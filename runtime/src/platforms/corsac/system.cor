/// Turning the kernel's answer into a result and an errno, the way
/// lib/sys/linux.cor's Platform.Result does: the kernel answers a negative
/// errno in the result register and never a pointer in that range.
static class CorsacPlatform
{
    public static long Errno;

    public static long Result(long raw)
    {
        if (raw < 0 && raw > 0 - 4096)
        {
            Errno = 0 - raw;
            return 0 - 1;
        }

        Errno = 0;
        return raw;
    }
}

