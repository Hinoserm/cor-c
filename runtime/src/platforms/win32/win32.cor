// The Windows platform library (--windows): the bare-metal runtime
// (runtime/src/arch/x86/baremetal.cor) with its hooks answered by kernel32.
//
// A Windows image is a guest in a process, as a ring-1 kernel's image is a
// guest of the kernel below it, and the bare-metal Platform already asks a
// host for everything a host has: memory (MapHook, UnmapHook), the time
// (NanosHook), an exit (ExitHook) and a console (Platform.Console). This file
// fills those in from kernel32 and owns what only Windows has: the TLS slot
// every thread's block is found by (Selector.TlsBaseSymbol: in NT's TEB, or in
// the array 9x's thread block points to),
// and the stack top the TEB records for each thread.
//
// A 32-bit image calls only kernel32 functions Windows 95 and NT 3.51 already
// had, so one image runs on every 32-bit Windows (docs/WIN32-TARGET.md). A
// 64-bit one -- XP x64 on -- also adds a vectored handler for its faults
// (Add/RemoveVectoredExceptionHandler, under a test of the word size that
// leaves them out of a 32-bit image) and finds its block in the x64 TEB's
// slot cells, 0x1480 and the expansion array at 0x1780 (CurrentBlock).
//
// NOTHING HERE ALLOCATES until Started: the heap is what Attach sets up.

public static class Win32
{
    const int MemCommit = 0x1000;
    const int MemReserve = 0x2000;
    const int MemDecommit = 0x4000;
    const int MemRelease = 0x8000;
    const int PageExecuteReadWrite = 0x40;

    const uint AccessViolation = 0xC0000005;
    /// EXCEPTION_UNWINDING and EXCEPTION_EXIT_UNWIND: a handler called to unwind, not to handle.
    const int Unwinding = 6;
    const int ContinueExecution = 0;
    const int ContinueSearch = 1;
    const int PageReadWrite = 0x04;
    const int StdInputHandle = -10, StdOutputHandle = -11, StdErrorHandle = -12;
    const int TlsOutOfIndexes = -1;
    /// INVALID_HANDLE_VALUE: (HANDLE)-1, every bit set in either word size.
    static nuint InvalidHandle => ~(nuint)0;

    /// WHERE THE TLS SLOTS ARE. NT keeps 64 in the TEB, at 0xE10 of it, and
    /// a slot past them in an expansion array (Windows 2000 on) this does not
    /// follow; the TEB's own address is at fs:[0x18]. Windows 9x keeps 80 in
    /// an array the thread's block points to from fs:[0x2C].
    const int TlsSlotsInTeb = 64;
    const int TebSelf = 0x18;
    const int TebTlsSlots = 0xE10;
    const int TibTlsArray9x = 0x2C;
    /// THE x64 TEB, read through GS: its own address at gs:[0x30], the 64
    /// slots at 0x1480 of it, and at gs:[0x1780] the expansion array
    /// (TlsExpansionSlots) a slot from 64 on is in -- made for a thread by
    /// TlsSetValue (SetBlock), which every write of a block goes through
    /// (Go's TEB_TlsSlots 0x1480; the x64 TEB, Windows' winternl.h).
    const int TebSelf64 = 0x30;
    const int TebTlsSlots64 = 0x1480;
    const int TebTlsExpansion64 = 0x1780;
    /// GetVersion's top bit: Windows 9x (and Win32s), not NT.
    const uint NotNt = 0x80000000;

    /// MEMORY_BASIC_INFORMATION's size: 28 on i386; 48 on x64, where
    /// BaseAddress, AllocationBase and RegionSize are eight bytes and the
    /// structure is padded (winnt.h).
    const int InfoBytes = WordSize.Bytes == 8 ? 48 : 28;
    /// Its fields' places: AllocationBase, RegionSize, State.
    const int InfoAllocationBase = WordSize.Bytes;
    const int InfoRegionSize = WordSize.Bytes == 8 ? 24 : 12;
    const int InfoState = WordSize.Bytes == 8 ? 32 : 16;

    /// FaultAddress's answer for an address it cannot say (also Windows 9x's -1).
    const nuint NoAddress = 0xFFFFFFFF;

    // Every call made before the thread has a block is SuppressGCTransition:
    // the transition reads the block.

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int TlsAlloc();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern uint GetVersion();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetModuleHandleW(nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint CreateSemaphoreA(nuint security, int initial, int maximum, nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int ReleaseSemaphore(nuint semaphore, uint count, nuint previous);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int WaitForSingleObject(nuint handle, int milliseconds);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int TlsFree(int slot);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint VirtualAlloc(nuint at, nuint bytes, int type, int protect);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int VirtualFree(nuint at, nuint bytes, int type);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint VirtualQuery(nuint at, nuint info, nuint bytes);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern void ExitProcess(int code);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetStdHandle(int which);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int WriteFile(nuint file, nuint bytes, int count, nuint written, nuint overlapped);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int QueryPerformanceCounter(nuint count);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int QueryPerformanceFrequency(nuint frequency);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern uint GetTickCount();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern void Sleep(int milliseconds);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int GetModuleFileNameA(nuint module, nuint name, int size);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint LoadLibraryA(nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int VirtualProtect(nuint at, nuint bytes, uint protect, nuint old);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int TlsSetValue(int slot, nuint value);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint AddVectoredExceptionHandler(uint first, nuint handler);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern uint RemoveVectoredExceptionHandler(nuint handler);

    /// The vectored handler a 64-bit image added (VectoredFault), or 0.
    static nuint _vectored;

    /// The slot taken, plus one: 0, none. No initialiser, so touching the
    /// class runs nothing before the thread has a block.
    static int _slotTaken;

    static nuint _imageStart;
    static nuint _imageEnd;
    static nuint _nullStub;
    static long _frequency;
    static long _count;

    /// THE PROCESS TAKES THE IMAGE IN (DllMain, DLL_PROCESS_ATTACH, before
    /// anything else of the image runs): a TLS slot for the threads' blocks,
    /// this thread's block in it, and the hooks. False -- the load fails --
    /// when there is no slot the TEB holds.
    public static bool Attach(nuint instance)
    {
        // The hooks first: with none, the bare-metal answers are the
        // machine's -- a port write and a HLT -- which a process may not make.
        Platform.MapHook = Sys.AddressOf(Map);
        Platform.UnmapHook = Sys.AddressOf(Unmap);
        Platform.NanosHook = Sys.AddressOf(Nanos);
        Platform.ExitHook = Sys.AddressOf(Exit);
        Platform.WriteHook = Sys.AddressOf(Write);
        Platform.ProcessorCountHook = Sys.AddressOf(Processors);
        Platform.YieldHook = Sys.AddressOf(Yield);
        if (!MakeParking()) return false;
        // THE RUNTIME'S OWN WAITS ON A WORD (Platform.Wait and Wake: the heap
        // lock, the collector's rounds, a fork's hold, the pacer) park as a
        // program's threads do (Park), not a turn given up at a time: a
        // thread waiting out a cycle looked again every time slice, a
        // processor's worth of looking while the collector needed it.
        Platform.WaitHook = Sys.AddressOf(WaitWord);
        Platform.WakeHook = Sys.AddressOf(WakeWord);
        FindWaitOnAddress();
        // A FAULT IN A 64-BIT IMAGE'S CODE comes to a vectored handler: x64
        // has no registration chain (Lowering.SehEnter's is i386's), and a
        // vectored handler -- XP x64 on, as Go's and the CLR's are -- sees it
        // first, whatever frames are between. One an image, added before the
        // slot is taken so a failure here holds nothing. Only in a 64-bit
        // image, whose test is a constant: an i386 image names neither
        // function, which Windows 95, NT 4 and 2000 do not have.
        if (WordSize.Bytes == 8 && _vectored == 0)
        {
            _vectored = AddVectoredExceptionHandler(1, Sys.AddressOf(VectoredFault));
            // (Without it a null read would end the process rather than throw: the load fails instead, plainly.)
            if (_vectored == 0) return false;
        }
        int slot = TlsAlloc();
        if (slot == TlsOutOfIndexes)
        {
            Release();
            return false;
        }
        if (WordSize.Bytes == 8)
        {
            // 64-BIT WINDOWS (every one NT): a slot under 64 in the TEB, one
            // from 64 on in its expansion array -- read as the TEB's own
            // address plus the slot's place, or the array's plus its place.
            _slotTaken = slot + 1;
            if (slot < TlsSlotsInTeb) Sys.SetThreadBlockSlot(TebSelf64, TebTlsSlots64 + 8 * slot);
            else Sys.SetThreadBlockSlot(TebTlsExpansion64, 8 * (slot - TlsSlotsInTeb));
        }
        else
        {
            bool nt = (GetVersion() & NotNt) == 0;
            if (nt && slot >= TlsSlotsInTeb)
            {
                TlsFree(slot);
                Release();
                return false;
            }
            _slotTaken = slot + 1;
            if (nt) Sys.SetThreadBlockSlot(TebSelf, TebTlsSlots + 4 * slot);
            else Sys.SetThreadBlockSlot(TibTlsArray9x, 4 * slot);
        }

        // The image's own extent, which a fault must be in to be ours:
        // SizeOfImage from the PE header e_lfanew names.
        _imageStart = instance;
        _imageEnd = instance + Sys.Read32(instance + Sys.Read32(instance + 0x3C) + 0x50);
        _nullStub = NullStub();

        nuint block = Sys.MainThreadBlock();
        Sys.WriteAddress(block + Tls.Self, block);
        SetBlock(block);
        nuint scratch = VirtualAlloc(0, InfoBytes, MemCommit | MemReserve, PageReadWrite);
        if (scratch == 0)
        {
            SetBlock(0);
            Release();
            return false;
        }
        Sys.WriteAddress(block + Tls.StackBase, StackTop(scratch));
        VirtualFree(scratch, 0, MemRelease);
        return true;
    }

    /// A THREAD C CALLS IN FROM is given a block the first time it comes
    /// (every export's way in, Lowering.EnterFromC): one the loading thread
    /// already has, and one made by the program the image was loaded into
    /// does not. Registered stopped, as a thread another starts is; the
    /// export's ReturnFromC says it is running.
    public static void Enter()
    {
        if (CurrentBlock() == 0) Adopt();
    }

    /// THIS THREAD'S BLOCK, OR 0, ON A THREAD THAT MAY NEVER HAVE HAD ONE
    /// (Enter, ThreadDetach: Windows calls a DLL on every thread of the
    /// process). On x64 a slot under 64 is in the TEB's own array, which
    /// every thread has: the block's read itself. A slot from 64 on is in
    /// the thread's expansion array (gs:[0x1780]), which a thread that never
    /// wrote a slot does not have -- the pointer null, and the block's read
    /// would go through it -- so it is read here as kernelbase's TlsGetValue
    /// reads it, 0 where there is none, but without TlsGetValue: that clears
    /// the thread's last error on every call (its disassembly, and Wine's
    /// kernelbase), and a host's GetLastError after a call into this image
    /// would read 0. Elsewhere the read itself.
    static nuint CurrentBlock()
    {
        // No slot (before Attach, after Release): no block, and the block's
        // read would go through cells never set.
        if (_slotTaken == 0) return 0;
        int slot = _slotTaken - 1;
        if (WordSize.Bytes != 8 || slot < TlsSlotsInTeb) return Sys.ThreadBlock();
        nuint expansion = Sys.PerCpuRead(TebTlsExpansion64);
        return expansion == 0 ? 0 : Sys.ReadAddress(expansion + (nuint)(8 * (slot - TlsSlotsInTeb)));
    }

    static void Adopt()
    {
        // The block, and after it the scratch StackTop fills.
        nuint block = VirtualAlloc(0, Tls.Bytes + InfoBytes, MemCommit | MemReserve, PageReadWrite);
        if (block == 0) ExitProcess(137);
        nuint top = StackTop(block + Tls.Bytes);
        Sys.WriteAddress(block + Tls.Self, block);
        SetBlock(block);
        Runtime.RegisterThread(block, top);
    }

    /// THIS THREAD'S BLOCK INTO THE SLOT: on i386 the word the image's two
    /// names find (Sys.SetThreadBlock); on x64 through TlsSetValue, which
    /// for a slot from 64 on first makes the thread's expansion array the
    /// block is read from. Every write of a block on Windows comes here
    /// (Platform.SetThreadBlock too).
    public static void SetBlock(nuint block)
    {
        if (WordSize.Bytes == 8)
        {
            // (It fails only where the expansion array cannot be had: the
            // thread could never find its block, so the process ends.)
            if (TlsSetValue(_slotTaken - 1, block) == 0) ExitProcess(137);
        }
        else Sys.SetThreadBlock(block);
    }

    /// THE PROCESS LETS THE IMAGE GO (DllMain, DLL_PROCESS_DETACH, `reserved`
    /// DllMain's third argument): on a FreeLibrary (`reserved` 0) the slot
    /// back and a 64-bit image's vectored handler taken off; at the process's
    /// end (`reserved` not 0) nothing -- the process is going, and other
    /// DLLs' detach code may still call in (Microsoft's DllMain guidance:
    /// no teardown at process exit). A pinned image (Pin) is only ever let
    /// go so.
    public static void Detach(nuint reserved)
    {
        if (reserved != 0) return;
        Release();
    }

    /// WHAT ATTACH TOOK, GIVEN BACK: the vectored handler (a 64-bit image's)
    /// and the TLS slot. From a FreeLibrary's Detach, and from an Attach that
    /// fails partway -- whether or not Windows then calls DLL_PROCESS_DETACH,
    /// each is given back once (the words cleared as it goes).
    static void Release()
    {
        if (WordSize.Bytes == 8 && _vectored != 0)
        {
            RemoveVectoredExceptionHandler(_vectored);
            _vectored = 0;
        }
        if (_slotTaken != 0)
        {
            TlsFree(_slotTaken - 1);
            _slotTaken = 0;
        }
    }

    /// A THREAD GOING AWAY (DLL_THREAD_DETACH): one this image gave a block
    /// to is the collector's no longer, and its block goes back. The loading
    /// thread's block is static memory, and stays.
    public static void ThreadDetach()
    {
        nuint block = CurrentBlock();
        if (block == 0) return;
        // A thread the runtime started has ended already (Thread's body:
        // Runtime.EndThread): only the block to give back. Its State usually
        // still says Gone, and then no lock is taken under the loader's as
        // DllMain runs; where a later wait changed it, the registry is asked,
        // which takes the registry's lock, as before.
        if (Sys.ReadAddress(block + Tls.State) != GcThreads.Gone && GcThreads.IsRegistered(block))
        {
            Runtime.EndBlocking();
            Runtime.EndThread();
        }
        SetBlock(0);
        if (block != Sys.MainThreadBlock()) VirtualFree(block, 0, MemRelease);
    }

    /// THE WAY INTO Runtime.NullFault from a fault, made once: Fault cannot
    /// build the call on the faulting stack, where Windows has just put the
    /// context it is handing over, so it sends the thread here with the
    /// return address to give NullFault in EAX -- the faulting instruction,
    /// as if it had called it, or for a leaf that stands for its call the
    /// caller's return address (Runtime.FrameAt) -- the frame in EDX and the
    /// instruction NullFault names in ECX, and this builds it: NullFault(frame,
    /// pc), the frame to EAX and the instruction to EDX, where it takes its
    /// two words; the stack aligned as a call leaves it.
    static nuint NullStub()
    {
        nuint stub = VirtualAlloc(0, 32, MemCommit | MemReserve, PageExecuteReadWrite);
        if (stub == 0) return 0;
        nuint entry = Sys.AddressOf(Runtime.NullFault);
        nuint at = 0;
        if (WordSize.Bytes == 8)
        {
            // x64: the return address in RAX, the frame in RDX, the
            // instruction in RCX (VectoredFault); NullFault(frame, pc) by
            // this compiler's convention, System V's: RDI and RSI.
            Sys.Write8(stub + at++, 0x48); Sys.Write8(stub + at++, 0x83); Sys.Write8(stub + at++, 0xE4); Sys.Write8(stub + at++, 0xF0); // and rsp, -16
            Sys.Write8(stub + at++, 0x50);                                                                  // push rax   the return address: aligned as a call leaves it
            Sys.Write8(stub + at++, 0x48); Sys.Write8(stub + at++, 0x89); Sys.Write8(stub + at++, 0xD7); // mov rdi, rdx   the frame
            Sys.Write8(stub + at++, 0x48); Sys.Write8(stub + at++, 0x89); Sys.Write8(stub + at++, 0xCE); // mov rsi, rcx   the instruction
            Sys.Write8(stub + at++, 0x49); Sys.Write8(stub + at++, 0xBB);                                 // mov r11, NullFault
            for (int i = 0; i < 8; i++) Sys.Write8(stub + at++, (byte)(entry >> (8 * i)));
            Sys.Write8(stub + at++, 0x41); Sys.Write8(stub + at++, 0xFF); Sys.Write8(stub + at++, 0xE3); // jmp r11
            return stub;
        }
        Sys.Write8(stub + at++, 0x83); Sys.Write8(stub + at++, 0xE4); Sys.Write8(stub + at++, 0xF0); // and esp, -16
        Sys.Write8(stub + at++, 0x50);                                                                  // push eax   the return address: aligned as a call leaves it
        Sys.Write8(stub + at++, 0x89); Sys.Write8(stub + at++, 0xD0);                                 // mov eax, edx   the frame
        Sys.Write8(stub + at++, 0x89); Sys.Write8(stub + at++, 0xCA);                                 // mov edx, ecx   the instruction
        Sys.Write8(stub + at++, 0xB9);                                                                  // mov ecx, NullFault
        for (int i = 0; i < 4; i++) Sys.Write8(stub + at++, (byte)(entry >> (8 * i)));
        Sys.Write8(stub + at++, 0xFF); Sys.Write8(stub + at++, 0xE1);                                 // jmp ecx
        return stub;
    }

    /// THE SEH HANDLER every way in from C registers (Lowering.SehEnter),
    /// called by Windows with the exception's record, the registration, the
    /// context and the dispatcher's word. An access violation by this image's
    /// own code at a null address (Runtime.NullFaultCatchable) goes on as a
    /// NullReferenceException: the thread continues in NullStub. Anything
    /// else -- another exception, a fault in code that is not ours, a fault
    /// in the collector -- is searched on for whoever else handles it.
    /// EXCEPTION_RECORD: ExceptionCode at 0, ExceptionFlags 4,
    /// NumberParameters 16, the address 24. CONTEXT: Edx 0xA8, Eax 0xB0,
    /// Ebp 0xB4, Eip 0xB8, Esp 0xC4.
    /// Windows calls it as C calls anything, its four words pushed
    /// ([StackArguments]: this language's own calls give the first three
    /// in registers).
    [StackArguments]
    public static int Fault(nuint rec, nuint registration, nuint ctx, nuint dispatcher)
    {
        if ((Sys.Read32(rec + 4) & Unwinding) != 0) return ContinueSearch;
        if (Sys.Read32(rec) != AccessViolation || _nullStub == 0 || Sys.Read32(rec + 16) < 2) return ContinueSearch;
        nuint pc = Sys.Read32(ctx + 0xB8);
        // Ours: this image's code, or code of an image over it that the
        // runtime knows by its frames (Runtime.KnowsCode).
        if ((pc < _imageStart || pc >= _imageEnd) && !Runtime.KnowsCode(pc)) return ContinueSearch;
        // The address read or written. Windows 9x gives -1 there, and the
        // faulting instruction says it instead (FaultAddress).
        nuint address = Sys.Read32(rec + 24);
        if (address == NoAddress) address = FaultAddress(ctx, pc);
        if (address == NoAddress || !Runtime.NullFaultCatchable(address)) return ContinueSearch;

        // CONTEXT's registers are DWORDs: Eax (the return address), Edx (the
        // frame), Ecx (the instruction), Eip. The faulting function's frame
        // link (Runtime.FrameAt), made EBP, so NullFault's prologue links to
        // it as a call from there would; a leaf with no link of its own
        // stands as the call it was in its caller (`pc` its return address;
        // the instruction named is still the leaf's: Runtime.NullFault).
        nuint stoppedPc = pc;
        nuint frame = Runtime.FrameAt(ref pc, Sys.Read32(ctx + 0xC4), Sys.Read32(ctx + 0xB4));
        // A leaf stood for its call has its caller's EBX, ESI and EDI where
        // it pushed them: put back, as its return would have (Runtime.LeafSaved).
        if (pc != stoppedPc)
        {
            nuint stoppedSp = Sys.Read32(ctx + 0xC4);
            nuint saved = Runtime.LeafSaved(stoppedPc, stoppedSp, 3);
            if (saved != 0) Sys.Write32(ctx + 0xA4, Sys.Read32(saved));
            saved = Runtime.LeafSaved(stoppedPc, stoppedSp, 6);
            if (saved != 0) Sys.Write32(ctx + 0xA0, Sys.Read32(saved));
            saved = Runtime.LeafSaved(stoppedPc, stoppedSp, 7);
            if (saved != 0) Sys.Write32(ctx + 0x9C, Sys.Read32(saved));
        }
        Sys.Write32(ctx + 0xB4, Sys.Low32(frame));
        Sys.Write32(ctx + 0xB0, Sys.Low32(pc));
        Sys.Write32(ctx + 0xA8, Sys.Low32(frame));
        Sys.Write32(ctx + 0xAC, Sys.Low32(stoppedPc));
        Sys.Write32(ctx + 0xB8, Sys.Low32(_nullStub));
        return ContinueExecution;
    }

    /// THE VECTORED HANDLER of a 64-bit image (Attach), which Windows calls
    /// with EXCEPTION_POINTERS -- the record, then the context -- by its own
    /// x64 convention ([StackArguments]: the platform's C convention, which
    /// Function.NativeEntry's stub takes in for this compiler's). As Fault on
    /// i386: an access violation by this image's code (or one the runtime
    /// knows, Runtime.KnowsCode) at an address a null reference reaches
    /// goes on as a NullReferenceException, the thread continuing in
    /// NullStub; anything else is searched on (EXCEPTION_CONTINUE_SEARCH,
    /// 0). EXCEPTION_RECORD: ExceptionCode at 0, NumberParameters 24, the
    /// address 40 (ExceptionInformation[1]). CONTEXT (winnt.h, x64): Rax
    /// 0x78, Rcx 0x80, Rdx 0x88, Rbx 0x90, Rsp 0x98, Rbp 0xA0, R12 0xD8 to
    /// R15 0xF0, Rip 0xF8.
    [StackArguments]
    public static int VectoredFault(nuint pointers)
    {
        nuint rec = Sys.ReadAddress(pointers);
        nuint ctx = Sys.ReadAddress(pointers + 8);
        if (Sys.Read32(rec) != AccessViolation || _nullStub == 0 || Sys.Read32(rec + 24) < 2) return 0;
        nuint pc = Sys.ReadAddress(ctx + 0xF8);
        if ((pc < _imageStart || pc >= _imageEnd) && !Runtime.KnowsCode(pc)) return 0;
        nuint address = Sys.ReadAddress(rec + 40);
        if (!Runtime.NullFaultCatchable(address)) return 0;

        // As Linux's long-mode Fault does it: the faulting function's frame
        // link (Runtime.FrameAt), made RBP; a leaf stands as the call it was
        // in its caller, its caller's RBX and R12-R15 put back from where it
        // pushed them (Runtime.LeafSaved).
        nuint stoppedPc = pc;
        nuint stoppedSp = Sys.ReadAddress(ctx + 0x98);
        nuint frame = Runtime.FrameAt(ref pc, stoppedSp, Sys.ReadAddress(ctx + 0xA0));
        if (pc != stoppedPc)
        {
            nuint saved = Runtime.LeafSaved(stoppedPc, stoppedSp, 3);
            if (saved != 0) Sys.WriteAddress(ctx + 0x90, Sys.ReadAddress(saved));
            int r = 12;
            while (r <= 15)
            {
                saved = Runtime.LeafSaved(stoppedPc, stoppedSp, r);
                if (saved != 0) Sys.WriteAddress(ctx + 0xD8 + (nuint)((r - 12) * 8), Sys.ReadAddress(saved));
                r = r + 1;
            }
        }
        Sys.WriteAddress(ctx + 0xA0, frame);
        Sys.WriteAddress(ctx + 0x78, pc);
        Sys.WriteAddress(ctx + 0x88, frame);
        Sys.WriteAddress(ctx + 0x80, stoppedPc);
        Sys.WriteAddress(ctx + 0xF8, _nullStub);
        return -1;                                   // EXCEPTION_CONTINUE_EXECUTION
    }

    /// THE ADDRESS AN INSTRUCTION FAULTED ON, read from the instruction itself
    /// where Windows 9x does not say it (its access violation's address is
    /// -1): the memory operand's base, index times scale and displacement,
    /// with the registers the context holds. For the forms this compiler's
    /// code uses -- a ModRM operand after a one- or two-byte opcode, or the
    /// accumulator's absolute moves (A0-A3) -- and -1 for anything else, or
    /// for an operand through FS or GS, which is never a null reference's.
    static nuint FaultAddress(nuint ctx, nuint pc)
    {
        nuint at = pc;
        int b = Sys.Read8(at);
        // Prefixes: operand size, repeats, lock, the segments but FS and GS.
        while (b is 0x66 or 0x67 or 0xF0 or 0xF2 or 0xF3 or 0x26 or 0x2E or 0x36 or 0x3E)
        {
            at++;
            b = Sys.Read8(at);
        }
        if (b is 0x64 or 0x65) return NoAddress;
        if (b is >= 0xA0 and <= 0xA3) return Sys.Read32(at + 1);
        bool modrm;
        if (b == 0x0F)
        {
            at++;
            int c = Sys.Read8(at);
            modrm = c is (>= 0x10 and <= 0x17) or (>= 0x28 and <= 0x2F) or (>= 0x40 and <= 0x4F) or (>= 0x90 and <= 0x9F)
                or 0xA3 or 0xA4 or 0xA5 or 0xAB or 0xAC or 0xAD or 0xAF or (>= 0xB0 and <= 0xB7) or (>= 0xBA and <= 0xBF)
                or 0xC0 or 0xC1 or 0xC7;
        }
        else
        {
            modrm = (b < 0x40 && (b & 7) < 4) || b is 0x62 or 0x63 or 0x69 or 0x6B or (>= 0x80 and <= 0x8F) or 0xC0 or 0xC1
                or (>= 0xC4 and <= 0xC7) or (>= 0xD0 and <= 0xD3) or (>= 0xD8 and <= 0xDF) or 0xF6 or 0xF7 or 0xFE or 0xFF;
        }
        if (!modrm) return NoAddress;
        at++;
        int m = Sys.Read8(at);
        int mod = m >> 6, rm = m & 7;
        if (mod == 3) return NoAddress;
        at++;
        nuint address = 0;
        if (rm == 4)
        {
            int sib = Sys.Read8(at);
            at++;
            int scale = sib >> 6, index = (sib >> 3) & 7, bas = sib & 7;
            if (index != 4) address = Register(ctx, index) << scale;
            if (bas == 5 && mod == 0)
            {
                address = address + Sys.Read32(at);
                at = at + 4;
            }
            else address = address + Register(ctx, bas);
        }
        else if (rm == 5 && mod == 0)
        {
            address = Sys.Read32(at);
            at = at + 4;
        }
        else address = Register(ctx, rm);
        if (mod == 1) address = address + (nuint)(long)(sbyte)Sys.Read8(at);
        else if (mod == 2) address = address + (nuint)(long)(int)Sys.Read32(at);
        return address;
    }

    /// A general register as CONTEXT holds it, by its encoding: EAX ECX EDX EBX ESP EBP ESI EDI.
    static nuint Register(nuint ctx, int number)
    {
        nuint offset = number switch { 0 => 0xB0, 1 => 0xAC, 2 => 0xA8, 3 => 0xA4, 4 => 0xC4, 5 => 0xB4, 6 => 0xA0, _ => 0x9C };
        return Sys.Read32(ctx + offset);
    }

    /// A PROGRAM'S IMAGE: the module the process was started from (its handle is its base).
    public static nuint ProgramImage() => GetModuleHandleW(0);

    /// The process ends, with `code`: a program that could not even start.
    public static void Fail(int code) => ExitProcess(code);

    /// Nanoseconds by the performance counter, for Clock.
    public static long NowNanos() => Nanos(0, 0, 0);

    // ---- a wait on a word ------------------------------------------------
    //
    // WaitOnAddress where Windows has it (8 and later, in KernelBase): the
    // kernel's own wait on a word, Linux's futex. Found at Attach by name,
    // never imported -- an import of it would keep the image from loading on
    // anything older. Where it is not, as on Windows 2000, which is the
    // floor, and on CORSAC's NT layer today: a wait parks on one of ParkBuckets
    // semaphores, chosen by the word's address, after counting itself among
    // its bucket's waiters and reading the word once more; a wake releases as
    // many as wait there. A waiter counted before its last read cannot miss a
    // wake made after the word changed. Words that share a bucket wake each
    // other now and then, which every caller allows: each reads its word
    // again. Made in Attach, in memory of its own: a wait may be the
    // collector's, with nothing to be had of the heap.
    const int ParkBuckets = 64;
    static nuint _parkSemaphores;
    static nuint _parkWaiters;

    static bool MakeParking()
    {
        if (_parkSemaphores != 0) return true;
        nuint table = VirtualAlloc(0, ParkBuckets * (WordSize.Bytes + 4), MemCommit | MemReserve, PageReadWrite);
        if (table == 0) return false;
        for (int i = 0; i < ParkBuckets; i++)
        {
            nuint semaphore = CreateSemaphoreA(0, 0, 0x7FFFFFFF, 0);
            if (semaphore == 0) return false;
            Sys.WriteAddress(table + WordSize.Bytes * (nuint)i, semaphore);   // a HANDLE is a word
        }
        _parkWaiters = table + WordSize.Bytes * ParkBuckets;
        _parkSemaphores = table;
        return true;
    }

    static nuint Bucket(nuint at) => ((at >> 2) * 0x9E3779B1 >> 26) & (ParkBuckets - 1);

    // WaitOnAddress and the two wakes, or 0 (FindWaitOnAddress).
    static nuint _waitOnAddress, _wakeOne, _wakeAll;

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetModuleHandleA(nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetProcAddress(nuint module, nuint name);

    /// KernelBase's WaitOnAddress, WakeByAddressSingle and WakeByAddressAll,
    /// all three or none: Windows 8's and later. KernelBase is loaded in every
    /// process from Windows 7 on, and only asked for here, not loaded: on 7
    /// it has none of the three, and before 7 there is no KernelBase at all. The names written into a page of their own,
    /// given back after: nothing here asks the heap (MakeParking's reason).
    static void FindWaitOnAddress()
    {
        nuint names = VirtualAlloc(0, 4096, MemCommit | MemReserve, PageReadWrite);
        if (names == 0) return;
        nuint module = GetModuleHandleA(Ascii(names, "kernelbase.dll"));
        if (module != 0)
        {
            nuint wait = GetProcAddress(module, Ascii(names + 64, "WaitOnAddress"));
            nuint one = GetProcAddress(module, Ascii(names + 128, "WakeByAddressSingle"));
            nuint all = GetProcAddress(module, Ascii(names + 192, "WakeByAddressAll"));
            if (wait != 0 && one != 0 && all != 0)
            {
                _wakeOne = one;
                _wakeAll = all;
                _waitOnAddress = wait;
            }
        }
        VirtualFree(names, 0, MemRelease);
    }

    /// `text`, an ASCII name, written at `at` with its zero: `at`.
    static nuint Ascii(nuint at, string text)
    {
        for (int i = 0; i < text.Length; i++) Sys.Write8(at + (nuint)i, (byte)text[i]);
        Sys.Write8(at + (nuint)text.Length, 0);
        return at;
    }

    /// Platform.WaitHook: Park, for as long as it takes.
    static nuint WaitWord(nuint at, nuint value, nuint c)
    {
        Park(at, (int)value, -1);
        return 0;
    }

    /// Platform.WakeHook: Unpark.
    static nuint WakeWord(nuint at, nuint count, nuint c)
    {
        Unpark(at, (int)count);
        return 0;
    }

    /// Waits while the word at `at` is `expect`, for at most `milliseconds`
    /// (-1, none -- looked at again each second all the same).
    public static void Park(nuint at, int expect, int milliseconds)
    {
        int most = milliseconds < 0 || milliseconds > 1000 ? 1000 : milliseconds;
        // Its block or 0 (CurrentBlock): the block's own read is not safe on a
        // 64-bit thread with no TLS expansion array, where a slot from 64 on is.
        nuint block = CurrentBlock();
        if (_waitOnAddress != 0 && block != 0)
        {
            // The value compared with is read from memory: the thread
            // block's scratch words (Tls.Scratch), which nothing else of
            // this platform's uses -- a word of this thread's own that no
            // frame below can reuse while WaitOnAddress reads it. Called
            // without the native handshake (SuppressGCTransition): this
            // is the collector's own wait, and the handshake's stop would
            // stir the collector through Unpark again, without end.
            nuint compare = block + Tls.Scratch;
            Sys.Write32(compare, (uint)expect);
            ((delegate* unmanaged[Stdcall, SuppressGCTransition]<nuint, nuint, nuint, uint, int>)_waitOnAddress)(at, compare, 4, (uint)most);
            return;
        }
        nuint b = Bucket(at);
        nuint waiters = _parkWaiters + b * 4;
        Sys.AtomicAdd32(waiters, 1);
        if (Sys.Read32(at) == (uint)expect)
            WaitForSingleObject(Sys.ReadAddress(_parkSemaphores + b * WordSize.Bytes), most);
        Sys.AtomicAdd32(waiters, -1);
    }

    /// Wakes up to `count` of what waits on the word at `at`.
    public static void Unpark(nuint at, int count)
    {
        // THE TWO WAITS BOTH WOKEN: a thread with no block yet parks on the
        // semaphores even where WaitOnAddress is had (Park), and a wake by
        // address alone left it to its next look, a second later. The
        // semaphores' half costs a read where nobody waits there.
        if (_waitOnAddress != 0)
        {
            if (count == 1) ((delegate* unmanaged[Stdcall, SuppressGCTransition]<nuint, void>)_wakeOne)(at);
            else ((delegate* unmanaged[Stdcall, SuppressGCTransition]<nuint, void>)_wakeAll)(at);
        }
        nuint b = Bucket(at);
        uint waiting = Sys.Read32(_parkWaiters + b * 4);
        if (waiting == 0) return;
        uint wake = (uint)count;
        ReleaseSemaphore(Sys.ReadAddress(_parkSemaphores + b * WordSize.Bytes), wake < waiting ? wake : waiting, 0);
    }

    /// The runtime is running: what wants it.
    public static void Started()
    {
        Pin();
    }

    /// LOADED ONCE, LOADED FOR GOOD, as native AOT's DLLs are: the runtime
    /// cannot give back its heap or the blocks of threads still alive, so a
    /// FreeLibrary and LoadLibrary pair -- Quake 2's vid_restart -- would leak
    /// both every time. Its own name loaded once more, which for a module
    /// already loaded only counts it again (GetModuleHandleEx's pin is XP's).
    /// The name in a page of its own, given back after: nothing here asks the
    /// heap, so a DLL that allocates nothing carries no collector.
    static void Pin() => PinImage(_imageStart);

    /// An image loaded for good: its own name loaded once more (Pin). An
    /// image over the runtime DLL pins itself so (Lowering.EmitImageAttach):
    /// the runtime holds its statics and frames from then on.
    public static void PinImage(nuint instance)
    {
        nuint name = VirtualAlloc(0, 264, MemCommit | MemReserve, PageReadWrite);
        if (name == 0) return;
        int length = GetModuleFileNameA(instance, name, 260);
        if (length > 0 && length < 260) LoadLibraryA(name);
        VirtualFree(name, 0, MemRelease);
    }

    /// THE WORDS AN IMPORT'S ADDRESS GOES IN, filled as an image over the
    /// runtime DLL starts and before any of its code runs (Linker DataImports):
    /// each entry of the table from `table` to `end` is two RVAs, a word of the
    /// image and the import address table slot the loader filled with what
    /// the word names, and the word, which holds only the addend, gets that
    /// address added. Windows' loader fills the slots, data's as well as
    /// functions'; it has no relocation that names another image's symbol,
    /// and this is that relocation. Every section is made writable for the
    /// while, and each is given back the protection it had.
    public static void FillImports(nuint instance, nuint table, nuint end)
    {
        if (table == end) return;
        nuint pe = instance + Sys.Read32(instance + 0x3C);
        nuint sections = Sys.Read16(pe + 6);
        nuint headers = pe + 24 + Sys.Read16(pe + 20);
        // A word of protection kept for each section, in a page of its own.
        nuint kept = VirtualAlloc(0, sections * 4 + 4, MemCommit | MemReserve, PageReadWrite);
        if (kept == 0) ExitProcess(137);
        for (nuint i = 0; i < sections; i++)
        {
            nuint header = headers + i * 40;
            VirtualProtect(instance + Sys.Read32(header + 12), Sys.Read32(header + 8), PageExecuteReadWrite, kept + i * 4);
        }
        for (nuint at = table; at < end; at = at + 8)
        {
            // (A word of the image: four bytes in PE32, eight in PE32+.)
            nuint word = instance + Sys.Read32(at);
            nuint slot = instance + Sys.Read32(at + 4);
            Sys.WriteAddress(word, Sys.ReadAddress(word) + Sys.ReadAddress(slot));
        }
        for (nuint i = 0; i < sections; i++)
        {
            nuint header = headers + i * 40;
            VirtualProtect(instance + Sys.Read32(header + 12), Sys.Read32(header + 8), Sys.Read32(kept + i * 4), kept + sections * 4);
        }
        VirtualFree(kept, 0, MemRelease);
    }

    /// THE TOP OF THIS THREAD'S STACK, where a scan of it ends: the end of
    /// the committed region the stack pointer is in, which is the stack's
    /// top whatever made the thread. VirtualQuery fills MEMORY_BASIC_INFORMATION
    /// at `scratch` (InfoBytes: BaseAddress first, RegionSize at InfoRegionSize),
    /// which is memory the heap never handed out: this runs before the
    /// thread may allocate.
    static nuint StackTop(nuint scratch)
    {
        VirtualQuery(Sys.FramePointer(), scratch, InfoBytes);
        // BaseAddress and RegionSize are a PVOID and a SIZE_T: a word each.
        return Sys.ReadAddress(scratch) + Sys.ReadAddress(scratch + InfoRegionSize);
    }

    /// Zeroed pages, or 0: VirtualAlloc's are zeroed.
    static nuint Map(nuint bytes, nuint b, nuint c)
    {
        return VirtualAlloc(0, bytes, MemCommit | MemReserve, PageReadWrite);
    }

    /// Given back by DECOMMIT: the heap gives back pieces of what it was
    /// mapped, and only a whole reservation can be released -- AND THEN THE
    /// RESERVATION RELEASED, once none of it is committed any more. A
    /// decommitted reservation keeps its addresses, and VirtualAlloc never
    /// hands them out again: every chunk the heap mapped and gave back was
    /// address space lost for good, at least 64 KB a time. A game's ICD
    /// mapped and gave back two large arrays a frame, and Half-Life's own
    /// calloc ran out of address space after five minutes (CORSAC on the
    /// K8, 2026-10-30: 31,050 maps and unmaps, the address space a wall of
    /// reserved holes).
    static nuint Unmap(nuint at, nuint bytes, nuint c)
    {
        // One query at a time through the buffer made for it the first time:
        // the heap gives back from more than one thread. A holder put off
        // the processor is waited for, not spun at: Sleep(0) yields only to
        // threads of the waiter's priority or above, so after a few turns
        // Sleep(1), which lets a lower-priority holder run.
        nuint lockWord = Sys.AddressOf(ref _querying);
        for (int turn = 0; Sys.Cas32(lockWord, 0, 1) != 0; turn++) Sleep(turn < 16 ? 0 : 1);
        try
        {
            // The reservation asked for while `at` is still ours: decommitted
            // first, a reservation another thread then released and a third
            // made over the same addresses would have been taken for ours.
            if (_query == 0) _query = VirtualAlloc(0, InfoBytes, MemCommit | MemReserve, PageReadWrite);
            nuint info = _query;
            nuint reservation = info != 0 && VirtualQuery(at, info, InfoBytes) != 0 ? Sys.ReadAddress(info + InfoAllocationBase) : 0;
            VirtualFree(at, bytes, MemDecommit);
            if (reservation == 0) return 0;
            // MEMORY_BASIC_INFORMATION: BaseAddress, AllocationBase,
            // AllocationProtect, RegionSize, State (InfoBytes' places).
            // Every run of the reservation in turn, from its base: any still
            // committed keeps it.
            nuint walk = reservation;
            while (true)
            {
                if (VirtualQuery(walk, info, InfoBytes) == 0 || Sys.ReadAddress(info + InfoAllocationBase) != reservation) break;
                if (Sys.Read32(info + InfoState) == MemCommit) return 0;
                nuint size = Sys.ReadAddress(info + InfoRegionSize);
                if (size == 0) return 0;
                walk = walk + size;
            }
            VirtualFree(reservation, 0, MemRelease);
            return 0;
        }
        finally { Sys.AtomicSwap32(lockWord, 0); }
    }

    static nuint _query;
    static int _querying;

    /// The performance counter as nanoseconds, or the tick count's
    /// milliseconds on a machine without one.
    static long Nanos(nuint a, nuint b, nuint c)
    {
        if (_frequency == 0 && QueryPerformanceFrequency(Sys.AddressOf(ref _frequency)) == 0) _frequency = -1;
        if (_frequency < 0) { long ticks = GetTickCount(); return ticks * 1000000; }
        QueryPerformanceCounter(Sys.AddressOf(ref _count));
        long seconds = _count / _frequency;
        return seconds * 1000000000 + (_count - seconds * _frequency) * 1000000000 / _frequency;
    }

    /// A spin's offer to the others (Platform.YieldHook): the rest of this
    /// thread's time slice given up. Sleep(0), which every Windows has.
    static nuint Yield(nuint at, nuint value, nuint c)
    {
        Sleep(0);
        return 0;
    }

    [DllImport("kernel32")] static extern void GetSystemInfo(nuint info);

    /// How many processors (Os.ProcessorCount): SYSTEM_INFO's count, at 20
    /// of its 36 bytes on i386 and 32 of its 48 on x64, where the two
    /// application addresses and the processor mask are words (winbase.h).
    static nuint Processors(nuint a, nuint b, nuint c)
    {
        int at = WordSize.Bytes == 8 ? 32 : 20;
        byte[] info = new byte[WordSize.Bytes == 8 ? 48 : 36];
        GetSystemInfo(Sys.ArrayData(info));
        return (nuint)(info[at] | (info[at + 1] << 8) | (info[at + 2] << 16) | (info[at + 3] << 24));
    }

    static nuint Exit(nuint code, nuint b, nuint c)
    {
        ExitProcess((int)code);
        return 0;
    }

    /// What the runtime prints (Platform.WriteHook): to the descriptor it
    /// names -- the standard three by their handles, any other through the
    /// descriptor table (Os.Write) -- dropped where there is no such handle.
    /// EVERY DESCRIPTOR WAS STANDARD ERROR, a program's Console.WriteLine
    /// (Runtime.WriteBytes(StdOut, ...)) as much as an exception's report:
    /// on a console the two look alike, and a program whose error output was
    /// sent elsewhere printed nothing on its standard output at all.
    static nuint Write(int fd, nuint address, nuint count)
    {
        if (fd > 2)
        {
            Os.Write(fd, address, count);
            return count;
        }
        nuint handle = GetStdHandle(fd == 1 ? StdOutputHandle : fd == 0 ? StdInputHandle : StdErrorHandle);
        if (handle == 0 || handle == InvalidHandle) return 0;
        int written = 0;
        WriteFile(handle, address, (int)count, Sys.AddressOf(ref written), 0);
        return count;
    }
}
