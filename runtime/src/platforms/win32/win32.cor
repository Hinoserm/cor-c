// The Windows platform library (--windows): the bare-metal runtime
// (runtime/src/arch/x86/baremetal.cor) with its hooks answered by kernel32.
//
// A Windows image is a guest in a process, as a ring-1 kernel's image is a
// guest of the kernel below it, and the bare-metal Platform already asks a
// host for everything a host has: memory (MapHook, UnmapHook), the time
// (NanosHook), an exit (ExitHook) and a console (Platform.Console). This file
// fills those in from kernel32 and owns what only Windows has: the TLS slot
// every thread's block is found by (Selector.TlsBaseSymbol: in NT's TEB, or in
// the array 9x's thread block points to),
// and the stack top the TEB records for each thread.
//
// Only kernel32 functions Windows 95 and NT 3.51 already had are called, so
// one image runs on every 32-bit Windows (docs/WIN32-TARGET.md).
//
// NOTHING HERE ALLOCATES until Started: the heap is what Attach sets up.

public static class Win32
{
    const int MemCommit = 0x1000;
    const int MemReserve = 0x2000;
    const int MemDecommit = 0x4000;
    const int MemRelease = 0x8000;
    const int PageExecuteReadWrite = 0x40;

    const uint AccessViolation = 0xC0000005;
    /// EXCEPTION_UNWINDING and EXCEPTION_EXIT_UNWIND: a handler called to unwind, not to handle.
    const int Unwinding = 6;
    const int ContinueExecution = 0;
    const int ContinueSearch = 1;
    const int PageReadWrite = 0x04;
    const int StdErrorHandle = -12;
    const int TlsOutOfIndexes = -1;
    const nuint InvalidHandle = 0xFFFFFFFF;

    /// WHERE THE TLS SLOTS ARE. NT keeps 64 in the TEB, at 0xE10 of it, and
    /// a slot past them in an expansion array (Windows 2000 on) this does not
    /// follow; the TEB's own address is at fs:[0x18]. Windows 9x keeps 80 in
    /// an array the thread's block points to from fs:[0x2C].
    const int TlsSlotsInTeb = 64;
    const int TebSelf = 0x18;
    const int TebTlsSlots = 0xE10;
    const int TibTlsArray9x = 0x2C;
    /// GetVersion's top bit: Windows 9x (and Win32s), not NT.
    const uint NotNt = 0x80000000;

    /// MEMORY_BASIC_INFORMATION's size on i386.
    const int InfoBytes = 28;

    /// FaultAddress's answer for an address it cannot say (also Windows 9x's -1).
    const nuint NoAddress = 0xFFFFFFFF;

    // Every call made before the thread has a block is SuppressGCTransition:
    // the transition reads the block.

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int TlsAlloc();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern uint GetVersion();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetModuleHandleW(nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint CreateSemaphoreA(nuint security, int initial, int maximum, nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int ReleaseSemaphore(nuint semaphore, uint count, nuint previous);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int WaitForSingleObject(nuint handle, int milliseconds);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int TlsFree(int slot);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint VirtualAlloc(nuint at, nuint bytes, int type, int protect);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int VirtualFree(nuint at, nuint bytes, int type);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint VirtualQuery(nuint at, nuint info, nuint bytes);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern void ExitProcess(int code);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint GetStdHandle(int which);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int WriteFile(nuint file, nuint bytes, int count, nuint written, nuint overlapped);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int QueryPerformanceCounter(nuint count);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int QueryPerformanceFrequency(nuint frequency);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern uint GetTickCount();

    [DllImport("kernel32"), SuppressGCTransition]
    static extern void Sleep(int milliseconds);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int GetModuleFileNameA(nuint module, nuint name, int size);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern nuint LoadLibraryA(nuint name);

    [DllImport("kernel32"), SuppressGCTransition]
    static extern int VirtualProtect(nuint at, nuint bytes, uint protect, nuint old);

    /// The slot taken, plus one: 0, none. No initialiser, so touching the
    /// class runs nothing before the thread has a block.
    static int _slotTaken;

    static nuint _imageStart;
    static nuint _imageEnd;
    static nuint _nullStub;
    static long _frequency;
    static long _count;

    /// THE PROCESS TAKES THE IMAGE IN (DllMain, DLL_PROCESS_ATTACH, before
    /// anything else of the image runs): a TLS slot for the threads' blocks,
    /// this thread's block in it, and the hooks. False -- the load fails --
    /// when there is no slot the TEB holds.
    public static bool Attach(nuint instance)
    {
        // The hooks first: with none, the bare-metal answers are the
        // machine's -- a port write and a HLT -- which a process may not make.
        Platform.MapHook = Sys.AddressOf(Map);
        Platform.UnmapHook = Sys.AddressOf(Unmap);
        Platform.NanosHook = Sys.AddressOf(Nanos);
        Platform.ExitHook = Sys.AddressOf(Exit);
        Platform.WriteHook = Sys.AddressOf(Write);
        Platform.ProcessorCountHook = Sys.AddressOf(Processors);
        Platform.WaitHook = Sys.AddressOf(Yield);
        Platform.YieldHook = Sys.AddressOf(Yield);
        if (!MakeParking()) return false;
        int slot = TlsAlloc();
        if (slot == TlsOutOfIndexes) return false;
        bool nt = (GetVersion() & NotNt) == 0;
        if (nt && slot >= TlsSlotsInTeb)
        {
            TlsFree(slot);
            return false;
        }
        _slotTaken = slot + 1;
        if (nt) Sys.SetThreadBlockSlot(TebSelf, TebTlsSlots + 4 * slot);
        else Sys.SetThreadBlockSlot(TibTlsArray9x, 4 * slot);

        // The image's own extent, which a fault must be in to be ours:
        // SizeOfImage from the PE header e_lfanew names.
        _imageStart = instance;
        _imageEnd = instance + Sys.Read32(instance + Sys.Read32(instance + 0x3C) + 0x50);
        _nullStub = NullStub();

        nuint block = Sys.MainThreadBlock();
        Sys.WriteAddress(block + Tls.Self, block);
        Sys.SetThreadBlock(block);
        nuint scratch = VirtualAlloc(0, InfoBytes, MemCommit | MemReserve, PageReadWrite);
        if (scratch == 0) return false;
        Sys.WriteAddress(block + Tls.StackBase, StackTop(scratch));
        VirtualFree(scratch, 0, MemRelease);
        return true;
    }

    /// A THREAD C CALLS IN FROM is given a block the first time it comes
    /// (every export's way in, Lowering.EnterFromC): one the loading thread
    /// already has, and one made by the program the image was loaded into
    /// does not. Registered stopped, as a thread another starts is; the
    /// export's ReturnFromC says it is running.
    public static void Enter()
    {
        if (Sys.ThreadBlock() == 0) Adopt();
    }

    static void Adopt()
    {
        // The block, and after it the scratch StackTop fills.
        nuint block = VirtualAlloc(0, Tls.Bytes + InfoBytes, MemCommit | MemReserve, PageReadWrite);
        if (block == 0) ExitProcess(137);
        nuint top = StackTop(block + Tls.Bytes);
        Sys.WriteAddress(block + Tls.Self, block);
        Sys.SetThreadBlock(block);
        Runtime.RegisterThread(block, top);
    }

    /// A THREAD GOING AWAY (DLL_THREAD_DETACH): one this image gave a block
    /// to is the collector's no longer, and its block goes back. The loading
    /// thread's block is static memory, and stays.
    public static void ThreadDetach()
    {
        nuint block = Sys.ThreadBlock();
        if (block == 0) return;
        Runtime.EndBlocking();
        Runtime.EndThread();
        Sys.SetThreadBlock(0);
        if (block != Sys.MainThreadBlock()) VirtualFree(block, 0, MemRelease);
    }

    /// THE WAY INTO Runtime.NullFault from a fault, made once: Fault cannot
    /// build the call on the faulting stack, where Windows has just put the
    /// context it is handing over, so it sends the thread here with the
    /// faulting instruction in EAX and its frame in EDX, and this builds it:
    /// NullFault(frame, pc), its return address the faulting instruction, as
    /// if that instruction had called it; the stack aligned as a call leaves it.
    static nuint NullStub()
    {
        nuint stub = VirtualAlloc(0, 32, MemCommit | MemReserve, PageExecuteReadWrite);
        if (stub == 0) return 0;
        nuint entry = Sys.AddressOf(Runtime.NullFault);
        nuint at = 0;
        Sys.Write8(stub + at++, 0x83); Sys.Write8(stub + at++, 0xE4); Sys.Write8(stub + at++, 0xF0); // and esp, -16
        Sys.Write8(stub + at++, 0x83); Sys.Write8(stub + at++, 0xEC); Sys.Write8(stub + at++, 0x08); // sub esp, 8: after the three pushes, aligned as a call leaves it
        Sys.Write8(stub + at++, 0x50);                                                                  // push eax   pc
        Sys.Write8(stub + at++, 0x52);                                                                  // push edx   frame
        Sys.Write8(stub + at++, 0x50);                                                                  // push eax   the return address
        Sys.Write8(stub + at++, 0xB9);                                                                  // mov ecx, NullFault
        for (int i = 0; i < 4; i++) Sys.Write8(stub + at++, (byte)(entry >> (8 * i)));
        Sys.Write8(stub + at++, 0xFF); Sys.Write8(stub + at++, 0xE1);                                 // jmp ecx
        return stub;
    }

    /// THE SEH HANDLER every way in from C registers (Lowering.SehEnter),
    /// called by Windows with the exception's record, the registration, the
    /// context and the dispatcher's word. An access violation by this image's
    /// own code at a null address (Runtime.NullFaultCatchable) goes on as a
    /// NullReferenceException: the thread continues in NullStub. Anything
    /// else -- another exception, a fault in code that is not ours, a fault
    /// in the collector -- is searched on for whoever else handles it.
    /// EXCEPTION_RECORD: ExceptionCode at 0, ExceptionFlags 4,
    /// NumberParameters 16, the address 24. CONTEXT: Edx 0xA8, Eax 0xB0,
    /// Ebp 0xB4, Eip 0xB8, Esp 0xC4.
    public static int Fault(nuint rec, nuint registration, nuint ctx, nuint dispatcher)
    {
        if ((Sys.Read32(rec + 4) & Unwinding) != 0) return ContinueSearch;
        if (Sys.Read32(rec) != AccessViolation || _nullStub == 0 || Sys.Read32(rec + 16) < 2) return ContinueSearch;
        nuint pc = Sys.Read32(ctx + 0xB8);
        // Ours: this image's code, or code of an image over it that the
        // runtime knows by its frames (Runtime.KnowsCode).
        if ((pc < _imageStart || pc >= _imageEnd) && !Runtime.KnowsCode(pc)) return ContinueSearch;
        // The address read or written. Windows 9x gives -1 there, and the
        // faulting instruction says it instead (FaultAddress).
        nuint address = Sys.Read32(rec + 24);
        if (address == NoAddress) address = FaultAddress(ctx, pc);
        if (address == NoAddress || !Runtime.NullFaultCatchable(address)) return ContinueSearch;

        // CONTEXT's registers are DWORDs: Eax, Edx (the frame), Eip. A leaf
        // that gave EBP a value has its frame found by its prologue
        // (Runtime.FrameAt), and EBP made that frame again, so NullFault's
        // prologue links to it as a call from there would.
        nuint frame = Runtime.FrameAt(pc, Sys.Read32(ctx + 0xC4), Sys.Read32(ctx + 0xB4));
        Sys.Write32(ctx + 0xB4, Sys.Low32(frame));
        Sys.Write32(ctx + 0xB0, Sys.Low32(pc));
        Sys.Write32(ctx + 0xA8, Sys.Low32(frame));
        Sys.Write32(ctx + 0xB8, Sys.Low32(_nullStub));
        return ContinueExecution;
    }

    /// THE ADDRESS AN INSTRUCTION FAULTED ON, read from the instruction itself
    /// where Windows 9x does not say it (its access violation's address is
    /// -1): the memory operand's base, index times scale and displacement,
    /// with the registers the context holds. For the forms this compiler's
    /// code uses -- a ModRM operand after a one- or two-byte opcode, or the
    /// accumulator's absolute moves (A0-A3) -- and -1 for anything else, or
    /// for an operand through FS or GS, which is never a null reference's.
    static nuint FaultAddress(nuint ctx, nuint pc)
    {
        nuint at = pc;
        int b = Sys.Read8(at);
        // Prefixes: operand size, repeats, lock, the segments but FS and GS.
        while (b is 0x66 or 0x67 or 0xF0 or 0xF2 or 0xF3 or 0x26 or 0x2E or 0x36 or 0x3E)
        {
            at++;
            b = Sys.Read8(at);
        }
        if (b is 0x64 or 0x65) return NoAddress;
        if (b is >= 0xA0 and <= 0xA3) return Sys.Read32(at + 1);
        bool modrm;
        if (b == 0x0F)
        {
            at++;
            int c = Sys.Read8(at);
            modrm = c is (>= 0x10 and <= 0x17) or (>= 0x28 and <= 0x2F) or (>= 0x40 and <= 0x4F) or (>= 0x90 and <= 0x9F)
                or 0xA3 or 0xA4 or 0xA5 or 0xAB or 0xAC or 0xAD or 0xAF or (>= 0xB0 and <= 0xB7) or (>= 0xBA and <= 0xBF)
                or 0xC0 or 0xC1 or 0xC7;
        }
        else
        {
            modrm = (b < 0x40 && (b & 7) < 4) || b is 0x62 or 0x63 or 0x69 or 0x6B or (>= 0x80 and <= 0x8F) or 0xC0 or 0xC1
                or (>= 0xC4 and <= 0xC7) or (>= 0xD0 and <= 0xD3) or (>= 0xD8 and <= 0xDF) or 0xF6 or 0xF7 or 0xFE or 0xFF;
        }
        if (!modrm) return NoAddress;
        at++;
        int m = Sys.Read8(at);
        int mod = m >> 6, rm = m & 7;
        if (mod == 3) return NoAddress;
        at++;
        nuint address = 0;
        if (rm == 4)
        {
            int sib = Sys.Read8(at);
            at++;
            int scale = sib >> 6, index = (sib >> 3) & 7, bas = sib & 7;
            if (index != 4) address = Register(ctx, index) << scale;
            if (bas == 5 && mod == 0)
            {
                address = address + Sys.Read32(at);
                at = at + 4;
            }
            else address = address + Register(ctx, bas);
        }
        else if (rm == 5 && mod == 0)
        {
            address = Sys.Read32(at);
            at = at + 4;
        }
        else address = Register(ctx, rm);
        if (mod == 1) address = address + (nuint)(long)(sbyte)Sys.Read8(at);
        else if (mod == 2) address = address + (nuint)(long)(int)Sys.Read32(at);
        return address;
    }

    /// A general register as CONTEXT holds it, by its encoding: EAX ECX EDX EBX ESP EBP ESI EDI.
    static nuint Register(nuint ctx, int number)
    {
        nuint offset = number switch { 0 => 0xB0, 1 => 0xAC, 2 => 0xA8, 3 => 0xA4, 4 => 0xC4, 5 => 0xB4, 6 => 0xA0, _ => 0x9C };
        return Sys.Read32(ctx + offset);
    }

    /// A PROGRAM'S IMAGE: the module the process was started from (its handle is its base).
    public static nuint ProgramImage() => GetModuleHandleW(0);

    /// The process ends, with `code`: a program that could not even start.
    public static void Fail(int code) => ExitProcess(code);

    /// Nanoseconds by the performance counter, for Clock.
    public static long NowNanos() => Nanos(0, 0, 0);

    // ---- a wait on a word ------------------------------------------------
    //
    // Windows 2000 has no WaitOnAddress. A wait parks on one of ParkBuckets
    // semaphores, chosen by the word's address, after counting itself among
    // its bucket's waiters and reading the word once more; a wake releases as
    // many as wait there. A waiter counted before its last read cannot miss a
    // wake made after the word changed. Words that share a bucket wake each
    // other now and then, which every caller allows: each reads its word
    // again. Made in Attach, in memory of its own: a wait may be the
    // collector's, with nothing to be had of the heap.
    const int ParkBuckets = 64;
    static nuint _parkSemaphores;
    static nuint _parkWaiters;

    static bool MakeParking()
    {
        if (_parkSemaphores != 0) return true;
        nuint table = VirtualAlloc(0, ParkBuckets * 8, MemCommit | MemReserve, PageReadWrite);
        if (table == 0) return false;
        for (int i = 0; i < ParkBuckets; i++)
        {
            nuint semaphore = CreateSemaphoreA(0, 0, 0x7FFFFFFF, 0);
            if (semaphore == 0) return false;
            Sys.Write32(table + 4 * (nuint)i, Sys.Low32(semaphore));      // a HANDLE is 32 bits here
        }
        _parkWaiters = table + 4 * ParkBuckets;
        _parkSemaphores = table;
        return true;
    }

    static nuint Bucket(nuint at) => ((at >> 2) * 0x9E3779B1 >> 26) & (ParkBuckets - 1);

    /// Waits while the word at `at` is `expect`, for at most `milliseconds`
    /// (-1, none -- looked at again each second all the same).
    public static void Park(nuint at, int expect, int milliseconds)
    {
        nuint b = Bucket(at);
        nuint waiters = _parkWaiters + b * 4;
        Sys.AtomicAdd32(waiters, 1);
        if (Sys.Read32(at) == (uint)expect)
            WaitForSingleObject(Sys.Read32(_parkSemaphores + b * 4), milliseconds < 0 || milliseconds > 1000 ? 1000 : milliseconds);
        Sys.AtomicAdd32(waiters, -1);
    }

    /// Wakes up to `count` of what waits on the word at `at`.
    public static void Unpark(nuint at, int count)
    {
        nuint b = Bucket(at);
        uint waiting = Sys.Read32(_parkWaiters + b * 4);
        if (waiting == 0) return;
        uint wake = (uint)count;
        ReleaseSemaphore(Sys.Read32(_parkSemaphores + b * 4), wake < waiting ? wake : waiting, 0);
    }

    /// The runtime is running: what wants it.
    public static void Started()
    {
        Pin();
    }

    /// LOADED ONCE, LOADED FOR GOOD, as native AOT's DLLs are: the runtime
    /// cannot give back its heap or the blocks of threads still alive, so a
    /// FreeLibrary and LoadLibrary pair -- Quake 2's vid_restart -- would leak
    /// both every time. Its own name loaded once more, which for a module
    /// already loaded only counts it again (GetModuleHandleEx's pin is XP's).
    /// The name in a page of its own, given back after: nothing here asks the
    /// heap, so a DLL that allocates nothing carries no collector.
    static void Pin() => PinImage(_imageStart);

    /// An image loaded for good: its own name loaded once more (Pin). An
    /// image over the runtime DLL pins itself so (Lowering.EmitImageAttach):
    /// the runtime holds its statics and frames from then on.
    public static void PinImage(nuint instance)
    {
        nuint name = VirtualAlloc(0, 264, MemCommit | MemReserve, PageReadWrite);
        if (name == 0) return;
        int length = GetModuleFileNameA(instance, name, 260);
        if (length > 0 && length < 260) LoadLibraryA(name);
        VirtualFree(name, 0, MemRelease);
    }

    /// THE WORDS AN IMPORT'S ADDRESS GOES IN, filled as an image over the
    /// runtime DLL starts and before any of its code runs (Linker DataImports):
    /// each entry of the table from `table` to `end` is two RVAs, a word of the
    /// image and the import address table slot the loader filled with what
    /// the word names, and the word, which holds only the addend, gets that
    /// address added. Windows' loader fills the slots, data's as well as
    /// functions'; it has no relocation that names another image's symbol,
    /// and this is that relocation. Every section is made writable for the
    /// while, and each is given back the protection it had.
    public static void FillImports(nuint instance, nuint table, nuint end)
    {
        if (table == end) return;
        nuint pe = instance + Sys.Read32(instance + 0x3C);
        nuint sections = Sys.Read16(pe + 6);
        nuint headers = pe + 24 + Sys.Read16(pe + 20);
        // A word of protection kept for each section, in a page of its own.
        nuint kept = VirtualAlloc(0, sections * 4 + 4, MemCommit | MemReserve, PageReadWrite);
        if (kept == 0) ExitProcess(137);
        for (nuint i = 0; i < sections; i++)
        {
            nuint header = headers + i * 40;
            VirtualProtect(instance + Sys.Read32(header + 12), Sys.Read32(header + 8), PageExecuteReadWrite, kept + i * 4);
        }
        for (nuint at = table; at < end; at = at + 8)
        {
            nuint word = instance + Sys.Read32(at);
            nuint slot = instance + Sys.Read32(at + 4);
            Sys.Write32(word, Sys.Read32(word) + Sys.Read32(slot));
        }
        for (nuint i = 0; i < sections; i++)
        {
            nuint header = headers + i * 40;
            VirtualProtect(instance + Sys.Read32(header + 12), Sys.Read32(header + 8), Sys.Read32(kept + i * 4), kept + sections * 4);
        }
        VirtualFree(kept, 0, MemRelease);
    }

    /// THE TOP OF THIS THREAD'S STACK, where a scan of it ends: the end of
    /// the committed region the stack pointer is in, which is the stack's
    /// top whatever made the thread. VirtualQuery fills MEMORY_BASIC_INFORMATION
    /// at `scratch` (28 bytes; BaseAddress first, RegionSize the fourth word),
    /// which is memory the heap never handed out: this runs before the
    /// thread may allocate.
    static nuint StackTop(nuint scratch)
    {
        VirtualQuery(Sys.FramePointer(), scratch, InfoBytes);
        // BaseAddress and RegionSize are a PVOID and a SIZE_T: 32 bits here.
        return (nuint)Sys.Read32(scratch) + Sys.Read32(scratch + 12);
    }

    /// Zeroed pages, or 0: VirtualAlloc's are zeroed.
    static nuint Map(nuint bytes, nuint b, nuint c)
    {
        return VirtualAlloc(0, bytes, MemCommit | MemReserve, PageReadWrite);
    }

    /// Given back by DECOMMIT: the heap gives back pieces of what it was
    /// mapped, and only a whole reservation can be released -- AND THEN THE
    /// RESERVATION RELEASED, once none of it is committed any more. A
    /// decommitted reservation keeps its addresses, and VirtualAlloc never
    /// hands them out again: every chunk the heap mapped and gave back was
    /// address space lost for good, at least 64 KB a time. A game's ICD
    /// mapped and gave back two large arrays a frame, and Half-Life's own
    /// calloc ran out of address space after five minutes (CORSAC on the
    /// K8, 2026-10-30: 31,050 maps and unmaps, the address space a wall of
    /// reserved holes).
    static nuint Unmap(nuint at, nuint bytes, nuint c)
    {
        // One query at a time through the buffer made for it the first time:
        // the heap gives back from more than one thread. A holder put off
        // the processor is waited for, not spun at: Sleep(0) yields only to
        // threads of the waiter's priority or above, so after a few turns
        // Sleep(1), which lets a lower-priority holder run.
        nuint lockWord = Sys.AddressOf(ref _querying);
        for (int turn = 0; Sys.Cas32(lockWord, 0, 1) != 0; turn++) Sleep(turn < 16 ? 0 : 1);
        try
        {
            // The reservation asked for while `at` is still ours: decommitted
            // first, a reservation another thread then released and a third
            // made over the same addresses would have been taken for ours.
            if (_query == 0) _query = VirtualAlloc(0, InfoBytes, MemCommit | MemReserve, PageReadWrite);
            nuint info = _query;
            nuint reservation = info != 0 && VirtualQuery(at, info, InfoBytes) != 0 ? Sys.Read32(info + 4) : 0;
            VirtualFree(at, bytes, MemDecommit);
            if (reservation == 0) return 0;
            // MEMORY_BASIC_INFORMATION: BaseAddress, AllocationBase,
            // AllocationProtect, RegionSize, State -- 32 bits each here.
            // Every run of the reservation in turn, from its base: any still
            // committed keeps it.
            nuint walk = reservation;
            while (true)
            {
                if (VirtualQuery(walk, info, InfoBytes) == 0 || Sys.Read32(info + 4) != reservation) break;
                if (Sys.Read32(info + 16) == MemCommit) return 0;
                nuint size = Sys.Read32(info + 12);
                if (size == 0) return 0;
                walk = walk + size;
            }
            VirtualFree(reservation, 0, MemRelease);
            return 0;
        }
        finally { Sys.AtomicSwap32(lockWord, 0); }
    }

    static nuint _query;
    static int _querying;

    /// The performance counter as nanoseconds, or the tick count's
    /// milliseconds on a machine without one.
    static long Nanos(nuint a, nuint b, nuint c)
    {
        if (_frequency == 0 && QueryPerformanceFrequency(Sys.AddressOf(ref _frequency)) == 0) _frequency = -1;
        if (_frequency < 0) { long ticks = GetTickCount(); return ticks * 1000000; }
        QueryPerformanceCounter(Sys.AddressOf(ref _count));
        long seconds = _count / _frequency;
        return seconds * 1000000000 + (_count - seconds * _frequency) * 1000000000 / _frequency;
    }

    /// A TURN OF A WAIT (Platform.WaitHook), and a spin's offer to the others
    /// (Platform.YieldHook): the word waited for is another thread's to
    /// change, so this one gives up the rest of its time slice.
    /// Sleep(0), which every Windows has; nothing wakes a sleeper, which
    /// looks again on its next turn.
    static nuint Yield(nuint at, nuint value, nuint c)
    {
        Sleep(0);
        return 0;
    }

    [DllImport("kernel32")] static extern void GetSystemInfo(nuint info);

    /// How many processors (Os.ProcessorCount): SYSTEM_INFO's count, at 20.
    static nuint Processors(nuint a, nuint b, nuint c)
    {
        byte[] info = new byte[36];
        GetSystemInfo(Sys.ArrayData(info));
        return (nuint)(info[20] | (info[21] << 8) | (info[22] << 16) | (info[23] << 24));
    }

    static nuint Exit(nuint code, nuint b, nuint c)
    {
        ExitProcess((int)code);
        return 0;
    }

    /// What the runtime prints -- an unhandled exception's report -- goes to
    /// the process's standard error, when it has one (Platform.WriteHook).
    static nuint Write(int fd, nuint address, nuint count)
    {
        nuint handle = GetStdHandle(StdErrorHandle);
        if (handle == 0 || handle == InvalidHandle) return 0;
        long written = 0;
        WriteFile(handle, address, (int)count, Sys.AddressOf(ref written), 0);
        return count;
    }
}
