// The Windows facts of threading: the clock and sleeping, a wait on a word
// and its wake, and how a Thread is launched -- under the names the
// scheduler (runtime/src/core/threading.cor) and every hosted platform's
// threads (runtime/src/platforms/threads.cor) ask for: Clock, Native and
// Thread's launch. Windows 2000 is the floor: no WaitOnAddress, so a wait on
// a word parks on one of a few semaphores chosen by the word's address
// (Win32.Park), and a wake releases what waits there.

static class Clock
{
    const long NanosPerMilli = 1000000;

    [DllImport("kernel32")] static extern void Sleep(int milliseconds);

    /// Nanoseconds by the performance counter (Win32.NowNanos).
    public static long Now() => Win32.NowNanos();

    public static long NowMicroseconds() => Now() / 1000;

    public static long NowMilliseconds() => Now() / NanosPerMilli;

    /// Sleeps until the clock reaches `deadline`, as stopped to a collection
    /// for the while; a console's Ctrl+C that came meanwhile is delivered.
    public static void SleepUntil(long deadline)
    {
        long left = deadline - Now();
        if (left > 0)
        {
            Runtime.BeginBlocking();
            Sleep((int)((left + NanosPerMilli - 1) / NanosPerMilli));
            Runtime.EndBlocking();
        }
        if (PosixSignalRegistration.Pending) PosixSignalRegistration.Deliver();
    }
}

static class Native
{
    /// Linux's: where a thread's own mapping says its length. A Windows thread
    /// stands on the stack Windows gave it and has no mapping to give back.
    public const int UnmapLengthAt = 4096 - 8;

    public const int WakeAll = 0x7FFFFFFF;

    [DllImport("kernel32"), SuppressGCTransition] static extern int GetCurrentThreadId();

    public static long CurrentThreadId() => GetCurrentThreadId();

    /// Sleeps until the word at `at` stops being `expect`, or someone wakes it;
    /// a spurious return is normal, every caller reads its word again. Asleep
    /// is stopped, as far as a collection is concerned (Linux's note).
    public static void Wait(nuint at, int expect)
    {
        Runtime.BeginBlocking();
        Win32.Park(at, expect, -1);
        Runtime.EndBlocking();
    }

    /// As Wait, giving up after `nanoseconds`.
    public static void WaitFor(nuint at, int expect, long nanoseconds)
    {
        long ms = (nanoseconds + 999999) / 1000000;
        Runtime.BeginBlocking();
        Win32.Park(at, expect, ms > 0x7FFFFFFF ? 0x7FFFFFFF : (int)ms);
        Runtime.EndBlocking();
    }

    /// Wakes up to `count` waiters on the word at `at`.
    public static void Wake(nuint at, int count) => Win32.Unpark(at, count);
}

namespace System.Threading
{
partial class Thread
{
    [DllImport("kernel32")] static extern nuint CreateThread(nuint security, nuint stack, nuint start, nuint argument, int flags, nuint id);
    [DllImport("kernel32")] static extern int CloseHandle(nuint handle);
    [DllImport("kernel32"), SuppressGCTransition] static extern nuint VirtualAlloc(nuint at, nuint bytes, int type, int protect);

    /// The start routine Windows calls, `DWORD WINAPI start(LPVOID)`, made
    /// once: a stub on a page of its own that calls ThreadEntry(slot) by this
    /// compiler's convention -- the slot one word -- and returns 0,
    /// taking its argument off. Not a method C calls ([UnmanagedCallersOnly]):
    /// that would give the new thread a block of its own on the way in, and
    /// it has one already, made and registered by its parent (Launch).
    static nuint _windowsEntry;

    static nuint WindowsEntry()
    {
        if (_windowsEntry != 0) return _windowsEntry;
        nuint stub = VirtualAlloc(0, 32, 0x3000, 0x40);    // MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE
        if (stub == 0) return 0;
        nuint entry = Sys.AddressOf(Thread.ThreadEntry);
        nuint at = 0;
        Sys.Write8(stub + at++, 0x8B); Sys.Write8(stub + at++, 0x44); Sys.Write8(stub + at++, 0x24); Sys.Write8(stub + at++, 0x04); // mov eax, [esp+4]
        Sys.Write8(stub + at++, 0x50);                                                                                               // push eax   slot
        Sys.Write8(stub + at++, 0xB9);                                                                                               // mov ecx, ThreadEntry
        for (int i = 0; i < 4; i++) Sys.Write8(stub + at++, (byte)(entry >> (8 * i)));
        Sys.Write8(stub + at++, 0xFF); Sys.Write8(stub + at++, 0xD1);                                                              // call ecx
        Sys.Write8(stub + at++, 0x83); Sys.Write8(stub + at++, 0xC4); Sys.Write8(stub + at++, 0x04);                            // add esp, 4
        Sys.Write8(stub + at++, 0x31); Sys.Write8(stub + at++, 0xC0);                                                              // xor eax, eax
        Sys.Write8(stub + at++, 0xC2); Sys.Write8(stub + at++, 0x04); Sys.Write8(stub + at++, 0x00);                            // ret 4
        _windowsEntry = stub;
        return stub;
    }

    /// A Windows thread, on the stack Windows gives it: its block a page of
    /// the runtime's, registered stopped with an empty stack before the
    /// thread exists, as a C library's thread is on Linux (LaunchNative there);
    /// the thread says where its stack is once it stands on it (BeginNative).
    void Launch()
    {
        nuint block = Platform.Map(4096);
        if (block == 0) throw new InvalidOperationException("threading: no memory for a thread block");
        nuint start = WindowsEntry();
        if (start == 0) throw new InvalidOperationException("threading: no memory for the thread start");
        _block = block;
        _stack = 0;
        _stackBytes = 0;
        Runtime.RegisterThread(_block, 0);
        int id = 0;
        nuint handle = CreateThread(0, StackSize(), start, (nuint)_slot, 0, Sys.AddressOf(ref id));
        if (handle == 0)
        {
            Runtime.ForgetThread(_block);
            throw new InvalidOperationException("threading: CreateThread failed");
        }
        // Nobody joins it through Windows: Join waits on the thread's own word.
        CloseHandle(handle);
        _id = id;
    }

    /// Where a Windows thread begins (WindowsEntry's stub calls it).
    static int ThreadEntry(int slot)
    {
        Thread? t = _all[slot];
        if (t != null) t.BeginNative(Sys.FramePointer());
        return 0;
    }
}
}
