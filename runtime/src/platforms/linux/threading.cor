// The Linux half of the scheduler: what needs a kernel.
//
// lib/threading.cor is the scheduler and the tasks, and it makes no system
// call at all: it asks for the time, for a sleep until a deadline, for a
// wait and a wake on a word, and for a thread -- through the names Clock,
// Native and Thread. This file is those names on Linux: clock_gettime and
// nanosleep, futexes, clone(2) with a stack of its own, and the pool of
// worker threads Scheduler.UseThreads starts. runtime/src/arch/x86/baremetal.cor answers
// the same names with the PIT and no threads, which is how the same
// scheduler runs in the bootloader and the kernel.

static partial class Scheduler
{
    /// Runs posted work on `count` threads from now on. Zero leaves the
    /// single-threaded event loop alone, which is the default.
    ///
    /// Call it once, before the work starts. Pool work may allocate and may
    /// throw: each worker has a block of its own, and an exception that escapes
    /// a work item is reported exactly as one on the event loop is.
    public static void UseThreads(int count)
    {
        if (count < 0)
        {
            throw new ArgumentOutOfRangeException("count");
        }
        if (count == 0)
        {
            return;
        }
        if (_workers > 0)
        {
            throw new InvalidOperationException("the scheduler already has worker threads");
        }

        Gate();
        SignalCell();

        // Grown once, here, so that a Post from a worker does not have to
        // allocate with the queue's lock held.
        Reserve(1024);

        _workers = count;

        for (int i = 0; i < count; i++)
        {
            System.Threading.Thread.Start(new PoolWorker());
        }
    }
}

/// .NET's own way to ask for a pool of a size, and the one a program
/// compiled by both can call: SetMinThreads starts the scheduler's workers
/// (Scheduler.UseThreads), once -- a later call leaves them as they are.
/// corc asks for its --jobs this way; an #if !NET around UseThreads was
/// never compiled, as corc defines NET for the framework it builds for.
static partial class ThreadPool
{
    public static bool SetMinThreads(int workerThreads, int completionPortThreads)
    {
        if (workerThreads < 0 || completionPortThreads < 0) return false;
        if (Scheduler.ThreadCount == 0 && workerThreads > 0) Scheduler.UseThreads(workerThreads);
        return true;
    }
}

static partial class Scheduler
{
    /// How many worker threads UseThreads started: zero for the event loop alone.
    public static int ThreadCount => _workers;
}

/// The monotonic clock and sleeping, through Linux system calls.
///
/// (These belong to runtime/src/platforms/linux/system.cor in spirit -- they are the only Linux
/// facts in this file -- and move there when a second target needs its own.)
static class Clock
{
    const long ClockGettime = Call.ClockGetTime;      // (clockid, struct timespec *)
    const long ClockNanosleep = Call.ClockNanosleep;  // (clockid, flags, request, remain)
    const long Nanosleep = Call.NanoSleep;            // (request, remain)
    const long Monotonic = 1;           // CLOCK_MONOTONIC
    const long AbsoluteTime = 1;        // TIMER_ABSTIME
    const long NoSys = -38;             // -ENOSYS
    const long NanosPerSecond = 1000000000;

    /// Nanoseconds on CLOCK_MONOTONIC. The timespec is two words, seconds
    /// then nanoseconds -- 32 bits each on i386, 64 in long mode; neither
    /// is negative for this clock.
    public static long Now()
    {
        // Thread-local syscall storage is available before any allocation.
        // Clock reads do not retain it or dispatch managed signal handlers.
        long at = Sys.ThreadBlock() + Tls.Scratch;
        Sys.Poke(at, 0);
        Sys.Poke(at + WordSize.Bytes, 0);

        Sys.Syscall(ClockGettime, Monotonic, at, 0);

        long seconds = Sys.Peek(at);
        long nanos = Sys.Peek(at + WordSize.Bytes);

        return seconds * NanosPerSecond + nanos;
    }

    /// Microseconds on the same clock: what the collector times its pauses
    /// by (Gc.PauseClock).
    public static long NowMicroseconds()
    {
        return Now() / 1000;
    }

    /// Milliseconds on the same clock, for programs that measure.
    public static long NowMilliseconds()
    {
        return Now() / 1000000;
    }

    /// Returns once CLOCK_MONOTONIC has reached `deadline`, or early on a
    /// signal (the caller re-checks the clock anyway).
    public static void SleepUntil(long deadline)
    {
        // The kernel consumes this timespec during the syscall. Signal
        // callbacks run only afterwards; the fallback rewrites it after Now.
        long at = Sys.ThreadBlock() + Tls.Scratch;

        Sys.Poke(at, deadline / NanosPerSecond);
        Sys.Poke(at + WordSize.Bytes, deadline % NanosPerSecond);

        // Asleep is stopped, as far as a collection is concerned: see the note
        // on Native.Wait.
        Runtime.BeginBlocking();

        long result = Platform.Result(Sys.Syscall(ClockNanosleep, Monotonic, AbsoluteTime, at, 0, 0, 0));

        Runtime.EndBlocking();

        if (result == 0 - Err.Intr || PosixSignalRegistration.Pending)
        {
            // A signal ended the sleep, or came just before it: the program's handlers run now, at
            // the same quiet moment Os.Poll and Os.Sleep give them.
            PosixSignalRegistration.Deliver();
        }

        if (result != NoSys)
        {
            return;
        }

        // A kernel without clock_nanosleep: sleep for the remaining interval.
        long left = deadline - Now();

        if (left <= 0)
        {
            return;
        }

        Sys.Poke(at, left / NanosPerSecond);
        Sys.Poke(at + WordSize.Bytes, left % NanosPerSecond);
        Runtime.BeginBlocking();
        Sys.Syscall(Nanosleep, at, 0, 0);
        Runtime.EndBlocking();
    }
}

/// The Linux facts a thread needs: clone(2), futex(2), gettid(2), and pages to
/// put a stack in.
///
/// WHY A HAND-ASSEMBLED TRAMPOLINE. clone(2) on i386 returns TWICE, once in
/// each thread, and the child comes back with the stack pointer the call was
/// given and nothing else changed -- same EBP, same return address, same
/// everything. Code compiled from this language addresses its locals through
/// EBP, so a child that simply "returned" from the function holding the system
/// call would run that function's epilogue against the PARENT's frame and
/// return onto the parent's stack: two threads on one stack. Every libc solves
/// this in assembler, and so does this: eighty bytes written into an executable
/// page, called through Sys.Call5, which after the call puts the child on its
/// own stack with a zero frame pointer and jumps to a real function.
static class Native
{
    const long Mmap = Call.Mmap;        // (addr, len, prot, flags, fd, offset)
    const long Clone = Call.Clone;
    const long Futex = Call.Futex;      // (uaddr, op, val, timeout, uaddr2, val3)
    const long GetTid = Call.Gettid;    // () -> the caller's thread id
    const long Exit = Call.Exit;        // (status): THIS thread only
    const long Munmap = Call.Munmap;    // (addr, len)

    /// WHERE A THREAD'S MAPPING SAYS HOW LONG IT IS, for the trampoline to give
    /// it back as the thread ends: the last word of the block's page, which
    /// the block (Tls.Bytes) never reaches and the guard page follows.
    public const long UnmapLengthAt = 4096 - 8;

    const long ProtReadWrite = 3;
    const long ProtReadWriteExec = 7;
    const long MapPrivateAnonymous = 0x22;

    const long FutexWait = 128;         // FUTEX_WAIT | FUTEX_PRIVATE_FLAG
    const long FutexWake = 129;         // FUTEX_WAKE | FUTEX_PRIVATE_FLAG

    /// CLONE_VM | FS | FILES | SIGHAND | THREAD | SYSVSEM: one address space,
    /// one file table, one signal disposition, one thread group -- a thread in
    /// the sense every other language means.
    public const long ThreadFlags = 0x100 | 0x200 | 0x400 | 0x800 | 0x10000 | 0x40000;

    /// Pages that can be read, written and executed, or 0.
    static long MapExecutable(long bytes)
    {
        long got = Sys.Syscall(Mmap, 0, bytes, ProtReadWriteExec, MapPrivateAnonymous, 0 - 1, 0);

        if (Platform.Result(got) < 0)
        {
            return 0;
        }
        return got;
    }

    /// Pages for a thread stack, or 0. A fixed size, not MAP_GROWSDOWN: the
    /// guard page a growing stack needs is the unmapped page below this one.
    public static long MapStack(long bytes)
    {
        long got = Sys.Syscall(Mmap, 0, bytes, ProtReadWrite, MapPrivateAnonymous, 0 - 1, 0);

        if (Platform.Result(got) < 0)
        {
            return 0;
        }
        return got;
    }

    static long _trampoline;

    static long Byte(long at, long value)
    {
        Sys.PokeByte(at, value);
        return at + 1;
    }

    static long Immediate(long at, long value)
    {
        Sys.PokeByte(at, value & 0xFF);
        Sys.PokeByte(at + 1, (value >> 8) & 0xFF);
        Sys.PokeByte(at + 2, (value >> 16) & 0xFF);
        Sys.PokeByte(at + 3, (value >> 24) & 0xFF);
        return at + 4;
    }

    /// The trampoline, written once. Called as
    ///
    ///     tramp(flags, childStackTop, parameters)
    ///
    /// where `parameters` addresses two words, the entry point and the argument
    /// to give it. Three arguments and not four, because Sys.Call is the only
    /// indirect call the x86 backend has and it takes three.
    ///
    /// The parent answers the new thread id (or -errno); the child ends up on
    /// the new stack with a zero frame pointer, calls entry(argument), and ends
    /// itself with exit(2) when that returns.
    static long Trampoline()
    {
        long code = TryTrampoline();

        if (code == 0)
        {
            throw new InvalidOperationException("threading: no executable page for the thread trampoline");
        }
        return code;
    }

    /// The same, or 0 when there is no page for it: what the collector asks,
    /// which may neither throw nor allocate.
    public static long TryTrampoline()
    {
        long code = _trampoline;

        if (code != 0)
        {
            return code;
        }

        code = MapExecutable(4096);

        if (code == 0)
        {
            return 0;
        }

        long at = code;

#if TARGET_AMD64
        // Long mode: called with flags in RDI, the child's stack top in RSI
        // and `parameters` in RDX, as the System V convention delivers the
        // three arguments -- which is also where clone(2) wants the first
        // two. The rest of clone's arguments (parent tid, child tid, tls) are
        // RDX, R10 and R8, all zero: the child sets its own FS.
        at = Byte(at, 0x4C); at = Byte(at, 0x8B); at = Byte(at, 0x02);                        // mov r8,[rdx]      entry
        at = Byte(at, 0x4C); at = Byte(at, 0x8B); at = Byte(at, 0x4A); at = Byte(at, 0x08);   // mov r9,[rdx+8]    argument
        at = Byte(at, 0x48); at = Byte(at, 0x83); at = Byte(at, 0xEE); at = Byte(at, 0x10);   // sub rsi,16
        at = Byte(at, 0x4C); at = Byte(at, 0x89); at = Byte(at, 0x0E);                        // mov [rsi],r9
        at = Byte(at, 0x4C); at = Byte(at, 0x89); at = Byte(at, 0x46); at = Byte(at, 0x08);   // mov [rsi+8],r8
        at = Byte(at, 0x31); at = Byte(at, 0xD2);                                             // xor edx,edx
        at = Byte(at, 0x45); at = Byte(at, 0x31); at = Byte(at, 0xD2);                        // xor r10d,r10d
        at = Byte(at, 0x45); at = Byte(at, 0x31); at = Byte(at, 0xC0);                        // xor r8d,r8d
        at = Byte(at, 0xB8); at = Immediate(at, Clone);                                       // mov eax,56
        at = Byte(at, 0x0F); at = Byte(at, 0x05);                                             // syscall
        at = Byte(at, 0x48); at = Byte(at, 0x85); at = Byte(at, 0xC0);                        // test rax,rax
        at = Byte(at, 0x75); at = Byte(at, 0x27);                                             // jnz parent (+39)

        // The child, on its own stack: [rsp] is the argument, [rsp+8] the
        // entry. Popping both leaves RSP at the sixteen-aligned top, so the
        // call sees the alignment every call does.
        at = Byte(at, 0x31); at = Byte(at, 0xED);                                             // xor ebp,ebp
        at = Byte(at, 0x5F);                                                                  // pop rdi  (argument)
        at = Byte(at, 0x58);                                                                  // pop rax  (entry)
        at = Byte(at, 0xFF); at = Byte(at, 0xD0);                                             // call rax
        // ITS OWN MAPPING GIVEN BACK, by registers alone: the entry answers
        // the mapping's start or 0 (Thread.ChildEntry), its length in the
        // block's page (UnmapLengthAt), every signal already blocked.
        at = Byte(at, 0x48); at = Byte(at, 0x85); at = Byte(at, 0xC0);                        // test rax,rax
        at = Byte(at, 0x74); at = Byte(at, 0x11);                                             // jz exit (+17)
        at = Byte(at, 0x48); at = Byte(at, 0x89); at = Byte(at, 0xC7);                        // mov rdi,rax
        at = Byte(at, 0x48); at = Byte(at, 0x8B); at = Byte(at, 0xB0); at = Immediate(at, UnmapLengthAt); // mov rsi,[rax+UnmapLengthAt]
        at = Byte(at, 0xB8); at = Immediate(at, Munmap);                                      // mov eax,11
        at = Byte(at, 0x0F); at = Byte(at, 0x05);                                             // syscall
        // exit:
        at = Byte(at, 0x31); at = Byte(at, 0xFF);                                             // xor edi,edi
        at = Byte(at, 0xB8); at = Immediate(at, Exit);                                        // mov eax,60
        at = Byte(at, 0x0F); at = Byte(at, 0x05);                                             // syscall
        at = Byte(at, 0xEB); at = Byte(at, 0xFE);                                             // jmp $ (never reached)

        // parent:
        at = Byte(at, 0xC3);                                                                  // ret
#else
        at = Byte(at, 0x53);                                                                  // push ebx (callee-saved)
        at = Byte(at, 0x8B); at = Byte(at, 0x54); at = Byte(at, 0x24); at = Byte(at, 0x10);   // mov edx,[esp+16]  parameters
        at = Byte(at, 0x8B); at = Byte(at, 0x4C); at = Byte(at, 0x24); at = Byte(at, 0x0C);   // mov ecx,[esp+12]  childStackTop
        at = Byte(at, 0x8B); at = Byte(at, 0x02);                                             // mov eax,[edx]     entry
        at = Byte(at, 0x89); at = Byte(at, 0x41); at = Byte(at, 0xFC);                        // mov [ecx-4],eax
        at = Byte(at, 0x8B); at = Byte(at, 0x42); at = Byte(at, 0x04);                        // mov eax,[edx+4]   argument
        at = Byte(at, 0x89); at = Byte(at, 0x41); at = Byte(at, 0xF8);                        // mov [ecx-8],eax
        at = Byte(at, 0x83); at = Byte(at, 0xE9); at = Byte(at, 0x08);                        // sub ecx,8
        at = Byte(at, 0x8B); at = Byte(at, 0x5C); at = Byte(at, 0x24); at = Byte(at, 0x08);   // mov ebx,[esp+8]   flags
        at = Byte(at, 0xB8); at = Immediate(at, Clone);                                       // mov eax,120
        at = Byte(at, 0xCD); at = Byte(at, 0x80);                                             // int 0x80
        at = Byte(at, 0x85); at = Byte(at, 0xC0);                                             // test eax,eax
        at = Byte(at, 0x75); at = Byte(at, 0x28);                                             // jnz parent (+40)

        // The child, on its own stack: [esp] is the argument, [esp+4] the entry.
        at = Byte(at, 0x31); at = Byte(at, 0xED);                                             // xor ebp,ebp
        at = Byte(at, 0x58);                                                                  // pop eax  (argument)
        at = Byte(at, 0x5A);                                                                  // pop edx  (entry)
        at = Byte(at, 0x50);                                                                  // push eax
        at = Byte(at, 0xFF); at = Byte(at, 0xD2);                                             // call edx
        at = Byte(at, 0x83); at = Byte(at, 0xC4); at = Byte(at, 0x04);                        // add esp,4
        // Its own mapping given back by registers alone, as above.
        at = Byte(at, 0x85); at = Byte(at, 0xC0);                                             // test eax,eax
        at = Byte(at, 0x74); at = Byte(at, 0x0F);                                             // jz exit (+15)
        at = Byte(at, 0x89); at = Byte(at, 0xC3);                                             // mov ebx,eax
        at = Byte(at, 0x8B); at = Byte(at, 0x88); at = Immediate(at, UnmapLengthAt);          // mov ecx,[eax+UnmapLengthAt]
        at = Byte(at, 0xB8); at = Immediate(at, Munmap);                                      // mov eax,91
        at = Byte(at, 0xCD); at = Byte(at, 0x80);                                             // int 0x80
        // exit:
        at = Byte(at, 0x31); at = Byte(at, 0xDB);                                             // xor ebx,ebx
        at = Byte(at, 0xB8); at = Immediate(at, Exit);                                        // mov eax,1
        at = Byte(at, 0xCD); at = Byte(at, 0x80);                                             // int 0x80
        at = Byte(at, 0xEB); at = Byte(at, 0xFE);                                             // jmp $ (never reached)

        // parent:
        at = Byte(at, 0x5B);                                                                  // pop ebx
        at = Byte(at, 0xC3);                                                                  // ret
#endif

        _trampoline = code;
        return code;
    }

    /// The two words the trampoline reads, in the same page as the code and so
    /// out of the collector's way entirely. One pair for the whole process:
    /// only the parent reads them, and only before the clone, so a lock around
    /// a launch is all they need.
    // Past the code, which is some eighty bytes.
    const long ParameterOffset = 128;

    static AtomicCell? _launching;

    static AtomicCell LaunchLock()
    {
        AtomicCell? l = _launching;

        if (l == null)
        {
            Atom.CheckLayout();
            l = new AtomicCell();
            _launching = l;
        }
        return l;
    }

    /// Starts a thread that runs `entry(argument)` on a stack of its own.
    /// Answers the new thread id, or a negative errno.
    public static long Spawn(long entry, long argument, long stackTop)
    {
        long code = Trampoline();
        AtomicCell gate = LaunchLock();

        gate.Enter();

        long parameters = code + ParameterOffset;

        Sys.Poke(parameters, entry);
        Sys.Poke(parameters + WordSize.Bytes, argument);

        long id = Platform.Result(Sys.CallNative(code, ThreadFlags, stackTop, parameters));

        gate.Exit();
        return id;
    }

    /// A thread with no Thread of its own -- the collector's workers: entry
    /// runs on the pages [stack, stack + bytes), whose lowest two words carry
    /// its entry and argument to the trampoline, so no lock and no shared
    /// page are needed and nothing is allocated. The thread id, or -errno.
    public static long SpawnBare(long entry, long argument, long stack, long bytes)
    {
        long code = TryTrampoline();

        if (code == 0)
        {
            return 0 - 12;      // ENOMEM
        }
        Sys.Poke(stack, entry);
        Sys.Poke(stack + WordSize.Bytes, argument);
        return Platform.Result(Sys.CallNative(code, ThreadFlags, stack + bytes, stack));
    }

    public static long CurrentThreadId()
    {
        return Sys.Syscall(GetTid, 0, 0, 0);
    }

    /// Sleeps until the word at `at` stops being `expect`, or until someone
    /// wakes it. A spurious return is normal: every caller re-reads the word.
    ///
    /// A thread asleep here is a thread that will not allocate until somebody
    /// wakes it, and the collector stops the world by waiting for every other
    /// thread to say it has stopped: without the pair around the call, a
    /// collection while any worker was idle would wait for that worker and the
    /// worker would wait for the work that the collection is in the way of.
    public static void Wait(long at, long expect)
    {
        Runtime.BeginBlocking();
        Sys.Syscall(Futex, at, FutexWait, expect, 0, 0, 0);
        Runtime.EndBlocking();
    }

    /// As Wait, giving up after `nanoseconds` -- FUTEX_WAIT's timeout, which
    /// is relative. A return by timeout, wake or signal looks the same; every
    /// caller re-reads its word and its clock.
    public static void WaitFor(long at, long expect, long nanoseconds)
    {
        long timeout = Sys.ThreadBlock() + Tls.Scratch;
        // A timespec is two words, whatever the word is: 32-bit halves at 0
        // and 4 were a garbage timeout on every timed wait in long mode.
        Sys.Poke(timeout, nanoseconds / 1000000000);
        Sys.Poke(timeout + WordSize.Bytes, nanoseconds % 1000000000);
        Runtime.BeginBlocking();
        Sys.Syscall(Futex, at, FutexWait, expect, timeout, 0, 0);
        Runtime.EndBlocking();
    }

    /// Wakes up to `count` waiters on the word at `at`.
    public static void Wake(long at, long count)
    {
        Sys.Syscall(Futex, at, FutexWake, count, 0, 0, 0);
    }

    public const long WakeAll = 0x7FFFFFFF;
}

namespace Microsoft.Win32.SafeHandles
{
    /// WHAT IS UNDER A WaitHandle, as .NET's SafeWaitHandle: the object its
    /// waits wait on (Target) and the number .NET would have from the kernel
    /// -- one the runtime gives it on the first ask, there being no kernel
    /// object. A handle made from a number another SafeWaitHandle answered
    /// is under the same object; from any other, under nothing. Closed once:
    /// the last of a named Mutex's closed gives the name up.
    public sealed class SafeWaitHandle : IDisposable
    {
        System.Threading.WaitHandle? _target;
        nint _handle;
        bool _closed;

        static nint _next = 0x1000;
        static List<SafeWaitHandle>? _numbered;
        static AtomicCell _numbering = new AtomicCell();

        public SafeWaitHandle() { _handle = -1; }

        public SafeWaitHandle(IntPtr existingHandle, bool ownsHandle)
        {
            _handle = existingHandle;
            _numbering.Enter();
            try
            {
                List<SafeWaitHandle>? numbered = _numbered;
                if (numbered != null)
                {
                    for (int i = 0; i < numbered.Count; i++)
                    {
                        if (numbered[i]._handle == existingHandle && !numbered[i]._closed) _target = numbered[i]._target;
                    }
                }
            }
            finally
            {
                _numbering.Exit();
            }
        }

        internal SafeWaitHandle(System.Threading.WaitHandle target)
        {
            _target = target;
        }

        /// What waits wait on; null once closed, or with nothing under it.
        internal System.Threading.WaitHandle? Target => _closed ? null : _target;

        public bool IsClosed => _closed;
        public bool IsInvalid => _target == null && (_handle == 0 || _handle == -1);

        public IntPtr DangerousGetHandle()
        {
            if (_handle == 0 && _target != null)
            {
                _numbering.Enter();
                try
                {
                    if (_handle == 0)
                    {
                        _next = _next + 4;
                        _handle = _next;
                        (_numbered ??= new List<SafeWaitHandle>()).Add(this);
                    }
                }
                finally
                {
                    _numbering.Exit();
                }
            }
            return _handle;
        }

        public void DangerousAddRef(ref bool success)
        {
            ObjectDisposedException.ThrowIf(_closed, this);
            success = true;
        }

        public void DangerousRelease()
        {
        }

        public void SetHandleAsInvalid()
        {
            _closed = true;
        }

        public void Close()
        {
            Dispose();
        }

        public void Dispose()
        {
            if (_closed) return;
            _closed = true;
            if (_handle != 0 && _handle != -1)
            {
                _numbering.Enter();
                try { _numbered?.Remove(this); }
                finally { _numbering.Exit(); }
            }
            if (_target is System.Threading.Mutex shared && shared.Key != null)
            {
                System.Threading.NamedMutexes.Closed(shared);
            }
        }
    }
}

// THREADS ARE System.Threading's, as .NET's are: Thread, its two delegates
// and ThreadStateException, by the names .NET gives them.
namespace System.Threading
{

/// A thread of execution, started with a body to run.
///
/// A thread body may allocate, throw and catch like any other code: the
/// handler chain and the allocation buffer are words of the block this class
/// gives every thread it starts (runtime/src/core/runtime.cor, class Tls), and the
/// collector is told where the thread's stack is before the thread runs.
///
/// THE ONE THING TO KNOW. A collection stops every thread, and a thread stops
/// when it allocates, when it waits on a lock or a futex, or when it sleeps.
/// A thread in a long computation that does none of those DELAYS every other
/// thread's collection until it does one. See the note above GcLock in
/// runtime/src/core/gc.cor for why, and for what fixes it.
public delegate void ThreadStart();

/// A thread body handed one argument, Start(object) passing it, as .NET's.
public delegate void ParameterizedThreadStart(object? obj);

class ThreadStateException : SystemException
{

    internal override int Code => unchecked((int)0x80131520);
    public ThreadStateException() : base("Thread was in an invalid state for the operation being executed.") { }
    public ThreadStateException(string? message) : base(message ?? "Thread was in an invalid state for the operation being executed.") { }
    public ThreadStateException(string? message, Exception? innerException) : base(message ?? "Thread was in an invalid state for the operation being executed.", innerException) { }
}

class Thread
{
    // LAYOUT: these two must stay the first instance fields (see Atom). _done
    // is what Join waits on, and it is a futex word, so it must have an
    // address -- hence a field of an object rather than a static.
    nint _done;
    nint _lock;

    Action _body;
    ThreadStart? _start;
    ParameterizedThreadStart? _withArgument;
    object? _argument;
    long _id;
    long _stack;
    long _stackBytes;
    long _block;
    int _slot;
    string? _name;
    bool _background;
    bool _counted;
    int _managedId;
    // A thread this class did not start, adopted when it first asks for
    // itself (CurrentThread): the program's first thread.
    bool _adopted;
    // The cultures it starts with: set on it before it started, or else
    // what the thread starting it was given (Start), as .NET's carry over.
    CultureInfo? _culture;
    CultureInfo? _uiCulture;

    /// The mutexes this thread owns, as a list through them
    /// (System.Threading.Mutex): what it leaves abandoned if it ends
    /// holding any. Changed only with the wait handles' gate held.
    internal System.Threading.Mutex? HeldMutexes;

    // The Thread each thread is, made the first time one asks that this
    // class did not start.
    [ThreadStatic] static Thread? _current;

    /// How many Threads have been made, for ManagedThreadId.
    static nint _made;

    /// How many foreground threads are running, as a futex word the end of
    /// Main waits on (WaitForForeground); and a spin lock over the counting.
    // Two words a CAS and a futex work on: the count, and its lock.
    static readonly nint[] _foreground = new nint[2];

    /// Big enough for the deepest call a thread body here makes, and cheap:
    /// anonymous pages cost nothing until they are touched. EIGHT MEGABYTES
    /// IN LONG MODE, where every frame is half again or twice its i386 size:
    /// a compiler's recursive rewrite that fit a megabyte on i386 ran off the
    /// end of one in long mode, through the thread block below it.
#if TARGET_64BIT
    const long StackBytes = 8388608;
#else
    const long StackBytes = 1048576;
#endif

    /// The runtime's own threads -- Task workers, the pool -- are background
    /// threads, as .NET's pool threads are.
    Thread(Action body, int slot)
    {
        _done = 0;
        _lock = 0;
        _body = body;
        _slot = slot;
        _background = true;
        _managedId = NextManagedId();
    }

    /// THE THREAD'S CURRENT CULTURES, as .NET's: on the thread itself,
    /// CultureInfo's current ones; set on a thread not started yet, the ones
    /// it starts with. Any other thread's are refused, read or set.
    public CultureInfo CurrentCulture
    {
        get
        {
            RequireCurrent();
            return CultureInfo.CurrentCulture;
        }
        set
        {
            if (ReferenceEquals(this, CurrentThread))
            {
                CultureInfo.CurrentCulture = value;
                return;
            }
            _culture = BeforeStart(value);
        }
    }

    public CultureInfo CurrentUICulture
    {
        get
        {
            RequireCurrent();
            return CultureInfo.CurrentUICulture;
        }
        set
        {
            if (ReferenceEquals(this, CurrentThread))
            {
                CultureInfo.CurrentUICulture = value;
                return;
            }
            _uiCulture = BeforeStart(value);
        }
    }

    void RequireCurrent()
    {
        if (!ReferenceEquals(this, CurrentThread)) throw new InvalidOperationException(NotCurrent);
    }

    // A culture for a thread to start with, which only one not started yet takes.
    CultureInfo BeforeStart(CultureInfo value)
    {
        ArgumentNullException.ThrowIfNull(value);
        if (Sys.PeekWord(Atom.At(this, Atom.SecondWord)) != 0) throw new InvalidOperationException(NotCurrent);
        return value;
    }

    const string NotCurrent = "This operation must be performed on the same thread as that represented by the Thread instance.";

    public Thread(ThreadStart start)
    {
        if (start == null) throw new ArgumentNullException("start");
        _start = start;
        _managedId = NextManagedId();
    }

    public Thread(ParameterizedThreadStart start)
    {
        if (start == null) throw new ArgumentNullException("start");
        _withArgument = start;
        _managedId = NextManagedId();
    }

    /// A THREAD THIS CLASS DID NOT START, as CurrentThread first finds it:
    /// the first thread -- ManagedThreadId 1, as .NET's main thread has, and
    /// a foreground thread -- or one the runtime made bare. It is running
    /// already, so Start refuses it (the claim word is taken), and it is
    /// never counted among the foreground threads: the end of Main does not
    /// wait for the thread that runs it.
    Thread(long kernelId, bool first)
    {
        _done = 0;
        _lock = 1;
        _block = Sys.ThreadBlock();
        _id = kernelId;
        _adopted = true;
        _background = !first;
        _managedId = first ? 1 : NextManagedId();
    }

    // ManagedThreadId 1 is the first thread's; every Thread made counts up
    // from 2, and keeps its number for good.
    static int NextManagedId()
    {
        return (int)Sys.AtomicAdd(Sys.AddressOf(ref _made), 1) + 2;
    }

    /// A THREAD OF A STACK SIZE ITS OWN, as .NET's maxStackSize: 0 the
    /// default; anything below the least a thread can run on, that least
    /// (MinimumStack); the size rounded up to a page. Taken where this
    /// runtime maps the stack itself (Launch); a thread the C library makes
    /// (LaunchNative) has the C library's.
    public Thread(ThreadStart start, int maxStackSize) : this(start)
    {
        if (maxStackSize < 0) throw new ArgumentOutOfRangeException("maxStackSize");
        _requestedStack = maxStackSize;
    }

    public Thread(ParameterizedThreadStart start, int maxStackSize) : this(start)
    {
        if (maxStackSize < 0) throw new ArgumentOutOfRangeException("maxStackSize");
        _requestedStack = maxStackSize;
    }

    // The stack a thread asked for (0: StackBytes), and the least one runs
    // on: the thread block's page, the guard page, and room above them.
    long _requestedStack;
    const long MinimumStack = 65536;

    long StackSize()
    {
        if (_requestedStack <= 0) return StackBytes;
        long bytes = _requestedStack < MinimumStack ? MinimumStack : _requestedStack;
        return (bytes + 4095) & (0 - 4096);
    }

    /// Starts a thread made with a ParameterizedThreadStart, handing it
    /// `parameter`; one made with a ThreadStart refuses, as in .NET.
    public void Start(object? parameter)
    {
        if (_withArgument == null)
            throw new InvalidOperationException("The thread was created with a ThreadStart delegate that does not accept a parameter.");
        _argument = parameter;
        Start();
    }

    /// The thread id the kernel gave it, or 0 before it has been started.
    internal long Id => _id;

    /// The thread's number in this process, from the moment it is made: 1
    /// for the first thread, and a number of its own for every other.
    public int ManagedThreadId => _managedId;

    /// The Thread running the code that asks: the one that started it, or
    /// for a thread this class did not start, one made on the first ask.
    public static Thread CurrentThread
    {
        get
        {
            Thread? current = _current;
            if (current == null)
            {
                current = new Thread(Native.CurrentThreadId(), Sys.ThreadBlock() == Sys.MainThreadBlock());
                _current = current;
            }
            return current;
        }
    }

    public bool IsAlive => _id != 0 && _done == 0;

    /// The thread's name, for a debugger and for the program; null until
    /// given one.
    public string? Name
    {
        get { return _name; }
        set { _name = value; }
    }

    /// A background thread does not keep the process alive: when Main
    /// returns, the process waits for every FOREGROUND thread and no other,
    /// as .NET's does. A thread made with a ThreadStart is a foreground one
    /// until told otherwise; it may be told at any time.
    public bool IsBackground
    {
        get { return _background; }
        set
        {
            if (_adopted)
            {
                _background = value;
                return;
            }
            Counting(true);
            try
            {
                _background = value;
                bool running = !_adopted && _id != 0 && Sys.PeekWord(Atom.At(this, Atom.FirstWord)) == 0;
                if (running && !value && !_counted) Count(1);
                if (running && value && _counted) Count(-1);
            }
            finally { Counting(false); }
        }
    }

    static void Counting(bool enter)
    {
        long at = Sys.ArrayData(_foreground) + WordSize.Bytes;
        if (!enter)
        {
            Sys.AtomicSwap(at, 0);
            return;
        }
        // Paused, then the processor given up: no holder allocates under
        // it, but one may have been put off the processor. Never stopped for
        // the collector (Atom.Turn): Finish takes it after EndThread, when
        // the thread is no longer the collector's to answer for.
        long turns = 0;
        while (Sys.Cas(at, 0, 1) != 0)
        {
            turns = turns + 1;
            if (turns < 64) Sys.Pause();
            else Platform.Yield();
        }
    }

    /// With the counting lock held: one foreground thread more or fewer.
    void Count(int by)
    {
        long at = Sys.ArrayData(_foreground);
        _counted = by > 0;
        if (Sys.AtomicAdd(at, by) + by == 0) Native.Wake(at, Native.WakeAll);
    }

    /// The end of Main waits here for the foreground threads (Runtime.Exit).
    static void WaitForForeground()
    {
        long at = Sys.ArrayData(_foreground);
        while (true)
        {
            long now = Sys.Peek(at) & WordSize.AddressMask;
            if (now == 0) return;
            Native.Wait(at, now);
        }
    }

    /// This thread's kernel thread id (gettid(2)), which is the process id on
    /// the first thread.
    internal static long CurrentId => Native.CurrentThreadId();

    // ---- the registry -------------------------------------------------------
    //
    // A started thread is handed nothing but a machine word, and a word cannot
    // be an object reference this language can hand back: the child is given
    // its slot in this table instead, which is also what keeps a running
    // thread's object -- and its body -- reachable for the collector.

    static Thread?[] _all = new Thread?[64];
    static int _slots;
    // SLOTS GIVEN BACK by threads that ended (Unregister), taken again
    // before the table grows: a slot a thread, for ever, kept every Thread
    // the program started, its body and what that captured.
    static int[] _freed = new int[16];
    static int _freedCount;
    static AtomicCell? _registry;

    static AtomicCell Registry()
    {
        AtomicCell? r = _registry;

        if (r == null)
        {
            Atom.CheckLayout();
            r = new AtomicCell();
            _registry = r;
        }
        return r;
    }

    static int Register(Thread t)
    {
        AtomicCell gate = Registry();

        gate.Enter();

        if (_freedCount > 0)
        {
            _freedCount = _freedCount - 1;
            int again = _freed[_freedCount];
            _all[again] = t;
            gate.Exit();
            return again;
        }

        if (_slots == _all.Length)
        {
            Thread?[] bigger = new Thread?[_all.Length * 2];

            for (int i = 0; i < _slots; i++)
            {
                bigger[i] = _all[i];
            }
            _all = bigger;
        }

        int slot = _slots;

        _all[slot] = t;
        _slots = _slots + 1;

        gate.Exit();
        return slot;
    }

    /// A thread's slot given back as it ends, still a thread the collector
    /// counts (before Runtime.EndThread): nothing reads the slot after its
    /// entry has, and the Thread is then only what its joiners hold.
    static void Unregister(int slot)
    {
        AtomicCell gate = Registry();
        gate.Enter();
        if (_freedCount == _freed.Length)
        {
            int[] bigger = new int[_freed.Length * 2];
            for (int i = 0; i < _freedCount; i++) bigger[i] = _freed[i];
            _freed = bigger;
        }
        _all[slot] = null;
        _freed[_freedCount] = slot;
        _freedCount = _freedCount + 1;
        gate.Exit();
    }

    // ---- starting and joining -----------------------------------------------

    /// Runs `body` on a new thread and answers the thread, already running.
    internal static Thread Start(Action body)
    {
        if (body == null)
        {
            throw new ArgumentNullException("body");
        }

        Atom.CheckLayout();

        Thread t = new Thread(body, 0);

        t.Start();
        return t;
    }

    public void Start()
    {
        Atom.CheckLayout();
        // The second layout word is the one-time start claim, not a held
        // mutex: even a completed thread cannot be started a second time.
        if (Sys.Cas(Atom.At(this, Atom.SecondWord), 0, 1) != 0)
            throw new ThreadStateException("Thread is running or terminated; it cannot restart.");
        // WHAT THE STARTER WAS GIVEN GOES WITH IT, as .NET's execution
        // context carries the cultures into a thread it starts -- not into
        // the runtime's own workers, which .NET starts with none.
        if (_start != null || _withArgument != null)
        {
            _culture ??= CultureInfo.GivenCulture;
            _uiCulture ??= CultureInfo.GivenUICulture;
        }
        _slot = Register(this);
        if (!_background)
        {
            Runtime.ForegroundWait = Sys.AddressOf(Thread.WaitForForeground);
            Counting(true);
            try { Count(1); }
            finally { Counting(false); }
        }
        try { Launch(); }
        catch
        {
            Counting(true);
            try { if (_counted) Count(-1); }
            finally { Counting(false); }
            throw;
        }
    }

    // A THREAD C CAN RUN IN. When the C library is loaded -- a program with
    // a [DllImport], or one linked against a library that has one -- a new
    // thread is made by its pthread_create, so that it has the C library's
    // own per-thread state (errno, the allocator's caches, the stack
    // canary) for whatever C it calls. clone(2) alone gives it the creating
    // thread's, which C would then share between two threads at once. The
    // runtime's block is its own page; the stack is the C library's.

    static long _nativeCreate;          // pthread_create, -1 when there is none
    static long _nativeDetach;

    static long NativeCreate()
    {
        if (_nativeCreate == 0)
        {
            long create = Runtime.NativeSymbol("pthread_create");
            _nativeDetach = Runtime.NativeSymbol("pthread_detach");
            _nativeCreate = create == 0 || _nativeDetach == 0 ? -1 : create;
        }
        return _nativeCreate < 0 ? 0 : _nativeCreate;
    }

    void Launch()
    {
        long create = NativeCreate();
        if (create != 0)
        {
            LaunchNative(create);
            return;
        }

        long stackBytes = StackSize();
        long stack = Native.MapStack(stackBytes);

        if (stack == 0)
        {
            throw new InvalidOperationException("threading: no memory for a thread stack");
        }

        // A GUARD PAGE between the block (the mapping's first page) and the
        // stack: a stack that runs out faults at once, where it happens, and
        // does not write over the thread block -- which went on to hand out a
        // null thread and fault somewhere with nothing to do with the stack.
        Platform.Guard(stack + 4096, 4096);

        _stack = stack;
        _stackBytes = stackBytes;

        // The top, sixteen-byte aligned, because the first thing the child does
        // is push and call.
        long top = (stack + stackBytes) & (0 - 16);

        // THE BLOCK GOES AT THE BOTTOM OF THE SAME MAPPING. The child needs it
        // before it may allocate, so it cannot be allocated by the child; it is
        // filled in here, by the parent, while the child does not exist yet.
        // The stack grows down towards it, and meets the guard page first.
        _block = stack;

        // Registered by the PARENT, and BEFORE the clone: a collection in the
        // window between the two must not sweep an object the child has
        // already made, and must not wait for a thread that does not exist
        // yet. It is registered stopped, with an empty stack, and the child
        // says it is running once its block is its own (see Begin).
        Runtime.RegisterThread(_block, top);

        long id = Native.Spawn(Sys.AddressOf(Thread.ChildEntry), _slot, top);

        if (id < 0)
        {
            Runtime.ForgetThread(_block);
            throw new InvalidOperationException("threading: clone failed");
        }
        _id = id;
    }

    void LaunchNative(long create)
    {
        long block = Platform.Map(4096);

        if (block == 0)
        {
            throw new InvalidOperationException("threading: no memory for a thread block");
        }
        _block = block;
        _stack = 0;
        _stackBytes = 0;

        // Registered stopped with an empty stack, as Launch does: the child
        // says where its stack is once it stands on it (BeginNative).
        Runtime.RegisterThread(_block, 0);

        byte[] handle = new byte[8];
        long failed = Runtime.CallC(create, Sys.ArrayData(handle), 0, Sys.AddressOf(Thread.NativeEntry), _slot);

        if (failed != 0)
        {
            Runtime.ForgetThread(_block);
            throw new InvalidOperationException("threading: pthread_create failed");
        }
        // Nobody joins it through the C library: Join waits on the thread's
        // own word, so its C side is released when it returns.
        Runtime.CallC(_nativeDetach, Sys.Peek(Sys.ArrayData(handle)), 0, 0, 0);
        _id = 1;
    }

    /// Where a thread pthread_create made begins: a C start routine, which
    /// this compiler's convention already is.
    static long NativeEntry(long slot)
    {
        Thread? t = _all[(int)slot];

        if (t != null)
        {
            t.BeginNative(Sys.FramePointer());
        }
#if !TARGET_64BIT
        // Back to the C library it goes, which finds its thread through GS
        // as it tears the thread down (on i386; x86-64's runtime is in GS
        // and C's in FS, and neither moved).
        if (Runtime.NativeGs != 0)
        {
            Sys.SetGs(Runtime.NativeGs);
        }
#endif
        return 0;
    }

    /// Begin, for a thread on the C library's stack: nothing above `frame`
    /// is the runtime's, so the stack the collector reads starts there.
    void BeginNative(long frame)
    {
        Platform.SetThreadBlock(_block);
        Sys.Poke(_block + Tls.ThreadId, Native.CurrentThreadId());
        long top = frame + 2 * WordSize.Bytes;
        Runtime.MoveStack(top, top);
        Runtime.EndBlocking();
        Body();
    }

    /// Where a new thread begins, on its own stack with no frame above it. It
    /// takes a slot rather than a reference because a machine word is all
    /// clone(2) can carry.
    ///
    /// AND ANSWERS ITS MAPPING for the trampoline to give back once it is off
    /// it (UnmapLengthAt), or 0: read from the block's page, which is not the
    /// collector's -- the thread is none of the collector's by now, and the
    /// Thread may already be gone with it. Every signal is blocked first, so
    /// no handler runs on a stack about to go.
    static long ChildEntry(long slot)
    {
        Thread? t = _all[(int)slot];

        if (t == null)
        {
            return 0;
        }
        t.Begin();
        long block = Sys.ThreadBlock();
        if (Sys.Peek(block + Native.UnmapLengthAt) == 0)
        {
            return 0;
        }
        Platform.QuietWorker();
        return block;
    }

    /// The first thing a new thread does. Until SetThreadBlock returns, GS
    /// still names the PARENT's block -- clone(2) leaves the thread-local
    /// descriptors alone unless it is asked to set them -- so nothing above
    /// that line may allocate or enter a `try`; a field read and a call are
    /// all it is.
    void Begin()
    {
        Platform.SetThreadBlock(_block);
        Sys.Poke(_block + Tls.ThreadId, Native.CurrentThreadId());

        // Running, from here on: until this the collector was told this thread
        // was stopped with nothing on its stack, which it was.
        Runtime.EndBlocking();
        Body();
    }

    /// An exception that escapes a thread body ends the program, which is what
    /// .NET does with one that escapes a thread's start routine.
    void Body()
    {
        _current = this;
        try
        {
            _current = this;
            if (_culture != null) CultureInfo.CurrentCulture = _culture;
            if (_uiCulture != null) CultureInfo.CurrentUICulture = _uiCulture;
            ThreadStart? start = _start;
            ParameterizedThreadStart? withArgument = _withArgument;
            if (start != null) start.Invoke();
            else if (withArgument != null) withArgument.Invoke(_argument);
            else _body.Invoke();
        }
        catch (Exception e)
        {
            AsyncRuntime.Unhandled(e);
        }

        // Mutexes still held are left abandoned before Join can return: a
        // thread that joins this one and then waits on one is told.
        if (HeldMutexes != null)
        {
            System.Threading.Mutex.AbandonHeld(this);
        }

        // Its slot back, and its mapping's length where the trampoline will
        // read it: the mapping is the block's own (Launch), and a thread the C
        // library made has none of its own to give back (_stack 0).
        Unregister(_slot);
        if (_stack != 0)
        {
            Sys.Poke(_block + Native.UnmapLengthAt, _stackBytes);
        }

        // The stack under this thread stops being a stack the collector may
        // read before the thread stops standing on it.
        Runtime.EndThread();
        Finish();
    }

    /// Marks the thread finished and wakes everyone in Join. The stack is
    /// returned to the kernel by the trampoline once the thread is off it,
    /// just before its exit(2) (ChildEntry).
    void Finish()
    {
        long at = Atom.At(this, Atom.FirstWord);

        Counting(true);
        Sys.AtomicSwap(at, 1);
        if (_counted) Count(-1);
        Counting(false);
        Native.Wake(at, Native.WakeAll);
    }

    /// Waits for the thread to finish running its body.
    public void Join()
    {
        if (_id == 0) throw new ThreadStateException("Thread has not been started.");
        long at = Atom.At(this, Atom.FirstWord);

        while (Sys.PeekWord(at) == 0)
        {
            Native.Wait(at, 0);
        }
    }

    /// Join with a limit: true when the thread finished within
    /// `millisecondsTimeout` (-1, Timeout.Infinite, waits as Join() does).
    public bool Join(int millisecondsTimeout)
    {
        if (millisecondsTimeout == -1) { Join(); return true; }
        if (millisecondsTimeout < -1) throw new ArgumentOutOfRangeException("millisecondsTimeout", "Number must be either non-negative and less than or equal to Int32.MaxValue or -1.");
        if (_id == 0) throw new ThreadStateException("Thread has not been started.");
        long at = Atom.At(this, Atom.FirstWord);
        long until = Clock.Now() + (long)millisecondsTimeout * 1000000;
        while (Sys.PeekWord(at) == 0)
        {
            long left = until - Clock.Now();
            if (left <= 0) return false;
            Native.WaitFor(at, 0, left);
        }
        return true;
    }

    public bool Join(TimeSpan timeout) { return Join(Timeouts.Guarded(timeout)); }

    /// Stops this thread for `milliseconds`, leaving the processor to others.
    /// .NET's rules: -1 for ever, less refused, 0 the processor given up to
    /// any thread ready for it, and otherwise the whole time, whatever
    /// signal wakes the thread early.
    public static void Sleep(int millisecondsTimeout)
    {
        ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1, "millisecondsTimeout");
        if (millisecondsTimeout == 0)
        {
            Yield();
            return;
        }
        if (millisecondsTimeout == -1)
        {
            while (true) Clock.SleepUntil(Clock.Now() + 3600L * 1000000000);
        }
        long deadline = Clock.Now() + (long)millisecondsTimeout * 1000000;
        while (Clock.Now() < deadline) Clock.SleepUntil(deadline);
    }

    public static void Sleep(TimeSpan timeout)
    {
        Sleep(Timeouts.Guarded(timeout));
    }

    /// Gives the processor up to any other thread ready to run on it
    /// (sched_yield). True, as .NET answers on Linux: the kernel does not
    /// say whether another thread ran. Given up is stopped, as asleep is
    /// (Clock.SleepUntil): a thread that spins on Yield waiting for another
    /// must not keep that other's collection waiting for it.
    public static bool Yield()
    {
        Runtime.BeginBlocking();
        Platform.Yield();
        Runtime.EndBlocking();
        return true;
    }
}

}

/// The half of System.Environment (stdlib's environment.cor) that is a
/// thread's, kept here beside Thread: a freestanding image has no Thread,
/// and compiles environment.cor all the same -- CORSAC's ring-1 kernels do.
static partial class Environment
{
    /// The running thread's ManagedThreadId, as Thread.CurrentThread has it:
    /// 1 on the first thread.
    public static int CurrentManagedThreadId => System.Threading.Thread.CurrentThread.ManagedThreadId;
}

// ---- WaitHandle, and the events, mutexes and semaphores that are one ---------
//
// .NET's waitable objects, kept the way .NET keeps them where there is no
// kernel object to hand them to -- its own wait subsystem on Unix -- and for
// the same two reasons: WaitAll must take every handle it names at once or
// none of them, and a Set must hand an auto-reset event straight to a thread
// already waiting on it, so that two Sets let two waiters through. A futex
// word per handle can do neither. So:
//
//   - ONE GATE over every handle (WaitHandle.EnterGate), a futex lock: a
//     handle's state and its queue of waits change only with it held, and it
//     is held for the few instructions a change takes -- but for a NAMED
//     mutex, whose look at the other processes' hold (Ours, TryLock, Mark)
//     opens, locks and writes a file and makes what it reads. Nothing waits
//     while it is held, and nothing thrown leaves it held: a hold that would
//     overflow is refused before the take (WaitOverflow).
//   - A WAIT THAT CANNOT BE ANSWERED AT ONCE is queued on every handle it
//     names (a HandleWait, with a HandleWaitLink in each queue) and sleeps on
//     a word of its own.
//   - A SIGNAL ANSWERS THE QUEUE. Set, Release and ReleaseMutex walk the
//     handle's waits oldest first and finish each one the handle can now
//     finish: they take the handles for it, exactly as the waiting thread
//     would have, write down what it ended with, and wake it. A semaphore
//     count or an auto-reset event handed over that way is never seen
//     signalled by anybody else.
//   - A WAIT THAT TIMES OUT takes the gate and looks once more: a signal that
//     finished it in the meantime has already taken its handles for it, and
//     it answers that instead of the timeout.
//
// A MUTEX belongs to a thread (Thread.CurrentThread), as many times over as
// that thread has taken it. A thread that ends while it holds mutexes leaves
// them abandoned (Mutex.AbandonHeld, from Thread.Body): each is free again,
// and the next wait to take one says so with AbandonedMutexException.

namespace System.Threading
{
    /// Whether a set EventWaitHandle lets one waiter through and resets
    /// itself, or stays set for everybody until it is reset.
    public enum EventResetMode
    {
        AutoReset = 0,
        ManualReset = 1,
    }

    /// .NET's WaitHandle: something a thread can wait on until it is
    /// signalled, by itself (WaitOne) or with others (WaitAny, WaitAll).
    public abstract class WaitHandle : IDisposable
    {
        /// What WaitAny answers when the timeout passed first.
        public const int WaitTimeout = 258;

        // WHAT A WAIT ENDS WITH, inside, as .NET's own wait answers it: the
        // index of the handle that ended it, that plus WaitAbandoned when the
        // handle was a mutex its owner left behind, or WaitTimeout.
        const int WaitAbandoned = 0x80;
        /// A wait that would take a mutex this thread holds int.MaxValue
        /// times: nothing taken, and Wait throws once the gate is let go.
        const int WaitOverflow = -2;
        const int MaxWaitHandles = 64;

        // .NET names the handle under a closed WaitHandle, not the WaitHandle.
        const string ClosedName = "Microsoft.Win32.SafeHandles.SafeWaitHandle";

        // The gate over every handle's state and queue: 0 free, 1 held, 2
        // held with somebody asleep on it. Drepper's futex mutex ("Futexes Are
        // Tricky", section 6): taking and giving it back uncontended is one
        // atomic instruction each, and only a sleeper makes the giving back
        // pay for a wake.
        static nint _gate;

        // The waits queued on this handle, oldest first.
        HandleWaitLink? _first;
        HandleWaitLink? _last;

        // WHAT IS UNDER THE HANDLE, as .NET's SafeWaitHandle: the object
        // whose state and queue a wait reads -- this one for the kinds below,
        // the one shared by every Mutex of a name, the one another WaitHandle's
        // SafeWaitHandle names once a program sets it here -- and whether it
        // has been closed. A WaitHandle a program derives itself has nothing
        // under it, and a wait on it is refused naming its own type, as .NET
        // refuses one with no SafeWaitHandle; a closed one is refused naming
        // the handle that was under it.
        Microsoft.Win32.SafeHandles.SafeWaitHandle? _safe;

        /// What a handle is when there is none, as .NET's.
        protected static readonly IntPtr InvalidHandle = new IntPtr(-1);

        protected WaitHandle() { }

        // The kinds' own.
        internal WaitHandle(bool kind)
        {
            _safe = new Microsoft.Win32.SafeHandles.SafeWaitHandle(this);
        }

        /// The object a wait on this handle waits on (CheckOpen first).
        internal WaitHandle Core => _safe!.Target!;

        /// Under it from now on: another's, for a Mutex of a name another
        /// Mutex made first.
        internal void Share(WaitHandle core)
        {
            _safe = new Microsoft.Win32.SafeHandles.SafeWaitHandle(core);
        }

        /// .NET's handle on what is under it: one the runtime numbers, as
        /// there is no kernel object to have one; -1 with nothing under it.
        public virtual IntPtr Handle
        {
            get
            {
                Microsoft.Win32.SafeHandles.SafeWaitHandle? safe = _safe;
                return safe == null ? InvalidHandle : safe.DangerousGetHandle();
            }
            set
            {
                if (value == InvalidHandle)
                {
                    if (_safe != null)
                    {
                        _safe.SetHandleAsInvalid();
                        _safe = null;
                    }
                    return;
                }
                _safe = new Microsoft.Win32.SafeHandles.SafeWaitHandle(value, true);
            }
        }

        /// The handle under it, an invalid one made on the first ask when
        /// there is none, as .NET's; set, it is what waits wait on.
        public Microsoft.Win32.SafeHandles.SafeWaitHandle SafeWaitHandle
        {
            get
            {
                Microsoft.Win32.SafeHandles.SafeWaitHandle? safe = _safe;
                if (safe == null)
                {
                    safe = new Microsoft.Win32.SafeHandles.SafeWaitHandle(InvalidHandle, false);
                    _safe = safe;
                }
                return safe;
            }
            set
            {
                _safe = value;
            }
        }

        public virtual bool WaitOne()
        {
            return WaitOne(-1);
        }

        /// True once signalled -- and taken, for a kind that is taken: an
        /// auto-reset event, a semaphore's count, a mutex -- or false when
        /// `millisecondsTimeout` passes first (-1: never; 0: only looks).
        public virtual bool WaitOne(int millisecondsTimeout)
        {
            ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1, "millisecondsTimeout");
            CheckOpen();
            int result = Wait(Core, null, 1, false, null, millisecondsTimeout);
            if (result == WaitAbandoned)
            {
                throw new AbandonedMutexException();
            }
            return result != WaitTimeout;
        }

        public virtual bool WaitOne(TimeSpan timeout)
        {
            return WaitOne(Milliseconds(timeout));
        }

        public virtual bool WaitOne(int millisecondsTimeout, bool exitContext)
        {
            return WaitOne(millisecondsTimeout);
        }

        public virtual bool WaitOne(TimeSpan timeout, bool exitContext)
        {
            return WaitOne(timeout);
        }

        public virtual void Close()
        {
            Dispose();
        }

        public void Dispose()
        {
            Dispose(true);
        }

        /// Closed: every wait and signal from now on is refused with
        /// ObjectDisposedException -- and the last of a name's Mutexes gives
        /// the name up.
        protected virtual void Dispose(bool explicitDisposing)
        {
            _safe?.Close();
        }

        public static bool WaitAll(WaitHandle[] waitHandles)
        {
            return WaitAll(waitHandles, -1);
        }

        /// True once every handle could be taken AT ONCE, and has been; false
        /// when the timeout passed first, with none of them taken.
        public static bool WaitAll(WaitHandle[] waitHandles, int millisecondsTimeout)
        {
            return WaitMultiple(waitHandles, true, millisecondsTimeout) != WaitTimeout;
        }

        public static bool WaitAll(WaitHandle[] waitHandles, TimeSpan timeout)
        {
            return WaitAll(waitHandles, Milliseconds(timeout));
        }

        public static bool WaitAll(WaitHandle[] waitHandles, int millisecondsTimeout, bool exitContext)
        {
            return WaitAll(waitHandles, millisecondsTimeout);
        }

        public static bool WaitAll(WaitHandle[] waitHandles, TimeSpan timeout, bool exitContext)
        {
            return WaitAll(waitHandles, timeout);
        }

        public static int WaitAny(WaitHandle[] waitHandles)
        {
            return WaitAny(waitHandles, -1);
        }

        /// The index of the handle taken -- the lowest, when several could
        /// be -- or WaitTimeout when the timeout passed first.
        public static int WaitAny(WaitHandle[] waitHandles, int millisecondsTimeout)
        {
            return WaitMultiple(waitHandles, false, millisecondsTimeout);
        }

        public static int WaitAny(WaitHandle[] waitHandles, TimeSpan timeout)
        {
            return WaitAny(waitHandles, Milliseconds(timeout));
        }

        public static int WaitAny(WaitHandle[] waitHandles, int millisecondsTimeout, bool exitContext)
        {
            return WaitAny(waitHandles, millisecondsTimeout);
        }

        public static int WaitAny(WaitHandle[] waitHandles, TimeSpan timeout, bool exitContext)
        {
            return WaitAny(waitHandles, timeout);
        }

        public static bool SignalAndWait(WaitHandle toSignal, WaitHandle toWaitOn)
        {
            return SignalAndWait(toSignal, toWaitOn, -1, false);
        }

        public static bool SignalAndWait(WaitHandle toSignal, WaitHandle toWaitOn, TimeSpan timeout, bool exitContext)
        {
            return SignalAndWait(toSignal, toWaitOn, Milliseconds(timeout), exitContext);
        }

        /// Signals one handle and waits on another, the wait queued in the
        /// same hold of the gate as the signal: nothing the signal sets off
        /// can signal `toWaitOn` before this thread is waiting on it.
        public static bool SignalAndWait(WaitHandle toSignal, WaitHandle toWaitOn, int millisecondsTimeout, bool exitContext)
        {
            if (toSignal == null)
            {
                throw new ArgumentNullException("toSignal");
            }
            if (toWaitOn == null)
            {
                throw new ArgumentNullException("toWaitOn");
            }
            ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1, "millisecondsTimeout");
            toSignal.CheckOpen();
            toWaitOn.CheckOpen();
            int result = Wait(toWaitOn.Core, null, 1, false, toSignal.Core, millisecondsTimeout);
            if (result == WaitAbandoned)
            {
                throw new AbandonedMutexException();
            }
            return result != WaitTimeout;
        }

        // A TimeSpan as a wait's milliseconds, refused as .NET refuses it.
        static int Milliseconds(TimeSpan timeout)
        {
            long milliseconds = (long)timeout.TotalMilliseconds;
            ArgumentOutOfRangeException.ThrowIfLessThan(milliseconds, -1, "timeout");
            ArgumentOutOfRangeException.ThrowIfGreaterThan(milliseconds, int.MaxValue, "timeout");
            return (int)milliseconds;
        }

        // Every wait and signal asks first: refused as .NET refuses it, when
        // there is nothing under the handle or it has been closed.
        internal void CheckOpen()
        {
            Microsoft.Win32.SafeHandles.SafeWaitHandle? safe = _safe;
            if (safe != null && safe.IsClosed)
            {
                throw new ObjectDisposedException(ClosedName);
            }
            ObjectDisposedException.ThrowIf(safe == null || safe.Target == null, this);
        }

        // WaitAll and WaitAny, with .NET's checks in .NET's order: the array,
        // its length, the timeout, then each element in turn -- null, then
        // closed -- and last, for WaitAll, one named twice, which taking all
        // at once would take twice.
        static int WaitMultiple(WaitHandle[] waitHandles, bool waitAll, int millisecondsTimeout)
        {
            if (waitHandles == null)
            {
                throw new ArgumentNullException("waitHandles");
            }
            if (waitHandles.Length == 0)
            {
                throw new ArgumentException("Waithandle array may not be empty.", "waitHandles");
            }
            if (waitHandles.Length > MaxWaitHandles)
            {
                throw new NotSupportedException("The number of WaitHandles must be less than or equal to 64.");
            }
            ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1, "millisecondsTimeout");

            // A COPY, made as each element is checked, as .NET's wait makes
            // one: the caller's array may change while the wait is queued, and
            // the wait is what a signal reads -- so the copy is what is
            // checked, and a null put into the array after its check can never
            // reach a signal walking the queue with the gate held.
            int count = waitHandles.Length;
            WaitHandle[] handles = new WaitHandle[count];
            for (int i = 0; i < count; i++)
            {
                WaitHandle handle = waitHandles[i];
                if (handle == null)
                {
                    throw new ArgumentNullException("waitHandles[" + i + "]", "At least one element in the specified array was null.");
                }
                handle.CheckOpen();
                handles[i] = handle.Core;
            }
            // A MUTEX OF A NAME IS WAITED ON ALONE, as on .NET's Unix.
            for (int i = 0; i < count; i++)
            {
                if (handles[i].Elsewhere)
                {
                    throw new PlatformNotSupportedException("Wait operations on multiple wait handles including a named synchronization primitive are not supported on this platform.");
                }
            }
            if (waitAll)
            {
                for (int i = 1; i < count; i++)
                {
                    for (int j = 0; j < i; j++)
                    {
                        if (handles[j] == handles[i])
                        {
                            throw new DuplicateWaitObjectException();
                        }
                    }
                }
            }

            int result = Wait(null, handles, count, waitAll, null, millisecondsTimeout);
            if (result >= WaitAbandoned && result < WaitAbandoned + count)
            {
                if (waitAll)
                {
                    throw new AbandonedMutexException();
                }
                int index = result - WaitAbandoned;
                throw new AbandonedMutexException(index, waitHandles[index]);
            }
            return result;
        }

        // THE ONE WAIT every public wait comes to: on `one`, or on the first
        // `count` of `many` -- any of them, or all of them at once -- after
        // `signal` is given its signal, when there is one, in the same hold of
        // the gate. It ends as WaitTimeout and WaitAbandoned say -- or, a
        // mutex it would take again past int.MaxValue holds, as .NET's
        // OverflowException, thrown here with the gate let go and nothing
        // taken (WaitOverflow).
        static int Wait(WaitHandle? one, WaitHandle[]? many, int count, bool all, WaitHandle? signal, int milliseconds)
        {
            int result = WaitCore(one, many, count, all, signal, milliseconds);
            if (result == WaitOverflow)
            {
                throw new OverflowException("The current thread attempted to reacquire a mutex that has reached its maximum acquire count.");
            }
            return result;
        }

        static int WaitCore(WaitHandle? one, WaitHandle[]? many, int count, bool all, WaitHandle? signal, int milliseconds)
        {
            Thread me = Thread.CurrentThread;

            // A wait that may sleep is made before the gate is taken, nothing
            // being made with it held -- at once for SignalAndWait, whose wait
            // must be queued in the hold that signals; otherwise only when the
            // first look finds nothing to take, so that a wait answered at
            // once makes nothing at all.
            HandleWait? wait = null;
            if (signal != null && milliseconds != 0)
            {
                wait = new HandleWait(me, one, many, count, all);
            }

            EnterGate();
            if (signal != null && !signal.Give(me))
            {
                ExitGate();
                throw signal.Refused();
            }
            int result = TakeNow(one, many, count, all, me);
            if (result != WaitTimeout || milliseconds == 0)
            {
                ExitGate();
                return result;
            }
            if (wait == null)
            {
                ExitGate();
                wait = new HandleWait(me, one, many, count, all);
                EnterGate();
                // Looked at again: a signal may have come while the gate was open.
                result = TakeNow(one, many, count, all, me);
                if (result != WaitTimeout)
                {
                    ExitGate();
                    return result;
                }
            }
            wait.Queue();
            ExitGate();

            long done = Atom.At(wait, Atom.FirstWord);
            long deadline = milliseconds < 0 ? -1 : Clock.Now() + (long)milliseconds * 1000000;
            // A MUTEX OF A NAME ANOTHER PROCESS MAY HOLD gives no signal here
            // when that process lets it go: the wait looks again now and then,
            // a little less often each time, and takes what it can.
            long poll = Polled(one, many, count) ? PollFirst : 0;
            while (Sys.PeekWord(done) == 0)
            {
                long left = deadline < 0 ? long.MaxValue : deadline - Clock.Now();
                if (left <= 0)
                {
                    break;
                }
                if (poll > 0)
                {
                    Native.WaitFor(done, 0, left < poll ? left : poll);
                    if (poll < PollMost) poll = poll * 2;
                    if (Sys.PeekWord(done) != 0) break;
                    EnterGate();
                    if (Sys.PeekWord(done) == 0)
                    {
                        result = TakeNow(one, many, count, all, me);
                        if (result != WaitTimeout)
                        {
                            wait.Unqueue();
                            ExitGate();
                            return result;
                        }
                    }
                    ExitGate();
                    continue;
                }
                if (deadline < 0)
                {
                    Native.Wait(done, 0);
                    continue;
                }
                Native.WaitFor(done, 0, left);
            }

            // Finished by a signal: what it ended with was written before the
            // word that says so.
            if (Sys.PeekWord(done) != 0)
            {
                return wait.Result;
            }
            EnterGate();
            if (Sys.PeekWord(done) != 0)
            {
                result = wait.Result;
            }
            else
            {
                wait.Unqueue();
                result = WaitTimeout;
            }
            ExitGate();
            return result;
        }

        // How long a wait on a named mutex sleeps before it first looks again,
        // and the most it sleeps between looks, in nanoseconds.
        const long PollFirst = 1000000;
        const long PollMost = 32000000;

        static bool Polled(WaitHandle? one, WaitHandle[]? many, int count)
        {
            if (one != null) return one.Elsewhere;
            for (int i = 0; i < count; i++)
            {
                if (many![i].Elsewhere) return true;
            }
            return false;
        }

        /// Whether another process can let this handle go: a named mutex's.
        internal virtual bool Elsewhere => false;

        /// With the gate held, after a look that took nothing: what the look
        /// claimed on the way -- a named mutex's hold on its file -- let go.
        internal virtual void Untaken()
        {
        }

        // With the gate held: what the wait asks for, taken if `thread` can
        // have it now -- answered as Wait answers, WaitTimeout when it cannot.
        static int TakeNow(WaitHandle? one, WaitHandle[]? many, int count, bool all, Thread thread)
        {
            int result = TakeNowOrNot(one, many, count, all, thread);
            if (result == WaitTimeout)
            {
                if (one != null) one.Untaken();
                else for (int i = 0; i < count; i++) many![i].Untaken();
            }
            return result;
        }

        static int TakeNowOrNot(WaitHandle? one, WaitHandle[]? many, int count, bool all, Thread thread)
        {
            if (one != null)
            {
                if (!one.SignaledFor(thread))
                {
                    return WaitTimeout;
                }
                if (one.Overflows(thread)) return WaitOverflow;
                return one.Take(thread) ? WaitAbandoned : 0;
            }
            WaitHandle[] handles = many!;
            if (!all)
            {
                for (int i = 0; i < count; i++)
                {
                    WaitHandle handle = handles[i];
                    if (handle.SignaledFor(thread))
                    {
                        if (handle.Overflows(thread)) return WaitOverflow;
                        return handle.Take(thread) ? WaitAbandoned + i : i;
                    }
                }
                return WaitTimeout;
            }
            for (int i = 0; i < count; i++)
            {
                if (!handles[i].SignaledFor(thread))
                {
                    return WaitTimeout;
                }
            }
            // ALL OR NONE, the overflow too: looked for before any is taken.
            for (int i = 0; i < count; i++)
            {
                if (handles[i].Overflows(thread)) return WaitOverflow;
            }
            int abandoned = -1;
            for (int i = 0; i < count; i++)
            {
                if (handles[i].Take(thread) && abandoned < 0)
                {
                    abandoned = i;
                }
            }
            return abandoned < 0 ? 0 : WaitAbandoned + abandoned;
        }

        // With the gate held, after this handle's state changed to one that
        // somebody may take: the queued waits, oldest first, each finished
        // that now can be, until nobody can take the handle any more.
        internal void Answer()
        {
            HandleWaitLink? link = _first;
            while (link != null && Signaled())
            {
                // Read before the wait is finished, which takes all its links
                // -- this one among them -- out of their queues. A wait has
                // one link in a queue at most, so the next is another's.
                HandleWaitLink? next = link.Next;
                HandleWait wait = link.Wait;
                int result = TakeNow(wait.One, wait.Many, wait.Count, wait.All, wait.Waiter);
                if (result != WaitTimeout)
                {
                    wait.Finish(result);
                }
                link = next;
            }
        }

        internal void Enqueue(HandleWaitLink link)
        {
            link.Previous = _last;
            link.Next = null;
            if (_last != null)
            {
                _last.Next = link;
            }
            else
            {
                _first = link;
            }
            _last = link;
        }

        internal void Dequeue(HandleWaitLink link)
        {
            if (link.Previous != null)
            {
                link.Previous.Next = link.Next;
            }
            else
            {
                _first = link.Next;
            }
            if (link.Next != null)
            {
                link.Next.Previous = link.Previous;
            }
            else
            {
                _last = link.Previous;
            }
            link.Next = null;
            link.Previous = null;
        }

        // ---- what each kind answers, always with the gate held ----------------

        /// Whether `thread` could take the handle now.
        internal virtual bool SignaledFor(Thread thread)
        {
            return false;
        }

        /// Whether any thread could: how far a signal walks the queue.
        internal virtual bool Signaled()
        {
            return false;
        }

        /// Takes the handle for `thread`, which SignaledFor allowed: true when
        /// that took over a mutex its owner abandoned.
        internal virtual bool Take(Thread thread)
        {
            return false;
        }

        /// Whether taking it for `thread` would hold it past what may be
        /// counted (a mutex's int.MaxValue): asked, with the gate held,
        /// before anything is taken.
        internal virtual bool Overflows(Thread thread)
        {
            return false;
        }

        /// SignalAndWait's signal, given by `thread`: false when it may not
        /// be given, and Refused says why.
        internal virtual bool Give(Thread thread)
        {
            return false;
        }

        internal virtual Exception Refused()
        {
            return new InvalidOperationException();
        }

        // ---- the gate --------------------------------------------------------

        internal static void EnterGate()
        {
            long at = Sys.AddressOf(ref _gate);
            long seen = Sys.Cas(at, 0, 1);

            if (seen == 0)
            {
                return;
            }

            // Taking it now means there may be a sleeper -- this one -- so it
            // goes to 2 and stays there until a giving back finds it free.
            while (seen != 0)
            {
                seen = Sys.AtomicSwap(at, 2);

                if (seen == 0)
                {
                    return;
                }
                Native.Wait(at, 2);
                seen = Sys.Cas(at, 0, 2);
            }
        }

        internal static void ExitGate()
        {
            long at = Sys.AddressOf(ref _gate);

            if (Sys.AtomicSwap(at, 0) == 2)
            {
                Native.Wake(at, 1);
            }
        }
    }

    /// One thread's wait that could not be answered at once: what it waits
    /// on, how, and for which thread a signal takes the handles.
    sealed class HandleWait
    {
        // LAYOUT: first instance field, at Atom.FirstWord (see Atom), and a
        // WORD, as the other waiters' are: what the waiting thread sleeps on,
        // 1 once a signal has finished the wait.
        nint _done;
        int _pad;

        // The thread that waits, which a signal takes the handles for.
        public readonly Thread Waiter;
        public readonly WaitHandle? One;
        public readonly WaitHandle[]? Many;
        public readonly int Count;
        public readonly bool All;

        /// What the wait ended with, written before the word says it ended.
        public int Result;

        // Its place in each queue: one for every handle it names, a handle
        // named twice (WaitAny allows it) queued once.
        readonly HandleWaitLink[] _links;
        int _queued;

        public HandleWait(Thread thread, WaitHandle? one, WaitHandle[]? many, int count, bool all)
        {
            _done = 0;
            _pad = 0;
            Waiter = thread;
            One = one;
            Many = many;
            Count = count;
            All = all;
            _links = new HandleWaitLink[count];
            for (int i = 0; i < count; i++)
            {
                _links[i] = new HandleWaitLink(this);
            }
            Atom.CheckLayout();
        }

        /// With the gate held: on the queue of every handle it names.
        public void Queue()
        {
            if (One != null)
            {
                One.Enqueue(_links[0]);
                _queued = 1;
                return;
            }
            WaitHandle[] handles = Many!;
            int queued = 0;
            for (int i = 0; i < Count; i++)
            {
                WaitHandle handle = handles[i];
                bool again = false;
                for (int j = 0; j < i; j++)
                {
                    if (handles[j] == handle)
                    {
                        again = true;
                        break;
                    }
                }
                if (!again)
                {
                    HandleWaitLink link = _links[queued];
                    link.Handle = handle;
                    handle.Enqueue(link);
                    queued = queued + 1;
                }
            }
            _queued = queued;
        }

        /// With the gate held: off every queue.
        public void Unqueue()
        {
            for (int i = 0; i < _queued; i++)
            {
                HandleWaitLink link = _links[i];
                WaitHandle handle = One ?? link.Handle!;
                handle.Dequeue(link);
            }
            _queued = 0;
        }

        /// With the gate held, the handles already taken for it: the wait
        /// ends with `result`, and its thread is woken.
        public void Finish(int result)
        {
            Unqueue();
            Result = result;
            long done = Atom.At(this, Atom.FirstWord);
            Sys.AtomicSwap(done, 1);
            Native.Wake(done, 1);
        }
    }

    /// A HandleWait's place in one handle's queue.
    sealed class HandleWaitLink
    {
        public readonly HandleWait Wait;
        public WaitHandle? Handle;
        public HandleWaitLink? Next;
        public HandleWaitLink? Previous;

        public HandleWaitLink(HandleWait wait)
        {
            Wait = wait;
        }
    }

    /// .NET's EventWaitHandle: set or not set. Set, an auto-reset one lets
    /// one waiter through and is not set again until the next Set; a
    /// manual-reset one lets everybody through until it is reset.
    public class EventWaitHandle : WaitHandle
    {
        EventWaitHandle(bool initialState, EventResetMode mode, int unnamed) : this(initialState, mode) { }

        bool _set;
        readonly EventResetMode _mode;

        public EventWaitHandle(bool initialState, EventResetMode mode, string? name)
            : this(initialState, mode, Named.Refused(name)) { }

        public EventWaitHandle(bool initialState, EventResetMode mode, string? name, out bool createdNew)
            : this(initialState, mode, Named.Refused(name))
        {
            createdNew = true;
        }

        public EventWaitHandle(bool initialState, EventResetMode mode, string? name, NamedWaitHandleOptions options)
            : this(initialState, mode, Named.Refused(name)) { }

        public EventWaitHandle(bool initialState, EventResetMode mode, string? name, NamedWaitHandleOptions options, out bool createdNew)
            : this(initialState, mode, Named.Refused(name))
        {
            createdNew = true;
        }

        /// No name on this platform opens one, as on .NET's Unix.
        public static EventWaitHandle OpenExisting(string name) { throw Named.Unsupported(name); }
        public static EventWaitHandle OpenExisting(string name, NamedWaitHandleOptions options) { throw Named.Unsupported(name); }

        public static bool TryOpenExisting(string name, out EventWaitHandle? result)
        {
            result = null;
            throw Named.Unsupported(name);
        }

        public static bool TryOpenExisting(string name, NamedWaitHandleOptions options, out EventWaitHandle? result)
        {
            result = null;
            throw Named.Unsupported(name);
        }

        public EventWaitHandle(bool initialState, EventResetMode mode) : base(true)
        {
            if (mode != EventResetMode.AutoReset && mode != EventResetMode.ManualReset)
            {
                throw new ArgumentException("Value of flags is invalid.", "mode");
            }
            _set = initialState;
            _mode = mode;
        }

        /// Sets it: handed straight to the oldest waiter it lets through, if
        /// there is one, which an auto-reset event then is not set for.
        public bool Set()
        {
            CheckOpen();
            EnterGate();
            _set = true;
            Answer();
            ExitGate();
            return true;
        }

        public bool Reset()
        {
            CheckOpen();
            EnterGate();
            _set = false;
            ExitGate();
            return true;
        }

        internal override bool SignaledFor(Thread thread)
        {
            return _set;
        }

        internal override bool Signaled()
        {
            return _set;
        }

        internal override bool Take(Thread thread)
        {
            if (_mode == EventResetMode.AutoReset)
            {
                _set = false;
            }
            return false;
        }

        internal override bool Give(Thread thread)
        {
            _set = true;
            Answer();
            return true;
        }
    }

    public sealed class AutoResetEvent : EventWaitHandle
    {
        public AutoResetEvent(bool initialState) : base(initialState, EventResetMode.AutoReset) { }
    }

    public sealed class ManualResetEvent : EventWaitHandle
    {
        public ManualResetEvent(bool initialState) : base(initialState, EventResetMode.ManualReset) { }
    }

    /// .NET's Mutex: a WaitHandle one thread owns at a time, taken by that
    /// thread as many times over as it waits on it and free once it has
    /// released it as many times. Unnamed only: a name is a mutex other
    /// processes share, which needs something outside this one to keep it.
    public sealed class Mutex : WaitHandle
    {
        // The owner and how many times over it holds the mutex: null and 0
        // when it is free.
        Thread? _owner;
        int _depth;

        // Left behind by a thread that ended holding it, until the next
        // thread to take it is told.
        bool _abandoned;

        // The other mutexes the owner holds: a list through them that starts
        // at its Thread.HeldMutexes.
        Mutex? _nextHeld;
        Mutex? _previousHeld;

        // A NAMED ONE'S: what holds the name for this process, its key in
        // the table of names (NamedMutexes), and how many Mutexes of this
        // process have it open. Only on the Mutex every one of them shares.
        NamedMutexFiles? _files;
        string? _key;
        int _users;

        public Mutex() : this(false) { }

        public Mutex(bool initiallyOwned) : base(true)
        {
            if (initiallyOwned)
            {
                Thread me = Thread.CurrentThread;
                EnterGate();
                Take(me);
                ExitGate();
            }
        }

        /// A MUTEX OF A NAME, which every Mutex of that name in every process
        /// shares, as .NET's are on Unix: owned by one thread of one process
        /// at a time. Made by this call, it is owned at once when
        /// `initiallyOwned` asks; already there, the call only opens it. The
        /// name is per session unless it says "Global\", and -- with no
        /// options given -- any user's, as .NET's older forms are.
        public Mutex(bool initiallyOwned, string? name) : this(initiallyOwned, name, out bool unused) { }

        public Mutex(bool initiallyOwned, string? name, out bool createdNew)
            : this(initiallyOwned, name, NamedWaitHandleOptions.Legacy, out createdNew) { }

        public Mutex(bool initiallyOwned, string? name, NamedWaitHandleOptions options)
            : this(initiallyOwned, name, options, out bool unused) { }

        public Mutex(string? name, NamedWaitHandleOptions options) : this(false, name, options, out bool unused) { }

        public Mutex(bool initiallyOwned, string? name, NamedWaitHandleOptions options, out bool createdNew) : base(true)
        {
            createdNew = true;
            if (string.IsNullOrEmpty(name))
            {
                if (initiallyOwned)
                {
                    Thread me = Thread.CurrentThread;
                    EnterGate();
                    Take(me);
                    ExitGate();
                }
                return;
            }
            Mutex core = NamedMutexes.Open(name, options, true, out createdNew)!;
            Share(core);
            if (initiallyOwned && createdNew)
            {
                core.WaitOne();
            }
        }

        Mutex(Mutex core) : base(true)
        {
            Share(core);
        }

        public static Mutex OpenExisting(string name) { return OpenExisting(name, NamedWaitHandleOptions.Legacy); }

        public static Mutex OpenExisting(string name, NamedWaitHandleOptions options)
        {
            ArgumentException.ThrowIfNullOrEmpty(name);
            Mutex? core = NamedMutexes.Open(name, options, false, out bool unused);
            if (core == null)
            {
                throw new WaitHandleCannotBeOpenedException();
            }
            return new Mutex(core);
        }

        public static bool TryOpenExisting(string name, out Mutex? result)
        {
            return TryOpenExisting(name, NamedWaitHandleOptions.Legacy, out result);
        }

        public static bool TryOpenExisting(string name, NamedWaitHandleOptions options, out Mutex? result)
        {
            ArgumentException.ThrowIfNullOrEmpty(name);
            Mutex? core = NamedMutexes.Open(name, options, false, out bool unused);
            result = core == null ? null : new Mutex(core);
            return result != null;
        }

        /// The shared Mutex of a name: no thread's yet, and its files.
        internal static Mutex ForName(string key, NamedMutexFiles files)
        {
            Mutex made = new Mutex();
            made._key = key;
            made._files = files;
            return made;
        }

        internal string? Key => _key;

        /// One more of this process's Mutexes has the name open.
        internal void Opened() { _users = _users + 1; }

        /// One fewer: the last gives the name up (NamedMutexes.Closed).
        internal bool LastClosed()
        {
            _users = _users - 1;
            if (_users > 0) return false;
            _files!.Close();
            return true;
        }

        internal override bool Elsewhere => _files != null;

        internal override void Untaken()
        {
            if (_files != null && _owner == null)
            {
                _files.Unlock(true);
            }
        }

        /// Gives back one of the calling thread's holds, and the mutex to the
        /// oldest waiter with the last; a thread that does not own it is
        /// refused.
        public void ReleaseMutex()
        {
            CheckOpen();
            Thread me = Thread.CurrentThread;
            Mutex core = (Mutex)Core;
            EnterGate();
            bool released = core.Release(me);
            ExitGate();
            if (!released)
            {
                throw new ApplicationException("Object synchronization method was called from an unsynchronized block of code.");
            }
        }

        // FREE, AND THIS PROCESS'S: a named one only when the file another
        // process's owner holds is this process's now, a hold taken here and
        // let go again unless the look takes the mutex (Untaken).
        bool Ours()
        {
            if (_files == null) return true;
            if (!_files.TryLock(out bool abandoned)) return false;
            if (abandoned) _abandoned = true;
            return true;
        }

        internal override bool SignaledFor(Thread thread)
        {
            return _owner == thread || _owner == null && Ours();
        }

        internal override bool Signaled()
        {
            return _owner == null && Ours();
        }

        // AT MOST int.MaxValue HOLDS, as .NET counts them: refused before the
        // take (Wait's WaitOverflow), never thrown with the gate held.
        internal override bool Overflows(Thread thread)
        {
            return _owner == thread && _depth == int.MaxValue;
        }

        internal override bool Take(Thread thread)
        {
            if (_owner == thread)
            {
                _depth = _depth + 1;
                return false;
            }
            _owner = thread;
            _depth = 1;
            Mutex? first = thread.HeldMutexes;
            _nextHeld = first;
            _previousHeld = null;
            if (first != null)
            {
                first._previousHeld = this;
            }
            thread.HeldMutexes = this;

            bool abandoned = _abandoned;
            _abandoned = false;
            return abandoned;
        }

        internal override bool Give(Thread thread)
        {
            return Release(thread);
        }

        /// As .NET words a release refused inside SignalAndWait: the system's
        /// own error, ERROR_NOT_OWNER, with its number.
        internal override Exception Refused()
        {
            ApplicationException refused = new ApplicationException("Attempt to release mutex not owned by caller.\n (0x80070120)");
            refused.HResult = unchecked((int)0x80070120);
            return refused;
        }

        // With the gate held: one of `thread`'s holds given back, and with
        // the last the mutex to the next waiter; false when `thread` does not
        // own it.
        bool Release(Thread thread)
        {
            if (_owner != thread)
            {
                return false;
            }
            _depth = _depth - 1;
            if (_depth == 0)
            {
                Free();
                Answer();
                if (_owner == null && _files != null)
                {
                    _files.Unlock(true);
                }
            }
            return true;
        }

        // Off its owner's list, and nobody's.
        void Free()
        {
            Thread owner = _owner!;
            if (_previousHeld != null)
            {
                _previousHeld._nextHeld = _nextHeld;
            }
            else
            {
                owner.HeldMutexes = _nextHeld;
            }
            if (_nextHeld != null)
            {
                _nextHeld._previousHeld = _previousHeld;
            }
            _nextHeld = null;
            _previousHeld = null;
            _owner = null;
            _depth = 0;
        }

        /// The mutexes `thread` still holds as it ends, left behind: each is
        /// free, and handed to its oldest waiter -- which is told so -- or
        /// else to whichever thread takes it next.
        internal static void AbandonHeld(Thread thread)
        {
            EnterGate();
            Mutex? held = thread.HeldMutexes;
            while (held != null)
            {
                held.Free();
                held._abandoned = true;
                held.Answer();
                // Another process's next owner is told too: the file still
                // says it was owned.
                if (held._owner == null && held._files != null)
                {
                    held._files.Unlock(false);
                }
                held = thread.HeldMutexes;
            }
            ExitGate();
        }
    }

    /// .NET's Semaphore: a count of permits up to a maximum, a WaitHandle
    /// that is signalled while the count is above zero; each wait takes one.
    public sealed class Semaphore : WaitHandle
    {
        int _count;
        readonly int _maximum;

        public Semaphore(int initialCount, int maximumCount, string? name)
            : this(initialCount, maximumCount, Named.Refused(name)) { }

        public Semaphore(int initialCount, int maximumCount, string? name, out bool createdNew)
            : this(initialCount, maximumCount, Named.Refused(name))
        {
            createdNew = true;
        }

        public Semaphore(int initialCount, int maximumCount, string? name, NamedWaitHandleOptions options)
            : this(initialCount, maximumCount, Named.Refused(name)) { }

        public Semaphore(int initialCount, int maximumCount, string? name, NamedWaitHandleOptions options, out bool createdNew)
            : this(initialCount, maximumCount, Named.Refused(name))
        {
            createdNew = true;
        }

        public static Semaphore OpenExisting(string name) { throw Named.Unsupported(name); }
        public static Semaphore OpenExisting(string name, NamedWaitHandleOptions options) { throw Named.Unsupported(name); }

        public static bool TryOpenExisting(string name, out Semaphore? result)
        {
            result = null;
            throw Named.Unsupported(name);
        }

        public static bool TryOpenExisting(string name, NamedWaitHandleOptions options, out Semaphore? result)
        {
            result = null;
            throw Named.Unsupported(name);
        }

        Semaphore(int initialCount, int maximumCount, int unnamed) : this(initialCount, maximumCount) { }

        public Semaphore(int initialCount, int maximumCount) : base(true)
        {
            ArgumentOutOfRangeException.ThrowIfNegative(initialCount, "initialCount");
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(maximumCount, "maximumCount");
            if (initialCount > maximumCount)
            {
                throw new ArgumentException("The initial count for the semaphore must be greater than or equal to zero and less than the maximum count.");
            }
            _count = initialCount;
            _maximum = maximumCount;
        }

        public int Release()
        {
            return Release(1);
        }

        /// Gives back `releaseCount` permits -- to the oldest waiters first --
        /// and answers the count as it was before; past the maximum, nothing
        /// is given back and SemaphoreFullException says why.
        public int Release(int releaseCount)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(releaseCount, "releaseCount");
            CheckOpen();
            EnterGate();
            int previous = _count;
            if (_maximum - previous < releaseCount)
            {
                ExitGate();
                throw new SemaphoreFullException();
            }
            _count = previous + releaseCount;
            Answer();
            ExitGate();
            return previous;
        }

        internal override bool SignaledFor(Thread thread)
        {
            return _count > 0;
        }

        internal override bool Signaled()
        {
            return _count > 0;
        }

        internal override bool Take(Thread thread)
        {
            _count = _count - 1;
            return false;
        }

        internal override bool Give(Thread thread)
        {
            if (_count == _maximum)
            {
                return false;
            }
            _count = _count + 1;
            Answer();
            return true;
        }

        internal override Exception Refused()
        {
            return new InvalidOperationException("The WaitHandle cannot be signaled because it would exceed its maximum count.");
        }
    }

    /// How a named WaitHandle is shared, as .NET 10's options: by the
    /// current user only and in the current session only, unless said
    /// otherwise -- a struct whose default says both.
    public struct NamedWaitHandleOptions
    {
        bool _notCurrentUserOnly;
        bool _notCurrentSessionOnly;
        bool _legacy;

        public bool CurrentUserOnly
        {
            get { return !_notCurrentUserOnly; }
            set { _notCurrentUserOnly = !value; }
        }

        public bool CurrentSessionOnly
        {
            get { return !_notCurrentSessionOnly; }
            set { _notCurrentSessionOnly = !value; }
        }

        /// What the forms with no options mean: any user's, and the session
        /// by the name's own prefix.
        internal static NamedWaitHandleOptions Legacy
        {
            get
            {
                NamedWaitHandleOptions made = default;
                made._notCurrentUserOnly = true;
                made._legacy = true;
                return made;
            }
        }

        internal bool IsLegacy => _legacy;
    }

    /// No WaitHandle of the name, as OpenExisting says.
    public class WaitHandleCannotBeOpenedException : ApplicationException
    {
        const string None = "No handle of the given name exists.";
        // COR_E_WAITHANDLECANNOTBEOPENED, which .NET gives every one.
        internal override int Code => unchecked((int)0x8013152C);

        public WaitHandleCannotBeOpenedException() : base(None) { }
        public WaitHandleCannotBeOpenedException(string? message) : base(message ?? None) { }
        public WaitHandleCannotBeOpenedException(string? message, Exception? innerException) : base(message ?? None, innerException) { }
    }

    /// What .NET's Unix answers for a name an EventWaitHandle or a Semaphore
    /// is given: there are no named ones there.
    static class Named
    {
        const string Message = "The named version of this synchronization primitive is not supported on this platform.";

        /// 0 for no name; any name, the empty one too, refused.
        public static int Refused(string? name)
        {
            if (name != null) throw new PlatformNotSupportedException(Message);
            return 0;
        }

        public static Exception Unsupported(string? name)
        {
            return new PlatformNotSupportedException(Message);
        }
    }

    /// THE NAMED MUTEXES THIS PROCESS HAS OPEN, by key -- where the name is
    /// kept (the user and session it is shared in) and the name -- each the
    /// one Mutex every Mutex of the name in this process shares. Changed
    /// under its own lock, never the wait handles' gate: opening a name
    /// makes files and objects.
    static class NamedMutexes
    {
        static List<Mutex>? _open;
        static AtomicCell _lock = new AtomicCell();

        const string Incorrect = "The filename, directory name, or volume label syntax is incorrect.";

        /// The Mutex of `name`, opened for one more of this process's: made
        /// (and the name with it) when `create` and nobody has it, null when
        /// not `create` and nobody has it. Refuses a name .NET refuses.
        public static Mutex? Open(string name, NamedWaitHandleOptions options, bool create, out bool createdNew)
        {
            createdNew = false;
            string bare = name;
            bool global;
            if (name.StartsWith("Global\\", StringComparison.Ordinal))
            {
                bare = name.Substring(7);
                global = true;
                if (!options.IsLegacy && options.CurrentSessionOnly) throw Prefix(name);
            }
            else if (name.StartsWith("Local\\", StringComparison.Ordinal))
            {
                bare = name.Substring(6);
                global = false;
                if (!options.IsLegacy && !options.CurrentSessionOnly) throw Prefix(name);
            }
            else
            {
                global = !options.IsLegacy && !options.CurrentSessionOnly;
            }
            if (bare.Length > 255)
            {
                throw new ArgumentException("The length of the name exceeds the maximum limit.", "name");
            }
            if (bare.Length == 0)
            {
                throw new System.IO.IOException("The parameter is incorrect. : '" + name + "'.");
            }
            if (bare.IndexOf('\\') >= 0 || bare.IndexOf('/') >= 0)
            {
                throw new System.IO.IOException(Incorrect + " : '" + name + "'.");
            }

            string scope = (options.CurrentUserOnly ? "u" + Os.Getuid() : "any") + "/"
                         + (global ? "global" : "s" + Platform.Result(Sys.Syscall(Call.Getsid, 0, 0, 0)));
            string key = scope + "/" + bare;

            AtomicCell gate = _lock;
            gate.Enter();
            try
            {
                List<Mutex> open = _open ??= new List<Mutex>();
                for (int i = 0; i < open.Count; i++)
                {
                    if (open[i].Key == key)
                    {
                        open[i].Opened();
                        return open[i];
                    }
                }
                NamedMutexFiles? files = NamedMutexFiles.Open(scope, bare, name, create, options.CurrentUserOnly, out createdNew);
                if (files == null)
                {
                    return null;
                }
                Mutex made = Mutex.ForName(key, files);
                made.Opened();
                open.Add(made);
                return made;
            }
            finally
            {
                gate.Exit();
            }
        }

        /// One of this process's Mutexes of the name closed.
        public static void Closed(Mutex core)
        {
            AtomicCell gate = _lock;
            gate.Enter();
            try
            {
                if (core.LastClosed()) _open!.Remove(core);
            }
            finally
            {
                gate.Exit();
            }
        }

        static ArgumentException Prefix(string name)
        {
            return new ArgumentException("The specified name '" + name + "' has a prefix that is not compatible with the specified option 'CurrentSessionOnly'.", "name");
        }
    }

    /// WHAT HOLDS A NAME FOR THIS PROCESS: two files in a directory of the
    /// user and session it is shared in, under the temporary directory. Every
    /// process with the name open holds the first shared (flock); the one
    /// whose thread owns the mutex holds the second exclusively, and writes 1
    /// in it while it does -- so that a 1 found by the next to take it says
    /// its owner ended holding it, and the mutex was abandoned. A process
    /// that ends lets go of both, its kernel says so for it. Made when the
    /// first file can be held exclusively: nobody else has the name, and
    /// whatever its second file says is from a mutex nobody has any more.
    sealed class NamedMutexFiles
    {
        const int Shared = 1;
        const int Exclusive = 2;
        const int NoWait = 4;
        const int Let = 8;

        int _users;
        int _owner;
        bool _locked;
        readonly string _file;

        NamedMutexFiles(int users, int owner, string file)
        {
            _users = users;
            _owner = owner;
            _file = file;
        }

        public static NamedMutexFiles? Open(string scope, string name, string written, bool create, bool userOnly, out bool createdNew)
        {
            createdNew = false;
            string dir = TempDirectory() + ".corsac-names/" + scope + "/";
            Made(dir, userOnly);
            string file = dir + Escaped(name);
            int users;
            bool alone;
            while (true)
            {
                users = Os.Open(file, O.ReadWrite | (create ? O.Create : 0), userOnly ? 384 : 438);
                if (users < 0)
                {
                    if (users == -Err.NoEnt && !create) return null;
                    throw OpenFailed(written);
                }
                alone = Os.Flock(users, Exclusive | NoWait) == 0;
                if (alone && !create)
                {
                    // A FILE LEFT BY PROCESSES THAT HAVE ALL ENDED: no name.
                    Os.Flock(users, Let);
                    Os.Close(users);
                    return null;
                }
                while (!alone && Os.Flock(users, Shared | NoWait) != 0)
                {
                    Thread.Sleep(1);
                }
                // STILL THE FILE OF THE NAME: the last to close another
                // process's hold gives the name up by removing it (Close),
                // and one opened just before that is nobody's.
                if (Same(users, file)) break;
                Os.Close(users);
            }
            int owner = Os.Open(file + ".owner", O.ReadWrite | O.Create, userOnly ? 384 : 438);
            if (owner < 0)
            {
                Os.Close(users);
                throw OpenFailed(written);
            }
            if (alone)
            {
                Mark(owner, 0);
                Os.Flock(users, Shared);
                createdNew = true;
            }
            return new NamedMutexFiles(users, owner, file);
        }

        // THE TEMPORARY DIRECTORY AS .NET'S NATIVE LAYER FINDS IT for its
        // named mutexes: TMPDIR as the process started with it, or /tmp/ --
        // Path.GetTempPath's rule, read below System.IO, which is a library
        // above this one.
        static string TempDirectory()
        {
            string? dir = Os.StartingVariable("TMPDIR");
            if (dir == null || dir.Length == 0) return "/tmp/";
            return dir.EndsWith("/") ? dir : dir + "/";
        }

        // A FILE OF THE NAME THAT CANNOT BE OPENED, as .NET reports a named
        // mutex whose shared file its native layer cannot open: the Win32
        // error ERROR_OPEN_FAILED in an IOException naming the mutex as it
        // was written (Win32Marshal), whatever the system said.
        static System.IO.IOException OpenFailed(string written)
        {
            return new System.IO.IOException("The system cannot open the device or file specified. : '" + written + "'.", unchecked((int)0x8007006E));
        }

        // Whether the descriptor is still the file at `path`.
        static bool Same(int fd, string path)
        {
            byte[] held = Stat.Room();
            byte[] named = Stat.Room();
            return Os.Fstat(fd, held) >= 0 && Os.Stat(path, named) >= 0
                && Stat.Ino(held) == Stat.Ino(named) && Stat.Device(held) == Stat.Device(named);
        }

        // The directory, and those it is in, made as they are needed: a
        // user's own closed to others, the shared ones open to all.
        static void Made(string dir, bool userOnly)
        {
            int at = 0;
            string top = TempDirectory();
            while (true)
            {
                at = dir.IndexOf('/', Math.Max(at, top.Length));
                if (at < 0) return;
                Os.Mkdir(dir.Substring(0, at), userOnly ? 448 : 1023);
                at = at + 1;
            }
        }

        // A name as a file's: letters, digits and - _ as they are, anything
        // else (a dot among them, so no name is "." or "..") as %XX of its
        // UTF-8 bytes. A LONG ONE -- a name may be 255 characters, a file's
        // name only 255 bytes -- keeps its first hundred and a hash of all of
        // it, FNV-1a's sixty-four bits.
        static string Escaped(string name)
        {
            System.Text.StringBuilder made = new System.Text.StringBuilder("mutex-");
            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(name);
            ulong hash = 14695981039346656037;
            for (int i = 0; i < bytes.Length; i++)
            {
                int b = bytes[i];
                hash = unchecked((hash ^ (ulong)b) * 1099511628211);
                if (b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '-' || b == '_')
                {
                    made.Append((char)b);
                }
                else
                {
                    made.Append('%').Append("0123456789ABCDEF"[b >> 4]).Append("0123456789ABCDEF"[b & 15]);
                }
            }
            if (made.Length > 120)
            {
                made.Length = 106;
                made.Append('~').Append(hash.ToString("x16"));
            }
            return made.ToString();
        }

        /// The second file held: this process's to give its threads.
        /// `abandoned` when its last owner ended holding it.
        public bool TryLock(out bool abandoned)
        {
            abandoned = false;
            if (_locked) return true;
            if (Os.Flock(_owner, Exclusive | NoWait) != 0) return false;
            byte[] said = new byte[1];
            abandoned = Os.Pread(_owner, said, 0, 1, 0) == 1 && said[0] == 1;
            Mark(_owner, 1);
            _locked = true;
            return true;
        }

        /// Let go: `released` when its owner released it, which clears the
        /// mark; an owner that ended holding it leaves the mark for the next.
        public void Unlock(bool released)
        {
            if (!_locked) return;
            if (released) Mark(_owner, 0);
            _locked = false;
            Os.Flock(_owner, Let);
        }

        /// This process lets go of the name -- and the last to have it open
        /// anywhere removes its files, as .NET removes its own.
        public void Close()
        {
            Unlock(false);
            if (Os.Flock(_users, Exclusive | NoWait) == 0)
            {
                Os.Unlink(_file + ".owner");
                Os.Unlink(_file);
            }
            Os.Close(_owner);
            Os.Close(_users);
        }

        static void Mark(int fd, int value)
        {
            byte[] mark = new byte[] { (byte)value };
            Os.Lseek(fd, 0, 0);
            Os.Write(fd, mark, 0, 1);
        }
    }

    /// A wait took a mutex whose owner ended without releasing it. The wait
    /// has taken it all the same: whatever the mutex guarded may be half
    /// changed. MutexIndex and Mutex name it when WaitAny took it; -1 and
    /// null otherwise.
    public class AbandonedMutexException : SystemException
    {
        const string Abandoned = "The wait completed due to an abandoned mutex.";
        // COR_E_ABANDONEDMUTEX, which .NET gives every one.
        internal override int Code => unchecked((int)0x8013152D);

        int _mutexIndex = -1;
        Mutex? _mutex;

        public AbandonedMutexException() : base(Abandoned) { }
        public AbandonedMutexException(string? message) : base(message ?? Abandoned) { }
        public AbandonedMutexException(string? message, Exception? inner) : base(message ?? Abandoned, inner) { }

        public AbandonedMutexException(int location, WaitHandle? handle) : base(Abandoned)
        {
            Locate(location, handle);
        }

        public AbandonedMutexException(string? message, int location, WaitHandle? handle) : base(message)
        {
            Locate(location, handle);
        }

        public AbandonedMutexException(string? message, Exception? inner, int location, WaitHandle? handle) : base(message, inner)
        {
            Locate(location, handle);
        }

        void Locate(int location, WaitHandle? handle)
        {
            _mutexIndex = location;
            _mutex = handle as Mutex;
        }

        public Mutex? Mutex => _mutex;

        public int MutexIndex => _mutexIndex;
    }
}

/// .NET's ManualResetEventSlim: a word that is set or not and a futex on it,
/// with the waits that give up after a time.
public class ManualResetEventSlim : IDisposable
{
    // LAYOUT: first instance field, at Atom.FirstWord (see Atom).
    nint _signalled;
    int _pad;

    public ManualResetEventSlim() : this(false) { }

    public ManualResetEventSlim(bool initialState)
    {
        _signalled = initialState ? 1 : 0;
        _pad = 0;
        Atom.CheckLayout();
    }

    public bool IsSet => Sys.PeekWord(Atom.At(this, Atom.FirstWord)) != 0;

    public void Set()
    {
        long at = Atom.At(this, Atom.FirstWord);
        Sys.AtomicSwap(at, 1);
        Native.Wake(at, Native.WakeAll);
    }

    public void Reset()
    {
        Sys.AtomicSwap(Atom.At(this, Atom.FirstWord), 0);
    }

    public void Wait()
    {
        long at = Atom.At(this, Atom.FirstWord);
        while (Sys.PeekWord(at) == 0) Native.Wait(at, 0);
    }

    public bool Wait(TimeSpan timeout) => Wait(Timeouts.Guarded(timeout));

    /// True once set; false when `millisecondsTimeout` passes first (-1: never).
    public bool Wait(int millisecondsTimeout)
    {
        ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1, "millisecondsTimeout");
        if (millisecondsTimeout == -1) { Wait(); return true; }
        long at = Atom.At(this, Atom.FirstWord);
        // Timed by the runtime's own clock, as Thread.Join's: Stopwatch is a
        // library above this one.
        long until = Clock.Now() + (long)millisecondsTimeout * 1000000;
        while (Sys.PeekWord(at) == 0)
        {
            long left = until - Clock.Now();
            if (left <= 0) return false;
            Native.WaitFor(at, 0, left);
        }
        return true;
    }

    public void Dispose() { }
}
