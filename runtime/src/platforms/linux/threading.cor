// The Linux half of the scheduler: what needs a kernel.
//
// lib/threading.cor is the scheduler and the tasks, and it makes no system
// call at all: it asks for the time, for a sleep until a deadline, for a
// wait and a wake on a word, and for a thread -- through the names Clock,
// Native and Thread. This file is those names on Linux: clock_gettime and
// nanosleep, futexes, clone(2) with a stack of its own, and the pool of
// worker threads Scheduler.UseThreads starts. lib/sys/baremetal.cor answers
// the same names with the PIT and no threads, which is how the same
// scheduler runs in the bootloader and the kernel.

static partial class Scheduler
{
    /// Runs posted work on `count` threads from now on. Zero leaves the
    /// single-threaded event loop alone, which is the default.
    ///
    /// Call it once, before the work starts. Pool work may allocate and may
    /// throw: each worker has a block of its own, and an exception that escapes
    /// a work item is reported exactly as one on the event loop is.
    public static void UseThreads(int count)
    {
        if (count < 0)
        {
            throw new ArgumentOutOfRangeException("count");
        }
        if (count == 0)
        {
            return;
        }
        if (_workers > 0)
        {
            throw new InvalidOperationException("the scheduler already has worker threads");
        }

        Gate();
        SignalCell();

        // Grown once, here, so that a Post from a worker does not have to
        // allocate with the queue's lock held.
        Reserve(1024);

        _workers = count;

        for (int i = 0; i < count; i++)
        {
            Thread.Start(new PoolWorker());
        }
    }
}

/// The monotonic clock and sleeping, through Linux system calls.
///
/// (These belong to lib/sys/linux.cor in spirit -- they are the only Linux
/// facts in this file -- and move there when a second target needs its own.)
static class Clock
{
    const long ClockGettime = Call.ClockGetTime;      // (clockid, struct timespec *)
    const long ClockNanosleep = Call.ClockNanosleep;  // (clockid, flags, request, remain)
    const long Nanosleep = Call.NanoSleep;            // (request, remain)
    const long Monotonic = 1;           // CLOCK_MONOTONIC
    const long AbsoluteTime = 1;        // TIMER_ABSTIME
    const long NoSys = -38;             // -ENOSYS
    const long NanosPerSecond = 1000000000;

    /// Nanoseconds on CLOCK_MONOTONIC. The timespec is two words, seconds
    /// then nanoseconds -- 32 bits each on i386, 64 in long mode; neither
    /// is negative for this clock.
    public static long Now()
    {
        // Thread-local syscall storage is available before any allocation.
        // Clock reads do not retain it or dispatch managed signal handlers.
        long at = Sys.ThreadBlock() + Tls.Scratch;
        Sys.Poke(at, 0);
        Sys.Poke(at + WordSize.Bytes, 0);

        Sys.Syscall(ClockGettime, Monotonic, at, 0);

        long seconds = Sys.Peek(at);
        long nanos = Sys.Peek(at + WordSize.Bytes);

        return seconds * NanosPerSecond + nanos;
    }

    /// Microseconds on the same clock: what the collector times its pauses
    /// by (Gc.PauseClock).
    public static long NowMicroseconds()
    {
        return Now() / 1000;
    }

    /// Milliseconds on the same clock, for programs that measure.
    public static long NowMilliseconds()
    {
        return Now() / 1000000;
    }

    /// Returns once CLOCK_MONOTONIC has reached `deadline`, or early on a
    /// signal (the caller re-checks the clock anyway).
    public static void SleepUntil(long deadline)
    {
        // The kernel consumes this timespec during the syscall. Signal
        // callbacks run only afterwards; the fallback rewrites it after Now.
        long at = Sys.ThreadBlock() + Tls.Scratch;

        Sys.Poke(at, deadline / NanosPerSecond);
        Sys.Poke(at + WordSize.Bytes, deadline % NanosPerSecond);

        // Asleep is stopped, as far as a collection is concerned: see the note
        // on Native.Wait.
        Runtime.BeginBlocking();

        long result = Platform.Result(Sys.Syscall(ClockNanosleep, Monotonic, AbsoluteTime, at, 0, 0, 0));

        Runtime.EndBlocking();

        if (result == 0 - Err.Intr || PosixSignalRegistration.Pending)
        {
            // A signal ended the sleep, or came just before it: the program's handlers run now, at
            // the same quiet moment Os.Poll and Os.Sleep give them.
            PosixSignalRegistration.Deliver();
        }

        if (result != NoSys)
        {
            return;
        }

        // A kernel without clock_nanosleep: sleep for the remaining interval.
        long left = deadline - Now();

        if (left <= 0)
        {
            return;
        }

        Sys.Poke(at, left / NanosPerSecond);
        Sys.Poke(at + WordSize.Bytes, left % NanosPerSecond);
        Runtime.BeginBlocking();
        Sys.Syscall(Nanosleep, at, 0, 0);
        Runtime.EndBlocking();
    }
}

/// The Linux facts a thread needs: clone(2), futex(2), gettid(2), and pages to
/// put a stack in.
///
/// WHY A HAND-ASSEMBLED TRAMPOLINE. clone(2) on i386 returns TWICE, once in
/// each thread, and the child comes back with the stack pointer the call was
/// given and nothing else changed -- same EBP, same return address, same
/// everything. Code compiled from this language addresses its locals through
/// EBP, so a child that simply "returned" from the function holding the system
/// call would run that function's epilogue against the PARENT's frame and
/// return onto the parent's stack: two threads on one stack. Every libc solves
/// this in assembler, and so does this: sixty bytes written into an executable
/// page, called through Sys.Call5, which after the call puts the child on its
/// own stack with a zero frame pointer and jumps to a real function.
static class Native
{
    const long Mmap = Call.Mmap;        // (addr, len, prot, flags, fd, offset)
    const long Clone = Call.Clone;
    const long Futex = Call.Futex;      // (uaddr, op, val, timeout, uaddr2, val3)
    const long GetTid = Call.Gettid;    // () -> the caller's thread id
    const long Exit = Call.Exit;        // (status): THIS thread only

    const long ProtReadWrite = 3;
    const long ProtReadWriteExec = 7;
    const long MapPrivateAnonymous = 0x22;

    const long FutexWait = 128;         // FUTEX_WAIT | FUTEX_PRIVATE_FLAG
    const long FutexWake = 129;         // FUTEX_WAKE | FUTEX_PRIVATE_FLAG

    /// CLONE_VM | FS | FILES | SIGHAND | THREAD | SYSVSEM: one address space,
    /// one file table, one signal disposition, one thread group -- a thread in
    /// the sense every other language means.
    public const long ThreadFlags = 0x100 | 0x200 | 0x400 | 0x800 | 0x10000 | 0x40000;

    /// Pages that can be read, written and executed, or 0.
    static long MapExecutable(long bytes)
    {
        long got = Sys.Syscall(Mmap, 0, bytes, ProtReadWriteExec, MapPrivateAnonymous, 0 - 1, 0);

        if (Platform.Result(got) < 0)
        {
            return 0;
        }
        return got;
    }

    /// Pages for a thread stack, or 0. A fixed size, not MAP_GROWSDOWN: the
    /// guard page a growing stack needs is the unmapped page below this one.
    public static long MapStack(long bytes)
    {
        long got = Sys.Syscall(Mmap, 0, bytes, ProtReadWrite, MapPrivateAnonymous, 0 - 1, 0);

        if (Platform.Result(got) < 0)
        {
            return 0;
        }
        return got;
    }

    static long _trampoline;

    static long Byte(long at, long value)
    {
        Sys.PokeByte(at, value);
        return at + 1;
    }

    static long Immediate(long at, long value)
    {
        Sys.PokeByte(at, value & 0xFF);
        Sys.PokeByte(at + 1, (value >> 8) & 0xFF);
        Sys.PokeByte(at + 2, (value >> 16) & 0xFF);
        Sys.PokeByte(at + 3, (value >> 24) & 0xFF);
        return at + 4;
    }

    /// The trampoline, written once. Called as
    ///
    ///     tramp(flags, childStackTop, parameters)
    ///
    /// where `parameters` addresses two words, the entry point and the argument
    /// to give it. Three arguments and not four, because Sys.Call is the only
    /// indirect call the x86 backend has and it takes three.
    ///
    /// The parent answers the new thread id (or -errno); the child ends up on
    /// the new stack with a zero frame pointer, calls entry(argument), and ends
    /// itself with exit(2) when that returns.
    static long Trampoline()
    {
        long code = TryTrampoline();

        if (code == 0)
        {
            throw new InvalidOperationException("threading: no executable page for the thread trampoline");
        }
        return code;
    }

    /// The same, or 0 when there is no page for it: what the collector asks,
    /// which may neither throw nor allocate.
    public static long TryTrampoline()
    {
        long code = _trampoline;

        if (code != 0)
        {
            return code;
        }

        code = MapExecutable(4096);

        if (code == 0)
        {
            return 0;
        }

        long at = code;

#if TARGET_AMD64
        // Long mode: called with flags in RDI, the child's stack top in RSI
        // and `parameters` in RDX, as the System V convention delivers the
        // three arguments -- which is also where clone(2) wants the first
        // two. The rest of clone's arguments (parent tid, child tid, tls) are
        // RDX, R10 and R8, all zero: the child sets its own FS.
        at = Byte(at, 0x4C); at = Byte(at, 0x8B); at = Byte(at, 0x02);                        // mov r8,[rdx]      entry
        at = Byte(at, 0x4C); at = Byte(at, 0x8B); at = Byte(at, 0x4A); at = Byte(at, 0x08);   // mov r9,[rdx+8]    argument
        at = Byte(at, 0x48); at = Byte(at, 0x83); at = Byte(at, 0xEE); at = Byte(at, 0x10);   // sub rsi,16
        at = Byte(at, 0x4C); at = Byte(at, 0x89); at = Byte(at, 0x0E);                        // mov [rsi],r9
        at = Byte(at, 0x4C); at = Byte(at, 0x89); at = Byte(at, 0x46); at = Byte(at, 0x08);   // mov [rsi+8],r8
        at = Byte(at, 0x31); at = Byte(at, 0xD2);                                             // xor edx,edx
        at = Byte(at, 0x45); at = Byte(at, 0x31); at = Byte(at, 0xD2);                        // xor r10d,r10d
        at = Byte(at, 0x45); at = Byte(at, 0x31); at = Byte(at, 0xC0);                        // xor r8d,r8d
        at = Byte(at, 0xB8); at = Immediate(at, Clone);                                       // mov eax,56
        at = Byte(at, 0x0F); at = Byte(at, 0x05);                                             // syscall
        at = Byte(at, 0x48); at = Byte(at, 0x85); at = Byte(at, 0xC0);                        // test rax,rax
        at = Byte(at, 0x75); at = Byte(at, 0x11);                                             // jnz parent (+17)

        // The child, on its own stack: [rsp] is the argument, [rsp+8] the
        // entry. Popping both leaves RSP at the sixteen-aligned top, so the
        // call sees the alignment every call does.
        at = Byte(at, 0x31); at = Byte(at, 0xED);                                             // xor ebp,ebp
        at = Byte(at, 0x5F);                                                                  // pop rdi  (argument)
        at = Byte(at, 0x58);                                                                  // pop rax  (entry)
        at = Byte(at, 0xFF); at = Byte(at, 0xD0);                                             // call rax
        at = Byte(at, 0x31); at = Byte(at, 0xFF);                                             // xor edi,edi
        at = Byte(at, 0xB8); at = Immediate(at, Exit);                                        // mov eax,60
        at = Byte(at, 0x0F); at = Byte(at, 0x05);                                             // syscall
        at = Byte(at, 0xEB); at = Byte(at, 0xFE);                                             // jmp $ (never reached)

        // parent:
        at = Byte(at, 0xC3);                                                                  // ret
#else
        at = Byte(at, 0x53);                                                                  // push ebx (callee-saved)
        at = Byte(at, 0x8B); at = Byte(at, 0x54); at = Byte(at, 0x24); at = Byte(at, 0x10);   // mov edx,[esp+16]  parameters
        at = Byte(at, 0x8B); at = Byte(at, 0x4C); at = Byte(at, 0x24); at = Byte(at, 0x0C);   // mov ecx,[esp+12]  childStackTop
        at = Byte(at, 0x8B); at = Byte(at, 0x02);                                             // mov eax,[edx]     entry
        at = Byte(at, 0x89); at = Byte(at, 0x41); at = Byte(at, 0xFC);                        // mov [ecx-4],eax
        at = Byte(at, 0x8B); at = Byte(at, 0x42); at = Byte(at, 0x04);                        // mov eax,[edx+4]   argument
        at = Byte(at, 0x89); at = Byte(at, 0x41); at = Byte(at, 0xF8);                        // mov [ecx-8],eax
        at = Byte(at, 0x83); at = Byte(at, 0xE9); at = Byte(at, 0x08);                        // sub ecx,8
        at = Byte(at, 0x8B); at = Byte(at, 0x5C); at = Byte(at, 0x24); at = Byte(at, 0x08);   // mov ebx,[esp+8]   flags
        at = Byte(at, 0xB8); at = Immediate(at, Clone);                                       // mov eax,120
        at = Byte(at, 0xCD); at = Byte(at, 0x80);                                             // int 0x80
        at = Byte(at, 0x85); at = Byte(at, 0xC0);                                             // test eax,eax
        at = Byte(at, 0x75); at = Byte(at, 0x15);                                             // jnz parent (+21)

        // The child, on its own stack: [esp] is the argument, [esp+4] the entry.
        at = Byte(at, 0x31); at = Byte(at, 0xED);                                             // xor ebp,ebp
        at = Byte(at, 0x58);                                                                  // pop eax  (argument)
        at = Byte(at, 0x5A);                                                                  // pop edx  (entry)
        at = Byte(at, 0x50);                                                                  // push eax
        at = Byte(at, 0xFF); at = Byte(at, 0xD2);                                             // call edx
        at = Byte(at, 0x83); at = Byte(at, 0xC4); at = Byte(at, 0x04);                        // add esp,4
        at = Byte(at, 0x31); at = Byte(at, 0xDB);                                             // xor ebx,ebx
        at = Byte(at, 0xB8); at = Immediate(at, Exit);                                        // mov eax,1
        at = Byte(at, 0xCD); at = Byte(at, 0x80);                                             // int 0x80
        at = Byte(at, 0xEB); at = Byte(at, 0xFE);                                             // jmp $ (never reached)

        // parent:
        at = Byte(at, 0x5B);                                                                  // pop ebx
        at = Byte(at, 0xC3);                                                                  // ret
#endif

        _trampoline = code;
        return code;
    }

    /// The two words the trampoline reads, in the same page as the code and so
    /// out of the collector's way entirely. One pair for the whole process:
    /// only the parent reads them, and only before the clone, so a lock around
    /// a launch is all they need.
    const long ParameterOffset = 64;

    static AtomicCell? _launching;

    static AtomicCell LaunchLock()
    {
        AtomicCell? l = _launching;

        if (l == null)
        {
            Atom.CheckLayout();
            l = new AtomicCell();
            _launching = l;
        }
        return l;
    }

    /// Starts a thread that runs `entry(argument)` on a stack of its own.
    /// Answers the new thread id, or a negative errno.
    public static long Spawn(long entry, long argument, long stackTop)
    {
        long code = Trampoline();
        AtomicCell gate = LaunchLock();

        gate.Enter();

        long parameters = code + ParameterOffset;

        Sys.Poke(parameters, entry);
        Sys.Poke(parameters + WordSize.Bytes, argument);

        long id = Platform.Result(Sys.CallNative(code, ThreadFlags, stackTop, parameters));

        gate.Exit();
        return id;
    }

    /// A thread with no Thread of its own -- the collector's workers: entry
    /// runs on the pages [stack, stack + bytes), whose lowest two words carry
    /// its entry and argument to the trampoline, so no lock and no shared
    /// page are needed and nothing is allocated. The thread id, or -errno.
    public static long SpawnBare(long entry, long argument, long stack, long bytes)
    {
        long code = TryTrampoline();

        if (code == 0)
        {
            return 0 - 12;      // ENOMEM
        }
        Sys.Poke(stack, entry);
        Sys.Poke(stack + WordSize.Bytes, argument);
        return Platform.Result(Sys.CallNative(code, ThreadFlags, stack + bytes, stack));
    }

    public static long CurrentThreadId()
    {
        return Sys.Syscall(GetTid, 0, 0, 0);
    }

    /// Sleeps until the word at `at` stops being `expect`, or until someone
    /// wakes it. A spurious return is normal: every caller re-reads the word.
    ///
    /// A thread asleep here is a thread that will not allocate until somebody
    /// wakes it, and the collector stops the world by waiting for every other
    /// thread to say it has stopped: without the pair around the call, a
    /// collection while any worker was idle would wait for that worker and the
    /// worker would wait for the work that the collection is in the way of.
    public static void Wait(long at, long expect)
    {
        Runtime.BeginBlocking();
        Sys.Syscall(Futex, at, FutexWait, expect, 0, 0, 0);
        Runtime.EndBlocking();
    }

    /// As Wait, giving up after `nanoseconds` -- FUTEX_WAIT's timeout, which
    /// is relative. A return by timeout, wake or signal looks the same; every
    /// caller re-reads its word and its clock.
    public static void WaitFor(long at, long expect, long nanoseconds)
    {
        long timeout = Sys.ThreadBlock() + Tls.Scratch;
        // A timespec is two words, whatever the word is: 32-bit halves at 0
        // and 4 were a garbage timeout on every timed wait in long mode.
        Sys.Poke(timeout, nanoseconds / 1000000000);
        Sys.Poke(timeout + WordSize.Bytes, nanoseconds % 1000000000);
        Runtime.BeginBlocking();
        Sys.Syscall(Futex, at, FutexWait, expect, timeout, 0, 0);
        Runtime.EndBlocking();
    }

    /// Wakes up to `count` waiters on the word at `at`.
    public static void Wake(long at, long count)
    {
        Sys.Syscall(Futex, at, FutexWake, count, 0, 0, 0);
    }

    public const long WakeAll = 0x7FFFFFFF;
}

/// A thread of execution, started with a body to run.
///
/// A thread body may allocate, throw and catch like any other code: the
/// handler chain and the allocation buffer are words of the block this class
/// gives every thread it starts (lib/rt/runtime.cor, class Tls), and the
/// collector is told where the thread's stack is before the thread runs.
///
/// THE ONE THING TO KNOW. A collection stops every thread, and a thread stops
/// when it allocates, when it waits on a lock or a futex, or when it sleeps.
/// A thread in a long computation that does none of those DELAYS every other
/// thread's collection until it does one. See the note above GcLock in
/// lib/rt/gc.cor for why, and for what fixes it.
public delegate void ThreadStart();

/// A thread body handed one argument, Start(object) passing it, as .NET's.
public delegate void ParameterizedThreadStart(object? obj);

class ThreadStateException : SystemException
{
    public ThreadStateException() : base("Thread was in an invalid state for the operation being executed.") { }
    public ThreadStateException(string? message) : base(message) { }
    public ThreadStateException(string? message, Exception? innerException) : base(message, innerException) { }
}

class Thread
{
    // LAYOUT: these two must stay the first instance fields (see Atom). _done
    // is what Join waits on, and it is a futex word, so it must have an
    // address -- hence a field of an object rather than a static.
    nint _done;
    nint _lock;

    Action _body;
    ThreadStart? _start;
    ParameterizedThreadStart? _withArgument;
    object? _argument;
    long _id;
    long _stack;
    long _stackBytes;
    long _block;
    int _slot;
    string? _name;
    bool _background;
    bool _counted;

    /// How many foreground threads are running, as a futex word the end of
    /// Main waits on (WaitForForeground); and a spin lock over the counting.
    // Two words a CAS and a futex work on: the count, and its lock.
    static readonly nint[] _foreground = new nint[2];

    /// Big enough for the deepest call a thread body here makes, and cheap:
    /// anonymous pages cost nothing until they are touched. EIGHT MEGABYTES
    /// IN LONG MODE, where every frame is half again or twice its i386 size:
    /// a compiler's recursive rewrite that fit a megabyte on i386 ran off the
    /// end of one in long mode, through the thread block below it.
#if TARGET_64BIT
    const long StackBytes = 8388608;
#else
    const long StackBytes = 1048576;
#endif

    /// The runtime's own threads -- Task workers, the pool -- are background
    /// threads, as .NET's pool threads are.
    Thread(Action body, int slot)
    {
        _done = 0;
        _lock = 0;
        _body = body;
        _slot = slot;
        _background = true;
    }

    public Thread(ThreadStart start)
    {
        if (start == null) throw new ArgumentNullException("start");
        _start = start;
    }

    public Thread(ParameterizedThreadStart start)
    {
        if (start == null) throw new ArgumentNullException("start");
        _withArgument = start;
    }

    /// A THREAD OF A STACK SIZE ITS OWN, as .NET's maxStackSize: 0 the
    /// default; anything below the least a thread can run on, that least
    /// (MinimumStack); the size rounded up to a page. Taken where this
    /// runtime maps the stack itself (Launch); a thread the C library makes
    /// (LaunchNative) has the C library's.
    public Thread(ThreadStart start, int maxStackSize) : this(start)
    {
        if (maxStackSize < 0) throw new ArgumentOutOfRangeException("maxStackSize");
        _requestedStack = maxStackSize;
    }

    public Thread(ParameterizedThreadStart start, int maxStackSize) : this(start)
    {
        if (maxStackSize < 0) throw new ArgumentOutOfRangeException("maxStackSize");
        _requestedStack = maxStackSize;
    }

    // The stack a thread asked for (0: StackBytes), and the least one runs
    // on: the thread block's page, the guard page, and room above them.
    long _requestedStack;
    const long MinimumStack = 65536;

    long StackSize()
    {
        if (_requestedStack <= 0) return StackBytes;
        long bytes = _requestedStack < MinimumStack ? MinimumStack : _requestedStack;
        return (bytes + 4095) & (0 - 4096);
    }

    /// Starts a thread made with a ParameterizedThreadStart, handing it
    /// `parameter`; one made with a ThreadStart refuses, as in .NET.
    public void Start(object? parameter)
    {
        if (_withArgument == null)
            throw new InvalidOperationException("The thread was created with a ThreadStart delegate that does not accept a parameter.");
        _argument = parameter;
        Start();
    }

    /// The thread id the kernel gave it, or 0 before it has been started.
    public long Id => _id;

    public bool IsAlive => _id != 0 && _done == 0;

    /// The thread's name, for a debugger and for the program; null until
    /// given one.
    public string? Name
    {
        get { return _name; }
        set { _name = value; }
    }

    /// A background thread does not keep the process alive: when Main
    /// returns, the process waits for every FOREGROUND thread and no other,
    /// as .NET's does. A thread made with a ThreadStart is a foreground one
    /// until told otherwise; it may be told at any time.
    public bool IsBackground
    {
        get { return _background; }
        set
        {
            Counting(true);
            try
            {
                _background = value;
                bool running = _id != 0 && Sys.PeekWord(Atom.At(this, Atom.FirstWord)) == 0;
                if (running && !value && !_counted) Count(1);
                if (running && value && _counted) Count(-1);
            }
            finally { Counting(false); }
        }
    }

    static void Counting(bool enter)
    {
        long at = Sys.ArrayData(_foreground) + WordSize.Bytes;
        if (!enter)
        {
            Sys.AtomicSwap(at, 0);
            return;
        }
        while (Sys.Cas(at, 0, 1) != 0) { }
    }

    /// With the counting lock held: one foreground thread more or fewer.
    void Count(int by)
    {
        long at = Sys.ArrayData(_foreground);
        _counted = by > 0;
        if (Sys.AtomicAdd(at, by) + by == 0) Native.Wake(at, Native.WakeAll);
    }

    /// The end of Main waits here for the foreground threads (Runtime.Exit).
    static void WaitForForeground()
    {
        long at = Sys.ArrayData(_foreground);
        while (true)
        {
            long now = Sys.Peek(at) & WordSize.AddressMask;
            if (now == 0) return;
            Native.Wait(at, now);
        }
    }

    /// This thread's kernel thread id (gettid(2)), which is the process id on
    /// the first thread.
    public static long CurrentId => Native.CurrentThreadId();

    // ---- the registry -------------------------------------------------------
    //
    // A started thread is handed nothing but a machine word, and a word cannot
    // be an object reference this language can hand back: the child is given
    // its slot in this table instead, which is also what keeps a running
    // thread's object -- and its body -- reachable for the collector.

    static Thread?[] _all = new Thread?[64];
    static int _slots;
    static AtomicCell? _registry;

    static AtomicCell Registry()
    {
        AtomicCell? r = _registry;

        if (r == null)
        {
            Atom.CheckLayout();
            r = new AtomicCell();
            _registry = r;
        }
        return r;
    }

    static int Register(Thread t)
    {
        AtomicCell gate = Registry();

        gate.Enter();

        if (_slots == _all.Length)
        {
            Thread?[] bigger = new Thread?[_all.Length * 2];

            for (int i = 0; i < _slots; i++)
            {
                bigger[i] = _all[i];
            }
            _all = bigger;
        }

        int slot = _slots;

        _all[slot] = t;
        _slots = _slots + 1;

        gate.Exit();
        return slot;
    }

    // ---- starting and joining -----------------------------------------------

    /// Runs `body` on a new thread and answers the thread, already running.
    public static Thread Start(Action body)
    {
        if (body == null)
        {
            throw new ArgumentNullException("body");
        }

        Atom.CheckLayout();

        Thread t = new Thread(body, 0);

        t.Start();
        return t;
    }

    public void Start()
    {
        Atom.CheckLayout();
        // The second layout word is the one-time start claim, not a held
        // mutex: even a completed thread cannot be started a second time.
        if (Sys.Cas(Atom.At(this, Atom.SecondWord), 0, 1) != 0)
            throw new ThreadStateException("Thread has already been started.");
        _slot = Register(this);
        if (!_background)
        {
            Runtime.ForegroundWait = Sys.AddressOf(Thread.WaitForForeground);
            Counting(true);
            try { Count(1); }
            finally { Counting(false); }
        }
        try { Launch(); }
        catch
        {
            Counting(true);
            try { if (_counted) Count(-1); }
            finally { Counting(false); }
            throw;
        }
    }

    // A THREAD C CAN RUN IN. When the C library is loaded -- a program with
    // a [DllImport], or one linked against a library that has one -- a new
    // thread is made by its pthread_create, so that it has the C library's
    // own per-thread state (errno, the allocator's caches, the stack
    // canary) for whatever C it calls. clone(2) alone gives it the creating
    // thread's, which C would then share between two threads at once. The
    // runtime's block is its own page; the stack is the C library's.

    static long _nativeCreate;          // pthread_create, -1 when there is none
    static long _nativeDetach;

    static long NativeCreate()
    {
        if (_nativeCreate == 0)
        {
            long create = Runtime.NativeSymbol("pthread_create");
            _nativeDetach = Runtime.NativeSymbol("pthread_detach");
            _nativeCreate = create == 0 || _nativeDetach == 0 ? -1 : create;
        }
        return _nativeCreate < 0 ? 0 : _nativeCreate;
    }

    void Launch()
    {
        long create = NativeCreate();
        if (create != 0)
        {
            LaunchNative(create);
            return;
        }

        long stackBytes = StackSize();
        long stack = Native.MapStack(stackBytes);

        if (stack == 0)
        {
            throw new InvalidOperationException("threading: no memory for a thread stack");
        }

        // A GUARD PAGE between the block (the mapping's first page) and the
        // stack: a stack that runs out faults at once, where it happens, and
        // does not write over the thread block -- which went on to hand out a
        // null thread and fault somewhere with nothing to do with the stack.
        Platform.Guard(stack + 4096, 4096);

        _stack = stack;
        _stackBytes = stackBytes;

        // The top, sixteen-byte aligned, because the first thing the child does
        // is push and call.
        long top = (stack + stackBytes) & (0 - 16);

        // THE BLOCK GOES AT THE BOTTOM OF THE SAME MAPPING. The child needs it
        // before it may allocate, so it cannot be allocated by the child; it is
        // filled in here, by the parent, while the child does not exist yet.
        // The stack grows down towards it, and meets the guard page first.
        _block = stack;

        // Registered by the PARENT, and BEFORE the clone: a collection in the
        // window between the two must not sweep an object the child has
        // already made, and must not wait for a thread that does not exist
        // yet. It is registered stopped, with an empty stack, and the child
        // says it is running once its block is its own (see Begin).
        Runtime.RegisterThread(_block, top);

        long id = Native.Spawn(Sys.AddressOf(Thread.ChildEntry), _slot, top);

        if (id < 0)
        {
            Runtime.ForgetThread(_block);
            throw new InvalidOperationException("threading: clone failed");
        }
        _id = id;
    }

    void LaunchNative(long create)
    {
        long block = Platform.Map(4096);

        if (block == 0)
        {
            throw new InvalidOperationException("threading: no memory for a thread block");
        }
        _block = block;
        _stack = 0;
        _stackBytes = 0;

        // Registered stopped with an empty stack, as Launch does: the child
        // says where its stack is once it stands on it (BeginNative).
        Runtime.RegisterThread(_block, 0);

        byte[] handle = new byte[8];
        long failed = Runtime.CallC(create, Sys.ArrayData(handle), 0, Sys.AddressOf(Thread.NativeEntry), _slot);

        if (failed != 0)
        {
            Runtime.ForgetThread(_block);
            throw new InvalidOperationException("threading: pthread_create failed");
        }
        // Nobody joins it through the C library: Join waits on the thread's
        // own word, so its C side is released when it returns.
        Runtime.CallC(_nativeDetach, Sys.Peek(Sys.ArrayData(handle)), 0, 0, 0);
        _id = 1;
    }

    /// Where a thread pthread_create made begins: a C start routine, which
    /// this compiler's convention already is.
    static long NativeEntry(long slot)
    {
        Thread? t = _all[(int)slot];

        if (t != null)
        {
            t.BeginNative(Sys.FramePointer());
        }
#if !TARGET_64BIT
        // Back to the C library it goes, which finds its thread through GS
        // as it tears the thread down (on i386; x86-64's runtime is in GS
        // and C's in FS, and neither moved).
        if (Runtime.NativeGs != 0)
        {
            Sys.SetGs(Runtime.NativeGs);
        }
#endif
        return 0;
    }

    /// Begin, for a thread on the C library's stack: nothing above `frame`
    /// is the runtime's, so the stack the collector reads starts there.
    void BeginNative(long frame)
    {
        Platform.SetThreadBlock(_block);
        Sys.Poke(_block + Tls.ThreadId, Native.CurrentThreadId());
        long top = frame + 2 * WordSize.Bytes;
        Runtime.MoveStack(top, top);
        Runtime.EndBlocking();
        Body();
    }

    /// Where a new thread begins, on its own stack with no frame above it. It
    /// takes a slot rather than a reference because a machine word is all
    /// clone(2) can carry.
    static void ChildEntry(long slot)
    {
        Thread? t = _all[(int)slot];

        if (t != null)
        {
            t.Begin();
        }
    }

    /// The first thing a new thread does. Until SetThreadBlock returns, GS
    /// still names the PARENT's block -- clone(2) leaves the thread-local
    /// descriptors alone unless it is asked to set them -- so nothing above
    /// that line may allocate or enter a `try`; a field read and a call are
    /// all it is.
    void Begin()
    {
        Platform.SetThreadBlock(_block);
        Sys.Poke(_block + Tls.ThreadId, Native.CurrentThreadId());

        // Running, from here on: until this the collector was told this thread
        // was stopped with nothing on its stack, which it was.
        Runtime.EndBlocking();
        Body();
    }

    /// An exception that escapes a thread body ends the program, which is what
    /// .NET does with one that escapes a thread's start routine.
    void Body()
    {
        try
        {
            ThreadStart? start = _start;
            ParameterizedThreadStart? withArgument = _withArgument;
            if (start != null) start.Invoke();
            else if (withArgument != null) withArgument.Invoke(_argument);
            else _body.Invoke();
        }
        catch (Exception e)
        {
            AsyncRuntime.Unhandled(e);
        }

        // The stack under this thread stops being a stack the collector may
        // read before the thread stops standing on it.
        Runtime.EndThread();
        Finish();
    }

    /// Marks the thread finished and wakes everyone in Join. The stack is NOT
    /// returned to the kernel: the thread is still standing on it until the
    /// exit(2) in the trampoline retires. One mapping per thread leaks, which
    /// is what a pool of long-lived workers wants anyway.
    void Finish()
    {
        long at = Atom.At(this, Atom.FirstWord);

        Counting(true);
        Sys.AtomicSwap(at, 1);
        if (_counted) Count(-1);
        Counting(false);
        Native.Wake(at, Native.WakeAll);
    }

    /// Waits for the thread to finish running its body.
    public void Join()
    {
        if (_id == 0) throw new ThreadStateException("Thread has not been started.");
        long at = Atom.At(this, Atom.FirstWord);

        while (Sys.PeekWord(at) == 0)
        {
            Native.Wait(at, 0);
        }
    }

    /// Stops this thread for `milliseconds`, leaving the processor to others.
    public static void Sleep(int milliseconds)
    {
        if (milliseconds <= 0)
        {
            return;
        }
        Clock.SleepUntil(Clock.Now() + (long)milliseconds * 1000000);
    }
}

/// Mutual exclusion, one word, three states: 0 free, 1 held with nobody
/// waiting, 2 held with somebody waiting. An uncontended lock and unlock is a
/// single atomic instruction each and never enters the kernel; only the state
/// that says "somebody is asleep" makes Unlock pay for a futex wake. (This is
/// Drepper's futex mutex, "Futexes Are Tricky", section 6.)
class Mutex
{
    // LAYOUT: first instance field, at Atom.FirstWord (see Atom).
    nint _state;
    int _pad;

    const int Free = 0;
    const int Held = 1;
    const int Contended = 2;

    public Mutex()
    {
        _state = Free;
        _pad = 0;
        Atom.CheckLayout();
    }

    /// Whether the lock is held by somebody, at the moment of asking.
    public bool IsHeld => _state != Free;

    public void Lock()
    {
        long at = Atom.At(this, Atom.FirstWord);
        long seen = Sys.Cas(at, Free, Held);

        if (seen == Free)
        {
            return;
        }

        // Taking it now means there may be a waiter -- this one -- so it goes
        // to Contended and stays there until an Unlock finds it free again.
        while (seen != Free)
        {
            seen = Sys.AtomicSwap(at, Contended);

            if (seen == Free)
            {
                return;
            }
            Native.Wait(at, Contended);
            seen = Sys.Cas(at, Free, Contended);
        }
    }

    /// Takes the lock if it is free, without waiting.
    public bool TryLock()
    {
        return Sys.Cas(Atom.At(this, Atom.FirstWord), Free, Held) == Free;
    }

    public void Unlock()
    {
        long at = Atom.At(this, Atom.FirstWord);

        if (Sys.AtomicSwap(at, Free) == Contended)
        {
            Native.Wake(at, 1);
        }
    }
}

/// A count of permits, taken and given back. Wait blocks while the count is
/// zero; Release adds one and wakes one waiter.
class Semaphore
{
    // LAYOUT: first instance field, at Atom.FirstWord (see Atom).
    nint _count;
    int _pad;

    public Semaphore(int initialCount)
    {
        if (initialCount < 0)
        {
            throw new ArgumentOutOfRangeException("initialCount");
        }
        _count = initialCount;
        _pad = 0;
        Atom.CheckLayout();
    }

    public int Count => (int)_count;

    public void Wait()
    {
        long at = Atom.At(this, Atom.FirstWord);

        while (true)
        {
            int seen = (int)Sys.PeekWord(at);

            if (seen > 0)
            {
                if (Sys.Cas(at, seen, seen - 1) == seen)
                {
                    return;
                }
                continue;
            }
            Native.Wait(at, 0);
        }
    }

    /// Takes a permit if there is one, without waiting.
    public bool TryWait()
    {
        long at = Atom.At(this, Atom.FirstWord);
        int seen = (int)Sys.PeekWord(at);

        if (seen <= 0)
        {
            return false;
        }
        return Sys.Cas(at, seen, seen - 1) == seen;
    }

    public void Release()
    {
        Release(1);
    }

    public void Release(int count)
    {
        long at = Atom.At(this, Atom.FirstWord);

        Sys.AtomicAdd(at, count);
        Native.Wake(at, count);
    }
}

/// .NET's WaitHandle: something a thread can wait on until it is signalled.
public abstract class WaitHandle : IDisposable
{
    /// Waits until signalled; true when it was.
    public abstract bool WaitOne();

    public virtual void Dispose() { }
}

/// Set or not set; everyone waiting goes through when it is set, and stays
/// through until somebody resets it.
class ManualResetEvent : WaitHandle
{
    // LAYOUT: first instance field, at Atom.FirstWord (see Atom).
    nint _signalled;
    int _pad;

    public ManualResetEvent(bool initialState)
    {
        _signalled = initialState ? 1 : 0;
        _pad = 0;
        Atom.CheckLayout();
    }

    public bool IsSet => _signalled != 0;

    public bool Set()
    {
        long at = Atom.At(this, Atom.FirstWord);

        Sys.AtomicSwap(at, 1);
        Native.Wake(at, Native.WakeAll);
        return true;
    }

    public bool Reset()
    {
        Sys.AtomicSwap(Atom.At(this, Atom.FirstWord), 0);
        return true;
    }

    public override bool WaitOne()
    {
        long at = Atom.At(this, Atom.FirstWord);

        while (Sys.PeekWord(at) == 0)
        {
            Native.Wait(at, 0);
        }
        return true;
    }
}

// ---- Monitor.Wait and Pulse --------------------------------------------------
//
// The other half of System.Threading.Monitor (core threading.cor), where a
// thread can sleep. Wait gives the lock up entirely -- every level of it --
// sleeps until Pulse picks it or the timeout passes, then takes the lock back
// at the depth it had. A waiter is enrolled before the lock is let go, so a
// Pulse made the moment after cannot miss it.
static partial class Monitor
{
    static int _waitGate;
    static List<MonitorWaiter>? _waiters;

    public static bool Wait(object obj)
    {
        return Wait(obj, -1);
    }

    public static bool Wait(object obj, TimeSpan timeout)
    {
        return Wait(obj, Timeouts.Milliseconds(timeout, "timeout"));
    }

    public static bool Wait(object obj, int millisecondsTimeout, bool exitContext)
    {
        return Wait(obj, millisecondsTimeout);
    }

    public static bool Wait(object obj, TimeSpan timeout, bool exitContext)
    {
        return Wait(obj, timeout);
    }

    /// Answers whether it was pulsed; false when the timeout passed first.
    public static bool Wait(object obj, int millisecondsTimeout)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        if (millisecondsTimeout < -1)
        {
            throw new ArgumentOutOfRangeException("millisecondsTimeout");
        }
        long word = Sys.SyncWord(obj);
        long me = Owner();

        if (me == 0 || (Sys.Peek(word) & ~Asleep) != me)
        {
            throw new SynchronizationLockException();
        }

        MonitorWaiter waiter = new MonitorWaiter(word);
        EnterGate();
        try
        {
            List<MonitorWaiter> waiters = _waiters ??= new List<MonitorWaiter>();
            waiters.Add(waiter);
        }
        finally
        {
            ExitGate();
        }

        int depth = TakeDepth(word);
        Release(word);

        long flag = Atom.At(waiter, Atom.FirstWord);
        long deadline = millisecondsTimeout < 0 ? -1 : Clock.Now() + (long)millisecondsTimeout * 1000000;

        while (Sys.PeekWord(flag) == 0)
        {
            if (deadline < 0)
            {
                Native.Wait(flag, 0);
                continue;
            }
            long left = deadline - Clock.Now();
            if (left <= 0)
            {
                break;
            }
            Native.WaitFor(flag, 0, left);
        }

        bool pulsed;
        EnterGate();
        try
        {
            pulsed = Sys.PeekWord(flag) != 0;
            _waiters!.Remove(waiter);
        }
        finally
        {
            ExitGate();
        }

        Enter(obj);
        RestoreDepth(word, depth);
        return pulsed;
    }

    /// Wakes the longest waiter on the object, if there is one.
    public static void Pulse(object obj)
    {
        Signal(obj, all: false);
    }

    /// Wakes every waiter on the object.
    public static void PulseAll(object obj)
    {
        Signal(obj, all: true);
    }

    static void Signal(object obj, bool all)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        long word = Sys.SyncWord(obj);
        long me = Owner();

        if (me == 0 || (Sys.Peek(word) & ~Asleep) != me)
        {
            throw new SynchronizationLockException();
        }

        EnterGate();
        try
        {
            List<MonitorWaiter>? waiters = _waiters;
            if (waiters == null)
            {
                return;
            }
            for (int i = 0; i < waiters.Count; i++)
            {
                MonitorWaiter waiter = waiters[i];
                long flag = Atom.At(waiter, Atom.FirstWord);
                if (waiter.Word != word || Sys.PeekWord(flag) != 0)
                {
                    continue;
                }
                Sys.AtomicSwap(flag, 1);
                Native.Wake(flag, 1);
                if (!all)
                {
                    return;
                }
            }
        }
        finally
        {
            ExitGate();
        }
    }

    static void EnterGate()
    {
        long gate = Sys.AddressOf(ref _waitGate);
        while (Sys.Cas(gate, 0, 1) != 0) { Sys.Pause(); }
    }

    static void ExitGate()
    {
        Sys.AtomicSwap(Sys.AddressOf(ref _waitGate), 0);
    }
}

/// One thread in Monitor.Wait: the lock word it waits on, and the flag a Pulse
/// sets -- the futex word it sleeps on.
class MonitorWaiter
{
    // LAYOUT: first instance field, at Atom.FirstWord (see Atom), and a
    // WORD, as the other waiters' are.
    nint _signalled;
    int _pad;

    public long Word;

    public MonitorWaiter(long word)
    {
        _signalled = 0;
        _pad = 0;
        Word = word;
        Atom.CheckLayout();
    }
}
