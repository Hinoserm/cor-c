// The Linux ABI's constants and structures, i386's and x86-64's: the call
// numbers, the descriptors, open(2)'s flags, errno, and the byte layouts of
// stat, statfs, getdents64 and the time structures, with Raw to read them.
// Which machine's is chosen by the target's symbol (TARGET_AMD64). No system
// call is made here.
//
// Apart from system.cor so that code which makes Linux's file calls without
// being a Linux process -- CORSAC's kernel and its modules, through
// files.cor and KernelFiles.Syscall -- has the same numbers and structures
// by the same names.

#if TARGET_AMD64
/// The x86-64 system-call numbers this library uses, from asm/unistd_64.h,
/// under the names the i386 table gives them so one source makes the call.
/// Where i386 had a separate 64-bit or 32-bit-id variant -- stat64, the
/// getuid32 family, _llseek, mmap2 -- the x86-64 call already IS that one,
/// and the name keeps pointing at what the code means. The calls whose
/// ARGUMENTS differ as well (mmap's offset, statfs's size, wait4's rusage,
/// ftruncate's length, set_thread_area) are shaped at their call sites.
static class LinuxCall
{
    public const int Exit = 60;        // (status)
    public const int Read = 0;         // (fd, address, count) -> read, or -errno
    public const int Pread64 = 17;     // (fd, address, count, offset) -> read, or -errno
    public const int Write = 1;        // (fd, address, count) -> written, or -errno
    public const int Open = 2;         // (path, flags, mode) -> fd, or -errno
    public const int Close = 3;        // (fd) -> 0, or -errno
    public const int Getpid = 39;
    public const int Uname = 63;       // (utsname)
    public const int Sysinfo = 99;     // (struct sysinfo)
    public const int Brk = 12;
    /// mmap(2): the offset is in BYTES here, where i386's mmap2 takes pages.
    public const int Mmap = 9;         // (addr, len, prot, flags, fd, offset) -> address
    public const int MmapOffsetShift = 12;
    public const int ExitGroup = 231;  // (status): every thread, not just this one
    /// arch_prctl(2): where this thread's FS base, and so its block, is.
    public const int ArchPrctl = 158;  // (code, address)
    public const int ArchSetFs = 0x1002;
    public const int ArchSetGs = 0x1001;
    public const int Futex = 202;      // (uaddr, op, val, timeout, uaddr2, val3)

    // ---- processes -------------------------------------------------------
    public const int Fork = 57;
    /// wait4(2): waitpid's arguments and a fourth, the rusage, which is 0.
    public const int Wait4 = 61;       // (pid, status, options, rusage)
    public const int Execve = 59;
    public const int Kill = 62;
    public const int Getppid = 110;
    public const int Getuid = 102;
    public const int Geteuid = 107;
    public const int Getgid = 104;
    public const int Setpgid = 109;
    public const int Getpgid = 121;
    public const int Getsid = 124;     // (pid) -> its session's id
    public const int Setsid = 112;
    public const int Setuid = 105;
    public const int Setgid = 106;
    public const int Setgroups = 116;
    public const int Umask = 95;
    public const int Chown = 92;
    public const int Lchown = 94;
    public const int Gettid = 186;
    public const int Tgkill = 234;
    public const int Clone = 56;       // (flags, stack, ptid, ctid, tls): x86-64's order
    public const int SetTidAddress = 218;

    // ---- files and directories -------------------------------------------
    public const int Unlink = 87;
    public const int Link = 86;
    public const int Chdir = 80;
    public const int Lseek = 8;        // (fd, offset, whence) -> the offset: 64 bits already
    public const int Rename = 82;
    public const int Mkdir = 83;
    public const int Rmdir = 84;
    public const int Dup = 32;
    public const int Pipe = 22;
    public const int Ioctl = 16;
    public const int Dup2 = 33;
    public const int Ftruncate = 77;   // (fd, length): the length is 64 bits already
    public const int Getcwd = 79;
    public const int Stat64 = 4;       // stat: already the 64-bit structure (StatBuf)
    public const int Lstat64 = 6;
    public const int Fstat64 = 5;
    public const int Getdents64 = 217;
    public const int Access = 21;
    public const int Chmod = 90;
    public const int Symlink = 88;
    public const int Readlink = 89;
    public const int Poll = 7;
    public const int Fcntl = 72;
    public const int RtSigaction = 13;
    public const int RtSigprocmask = 14;
    public const int RtSigreturn = 15;
    public const int GetRandom = 318;
    public const int SchedGetaffinity = 204;
    public const int Utimensat = 280;
    public const int Sync = 162;
    public const int InitModule = 175;     // (image, length, params)
    public const int DeleteModule = 176;   // (name, flags): O_TRUNC forces
    public const int FinitModule = 313;    // (fd, params, flags)
    public const int Fsync = 74;
    public const int Flock = 73;
    public const int Fdatasync = 75;
    public const int Mount = 165;
    public const int Umount2 = 166;
    /// statfs/fstatfs: (path or fd, buffer) -- no size argument on x86-64.
    public const int Statfs64 = 137;
    public const int Fstatfs64 = 138;
    public const int Reboot = 169;
    public const int Munmap = 11;
    public const int Mprotect = 10;    // (address, length, protection)
    public const int Membarrier = 324; // (cmd, flags, cpu)

    // ---- time ------------------------------------------------------------
    public const int Time = 201;
    public const int GetTimeOfDay = 96;
    public const int NanoSleep = 35;
    public const int ClockGetTime = 228;
    public const int ClockGetRes = 229;
    public const int ClockNanosleep = 230;
    public const int Sched_Yield = 24;

    // ---- sockets: one call each, and no socketcall(2) at all -------------
    public const int Socket = 41;
    public const int SocketPair = 53;
    public const int Bind = 49;
    public const int Connect = 42;
    public const int Listen = 50;
    public const int Accept4 = 288;
    public const int GetSockOpt = 55;
    public const int SetSockOpt = 54;
    public const int GetSockName = 51;
    public const int GetPeerName = 52;
    public const int SendTo = 44;
    public const int SendMsg = 46;
    public const int RecvFrom = 45;
    public const int RecvMsg = 47;
    public const int Shutdown = 48;
    public const int InotifyAddWatch = 254;    // (fd, path, mask) -> wd
    public const int InotifyRmWatch = 255;     // (fd, wd)
    public const int InotifyInit1 = 294;       // (flags: IN_NONBLOCK 0x800, IN_CLOEXEC 0x80000) -> fd
}
#else
/// The i386 system-call numbers this library uses, from asm/unistd_32.h:
/// Linux's numbers and argument conventions, named LinuxCall so that a
/// kernel compiled with this library keeps `Call` for its own.
static class LinuxCall
{
    public const int Exit = 1;         // (status)
    public const int Read = 3;         // (fd, address, count) -> read, or -errno
    public const int Pread64 = 180;    // (fd, address, count, offset low, offset high) -> read, or -errno
    public const int Write = 4;        // (fd, address, count) -> written, or -errno
    public const int Open = 5;         // (path, flags, mode) -> fd, or -errno
    public const int Close = 6;        // (fd) -> 0, or -errno
    public const int Getpid = 20;      // () -> pid; the cheapest call there is
    public const int Uname = 122;      // (utsname)
    public const int Sysinfo = 116;    // (struct sysinfo)
    public const int Brk = 45;         // (address) -> the break now; unused
    public const int Mmap2 = 192;      // (addr, len, prot, flags, fd, pgoff) -> address
    /// The one this library calls: mmap2, whose offset is in pages.
    public const int Mmap = 192;
    public const int MmapOffsetShift = 0;
    public const int ExitGroup = 252;  // (status): every thread, not just this one
    public const int SetThreadArea = 243;  // (user_desc): a GDT entry of this thread's own
    public const int Futex = 240;      // (uaddr, op, val, timeout, uaddr2, val3)
    public const int Gettid = 224;
    public const int Clone = 120;      // (flags, stack, ptid, tls, ctid)
    public const int ClockNanosleep = 267;

    // ---- processes -------------------------------------------------------
    public const int Fork = 2;         // () -> child pid in the parent, 0 in the child
    public const int Waitpid = 7;      // (pid, status, options) -> pid, or -errno
    public const int Execve = 11;      // (path, argv, envp): does not return on success
    public const int Kill = 37;        // (pid, signal)
    public const int Getppid = 64;
    public const int Getuid = 199;     // getuid32; the 16-bit getuid (24) truncates
    public const int Geteuid = 201;    // geteuid32
    public const int Getgid = 200;     // getgid32
    public const int Setpgid = 57;     // (pid, pgid)
    public const int Getpgid = 132;    // (pid) -> the group it is in
    public const int Getsid = 147;     // (pid) -> its session's id
    public const int Setsid = 66;      // () -> the new session id
    public const int Setuid = 213;     // setuid32; the 16-bit one (23) truncates
    public const int Setgid = 214;     // setgid32
    public const int Setgroups = 206;  // setgroups32 (count, list)
    public const int Umask = 60;       // (mask) -> the mask it replaced
    public const int Chown = 212;      // chown32 (path, uid, gid)
    public const int Lchown = 198;     // lchown32 (path, uid, gid): the link itself

    // ---- files and directories -------------------------------------------
    public const int Unlink = 10;
    public const int Link = 9;         // (existing, new): a second name for one inode
    public const int Chdir = 12;
    public const int Lseek = 19;       // 32-bit offsets only; LlSeek is the one to use
    public const int Rename = 38;
    public const int Mkdir = 39;       // (path, mode)
    public const int Rmdir = 40;
    public const int Dup = 41;
    public const int Pipe = 42;        // (int[2]) -> 0; the two descriptors go in the array
    public const int Ioctl = 54;
    public const int Dup2 = 63;        // (from, to)
    public const int Ftruncate = 93;
    public const int Ftruncate64 = 194; // (fd, low, high): 64-bit length
    public const int LlSeek = 140;     // (fd, high, low, result, whence): 64-bit lseek
    public const int Getcwd = 183;     // (buffer, size) -> length INCLUDING the NUL
    public const int Stat64 = 195;     // (path, buffer)
    public const int Lstat64 = 196;    // (path, buffer): the link itself, not its target
    public const int Fstat64 = 197;    // (fd, buffer)
    public const int Getdents64 = 220; // (fd, buffer, count) -> bytes of records
    public const int Access = 33;      // (path, mode)
    public const int Chmod = 15;
    public const int Symlink = 83;
    public const int Readlink = 85;
    public const int Poll = 168;       // (fds, nfds, timeout_ms)
    public const int InotifyAddWatch = 292;    // (fd, path, mask) -> wd
    public const int InotifyRmWatch = 293;     // (fd, wd)
    public const int InotifyInit1 = 332;       // (flags: IN_NONBLOCK 0x800, IN_CLOEXEC 0x80000) -> fd
    public const int Fcntl = 55;       // (fd, cmd, arg)
    public const int RtSigaction = 174;
    public const int RtSigprocmask = 175;
    public const int GetRandom = 355;
    public const int SchedGetaffinity = 242;   // (pid, bytes, mask)
    public const int Utimensat = 320;
    public const int Sync = 36;
    public const int InitModule = 128;     // (image, length, params)
    public const int DeleteModule = 129;   // (name, flags): O_TRUNC forces
    public const int FinitModule = 350;    // (fd, params, flags)
    public const int Fsync = 118;
    public const int Flock = 143;     // (fd, operation): LOCK_SH 1, LOCK_EX 2, LOCK_NB 4
    public const int Fdatasync = 148;
    public const int Mount = 21;       // (source, target, type, flags, data)
    public const int Umount2 = 52;     // (target, flags)
    public const int Statfs64 = 268;   // (path, size, buffer)
    public const int Fstatfs64 = 269;  // (fd, size, buffer)
    public const int Reboot = 88;      // (magic1, magic2, cmd, arg)  // (dirfd, path, times[2], flags)  // (buffer, count, flags)
    public const int Munmap = 91;
    public const int Mprotect = 125;   // (address, length, protection)
    public const int Membarrier = 375; // (cmd, flags, cpu)

    // ---- time ------------------------------------------------------------
    public const int Time = 13;        // (address or 0) -> seconds since the epoch
    public const int GetTimeOfDay = 78;
    public const int NanoSleep = 162;  // (request, remainder)
    public const int ClockGetTime = 265;
    public const int ClockGetRes = 266;
    public const int Sched_Yield = 158;

    // ---- sockets ---------------------------------------------------------
    //
    // TWO WAYS IN, and which one works is the kernel's choice. i386 grew
    // separate socket calls in Linux 4.3; before that every one of them went
    // through socketcall(2) with its arguments in a block of words. Os.Sock
    // below tries the direct call and falls back on -ENOSYS, so this library
    // runs on either without being told which it is on.
    public const int SocketCall = 102; // (which, args): the old, universal door
    public const int Socket = 359;
    public const int SocketPair = 360;
    public const int Bind = 361;
    public const int Connect = 362;
    public const int Listen = 363;
    public const int Accept4 = 364;
    public const int GetSockOpt = 365;
    public const int SetSockOpt = 366;
    public const int GetSockName = 367;
    public const int GetPeerName = 368;
    public const int SendTo = 369;
    public const int SendMsg = 370;
    public const int RecvFrom = 371;
    public const int RecvMsg = 372;
    public const int Shutdown = 373;
}
#endif

/// The three standard descriptors, as os/lib/user.cor spells them.
static class Fd
{
    public const int In = 0;
    public const int Out = 1;
    public const int Err = 2;
}

/// open(2) flags, Linux i386 values. The same names and -- not by accident --
/// the same numbers as os/lib/user.cor's O, which took them from Linux.
static class O
{
    public const int Read = 0;          // O_RDONLY
    public const int Write = 1;         // O_WRONLY
    public const int ReadWrite = 2;     // O_RDWR
    public const int AccessMask = 3;

    public const int Create = 64;       // O_CREAT
    public const int Exclusive = 128;   // O_EXCL
    public const int Truncate = 512;    // O_TRUNC
    public const int Append = 1024;     // O_APPEND
    public const int NonBlock = 2048;   // O_NONBLOCK
    public const int Dsync = 0x1000;    // O_DSYNC
    public const int Sync = 0x101000;   // O_SYNC includes O_DSYNC
    public const int Directory = 65536; // O_DIRECTORY

    /// O_LARGEFILE. On a 32-bit kernel an open WITHOUT this refuses, with
    /// EOVERFLOW, any file whose size does not fit in 31 bits -- which is
    /// every disc image and every block device of 2 GiB or more. .NET opens
    /// with it always on Linux, and so does everything here.
    public const int LargeFile = 32768; // 0100000
}

/// The errno values a program here has a reason to test for. A failed call
/// answers the NEGATIVE of one of these, as the raw kernel interface does;
/// there is no errno variable because there is no libc.
static class Err
{
    public const int Perm = 1;         // EPERM
    public const int NoEnt = 2;        // ENOENT
    public const int Intr = 4;         // EINTR
    public const int Io = 5;           // EIO
    public const int BadF = 9;         // EBADF
    public const int Again = 11;       // EAGAIN
    public const int NoMem = 12;       // ENOMEM
    public const int Access = 13;      // EACCES
    public const int NoDev = 19;
    public const int NetDown = 100;
    public const int ConnReset = 104;
    public const int NoBufs = 105;
    public const int Fault = 14;

    public const int MFile = 24;
    public const int MsgSize = 90;
    public const int ProtoNoSupport = 93;      // EPROTONOSUPPORT
    public const int NotSup = 95;
    public const int AFNoSupport = 97;
    public const int AddrInUse = 98;
    public const int NetUnreach = 101;
    public const int ConnAborted = 103;
    public const int IsConn = 106;
    public const int TimedOut = 110;
    public const int ConnRefused = 111;
    public const int HostUnreach = 113;
    public const int Already = 114;
    public const int InProgress = 115;
    public const int NotConn = 107;
    public const int Exist = 17;       // EEXIST
    public const int NotDir = 20;      // ENOTDIR
    public const int IsDir = 21;       // EISDIR
    public const int Inval = 22;       // EINVAL
    public const int FBig = 27;        // EFBIG: longer than the file system allows
    public const int NoSpc = 28;       // ENOSPC
    public const int Pipe = 32;        // EPIPE
    public const int Range = 34;       // ERANGE
    public const int NameTooLong = 36; // ENAMETOOLONG
    public const int NotEmpty = 39;    // ENOTEMPTY
    public const int NoSys = 38;       // ENOSYS: the kernel has no such call
    public const int NotSock = 88;     // ENOTSOCK
    public const int NoTty = 25;       // ENOTTY: not a terminal
    public const int Spipe = 29;       // ESPIPE: a pipe cannot seek
    public const int RoFs = 30;        // EROFS: a file system mounted read-only
    public const int Canceled = 125;   // ECANCELED

    /// A call's answer as the number it is: a count or a descriptor, or
    /// -errno. Only the last 4095 values of the word are errors (asm/errno:
    /// -MAX_ERRNO); an address in the top half of the space reads negative
    /// as a number, and is read as an address (Address).
    public static nint Result(nint raw)
    {
        return raw;
    }

    /// Whether a call's answer is -errno.
    public static bool Failed(nint raw)
    {
        return (nuint)raw >= unchecked((nuint)(-4095));
    }

    /// A call's answer that is an address (mmap, brk), or 0 for an error.
    public static nuint Address(nint raw)
    {
        return Failed(raw) ? 0 : (nuint)raw;
    }
}

/// Little-endian fields in a byte array. The one place that knows how the
/// machine spells a number wider than a byte.
static class Raw
{
    public static long U8(byte[] b, int at)
    {
        return b[at];
    }

    public static long U16(byte[] b, int at)
    {
        return b[at * 2 + 0] | (b[at * 2 + 1] << 8);
    }

    /// An unsigned 32-bit field, widened into a long so that 0x80000000 is
    /// two billion and not minus two billion.
    public static long U32(byte[] b, int at)
    {
        long low = b[at + 0] | (b[at + 1] << 8);
        long high = b[at + 2] | (b[at + 3] << 8);
        return low | (high << 16);
    }

    /// The same four bytes read as a signed number, which is what a mode, a
    /// uid or a seconds-since-the-epoch is.
    public static int I32(byte[] b, int at)
    {
        return (int)U32(b, at);
    }

    public static long I64(byte[] b, int at)
    {
        return U32(b, at) | (((long)I32(b, at + 4)) << 32);
    }

    public static void SetU32(byte[] b, int at, long value)
    {
        b[at + 0] = (byte)(value & 0xFF);
        b[at + 1] = (byte)((value >> 8) & 0xFF);
        b[at + 2] = (byte)((value >> 16) & 0xFF);
        b[at + 3] = (byte)((value >> 24) & 0xFF);
    }

    public static void SetI64(byte[] b, int at, long value)
    {
        SetU32(b, at, value & 0xFFFFFFFF);
        SetU32(b, at + 4, (value >> 32) & 0xFFFFFFFF);
    }

    /// A machine word: a pointer or a size_t in a structure the kernel reads.
    public static nuint Word(byte[] b, int at)
    {
#if TARGET_64BIT
        return (nuint)I64(b, at);
#else
        return (nuint)U32(b, at);
#endif
    }

    public static void SetWord(byte[] b, int at, nuint value)
    {
#if TARGET_64BIT
        SetI64(b, at, (long)value);
#else
        SetU32(b, at, (long)value);
#endif
    }

    /// `count` bytes as text: the kernel's strings are bytes, and they are
    /// decoded as UTF-8, which is what .NET on Linux does with a file name, an
    /// argument or a variable -- an ill-formed sequence becomes U+FFFD.
    public static string Text(byte[] b, int at, int count)
    {
        return Utf8Transcoder.Decode(b, at, count);
    }

    /// Text up to the first zero byte, which is how the kernel ends a name.
    public static string CText(byte[] b, int at, int limit)
    {
        int n = 0;

        while (at + n < limit && b[at + n] != 0)
        {
            n = n + 1;
        }
        return Text(b, at, n);
    }
}

/// lseek(2)'s third argument.
static class Whence
{
    public const int Set = 0;
    public const int Current = 1;
    /// os/lib/user.cor's name for Current; a ported utility says Whence.Cur.
    public const int Cur = 1;
    public const int End = 2;
}

#if TARGET_AMD64
/// The x86-64 `struct stat` that stat/lstat/fstat fill in: every count and
/// time a full eight bytes, naturally aligned.
static class StatBuf
{
    public const int Bytes = 144;

    public const int Dev = 0;           // 8 bytes
    public const int InoAt = 8;         // 8 bytes
    public const int NlinkAt = 16;      // 8 bytes
    public const int ModeAt = 24;
    public const int UidAt = 28;
    public const int GidAt = 32;
    public const int RdevAt = 40;       // 8 bytes
    public const int SizeAt = 48;       // 8 bytes
    public const int BlkSizeAt = 56;    // 8 bytes
    public const int BlocksAt = 64;     // 8 bytes
    public const int AtimeAt = 72;      // seconds, 8 bytes; nanoseconds after
    public const int AtimeNsecAt = 80;
    public const int MtimeAt = 88;
    public const int MtimeNsecAt = 96;
    public const int CtimeAt = 104;
    public const int CtimeNsecAt = 112;
    public const int TimeBytes = 8;
#else
/// The i386 `struct stat64` that stat64/lstat64/fstat64 fill in. The odd
/// offsets are real: the 64-bit fields in it are packed to four bytes, so
/// st_size sits at 44 and not at 48.
static class StatBuf
{
    public const int Bytes = 96;

    public const int Dev = 0;           // 8 bytes
    public const int ModeAt = 16;
    public const int NlinkAt = 20;
    public const int UidAt = 24;
    public const int GidAt = 28;
    public const int RdevAt = 32;       // 8 bytes
    public const int SizeAt = 44;       // 8 bytes, four-byte aligned
    public const int BlkSizeAt = 52;
    public const int BlocksAt = 56;     // 8 bytes
    public const int AtimeAt = 64;
    public const int MtimeAt = 72;
    public const int CtimeAt = 80;

    // THE NANOSECONDS EACH TIME ALREADY HAS. struct stat64 stores every
    // timestamp as a pair -- seconds, then nanoseconds in the word after it --
    // so these are not new fields the kernel has to fill: they are the four
    // bytes at 68, 76 and 84 that were being skipped over.
    //
    // Without them no two events inside one second can be told apart, and
    // `cp -u` and `mv -u` are exactly the programs that have to: a file
    // rewritten a moment after the copy has the same whole second and is
    // judged unchanged.
    public const int AtimeNsecAt = 68;
    public const int MtimeNsecAt = 76;
    public const int CtimeNsecAt = 84;
    public const int InoAt = 88;        // 8 bytes

    public const int TimeBytes = 4;
#endif

    public const int TypeMask = 0xF000;
    public const int Fifo = 0x1000;
    public const int Char = 0x2000;
    public const int Dir = 0x4000;
    public const int Block = 0x6000;
    public const int File = 0x8000;
    public const int Link = 0xA000;
    public const int Socket = 0xC000;

    public const int PermissionMask = 0xFFF;

    /// Somewhere to put one.
    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    /// Refuses a buffer that cannot hold one, rather than letting the kernel
    /// write past the end of an array -- the one thing a language with bounds
    /// checks must not allow a system call to do behind its back.
    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a stat buffer is too small");
        }
    }

    public static long Device(byte[] b) { return Raw.I64(b, Dev); }
    public static long Rdev(byte[] b)   { return Raw.I64(b, RdevAt); }
    public static long Mode(byte[] b)   { return Raw.U32(b, ModeAt); }
    public static long Links(byte[] b)  { return Raw.U32(b, NlinkAt); }
    public static long Uid(byte[] b)    { return Raw.U32(b, UidAt); }
    public static long Gid(byte[] b)    { return Raw.U32(b, GidAt); }
    public static long Size(byte[] b)   { return Raw.I64(b, SizeAt); }
    public static long Blocks(byte[] b) { return Raw.I64(b, BlocksAt); }
    public static long Ino(byte[] b)    { return Raw.I64(b, InoAt); }
    public static long Mtime(byte[] b)  { return TimeBytes == 8 ? Raw.I64(b, MtimeAt) : Raw.I32(b, MtimeAt); }
    public static long Atime(byte[] b)  { return TimeBytes == 8 ? Raw.I64(b, AtimeAt) : Raw.I32(b, AtimeAt); }
    public static long Ctime(byte[] b)  { return TimeBytes == 8 ? Raw.I64(b, CtimeAt) : Raw.I32(b, CtimeAt); }

    public static long MtimeNsec(byte[] b) { return Raw.U32(b, MtimeNsecAt); }
    public static long AtimeNsec(byte[] b) { return Raw.U32(b, AtimeNsecAt); }
    public static long CtimeNsec(byte[] b) { return Raw.U32(b, CtimeNsecAt); }

    /// What POSIX spells S_ISDIR and its family, asked of a mode word.
    public static bool IsDirMode(long mode)   { return (mode & TypeMask) == Dir; }
    public static bool IsFileMode(long mode)  { return (mode & TypeMask) == File; }
    public static bool IsCharMode(long mode)  { return (mode & TypeMask) == Char; }
    public static bool IsBlockMode(long mode) { return (mode & TypeMask) == Block; }
    public static bool IsLinkMode(long mode)  { return (mode & TypeMask) == Link; }
    public static bool IsFifoMode(long mode)  { return (mode & TypeMask) == Fifo; }
    public static bool IsSocketMode(long mode) { return (mode & TypeMask) == Socket; }

    /// And asked of a path, which is what a program usually has.
    public static bool IsDir(string path)  { return IsDirMode(Os.ModeOf(path)); }
    public static bool IsFile(string path) { return IsFileMode(Os.ModeOf(path)); }
}

/// StatBuf under os/lib/user.cor's name for it.
///
/// THE ONLY REASON THIS EXISTS is that a static method and a type cannot share
/// a name here: `Os.Stat(path, buffer)` is a method on Os, and inside Os the
/// name Stat then means that method and never the type, so the type had to be
/// called something else. A utility written against user.cor says Stat.IsDir
/// and Stat.Room, and outside Os those resolve to this.
static class Stat
{
    public const int Bytes = StatBuf.Bytes;

    public const int TypeMask = StatBuf.TypeMask;
    public const int Fifo = StatBuf.Fifo;
    public const int Char = StatBuf.Char;
    public const int Dir = StatBuf.Dir;
    public const int Block = StatBuf.Block;
    public const int File = StatBuf.File;
    public const int Link = StatBuf.Link;
    public const int Socket = StatBuf.Socket;

    public static byte[] Room()            { return StatBuf.Room(); }
    public static void Check(byte[] b)     { StatBuf.Check(b); }

    public static long Device(byte[] b)    { return StatBuf.Device(b); }
    public static long Rdev(byte[] b)      { return StatBuf.Rdev(b); }
    public static long Mode(byte[] b)      { return StatBuf.Mode(b); }
    public static long Links(byte[] b)     { return StatBuf.Links(b); }
    public static long Uid(byte[] b)       { return StatBuf.Uid(b); }
    public static long Gid(byte[] b)       { return StatBuf.Gid(b); }
    public static long Size(byte[] b)      { return StatBuf.Size(b); }
    public static long Blocks(byte[] b)    { return StatBuf.Blocks(b); }
    public static long Ino(byte[] b)       { return StatBuf.Ino(b); }
    public static long Mtime(byte[] b)     { return StatBuf.Mtime(b); }
    public static long Atime(byte[] b)     { return StatBuf.Atime(b); }
    public static long Ctime(byte[] b)     { return StatBuf.Ctime(b); }

    public static long MtimeNsec(byte[] b) { return StatBuf.MtimeNsec(b); }
    public static long AtimeNsec(byte[] b) { return StatBuf.AtimeNsec(b); }
    public static long CtimeNsec(byte[] b) { return StatBuf.CtimeNsec(b); }

    public static bool IsDirMode(long mode)   { return StatBuf.IsDirMode(mode); }
    public static bool IsFileMode(long mode)  { return StatBuf.IsFileMode(mode); }
    public static bool IsCharMode(long mode)  { return StatBuf.IsCharMode(mode); }
    public static bool IsBlockMode(long mode) { return StatBuf.IsBlockMode(mode); }
    public static bool IsLinkMode(long mode)  { return StatBuf.IsLinkMode(mode); }
    public static bool IsFifoMode(long mode)  { return StatBuf.IsFifoMode(mode); }
    public static bool IsSocketMode(long mode) { return StatBuf.IsSocketMode(mode); }

    public static bool IsDir(string path)  { return StatBuf.IsDir(path); }
    public static bool IsFile(string path) { return StatBuf.IsFile(path); }
}

#if TARGET_AMD64
/// The x86-64 `struct statfs`: every field a full word.
static class StatFs
{
    public const int Bytes = 120;

    public const int TypeAt = 0;
    public const int BlockSizeAt = 8;
    public const int BlocksAt = 16;
    public const int FreeAt = 24;
    public const int AvailableAt = 32;
    public const int FilesAt = 40;
    public const int FilesFreeAt = 48;
    public const int FsidAt = 56;
    public const int NameLengthAt = 64;
    public const int FragmentSizeAt = 72;
    public const int FlagsAt = 80;

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a statfs buffer is 120 bytes");
        }
    }

    public static long Type(byte[] b)         { return Raw.I64(b, TypeAt); }
    public static long BlockSize(byte[] b)    { return Raw.I64(b, BlockSizeAt); }
    public static long Blocks(byte[] b)       { return Raw.I64(b, BlocksAt); }
    public static long Free(byte[] b)         { return Raw.I64(b, FreeAt); }
    public static long Available(byte[] b)    { return Raw.I64(b, AvailableAt); }
    public static long Files(byte[] b)        { return Raw.I64(b, FilesAt); }
    public static long FilesFree(byte[] b)    { return Raw.I64(b, FilesFreeAt); }
    public static long NameLength(byte[] b)   { return Raw.I64(b, NameLengthAt); }
    public static long FragmentSize(byte[] b) { return Raw.I64(b, FragmentSizeAt); }
    public static long Flags(byte[] b)        { return Raw.I64(b, FlagsAt); }
}
#else
/// The i386 `struct statfs64` that statfs64(2) fills in. Its 64-bit fields
/// are packed to four bytes, as the stat structure's are, so the offsets run
/// on without padding.
static class StatFs
{
    public const int Bytes = 84;

    public const int TypeAt = 0;        // the filing system's magic number
    public const int BlockSizeAt = 4;   // the unit the counts below are in
    public const int BlocksAt = 8;      // 8 bytes
    public const int FreeAt = 16;       // 8 bytes: free to the superuser
    public const int AvailableAt = 24;  // 8 bytes: free to everybody else
    public const int FilesAt = 32;      // 8 bytes
    public const int FilesFreeAt = 40;  // 8 bytes
    public const int FsidAt = 48;       // 8 bytes
    public const int NameLengthAt = 56;
    public const int FragmentSizeAt = 60;
    public const int FlagsAt = 64;

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a statfs buffer is 84 bytes");
        }
    }

    public static long Type(byte[] b)         { return Raw.U32(b, TypeAt); }
    public static long BlockSize(byte[] b)    { return Raw.I32(b, BlockSizeAt); }
    public static long Blocks(byte[] b)       { return Raw.I64(b, BlocksAt); }
    public static long Free(byte[] b)         { return Raw.I64(b, FreeAt); }
    public static long Available(byte[] b)    { return Raw.I64(b, AvailableAt); }
    public static long Files(byte[] b)        { return Raw.I64(b, FilesAt); }
    public static long FilesFree(byte[] b)    { return Raw.I64(b, FilesFreeAt); }
    public static long NameLength(byte[] b)   { return Raw.I32(b, NameLengthAt); }
    public static long FragmentSize(byte[] b) { return Raw.I32(b, FragmentSizeAt); }
    public static long Flags(byte[] b)        { return Raw.I32(b, FlagsAt); }
}
#endif

/// One record in a getdents64(2) buffer: an inode, an offset, the length of
/// the record itself, a kind, and a NUL-terminated name. The records are
/// variable length, which is why the length is in the record.
static class Dirent
{
    public const int InoAt = 0;         // 8 bytes
    public const int OffAt = 8;         // 8 bytes
    public const int LengthAt = 16;     // 2 bytes: the WHOLE record
    public const int TypeAt = 18;
    public const int NameAt = 19;

    public const int Unknown = 0;
    public const int Fifo = 1;
    public const int Char = 2;
    public const int DirKind = 4;
    public const int Block = 6;
    public const int FileKind = 8;
    public const int LinkKind = 10;
    public const int SocketKind = 12;

    /// How far to the next record. Zero would be a loop, so it is refused.
    public static int Length(byte[] b, int at)
    {
        int n = (int)(b[at + LengthAt] | (b[at + LengthAt + 1] << 8));

        if (n <= 0)
        {
            throw new InvalidOperationException("a directory record of no length");
        }
        return n;
    }

    public static long Ino(byte[] b, int at)
    {
        return Raw.I64(b, at + InoAt);
    }

    /// The kind without a stat, when the filing system bothered to say; most
    /// do, and Unknown is the answer when one does not.
    public static long Kind(byte[] b, int at)
    {
        return b[at + TypeAt];
    }

    public static string Name(byte[] b, int at)
    {
        return Raw.CText(b, at + NameAt, at + Length(b, at));
    }
}

/// The 32-bit `struct timespec`: whole seconds and nanoseconds within the
/// second, both signed words on i386.
static class TimeSpec
{
#if TARGET_64BIT
    // Two longs: seconds and nanoseconds.
    public const int Bytes = 16;
    public const int NanosAt = 8;
#else
    public const int Bytes = 8;
    public const int NanosAt = 4;
#endif

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a timespec is too small");
        }
    }

#if TARGET_64BIT
    public static long Seconds(byte[] b) { return Raw.I64(b, 0); }
    public static long Nanos(byte[] b)   { return Raw.I64(b, NanosAt); }

    public static void Set(byte[] b, long seconds, long nanos)
    {
        Raw.SetI64(b, 0, seconds);
        Raw.SetI64(b, NanosAt, nanos);
    }
#else
    public static long Seconds(byte[] b) { return Raw.I32(b, 0); }
    public static long Nanos(byte[] b)   { return Raw.I32(b, 4); }

    public static void Set(byte[] b, long seconds, long nanos)
    {
        Raw.SetU32(b, 0, seconds);
        Raw.SetU32(b, 4, nanos);
    }
#endif
}

/// `struct timeval`: seconds and MICROseconds, which is the older call's
/// resolution and the reason it is a different structure.
static class TimeVal
{
#if TARGET_64BIT
    public const int Bytes = 16;
#else
    public const int Bytes = 8;
#endif

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

#if TARGET_64BIT
    public static long Seconds(byte[] b) { return Raw.I64(b, 0); }
    public static long Micros(byte[] b)  { return Raw.I64(b, 8); }

    public static void Set(byte[] b, long seconds, long micros)
    {
        Raw.SetI64(b, 0, seconds);
        Raw.SetI64(b, 8, micros);
    }
#else
    public static long Seconds(byte[] b) { return Raw.I32(b, 0); }
    public static long Micros(byte[] b)  { return Raw.I32(b, 4); }

    public static void Set(byte[] b, long seconds, long micros)
    {
        Raw.SetU32(b, 0, seconds);
        Raw.SetU32(b, 4, micros);
    }
#endif
}

/// Which clock. Realtime can jump -- it is the one a user sets -- so anything
/// measuring an interval must use Monotonic and nothing else.
static class ClockId
{
    public const int Realtime = 0;
    public const int Monotonic = 1;
    public const int ProcessCpu = 2;
    public const int ThreadCpu = 3;
    public const int MonotonicRaw = 4;
}

/// The kernel's `struct termios` as the TCGETS/TCSETS ioctls use it: four
/// flag words, a line discipline byte, then nineteen special characters.
/// (glibc's termios is a different, larger structure; this is the kernel's.)
static class Termios
{
    public const int Bytes = 36;

    public const int InputAt = 0;
    public const int OutputAt = 4;
    public const int ControlAt = 8;
    public const int LocalAt = 12;
    public const int LineAt = 16;
    public const int CharsAt = 17;

    // c_lflag, the bits a program actually changes.
    public const int Signals = 0x1;        // ISIG
    public const int Canonical = 0x2;      // ICANON: input arrives a LINE at a time
    public const int Echo = 0x8;           // ECHO
    public const int EchoErase = 0x10;     // ECHOE

    // c_iflag
    public const int CrToNl = 0x100;       // ICRNL
    public const int IgnoreCr = 0x80;      // IGNCR
    public const int FlowControl = 0x400;  // IXON

    // c_cflag
    public const int HangUpOnClose = 0x400; // HUPCL: the last close drops DTR
    public const int LocalLine = 0x800;    // CLOCAL: the line's carrier means nothing
    public const uint HardwareFlow = 0x80000000; // CRTSCTS: RTS/CTS flow control

    // c_oflag
    public const int PostProcess = 0x1;    // OPOST
    public const int NlToCrNl = 0x4;       // ONLCR

    // indices into c_cc
    public const int Intr = 0;
    public const int Quit = 1;
    public const int Erase = 2;
    public const int Kill = 3;
    public const int Eof = 4;
    public const int Time = 5;
    public const int Min = 6;

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a termios is 36 bytes");
        }
    }

    public static long Input(byte[] t)   { return Raw.U32(t, InputAt); }
    public static long Output(byte[] t)  { return Raw.U32(t, OutputAt); }
    public static long Control(byte[] t) { return Raw.U32(t, ControlAt); }
    public static long Local(byte[] t)   { return Raw.U32(t, LocalAt); }

    public static void SetInput(byte[] t, long v)   { Raw.SetU32(t, InputAt, v); }
    public static void SetOutput(byte[] t, long v)  { Raw.SetU32(t, OutputAt, v); }
    public static void SetControl(byte[] t, long v) { Raw.SetU32(t, ControlAt, v); }
    public static void SetLocal(byte[] t, long v)   { Raw.SetU32(t, LocalAt, v); }

    public static long Char(byte[] t, int which)
    {
        return t[CharsAt + which];
    }

    public static void SetChar(byte[] t, int which, long ch)
    {
        t[CharsAt + which] = (byte)(ch & 0xFF);
    }
}

/// The terminal ioctls, by their traditional numbers.
static class Tio
{
    public const int GetAttributes = 0x5401;       // TCGETS
    public const int SetAttributes = 0x5402;       // TCSETS, at once
    public const int SetAttributesDrain = 0x5403;  // TCSETSW, after the output goes out
    public const int SetAttributesFlush = 0x5404;  // TCSETSF, and throw the input away
    public const int WindowSize = 0x5413;          // TIOCGWINSZ
    public const int SetWindowSize = 0x5414;
    public const int Foreground = 0x540F;          // TIOCGPGRP
    public const int SetForeground = 0x5410;
    public const int Exclusive = 0x540C;
    public const int SetControlling = 0x540E;      // TIOCSCTTY
    public const int GiveUpControlling = 0x5422;   // TIOCNOTTY
    public const int GetModemLines = 0x5415;       // TIOCMGET
    public const int SetModemLines = 0x5418;       // TIOCMSET
    public const int FlushInput = 0x540B;          // TCFLSH
}
