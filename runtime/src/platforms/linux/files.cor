// Linux's file calls: open, read, write, seek, stat, the name space and
// directories, as thin wrappers over Sys.Syscall -- the part of the Os class
// that System.IO is built on.
//
// TWO KINDS OF CALLER COMPILE THIS FILE. A Linux program, beside system.cor,
// whose Sys.Syscall is `int 0x80`; and CORSAC's kernel and its modules,
// beside baremetal.cor, compiled with --kernel-syscalls, whose Sys.Syscall is
// a call of the kernel's KernelFiles.Syscall. The numbers, the arguments and
// the structures (abi.cor) are Linux's for both.
//
// ---- raw memory, and why there is any ---------------------------------
//
// Every structure the kernel fills in -- a stat, a timespec, a directory
// record, a termios -- is a block of bytes with fields at fixed offsets,
// and this language has no way to declare one. A byte[] is the block; Raw
// reads and writes its fields. The alternative, a class per structure with
// the kernel writing into its fields, needs the compiler to promise a
// layout it does not promise.

public static partial class Os
{
    /// `s` as UTF-8 with a zero byte after it, which is what the kernel
    /// means by a path: a string is UTF-16 code units, and a path a Unix
    /// kernel is handed is bytes.
    private static byte[] CString(string s)
    {
        return Utf8Transcoder.EncodeTerminated(s);
    }

    /// inotify_init1(2): a descriptor that is told of changes to the files
    /// it watches (inotify(7)); `flags` IN_NONBLOCK (0x800), IN_CLOEXEC
    /// (0x80000).
    public static int InotifyInit1(int flags)
    {
        return (int)Err.Result(Sys.Syscall(LinuxCall.InotifyInit1, (SyscallWord)flags, 0, 0));
    }

    /// inotify_add_watch(2): `path` watched for `mask` (IN_*); its watch
    /// descriptor, the same one again for a path watched already.
    public static int InotifyAddWatch(int fd, string path, long mask)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.InotifyAddWatch, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(c), (SyscallWord)(uint)mask));
    }

    /// inotify_rm_watch(2): the watch ends, and IN_IGNORED says so.
    public static int InotifyRmWatch(int fd, int wd)
    {
        return (int)Err.Result(Sys.Syscall(LinuxCall.InotifyRmWatch, (SyscallWord)fd, (SyscallWord)wd, 0));
    }

    /// open(2). The mode is what a file is CREATED with and is ignored
    /// otherwise, exactly as open(2)'s third argument is.
    public static int Open(string path, int flags, int mode)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Open, (SyscallWord)Sys.ArrayData(c), (SyscallWord)flags, (SyscallWord)mode));
    }

    /// Two-argument open: a file it creates is 0666 (0x1B6) through the
    /// umask, as creat(2)'s callers and .NET make one -- the mask, not this,
    /// is what takes the group's and others' write away.
    public static int Open(string path, int flags)
    {
        return Open(path, flags, 0x1B6);
    }

    public static int Close(int fd)
    {
        return (int)Err.Result(Sys.Syscall(LinuxCall.Close, (SyscallWord)fd, 0, 0));
    }

    /// read(2) into part of an array. Zero means the end; negative is -errno.
    /// The range is checked here because the kernel would happily write past
    /// the array, and that is the one bug a language with bounds checks is
    /// supposed to make impossible.
    public static int Read(int fd, byte[] buf, int at, int count)
    {
        if (at < 0 || count < 0 || at > buf.Length - count)
        {
            throw new IndexOutOfRangeException("read range is outside its buffer");
        }
        return (int)Err.Result(Platform.Blocking(LinuxCall.Read, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buf) + (nuint)at), (SyscallWord)count));
    }

    /// A read at an offset, which moves no file position (pread64): several
    /// threads can read one descriptor at once (RandomAccess.Read). The
    /// kernel's number.
    public static long Pread(int fd, nuint into, nuint count, long offset)
    {
#if SYSCALL64
        return Err.Result(Platform.Blocking(LinuxCall.Pread64, (SyscallWord)fd, (SyscallWord)into, (SyscallWord)count, (SyscallWord)offset));
#else
        // The offset in two registers, low then high.
        return Err.Result(Platform.Blocking(LinuxCall.Pread64, (SyscallWord)fd, (SyscallWord)into, (SyscallWord)count, (uint)offset, (uint)(offset >> 32)));
#endif
    }

    /// Pread into buf[at, at + count), checked as Read is.
    public static long Pread(int fd, byte[] buf, int at, int count, long offset)
    {
        if (at < 0 || count < 0 || at > buf.Length - count)
        {
            throw new IndexOutOfRangeException("read range is outside its buffer");
        }
        return Pread(fd, Sys.ArrayData(buf) + (nuint)at, (nuint)count, offset);
    }

    /// pwrite(2): a write at an offset that moves no file position.
    public static long Pwrite(int fd, nuint from, nuint count, long offset)
    {
#if SYSCALL64
        return Err.Result(Platform.Blocking(LinuxCall.Pwrite64, (SyscallWord)fd, (SyscallWord)from, (SyscallWord)count, (SyscallWord)offset));
#else
        // The offset in two registers, low then high.
        return Err.Result(Platform.Blocking(LinuxCall.Pwrite64, (SyscallWord)fd, (SyscallWord)from, (SyscallWord)count, (uint)offset, (uint)(offset >> 32)));
#endif
    }

    /// Pwrite from buf[at, at + count), checked as Pread is.
    public static long Pwrite(int fd, byte[] buf, int at, int count, long offset)
    {
        if (at < 0 || count < 0 || at > buf.Length - count)
        {
            throw new IndexOutOfRangeException("write range is outside its buffer");
        }
        return Pwrite(fd, Sys.ArrayData(buf) + (nuint)at, (nuint)count, offset);
    }

    /// The raw form: an address and a count, for code that manages its own
    /// buffer. Answers the kernel's number.
    public static long Read(int fd, nuint into, nuint count)
    {
        return Err.Result(Platform.Blocking(LinuxCall.Read, (SyscallWord)fd, (SyscallWord)into, (SyscallWord)count));
    }

    /// write(2) from part of an array. ONE call: the kernel may take fewer
    /// bytes than offered, and the caller that cares loops. Negative is -errno.
    public static int Write(int fd, byte[] buf, int at, int count)
    {
        if (at < 0 || count < 0 || at > buf.Length - count)
        {
            throw new IndexOutOfRangeException("write range is outside its buffer");
        }
        return (int)Err.Result(Platform.Blocking(LinuxCall.Write, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buf) + (nuint)at), (SyscallWord)count));
    }

    public static long Write(int fd, nuint at, nuint count)
    {
        return Err.Result(Platform.Blocking(LinuxCall.Write, (SyscallWord)fd, (SyscallWord)at, (SyscallWord)count));
    }

    /// `s` as UTF-8 with a zero byte after it, for the calls that take a
    /// path. Public for the same reason AddressOf is.
    public static byte[] CStr(string s)
    {
        return CString(s);
    }

    /// lseek(2) with a 64-bit offset.
    ///
    /// _llseek, not lseek: the i386 lseek takes and returns a 32-bit offset,
    /// so it cannot say where it is in a file over 2 GB and cannot be asked to
    /// go there. _llseek splits the offset into two words and writes the
    /// answer into a buffer, which is why this one needs eight bytes of room.
    public static long Lseek(int fd, long offset, int whence)
    {
#if SYSCALL64
        // Long mode's lseek takes and answers the whole 64-bit offset.
        return Err.Result(Sys.Syscall(LinuxCall.Lseek, (SyscallWord)fd, (SyscallWord)offset, (SyscallWord)whence));
#else
        byte[] where = new byte[8];
        long got = Err.Result(Sys.Syscall(LinuxCall.LlSeek, (SyscallWord)fd,
            (uint)(offset >> 32), (uint)offset,
            (SyscallWord)Sys.ArrayData(where), (SyscallWord)whence, 0));

        if (got < 0)
        {
            return got;
        }
        return Raw.I64(where, 0);
#endif
    }

    /// Where the descriptor is now, without moving it.
    public static long Tell(int fd)
    {
        return Lseek(fd, 0, Whence.Current);
    }

    /// How long an open file is. A regular file's is fstat's st_size, as
    /// .NET's FileStream.Length on Unix answers -- a /proc file, which Linux
    /// will not seek to the end of (EINVAL), is 0 bytes by it, and a reader
    /// of it reads to its end. Anything else goes to its end and back again:
    /// a disc's length, and a pipe's -ESPIPE, the honest answer to "how
    /// long is a pipe".
    public static long SizeOf(int fd)
    {
        byte[] st = StatBuf.Room();
        if (Fstat(fd, st) >= 0 && (StatBuf.Mode(st) & 0xF000) == 0x8000) return StatBuf.Size(st);

        long here = Lseek(fd, 0, Whence.Current);

        if (here < 0)
        {
            return here;
        }

        long end = Lseek(fd, 0, Whence.End);

        if (end < 0)
        {
            return end;
        }
        Lseek(fd, here, Whence.Set);
        return end;
    }

    public static int Truncate(int fd, long length)
    {
        // The length is 64 bits: Ftruncate takes it in the shape each target's call does.
        return Ftruncate(fd, length);
    }

    /// flock(2): an advisory lock on the whole file (LOCK_SH 1, LOCK_EX 2,
    /// LOCK_UN 8, LOCK_NB 4 not to wait). 0, or a negative errno -- EAGAIN
    /// when LOCK_NB and somebody else holds a conflicting lock.
    public static int Flock(int fd, int operation)
    {
        return (int)Err.Result(Sys.Syscall(LinuxCall.Flock, (SyscallWord)fd, (SyscallWord)operation, 0));
    }

    /// fsync(2): the file's data and metadata on the device before it returns.
    public static int Fsync(int fd)
    {
        return (int)Err.Result(Sys.Syscall(LinuxCall.Fsync, (SyscallWord)fd, 0, 0));
    }

    /// ftruncate64(2), the length split into two words as the i386 call takes it.
    public static int Ftruncate(int fd, long length)
    {
#if SYSCALL64
        return (int)Err.Result(Sys.Syscall(LinuxCall.Ftruncate, (SyscallWord)fd, (SyscallWord)length, 0));
#else
        return (int)Err.Result(Sys.Syscall(LinuxCall.Ftruncate64, (SyscallWord)fd, (uint)length, (uint)(length >> 32)));
#endif
    }

    public static int Stat(string path, byte[] into)
    {
        StatBuf.Check(into);
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Statx, SyscallRegister.AtFdCwd, (SyscallWord)Sys.ArrayData(c), 0, StatBuf.BasicStats, (SyscallWord)Sys.ArrayData(into), 0));
    }

    /// The link itself rather than what it points at.
    public static int Lstat(string path, byte[] into)
    {
        StatBuf.Check(into);
        byte[] c = CString(path);
        // AT_SYMLINK_NOFOLLOW (0x100).
        return (int)Err.Result(Sys.Syscall(LinuxCall.Statx, SyscallRegister.AtFdCwd, (SyscallWord)Sys.ArrayData(c), 0x100, StatBuf.BasicStats, (SyscallWord)Sys.ArrayData(into), 0));
    }

    public static int Fstat(int fd, byte[] into)
    {
        StatBuf.Check(into);
        // An empty path and AT_EMPTY_PATH (0x1000): the descriptor itself.
        byte[] none = CString("");
        return (int)Err.Result(Sys.Syscall(LinuxCall.Statx, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(none), 0x1000, StatBuf.BasicStats, (SyscallWord)Sys.ArrayData(into), 0));
    }

    /// Whether the name resolves to anything at all.
    public static bool Exists(string path)
    {
        byte[] st = StatBuf.Room();
        return Stat(path, st) >= 0;
    }

    /// The mode word, or 0 when the name is not there -- 0 is not a mode any
    /// real file has, so "not there" and "there" stay distinguishable without
    /// a second call.
    public static long ModeOf(string path)
    {
        byte[] st = StatBuf.Room();

        if (Stat(path, st) < 0)
        {
            return 0;
        }
        return StatBuf.Mode(st);
    }

    /// How many bytes the named file holds, or -errno.
    public static long SizeOf(string path)
    {
        byte[] st = StatBuf.Room();
        int r = Stat(path, st);

        if (r < 0)
        {
            return r;
        }
        return StatBuf.Size(st);
    }

    public static int Create(string path, int mode)
    {
        return Open(path, O.Write | O.Create | O.Truncate, mode);
    }

    public static int Unlink(string path)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Unlink, (SyscallWord)Sys.ArrayData(c), 0, 0));
    }

    /// rename(2). BOTH paths are copied before either address is taken: a
    /// second allocation can collect, and a collection can run while the first
    /// address is only in a register, which no conservative scan of the stack
    /// would find.
    public static int Rename(string from, string to)
    {
        byte[] a = CString(from);
        byte[] b = CString(to);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Rename, (SyscallWord)Sys.ArrayData(a), (SyscallWord)Sys.ArrayData(b), 0));
    }

    public static int Mkdir(string path, int mode)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Mkdir, (SyscallWord)Sys.ArrayData(c), (SyscallWord)mode, 0));
    }

    /// 0777 through the umask, which is what mkdir(1) asks mkdir(2) for.
    public static int Mkdir(string path)
    {
        return Mkdir(path, 0x1FF);
    }

    public static int Rmdir(string path)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Rmdir, (SyscallWord)Sys.ArrayData(c), 0, 0));
    }

    public static int Chmod(string path, int mode)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Chmod, (SyscallWord)Sys.ArrayData(c), (SyscallWord)mode, 0));
    }

    /// access(2). 0 asks only whether the name resolves; 1/2/4 are execute,
    /// write and read.
    public static int Access(string path, int mode)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Access, (SyscallWord)Sys.ArrayData(c), (SyscallWord)mode, 0));
    }

    /// link(2): another directory entry for the inode `existing` already
    /// names. Not a copy -- the two names are the same file thereafter.
    public static int Link(string existing, string name)
    {
        byte[] a = CString(existing);
        byte[] b = CString(name);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Link, (SyscallWord)Sys.ArrayData(a), (SyscallWord)Sys.ArrayData(b), 0));
    }

    public static int Symlink(string target, string name)
    {
        byte[] a = CString(target);
        byte[] b = CString(name);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Symlink, (SyscallWord)Sys.ArrayData(a), (SyscallWord)Sys.ArrayData(b), 0));
    }

    /// Where a symbolic link points, or null when it is not one.
    public static string? Readlink(string path)
    {
        byte[] c = CString(path);
        byte[] room = new byte[4096];
        int n = (int)Err.Result(Sys.Syscall(LinuxCall.Readlink, (SyscallWord)Sys.ArrayData(c), (SyscallWord)Sys.ArrayData(room), (SyscallWord)room.Length));

        if (n < 0)
        {
            return null;
        }
        return Raw.Text(room, 0, n);
    }

    /// The working directory, or null when it is longer than the buffer or has
    /// been removed underneath us.
    public static string? Getcwd()
    {
        byte[] room = new byte[4096];
        int n = (int)Err.Result(Sys.Syscall(LinuxCall.Getcwd, (SyscallWord)Sys.ArrayData(room), (SyscallWord)room.Length, 0));

        if (n <= 0)
        {
            return null;
        }
        // The kernel counts the NUL it wrote; a string here does not have one.
        return Raw.Text(room, 0, n - 1);
    }

    /// One getdents64(2): as many whole records as fit, or 0 at the end.
    /// Dirent below walks the buffer.
    public static int Getdents(int fd, byte[] into, int count)
    {
        if (count < 0 || count > into.Length)
        {
            throw new IndexOutOfRangeException("directory buffer is too small for that count");
        }
        return (int)Err.Result(Sys.Syscall(LinuxCall.Getdents64, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(into), (SyscallWord)count));
    }

    /// Every name in a directory except "." and "..", or null when it cannot
    /// be opened. Sorted by nothing: the order is the filing system's, which
    /// is what readdir(3) gives too.
    public static string[]? ListDir(string path)
    {
        int error;
        return ListDir(path, out error);
    }

    /// The same, with why not: `error` is the -errno of the open that
    /// failed, which is what tells a missing directory from one that may
    /// not be read, and 0 when the names came back.
    public static string[]? ListDir(string path, out int error)
    {
        int fd = Open(path, O.Read | O.Directory);

        if (fd < 0)
        {
            error = fd;
            return null;
        }
        error = 0;

        List<string> names = new List<string>();
        byte[] block = new byte[4096];

        while (true)
        {
            int got = Getdents(fd, block, block.Length);

            if (got <= 0)
            {
                break;
            }

            int at = 0;

            while (at < got)
            {
                string name = Dirent.Name(block, at);

                if (name != "." && name != "..")
                {
                    names.Add(name);
                }
                at = at + Dirent.Length(block, at);
            }
        }
        Close(fd);
        return names.ToArray();
    }

    /// utimensat(2) on a path: access and modification times as seconds
    /// and nanoseconds; negative nanoseconds leave that time alone.
    /// `follow` false changes a symbolic link itself.
    public static int Utimensat(string path, long atimeSeconds, long atimeNanos, long mtimeSeconds, long mtimeNanos, bool follow)
    {
        // Two timespecs, access then modification.
        byte[] times = new byte[2 * TimeSpec.Bytes];
        byte[] one = TimeSpec.Room();
        TimeSpec.Set(one, atimeNanos < 0 ? 0 : atimeSeconds, atimeNanos < 0 ? 1073741822 : atimeNanos);   // UTIME_OMIT
        for (int i = 0; i < TimeSpec.Bytes; i++) times[i] = one[i];
        TimeSpec.Set(one, mtimeNanos < 0 ? 0 : mtimeSeconds, mtimeNanos < 0 ? 1073741822 : mtimeNanos);
        for (int i = 0; i < TimeSpec.Bytes; i++) times[TimeSpec.Bytes + i] = one[i];
        return (int)Err.Result(Sys.Syscall(LinuxCall.Utimensat, SyscallRegister.AtFdCwd, (SyscallWord)Sys.ArrayData(CString(path)), (SyscallWord)Sys.ArrayData(times), follow ? 0u : 0x100u, 0, 0));
    }

    /// chown(2), by name, following symbolic links.
    public static int Chown(string path, int uid, int gid)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Chown, (SyscallWord)Sys.ArrayData(c), (SyscallWord)uid, (SyscallWord)gid));
    }

    /// lchown(2): as Chown, but of a symbolic link itself rather than what
    /// it names.
    public static int Lchown(string path, int uid, int gid)
    {
        byte[] c = CString(path);
        return (int)Err.Result(Sys.Syscall(LinuxCall.Lchown, (SyscallWord)Sys.ArrayData(c), (SyscallWord)uid, (SyscallWord)gid));
    }

    /// statfs64(2): how big a filing system is and how much of it is left.
    public static int Statfs(string path, byte[] into)
    {
        StatFs.Check(into);
        byte[] c = CString(path);
#if SYSCALL64
        return (int)Err.Result(Sys.Syscall(LinuxCall.Statfs64, (SyscallWord)Sys.ArrayData(c), (SyscallWord)Sys.ArrayData(into), 0));
#else
        return (int)Err.Result(Sys.Syscall(LinuxCall.Statfs64, (SyscallWord)Sys.ArrayData(c),
                                                StatFs.Bytes, (SyscallWord)Sys.ArrayData(into)));
#endif
    }

    public static int Fstatfs(int fd, byte[] into)
    {
        StatFs.Check(into);
#if SYSCALL64
        return (int)Err.Result(Sys.Syscall(LinuxCall.Fstatfs64, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(into), 0));
#else
        return (int)Err.Result(Sys.Syscall(LinuxCall.Fstatfs64, (SyscallWord)fd,
                                                StatFs.Bytes, (SyscallWord)Sys.ArrayData(into)));
#endif
    }

    public static int Close(long fd)
    {
        return Close((int)fd);
    }

    public static long Write(long fd, string s)
    {
        return Write((int)fd, s);
    }

    public static long Lseek(long fd, long offset, long whence)
    {
        return Lseek((int)fd, offset, (int)whence);
    }

    // ---- the clock files are stamped by, and a device's own calls ---------

    /// Microseconds since the epoch, clock_gettime(2)'s realtime clock as one number:
    /// DateTime.UtcNow, which System.IO's file times are compared with.
    public static long Micros()
    {
        // The call itself, not Os.ClockGetTime: this file is also the kernel's
        // file layer (--kernel-syscalls), compiled without system.cor.
        byte[] now = TimeSpec.Room();

        if (Err.Result(Sys.Syscall(LinuxCall.ClockGetTime, (SyscallWord)ClockId.Realtime, (SyscallWord)Sys.ArrayData(now), 0)) < 0)
        {
            return 0;
        }
        return TimeSpec.Seconds(now) * 1000000 + TimeSpec.Nanos(now) / 1000;
    }

    /// ioctl(2) on a descriptor (System.IO's BlockDevice).
    public static long Ioctl(int fd, uint request, nuint argument)
    {
        return Err.Result(Sys.Syscall(LinuxCall.Ioctl, (SyscallWord)fd, request, (SyscallWord)argument));
    }
}
