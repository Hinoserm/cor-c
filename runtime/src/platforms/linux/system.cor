// The Linux system-call library: the ONLY file that knows the program is a
// Linux process, i386 or x86-64.
//
// Everything here is a system call through Sys.Syscall, the one intrinsic the
// compiler provides for reaching the kernel (docs/software/X86-BACKEND.md,
// "Linux is a target, not a model"), made exactly as Linux's interface for
// the program's own mode makes it: `int 0x80` with the number in EAX and
// the arguments in EBX, ECX, EDX, ESI, EDI, EBP on i386, `syscall` with them
// in RAX and RDI, RSI, RDX, R10, R8, R9 in long mode. The backend does that;
// this file only says which number and what to pass, in registers as wide as
// the interface's (SyscallWord), and where the two interfaces ask for
// different shapes -- a 64-bit value in two registers, a structure laid out
// otherwise -- it says so under SYSCALL64 (--syscall-abi).
//
//   corc compile program.cor -o program
//
// Two layers live here:
//
//   Platform   what runtime/src/core/runtime.cor needs from an operating system:
//              memory, exit, and writing bytes. The runtime calls nothing
//              else in this file.
//   Os, Console, Fd, O, Err, Call
//              the beginnings of the API a program written for this system
//              uses, as thin wrappers, named after os/lib/user.cor's so the
//              OS's own utilities port with the fewest edits.
//
// THE ONE FACT ABOUT THE KERNEL'S ANSWERS. A Linux system call returns its
// result in EAX, and an error is a SMALL NEGATIVE number: -errno, in
// -4095..-1. Sys.Syscall hands the register back as a SyscallWord, unchanged. An
// error is one of the top 4095 values of the unsigned range (Err.Failed);
// an address is read with Err.Address, never by its sign, since one above
// 2 GB (which brk and mmap can legitimately return) is negative as a signed number.

/// The control messages recvmsg(2) answers with: a list of headers, each
/// four words of its own length, a level and a type, then the data, and
/// each one starting on a word boundary whatever the last one's length was.
///
/// A PROGRAM MUST WALK THIS AND MUST NOT INDEX IT. The kernel writes as
/// many as it has to say and in whatever order it likes, and a program that
/// assumes the one it asked for is the first one works until the day
/// somebody turns on a second option.
static class Cmsg
{
    // struct cmsghdr: a size_t length, then two ints, padded to a word.
#if SYSCALL64
    public const int HeaderBytes = 16;
    const int LevelAt = 8;
    const int Align = 7;
#else
    public const int HeaderBytes = 12;
    const int LevelAt = 4;
    const int Align = 3;
#endif

    // The levels and types a program on this machine actually reads.
    public const int LevelIp = 0;               // SOL_IP
    public const int TimeToLive = 2;            // IP_TTL, with IP_RECVTTL set
    public const int Error = 11;                // IP_RECVERR's answer

    /// Where the first header is, or -1 when there is none.
    public static int First(int controlBytes)
    {
        return controlBytes >= HeaderBytes ? 0 : -1;
    }

    /// Where the header after the one at `at` is, or -1.
    public static int Next(byte[] control, int controlBytes, int at)
    {
        nuint length = Length(control, at);

        if (length < HeaderBytes)
        {
            return -1;
        }

        int next = at + (int)((length + (nuint)Align) & ~(nuint)Align);
        return next + HeaderBytes <= controlBytes ? next : -1;
    }

    public static nuint Length(byte[] control, int at)
    {
        return Raw.Word(control, at);
    }

    public static int Level(byte[] control, int at)
    {
        return (int)Raw.I32(control, at + LevelAt);
    }

    public static int Type(byte[] control, int at)
    {
        return (int)Raw.I32(control, at + LevelAt + 4);
    }

    /// Where this header's data starts.
    public static int Data(int at)
    {
        return at + HeaderBytes;
    }
}

/// What runtime/src/core/runtime.cor and runtime/src/core/gc.cor ask of the operating system,
/// and nothing else. The heap is the caller of Map, so NOTHING in this
/// class may allocate: no `new`, no arrays, no strings built at run time.
/// A string LITERAL is data the compiler laid out, and is fine.
static class Platform
{
    // The raw answer, as is: -errno for a call that answers a count or
    // zero. An address-returning call goes through Err.Failed/Err.Address.
    public static long Result(SyscallWord raw)
    {
        return Err.Result(raw);
    }

    /// A call that may wait -- a read of a pipe, a terminal or a socket, a
    /// poll, a wait for a child, a sleep -- made as a blocking one to the
    /// collector, as Native.Wait makes a futex wait. A thread parked in the
    /// kernel that the collector counted as running is waited for by the
    /// first collection another thread starts, for ever: lsass's accept(2)
    /// held every other thread of it so until its callers made their waits
    /// this way. The stack is read where it stands meanwhile; the words the
    /// call was handed are on it, and they keep what they point into.
    /// Answers the kernel's raw number, as Sys.Syscall does.
    public static SyscallWord Blocking(int n, SyscallWord a, SyscallWord b, SyscallWord c, SyscallWord d = 0, SyscallWord e = 0, SyscallWord f = 0)
    {
        // A KERNEL'S OWN CALL (--kernel-syscalls) IS NOT BRACKETED: its
        // thread block is a processor's, the kernel decides when the call
        // parks and reads the parked stack itself, and a block marked
        // stopped is one it refuses to park.
        if (Sys.KernelSyscalls()) return Sys.Syscall(n, a, b, c, d, e, f);
        Runtime.BeginBlocking();
        SyscallWord raw = Sys.Syscall(n, a, b, c, d, e, f);
        Runtime.EndBlocking();
        return raw;
    }

    // THE COLLECTOR'S SETTINGS ARE THE IMAGE'S KNOBS (Runtime.KnobValue),
    // baked in with corc's --runtime-knob NAME=VALUE, and never the
    // environment's: .NET's name where .NET has the setting, Corsac.GC.*
    // where it does not. Read with nothing allocated, on any thread, at any
    // time: the knobs are a literal in the image, where the environment was
    // the loader's stack, which only the main thread could trust and a
    // program could write over.

    /// Corsac.GC.Verify: the collector checks, after each minor cycle's
    /// mark, that no old object points at a young one it is about to sweep.
    public static bool VerifyGenerations() => Runtime.KnobFlag("Corsac.GC.Verify");

    /// Corsac.GC.Census: every whole collection counts what it found live,
    /// by type, and says the largest on standard error. Corsac.GC.DeadCensus
    /// asks for it too, as Gc.AskDeadCensus does.
    /// ASKED ONCE: the collector asks at every collection, and the answer
    /// cannot change -- a walk of the knobs at each would find what the
    /// first found.
    public static bool GcCensus()
    {
        if (_censusAsked == 0) _censusAsked = (Runtime.KnobFlag("Corsac.GC.Census") || Runtime.KnobFlag("Corsac.GC.DeadCensus")) ? 2 : 1;
        return _censusAsked == 2;
    }

    static int _censusAsked;

    /// Corsac.GC.DeadCensus: the census also counts what every sweep found dead.
    public static bool GcDeadCensus() => Runtime.KnobFlag("Corsac.GC.DeadCensus");

    /// Corsac.GC.Threshold=<bytes>: collect at least that often, whatever the
    /// pacing says -- every call site a collection may fall under, tried.
    /// WITHOUT IT, ON A SMALL MACHINE -- 128 MB or less (TotalMemory: the
    /// machine, or the control group's limit when that is smaller) -- a
    /// thirty-second of its memory, as a kernel's own heap is held (its
    /// ThresholdCap), and with it the collector's small pages and chunks
    /// (HeapChunks.BatchPageBytes, ChunkAsk): a 32 MB machine's desktop
    /// programs each kept a heap paced for a machine with memory to spare.
    /// A larger machine has none, as before.
    public static long GcThreshold()
    {
        if (!_thresholdAsked)
        {
            _threshold = Runtime.KnobNumber("Corsac.GC.Threshold");
            if (_threshold == 0)
            {
                long total = TotalMemory();
                if (total > 0 && total <= SmallMachineBytes) _threshold = total / 32;
            }
            _thresholdAsked = true;
        }
        return _threshold;
    }

    /// The most memory a machine has that its programs' heaps are held for.
    const long SmallMachineBytes = 128L * 1024 * 1024;

    static bool _thresholdAsked;
    static long _threshold;

    /// System.GC.Gen0Size=<bytes>, the name the build gives .NET's GCgen0size
    /// (ManagedRuntimeConfiguration): allocate that much between minor
    /// cycles, whatever the pacing says -- for measuring what a nursery's
    /// size costs.
    public static long GcNursery() => Runtime.KnobNumber("System.GC.Gen0Size");

    /// Whether threads have region arenas (Gc, "regions"): here they do,
    /// each mapped chunk by chunk as its regions fill it.
    public static bool Regions()
    {
        return true;
    }

    /// System.GC.HeapHardLimit=<bytes>, .NET's own knob for it: the heap's
    /// hard limit, as a container's memory.max would set it -- for trying a
    /// small machine on a big one.
    public static long HeapLimit() => Runtime.KnobNumber("System.GC.HeapHardLimit");

    /// Corsac.GC.AllocSample: where the allocations come from, sampled and
    /// printed as the process ends (AllocSamples).
    public static bool AllocSample() => Runtime.KnobFlag("Corsac.GC.AllocSample");

    /// Which sampled blocks were freed, and which the collector took.
    public static bool AllocSampleFrees() => true;

    /// Corsac.GC.Stats: the collector's counts, pauses and heap said at exit,
    /// as corc's --gc-stats has corc's own said (AppContext's switch of the
    /// same name).
    public static bool GcStats() => Runtime.KnobFlag("Corsac.GC.Stats");

    /// Corsac.GC.HeapCheck: the heap's structure checked as every collection
    /// begins and ends -- every chunk's chain, every buffer's, and the free
    /// lists against what the walks found -- and the first faults said.
    public static bool HeapCheck() => Runtime.KnobFlag("Corsac.GC.HeapCheck");

    /// Corsac.GC.VerifyFrees: the collector's checked mode for the compiler's
    /// frees (Gc.VerifyFree), every free it was handed poisoned and kept.
    public static bool VerifyFrees() => Runtime.KnobFlag("Corsac.GC.VerifyFrees") && Runtime.KnobLetter("Corsac.GC.VerifyFrees") != 'f';

    /// Corsac.GC.VerifyFrees=f: only the fields freed with their owner
    /// (Runtime.FreeField) are checked -- poisoned, kept, their free recorded
    /// -- and every other free gives its block back as usual, so the heap is
    /// reused the way an unchecked run reuses it.
    public static bool VerifyFieldFrees() => Runtime.KnobFlag("Corsac.GC.VerifyFrees") && Runtime.KnobLetter("Corsac.GC.VerifyFrees") == 'f';

    /// Corsac.GC.FreeLog: every field free the compiler wrote is recorded in a
    /// ring (Runtime.FreeLog), for a debugger or a scan of the process to
    /// find the free that took an object still in use.
    public static bool FreeLog() => Runtime.KnobFlag("Corsac.GC.FreeLog");

    /// Corsac.GC.GuardReleases: a chunk the heap releases is made
    /// inaccessible instead of unmapped (Guard), and a dedicated one released
    /// by a free says who freed it: a stale reference to what was in it
    /// faults at its first use, in the fault report's stack.
    public static bool GuardReleases() => Runtime.KnobFlag("Corsac.GC.GuardReleases");

    /// Corsac.GC.IgnoreFrees: which frees the compiler wrote are ignored, the
    /// collector finding that garbage instead. What it is for is telling a
    /// fault that a free makes from one the collector makes, and then which
    /// kind of free: 1 (or anything else) all of them; p the plain frees at
    /// a last use (Runtime.Free); f the fields freed with their owner
    /// (Runtime.FreeField); r what an owned variable or an owned field held
    /// before it was assigned, and a collection's outgrown storage (both of
    /// the three below); v an owned variable's (Runtime.FreeReplaced); w an
    /// owned field's (Runtime.FreeOwnedReplaced); o a collection's outgrown
    /// storage alone (OutgrownStorage); s the storage a collection made in a
    /// frame gives back (Runtime.FreeStorageInFrame). 0, false, or unset, none.
    public static long IgnoreFrees()
    {
        return Runtime.KnobFlag("Corsac.GC.IgnoreFrees") ? Runtime.KnobLetter("Corsac.GC.IgnoreFrees") : 0;
    }

    /// Corsac.GC.FreePaths: the ways a free gives a block back that are
    /// skipped, the block left to the collector instead -- a diagnostic, for
    /// finding which of them corrupts. Letters: t the top of the thread's own
    /// buffer, i a block freed in place in another thread's buffer, b the
    /// bump pointer's top, d a dedicated chunk released, m a block merged
    /// into the free lists. As a mask: t 1, i 2, b 4, d 8, m 16. And p 32:
    /// every block freed is filled with the checked mode's pattern before it
    /// goes back -- the two paths that hand the bytes straight back to the
    /// bump pointer (t, b) skipped -- so a read after a free and before the
    /// reuse faults on the pattern, and a fault that does not is the heap's.
    /// And P 64: every run of dead blocks a sweep gives back is filled with
    /// the pattern too, so an object swept while something still used it --
    /// a root the stack maps missed -- is read as the pattern at once.
    public static long SkippedFreePaths() => Runtime.FreePathsMask();

    /// Fresh, zeroed, page-aligned memory of `bytes`, or 0.
    ///
    /// mmap2 of anonymous private pages: the kernel zeroes every page it
    /// hands over, which is the promise the heap's bump allocation relies
    /// on, and each call is a chunk of its own, which is what the heap's
    /// chunk list expects. mmap2 rather than mmap because the i386 ABI's
    /// six-argument form is mmap2 (the offset is in pages) and the old
    /// mmap takes its arguments in a structure.
    /// A label and a number on standard error, allocating nothing: for the
    /// allocator's own paths, where a `new` would recurse.
    static nuint _traceDigits;

    public static void Trace(string label, long value)
    {
        if (_traceDigits == 0)
        {
            _traceDigits = Err.Address(Sys.Syscall(LinuxCall.Mmap, 0, 4096, 3, 0x22, SyscallRegister.MinusOne, 0));
        }

        Runtime.WriteLiteral(2, label);

        if (_traceDigits != 0)
        {
            ulong n = value < 0 ? 0 - (ulong)value : (ulong)value;
            int at = 24;

            if (n == 0)
            {
                at = at - 1;
                Sys.Write8(_traceDigits + (nuint)at, 48);
            }

            while (n > 0 && at > 1)
            {
                at = at - 1;
                Sys.Write8(_traceDigits + (nuint)at, (byte)(48 + n % 10));
                n = n / 10;
            }

            if (value < 0)
            {
                at = at - 1;
                Sys.Write8(_traceDigits + (nuint)at, 45);
            }

            WriteBytes(2, _traceDigits + (nuint)at, (nuint)(24 - at));
        }

        Runtime.WriteLiteral(2, "\n");
    }

    /// Memory given back to the kernel: munmap(2). What the collector does
    /// with a chunk it has emptied.
    public static void Unmap(nuint at, nuint bytes)
    {
        Sys.Syscall(LinuxCall.Munmap, (SyscallWord)at, (SyscallWord)bytes, 0);
    }

    /// Memory made unreadable and unwritable and its address kept: a fresh
    /// PROT_NONE mapping over it. What a released chunk becomes under Corsac.GC.GuardReleases,
    /// so that its address is never handed out again and the first use of it
    /// faults where it happens.
    public static void Guard(nuint at, nuint bytes)
    {
        // Mapped over, not protected: MAP_FIXED | MAP_NORESERVE with
        // PROT_NONE keeps the addresses reserved and gives the pages back.
        // Protected, every guarded chunk stayed resident, and a build ran
        // the machine out of memory.
        Sys.Syscall(LinuxCall.Mmap, (SyscallWord)at, (SyscallWord)bytes, 0, 0x22 | 0x10 | 0x4000, SyscallRegister.MinusOne, 0);
    }

    /// The processor given up to whatever else is ready (sched_yield): a
    /// thread spinning for a lock lets its holder run (GcLock.Enter).
    public static void Yield()
    {
        Sys.Syscall(LinuxCall.Sched_Yield, 0, 0, 0);
    }

    /// A file mapped whole, read-only and private: its pages the page
    /// cache's, shared by every process that maps it and given back under
    /// pressure like any cached page. The address, and its length in
    /// `length`; 0 when it cannot be mapped (the caller reads it instead).
    public static nuint MapReadOnly(string path, out nuint length)
    {
        length = 0;
        int fd = Os.Open(path, 0);                          // O_RDONLY
        if (fd < 0) return 0;
        long size = Os.SizeOf(fd);
        nuint at = 0;
        if (size > 0 && size < 0x10000000)
        {
            // PROT_READ = 1, MAP_PRIVATE = 2.
            at = Err.Address(Sys.Syscall(LinuxCall.Mmap, 0, (SyscallWord)size, 1, 2, (SyscallWord)fd, 0));
            if (at != 0) length = (nuint)size;
        }
        Os.Close(fd);
        return at;
    }

    public static nuint Map(nuint bytes)
    {
        // PROT_READ | PROT_WRITE = 3; MAP_PRIVATE | MAP_ANONYMOUS = 0x22;
        // no file (-1), offset 0.
        SyscallWord got = Sys.Syscall(LinuxCall.Mmap, 0, (SyscallWord)bytes, 3, 0x22, SyscallRegister.MinusOne, 0);

        // REFUSED, said by whoever asked: the heap's out of memory is
        // reported only if nothing catches it (Gc.ThrowOutOfMemory).
        if (Err.Failed(got))
        {
            return 0;
        }
        nuint answer = (nuint)got;
        if (answer == 0)
        {
            string zero = "mmap answered address 0\n";
            Runtime.WriteLiteral(2, zero);
        }
        return answer;
    }

    // ---- the thread block ----------------------------------------------------

    /// Puts `block` where Sys.ThreadBlock() will find it, for this thread and
    /// no other.
    ///
    /// set_thread_area(2) writes one of the three GDT entries the kernel keeps
    /// PER THREAD and reloads them on every switch, so each thread asking for
    /// entry -1 gets one of its own with its own base. The selector it answers
    /// with, shifted and with the requested privilege level, goes into GS; a
    /// load through GS then adds that base, and the block's first word holding
    /// its own address (glibc's convention) is what turns one such load into a
    /// flat address every other instruction can use.
    ///
    /// Nothing here allocates: the structure the call reads is sixteen bytes
    /// of the block itself, because a thread sets its block up before it is
    /// allowed to touch the heap.
    ///
    /// Never inlined: a call of it by name is how region inference tells
    /// what runs before a thread's block is its own (RuntimeAbi.SetThreadBlock),
    /// where no region may be opened.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void SetThreadBlock(nuint block)
    {
        // ONLY FOR A COLLECTOR, which alone reads these: in a program without
        // one the stores fold away, and with them the routines they named --
        // the clock and the workers' -- at a closed link as in a whole
        // program (Escape.GoneWithoutCollector).
        if (Runtime.CollectorLinked())
        {
            // The collector times its pauses by this system's clock.
            Gc.PauseClock = Sys.AddressOf(MicrosecondsHook);
            // And the collector's workers: how many, and how one is started.
            Gc.WorkerCountHook = Sys.AddressOf(Platform.WorkerCountHook);
            Gc.WorkerStartHook = Sys.AddressOf(Platform.WorkerStartHook);
            Gc.WorkerQuietHook = Sys.AddressOf(Platform.WorkerQuietHook);
            // And its statics read by their cards in a minor cycle: a user-mode
            // program's statics take a reference only through a store the
            // compiler marks (Gc.ScanStatics).
            Gc.StaticsByCards = true;
        }
        Sys.WriteAddress(block + Tls.Self, block);

#if SYSCALL64
        // LONG MODE KEEPS A BASE REGISTER PER THREAD FOR THIS: GS, set with
        // arch_prctl(ARCH_SET_GS), saved and restored by the kernel on every
        // switch. Not FS, which is glibc's thread pointer: a program that
        // calls into C (a [DllImport]) runs C code on this thread, and that
        // code finds errno, its allocator's caches and its stack canary
        // through FS. No descriptor, no selector: the block's own first word
        // is still its address, so gs:[0] answers it.
        if (Err.Failed(Sys.Syscall(LinuxCall.ArchPrctl, LinuxCall.ArchSetGs, (SyscallWord)block, 0)))
        {
            Runtime.WriteLiteral(2, "arch_prctl(ARCH_SET_GS) failed: this kernel cannot give a thread its own block\n");
            Exit(134);
        }
#else

        nuint desc = block + Tls.Scratch;

        // THE C LIBRARY'S SELECTOR, taken before this replaces it: under
        // ld-linux, GS already names glibc's thread pointer, and a call into
        // C puts it back for the length of the call (Runtime.EnterNative).
        // Only the first time -- a later thread starts with the runtime's.
        int entry = 0 - 1;                      // entry_number: any free one
        if (Runtime.ManagedGs == 0)
        {
            Runtime.NativeGs = Sys.GetGs();
        }
        else
        {
            // The same slot in every thread, so one selector means each
            // thread's own block: a thread made by pthread_create inherits
            // the slot as its creator left it, and asking for "any" would
            // give it another.
            entry = Runtime.ManagedGs >> 3;
        }
        Sys.Write32(desc, (uint)entry);
        Sys.Write32(desc + 4, (uint)block);    // base_addr
        Sys.Write32(desc + 8, 0xFFFFF);        // limit: the whole space, in pages
        // seg_32bit | limit_in_pages | useable; a writable data segment that
        // is present, which is the rest of the bits being zero.
        Sys.Write32(desc + 12, 0x51);

        if (Err.Failed(Sys.Syscall(LinuxCall.SetThreadArea, (SyscallWord)desc, 0, 0)))
        {
            string text = "set_thread_area failed: this kernel cannot give a thread its own block\n";

            Runtime.WriteLiteral(2, text);
            Exit(134);
        }

        int selector = (int)(Sys.Read32(desc) << 3) | 3;
        Runtime.ManagedGs = selector;
        Sys.SetGs(selector);
#endif
    }

    // ---- waiting ---------------------------------------------------------------
    //
    // The collector's stop-the-world, and nothing else, uses these. FUTEX_WAIT
    // and FUTEX_WAKE with the private flag: no shared memory is involved, so
    // the kernel can skip the page lookup entirely.

    /// Nothing: a thread here stops when it next allocates or blocks, and
    /// there is no interrupt to send it. The kernel's platform has one.
    public static void PromptStop()
    {
    }

    /// EVERY THREAD OF THE PROCESS SERIALISED, as .NET's
    /// FlushProcessWriteBuffers: what an asymmetric fence rests on, the slow
    /// side making sure every other thread's stores are visible and none of
    /// its loads is from before. A fence here orders only this processor.
    /// membarrier(2)'s private expedited command interrupts each processor
    /// running one of this process's threads; it is registered on first use,
    /// and where the kernel has none the global command -- every processor,
    /// slower -- serves, and with neither, a fence. The kernel's answer kept
    /// (_membarrier): 1 private expedited, 2 global, -1 neither.
    static long _membarrier;

    public static void ProcessWideBarrier()
    {
        Sys.Fence();
        long how = _membarrier;
        if (how == 0)
        {
            // MEMBARRIER_CMD_QUERY (0): the commands this kernel has.
            long has = Err.Result(Sys.Syscall(LinuxCall.Membarrier, 0, 0, 0));
            if (has > 0 && (has & 8) != 0 && Sys.Syscall(LinuxCall.Membarrier, 16, 0, 0) == 0) how = 1;   // REGISTER_PRIVATE_EXPEDITED
            else if (has > 0 && (has & 1) != 0) how = 2;                                             // GLOBAL
            else how = -1;
            _membarrier = how;
        }
        if (how == 1) Sys.Syscall(LinuxCall.Membarrier, 8, 0, 0);          // PRIVATE_EXPEDITED
        else if (how == 2) Sys.Syscall(LinuxCall.Membarrier, 1, 0, 0);     // GLOBAL
    }

    // ---- the collector's workers ----------------------------------------

    // THE COLLECTOR'S HOOKS, as Sys.Call makes them: three words in, a word out.
    // The clock's microseconds are answered as their low word (the collector
    // takes differences of those as 32-bit numbers).
    static nuint MicrosecondsHook(nuint a, nuint b, nuint c) { return (nuint)Clock.NowMicroseconds(); }
    static nuint WorkerCountHook(nuint a, nuint b, nuint c) { return (nuint)CollectorWorkers(); }
    static nuint WorkerStartHook(nuint entry, nuint b, nuint c) { return (nuint)StartCollectorWorker(entry); }
    static nuint WorkerQuietHook(nuint a, nuint b, nuint c) { QuietWorker(); return 0; }

    /// How many threads may mark and sweep beside the collecting one: the
    /// processors this process may run on less one, at most seven, or the
    /// image's Corsac.GC.Workers, at most fifteen. Read without the heap: the
    /// collector asks this holding its lock.
    public static long CollectorWorkers()
    {
        if (Runtime.KnobValue("Corsac.GC.Workers") != 0)
        {
            long wanted = Runtime.KnobNumber("Corsac.GC.Workers");
            return (int)(wanted > 15 ? 15 : wanted);
        }
        nuint page = Map(4096);
        if (page == 0) return 0;
        long got = Platform.Result(Sys.Syscall(LinuxCall.SchedGetaffinity, 0, 128, (SyscallWord)page));
        int count = 0;
        for (long i = 0; i < got && i < 128; i++)
        {
            long bits = Sys.Read8(page + (nuint)i);
            while (bits != 0) { count = count + (int)(bits & 1); bits = bits >> 1; }
        }
        Unmap(page, 4096);
        count = count - 1;
        return count < 0 ? 0 : count > 7 ? 7 : count;
    }

    const int WorkerStackBytes = 256 * 1024;

    /// Starts one of them: `entry` on a stack of its own, with no Thread,
    /// no thread block and no signals. False when there is no room for it.
    public static long StartCollectorWorker(nuint entry)
    {
        nuint stack = Native.MapStack(WorkerStackBytes);
        if (stack == 0) return 0;
        return Native.SpawnBare(entry, 0, stack, WorkerStackBytes) > 0 ? 1 : 0;
    }

    /// First thing a worker does: every signal blocked, so no handler of the
    /// program's ever runs on a thread that has no block of its own.
    public static void QuietWorker()
    {
        // A mask in the worker's own frame: its thread block would be the
        // parent's, whose GS it inherited. Eight bytes of ones, every signal.
        long mask = 0 - 1;
        Sys.Syscall(LinuxCall.RtSigprocmask, 0, (SyscallWord)Sys.AddressOf(ref mask), 0, 8, 0, 0);     // SIG_BLOCK
    }

    public static void Wait(nuint at, int value)
    {
        Sys.Syscall(LinuxCall.Futex, (SyscallWord)at, 128, (SyscallWord)value, 0, 0, 0);
    }

    public static void Wake(nuint at, int count)
    {
        Sys.Syscall(LinuxCall.Futex, (SyscallWord)at, 129, (SyscallWord)count, 0, 0, 0);
    }

    // ---- the machine's memory, for GC.GetGCMemoryInfo ------------------------

    /// sysinfo(2)'s totalram and freeram, in bytes: what the machine has and
    /// what it has free (the kernel's view, which leaves out reclaimable
    /// caches -- MemAvailable counts those, and is read where a caller wants
    /// it) -- EACH NO MORE THAN THE PROCESS'S CONTROL GROUP ALLOWS. A
    /// compiler run in a 256 MB group on a 48 GB server was told 48: its
    /// caches took their largest sizes, the small-machine pacing never
    /// applied, and the group's limit killed it where a collection would have
    /// kept it inside. So the total is the smaller of the machine and the
    /// group's limit (MemoryLimit), as .NET reports a container's; and what
    /// is free is no more than the limit less what the group says it already
    /// uses (memory.current), or than the limit when that cannot be read.
    public static long TotalMemory()
    {
        long physical = SysinfoBytes(SysinfoTotal);
        long limit = MemoryLimit();
        return limit != 0 && (physical == 0 || limit < physical) ? limit : physical;
    }

    /// What is free, or -1 where nothing can say (sysinfo refused, no
    /// group limit).
    public static long AvailableMemory()
    {
        long free = MemAvailableBytes();
        if (free == 0) free = SysinfoBytes(SysinfoFree);
        long limit = MemoryLimit();
        if (limit == 0)
        {
            return free != 0 ? free : -1;
        }
        long used = CgroupUsage();
        long left = used < 0 ? limit : used < limit ? limit - used : 0;
        return free != 0 && free < left ? free : left;
    }

    /// Whether a mapping costs only the pages that are touched: the kernel
    /// commits anonymous memory as it is first written, so the collector may
    /// reserve a card table for the whole address space (Gc, generations).
    public const bool MapsCommitLazily = true;

    /// The scheduler's continuations are its own here: no kernel's run queue
    /// to post them to (Scheduler.Post), and no context to flow with them
    /// (AsyncContext) -- a Linux thread is the context.
    public const int PostHook = 0;
    public const int ContextHook = 0;
    public const int CompletedHook = 0;

    /// Memory committed as it is first touched: what every anonymous mapping
    /// here is already (MapsCommitLazily).
    public static nuint MapLazy(nuint bytes) => Map(bytes);

    /// Nothing to commit ahead: the kernel commits on touch, and never fails
    /// to (Gc.CommitCards).
    public static void Commit(nuint at, nuint bytes) { }
    public const int TaskArenaBytes = 0;

    /// A thread here is a thread: its block is its own, and what it runs
    /// keeps its words there (the bare-metal platform's hooks of these names).
    public const int ThreadStaticsHook = 0;
    public const int TypeInitOwnerHook = 0;
    public const int TypeInitWaitHook = 0;

    /// Free memory as the collector may ask it: with the heap held, so without
    /// allocating (SysinfoBytes answers into a page of the system's own).
    public static long FreeMemoryQuietly()
    {
        long available = MemAvailableBytes();
        return available > 0 ? available : SysinfoBytes(SysinfoFree) + SysinfoBytes(SysinfoBuffers);
    }

    /// MEMAVAILABLE, IN BYTES: what the kernel says can be had without
    /// swapping -- free memory and the page cache it would drop -- or 0 where
    /// it says nothing (a kernel before 3.14, no /proc). Free and buffers
    /// alone made a host whose memory sat in its cache look nearly full: a
    /// load near 100% (GC.GetGCMemoryInfo) and the collector paced as if
    /// there were no room. Read with the heap held, into a page of the
    /// system's own; a caller that finds another reading answers the last.
    static nuint _meminfoPage;
    static long _lastAvailable;
    const int MeminfoPath = 8;
    const int MeminfoText = 64;

    static long MemAvailableBytes()
    {
        nuint page = _meminfoPage;
        if (page == 0)
        {
            nuint made = Map(4096);
            if (made == 0) return 0;
            WriteText(made + MeminfoPath, "/proc/meminfo");
            if (Sys.Cas(Sys.AddressOf(ref _meminfoPage), 0, made) != 0) Unmap(made, 4096);
            page = _meminfoPage;
        }
        if (Sys.Cas32(page, 0, 1) != 0)
        {
            return _lastAvailable;
        }
        nuint text = page + MeminfoText;
        long got = ReadPath(page + MeminfoPath, text, 1024);
        nuint at = got > 0 ? LineAfter(text, (nuint)got, "MemAvailable:") : 0;
        long value = 0;
        if (at != 0)
        {
            nuint end = text + (nuint)got;
            while (at < end && Sys.Read8(at) == 32) at = at + 1;
            while (at < end && Sys.Read8(at) >= 48 && Sys.Read8(at) <= 57)
            {
                value = value * 10 + (Sys.Read8(at) - 48);
                at = at + 1;
            }
            value = value * 1024;
        }
        _lastAvailable = value;
        Sys.Write32(page, 0);
        return value;
    }

    /// How much address space a 32-bit process has: four gigabytes under a
    /// 64-bit kernel, three under a 32-bit one -- uname's machine, x86_64 or
    /// not. Asked once, at the heap's start, into a page of the system's own:
    /// nothing here allocates. Zero when uname says nothing.
    public static long AddressSpace()
    {
        nuint page = Map(4096);
        if (page == 0)
        {
            return 0;
        }
        long space = 0;
        if (Result(Sys.Syscall(LinuxCall.Uname, (SyscallWord)page, 0, 0)) == 0)
        {
            // struct utsname: six fields of 65 bytes; the machine is the fifth.
            nuint machine = page + 4 * 65;
            bool wide = Sys.Read8(machine) == 120 && Sys.Read8(machine + 1) == 56 && Sys.Read8(machine + 2) == 54
                     && Sys.Read8(machine + 3) == 95 && Sys.Read8(machine + 4) == 54 && Sys.Read8(machine + 5) == 52
                     && Sys.Read8(machine + 6) == 0;
            space = wide ? 4294967296 : 3221225472;
        }
        Unmap(page, 4096);
        return space;
    }

    // ---- a fault no program survives -----------------------------------------
    //
    // A SEGMENTATION FAULT SAYS WHERE IT WAS, as .NET's runtime has one say:
    // "Fatal error. System.AccessViolationException", the address and the
    // stack, on standard error (Runtime.ReportFault) -- and then the process
    // dies of the signal all the same: the default action, a core where one
    // is asked for, and 128 + the signal to whatever waits on it. Without
    // it a compile process of a project build died of one with nothing in
    // any log; only the kernel's ring buffer had a pid and an address.
    //
    // Armed once, as the first image begins, on a page of the system's own
    // that holds the kernel's sigaction, a signal set and the digits the
    // report spells numbers in: nothing here allocates, because the fault
    // may be in the allocator. The handler never returns, so it needs no
    // sigreturn trampoline; it puts the default action back itself rather
    // than trusting SA_RESETHAND to have, unblocks the signal and sends it
    // again, and ends the process outright if that did not.
    static nuint _faultPage;
    static long _faulting;
    static nuint _faultReturn;

    const int SignalBus = 7;
    const int SignalSegv = 11;

    public static void ArmFaultReport()
    {
        if (_faultPage != 0)
        {
            return;
        }
        nuint page = Map(4096);
        if (page == 0)
        {
            return;
        }
        _faultPage = page;
        // THE WAY BACK from a fault that becomes a NullReferenceException:
        // rt_sigreturn, seven bytes on a page of their own that may run, as
        // PosixSignalRegistration's restorer is.
        SyscallWord mapped = Sys.Syscall(LinuxCall.Mmap, 0, 4096, 7, 0x22, SyscallRegister.MinusOne, 0);
        nuint back = Err.Address(mapped);
        if (back != 0)
        {
#if SYSCALL64
            Sys.Write8(back, 0xB8);                                 // mov eax,
            Sys.Write8(back + 1, 15);                               //   15 (rt_sigreturn)
            Sys.Write8(back + 5, 0x0F);                             // syscall
            Sys.Write8(back + 6, 0x05);
#else
            Sys.Write8(back, 0xB8);                                 // mov eax,
            Sys.Write8(back + 1, 173);                              //   173 (rt_sigreturn)
            Sys.Write8(back + 5, 0xCD);                             // int 0x80
            Sys.Write8(back + 6, 0x80);
#endif
            _faultReturn = back;
        }
        // The kernel's sigaction: handler, flags, restorer, mask, a word
        // each but the mask. SA_SIGINFO for the address and the registers
        // (and the modern frame, the one rt_sigreturn returns through);
        // SA_RESTORER with the way back above; SA_NODEFER, so that a fault
        // in the program after a NullReferenceException is caught again.
        // A second fault inside the report finds _faulting set and ends the
        // process.
        nuint handler = Sys.AddressOf(Platform.Fault);
        Sys.WriteAddress(page, handler);
        Sys.WriteAddress(page + WordSize.Bytes, (nuint)(0x00000004 | 0x04000000 | 0x40000000));
        Sys.WriteAddress(page + 2 * WordSize.Bytes, _faultReturn != 0 ? _faultReturn : handler);
        Sys.Syscall(LinuxCall.RtSigaction, SignalSegv, (SyscallWord)page, 0, 8, 0, 0);
        Sys.Syscall(LinuxCall.RtSigaction, SignalBus, (SyscallWord)page, 0, 8, 0, 0);
    }

    /// The kernel's call on a fault: the signal, its siginfo and the
    /// interrupted context. Reports once, then dies of the signal.
    public static void Fault(int signal, nuint si, nuint uc)
    {
        // A NULL DEREFERENCE IS AN EXCEPTION, as it is in .NET: the thread is
        // sent on, when the handler returns, into Runtime.NullFault as if the
        // faulting instruction had called it -- its return address that
        // instruction, its arguments the frame and the instruction -- and it
        // throws NullReferenceException from there to whatever catches it.
        if (_faulting == 0 && signal == SignalSegv && si != 0 && uc != 0 && _faultReturn != 0)
        {
#if SYSCALL64
            nuint nullAt = Sys.ReadAddress(si + 16);
#else
            nuint nullAt = Sys.ReadAddress(si + 12);
#endif
            if (Runtime.NullFaultCatchable(nullAt))
            {
                nuint entry = Sys.AddressOf(Runtime.NullFault);
#if SYSCALL64
                // gregs from 40: RDI 8th, RSI 9th, RBP 10th, RSP 15th, RIP 16th.
                // Past the red zone, aligned as a call leaves it.
                // Each greg_t is 8 bytes here.
                // A leaf that gave RBP a value has its frame found by its
                // prologue (Runtime.FrameAt), and RBP made that frame again,
                // so NullFault's prologue links to it as a call from there would.
                nuint faultPc = Sys.ReadAddress(uc + 168);
                nuint faultFrame = Runtime.FrameAt(faultPc, Sys.ReadAddress(uc + 160), Sys.ReadAddress(uc + 120));
                Sys.WriteAddress(uc + 120, faultFrame);
                nuint sp = ((Sys.ReadAddress(uc + 160) - 128) & ~(nuint)15) - 8;
                Sys.WriteAddress(sp, faultPc);
                Sys.WriteAddress(uc + 104, faultFrame);
                Sys.WriteAddress(uc + 112, faultPc);
                Sys.WriteAddress(uc + 160, sp);
                Sys.WriteAddress(uc + 168, entry);
#else
                // gregs from 20: EBP 7th, ESP 8th, EIP 15th; the arguments
                // on the stack above the return address, each a word. Aligned
                // as a call leaves it: the return address at 12 past a
                // multiple of 16.
                // Each greg_t is 4 bytes here.
                // A leaf that gave EBP a value has its frame found by its
                // prologue (Runtime.FrameAt), and EBP made that frame again,
                // so NullFault's prologue links to it as a call from there would.
                nuint faultPc = Sys.ReadAddress(uc + 76);
                nuint faultFrame = Runtime.FrameAt(faultPc, Sys.ReadAddress(uc + 48), Sys.ReadAddress(uc + 44));
                Sys.WriteAddress(uc + 44, faultFrame);
                nuint sp = ((Sys.ReadAddress(uc + 48) - 64) & ~(nuint)15) - 20;
                Sys.WriteAddress(sp, faultPc);
                Sys.WriteAddress(sp + 4, faultFrame);
                Sys.WriteAddress(sp + 8, faultPc);
                Sys.WriteAddress(uc + 48, sp);
                Sys.WriteAddress(uc + 76, entry);
#endif
                return;
            }
        }
        if (_faulting == 0 && si != 0 && uc != 0)
        {
            _faulting = 1;
#if SYSCALL64
            // siginfo's si_addr at 16; mcontext's gregs from 40, RBP the
            // 10th and RIP the 16th.
            nuint address = Sys.ReadAddress(si + 16);
            nuint pc = Sys.ReadAddress(uc + 168);
            nuint frame = Runtime.FrameAt(pc, Sys.ReadAddress(uc + 160), Sys.ReadAddress(uc + 120));
            nuint registers = uc + 40;
            int count = 16;
#else
            // siginfo's si_addr at 12; mcontext's gregs from 20, EBP the
            // seventh and EIP the fifteenth.
            nuint address = Sys.ReadAddress(si + 12);
            nuint pc = Sys.ReadAddress(uc + 76);
            nuint frame = Runtime.FrameAt(pc, Sys.ReadAddress(uc + 48), Sys.ReadAddress(uc + 44));
            // EDI, ESI, EBP, ESP, EBX, EDX, ECX, EAX.
            nuint registers = uc + 36;
            int count = 8;
#endif
            Runtime.ReportFault(address, pc, frame, _faultPage + 256, registers, count);
        }
        // SIG_DFL, the signal unblocked (SIG_UNBLOCK, a set of one), and sent.
        nuint page = _faultPage;
        Sys.WriteAddress(page, 0);
        Sys.WriteAddress(page + WordSize.Bytes, 0);
        Sys.Syscall(LinuxCall.RtSigaction, (SyscallWord)signal, (SyscallWord)page, 0, 8, 0, 0);
        // The signal set is 64 bits, whatever the machine's word.
        Sys.Write64(page + 128, 0);
        Sys.Write8(page + 128 + (nuint)((signal - 1) / 8), (byte)(1 << ((signal - 1) % 8)));
        Sys.Syscall(LinuxCall.RtSigprocmask, 1, (SyscallWord)(page + 128), 0, 8, 0, 0);
        Sys.Syscall(LinuxCall.Kill, Sys.Syscall(LinuxCall.Getpid, 0, 0, 0, 0, 0, 0), (SyscallWord)signal, 0, 0, 0, 0);
        Sys.Syscall(LinuxCall.ExitGroup, (SyscallWord)(128 + signal), 0, 0, 0, 0, 0);
    }

    /// THE MEMORY THE PROCESS'S CONTROL GROUP MAY USE, or 0 when it has no
    /// limit that binds: what .NET reads to size its heap in a container, and
    /// what a machine's free memory does not show -- a process capped at 256
    /// MB on a server with 48 GB free would otherwise pace itself for 48.
    /// cgroup v2's memory.max, the smallest along the group's path, since a
    /// parent's limit binds its children ("max" is none); then, when v2 says
    /// none, v1's memory.limit_in_bytes, for a hybrid system whose memory
    /// controller is still on v1 beside a v2 line in /proc/self/cgroup. A
    /// limit at or above the machine's memory is no limit, and answers 0.
    ///
    /// READ ONCE AND KEPT: the collector asks as the heap starts (Gc.Start),
    /// before there is a heap or a second thread, and GC.GetGCMemoryInfo asks
    /// on every call. Raw calls into pages of the system's own, so nothing
    /// here allocates; one page is kept, holding the path of the binding
    /// group's usage file for CgroupUsage.
    public static long MemoryLimit()
    {
        if (_limitAsked == 0)
        {
            _limit = ReadMemoryLimit();
            long physical = SysinfoBytes(SysinfoTotal);
            if (physical != 0 && _limit >= physical) _limit = 0;
            _limitAsked = 1;
        }
        return _limit;
    }

    static long _limit;
    static long _limitAsked;

    /// The page CgroupUsage reads through: a lock word at 0, the number read
    /// at UsageDigits, the usage file's NUL-terminated path at UsagePath. 0
    /// when no group limits the process.
    static nuint _usagePage;
    const int UsageDigits = 64;
    const int UsagePath = 128;

    /// What the binding group says it uses now -- v2's memory.current, v1's
    /// memory.usage_in_bytes -- or -1 when there is no such group or the file
    /// says nothing. The page is shared, so a caller that finds another
    /// reading it answers what was read last rather than wait or read into it
    /// at the same time.
    static long CgroupUsage()
    {
        nuint page = _usagePage;
        if (page == 0)
        {
            return -1;
        }
        if (Sys.Cas32(page, 0, 1) != 0)
        {
            return _lastUsage - 1;
        }
        long got = ReadPath(page + UsagePath, page + UsageDigits, 32);
        long answer = got > 0 ? Digits(page + UsageDigits, (nuint)got) : -1;
        _lastUsage = answer + 1;
        Sys.Write32(page, 0);
        return answer;
    }

    /// The decimal number at `at`, or -1 for none.
    static long Digits(nuint at, nuint count)
    {
        long value = 0;
        bool any = false;
        for (nuint p = at; p < at + count; p++)
        {
            byte c = Sys.Read8(p);
            if (c < 48 || c > 57) break;
            value = value * 10 + (c - 48);
            any = true;
        }
        return any ? value : -1;
    }

    /// `text` and its NUL at `at`.
    static nuint WriteText(nuint at, string text)
    {
        for (int i = 0; i < text.Length; i++) { Sys.Write8(at, (byte)text[i]); at = at + 1; }
        Sys.Write8(at, 0);
        return at;
    }

    // What the last read said, plus one: a static here starts as zero, read
    // before any initialiser could run, so zero must mean "nothing read".
    static long _lastUsage;

    static long ReadMemoryLimit()
    {
        nuint page = Map(8192);
        if (page == 0)
        {
            return 0;
        }
        nuint text = page;           // /proc/self/cgroup
        nuint path = page + 4096;    // the file asked for, NUL-terminated
        long limit = 0;
        WriteText(path, "/proc/self/cgroup");
        long got = ReadPath(path, text, 4095);
        nuint end0 = got > 0 ? text + (nuint)got : text;
        nuint spare = end0 + 1;
        nuint room = page + 4096 - spare;
        nuint v2 = got > 0 ? LineAfter(text, (nuint)got, "0::") : 0;
        if (v2 != 0)
        {
            nuint end = v2;
            while (end < end0 && Sys.Read8(end) != 10) end = end + 1;
            // The group, then each parent up to the root, whose own file
            // does not exist (except as a namespace's root, which is "/").
            nuint binding = 0;
            while (end > v2)
            {
                long bytes = CgroupFile(path, v2, end, "/sys/fs/cgroup", "/memory.max", spare, room);
                if (bytes > 0 && (limit == 0 || bytes < limit)) { limit = bytes; binding = end; }
                end = end - 1;
                while (end > v2 && Sys.Read8(end) != 47) end = end - 1;
            }
            if (limit != 0) KeepUsagePath(v2, binding, "/sys/fs/cgroup", "/memory.current");
        }
        if (limit == 0 && got > 0)
        {
            nuint v1 = LineAfter(text, (nuint)got, ":memory:");
            if (v1 != 0)
            {
                nuint end = v1;
                while (end < end0 && Sys.Read8(end) != 10) end = end + 1;
                limit = CgroupFile(path, v1, end, "/sys/fs/cgroup/memory", "/memory.limit_in_bytes", spare, room);
                // v1 says "no limit" as a number near 2^63.
                if (limit >= 0x7FFFFFFFFFFFF000 / 2) limit = 0;
                if (limit != 0) KeepUsagePath(v1, end, "/sys/fs/cgroup/memory", "/memory.usage_in_bytes");
            }
        }
        Unmap(page, 8192);
        return limit;
    }

    /// The binding group's usage file, `root` + [from, to) + `leaf`, written
    /// into a page kept for CgroupUsage; nothing kept when no page is had.
    static void KeepUsagePath(nuint from, nuint to, string root, string leaf)
    {
        nuint page = Map(4096);
        if (page == 0)
        {
            return;
        }
        WritePath(page + UsagePath, from, to, root, leaf);
        _usagePage = page;
    }

    /// root, the bytes [from, to), leaf and a NUL at `at`, at most 3000.
    static void WritePath(nuint at, nuint from, nuint to, string root, string leaf)
    {
        nuint start = at;
        for (int i = 0; i < root.Length; i++) { Sys.Write8(at, (byte)root[i]); at = at + 1; }
        for (nuint p = from; p < to && at < start + 3000; p++) { Sys.Write8(at, Sys.Read8(p)); at = at + 1; }
        WriteText(at, leaf);
    }

    /// Reads the file named by `name` (built into `scratch`) into [into,
    /// into + most); answers the bytes read, or -1.
    static long ReadPath(nuint path, nuint into, nuint most)
    {
        int fd = (int)Err.Result(Sys.Syscall(LinuxCall.Open, (SyscallWord)path, 0, 0));
        if (fd < 0)
        {
            return -1;
        }
        nuint got = 0;
        while (got < most)
        {
            long n = Err.Result(Sys.Syscall(LinuxCall.Read, (SyscallWord)fd, (SyscallWord)(into + got), (SyscallWord)(most - got)));
            if (n <= 0) break;
            got = got + (nuint)n;
        }
        Sys.Syscall(LinuxCall.Close, (SyscallWord)fd, 0, 0);
        return (long)got;
    }

    /// Where the text after `key` begins, when a line of [text, text + count)
    /// starts with it (or, for a key starting with ':', contains it after the
    /// line's hierarchy number); -1 when none does.
    /// Just past `key` at a line's start -- or, for a key starting ':',
    /// after the line's first field -- or 0.
    static nuint LineAfter(nuint text, nuint count, string key)
    {
        nuint end = text + count;
        nuint line = text;
        while (line < end)
        {
            nuint at = line;
            if (key[0] == ':')
            {
                while (at < end && Sys.Read8(at) != 58 && Sys.Read8(at) != 10) at = at + 1;
            }
            int i = 0;
            while (i < key.Length && at + (nuint)i < end && Sys.Read8(at + (nuint)i) == key[i]) i = i + 1;
            if (i == key.Length)
            {
                return at + (nuint)i;
            }
            while (line < end && Sys.Read8(line) != 10) line = line + 1;
            line = line + 1;
        }
        return 0;
    }

    /// The number in `root` + [from, to) + `leaf`, or 0 for "max", for a
    /// file that is not there, or for one that says nothing a number.
    static long CgroupFile(nuint path, nuint from, nuint to, string root, string leaf, nuint buffer, nuint most)
    {
        WritePath(path, from, to, root, leaf);
        if (most < 32) return 0;
        long got = ReadPath(path, buffer, most > 64 ? 64 : most);
        long value = got > 0 ? Digits(buffer, (nuint)got) : -1;
        return value > 0 ? value : 0;
    }

    // struct sysinfo: the unsigned longs are words, so the offsets are the
    // word size's -- i386 and x86-64 lay it out alike, one word apart.
    const int SysinfoTotal = 4 * WordSize.Bytes;
    const int SysinfoFree = 5 * WordSize.Bytes;
    const int SysinfoBuffers = 7 * WordSize.Bytes;
#if SYSCALL64
    const int SysinfoUnit = 104;
#else
    const int SysinfoUnit = 52;
#endif

    // A PAGE OF THE SYSTEM'S, NOT A HEAP ARRAY: the collector reads the
    // machine's free memory as it sets the next collection's pace, holding
    // the heap, where a `new byte[]` would ask the heap for itself. Taken
    // once; two callers at once write the same figures into it.
    static nuint _sysinfo;

    static long SysinfoBytes(int field)
    {
        if (_sysinfo == 0)
        {
            _sysinfo = Map(4096);
            if (_sysinfo == 0) return 0;
        }
        if (Result(Sys.Syscall(LinuxCall.Sysinfo, (SyscallWord)_sysinfo, 0, 0)) < 0)
        {
            return 0;
        }
        long unit = Sys.Read32(_sysinfo + SysinfoUnit);
        // struct sysinfo's counts are `unsigned long`: a word, 4 bytes on i386.
        long count = (long)Sys.ReadAddress(_sysinfo + (nuint)field);
        return count * (unit == 0 ? 1 : unit);
    }

    // ---- what Monitor asks (core threading.cor) ----------------------------

    /// Who holds a lock: this thread, by its thread block (word-aligned, so
    /// bit 0 is free for Monitor's "somebody is asleep" mark).
    public static nuint MonitorOwner()
    {
        return Sys.ThreadBlock();
    }

    /// Sleeps while the lock word still reads `value`, as a blocking region:
    /// the collector does not wait for a thread asleep on a lock.
    public static void MonitorBlock(nuint at, int value)
    {
        Native.Wait(at, value);
    }

    public static void MonitorWake(nuint at)
    {
        Native.Wake(at, 1);
    }

    /// Stops this thread at a safepoint, with every callee-saved register on
    /// the stack. The system call is the same trick EnterCollection uses and
    /// for the same reason: a reference the caller left in EBX, ESI or EDI is
    /// invisible to a collector that reads memory unless a prologue pushed it,
    /// and the stack pointer written down inside GcThreads.SafePoint is below
    /// these pushes. See GcRoots in runtime/src/core/gc.cor.
    public static void SafePoint(int mode)
    {
        Sys.Syscall(LinuxCall.Getpid, 0, 0, 0, 0, 0, 0);
        GcThreads.Spill(mode, Sys.Stack(), Sys.FramePointer());
        GcThreads.SafePoint(mode);
    }

    /// Enters a collection with every callee-saved register on the stack.
    ///
    /// The system call below is the whole trick. The backend loads its
    /// arguments into EBX, ECX, EDX, ESI and EDI, so this function USES
    /// every callee-saved register and its prologue pushes them; the values
    /// the caller of Runtime.Alloc left in them are then on the stack, above
    /// the ESP that Gc.CollectInner scans from. getpid is the cheapest call
    /// with no effect. See GcRoots in runtime/src/core/gc.cor for the full reasoning.
    public static void EnterCollection()
    {
        Sys.Syscall(LinuxCall.Getpid, 0, 0, 0, 0, 0, 0);
        if (Runtime.CollectorLinked()) Gc.CollectInner();
    }

    /// A call into an object whose code was taken away (Gc.Revoke): a
    /// program has no modules to lose, so this is only ever a fault, and the
    /// process ends as a crash would end it.
    public static void Revoked()
    {
        Runtime.WriteLiteral(2, "a revoked object was called\n");
        Exit(134);
    }

    /// Ends the whole process. exit_group rather than exit, so that the day
    /// this runtime has threads, exiting means what a C program means by it.
    /// [DoesNotReturn], as .NET's own exit is, for C#'s null analysis: a
    /// method marked so that ends calling this one is not warned of (CS8763).
    [DoesNotReturn]
    public static void Exit(int code)
    {
        // Buffered console output reaches the terminal before the process
        // ends, as it does when a .NET Main returns. What to flush was left
        // with the runtime by whoever buffered it: this library is below the
        // class library and may not name Console.
        Runtime.AtExit();
        // And C's, when a C library is loaded: exit(3) flushes what printf
        // buffered and runs its atexit handlers and its libraries'
        // finalisers, then ends the process itself.
        nuint cExit = Runtime.NativeSymbol("exit");
        if (cExit != 0)
        {
            Runtime.CallC(cExit, (nuint)code, 0, 0, 0);
        }
        Sys.Syscall(LinuxCall.ExitGroup, (SyscallWord)code, 0, 0);
        // The kernel does not return from that; if it somehow did, the plain
        // exit is the next best thing, and after that there is nothing --
        // asked again for ever rather than returned from, so that this, and
        // Os.Exit and Environment.Exit over it, is proved never to return
        // and the code after a call to one is none (Binder.CallNeverReturns).
        while (true) Sys.Syscall(LinuxCall.Exit, (SyscallWord)code, 0, 0);
    }

    /// One write(2): how many bytes the kernel took, or -errno. The runtime
    /// loops on short writes and EINTR; this does not, so a caller that
    /// wants the raw answer can have it.
    public static long WriteBytes(int fd, nuint address, nuint count)
    {
        // Raw: this is also how the runtime says it cannot start, before
        // the thread has the block a blocking call is recorded in.
        return Err.Result(Sys.Syscall(LinuxCall.Write, (SyscallWord)fd, (SyscallWord)address, (SyscallWord)count));
    }

    /// THE 386'S ATOMICS ARE DONE UNDER ONE LOCK (Runtime.AtomicAdd386 and
    /// its kin). A process cannot turn interrupts off, and XCHG is the one
    /// read and write as one the 386 has: it takes the lock, the operation
    /// reads and writes under it, and a plain exchange gives it back. A
    /// thread finding it held yields to its holder, which on the 386's one
    /// processor can run only once this thread stops (Runtime.Atomics386).
    /// What Leave is handed.
    public static uint AtomicsEnter()
    {
        while (Sys.AtomicSwap32(Sys.AddressOf(ref Runtime.Atomics386), 1) != 0)
        {
            Yield();
        }
        return 0;
    }

    public static void AtomicsLeave(uint held)
    {
        Sys.AtomicSwap32(Sys.AddressOf(ref Runtime.Atomics386), 0);
    }

    /// A LOCK AN INTERRUPT HANDLER TAKES TOO, as bare metal has it: a
    /// process has no interrupts to turn off, so the word at `at` taken by
    /// exchange, a pause a turn, and the processor given up past a few --
    /// its holder, a few loads and stores from letting go, may have been
    /// put off it. Answers what Leave is handed.
    public static uint HandlerLockEnter(nuint at)
    {
        int turns = 0;
        while (Sys.AtomicSwap(at, 1) != 0)
        {
            turns = turns + 1;
            if (turns < 64) Sys.Pause();
            else Yield();
        }
        return 0;
    }

    public static void HandlerLockLeave(nuint at, uint held)
    {
        Sys.AtomicSwap(at, 0);
    }
}

/// The system API a program uses, as thin wrappers over the calls above.
///
/// NAMED AFTER os/lib/user.cor's Os so the utilities port. Where this file
/// diverges from user.cor, and why:
///
///   - Descriptors, counts and results are `int` where user.cor has `long`.
///     This machine's word is 32 bits and its arrays index by int; a long
///     here would be two registers for a number that never exceeds one.
///     Every raw-address form (Write/Read with an address and a count) keeps
///     `long` for the address, which is what an address is in the language.
///   - Object bytes are found with Sys.ArrayData, never by adding a header
///     size: user.cor's `Sys.Word(x) + 24` was the old machine's header.
///   - Paths are NUL-terminated on the way in. The CORSAC kernel took a
///     length-prefixed string; Linux takes C's, so Open copies the path
///     into a fresh block with a trailing zero.
///   - Errors are the negative errno, exactly as user.cor's are, and Result
///     above is why they come out negative at all.
///   - Args() is new: user.cor's Getarg read one argument string from the
///     kernel; Linux left argc and argv on the stack at entry.
static partial class Os
{
    static nuint _signalRestorer;

    /// The kernel's sigaction: handler, flags, restorer, mask (64 bits) --
    /// four words on x86-64, where the first three are eight bytes each.
    ///
    /// SA_RESTORER names the few bytes the kernel returns THROUGH when a
    /// handler finishes, and two things about them are easy to get wrong and
    /// fatal when they are:
    ///
    ///   THE CALL IS sigreturn(119), NOT rt_sigreturn(173). On i386 the
    ///   kernel builds the OLD signal frame for a handler registered without
    ///   SA_SIGINFO -- whichever call registered it -- and the two frames are
    ///   not the same shape. Returning through the wrong one restores a
    ///   context of rubbish: the program resumes at address zero and dies of
    ///   a fault nowhere near the signal. `pop %eax` first, as glibc's own
    ///   __restore does, because the legacy frame wants the signal number off
    ///   the stack before the sigcontext underneath it is read.
    ///
    ///   THE BYTES MUST BE EXECUTABLE. The heap is mapped read/write and
    ///   nothing else, so a thunk kept in an ordinary array is data the
    ///   processor refuses to run: a fault on the way out of every handler.
    ///   They live in a page of their own, mapped with PROT_EXEC.
    ///
    /// SA_RESTART keeps a read or a wait from failing with EINTR under a
    /// signal the program handles.
    /// The session the process is in (getsid(2)): what a named mutex not
    /// marked global is private to.
    public static long SessionId() => Platform.Result(Sys.Syscall(LinuxCall.Getsid, 0, 0, 0));

    public static void InstallSignal(int signal, nuint handler)
    {
        if (_signalRestorer == 0)
        {
            nuint page = Os.MapExecutable(4096);
            if (page == 0)
            {
                return;
            }
#if SYSCALL64
            // Long mode's: rt_sigreturn is 15 and is made with `syscall`. The
            // kernel refuses a handler without a restorer on this ABI.
            Sys.Write8(page, 0xB8);                                 // mov eax,
            Sys.Write8(page + 1, 15);                               //   15 (rt_sigreturn)
            Sys.Write8(page + 2, 0);
            Sys.Write8(page + 3, 0);
            Sys.Write8(page + 4, 0);
            Sys.Write8(page + 5, 0x0F);                             // syscall
            Sys.Write8(page + 6, 0x05);
#else
            Sys.Write8(page, 0xB8);                                 // mov eax,
            Sys.Write8(page + 1, 173);                              //   173 (rt_sigreturn)
            Sys.Write8(page + 2, 0);
            Sys.Write8(page + 3, 0);
            Sys.Write8(page + 4, 0);
            Sys.Write8(page + 5, 0xCD);                             // int
            Sys.Write8(page + 6, 0x80);                             //   0x80
#endif
            _signalRestorer = page;
        }
#if SYSCALL64
        // x86-64's kernel sigaction: handler, flags, restorer and mask, a
        // word each.
        byte[] act = new byte[32];
        Raw.SetWord(act, 0, handler);
#else
        byte[] act = new byte[20];
        Raw.SetWord(act, 0, handler);
#endif
        long flags = 0x04000000;                                      // SA_RESTORER
        if (handler > 1)
        {
            // SA_SIGINFO AS WELL AS SA_RESTART, and not for the extra
            // arguments: it is what makes the kernel build the MODERN signal
            // frame, the one rt_sigreturn above knows how to return through.
            // Without it i386 builds the old frame for a handler registered
            // through rt_sigaction, and returning through the wrong one
            // restores a context of rubbish.
            flags = flags | 0x10000000 | 0x00000004;                  // SA_RESTART|SA_SIGINFO
        }
#if SYSCALL64
        Raw.SetI64(act, 8, flags);
        Raw.SetWord(act, 16, _signalRestorer);
#else
        Raw.SetU32(act, 4, flags);
        Raw.SetWord(act, 8, _signalRestorer);
#endif
        Os.SigAction(signal, act);
    }

    [DoesNotReturn]
    public static void Exit(int code)
    {
        Platform.Exit(code);
    }

    /// The WHOLE string, however many calls that takes. A terminal, pipe or
    /// socket may honestly accept part of it; this keeps offering the rest,
    /// and retries an interrupted call, so text written this way arrives
    /// complete or not at all. Answers the length, or the error if nothing
    /// at all was written.
    public static int Write(int fd, string s)
    {
        byte[] bytes = Utf8Transcoder.Encode(s, 0, s.Length);
        nuint at = Sys.ArrayData(bytes);
        nuint done = 0;
        nuint length = (nuint)bytes.Length;

        while (done < length)
        {
            long n = Platform.WriteBytes(fd, at + done, length - done);

            if (n == 0 - Err.Intr)
            {
                continue;
            }
            if (n <= 0)
            {
                return done > 0 ? (int)done : (int)n;
            }
            done = done + (nuint)n;
        }
        return (int)done;
    }

    public static void Print(string s)
    {
        Write(Fd.Out, s);
    }

    /// A whole line in ONE write, so another process's output cannot land
    /// between the text and its newline.
    public static void Line(string s)
    {
        Write(Fd.Out, String.Concat(s, "\n"));
    }

    /// The address of envp as the kernel laid it on the entry stack: past
    /// argc, past argc pointers, past the null that ends them.
    /// System.Environment answers with this; execve needs it here, and the
    /// entry stack is this library's business rather than the class
    /// library's.
    /// THE MAIN THREAD'S ENTRY STACK, wherever this is asked: argc, argv and
    /// the environment are above it alone. Sys.EntryStack is the top of the
    /// stack of the thread asking, and a worker reading a flag -- the
    /// collector's exit report after running out of memory on one -- or the
    /// environment first walked its own stack as envp: it faulted, or found
    /// nothing and kept that for every thread.
    public static nuint MainEntryStack() => Sys.ReadAddress(Sys.MainThreadBlock() + Tls.StackBase);

    public static nuint EnvironAddress()
    {
        nuint sp = MainEntryStack();
        // argc is a word at the stack pointer, then argc+1 argv words, then envp.
        return sp + WordSize.Bytes + WordSize.Bytes * Sys.ReadAddress(sp) + WordSize.Bytes;
    }

    /// A VARIABLE OF THE ENVIRONMENT THE PROCESS STARTED WITH, as getenv(3)
    /// reads it, or null: what .NET's native layer reads where the runtime
    /// needs one -- a named mutex's temporary directory -- not
    /// System.Environment's, which a library above this one keeps and
    /// SetEnvironmentVariable changes.
    public static string? StartingVariable(string name)
    {
        nuint at = EnvironAddress();
        for (nuint entry = Sys.ReadAddress(at); entry != 0; at = at + WordSize.Bytes, entry = Sys.ReadAddress(at))
        {
            int i = 0;
            while (i < name.Length && Sys.Read8(entry + (nuint)i) == name[i]) i = i + 1;
            if (i == name.Length && Sys.Read8(entry + (nuint)i) == '=') return FromC(entry + (nuint)i + 1);
        }
        return null;
    }

    /// geteuid(2): who the process acts as, which Environment.UserName names.
    public static long EffectiveUserId() { return (uint)Sys.Syscall(LinuxCall.Geteuid, 0, 0, 0); }

    /// uname(2)'s nodename, or null when the call fails.
    public static string? NodeName()
    {
        byte[] names = new byte[65 * 6];                      // struct utsname: six fields of 65
        if (Platform.Result(Sys.Syscall(LinuxCall.Uname, (SyscallWord)Sys.ArrayData(names), 0, 0)) < 0) return null;
        int end = 65;
        while (end < 130 && names[end] != 0) end++;
        return Utf8Transcoder.Decode(names, 65, end - 65);
    }

    /// The kernel's version for Environment.OSVersion: Unix (4), and the
    /// leading numbers of uname(2)'s release; no service pack.
    public static int[] SystemVersion(out string servicePack)
    {
        servicePack = "";
        int[] made = new int[] { 4, 0, 0, 0, 0 };
        byte[] names = new byte[65 * 6];
        if (Platform.Result(Sys.Syscall(LinuxCall.Uname, (SyscallWord)Sys.ArrayData(names), 0, 0)) < 0) return made;
        int at = 130, field = 1;
        while (at < 195 && field < 5 && names[at] >= '0' && names[at] <= '9')
        {
            int n = 0;
            while (at < 195 && names[at] >= '0' && names[at] <= '9') { n = n * 10 + (names[at] - '0'); at++; }
            made[field++] = n;
            if (at < 195 && names[at] == '.') at++; else break;
        }
        return made;
    }

    public static int Chdir(string path)
    {
        byte[] c = CString(path);
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Chdir, (SyscallWord)Sys.ArrayData(c), 0, 0));
    }

    // ---- descriptors ------------------------------------------------------

    public static int Dup(int fd)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Dup, (SyscallWord)fd, 0, 0));
    }

    /// dup2(2): `to` becomes another name for `fd`, closing whatever it was.
    public static int Dup2(int fd, int to)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Dup2, (SyscallWord)fd, (SyscallWord)to, 0));
    }

    /// pipe(2). `pair` gets the read end at 0 and the write end at 1.
    public static int Pipe(int[] pair)
    {
        if (pair.Length < 2)
        {
            throw new IndexOutOfRangeException("a pipe needs two descriptors");
        }
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Pipe, (SyscallWord)Sys.ArrayData(pair), 0, 0));
    }

    /// sync(2): every dirty block to the disc.
    public static void Sync()
    {
        Sys.Syscall(LinuxCall.Sync, 0, 0, 0);
    }

    /// reboot(2) with Linux's two magic numbers and a command:
    /// 0x01234567 restart, 0x4321FEDC power off, 0xCDEF0123 halt.
    /// Does not return when it works; -errno when it does not.
    public static long Reboot(uint command)
    {
        return Platform.Result(Sys.Syscall(LinuxCall.Reboot, 0xFEE1DEAD, 672274793, command, 0, 0, 0));
    }

    // ---- waiting, randomness, signals ----------------------------------------

    /// fcntl(2)'s two commands a program actually needs: the descriptor's
    /// flags, and the same flags changed. O_NONBLOCK is what a server with
    /// more than one ear sets, and is what .NET spells Socket.Blocking.
    public static int Fcntl(int fd, int command, int argument)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Fcntl, (SyscallWord)fd, (SyscallWord)command, (SyscallWord)argument));
    }

    /// poll(2) on one descriptor: >0 when an event in `events` (1 read,
    /// 4 write, 8 error) is ready within `timeoutMs` (-1 forever), 0 on
    /// the timeout, -errno otherwise.
    public static int Poll(int fd, int events, int timeoutMs)
    {
        byte[] pfd = new byte[8];
        Raw.SetU32(pfd, 0, fd);
        pfd[4] = (byte)events;
        pfd[5] = (byte)(events >> 8);
        while (true)
        {
            long r = Platform.Result(Platform.Blocking(LinuxCall.Poll, (SyscallWord)Sys.ArrayData(pfd), 1, (SyscallWord)timeoutMs));
            if (r == -Err.Intr || PosixSignalRegistration.Pending)
            {
                // A signal arrived while waiting -- or just before, with
                // nothing blocked for it to interrupt: this is the quiet
                // moment at which the program's handlers run. The caller
                // sees the interruption and decides whether it still wants
                // to wait.
                PosixSignalRegistration.Deliver();
            }
            return (int)r;
        }
    }

    /// pause(2): asleep until a signal, whose handlers have run by the time
    /// this returns. Spelt poll(2) of nothing, for ever, which is the same
    /// wait on every kernel that has poll.
    public static void Pause()
    {
        if (!PosixSignalRegistration.Pending)
        {
            Platform.Result(Platform.Blocking(LinuxCall.Poll, 0, 0, SyscallRegister.MinusOne));
        }

        PosixSignalRegistration.Deliver();
    }

    /// poll(2) on several descriptors at once, each for the same `events`.
    /// `ready[i]` says which answered. The count of them, 0 on the timeout,
    /// -errno otherwise; a signal is delivered and reported as -EINTR.
    public static int PollMany(int[] fds, int count, int events, int timeoutMs, bool[] ready)
    {
        byte[] pfd = new byte[8 * count];

        for (int i = 0; i < count; i++)
        {
            Raw.SetU32(pfd, 8 * i, fds[i]);
            pfd[8 * i + 4] = (byte)events;
            pfd[8 * i + 5] = (byte)(events >> 8);
            ready[i] = false;
        }

        long r = Platform.Result(Platform.Blocking(LinuxCall.Poll, (SyscallWord)Sys.ArrayData(pfd), (SyscallWord)count, (SyscallWord)timeoutMs));

        if (r == -Err.Intr || PosixSignalRegistration.Pending)
        {
            PosixSignalRegistration.Deliver();
        }

        for (int i = 0; i < count && r > 0; i++)
        {
            ready[i] = (pfd[8 * i + 6] | pfd[8 * i + 7]) != 0;
        }

        return (int)r;
    }

    /// How many processors this process may run on: the bits of its
    /// sched_getaffinity(2) mask, which is what .NET's ProcessorCount counts.
    public static int ProcessorCount()
    {
        byte[] mask = new byte[128];
        long got = Platform.Result(Sys.Syscall(LinuxCall.SchedGetaffinity, 0, (SyscallWord)mask.Length, (SyscallWord)Sys.ArrayData(mask)));
        int count = 0;
        for (int i = 0; i < got && i < mask.Length; i++)
        {
            for (int bit = 0; bit < 8; bit++) if (((mask[i] >> bit) & 1) != 0) count++;
        }
        return count > 0 ? count : 1;
    }

    /// getrandom(2): bytes into the buffer, blocking until the pool is seeded.
    public static long GetRandom(byte[] buffer, int at, int count)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("getrandom range is outside its buffer");
        }
        return Platform.Result(Sys.Syscall(LinuxCall.GetRandom, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)at), (SyscallWord)count, 0));
    }

    /// rt_sigaction(2) with a 20-byte kernel sigaction (handler, flags,
    /// restorer, 64-bit mask) and no request for the old one.
    public static long SigAction(int signal, byte[] action)
    {
        return Platform.Result(Sys.Syscall(LinuxCall.RtSigaction, (SyscallWord)signal, (SyscallWord)Sys.ArrayData(action), 0, 8, 0, 0));
    }

    /// Bytes waiting to be read on `fd` (FIONREAD), or -errno.
    public static long Available(int fd)
    {
        byte[] n = new byte[4];
        long r = Ioctl(fd, 0x541B, Sys.ArrayData(n));
        return r < 0 ? r : Raw.U32(n, 0);
    }

    // ---- processes --------------------------------------------------------

    /// Pages the processor may EXECUTE, as well as read and write.
    ///
    /// THE HEAP IS NOT EXECUTABLE -- it is mapped PROT_READ|PROT_WRITE and
    /// nothing else, which is what keeps a buffer somebody overran from
    /// becoming a program. The one thing in this system that must be code at
    /// run time is the signal restorer: the six bytes the kernel returns
    /// THROUGH when a handler finishes. Those live here, and nothing else
    /// does.
    ///
    /// The address, or 0.
    public static nuint MapExecutable(nuint bytes)
    {
        // PROT_READ | PROT_WRITE | PROT_EXEC = 7; MAP_PRIVATE | MAP_ANONYMOUS.
        return Err.Address(Sys.Syscall(LinuxCall.Mmap, 0, (SyscallWord)bytes, 7, 0x22, SyscallRegister.MinusOne, 0));
    }

    /// fork(2): the child's pid here, 0 over there, -errno on failure.
    ///
    /// EVERYTHING the process has is duplicated, the heap included, so the
    /// child is running the same program with the same objects and neither
    /// side can see the other's writes afterwards. Nothing in this runtime
    /// needs to be told: there is one thread, and the collector's state is as
    /// valid in the copy as it was in the original.
    public static int Fork()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Fork, 0, 0, 0));
    }

    public static int Getpid()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Getpid, 0, 0, 0));
    }

    public static int Getppid()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Getppid, 0, 0, 0));
    }

    public static int Getuid()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Getuid, 0, 0, 0));
    }

    public static int Getgid()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Getgid, 0, 0, 0));
    }

    public static int Kill(int pid, int signal)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Kill, (SyscallWord)pid, (SyscallWord)signal, 0));
    }

    /// setpgid(2). A zero for either means "this process" and "its own pid",
    /// which is how a shell puts itself in a group of its own.
    public static int Setpgid(int pid, int group)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Setpgid, (SyscallWord)pid, (SyscallWord)group, 0));
    }

    /// getpgid(2); zero means this process.
    public static int Getpgid(int pid)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Getpgid, (SyscallWord)pid, 0, 0));
    }

    /// setsid(2): a new session, with no controlling terminal, this process
    /// leading it. Fails with -EPERM when this process already leads a group.
    public static int Setsid()
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Setsid, 0, 0, 0));
    }

    public static int Setuid(int uid)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Setuid, (SyscallWord)uid, 0, 0));
    }

    public static int Setgid(int gid)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Setgid, (SyscallWord)gid, 0, 0));
    }

    /// setgroups(2): the supplementary groups, as a block of 32-bit ids.
    public static int Setgroups(int[] groups, int count)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Setgroups, (SyscallWord)count, (SyscallWord)Sys.ArrayData(groups), 0));
    }

    /// umask(2): the bits taken OUT of every mode this process creates with.
    /// Answers the mask it replaced, and cannot fail.
    public static int Umask(int mask)
    {
        return (int)Sys.Syscall(LinuxCall.Umask, (SyscallWord)mask, 0, 0);
    }

    /// mount(2). `data` is the filing system's own options, the ones after
    /// -o that the kernel does not understand itself; null when there are
    /// none.
    public static int Mount(string source, string target, string type,
                            ulong flags, string? data)
    {
        byte[] from = CString(source);
        byte[] onto = CString(target);
        byte[] kind = CString(type);
        // Taken here, in the block the call is in: an address taken inside
        // the if would keep its array only to the if's end.
        byte[]? extra = data == null ? null : CString(data);
        nuint options = extra == null ? 0 : Sys.ArrayData(extra);
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Mount, (SyscallWord)Sys.ArrayData(from), (SyscallWord)Sys.ArrayData(onto),
                                                (SyscallWord)Sys.ArrayData(kind), (SyscallWord)flags, (SyscallWord)options, 0));
    }

    /// umount2(2). The flags are MNT_FORCE, MNT_DETACH and the rest.
    public static int Umount(string target, int flags)
    {
        byte[] c = CString(target);
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Umount2, (SyscallWord)Sys.ArrayData(c), (SyscallWord)flags, 0));
    }

    /// An array of C strings, then a null, as execve(2) wants it: the strings
    /// in `keep` so a collection during the build cannot free them, and their
    /// addresses in a block of words.
    ///
    /// The block is a byte[] rather than an int[] only because Raw writes
    /// words into byte[]; the kernel sees the same four bytes either way.
    private static byte[] Vector(string[] items, byte[][] keep, int at)
    {
        byte[] block = new byte[(items.Length + 1) * (int)WordSize.Bytes];

        for (int i = 0; i < items.Length; i++)
        {
            byte[] c = CString(items[i]);
            keep[at + i] = c;
            Raw.SetWord(block, i * (int)WordSize.Bytes, Sys.ArrayData(c));
        }
        Raw.SetWord(block, items.Length * (int)WordSize.Bytes, 0);
        return block;
    }

    /// execve(2). On success it does not return: this process becomes the
    /// named program. On failure it answers -errno, and the caller -- which in
    /// a forked child is usually about to exit -- learns why.
    ///
    /// A null environment means the one this process was started with, passed
    /// straight through by address rather than copied out and back.
    public static int Exec(string path, string[] argv, string[]? envp)
    {
        byte[] c = CString(path);
        int room = argv.Length + (envp == null ? 0 : envp.Length);
        byte[][] keep = new byte[room][];

        byte[] args = Vector(argv, keep, 0);
        nuint env;

        if (envp == null)
        {
            env = EnvironAddress();
        }
        else
        {
            byte[] block = Vector(envp, keep, argv.Length);
            env = Sys.ArrayData(block);
        }
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Execve, (SyscallWord)Sys.ArrayData(c), (SyscallWord)Sys.ArrayData(args), (SyscallWord)env));
    }

    /// The common shape: the program's own path as argv[0], the caller's
    /// environment, nothing else.
    public static int Exec(string path, string[] argv)
    {
        return Exec(path, argv, null);
    }

    /// EVERYTHING execve(2) AND chdir(2) ARE HANDED, MADE BEFORE A FORK. The
    /// child of a process with other threads has only the one that forked:
    /// a lock another held stays held there, and a collection waits on
    /// threads that are not there. So the child may not allocate: it calls
    /// ChdirPlanned, ExecPlanned and ExitNow, which are system calls on what
    /// this made. Without it, a native link's backends hung between fork and
    /// exec for good.
    public static ExecPlan PrepareExec(string path, string[] argv, string[]? envp, string? directory)
    {
        ExecPlan plan = new ExecPlan();
        int room = argv.Length + (envp == null ? 0 : envp.Length);
        plan.Keep = new byte[room][];
        plan.Path = CString(path);
        plan.Args = Vector(argv, plan.Keep, 0);
        if (envp == null)
        {
            plan.EnvAddress = EnvironAddress();
        }
        else
        {
            plan.Env = Vector(envp, plan.Keep, argv.Length);
            plan.EnvAddress = Sys.ArrayData(plan.Env);
        }
        if (directory != null && directory.Length > 0) plan.Directory = CString(directory);
        return plan;
    }

    /// chdir(2) to the plan's directory, if it has one; nothing allocated.
    public static int ChdirPlanned(ExecPlan plan)
    {
        if (plan.Directory == null) return 0;
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Chdir, (SyscallWord)Sys.ArrayData(plan.Directory), 0, 0));
    }

    /// execve(2) on the plan; nothing allocated. Returns only on failure.
    public static int ExecPlanned(ExecPlan plan)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Execve, (SyscallWord)Sys.ArrayData(plan.Path),
            (SyscallWord)Sys.ArrayData(plan.Args), (SyscallWord)plan.EnvAddress));
    }

    /// exit_group(2) at once: no handler, no flush -- a forked child's buffers
    /// are its parent's too.
    public static void ExitNow(int code)
    {
        Sys.Syscall(LinuxCall.ExitGroup, (SyscallWord)code, 0, 0);
    }

    /// waitpid(2). -1 for `pid` means any child. `status` gets the raw status
    /// word at index 0; Wait below reads it.
    public static int Waitpid(int pid, int[] status, int options)
    {
        if (status.Length < 1)
        {
            throw new IndexOutOfRangeException("waitpid needs somewhere for the status");
        }
#if SYSCALL64
        // wait4(2), the only form long mode has: no resource usage wanted.
        return (int)Platform.Result(Platform.Blocking(LinuxCall.Wait4, (SyscallWord)pid, (SyscallWord)Sys.ArrayData(status), (SyscallWord)options, 0, 0, 0));
#else
        return (int)Platform.Result(Platform.Blocking(LinuxCall.Waitpid, (SyscallWord)pid, (SyscallWord)Sys.ArrayData(status), (SyscallWord)options));
#endif
    }

    /// Waits for one child and answers the way a shell reports it: its exit
    /// code, or 128 + the signal that killed it, or -errno.
    public static int Wait(int pid)
    {
        int[] status = new int[1];
        int got = Waitpid(pid, status, 0);

        if (got < 0)
        {
            return got;
        }
        return WaitStatus.Result(status[0]);
    }

    // ---- time -------------------------------------------------------------

    /// Seconds since the epoch.
    public static long Time()
    {
        byte[] now = TimeSpec.Room();
        return ClockGetTime(ClockId.Realtime, now) < 0 ? 0 : TimeSpec.Seconds(now);
    }

    /// clock_gettime(2) into a timespec of TimeSpec.Bytes.
    public static int ClockGetTime(int clock, byte[] into)
    {
        TimeSpec.Check(into);
        return (int)Platform.Result(Sys.Syscall(LinuxCall.ClockGetTime, (SyscallWord)clock, (SyscallWord)Sys.ArrayData(into), 0));
    }

    public static int ClockGetRes(int clock, byte[] into)
    {
        TimeSpec.Check(into);
        return (int)Platform.Result(Sys.Syscall(LinuxCall.ClockGetRes, (SyscallWord)clock, (SyscallWord)Sys.ArrayData(into), 0));
    }

    /// A clock as ONE number of nanoseconds, which is what code that measures
    /// an interval actually wants. Monotonic nanoseconds fit in a long for
    /// 292 years, so there is no wrap to reason about.
    public static long Nanos(int clock)
    {
        byte[] t = TimeSpec.Room();

        if (ClockGetTime(clock, t) < 0)
        {
            return 0;
        }
        return TimeSpec.Seconds(t) * 1000000000 + TimeSpec.Nanos(t);
    }

    /// clock_nanosleep(2) on the monotonic clock, restarted when a signal interrupts it, so that asking to
    /// sleep for a second sleeps for a second.
    public static void Sleep(long nanoseconds)
    {
        byte[] want = TimeSpec.Room();
        byte[] left = TimeSpec.Room();

        TimeSpec.Set(want, nanoseconds / 1000000000, nanoseconds % 1000000000);

        while (true)
        {
            long r = Platform.Result(Platform.Blocking(LinuxCall.ClockNanosleep, ClockId.Monotonic, 0, (SyscallWord)Sys.ArrayData(want), (SyscallWord)Sys.ArrayData(left)));

            if (r != 0 - Err.Intr)
            {
                if (PosixSignalRegistration.Pending)
                {
                    PosixSignalRegistration.Deliver();
                }
                return;
            }

            // A signal arrived while asleep, which is as quiet a moment as
            // a program has: its handlers run now (as they do in Poll), and
            // then the rest of the sleep is slept.
            PosixSignalRegistration.Deliver();
            TimeSpec.Set(want, TimeSpec.Seconds(left), TimeSpec.Nanos(left));
        }
    }

    public static void SleepMillis(long millis)
    {
        Sleep(millis * 1000000);
    }

    public static void Yield()
    {
        Sys.Syscall(LinuxCall.Sched_Yield, 0, 0, 0);
    }

    // ---- the terminal -----------------------------------------------------

    /// Whether the descriptor is a terminal: TCGETS succeeds on one and
    /// answers -ENOTTY on anything else, which is exactly how isatty(3) is
    /// implemented and why there is no separate call for it.
    public static bool IsTty(int fd)
    {
        byte[] t = Termios.Room();
        return Ioctl(fd, Tio.GetAttributes, Sys.ArrayData(t)) >= 0;
    }

    public static long GetAttributes(int fd, byte[] into)
    {
        Termios.Check(into);
        return Ioctl(fd, Tio.GetAttributes, Sys.ArrayData(into));
    }

    /// The change takes effect at once. Tio.SetAttributesDrain is the form
    /// that waits for what is already queued to go out, which is what a
    /// program changing the speed of a line wants.
    public static long SetAttributes(int fd, byte[] from)
    {
        Termios.Check(from);
        return Ioctl(fd, Tio.SetAttributes, Sys.ArrayData(from));
    }

    /// Characters as they are typed, no echo: what a full-screen program does
    /// on the way in. Answers the previous settings so it can be undone.
    public static byte[]? RawMode(int fd)
    {
        byte[] was = Termios.Room();

        if (GetAttributes(fd, was) < 0)
        {
            return null;
        }

        byte[] now = Termios.Room();

        for (int i = 0; i < Termios.Bytes; i++)
        {
            now[i] = was[i];
        }

        Termios.SetLocal(now, Termios.Local(now) & ~(Termios.Canonical | Termios.Echo));
        Termios.SetChar(now, Termios.Min, 1);
        Termios.SetChar(now, Termios.Time, 0);

        if (SetAttributes(fd, now) < 0)
        {
            return null;
        }
        return was;
    }

    /// How wide and how tall the terminal is, as (columns << 16) | rows, or 0
    /// when the descriptor is not one.
    public static long WindowSize(int fd)
    {
        byte[] w = new byte[8];

        if (Ioctl(fd, Tio.WindowSize, Sys.ArrayData(w)) < 0)
        {
            return 0;
        }
        return ((long)Raw.U16(w, 2) << 16) | Raw.U16(w, 0);
    }

    // ---- memory -----------------------------------------------------------

    /// The raw answer: test it with Err.Failed and read the address with
    /// Err.Address, never by its sign (a mapping above 2 GB is negative).
    public static SyscallWord Mmap(nuint address, nuint length, int protection, int flags, int fd, long pages)
    {
        return Sys.Syscall(LinuxCall.Mmap, (SyscallWord)address, (SyscallWord)length, (SyscallWord)protection, (SyscallWord)flags, (SyscallWord)fd, (SyscallWord)(pages << LinuxCall.MmapOffsetShift));
    }

    public static int Munmap(nuint address, nuint length)
    {
        return (int)Platform.Result(Sys.Syscall(LinuxCall.Munmap, (SyscallWord)address, (SyscallWord)length, 0));
    }

    // ---- sockets ----------------------------------------------------------
    //
    // One system call per operation, as x86-64 has always had and i386 has
    // since Linux 4.3: no socketcall(2), which packed the arguments into a
    // block of words and is the multiplexer the kernel kept for its old
    // callers.

    private static long Sock(int call, SyscallWord a, SyscallWord b, SyscallWord c, SyscallWord d, SyscallWord e, SyscallWord f)
    {
        return Err.Result(Platform.Blocking(call, a, b, c, d, e, f));
    }

    public static int Socket(int family, int kind, int protocol)
    {
        return (int)Sock(LinuxCall.Socket, (SyscallWord)family, (SyscallWord)kind, (SyscallWord)protocol, 0, 0, 0);
    }

    public static int Bind(int fd, byte[] address)
    {
        return (int)Sock(LinuxCall.Bind, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(address), (SyscallWord)address.Length, 0, 0, 0);
    }

    public static int Listen(int fd, int backlog)
    {
        return (int)Sock(LinuxCall.Listen, (SyscallWord)fd, (SyscallWord)backlog, 0, 0, 0, 0);
    }

    /// accept(2), through accept4 with no flags where the direct calls exist:
    /// there is no separate accept system call on i386's modern numbering.
    /// `address` may be null when the caller does not care who connected.
    public static int Accept(int fd, byte[]? address)
    {
        if (address == null)
        {
            return (int)Sock(LinuxCall.Accept4, (SyscallWord)fd, 0, 0, 0, 0, 0);
        }

        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(LinuxCall.Accept4, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(address), (SyscallWord)Sys.ArrayData(length), 0, 0, 0);
    }

    public static int Connect(int fd, byte[] address)
    {
        return (int)Sock(LinuxCall.Connect, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(address), (SyscallWord)address.Length, 0, 0, 0);
    }

    public static int GetSockName(int fd, byte[] address)
    {
        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(LinuxCall.GetSockName, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(address), (SyscallWord)Sys.ArrayData(length), 0, 0, 0);
    }

    public static int GetPeerName(int fd, byte[] address)
    {
        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(LinuxCall.GetPeerName, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(address), (SyscallWord)Sys.ArrayData(length), 0, 0, 0);
    }

    /// send(2) is sendto(2) with no address, which is what the kernel makes of
    /// it too -- there is no separate send system call.
    public static int Send(int fd, byte[] buffer, int at, int count, int flags)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("send range is outside its buffer");
        }
        return (int)Sock(LinuxCall.SendTo, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)at), (SyscallWord)count, (SyscallWord)flags, 0, 0);
    }

    public static int Recv(int fd, byte[] buffer, int at, int count, int flags)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recv range is outside its buffer");
        }
        return (int)Sock(LinuxCall.RecvFrom, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)at), (SyscallWord)count, (SyscallWord)flags, 0, 0);
    }

    /// sendto(2) and recvfrom(2) with an address: a datagram's destination,
    /// and where one came from. `address` is a sockaddr the caller sized;
    /// recvfrom writes what it can of the sender's into it.
    public static int SendTo(int fd, byte[] buffer, int at, int count, int flags, byte[] address)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("sendto range is outside its buffer");
        }
        return (int)Sock(LinuxCall.SendTo, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)at), (SyscallWord)count, (SyscallWord)flags,
            (SyscallWord)Sys.ArrayData(address), (SyscallWord)address.Length);
    }

    public static int RecvFrom(int fd, byte[] buffer, int at, int count, int flags, byte[] address)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recvfrom range is outside its buffer");
        }
        byte[] length = new byte[4];
        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(LinuxCall.RecvFrom, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)at), (SyscallWord)count, (SyscallWord)flags,
            (SyscallWord)Sys.ArrayData(address), (SyscallWord)Sys.ArrayData(length));
    }

    /// recvmsg(2): a datagram AND WHAT THE KERNEL KNOWS ABOUT IT.
    ///
    /// THE CONTROL DATA IS THE WHOLE POINT. recvfrom answers the bytes and
    /// the sender and nothing else; there is no room in it for the things
    /// that are true of a packet rather than in it -- the time to live it
    /// arrived with, the ICMP error that came back instead of an answer.
    /// Those arrive here, as a list of `struct cmsghdr` in `control`, and
    /// a program that wants them has to ask for each with setsockopt first
    /// (IP_RECVTTL, IP_RECVERR) and walk them afterwards. Cmsg.Next is the
    /// walk.
    ///
    /// Returns the bytes received, or -errno; `controlBytes` is how much of
    /// `control` the kernel wrote.
    public static int RecvMsg(int fd, byte[] buffer, int at, int count, int flags,
        byte[]? address, byte[]? control, out int controlBytes)
    {
        controlBytes = 0;

        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recvmsg range is outside its buffer");
        }

#if SYSCALL64
        // The structures are the kernel's, laid out as x86-64 lays them out:
        // an iovec of two words, and a msghdr whose name length is an int
        // padded to the pointer after it and whose counts are words.
        byte[] iov = new byte[16];
        byte[] message = new byte[56];

        Raw.SetWord(iov, 0, Sys.ArrayData(buffer) + (nuint)at);
        Raw.SetI64(iov, 8, count);

        Raw.SetWord(message, 0, address == null ? 0 : Sys.ArrayData(address));
        Raw.SetU32(message, 8, address == null ? 0 : address.Length);
        Raw.SetWord(message, 16, Sys.ArrayData(iov));
        Raw.SetI64(message, 24, 1);
        Raw.SetWord(message, 32, control == null ? 0 : Sys.ArrayData(control));
        Raw.SetI64(message, 40, control == null ? 0 : control.Length);
        Raw.SetU32(message, 48, 0);

        int got = (int)Sock(LinuxCall.RecvMsg, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(message), (SyscallWord)flags, 0, 0, 0);

        if (got >= 0)
        {
            controlBytes = (int)Raw.I64(message, 40);
        }
#else
        // The structures are the kernel's, laid out as a 32-bit machine
        // lays them out: a msghdr of seven words, and an iovec of two.
        byte[] iov = new byte[8];
        byte[] message = new byte[28];

        Raw.SetWord(iov, 0, Sys.ArrayData(buffer) + (nuint)at);
        Raw.SetU32(iov, 4, count);

        Raw.SetWord(message, 0, address == null ? 0 : Sys.ArrayData(address));
        Raw.SetU32(message, 4, address == null ? 0 : address.Length);
        Raw.SetWord(message, 8, Sys.ArrayData(iov));
        Raw.SetU32(message, 12, 1);
        Raw.SetWord(message, 16, control == null ? 0 : Sys.ArrayData(control));
        Raw.SetU32(message, 20, control == null ? 0 : control.Length);
        Raw.SetU32(message, 24, 0);

        int got = (int)Sock(LinuxCall.RecvMsg, (SyscallWord)fd, (SyscallWord)Sys.ArrayData(message), (SyscallWord)flags, 0, 0, 0);

        if (got >= 0)
        {
            controlBytes = (int)Raw.U32(message, 20);
        }
#endif

        return got;
    }

    public static int SetSockOpt(int fd, int level, int option, byte[] value)
    {
        return (int)Sock(LinuxCall.SetSockOpt, (SyscallWord)fd, (SyscallWord)level, (SyscallWord)option, (SyscallWord)Sys.ArrayData(value), (SyscallWord)value.Length, 0);
    }

    /// The one every server needs: SO_REUSEADDR, so a restart does not have to
    /// wait out the previous socket's TIME_WAIT.
    public static int ReuseAddress(int fd)
    {
        byte[] one = new byte[4];

        Raw.SetU32(one, 0, 1);
        return SetSockOpt(fd, 1, 2, one);
    }

    public static int Shutdown(int fd, int how)
    {
        return (int)Sock(LinuxCall.Shutdown, (SyscallWord)fd, (SyscallWord)how, 0, 0, 0, 0);
    }

    // ---- the shapes os/lib/user.cor had ------------------------------------

    /// The old library's exit took the enum; a utility says
    /// Os.Exit(ExitCode.NoInput) and means 66.
    public static void Exit(ExitCode code)
    {
        Platform.Exit((int)code);
    }

    // ---- the command line -------------------------------------------------------
    //
    // At entry ESP pointed at argc, then argc pointers to NUL-terminated
    // strings, then a null, then the environment. The compiler saved that
    // ESP for us (Sys.EntryStack); this reads it once and keeps the result,
    // because the strings are the kernel's and copying them each time would
    // be a heap of identical arrays.

    static string[] _args;

    /// The length of a C string at `at`.
    private static int CLength(nuint at)
    {
        int n = 0;

        while (Sys.Read8(at + (nuint)n) != 0)
        {
            n = n + 1;
        }
        return n;
    }

    /// A COR-C# string from a C string: its bytes decoded as UTF-8.
    private static string FromC(nuint at)
    {
        return Utf8Transcoder.Decode(at, CLength(at));
    }

    /// A COR-C# string from a NUL-terminated C string at an address. Public
    /// because Env reads the kernel's environment block, which is C strings
    /// and nothing else.
    public static string StringAt(nuint at)
    {
        return FromC(at);
    }

    /// argv, including the program's own name at index 0, as the C
    /// convention has it. Main's `string[] args` in C# leaves the name out;
    /// a caller that wants that shape takes it from index 1.
    public static string[] Args()
    {
        string[] have = _args;

        if (have != null)
        {
            return have;
        }

        // The main thread's entry stack is ESP exactly as the kernel handed
        // it over, before _start's own prologue: argc at [sp], then argv.
        nuint sp = MainEntryStack();
        int argc = (int)Sys.ReadAddress(sp);

        if (argc < 0)
        {
            argc = 0;
        }

        string[] args = new string[argc];

        for (int i = 0; i < argc; i++)
        {
            args[i] = FromC(Sys.ReadAddress(sp + WordSize.Bytes + (nuint)(WordSize.Bytes * i)));
        }
        _args = args;
        return args;
    }

    // ---- standard input, a line at a time -----------------------------------------

    static byte[] _readAhead;      // bytes read and not yet handed out
    static int _readAheadAt;
    static int _readAheadCount;
    static bool _ended;
    static bool _afterReturn;      // the last line ended at a '\r'

    const int ReadAheadBytes = 1024;

    /// Whether standard input has ended. Set by the read that found it.
    public static bool AtEnd()
    {
        return _ended;
    }

    /// A line from standard input without its line end, or null when the
    /// input is finished and there is nothing left. The last line of a file
    /// with no line end is a line.
    ///
    /// A LINE ENDS AT "\n", "\r" OR "\r\n", each once, as .NET's ReadLine
    /// has it -- so a "\r" ends a line even when the "\n" that follows it
    /// arrives in the next read. The line's bytes are UTF-8 and are decoded
    /// as a whole, since one character may be several of them.
    ///
    /// Reads in blocks and keeps the tail, because a pipe or a file gives
    /// several lines per read and a byte-at-a-time read is a system call
    /// per character.
    public static string? ReadLine()
    {
        byte[] line = new byte[64];
        int length = 0;
        bool any = false;

        while (true)
        {
            if (_readAheadAt >= _readAheadCount)
            {
                if (_ended)
                {
                    return any ? Utf8Transcoder.Decode(line, 0, length) : null;
                }

                byte[] buffer = _readAhead;

                if (buffer == null)
                {
                    buffer = new byte[ReadAheadBytes];
                    _readAhead = buffer;
                }

                long got = Read(Fd.In, Sys.ArrayData(buffer), ReadAheadBytes);

                if (got == 0 - Err.Intr)
                {
                    continue;
                }
                if (got <= 0)
                {
                    _ended = true;
                    return any ? Utf8Transcoder.Decode(line, 0, length) : null;
                }
                _readAheadAt = 0;
                _readAheadCount = (int)got;
            }

            int ch = _readAhead[_readAheadAt];
            _readAheadAt = _readAheadAt + 1;

            if (_afterReturn)
            {
                _afterReturn = false;
                if (ch == 10)
                {
                    continue;
                }
            }
            any = true;

            if (ch == 10)
            {
                return Utf8Transcoder.Decode(line, 0, length);
            }
            if (ch == 13)
            {
                _afterReturn = true;
                return Utf8Transcoder.Decode(line, 0, length);
            }
            if (length == line.Length)
            {
                byte[] wider = new byte[line.Length * 2];
                Sys.Copy(wider, 0, line, 0, length);
                line = wider;
            }
            line[length] = (byte)ch;
            length = length + 1;
        }
    }
}

/// The status word waitpid(2) writes, and what it means. The encoding is the
/// kernel's and has been since v6: the low byte says how it ended.
static class WaitStatus
{
    public const int NoHang = 1;        // WNOHANG
    public const int Untraced = 2;      // WUNTRACED

    /// Whether the child ran to its own end rather than being killed.
    public static bool Exited(int status)
    {
        return (status & 0x7F) == 0;
    }

    /// What it returned from Main, meaningful only when Exited.
    public static int Code(int status)
    {
        return (status >> 8) & 0xFF;
    }

    public static bool Signalled(int status)
    {
        return (status & 0x7F) != 0 && (status & 0x7F) != 0x7F;
    }

    /// Which signal killed it, or 0.
    public static int Signal(int status)
    {
        return status & 0x7F;
    }

    public static bool Stopped(int status)
    {
        return (status & 0xFF) == 0x7F;
    }

    /// A shell's one number for how a child ended: its exit code, or
    /// 128 + the signal. Every Unix shell reports it this way and every
    /// script that tests $? expects it.
    public static int Result(int status)
    {
        if (Exited(status))
        {
            return Code(status);
        }
        return 128 + Signal(status);
    }
}

enum ExitCode
{
    Success = 0,
    Failure = 1,

    Usage = 64,             // the command was used incorrectly
    DataErr = 65,           // the input was wrong
    NoInput = 66,           // an input file was missing or unreadable
    NoUser = 67,            // no such user
    NoHost = 68,            // no such host
    Unavailable = 69,       // a service is not available
    Software = 70,          // an internal error: the program's own fault
    OsErr = 71,             // the operating system said no
    OsFile = 72,            // a system file is missing or wrong
    CantCreate = 73,        // an output file could not be made
    IoErr = 74,             // an error while reading or writing
    TempFail = 75,          // try again later
    Protocol = 76,          // the other end did not follow the protocol
    NoPerm = 77,            // not permitted, and not a file-permission problem
    Config = 78,            // something is misconfigured

    NotExecutable = 126,
    NotFound = 127,
    Signalled = 128,        // a BASE: add the signal, so an interrupt is 130
}

/// What a forked child hands execve(2) and chdir(2), made before the fork (Os.PrepareExec).
sealed class ExecPlan
{
    public byte[] Path = null!;
    public byte[] Args = null!;
    public byte[][] Keep = null!;
    public byte[]? Env;
    public nuint EnvAddress;
    public byte[]? Directory;
}
