// The Linux system-call library: the ONLY file that knows the program is a
// Linux process, i386 or x86-64.
//
// Everything here is a system call through Sys.Syscall, the one intrinsic the
// compiler provides for reaching the kernel (docs/software/X86-BACKEND.md,
// "Linux is a target, not a model"): `int 0x80` with the number in EAX and
// the arguments in EBX, ECX, EDX, ESI, EDI, EBP on i386, `syscall` with them
// in RAX and RDI, RSI, RDX, R10, R8, R9 in long mode. The backend does that;
// this file only says which number and what to pass, and where the two ABIs
// ask for different shapes it says so under TARGET_AMD64.
//
//   corc compile lib/std.cor lib/rt/runtime.cor lib/sys/linux.cor program.cor -o program
//
// Two layers live here:
//
//   Platform   what lib/rt/runtime.cor needs from an operating system:
//              memory, exit, and writing bytes. The runtime calls nothing
//              else in this file.
//   Os, Console, Fd, O, Err, Call
//              the beginnings of the API a program written for this system
//              uses, as thin wrappers, named after os/lib/user.cor's so the
//              OS's own utilities port with the fewest edits.
//
// THE ONE FACT ABOUT THE KERNEL'S ANSWERS. A Linux system call returns its
// result in EAX, and an error is a SMALL NEGATIVE number: -errno, in
// -4095..-1. Sys.Syscall hands that 32-bit register back zero-extended into a
// long, so -2 arrives as 4294967294. Result() below turns that range, and
// only that range, back into the negative number it is; an address above
// 2 GB (which brk can legitimately return) stays positive.

/// Which socket operation, when they go through socketcall(2). The numbers
/// are the kernel's SYS_SOCKET family from linux/net.h and have nothing to do
/// with the system-call numbers (Call, abi.cor).
static class SockCall
{
    public const long Socket = 1;
    public const long Bind = 2;
    public const long Connect = 3;
    public const long Listen = 4;
    public const long Accept = 5;
    public const long GetSockName = 6;
    public const long GetPeerName = 7;
    public const long SocketPair = 8;
    public const long Send = 9;
    public const long Recv = 10;
    public const long SendTo = 11;
    public const long RecvFrom = 12;
    public const long Shutdown = 13;
    public const long SetSockOpt = 14;
    public const long GetSockOpt = 15;
    public const long SendMsg = 16;
    public const long RecvMsg = 17;
    public const long Accept4 = 18;
}

/// The control messages recvmsg(2) answers with: a list of headers, each
/// four words of its own length, a level and a type, then the data, and
/// each one starting on a word boundary whatever the last one's length was.
///
/// A PROGRAM MUST WALK THIS AND MUST NOT INDEX IT. The kernel writes as
/// many as it has to say and in whatever order it likes, and a program that
/// assumes the one it asked for is the first one works until the day
/// somebody turns on a second option.
static class Cmsg
{
    // struct cmsghdr: a size_t length, then two ints, padded to a word.
#if TARGET_64BIT
    public const int HeaderBytes = 16;
    const int LevelAt = 8;
    const int Align = 7;
#else
    public const int HeaderBytes = 12;
    const int LevelAt = 4;
    const int Align = 3;
#endif

    // The levels and types a program on this machine actually reads.
    public const int LevelIp = 0;               // SOL_IP
    public const int TimeToLive = 2;            // IP_TTL, with IP_RECVTTL set
    public const int Error = 11;                // IP_RECVERR's answer

    /// Where the first header is, or -1 when there is none.
    public static int First(int controlBytes)
    {
        return controlBytes >= HeaderBytes ? 0 : -1;
    }

    /// Where the header after the one at `at` is, or -1.
    public static int Next(byte[] control, int controlBytes, int at)
    {
        long length = Length(control, at);

        if (length < HeaderBytes)
        {
            return -1;
        }

        int next = at + (int)((length + Align) & ~Align);
        return next + HeaderBytes <= controlBytes ? next : -1;
    }

    public static long Length(byte[] control, int at)
    {
        return Raw.Word(control, at);
    }

    public static int Level(byte[] control, int at)
    {
        return (int)Raw.I32(control, at + LevelAt);
    }

    public static int Type(byte[] control, int at)
    {
        return (int)Raw.I32(control, at + LevelAt + 4);
    }

    /// Where this header's data starts.
    public static int Data(int at)
    {
        return at + HeaderBytes;
    }
}

/// What lib/rt/runtime.cor and lib/rt/gc.cor ask of the operating system,
/// and nothing else. The heap is the caller of Map, so NOTHING in this
/// class may allocate: no `new`, no arrays, no strings built at run time.
/// A string LITERAL is data the compiler laid out, and is fine.
static class Platform
{
    // Sys.Syscall answers the 32-bit EAX zero-extended. -errno lives in
    // the top 4095 values of the unsigned range; nothing else does.
    public static long Result(long raw)
    {
        return Err.Result(raw);
    }

    /// A call that may wait -- a read of a pipe, a terminal or a socket, a
    /// poll, a wait for a child, a sleep -- made as a blocking one to the
    /// collector, as Native.Wait makes a futex wait. A thread parked in the
    /// kernel that the collector counted as running is waited for by the
    /// first collection another thread starts, for ever: lsass's accept(2)
    /// held every other thread of it so until its callers made their waits
    /// this way. The stack is read where it stands meanwhile; the words the
    /// call was handed are on it, and they keep what they point into.
    /// Answers the kernel's raw number, as Sys.Syscall does.
    public static long Blocking(long n, long a, long b, long c, long d = 0, long e = 0, long f = 0)
    {
        Runtime.BeginBlocking();
        long raw = Sys.Syscall(n, a, b, c, d, e, f);
        Runtime.EndBlocking();
        return raw;
    }

    /// Whether the process was started with CORSAC_VERIFY_FREES set to
    /// anything but 0: the collector's checked mode for the compiler's frees
    /// (Gc.VerifyFree). Read straight from the environment on the entry
    /// stack, with nothing allocated -- so only on the MAIN thread, whose
    /// entry stack is the loader's (the collector asks once, as it starts).
    /// CORSAC_GC_VERIFY=1: the collector checks, after each minor cycle's
    /// mark, that no old object points at a young one it is about to sweep.
    public static bool VerifyGenerations() => EnvironmentFlag("CORSAC_GC_VERIFY=");

    /// CORSAC_GC_CENSUS=1: every whole collection counts what it found live,
    /// by type, and says the largest on standard error.
    /// Read once: the collector asks at every collection, and by then a
    /// program may have made its environment something else (csrss did, and
    /// the collector read freed memory for it).
    public static bool GcCensus()
    {
        if (_censusAsked == 0) _censusAsked = EnvironmentFlag("CORSAC_GC_CENSUS=") ? 2 : 1;
        return _censusAsked == 2;
    }

    static int _censusAsked;

    /// CORSAC_GC_CENSUS=2: the census also counts what every sweep found dead.
    public static bool GcDeadCensus() => EnvironmentByte("CORSAC_GC_CENSUS=") == '2';

    /// CORSAC_GC_THRESHOLD=<bytes>: collect at least that often, whatever the
    /// pacing says -- every call site a collection may fall under, tried.
    public static long GcThreshold()
    {
        if (!_thresholdAsked) { _threshold = EnvironmentNumber("CORSAC_GC_THRESHOLD="); _thresholdAsked = true; }
        return _threshold;
    }

    static bool _thresholdAsked;
    static long _threshold;

    /// CORSAC_GC_NURSERY=<bytes>: allocate that much between minor cycles,
    /// whatever the pacing says -- for measuring what a nursery's size costs.
    public static long GcNursery() => EnvironmentNumber("CORSAC_GC_NURSERY=");

    /// Each thread's region arena (Gc, "regions"): four megabytes of address
    /// space, mapped when the thread first opens a region and touched only
    /// as far as regions reach.
    public static long RegionBytes()
    {
        return 4L * 1024 * 1024;
    }

    /// CORSAC_HEAP_LIMIT=<bytes>: the heap's hard limit, as a container's
    /// memory.max would set it -- for trying a small machine on a big one.
    public static long HeapLimit() => EnvironmentNumber("CORSAC_HEAP_LIMIT=");

    /// CORSAC_ALLOC_SAMPLE=1: where the allocations come from, sampled and
    /// printed as the process ends (AllocSamples).
    public static bool AllocSample() => EnvironmentFlag("CORSAC_ALLOC_SAMPLE=");

    /// CORSAC_GC_STATS=1: the collector's counts, pauses and heap said at exit.
    public static bool GcStats() => EnvironmentFlag("CORSAC_GC_STATS=");

    /// CORSAC_HEAP_CHECK=1: the heap's structure checked as every collection
    /// begins and ends -- every chunk's chain, every buffer's, and the free
    /// lists against what the walks found -- and the first faults said.
    public static bool HeapCheck() => EnvironmentFlag("CORSAC_HEAP_CHECK=");

    public static bool VerifyFrees() => EnvironmentFlag("CORSAC_VERIFY_FREES=") && EnvironmentByte("CORSAC_VERIFY_FREES=") != 'f';

    /// CORSAC_VERIFY_FREES=f: only the fields freed with their owner
    /// (Runtime.FreeField) are checked -- poisoned, kept, their free recorded
    /// -- and every other free gives its block back as usual, so the heap is
    /// reused the way an unchecked run reuses it.
    public static bool VerifyFieldFrees() => EnvironmentByte("CORSAC_VERIFY_FREES=") == 'f';

    /// CORSAC_FREE_LOG=1: every field free the compiler wrote is recorded in a
    /// ring (Runtime.FreeLog), for a debugger or a scan of the process to
    /// find the free that took an object still in use.
    public static bool FreeLog() => EnvironmentFlag("CORSAC_FREE_LOG=");

    /// CORSAC_GUARD_RELEASES=1: a chunk the heap releases is made
    /// inaccessible instead of unmapped (Guard), and a dedicated one released
    /// by a free says who freed it: a stale reference to what was in it
    /// faults at its first use, in the fault report's stack.
    public static bool GuardReleases() => EnvironmentFlag("CORSAC_GUARD_RELEASES=");

    /// CORSAC_IGNORE_FREES: which frees the compiler wrote are ignored, the
    /// collector finding that garbage instead. What it is for is telling a
    /// fault that a free makes from one the collector makes, and then which
    /// kind of free: 1 (or anything else) all of them; p the plain frees at
    /// a last use (Runtime.Free); f the fields freed with their owner
    /// (Runtime.FreeField); r what an owned variable held before it was
    /// assigned (Runtime.FreeReplaced); s the storage a collection made in a
    /// frame gives back (Runtime.FreeStorageInFrame). 0, or unset, none.
    public static long IgnoreFrees()
    {
        long first = EnvironmentByte("CORSAC_IGNORE_FREES=");
        return first == 48 ? 0 : first;
    }

    /// CORSAC_FREE_PATHS: the ways a free gives a block back that are
    /// skipped, the block left to the collector instead -- a diagnostic, for
    /// finding which of them corrupts. Letters: t the top of the thread's own
    /// buffer, i a block freed in place in another thread's buffer, b the
    /// bump pointer's top, d a dedicated chunk released, m a block merged
    /// into the free lists. As a mask: t 1, i 2, b 4, d 8, m 16. And p 32:
    /// every block freed is filled with the checked mode's pattern before it
    /// goes back -- the two paths that hand the bytes straight back to the
    /// bump pointer (t, b) skipped -- so a read after a free and before the
    /// reuse faults on the pattern, and a fault that does not is the heap's.
    /// And P 64: every run of dead blocks a sweep gives back is filled with
    /// the pattern too, so an object swept while something still used it --
    /// a root the stack maps missed -- is read as the pattern at once.
    public static long SkippedFreePaths()
    {
        long at = EnvironmentValue("CORSAC_FREE_PATHS=");
        long mask = 0;
        while (at != 0 && Sys.PeekByte(at) != 0)
        {
            long c = Sys.PeekByte(at);
            mask = mask | (c == 't' ? 1 : c == 'i' ? 2 : c == 'b' ? 4 : c == 'd' ? 8 : c == 'm' ? 16 : c == 'p' ? 32 : c == 'P' ? 64 : 0);
            at = at + 1;
        }
        return mask;
    }

    /// `key` (ending in '=') read from the environment as a decimal number,
    /// or 0 when it is not set.
    static long EnvironmentNumber(string key)
    {
        long at = EnvironmentValue(key);
        long value = 0;
        while (at != 0 && Sys.PeekByte(at) >= 48 && Sys.PeekByte(at) <= 57)
        {
            value = value * 10 + Sys.PeekByte(at) - 48;
            at = at + 1;
        }
        return value;
    }

    /// Whether `key` (ending in '=') is set in the environment to something
    /// other than nothing or 0, read from the loader's stack.
    static bool EnvironmentFlag(string key)
    {
        long first = EnvironmentByte(key);
        return first != 0 && first != 48;
    }

    /// The first byte of `key`'s value (`key` ends in '='), or 0 when it is
    /// unset or empty.
    static long EnvironmentByte(string key)
    {
        long at = EnvironmentValue(key);
        return at == 0 ? 0 : Sys.PeekByte(at);
    }

    /// Where `key`'s value begins in the environment, or 0 when it is unset.
    static long EnvironmentValue(string key)
    {
        long env = Os.EnvironAddress();
        while (true)
        {
            long text = Sys.Peek(env) & WordSize.AddressMask;
            if (text == 0)
            {
                return 0;
            }
            int i = 0;
            while (i < key.Length && Sys.PeekByte(text + i) == key[i])
            {
                i = i + 1;
            }
            if (i == key.Length)
            {
                return text + i;
            }
            env = env + WordSize.Bytes;
        }
    }

    /// The address the kernel is to be handed for `at`: a Linux process's
    /// memory is flat, so the same one.
    public static long Linear(long at)
    {
        return at;
    }

    /// Fresh, zeroed, page-aligned memory of `bytes`, or 0.
    ///
    /// mmap2 of anonymous private pages: the kernel zeroes every page it
    /// hands over, which is the promise the heap's bump allocation relies
    /// on, and each call is a chunk of its own, which is what the heap's
    /// chunk list expects. mmap2 rather than mmap because the i386 ABI's
    /// six-argument form is mmap2 (the offset is in pages) and the old
    /// mmap takes its arguments in a structure.
    /// A label and a number on standard error, allocating nothing: for the
    /// allocator's own paths, where a `new` would recurse.
    static long _traceDigits;

    public static void Trace(string label, long value)
    {
        if (_traceDigits == 0)
        {
            long got = Sys.Syscall(Call.Mmap, 0, 4096, 3, 0x22, 0 - 1, 0);
            _traceDigits = Result(got) > 0 ? Result(got) : 0 - 1;
        }

        Runtime.WriteLiteral(2, label);

        if (_traceDigits > 0)
        {
            long n = value < 0 ? 0 - value : value;
            long at = 24;

            if (n == 0)
            {
                at = at - 1;
                Sys.PokeByte(_traceDigits + at, 48);
            }

            while (n > 0 && at > 1)
            {
                at = at - 1;
                Sys.PokeByte(_traceDigits + at, 48 + n % 10);
                n = n / 10;
            }

            if (value < 0)
            {
                at = at - 1;
                Sys.PokeByte(_traceDigits + at, 45);
            }

            WriteBytes(2, _traceDigits + at, 24 - at);
        }

        Runtime.WriteLiteral(2, "\n");
    }

    /// Memory given back to the kernel: munmap(2). What the collector does
    /// with a chunk it has emptied.
    public static void Unmap(long at, long bytes)
    {
        Sys.Syscall(Call.Munmap, at, bytes, 0);
    }

    /// Memory made unreadable and unwritable and its address kept: a fresh
    /// PROT_NONE mapping over it. What a released chunk becomes under CORSAC_GUARD_RELEASES,
    /// so that its address is never handed out again and the first use of it
    /// faults where it happens.
    public static void Guard(long at, long bytes)
    {
        // Mapped over, not protected: MAP_FIXED | MAP_NORESERVE with
        // PROT_NONE keeps the addresses reserved and gives the pages back.
        // Protected, every guarded chunk stayed resident, and a build ran
        // the machine out of memory.
        Sys.Syscall(Call.Mmap, at, bytes, 0, 0x22 | 0x10 | 0x4000, 0 - 1, 0);
    }

    /// The processor given up to whatever else is ready (sched_yield): a
    /// thread spinning for a lock lets its holder run (GcLock.Enter).
    public static void Yield()
    {
        Sys.Syscall(Call.Sched_Yield, 0, 0, 0);
    }

    /// A file mapped whole, read-only and private: its pages the page
    /// cache's, shared by every process that maps it and given back under
    /// pressure like any cached page. The address, and its length in
    /// `length`; 0 when it cannot be mapped (the caller reads it instead).
    public static long MapReadOnly(string path, out long length)
    {
        length = 0;
        int fd = Os.Open(path, 0);                          // O_RDONLY
        if (fd < 0) return 0;
        long size = Os.SizeOf(fd);
        long at = 0;
        if (size > 0 && size < 0x10000000)
        {
            // PROT_READ = 1, MAP_PRIVATE = 2.
            long got = Sys.Syscall(Call.Mmap, 0, size, 1, 2, fd, 0);
            if (Result(got) > 0) { at = Result(got); length = size; }
        }
        Os.Close(fd);
        return at;
    }

    public static long Map(long bytes)
    {
        // PROT_READ | PROT_WRITE = 3; MAP_PRIVATE | MAP_ANONYMOUS = 0x22;
        // no file (-1), offset 0.
        long got = Sys.Syscall(Call.Mmap, 0, bytes, 3, 0x22, 0 - 1, 0);
        long answer = Result(got);

        if (answer < 0)
        {
            // Said here, without allocating (this is the allocator's own
            // failure path): the kernel's log has the numbers.
            string text = "mmap refused by the kernel\n";
            Runtime.WriteLiteral(2, text);
            return 0;
        }
        if (answer == 0)
        {
            string zero = "mmap answered address 0\n";
            Runtime.WriteLiteral(2, zero);
        }
        return answer;
    }

    // ---- the thread block ----------------------------------------------------

    /// Puts `block` where Sys.ThreadBlock() will find it, for this thread and
    /// no other.
    ///
    /// set_thread_area(2) writes one of the three GDT entries the kernel keeps
    /// PER THREAD and reloads them on every switch, so each thread asking for
    /// entry -1 gets one of its own with its own base. The selector it answers
    /// with, shifted and with the requested privilege level, goes into GS; a
    /// load through GS then adds that base, and the block's first word holding
    /// its own address (glibc's convention) is what turns one such load into a
    /// flat address every other instruction can use.
    ///
    /// Nothing here allocates: the structure the call reads is sixteen bytes
    /// of the block itself, because a thread sets its block up before it is
    /// allowed to touch the heap.
    ///
    /// Never inlined: a call of it by name is how region inference tells
    /// what runs before a thread's block is its own (RuntimeAbi.SetThreadBlock),
    /// where no region may be opened.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void SetThreadBlock(long block)
    {
        // The collector times its pauses by this system's clock.
        Gc.PauseClock = Sys.AddressOf(Clock.NowMicroseconds);
        // And the collector's workers: how many, and how one is started.
        Gc.WorkerCountHook = Sys.AddressOf(Platform.CollectorWorkers);
        Gc.WorkerStartHook = Sys.AddressOf(Platform.StartCollectorWorker);
        Gc.WorkerQuietHook = Sys.AddressOf(Platform.QuietWorker);
        Sys.Poke(block + Tls.Self, block);

#if TARGET_AMD64
        // LONG MODE KEEPS A BASE REGISTER PER THREAD FOR THIS: GS, set with
        // arch_prctl(ARCH_SET_GS), saved and restored by the kernel on every
        // switch. Not FS, which is glibc's thread pointer: a program that
        // calls into C (a [DllImport]) runs C code on this thread, and that
        // code finds errno, its allocator's caches and its stack canary
        // through FS. No descriptor, no selector: the block's own first word
        // is still its address, so gs:[0] answers it.
        if (Result(Sys.Syscall(Call.ArchPrctl, Call.ArchSetGs, block, 0)) < 0)
        {
            Runtime.WriteLiteral(2, "arch_prctl(ARCH_SET_GS) failed: this kernel cannot give a thread its own block\n");
            Exit(134);
        }
#else

        long desc = block + Tls.Scratch;

        // THE C LIBRARY'S SELECTOR, taken before this replaces it: under
        // ld-linux, GS already names glibc's thread pointer, and a call into
        // C puts it back for the length of the call (Runtime.EnterNative).
        // Only the first time -- a later thread starts with the runtime's.
        long entry = 0 - 1;                     // entry_number: any free one
        if (Runtime.ManagedGs == 0)
        {
            Runtime.NativeGs = Sys.GetGs();
        }
        else
        {
            // The same slot in every thread, so one selector means each
            // thread's own block: a thread made by pthread_create inherits
            // the slot as its creator left it, and asking for "any" would
            // give it another.
            entry = Runtime.ManagedGs >> 3;
        }
        Sys.PokeWord(desc, entry);
        Sys.PokeWord(desc + 4, block);          // base_addr
        Sys.PokeWord(desc + 8, 0xFFFFF);        // limit: the whole space, in pages
        // seg_32bit | limit_in_pages | useable; a writable data segment that
        // is present, which is the rest of the bits being zero.
        Sys.PokeWord(desc + 12, 0x51);

        if (Result(Sys.Syscall(Call.SetThreadArea, desc, 0, 0)) < 0)
        {
            string text = "set_thread_area failed: this kernel cannot give a thread its own block\n";

            Runtime.WriteLiteral(2, text);
            Exit(134);
        }

        long selector = (Sys.PeekWord(desc) << 3) | 3;
        Runtime.ManagedGs = selector;
        Sys.SetGs(selector);
#endif
    }

    // ---- waiting ---------------------------------------------------------------
    //
    // The collector's stop-the-world, and nothing else, uses these. FUTEX_WAIT
    // and FUTEX_WAKE with the private flag: no shared memory is involved, so
    // the kernel can skip the page lookup entirely.

    /// Nothing: a thread here stops when it next allocates or blocks, and
    /// there is no interrupt to send it. The kernel's platform has one.
    public static void PromptStop()
    {
    }

    // ---- the collector's workers ----------------------------------------

    /// How many threads may mark and sweep beside the collecting one: the
    /// processors this process may run on less one, at most seven, or
    /// CORSAC_GC_WORKERS. Read without the heap: the collector asks this
    /// holding its lock.
    public static long CollectorWorkers()
    {
        if (EnvironmentValue("CORSAC_GC_WORKERS=") != 0)
        {
            long wanted = EnvironmentNumber("CORSAC_GC_WORKERS=");
            return (int)(wanted > 15 ? 15 : wanted);
        }
        long page = Map(4096);
        if (page == 0) return 0;
        long got = Platform.Result(Sys.Syscall(Call.SchedGetaffinity, 0, 128, Platform.Linear(page)));
        int count = 0;
        for (long i = 0; i < got && i < 128; i++)
        {
            long bits = Sys.PeekByte(page + i);
            while (bits != 0) { count = count + (int)(bits & 1); bits = bits >> 1; }
        }
        Unmap(page, 4096);
        count = count - 1;
        return count < 0 ? 0 : count > 7 ? 7 : count;
    }

    const long WorkerStackBytes = 256 * 1024;

    /// Starts one of them: `entry` on a stack of its own, with no Thread,
    /// no thread block and no signals. False when there is no room for it.
    public static long StartCollectorWorker(long entry)
    {
        long stack = Native.MapStack(WorkerStackBytes);
        if (stack == 0) return 0;
        return Native.SpawnBare(entry, 0, stack, WorkerStackBytes) > 0 ? 1 : 0;
    }

    /// First thing a worker does: every signal blocked, so no handler of the
    /// program's ever runs on a thread that has no block of its own.
    public static void QuietWorker()
    {
        // A mask in the worker's own frame: its thread block would be the
        // parent's, whose GS it inherited. Eight bytes of ones, every signal.
        long mask = 0 - 1;
        Sys.Syscall(Call.RtSigprocmask, 0, Platform.Linear(Sys.AddressOf(ref mask)), 0, 8, 0, 0);     // SIG_BLOCK
    }

    public static void Wait(long at, long value)
    {
        Sys.Syscall(Call.Futex, at, 128, value, 0, 0, 0);
    }

    public static void Wake(long at, long count)
    {
        Sys.Syscall(Call.Futex, at, 129, count, 0, 0, 0);
    }

    // ---- the machine's memory, for GC.GetGCMemoryInfo ------------------------

    /// sysinfo(2)'s totalram and freeram, in bytes: what the machine has and
    /// what it has free (the kernel's view, which leaves out reclaimable
    /// caches -- MemAvailable counts those, and is read where a caller wants
    /// it).
    public static long TotalMemory()
    {
        return SysinfoBytes(SysinfoTotal);
    }

    public static long AvailableMemory()
    {
        return SysinfoBytes(SysinfoFree);
    }

    /// Whether a mapping costs only the pages that are touched: the kernel
    /// commits anonymous memory as it is first written, so the collector may
    /// reserve a card table for the whole address space (Gc, generations).
    public const bool MapsCommitLazily = true;

    /// The scheduler's continuations are its own here: no kernel's run queue
    /// to post them to (Scheduler.Post), and no context to flow with them
    /// (AsyncContext) -- a Linux thread is the context.
    public const long PostHook = 0;
    public const long ContextHook = 0;

    /// Free memory as the collector may ask it: with the heap held, so without
    /// allocating (SysinfoBytes answers into a page of the system's own).
    public static long FreeMemoryQuietly()
    {
        return SysinfoBytes(SysinfoFree) + SysinfoBytes(SysinfoBuffers);
    }

    /// THE MEMORY THE PROCESS'S CONTROL GROUP MAY USE, or 0 when it has no
    /// limit: what .NET reads to size its heap in a container, and what a
    /// machine's free memory does not show -- a process capped at 256 MB on a
    /// server with 48 GB free would otherwise pace itself for 48. cgroup v2's
    /// memory.max, the smallest along the group's path, since a parent's
    /// limit binds its children; or v1's memory.limit_in_bytes. Read once, at
    /// the heap's start, with raw calls into a page of the system's own:
    /// nothing here allocates.
    /// How much address space a 32-bit process has: four gigabytes under a
    /// 64-bit kernel, three under a 32-bit one -- uname's machine, x86_64 or
    /// not. Asked once, at the heap's start, into a page of the system's own:
    /// nothing here allocates. Zero when uname says nothing.
    public static long AddressSpace()
    {
        long page = Map(4096);
        if (page == 0)
        {
            return 0;
        }
        long space = 0;
        if (Result(Sys.Syscall(Call.Uname, page, 0, 0)) == 0)
        {
            // struct utsname: six fields of 65 bytes; the machine is the fifth.
            long machine = page + 4 * 65;
            bool wide = Sys.PeekByte(machine) == 120 && Sys.PeekByte(machine + 1) == 56 && Sys.PeekByte(machine + 2) == 54
                     && Sys.PeekByte(machine + 3) == 95 && Sys.PeekByte(machine + 4) == 54 && Sys.PeekByte(machine + 5) == 52
                     && Sys.PeekByte(machine + 6) == 0;
            space = wide ? 4294967296 : 3221225472;
        }
        Unmap(page, 4096);
        return space;
    }

    // ---- a fault no program survives -----------------------------------------
    //
    // A SEGMENTATION FAULT SAYS WHERE IT WAS, as .NET's runtime has one say:
    // "Fatal error. System.AccessViolationException", the address and the
    // stack, on standard error (Runtime.ReportFault) -- and then the process
    // dies of the signal all the same: the default action, a core where one
    // is asked for, and 128 + the signal to whatever waits on it. Without
    // it a compile process of a project build died of one with nothing in
    // any log; only the kernel's ring buffer had a pid and an address.
    //
    // Armed once, as the first image begins, on a page of the system's own
    // that holds the kernel's sigaction, a signal set and the digits the
    // report spells numbers in: nothing here allocates, because the fault
    // may be in the allocator. The handler never returns, so it needs no
    // sigreturn trampoline; it puts the default action back itself rather
    // than trusting SA_RESETHAND to have, unblocks the signal and sends it
    // again, and ends the process outright if that did not.
    static long _faultPage;
    static long _faulting;
    static long _faultReturn;

    const int SignalBus = 7;
    const int SignalSegv = 11;

    public static void ArmFaultReport()
    {
        if (_faultPage != 0)
        {
            return;
        }
        long page = Map(4096);
        if (page == 0)
        {
            return;
        }
        _faultPage = page;
        // THE WAY BACK from a fault that becomes a NullReferenceException:
        // rt_sigreturn, seven bytes on a page of their own that may run, as
        // PosixSignalRegistration's restorer is.
        long back = Platform.Result(Sys.Syscall(Call.Mmap, 0, 4096, 7, 0x22, 0 - 1, 0));
        if (back > 0)
        {
#if TARGET_64BIT
            Sys.PokeByte(back, 0xB8);                                 // mov eax,
            Sys.PokeByte(back + 1, 15);                               //   15 (rt_sigreturn)
            Sys.PokeByte(back + 5, 0x0F);                             // syscall
            Sys.PokeByte(back + 6, 0x05);
#else
            Sys.PokeByte(back, 0xB8);                                 // mov eax,
            Sys.PokeByte(back + 1, 173);                              //   173 (rt_sigreturn)
            Sys.PokeByte(back + 5, 0xCD);                             // int 0x80
            Sys.PokeByte(back + 6, 0x80);
#endif
            _faultReturn = back;
        }
        // The kernel's sigaction: handler, flags, restorer, mask, a word
        // each but the mask. SA_SIGINFO for the address and the registers
        // (and the modern frame, the one rt_sigreturn returns through);
        // SA_RESTORER with the way back above; SA_NODEFER, so that a fault
        // in the program after a NullReferenceException is caught again.
        // A second fault inside the report finds _faulting set and ends the
        // process.
        long handler = Sys.AddressOf(Platform.Fault);
        Sys.Poke(page, handler);
        Sys.Poke(page + WordSize.Bytes, 0x00000004 | 0x04000000 | 0x40000000);
        Sys.Poke(page + 2 * WordSize.Bytes, _faultReturn != 0 ? _faultReturn : handler);
        Sys.Syscall(Call.RtSigaction, SignalSegv, page, 0, 8, 0, 0);
        Sys.Syscall(Call.RtSigaction, SignalBus, page, 0, 8, 0, 0);
    }

    /// The kernel's call on a fault: the signal, its siginfo and the
    /// interrupted context. Reports once, then dies of the signal.
    public static void Fault(int signal, nint info, nint context)
    {
        long si = (long)info & WordSize.AddressMask;
        long uc = (long)context & WordSize.AddressMask;
        // A NULL DEREFERENCE IS AN EXCEPTION, as it is in .NET: the thread is
        // sent on, when the handler returns, into Runtime.NullFault as if the
        // faulting instruction had called it -- its return address that
        // instruction, its arguments the frame and the instruction -- and it
        // throws NullReferenceException from there to whatever catches it.
        if (_faulting == 0 && signal == SignalSegv && si != 0 && uc != 0 && _faultReturn != 0)
        {
#if TARGET_64BIT
            long nullAt = Sys.Peek(si + 16);
#else
            long nullAt = Sys.Peek(si + 12) & WordSize.AddressMask;
#endif
            if (Runtime.NullFaultCatchable(nullAt))
            {
                long entry = Sys.AddressOf(Runtime.NullFault);
#if TARGET_64BIT
                // gregs from 40: RDI 8th, RSI 9th, RBP 10th, RSP 15th, RIP 16th.
                // Past the red zone, aligned as a call leaves it.
                long faultPc = Sys.Peek(uc + 168);
                long faultFrame = Sys.Peek(uc + 120);
                long sp = ((Sys.Peek(uc + 160) - 128) & ~15L) - 8;
                Sys.Poke(sp, faultPc);
                Sys.Poke(uc + 104, faultFrame);
                Sys.Poke(uc + 112, faultPc);
                Sys.Poke(uc + 160, sp);
                Sys.Poke(uc + 168, entry);
#else
                // gregs from 20: EBP 7th, ESP 8th, EIP 15th; the arguments
                // on the stack above the return address.
                long faultPc = Sys.Peek(uc + 76) & WordSize.AddressMask;
                long faultFrame = Sys.Peek(uc + 44) & WordSize.AddressMask;
                long sp = ((Sys.Peek(uc + 48) & WordSize.AddressMask) - 64 & ~15L) - 4;
                Sys.Poke(sp, faultPc);
                Sys.Poke(sp + 4, faultFrame);
                Sys.Poke(sp + 8, faultPc);
                Sys.Poke(uc + 48, sp);
                Sys.Poke(uc + 76, entry);
#endif
                return;
            }
        }
        if (_faulting == 0 && si != 0 && uc != 0)
        {
            _faulting = 1;
#if TARGET_64BIT
            // siginfo's si_addr at 16; mcontext's gregs from 40, RBP the
            // eleventh and RIP the seventeenth.
            long address = Sys.Peek(si + 16);
            long pc = Sys.Peek(uc + 168);
            long frame = Sys.Peek(uc + 120);
            long registers = uc + 40;
            int count = 16;
#else
            // siginfo's si_addr at 12; mcontext's gregs from 20, EBP the
            // seventh and EIP the fifteenth.
            long address = Sys.Peek(si + 12) & WordSize.AddressMask;
            long pc = Sys.Peek(uc + 76) & WordSize.AddressMask;
            long frame = Sys.Peek(uc + 44) & WordSize.AddressMask;
            // EDI, ESI, EBP, ESP, EBX, EDX, ECX, EAX.
            long registers = uc + 36;
            int count = 8;
#endif
            Runtime.ReportFault(address, pc, frame, _faultPage + 256, registers, count);
        }
        // SIG_DFL, the signal unblocked (SIG_UNBLOCK, a set of one), and sent.
        long page = _faultPage;
        Sys.Poke(page, 0);
        Sys.Poke(page + WordSize.Bytes, 0);
        Sys.Syscall(Call.RtSigaction, signal, page, 0, 8, 0, 0);
        Sys.Poke(page + 128, 0);
        Sys.Poke(page + 128 + WordSize.Bytes, 0);
        Sys.PokeByte(page + 128 + (signal - 1) / 8, 1 << ((signal - 1) % 8));
        Sys.Syscall(Call.RtSigprocmask, 1, page + 128, 0, 8, 0, 0);
        Sys.Syscall(Call.Kill, Sys.Syscall(Call.Getpid, 0, 0, 0, 0, 0, 0), signal, 0, 0, 0, 0);
        Sys.Syscall(Call.ExitGroup, 128 + signal, 0, 0, 0, 0, 0);
    }

    public static long MemoryLimit()
    {
        long page = Map(8192);
        if (page == 0)
        {
            return 0;
        }
        long text = page;           // /proc/self/cgroup
        long path = page + 4096;    // the file asked for, NUL-terminated
        long limit = 0;
        long got = ReadInto(text, 4095, "/proc/self/cgroup", path);
        long v2 = got > 0 ? LineAfter(text, got, "0::") : -1;
        if (v2 >= 0)
        {
            long end = v2;
            while (end < text + got && Sys.PeekByte(end) != 10) end = end + 1;
            // The group, then each parent up to the root, whose own file
            // does not exist.
            while (end > v2)
            {
                long bytes = CgroupFile(path, v2, end, "/sys/fs/cgroup", "/memory.max", text + got + 1, page + 4096 - (text + got + 1));
                if (bytes > 0 && (limit == 0 || bytes < limit)) limit = bytes;
                end = end - 1;
                while (end > v2 && Sys.PeekByte(end) != 47) end = end - 1;
            }
        }
        else if (got > 0)
        {
            long v1 = LineAfter(text, got, ":memory:");
            if (v1 >= 0)
            {
                long end = v1;
                while (end < text + got && Sys.PeekByte(end) != 10) end = end + 1;
                limit = CgroupFile(path, v1, end, "/sys/fs/cgroup/memory", "/memory.limit_in_bytes", text + got + 1, page + 4096 - (text + got + 1));
                // v1 says "no limit" as a number near 2^63.
                if (limit >= 0x7FFFFFFFFFFFF000 / 2) limit = 0;
            }
        }
        Unmap(page, 8192);
        return limit;
    }

    /// Reads the file named by `name` (built into `scratch`) into [into,
    /// into + most); answers the bytes read, or -1.
    static long ReadInto(long into, long most, string name, long scratch)
    {
        for (int i = 0; i < name.Length; i++) Sys.PokeByte(scratch + i, name[i]);
        Sys.PokeByte(scratch + name.Length, 0);
        return ReadPath(scratch, into, most);
    }

    static long ReadPath(long path, long into, long most)
    {
        long fd = Result(Sys.Syscall(Call.Open, path, 0, 0));
        if (fd < 0)
        {
            return -1;
        }
        long got = 0;
        while (got < most)
        {
            long n = Result(Sys.Syscall(Call.Read, fd, into + got, most - got));
            if (n <= 0) break;
            got = got + n;
        }
        Sys.Syscall(Call.Close, fd, 0, 0);
        return got;
    }

    /// Where the text after `key` begins, when a line of [text, text + count)
    /// starts with it (or, for a key starting with ':', contains it after the
    /// line's hierarchy number); -1 when none does.
    static long LineAfter(long text, long count, string key)
    {
        long line = text;
        while (line < text + count)
        {
            long at = line;
            if (key[0] == ':')
            {
                while (at < text + count && Sys.PeekByte(at) != 58 && Sys.PeekByte(at) != 10) at = at + 1;
            }
            int i = 0;
            while (i < key.Length && at + i < text + count && Sys.PeekByte(at + i) == key[i]) i = i + 1;
            if (i == key.Length)
            {
                return at + i;
            }
            while (line < text + count && Sys.PeekByte(line) != 10) line = line + 1;
            line = line + 1;
        }
        return -1;
    }

    /// The number in `root` + [from, to) + `leaf`, or 0 for "max", for a
    /// file that is not there, or for one that says nothing a number.
    static long CgroupFile(long path, long from, long to, string root, string leaf, long buffer, long most)
    {
        long at = path;
        for (int i = 0; i < root.Length; i++) { Sys.PokeByte(at, root[i]); at = at + 1; }
        for (long p = from; p < to && at < path + 3000; p++) { Sys.PokeByte(at, Sys.PeekByte(p)); at = at + 1; }
        for (int i = 0; i < leaf.Length; i++) { Sys.PokeByte(at, leaf[i]); at = at + 1; }
        Sys.PokeByte(at, 0);
        if (most < 32) most = 0;
        long got = most > 0 ? ReadPath(path, buffer, most > 64 ? 64 : most) : -1;
        long value = 0;
        long digits = 0;
        for (long p = buffer; p < buffer + got; p++)
        {
            long c = Sys.PeekByte(p);
            if (c < 48 || c > 57) break;
            value = value * 10 + (c - 48);
            digits = digits + 1;
        }
        return digits > 0 ? value : 0;
    }

    // struct sysinfo: the unsigned longs are words, so the offsets are the
    // word size's -- i386 and x86-64 lay it out alike, one word apart.
    const int SysinfoTotal = 4 * WordSize.Bytes;
    const int SysinfoFree = 5 * WordSize.Bytes;
    const int SysinfoBuffers = 7 * WordSize.Bytes;
#if TARGET_64BIT
    const int SysinfoUnit = 104;
#else
    const int SysinfoUnit = 52;
#endif

    // A PAGE OF THE SYSTEM'S, NOT A HEAP ARRAY: the collector reads the
    // machine's free memory as it sets the next collection's pace, holding
    // the heap, where a `new byte[]` would ask the heap for itself. Taken
    // once; two callers at once write the same figures into it.
    static long _sysinfo;

    static long SysinfoBytes(int field)
    {
        if (_sysinfo == 0)
        {
            _sysinfo = Map(4096);
            if (_sysinfo == 0) return 0;
        }
        if (Result(Sys.Syscall(116, _sysinfo, 0, 0)) < 0)
        {
            return 0;
        }
        long unit = Sys.Peek(_sysinfo + SysinfoUnit) & 0xFFFFFFFF;
        long count = Sys.Peek(_sysinfo + field) & WordSize.AddressMask;
        return count * (unit == 0 ? 1 : unit);
    }

    // ---- what Monitor asks (core threading.cor) ----------------------------

    /// Who holds a lock: this thread, by its thread block (word-aligned, so
    /// bit 0 is free for Monitor's "somebody is asleep" mark).
    public static long MonitorOwner()
    {
        return Sys.ThreadBlock();
    }

    /// Sleeps while the lock word still reads `value`, as a blocking region:
    /// the collector does not wait for a thread asleep on a lock.
    public static void MonitorBlock(long at, long value)
    {
        Native.Wait(at, value);
    }

    public static void MonitorWake(long at)
    {
        Native.Wake(at, 1);
    }

    /// Stops this thread at a safepoint, with every callee-saved register on
    /// the stack. The system call is the same trick EnterCollection uses and
    /// for the same reason: a reference the caller left in EBX, ESI or EDI is
    /// invisible to a collector that reads memory unless a prologue pushed it,
    /// and the stack pointer written down inside GcThreads.SafePoint is below
    /// these pushes. See GcRoots in lib/rt/gc.cor.
    public static void SafePoint(long mode)
    {
        Sys.Syscall(Call.Getpid, 0, 0, 0, 0, 0, 0);
        GcThreads.Spill(mode, Sys.Stack(), Sys.FramePointer());
        GcThreads.SafePoint(mode);
    }

    /// Enters a collection with every callee-saved register on the stack.
    ///
    /// The system call below is the whole trick. The backend loads its
    /// arguments into EBX, ECX, EDX, ESI and EDI, so this function USES
    /// every callee-saved register and its prologue pushes them; the values
    /// the caller of Runtime.Alloc left in them are then on the stack, above
    /// the ESP that Gc.CollectInner scans from. getpid is the cheapest call
    /// with no effect. See GcRoots in lib/rt/gc.cor for the full reasoning.
    public static void EnterCollection()
    {
        Sys.Syscall(Call.Getpid, 0, 0, 0, 0, 0, 0);
        if (Runtime.CollectorLinked()) Gc.CollectInner();
    }

    /// A call into an object whose code was taken away (Gc.Revoke): a
    /// program has no modules to lose, so this is only ever a fault, and the
    /// process ends as a crash would end it.
    public static void Revoked()
    {
        Runtime.WriteLiteral(2, "a revoked object was called\n");
        Exit(134);
    }

    /// Ends the whole process. exit_group rather than exit, so that the day
    /// this runtime has threads, exiting means what a C program means by it.
    public static void Exit(int code)
    {
        // Buffered console output reaches the terminal before the process
        // ends, as it does when a .NET Main returns. What to flush was left
        // with the runtime by whoever buffered it: this library is below the
        // class library and may not name Console.
        Runtime.AtExit();
        // And C's, when a C library is loaded: exit(3) flushes what printf
        // buffered and runs its atexit handlers and its libraries'
        // finalisers, then ends the process itself.
        long cExit = Runtime.NativeSymbol("exit");
        if (cExit != 0)
        {
            Runtime.CallC(cExit, code, 0, 0, 0);
        }
        Sys.Syscall(Call.ExitGroup, code, 0, 0);
        // The kernel does not return from that; if it somehow did, the plain
        // exit is the next best thing, and after that there is nothing.
        Sys.Syscall(Call.Exit, code, 0, 0);
    }

    /// One write(2): how many bytes the kernel took, or -errno. The runtime
    /// loops on short writes and EINTR; this does not, so a caller that
    /// wants the raw answer can have it.
    public static long WriteBytes(int fd, long address, long count)
    {
        // Raw: this is also how the runtime says it cannot start, before
        // the thread has the block a blocking call is recorded in.
        return Result(Sys.Syscall(Call.Write, fd, address, count));
    }
}

/// The system API a program uses, as thin wrappers over the calls above.
///
/// NAMED AFTER os/lib/user.cor's Os so the utilities port. Where this file
/// diverges from user.cor, and why:
///
///   - Descriptors, counts and results are `int` where user.cor has `long`.
///     This machine's word is 32 bits and its arrays index by int; a long
///     here would be two registers for a number that never exceeds one.
///     Every raw-address form (Write/Read with an address and a count) keeps
///     `long` for the address, which is what an address is in the language.
///   - Object bytes are found with Sys.ArrayData, never by adding a header
///     size: user.cor's `Sys.Word(x) + 24` was the old machine's header.
///   - Paths are NUL-terminated on the way in. The CORSAC kernel took a
///     length-prefixed string; Linux takes C's, so Open copies the path
///     into a fresh block with a trailing zero.
///   - Errors are the negative errno, exactly as user.cor's are, and Result
///     above is why they come out negative at all.
///   - Args() is new: user.cor's Getarg read one argument string from the
///     kernel; Linux left argc and argv on the stack at entry.
static partial class Os
{
    public static void Exit(int code)
    {
        Platform.Exit(code);
    }

    /// The WHOLE string, however many calls that takes. A terminal, pipe or
    /// socket may honestly accept part of it; this keeps offering the rest,
    /// and retries an interrupted call, so text written this way arrives
    /// complete or not at all. Answers the length, or the error if nothing
    /// at all was written.
    public static int Write(int fd, string s)
    {
        byte[] bytes = Utf8Transcoder.Encode(s, 0, s.Length);
        long at = Platform.Linear(Sys.ArrayData(bytes));
        long done = 0;
        long length = bytes.Length;

        while (done < length)
        {
            long n = Platform.WriteBytes(fd, at + done, length - done);

            if (n == 0 - Err.Intr)
            {
                continue;
            }
            if (n <= 0)
            {
                return done > 0 ? (int)done : (int)n;
            }
            done = done + n;
        }
        return (int)done;
    }

    public static void Print(string s)
    {
        Write(Fd.Out, s);
    }

    /// A whole line in ONE write, so another process's output cannot land
    /// between the text and its newline.
    public static void Line(string s)
    {
        Write(Fd.Out, String.Concat(s, "\n"));
    }

    /// The address of envp as the kernel laid it on the entry stack: past
    /// argc, past argc pointers, past the null that ends them.
    /// System.Environment answers with this; execve needs it here, and the
    /// entry stack is this library's business rather than the class
    /// library's.
    /// THE MAIN THREAD'S ENTRY STACK, wherever this is asked: argc, argv and
    /// the environment are above it alone. Sys.EntryStack is the top of the
    /// stack of the thread asking, and a worker reading a flag -- the
    /// collector's exit report after running out of memory on one -- or the
    /// environment first walked its own stack as envp: it faulted, or found
    /// nothing and kept that for every thread.
    public static long MainEntryStack() => Sys.Peek(Sys.MainThreadBlock() + Tls.StackBase);

    public static long EnvironAddress()
    {
        long sp = MainEntryStack();
        return sp + WordSize.Bytes + WordSize.Bytes * Sys.Peek(sp) + WordSize.Bytes;
    }

    /// uname(2)'s nodename, or null when the call fails.
    public static string? NodeName()
    {
        byte[] names = new byte[65 * 6];                      // struct utsname: six fields of 65
        if (Platform.Result(Sys.Syscall(Call.Uname, Sys.ArrayData(names), 0, 0)) < 0) return null;
        int end = 65;
        while (end < 130 && names[end] != 0) end++;
        return Utf8Transcoder.Decode(names, 65, end - 65);
    }

    public static int Chdir(string path)
    {
        byte[] c = CString(path);
        return (int)Platform.Result(Sys.Syscall(Call.Chdir, Platform.Linear(Sys.ArrayData(c)), 0, 0));
    }

    // ---- descriptors ------------------------------------------------------

    public static int Dup(int fd)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Dup, fd, 0, 0));
    }

    /// dup2(2): `to` becomes another name for `fd`, closing whatever it was.
    public static int Dup2(int fd, int to)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Dup2, fd, to, 0));
    }

    /// pipe(2). `pair` gets the read end at 0 and the write end at 1.
    public static int Pipe(int[] pair)
    {
        if (pair.Length < 2)
        {
            throw new IndexOutOfRangeException("a pipe needs two descriptors");
        }
        return (int)Platform.Result(Sys.Syscall(Call.Pipe, Sys.ArrayData(pair), 0, 0));
    }

    /// sync(2): every dirty block to the disc.
    public static void Sync()
    {
        Sys.Syscall(Call.Sync, 0, 0, 0);
    }

    /// reboot(2) with Linux's two magic numbers and a command:
    /// 0x01234567 restart, 0x4321FEDC power off, 0xCDEF0123 halt.
    /// Does not return when it works; -errno when it does not.
    public static long Reboot(long command)
    {
        return Platform.Result(Sys.Syscall(Call.Reboot, 0xFEE1DEAD, 672274793, command, 0, 0, 0));
    }

    // ---- waiting, randomness, signals ----------------------------------------

    /// fcntl(2)'s two commands a program actually needs: the descriptor's
    /// flags, and the same flags changed. O_NONBLOCK is what a server with
    /// more than one ear sets, and is what .NET spells Socket.Blocking.
    public static int Fcntl(int fd, int command, int argument)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Fcntl, fd, command, argument));
    }

    /// poll(2) on one descriptor: >0 when an event in `events` (1 read,
    /// 4 write, 8 error) is ready within `timeoutMs` (-1 forever), 0 on
    /// the timeout, -errno otherwise.
    public static int Poll(int fd, int events, int timeoutMs)
    {
        byte[] pfd = new byte[8];
        Raw.SetU32(pfd, 0, fd);
        pfd[4] = (byte)events;
        pfd[5] = (byte)(events >> 8);
        while (true)
        {
            long r = Platform.Result(Platform.Blocking(Call.Poll, Platform.Linear(Sys.ArrayData(pfd)), 1, timeoutMs));
            if (r == -Err.Intr || PosixSignalRegistration.Pending)
            {
                // A signal arrived while waiting -- or just before, with
                // nothing blocked for it to interrupt: this is the quiet
                // moment at which the program's handlers run. The caller
                // sees the interruption and decides whether it still wants
                // to wait.
                PosixSignalRegistration.Deliver();
            }
            return (int)r;
        }
    }

    /// pause(2): asleep until a signal, whose handlers have run by the time
    /// this returns. Spelt poll(2) of nothing, for ever, which is the same
    /// wait on every kernel that has poll.
    public static void Pause()
    {
        if (!PosixSignalRegistration.Pending)
        {
            Platform.Result(Platform.Blocking(Call.Poll, 0, 0, -1));
        }

        PosixSignalRegistration.Deliver();
    }

    /// poll(2) on several descriptors at once, each for the same `events`.
    /// `ready[i]` says which answered. The count of them, 0 on the timeout,
    /// -errno otherwise; a signal is delivered and reported as -EINTR.
    public static int PollMany(int[] fds, int count, int events, int timeoutMs, bool[] ready)
    {
        byte[] pfd = new byte[8 * count];

        for (int i = 0; i < count; i++)
        {
            Raw.SetU32(pfd, 8 * i, fds[i]);
            pfd[8 * i + 4] = (byte)events;
            pfd[8 * i + 5] = (byte)(events >> 8);
            ready[i] = false;
        }

        long r = Platform.Result(Platform.Blocking(Call.Poll, Platform.Linear(Sys.ArrayData(pfd)), count, timeoutMs));

        if (r == -Err.Intr || PosixSignalRegistration.Pending)
        {
            PosixSignalRegistration.Deliver();
        }

        for (int i = 0; i < count && r > 0; i++)
        {
            ready[i] = (pfd[8 * i + 6] | pfd[8 * i + 7]) != 0;
        }

        return (int)r;
    }

    /// How many processors this process may run on: the bits of its
    /// sched_getaffinity(2) mask, which is what .NET's ProcessorCount counts.
    public static int ProcessorCount()
    {
        byte[] mask = new byte[128];
        long got = Platform.Result(Sys.Syscall(Call.SchedGetaffinity, 0, mask.Length, Platform.Linear(Sys.ArrayData(mask))));
        int count = 0;
        for (int i = 0; i < got && i < mask.Length; i++)
        {
            for (int bit = 0; bit < 8; bit++) if (((mask[i] >> bit) & 1) != 0) count++;
        }
        return count > 0 ? count : 1;
    }

    /// getrandom(2): bytes into the buffer, blocking until the pool is seeded.
    public static long GetRandom(byte[] buffer, int at, int count)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("getrandom range is outside its buffer");
        }
        return Platform.Result(Sys.Syscall(Call.GetRandom, Platform.Linear(Sys.ArrayData(buffer)) + at, count, 0));
    }

    /// rt_sigaction(2) with a 20-byte kernel sigaction (handler, flags,
    /// restorer, 64-bit mask) and no request for the old one.
    public static long SigAction(int signal, byte[] action)
    {
        return Platform.Result(Sys.Syscall(Call.RtSigaction, signal, Platform.Linear(Sys.ArrayData(action)), 0, 8, 0, 0));
    }

    /// Bytes waiting to be read on `fd` (FIONREAD), or -errno.
    public static long Available(int fd)
    {
        byte[] n = new byte[4];
        long r = Ioctl(fd, 0x541B, Platform.Linear(Sys.ArrayData(n)));
        return r < 0 ? r : Raw.U32(n, 0);
    }

    // ---- processes --------------------------------------------------------

    /// Pages the processor may EXECUTE, as well as read and write.
    ///
    /// THE HEAP IS NOT EXECUTABLE -- it is mapped PROT_READ|PROT_WRITE and
    /// nothing else, which is what keeps a buffer somebody overran from
    /// becoming a program. The one thing in this system that must be code at
    /// run time is the signal restorer: the six bytes the kernel returns
    /// THROUGH when a handler finishes. Those live here, and nothing else
    /// does.
    ///
    /// The address, or 0.
    public static long MapExecutable(long bytes)
    {
        // PROT_READ | PROT_WRITE | PROT_EXEC = 7; MAP_PRIVATE | MAP_ANONYMOUS.
        long got = Platform.Result(Sys.Syscall(Call.Mmap, 0, bytes, 7, 0x22, 0 - 1, 0));
        return got < 0 ? 0 : got;
    }

    /// fork(2): the child's pid here, 0 over there, -errno on failure.
    ///
    /// EVERYTHING the process has is duplicated, the heap included, so the
    /// child is running the same program with the same objects and neither
    /// side can see the other's writes afterwards. Nothing in this runtime
    /// needs to be told: there is one thread, and the collector's state is as
    /// valid in the copy as it was in the original.
    public static int Fork()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Fork, 0, 0, 0));
    }

    public static int Getpid()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Getpid, 0, 0, 0));
    }

    public static int Getppid()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Getppid, 0, 0, 0));
    }

    public static int Getuid()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Getuid, 0, 0, 0));
    }

    public static int Getgid()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Getgid, 0, 0, 0));
    }

    public static int Kill(int pid, int signal)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Kill, pid, signal, 0));
    }

    /// setpgid(2). A zero for either means "this process" and "its own pid",
    /// which is how a shell puts itself in a group of its own.
    public static int Setpgid(int pid, int group)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Setpgid, pid, group, 0));
    }

    /// getpgid(2); zero means this process.
    public static int Getpgid(int pid)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Getpgid, pid, 0, 0));
    }

    /// setsid(2): a new session, with no controlling terminal, this process
    /// leading it. Fails with -EPERM when this process already leads a group.
    public static int Setsid()
    {
        return (int)Platform.Result(Sys.Syscall(Call.Setsid, 0, 0, 0));
    }

    public static int Setuid(int uid)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Setuid, uid, 0, 0));
    }

    public static int Setgid(int gid)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Setgid, gid, 0, 0));
    }

    /// setgroups(2): the supplementary groups, as a block of 32-bit ids.
    public static int Setgroups(int[] groups, int count)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Setgroups, count, Sys.ArrayData(groups), 0));
    }

    /// umask(2): the bits taken OUT of every mode this process creates with.
    /// Answers the mask it replaced, and cannot fail.
    public static int Umask(int mask)
    {
        return (int)Sys.Syscall(Call.Umask, mask, 0, 0);
    }

    /// mount(2). `data` is the filing system's own options, the ones after
    /// -o that the kernel does not understand itself; null when there are
    /// none.
    public static int Mount(string source, string target, string type,
                            long flags, string? data)
    {
        byte[] from = CString(source);
        byte[] onto = CString(target);
        byte[] kind = CString(type);
        // Taken here, in the block the call is in: an address taken inside
        // the if would keep its array only to the if's end.
        byte[]? extra = data == null ? null : CString(data);
        long options = extra == null ? 0 : Platform.Linear(Sys.ArrayData(extra));
        return (int)Platform.Result(Sys.Syscall(Call.Mount, Platform.Linear(Sys.ArrayData(from)), Platform.Linear(Sys.ArrayData(onto)),
                                                Platform.Linear(Sys.ArrayData(kind)), flags, options, 0));
    }

    /// umount2(2). The flags are MNT_FORCE, MNT_DETACH and the rest.
    public static int Umount(string target, int flags)
    {
        byte[] c = CString(target);
        return (int)Platform.Result(Sys.Syscall(Call.Umount2, Platform.Linear(Sys.ArrayData(c)), flags, 0));
    }

    /// An array of C strings, then a null, as execve(2) wants it: the strings
    /// in `keep` so a collection during the build cannot free them, and their
    /// addresses in a block of words.
    ///
    /// The block is a byte[] rather than an int[] only because Raw writes
    /// words into byte[]; the kernel sees the same four bytes either way.
    private static byte[] Vector(string[] items, byte[][] keep, int at)
    {
        byte[] block = new byte[(items.Length + 1) * (int)WordSize.Bytes];

        for (int i = 0; i < items.Length; i++)
        {
            byte[] c = CString(items[i]);
            keep[at + i] = c;
            Raw.SetWord(block, i * (int)WordSize.Bytes, Platform.Linear(Sys.ArrayData(c)));
        }
        Raw.SetWord(block, items.Length * (int)WordSize.Bytes, 0);
        return block;
    }

    /// execve(2). On success it does not return: this process becomes the
    /// named program. On failure it answers -errno, and the caller -- which in
    /// a forked child is usually about to exit -- learns why.
    ///
    /// A null environment means the one this process was started with, passed
    /// straight through by address rather than copied out and back.
    public static int Exec(string path, string[] argv, string[]? envp)
    {
        byte[] c = CString(path);
        int room = argv.Length + (envp == null ? 0 : envp.Length);
        byte[][] keep = new byte[room][];

        byte[] args = Vector(argv, keep, 0);
        long env;

        if (envp == null)
        {
            env = EnvironAddress();
        }
        else
        {
            byte[] block = Vector(envp, keep, argv.Length);
            env = Platform.Linear(Sys.ArrayData(block));
        }
        return (int)Platform.Result(Sys.Syscall(Call.Execve, Platform.Linear(Sys.ArrayData(c)), Platform.Linear(Sys.ArrayData(args)), env));
    }

    /// The common shape: the program's own path as argv[0], the caller's
    /// environment, nothing else.
    public static int Exec(string path, string[] argv)
    {
        return Exec(path, argv, null);
    }

    /// EVERYTHING execve(2) AND chdir(2) ARE HANDED, MADE BEFORE A FORK. The
    /// child of a process with other threads has only the one that forked:
    /// a lock another held stays held there, and a collection waits on
    /// threads that are not there. So the child may not allocate: it calls
    /// ChdirPlanned, ExecPlanned and ExitNow, which are system calls on what
    /// this made. Without it, a native link's backends hung between fork and
    /// exec for good.
    public static ExecPlan PrepareExec(string path, string[] argv, string[]? envp, string? directory)
    {
        ExecPlan plan = new ExecPlan();
        int room = argv.Length + (envp == null ? 0 : envp.Length);
        plan.Keep = new byte[room][];
        plan.Path = CString(path);
        plan.Args = Vector(argv, plan.Keep, 0);
        if (envp == null)
        {
            plan.EnvAddress = EnvironAddress();
        }
        else
        {
            plan.Env = Vector(envp, plan.Keep, argv.Length);
            plan.EnvAddress = Platform.Linear(Sys.ArrayData(plan.Env));
        }
        if (directory != null && directory.Length > 0) plan.Directory = CString(directory);
        return plan;
    }

    /// chdir(2) to the plan's directory, if it has one; nothing allocated.
    public static int ChdirPlanned(ExecPlan plan)
    {
        if (plan.Directory == null) return 0;
        return (int)Platform.Result(Sys.Syscall(Call.Chdir, Platform.Linear(Sys.ArrayData(plan.Directory)), 0, 0));
    }

    /// execve(2) on the plan; nothing allocated. Returns only on failure.
    public static int ExecPlanned(ExecPlan plan)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Execve, Platform.Linear(Sys.ArrayData(plan.Path)),
            Platform.Linear(Sys.ArrayData(plan.Args)), plan.EnvAddress));
    }

    /// exit_group(2) at once: no handler, no flush -- a forked child's buffers
    /// are its parent's too.
    public static void ExitNow(int code)
    {
        Sys.Syscall(Call.ExitGroup, code, 0, 0);
    }

    /// waitpid(2). -1 for `pid` means any child. `status` gets the raw status
    /// word at index 0; Wait below reads it.
    public static int Waitpid(int pid, int[] status, int options)
    {
        if (status.Length < 1)
        {
            throw new IndexOutOfRangeException("waitpid needs somewhere for the status");
        }
#if TARGET_AMD64
        // wait4(2), the only form long mode has: no resource usage wanted.
        return (int)Platform.Result(Platform.Blocking(Call.Wait4, pid, Sys.ArrayData(status), options, 0, 0, 0));
#else
        return (int)Platform.Result(Platform.Blocking(Call.Waitpid, pid, Sys.ArrayData(status), options));
#endif
    }

    /// Waits for one child and answers the way a shell reports it: its exit
    /// code, or 128 + the signal that killed it, or -errno.
    public static int Wait(int pid)
    {
        int[] status = new int[1];
        int got = Waitpid(pid, status, 0);

        if (got < 0)
        {
            return got;
        }
        return WaitStatus.Result(status[0]);
    }

    // ---- time -------------------------------------------------------------

    /// Seconds since the epoch.
    public static long Time()
    {
        return Platform.Result(Sys.Syscall(Call.Time, 0, 0, 0));
    }

    /// clock_gettime(2) into a timespec of TimeSpec.Bytes.
    public static int ClockGetTime(int clock, byte[] into)
    {
        TimeSpec.Check(into);
        return (int)Platform.Result(Sys.Syscall(Call.ClockGetTime, clock, Platform.Linear(Sys.ArrayData(into)), 0));
    }

    public static int ClockGetRes(int clock, byte[] into)
    {
        TimeSpec.Check(into);
        return (int)Platform.Result(Sys.Syscall(Call.ClockGetRes, clock, Platform.Linear(Sys.ArrayData(into)), 0));
    }

    /// A clock as ONE number of nanoseconds, which is what code that measures
    /// an interval actually wants. Monotonic nanoseconds fit in a long for
    /// 292 years, so there is no wrap to reason about.
    public static long Nanos(int clock)
    {
        byte[] t = TimeSpec.Room();

        if (ClockGetTime(clock, t) < 0)
        {
            return 0;
        }
        return TimeSpec.Seconds(t) * 1000000000 + TimeSpec.Nanos(t);
    }

    /// nanosleep(2), restarted when a signal interrupts it, so that asking to
    /// sleep for a second sleeps for a second.
    public static void Sleep(long nanoseconds)
    {
        byte[] want = TimeSpec.Room();
        byte[] left = TimeSpec.Room();

        TimeSpec.Set(want, nanoseconds / 1000000000, nanoseconds % 1000000000);

        while (true)
        {
            long r = Platform.Result(Platform.Blocking(Call.NanoSleep, Platform.Linear(Sys.ArrayData(want)), Platform.Linear(Sys.ArrayData(left)), 0));

            if (r != 0 - Err.Intr)
            {
                if (PosixSignalRegistration.Pending)
                {
                    PosixSignalRegistration.Deliver();
                }
                return;
            }

            // A signal arrived while asleep, which is as quiet a moment as
            // a program has: its handlers run now (as they do in Poll), and
            // then the rest of the sleep is slept.
            PosixSignalRegistration.Deliver();
            TimeSpec.Set(want, TimeSpec.Seconds(left), TimeSpec.Nanos(left));
        }
    }

    public static void SleepMillis(long millis)
    {
        Sleep(millis * 1000000);
    }

    public static void Yield()
    {
        Sys.Syscall(Call.Sched_Yield, 0, 0, 0);
    }

    // ---- the terminal -----------------------------------------------------

    /// Whether the descriptor is a terminal: TCGETS succeeds on one and
    /// answers -ENOTTY on anything else, which is exactly how isatty(3) is
    /// implemented and why there is no separate call for it.
    public static bool IsTty(int fd)
    {
        byte[] t = Termios.Room();
        return Ioctl(fd, Tio.GetAttributes, Platform.Linear(Sys.ArrayData(t))) >= 0;
    }

    public static long GetAttributes(int fd, byte[] into)
    {
        Termios.Check(into);
        return Ioctl(fd, Tio.GetAttributes, Platform.Linear(Sys.ArrayData(into)));
    }

    /// The change takes effect at once. Tio.SetAttributesDrain is the form
    /// that waits for what is already queued to go out, which is what a
    /// program changing the speed of a line wants.
    public static long SetAttributes(int fd, byte[] from)
    {
        Termios.Check(from);
        return Ioctl(fd, Tio.SetAttributes, Platform.Linear(Sys.ArrayData(from)));
    }

    /// Characters as they are typed, no echo: what a full-screen program does
    /// on the way in. Answers the previous settings so it can be undone.
    public static byte[]? RawMode(int fd)
    {
        byte[] was = Termios.Room();

        if (GetAttributes(fd, was) < 0)
        {
            return null;
        }

        byte[] now = Termios.Room();

        for (int i = 0; i < Termios.Bytes; i++)
        {
            now[i] = was[i];
        }

        Termios.SetLocal(now, Termios.Local(now) & ~(Termios.Canonical | Termios.Echo));
        Termios.SetChar(now, Termios.Min, 1);
        Termios.SetChar(now, Termios.Time, 0);

        if (SetAttributes(fd, now) < 0)
        {
            return null;
        }
        return was;
    }

    /// How wide and how tall the terminal is, as (columns << 16) | rows, or 0
    /// when the descriptor is not one.
    public static long WindowSize(int fd)
    {
        byte[] w = new byte[8];

        if (Ioctl(fd, Tio.WindowSize, Platform.Linear(Sys.ArrayData(w))) < 0)
        {
            return 0;
        }
        return (Raw.U16(w, 1) << 16) | Raw.U16(w, 0);
    }

    // ---- memory -----------------------------------------------------------

    public static long Mmap(long address, long length, long protection, long flags, long fd, long pages)
    {
        return Platform.Result(Sys.Syscall(Call.Mmap, address, length, protection, flags, fd, pages << Call.MmapOffsetShift));
    }

    public static int Munmap(long address, long length)
    {
        return (int)Platform.Result(Sys.Syscall(Call.Munmap, address, length, 0));
    }

    // ---- sockets ----------------------------------------------------------
    //
    // Two doors, one question. i386 gained an ordinary system call per socket
    // operation in Linux 4.3; before that the only way in was socketcall(2),
    // which takes the operation number and a block of argument words. Which
    // one a kernel has is not something a library can be told at build time --
    // the same binary has to run on both -- so every call below tries the
    // direct number first and falls back when the kernel says -ENOSYS.

    private static long Sock(long direct, long which, long a, long b, long c, long d, long e, long f)
    {
        long got = Platform.Result(Platform.Blocking(direct, a, b, c, d, e, f));

#if TARGET_AMD64
        // Long mode has always had a call per operation, and no socketcall.
        return got;
#else
        if (got != 0 - Err.NoSys)
        {
            return got;
        }

        // socketcall copies as many words as the operation takes; the ones
        // beyond that are never read, so one six-word block serves them all.
        byte[] block = new byte[24];

        Raw.SetU32(block, 0, a);
        Raw.SetU32(block, 4, b);
        Raw.SetU32(block, 8, c);
        Raw.SetU32(block, 12, d);
        Raw.SetU32(block, 16, e);
        Raw.SetU32(block, 20, f);
        return Platform.Result(Platform.Blocking(Call.SocketCall, which, Platform.Linear(Sys.ArrayData(block)), 0));
#endif
    }

    public static int Socket(int family, int kind, int protocol)
    {
        return (int)Sock(Call.Socket, SockCall.Socket, family, kind, protocol, 0, 0, 0);
    }

    public static int Bind(int fd, byte[] address)
    {
        return (int)Sock(Call.Bind, SockCall.Bind, fd, Platform.Linear(Sys.ArrayData(address)), address.Length, 0, 0, 0);
    }

    public static int Listen(int fd, int backlog)
    {
        return (int)Sock(Call.Listen, SockCall.Listen, fd, backlog, 0, 0, 0, 0);
    }

    /// accept(2), through accept4 with no flags where the direct calls exist:
    /// there is no separate accept system call on i386's modern numbering.
    /// `address` may be null when the caller does not care who connected.
    public static int Accept(int fd, byte[]? address)
    {
        if (address == null)
        {
            return (int)Sock(Call.Accept4, SockCall.Accept, fd, 0, 0, 0, 0, 0);
        }

        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(Call.Accept4, SockCall.Accept, fd, Platform.Linear(Sys.ArrayData(address)), Platform.Linear(Sys.ArrayData(length)), 0, 0, 0);
    }

    public static int Connect(int fd, byte[] address)
    {
        return (int)Sock(Call.Connect, SockCall.Connect, fd, Platform.Linear(Sys.ArrayData(address)), address.Length, 0, 0, 0);
    }

    public static int GetSockName(int fd, byte[] address)
    {
        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(Call.GetSockName, SockCall.GetSockName, fd, Platform.Linear(Sys.ArrayData(address)), Platform.Linear(Sys.ArrayData(length)), 0, 0, 0);
    }

    public static int GetPeerName(int fd, byte[] address)
    {
        byte[] length = new byte[4];

        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(Call.GetPeerName, SockCall.GetPeerName, fd, Platform.Linear(Sys.ArrayData(address)), Platform.Linear(Sys.ArrayData(length)), 0, 0, 0);
    }

    /// send(2) is sendto(2) with no address, which is what the kernel makes of
    /// it too -- there is no separate send system call.
    public static int Send(int fd, byte[] buffer, int at, int count, int flags)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("send range is outside its buffer");
        }
        return (int)Sock(Call.SendTo, SockCall.Send, fd, Platform.Linear(Sys.ArrayData(buffer)) + at, count, flags, 0, 0);
    }

    public static int Recv(int fd, byte[] buffer, int at, int count, int flags)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recv range is outside its buffer");
        }
        return (int)Sock(Call.RecvFrom, SockCall.Recv, fd, Platform.Linear(Sys.ArrayData(buffer)) + at, count, flags, 0, 0);
    }

    /// sendto(2) and recvfrom(2) with an address: a datagram's destination,
    /// and where one came from. `address` is a sockaddr the caller sized;
    /// recvfrom writes what it can of the sender's into it.
    public static int SendTo(int fd, byte[] buffer, int at, int count, int flags, byte[] address)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("sendto range is outside its buffer");
        }
        return (int)Sock(Call.SendTo, SockCall.SendTo, fd, Platform.Linear(Sys.ArrayData(buffer)) + at, count, flags,
            Platform.Linear(Sys.ArrayData(address)), address.Length);
    }

    public static int RecvFrom(int fd, byte[] buffer, int at, int count, int flags, byte[] address)
    {
        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recvfrom range is outside its buffer");
        }
        byte[] length = new byte[4];
        Raw.SetU32(length, 0, address.Length);
        return (int)Sock(Call.RecvFrom, SockCall.RecvFrom, fd, Platform.Linear(Sys.ArrayData(buffer)) + at, count, flags,
            Platform.Linear(Sys.ArrayData(address)), Platform.Linear(Sys.ArrayData(length)));
    }

    /// recvmsg(2): a datagram AND WHAT THE KERNEL KNOWS ABOUT IT.
    ///
    /// THE CONTROL DATA IS THE WHOLE POINT. recvfrom answers the bytes and
    /// the sender and nothing else; there is no room in it for the things
    /// that are true of a packet rather than in it -- the time to live it
    /// arrived with, the ICMP error that came back instead of an answer.
    /// Those arrive here, as a list of `struct cmsghdr` in `control`, and
    /// a program that wants them has to ask for each with setsockopt first
    /// (IP_RECVTTL, IP_RECVERR) and walk them afterwards. Cmsg.Next is the
    /// walk.
    ///
    /// Returns the bytes received, or -errno; `controlBytes` is how much of
    /// `control` the kernel wrote.
    public static int RecvMsg(int fd, byte[] buffer, int at, int count, int flags,
        byte[]? address, byte[]? control, out int controlBytes)
    {
        controlBytes = 0;

        if (at < 0 || count < 0 || at > buffer.Length - count)
        {
            throw new IndexOutOfRangeException("recvmsg range is outside its buffer");
        }

#if TARGET_64BIT
        // The structures are the kernel's, laid out as x86-64 lays them out:
        // an iovec of two words, and a msghdr whose name length is an int
        // padded to the pointer after it and whose counts are words.
        byte[] iov = new byte[16];
        byte[] message = new byte[56];

        Raw.SetI64(iov, 0, Platform.Linear(Sys.ArrayData(buffer)) + at);
        Raw.SetI64(iov, 8, count);

        Raw.SetI64(message, 0, address == null ? 0 : Platform.Linear(Sys.ArrayData(address)));
        Raw.SetU32(message, 8, address == null ? 0 : address.Length);
        Raw.SetI64(message, 16, Platform.Linear(Sys.ArrayData(iov)));
        Raw.SetI64(message, 24, 1);
        Raw.SetI64(message, 32, control == null ? 0 : Platform.Linear(Sys.ArrayData(control)));
        Raw.SetI64(message, 40, control == null ? 0 : control.Length);
        Raw.SetU32(message, 48, 0);

        int got = (int)Sock(Call.RecvMsg, SockCall.RecvMsg, fd, Platform.Linear(Sys.ArrayData(message)), flags, 0, 0, 0);

        if (got >= 0)
        {
            controlBytes = (int)Raw.I64(message, 40);
        }
#else
        // The structures are the kernel's, laid out as a 32-bit machine
        // lays them out: a msghdr of seven words, and an iovec of two.
        byte[] iov = new byte[8];
        byte[] message = new byte[28];

        Raw.SetU32(iov, 0, Platform.Linear(Sys.ArrayData(buffer)) + at);
        Raw.SetU32(iov, 4, count);

        Raw.SetU32(message, 0, address == null ? 0 : Platform.Linear(Sys.ArrayData(address)));
        Raw.SetU32(message, 4, address == null ? 0 : address.Length);
        Raw.SetU32(message, 8, Platform.Linear(Sys.ArrayData(iov)));
        Raw.SetU32(message, 12, 1);
        Raw.SetU32(message, 16, control == null ? 0 : Platform.Linear(Sys.ArrayData(control)));
        Raw.SetU32(message, 20, control == null ? 0 : control.Length);
        Raw.SetU32(message, 24, 0);

        int got = (int)Sock(Call.RecvMsg, SockCall.RecvMsg, fd, Platform.Linear(Sys.ArrayData(message)), flags, 0, 0, 0);

        if (got >= 0)
        {
            controlBytes = (int)Raw.U32(message, 20);
        }
#endif

        return got;
    }

    public static int SetSockOpt(int fd, int level, int option, byte[] value)
    {
        return (int)Sock(Call.SetSockOpt, SockCall.SetSockOpt, fd, level, option, Platform.Linear(Sys.ArrayData(value)), value.Length, 0);
    }

    /// The one every server needs: SO_REUSEADDR, so a restart does not have to
    /// wait out the previous socket's TIME_WAIT.
    public static int ReuseAddress(int fd)
    {
        byte[] one = new byte[4];

        Raw.SetU32(one, 0, 1);
        return SetSockOpt(fd, 1, 2, one);
    }

    public static int Shutdown(int fd, int how)
    {
        return (int)Sock(Call.Shutdown, SockCall.Shutdown, fd, how, 0, 0, 0, 0);
    }

    // ---- the shapes os/lib/user.cor had ------------------------------------
    //
    // That library counted descriptors and byte counts in `long`, because its
    // machine's word was 64 bits. This one counts them in `int`, which is what
    // a 32-bit word and an int-indexed array make them. These overloads take
    // the old shapes so a ported utility's `long fd` still compiles; they do
    // nothing but narrow and call the real one.

    public static long Ioctl(long fd, long request, long argument)
    {
        return Ioctl((int)fd, request, argument);
    }

    /// The old library's exit took the enum; a utility says
    /// Os.Exit(ExitCode.NoInput) and means 66.
    public static void Exit(ExitCode code)
    {
        Platform.Exit((int)code);
    }

    // ---- the command line -------------------------------------------------------
    //
    // At entry ESP pointed at argc, then argc pointers to NUL-terminated
    // strings, then a null, then the environment. The compiler saved that
    // ESP for us (Sys.EntryStack); this reads it once and keeps the result,
    // because the strings are the kernel's and copying them each time would
    // be a heap of identical arrays.

    static string[] _args;

    /// The length of a C string at `at`.
    private static int CLength(long at)
    {
        int n = 0;

        while (Sys.PeekByte(at + n) != 0)
        {
            n = n + 1;
        }
        return n;
    }

    /// A COR-C# string from a C string: its bytes decoded as UTF-8.
    private static string FromC(long at)
    {
        return Utf8Transcoder.Decode(at, CLength(at));
    }

    /// A COR-C# string from a NUL-terminated C string at an address. Public
    /// because Env reads the kernel's environment block, which is C strings
    /// and nothing else.
    public static string StringAt(long at)
    {
        return FromC(at);
    }

    /// argv, including the program's own name at index 0, as the C
    /// convention has it. Main's `string[] args` in C# leaves the name out;
    /// a caller that wants that shape takes it from index 1.
    public static string[] Args()
    {
        string[] have = _args;

        if (have != null)
        {
            return have;
        }

        // The main thread's entry stack is ESP exactly as the kernel handed
        // it over, before _start's own prologue: argc at [sp], then argv.
        long sp = MainEntryStack();
        int argc = (int)Sys.Peek(sp);

        if (argc < 0)
        {
            argc = 0;
        }

        string[] args = new string[argc];

        for (int i = 0; i < argc; i++)
        {
            args[i] = FromC(Sys.Peek(sp + WordSize.Bytes + WordSize.Bytes * i));
        }
        _args = args;
        return args;
    }

    // ---- standard input, a line at a time -----------------------------------------

    static byte[] _readAhead;      // bytes read and not yet handed out
    static int _readAheadAt;
    static int _readAheadCount;
    static bool _ended;
    static bool _afterReturn;      // the last line ended at a '\r'

    const int ReadAheadBytes = 1024;

    /// Whether standard input has ended. Set by the read that found it.
    public static bool AtEnd()
    {
        return _ended;
    }

    /// A line from standard input without its line end, or null when the
    /// input is finished and there is nothing left. The last line of a file
    /// with no line end is a line.
    ///
    /// A LINE ENDS AT "\n", "\r" OR "\r\n", each once, as .NET's ReadLine
    /// has it -- so a "\r" ends a line even when the "\n" that follows it
    /// arrives in the next read. The line's bytes are UTF-8 and are decoded
    /// as a whole, since one character may be several of them.
    ///
    /// Reads in blocks and keeps the tail, because a pipe or a file gives
    /// several lines per read and a byte-at-a-time read is a system call
    /// per character.
    public static string? ReadLine()
    {
        byte[] line = new byte[64];
        int length = 0;
        bool any = false;

        while (true)
        {
            if (_readAheadAt >= _readAheadCount)
            {
                if (_ended)
                {
                    return any ? Utf8Transcoder.Decode(line, 0, length) : null;
                }

                byte[] buffer = _readAhead;

                if (buffer == null)
                {
                    buffer = new byte[ReadAheadBytes];
                    _readAhead = buffer;
                }

                long got = Read(Fd.In, Platform.Linear(Sys.ArrayData(buffer)), ReadAheadBytes);

                if (got == 0 - Err.Intr)
                {
                    continue;
                }
                if (got <= 0)
                {
                    _ended = true;
                    return any ? Utf8Transcoder.Decode(line, 0, length) : null;
                }
                _readAheadAt = 0;
                _readAheadCount = (int)got;
            }

            int ch = _readAhead[_readAheadAt];
            _readAheadAt = _readAheadAt + 1;

            if (_afterReturn)
            {
                _afterReturn = false;
                if (ch == 10)
                {
                    continue;
                }
            }
            any = true;

            if (ch == 10)
            {
                return Utf8Transcoder.Decode(line, 0, length);
            }
            if (ch == 13)
            {
                _afterReturn = true;
                return Utf8Transcoder.Decode(line, 0, length);
            }
            if (length == line.Length)
            {
                byte[] wider = new byte[line.Length * 2];
                Sys.Copy(wider, 0, line, 0, length);
                line = wider;
            }
            line[length] = (byte)ch;
            length = length + 1;
        }
    }
}

/// The kernel's `struct termios` as the TCGETS/TCSETS ioctls use it: four
/// flag words, a line discipline byte, then nineteen special characters.
/// (glibc's termios is a different, larger structure; this is the kernel's.)
static class Termios
{
    public const int Bytes = 36;

    public const int InputAt = 0;
    public const int OutputAt = 4;
    public const int ControlAt = 8;
    public const int LocalAt = 12;
    public const int LineAt = 16;
    public const int CharsAt = 17;

    // c_lflag, the bits a program actually changes.
    public const long Signals = 0x1;        // ISIG
    public const long Canonical = 0x2;      // ICANON: input arrives a LINE at a time
    public const long Echo = 0x8;           // ECHO
    public const long EchoErase = 0x10;     // ECHOE

    // c_iflag
    public const long CrToNl = 0x100;       // ICRNL
    public const long IgnoreCr = 0x80;      // IGNCR
    public const long FlowControl = 0x400;  // IXON

    // c_cflag
    public const long HangUpOnClose = 0x400; // HUPCL: the last close drops DTR
    public const long LocalLine = 0x800;    // CLOCAL: the line's carrier means nothing
    public const long HardwareFlow = 0x80000000; // CRTSCTS: RTS/CTS flow control

    // c_oflag
    public const long PostProcess = 0x1;    // OPOST
    public const long NlToCrNl = 0x4;       // ONLCR

    // indices into c_cc
    public const int Intr = 0;
    public const int Quit = 1;
    public const int Erase = 2;
    public const int Kill = 3;
    public const int Eof = 4;
    public const int Time = 5;
    public const int Min = 6;

    public static byte[] Room()
    {
        return new byte[Bytes];
    }

    public static void Check(byte[] b)
    {
        if (b.Length < Bytes)
        {
            throw new ArgumentException("a termios is 36 bytes");
        }
    }

    public static long Input(byte[] t)   { return Raw.U32(t, InputAt); }
    public static long Output(byte[] t)  { return Raw.U32(t, OutputAt); }
    public static long Control(byte[] t) { return Raw.U32(t, ControlAt); }
    public static long Local(byte[] t)   { return Raw.U32(t, LocalAt); }

    public static void SetInput(byte[] t, long v)   { Raw.SetU32(t, InputAt, v); }
    public static void SetOutput(byte[] t, long v)  { Raw.SetU32(t, OutputAt, v); }
    public static void SetControl(byte[] t, long v) { Raw.SetU32(t, ControlAt, v); }
    public static void SetLocal(byte[] t, long v)   { Raw.SetU32(t, LocalAt, v); }

    public static long Char(byte[] t, int which)
    {
        return t[CharsAt + which];
    }

    public static void SetChar(byte[] t, int which, long ch)
    {
        t[CharsAt + which] = (byte)(ch & 0xFF);
    }
}

/// The terminal ioctls, by their traditional numbers.
static class Tio
{
    public const long GetAttributes = 0x5401;       // TCGETS
    public const long SetAttributes = 0x5402;       // TCSETS, at once
    public const long SetAttributesDrain = 0x5403;  // TCSETSW, after the output goes out
    public const long SetAttributesFlush = 0x5404;  // TCSETSF, and throw the input away
    public const long WindowSize = 0x5413;          // TIOCGWINSZ
    public const long SetWindowSize = 0x5414;
    public const long Foreground = 0x540F;          // TIOCGPGRP
    public const long SetForeground = 0x5410;
    public const long Exclusive = 0x540C;
    public const long SetControlling = 0x540E;      // TIOCSCTTY
    public const long GiveUpControlling = 0x5422;   // TIOCNOTTY
    public const long GetModemLines = 0x5415;       // TIOCMGET
    public const long SetModemLines = 0x5418;       // TIOCMSET
    public const long FlushInput = 0x540B;          // TCFLSH
}

/// The status word waitpid(2) writes, and what it means. The encoding is the
/// kernel's and has been since v6: the low byte says how it ended.
static class WaitStatus
{
    public const int NoHang = 1;        // WNOHANG
    public const int Untraced = 2;      // WUNTRACED

    /// Whether the child ran to its own end rather than being killed.
    public static bool Exited(int status)
    {
        return (status & 0x7F) == 0;
    }

    /// What it returned from Main, meaningful only when Exited.
    public static int Code(int status)
    {
        return (status >> 8) & 0xFF;
    }

    public static bool Signalled(int status)
    {
        return (status & 0x7F) != 0 && (status & 0x7F) != 0x7F;
    }

    /// Which signal killed it, or 0.
    public static int Signal(int status)
    {
        return status & 0x7F;
    }

    public static bool Stopped(int status)
    {
        return (status & 0xFF) == 0x7F;
    }

    /// A shell's one number for how a child ended: its exit code, or
    /// 128 + the signal. Every Unix shell reports it this way and every
    /// script that tests $? expects it.
    public static int Result(int status)
    {
        if (Exited(status))
        {
            return Code(status);
        }
        return 128 + Signal(status);
    }
}

enum ExitCode
{
    Success = 0,
    Failure = 1,

    Usage = 64,             // the command was used incorrectly
    DataErr = 65,           // the input was wrong
    NoInput = 66,           // an input file was missing or unreadable
    NoUser = 67,            // no such user
    NoHost = 68,            // no such host
    Unavailable = 69,       // a service is not available
    Software = 70,          // an internal error: the program's own fault
    OsErr = 71,             // the operating system said no
    OsFile = 72,            // a system file is missing or wrong
    CantCreate = 73,        // an output file could not be made
    IoErr = 74,             // an error while reading or writing
    TempFail = 75,          // try again later
    Protocol = 76,          // the other end did not follow the protocol
    NoPerm = 77,            // not permitted, and not a file-permission problem
    Config = 78,            // something is misconfigured

    NotExecutable = 126,
    NotFound = 127,
    Signalled = 128,        // a BASE: add the signal, so an interrupt is 130
}

/// What a forked child hands execve(2) and chdir(2), made before the fork (Os.PrepareExec).
sealed class ExecPlan
{
    public byte[] Path = null!;
    public byte[] Args = null!;
    public byte[][] Keep = null!;
    public byte[]? Env;
    public long EnvAddress;
    public byte[]? Directory;
}
