// Tasks, awaiters, cancellation and the scheduler that runs them.
//
//   corc compile program.cor -o program        (linked by default; see
//                                               compiler/Driver.cs)
//
// This is the library half of `async` and `await` (docs/software/
// X86-BACKEND.md, "Async"). The compiler lowers an async method into a state
// machine -- a class implementing Action -- and calls, BY NAME, exactly these:
//
//   new Task() / new Task<T>()            an incomplete task
//   task.GetAwaiter()                     IsCompleted, GetResult(),
//                                         OnCompleted(Action)
//   Task.SetResultCore()                  complete, and post continuations
//   Task<T>.SetResultCore(T value)
//   Task.SetExceptionCore(Exception e)
//   AsyncRuntime.Unhandled(Exception e)   escaped an `async void` method
//   AsyncRuntime.RunMain(Task t)          `async Task Main` returned t
//
// Renaming any of those breaks every async program without breaking this
// file's compilation, so do not.
//
// THE NAMES AND BEHAVIOUR ARE .NET'S. Where this differs:
//   - There is no AggregateException. A faulted task stores the ONE exception
//     that faulted it, and Wait(), Result and await all rethrow that object.
//     WhenAll reports the first faulted task's exception, in array order.
//   - Awaiters and awaitables are classes, not structs: a struct here is a
//     heap block copied at every boundary, which buys nothing.
//   - There is one scheduler, a single-threaded event loop, and it runs only
//     inside Scheduler.RunUntil (Wait, Result, RunMain). Nothing runs "in the
//     background" while the program is doing something else.
//
// THREAD SAFETY IS BUILT IN FROM THE START. Every state transition on a task,
// a cancellation source and the run queue goes through Sys.Cas / a spin lock
// on a word inside the object, so a thread pool can later provide the same
// Scheduler.Post over several threads without a change here or in compiled
// code. See Atom for the one layout assumption that makes that possible.
//
// ---- atomics on a word inside an object -------------------------------------

/// Where the words that atomic operations work on live, and a spin lock.
///
/// THE LAYOUT ASSUMPTION, in one place. An object is a two-word header
/// (vtable, sync word) followed by its fields in declaration order, each
/// aligned to its size, base-class fields first (X86-BACKEND.md, "Object
/// layout"; Binder.LayOut). So a class whose FIRST two declared instance
/// fields are `nint` -- and whose base declares none -- has them at two and
/// three words: +8 and +12 on i386, +16 and +24 in long mode. Task,
/// CancellationTokenSource, AtomicCell and WhenAllState are written that way,
/// and CheckLayout below proves it on first use of the scheduler rather than
/// trusting this comment.
///
/// `nint`, a machine word, because Sys.Cas, Sys.AtomicSwap and Sys.AtomicAdd
/// are word operations: on i386 that is 32 bits, as `int` was, and in long
/// mode a CAS on a 32-bit field would take its neighbour with it.
///
/// The address is taken afresh on every operation (Sys.Word(o) + offset) and
/// never stored, so a future moving collector that updates references keeps
/// this correct as long as it does not move an object in the middle of one
/// instruction.
static class Atom
{
    public const long FirstWord = 2 * WordSize.Bytes;
    public const long SecondWord = 3 * WordSize.Bytes;

    public static long At(object o, long offset)
    {
        return Sys.Word(o) + offset;
    }

    /// Takes the spin lock at `at` (0 free, 1 held). Uncontended on one
    /// thread, which is the only case today; Pause is what a waiter does on a
    /// multiprocessor.
    public static void Enter(long at)
    {
        while (Sys.Cas(at, 0, 1) != 0)
        {
            Sys.Pause();
        }
    }

    public static void Exit(long at)
    {
        Sys.AtomicSwap(at, 0);
    }

    static bool _checked;

    /// Proves the offsets above against the compiler's actual layout, once.
    /// A drift here would otherwise corrupt a neighbouring field silently.
    public static void CheckLayout()
    {
        if (_checked)
        {
            return;
        }

        AtomicCell cell = new AtomicCell();
        cell.Value = 0x5A17;
        cell.Lock = 0x3C0D;

        if (Sys.PeekWord(At(cell, FirstWord)) != 0x5A17 || Sys.PeekWord(At(cell, SecondWord)) != 0x3C0D)
        {
            throw new InvalidOperationException("threading: object layout is not the one lib/threading.cor assumes");
        }

        Task t = new Task();

        if (!t.LayoutIsAsAssumed())
        {
            throw new InvalidOperationException("threading: Task layout is not the one lib/threading.cor assumes");
        }
        _checked = true;
    }
}

/// A word that can be changed atomically, and a lock beside it. Used where a
/// static would otherwise need an address (a static field has none the
/// language can take).
class AtomicCell
{
    // LAYOUT: Value at Atom.FirstWord, Lock at Atom.SecondWord. Keep first.
    public nint Value;
    public nint Lock;

    public int Read()
    {
        return (int)Value;
    }

    /// Answers what was there; the swap happened when that equals `expect`.
    public int CompareExchange(int expect, int value)
    {
        return (int)Sys.Cas(Atom.At(this, Atom.FirstWord), expect, value);
    }

    /// Adds and answers the NEW value (xadd hands back the old one).
    public int Add(int delta)
    {
        return (int)Sys.AtomicAdd(Atom.At(this, Atom.FirstWord), delta) + delta;
    }

    public void Enter()
    {
        Atom.Enter(Atom.At(this, Atom.SecondWord));
    }

    public void Exit()
    {
        Atom.Exit(Atom.At(this, Atom.SecondWord));
    }
}

// ---- Task --------------------------------------------------------------------

enum TaskStatus
{
    Created,
    WaitingForActivation,
    WaitingToRun,
    Running,
    WaitingForChildrenToComplete,
    RanToCompletion,
    Canceled,
    Faulted,
}

/// A piece of work that finishes later, and what it finished with.
///
/// States, in the word at Atom.FirstWord:
///   0  incomplete
///   1  claimed: one completer has won and is filling in the outcome
///   2  ran to completion
///   3  faulted (Exception holds why)
///   4  canceled
///
/// Completing is two steps so that the outcome (a result, an exception) is
/// written BEFORE anyone can observe a final state: CAS 0 -> 1 decides who
/// completes, the outcome is stored, and then, under the continuation lock,
/// the state becomes final and the continuation list is taken. A registration
/// holds the same lock, so it either sees a final state (and posts at once) or
/// is in the list the completer takes. Nothing is lost and nothing runs twice.
class Task
{
    // LAYOUT: these two must stay the first instance fields (see Atom).
    nint _state;
    nint _lock;

    Exception? _exception;
    Action? _first;
    List<Action>? _more;
    // THE CONTEXT EACH CONTINUATION WAS REGISTERED IN (AsyncContext): what
    // it resumes in. Null where the platform flows none (Linux), always.
    AsyncContext? _firstContext;
    List<AsyncContext?>? _moreContexts;
    System.Threading.Tasks.TaskCreationOptions _options;
    object? _asyncState;

    const int Incomplete = 0;
    const int Claimed = 1;
    const int RanToCompletion = 2;
    const int Faulted = 3;
    const int Canceled = 4;

    /// An incomplete task. What the compiler calls for every async method.
    public Task()
    {
        _state = Incomplete;
        _lock = 0;
    }

    /// Whether the fields above are where Atom says: written through the
    /// field, read through the address.
    public bool LayoutIsAsAssumed()
    {
        _state = 0x2B;
        _lock = 0x4D;

        bool ok = Sys.PeekWord(Atom.At(this, Atom.FirstWord)) == 0x2B
               && Sys.PeekWord(Atom.At(this, Atom.SecondWord)) == 0x4D;

        _state = Incomplete;
        _lock = 0;
        return ok;
    }

    // ---- what a task is -----------------------------------------------------

    /// The options it was made with (TaskCompletionSource's), as .NET
    /// reports them. A continuation here is always posted to the scheduler,
    /// never run inline in the completing call, so RunContinuationsAsynchronously
    /// is already how every task behaves.
    public System.Threading.Tasks.TaskCreationOptions CreationOptions => _options;

    /// The state object it was made with, or null.
    public object? AsyncState => _asyncState;

    public void SetCreation(System.Threading.Tasks.TaskCreationOptions options, object? state)
    {
        _options = options;
        _asyncState = state;
    }

    /// Takes the outcome of a finished task as this one's: its success, its
    /// fault or its cancellation (and, for a Task<T>, its result).
    public virtual void CopyOutcomeFrom(Task from)
    {
        new Propagate(from, this).Invoke();
    }

    // ---- WaitAsync -------------------------------------------------------------
    //
    // A task that completes as this one does, or faults with TimeoutException
    // when the timeout passes first, or is canceled when the token is -- the
    // task itself going on regardless, as .NET's does.

    public Task WaitAsync(CancellationToken cancellationToken)
    {
        return WaitAsync(-1, cancellationToken);
    }

    public Task WaitAsync(TimeSpan timeout)
    {
        return WaitAsync(Timeouts.Milliseconds(timeout, "timeout"), default(CancellationToken));
    }

    public Task WaitAsync(TimeSpan timeout, CancellationToken cancellationToken)
    {
        return WaitAsync(Timeouts.Milliseconds(timeout, "timeout"), cancellationToken);
    }

    Task WaitAsync(int milliseconds, CancellationToken cancellationToken)
    {
        if (IsCompleted || (milliseconds == -1 && !cancellationToken.CanBeCanceled))
        {
            return this;
        }
        if (cancellationToken.IsCancellationRequested)
        {
            return Task.FromCanceled(cancellationToken);
        }
        if (milliseconds == 0)
        {
            return Task.FromException(new TimeoutException());
        }
        Task result = new Task();
        WaitAsyncRace race = new WaitAsyncRace(this, result);
        race.Arm(milliseconds, cancellationToken);
        return result;
    }

    public bool IsCompleted => _state >= RanToCompletion;
    public bool IsCompletedSuccessfully => _state == RanToCompletion;
    public bool IsFaulted => _state == Faulted;
    public bool IsCanceled => _state == Canceled;

    /// Why the task faulted, or null. Null for a canceled task, as in .NET.
    public Exception? Exception
    {
        get
        {
            if (_state == Faulted)
            {
                return _exception;
            }
            return null;
        }
    }

    public TaskStatus Status
    {
        get
        {
            int s = (int)_state;

            if (s == RanToCompletion)
            {
                return TaskStatus.RanToCompletion;
            }
            if (s == Faulted)
            {
                return TaskStatus.Faulted;
            }
            if (s == Canceled)
            {
                return TaskStatus.Canceled;
            }
            return TaskStatus.WaitingForActivation;
        }
    }

    public TaskAwaiter GetAwaiter()
    {
        return new TaskAwaiter(this);
    }

    public ConfiguredTaskAwaitable ConfigureAwait(bool continueOnCapturedContext)
    {
        return new ConfiguredTaskAwaitable(this);
    }

    /// Runs the scheduler until this task is complete, then rethrows what
    /// faulted or canceled it. Throws InvalidOperationException when nothing
    /// left can complete it (see Scheduler.RunUntil).
    public void Wait()
    {
        Scheduler.RunUntil(this);
        ThrowIfNotSuccessful();
    }

    /// Rethrows the ORIGINAL exception of a faulted task; a canceled one
    /// rethrows the OperationCanceledException that canceled it, or a fresh
    /// TaskCanceledException when there was none.
    public void ThrowIfNotSuccessful()
    {
        int s = (int)_state;

        if (s == RanToCompletion)
        {
            return;
        }

        Exception? e = _exception;

        if (s == Faulted && e != null)
        {
            System.Runtime.ExceptionServices.ExceptionDispatchInfo.Throw(e);
            return;
        }
        if (s == Canceled)
        {
            if (e != null)
            {
                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Throw(e);
                return;
            }
            throw new TaskCanceledException(this);
        }
        throw new InvalidOperationException("the task has not completed");
    }

    /// Runs `continuation` with this task once it completes -- posted, never
    /// inline, even when it is already complete.
    public Task ContinueWith(Action<Task> continuation)
    {
        Task next = new Task();
        AddContinuation(new ContinueWithAction(this, continuation, next));
        return next;
    }

    // ---- completion: the compiler's contract ------------------------------

    public void SetResultCore()
    {
        if (!TrySetResult())
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    /// An OperationCanceledException CANCELS the task rather than faulting
    /// it, which is what .NET does when one escapes an async method.
    public void SetExceptionCore(Exception e)
    {
        if (!TrySetException(e))
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetResult()
    {
        if (!TryClaim())
        {
            return false;
        }
        Finish(RanToCompletion);
        return true;
    }

    public bool TrySetException(Exception e)
    {
        if (!TryClaim())
        {
            return false;
        }

        _exception = e;

        if (e is OperationCanceledException)
        {
            Finish(Canceled);
        }
        else
        {
            Finish(Faulted);
        }
        return true;
    }

    /// Canceled with no exception of its own; awaiting it throws a new
    /// TaskCanceledException.
    public bool TrySetCanceled()
    {
        if (!TryClaim())
        {
            return false;
        }
        Finish(Canceled);
        return true;
    }

    public bool TrySetCanceled(OperationCanceledException e)
    {
        if (!TryClaim())
        {
            return false;
        }
        _exception = e;
        Finish(Canceled);
        return true;
    }

    /// Step one of completing: exactly one caller ever gets true.
    public bool TryClaim()
    {
        return Sys.Cas(Atom.At(this, Atom.FirstWord), Incomplete, Claimed) == Incomplete;
    }

    /// Step two for a caller that claimed and stored a result.
    public void FinishSuccess()
    {
        Finish(RanToCompletion);
    }

    /// Step two for a caller that claimed: faults with `e`, whatever it is.
    public void FaultClaimed(Exception e)
    {
        _exception = e;
        Finish(Faulted);
    }

    /// Step two, for the caller that claimed: the outcome is already stored.
    void Finish(int finalState)
    {
        long lockAt = Atom.At(this, Atom.SecondWord);

        Atom.Enter(lockAt);

        Sys.AtomicSwap(Atom.At(this, Atom.FirstWord), finalState);

        Action? first = _first;
        List<Action>? more = _more;
        AsyncContext? firstContext = _firstContext;
        List<AsyncContext?>? moreContexts = _moreContexts;

        _first = null;
        _more = null;
        _firstContext = null;
        _moreContexts = null;

        Atom.Exit(lockAt);

        if (first != null)
        {
            Scheduler.Post(first, firstContext);
        }
        if (more != null)
        {
            for (int i = 0; i < more.Count; i++)
            {
                Scheduler.Post(more[i], moreContexts != null && i < moreContexts.Count ? moreContexts[i] : null);
            }
        }
    }

    /// Step two for a caller that claimed in an interrupt handler and left
    /// the rest to thread context (InterruptCompletions.Drain).
    public void FinishClaimedSuccess()
    {
        Finish(RanToCompletion);
    }

    /// Registers a continuation. Posted at once when the task is already
    /// complete; otherwise kept, in registration order, until it is. The
    /// context it is registered in -- the suspending method's, as .NET
    /// captures ExecutionContext at AwaitUnsafeOnCompleted -- is what it
    /// resumes in (AsyncContext).
    public void AddContinuation(Action continuation)
    {
        // Captured before the lock: capturing may allocate, and nothing is
        // made under an Atom lock.
        AsyncContext? context = AsyncContext.Capture();
        List<AsyncContext?>? contexts = null;
        long lockAt = Atom.At(this, Atom.SecondWord);

        Atom.Enter(lockAt);

        if (_state >= RanToCompletion)
        {
            Atom.Exit(lockAt);
            Scheduler.Post(continuation, context);
            return;
        }

        if (_first == null)
        {
            _first = continuation;
            _firstContext = context;
            Atom.Exit(lockAt);
            return;
        }

        List<Action>? more = _more;

        if (more == null || (context != null && _moreContexts == null))
        {
            // Made outside the lock and tried again: the lists are small and
            // a second registration is rare.
            Atom.Exit(lockAt);
            List<Action> madeMore = more ?? new List<Action>();
            if (context != null || _moreContexts != null) contexts = _moreContexts ?? new List<AsyncContext?>();
            Atom.Enter(lockAt);
            if (_state >= RanToCompletion)
            {
                Atom.Exit(lockAt);
                Scheduler.Post(continuation, context);
                return;
            }
            if (_more == null) _more = madeMore;
            if (contexts != null && _moreContexts == null)
            {
                // Contexts kept in step with the continuations already there.
                for (int i = contexts.Count; i < _more.Count; i++) contexts.Add(null);
                _moreContexts = contexts;
            }
            more = _more;
        }

        more.Add(continuation);
        if (_moreContexts != null) _moreContexts.Add(context);

        Atom.Exit(lockAt);
    }

    // ---- the statics ----------------------------------------------------------

    static Task? _completed;

    /// One already-completed task, shared.
    public static Task CompletedTask
    {
        get
        {
            Task? done = _completed;

            if (done == null)
            {
                done = new Task();
                done.TrySetResult();
                _completed = done;
            }
            return done;
        }
    }

    public static Task FromException(Exception exception)
    {
        Task t = new Task();
        t.TrySetException(exception);
        return t;
    }

    public static Task FromCanceled(CancellationToken cancellationToken)
    {
        Task t = new Task();
        t.TrySetCanceled(new TaskCanceledException());
        return t;
    }

    /// A task that completes after `milliseconds`. Zero is already complete;
    /// -1 never completes (Timeout.Infinite).
    public static Task Delay(int milliseconds)
    {
        return DelayCore(milliseconds, CancellationToken.None);
    }

    public static Task Delay(int milliseconds, CancellationToken cancellationToken)
    {
        return DelayCore(milliseconds, cancellationToken);
    }

    static Task DelayCore(int milliseconds, CancellationToken token)
    {
        if (milliseconds < -1)
        {
            throw new ArgumentOutOfRangeException("milliseconds", "The value needs to be either -1 (signifying an infinite timeout), 0, or a positive integer.");
        }
        if (token.IsCancellationRequested)
        {
            Task canceled = new Task();
            canceled.TrySetCanceled(new TaskCanceledException());
            return canceled;
        }
        if (milliseconds == 0)
        {
            return CompletedTask;
        }

        Task t = new Task();
        DelayCompletion done = new DelayCompletion(t);

        if (milliseconds > 0)
        {
            done.Timer = Scheduler.AddTimer(milliseconds, done);
        }
        if (token.CanBeCanceled)
        {
            done.Registration = token.Register(new DelayCancellation(done));
        }
        return t;
    }

    /// An awaitable that completes by posting: whatever awaits it goes to the
    /// back of the run queue.
    public static YieldAwaitable Yield()
    {
        return new YieldAwaitable();
    }

    /// Queues `action` on the scheduler; the task completes when it has run.
    public static Task Run(Action action)
    {
        Task t = new Task();
        Scheduler.Post(new RunAction(action, t));
        return t;
    }

    /// Queues `function` and completes with the task IT returns (unwrapped).
    public static Task Run(Func<Task> function)
    {
        Task t = new Task();
        Scheduler.Post(new RunTaskFunction(function, t));
        return t;
    }

    public static Task WhenAll(params Task[] tasks)
    {
        int n = tasks.Length;

        if (n == 0)
        {
            return CompletedTask;
        }

        Task all = new Task();
        WhenAllState state = new WhenAllState(tasks, all);

        for (int i = 0; i < n; i++)
        {
            Task one = tasks[i];

            if (one == null)
            {
                throw new ArgumentException("The tasks argument included a null value.");
            }
            one.AddContinuation(state);
        }
        return all;
    }

    public static Task WhenAll(List<Task> tasks)
    {
        return WhenAll(tasks.ToArray());
    }

    /// Any sequence of tasks, as .NET takes it: read once, then waited on.
    public static Task WhenAll(IEnumerable<Task> tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        List<Task> taken = new List<Task>();
        foreach (Task one in tasks)
        {
            taken.Add(one);
        }
        return WhenAll(taken.ToArray());
    }

    /// Completes with the first of `tasks` to complete (which may itself have
    /// faulted: WhenAny never faults).
    public static Task<Task> WhenAny(params Task[] tasks)
    {
        if (tasks.Length == 0)
        {
            throw new ArgumentException("The tasks argument contains no tasks.");
        }

        Task<Task> any = new Task<Task>();

        for (int i = 0; i < tasks.Length; i++)
        {
            Task one = tasks[i];

            if (one == null)
            {
                throw new ArgumentException("The tasks argument included a null value.");
            }
            one.AddContinuation(new WhenAnyPart(one, any));
        }
        return any;
    }

    public static Task<Task> WhenAny(List<Task> tasks)
    {
        return WhenAny(tasks.ToArray());
    }

    /// Every task's result, in the order the tasks were given, once all have
    /// completed -- or the first fault, or a cancellation, as .NET's is.
    public static Task<T[]> WhenAll<T>(params Task<T>[] tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        Task[] plain = new Task[tasks.Length];
        for (int i = 0; i < tasks.Length; i++)
        {
            if (tasks[i] == null)
            {
                throw new ArgumentException("The tasks argument included a null value.");
            }
            plain[i] = tasks[i];
        }
        Task<T[]> made = new Task<T[]>();
        Task all = WhenAll(plain);
        all.AddContinuation(new WhenAllResults<T>(all, tasks, made));
        return made;
    }

    public static Task<T[]> WhenAll<T>(IEnumerable<Task<T>> tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        List<Task<T>> taken = new List<Task<T>>();
        foreach (Task<T> one in tasks)
        {
            taken.Add(one);
        }
        return WhenAll(taken.ToArray());
    }

    /// The first of `tasks` to complete, as the Task<T> it is.
    public static Task<Task<T>> WhenAny<T>(params Task<T>[] tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        Task[] plain = new Task[tasks.Length];
        for (int i = 0; i < tasks.Length; i++)
        {
            plain[i] = tasks[i];
        }
        Task<Task<T>> made = new Task<Task<T>>();
        Task<Task> any = WhenAny(plain);
        any.AddContinuation(new WhenAnyTyped<T>(any, made));
        return made;
    }

    public static Task<Task<T>> WhenAny<T>(IEnumerable<Task<T>> tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        List<Task<T>> taken = new List<Task<T>>();
        foreach (Task<T> one in tasks)
        {
            taken.Add(one);
        }
        return WhenAny(taken.ToArray());
    }

    public static Task<Task> WhenAny(IEnumerable<Task> tasks)
    {
        if (tasks == null)
        {
            throw new ArgumentNullException("tasks");
        }
        List<Task> taken = new List<Task>();
        foreach (Task one in tasks)
        {
            taken.Add(one);
        }
        return WhenAny(taken.ToArray());
    }

    // ---- the .NET generic factories ---------------------------------------

    public static Task<T> FromResult<T>(T result)
    {
        Task<T> t = new Task<T>();
        t.TrySetResult(result);
        return t;
    }

    public static Task<T> Run<T>(Func<T> function)
    {
        Task<T> t = new Task<T>();
        Scheduler.Post(new RunFunction<T>(function, t));
        return t;
    }

    public static Task<T> Run<T>(Func<Task<T>> function)
    {
        Task<T> t = new Task<T>();
        Scheduler.Post(new RunTaskFunction<T>(function, t));
        return t;
    }

    public static Task<T> FromException<T>(Exception exception)
    {
        Task<T> t = new Task<T>();
        t.TrySetException(exception);
        return t;
    }
}

/// A task that completes with a value.
class Task<T> : Task
{
    public override void CopyOutcomeFrom(Task from)
    {
        if (from is Task<T> typed)
        {
            new PropagateResult<T>(typed, this).Invoke();
            return;
        }
        base.CopyOutcomeFrom(from);
    }

    public new Task<T> WaitAsync(CancellationToken cancellationToken)
    {
        return WaitAsyncOf(-1, cancellationToken);
    }

    public new Task<T> WaitAsync(TimeSpan timeout)
    {
        return WaitAsyncOf(Timeouts.Milliseconds(timeout, "timeout"), default(CancellationToken));
    }

    public new Task<T> WaitAsync(TimeSpan timeout, CancellationToken cancellationToken)
    {
        return WaitAsyncOf(Timeouts.Milliseconds(timeout, "timeout"), cancellationToken);
    }

    Task<T> WaitAsyncOf(int milliseconds, CancellationToken cancellationToken)
    {
        if (IsCompleted || (milliseconds == -1 && !cancellationToken.CanBeCanceled))
        {
            return this;
        }
        Task<T> result = new Task<T>();
        if (cancellationToken.IsCancellationRequested)
        {
            result.TrySetCanceled(new TaskCanceledException());
            return result;
        }
        if (milliseconds == 0)
        {
            result.TrySetException(new TimeoutException());
            return result;
        }
        WaitAsyncRace race = new WaitAsyncRace(this, result);
        race.Arm(milliseconds, cancellationToken);
        return result;
    }

    T _result;

    public Task() : base()
    {
    }

    /// The value; runs the scheduler until there is one (as Wait does), and
    /// rethrows what faulted the task.
    public T Result
    {
        get
        {
            if (!IsCompleted)
            {
                Scheduler.RunUntil(this);
            }
            ThrowIfNotSuccessful();
            return _result;
        }
    }

    /// Hides Task.GetAwaiter, as .NET's does: `await` on a Task<T> gets this
    /// one by the static type, and its GetResult answers the value.
    public TaskAwaiter<T> GetAwaiter()
    {
        return new TaskAwaiter<T>(this);
    }

    public ConfiguredTaskAwaitable<T> ConfigureAwait(bool continueOnCapturedContext)
    {
        return new ConfiguredTaskAwaitable<T>(this);
    }

    /// The compiler's contract for `return value;` in an async Task<T>.
    public void SetResultCore(T value)
    {
        if (!TrySetResult(value))
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    /// The result is written between the claim and the final state, so no
    /// reader that sees the task complete can see it without its value.
    public bool TrySetResult(T value)
    {
        if (!TryClaim())
        {
            return false;
        }
        _result = value;
        FinishSuccess();
        return true;
    }

    /// The value of a task already known to have completed successfully.
    public T ResultWhenDone()
    {
        return _result;
    }

    /// Step two for a task an interrupt handler claimed (InterruptCompletions):
    /// its value stored and its continuations posted, in thread context.
    public void FinishClaimed(T value)
    {
        _result = value;
        FinishSuccess();
    }
}

/// STAND-IN for Task.FromResult<T> and Task.Run<T> until the binder bug in
/// the note at the top is fixed. `TaskOf<int>.FromResult(5)`.
static class TaskOf<T>
{
    public static Task<T> FromResult(T result)
    {
        Task<T> t = new Task<T>();
        t.TrySetResult(result);
        return t;
    }

    public static Task<T> Run(Func<T> function)
    {
        Task<T> t = new Task<T>();
        Scheduler.Post(new RunFunction<T>(function, t));
        return t;
    }

    public static Task<T> Run(Func<Task<T>> function)
    {
        Task<T> t = new Task<T>();
        Scheduler.Post(new RunTaskFunction<T>(function, t));
        return t;
    }

    public static Task<T> FromException(Exception exception)
    {
        Task<T> t = new Task<T>();
        t.TrySetException(exception);
        return t;
    }
}

/// Messages shared by Task and TaskCompletionSource. Not on Task itself:
/// inside TaskCompletionSource the name Task is also its property.
static class TaskErrors
{
    public static InvalidOperationException AlreadyCompleted()
    {
        return new InvalidOperationException("An attempt was made to transition a task to a final state when it had already completed.");
    }
}

// ---- awaiters -----------------------------------------------------------------

class TaskAwaiter
{
    Task _task;

    public TaskAwaiter(Task task)
    {
        _task = task;
    }

    public bool IsCompleted => _task.IsCompleted;

    /// The task's outcome, WAITING for it first as .NET's GetResult does when
    /// it is called on a task that has not finished -- `t.GetAwaiter()
    /// .GetResult()` is how synchronous code blocks on an async one.
    public void GetResult()
    {
        if (!_task.IsCompleted)
        {
            Scheduler.RunUntil(_task);
        }
        _task.ThrowIfNotSuccessful();
    }

    public void OnCompleted(Action continuation)
    {
        _task.AddContinuation(continuation);
    }

    public void UnsafeOnCompleted(Action continuation)
    {
        _task.AddContinuation(continuation);
    }
}

class TaskAwaiter<T>
{
    Task<T> _task;

    public TaskAwaiter(Task<T> task)
    {
        _task = task;
    }

    public bool IsCompleted => _task.IsCompleted;

    public T GetResult()
    {
        if (!_task.IsCompleted)
        {
            Scheduler.RunUntil(_task);
        }
        _task.ThrowIfNotSuccessful();
        return _task.ResultWhenDone();
    }

    public void OnCompleted(Action continuation)
    {
        _task.AddContinuation(continuation);
    }

    public void UnsafeOnCompleted(Action continuation)
    {
        _task.AddContinuation(continuation);
    }
}

/// `task.ConfigureAwait(false)`. There is no synchronisation context to
/// leave, so this awaits exactly as the task itself does.
class ConfiguredTaskAwaitable
{
    Task _task;

    public ConfiguredTaskAwaitable(Task task)
    {
        _task = task;
    }

    public TaskAwaiter GetAwaiter()
    {
        return new TaskAwaiter(_task);
    }
}

class ConfiguredTaskAwaitable<T>
{
    Task<T> _task;

    public ConfiguredTaskAwaitable(Task<T> task)
    {
        _task = task;
    }

    public TaskAwaiter<T> GetAwaiter()
    {
        return new TaskAwaiter<T>(_task);
    }
}

/// What Task.Yield() returns. .NET nests the awaiter as
/// YieldAwaitable.YieldAwaiter; nested types are hoisted here, so it is
/// YieldAwaiter.
class YieldAwaitable
{
    public YieldAwaiter GetAwaiter()
    {
        return new YieldAwaiter();
    }
}

class YieldAwaiter
{
    /// Never complete, so an await always suspends and requeues.
    public bool IsCompleted => false;

    public void GetResult()
    {
    }

    public void OnCompleted(Action continuation)
    {
        Scheduler.Post(continuation);
    }

    public void UnsafeOnCompleted(Action continuation)
    {
        Scheduler.Post(continuation);
    }
}

// ---- the continuations the statics above use ----------------------------------

class ContinueWithAction : Action
{
    Task _antecedent;
    Action<Task> _body;
    Task _next;

    public ContinueWithAction(Task antecedent, Action<Task> body, Task next)
    {
        _antecedent = antecedent;
        _body = body;
        _next = next;
    }

    public void Invoke()
    {
        try
        {
            _body.Invoke(_antecedent);
        }
        catch (Exception e)
        {
            _next.TrySetException(e);
            return;
        }
        _next.TrySetResult();
    }
}

class RunAction : Action
{
    Action _body;
    Task _task;

    public RunAction(Action body, Task task)
    {
        _body = body;
        _task = task;
    }

    public void Invoke()
    {
        try
        {
            _body.Invoke();
        }
        catch (Exception e)
        {
            _task.TrySetException(e);
            return;
        }
        _task.TrySetResult();
    }
}

class RunFunction<T> : Action
{
    Func<T> _body;
    Task<T> _task;

    public RunFunction(Func<T> body, Task<T> task)
    {
        _body = body;
        _task = task;
    }

    public void Invoke()
    {
        T value;

        try
        {
            value = _body.Invoke();
        }
        catch (Exception e)
        {
            _task.TrySetException(e);
            return;
        }
        _task.TrySetResult(value);
    }
}

class RunTaskFunction : Action
{
    Func<Task> _body;
    Task _task;

    public RunTaskFunction(Func<Task> body, Task task)
    {
        _body = body;
        _task = task;
    }

    public void Invoke()
    {
        Task? inner;

        try
        {
            inner = _body.Invoke();
        }
        catch (Exception e)
        {
            _task.TrySetException(e);
            return;
        }

        if (inner == null)
        {
            // .NET: a Func<Task> that returns null cancels the proxy.
            _task.TrySetCanceled();
            return;
        }
        inner.AddContinuation(new Propagate(inner, _task));
    }
}

class RunTaskFunction<T> : Action
{
    Func<Task<T>> _body;
    Task<T> _task;

    public RunTaskFunction(Func<Task<T>> body, Task<T> task)
    {
        _body = body;
        _task = task;
    }

    public void Invoke()
    {
        Task<T>? inner;

        try
        {
            inner = _body.Invoke();
        }
        catch (Exception e)
        {
            _task.TrySetException(e);
            return;
        }

        if (inner == null)
        {
            _task.TrySetCanceled();
            return;
        }
        inner.AddContinuation(new PropagateResult<T>(inner, _task));
    }
}

/// Copies the outcome of one Task<T> onto another, value included.
class PropagateResult<T> : Action
{
    Task<T> _from;
    Task<T> _to;

    public PropagateResult(Task<T> from, Task<T> to)
    {
        _from = from;
        _to = to;
    }

    public void Invoke()
    {
        Task<T> from = _from;

        if (from.IsCompletedSuccessfully)
        {
            _to.TrySetResult(from.ResultWhenDone());
            return;
        }

        try
        {
            from.ThrowIfNotSuccessful();
        }
        catch (OperationCanceledException c)
        {
            _to.TrySetCanceled(c);
            return;
        }
        catch (Exception e)
        {
            _to.TrySetException(e);
        }
    }
}

/// Copies the outcome of one task onto another.
class Propagate : Action
{
    Task _from;
    Task _to;

    public Propagate(Task from, Task to)
    {
        _from = from;
        _to = to;
    }

    public void Invoke()
    {
        Task from = _from;

        if (from.IsCompletedSuccessfully)
        {
            _to.TrySetResult();
            return;
        }

        try
        {
            from.ThrowIfNotSuccessful();
        }
        catch (OperationCanceledException c)
        {
            _to.TrySetCanceled(c);
            return;
        }
        catch (Exception e)
        {
            _to.TrySetException(e);
        }
    }
}

/// One object shared by every task in a WhenAll: a countdown, and the result
/// task. Registered as the continuation of each.
/// WhenAll<T>'s last step: the results collected once every task is done,
/// or the fault or cancellation WhenAll carried.
class WhenAllResults<T> : Action
{
    Task _all;
    Task<T>[] _tasks;
    Task<T[]> _made;

    public WhenAllResults(Task all, Task<T>[] tasks, Task<T[]> made)
    {
        _all = all;
        _tasks = tasks;
        _made = made;
    }

    public void Invoke()
    {
        if (_all.IsFaulted && _all.Exception is Exception fault)
        {
            _made.TrySetException(fault);
            return;
        }
        if (_all.IsCanceled)
        {
            try
            {
                _all.ThrowIfNotSuccessful();
            }
            catch (OperationCanceledException oce)
            {
                _made.TrySetCanceled(oce);
                return;
            }
            catch (Exception)
            {
            }
            _made.TrySetCanceled();
            return;
        }
        T[] results = new T[_tasks.Length];
        for (int i = 0; i < _tasks.Length; i++)
        {
            results[i] = _tasks[i].Result;
        }
        _made.TrySetResult(results);
    }
}

/// WhenAny<T>'s last step: the winner handed on as the Task<T> it is.
class WhenAnyTyped<T> : Action
{
    Task<Task> _any;
    Task<Task<T>> _made;

    public WhenAnyTyped(Task<Task> any, Task<Task<T>> made)
    {
        _any = any;
        _made = made;
    }

    public void Invoke()
    {
        _made.TrySetResult((Task<T>)_any.Result);
    }
}

class WhenAllState : Action
{
    // LAYOUT: Remaining must stay the first instance field (see Atom).
    nint _remaining;
    Task[] _tasks;
    Task _all;

    public WhenAllState(Task[] tasks, Task all)
    {
        _remaining = tasks.Length;
        _tasks = tasks;
        _all = all;
    }

    public void Invoke()
    {
        // xadd answers the OLD count: the last task sees 1.
        long before = Sys.AtomicAdd(Atom.At(this, Atom.FirstWord), -1);

        if (before != 1)
        {
            return;
        }

        Task[] tasks = _tasks;
        Exception? canceled = null;
        bool anyCanceled = false;

        for (int i = 0; i < tasks.Length; i++)
        {
            Task one = tasks[i];

            if (one.IsFaulted)
            {
                Exception? e = one.Exception;

                if (e != null)
                {
                    _all.TrySetException(e);
                    return;
                }
            }
            if (one.IsCanceled && !anyCanceled)
            {
                anyCanceled = true;
                try
                {
                    one.ThrowIfNotSuccessful();
                }
                catch (Exception e)
                {
                    canceled = e;
                }
            }
        }

        if (anyCanceled)
        {
            if (canceled is OperationCanceledException oce)
            {
                _all.TrySetCanceled(oce);
            }
            else
            {
                _all.TrySetCanceled();
            }
            return;
        }
        _all.TrySetResult();
    }
}

class WhenAnyPart : Action
{
    Task _one;
    Task<Task> _any;

    public WhenAnyPart(Task one, Task<Task> any)
    {
        _one = one;
        _any = any;
    }

    public void Invoke()
    {
        _any.TrySetResult(_one);
    }
}

class DelayCompletion : Action
{
    Task _task;
    public TimerEntry? Timer;
    public CancellationTokenRegistration? Registration;

    public DelayCompletion(Task task)
    {
        _task = task;
    }

    /// The timer fired.
    public void Invoke()
    {
        if (_task.TrySetResult())
        {
            CancellationTokenRegistration? r = Registration;

            if (r != null)
            {
                r.Dispose();
            }
        }
    }

    public void Cancel()
    {
        if (_task.TrySetCanceled(new TaskCanceledException()))
        {
            TimerEntry? timer = Timer;

            if (timer != null)
            {
                timer.Cancel();
            }
        }
    }
}

class DelayCancellation : Action
{
    DelayCompletion _delay;

    public DelayCancellation(DelayCompletion delay)
    {
        _delay = delay;
    }

    public void Invoke()
    {
        _delay.Cancel();
    }
}

// ---- TaskCompletionSource ------------------------------------------------------

/// A task whose completion is in the caller's hands.
/// What a TaskCompletionSource may be made with, as .NET checks it: a task
/// no delegate runs can only be attached to its parent or have its
/// continuations run asynchronously.
static class TaskCompletionOptions
{
    public static void Check(System.Threading.Tasks.TaskCreationOptions options)
    {
        if ((options & ~(System.Threading.Tasks.TaskCreationOptions.AttachedToParent
                         | System.Threading.Tasks.TaskCreationOptions.RunContinuationsAsynchronously)) != 0)
        {
            throw new ArgumentOutOfRangeException("creationOptions");
        }
    }
}

class TaskCompletionSource<T>
{
    Task<T> _task;

    public TaskCompletionSource()
    {
        _task = new Task<T>();
    }

    public TaskCompletionSource(System.Threading.Tasks.TaskCreationOptions creationOptions) : this(null, creationOptions)
    {
    }

    public TaskCompletionSource(object? state) : this(state, System.Threading.Tasks.TaskCreationOptions.None)
    {
    }

    public TaskCompletionSource(object? state, System.Threading.Tasks.TaskCreationOptions creationOptions)
    {
        TaskCompletionOptions.Check(creationOptions);
        _task = new Task<T>();
        _task.SetCreation(creationOptions, state);
    }

    public Task<T> Task => _task;

    public void SetResult(T result)
    {
        if (!_task.TrySetResult(result))
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetResult(T result)
    {
        return _task.TrySetResult(result);
    }

    public void SetException(Exception exception)
    {
        if (!TrySetException(exception))
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    /// Faults the task, whatever the exception is -- unlike an async method,
    /// .NET's TaskCompletionSource does not turn an
    /// OperationCanceledException into cancellation.
    public bool TrySetException(Exception exception)
    {
        if (!_task.TryClaim())
        {
            return false;
        }
        _task.FaultClaimed(exception);
        return true;
    }

    public void SetCanceled()
    {
        if (!TrySetCanceled())
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetCanceled()
    {
        return _task.TrySetCanceled();
    }

    public bool TrySetCanceled(CancellationToken cancellationToken)
    {
        return _task.TrySetCanceled(new TaskCanceledException());
    }
}

/// WaitAsync's three ways to finish: the source completing (its outcome
/// copied over), the timeout (TimeoutException), or the token (canceled).
/// Whichever comes first settles the result; the others find it settled.
class WaitAsyncRace : Action
{
    Task _source;
    Task _result;
    TimerEntry? _timer;
    CancellationTokenRegistration? _registration;

    public WaitAsyncRace(Task source, Task result)
    {
        _source = source;
        _result = result;
    }

    public void Arm(int milliseconds, CancellationToken token)
    {
        if (milliseconds > 0)
        {
            _timer = Scheduler.AddTimer(milliseconds, new WaitAsyncTimeout(this));
        }
        if (token.CanBeCanceled)
        {
            _registration = token.Register(new WaitAsyncCanceled(this));
        }
        _source.AddContinuation(this);
    }

    /// The source finished: its outcome is the result's.
    public void Invoke()
    {
        Settled();
        _result.CopyOutcomeFrom(_source);
    }

    public void TimedOut()
    {
        if (_result.TrySetException(new TimeoutException()))
        {
            Settled();
        }
    }

    public void Canceled()
    {
        if (_result.TrySetCanceled(new TaskCanceledException()))
        {
            Settled();
        }
    }

    void Settled()
    {
        TimerEntry? timer = _timer;
        if (timer != null)
        {
            timer.Cancel();
        }
        CancellationTokenRegistration? registration = _registration;
        if (registration != null)
        {
            registration.Dispose();
        }
    }
}

class WaitAsyncTimeout : Action
{
    WaitAsyncRace _race;
    public WaitAsyncTimeout(WaitAsyncRace race) { _race = race; }
    public void Invoke() { _race.TimedOut(); }
}

class WaitAsyncCanceled : Action
{
    WaitAsyncRace _race;
    public WaitAsyncCanceled(WaitAsyncRace race) { _race = race; }
    public void Invoke() { _race.Canceled(); }
}

/// The non-generic TaskCompletionSource of .NET 5.
class TaskCompletionSource
{
    Task _task;

    public TaskCompletionSource()
    {
        _task = new Task();
    }

    public TaskCompletionSource(System.Threading.Tasks.TaskCreationOptions creationOptions) : this(null, creationOptions)
    {
    }

    public TaskCompletionSource(object? state) : this(state, System.Threading.Tasks.TaskCreationOptions.None)
    {
    }

    public TaskCompletionSource(object? state, System.Threading.Tasks.TaskCreationOptions creationOptions)
    {
        TaskCompletionOptions.Check(creationOptions);
        _task = new Task();
        _task.SetCreation(creationOptions, state);
    }

    public Task Task => _task;

    public void SetResult()
    {
        if (!_task.TrySetResult())
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetResult()
    {
        return _task.TrySetResult();
    }

    public void SetException(Exception exception)
    {
        if (!TrySetException(exception))
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetException(Exception exception)
    {
        if (!_task.TryClaim())
        {
            return false;
        }
        _task.FaultClaimed(exception);
        return true;
    }

    public void SetCanceled()
    {
        if (!TrySetCanceled())
        {
            throw TaskErrors.AlreadyCompleted();
        }
    }

    public bool TrySetCanceled()
    {
        return _task.TrySetCanceled();
    }
}

// ---- cancellation ------------------------------------------------------------

/// The operation was canceled. C#'s, with the token that canceled it.
class OperationCanceledException : SystemException
{
    CancellationToken _token;

    public OperationCanceledException() : base("The operation was canceled.") { }

    public OperationCanceledException(string? message) : base(message)
    {
    }

    public OperationCanceledException(CancellationToken token) : base("The operation was canceled.")
    {
        _token = token;
    }

    public OperationCanceledException(string message, CancellationToken token) : base(message)
    {
        _token = token;
    }

    public CancellationToken CancellationToken => _token;
    public OperationCanceledException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// A task was canceled.
class TaskCanceledException : OperationCanceledException
{
    Task? _task;

    public TaskCanceledException() : base("A task was canceled.") { }

    public TaskCanceledException(string? message) : base(message)
    {
    }

    public TaskCanceledException(Task task) : base("A task was canceled.")
    {
        _task = task;
    }

    /// The canceled task, when this was raised by awaiting one.
    public Task? Task => _task;
    public TaskCanceledException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// Timeout.Infinite, which Task.Delay accepts.
static class Timeout
{
    public const int Infinite = -1;
}

/// A request to cancel, and everything that asked to hear about it.
///
/// Cancel runs the registered callbacks SYNCHRONOUSLY, most recent first,
/// as .NET does; the first exception any of them throws is rethrown after
/// all have run (.NET wraps them in an AggregateException instead).
class CancellationTokenSource : IDisposable
{
    // LAYOUT: these two must stay the first instance fields (see Atom).
    nint _canceled;
    nint _lock;

    List<Action>? _callbacks;
    TimerEntry? _timer;
    List<CancellationTokenRegistration>? _links;

    public CancellationTokenSource()
    {
        _canceled = 0;
        _lock = 0;
    }

    /// Cancels itself once `delay` has passed.
    public CancellationTokenSource(TimeSpan delay) : this()
    {
        CancelAfter(Timeouts.Milliseconds(delay, "delay"));
    }

    /// Cancels itself after `millisecondsDelay`, once the scheduler runs.
    public CancellationTokenSource(int millisecondsDelay) : this()
    {
        CancelAfter(millisecondsDelay);
    }

    public bool IsCancellationRequested => _canceled != 0;

    public CancellationToken Token => new CancellationToken(this);

    public void Cancel()
    {
        if (Sys.Cas(Atom.At(this, Atom.FirstWord), 0, 1) != 0)
        {
            return;
        }

        TimerEntry? timer = _timer;

        if (timer != null)
        {
            timer.Cancel();
        }

        long lockAt = Atom.At(this, Atom.SecondWord);

        Atom.Enter(lockAt);

        List<Action>? callbacks = _callbacks;

        _callbacks = null;

        Atom.Exit(lockAt);

        if (callbacks == null)
        {
            return;
        }

        Exception? first = null;

        for (int i = callbacks.Count - 1; i >= 0; i--)
        {
            try
            {
                callbacks[i].Invoke();
            }
            catch (Exception e)
            {
                if (first == null)
                {
                    first = e;
                }
            }
        }

        if (first != null)
        {
            throw first;
        }
    }

    public void CancelAfter(int millisecondsDelay)
    {
        if (millisecondsDelay < -1)
        {
            throw new ArgumentOutOfRangeException("millisecondsDelay");
        }
        if (IsCancellationRequested || millisecondsDelay == -1)
        {
            return;
        }

        TimerEntry? old = _timer;

        if (old != null)
        {
            old.Cancel();
        }
        _timer = Scheduler.AddTimer(millisecondsDelay, new CancelAction(this));
    }

    public void CancelAfter(TimeSpan delay)
    {
        CancelAfter(Timeouts.Milliseconds(delay, "delay"));
    }

    /// Cancels, as Cancel does, and answers a task that is complete once it
    /// has (.NET 8's CancelAsync).
    public Task CancelAsync()
    {
        Cancel();
        return Task.CompletedTask;
    }

    /// Stops its timer and, for a linked source, lets go of the tokens it
    /// was following -- their sources keep no callback for a source that is
    /// gone.
    public void Dispose()
    {
        TimerEntry? timer = _timer;

        if (timer != null)
        {
            timer.Cancel();
        }

        List<CancellationTokenRegistration>? links = _links;
        _links = null;

        if (links != null)
        {
            for (int i = 0; i < links.Count; i++)
            {
                links[i].Dispose();
            }
        }
    }

    /// Adds `callback`; runs it at once (on this thread) when already
    /// canceled, which is .NET's rule.
    public CancellationTokenRegistration Register(Action callback)
    {
        long lockAt = Atom.At(this, Atom.SecondWord);

        Atom.Enter(lockAt);

        if (_canceled != 0)
        {
            Atom.Exit(lockAt);
            callback.Invoke();
            return new CancellationTokenRegistration(null, callback);
        }

        List<Action>? callbacks = _callbacks;

        if (callbacks == null)
        {
            callbacks = new List<Action>();
            _callbacks = callbacks;
        }
        callbacks.Add(callback);

        Atom.Exit(lockAt);
        return new CancellationTokenRegistration(this, callback);
    }

    public void Unregister(Action callback)
    {
        long lockAt = Atom.At(this, Atom.SecondWord);

        Atom.Enter(lockAt);

        List<Action>? callbacks = _callbacks;

        if (callbacks != null)
        {
            callbacks.Remove(callback);
        }

        Atom.Exit(lockAt);
    }

    static CancellationTokenSource? _canceledSource;

    /// One source that is already canceled, behind `new CancellationToken(true)`.
    public static CancellationTokenSource AlreadyCanceled
    {
        get
        {
            CancellationTokenSource? s = _canceledSource;

            if (s == null)
            {
                s = new CancellationTokenSource();
                s.Cancel();
                _canceledSource = s;
            }
            return s;
        }
    }

    /// A source canceled when any of the tokens is (or already canceled,
    /// when one of them already is).
    public static CancellationTokenSource CreateLinkedTokenSource(CancellationToken first, CancellationToken second)
    {
        CancellationTokenSource linked = new CancellationTokenSource();
        linked.Follow(first);
        linked.Follow(second);
        return linked;
    }

    public static CancellationTokenSource CreateLinkedTokenSource(CancellationToken token)
    {
        CancellationTokenSource linked = new CancellationTokenSource();
        linked.Follow(token);
        return linked;
    }

    public static CancellationTokenSource CreateLinkedTokenSource(params CancellationToken[] tokens)
    {
        if (tokens == null)
        {
            throw new ArgumentNullException("tokens");
        }
        CancellationTokenSource linked = new CancellationTokenSource();
        for (int i = 0; i < tokens.Length; i++)
        {
            linked.Follow(tokens[i]);
        }
        return linked;
    }

    void Follow(CancellationToken token)
    {
        if (!token.CanBeCanceled)
        {
            return;
        }
        CancellationTokenRegistration registration = token.Register(new CancelAction(this));
        List<CancellationTokenRegistration> links = _links ??= new List<CancellationTokenRegistration>();
        links.Add(registration);
    }
}

class CancelAction : Action
{
    CancellationTokenSource _source;

    public CancelAction(CancellationTokenSource source)
    {
        _source = source;
    }

    public void Invoke()
    {
        _source.Cancel();
    }
}

/// A way to observe one CancellationTokenSource. A struct, as in .NET, so
/// `default` and CancellationToken.None are a token nothing can cancel.
struct CancellationToken
{
    CancellationTokenSource? _source;

    public CancellationToken(CancellationTokenSource source)
    {
        _source = source;
    }

    /// `new CancellationToken(true)` is already canceled.
    public CancellationToken(bool canceled)
    {
        if (canceled)
        {
            _source = CancellationTokenSource.AlreadyCanceled;
        }
        else
        {
            _source = null;
        }
    }

    public static CancellationToken None => new CancellationToken(false);

    public bool CanBeCanceled => _source != null;

    public bool IsCancellationRequested
    {
        get
        {
            CancellationTokenSource? s = _source;

            if (s == null)
            {
                return false;
            }
            return s.IsCancellationRequested;
        }
    }

    public void ThrowIfCancellationRequested()
    {
        if (IsCancellationRequested)
        {
            throw new OperationCanceledException(this);
        }
    }

    public CancellationTokenRegistration Register(Action callback)
    {
        CancellationTokenSource? s = _source;

        if (s == null)
        {
            return new CancellationTokenRegistration(null, callback);
        }
        return s.Register(callback);
    }
}

/// What Register hands back; Dispose removes the callback. A class here
/// (a struct in .NET) so that "no registration" is simply null.
class CancellationTokenRegistration : IDisposable
{
    CancellationTokenSource? _source;
    Action _callback;

    public CancellationTokenRegistration(CancellationTokenSource? source, Action callback)
    {
        _source = source;
        _callback = callback;
    }

    public void Dispose()
    {
        CancellationTokenSource? s = _source;

        if (s != null)
        {
            s.Unregister(_callback);
            _source = null;
        }
    }

    public bool Unregister()
    {
        CancellationTokenSource? s = _source;

        if (s == null)
        {
            return false;
        }
        s.Unregister(_callback);
        _source = null;
        return true;
    }
}

// ---- the scheduler -----------------------------------------------------------

/// One pending timer: a deadline on the monotonic clock and what to post.
class TimerEntry
{
    public long Deadline;
    public long Sequence;
    public Action Callback;
    public bool Canceled;

    public TimerEntry(long deadline, long sequence, Action callback)
    {
        Deadline = deadline;
        Sequence = sequence;
        Callback = callback;
    }

    /// Stops it firing. The entry stays in the heap and is discarded when it
    /// reaches the top.
    public void Cancel()
    {
        Canceled = true;
    }

    /// Earlier deadline first; equal deadlines in the order they were added.
    public bool Before(TimerEntry other)
    {
        if (Deadline != other.Deadline)
        {
            return Deadline < other.Deadline;
        }
        return Sequence < other.Sequence;
    }
}

/// The body of a pool thread: one object, started once, never returns.
class PoolWorker : Action
{
    public void Invoke()
    {
        Scheduler.WorkerLoop();
    }
}

/// The single-threaded event loop: a run queue and a timer heap.
///
/// RUN QUEUE. A growable ring of Action, as Queue<T> is: posting stores one
/// reference and moves a count, allocating only when the ring doubles. Taken
/// under a spin lock (an AtomicCell), so a pool of threads can post and take
/// without a change here.
///
/// TIMERS. A binary min-heap of TimerEntry ordered by (deadline, sequence),
/// deadlines in nanoseconds of CLOCK_MONOTONIC. A timer that fires is POSTED
/// like any other work; cancellation marks the entry and it is dropped when
/// it reaches the top.
///
/// THE LOOP (RunUntil). While the awaited task is incomplete: run everything
/// that was queued at the start of the round (so a task that keeps yielding
/// cannot starve a timer), then post every timer that is due. When the queue
/// is empty and no timer is due, sleep until the nearest deadline with
/// clock_nanosleep(TIMER_ABSTIME). When the queue is empty and there are no
/// timers, nothing left can complete the task: that is a deadlock, and it is
/// reported rather than hung on. (When descriptor readiness arrives, a
/// pending wait on a descriptor will count as something that can.)
///
/// An exception escaping a posted item is unhandled, as it is on a .NET
/// thread-pool thread: the compiler's continuations catch everything
/// themselves, so only user work items can do this.
static partial class Scheduler
{
    // Made on first use, not at start-up: a static initialiser runs before
    // Main, and on bare metal Main is what says where the heap is.
    static Action?[] _ring = null!;
    static AsyncContext?[] _ringContexts = null!;
    static int _head;
    static int _count;
    static AtomicCell? _gate;

    static TimerEntry?[] _timers = null!;
    static int _timerCount;
    static long _timerSequence;

    static AtomicCell Gate()
    {
        AtomicCell? g = _gate;

        if (g == null)
        {
            Atom.CheckLayout();
            _ring = new Action?[16];
            _ringContexts = new AsyncContext?[16];
            _timers = new TimerEntry?[8];
            g = new AtomicCell();
            _gate = g;
        }
        return g;
    }

    // ---- the thread pool ----------------------------------------------------
    //
    // Off by default: with no workers this is the single-threaded event loop it
    // has always been, and every program's ordering is what it was. UseThreads
    // starts workers that pull from the SAME run queue -- the one behind the
    // spin lock above -- so nothing else in this file changes: Task.Run posts,
    // a completion posts its continuations, and whoever is free runs them.
    //
    // WAKING. A counter beside the queue, bumped on every Post and futex-woken;
    // an idle worker reads it, re-checks the queue, and sleeps on that exact
    // value, so a Post that lands between the two cannot be missed.

    static int _workers;
    static AtomicCell? _signal;

    static AtomicCell SignalCell()
    {
        AtomicCell? s = _signal;

        if (s == null)
        {
            Atom.CheckLayout();
            s = new AtomicCell();
            _signal = s;
        }
        return s;
    }

    /// How many pool threads are running; 0 is the single-threaded loop.
    public static int WorkerCount => _workers;


    /// Makes room for `capacity` queued items without further allocation.
    public static void Reserve(int capacity)
    {
        AtomicCell gate = Gate();

        gate.Enter();

        while (_ring.Length < capacity)
        {
            Grow();
        }

        gate.Exit();
    }

    static void WakeOneWorker()
    {
        AtomicCell signal = SignalCell();
        long at = Atom.At(signal, Atom.FirstWord);

        Sys.AtomicAdd(at, 1);
        Native.Wake(at, 1);
    }

    /// A worker: run whatever is queued, and sleep on the signal word when
    /// there is nothing. It never returns; the process ends through
    /// exit_group(2), which takes every thread with it.
    public static void WorkerLoop()
    {
        AtomicCell signal = SignalCell();
        long at = Atom.At(signal, Atom.FirstWord);

        while (true)
        {
            AsyncContext? context;
            Action? work = Take(out context);

            if (work != null)
            {
                // RunOne, like the event loop: the handler chain is this
                // thread's own, so a work item that throws is caught here and
                // reported rather than taking the process with it.
                RunOne(work, context);
                continue;
            }

            long seen = Sys.PeekWord(at);

            // Re-read the queue after reading the counter: a Post in between
            // bumps the counter, and then the futex wait returns at once.
            if (_count > 0)
            {
                continue;
            }
            Native.Wait(at, seen);
        }
    }

    /// Queues `work` to run on the scheduler, after everything already queued,
    /// in the context of whoever posts it (AsyncContext).
    public static void Post(Action work)
    {
        Post(work, AsyncContext.Capture());
    }

    /// Queues `work` to run in `context` (null: none to enter). WHERE IT GOES
    /// IS THE PLATFORM'S: a kernel that runs the continuations itself installs
    /// Platform.PostHook, and the work goes onto its run queue, drained by its
    /// own scheduler loop (RunPosted); otherwise this scheduler's ring.
    public static void Post(Action work, AsyncContext? context)
    {
        if (work == null)
        {
            throw new ArgumentNullException("work");
        }

        if (Platform.PostHook != 0)
        {
            Sys.Call(Platform.PostHook, Sys.Word(work), Sys.Word(context), 0);
            return;
        }

        AtomicCell gate = Gate();

        gate.Enter();

        if (_count == _ring.Length)
        {
            Grow();
        }

        int at = _head + _count;

        if (at >= _ring.Length)
        {
            at = at - _ring.Length;
        }
        _ring[at] = work;
        _ringContexts[at] = context;
        _count = _count + 1;

        gate.Exit();

        if (_workers > 0)
        {
            WakeOneWorker();
        }
    }

    /// How many items are waiting to run.
    public static int Pending => _count;

    static Action? Take(out AsyncContext? context)
    {
        AtomicCell gate = Gate();

        gate.Enter();

        if (_count == 0)
        {
            gate.Exit();
            context = null;
            return null;
        }

        Action? work = _ring[_head];
        context = _ringContexts[_head];

        // Cleared, so the ring does not keep finished work alive.
        _ring[_head] = null;
        _ringContexts[_head] = null;
        _head = _head + 1;
        if (_head == _ring.Length)
        {
            _head = 0;
        }
        _count = _count - 1;

        gate.Exit();
        return work;
    }

    /// Doubles the ring, straightening it so the head is at zero. Called with
    /// the gate held.
    static void Grow()
    {
        Action?[] old = _ring;
        AsyncContext?[] oldContexts = _ringContexts;
        Action?[] bigger = new Action?[old.Length * 2];
        AsyncContext?[] biggerContexts = new AsyncContext?[old.Length * 2];

        for (int i = 0; i < _count; i++)
        {
            int at = _head + i;

            if (at >= old.Length)
            {
                at = at - old.Length;
            }
            bigger[i] = old[at];
            biggerContexts[i] = oldContexts[at];
        }

        _ring = bigger;
        _ringContexts = biggerContexts;
        _head = 0;
    }

    static void RunOne(Action work, AsyncContext? context)
    {
        Exception? failed = RunPosted(work, context);
        if (failed != null)
        {
            AsyncRuntime.Unhandled(failed);
        }
    }

    /// One posted item run in its context -- entered first, left after,
    /// whatever it did (AsyncContext.Enter) -- answering what escaped it, or
    /// null. What a kernel's scheduler loop calls for each item its PostHook
    /// was given: an exception there is the kernel's to report, never a
    /// reason to stop the machine as Unhandled stops a program.
    public static Exception? RunPosted(Action work, AsyncContext? context)
    {
        AsyncContextSaved saved = default(AsyncContextSaved);
        if (context != null) saved = AsyncContext.Enter(context);
        try
        {
            work.Invoke();
            return null;
        }
        catch (Exception e)
        {
            return e;
        }
        finally
        {
            if (context != null) AsyncContext.Leave(context, saved);
        }
    }

    // ---- what a kernel driving this scheduler from its own loop asks ------------

    /// Every timer that is due by now posted (through PostHook, to the
    /// kernel's queue), and every task an interrupt handler completed since
    /// the last look finished (InterruptCompletions.Drain). Called by the
    /// kernel's scheduler loop; nothing here sleeps.
    public static void RunDue()
    {
        Gate();
        InterruptCompletions.Drain();
        DropCanceledTimers();
        if (_timerCount > 0)
        {
            PostDueTimers(Clock.Now());
        }
    }

    /// When the soonest live timer is due, on Clock.Now's scale, or -1 for
    /// none: what a tickless kernel arms its clock for. SoonestHint set to
    /// it as well.
    public static long NextDeadline()
    {
        Gate();
        DropCanceledTimers();
        AtomicCell gate = Gate();
        gate.Enter();
        TimerEntry? next = _timerCount > 0 ? _timers[0] : null;
        long due = next != null ? next.Deadline : -1;
        _soonest = due + 1;
        gate.Exit();
        return due;
    }

    /// THE SOONEST TIMER, AS A WORD TO READ WITH NO GATE: what a kernel's
    /// clock interrupt asks when it sets the clock for the next thing due --
    /// it may not take the scheduler's gate, which the code it interrupted
    /// may hold. Lowered by every AddTimer, set exactly by NextDeadline; a
    /// timer canceled since leaves it early, which costs one look. -1: none.
    public static long SoonestHint => _soonest - 1;

    // The deadline plus one, 0 for none: zero-initialised, so Scheduler keeps
    // no static constructor (one would run before a bare-metal Main says
    // where the heap is).
    static long _soonest;

    /// Runs queued work and timers until `task` completes. Throws
    /// InvalidOperationException when nothing left could complete it.
    public static void RunUntil(Task task)
    {
        Gate();

        if (_workers > 0)
        {
            RunUntilWithWorkers(task);
            return;
        }

        while (!task.IsCompleted)
        {
            // One round: only what was queued when it began.
            int round = _count;

            while (round > 0 && !task.IsCompleted)
            {
                AsyncContext? context;
                Action? work = Take(out context);

                if (work == null)
                {
                    break;
                }
                RunOne(work, context);
                round = round - 1;
            }

            if (task.IsCompleted)
            {
                return;
            }

            // What interrupt handlers completed since the last round: their
            // continuations posted for the next.
            InterruptCompletions.Drain();
            if (_count > 0)
            {
                continue;
            }

            DropCanceledTimers();

            if (_timerCount > 0)
            {
                long now = Clock.Now();

                PostDueTimers(now);

                if (_count == 0)
                {
                    DropCanceledTimers();

                    TimerEntry? next = _timers[0];

                    if (_timerCount > 0 && next != null && next.Deadline > now)
                    {
                        long until = Waking(now, next.Deadline);
                        // A completion an interrupt may bring is looked for
                        // every InterruptPollNanos, not only at the timer.
                        if (InterruptCompletions.Armed > 0 && until > now + InterruptPollNanos) until = now + InterruptPollNanos;
                        Clock.SleepUntil(until);
                    }
                }
                continue;
            }

            if (_count == 0)
            {
                // AN INTERRUPT MAY STILL COMPLETE IT: a device with a task
                // armed for its completion (InterruptCompletions.Arm).
                if (InterruptCompletions.Armed > 0)
                {
                    long at = Clock.Now();
                    Clock.SleepUntil(at + InterruptPollNanos);
                    continue;
                }
                // ANOTHER THREAD MAY STILL COMPLETE IT: one that took the item
                // from this queue, or one that completes it directly.
                if (GcThreads.Others())
                {
                    long at = Clock.Now();
                    Clock.SleepUntil(Waking(at, at + OthersPollNanos));
                    continue;
                }
                throw new InvalidOperationException("deadlock: nothing can complete this task");
            }
        }
    }

    // How long a wait sleeps before it looks again while other threads run.
    const long OthersPollNanos = 200000;

    // And while a device may complete a task from its interrupt: on bare
    // metal the sleep halts until the next interrupt anyway, so this bounds
    // only a sleep the clock would otherwise make longer.
    const long InterruptPollNanos = 1000000;

    /// WHEN A SLEEPING WAIT LOOKS AGAIN: at the deadline it sleeps for, or
    /// sooner while other threads run. The queue is everybody's, so the item
    /// that completes this thread's task may run on another, which wakes
    /// nobody: the native link's backends shared it, one ran another's read,
    /// and the waiter slept on to its five-minute timer while the response
    /// had long since come.
    static long Waking(long now, long deadline)
    {
        if (GcThreads.Others() && deadline > now + OthersPollNanos) return now + OthersPollNanos;
        return deadline;
    }

    /// Waiting for a task while workers run the queue. The queue is theirs --
    /// this thread taking an item could block on something only a worker can
    /// finish -- but the timers stay here, because the timer heap is driven by
    /// whoever sleeps on the clock and that is still this thread.
    ///
    /// It polls rather than sleeping on the task's own word: a futex wait on
    /// the state word would make every completion pay for a wake. The interval
    /// is short enough not to show up beside the work and long enough not to
    /// spin a processor.
    static void RunUntilWithWorkers(Task task)
    {
        const long PollNanos = OthersPollNanos;

        while (!task.IsCompleted)
        {
            DropCanceledTimers();

            long now = Clock.Now();

            if (_timerCount > 0)
            {
                PostDueTimers(now);
            }

            if (task.IsCompleted)
            {
                return;
            }

            long until = now + PollNanos;
            TimerEntry? next = _timers[0];

            if (_timerCount > 0 && next != null && next.Deadline > now && next.Deadline < until)
            {
                until = next.Deadline;
            }
            Clock.SleepUntil(until);
        }
    }

    /// Runs everything queued, and every timer, until there is nothing left
    /// at all. For programs that post work without a task to wait on.
    public static void RunUntilIdle()
    {
        Gate();

        while (true)
        {
            AsyncContext? context;
            Action? work = Take(out context);

            if (work != null)
            {
                RunOne(work, context);
                continue;
            }

            DropCanceledTimers();

            if (_timerCount == 0)
            {
                return;
            }

            long now = Clock.Now();

            PostDueTimers(now);

            TimerEntry? next = _timers[0];

            if (_count == 0 && _timerCount > 0 && next != null && next.Deadline > now)
            {
                Clock.SleepUntil(next.Deadline);
            }
        }
    }

    // ---- timers ---------------------------------------------------------------

    /// Posts `callback` after `milliseconds` (from now).
    public static TimerEntry AddTimer(int milliseconds, Action callback)
    {
        long deadline = Clock.Now() + (long)milliseconds * 1000000;
        return AddTimerAt(deadline, callback);
    }

    /// Posts `callback` once CLOCK_MONOTONIC reaches `deadline` (nanoseconds).
    public static TimerEntry AddTimerAt(long deadline, Action callback)
    {
        Gate();
        AtomicCell gate = Gate();

        gate.Enter();

        _timerSequence = _timerSequence + 1;

        TimerEntry entry = new TimerEntry(deadline, _timerSequence, callback);

        if (_timerCount == _timers.Length)
        {
            TimerEntry?[] bigger = new TimerEntry?[_timers.Length * 2];

            for (int i = 0; i < _timerCount; i++)
            {
                bigger[i] = _timers[i];
            }
            _timers = bigger;
        }

        int at = _timerCount;

        _timerCount = _timerCount + 1;
        _timers[at] = entry;
        SiftUp(at);
        if (_soonest == 0 || deadline + 1 < _soonest) _soonest = deadline + 1;

        gate.Exit();
        return entry;
    }

    /// How many timers are in the heap, canceled ones included.
    public static int TimerCount => _timerCount;

    static void DropCanceledTimers()
    {
        AtomicCell gate = Gate();

        gate.Enter();

        while (_timerCount > 0)
        {
            TimerEntry? top = _timers[0];

            if (top != null && !top.Canceled)
            {
                break;
            }
            RemoveTop();
        }

        gate.Exit();
    }

    static void PostDueTimers(long now)
    {
        while (true)
        {
            AtomicCell gate = Gate();

            gate.Enter();

            TimerEntry? top = null;

            if (_timerCount > 0)
            {
                top = _timers[0];
            }

            if (top == null || top.Deadline > now)
            {
                gate.Exit();
                return;
            }

            RemoveTop();
            gate.Exit();

            // A timer's callback is the runtime's own (a delay completing, a
            // cancellation): no context of anybody's to enter.
            if (!top.Canceled)
            {
                Post(top.Callback, null);
            }
        }
    }

    /// Called with the gate held and _timerCount > 0.
    static void RemoveTop()
    {
        int last = _timerCount - 1;

        _timers[0] = _timers[last];
        _timers[last] = null;
        _timerCount = last;

        if (last > 0)
        {
            SiftDown(0);
        }
    }

    static void SiftUp(int at)
    {
        TimerEntry? moving = _timers[at];

        if (moving == null)
        {
            return;
        }

        while (at > 0)
        {
            int parent = (at - 1) >> 1;
            TimerEntry? above = _timers[parent];

            if (above == null || !moving.Before(above))
            {
                break;
            }
            _timers[at] = above;
            at = parent;
        }
        _timers[at] = moving;
    }

    static void SiftDown(int at)
    {
        TimerEntry? moving = _timers[at];

        if (moving == null)
        {
            return;
        }

        while (true)
        {
            int child = at * 2 + 1;

            if (child >= _timerCount)
            {
                break;
            }

            TimerEntry? pick = _timers[child];
            int right = child + 1;

            if (right < _timerCount)
            {
                TimerEntry? other = _timers[right];

                if (other != null && pick != null && other.Before(pick))
                {
                    child = right;
                    pick = other;
                }
            }

            if (pick == null || !pick.Before(moving))
            {
                break;
            }
            _timers[at] = pick;
            at = child;
        }
        _timers[at] = moving;
    }
}


/// .NET's ThreadPool, as a facade over the scheduler. Work queued here runs
/// on the event loop today and on pool threads when there are some.
// ---- System.Threading.Monitor -------------------------------------------------
//
// What `lock (x) { ... }` expands to (Monitor.Enter, then Exit in a finally),
// with .NET's contract: REENTRANT -- a thread that holds an object's lock may
// lock it again, and must exit as many times -- owned, so an Exit by a thread
// that does not hold it throws SynchronizationLockException, and waitable
// (Monitor.Wait/Pulse, in the platform's half of this class).
//
// THE OBJECT'S SYNC WORD SAYS WHO HOLDS IT: 0 free, otherwise the owner the
// platform names (Platform.MonitorOwner -- a hosted thread's thread block),
// bit 0 set while somebody may be asleep waiting for it. A thread that locks
// again is counted in a side table, since recursion is the exception.
//
// A PLATFORM WITH NO IDENTITY TO GIVE -- the bare-metal kernel, where a
// "thread" is a processor and a task holding a lock can resume on another
// one -- answers 0, and the lock is what it always was there: a spin on the
// word, held or not, with no owner to check and nobody asleep on it.
static partial class Monitor
{
    const long Held = 2;            // the owner written when there is no identity
    const long Asleep = 1;          // bit 0: someone may be waiting on the word

    static int _depthGate;
    static Dictionary<long, int>? _depths;

    static long Owner()
    {
        long me = Platform.MonitorOwner();
        return me == 0 ? 0 : me & ~Asleep;
    }

    public static void Enter(object obj)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        long word = Sys.SyncWord(obj);
        long me = Owner();

        if (me == 0)
        {
            while (Sys.Cas(word, 0, Held) != 0) { Sys.Pause(); }
            return;
        }

        long seen = Sys.Cas(word, 0, me);

        if (seen == 0)
        {
            return;
        }
        if ((seen & ~Asleep) == me)
        {
            Deepen(word, 1);
            return;
        }
        Contend(word, me);
    }

    /// .NET's form: lockTaken says whether the lock was taken, and must be
    /// false on the way in.
    public static void Enter(object obj, ref bool lockTaken)
    {
        if (lockTaken)
        {
            throw new ArgumentException("The lockTaken argument must be set to false before calling this method.", "lockTaken");
        }
        Enter(obj);
        lockTaken = true;
    }

    /// Takes the lock without waiting, or says it could not.
    public static bool TryEnter(object obj)
    {
        return TryEnter(obj, 0);
    }

    public static void TryEnter(object obj, ref bool lockTaken)
    {
        if (lockTaken)
        {
            throw new ArgumentException("The lockTaken argument must be set to false before calling this method.", "lockTaken");
        }
        lockTaken = TryEnter(obj, 0);
    }

    public static bool TryEnter(object obj, TimeSpan timeout)
    {
        return TryEnter(obj, Timeouts.Milliseconds(timeout, "timeout"));
    }

    public static void TryEnter(object obj, int millisecondsTimeout, ref bool lockTaken)
    {
        if (lockTaken)
        {
            throw new ArgumentException("The lockTaken argument must be set to false before calling this method.", "lockTaken");
        }
        lockTaken = TryEnter(obj, millisecondsTimeout);
    }

    /// Takes the lock within the timeout (-1 for as long as it takes, 0 for
    /// not at all), or says it could not.
    public static bool TryEnter(object obj, int millisecondsTimeout)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        if (millisecondsTimeout < -1)
        {
            throw new ArgumentOutOfRangeException("millisecondsTimeout");
        }
        if (millisecondsTimeout == -1)
        {
            Enter(obj);
            return true;
        }
        long word = Sys.SyncWord(obj);
        long me = Owner();
        long mark = me == 0 ? Held : me;
        long deadline = Clock.NowMilliseconds() + millisecondsTimeout;

        while (true)
        {
            long seen = Sys.Cas(word, 0, mark);

            if (seen == 0)
            {
                return true;
            }
            if (me != 0 && (seen & ~Asleep) == me)
            {
                Deepen(word, 1);
                return true;
            }
            if (Clock.NowMilliseconds() >= deadline)
            {
                return false;
            }
            Sys.Pause();
        }
    }

    public static void Exit(object obj)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        long word = Sys.SyncWord(obj);
        long me = Owner();

        if (me == 0)
        {
            Sys.AtomicSwap(word, 0);
            return;
        }
        // THE WHOLE WORD: an owner is a thread block's address, above 4 GB in
        // long mode, and PeekWord reads 32 bits of it -- every lock taken on a
        // 64-bit thread was "not held" by it on the way out.
        if ((Sys.Peek(word) & ~Asleep) != me)
        {
            throw new SynchronizationLockException();
        }
        if (Deepen(word, -1))
        {
            return;
        }
        Release(word);
    }

    /// Whether this thread holds the object's lock. Where there is no
    /// identity, whether anybody does.
    public static bool IsEntered(object obj)
    {
        if (obj == null)
        {
            throw new ArgumentNullException("obj");
        }
        long me = Owner();
        long seen = Sys.Peek(Sys.SyncWord(obj));
        return me == 0 ? seen != 0 : (seen & ~Asleep) == me;
    }

    /// Lets the word go, waking one sleeper if the word said there might be one.
    static void Release(long word)
    {
        if ((Sys.AtomicSwap(word, 0) & Asleep) != 0)
        {
            Platform.MonitorWake(word);
        }
    }

    /// Waits for the word to come free and takes it, marked as possibly
    /// waited on: the sleeper that took it cannot know it was the last.
    static void Contend(long word, long me)
    {
        int spins = 0;

        while (true)
        {
            long seen = Sys.Peek(word);

            if (seen == 0)
            {
                if (Sys.Cas(word, 0, me | Asleep) == 0)
                {
                    return;
                }
                continue;
            }
            if (spins < 64)
            {
                spins = spins + 1;
                Sys.Pause();
                continue;
            }
            if ((seen & Asleep) == 0 && Sys.Cas(word, seen, seen | Asleep) != seen)
            {
                continue;
            }
            Platform.MonitorBlock(word, seen | Asleep);
        }
    }

    /// Changes the extra depth a held word is counted at by `by`, saying,
    /// for a decrease, whether there was depth to take (the lock is then
    /// still held).
    static bool Deepen(long word, int by)
    {
        long gate = Sys.AddressOf(ref _depthGate);

        while (Sys.Cas(gate, 0, 1) != 0) { Sys.Pause(); }
        bool had = false;
        try
        {
            Dictionary<long, int> depths = _depths ??= new Dictionary<long, int>();
            depths.TryGetValue(word, out int depth);
            if (by > 0)
            {
                depths[word] = depth + by;
                had = true;
            }
            else if (depth > 0)
            {
                if (depth == 1) depths.Remove(word);
                else depths[word] = depth - 1;
                had = true;
            }
        }
        finally
        {
            Sys.AtomicSwap(gate, 0);
        }
        return had;
    }

    /// The extra depth, taken off the table whole (Monitor.Wait gives the
    /// lock up entirely and must restore every level when it takes it back).
    static int TakeDepth(long word)
    {
        long gate = Sys.AddressOf(ref _depthGate);

        while (Sys.Cas(gate, 0, 1) != 0) { Sys.Pause(); }
        int depth = 0;
        try
        {
            if (_depths != null && _depths.TryGetValue(word, out depth)) _depths.Remove(word);
        }
        finally
        {
            Sys.AtomicSwap(gate, 0);
        }
        return depth;
    }

    static void RestoreDepth(long word, int depth)
    {
        if (depth > 0)
        {
            Deepen(word, depth);
        }
    }
}

/// Timeout arguments as .NET checks them: a TimeSpan in milliseconds, -1 for
/// infinite, and anything else negative or past int.MaxValue refused.
static class Timeouts
{
    public static int Milliseconds(TimeSpan timeout, string name)
    {
        long ms = (long)timeout.TotalMilliseconds;
        if (ms < -1 || ms > int.MaxValue)
        {
            throw new ArgumentOutOfRangeException(name);
        }
        return (int)ms;
    }
}

static class ThreadPool
{
    public static bool QueueUserWorkItem(Action callBack)
    {
        Scheduler.Post(callBack);
        return true;
    }

    public static bool UnsafeQueueUserWorkItem(Action callBack)
    {
        Scheduler.Post(callBack);
        return true;
    }
}

// ---- real threads ------------------------------------------------------------
//
// WHEN THIS FILE BECOMES A SHARED OBJECT. Nothing below reaches into another
// module's data or depends on an address the linker folded: every caller enters
// through a function (Thread.Start, Thread.CurrentId, Scheduler.UseThreads,
// Scheduler.Post), the scheduler's and the registry's state are statics of this
// module and of no other, and the one code address taken -- Sys.AddressOf of
// the thread entry -- is taken at run time and handed to run-time-generated
// code, so a position-independent load is free to put it anywhere. What is NOT
// The state that used to be on the other side of the boundary -- the exception
// handler chain's head and the stack a thread stands on, one word of the
// executable's .bss each -- is now a block per thread (lib/rt/runtime.cor,
// class Tls), reached through GS, so a thread other than the first can throw,
// catch and allocate, and the collector sees every thread's stack.



// ---- the things threads wait on ----------------------------------------------




// ---- the context a continuation resumes in --------------------------------------
//
// AS .NET FLOWS ExecutionContext: what is "current" when an await suspends is
// what is current when its continuation runs, wherever and after whatever
// else it runs. Captured where a continuation is registered (Task.
// AddContinuation, a Post) and entered around the run (Scheduler.RunPosted).
//
// What a context holds:
//   - the PLATFORM'S word, opaque here: a kernel's is the process the work
//     is done for (UserMode.Current() and its address space), asked and set
//     through Platform.ContextHook;
//   - the flow's [ThreadStatic] table, so that a thread static belongs to the
//     flow and not to whichever thread block the continuation lands on;
//   - the flow's region arena (Gc, regions), its four thread-block words, so
//     the arena travels with the flow. A continuation runs from the
//     scheduler's frame, so whatever regions an earlier run left open are
//     below it and closed by the next region it opens (Gc.PopStale).
//
// NOTHING IS CAPTURED where the platform flows nothing (Platform.ContextHook
// 0: Linux, a loader, a boot test): no allocation, no word moved. Where it
// does, a continuation registered inside a run shares that run's context,
// as an ExecutionContext is shared until something changes it; only a root
// -- an await outside any continuation, a system call starting work --
// makes one.
//
// ONE PROCESSOR: the context running is a static. Several processors (the
// TODO's step 6) make it the processor's.
/// What a run in a context displaced, put back as it ends (AsyncContext).
struct AsyncContextSaved
{
    public AsyncContext? Running;
    public long RunningBlock;
    public long OwnerWord;
    public long Statics;
    public long RegionBase, RegionAt, RegionEnd, RegionOpen;
}

sealed class AsyncContext
{
    /// The platform's: what Platform.ContextHook captured (a kernel's process).
    public object? Owner;
    /// The flow's [ThreadStatic] cells (ThreadStatics), or null for none yet.
    public object?[]? Statics;
    /// The flow's region arena, as the thread block's four words keep it.
    public long RegionBase, RegionAt, RegionEnd, RegionOpen;

    static AsyncContext? _running;
    // The thread block it runs on: another processor's capture -- a system
    // call there while this one runs a continuation -- is not inside it.
    static long _runningBlock;

    // Platform.ContextHook's operations: the word now; a word made current,
    // answering the one it displaced; that one put back.
    public const long CaptureOp = 0, EnterOp = 1, LeaveOp = 2;

    /// The context now, for a continuation being registered or posted: the
    /// running one, its platform word asked afresh, or a new one at a root.
    /// Null where the platform flows no context.
    public static AsyncContext? Capture()
    {
        if (Platform.ContextHook == 0)
        {
            return null;
        }
        object? owner = Sys.FromWord(Sys.Call(Platform.ContextHook, CaptureOp, 0, 0));
        AsyncContext? running = _runningBlock == Sys.ThreadBlock() ? _running : null;
        if (running != null)
        {
            running.Owner = owner;
            return running;
        }
        AsyncContext made = new AsyncContext();
        made.Owner = owner;
        return made;
    }

    /// The context in force on this thread block, or null outside every
    /// continuation.
    public static AsyncContext? Running => _runningBlock == Sys.ThreadBlock() ? _running : null;

    /// `context` made current on this thread block: the platform's word, the
    /// statics table and the region arena's words swapped in.
    public static AsyncContextSaved Enter(AsyncContext context)
    {
        AsyncContextSaved saved = default(AsyncContextSaved);
        saved.Running = _running;
        saved.RunningBlock = _runningBlock;
        if (Platform.ContextHook != 0)
        {
            saved.OwnerWord = Sys.Call(Platform.ContextHook, EnterOp, Sys.Word(context.Owner), 0);
        }
        long block = Sys.ThreadBlock();
        if (block != 0)
        {
            saved.Statics = Sys.Peek(block + Tls.ThreadStatics);
            saved.RegionBase = Sys.Peek(block + Tls.RegionBase);
            saved.RegionAt = Sys.Peek(block + Tls.RegionAt);
            saved.RegionEnd = Sys.Peek(block + Tls.RegionEnd);
            saved.RegionOpen = Sys.Peek(block + Tls.RegionOpen);
            Sys.Poke(block + Tls.ThreadStatics, Sys.Word(context.Statics));
            Sys.Poke(block + Tls.RegionBase, context.RegionBase);
            Sys.Poke(block + Tls.RegionAt, context.RegionAt);
            Sys.Poke(block + Tls.RegionEnd, context.RegionEnd);
            Sys.Poke(block + Tls.RegionOpen, context.RegionOpen);
        }
        _running = context;
        _runningBlock = block;
        return saved;
    }

    /// The run in `context` over: what it made of the statics and the arena
    /// kept in the context, and the block's own put back.
    public static void Leave(AsyncContext context, AsyncContextSaved saved)
    {
        long block = Sys.ThreadBlock();
        if (block != 0)
        {
            long statics = Sys.Peek(block + Tls.ThreadStatics);
            if (statics != Sys.Word(context.Statics))
            {
                context.Statics = ThreadStatics.Flowing(statics);
            }
            context.RegionBase = Sys.Peek(block + Tls.RegionBase);
            context.RegionAt = Sys.Peek(block + Tls.RegionAt);
            context.RegionEnd = Sys.Peek(block + Tls.RegionEnd);
            context.RegionOpen = Sys.Peek(block + Tls.RegionOpen);
            Sys.Poke(block + Tls.ThreadStatics, saved.Statics);
            Sys.Poke(block + Tls.RegionBase, saved.RegionBase);
            Sys.Poke(block + Tls.RegionAt, saved.RegionAt);
            Sys.Poke(block + Tls.RegionEnd, saved.RegionEnd);
            Sys.Poke(block + Tls.RegionOpen, saved.RegionOpen);
        }
        if (Platform.ContextHook != 0)
        {
            Sys.Call(Platform.ContextHook, LeaveOp, saved.OwnerWord, 0);
        }
        _running = saved.Running;
        _runningBlock = saved.RunningBlock;
    }
}

// ---- tasks an interrupt handler completes --------------------------------------
//
// AN INTERRUPT HANDLER ONLY COMPLETES. It may not allocate, wait, take a lock
// a thread holds, or run what was waiting -- so it cannot call TrySetResult,
// whose Finish posts continuations onto a queue that grows and takes the
// scheduler's gate. What it does instead is the first half: it CLAIMS the
// task (one compare-and-swap on its state word, so a completion from a
// timeout or a cancellation and one from the device cannot both win), puts
// the result in a word of a table made beforehand, and pushes the slot onto
// a list the handler links through that table -- the task's queue link,
// which needs no node and no allocation. The second half -- the result
// stored in the task, the final state, the continuations posted in the
// contexts they were registered in -- is thread context's: whoever drains
// the list (Drain: the scheduler's round, a kernel's scheduler loop).
//
// A HANDLE, not a slot, is what a device keeps: the slot and its generation,
// so a device whose late interrupt names a slot since drained and armed for
// something else completes nothing. One processor's rules today: the free
// list is thread context's alone, the ready list is pushed by handlers with
// a compare-and-swap and taken whole by Drain with a swap.
static class InterruptCompletions
{
    const int Slots = 256;

    static Task?[] _held = null!;
    static long[] _results = null!;
    static int[] _links = null!;
    static int[] _generations = null!;
    static bool[] _typed = null!;
    static nint _free;          // first free slot + 1, under the gate
    static nint _ready;         // first completed slot + 1, pushed by handlers
    static AtomicCell? _gate;
    static nint _armed;

    /// Slots armed and not yet drained: a device may still complete them.
    public static long Armed => _armed;

    /// Whether a handler has completed something Drain has not finished:
    /// a word read, no gate, from any context.
    public static bool Pending => _ready != 0;

    static AtomicCell Gate()
    {
        AtomicCell? g = _gate;
        if (g == null)
        {
            Atom.CheckLayout();
            _held = new Task?[Slots];
            _results = new long[Slots];
            _links = new int[Slots];
            _generations = new int[Slots];
            _typed = new bool[Slots];
            for (int i = 0; i < Slots - 1; i++) _links[i] = i + 2;
            _links[Slots - 1] = 0;
            _free = 1;
            g = new AtomicCell();
            _gate = g;
        }
        return g;
    }

    /// `task` armed for an interrupt handler to complete with a number (its
    /// result): a handle above zero, or 0 when every slot is armed already.
    /// Thread context: allocates the table at its first use.
    public static long Arm(Task<long> task)
    {
        return ArmCore(task, true);
    }

    /// The same for a task with no result.
    public static long Arm(Task task)
    {
        return ArmCore(task, false);
    }

    static long ArmCore(Task task, bool typed)
    {
        AtomicCell gate = Gate();
        gate.Enter();
        int slot = (int)_free - 1;
        if (slot < 0)
        {
            gate.Exit();
            return 0;
        }
        _free = _links[slot];
        _links[slot] = 0;
        _held[slot] = task;
        _typed[slot] = typed;
        _results[slot] = 0;
        int generation = (_generations[slot] + 1) & 0x7FFF;
        if (generation == 0) generation = 1;
        _generations[slot] = generation;
        gate.Exit();
        Sys.AtomicAdd(Sys.AddressOf(ref _armed), 1);
        return ((long)generation << 16) | (long)(slot + 1);
    }

    /// A task made and armed together: what a device's awaitable read hands
    /// back. Thread context. The handle is 0 when nothing could be armed --
    /// the caller then does without an interrupt's completion.
    public static Task<long> Make(out long handle)
    {
        Task<long> task = new Task<long>();
        handle = Arm(task);
        return task;
    }

    /// THE HANDLER'S HALF, and the only thing a handler may call here: the
    /// task `handle` names claimed with `result`, and its slot put on the
    /// ready list. Nothing allocated, nothing waited for, no lock taken.
    /// False for a handle not armed any more or a task already completed.
    /// Thread context may call it too: a timeout's or a cancellation's
    /// completion of the same task, of which only one wins.
    public static bool Complete(long handle, long result)
    {
        int slot = (int)(handle & 0xFFFF) - 1;
        int generation = (int)((handle >> 16) & 0x7FFF);
        if (slot < 0 || slot >= Slots || _held == null || _generations[slot] != generation)
        {
            return false;
        }
        Task? task = _held[slot];
        if (task == null || !task.TryClaim())
        {
            return false;
        }
        _results[slot] = result;
        long at = Sys.AddressOf(ref _ready);
        while (true)
        {
            long head = Sys.Peek(at);
            _links[slot] = (int)head;
            if (Sys.Cas(at, head, slot + 1) == head)
            {
                return true;
            }
        }
    }

    /// THREAD CONTEXT'S HALF: every task handlers completed since the last
    /// look given its result and final state, its continuations posted, and
    /// its slot back on the free list. In the order they completed.
    public static void Drain()
    {
        if (_gate == null || _ready == 0)
        {
            return;
        }
        long taken = Sys.AtomicSwap(Sys.AddressOf(ref _ready), 0);
        // Pushed newest first: turned round, so the first completed runs first.
        int reversed = 0;
        int at = (int)taken;
        while (at != 0)
        {
            int next = _links[at - 1];
            _links[at - 1] = reversed;
            reversed = at;
            at = next;
        }
        AtomicCell gate = Gate();
        at = reversed;
        while (at != 0)
        {
            int slot = at - 1;
            int next = _links[slot];
            Task? task = _held[slot];
            long result = _results[slot];
            bool typed = _typed[slot];
            gate.Enter();
            _held[slot] = null;
            _links[slot] = (int)_free;
            _free = slot + 1;
            gate.Exit();
            Sys.AtomicAdd(Sys.AddressOf(ref _armed), -1);
            if (task != null)
            {
                if (typed && task is Task<long> number) number.FinishClaimed(result);
                else task.FinishClaimedSuccess();
            }
            at = next;
        }
    }
}

// ---- what the compiler calls around async methods ----------------------------

static class AsyncRuntime
{
    /// An exception escaped an `async void` method (or a posted work item).
    /// Printed to standard error and the process ends with 134, as
    /// Runtime.Unhandled does for a synchronous throw.
    public static void Unhandled(Exception e)
    {
        string text = "Unhandled exception. " + e.ToString() + "\n";

        Runtime.WriteText(2, text);
        Platform.Exit(134);
    }

    /// `async Task Main` returned `task`: run until it completes, and end the
    /// program as an uncaught exception would if it faulted or was canceled.
    /// For `async Task<int> Main` the compiler reads the result itself.
    public static void RunMain(Task task)
    {
        try
        {
            Scheduler.RunUntil(task);
            task.ThrowIfNotSuccessful();
        }
        catch (Exception e)
        {
            Unhandled(e);
        }
    }
}

// ---- ValueTask and asynchronous disposal ---------------------------------------
//
// .NET's shapes and namespaces. A ValueTask is a struct that is either
// already complete (default, CompletedTask, or holding its result) or stands
// for a Task; awaiting it awaits that task. What `await using` calls:
// IAsyncDisposable's DisposeAsync, awaited in the finally the using is
// lowered to.
//
// NOTHING IS MADE FOR ONE ALREADY COMPLETE. Its awaiter holds the task --
// none -- and the result itself, so awaiting a completed ValueTask<T> asks
// IsCompleted, finds true, and takes the result, with no Task made for it
// (AsTask, which makes one, is for a caller that wants a Task).
//
// AN `async ValueTask` METHOD (X86-BACKEND.md, "Async") keeps its state
// machine in its caller's frame while it runs synchronously, and moves it
// to the heap only at its first real suspension, where the task is made:
// one that completes without suspending allocates nothing, as .NET's
// AsyncValueTaskMethodBuilder boxes only at the first await that does not
// complete synchronously. The compiler makes the result with the
// constructors below: ValueTask(Task) and ValueTask<T>(Task<T>) for one that
// suspended or faulted, ValueTask<T>(T) and default for one that did not.

namespace System.Threading.Tasks
{
    /// How a task is to be made and run, as .NET's flags.
    [Flags]
    enum TaskCreationOptions
    {
        None = 0,
        PreferFairness = 1,
        LongRunning = 2,
        AttachedToParent = 4,
        DenyChildAttach = 8,
        HideScheduler = 16,
        RunContinuationsAsynchronously = 64,
    }

    readonly struct ValueTask
    {
        readonly Task? _task;

        public ValueTask(Task task)
        {
            if (task is null) throw new ArgumentNullException("task");
            _task = task;
        }

        /// A completed ValueTask; the same as default.
        public static ValueTask CompletedTask => default;

        public bool IsCompleted => _task is null || _task.IsCompleted;
        public bool IsCompletedSuccessfully => _task is null || _task.IsCompletedSuccessfully;
        public bool IsFaulted => _task is not null && _task.IsFaulted;

        public Task AsTask() => _task ?? Task.CompletedTask;

        public System.Runtime.CompilerServices.ValueTaskAwaiter GetAwaiter()
            => new System.Runtime.CompilerServices.ValueTaskAwaiter(_task, true);

        public static ValueTask FromResult() => default;
    }

    /// A result that is either here already or the Task that will make it.
    readonly struct ValueTask<TResult>
    {
        readonly Task<TResult>? _task;
        readonly TResult _result;

        public ValueTask(TResult result)
        {
            _task = null;
            _result = result;
        }

        public ValueTask(Task<TResult> task)
        {
            if (task is null) throw new ArgumentNullException("task");
            _task = task;
            _result = default!;
        }

        public bool IsCompleted => _task is null || _task.IsCompleted;
        public bool IsCompletedSuccessfully => _task is null || _task.IsCompletedSuccessfully;
        public bool IsFaulted => _task is not null && _task.IsFaulted;

        public TResult Result => _task is null ? _result : _task.Result;

        public Task<TResult> AsTask() => _task ?? Task.FromResult(_result);

        public System.Runtime.CompilerServices.ValueTaskAwaiter<TResult> GetAwaiter()
            => new System.Runtime.CompilerServices.ValueTaskAwaiter<TResult>(_task, _result);
    }
}

namespace System.Runtime.CompilerServices
{
    readonly struct ValueTaskAwaiter
    {
        // Null for a ValueTask that completed without a task: done, and
        // nothing to rethrow.
        readonly Task? _task;

        public ValueTaskAwaiter(Task task)
        {
            _task = task;
        }

        internal ValueTaskAwaiter(Task? task, bool fromValueTask)
        {
            _task = task;
        }

        public bool IsCompleted => _task is null || _task.IsCompleted;

        public void GetResult()
        {
            Task? task = _task;
            if (task is null)
            {
                return;
            }
            if (!task.IsCompleted)
            {
                Scheduler.RunUntil(task);
            }
            task.ThrowIfNotSuccessful();
        }

        public void OnCompleted(Action continuation)
        {
            Task? task = _task;
            if (task is null) Scheduler.Post(continuation);
            else task.AddContinuation(continuation);
        }

        public void UnsafeOnCompleted(Action continuation)
        {
            OnCompleted(continuation);
        }
    }

    readonly struct ValueTaskAwaiter<TResult>
    {
        // The task, or null with the result here already: a completed
        // ValueTask<T> is awaited with no Task made for it.
        readonly System.Threading.Tasks.Task<TResult>? _task;
        readonly TResult _result;

        public ValueTaskAwaiter(System.Threading.Tasks.Task<TResult> task)
        {
            _task = task;
            _result = default!;
        }

        internal ValueTaskAwaiter(System.Threading.Tasks.Task<TResult>? task, TResult result)
        {
            _task = task;
            _result = result;
        }

        public bool IsCompleted => _task is null || _task.IsCompleted;

        public TResult GetResult()
        {
            System.Threading.Tasks.Task<TResult>? task = _task;
            return task is null ? _result : task.GetAwaiter().GetResult();
        }

        public void OnCompleted(Action continuation)
        {
            System.Threading.Tasks.Task<TResult>? task = _task;
            if (task is null) Scheduler.Post(continuation);
            else task.AddContinuation(continuation);
        }

        public void UnsafeOnCompleted(Action continuation)
        {
            OnCompleted(continuation);
        }
    }
}

namespace System
{
    /// What `await using` gives a resource back through.
    interface IAsyncDisposable
    {
        System.Threading.Tasks.ValueTask DisposeAsync();
    }
}

namespace System.Threading
{
    /// A count of permits for threads and awaits alike: Wait takes one, or
    /// waits (with a timeout, or until a token is canceled) for a Release.
    /// Waiters are served in the order they came. Every waiter, synchronous
    /// or not, is a task in the queue; a synchronous Wait runs the scheduler
    /// until its task is done, as Task.Wait does.
    class SemaphoreSlim : IDisposable
    {
        // LAYOUT: these two must stay the first instance fields (see Atom),
        // and WORDS: as ints, two of them shared the first word in long mode,
        // Atom.SecondWord fell on _max, and the gate never read free.
        nint _count;
        nint _lock;

        readonly int _max;
        readonly List<SemaphoreWaiter> _waiters = new List<SemaphoreWaiter>();
        bool _disposed;

        public SemaphoreSlim(int initialCount) : this(initialCount, int.MaxValue)
        {
        }

        public SemaphoreSlim(int initialCount, int maxCount)
        {
            if (initialCount < 0 || initialCount > maxCount)
            {
                throw new ArgumentOutOfRangeException("initialCount");
            }
            if (maxCount <= 0)
            {
                throw new ArgumentOutOfRangeException("maxCount");
            }
            _count = initialCount;
            _lock = 0;
            _max = maxCount;
            Atom.CheckLayout();
        }

        public int CurrentCount => (int)_count;

        public void Wait()
        {
            Wait(-1, default(CancellationToken));
        }

        public void Wait(CancellationToken cancellationToken)
        {
            Wait(-1, cancellationToken);
        }

        public bool Wait(int millisecondsTimeout)
        {
            return Wait(millisecondsTimeout, default(CancellationToken));
        }

        public bool Wait(TimeSpan timeout)
        {
            return Wait(Timeouts.Milliseconds(timeout, "timeout"), default(CancellationToken));
        }

        public bool Wait(TimeSpan timeout, CancellationToken cancellationToken)
        {
            return Wait(Timeouts.Milliseconds(timeout, "timeout"), cancellationToken);
        }

        /// Throws OperationCanceledException when the token is canceled first.
        public bool Wait(int millisecondsTimeout, CancellationToken cancellationToken)
        {
            return WaitAsync(millisecondsTimeout, cancellationToken).GetAwaiter().GetResult();
        }

        public Task WaitAsync()
        {
            return WaitAsync(-1, default(CancellationToken));
        }

        public Task WaitAsync(CancellationToken cancellationToken)
        {
            return WaitAsync(-1, cancellationToken);
        }

        public Task<bool> WaitAsync(int millisecondsTimeout)
        {
            return WaitAsync(millisecondsTimeout, default(CancellationToken));
        }

        public Task<bool> WaitAsync(TimeSpan timeout)
        {
            return WaitAsync(Timeouts.Milliseconds(timeout, "timeout"), default(CancellationToken));
        }

        public Task<bool> WaitAsync(TimeSpan timeout, CancellationToken cancellationToken)
        {
            return WaitAsync(Timeouts.Milliseconds(timeout, "timeout"), cancellationToken);
        }

        public Task<bool> WaitAsync(int millisecondsTimeout, CancellationToken cancellationToken)
        {
            CheckDisposed();
            if (millisecondsTimeout < -1)
            {
                throw new ArgumentOutOfRangeException("millisecondsTimeout");
            }
            if (cancellationToken.IsCancellationRequested)
            {
                Task<bool> canceled = new Task<bool>();
                canceled.TrySetCanceled(new TaskCanceledException());
                return canceled;
            }

            SemaphoreWaiter waiter;
            long gate = Atom.At(this, Atom.SecondWord);
            Atom.Enter(gate);
            if (_count > 0)
            {
                _count = _count - 1;
                Atom.Exit(gate);
                return Task.FromResult(true);
            }
            if (millisecondsTimeout == 0)
            {
                Atom.Exit(gate);
                return Task.FromResult(false);
            }
            waiter = new SemaphoreWaiter(this);
            _waiters.Add(waiter);
            Atom.Exit(gate);

            waiter.Arm(millisecondsTimeout, cancellationToken);
            return waiter.Task;
        }

        public int Release()
        {
            return Release(1);
        }

        /// Gives back `releaseCount` permits -- to waiters first, in order --
        /// and answers the count as it was before.
        public int Release(int releaseCount)
        {
            CheckDisposed();
            if (releaseCount < 1)
            {
                throw new ArgumentOutOfRangeException("releaseCount");
            }

            long gate = Atom.At(this, Atom.SecondWord);
            Atom.Enter(gate);
            int previous = (int)_count;
            if (_max - previous < releaseCount)
            {
                Atom.Exit(gate);
                throw new SemaphoreFullException();
            }
            int left = releaseCount;
            while (left > 0 && _waiters.Count > 0)
            {
                SemaphoreWaiter next = _waiters[0];
                _waiters.RemoveAt(0);
                if (next.Grant())
                {
                    left = left - 1;
                }
            }
            _count = previous + left;
            Atom.Exit(gate);
            return previous;
        }

        /// A permit taken now if one is free, and nothing made either way:
        /// AsyncLock's uncontended path (Wait(0) answers through a task).
        public bool TryTakeNow()
        {
            CheckDisposed();
            long gate = Atom.At(this, Atom.SecondWord);
            Atom.Enter(gate);
            bool took = _count > 0;
            if (took)
            {
                _count = _count - 1;
            }
            Atom.Exit(gate);
            return took;
        }

        /// Takes a waiter that gave up out of the queue, saying whether it was
        /// still there (and so had not been granted a permit).
        public bool Withdraw(SemaphoreWaiter waiter)
        {
            long gate = Atom.At(this, Atom.SecondWord);
            Atom.Enter(gate);
            bool had = _waiters.Remove(waiter);
            Atom.Exit(gate);
            return had;
        }

        public void Dispose()
        {
            _disposed = true;
        }

        void CheckDisposed()
        {
            if (_disposed)
            {
                throw new ObjectDisposedException("SemaphoreSlim");
            }
        }
    }

    /// One wait on a SemaphoreSlim: the task it completes, and what may end it
    /// early -- its timeout, or its token.
    class SemaphoreWaiter : Action
    {
        readonly SemaphoreSlim _owner;
        readonly Task<bool> _task = new Task<bool>();
        TimerEntry? _timer;
        CancellationTokenRegistration? _registration;

        public SemaphoreWaiter(SemaphoreSlim owner)
        {
            _owner = owner;
        }

        public Task<bool> Task => _task;

        public void Arm(int milliseconds, CancellationToken token)
        {
            if (milliseconds > 0)
            {
                _timer = Scheduler.AddTimer(milliseconds, this);
            }
            if (token.CanBeCanceled)
            {
                _registration = token.Register(new SemaphoreWaitCanceled(this));
            }
        }

        /// A permit: the wait succeeds, if nothing ended it first.
        public bool Grant()
        {
            if (!_task.TrySetResult(true))
            {
                return false;
            }
            Disarm();
            return true;
        }

        /// The timeout: false, if it was still waiting.
        public void Invoke()
        {
            if (_owner.Withdraw(this) && _task.TrySetResult(false))
            {
                Disarm();
            }
        }

        public void Canceled()
        {
            if (_owner.Withdraw(this) && _task.TrySetCanceled(new TaskCanceledException()))
            {
                Disarm();
            }
        }

        void Disarm()
        {
            TimerEntry? timer = _timer;
            if (timer != null)
            {
                timer.Cancel();
            }
            CancellationTokenRegistration? registration = _registration;
            if (registration != null)
            {
                registration.Dispose();
            }
        }
    }

    class SemaphoreWaitCanceled : Action
    {
        readonly SemaphoreWaiter _waiter;
        public SemaphoreWaitCanceled(SemaphoreWaiter waiter) { _waiter = waiter; }
        public void Invoke() { _waiter.Canceled(); }
    }

    /// Release gave back more permits than the semaphore holds.
    class SemaphoreFullException : SystemException
    {
        public SemaphoreFullException() : base("Adding the specified count to the semaphore would cause it to exceed its maximum count.") { }
        public SemaphoreFullException(string message) : base(message) { }
        public SemaphoreFullException(string message, Exception? inner) : base(message, inner) { }
    }

    /// AN AWAITABLE LOCK, for a hold that awaits (docs/X86-BACKEND.md, "Async safety"):
    ///
    ///     using (await gate.LockAsync())
    ///     {
    ///         ... await disc.Read(...) ...
    ///     }
    ///
    /// The locks that may not be held across an await -- IrqSpinLock,
    /// KernelGate, Ring1Lock, IoOwnership, Monitor -- are for short holds that
    /// never suspend; the compiler refuses an await under one. This one is
    /// what a long hold takes instead: a waiter is a task that is completed
    /// when the lock is given back, so it holds no processor and no thread
    /// while it waits, and the continuation that holds it may run anywhere.
    /// It is not reentrant, as a SemaphoreSlim(1, 1) is not.
    ///
    /// Taken uncontended it makes nothing: the ValueTask holds the releaser
    /// itself (SemaphoreSlim.TryTakeNow). Contended, the wait is the
    /// semaphore's. Core runtime only -- no class library -- so a freestanding
    /// kernel has it.
    class AsyncLock
    {
        readonly SemaphoreSlim _gate = new SemaphoreSlim(1, 1);

        /// Taken: a releaser whose Dispose gives it back.
        public System.Threading.Tasks.ValueTask<AsyncLockReleaser> LockAsync()
        {
            if (_gate.TryTakeNow())
            {
                return new System.Threading.Tasks.ValueTask<AsyncLockReleaser>(new AsyncLockReleaser(this));
            }
            return new System.Threading.Tasks.ValueTask<AsyncLockReleaser>(LockSlow());
        }

        async Task<AsyncLockReleaser> LockSlow()
        {
            await _gate.WaitAsync();
            return new AsyncLockReleaser(this);
        }

        /// Whether it was free, and is taken now; the caller gives it back.
        public bool TryLock() => _gate.TryTakeNow();

        /// Given back: the longest waiter, if any, takes it next.
        public void Release()
        {
            _gate.Release();
        }

        /// Whether somebody holds it now.
        public bool IsHeld => _gate.CurrentCount == 0;
    }

    /// What AsyncLock.LockAsync hands back: disposing it gives the lock back.
    readonly struct AsyncLockReleaser : IDisposable
    {
        readonly AsyncLock? _owner;

        public AsyncLockReleaser(AsyncLock owner)
        {
            _owner = owner;
        }

        public void Dispose()
        {
            AsyncLock? owner = _owner;
            if (owner is not null)
            {
                owner.Release();
            }
        }
    }
}


/// [ThreadStatic] FIELDS: a value of each on every thread. Each such field has
/// a word in the image (Lowering.ThreadStaticIndex), 0 until the program's
/// first touch of the field gives it a number; each thread has a table of
/// cells, one for each number it has touched, made as it touches it: a block
/// as large as the field (Runtime.Alloc), read word by word by the collector
/// as a captured local's cell is. Slot 0 of a table is its node in the list of
/// every thread's tables -- a static, so a root as every static is; the
/// thread block's word (Tls.ThreadStatics) is only where the thread finds its
/// own, and no collector reads it. A thread's table leaves the list as the
/// thread ends.
static class ThreadStatics
{
    /// The numbers given out so far. Every atomic here is the runtime's own
    /// (Sys.AtomicAdd, Sys.Cas, Sys.AtomicSwap), never Interlocked: a
    /// freestanding kernel is built without the class library. They work on
    /// a word, so the fields are words.
    static nint _fields;
    /// Every thread's table, through its node.
    static ThreadStaticTable? _tables;
    /// Held while the list changes.
    static nint _lock;

    /// The cell of the field whose number is at `indexAt`, on this thread.
    public static long Cell(long indexAt, long bytes)
    {
        long index = Sys.Peek(indexAt);
        if (index == 0)
        {
            Sys.Cas(indexAt, 0, (int)Sys.AtomicAdd(Sys.AddressOf(ref _fields), 1) + 1);
            index = Sys.Peek(indexAt);
        }
        long block = Sys.ThreadBlock();
        object?[]? cells = Sys.FromWord(Sys.Peek(block + Tls.ThreadStatics)) as object?[];
        if (cells is null || index >= cells.Length)
        {
            cells = Grow(block, cells, index);
        }
        object? cell = cells[index];
        if (cell is null)
        {
            cell = Sys.FromWord(Runtime.Alloc(bytes));
            cells[index] = cell;
        }
        return Sys.Word(cell);
    }

    /// This thread's table, long enough for `index`: its first, put on the
    /// list, or a longer copy of the one it has.
    static object?[] Grow(long block, object?[]? old, long index)
    {
        long size = old is null ? 8 : old.Length * 2;
        while (size <= index)
        {
            size = size * 2;
        }
        object?[] cells = new object?[size];
        ThreadStaticTable node;
        if (old is null)
        {
            node = new ThreadStaticTable();
            Enter();
            node.Next = _tables;
            if (_tables is not null) _tables.Previous = node;
            _tables = node;
            Leave();
        }
        else
        {
            node = (ThreadStaticTable)old[0]!;
            for (int i = 1; i < old.Length; i++) cells[i] = old[i];
        }
        cells[0] = node;
        // Kept by the list before the thread block names it.
        node.Cells = cells;
        Sys.Poke(block + Tls.ThreadStatics, Sys.Word(cells));
        return cells;
    }

    /// A thread's table off the list as the thread ends: its cells are the
    /// collector's once nothing else holds what is in them.
    public static void Release(long block)
    {
        object?[]? cells = Sys.FromWord(Sys.Peek(block + Tls.ThreadStatics)) as object?[];
        if (cells is null)
        {
            return;
        }
        Sys.Poke(block + Tls.ThreadStatics, 0);
        ThreadStaticTable node = (ThreadStaticTable)cells[0]!;
        Enter();
        if (node.Previous is not null) node.Previous.Next = node.Next;
        else _tables = node.Next;
        if (node.Next is not null) node.Next.Previous = node.Previous;
        Leave();
        node.Cells = null;
        node.Next = null;
        node.Previous = null;
    }

    /// THE TABLE A FLOW MADE OR GREW while it ran on a thread block
    /// (AsyncContext.Leave): taken off the list of threads' tables, which
    /// would keep it for ever once the flow ended, and handed to the context
    /// that carries the flow -- which is all that keeps it from then on. The
    /// block's word is the caller's to put back. Null for no table.
    public static object?[]? Flowing(long word)
    {
        object?[]? cells = Sys.FromWord(word) as object?[];
        if (cells is null)
        {
            return null;
        }
        ThreadStaticTable node = (ThreadStaticTable)cells[0]!;
        if (node.Flows)
        {
            return cells;
        }
        Enter();
        if (node.Previous is not null) node.Previous.Next = node.Next;
        else if (_tables == node) _tables = node.Next;
        if (node.Next is not null) node.Next.Previous = node.Previous;
        node.Next = null;
        node.Previous = null;
        node.Flows = true;
        Leave();
        return cells;
    }

    static void Enter()
    {
        while ((int)Sys.Cas(Sys.AddressOf(ref _lock), 0, 1) != 0)
        {
            Sys.Pause();
        }
    }

    static void Leave()
    {
        Sys.AtomicSwap(Sys.AddressOf(ref _lock), 0);
    }
}

/// One thread's table on ThreadStatics' list.
sealed class ThreadStaticTable
{
    public object?[]? Cells;
    public ThreadStaticTable? Next;
    public ThreadStaticTable? Previous;
    /// A flow's table (AsyncContext), off the list: what keeps it is the
    /// context that carries it, not the list of threads' tables.
    public bool Flows;
}
