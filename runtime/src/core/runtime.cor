// The portable runtime: everything the compiler emits a call to that is not
// about any particular operating system.
//
// The compiler looks these up BY NAME AND PARAMETER COUNT on a static class
// called Runtime (see compiler/Lang/Lower/Lowering.cs, RuntimeMethod), so the
// signatures here are a contract, not a style. Anything the prelude declares on
// Sys or Math that the x86 backend has no instruction for arrives here under
// the same name and shape (Lowering.Intrinsic.cs, RuntimeFallback).
//
// The half of the runtime that DOES know the operating system -- the heap's
// memory, exit, and writing bytes to a descriptor -- lives in lib/sys/*.cor,
// and this file reaches it only through the small `Sys`-shaped surface below
// that the system library adds to the same Runtime class: Alloc, Exit and
// WriteBytes. Compile both together:
//
//   corc compile program.cor -o program
//
// RULES THIS FILE KEEPS.
//   - Nothing in the division helpers uses `/` or `%` on a long, because the
//     compiler lowers those very operators into these helpers.
//   - Math.Trunc and friends are written with an integer conversion, which
//     the backend performs with truncation (it swaps the x87 control word).
//   - Nothing here that runs on the failure path of an allocation allocates.

// ---- exceptions the compiler raises ---------------------------------------
//
// The ones std.cor already has (Exception, IndexOutOfRangeException,
// OverflowException) are used as they are; these three are the ones it does
// not declare and the compiler's checks need. Shapes follow std.cor exactly.

/// An integer division or remainder by zero. C#'s, and thrown by the check the
/// compiler puts in front of every integer `/` and `%`.
class DivideByZeroException : ArithmeticException
{
    internal override int Code => unchecked((int)0x80020012);
    public DivideByZeroException() : base("Attempted to divide by zero.") { }
    public DivideByZeroException(string? message) : base(message ?? "Attempted to divide by zero.") { }
    public DivideByZeroException(string? message, Exception? innerException) : base(message ?? "Attempted to divide by zero.", innerException) { }
}

/// A cast to a class or interface the object is not.
class InvalidCastException : SystemException
{
    internal override int Code => unchecked((int)0x80004002);

    // A FAILED CAST'S: the object's type and the name it was cast to, kept,
    // and the sentence made when it is read (Runtime.InvalidCastOfType). Made
    // at the throw, its strings were allocations every program with a
    // checked cast reached -- `(string)o` in its own Main -- and a program
    // proved to need no collector needed one for them.
    readonly Type? _castFrom;
    readonly string? _castTo;

    internal InvalidCastException(Type from, string to) : base(null)
    {
        _castFrom = from;
        _castTo = to;
    }

    public override string Message => _castFrom != null
        ? "Unable to cast object of type '" + String.TypeText(_castFrom.FullName) + "' to type '" + _castTo + "'."
        : base.Message;

    public InvalidCastException(string? message) : base(message ?? "Specified cast is not valid.") { }
    public InvalidCastException() : base("Specified cast is not valid.") { }
    public InvalidCastException(string? message, Exception? innerException) : base(message ?? "Specified cast is not valid.", innerException) { }
}

/// A member was reached through null. The compiler does not yet raise this
/// itself (a null dereference is a fault), but library code can, and the name
/// has to exist for source that says `catch (NullReferenceException)`.
class NullReferenceException : SystemException
{
    internal override int Code => unchecked((int)0x80004003);
    public NullReferenceException() : base("Object reference not set to an instance of an object.") { }
    public NullReferenceException(string? message) : base(message ?? "Object reference not set to an instance of an object.") { }
    public NullReferenceException(string? message, Exception? innerException) : base(message ?? "Object reference not set to an instance of an object.", innerException) { }
}

/// A member that cannot be reached: .NET's base for the missing-member family.
class MemberAccessException : SystemException
{
    internal override int Code => unchecked((int)0x8013151A);
    public MemberAccessException() : base("Cannot access member.") { }
    public MemberAccessException(string? message) : base(message ?? "Cannot access member.") { }
    public MemberAccessException(string? message, Exception? innerException) : base(message ?? "Cannot access member.", innerException) { }
}

class MissingMemberException : MemberAccessException
{
    internal override int Code => unchecked((int)0x80131512);
    public MissingMemberException() : base("Attempted to access a missing member.") { }
    public MissingMemberException(string? message) : base(message ?? "Attempted to access a missing member.") { }
    public MissingMemberException(string? message, Exception? innerException) : base(message ?? "Attempted to access a missing member.", innerException) { }
}

/// A method with no code to run. The compiler raises it for a generic virtual
/// method called on an object whose class overrides it but was not visible to
/// the code that made the call, so no copy of the override exists for that type
/// argument -- what an ahead-of-time compiler cannot make after the fact.
class MissingMethodException : MissingMemberException
{
    internal override int Code => unchecked((int)0x80131513);
    public MissingMethodException() : base("Attempted to access a missing method.") { }
    public MissingMethodException(string? message) : base(message ?? "Attempted to access a missing method.") { }
    public MissingMethodException(string? message, Exception? innerException) : base(message ?? "Attempted to access a missing method.", innerException) { }
}

/// THE MACHINE WORD, for every layout the runtime keeps itself: a pointer, a
/// length, a slot of the thread block, a word of the collector's headers.
/// Sys.ReadAddress and Sys.WriteAddress move exactly one of these, a nuint;
/// Sys.Read32 and Sys.Write32 move 32 bits whatever the machine, and are for
/// data that is 32 bits by its own definition. Chosen by the target's
/// conditional symbol, as .NET's CoreLib chooses its own pointer-sized
/// layouts. An int, so that it is a nuint's constant in an address and a
/// long's in a count alike.
static class WordSize
{
#if TARGET_64BIT
    public const int Bytes = 8;
    public const int Shift = 3;
#else
    public const int Bytes = 4;
    public const int Shift = 2;
#endif
}

/// THE SPILL SLOTS' TRAFFIC, as a program built with --count-spills runs:
/// each block that reads or writes a register allocator's spill slot adds
/// how many of each it does to these as it is entered (the backend's
/// SpillCount), and the program says them at its end. The measure of a
/// register allocator: what its spills cost as the program runs, not as it
/// reads (REGALLOC-RESEARCH). Nought, and nothing said, in a program built
/// without it.
//
// VOLATILE: nothing in the program's IR writes them -- the counting is the
// backend's, after the IR is gone -- and a field only ever read was folded
// to nought and dropped, Say with it. A volatile one is kept and read.
// Each total two 32-bit halves, as C# allows no volatile ulong: the add to
// the low half and the adc to the high.
static class SpillCounts
{
    public static volatile uint ReadsLow, ReadsHigh, WritesLow, WritesHigh;
    /// --count-spills-map: the backend's table of each counted block's runs,
    /// a 64-bit count each, and how many blocks it has (X86Backend's
    /// SpillTable fills these in); 0 and 0 otherwise.
    public static volatile nuint Blocks;
    public static volatile uint BlockCount;

    /// Said on standard error at the end, in a page of its own: a program
    /// with no collector -- a benchmark's loop alone -- has the counts too.
    /// The totals and the blocks' table are taken together once the page is
    /// had, before anything is said: what saying them runs counts too
    /// (WriteLiteral, the write), and these functions alone are not counted
    /// (SpillCount) -- never inlined into a caller that is.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void Say()
    {
        if (ReadsLow == 0 && ReadsHigh == 0 && WritesLow == 0 && WritesHigh == 0) return;
        uint blocks = BlockCount;
        nuint page = Platform.Map(4096 + ((nuint)blocks * 8 + 4095) / 4096 * 4096);
        if (page == 0) return;
        ulong reads = ((ulong)ReadsHigh << 32) | ReadsLow, writes = ((ulong)WritesHigh << 32) | WritesLow;
        nuint table = Blocks, copy = page + 4096;
        for (nuint at = 0; at < (nuint)blocks * 8; at += 4) Sys.Write32(copy + at, Sys.Read32(table + at));
        SayCount(page, "spills: reads ", reads);
        SayCount(page, "spills: writes ", writes);
        // Each block run, by its number in the map: "spills: block N", then "spills: runs R".
        for (uint k = 0; k < blocks; k++)
        {
            nuint at = copy + (nuint)k * 8;
            ulong runs = ((ulong)Sys.Read32(at + 4) << 32) | Sys.Read32(at);
            if (runs == 0) continue;
            SayCount(page, "spills: block ", k);
            SayCount(page, "spills: runs ", runs);
        }
    }

    /// The digits by 32-bit division alone, the total's four 16-bit pieces
    /// at a time, so every program -- this is in all of them -- carries no
    /// 64-bit divide for it.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void SayCount(nuint page, string label, ulong n)
    {
        Runtime.WriteLiteral(2, label);
        uint high = (uint)(n >> 32), low = (uint)n;
        nuint at = 23;
        Sys.Write8(page + at, 10);
        do
        {
            uint left = high >> 16, digit;
            uint top = left / 10;
            left = ((left % 10) << 16) | (high & 0xFFFF);
            high = (top << 16) | (left / 10);
            left = ((left % 10) << 16) | (low >> 16);
            uint mid = left / 10;
            left = ((left % 10) << 16) | (low & 0xFFFF);
            low = (mid << 16) | (left / 10);
            digit = left % 10;
            at = at - 1;
            Sys.Write8(page + at, (byte)(48 + digit));
        }
        while (high != 0 || low != 0);
        Platform.WriteBytes(2, page + at, 24 - at);
    }
}

/// WHAT THIS PROCESSOR HAS, asked of CPUID once and kept: the instructions
/// the runtime and the libraries take a faster way with where the processor
/// has them, beyond what --cpu the image was made for promises (Has of
/// features it promises is true at the compile, of a feature a --disable
/// bans false: Lowering.ProcessorHasFolded). One image runs on the
/// 486, the Pentium and the K6 alike (--cpu 486); a K7 or a K8 under it
/// still has CMPXCHG8B and the streaming stores, and this says so.
///
/// Asked the first time any feature is, on whichever thread: two threads
/// asking at once get the same answer from the same processor, and the word
/// is written whole, so no lock is needed. A 486 without CPUID (EFLAGS.ID
/// fixed) has none of these.
static class Processor
{
    /// lock cmpxchg8b (CPUID 1, EDX bit 8, CX8): a long's compare-exchange, the Pentium's.
    public const int Cas64 = 1 << 0;
    /// cmovcc (EDX bit 15).
    public const int Cmov = 1 << 1;
    /// MMX (EDX bit 23).
    public const int Mmx = 1 << 2;
    /// SSE's integer half in the MMX registers: the streaming store (movntq),
    /// the prefetches and sfence. Intel's SSE bit (EDX bit 25) or AMD's
    /// extended MMX (CPUID 0x80000001, EDX bit 22): the Pentium III, the
    /// Athlon and every K8. None of it needs the operating system to have
    /// enabled SSE's own state (CR4.OSFXSR).
    public const int MmxExtensions = 1 << 3;
    /// SSE and SSE2 (EDX bits 25 and 26): their XMM state is the operating
    /// system's to enable, which this does not ask.
    public const int Sse = 1 << 4;
    public const int Sse2 = 1 << 5;
    /// 3DNow! (CPUID 0x80000001, EDX bit 31).
    public const int ThreeDNow = 1 << 6;
    /// Set once asked, so a processor with none of the above is not asked again.
    const int Asked = 1 << 30;

    static int _features;

    /// Whether the processor has every one of `features`.
    public static bool Has(int features) { return (Features & features) == features; }

    public static int Features
    {
        get
        {
            int known = _features;
            return known != 0 ? known : Ask();
        }
    }

    // NOTHING WRITTEN TO MEMORY to ask: one register of each leaf straight
    // out of the instruction (Sys.CpuidEax, CpuidEdx). A struct of the four
    // registers, its address taken for Sys.Cpuid, was made on the heap (its
    // IR, 10-27: two Runtime.Alloc calls, a barrier and a card) -- and
    // the allocator reaches Interlocked's longs, which ask here: a cycle that
    // kept this from being inlined anywhere, and that would recurse if the
    // first long an allocation updated came before any other question.
    //
    // NEVER INLINED: asked once a process, it is the cold half of Features.
    // Expanded into its one caller, it made Features and Has seventy units
    // where the inliner takes forty (--trace-opt, 10-27: "keep: body=72
    // small-limit=40"), and every Has stayed a call -- two calls for one load
    // and a test at each question.
    [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
    static int Ask()
    {
#if TARGET_64BIT
        // Every processor that runs long mode has all of them.
        int found = Asked | Cas64 | Cmov | Mmx | MmxExtensions | Sse | Sse2;
#else
        int found = Asked;
        if (Sys.CpuidPresent() != 0)
        {
            if (Sys.CpuidEax(0) >= 1)
            {
                int d = Sys.CpuidEdx(1);
                if ((d & (1 << 8)) != 0) found |= Cas64;
                if ((d & (1 << 15)) != 0) found |= Cmov;
                if ((d & (1 << 23)) != 0) found |= Mmx;
                if ((d & (1 << 25)) != 0) found |= MmxExtensions | Sse;
                if ((d & (1 << 26)) != 0) found |= Sse2;
            }
            // The extended leaves, where the answer is one: a processor
            // without them answers its last basic leaf's figures instead.
            uint last = (uint)Sys.CpuidEax(unchecked((int)0x80000000));
            if (last >= 0x80000001 && last <= 0x8000FFFF)
            {
                int d = Sys.CpuidEdx(unchecked((int)0x80000001));
                if ((d & (1 << 22)) != 0) found |= MmxExtensions;
                if ((d & unchecked((int)0x80000000)) != 0) found |= ThreeDNow;
            }
        }
#endif
        _features = found;
        return found;
    }
}

/// The shape of a thread's block of runtime state.
///
/// ONE OF THESE PER THREAD, and everything in it used to be one word of .bss
/// for the whole process. The compiler emits the exception handler chain's
/// push, pop and unwind against Handler here, the collector reads StackBase
/// and StackLimit to know where a thread's stack is, and the allocator bumps
/// in AllocPtr; lib/threading.cor gives each thread it starts a block of its
/// own. KEEP IN STEP WITH compiler/Lang/Lower/Lowering.cs (the Tls* constants
/// there), which is the other half of this agreement.
///
/// The block is reached with Sys.ThreadBlock(): on Linux one load through GS,
/// whose descriptor runtime/src/platforms/linux/system.cor makes with set_thread_area(2), and on a
/// machine with no operating system a word of .bss, because there is one
/// thread and nothing to switch.
static class Tls
{
    // Every field is a word slot, numbered as lowering numbers them (its Tls*
    // constants are these slots times four, scaled by the word): 54 slots.
    /// The block's own address. First, because gs:[0] is how it is found.
    public const int Self = 0 * WordSize.Bytes;

    /// The innermost handler record on this thread, or 0.
    public const int Handler = 1 * WordSize.Bytes;

    /// The top of this thread's stack: where a stack scan ends.
    public const int StackBase = 2 * WordSize.Bytes;

    /// The stack pointer this thread stopped at; only meaningful while
    /// State says it is stopped.
    public const int StackLimit = 3 * WordSize.Bytes;

    /// This thread's allocation buffer: where it bumps, and where it may not.
    public const int AllocPtr = 4 * WordSize.Bytes;
    public const int AllocLimit = 5 * WordSize.Bytes;

    /// What the kernel calls this thread.
    public const int ThreadId = 6 * WordSize.Bytes;

    /// 0 while the thread is running, 1 while it is stopped for a collection
    /// or waiting on something only another thread can answer.
    public const int State = 7 * WordSize.Bytes;

    /// The first byte of the buffer, so that a free of the block on top of it
    /// can tell its own buffer from somebody else's memory.
    public const int AllocBase = 8 * WordSize.Bytes;

    /// The limit the collector took away, so that the buffer's tail can still
    /// be found and given back when the thread has stopped.
    public const int AllocSaved = 9 * WordSize.Bytes;

    /// Sixteen bytes a system call can be handed a structure in, without an
    /// allocation: a thread sets its own block up before it may allocate.
    public const int Scratch = 10 * WordSize.Bytes;

    /// Type-initialization record this thread is currently waiting on, or 0.
    public const int TypeInitWait = 14 * WordSize.Bytes;

    /// The thread's process -- its thread group -- as a kernel that hands a
    /// ring-1 block to it writes it there with ThreadId: what a ring-1
    /// kernel asks of every call, read here rather than asked by a trap.
    public const int ThreadGroup = 15 * WordSize.Bytes;

    /// Nonzero while this thread is inside the allocator's fast path: the
    /// few instructions between reading its buffer's limit and bumping its
    /// pointer. A collector that stops threads by interrupting them (a
    /// kernel's processors) may not stop one HERE -- it has passed the
    /// limit check and is about to write an object into a buffer the
    /// collector is about to retire -- and asks again a moment later.
    public const int InAlloc = 16 * WordSize.Bytes;

    /// The collector's last handshake round this thread has answered
    /// (GcThreads): a thread whose number is behind the collector's owes it
    /// a piece of work -- the objects of its own allocation buffer, or its
    /// own stack -- which it does at its next safepoint, or which the
    /// collector does for it while it is blocked. Never a stop.
    public const int Epoch = 17 * WordSize.Bytes;

    /// Set by a kernel that has arranged for this thread to answer a
    /// handshake the moment it resumes (an interrupted GUI kernel thread),
    /// so that it is not arranged twice; cleared by the answer.
    public const int HandshakeArmed = 18 * WordSize.Bytes;

    /// The registers of a thread that went blocked. Platform.SafePoint pushes
    /// every callee-saved register in its own frame -- and then returns,
    /// and the wait that follows writes its frames over that one. A caller's
    /// reference that lives only in EBX, ESI or EDI for the length of the
    /// wait would be nowhere the collector reads. So the frame is copied
    /// here as the thread says it is stopped (GcThreads.Spill), and read with
    /// its stack while it is (Gc.ScanStack). SpillCount words from Spill.
    public const int SpillCount = 19 * WordSize.Bytes;
    public const int Spill = 20 * WordSize.Bytes;
    public const int SpillMax = 12;

    /// The bytes this thread has allocated, a 64-bit count (it spans two words on i386, one of the two in long mode): its
    /// retired allocation buffers' used parts and its large blocks. What is
    /// in its current buffer is AllocPtr - AllocBase on top
    /// (GC.GetAllocatedBytesForCurrentThread).
    public const int Allocated = 32 * WordSize.Bytes;

    /// errno as the last [DllImport] with SetLastError = true left it: .NET's
    /// Marshal.GetLastPInvokeError, which is per thread.
    public const int LastError = 34 * WordSize.Bytes;

    /// This thread's size-class cache (Gc, "size classes"): a mapped table,
    /// two words a class -- the page it owns and the head of that page's
    /// free blocks it may take with no lock -- or 0 until it first needs one.
    /// A handshake takes it away as it takes the buffer limit, so that the
    /// next small allocation comes to the slow path and answers; the real
    /// one is kept in ClassesSaved meanwhile.
    public const int Classes = 35 * WordSize.Bytes;
    public const int ClassesSaved = 36 * WordSize.Bytes;

    /// The bytes this thread has taken off its class lists, less what it
    /// freed back onto them, since the collector last counted them in
    /// (Gc.FoldClassBytes): the pressure a small allocation adds, kept
    /// where only this thread writes it.
    public const int ClassBytes = 37 * WordSize.Bytes;

    /// This thread's region arena (Gc, "regions"): its first chunk (0 until
    /// the thread first opens a region), the bump pointer, the end of the
    /// chunk being filled, and where the innermost open region began (0
    /// when none is open). A region is a call the compiler proved every
    /// object made for it dead by its return; they are made here and given
    /// back together when it returns.
    public const int RegionBase = 38 * WordSize.Bytes;
    public const int RegionAt = 39 * WordSize.Bytes;
    public const int RegionEnd = 40 * WordSize.Bytes;
    public const int RegionOpen = 41 * WordSize.Bytes;

    /// The size of the block. The compiler lays the first one down in .bss.
    /// This thread's [ThreadStatic] cells, an object?[] (ThreadStatics), or 0
    /// before its first touch of one. Where the thread finds them, not what
    /// keeps them: that is ThreadStatics' list, a static the collector reads.
    public const int ThreadStatics = 42 * WordSize.Bytes;
    /// Blocks this thread made in regions since it last told Gc.RegionBlocks
    /// (Runtime.AllocRegion): counted here, without a word every thread
    /// writes, and added in where a region ends (Gc.CountRegionBlocks).
    public const int RegionCount = 43 * WordSize.Bytes;
    /// The AsyncContext a continuation running on this block runs in (its
    /// object's word, 0 outside every continuation): what a continuation
    /// registered here captures. A word of the block's, so each processor
    /// of a kernel -- each block -- has its own (AsyncContext).
    public const int AsyncContext = 44 * WordSize.Bytes;
    /// 1 while a continuation's run on this block has a region arena of its
    /// own (AsyncContext, Platform.TaskArenaBytes), mapped as its regions
    /// need and given back as the run ends; 0 otherwise.
    public const int TaskArena = 45 * WordSize.Bytes;
    /// The frame of the call that opened the innermost open region, without
    /// a loop's mark (Gc.OpenerFrame), or 0 when none is open: kept with
    /// RegionOpen wherever that changes (Gc.SetOpen), so that the allocation
    /// in a region put in place at every site (Runtime.AllocRegionSized)
    /// asks one word whether a region is open and is not one a throw has
    /// left -- an allocating frame at or above it -- with one compare.
    public const int RegionFloor = 46 * WordSize.Bytes;
    /// The run of queued work this thread is inside (Scheduler.RunUntil's
    /// frame), the owner a lock taken there is held by (Monitor.Owner), or
    /// 0 outside any: a run is another flow of work, as a thread is.
    public const int MonitorRun = 47 * WordSize.Bytes;
    /// The heap this thread allocates in (Gc, "heaps"): a heap's record, or
    /// 0 for the first heap, the program's or the kernel's. Written by this
    /// thread alone (Runtime.EnterHeap); a kernel whose block is a
    /// processor's saves and restores it with the thread it switches.
    public const int Heap = 48 * WordSize.Bytes;
    /// The class caches of the heaps this thread has left (Gc.SwitchHeap):
    /// a page, a word a heap by its number, or 0 until its first switch.
    /// The block's own, as its cache is: a kernel that moves a parked call
    /// to another processor carries the call's Heap word with it and enters
    /// that heap on the new block (Runtime.EnterHeap), and copies nothing of
    /// the allocator's.
    public const int Shelf = 49 * WordSize.Bytes;
    /// HOW MANY REASONS THE RUNNING CODE MAY NOT BE PREEMPTED, as Linux's
    /// preempt_count: the runtime raises it while it holds a spin lock of its
    /// own (the heap lock, the type initialisers' graph, the type-name
    /// gate), the kernel for its own spin locks and PreemptDisable. A kernel
    /// preempts only where it is 0, Tls.InAlloc is 0 and the code is outside
    /// __corsac_store_sequences: a spin lock's holder preempted on one
    /// processor would leave its waiters spinning for ever.
    public const int PreemptCount = 50 * WordSize.Bytes;
    /// THE KERNEL'S OWN WORD: what the thread is to the platform that runs
    /// it -- a kernel's thread object -- found in one load from the block,
    /// as Linux's `current`. A reference: scanned with the block's other
    /// references (GcThreads.Work). Written once, before the thread runs.
    public const int Owner = 51 * WordSize.Bytes;
    /// TWO RAW WORDS OF THE KERNEL'S: never read, written or scanned by the
    /// runtime. A processor's block keeps its number there, read
    /// gs-relative (Sys.PerCpuRead) on every processor alike.
    public const int Kernel0 = 52 * WordSize.Bytes;
    public const int Kernel1 = 53 * WordSize.Bytes;
    public const int Bytes = 54 * WordSize.Bytes;
}

/// WHERE THE ALLOCATIONS COME FROM (Corsac.GC.AllocSample): every sixteenth
/// allocation (Runtime.AllocHook) is charged, bytes and count, to the return
/// address of the call that made it and to that call's own caller, in a
/// fixed table of the operating system's; the table is printed as the
/// process ends, for tools/sym to name. Nothing here allocates.
static class AllocSamples
{
    // An entry: four addresses -- the site, its caller, and the two calls
    // above the caller -- then four 64-BIT TOTALS, which a word would cut
    // at 4 GB on i386: bytes, count, freed and collected.
    const int Slots = 65536;
    const int W = WordSize.Bytes;
    const int SiteAt = 0;
    const int CallerAt = W;
    const int AboveAt = 2 * W;
    const int Above2At = 3 * W;
    const int BytesAt = 4 * W;
    const int CountAt = 4 * W + 8;
    const int FreedAt = 4 * W + 16;
    const int CollectedAt = 4 * W + 24;
    const int EntryBytes = 4 * W + 32;
    static nuint _table;
    static long _lost;

    // WHICH SAMPLED BLOCKS THE PROGRAM FREED: each sampled block's address
    // and its entry, so a free (Gc.Free) can charge its bytes to the entry
    // it was made at. What an entry made and was not freed this way, the
    // collector took. Open addressing, two words a place; a block the
    // collector took leaves its place behind, written over when another
    // sampled block lands at the same address.
    const int Places = 1048576;
    // A place a block freed or collected left: no block's address.
    const nuint Gone = ~(nuint)0;
    static nuint _places;
    public static bool Tracking;

    /// Also called by a kernel once it has read its own command line
    /// (gui.allocsample=1), after the collector started without it.
    public static void Start()
    {
        if (!Platform.AllocSample()) return;
        Begin();
    }

    /// Sampling from now on, however asked: the image's knob at start, or
    /// AppContext.SetSwitch("Corsac.GC.AllocSample", true) -- corc's
    /// --alloc-sample. Once.
    public static void Begin()
    {
        if (_table != 0) return;
        _table = Platform.Map((nuint)Slots * EntryBytes);
        if (_table == 0) return;
        // WHICH WERE FREED takes twelve megabytes more, past what a small
        // machine's kernel can spare: there the sites and their bytes only.
        if (Platform.AllocSampleFrees())
        {
            _places = Platform.Map(Places * 3 * WordSize.Bytes);
            Tracking = _places != 0;
        }
        Runtime.AllocHook = Sys.AddressOf(AllocSamples.Record);
        Gc.FastPathsChanged();
    }

    /// The `most` heaviest sites by bytes, said as Dump says them and left
    /// counting: what a running kernel allocates, at each census.
    public static void Top(long most)
    {
        nuint table = _table;
        if (table == 0) return;
        // The last said, highest first; an entry's address breaks a tie
        // (0, below every entry, before the first).
        ulong lastBytes = ulong.MaxValue;
        nuint lastAt = 0;
        for (long said = 0; said < most; said++)
        {
            nuint best = 0;
            ulong bestBytes = 0;
            for (nuint i = 0; i < Slots; i++)
            {
                nuint e = table + i * EntryBytes;
                if (Sys.ReadAddress(e + SiteAt) == 0) continue;
                ulong bytes = Sys.Read64(e + BytesAt);
                bool below = bytes < lastBytes || bytes == lastBytes && e > lastAt;
                if (below && bytes > bestBytes) { bestBytes = bytes; best = e; }
            }
            if (best == 0) return;
            Gc.SayNumber("alloc sample site ", Sys.ReadAddress(best + SiteAt));
            Gc.SayNumber("alloc sample caller ", Sys.ReadAddress(best + CallerAt));
            Gc.SayNumber("alloc sample bytes ", bestBytes);
            Gc.SayNumber("alloc sample count ", Sys.Read64(best + CountAt));
            lastBytes = bestBytes;
            lastAt = best;
        }
    }

    // Bytes sampled by allocator: Alloc (a struct's block, a nullable cell,
    // a coroutine frame), AllocLeaf, AllocObject.
    static long _blockBytes;
    static long _leafBytes;
    static long _objectBytes;

    static nuint Record(nuint frameKind, nuint size, nuint made)
    {
        nuint fp = frameKind & ~(nuint)3;
        int kind = (int)(frameKind & 3);
        long bytes = (long)size;
        nuint block = made;
        if (kind == 1) _blockBytes = _blockBytes + bytes;
        else if (kind == 2) _leafBytes = _leafBytes + bytes;
        else _objectBytes = _objectBytes + bytes;
        // The allocator in the site's top bits (code sits far below them):
        // 1 a struct's block or a cell, 2 a leaf, 3 an object.
        nuint site = Sys.ReadAddress(fp + WordSize.Bytes) | ((nuint)kind << 30);
        nuint up = Sys.ReadAddress(fp);
        nuint caller = up != 0 ? Sys.ReadAddress(up + WordSize.Bytes) : 0;
        // AND THE TWO CALLS ABOVE IT: a table's arrays are made by its Rehash
        // for whichever set_Item grew it, and only further up is the code
        // whose table it was.
        nuint up2 = up != 0 ? Sys.ReadAddress(up) : 0;
        nuint above = up2 != 0 ? Sys.ReadAddress(up2 + WordSize.Bytes) : 0;
        nuint up3 = up2 != 0 ? Sys.ReadAddress(up2) : 0;
        nuint above2 = up3 != 0 ? Sys.ReadAddress(up3 + WordSize.Bytes) : 0;
        nuint h = ((site >> 2) ^ (caller << 3) ^ (above << 5) ^ (above2 << 7)) * 40503 & (Slots - 1);
        for (nuint probe = 0; probe < 64; probe++)
        {
            nuint e = _table + ((h + probe) & (Slots - 1)) * EntryBytes;
            nuint at = Sys.ReadAddress(e + SiteAt);
            if (at == 0)
            {
                Sys.WriteAddress(e + SiteAt, site);
                Sys.WriteAddress(e + CallerAt, caller);
                Sys.WriteAddress(e + AboveAt, above);
                Sys.WriteAddress(e + Above2At, above2);
                at = site;
            }
            if (at == site && Sys.ReadAddress(e + CallerAt) == caller
                && Sys.ReadAddress(e + AboveAt) == above && Sys.ReadAddress(e + Above2At) == above2)
            {
                Sys.Write64(e + BytesAt, Sys.Read64(e + BytesAt) + (ulong)bytes);
                Sys.Write64(e + CountAt, Sys.Read64(e + CountAt) + 1);
                if (Tracking && block != 0) Place(block, e, (nuint)bytes);
                return 0;
            }
        }
        _lost = _lost + 1;
        return 0;
    }

    static nuint PlaceOf(nuint block)
    {
        return ((block >> 3) * 2654435761u) & (Places - 1);
    }

    static void Place(nuint block, nuint entry, nuint bytes)
    {
        nuint h = PlaceOf(block);
        for (nuint probe = 0; probe < 32; probe++)
        {
            nuint p = _places + ((h + probe) & (Places - 1)) * 3 * WordSize.Bytes;
            nuint at = Sys.ReadAddress(p);
            if (at == 0 || at == block || at == Gone)
            {
                Sys.WriteAddress(p, block);
                Sys.WriteAddress(p + WordSize.Bytes, entry);
                Sys.WriteAddress(p + 2 * WordSize.Bytes, bytes);
                return;
            }
        }
        // Every place taken -- mostly by blocks the collector has had, which
        // nothing removes: the oldest-looking one gives way, a rotating one,
        // so a full table goes on counting what is freed now.
        _evict = (_evict + 1) & 31;
        nuint q = _places + ((h + _evict) & (Places - 1)) * 3 * WordSize.Bytes;
        Sys.WriteAddress(q, block);
        Sys.WriteAddress(q + WordSize.Bytes, entry);
        Sys.WriteAddress(q + 2 * WordSize.Bytes, bytes);
    }
    static nuint _evict;

    /// A block the program frees: charged to the entry that made it, if sampled.
    public static void Freed(nuint block)
    {
        nuint h = PlaceOf(block);
        for (nuint probe = 0; probe < 32; probe++)
        {
            nuint p = _places + ((h + probe) & (Places - 1)) * 3 * WordSize.Bytes;
            nuint at = Sys.ReadAddress(p);
            if (at == 0) return;
            if (at == block)
            {
                nuint e = Sys.ReadAddress(p + WordSize.Bytes);
                Sys.Write64(e + FreedAt, Sys.Read64(e + FreedAt) + Sys.ReadAddress(p + 2 * WordSize.Bytes));
                Sys.WriteAddress(p, Gone);
                return;
            }
        }
    }

    /// A block the collector swept up: charged to the entry that made it, if
    /// sampled. What an entry made and neither count took was alive at the end.
    public static void Collected(nuint block)
    {
        nuint h = PlaceOf(block);
        for (nuint probe = 0; probe < 32; probe++)
        {
            nuint p = _places + ((h + probe) & (Places - 1)) * 3 * WordSize.Bytes;
            nuint at = Sys.ReadAddress(p);
            if (at == 0) return;
            if (at == block)
            {
                nuint e = Sys.ReadAddress(p + WordSize.Bytes);
                Sys.Write64(e + CollectedAt, Sys.Read64(e + CollectedAt) + Sys.ReadAddress(p + 2 * WordSize.Bytes));
                Sys.WriteAddress(p, Gone);
                return;
            }
        }
    }

    public static void Dump()
    {
        nuint table = _table;
        if (table == 0) return;
        _table = 0;
        Tracking = false;
        Runtime.AllocHook = 0;
        Gc.FastPathsChanged();
        for (nuint i = 0; i < Slots; i++)
        {
            nuint e = table + i * EntryBytes;
            if (Sys.ReadAddress(e + SiteAt) == 0) continue;
            Gc.SayNumber("alloc sample site ", Sys.ReadAddress(e + SiteAt));
            Gc.SayNumber("alloc sample caller ", Sys.ReadAddress(e + CallerAt));
            Gc.SayNumber("alloc sample above ", Sys.ReadAddress(e + AboveAt));
            Gc.SayNumber("alloc sample above2 ", Sys.ReadAddress(e + Above2At));
            Gc.SayNumber("alloc sample bytes ", Sys.Read64(e + BytesAt));
            // AND THE LINE THE CALL IS ON, for a tool to read without
            // decoding the image's line program itself -- written where the
            // names lie, as the fault report writes them: nothing here may
            // allocate, or every program would need a collector for the end
            // it reaches this way.
            Runtime.SayWhere("alloc sample where ", (Sys.ReadAddress(e + SiteAt) & (((nuint)1 << 30) - 1)) - 1);
            Gc.SayNumber("alloc sample freed ", Sys.Read64(e + FreedAt));
            Gc.SayNumber("alloc sample collected ", Sys.Read64(e + CollectedAt));
            Gc.SayNumber("alloc sample count ", Sys.Read64(e + CountAt));
        }
        Gc.SayNumber("alloc sample lost ", _lost);
        Gc.SayNumber("alloc sample block bytes ", _blockBytes);
        Gc.SayNumber("alloc sample leaf bytes ", _leafBytes);
        Gc.SayNumber("alloc sample object bytes ", _objectBytes);
    }
}

/// A TYPE AS AN OBJECT, .NET's System.RuntimeType: what a Type is when it is
/// held as one -- `object o = typeof(int)`, an attribute's TypeId, a type in
/// a list of objects. A Type is its descriptor's address everywhere else
/// (Lowering's typeof and GetType), on which no virtual call can be made, so
/// a Type converted to object is this, and an object cast to Type is this
/// one's Handle (Runtime.TypeObject, TypeOfObject). ONE OBJECT A TYPE, made
/// the first time it is asked for and kept: `(object)typeof(int) ==
/// (object)typeof(int)`, as in .NET, and its hash and equality are an
/// object's own, which a Type's own GetHashCode and Equals ask of it.
sealed class RuntimeType
{
    internal readonly Type Handle;
    RuntimeType? _next;

    RuntimeType(Type handle) { Handle = handle; }

    public override string ToString() => String.TypeText(Handle.FullName);

    // EACH TYPE'S ONE OBJECT, found by its name's hash and added without a
    // lock: two threads making one type's at once keep the first one in.
    const int Buckets = 64;
    static readonly RuntimeType?[] _known = new RuntimeType?[Buckets];

    internal static RuntimeType? Of(Type? handle)
    {
        if (handle == null) return null;
        int at = (handle.FullName.GetHashCode() & 0x7fffffff) % Buckets;
        RuntimeType? made = null;
        while (true)
        {
            RuntimeType? head = _known[at];
            for (RuntimeType? known = head; known != null; known = known._next)
                if (known.Handle == handle) return known;
            made ??= new RuntimeType(handle);
            made._next = head;
            if (Sys.CompareExchangeReference(Sys.AddressOf(ref _known[at]), Sys.ObjectAddress(head), Sys.ObjectAddress(made)) == Sys.ObjectAddress(head)) return made;
        }
    }
}

/// What stops a suspended iterator from inside when it is disposed; never
/// seen outside MoveNext.
sealed class IteratorStopSignal : Exception
{
    /// THE ONE SIGNAL (Runtime.IteratorStop), made by the type's initialiser
    /// the first time an iterator is stopped: once in a run, which is what a
    /// program's walk for allocations knows of an initialiser. Filled behind
    /// a test of a field, it was made once all the same, but the walk could
    /// not tell that from an allocation every stop makes, and every program
    /// that stopped an iterator kept a collector for it.
    internal static readonly IteratorStopSignal One = new IteratorStopSignal();

    public IteratorStopSignal() : base("The iterator was disposed.") { }
}

/// A collection the compiler may give the elements of back as it dies
/// (Opt.OwnedElements): it proved each one was made for the collection, is
/// held by nothing else, and is dead by then. Every instantiation's vtable
/// carries the method, so one call reaches whichever it is.
/// THE ARRAYS A COLLECTION KEEPS ITS ELEMENTS IN, given back with it when
/// it is proved dead (Runtime.Free): they never leave the collection (a List
/// that lent its array out keeps it), so nothing else can hold them. Marked
/// in the type's descriptor (DescGcFlags, OwnsStorage) by lowering.
interface IOwnsStorage
{
    void FreeStorage();
}

/// .NET's System.Delegate: WHAT EVERY DELEGATE IS. A delegate type here is an
/// interface with an Invoke (Parser.ParseDelegateDeclaration), and the binder
/// gives each one this as its base (Binder.DeclareMembersIn), as every .NET
/// delegate type derives from Delegate -- so an Action is a Delegate, an
/// array of Delegates holds any of them, and the members below are every
/// delegate's.
///
/// A delegate is one of two things. A closure the compiler made of a lambda
/// or a method group, which is one target and answers these members with the
/// bodies written here and the two its delegate type writes (CombineImpl and
/// RemoveImpl: only the type knows the multicast class it combines into); the
/// binder fills a closure's slots with them (Binder.DelegateMembers). Or that
/// multicast class, written beside every delegate type (Parser.Multicast),
/// which holds the targets in order and answers all of them itself.
///
/// Method and Target are not here: they answer a MethodInfo and the object a
/// closure was made over, and there is no reflection to make the one, nor a
/// target .NET would name in a closure that captured locals.
interface Delegate
{
    /// The targets a call runs, in the order it runs them: for a single
    /// delegate, itself alone.
    public Delegate[] GetInvocationList() { return new Delegate[] { this }; }

    /// This delegate followed by `follow`, which is a delegate of the same
    /// type -- Delegate.Combine's work once neither side is null and the two
    /// are seen to be of one type (Runtime.SameDelegateType). Each
    /// delegate type answers it for its own closures, the one place that can
    /// name the multicast class to make.
    public Delegate? CombineImpl(Delegate follow) { throw new NotSupportedException("Delegates of this type cannot be combined."); }

    /// This delegate without the last run of `value`'s targets in it, or null
    /// when that leaves nothing -- Delegate.Remove's work. A single delegate
    /// is removed only by one equal to it, as its own Equals says (a method
    /// group's closure answers for its method, Runtime.GroupEquals).
    public Delegate? RemoveImpl(Delegate value) { return ((object)this).Equals(value) ? null : this; }

    /// .NET's Delegate.Combine: the two run one after the other, either
    /// alone when the other is null. Delegates of two types do not combine
    /// (ArgumentException), as .NET's do not.
    public static Delegate? Combine(Delegate? a, Delegate? b)
    {
        if (a == null) return b;
        if (b == null) return a;
        if (!Runtime.SameDelegateType(a, b)) throw new ArgumentException("Delegates must be of the same type.");
        return a.CombineImpl(b);
    }

    /// Every one of them combined, in order; null for none.
    public static Delegate? Combine(params Delegate?[]? delegates)
    {
        if (delegates == null || delegates.Length == 0) return null;
        Delegate? all = delegates[0];
        for (int i = 1; i < delegates.Length; i++) all = Combine(all, delegates[i]);
        return all;
    }

    /// .NET's Delegate.Remove: `source` without the LAST contiguous run of
    /// `value`'s targets -- a multicast removes a multicast out of the middle
    /// of another -- and `source` itself when there is none.
    public static Delegate? Remove(Delegate? source, Delegate? value)
    {
        if (source == null) return null;
        if (value == null) return source;
        if (!Runtime.SameDelegateType(source, value)) throw new ArgumentException("Delegates must be of the same type.");
        return source.RemoveImpl(value);
    }

    /// .NET's Delegate.RemoveAll: Remove until nothing more comes out. Remove
    /// hands back the very delegate it was given when it removes nothing.
    public static Delegate? RemoveAll(Delegate? source, Delegate? value)
    {
        Delegate? before;
        do
        {
            before = source;
            source = Remove(source, value);
        }
        while (Sys.ObjectAddress(before) != Sys.ObjectAddress(source));
        return before;
    }
}

/// WHAT THE COMPILER WRITES WHERE A PROGRAM USES DELEGATES, under a name no
/// program declares: `a += b` and `a + b` are Combine, `a -= b` and `a - b`
/// Remove, `a == b` Same (Binder.DelegateCombination, Binder.CheckBinary),
/// and the multicast class the parser writes beside each delegate type
/// (Parser.Multicast) compares and hashes through Equal and Hash. Reached
/// by a name of its own, because these are written into the program's own
/// namespaces, where a type of the program's may be called Runtime or
/// Delegate.
///
/// Combine and Remove are generic over the delegate's type, so the call is
/// typed as the delegate it combines -- an Action stays an Action -- without
/// naming the multicast class a generic or nested delegate type has: the
/// work goes through Delegate, whose CombineImpl and RemoveImpl each type
/// answers for itself, and which refuses two delegates of different types.
static class __Delegates
{
    // AS A DELEGATE, not as T: the binder types the call as the operator's
    // own delegate type (Binder.DelegateCombination), and a cast to T here
    // was a test against the shared copy's T -- `Func<__canon, __canon>`,
    // which a Func<int, int> is not -- or, for a multicast made in shared
    // code, against arguments it never had. Combine and Remove of one type
    // answer that type (Delegate.Combine refuses two), so nothing is tested.
    public static Delegate? Combine<T>(T? a, T? b) where T : class
    {
        if (a == null) return (Delegate?)(object?)b;
        if (b == null) return (Delegate?)(object?)a;
        return Delegate.Combine((Delegate)(object)a, (Delegate)(object)b);
    }

    public static Delegate? Remove<T>(T? a, T? b) where T : class
    {
        if (a == null) return null;
        if (b == null) return (Delegate?)(object?)a;
        return Delegate.Remove((Delegate)(object)a, (Delegate)(object)b);
    }

    public static bool Same(object? a, object? b) { return Runtime.SameDelegate(a, b); }

    public static bool Equal(object? a, object? b) { return Runtime.DelegateEquals(a, b); }

    public static int Hash(object self) { return Runtime.DelegateHash(self, 0); }
}

/// A delegate made of several, as the runtime sees one: the multicast class
/// the parser writes beside every delegate type answers it, and nothing else
/// does -- which is how the runtime's equality (Runtime.DelegateEquals) tells a
/// multicast from a single closure without asking a delegate type it cannot
/// name.
interface IMulticastDelegate
{
    int InvocationCount();
    object InvocationAt(int index);
}

interface IOwnsElements : IOwnsStorage
{
    void FreeOwnedElements();
    /// From here on its elements go with its storage (FreeStorage), however
    /// it comes to be freed: an owned field's collection, freed with the
    /// object that holds it (Runtime.FreeField, Runtime.FreeOwnedFields), is
    /// freed by no code the compiler placed beside it (Opt.OwnedElements,
    /// through a field).
    void OwnElements();
}

static partial class Runtime
{
    /// THE 386'S ATOMICS. A 386 reads and writes memory as one only with
    /// XCHG: it has no XADD (Interlocked.Add and Increment) and no CMPXCHG
    /// (CompareExchange, and every atomic made of it). Under --cpu=386 the
    /// compiler calls these instead (Lowering.Atomic386): the read and the
    /// write between Platform.AtomicsEnter and Leave -- interrupts off on
    /// bare metal, one lock in a process -- answering what was there. Never
    /// an atomic of their own but Enter's exchange.
    ///
    /// THE LOCK, where interrupts may not be turned off: this word, taken by
    /// XCHG, by Platform.AtomicsEnter and by the kernel's compare-exchange
    /// sequence on a 386 (X86Backend's __corsac_refcas), which names it.
    public static int Atomics386;

    // A 386's words are 32 bits: each reads and writes exactly those.
    public static int AtomicAdd386(nuint word, int value)
    {
        uint held = Platform.AtomicsEnter();
        int was = (int)Sys.Read32(word);
        Sys.Write32(word, (uint)(was + value));
        Platform.AtomicsLeave(held);
        return was;
    }

    /// An exchange under the same lock, so that it never lands between a
    /// compare-exchange's read and its write (Lowering.EmitAtomic).
    public static int AtomicSwap386(nuint word, int value)
    {
        uint held = Platform.AtomicsEnter();
        int was = (int)Sys.Read32(word);
        Sys.Write32(word, (uint)value);
        Platform.AtomicsLeave(held);
        return was;
    }

    public static int AtomicCas386(nuint word, int expect, int value)
    {
        uint held = Platform.AtomicsEnter();
        int was = (int)Sys.Read32(word);
        if (was == expect) Sys.Write32(word, (uint)value);
        Platform.AtomicsLeave(held);
        return was;
    }

    /// And (0), or (1) or exclusive or (2) of `value` into the word at `at`.
    public static int AtomicBits386(nuint word, int value, int op)
    {
        uint held = Platform.AtomicsEnter();
        int was = (int)Sys.Read32(word);
        Sys.Write32(word, (uint)(op == 0 ? was & value : op == 1 ? was | value : was ^ value));
        Platform.AtomicsLeave(held);
        return was;
    }

    /// The elements of a dying collection, given back (IOwnsElements). Null,
    /// a frame slot not yet filled (no vtable yet), or anything that is not
    /// such a collection is nothing to do.
    public static void FreeOwnedElements(object? collection)
    {
        if (collection == null || (Sys.ReadAddress(Sys.ObjectAddress(collection))) == 0) return;
        if (collection is IOwnsElements owner) owner.FreeOwnedElements();
    }

    /// THE ELEMENTS OF A DYING ARRAY OF COLLECTIONS, given back (Opt.
    /// OwnedElements, Escape.ConfirmArrayElements): the compiler proved each
    /// element is a collection made for its slot, held by nothing else, and
    /// dead when the array is. Each freed with its storage, its slot
    /// cleared. Null, a frame slot not yet filled (no vtable yet), or
    /// anything that is not an array of references is nothing to do.
    public static void FreeArrayElements(object? array)
    {
        if (array == null) return;
        nuint at = Sys.ObjectAddress(array);
        if ((Sys.ReadAddress(at)) == 0) return;
        FreeReferenceElements(at);
    }

    /// Every element of the array at `payload` freed and its slot cleared
    /// (FreeArrayElements, the owned fields): only for an array whose
    /// elements are references a word each, read off its descriptor as the
    /// mark reads it; anything else is left alone. The runtime's and not the
    /// collector's: a program with no collector frees an array's elements
    /// into the manual heap the same way.
    public static void FreeReferenceElements(nuint payload)
    {
        const int w = WordSize.Bytes;
        nuint vt = Sys.ReadAddress(payload);
        if (vt == 0 || CollectorLinked() && Gc.InQuarantine(vt)) return;
        nuint desc = vt - Gc.DescWords * w;
        if ((Sys.ReadAddress(desc + Gc.DescSelfWord * w)) != desc) return;
        nuint flags = Sys.ReadAddress(desc + Gc.DescFlagsWord * w);
        if ((flags & Gc.SequenceFlag) == 0 || (flags & Gc.StringFlag) != 0) return;
        if ((Sys.ReadAddress(desc + Gc.DescGcFlagsWord * w) & Gc.ElementsAreReferences) == 0) return;
        if (Sys.ReadAddress(desc + Gc.DescSizeWord * w) != w) return;
        nuint count = Sys.ReadAddress(payload + Gc.ArrayCountAt) & 0x7FFFFFFF;
        nuint first = payload + Sys.ReadAddress(desc + Gc.DescPayloadWord * w);
        for (nuint i = 0; i < count; i++)
        {
            nuint cell = first + i * w;
            nuint element = Sys.ReadAddress(cell);
            if (element == 0) continue;
            Sys.WriteAddress(cell, 0);
            Free(element);
        }
    }

    /// A collection whose elements the compiler proved are the collection's
    /// own wherever it is read -- through the one field it is handed to, by
    /// code that keeps the field's value alive past every use of what it read
    /// -- gives them back whenever its storage goes (IOwnsElements.OwnElements).
    public static void OwnElements(object? collection)
    {
        if (collection is IOwnsElements owner) owner.OwnElements();
    }

    /// A collection the compiler made in a frame instead of the heap (Escape's
    /// promotion) gives its storage back when that copy dies or the slot is
    /// filled again: the arrays it grew are the heap's, and went to the
    /// collector with nothing to free them. Nothing there yet (a zero vtable
    /// word, as the slot starts) is nothing to do.
    public static void FreeStorageInFrame(object? collection)
    {
        long ignored = Gc.IgnoredFrees;
        if (ignored == 's' || ignored != 0 && ignored != 'p' && ignored != 'f' && ignored != 'r') return;
        if (collection == null || (Sys.ReadAddress(Sys.ObjectAddress(collection))) == 0) return;
        if (collection is IOwnsStorage owner) owner.FreeStorage();
    }

    /// Delegate equality. Two closures are the same delegate when they are
    /// the same class -- which, for a method group, means the same method,
    /// because the compiler names those classes by the method -- and hold
    /// the same captured words, which for an instance method is the target.
    /// The object's size is the second word of its descriptor, and the
    /// descriptor sits DescriptorBytes before the vtable the object points
    /// at: twelve words before it, the size in the second.
    public static bool SameClosure(object? a, object? b)
    {
        nuint pa = Sys.ObjectAddress(a);
        nuint pb = Sys.ObjectAddress(b);
        if (pa == pb) return true;
        if (pa == 0 || pb == 0) return false;
        nuint vt = Sys.ReadAddress(pa);
        if (vt != Sys.ReadAddress(pb)) return false;
        nuint size = Sys.ReadAddress(vt - 12 * WordSize.Bytes + WordSize.Bytes);
        for (nuint at = 2 * WordSize.Bytes; at + WordSize.Bytes <= size; at += WordSize.Bytes)
        {
            if (Sys.ReadAddress(pa + at) != Sys.ReadAddress(pb + at)) return false;
        }
        return true;
    }

    /// DELEGATE EQUALITY AS .NET HAS IT (Delegate.Equals, and the `==` C#
    /// gives every delegate type, which the binder turns into this): the same
    /// method on the same target. A multicast is equal to another of the same
    /// type whose targets are equal one by one and in order, and never to a
    /// single delegate. What a lambda's closure answers through its Equals
    /// slot (Lowering.DelegateEqualsStub), and what the multicast class the
    /// parser writes answers through its own.
    public static bool DelegateEquals(object? a, object? b)
    {
        if (Sys.ObjectAddress(a) == Sys.ObjectAddress(b)) return true;
        if (a == null || b == null) return false;
        IMulticastDelegate? many = a as IMulticastDelegate;
        IMulticastDelegate? others = b as IMulticastDelegate;
        if (many == null || others == null) return many == null && others == null && SameClosure(a, b);
        if (Sys.ReadAddress(Sys.ObjectAddress(a)) != Sys.ReadAddress(Sys.ObjectAddress(b))) return false;
        int count = many.InvocationCount();
        if (count != others.InvocationCount()) return false;
        // EACH TARGET ASKED ITS OWN QUESTION, through its Equals slot: a
        // method group's closure is equal to another class's closure of the
        // same method (GroupEquals), which no comparison of the two layouts
        // can see.
        for (int i = 0; i < count; i++)
        {
            if (!many.InvocationAt(i).Equals(others.InvocationAt(i))) return false;
        }
        return true;
    }

    /// `a == b` OVER TWO DELEGATES, as C# gives every delegate type the
    /// operator (Binder.CheckBinary): .NET's Delegate.op_Equality, the same
    /// reference or both there and equal by the right one's own Equals.
    public static bool SameDelegate(object? a, object? b)
    {
        if (Sys.ObjectAddress(a) == Sys.ObjectAddress(b)) return true;
        if (a == null || b == null) return false;
        return b.Equals(a);
    }

    /// WHETHER TWO DELEGATES ARE OF ONE TYPE, which .NET's Delegate.Combine
    /// and Delegate.Remove require of their arguments (ArgumentException
    /// otherwise). Not whether the one converts to the other: a Func<string>
    /// held as a Func<object> is still a Func<string> -- variance converts no
    /// object -- and combined with a Func<object> it is refused, as in .NET. A
    /// delegate's type is the one delegate interface its class implements, a
    /// closure's or a multicast's, marked as one in its descriptor's flags
    /// (Lowering.TypeFlagDelegate).
    ///
    /// A MULTICAST BY ITS TARGETS: one made in a generic delegate's shared
    /// code (Delegate.CombineImpl) is of that code's canonical type --
    /// Action<__canon> for an Action<string> -- while what it combines are
    /// of the type itself, as is every delegate it was made from.
    public static bool SameDelegateType(object a, object b)
    {
        return DelegateTypeOf(Sys.ObjectAddress(Targeted(a))) == DelegateTypeOf(Sys.ObjectAddress(Targeted(b)));
    }

    static object Targeted(object d)
    {
        while (d is IMulticastDelegate many && many.InvocationCount() > 0) d = many.InvocationAt(0);
        return d;
    }

    /// A DELEGATE'S TYPE, as GetType() answers it (Lowering.TypeFlagDelegateObject):
    /// the delegate type its closure's or multicast's class implements, read
    /// off the descriptor alone -- handed the object, every object GetType
    /// was asked of (a LINQ source's `GetType() == typeof(List<T>)`) looked
    /// kept by this call, and nothing freed it.
    public static nuint DelegateTypeOfDescriptor(nuint desc)
    {
        return DelegateFace(desc);
    }

    static nuint DelegateTypeOf(nuint obj)
    {
        return DelegateFace((Sys.ReadAddress(obj)) - 12 * WordSize.Bytes);
    }

    static nuint DelegateFace(nuint desc)
    {
        const int w = WordSize.Bytes;
        nuint faces = Sys.ReadAddress(desc + 4 * w);
        if (faces != 0)
        {
            for (nuint at = faces; ; at = at + w)
            {
                nuint face = Sys.ReadAddress(at);
                if (face == 0) break;
                if ((Sys.ReadAddress(face + 6 * w) & DelegateFlag) != 0) return face;
            }
        }
        return desc;
    }

    /// The flag a delegate type's descriptor carries (Lowering.TypeFlagDelegate).
    const int DelegateFlag = 512;

    /// A METHOD GROUP'S DELEGATE, compared: equal to any other delegate made
    /// from the same method on the same target, whichever class made it. The
    /// compiler names a method group's closure by the type that converted it
    /// as well as by the method, so `Handlers.Run` turned into an Action in
    /// one class and in another are two closure classes -- and .NET calls the
    /// two delegates equal, which is what `-=` from somewhere else needs.
    /// Every closure of the one method has the same routine in its Equals
    /// slot (Lowering.GroupEqualsStub, named by the method), `slot` bytes past
    /// its vtable: that routine is the method's identity, and the target is
    /// the closure's one word, or nothing for a static method.
    public static bool GroupEquals(object? a, object? b, int slot)
    {
        if (DelegateEquals(a, b)) return true;
        if (a == null || b == null) return false;
        nuint va = Sys.ReadAddress(Sys.ObjectAddress(a));
        nuint vb = Sys.ReadAddress(Sys.ObjectAddress(b));
        // A string or an array has no slots to read; its flags say so.
        if ((Sys.ReadAddress(vb - 12 * WordSize.Bytes + 6 * WordSize.Bytes) & 1) != 0) return false;
        if (Sys.ReadAddress(va + (nuint)slot) != Sys.ReadAddress(vb + (nuint)slot)) return false;
        nuint size = Sys.ReadAddress(va - 12 * WordSize.Bytes + WordSize.Bytes);
        if (size != Sys.ReadAddress(vb - 12 * WordSize.Bytes + WordSize.Bytes)) return false;
        nuint pa = Sys.ObjectAddress(a);
        nuint pb = Sys.ObjectAddress(b);
        for (nuint at = 2 * WordSize.Bytes; at + WordSize.Bytes <= size; at += WordSize.Bytes)
        {
            if (Sys.ReadAddress(pa + at) != Sys.ReadAddress(pb + at)) return false;
        }
        return true;
    }

    /// The hash that goes with DelegateEquals and GroupEquals: equal
    /// delegates hash alike. A multicast combines its targets' own hashes, a
    /// method group's closure hashes its method's identity (`identity`, the
    /// address of the routine GroupEquals compares), and any other closure
    /// its class -- which is what a lambda written once is.
    public static int DelegateHash(object self, nuint identity)
    {
        if (self is IMulticastDelegate many)
        {
            int hash = 0;
            int count = many.InvocationCount();
            for (int i = 0; i < count; i++) hash = unchecked(hash * 33 + many.InvocationAt(i).GetHashCode());
            return hash;
        }
        nuint word = identity != 0 ? (nuint)identity : Sys.ReadAddress(Sys.ObjectAddress(self));
        return (int)(word >> 3);
    }

    // State is a naturally aligned static word: 0 unclaimed, 1 completed,
    // 2 failed, otherwise the initializing thread's control-block address.
    // No allocation is allowed in this protocol. Current thread control
    // blocks live until process exit; stack reclamation must preserve that
    // lifetime while initialization wait-graph readers can observe them.
    // THE WAIT GRAPH, ONE WALKER AT A TIME: publishing a waiter's edge and
    // walking the graph from the owner are one step under this word, as the
    // CLR takes one lock for its class-constructor deadlocks. Two threads
    // closing one cycle at the same moment each saw the other's edge, and
    // both took the cycle for theirs to break -- each read the other's
    // static half made (optimizer_static_initialization_threads, exit 7).
    // Now the last to close a cycle sees it, once. Nothing in the step
    // allocates, waits or reaches a safepoint.
    static nuint _typeInitGraph;

    public static int EnterTypeInitialization(nuint state)
    {
        // THE OWNER IS THE RUNNING CODE, not always its thread block: a
        // kernel's block is a processor's, and an initializer that parks in
        // a system call would leave the processor named as the owner -- the
        // next call on it took the type for its own, half made, and one on
        // another processor waited on a processor (Platform.TypeInitOwnerHook).
        nuint self = Platform.TypeInitOwnerHook != 0 ? (nuint)Sys.Call(Platform.TypeInitOwnerHook, 0, 0, 0) : 0;
        if (self == 0) self = Sys.ThreadBlock();
        if (self == 0) self = Sys.MainThreadBlock();
        while (true)
        {
            nuint owner = Sys.ReadAddress(state);
            if (owner == 1 || owner == self) return 0;
            if (owner == 2) return 2;
            if (owner == 0)
            {
                if (Sys.Cas(state, 0, self) == 0) return 1;
                continue;
            }
            // THE GRAPH'S WORD NAMES ITS HOLDER, and nobody spins on their own:
            // a kernel's interrupt handler that meets a type being made
            // elsewhere, on the processor whose interrupted code holds the
            // word, would spin for ever on a holder that cannot run again
            // until it returns. Its context already holds the walk -- and
            // the edge word is that context's too -- so it neither publishes
            // nor walks, and only waits, as every waiter did before the word.
            nuint graph = Sys.AddressOf(ref _typeInitGraph);
            nuint held;
            // NOT PREEMPTED WHILE THE GRAPH IS HELD (Tls.PreemptCount): its
            // other waiters spin.
            PreemptOff();
            while ((held = Sys.Cas(graph, 0, self)) != 0 && held != self) Sys.Pause();
            bool nested = held == self;
            if (nested) PreemptOn();
            if (!nested)
            {
                if (Sys.ReadAddress(state) != owner)
                {
                    Sys.AtomicSwap(graph, 0);
                    PreemptOn();
                    continue;
                }
                Sys.AtomicSwap(self + Tls.TypeInitWait, state);
                nuint peer = owner;
                bool cycle = false;
                for (int steps = 0; peer > 2 && steps < 256; steps++)
                {
                    if (peer == self) { cycle = true; break; }
                    nuint waits = Sys.ReadAddress(peer + Tls.TypeInitWait);
                    if (waits == 0) break;
                    peer = Sys.ReadAddress(waits);
                }
                if (cycle) Sys.AtomicSwap(self + Tls.TypeInitWait, 0);
                Sys.AtomicSwap(graph, 0);
                PreemptOn();
                if (cycle) return 0;
            }
            // A CALL THAT CAN PARK WAITS PARKED (Platform.TypeInitWaitHook):
            // the owner may itself be parked, and resumed only where this
            // would spin. Otherwise a waiter exposes its roots before
            // blocking: the owner may allocate and collect while executing
            // the initializer.
            if (Platform.TypeInitWaitHook == 0 || Sys.ReadAddress(state) != owner
                || Sys.Call(Platform.TypeInitWaitHook, state, owner, 0) == 0)
            {
                BeginBlocking();
                if (Sys.ReadAddress(state) == owner) Platform.Wait(state, (int)Sys.Low32(owner));
                EndBlocking();
            }
            if (!nested) Sys.AtomicSwap(self + Tls.TypeInitWait, 0);
        }
    }

    public static void CompleteTypeInitialization(nuint state)
    {
        Sys.AtomicSwap(state, 1u);
        Platform.Wake(state, 2147483647);
    }

    public static void FailTypeInitialization(nuint state)
    {
        Sys.AtomicSwap(state, 2u);
        Platform.Wake(state, 2147483647);
    }

    // ---- the system underneath ---------------------------------------------
    //
    // Three things the runtime cannot do without an operating system (or a
    // machine, when there is none): find memory, stop, and put bytes
    // somewhere a person can see them. Each lib/sys/*.cor provides a
    // `static class Platform` with exactly these, and nothing above this
    // point in the stack knows which one is linked:
    //
    //   long Platform.Map(nuint bytes)               fresh ZEROED, page-aligned
    //                                               memory of `bytes`, or 0
    //   void Platform.Exit(int code)                does not return
    //   long Platform.WriteBytes(int fd, nuint at, long count)
    //                                               bytes written, or -errno
    //   void Platform.EnterCollection()             pushes every callee-saved
    //                                               register, then calls
    //                                               Gc.CollectInner (see GcRoots)
    //
    // (There is no `partial` here, and the compiler finds Runtime's members
    // by name on ONE class, so the split is by forwarding rather than by
    // declaring Runtime twice.)

    // ---- what the image was built with ---------------------------------------
    //
    // THE RUNTIME'S SETTINGS ARE THE IMAGE'S, NEVER THE ENVIRONMENT'S: corc's
    // --runtime-knob NAME=VALUE, or a project's RuntimeHostConfigurationOption,
    // written into the program as .NET's Native AOT writes runtimeconfig.json's
    // settings into its image (ILC's --runtimeknob). A setting that rode
    // along unseen in the environment changed a run nobody could see the
    // command for. The entry stub hands them over as one literal -- each
    // NAME=VALUE ended by a NUL -- after the thread block exists and before
    // the main thread is registered, so the collector has them before it
    // starts. A program built with none never calls UseKnobs, and every
    // knob reads as unset. AppContext answers them too, as .NET's answers
    // runtimeconfig.json's.

    /// Where the knobs' UTF-16 units begin and end; 0 for an image built with none.
    static nuint _knobs;
    static nuint _knobsEnd;

    /// The knobs, from the entry stub. A literal the compiler laid out, in
    /// the image for the life of the process: nothing is allocated, nothing
    /// needs keeping, and every thread may read it at any time.
    public static void UseKnobs(string block)
    {
        _knobs = Sys.StringData(block);
        _knobsEnd = _knobs + (nuint)block.Length * 2;
    }

    /// Where knob `name`'s value begins -- UTF-16 units, ended by a NUL --
    /// or 0 when the image was not built with it. Allocates nothing: the
    /// collector asks as it starts, holding its lock, and at collections.
    public static nuint KnobValue(string name)
    {
        nuint at = _knobs;
        while (at != 0 && at < _knobsEnd)
        {
            int i = 0;
            while (i < name.Length && Sys.Read16(at + (nuint)i * 2) == name[i])
            {
                i = i + 1;
            }
            if (i == name.Length && Sys.Read16(at + (nuint)i * 2) == '=')
            {
                return at + (nuint)i * 2 + 2;
            }
            while (Sys.Read16(at) != 0)
            {
                at = at + 2;
            }
            at = at + 2;
        }
        return 0;
    }

    /// Knob `name` as a number -- decimal, or hexadecimal after 0x, as .NET
    /// reads a number from its own knobs -- or 0 when it is not set. Every
    /// platform's collector settings are read with these, hosted or alone on
    /// the machine, allocating nothing.
    public static long KnobNumber(string name)
    {
        nuint at = KnobValue(name);
        long value = 0;
        if (at != 0 && Sys.Read16(at) == '0' && (Sys.Read16(at + 2) | 0x20) == 'x')
        {
            at = at + 4;
            while (true)
            {
                long c = Sys.Read16(at);
                if (c >= '0' && c <= '9') value = value * 16 + c - '0';
                else if ((c | 0x20) >= 'a' && (c | 0x20) <= 'f') value = value * 16 + (c | 0x20) - 'a' + 10;
                else return value;
                at = at + 2;
            }
        }
        while (at != 0 && Sys.Read16(at) >= '0' && Sys.Read16(at) <= '9')
        {
            value = value * 10 + Sys.Read16(at) - '0';
            at = at + 2;
        }
        return value;
    }

    /// Whether knob `name` is set to something other than nothing, 0 or
    /// false (in any case, as bool.Parse reads it): 1 and true are on, and
    /// so is a letter that says which kind.
    public static bool KnobFlag(string name)
    {
        nuint at = KnobValue(name);
        if (at == 0) return false;
        nuint first = Sys.Read16(at);
        if (first == 0 || first == '0') return false;
        string off = "false";
        int i = 0;
        while (i < off.Length && (Sys.Read16(at + (nuint)i * 2) | 0x20) == off[i])
        {
            i = i + 1;
        }
        return i < off.Length || Sys.Read16(at + (nuint)i * 2) != 0;
    }

    /// The first character of knob `name`'s value, or 0 when it is unset or
    /// empty.
    public static long KnobLetter(string name)
    {
        nuint at = KnobValue(name);
        return at == 0 ? 0 : Sys.Read16(at);
    }

    /// Corsac.GC.FreePaths as the mask of the free paths skipped (the
    /// platform's SkippedFreePaths says what each letter is): t 1, i 2, b 4,
    /// d 8, m 16, p 32, P 64.
    public static long FreePathsMask()
    {
        nuint at = KnobValue("Corsac.GC.FreePaths");
        long mask = 0;
        while (at != 0 && Sys.Read16(at) != 0)
        {
            long c = Sys.Read16(at);
            mask = mask | (c == 't' ? 1 : c == 'i' ? 2 : c == 'b' ? 4 : c == 'd' ? 8 : c == 'm' ? 16 : c == 'p' ? 32 : c == 'P' ? 64 : 0);
            at = at + 2;
        }
        return mask;
    }

    // ---- what a thread is ---------------------------------------------------
    //
    // The compiler's entry stub calls the first two, in this order, before a
    // single static initialiser runs: nothing can throw or allocate until the
    // block exists, because the handler chain and the allocator are both in
    // it. lib/threading.cor calls the rest for every thread it starts.

    /// Puts this thread's block where Sys.ThreadBlock() will find it. The
    /// main thread's block is static memory, so this needs no heap.
    public static void StartThreadBlock()
    {
        Platform.SetThreadBlock(Sys.MainThreadBlock());
    }

    /// Tells the collector about the thread that is running this. Called by
    /// the entry stub for the first thread once its stack top is written down.
    public static void StartThread()
    {
        GcThreads.Register(Sys.ThreadBlock());
    }

    /// Tells the collector about a thread STARTED BY ANOTHER, BEFORE it
    /// starts: `block` is the child's, `stackTop` the stack it will run on.
    ///
    /// Registered as STOPPED with an empty stack, which is the truth until the
    /// child runs, and is what keeps the window between the two safe in both
    /// directions: a collection in it neither waits for a thread that does not
    /// exist yet nor sweeps an object the child has already made. The child
    /// says it is running, with EndBlocking, once its block is its own.
    public static void RegisterThread(nuint block, nuint stackTop)
    {
        Sys.WriteAddress(block + Tls.Self, block);
        Sys.WriteAddress(block + Tls.StackBase, stackTop);
        Sys.WriteAddress(block + Tls.StackLimit, stackTop);
        Sys.WriteAddress(block + Tls.SpillCount, 0);
        Sys.Write64(block + Tls.Allocated, 0);
        Sys.WriteAddress(block + Tls.State, 1);
        GcThreads.Register(block);
    }

    /// This thread is leaving managed code for a while and takes nothing
    /// with it: stopped, as far as a collection is concerned, with an EMPTY
    /// stack to scan. BeginBlocking's stricter cousin, for a caller whose
    /// stack may not even be mapped by the time a collection looks -- a
    /// kernel's processor going out to ring 3 or into its idle halt.
    /// EndBlocking is how it comes back.
    public static void LeaveManaged()
    {
        nuint block = Sys.ThreadBlock();

        Sys.WriteAddress(block + Tls.StackLimit, Sys.ReadAddress(block + Tls.StackBase));
        Sys.WriteAddress(block + Tls.SpillCount, 0);
        Sys.AtomicSwap(block + Tls.State, 1);
    }

    /// Takes a thread out again: its parent could not start it after all.
    public static void ForgetThread(nuint block)
    {
        ThreadStatics.Release(block);
        GcThreads.Deregister(block);
        Gc.ReleaseRegion(block);
    }

    /// This thread's stack is about to stop being one.
    public static void EndThread()
    {
        ThreadStatics.Release(Sys.ThreadBlock());
        GcThreads.Deregister(Sys.ThreadBlock());
        Gc.ReleaseRegion(Sys.ThreadBlock());
    }

    /// About to wait for something only another thread can provide. The
    /// collector may read this thread's stack where it stands until the wait
    /// is over; without this pair it would wait for a thread that is asleep
    /// in the kernel and will not allocate until somebody wakes it.
    public static void BeginBlocking()
    {
        GcThreads.BeginBlocking();
    }

    public static void EndBlocking()
    {
        GcThreads.EndBlocking();
    }

    /// A stopped thread's stack changed under it: its limit and top, set
    /// together (GcThreads.MoveStack).
    public static void MoveStack(nuint limit, nuint top)
    {
        GcThreads.MoveStack(limit, top);
    }

    // ---- answering the collector from the outside -------------------------------
    //
    // A collector never stops a thread; it asks each, in handshake rounds, for
    // a piece of work only that thread can do (runtime/src/core/gc.cor, GcThreads). A
    // thread answers at its next safepoint. One that reaches none for a long
    // time -- a processor in a kernel copying a page -- is prompted: the
    // platform's stop hook interrupts it, and the interrupt handler, with
    // every register of the interrupted code pushed on the stack under it,
    // answers for it right there with AnswerAt and returns. The one place it
    // may not answer is inside the allocator or the barrier (Tls.InAlloc);
    // the hook is asked again a moment later.

    /// The platform's word for what a thread is (Tls.Owner): `owner` kept in
    /// `block`, before the thread first runs (the word has no barrier).
    public static void SetThreadOwner(nuint block, object? owner)
    {
        Sys.WriteAddress(block + Tls.Owner, owner == null ? 0 : Sys.ObjectAddress(owner));
    }

    /// What SetThreadOwner kept in `block`, or null.
    public static object? ThreadOwner(nuint block)
    {
        nuint word = block == 0 ? 0 : Sys.ReadAddress(block + Tls.Owner);
        return word == 0 ? null : Sys.ObjectAt(word);
    }

    /// The running code may not be preempted until PreemptOn (Tls.PreemptCount).
    public static void PreemptOff()
    {
        nuint block = Sys.ThreadBlock();
        if (block != 0) Sys.WriteAddress(block + Tls.PreemptCount, Sys.ReadAddress(block + Tls.PreemptCount) + 1);
    }

    /// One reason fewer not to preempt (PreemptOff).
    public static void PreemptOn()
    {
        nuint block = Sys.ThreadBlock();
        if (block != 0) Sys.WriteAddress(block + Tls.PreemptCount, Sys.ReadAddress(block + Tls.PreemptCount) - 1);
    }

    /// Whether this thread holds the heap lock (see GcLock.HeldByMe).
    public static bool HoldsHeapLock()
    {
        return GcLock.HeldByMe();
    }

    /// Whether a collection is under way.
    public static bool CollectionPending()
    {
        return GcLock.IsCollecting();
    }

    /// Whether this thread owes the collector an answer it can give where it
    /// stands: it is running, not in the allocator or the barrier, and not
    /// the collector.
    public static bool AnswerOwed()
    {
        nuint block = Sys.ThreadBlock();
        return Sys.ReadAddress(block + Tls.State) == 0 && Sys.ReadAddress(block + Tls.InAlloc) == 0
            && !GcLock.HeldByMe() && GcThreads.Owes(block);
    }

    /// The answer, given for this thread by an interrupt handler: its stack
    /// from `stack` -- the trap frame, every register in it -- up to its base.
    /// Does not wait for anything.
    public static void AnswerAt(nuint stack)
    {
        GcThreads.Answer(stack);
    }

    /// Whether the thread `block` is running and owes an answer: the ones a
    /// stop hook has to interrupt.
    public static bool ThreadOwes(nuint block)
    {
        return Sys.ReadAddress(block + Tls.State) == 0 && GcThreads.Owes(block);
    }

    /// THE HEAP THIS THREAD ALLOCATES IN made `heap` (Gc.NewHeap's record,
    /// or Gc.KernelHeap), at a kernel module's gate (docs/HEAPS.md); answers
    /// the heap it allocated in before, for LeaveHeap. The same heap again
    /// costs a compare.
    public static nuint EnterHeap(nuint heap)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = tb != 0 ? Sys.ReadAddress(tb + Tls.Heap) : 0;
        nuint now = heap == Gc.KernelHeap ? 0 : heap;
        if (was != now)
        {
            Gc.SwitchHeap(tb, now);
        }
        return was != 0 ? was : Gc.KernelHeap;
    }

    /// Back to the heap EnterHeap answered.
    public static void LeaveHeap(nuint previous)
    {
        EnterHeap(previous);
    }

    /// A safepoint: the open round answered, if this thread owes it. What a
    /// loop's back edge calls when a round is open (BackEdgePolls), the word
    /// it read read again here. THROUGH THE HOOK A ROUND INSTALLS (PollHook,
    /// GcThreads.Round): nothing of the collector's is reached from here, so
    /// an image the link keeps it in for its loops is no image with a
    /// collector it did not need.
    public static nuint PollHook;

    public static void Poll()
    {
        nuint hook = PollHook;
        if (GcThreads.Asking == 0 || hook == 0) return;
        Sys.Call(hook, 0, 0, 0);
    }

    /// Up to `budget` blocks of a mark under way scanned by this thread --
    /// what an idle processor does before it halts. True when there was work.
    public static bool HelpCollect(long budget)
    {
        return Gc.Assist(budget) > 0;
    }

    /// Whether the thread `block` is running managed code right now, as the
    /// collector sees it: the ones a stop hook has to interrupt.
    public static bool ThreadRunning(nuint block)
    {
        return Sys.ReadAddress(block + Tls.State) == 0;
    }

    /// The heap: the garbage-collected one in runtime/src/core/gc.cor. This is the
    /// one call the compiler makes for memory, for every class, struct,
    /// array, string, closure and nullable cell, and it answers zeroed,
    /// 8-aligned memory. Everything about policy is Gc's.
    /// A kernel's allocation sampler (0 for none): called every sixteenth
    /// allocation with the allocator's own frame pointer, from which the
    /// allocating calls' return addresses are read, and the size -- where a
    /// program's collector work comes from, counted without allocating.
    public static nuint AllocHook;
    /// Whether the hook is called for every allocation (the checked mode's
    /// table of who made each block) rather than every sixteenth. A flag of
    /// its own, zero by default: the runtime has no static initializer, and
    /// one runs before the thread's block is set.
    public static bool AllocHookEvery;
    static long _allocCount;

    public static nuint Alloc(nuint bytes)
    {
        nuint at = Gc.AllocWord(bytes, 0);
        // After the allocation, so the sampler knows the block (and whether
        // the program frees it or leaves it to the collector).
        if (AllocHook != 0 && (((++_allocCount) & 15) == 0 || AllocHookEvery)) Sys.Call(AllocHook, Sys.FramePointer() | 1, bytes, at);
        return at;
    }

    /// The same for memory that will hold no references -- a string, an
    /// array of bytes, characters or floating-point numbers: the collector
    /// marks it when it is reachable and never reads what is in it. The
    /// compiler calls this for those, and Alloc for everything else.
    public static nuint AllocLeaf(nuint bytes)
    {
        nuint at = Gc.AllocWord(bytes, Gc.LeafKind);
        // After the allocation, so the sampler knows the block (and whether
        // the program frees it or leaves it to the collector).
        if (AllocHook != 0 && (((++_allocCount) & 15) == 0 || AllocHookEvery)) Sys.Call(AllocHook, Sys.FramePointer() | 2, bytes, at);
        return at;
    }

    /// The same for an object whose vtable the compiler stores next -- a class
    /// instance, a box, a closure, an array: the collector reads its
    /// references from its descriptor instead of guessing them from every word.
    public static nuint AllocObject(nuint bytes)
    {
        nuint at = Gc.AllocWord(bytes, Gc.ObjectKind);
        // After the allocation, so the sampler knows the block (and whether
        // the program frees it or leaves it to the collector).
        if (AllocHook != 0 && (((++_allocCount) & 15) == 0 || AllocHookEvery)) Sys.Call(AllocHook, Sys.FramePointer() | 3, bytes, at);
        return at;
    }

    /// THE ALLOCATION AT EVERY `new`, IN PLACE. Every object compiled code
    /// made was two calls -- AllocObject, then Gc.AllocWord, each with its
    /// frame and its saved registers -- and the sampler's test after, for
    /// a block AllocWord took off a list in a dozen instructions. The
    /// compiler and the link keep each allocation a call to AllocObject,
    /// AllocLeaf or Alloc through every pass that knows a `new` by that call
    /// (Escape, the region passes, the lifetime rules), and only after the
    /// last of them make it one of these two (AllocatorFastPaths): this, put
    /// where the call was, for a size the compiler knows and a size class
    /// holds -- the slot of its class in the thread's cache and the class's
    /// size given as constants, computed as Gc.StartClasses lays the classes
    /// out -- and AllocFast, a call, for any other size a class may hold.
    ///
    /// WHAT IT DOES IS AllocWord's SIZE-CLASS PATH, store for store, less
    /// the count, which is the list's as it was handed over (Gc.Charge): the
    /// thread's list for the class popped and the header and kind written,
    /// between Tls.InAlloc's two stores, so that a thread stopped anywhere
    /// in it -- a kernel's, at any instruction -- is not answered for half
    /// way, as in AllocWord. A free block in a page is zero already, the
    /// payload's last word too. Nothing for a collection under way: a block
    /// taken off a page the thread owns is written into the snapshot by its
    /// owner's STAMP answer (StampedAlready), exactly as one AllocWord hands
    /// out.
    ///
    /// IN THE ALLOCATOR BEFORE THE CACHE IS READ (Tls.InAlloc), as every
    /// path of Gc's is: a kernel sends a thread to its handshake at any
    /// instruction, and an answer there -- or a wait counted as stopped,
    /// whose pages ShedPages may give up -- is refused while InAlloc is set.
    /// Read first and marked after, the cache could be one this thread had
    /// been answered for between the two. So: the thread's block ANDed with
    /// Gc.FastClassMask -- 0 with no block yet, before the heap starts,
    /// under the heap check, and while a sampler counts (AllocHook) -- then
    /// InAlloc set, then the cache, 0 when a handshake took it to make the
    /// thread answer, then the list. Every way out but the pop goes to
    /// AllocMissed, the call the site was, which clears InAlloc first; the
    /// pop clears it itself. Each exactly once.
    public static nuint AllocFastSized(nuint bytes, nuint kind, nuint slot, nuint size)
    {
        nuint tb = Sys.ThreadBlock() & Gc.FastClassMask;
        if (tb != 0)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            if (cache != 0)
            {
                nuint at = cache + slot;
                nuint free = Sys.ReadAddress(at);
                if (free != 0)
                {
                    // An interrupt between the next link's load and its store
                    // finds InAlloc set and comes back: nothing else pops or
                    // pushes this list -- other threads' frees go to the
                    // page's own (Gc.ClassFree), and this thread's frees and
                    // handshake answers are refused while InAlloc is set.
                    Sys.WriteAddress(at, Sys.ReadAddress(free + Gc.BlockKindAt));
                    Sys.WriteAddress(free, size);
                    Sys.WriteAddress(free + Gc.BlockKindAt, kind);
                    Sys.WriteAddress(tb + Tls.InAlloc, 0);
                    return free + Gc.BlockHeaderBytes;
                }
            }
            // No cache or an empty list leaves InAlloc set: AllocMissed
            // clears it, so that every way out is the one call at each site.
        }
        return AllocMissed(bytes, kind);
    }

    /// The same for a size the compiler does not know -- an array's, a
    /// string's (Sys.NewChars: Concat, Substring, a builder's ToString) --
    /// put in place too (AllocatorFastPaths): its class and size from the
    /// collector's tables, as AllocWord finds them -- the rounded size
    /// shifted to an index into the class of every eight bytes, and the
    /// class's size by its index: two loads, no division. A call of its
    /// own, these were the compiler's most frequent allocations still made
    /// through a call and a frame.
    public static nuint AllocFast(nuint bytes, nuint kind)
    {
        // THE CLASS TEST ON THE REQUEST ITSELF, unsigned: the rounded size
        // is at most ClassMax exactly when this holds, and a negative request
        // -- which AllocWord refuses -- is a huge one here, and goes there.
        nuint request = bytes;
        if (request <= Gc.ClassMax + 7 - Gc.ClassBlockRounding)
        {
            const int w = WordSize.Bytes;
            // In the allocator before the cache is read (AllocFastSized).
            nuint tb = Sys.ThreadBlock() & Gc.FastClassMask;
            if (tb != 0)
            {
                Sys.WriteAddress(tb + Tls.InAlloc, 1);
                nuint cache = Sys.ReadAddress(tb + Tls.Classes);
                if (cache != 0)
                {
                    nuint small = (request + Gc.ClassBlockRounding) & Gc.BlockSizeMask;
                    // The tables: a word each, an address.
                    nuint c = Sys.ReadAddress(Gc._classOf + (small >> 3) * w);
                    nuint slot = cache + c * (2 * w) + w;
                    nuint free = Sys.ReadAddress(slot);
                    if (free != 0)
                    {
                        nuint size = Sys.ReadAddress(Gc._classSize + c * w);
                        Sys.WriteAddress(slot, Sys.ReadAddress(free + Gc.BlockKindAt));
                        Sys.WriteAddress(free, size);
                        Sys.WriteAddress(free + Gc.BlockKindAt, kind);
                        Sys.WriteAddress(tb + Tls.InAlloc, 0);
                        return free + Gc.BlockHeaderBytes;
                    }
                }
                // InAlloc left set: AllocMissed clears it (AllocFastSized).
            }
        }
        return AllocMissed(bytes, kind);
    }

    /// AllocFast's long way: the call the site was, by its kind. A call of
    /// its own, never put in place, so that each site carries one call.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static nuint AllocMissed(nuint bytes, nuint kind)
    {
        // OUT OF THE ALLOCATOR FIRST: AllocFastSized and AllocFast come here
        // with Tls.InAlloc still set when the cache or the list was empty,
        // which saves every site a store. Nothing is half done then -- the
        // cache and the list were read, not changed -- and the few
        // instructions to here are as unanswerable as the pop.
        nuint tb = Sys.ThreadBlock();
        if (tb != 0) Sys.WriteAddress(tb + Tls.InAlloc, 0);
        if (kind == Gc.ObjectKind) return AllocObject(bytes);
        if (kind == Gc.LeafKind) return AllocLeaf(bytes);
        return Alloc(bytes);
    }

    /// REGIONS: a call the compiler proved leaves dead, at its return, every
    /// object certain allocations make for it opens one on entry and gives
    /// it back on every way out. What it hands RegionLeave is what this
    /// returned. `bytes` is the most the region holds in one call, as the
    /// link proved it, 0 when it could not. See Gc, "regions".
    ///
    /// THE FAST PATH, which the link inlines into every boundary (Lto's
    /// UnitBackend, after the region passes): an arena already, no size
    /// proved, no region at or below this frame left by a throw to close,
    /// and room for the record where the arena is -- the record laid down
    /// as Gc.OpenRecord lays it, then the pointer and the open region. Any
    /// other case is Gc.RegionEnter's.
    public static nuint RegionEnter(nuint frame, nuint bytes)
    {
        nuint tb = Sys.ThreadBlock();
        if (bytes == 0 && tb != 0 && Sys.ReadAddress(tb + Tls.RegionBase) != 0)
        {
            nuint open = Sys.ReadAddress(tb + Tls.RegionOpen);
            nuint record = Sys.ReadAddress(tb + Tls.RegionAt);
            nuint end = record + Gc.RegionRecordBytes;
            // The open region's opener from the block (Tls.RegionFloor), not its record.
            if ((open == 0 || Sys.ReadAddress(tb + Tls.RegionFloor) > frame)
                && end <= Sys.ReadAddress(tb + Tls.RegionEnd))
            {
                Sys.WriteAddress(record, Gc.RegionRecordBytes);
                Sys.WriteAddress(end - Gc.BlockFooterBytes, Gc.RegionRecordBytes);
                Sys.WriteAddress(record + Gc.BlockKindAt, Gc.LeafKind);
                Sys.WriteAddress(record + Gc.BlockHeaderBytes, open);
                Sys.WriteAddress(record + Gc.RecordFrameAt, frame);
                Sys.WriteAddress(tb + Tls.RegionAt, end);
                Sys.WriteAddress(tb + Tls.RegionFloor, frame);
                Sys.WriteAddress(tb + Tls.RegionOpen, record);
                return record;
            }
        }
        return Gc.RegionEnter(frame, bytes);
    }

    /// A catch's own frame: every region opened by a frame below it -- a
    /// boundary the throw it caught came out of -- is closed (Gc.PopStale).
    public static void RegionCatch(nuint frame)
    {
        Gc.RegionCatch(frame);
    }

    /// A loop's region at the top of a lap: opened on the first (`record`
    /// -1), what the last lap made in it given back on every other. What it
    /// answers is the next lap's `record`, and RegionLeave's on the way out.
    /// `bytes` is the most one lap makes in it, 0 when nobody proved it.
    public static nuint RegionLoop(nuint record, nuint frame, nuint bytes)
    {
        return Gc.RegionLoop(record, frame, bytes);
    }

    /// THE FAST PATH, inlined at every leave as RegionEnter is: a region
    /// that began in the chunk being filled, below the pointer -- nothing
    /// past that chunk to hand back -- with the stats not asked for (the
    /// long way measures the arena as it is cut). The thread's blocks
    /// counted, the pointer set back first, the bytes cleared, the record
    /// popped: what Gc.RegionLeave does there. Any other case is its.
    public static void RegionLeave(nuint record)
    {
        nuint tb = Sys.ThreadBlock();
        if (record != Gc.NoRecord && tb != 0 && !Gc.StatsAsked && !Gc.CountingCollected)
        {
            nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
            // The arena handed back already (Gc.ReleaseRegion): nothing left to give.
            if (last == 0) return;
            nuint at = Sys.ReadAddress(tb + Tls.RegionAt);
            if (record >= Sys.ReadAddress(last) && record < at)
            {
                nuint counted = Sys.ReadAddress(tb + Tls.RegionCount);
                if (counted != 0)
                {
                    Sys.WriteAddress(tb + Tls.RegionCount, 0);
                    Gc.RegionBlocks = Gc.RegionBlocks + (long)counted;
                }
                nuint parent = Sys.ReadAddress(record + Gc.BlockHeaderBytes);
                Sys.WriteAddress(tb + Tls.RegionAt, record);
                nuint freed = at - record;
                Sys.MemorySet(record, 0, freed);
                Sys.WriteAddress(tb + Tls.RegionFloor, parent == 0 ? 0
                    : Sys.ReadAddress(parent + Gc.RecordFrameAt) & ~(nuint)Gc.RecordLoopMark);
                Sys.WriteAddress(tb + Tls.RegionOpen, parent);
                Gc.RegionFreedBytes = Gc.RegionFreedBytes + (long)(freed - Gc.RegionRecordBytes);
                Gc.FreedBytes = Gc.FreedBytes + (long)(freed - Gc.RegionRecordBytes);
                return;
            }
        }
        Gc.RegionLeave(record);
    }

    /// An allocation proved dead by the return of whichever region is open
    /// innermost: made in that region, or on the heap when none is open or
    /// it is full. `kind` is Gc's: 0, LeafKind or ObjectKind.
    /// `frame` is the allocating function's own: a region opened beneath it
    /// that a throw has left is closed first (Gc.PopStale).
    ///
    /// THE FAST PATH, kept to a few instructions so the link inlines it at
    /// every site (Lto's UnitBackend, after the region passes), as AllocFast
    /// is at each `new`; a constant size folds its rounding there. A region
    /// open, opened by a frame no deeper than ours -- one a throw has not
    /// left -- and room for the block in the chunk being filled: header,
    /// footer and kind written, then the pointer, as Gc.AllocRegion lays a
    /// block (a scan of a stopped thread sees it whole or not at all), and
    /// counted in the thread's block (Tls.RegionCount, added to
    /// Gc.RegionBlocks where a region ends). Anything else -- no thread block
    /// yet, no region, a stale one to close, a chunk to grow into, a sampled
    /// allocation -- the long way (AllocRegionSlow). A size the compiler
    /// knows is AllocRegionSized's, put in place.
    public static nuint AllocRegion(nuint bytes, nuint kind, nuint frame)
    {
        // The block ANDed with Gc.FastRegionMask (no block yet, a sampler, the
        // statistics), then the open region's opener from the block
        // (Tls.RegionFloor, 0 with none open): AllocRegionSized's tests.
        nuint tb = Sys.ThreadBlock() & Gc.FastRegionMask;
        if (tb != 0 && Sys.ReadAddress(tb + Tls.RegionFloor) >= frame && bytes <= Gc.MostRequest)
        {
            nuint at = Sys.ReadAddress(tb + Tls.RegionAt);
            nuint need = (bytes + Gc.BlockRounding) & Gc.BlockSizeMask;
            if (need < Gc.SmallestBlock) need = Gc.SmallestBlock;
            // ROOM COUNTED, NOT AN END COMPARED: on i386 a request near
            // MostRequest added to an arena high in the address space
            // wraps, and a wrapped end below the chunk's passed the test
            // and the block's footer was written far below it. The pointer
            // is never past the end.
            nuint end = Sys.ReadAddress(tb + Tls.RegionEnd);
            if (need <= end - at)
            {
                nuint next = at + need;
                Sys.WriteAddress(at, need);
                Sys.WriteAddress(next - Gc.BlockFooterBytes, need);
                Sys.WriteAddress(at + Gc.BlockKindAt, kind);
                Sys.WriteAddress(tb + Tls.RegionAt, next);
                // Counted in the thread's block (Tls.RegionCount), added to
                // Gc.RegionBlocks where a region ends: what says how much a
                // program makes in its regions.
                nuint counted = tb + Tls.RegionCount;
                Sys.WriteAddress(counted, Sys.ReadAddress(counted) + 1);
                return at + Gc.BlockHeaderBytes;
            }
        }
        return AllocRegionSlow(bytes, kind, frame);
    }

    /// THE SAME FOR A SIZE THE COMPILER KNOWS, put in place at the site
    /// (Opt.AllocatorFastPaths, after the region passes): `need` is the
    /// block's size, rounded with its header and footer as Gc lays a block
    /// out, a constant there. Three tests -- a block and no sampler, a
    /// region open by a frame at or below this one, room in the chunk --
    /// then the block laid down, header, footer and kind, before the
    /// pointer passes it, so that a scan of the stopped thread (ScanRegion)
    /// sees it whole or not at all. The memory is zero already: a region's
    /// end clears what it held (Gc.CutBack), as a fresh chunk is. Then the
    /// block counted in the thread's block (Tls.RegionCount), one add.
    /// Everything else is AllocRegionSlow, the call AllocRegion's long way is.
    ///
    /// NOT INSIDE THE ALLOCATOR (Tls.InAlloc), as NextChunk's and CutBack's
    /// stores are: those change the pointer and the chunk it is in, two
    /// words a handshake reads together. This changes the pointer alone,
    /// within the chunk being filled, after the block it passes is whole: a
    /// scan (ScanRegion, CopyRegion) landing before the store reads the
    /// chunk to the old pointer, after it to the new one past a whole
    /// block, and either is an arena as it is. The count is read only by
    /// this thread at a region's end (CountRegionBlocks) and as it ends
    /// (ReleaseRegion), never by a handshake.
    public static nuint AllocRegionSized(nuint bytes, nuint kind, nuint frame, nuint need)
    {
        nuint tb = Sys.ThreadBlock() & Gc.FastRegionMask;
        if (tb != 0 && Sys.ReadAddress(tb + Tls.RegionFloor) >= frame)
        {
            nuint at = Sys.ReadAddress(tb + Tls.RegionAt);
            if (need <= Sys.ReadAddress(tb + Tls.RegionEnd) - at)
            {
                nuint next = at + need;
                Sys.WriteAddress(at, need);
                Sys.WriteAddress(next - Gc.BlockFooterBytes, need);
                Sys.WriteAddress(at + Gc.BlockKindAt, kind);
                Sys.WriteAddress(tb + Tls.RegionAt, next);
                // Counted in the thread's block (Tls.RegionCount), added to
                // Gc.RegionBlocks where a region ends: what says how much a
                // program makes in its regions.
                nuint counted = tb + Tls.RegionCount;
                Sys.WriteAddress(counted, Sys.ReadAddress(counted) + 1);
                return at + Gc.BlockHeaderBytes;
            }
        }
        return AllocRegionSlow(bytes, kind, frame);
    }

    /// The long way of AllocRegion: Gc.AllocRegion, and the sampler.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static nuint AllocRegionSlow(nuint bytes, nuint kind, nuint frame)
    {
        nuint at = Gc.AllocRegion(bytes, kind, 0, frame);
        if (AllocHook != 0 && (((++_allocCount) & 15) == 0 || AllocHookEvery)) Sys.Call(AllocHook, Sys.FramePointer() | SampleKind(kind), bytes, at);
        return at;
    }

    // The sampler's kind of a block: 1 scanned word by word, 2 a leaf, 3 an
    // object. The hook gets it in the low two bits of the allocator's frame
    // pointer, which is word-aligned: (frame | kind, bytes, block).
    static nuint SampleKind(nuint kind) => kind == Gc.LeafKind ? (nuint)2 : kind == Gc.ObjectKind ? (nuint)3 : 1;

    /// Storage made for `owner` and dead when it is: in the innermost open
    /// region when owner is in it, or on this thread's stack in a frame that
    /// returns no later than that region ends (a collection the lifetime pass
    /// put in a boundary's frame; Gc.OnStackWithin); on the heap otherwise.
    public static nuint AllocNear(nuint bytes, nuint kind, nuint owner, nuint frame)
    {
        nuint at = Gc.AllocRegion(bytes, kind, owner == 0 ? Gc.NoRecord : owner, frame);
        if (AllocHook != 0 && (((++_allocCount) & 15) == 0 || AllocHookEvery)) Sys.Call(AllocHook, Sys.FramePointer() | SampleKind(kind), bytes, at);
        return at;
    }

    // ---- the heap of a program that needs no collector -----------------------
    //
    // WHAT MALLOC AND FREE ARE. When escape analysis proves that nothing
    // reachable from the entry is left for a collector -- every allocation is
    // freed where the compiler proved it dead, lives until the end in a
    // static, or is made at most once -- it retargets allocation here
    // (AllocManual, AllocManualObject) and the collector's free and liveness
    // test to FreeManual and ManualObject. This shares NOTHING with Gc: its
    // own statics, its own chunks from Platform.Map, no call into Gc; so Gc,
    // its stack maps and its barriers all go the way of unreachable code.
    //
    // Blocks come in sixteen-byte granules behind a two-word header: the
    // block's size with a free bit and an object bit, then a magic word. A
    // freed block goes on the list of its size (up to 1 KiB, one list a
    // granule) or on the one list of larger blocks, and the next of that size
    // takes it, zeroed; anything else is bumped from the newest chunk. Free
    // ignores whatever is not exactly a live block of this heap -- a null, a
    // literal, a block freed already -- as Gc.Free does, by the chunk list
    // and the header. One lock word, since a program with no collector may
    // still run threads.
    static nuint _manualChunks;      // newest chunk: [next chunk][end] then blocks
    static nuint _manualAt;
    static nuint _manualLimit;
    static nuint _manualBins;        // ManualBinCount list heads, then the lock word

    const int ManualChunk = 262144;
    const int ManualMagic = 0x4D48434D;   // 'MCHM'
    const int ManualFree = 1;
    const int ManualObjectFlag = 2;
    // FREED IN THE CHECKED MODE (Platform.VerifyFrees, Corsac.GC.VerifyFrees on
    // Linux), as Gc.VerifyFree does for a collected heap: the payload filled
    // with ManualPoison and the block never handed out again, so a read
    // after the free finds the pattern and a second free is reported and
    // ends the process with 97. Asked once, at the first allocation, on the
    // thread that starts the program.
    const int ManualChecked = 4;
    const uint ManualPoison = 0xFEEEFEEE;
    static bool _manualVerify;
    const int ManualBinCount = 65;        // 0 is the list of large blocks
    const int ManualSmall = 1024;

    public static nuint AllocManual(nuint bytes)
    {
        return ManualTake(bytes, 0);
    }

    public static nuint AllocManualObject(nuint bytes)
    {
        return ManualTake(bytes, ManualObjectFlag);
    }

    static nuint ManualTake(nuint bytes, nuint flags)
    {
        const int w = WordSize.Bytes;
        if (_manualBins == 0)
        {
            _manualVerify = Platform.VerifyFrees();
            if (!ManualGrow(ManualBinCount * w + w)) { Exit(137); }
            _manualBins = _manualAt;
            _manualAt = _manualAt + ((ManualBinCount * w + w + 15) & ~(nuint)15);
            // The exception out of memory throws, made as the heap begins,
            // as the collector's is (Gc.ThrowOutOfMemory).
            OutOfMemoryException made = new OutOfMemoryException(true);
            made.Reserve$(new nuint[TraceDepth]);
            _manualOutOfMemory = made;
        }
        if (bytes < 0 || bytes > 0x7FFFFFF0)
        {
            ManualOutOfMemory(0);
        }
        nuint need = (bytes + 2 * w + 15) & ~(nuint)15;
        nuint lockAt = _manualBins + ManualBinCount * w;
        ManualLock(lockAt);

        nuint block = 0;
        nuint list = need <= ManualSmall ? _manualBins + (need >> 4) * w : _manualBins;
        nuint previous = 0;
        nuint at = Sys.ReadAddress(list);
        while (at != 0)
        {
            nuint size = Sys.ReadAddress(at) & ~(nuint)15;
            if (size == need || (need > ManualSmall && size >= need))
            {
                nuint next = Sys.ReadAddress(at + 2 * w);
                if (previous == 0) Sys.WriteAddress(list, next); else Sys.WriteAddress(previous + 2 * w, next);
                block = at;
                need = size;
                nuint word = at + 2 * w;
                while (word < at + size)
                {
                    Sys.WriteAddress(word, 0);
                    word = word + w;
                }
                break;
            }
            if (need <= ManualSmall)
            {
                break;
            }
            previous = at;
            at = Sys.ReadAddress(at + 2 * w);
        }
        if (block == 0)
        {
            if (_manualAt + need > _manualLimit && !ManualGrow(need))
            {
                ManualOutOfMemory(lockAt);
            }
            block = _manualAt;
            _manualAt = _manualAt + need;
        }
        Sys.WriteAddress(block, need | flags);
        Sys.WriteAddress(block + w, ManualMagic);
        ManualUnlock(lockAt);
        return block + 2 * w;
    }

    /// A new chunk big enough for `need`, linked in front of the others;
    /// false when the system gives none.
    static bool ManualGrow(nuint need)
    {
        nuint ask = need + 32 > ManualChunk ? need + 32 : (nuint)ManualChunk;
        nuint chunk = Platform.Map(ask);
        if (chunk == 0)
        {
            return false;
        }
        Sys.WriteAddress(chunk, _manualChunks);
        Sys.WriteAddress(chunk + WordSize.Bytes, chunk + ask);
        _manualChunks = chunk;
        _manualAt = (chunk + 2 * WordSize.Bytes + 15) & ~(nuint)15;
        _manualLimit = chunk + ask;
        return true;
    }

    /// THE MANUAL HEAP'S LOCK, a spin: not preempted while it is held
    /// (Tls.PreemptCount), as its waiters only pause.
    static void ManualLock(nuint lockAt)
    {
        Runtime.PreemptOff();
        while (Sys.AtomicSwap(lockAt, 1u) != 0)
        {
            Sys.Pause();
        }
    }

    static void ManualUnlock(nuint lockAt)
    {
        Sys.AtomicSwap(lockAt, 0u);
        Runtime.PreemptOn();
    }

    /// The manual heap's exception out of memory, made as it begins.
    static OutOfMemoryException? _manualOutOfMemory;

    /// OUT OF MEMORY, THROWN from the manual heap as from the collector's
    /// (Gc.ThrowOutOfMemory): the lock word at `lockAt`, when this thread
    /// holds it, let go first, and the trace taken with nothing made.
    static void ManualOutOfMemory(nuint lockAt)
    {
        if (lockAt != 0) { ManualUnlock(lockAt); }
        OutOfMemoryException? thrown = _manualOutOfMemory;
        if (thrown == null) { Exit(137); return; }
        thrown.Refill$(Sys.FramePointer());
        throw thrown;
    }

    /// The header of the live block `at` is the payload of, or 0.
    static nuint ManualBlock(nuint at)
    {
        nuint block = ManualHeader(at);
        return block != 0 && (Sys.ReadAddress(block) & ManualFree) == 0 ? block : 0;
    }

    /// The header of the block of this heap `at` is the payload of, freed or not, or 0.
    static nuint ManualHeader(nuint at)
    {
        const int w = WordSize.Bytes;
        nuint block = at - 2 * w;
        if (at == 0 || (block & 15) != 0)
        {
            return 0;
        }
        nuint chunk = _manualChunks;
        while (chunk != 0)
        {
            if (block >= chunk + 2 * w && block < Sys.ReadAddress(chunk + w))
            {
                return Sys.ReadAddress(block + w) == ManualMagic ? block : 0;
            }
            chunk = Sys.ReadAddress(chunk);
        }
        return 0;
    }

    public static void FreeManual(nuint at)
    {
        const int w = WordSize.Bytes;
        if (_manualBins == 0)
        {
            return;
        }
        nuint lockAt = _manualBins + ManualBinCount * w;
        ManualLock(lockAt);
        nuint block = ManualHeader(at);
        if (block != 0 && _manualVerify)
        {
            nuint word = Sys.ReadAddress(block);
            if ((word & ManualChecked) != 0)
            {
                ManualUnlock(lockAt);
                WriteLiteral(2, "runtime: checked free: freed twice\n");
                Platform.Exit(97);
            }
            if ((word & ManualFree) == 0)
            {
                nuint end = block + (word & ~(nuint)15);
                Sys.WriteAddress(block, (word & ~(nuint)15) | ManualFree | ManualChecked);
                for (nuint p = block + 2 * w; p + 4 <= end; p = p + 4) Sys.Write32(p, ManualPoison);
            }
            ManualUnlock(lockAt);
            return;
        }
        if (block != 0 && (Sys.ReadAddress(block) & ManualFree) == 0)
        {
            nuint size = Sys.ReadAddress(block) & ~(nuint)15;
            nuint list = size <= ManualSmall ? _manualBins + (size >> 4) * w : _manualBins;
            Sys.WriteAddress(block, size | ManualFree);
            Sys.WriteAddress(block + 2 * w, Sys.ReadAddress(list));
            Sys.WriteAddress(list, block);
        }
        ManualUnlock(lockAt);
    }

    /// Whether `at` is a live object of this heap, with a descriptor to read:
    /// what Free asks before it frees the fields an object owns (Gc.LiveObject).
    public static bool ManualObject(nuint at)
    {
        nuint block = ManualBlock(at);
        return block != 0 && (Sys.ReadAddress(block) & ManualObjectFlag) != 0;
    }

    /// Gives a block obtained from Runtime.Alloc back to the heap NOW.
    ///
    /// This is the compiler's side of tiers 1 and 2 (X86-BACKEND.md,
    /// "Memory"): an object whose size is not constant, so it could not
    /// become a frame slot, and an owned object at the last use the optimiser
    /// found, are freed here rather than waited for. The contract:
    ///
    ///   - `at` is a payload address Runtime.Alloc answered, or zero. Zero, a
    ///     null reference, an interior pointer, a frame slot, an address from
    ///     somewhere else and a block already freed are all IGNORED, silently
    ///     and safely: freeing is an optimisation, and an optimisation that
    ///     was wrong about which block it held must cost no more than the
    ///     memory it failed to return.
    ///   - Constant time. The block is its payload minus a header, its
    ///     neighbours are found through the boundary tags, and the free lists
    ///     are segregated by size and linked at the head.
    ///   - It coalesces with a free neighbour on either side, so a program
    ///     that allocates and frees in a loop keeps one hole rather than
    ///     collecting a thousand.
    ///   - Freeing a block that is still referenced is undefined, in the same
    ///     way and for the same reason that it is in C. Only the optimiser is
    ///     allowed to say it.
    ///
    /// It exists WHETHER OR NOT THE COLLECTOR IS LINKED. A program that needs
    /// none has Gc.Free and Gc.LiveObject retargeted at FreeManual and
    /// ManualObject (Escape), and this frees into the manual heap unchanged.
    /// WHETHER THIS PROGRAM HAS A COLLECTOR. True here, and the compiler
    /// answers it for a whole program once it has decided (Escape): false
    /// where nothing needs one. What only a collector would ever do or say --
    /// its state in a fault report, its checks on a freed field -- is written
    /// under `if (CollectorLinked())`, and in a program without one it folds
    /// away, messages and all, as an #ifdef would in C.
    public static bool CollectorLinked()
    {
        return true;
    }

    /// A [ThreadStatic] field's cell on this thread (ThreadStatics.Cell): what
    /// lowering calls for every touch of one, handed the word that holds the
    /// field's number and the bytes its cell needs.
    public static nuint ThreadStaticCell(nuint indexAt, nuint bytes)
    {
        return ThreadStatics.Cell(indexAt, bytes);
    }

    public static void Free(nuint at)
    {
        if (Gc.IgnoredFrees == 'p')
        {
            return;
        }
        // In a region: given back with it, and not a block LiveObject's lock
        // need be taken to ask about. Only a collector's heap has regions.
        if (CollectorLinked() && Gc.InOwnRegion(at)) return;
        // A collection's storage before its owned fields: a collection that
        // owns its elements (IOwnsElements.OwnElements) reads them out of
        // its arrays as it gives them back, and an array that is an owned
        // field as well was freed and cleared first -- a table's values
        // gone, and every element it held left to the collector. Its
        // storage, given back, is cleared, and finds no owned field after.
        if (at != 0 && Gc.LiveObject(at))
        {
            FreeStorageOf(at);
            FreeOwnedFields(at);
        }
        Gc.Free(at);
    }

    /// A dying collection's storage, given back with it (IOwnsStorage): what
    /// the owned-field rules never could, the arrays being read through the
    /// collection's own methods everywhere it is used. The descriptor says
    /// whether the type has any, so every other object costs one load.
    const int OwnsStorageFlag = 2;

    static void FreeStorageOf(nuint at)
    {
        nuint vtable = Sys.ReadAddress(at);
        if (vtable == 0) return;
        // The descriptor is twelve words before the vtable; its GC flags the tenth.
        if ((Sys.ReadAddress(vtable - 12 * WordSize.Bytes + 9 * WordSize.Bytes) & OwnsStorageFlag) == 0) return;
        if (Sys.ObjectAt(at) is IOwnsStorage owner) owner.FreeStorage();
    }

    /// THE FIELDS AN OBJECT OWNS GO WITH IT. A type's descriptor word 11 is its
    /// owned-field map, in the reference map's form (a count of words, then a
    /// bit for each): the fields the compiler proved, over the whole program,
    /// only ever hold objects made for them and read nowhere that outlives the
    /// object (Escape.OwnedFields) -- an exception's message and trace. Each is
    /// cleared and freed, and whatever it owns in turn with it. Only objects
    /// the compiler proved dead come here, so the header is theirs to read.
    public static void FreeOwnedFields(nuint at)
    {
        nuint vtable = Sys.ReadAddress(at);
        if (vtable == 0)
        {
            return;
        }
        nuint map = Sys.ReadAddress(vtable - WordSize.Bytes);
        if (map == 0)
        {
            return;
        }
        nuint head = Sys.ReadAddress(map);
        // The element bits follow the field bits when the count says so
        // (ElementMapFlag): a field whose array owns its collections.
        nuint words = head & (ElementMapFlag - 1);
        nuint elementsAt = (head & ElementMapFlag) != 0 ? map + (1 + (words + 31) / 32) * WordSize.Bytes : 0;
        for (nuint word = 0; word < words; word++)
        {
            uint bits = Sys.Read32(map + WordSize.Bytes + (word / 32) * WordSize.Bytes);
            if ((bits & (1u << (int)(word % 32))) == 0)
            {
                continue;
            }
            nuint field = at + word * WordSize.Bytes;
            nuint held = Sys.ReadAddress(field);
            if (held != 0)
            {
                Sys.WriteAddress(field, 0);
                if (elementsAt != 0 && (Sys.Read32(elementsAt + (word / 32) * WordSize.Bytes) & (1u << (int)(word % 32))) != 0)
                    FreeReferenceElements(held);
                FreeHeld(held);
            }
        }
    }

    /// What an owned field held before a store replaces it (Escape.OwnedFields):
    /// freed with what it owns, unless it is what is being stored again.
    public static void FreeOwnedReplaced(nuint old, nuint current)
    {
        if (old != 0 && old != current && Gc.IgnoredFrees != 'r' && Gc.IgnoredFrees != 'w')
        {
            FreeHeld(old);
        }
    }

    /// Gives back what an owned variable held before it was assigned
    /// `current` (Escape's owned variables): nothing when it is the same
    /// object, which a variable assigned twice from one register holds; a
    /// null or a string literal, which is no heap block, is ignored by Free.
    ///
    /// AS ITS LAST VALUE IS GIVEN BACK AT A RETURN (Runtime.Free): with its
    /// storage and its owned fields, and what those own. The proof is the
    /// same one -- the variable alone held it, and every read of an owned
    /// field is dead before any free the compiler placed (Escape.OwnedFields
    /// counts this one among them) -- and given back by Gc.Free alone, a
    /// carried Box's list and a carried List's array went to the collector
    /// every lap. One in this thread's region is nothing to do, as for Free:
    /// read from the variable's shadow it may be memory a lap gave back.
    ///
    /// AND WHAT A LAP MADE FOR THE VARIABLE AND DROPPED, where it dies
    /// (Escape.FreeDropped): `old` that object, `current` what the variable's
    /// shadow names -- nothing to do when the variable took it.
    public static void FreeReplaced(nuint old, nuint current)
    {
        if (old != current && Gc.IgnoredFrees != 'r' && Gc.IgnoredFrees != 'v')
        {
            Free(old);
        }
    }

    /// Gives back what the reference field at `offset` of the object at `at`
    /// refers to, just before the object itself is given back: a field the
    /// optimiser has proved holds only objects made for it and reachable
    /// through it alone (Escape's owned fields) -- a List's array, freed with
    /// the List. Nothing for a null object or an empty field.
    public static void FreeField(nuint at, nuint offset)
    {
        if (at == 0 || Gc.IgnoredFrees == 'f')
        {
            return;
        }
        if (CollectorLinked()) Gc.VerifyFieldOwner(at, offset);
        nuint held = Sys.ReadAddress(at + offset);
        if (held != 0)
        {
            if (FreeLogRing != 0)
            {
                LogFree(held, at, offset, Sys.ReadAddress(Sys.FramePointer() + WordSize.Bytes));
            }
            // Cleared first: the object's owned-field map (FreeOwnedFields)
            // may name the same field, and must find it empty.
            Sys.WriteAddress(at + offset, 0);
            // The checked mode poisons and keeps a heap block: a region's
            // goes with its region, as FreeHeld sends it, and is no block of
            // the heap's to mark freed -- a cell of no type among them.
            if (CollectorLinked() && Gc.VerifyingFieldFrees && !Gc.InOwnRegion(held))
            {
                Gc.FreeFieldChecked(held);
                return;
            }
            // An array field whose arrays own their collections (the map's
            // element bits): those first. ONLY AN OBJECT HAS THE MAP, which
            // its descriptor names: a frame object is handed here only with
            // one in its first word (EscapeFields.HeaderlessSlot), and a
            // block says by its kind -- a struct's block has none, and its
            // first field read as a descriptor faulted.
            if (Described(at) && OwnsArrayElements(at, offset)) FreeReferenceElements(held);
            // As any object proved dead is given back (Free): with its own
            // owned fields, and a collection with its storage -- and its
            // elements, where the compiler marked them its own
            // (IOwnsElements.OwnElements). Given back alone, a parser's token
            // list left its array and every token to the collector.
            FreeHeld(held);
        }
    }

    /// In an owned-field map's count word: the element bits follow (Escape.ElementMapFlag).
    const int ElementMapFlag = 0x40000000;

    /// Whether the field at `offset` of the object at `at` owns its array's
    /// elements: the element bit of its type's owned-field map
    /// (Escape.ArrayFieldElements), which only a whole program's proof sets.
    /// Whether an owned field's owner starts with its descriptor: one in this
    /// thread's frames does, or it would not be here; anywhere else, its
    /// block says (Gc.ObjectBlock).
    static bool Described(nuint at)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb != 0 && at > Sys.FramePointer() && at < Sys.ReadAddress(tb + Tls.StackBase)) return true;
        return Gc.ObjectBlock(at);
    }

    static bool OwnsArrayElements(nuint at, nuint offset)
    {
        nuint vtable = Sys.ReadAddress(at);
        if (vtable == 0 || offset % WordSize.Bytes != 0) return false;
        nuint map = Sys.ReadAddress(vtable - WordSize.Bytes);
        if (map == 0) return false;
        nuint head = Sys.ReadAddress(map);
        if ((head & ElementMapFlag) == 0) return false;
        nuint words = head & (ElementMapFlag - 1);
        nuint word = offset / WordSize.Bytes;
        if (word >= words) return false;
        nuint chunks = (words + 31) / 32;
        uint bits = Sys.Read32(map + (1 + chunks + word / 32) * WordSize.Bytes);
        return (bits & (1u << (int)(word % 32))) != 0;
    }

    /// WHAT AN OWNED FIELD HELD, given back. One made in this thread's region
    /// goes with the region, but what it owns may be the heap's -- a parser's
    /// token wrapper made in a region, its list and tokens on the heap -- and
    /// only it leads there: its owned fields and storage go now. Read from a
    /// field of an object still alive, it is no region memory a loop's lap
    /// has given back already, as a pointer kept in a register might be.
    /// Only an object has fields it owns: a captured variable's cell, made in
    /// the region and owned by its closure's frame, holds a word and no
    /// type, and read as an object it took what that word points at for a
    /// type -- the self-hosted compiler's crash once its regions stopped
    /// filling up and sending such cells to the heap.
    static void FreeHeld(nuint held)
    {
        if (CollectorLinked() && Gc.IgnoredFrees != 'p' && Gc.InOwnRegion(held))
        {
            if (Gc.RegionObject(held))
            {
                FreeOwnedFields(held);
                FreeStorageOf(held);
            }
            // AND THE BLOCK ITSELF, where it is the region's top (Gc.RegionFree):
            // read from a field, it is the block, not memory a lap gave back.
            Gc.RegionFree(held);
            return;
        }
        Free(held);
    }

    /// An array its collection's own storage field alone holds, grown to
    /// `length` elements where it is when it is its region's top (Gc.RegionGrow):
    /// true when it was, and the collection keeps it; false, and it makes a
    /// new one as it always has. Keeps no pointer (EscapeFields.IsCollectorNote).
    public static bool GrowInPlace(nuint at, int length)
    {
        if (at == 0 || !CollectorLinked() || !Gc.InOwnRegion(at)) return false;
        return Gc.RegionGrow(at, length);
    }

    // THE FIELD FREES, LOGGED (Corsac.GC.FreeLog). A ring of the last entries,
    // four words each -- what was freed, whose field it was, the offset, and
    // the return address into the code that freed it -- whose first word
    // counts them. Nothing reads it here: a debugger or a scan of the process
    // looks for a freed block something live still points at, and the entry
    // names the free that took it.
    public const int FreeLogEntries = 1048576;
    public static nuint FreeLogRing;

    public static void StartFreeLog()
    {
        FreeLogRing = Platform.Map((FreeLogEntries * 4 + 1) * WordSize.Bytes);
    }

    /// A plain free, logged (Gc.Free): the block and the two calls it came
    /// through.
    public static void LogPlainFree(nuint held, nuint caller, nuint site)
    {
        LogFree(held, 0, caller, site);
    }

    static void LogFree(nuint held, nuint owner, nuint offset, nuint site)
    {
        nuint n = (nuint)Sys.AtomicAdd(FreeLogRing, 1) % FreeLogEntries;
        nuint entry = FreeLogRing + (1 + n * 4) * WordSize.Bytes;
        Sys.WriteAddress(entry, held);
        Sys.WriteAddress(entry + WordSize.Bytes, owner);
        Sys.WriteAddress(entry + 2 * WordSize.Bytes, offset);
        Sys.WriteAddress(entry + 3 * WordSize.Bytes, site);
    }

    // ---- packed blocks' scalar forms ----------------------------------------
    //
    // WHAT A PACKED OPERATION IS WITHOUT MMX (Packed.Add16 and the rest, in a
    // packed block's variant for a processor without the instruction:
    // Lowering.PackedIntrinsic): the same lanes, one at a time, as the
    // instruction computes them -- its saturations, its wrap-arounds, its
    // shift counts past a lane's width. `op` is the instruction's second
    // opcode byte, 0F xx, which names it.

    /// WHETHER THE PROCESSOR HAS A PACKED BLOCK'S VARIANT'S FEATURES
    /// (PackedChoose: Processor's bits), capped by the image's knob
    /// Corsac.Cpu.Features -- a mask of them -- so a test runs each variant
    /// on one machine. The knob is read once the image's knobs are there.
    public static bool PackedHas(int features)
    {
        int cap = _packedCap;
        if (cap == 0)
        {
            cap = KnobValue("Corsac.Cpu.Features") != 0 ? (int)KnobNumber("Corsac.Cpu.Features") | 1 << 30 : ~0;
            if (_knobs != 0) _packedCap = cap;
        }
        return (cap & features) == features && Processor.Has(features);
    }

    static int _packedCap;

    /// WHICH OF A PACKED BLOCK'S VARIANTS RUNS (Sys.PackedChoose): the first
    /// of `count` whose features the processor has and the image allows
    /// (`allowed`: a freestanding image without SSE in its --cpu never turns
    /// SSE on) -- a byte each in `features`, the first lowest; the last asks
    /// for none. Asked once a block, whose word keeps the answer.
    public static int PackedChoose(ulong features, int count, int allowed)
    {
        for (int k = 0; k < count - 1; k++)
        {
            int wanted = (int)((features >> (8 * k)) & 0xFF);
            if ((wanted & ~allowed) == 0 && PackedHas(wanted)) return k;
        }
        return count - 1;
    }


    /// What a field free becomes when the link finds the field is not clean
    /// after all: nothing. A unit compiled on its own cannot tell whether a
    /// field another unit fills holds only objects made for it; it calls a
    /// symbol of its own there, and the link makes that symbol FreeField or
    /// this (Escape's field sites, the link's lifetime hints).
    public static void KeepField(nuint at, nuint offset)
    {
    }

    /// Nonzero while a collection marks with the other threads running. The
    /// compiler reads it, inline, before every store of a reference into
    /// the heap or a static, and calls WriteBarrier when it is set.
    public static int Marking;

    /// What compiled code calls before storing the reference `value` at
    /// `slot`, while Marking is set. See Gc.Barrier.
    /// THE CARD TABLE, or 0: one byte for every kilobyte of the address space,
    /// set when a reference is stored into that kilobyte (Gc, generations).
    /// The compiler emits the mark after every store of a reference, as it
    /// emits the Marking test before it; CardMark is the same for the stores
    /// the library makes by hand (Interlocked).
    public static nuint Cards;
    public const int CardShift = 10;

    /// Every card of the object a payload belongs to: what a coroutine's
    /// frame is saved into at a suspension, without a barrier (AsyncTransform).
    public static void CardMarkObject(nuint payload)
    {
        Gc.CardMarkObject(payload);
    }

    /// What an object holds, reported as a barrier reports what a store
    /// overwrites, while a collection marks: a coroutine's machine, before
    /// its frame is saved over it at a suspension (AsyncTransform).
    public static void ShadeObject(nuint payload)
    {
        if (Marking != 0) Gc.ShadeObject(payload);
    }

    public static void CardMark(nuint slot)
    {
        nuint cards = Cards;
        if (cards != 0)
        {
            Sys.Write8(cards + (slot >> CardShift), 1);
        }
    }

    public static void WriteBarrier(nuint slot, nuint value)
    {
        Gc.Barrier(slot, value);
    }

    /// THE STORE SEQUENCES' BARRIERS (X86Backend and X64Backend:
    /// __corsac_refstore, __corsac_refxchg, __corsac_refcas), called while
    /// Marking is set: the report, the store and its card made together
    /// (Gc.BarrierStore).
    public static void WriteBarrierStore(nuint slot, nuint value)
    {
        Gc.BarrierStore(slot, value);
    }

    /// The same for an exchange: what the slot held.
    public static nuint WriteBarrierExchange(nuint slot, nuint value)
    {
        return Gc.BarrierExchange(slot, value);
    }

    /// The same for a compare-exchange: what the slot held, `value` stored
    /// only where that was `expected`.
    public static nuint WriteBarrierCompareExchange(nuint slot, nuint value, nuint expected)
    {
        return Gc.BarrierCompareExchange(slot, value, expected);
    }

    /// The same, told the reference being overwritten rather than where it
    /// is: what a barrier becomes when the object it guarded no longer lives
    /// in memory -- the optimiser kept its fields in registers
    /// (ScalarObjects), so the old reference is a register's value.
    public static void WriteBarrierValues(nuint old, nuint value)
    {
        Gc.BarrierValues(old, value);
    }

    /// Tells the collector about a range of memory outside the heap that may
    /// hold references, so that it is scanned as the statics are.
    ///
    /// The startup of an executable that links this runtime as a SHARED
    /// OBJECT calls this with its own __data_start and _end, because the
    /// library's copy of those symbols describes the library's statics and
    /// not the program's. Nothing else needs it today.
    public static bool RegisterRoots(nuint start, nuint end)
    {
        return GcRoots.Register(start, end);
    }

    public static bool UnregisterRoots(nuint start, nuint end)
    {
        return GcRoots.Unregister(start, end);
    }

    // ---- the images this process is made of -------------------------------
    //
    // A program is its own image and one shared object per library, and the
    // runtime has to be told about each of them: the linker's __data_start,
    // _end and __corsac_frames describe ONE image, and inside this library
    // they describe this library.
    //
    // Every shared object has a function of its own for it -- __corsac_init,
    // which the compiler generates and DT_INIT points at -- and every one of
    // them ends here.

    static long _imagesBegun;

    /// This image's statics, and its unit metadata directory. Called once per image:
    /// from __corsac_init for a shared object, from the entry stub for the
    /// program. Doing it twice is harmless and the generated initialiser
    /// guards against it anyway.
    public static void BeginImage(nuint dataStart, nuint dataEnd, nuint frames)
    {
        LastImageData = dataStart;
        LastImageEnd = dataEnd;
        LastImageFrames = frames;
        _imagesBegun = _imagesBegun + 1;
        RegisterRoots(dataStart, dataEnd);
        RegisterFrames(frames);
        Platform.ArmFaultReport();
    }

    /// The last image begun: what a kernel's module loader keeps, after the
    /// module's DT_INIT, to end it with (EndImage) when the module goes.
    public static nuint LastImageData, LastImageEnd, LastImageFrames;

    /// An image gone (a kernel module unloaded): its statics no longer roots,
    /// its stack maps no longer read. Its objects must be gone first, or
    /// tombstoned (Gc.Revoke).
    public static void EndImage(nuint dataStart, nuint dataEnd, nuint frames)
    {
        UnregisterRoots(dataStart, dataEnd);
        UnregisterFrames(frames);
    }

    // WHO RUNS A LIBRARY'S INITIALISER. On Linux the dynamic linker does,
    // before the program is entered, and by the time the entry stub runs
    // there is nothing left to do. A loader that lives in a KERNEL cannot:
    // it would have to call into the program's own privilege level, which is
    // exactly what it must not do. So it hands the process the SysV link map
    // instead -- DT_DEBUG in the program's dynamic section points at an
    // r_debug whose r_map is a chain of every image -- and the program walks
    // it and runs the initialisers itself.
    //
    // Which of the two happened is answered by _imagesBegun: if any image
    // has introduced itself, the loader ran them and this does nothing. That
    // matters beyond tidiness -- the chain on Linux holds ld-linux.so.2 and
    // any C library too, and running THEIR initialisers a second time is not
    // something this runtime may do.

    const int DtNull = 0;
    const int DtInit = 12;
    const int DtDebug = 21;
    const int DtInitArray = 25;
    const int DtInitArraySize = 27;

    /// Runs every image's initialiser, if nobody else has. `dynamic` is the
    /// address of the PROGRAM's own _DYNAMIC, which the entry stub knows and
    /// this library could not name -- its own _DYNAMIC is its own.
    public static void StartImages(nuint dynamic)
    {
        // Kept whoever runs the initialisers: it is where NativeSymbol finds
        // the link map later.
        _programDynamic = dynamic;
        if (_imagesBegun != 0 || dynamic == 0 || Interpreted())
        {
            return;
        }

        nuint debug = Tag(dynamic, DtDebug);

        if (debug == 0)
        {
            return;
        }

        // struct r_debug { int r_version; struct link_map *r_map; ... }: the
        // map is the second word, the int padded to one where words are 8.
        nuint image = Sys.ReadAddress(debug + WordSize.Bytes);

        while (image != 0)
        {
            // struct link_map { ElfN_Addr l_addr; char *l_name;
            //                   ElfN_Dyn *l_ld; link_map *l_next, *l_prev; }
            RunInitialiser(Sys.ReadAddress(image + 2 * WordSize.Bytes), Sys.ReadAddress(image));
            image = Sys.ReadAddress(image + 3 * WordSize.Bytes);
        }
    }

    /// Whether an interpreter (ld-linux) loaded this program, and so ran
    /// every library's initialisers before the entry stub: AT_BASE, the
    /// interpreter's address, in the auxiliary vector above the environment.
    /// No image having introduced itself is not enough to say otherwise --
    /// a program linked only against the C library has none of this
    /// runtime's images, and running the C library's initialiser a second
    /// time, with no arguments, clears its environment.
    static bool Interpreted()
    {
        nuint stack = Sys.ReadAddress(Sys.ThreadBlock() + Tls.StackBase);
        if (stack == 0)
        {
            return false;
        }
        nuint at = stack + (Sys.ReadAddress(stack) + 2) * WordSize.Bytes;     // past argc, argv and its NULL
        while (Sys.ReadAddress(at) != 0)
        {
            at = at + WordSize.Bytes;                                  // the environment
        }
        at = at + WordSize.Bytes;
        while (true)
        {
            nuint type = Sys.ReadAddress(at);
            if (type == 0)
            {
                return false;
            }
            if (type == 7)                                             // AT_BASE
            {
                return Sys.ReadAddress(at + WordSize.Bytes) != 0;
            }
            at = at + 2 * WordSize.Bytes;
        }
    }

    /// The value of a tag in a dynamic array, or zero.
    // A CALL, NOT INLINED: what it answers is a word of an image's dynamic
    // section, and inlined, its loads -- a word read out of what another
    // word read points to -- were what a method read out of a descriptor
    // looks like. Every image's initialiser called through one made the link
    // take every method a descriptor names as called with anything
    // (RegionSummary.MethodRead, RegionSolver.Addressed), and no region in
    // any program took what a virtual method made.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static nuint Tag(nuint dynamic, nuint want)
    {
        nuint at = dynamic;

        while (true)
        {
            // ElfN_Dyn: a tag word and a value word.
            nuint tag = Sys.ReadAddress(at);

            if (tag == DtNull)
            {
                return 0;
            }

            if (tag == want)
            {
                return Sys.ReadAddress(at + WordSize.Bytes);
            }
            at = at + 2 * WordSize.Bytes;
        }
    }

    /// DT_INIT and then DT_INIT_ARRAY, as the ABI orders them. The addresses
    /// in a dynamic section are as the image was linked, so the load bias is
    /// added; for a program, which is linked where it runs, that is zero.
    static void RunInitialiser(nuint dynamic, nuint bias)
    {
        if (dynamic == 0)
        {
            return;
        }

        nuint init = Tag(dynamic, DtInit);

        if (init != 0)
        {
            Sys.Call(init + bias, 0, 0, 0);
        }

        nuint array = Tag(dynamic, DtInitArray);
        nuint bytes = Tag(dynamic, DtInitArraySize);

        for (nuint i = 0; i < bytes; i = i + WordSize.Bytes)
        {
            nuint one = Sys.ReadAddress(array + bias + i);

            if (one != 0)
            {
                Sys.Call(one, 0, 0, 0);
            }
        }
    }

    // ---- calls into C -----------------------------------------------------
    //
    // A [DllImport] method's body (Lowering.Native) calls EnterNative, the C
    // function, and LeaveNative. Between the two the thread counts as
    // stopped, exactly as a thread waiting in a system call does: C does not
    // allocate from this heap, so a collection has no reason to wait for it,
    // and its callee-saved registers -- which C preserves -- were copied into
    // its block as it said so.
    //
    // ON i386, GS TOO. The C library's thread pointer is GS on i386, as the
    // runtime's is; the kernel keeps one base per thread per GDT slot, so each
    // of the two is a selector that means the right thing in every thread,
    // and swapping them is one segment load each way. On x86-64 the runtime's
    // is GS and C's is FS, and nothing moves.

    static nuint _programDynamic;

    /// i386: the selector GS held when the process began -- the C library's
    /// thread pointer under ld-linux, zero in a program nobody else set up.
    public static int NativeGs;

    /// i386: the selector of the runtime's own thread blocks.
    public static int ManagedGs;

    public static void EnterNative()
    {
        BeginBlocking();
#if !TARGET_64BIT
        if (NativeGs != 0)
        {
            Sys.SetGs(NativeGs);
        }
#endif
    }

    public static void LeaveNative()
    {
#if !TARGET_64BIT
        if (NativeGs != 0)
        {
            Sys.SetGs(ManagedGs);
        }
#endif
        EndBlocking();
    }

    /// THE PROGRAM, ENTERED THROUGH THE C LIBRARY when one is loaded (see
    /// the entry stub): __libc_start_main(main, argc, argv, init, fini,
    /// rtld_fini, stack_end) sets up C's environment, streams and program
    /// name, registers the loader's finaliser, and calls `main` -- which is
    /// the entry stub's own continuation -- and never comes back here. With
    /// no C library loaded this returns and the entry stub carries on.
    public static void StartC(nuint loaderFini, nuint stack, nuint main)
    {
        nuint start = NativeSymbol("__libc_start_main");
        if (start == 0)
        {
            return;
        }
        EnterNative();
        Sys.CallNative(start, main, Sys.ReadAddress(stack), stack + WordSize.Bytes, 0, 0, loaderFini, stack);
    }

    /// The first thing a function C calls does: GS back to the runtime's on
    /// i386, and running again, as far as a collection is concerned.
    public static void ReturnFromC()
    {
#if !TARGET_64BIT
        if (NativeGs != 0)
        {
            Sys.SetGs(ManagedGs);
        }
#endif
        EndBlocking();
    }

    /// A C function the runtime found for itself (NativeSymbol), called with
    /// C's rules and the same handshake a [DllImport] makes.
    public static nuint CallC(nuint fn, nuint a, nuint b, nuint c, nuint d)
    {
        EnterNative();
        nuint r = Sys.CallNative(fn, a, b, c, d);
        LeaveNative();
        return r;
    }

    /// A string as C reads one: its UTF-8 bytes and a NUL, in an array of its
    /// own that the caller keeps alive for the length of the call.
    public static byte[]? NativeString(string? s)
    {
        if (s == null)
        {
            return null;
        }
        return Utf8Transcoder.EncodeTerminated(s);
    }

    /// A string as a Windows W function reads one (LPWSTR): its UTF-16 units
    /// and a NUL, in an array of its own the caller keeps alive for the call.
    public static char[]? NativeWideString(string? s)
    {
        if (s == null)
        {
            return null;
        }
        char[] units = new char[s.Length + 1];
        for (int i = 0; i < s.Length; i++)
        {
            units[i] = s[i];
        }
        return units;
    }

    /// A string as a Windows A function reads one (LPSTR): Windows-1252 and a
    /// NUL. That is the ANSI code page (CP_ACP) of the Western systems these
    /// images are made for, taken as fixed: a system set to another reads
    /// other characters from the same bytes. A character it has no byte for
    /// is '?', WideCharToMultiByte's default character -- not .NET's best fit
    /// (U+0101 to 'a'), which guesses.
    public static byte[]? NativeAnsiString(string? s)
    {
        if (s == null)
        {
            return null;
        }
        byte[] bytes = new byte[s.Length + 1];
        for (int i = 0; i < s.Length; i++)
        {
            bytes[i] = AnsiByte(s[i]);
        }
        return bytes;
    }

    /// One character's Windows-1252 byte: the same below 0x80 and from 0xA0
    /// to 0xFF; the 27 it places at 0x80-0x9F; its five unused places as the
    /// C1 controls Windows maps them to; '?' for the rest.
    static byte AnsiByte(char c)
    {
        if (c < 0x80 || c >= 0xA0 && c <= 0xFF)
        {
            return (byte)c;
        }
        return (byte)(c switch
        {
            '\u20AC' => 0x80, '\u201A' => 0x82, '\u0192' => 0x83, '\u201E' => 0x84, '\u2026' => 0x85,
            '\u2020' => 0x86, '\u2021' => 0x87, '\u02C6' => 0x88, '\u2030' => 0x89, '\u0160' => 0x8A,
            '\u2039' => 0x8B, '\u0152' => 0x8C, '\u017D' => 0x8E, '\u2018' => 0x91, '\u2019' => 0x92,
            '\u201C' => 0x93, '\u201D' => 0x94, '\u2022' => 0x95, '\u2013' => 0x96, '\u2014' => 0x97,
            '\u02DC' => 0x98, '\u2122' => 0x99, '\u0161' => 0x9A, '\u203A' => 0x9B, '\u0153' => 0x9C,
            '\u017E' => 0x9E, '\u0178' => 0x9F,
            '\u0081' => 0x81, '\u008D' => 0x8D, '\u008F' => 0x8F, '\u0090' => 0x90, '\u009D' => 0x9D,
            _ => 0x3F,
        });
    }

    /// The address of an array's first element, or zero for null: what C's
    /// pointer to it is.
    public static nuint NativeData(object? array)
    {
        if (array == null)
        {
            return 0;
        }
        return Sys.ArrayData(array);
    }

    /// errno, as a SetLastError import left it, for Marshal.GetLastPInvokeError.
    public static void SetNativeError(int error)
    {
        Sys.WriteAddress(Sys.ThreadBlock() + Tls.LastError, (nuint)error);
    }

    public static int NativeError()
    {
        return (int)Sys.ReadAddress(Sys.ThreadBlock() + Tls.LastError);
    }

    // FINDING A C FUNCTION AT RUN TIME. The link map (StartImages) lists every
    // image the loader mapped; each has a dynamic section with its symbol
    // table and a hash table over it -- GNU's, which is all current C
    // libraries build, or SysV's, which this linker writes. Addresses in the
    // dynamic sections are relocated in place by ld-linux and not by a
    // kernel's loader, so one smaller than the image's bias is an offset.

    const int DtHash = 4;
    const int DtStrTab = 5;
    const int DtSymTab = 6;
    const int DtGnuHash = 0x6ffffef5;
    const int DtVersym = 0x6ffffff0;

    /// The address of the C symbol `name` in the images the loader mapped,
    /// or zero: none, or a program linked statically.
    public static nuint NativeSymbol(string name)
    {
        if (_programDynamic == 0)
        {
            return 0;
        }
        nuint debug = Tag(_programDynamic, DtDebug);
        if (debug == 0)
        {
            return 0;
        }
        byte[] bytes = Utf8Transcoder.Encode(name, 0, name.Length);
        nuint image = Sys.ReadAddress(debug + WordSize.Bytes);
        while (image != 0)
        {
            nuint found = SymbolIn(Sys.ReadAddress(image + 2 * WordSize.Bytes), Sys.ReadAddress(image), bytes);
            if (found != 0)
            {
                return found;
            }
            image = Sys.ReadAddress(image + 3 * WordSize.Bytes);
        }
        return 0;
    }

    static nuint Located(nuint value, nuint bias)
    {
        return value != 0 && value < bias ? value + bias : value;
    }

    static nuint SymbolIn(nuint dynamic, nuint bias, byte[] bytes)
    {
        if (dynamic == 0)
        {
            return 0;
        }
        nuint strings = Located(Tag(dynamic, DtStrTab), bias);
        nuint symbols = Located(Tag(dynamic, DtSymTab), bias);
        if (strings == 0 || symbols == 0)
        {
            return 0;
        }
        nuint versions = Located(Tag(dynamic, DtVersym), bias);
        nuint gnu = Located(Tag(dynamic, DtGnuHash), bias);
        if (gnu != 0)
        {
            return GnuLookup(gnu, symbols, strings, versions, bias, bytes);
        }
        nuint sysv = Located(Tag(dynamic, DtHash), bias);
        if (sysv != 0)
        {
            return SysvLookup(sysv, symbols, strings, versions, bias, bytes);
        }
        return 0;
    }

    static nuint GnuLookup(nuint table, nuint symbols, nuint strings, nuint versions, nuint bias, byte[] bytes)
    {
        uint h = 5381;
        for (int i = 0; i < bytes.Length; i++)
        {
            h = h * 33 + bytes[i];
        }
        uint buckets = Sys.Read32(table);
        uint first = Sys.Read32(table + 4);
        uint bloom = Sys.Read32(table + 8);
        if (buckets == 0)
        {
            return 0;
        }
        nuint bucketAt = table + 16 + bloom * WordSize.Bytes;
        nuint chainAt = bucketAt + buckets * 4;
        uint index = Sys.Read32(bucketAt + (h % buckets) * 4);
        if (index < first)
        {
            return 0;
        }
        while (true)
        {
            uint link = Sys.Read32(chainAt + (index - first) * 4);
            if ((link | 1) == (h | 1))
            {
                nuint found = Matching(symbols, strings, versions, bias, index, bytes);
                if (found != 0)
                {
                    return found;
                }
            }
            if ((link & 1) != 0)
            {
                return 0;
            }
            index = index + 1;
        }
    }

    static nuint SysvLookup(nuint table, nuint symbols, nuint strings, nuint versions, nuint bias, byte[] bytes)
    {
        uint h = 0;
        for (int i = 0; i < bytes.Length; i++)
        {
            h = (h << 4) + bytes[i];
            uint g = h & 0xF0000000;
            if (g != 0)
            {
                h = h ^ (g >> 24);
            }
            h = h & ~g;
        }
        uint buckets = Sys.Read32(table);
        if (buckets == 0)
        {
            return 0;
        }
        nuint chainAt = table + 8 + buckets * 4;
        uint index = Sys.Read32(table + 8 + (h % buckets) * 4);
        while (index != 0)
        {
            nuint found = Matching(symbols, strings, versions, bias, index, bytes);
            if (found != 0)
            {
                return found;
            }
            index = Sys.Read32(chainAt + index * 4);
        }
        return 0;
    }

    static nuint Matching(nuint symbols, nuint strings, nuint versions, nuint bias, uint index, byte[] bytes)
    {
#if TARGET_64BIT
        nuint symbol = symbols + index * 24;
        byte info = Sys.Read8(symbol + 4);
        ushort section = Sys.Read16(symbol + 6);
        nuint value = Sys.ReadAddress(symbol + 8);
#else
        nuint symbol = symbols + index * 16;
        byte info = Sys.Read8(symbol + 12);
        ushort section = Sys.Read16(symbol + 14);
        nuint value = Sys.ReadAddress(symbol + 4);
#endif
        if (section == 0 || value == 0)
        {
            return 0;
        }
        nuint text = strings + Sys.Read32(symbol);
        for (int i = 0; i < bytes.Length; i++)
        {
            if (Sys.Read8(text + (nuint)i) != bytes[i])
            {
                return 0;
            }
        }
        if (Sys.Read8(text + (nuint)bytes.Length) != 0)
        {
            return 0;
        }
        if (versions != 0 && (Sys.Read16(versions + index * 2) & 0x8000) != 0)
        {
            return 0;
        }
        nuint address = value + bias;
        if ((info & 15) == 10)                  // STT_GNU_IFUNC
        {
            address = (nuint)CallC(address, 0, 0, 0, 0);
        }
        return address;
    }

    // ---- the frame tables of the other images -----------------------------
    //
    // Each compilation unit carries an object-local frame table. The linker
    // collects their addresses in one image-local directory. Registration is
    // per image, not per source file, so splitting a program does not consume
    // the registry's image slots. The entry stub and each DT_INIT register the
    // directory for their own linked image.
    //
    // Room for the tables is taken from the operating system rather than
    // from a static array, for the reason GcRoots gives: registering must
    // not allocate, and a heap block here would be one the collector had to
    // keep for ever.

    const int TablesMax = 32;
    const int TablesBytes = 256;

    static nuint _tables;
    static nuint _tableCount;

    /// How many image directories and tables are registered, and the i-th:
    /// the collector reads the stack maps they name (Gc, precise registers).
    /// This image's own directory first (Sys.FrameDirectory), then every
    /// other image's in the order they introduced themselves.
    public static nuint MetadataCount()
    {
        return _tableCount + 1;
    }

    public static nuint Metadata(nuint i)
    {
        if (i == 0)
        {
            return Sys.FrameDirectory();
        }
        return i - 1 < _tableCount ? Sys.ReadAddress(_tables + (i - 1) * WordSize.Bytes) : 0;
    }

    /// Registers an image directory or an explicitly supplied individual frame
    /// table. Both are current metadata kinds, distinguished by their magic.
    public static bool RegisterFrames(nuint table)
    {
        if (table == 0)
        {
            return false;
        }

        if (Sys.Read32(table) != TableMagic && Sys.Read32(table) != PooledMagic && Sys.Read32(table) != DirectoryMagic) { return false; }
        for (nuint i = 0; i < _tableCount; i++)
        {
            if (Sys.ReadAddress(_tables + i * WordSize.Bytes) == table) { return true; }
        }

        if (_tables == 0)
        {
            _tables = Platform.Map(TablesBytes);

            if (_tables == 0)
            {
                return false;
            }
        }

        if (_tableCount >= TablesMax)
        {
            return false;
        }
        Sys.WriteAddress(_tables + _tableCount * WordSize.Bytes, table);
        _tableCount = _tableCount + 1;
        Gc.MapsChanged();
        return true;
    }

    /// An image's directory taken out again: a kernel module unloaded. The
    /// collector's index is rebuilt at its next collection.
    public static bool UnregisterFrames(nuint table)
    {
        for (nuint i = 0; i < _tableCount; i++)
        {
            if (Sys.ReadAddress(_tables + i * WordSize.Bytes) != table) continue;
            for (nuint j = i; j + 1 < _tableCount; j++) Sys.WriteAddress(_tables + j * WordSize.Bytes, Sys.ReadAddress(_tables + (j + 1) * WordSize.Bytes));
            _tableCount = _tableCount - 1;
            Gc.MapsChanged();
            return true;
        }
        return false;
    }

    /// The end of Main. A process lives on while any FOREGROUND thread does,
    /// as .NET's does: whoever starts one leaves here the address of what
    /// waits for them (Thread.WaitForForeground), which runs first.
    public static void Exit(int code)
    {
        nuint wait = ForegroundWait;
        if (wait != 0) Sys.Call(wait, 0, 0, 0);
        Platform.Exit(code);
    }

    public static nuint ForegroundWait;

    // ---- what runs when the process ends ---------------------------------
    //
    // The class library buffers console output and has to empty the buffer
    // before the process goes, which used to be a call from the platform
    // library straight to Console.Flush. That is a call UPWARDS -- the
    // syscall layer naming a type of the class library -- and it is what
    // made the two impossible to build as separate shared objects. The
    // direction is reversed here: whoever has something to flush leaves its
    // address, and the platform library calls what it was left without
    // knowing whose it is.

    static nuint _atExit;

    /// Leaves a function to be run, with no arguments, just before the
    /// process exits. One is enough for everything that has wanted this;
    /// a second call replaces the first.
    public static void OnExit(nuint function)
    {
        _atExit = function;
    }

    /// Runs it. Called from the platform library's Exit, which is the one
    /// road out of every program.
    public static void AtExit()
    {
        // What the collector counted, and what it sampled: nothing to say
        // where there is none.
        SpillCounts.Say();
        if (CollectorLinked())
        {
            AllocSamples.Dump();
            Gc.SayStats();
        }
        ExitHandler();
    }

    /// What the program left to be run at its end (OnExit), alone: the
    /// bare-metal exit's part of AtExit, which has no statistics to say and
    /// pulls in nothing of the collector's.
    public static void ExitHandler()
    {
        nuint f = _atExit;

        if (f != 0)
        {
            _atExit = 0;                // never twice, however exit is reached
            Sys.Call(f, 0, 0, 0);
        }
    }

    /// Every byte the runtime prints goes through here, so the retry on a
    /// short or interrupted write is in one place.
    public static void WriteBytes(int fd, nuint address, nuint count)
    {
        nuint done = 0;

        while (done < count)
        {
            long n = Platform.WriteBytes(fd, address + done, count - done);

            if (n < 0)
            {
                // -4 is EINTR on every Unix: a signal arrived, the write did
                // not happen, and asking again is what was meant. Any other
                // error is final; the runtime has nowhere to report it.
                if (n == -4)
                {
                    continue;
                }
                return;
            }
            if (n == 0)
            {
                return;
            }
            done = done + (nuint)n;
        }
    }

    // ---- how an object is laid out, as this file needs to know it ----------
    //
    // A string or array is a 16-byte header -- vtable, sync word, count, pad --
    // followed by the elements (docs/software/X86-BACKEND.md, "Arrays and
    // strings"): a byte array's bytes, a string's UTF-16 code units.
    // Sys.ObjectAddress(s) is the object's address, so its elements start at
    // Sys.ArrayData(s): the header in front of them is the compiler's to
    // know, so nothing here hard-codes it.

    // ---- printing --------------------------------------------------------
    //
    // Sys.Print* land here. All of them go through WriteBytes, which the
    // system library provides (fd, address, count), so the only thing this
    // file knows about the console is that descriptor 1 is it.

    const int StdOut = 1;
    const int StdErr = 2;

    /// ASCII text to a descriptor WITHOUT ALLOCATING, for the paths that
    /// report the allocator's own failure and the collector's own reports,
    /// made with its lock held: a word of characters at a time through a local
    /// whose address is taken, so it lives in the frame and nothing is ever
    /// allocated -- a block `new`ed for it was allocated, and the collector's
    /// census, said with the heap lock held, waited on that lock for good. A
    /// unit outside ASCII is written as '?'.
    public static void WriteLiteral(int fd, string text)
    {
        // A WORD AT A TIME, the bytes going out through the word's own
        // address: as many as a word holds, four on i386.
        nuint word = 0;
        nuint at = Sys.AddressOf(ref word);
        int i = 0;
        while (i < text.Length)
        {
            int n = text.Length - i < WordSize.Bytes ? text.Length - i : WordSize.Bytes;
            word = 0;
            for (int k = 0; k < n; k++)
            {
                int c = Sys.GetChar(text, i + k);
                Sys.Write8(at + (nuint)k, (byte)(c < 0x80 ? c : '?'));
            }
            WriteBytes(fd, at, (nuint)n);
            i = i + n;
        }
    }

    /// A string to a descriptor, as its UTF-8 -- through a fixed block that
    /// escape analysis keeps in the frame, a chunk at a time, so that printing
    /// allocates nothing and a program that only prints never meets the
    /// collector. A chunk never ends between the two halves of a surrogate
    /// pair, which are one character and one UTF-8 sequence.
    public static void WriteText(int fd, string s)
    {
        byte[] block = new byte[WriteChunkBytes];
        int at = 0;

        while (at < s.Length)
        {
            int take = s.Length - at;
            if (take > WriteChunkBytes / 3)
            {
                take = WriteChunkBytes / 3;
                int last = Sys.GetChar(s, at + take - 1);
                if (last >= 0xD800 && last <= 0xDBFF)
                {
                    take = take - 1;
                }
            }
            int n = Utf8Transcoder.Encode(s, at, take, block, 0);
            WriteBytes(fd, Sys.ArrayData(block), (nuint)n);
            at = at + take;
        }
    }

    // Three bytes per unit at most (a pair is four bytes for two units), so a
    // chunk of a third as many units always fits.
    const int WriteChunkBytes = 384;

    /// The end of a catch body's hold on the exception it caught, at every way
    /// out of the body but handing the exception on. Nothing to do: the
    /// compiler makes the call a free where the body kept the exception
    /// nowhere else, and leaves it to the collector where it did.
    public static void CatchEnd(object caught) { }

    public static void Print(string s)
    {
        WriteText(StdOut, s);
    }

    /// Bytes to the output as they are (Sys.Print of a ReadOnlySpan<byte>):
    /// nothing encoded, nothing allocated.
    public static void Print(ReadOnlySpan<byte> bytes)
    {
        if (bytes.Length == 0) return;
        WriteBytes(StdOut, Sys.ArrayData(bytes.Items) + (nuint)bytes.Start, (nuint)bytes.Length);
    }

    public static void PrintLine()
    {
        Print("\n"u8);
    }

    // The printing routines build their text in a LOCAL block, never a
    // cached one: a static holding a buffer is an escape by definition, and
    // escape analysis turns a local allocation into a frame slot, so a local
    // costs nothing and keeps the collector out of programs that only print.
    //
    // WHAT GOES TO THE DESCRIPTOR IS UTF-8. A string is UTF-16 code units, as
    // C#'s is, and a terminal, a pipe and a file all mean bytes; the encoding
    // between the two is made here, once, on the way out (Utf8.Encode).

    /// One UTF-16 code unit, as its UTF-8. A lone surrogate has no UTF-8 of its
    /// own and is written as U+FFFD, which is what .NET's encoder makes of one.
    public static void PrintChar(int c)
    {
        // ASCII is its own UTF-8: one byte, from a frame's word, nothing made.
        if (c >= 0 && c < 0x80)
        {
            long one = c;
            WriteBytes(StdOut, Sys.AddressOf(ref one), 1);
            return;
        }
        string text = Sys.NewChars(1);
        Sys.SetChar(text, 0, c);
        Print(text);
    }

    /// Decimal, signed, with long.MinValue handled: the digits are produced
    /// from the value's MAGNITUDE AS UNSIGNED, which cannot overflow where
    /// negating long.MinValue would.
    public static void PrintInt(long v)
    {
        // The digits' bytes are written as they were made: no string between.
        byte[] scratch = new byte[DigitsBytes];
        int begin = Digits(scratch, v);
        WriteBytes(StdOut, Sys.ArrayData(scratch) + (nuint)begin, (nuint)(DigitsBytes - begin));
    }

    /// Sixteen hex digits, zero padded, no prefix -- the shape a debugger
    /// prints a word in, so two values line up when printed one above the
    /// other.
    public static void PrintHex(long v)
    {
        byte[] text = new byte[16];
        ulong bits = (ulong)v;
        int i = 15;

        while (i >= 0)
        {
            int nibble = (int)(bits & (ulong)15);
            text[i] = (byte)(nibble < 10 ? 48 + nibble : 87 + nibble);
            bits = bits >> 4;
            i = i - 1;
        }
        WriteBytes(StdOut, Sys.ArrayData(text), 16);
    }

    // Twenty digits and a sign is the most a long ever needs.
    const int DigitsBytes = 24;

    /// Writes the decimal text of `value` into dst at `at`, at most
    /// `capacity` bytes, and answers how many were written. The text is built
    /// backwards from the least digit into the far end of the range and then
    /// slid down, which is one pass and needs no second buffer.
    ///
    /// A capacity too small for the number gets the FIRST `capacity`
    /// characters, which is what the old machine's sfmt did and what
    /// String.FromInt relies on when it passes 20 -- enough for any long.
    private static int FormatDecimal(string dst, int at, long value, int capacity)
    {
        if (capacity <= 0)
        {
            return 0;
        }

        byte[] scratch = new byte[DigitsBytes];
        int begin = Digits(scratch, value);
        int end = DigitsBytes;
        int length = end - begin;
        int take = length < capacity ? length : capacity;

        for (int i = 0; i < take; i++)
        {
            Sys.SetChar(dst, at + i, scratch[begin + i]);
        }
        return take;
    }

    /// The decimal text of `value` in the far end of `scratch` (DigitsBytes
    /// long), least digit first from the top down, and where it begins.
    private static int Digits(byte[] scratch, long value)
    {
        // The magnitude as unsigned: negating long.MinValue as a long gives
        // long.MinValue back, but as a ulong it is exactly 2^63.
        //
        // A BRANCH rather than `bool negative = value < 0`: the x86 backend
        // (as of this writing) mis-spills a bool it made with setcc when the
        // register pressure is this high -- it stores the flag to the frame
        // and then reads it back from BL -- and this routine is where that
        // showed up, as 14 printing as a twenty-digit negative. Branching
        // keeps the flag out of a byte register altogether.
        bool negative = false;
        ulong magnitude = (ulong)value;

        if (value < 0)
        {
            negative = true;
            magnitude = (ulong)(0 - value);
        }

        // Digits into a local block, least first, from the top down.
        int end = DigitsBytes;
        int begin = end;

        if (magnitude == (ulong)0)
        {
            begin = begin - 1;
            scratch[begin] = 48;
        }

        // Past 32 bits, a digit at a time through the helper below, never
        // `/`: this file IS where `/` on a long ends up. It answers the
        // remainder too, so no 64-bit multiply takes it back.
        while ((magnitude >> 32) != (ulong)0)
        {
            ulong left;
            magnitude = UDivShort(magnitude, (uint)10, out left);
            begin = begin - 1;
            scratch[begin] = (byte)(48 + (int)left);
        }

        // The rest, nearly every number there is, with the processor's own
        // 32-bit divide.
        uint small = (uint)magnitude;
        while (small != (uint)0)
        {
            uint q = small / (uint)10;
            begin = begin - 1;
            scratch[begin] = (byte)(48 + (int)(small - q * (uint)10));
            small = q;
        }

        if (negative)
        {
            begin = begin - 1;
            scratch[begin] = 45;
        }

        return begin;
    }

    // ---- enums ----------------------------------------------------------------
    //
    // WHAT A VALUE IS CALLED. .NET reads it out of the type's metadata; there
    // is none here, because an enum is a four-byte number with a symbol beside
    // it and by the time a program runs the names have gone. So the code
    // generator writes them down -- one table per enum a program renders, the
    // names in one array and their values in another, both in value order and
    // both ordinary read-only arrays (compiler/Lang/Lower/Lowering.Enum.cs).
    // Everything below is a walk over those two.

    /// AN ENUM VALUE AS TEXT, in .NET's words: the member's name, the members
    /// a set of bits is made of, and otherwise the number.
    public static string EnumName(string[] names, long[] values, bool flags, long value)
    {
        for (int i = 0; i < values.Length; i++)
        {
            if (values[i] == value) { return names[i]; }
        }

        if (!flags || value == 0) { return String.FromInt(value); }

        // A SET OF BITS, TAKEN LARGEST MEMBER FIRST. That order is what makes
        // a member which is the union of two others swallow both rather than
        // leaving them to be named again, and it is the order .NET takes them
        // in. Each is put in front of what is already there, so the answer
        // comes out in value order.
        long left = value;
        string said = "";

        for (int i = values.Length - 1; i >= 0; i--)
        {
            long bit = values[i];

            if (bit == 0 || (left & bit) != bit) { continue; }

            left = left & ~bit;
            said = said.Length == 0 ? names[i] : names[i] + ", " + said;
        }

        // Bits no member accounts for: the whole value as a number, which is
        // again what .NET answers rather than naming half of it.
        if (left != 0 || said.Length == 0) { return String.FromInt(value); }
        return said;
    }

    /// THE NAME OF A MEMBER WITH EXACTLY THIS VALUE, or null. .NET's
    /// Enum.GetName, which -- unlike ToString -- never takes a set of bits
    /// apart and never answers a number.
    public static string? EnumLabel(string[] names, long[] values, long value)
    {
        for (int i = 0; i < values.Length; i++)
        {
            if (values[i] == value) { return names[i]; }
        }
        return null;
    }

    /// Whether a member has exactly this value: .NET's Enum.IsDefined, which
    /// says no to a combination of flags no single member spells.
    public static bool EnumDefined(long[] values, long value)
    {
        for (int i = 0; i < values.Length; i++)
        {
            if (values[i] == value) { return true; }
        }
        return false;
    }

    /// THE TEXT BACK INTO A VALUE. .NET reads a member's name, a
    /// comma-separated list of them -- for any enum, not only a `[Flags]` one
    /// -- or a plain decimal number, which it accepts even when no member has
    /// it. Spaces around the commas are allowed and an empty string is not.
    public static bool EnumTryParse(string[] names, long[] values, string text, bool ignoreCase, out long value)
    {
        value = 0;

        if (text == null) { return false; }

        int at = 0;
        long total = 0;
        bool any = false;

        while (at <= text.Length)
        {
            int end = text.IndexOf(',', at);

            if (end < 0) { end = text.Length; }

            string part = text.Substring(at, end - at).Trim();

            at = end + 1;

            if (part.Length == 0) { return false; }

            long one = 0;

            if (!EnumOne(names, values, part, ignoreCase, out one)) { return false; }

            total = total | one;
            any = true;

            if (end == text.Length) { break; }
        }

        if (!any) { return false; }

        value = total;
        return true;
    }

    /// One name, or one number, out of the list.
    static bool EnumOne(string[] names, long[] values, string part, bool ignoreCase, out long value)
    {
        value = 0;

        for (int i = 0; i < names.Length; i++)
        {
            if (ignoreCase ? String.Compare(names[i], part, true) == 0 : names[i] == part)
            {
                value = values[i];
                return true;
            }
        }

        // A NUMBER IS ITSELF, even when no member has it: .NET reads
        // `Enum.Parse<Colour>("9")` as the 9 it says, and the value that comes
        // out prints as 9 again.
        char first = part[0];

        if (first != '-' && first != '+' && (first < '0' || first > '9')) { return false; }

        long parsed = 0;

        if (!long.TryParse(part, out parsed)) { return false; }

        value = parsed;
        return true;
    }

    /// The same, throwing what .NET throws when the text names nothing.
    public static long EnumParse(string[] names, long[] values, string text, bool ignoreCase)
    {
        long value = 0;

        if (EnumTryParse(names, values, text, ignoreCase, out value)) { return value; }

        if (text == null) { throw new ArgumentNullException("value"); }
        throw new ArgumentException("Requested value '" + text + "' was not found.");
    }

    // ---- stack traces ---------------------------------------------------------
    //
    // WHERE A FAULT HAPPENED, and what called what to get there. .NET prints
    // an unhandled exception as its type, its message, and then the frames,
    // and that is worth more on this machine than on one with a debugger,
    // because this one has no debugger.
    //
    // Two things make it possible. Every function's prologue is `push ebp; mov
    // ebp, esp`, so the saved frame pointers are a linked list of callers with
    // each return address beside them; and the code generator writes a table
    // saying what each stretch of the image is -- see Lang/X86/FrameTable.cs
    // for its shape. Walking the one and looking each address up in the other
    // is the whole of it.

    /// How many frames a trace keeps. A runaway recursion has thousands and
    /// nobody reads them; .NET truncates too.
    public const int TraceDepth = 32;

    /// 'CFR5' as the code generator writes it, least significant byte first.
    /// Spelled as the four letters rather than the number they come to, so
    /// that it cannot drift from FrameTableFormat (the linker's object
    /// model, where the layout is written down in full) by a typing slip.
    const int TableMagic = 67 + (70 << 8) + (82 << 16) + (53 << 24);
    /// 'CFR6': the same table, its names and files in the image's one pool,
    /// whose address the link wrote at +12 (Lto.FramePool), and its shared
    /// line programs there too, from where +20 says.
    const int PooledMagic = 67 + (70 << 8) + (82 << 16) + (54 << 24);
    /// 'CFP2': that pool. Its names are spelled in tokens: at +4 how many,
    /// at +8 where the names begin, at +12 a word for where each token
    /// starts and one more for where the last ends, then the tokens' bytes;
    /// a name is a ULEB128 token count and then each token's index. The
    /// image's shared line programs follow the names.
    const int NamePoolMagic = 67 + (70 << 8) + (80 << 16) + (50 << 24);
    const int DirectoryMagic = 67 + (77 << 8) + (68 << 16) + (82 << 24);

    /// A ULEB128 at `at`, with `at` left just past it. The table is written
    /// this way because it is in every image and the deltas are small.
    static nuint Uleb(nuint at, out nuint next) {
        nuint value = 0;
        int shift = 0;
        while (true) {
            byte b = Sys.Read8(at);
            at = at + 1;
            value = value | ((nuint)(b & 127) << shift);
            if ((b & 128) == 0) { next = at; return value; }
            shift = shift + 7;
        }
    }

    /// The same, signed, for a line that moved backwards.
    static long Sleb(nuint at, out nuint next) {
        long value = 0;
        int shift = 0;
        while (true) {
            byte b = Sys.Read8(at);
            at = at + 1;
            value = value | ((long)(b & 127) << shift);
            shift = shift + 7;
            if ((b & 128) == 0) {
                if (shift < 64 && (b & 64) != 0) { value = value | -(1L << shift); }
                next = at;
                return value;
            }
        }
    }

    /// A zero-terminated string out of the table.
    static string TextAt(nuint at) {
        int length = 0;
        while (Sys.Read8(at + (nuint)length) != 0) { length = length + 1; }

        return Utf8Transcoder.Decode(at, length);
    }

    /// A name or file a lookup found: a zero-terminated string when `pool`
    /// is 0, else a name of that pool, its tokens put together.
    static string NameAt(nuint pool, nuint at) {
        if (pool == 0) { return TextAt(at); }

        nuint count = Uleb(at, out at);
        nuint tokens = at;
        nuint length = 0;
        for (nuint i = 0; i < count; i++) {
            nuint token = Uleb(at, out at);
            length = length + TokenEnd(pool, token) - TokenStart(pool, token);
        }
        byte[] bytes = new byte[(int)length];
        at = tokens;
        int to = 0;
        for (nuint i = 0; i < count; i++) {
            nuint token = Uleb(at, out at);
            nuint from = TokenStart(pool, token);
            nuint end = TokenEnd(pool, token);
            while (from < end) {
                bytes[to] = Sys.Read8(from);
                to = to + 1;
                from = from + 1;
            }
        }
        return Utf8Transcoder.Decode(bytes, 0, to);
    }

    /// Where token `i` of a name pool starts and ends.
    static nuint TokenStart(nuint pool, nuint i) {
        return pool + Sys.Read32(pool + 12 + i * 4);
    }

    static nuint TokenEnd(nuint pool, nuint i) {
        return pool + Sys.Read32(pool + 16 + i * 4);
    }

    /// Whether `pc` is in a function some image described to the runtime --
    /// its own or one that introduced itself (BeginImage). Allocates nothing:
    /// a fault handler asks it.
    public static bool KnowsCode(nuint pc) {
        nuint name, file, pool, offset;
        long line;
        return Lookup(pc, out name, out file, out pool, out line, out offset, false);
    }

    /// THE TABLE ENTRY AN ADDRESS FALLS IN: where its name and its source
    /// file are spelled, the source line the address is on (0 for none, and
    /// left at 0 unless `lines` asks, since a line is its function's line
    /// program read), and how far into the function the address lies. False
    /// when the address belongs to no function this image described. `pool` is the name pool the name and
    /// file are spelled in, or 0 when they are zero-terminated strings
    /// (NameAt, SayName).
    ///
    /// Allocates nothing, which is what lets the out-of-memory report use it.
    static bool Lookup(nuint address, out nuint name, out nuint file, out nuint pool, out long line, out nuint offset, bool lines) {
        // This image's own table first, then every other image's, in the
        // order they introduced themselves.
        if (LookupMetadata(Sys.FrameDirectory(), address, out name, out file, out pool, out line, out offset, lines)) { return true; }

        for (nuint i = 0; i < _tableCount; i++) {
            if (LookupMetadata(Sys.ReadAddress(_tables + i * WordSize.Bytes), address, out name, out file, out pool, out line, out offset, lines)) { return true; }
        }
        return false;
    }

    static bool LookupMetadata(nuint metadata, nuint address, out nuint name, out nuint file, out nuint pool, out long line, out nuint offset, bool lines) {
        name = 0; file = 0; pool = 0; line = 0; offset = 0;
        if (metadata == 0) { return false; }
        if (Sys.Read32(metadata) == TableMagic || Sys.Read32(metadata) == PooledMagic) {
            return LookupIn(metadata, address, out name, out file, out pool, out line, out offset, lines);
        }
        if (Sys.Read32(metadata) != DirectoryMagic || Sys.Read32(metadata + 4) != 0 || Sys.Read32(metadata + 12) != 16) { return false; }
        uint count = Sys.Read32(metadata + 8);
        if (count > 100000) { return false; }
        for (nuint i = 0; i < count; i++) {
            nuint record = metadata + 16 + i * 16;
            nuint table = TableAddress(record);
            if (table != 0 && Sys.Read32(record + 4) >= 24 && LookupIn(table, address, out name, out file, out pool, out line, out offset, lines)) { return true; }
        }
        return false;
    }

    /// AN ADDRESS THE LINK WROTE INTO A TABLE: on i386 the address itself;
    /// in long mode the distance from the word to it, signed, so a shared
    /// object loaded anywhere in 64-bit space needs no loader relocation to
    /// describe its own code. Zero is none either way.
    static nuint TableAddress(nuint at) {
        uint held = Sys.Read32(at);
#if TARGET_64BIT
        if (held == 0) { return 0; }
        return at + (nuint)(long)(int)held;
#else
        return held;
#endif
    }

    /// The same, in one table ('CFR5' or 'CFR6'; FrameTableFormat in the
    /// linker's object model). Each entry is a lead byte -- its start's
    /// distance from the end of the one before when under 7, whether its file
    /// changed, which kind of line program it has, and its size's low two
    /// bits -- and then its fields, each said against the entry before: its
    /// name from that one's name, its file only when it changes, and its line
    /// program by its length and first line when it is its own (those follow
    /// in entry order) or by where it lies among the shared ones. Only the
    /// matching entry's program is read, and only to the address. The shared
    /// programs are the matched table's own or its image's pool's, never the
    /// runtime's unit's.
    static bool LookupIn(nuint table, nuint address, out nuint name, out nuint file, out nuint pool, out long line, out nuint offset, bool lines) {
        name = 0;
        file = 0;
        pool = 0;
        line = 0;
        offset = 0;

        if (table == 0) { return false; }
        bool pooled = Sys.Read32(table) == PooledMagic;
        if (!pooled && Sys.Read32(table) != TableMagic) { return false; }

        uint count = Sys.Read32(table + 4);
        nuint end = TableAddress(table + 8);
        nuint strings;
        nuint shared;
        if (pooled) {
            pool = TableAddress(table + 12);
            if (pool == 0 || Sys.Read32(pool) != NamePoolMagic) { pool = 0; return false; }
            strings = pool + Sys.Read32(pool + 8);
            shared = pool + Sys.Read32(table + 20);
        } else {
            strings = table + Sys.Read32(table + 12);
            shared = table + Sys.Read32(table + 20);
        }
        nuint own = table + Sys.Read32(table + 16);
        nuint at = table + 24;
        nuint said = 0;
        nuint source = 0;
        long first = 0;

        for (uint i = 0; i < count; i++) {
            byte lead = Sys.Read8(at);
            at = at + 1;
            nuint start = end + (nuint)(lead & 7);
            if ((lead & 7) == 7) { start = end + (nuint)Sleb(at, out at); }
            nuint size = (Uleb(at, out at) << 2) | (nuint)((lead >> 6) & 3);
            said = said + (nuint)Sleb(at, out at);
            if ((lead & 8) != 0) { source = Uleb(at, out at); }
            int kind = (lead >> 4) & 3;
            nuint program = 0;
            nuint length = 0;
            if (kind == 1) {
                length = Uleb(at, out at);
                first = first + Sleb(at, out at);
            } else if (kind == 2) {
                program = shared + Uleb(at, out at);
            } else if (kind != 0) {
                pool = 0;
                return false;
            }

            // The functions ascend: every entry after one past the address
            // starts past it too.
            if (address < start) { pool = 0; return false; }
            if (address < start + size) {
                name = strings + said;
                file = strings + source;
                offset = address - start;
                if (lines && kind == 1) {
                    line = LineIn(own, own + length, first, offset);
                } else if (lines && kind == 2) {
                    length = Uleb(program, out program);
                    nuint top = program + length;
                    long from = Sleb(program, out program);
                    line = LineIn(program, top, from, offset);
                }
                return true;
            }
            end = start + size;
            own = own + length;
        }
        pool = 0;
        return false;
    }

    /// One frame, in .NET's words: `   at Type.Method in file:line N`, or null
    /// when the address belongs to no function this image described.
    public static string? Frame(nuint address) {
        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;

        if (!Lookup(address, out name, out file, out pool, out line, out offset, true)) { return null; }

        string where = String.Concat("   at ", NameAt(pool, name));
        string source = NameAt(pool, file);
        if (source.Length == 0) { return where; }

        if (line == 0) { return String.Concat(where, String.Concat(" in ", source)); }

        return String.Concat(where,
               String.Concat(" in ", String.Concat(source,
               String.Concat(":line ", String.FromInt(line)))));
    }

    /// THE LINE A BYTE OF A FUNCTION BELONGS TO: that of the last pair at
    /// or before it, or 0 when it lies before the first. The program runs
    /// from `at` to `end` and starts at line `line`: a ULEB128 first offset,
    /// then ops, each moving the offset forward by A and the line by L, never
    /// 0 (FrameTableFormat, which writes them, has the same numbers):
    ///   b < 160         A = b / 2 + 1, L = b % 2 + 1
    ///   160 <= b < 255  c = (b - 160) * 256 + the next byte, A = c / 48 + 1,
    ///                   D = c % 48 - 24, and L = D + 1 when D >= 0, else D
    ///   b = 255         ULEB128 A, SLEB128 L
    static long LineIn(nuint at, nuint end, long line, nuint offset) {
        nuint where = Uleb(at, out at);
        if (where > offset) { return 0; }

        while (at < end) {
            int b = Sys.Read8(at);
            at = at + 1;
            nuint step;
            long moved;
            if (b < 160) {
                step = (nuint)((b >> 1) + 1);
                moved = (b & 1) + 1;
            } else if (b < 255) {
                int c = ((b - 160) << 8) | Sys.Read8(at);
                at = at + 1;
                step = (nuint)(c / 48 + 1);
                moved = c % 48 - 24;
                if (moved >= 0) { moved = moved + 1; }
            } else {
                step = Uleb(at, out at);
                moved = Sleb(at, out at);
            }
            where = where + step;
            if (where > offset) { return line; }
            line = line + moved;
        }
        return line;
    }

    /// THE CALLERS ABOVE A FRAME, newest first, as .NET lays them out.
    ///
    /// The frame is PASSED IN rather than read here, and that is not fussiness:
    /// whether this function is inlined into its caller changes how many frames
    /// lie between it and the one that matters, and a trace that is right only
    /// while the optimiser leaves it alone is not right. Whoever asks reads its
    /// own frame pointer -- one instruction -- and the answer does not depend on
    /// what was inlined into what.
    public static string Trace(nuint from) {
        return TraceOf(Frames(from));
    }

    /// The return addresses of the frames above `from`, newest first: what a
    /// trace is made of, taken while the stack still holds them. Naming them
    /// waits for somebody to read the trace (TraceOf), as .NET's does -- a
    /// throw pays for a walk of the frame chain, not for a search of the
    /// image's function table per frame, which made every exception a
    /// program caught and forgot cost thousands of lookups.
    public static nuint[] Frames(nuint from) {
        int count = 0;
        nuint frame = from;
        while (count < TraceDepth) {
            nuint next = StepFrame(frame);
            if (next == NoFrame) { break; }
            count = count + 1;
            frame = next;
        }

        nuint[] frames = new nuint[count];
        frame = from;
        for (int i = 0; i < count; i++) {
            frames[i] = Sys.ReadAddress(frame + WordSize.Bytes);
            frame = Sys.ReadAddress(frame);
        }
        return frames;
    }

    /// What StepFrame answers for a frame not to read.
    public const nuint NoFrame = ~(nuint)0;

    /// THE FRAME OF A FUNCTION STOPPED AT `pc`, its stack pointer `sp` and
    /// frame pointer register `bp` as they were there: `bp` itself, but in a
    /// function that gives the frame pointer a value (a leaf: the compiler's
    /// FramePointerFree), where the frame is at `sp` plus the frame's size and
    /// the saved registers' pushes. Such a function starts `push ebp` and
    /// `mov ebp, esp` written 8B EC (x86-64: push rbp, 48 8B EC), then `sub
    /// esp, n` (83 EC n or 81 EC n32, REX.W on x86-64) if it has a frame,
    /// then its pushes. For a fault or an interrupt in one: the chain from
    /// there runs on as from any frame. Allocates nothing.
    public static nuint FrameAt(nuint pc, nuint sp, nuint bp) {
        nuint name, file, pool, offset;
        long line;
        if (!Lookup(pc, out name, out file, out pool, out line, out offset, false)) { return bp; }
        nuint at = pc - offset;
        if (Sys.Read8(at) != 0x55) { return bp; }
        at = at + 1;
#if TARGET_64BIT
        if (Sys.Read8(at) != 0x48) { return bp; }
        at = at + 1;
#endif
        if (Sys.Read8(at) != 0x8B || Sys.Read8(at + 1) != 0xEC) { return bp; }
        at = at + 2;
        nuint size = 0;
#if TARGET_64BIT
        if (Sys.Read8(at) == 0x48) {
            if (Sys.Read8(at + 1) == 0x83 && Sys.Read8(at + 2) == 0xEC) { size = Sys.Read8(at + 3); at = at + 4; }
            else if (Sys.Read8(at + 1) == 0x81 && Sys.Read8(at + 2) == 0xEC) { size = Sys.Read32(at + 3); at = at + 7; }
        }
#else
        if (Sys.Read8(at) == 0x83 && Sys.Read8(at + 1) == 0xEC) { size = Sys.Read8(at + 2); at = at + 3; }
        else if (Sys.Read8(at) == 0x81 && Sys.Read8(at + 1) == 0xEC) { size = Sys.Read32(at + 2); at = at + 6; }
#endif
        nuint pushes = 0;
        while (true) {
            int b = Sys.Read8(at);
#if TARGET_64BIT
            if (b == 0x41 && Sys.Read8(at + 1) >= 0x50 && Sys.Read8(at + 1) <= 0x57) { pushes = pushes + 1; at = at + 2; continue; }
#endif
            if (b >= 0x50 && b <= 0x57) { pushes = pushes + 1; at = at + 1; continue; }
            break;
        }
        // Stopped inside the prologue, its pushes not all made: the register
        // is still the frame, and given no value yet.
        if (pc < at) { return bp; }
        return sp + size + pushes * WordSize.Bytes;
    }

    /// The caller's frame of `frame`, 0 at the chain's end, or NoFrame when this
    /// frame is not one to read: none, no return address, or a link that does
    /// not run towards the top of the stack -- a frame somebody built by hand,
    /// or rubbish, and following it would read whatever memory it points at.
    /// [frame] is the caller's frame pointer, the word after it the return
    /// address: the chain every prologue here builds.
    public static nuint StepFrame(nuint frame) {
        if (frame == 0) { return NoFrame; }
        nuint next = Sys.ReadAddress(frame);
        if (Sys.ReadAddress(frame + WordSize.Bytes) == 0) { return NoFrame; }
        if (next != 0 && next <= frame) { return NoFrame; }
        // NOR PAST THE TOP OF THIS THREAD'S STACK: a frame in it whose link
        // leaves it is C's, built without a frame pointer, its EBP any value
        // at all. Read on, Windows 98's chain went into memory that was not
        // there, and building a NullReferenceException's trace faulted. A
        // frame not in the stack the thread's block records -- an interrupt's
        // stack, say -- is followed as before.
        nuint block = Sys.ThreadBlock();
        nuint top = block == 0 ? 0 : Sys.ReadAddress(block + Tls.StackBase);
        if (top != 0 && frame < top && next >= top) { return NoFrame; }
        return next;
    }

    /// The frames Frames took, named: one line a frame in .NET's wording, up
    /// to the first address no function this image describes contains.
    public static string TraceOf(nuint[] frames) {
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < frames.Length; i++) {
            string? said = Frame(frames[i] - 1);
            if (said == null) { break; }

            // ONLY METHODS, as .NET lists only managed frames: the entry stub
            // and the runtime's assembly helpers are named without a type.
            if (said.IndexOf('.') >= 0) {
                if (made.Length > 0) { made.Append('\n'); }
                made.Append(said);
            }
        }
        return made.ToString();
    }

    /// THE SAME WALK WITH NO HEAP AT ALL, written straight to a descriptor.
    ///
    /// Trace() answers a string, which is exactly what the failure path of an
    /// allocation may not ask for: the report that matters most is the one
    /// printed when there is no memory to print it with. Every name is already
    /// in the image, one zero-terminated run each, so each is written where it
    /// lies and nothing is built. Line numbers are left off -- a line means
    /// decoding a second program for every frame, and what this report is for
    /// is WHICH FUNCTIONS were on the stack.
    ///
    /// The frame is passed in, for the reason Trace's is.
    public static void SayTrace(int fd, nuint from) {
        nuint frame = from;
        int taken = 0;

        while (frame != 0 && taken < TraceDepth) {
            // [frame] is the caller's frame pointer, the word after it the
            // return address: the chain every prologue here builds.
            nuint next = Sys.ReadAddress(frame);
            nuint ret = Sys.ReadAddress(frame + WordSize.Bytes);
            if (ret == 0) { break; }
            if (next != 0 && next <= frame) { break; }

            nuint name;
            nuint file;
            nuint pool;
            long line;
            nuint offset;

            if (!Lookup(ret, out name, out file, out pool, out line, out offset, false)) { break; }

            SayLiteral(fd, "   at ");
            SayName(fd, pool, name);
            SayLiteral(fd, "\n");

            taken = taken + 1;
            frame = next;
        }
    }

    /// The fault report armed (Platform.ArmFaultReport): called by a static
    /// program's entry stub and by BeginImage, once is enough.
    public static void ArmFaultReport() {
        Platform.ArmFaultReport();
    }

    /// A FAULT NOTHING CAN CATCH, said as .NET says one: its message, the
    /// address the fault was at and the instruction that made it, then the
    /// stack from the faulting function outward. The platform's fault handler
    /// calls it (Platform.ArmFaultReport), with a scratch page of its own
    /// for the digits; nothing here allocates.
    public static void ReportFault(nuint address, nuint pc, nuint frame, nuint digits, nuint registers, int count) {
        SayLiteral(StdErr, "Fatal error. System.AccessViolationException: Attempted to read or write protected memory. This is often an indication that other memory is corrupt.\n");
        SayLiteral(StdErr, "   fault at 0x");
        SayHex(digits, address);
        SayLiteral(StdErr, ", instruction at 0x");
        SayHex(digits, pc);
        SayLiteral(StdErr, "\n");
        // THE REGISTERS as the fault left them, in the kernel's order: the
        // object a bad read went through is nearly always in one of them.
        if (registers != 0) {
            SayLiteral(StdErr, "   registers");
            for (int i = 0; i < count; i++) {
                SayLiteral(StdErr, " ");
                SayHex(digits, Sys.ReadAddress(registers + (nuint)i * WordSize.Bytes));
            }
            SayLiteral(StdErr, "\n");
        }

        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;

        if (Lookup(pc, out name, out file, out pool, out line, out offset, false)) {
            SayLiteral(StdErr, "   at ");
            SayName(StdErr, pool, name);
            SayLiteral(StdErr, "\n");
        }
        SayTrace(StdErr, frame);
        if (CollectorLinked()) Gc.SayState();
        // AND WHETHER THE PROGRAM FREED IT (Corsac.GC.FreeLog): every register
        // and the address itself looked for among the last frees, a block
        // freed at or just below it named with the frees that took it. A
        // fault through an object the program gave back is the compiler's;
        // one through an object nobody freed is the collector's.
        if (FreeLogRing != 0) {
            FreedNear(digits, address);
            if (registers != 0) {
                for (int i = 0; i < count; i++) {
                    FreedNear(digits, Sys.ReadAddress(registers + (nuint)i * WordSize.Bytes));
                }
            }
        }
    }

    /// The frees in the log of a block at or up to a kilobyte below `value`,
    /// newest first, at most four.
    static void FreedNear(nuint digits, nuint value) {
        if (value < 4096) {
            return;
        }
        nuint total = Sys.ReadAddress(FreeLogRing);
        nuint have = total < FreeLogEntries ? total : FreeLogEntries;
        nuint found = 0;
        nuint back = 0;
        while (back < have && found < 4) {
            nuint n = (total - 1 - back) % FreeLogEntries;
            nuint entry = FreeLogRing + (1 + n * 4) * WordSize.Bytes;
            nuint held = Sys.ReadAddress(entry);
            if (held != 0 && value >= held - 16 && value < held + 1024) {
                SayLiteral(StdErr, "   0x");
                SayHex(digits, value);
                SayLiteral(StdErr, " is in a block freed ");
                SayHex(digits, back);
                SayLiteral(StdErr, " frees ago, at 0x");
                SayHex(digits, held);
                nuint owner = Sys.ReadAddress(entry + WordSize.Bytes);
                if (owner != 0) {
                    SayLiteral(StdErr, ", a field of 0x");
                    SayHex(digits, owner);
                }
                SayLiteral(StdErr, "\n");
                SayFrame(StdErr, Sys.ReadAddress(entry + 3 * WordSize.Bytes));
                if (owner == 0) {
                    SayFrame(StdErr, Sys.ReadAddress(entry + 2 * WordSize.Bytes));
                }
                found = found + 1;
            }
            back = back + 1;
        }
    }

    /// A word in hexadecimal, every digit, spelled in `digits` and written.
    static void SayHex(nuint digits, nuint value) {
        const int count = 2 * WordSize.Bytes;
        for (int i = 0; i < count; i++) {
            int nibble = (int)(value >> ((count - 1 - i) * 4)) & 15;
            Sys.Write8(digits + (nuint)i, (byte)(nibble < 10 ? 48 + nibble : 87 + nibble));
        }
        Platform.WriteBytes(StdErr, digits, count);
    }

    /// The function an address lies in, on a line of its own, allocating
    /// nothing: the collector's checked mode names a free site with it.
    public static void SayFrame(int fd, nuint address) {
        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;

        SayLiteral(fd, "   at ");
        if (Lookup(address, out name, out file, out pool, out line, out offset, false)) {
            SayName(fd, pool, name);
        } else {
            SayLiteral(fd, "?");
        }
        SayLiteral(fd, "\n");
    }

    /// The function at `address` on its own line, as a trace writes it, with
    /// nothing made; false, and nothing written, where no function this image
    /// describes holds it -- where a trace ends (Exception.SayTrace$).
    public static bool SayMethod(int fd, nuint address) {
        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;

        if (!Lookup(address, out name, out file, out pool, out line, out offset, false)) { return false; }
        SayLiteral(fd, "   at ");
        SayName(fd, pool, name);
        SayLiteral(fd, "\n");
        return true;
    }

    /// `prefix`, the function at `address`, its file and its line, and a
    /// newline, on standard error -- with no heap at all (AllocSamples.Dump).
    public static void SayWhere(string prefix, nuint address) {
        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;

        if (!Lookup(address, out name, out file, out pool, out line, out offset, true)) { return; }
        SayLiteral(StdErr, prefix);
        SayName(StdErr, pool, name);
        if (Sys.Read8(file) != 0) {
            SayLiteral(StdErr, " in ");
            SayName(StdErr, pool, file);
        }
        Gc.SayNumber(":line ", line);
    }

    /// A string the compiler laid out in the image, which is data and not an
    /// object this heap made: printing it allocates nothing.
    static void SayLiteral(int fd, string text) {
        WriteLiteral(fd, text);
    }

    /// A name or file a lookup found, written where it lies: a zero-terminated
    /// string when `pool` is 0, else a name of that pool, token by token.
    static void SayName(int fd, nuint pool, nuint at) {
        if (pool == 0) {
            SayText(fd, at);
            return;
        }
        nuint count = Uleb(at, out at);
        for (nuint i = 0; i < count; i++) {
            nuint token = Uleb(at, out at);
            nuint from = TokenStart(pool, token);
            Platform.WriteBytes(fd, from, TokenEnd(pool, token) - from);
        }
    }

    /// Whether the name a lookup found begins with `prefix`, read where it
    /// lies in either of SayName's forms, with nothing made.
    static bool NameStarts(nuint pool, nuint at, string prefix) {
        int k = 0;
        if (pool == 0) {
            while (k < prefix.Length) {
                if (Sys.Read8(at + (nuint)k) != prefix[k]) { return false; }
                k = k + 1;
            }
            return true;
        }
        nuint count = Uleb(at, out at);
        for (nuint i = 0; i < count && k < prefix.Length; i++) {
            nuint token = Uleb(at, out at);
            nuint end = TokenEnd(pool, token);
            for (nuint p = TokenStart(pool, token); p < end && k < prefix.Length; p++) {
                if (Sys.Read8(p) != prefix[k]) { return false; }
                k = k + 1;
            }
        }
        return k == prefix.Length;
    }

    /// THE RUNTIME'S OWN CODE at a return address: a method of Gc or of
    /// Runtime, the allocator and every way into it, which the heap's
    /// out-of-memory trace begins past (Exception.Refill$) as .NET's begins at
    /// the method whose allocation failed. Read from the frame table with
    /// nothing made.
    public static bool InRuntime(nuint address) {
        nuint name;
        nuint file;
        nuint pool;
        long line;
        nuint offset;
        if (!Lookup(address - 1, out name, out file, out pool, out line, out offset, false)) { return false; }
        return NameStarts(pool, name, "Gc.") || NameStarts(pool, name, "Runtime.");
    }

    /// A zero-terminated run of bytes in the image, written where it lies.
    static void SayText(int fd, nuint at) {
        nuint length = 0;
        while (Sys.Read8(at + length) != 0) { length = length + 1; }
        Platform.WriteBytes(fd, at, length);
    }

    /// WHERE A THROW HAPPENED, recorded into the exception as it is thrown --
    /// which is when the stack still says, and is what .NET does too.
    ///
    /// The compiler emits the call, and passes the throwing function's own
    /// frame pointer and source site, as bytes (Lowering.InternNameBytes).
    /// The frame chain begins with its callers; the explicit site preserves
    /// the leaf even when Capture is inlined.
    public static void Capture(object thrown, nuint frame, byte[] site) {
        // The iterator stop signal has no reader to show a trace to.
        if (thrown is IteratorStopSignal) { return; }
        // Tested and bound at once: a cast after the test was a failure path
        // never taken, an InvalidCastException and its message made on it,
        // which a program's walk for allocations still reached.
        // A TRACE PLACED BEFORE THE THROW is kept, and no frames are taken:
        // the heap's throw out of memory (Gc.ThrowOutOfMemory) has no memory
        // to take them with, and Frames would ask the heap that ran out.
        if (thrown is Exception e) {
            if (e.Keeps$()) { return; }
            e.ThrownAt$(site, Frames(frame));
        }
    }

    // ---- failure -------------------------------------------------------------

    /// What the heap held when it last ran out, said on standard error with
    /// nothing made (Gc.SayOutOfMemory): set by the heap as it throws, so an
    /// image with no collector names none of it.
    public static nuint OutOfMemoryReport;

    /// A throw with nothing to catch it. The message goes to standard error and
    /// the process ends with 134, which is what a C program that abort()s
    /// exits with, so a shell script sees the same thing it would from C.
    public static void Unhandled(object exception)
    {
        // Do not recursively retry an output buffer which caused the failure.
        _atExit = 0;

        // OUT OF MEMORY IS SAID AS .NET SAYS IT, "Out of memory.", and with
        // nothing made: the memory to build a message may be what ran out.
        // Then what .NET leaves out and a heap that ran out can still say:
        // where the exception was thrown, its frames written where their
        // names lie (Exception.SayTrace$), and what the heap held, through
        // the hook the heap set as it threw (Gc.ThrowOutOfMemory).
        if (exception is OutOfMemoryException) {
            SayLiteral(StdErr, "Out of memory.\n");
            ((Exception)exception).SayTrace$(StdErr);
            if (OutOfMemoryReport != 0) { Sys.Call(OutOfMemoryReport, 0, 0, 0); }
            Platform.Exit(134);
        }
        WriteText(StdErr, "Unhandled exception. ");

        // An Exception prints as its type name and its message, written
        // piece by piece: building `type + ": " + message` would drag
        // String.Concat and Exception.ToString into every program for the
        // one line that ends a broken one. Anything else that was thrown
        // prints through its ToString, since that is all it has.
        if (exception is Exception)
        {
            Exception e = (Exception)exception;
            string name = e.GetType().Name;
            string message = e.Message;
            WriteText(StdErr, name);
            WriteText(StdErr, ": ");
            WriteText(StdErr, message);
        }
        else
        {
            string text = "" + exception;
            WriteText(StdErr, text);
        }
        WriteText(StdErr, "\n");

        // AND WHERE IT CAME FROM, as it was at the throw. Walking now would
        // very nearly do -- nothing unwinds before this is called -- but the
        // recorded one is what an exception that was caught and rethrown
        // remembers, and it is the same text either way.
        string trace = "";
        if (exception is Exception) { trace = ((Exception)exception).StackTrace; }
        if (trace.Length == 0) { trace = Trace(Sys.FramePointer()); }
        WriteText(StdErr, trace);
        // Ended as a line, as .NET's report is (its trace has no newline of
        // its own): a kernel's console glued what came next onto it.
        if (trace.Length > 0 && trace[trace.Length - 1] != '\n') WriteText(StdErr, "\n");
        // At once: an unhandled exception ends the process whatever threads
        // it has, as .NET's does.
        Platform.Exit(134);
    }

    // The checks the compiler emits. Each THROWS so user code can catch it;
    // the compiler follows the call with a trap in case the throw returns,
    // which it never does.

    public static void IndexOutOfRange()
    {
        throw new IndexOutOfRangeException("Index was outside the bounds of the array.");
    }

    // ---- an array seen as one of its interfaces (Lowering.ArrayFaces) -----
    //
    // What SZArrayHelper says for an array that is an IList<T>: its size is
    // fixed, an index past it is an argument out of range, and the walker it
    // hands out reads nothing before MoveNext or after the end.

    /// Add, Insert, Remove and RemoveAt on an array.
    public static void ArrayFixedSize()
    {
        throw new NotSupportedException("Collection was of a fixed size.");
    }

    /// Clear on an array.
    public static void ArrayReadOnly()
    {
        throw new NotSupportedException("Collection is read-only.");
    }

    /// The indexer of an array seen as an IList<T> or IReadOnlyList<T>.
    public static void ArrayFaceIndex()
    {
        throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection.");
    }

    /// CopyTo's refusals, Array.Copy's own: no destination (its length -1),
    /// a negative index, or too little room from it for `length` elements.
    public static void ArrayCopyToCheck(int destinationLength, int index, int length)
    {
        if (destinationLength < 0) throw new ArgumentNullException("destinationArray");
        ArgumentOutOfRangeException.ThrowIfLessThan(index, 0, "destinationIndex");
        if ((uint)(index + length) > (uint)destinationLength)
        {
            throw new ArgumentException("Destination array was not long enough. Check the destination index, length, and the array's lower bounds.", "destinationArray");
        }
    }

    /// The walker's Current read where it stands on no element: before the
    /// first MoveNext (-1) or after the last.
    public static void ArrayWalkerOff(int at)
    {
        if (at < 0) throw new InvalidOperationException("Enumeration has not started. Call MoveNext.");
        throw new InvalidOperationException("Enumeration already finished.");
    }

    /// A Nullable's Value read when it has none.
    public static void NoValue()
    {
        throw new InvalidOperationException("Nullable object must have a value.");
    }

    /// A boxed number, an enum or a string compared through IComparable with
    /// something of another type: .NET's CompareTo(object) refuses it so,
    /// in the message the compiler wrote for the type.
    public static void CompareToRefused(string message)
    {
        throw new ArgumentException(message);
    }

    /// An enum compared through IComparable with something not of its type:
    /// Enum.CompareTo(object) names both types, the other's read off it.
    public static void EnumCompareRefused(object other, string enumType)
    {
        throw new ArgumentException("Object must be the same type as the enum. The type passed in was '"
            + String.TypeText(other.GetType().FullName) + "'; the enum type was '" + enumType + "'.");
    }

    /// A boxed tuple compared with a box of another type: ValueTuple's
    /// CompareTo(object) refuses it so, naming its own type as Type.ToString
    /// writes it -- System.ValueTuple`2[System.Int32,System.String].
    public static void ArgumentFailure(string tuple)
    {
        throw new ArgumentException("Argument must be of type " + tuple + ".", "other");
    }

    // ---- array covariance ------------------------------------------------
    //
    // A Dog[] may be held as an Animal[] -- C# allows it -- and then a Cat
    // stored into it is refused at run time. An array's descriptor names its
    // element's (word DescElementWord); a store the compiler cannot prove
    // safe, into an array whose type is not exactly the one written, comes
    // here (Lowering, StoreCheck).

    const int DescWordsHere = 12;
    const int DescDepthWord = 2;
    const int DescDisplayWord = 3;
    const int DescInterfacesWord = 4;
    const int DescFlagsWordHere = 6;
    const int DescElementWord = 10;

    // DescFlags of a type (Lowering): a string's, a box's, and an
    // interface's boxed face (Lowering.BoxedFaceFlags); an interface an array
    // or its walker is, an array of references, a walker (Lowering.ArrayFaces).
    const int ArrayFaceFlag = 2048;
    const int WalkerFaceFlag = 0x100000;
    const int ArrayWalkerFlag = 0x200000;
    const int ReferenceElementsFlag = 0x400000;
    const int TypeStringFlag = 2;
    const int TypeEnumFlag = 8;
    const int TypePrimitiveFlag = 32;
    const int FaceComparableFlag = 64;
    const int FaceFormattableFlag = 128;
    const int FaceOfFlag = 256;

    /// THE INTEGER KIND A BOX HOLDS, from its descriptor's flags
    /// (Lowering.BoxKind): an enum's underlying integer or the primitive
    /// itself, 1 sbyte to 8 ulong, 9 and 10 the native integers.
    public static int BoxKind(object value)
    {
        const int w = WordSize.Bytes;
        nuint desc = (Sys.ReadAddress(Sys.ObjectAddress(value))) - DescWordsHere * w;
        return (int)((Sys.ReadAddress(desc + DescFlagsWordHere * w) >> 12) & 0xFF);
    }

    /// The store of `value` into `array`: refused with ArrayTypeMismatchException
    /// unless the value is of the array's element type or derives from it.
    public static void ArrayStoreCheck(nuint array, nuint value)
    {
        if (array == 0 || value == 0)
        {
            return;
        }
        const int w = WordSize.Bytes;
        nuint desc = (Sys.ReadAddress(array)) - DescWordsHere * w;
        nuint element = Sys.ReadAddress(desc + DescElementWord * w);
        if (element == 0)
        {
            return;
        }
        // A VALUE WHOSE TYPE WORD IS 0 is a block freed and cleared under a
        // live reference: said with what the collector's free journal knows
        // of it (gc.freejournal), and refused as a mismatch rather than read
        // through a description at address 0.
        nuint vtable = Sys.ReadAddress(value);
        if (vtable == 0 || !DescribedAs(vtable - DescWordsHere * w, element))
        {
            ArrayStoreRefused(array, value);
        }
    }

    /// The refusal, out of line and never inlined: what the free journal knows
    /// of the value and the array, said, then the exception. THE CHECK IS
    /// INLINED AT EVERY REFERENCE STORE INTO A SHARED ARRAY, and the analyses
    /// know both routines by name to keep nothing and write no field
    /// (Escape.KeepsNothing); with the report spliced into the check, every
    /// value stored and every array stored into escaped through the report's
    /// raw writes, and an iterator's sets went back to the collector (1080).
    ///
    /// THE REPORT THROUGH A HOOK the journal sets as it is turned on
    /// (Gc.FreeJournalOn): called by name, it was a call into the collector
    /// from every image that stores a reference into a shared array -- one
    /// made without a collector included, which kept the collector's
    /// reporting routines, where nothing could ever turn the journal on.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void ArrayStoreRefused(nuint array, nuint value)
    {
        if (ArrayStoreReport != 0) Sys.Call(ArrayStoreReport, value, array, 0);
        throw new ArrayTypeMismatchException();
    }

    /// What says a refused store's value and array as the free journal knows
    /// them (Gc.SayRefusedStore), once the journal is on; 0 until then.
    public static nuint ArrayStoreReport;

    /// The copy of `value` into `array` by CopyTo (Lowering.ArrayFaces):
    /// refused as Array.Copy refuses an element the destination's cannot
    /// hold, with InvalidCastException naming both types, where a store
    /// would be ArrayTypeMismatchException.
    public static void ArrayCopyCheck(nuint array, nuint value)
    {
        if (array == 0 || value == 0)
        {
            return;
        }
        const int w = WordSize.Bytes;
        nuint desc = (Sys.ReadAddress(array)) - DescWordsHere * w;
        nuint element = Sys.ReadAddress(desc + DescElementWord * w);
        if (element == 0)
        {
            return;
        }
        nuint vtable = Sys.ReadAddress(value);
        if (vtable == 0 || !DescribedAs(vtable - DescWordsHere * w, element))
        {
            ArrayCopyRefused(value, element);
        }
    }

    /// The refusal, out of line as ArrayStoreRefused is: the element's type
    /// named by its descriptor.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void ArrayCopyRefused(nuint value, nuint element)
    {
        object o = Sys.ObjectAt(value)!;
        // The descriptor's name word, as the image keeps it (String.TypeFullName).
        object? word = Sys.ObjectAt(Sys.ReadAddress(element));
        string named = word == null ? "" : String.TypeFullName(word);
        InvalidCastTo(o, String.TypeText(named));
    }

    /// Whether an object is an array whose elements are of `element` or
    /// derive from it: `animals is Animal[]` for a Dog[] (ArrayTest).
    public static bool ArrayOf(nuint array, nuint element)
    {
        if (array == 0)
        {
            return false;
        }
        const int w = WordSize.Bytes;
        nuint desc = (Sys.ReadAddress(array)) - DescWordsHere * w;
        if ((Sys.ReadAddress(desc + DescFlagsWordHere * w) & 3) != 1)
        {
            return false;
        }
        nuint had = Sys.ReadAddress(desc + DescElementWord * w);
        return had != 0 && DescribedAs(had, element);
    }

    /// Whether the type a descriptor describes is `want`'s, derives from it,
    /// or implements it -- the tests Lowering.TypeTest makes inline, taken
    /// with both types known only at run time -- and, for two arrays, whether
    /// the one's elements are the other's, as covariance has it.
    public static bool DescribedAs(nuint desc, nuint want)
    {
        if (desc == want)
        {
            return true;
        }
        const int w = WordSize.Bytes;
        // A class's depth is its place in its chain; an interface's and an
        // array's is -1.
        // A class's depth in its chain; an interface's is negative.
        int wantDepth = (int)Sys.ReadAddress(want + DescDepthWord * w);
        if (wantDepth >= 0)
        {
            int depth = (int)Sys.ReadAddress(desc + DescDepthWord * w);
            if (depth < wantDepth)
            {
                return false;
            }
            nuint display = Sys.ReadAddress(desc + DescDisplayWord * w);
            return display != 0 && (Sys.ReadAddress(display + (nuint)wantDepth * w)) == want;
        }
        nuint faces = Sys.ReadAddress(desc + DescInterfacesWord * w);
        if (faces != 0)
        {
            for (nuint at = faces; ; at = at + w)
            {
                nuint face = Sys.ReadAddress(at);
                if (face == 0) break;
                if (face == want) return true;
            }
        }
        // A BOX OR A STRING IS ITS SYSTEM INTERFACES (BoxedFaces), which its
        // table names none of, so that every unit's copy of it is one table:
        // the interface's own descriptor says which face it is.
        nuint wantFlags = Sys.ReadAddress(want + DescFlagsWordHere * w);
        // AN ARRAY IS ITS SEQUENCE INTERFACES, AND ITS WALKER IEnumerator<T>
        // (Lowering.ArrayFaces), named in no table of theirs for the same
        // reason: an IList<U> -- its word 10 the descriptor of U[] -- of an
        // array that is a U[], covariance included; IEnumerable of any array.
        if ((wantFlags & (ArrayFaceFlag | WalkerFaceFlag)) != 0)
        {
            nuint descFlags = Sys.ReadAddress(desc + DescFlagsWordHere * w);
            nuint elements = Sys.ReadAddress(want + DescElementWord * w);
            if ((wantFlags & ArrayFaceFlag) != 0 && (descFlags & 3) == 1)
            {
                return elements == 0 || DescribedAs(desc, elements);
            }
            if ((wantFlags & WalkerFaceFlag) != 0 && (descFlags & ArrayWalkerFlag) != 0)
            {
                nuint walked = Sys.ReadAddress(desc + DescElementWord * w);
                return elements == 0 || walked != 0 && DescribedAs(walked, elements);
            }
        }
        if ((wantFlags & (FaceComparableFlag | FaceFormattableFlag | FaceOfFlag)) != 0 && BoxedFace(desc, want, wantFlags))
        {
            return true;
        }
        // A VARIANT INTERFACE OR DELEGATE: one of the same template whose
        // arguments vary as the template declares (VariantFits) -- the
        // type itself, when it is an interface, or any it implements.
        if (VarianceOf(want) != 0)
        {
            if (VariantFits(desc, want)) return true;
            if (faces != 0)
            {
                for (nuint at = faces; ; at = at + w)
                {
                    nuint face = Sys.ReadAddress(at);
                    if (face == 0) break;
                    if (VariantFits(face, want)) return true;
                }
            }
        }
        // Two arrays of references: covariance, element by element. Every
        // array of references is an object[], whose element is named by none.
        if ((Sys.ReadAddress(desc + DescFlagsWordHere * w) & 3) == 1 && (wantFlags & 3) == 1)
        {
            nuint had = Sys.ReadAddress(desc + DescElementWord * w);
            nuint wanted = Sys.ReadAddress(want + DescElementWord * w);
            if (wanted == 0)
            {
                return (wantFlags & ReferenceElementsFlag) != 0 && (Sys.ReadAddress(desc + DescFlagsWordHere * w) & ReferenceElementsFlag) != 0;
            }
            return had != 0 && DescribedAs(had, wanted);
        }
        return false;
    }

    /// Whether a box's or a string's descriptor answers an interface of a
    /// boxed face (Lowering.BoxedFaceFlags), as BoxedFaces.Implements does:
    /// IComparable a number, a bool, a char, an enum or a string;
    /// IFormattable a number or an enum, not a bool (the box the
    /// interface's word 10 names); IComparable<X> and IEquatable<X> only X's
    /// own, the descriptor its word 10 names.
    static bool BoxedFace(nuint desc, nuint want, nuint wantFlags)
    {
        const int w = WordSize.Bytes;
        nuint flags = Sys.ReadAddress(desc + DescFlagsWordHere * w);
        nuint named = Sys.ReadAddress(want + DescElementWord * w);
        if ((wantFlags & FaceOfFlag) != 0)
        {
            return named != 0 && named == desc && FaceOverItself(desc);
        }
        if ((wantFlags & FaceComparableFlag) != 0)
        {
            return (flags & (TypePrimitiveFlag | TypeEnumFlag)) != 0 || (flags & 3) == (1 | TypeStringFlag);
        }
        if ((wantFlags & FaceFormattableFlag) != 0)
        {
            return (flags & TypeEnumFlag) != 0 || (flags & TypePrimitiveFlag) != 0 && desc != named;
        }
        return false;
    }

    /// Whether a descriptor is one that is IComparable<X> and IEquatable<X>
    /// over itself without its table naming them (BoxedFaces): the string's,
    /// or the box of a number, a bool or a char -- not an enum's box, nor a
    /// class's. Every route asks it alike: an interface's word 10 for
    /// DescribedAs (BoxedFace), X's own descriptor for a shared copy's
    /// ShapedAs, and the box itself for the test Lowering makes inline
    /// (BoxedFaceTest).
    static bool FaceOverItself(nuint desc)
    {
        nuint flags = Sys.ReadAddress(desc + DescFlagsWordHere * WordSize.Bytes);
        return (flags & 3) == (1 | TypeStringFlag) || (flags & TypePrimitiveFlag) != 0;
    }

    // An interface's identity record (Lowering.ShapeRecord), named by its
    // descriptor's word 8: its family, its argument count, its arguments'
    // descriptors.
    const int DescShapeWord = 8;
    const int ShapeCountMask = 255;
    const int ShapeFaceOf = 256;
    // A class, not an interface (Lowering.ShapeTest), its depth above ShapeDepthShift.
    const int ShapeClass = 512;
    // A sequence interface an array is, or the IEnumerator<T> its walker is (Lowering.ShapeTest).
    const int ShapeArrayFace = 1024;
    const int ShapeWalkerFace = 2048;
    // Which of an interface's arguments the caller found to be object, one bit each from here (Lowering.ShapeTest).
    const int ShapeObjectShift = 24;
    const int ShapeDepthShift = 16;
    const int TypeValueFlag = 4;

    /// Whether an interface of `record`'s identity and `variance`'s declared
    /// variance converts to the one of its family over these arguments'
    /// descriptors, as VariantFits says of two named ones: each argument the
    /// same, or a reference type converting the way the template declares.
    static bool ShapeVariantFits(nuint record, nuint variance, nuint count, nuint shape, nuint a0, nuint a1, nuint a2, nuint a3)
    {
        const int w = WordSize.Bytes;
        for (nuint i = 0; i < count; i++)
        {
            nuint theirs = i == 0 ? a0 : i == 1 ? a1 : i == 2 ? a2 : a3;
            nuint mine = Sys.ReadAddress(record + (2 + i) * w);
            if (mine == theirs) continue;
            nuint kind = Sys.ReadAddress(variance + (2 + 2 * i) * w);
            if ((kind & 4) == 0 || mine == 0 || theirs == 0) return false;
            if ((Sys.ReadAddress(theirs + DescFlagsWordHere * w) & (TypeValueFlag | TypePrimitiveFlag | TypeEnumFlag)) != 0) return false;
            // Object, either side: the caller says of its arguments (ShapeObjectShift),
            // the variance record of the interface's (1).
            bool theirsObject = ((shape >> (ShapeObjectShift + (int)i)) & 1) != 0;
            bool mineObject = (Sys.ReadAddress(variance + (3 + 2 * i) * w)) == 1;
            nuint how = kind & 3;
            if (how == 1)
            {
                if (!theirsObject && (mineObject || !DescribedAs(mine, theirs))) return false;
            }
            else if (how == 2)
            {
                if (!mineObject && (theirsObject || !DescribedAs(theirs, mine))) return false;
            }
            else
            {
                return false;
            }
        }
        return true;
    }

    /// Whether an identity record (Lowering.ShapeRecord) is the type of
    /// `family` over these `count` arguments' descriptors.
    static bool ShapeRecordIs(nuint record, nuint family, nuint count, nuint a0, nuint a1, nuint a2, nuint a3)
    {
        const int w = WordSize.Bytes;
        return (Sys.ReadAddress(record)) == (family)
            && (Sys.ReadAddress(record + w)) == count
            && (Sys.ReadAddress(record + 2 * w)) == (a0)
            && (count < 2 || (Sys.ReadAddress(record + 3 * w)) == (a1))
            && (count < 3 || (Sys.ReadAddress(record + 4 * w)) == (a2))
            && (count < 4 || (Sys.ReadAddress(record + 5 * w)) == (a3));
    }

    /// Whether an object implements the generic interface of `family`
    /// (CanonShape.FamilyOf) over these type arguments' descriptors -- the
    /// test a shared method copy makes of `x is IList<U>` when only the call
    /// knew what U is (Lowering.ShapeTest). `shape` is the argument count,
    /// with ShapeFaceOf for IComparable<X> and IEquatable<X>, which a string
    /// and a box of a number, a bool or a char implement over themselves
    /// without their tables naming them (BoxedFace).
    /// False when any argument is 0, which no caller could say: the copy's
    /// own test answers then.
    public static bool ShapedAs(nuint obj, nuint family, nuint shape, nuint a0, nuint a1, nuint a2, nuint a3)
    {
        if (obj == 0)
        {
            return false;
        }
        nuint count = shape & ShapeCountMask;
        if (count < 1 || count > 4 || a0 == 0 || count > 1 && a1 == 0 || count > 2 && a2 == 0 || count > 3 && a3 == 0)
        {
            return false;
        }
        const int w = WordSize.Bytes;
        nuint desc = (Sys.ReadAddress(obj)) - DescWordsHere * w;
        // A GENERIC CLASS (ShapeClass), at its depth in every chain it is in
        // (shape's high bits): the ancestor at that depth is the class of that
        // family over these arguments, by the identity record its type
        // context holds there (Lowering.TypeContext). Classes vary in nothing.
        if ((shape & ShapeClass) != 0)
        {
            nuint depth = shape >> ShapeDepthShift;
            if ((Sys.ReadAddress(desc + DescFlagsWordHere * w) & (1 | TypeStringFlag | TypeValueFlag | InterfaceFlag)) != 0) return false;
            int had = (int)Sys.ReadAddress(desc + DescDepthWord * w);
            if (had < 0 || (nuint)had < depth) return false;
            nuint context = Sys.ReadAddress(desc + DescElementWord * w);
            if (context == 0) return false;
            nuint table = Sys.ReadAddress(context + depth * w);
            if (table == 0) return false;
            nuint entries = Sys.ReadAddress(table);
            nuint identity = Sys.ReadAddress(table + (1 + entries) * w);
            return identity != 0 && ShapeRecordIs(identity, family, count, a0, a1, a2, a3);
        }
        // AN ARRAY, OR ITS WALKER, ASKED ONE OF ITS INTERFACES (ShapeArrayFace,
        // ShapeWalkerFace; Lowering.ArrayFaces): its elements are U's, or
        // derive from it, or U is object and they are references.
        nuint descFlags = Sys.ReadAddress(desc + DescFlagsWordHere * w);
        nuint arrayAsked = (shape & ShapeArrayFace) != 0 && (descFlags & 3) == 1 ? desc
            : (shape & ShapeWalkerFace) != 0 && (descFlags & ArrayWalkerFlag) != 0 ? Sys.ReadAddress(desc + DescElementWord * w) : 0;
        if (arrayAsked != 0)
        {
            if (((shape >> ShapeObjectShift) & 1) != 0)
            {
                return (Sys.ReadAddress(arrayAsked + DescFlagsWordHere * w) & ReferenceElementsFlag) != 0;
            }
            nuint element = Sys.ReadAddress(arrayAsked + DescElementWord * w);
            return element != 0 && DescribedAs(element, a0);
        }
        nuint faces = Sys.ReadAddress(desc + DescInterfacesWord * w);
        if (faces != 0)
        {
            for (nuint at = faces; ; at = at + w)
            {
                nuint face = Sys.ReadAddress(at);
                if (face == 0) break;
                nuint record = Sys.ReadAddress(face + DescShapeWord * w);
                if (record != 0 && ShapeRecordIs(record, family, count, a0, a1, a2, a3))
                {
                    return true;
                }
                // AND BY VARIANCE, as DescribedAs answers a named interface
                // (VariantFits): a List<string> is an IEnumerable<object>
                // where the copy's U is object.
                if (record != 0 && (Sys.ReadAddress(record)) == (family) && (Sys.ReadAddress(record + w)) == count)
                {
                    nuint variance = VarianceOf(face);
                    if (variance != 0 && ShapeVariantFits(record, variance, count, shape, a0, a1, a2, a3)) return true;
                }
            }
        }
        // A string is IComparable<string> and IEquatable<string>, a boxed int
        // IComparable<int> and IEquatable<int>, which their tables do not list
        // (BoxedFaces): X's descriptor is the object's own, as an interface's
        // word 10 names it for DescribedAs. Only the string answered here,
        // and a box asked of its own number from a shared copy said no.
        if ((shape & ShapeFaceOf) != 0 && count == 1 && (a0) == desc && FaceOverItself(desc))
        {
            return true;
        }
        return false;
    }

    /// THE DECLARED VARIANCE OF A CONSTRUCTED INTERFACE OR DELEGATE TYPE,
    /// which its descriptor carries (Lowering.VarianceRecord) when its
    /// template declares any `in` or `out`: word 11 of an interface's
    /// descriptor, nothing for any other kind. The record is the template's
    /// identity, the count of arguments, and for each argument its variance
    /// (1 out, 2 in) with 4 added for a reference type, and the argument's
    /// descriptor -- 1 standing for object.
    const int DescRecordWord = 11;
    const int InterfaceFlag = 16;

    static nuint VarianceOf(nuint desc)
    {
        const int w = WordSize.Bytes;
        if ((Sys.ReadAddress(desc + DescFlagsWordHere * w) & InterfaceFlag) == 0) return 0;
        return Sys.ReadAddress(desc + DescRecordWord * w);
    }

    /// Whether the interface `face` converts to `want` by variance, as C#
    /// says (18.2.3.3): the same template, each argument the same type or,
    /// where the template declares it `out`, a reference type converting to
    /// the wanted one, and where `in`, one the wanted converts to. An
    /// IEnumerable<string> is an IEnumerable<object>, a Func<string> a
    /// Func<object>, an Action<object> an Action<string>; a Func<int> is no
    /// Func<object>, a value type being no reference.
    static bool VariantFits(nuint face, nuint want)
    {
        nuint had = VarianceOf(face);
        nuint wanted = VarianceOf(want);
        if (had == 0 || wanted == 0) return false;
        const int w = WordSize.Bytes;
        if ((Sys.ReadAddress(had)) != (Sys.ReadAddress(wanted))) return false;
        nuint count = Sys.ReadAddress(had + w);
        if (count != Sys.ReadAddress(wanted + w)) return false;
        for (nuint i = 0; i < count; i++)
        {
            nuint at = (2 + 2 * i) * w;
            nuint kind = Sys.ReadAddress(wanted + at);
            nuint mine = Sys.ReadAddress(had + at + w);
            nuint theirs = Sys.ReadAddress(wanted + at + w);
            if (mine == theirs) continue;
            if ((kind & 4) == 0 || (Sys.ReadAddress(had + at) & 4) == 0) return false;
            nuint how = kind & 3;
            if (how == 1)
            {
                if (theirs != 1 && (mine == 1 || !DescribedAs(mine, theirs))) return false;
            }
            else if (how == 2)
            {
                if (mine != 1 && (theirs == 1 || !DescribedAs(theirs, mine))) return false;
            }
            else
            {
                return false;
            }
        }
        return true;
    }

    // ---- iterators (Lowering.Iterator) -----------------------------------

    /// An iterator's Reset, which C# iterators do not support.
    public static void IteratorReset()
    {
        throw new NotSupportedException("Specified method is not supported.");
    }

    /// The signal Dispose resumes a suspended iterator with: thrown at the
    /// yield it stopped at, it runs the finally blocks around it and is
    /// caught by MoveNext itself (IteratorStopping).
    /// ONE SIGNAL, made once and thrown each time: an iterator stopped early
    /// is routine -- every Any, All and First over a lazy sequence disposes
    /// one mid-way -- and a fresh exception each time, with the trace Capture
    /// walks for it, made that the most expensive thing the compiler did.
    /// Nothing ever sees it but the finally blocks it runs and MoveNext's
    /// own handler: C# allows no catch around a yield.
    public static void IteratorStop()
    {
        throw IteratorStopSignal.One;
    }

    /// THE STRUCTS A MEMBERWISE COPY STILL SHARES, given blocks of its own
    /// (Lowering.EmitMemberwiseClone, for a type whose descriptor has
    /// Gc.ValueBlocksFlag): a struct a field holds by pointer is a value, and
    /// the copy takes its own as an assignment of the struct would. The list
    /// is after the reference map: how many, then each field's offset, the
    /// struct's size, and the function that copies one holding structs of its
    /// own (0 where its bytes are all of it). The copy is the caller's to
    /// mark: the runtime's own stores mark no card.
    public static void CopyValueBlocks(object made)
    {
        nuint at = Sys.ObjectAddress(made);
        const int w = WordSize.Bytes;
        nuint desc = Sys.ReadAddress(at) - Gc.DescWords * w;
        nuint map = Sys.ReadAddress(desc + Gc.DescRefMapWord * w);
        nuint list = map + (1 + (Sys.ReadAddress(map) + 31) / 32) * w;
        nuint count = Sys.ReadAddress(list);
        for (nuint k = 0; k < count; k++)
        {
            nuint entry = list + (1 + 3 * k) * w;
            nuint field = at + Sys.ReadAddress(entry);
            nuint shared = Sys.ReadAddress(field);
            if (shared == 0) continue;
            nuint copier = Sys.ReadAddress(entry + 2 * w);
            nuint own;
            if (copier != 0)
            {
                own = Sys.Call(copier, shared, 0, 0);
            }
            else
            {
                nuint size = Sys.ReadAddress(entry + w);
                own = Alloc(size);
                Sys.MemoryCopy(own, shared, size);
            }
            Sys.WriteAddress(field, own);
        }
    }

    public static bool IteratorStopping(object thrown)
    {
        return thrown is IteratorStopSignal;
    }

    public static void DivideByZero()
    {
        throw new DivideByZeroException();
    }

    public static void Overflow()
    {
        throw new OverflowException("Arithmetic operation resulted in an overflow.");
    }

    /// `new T[count]` with a count no array can have: negative, which .NET
    /// answers with OverflowException, or more bytes than any allocation can
    /// be, OutOfMemoryException -- where the size wrapped and a tiny block
    /// was given a length every index passed.
    public static void ArraySize(int count)
    {
        if (count < 0) throw new OverflowException("Arithmetic operation resulted in an overflow.");
        throw new OutOfMemoryException("Array dimensions exceeded supported range.");
    }

    /// A cast that failed, worded as .NET words it: the object's type as
    /// Type.ToString writes it, and the type the cast wanted, written by the
    /// compiler at the cast.
    public static void InvalidCastTo(object o, string wanted)
    {
        throw new InvalidCastException(o.GetType(), wanted);
    }

    /// A FAILED CAST FROM THE OBJECT'S TYPE ALONE, read where the cast failed
    /// (Lowering.CastFailed): .NET's message names that type and nothing else
    /// of the object, and a loop region's way out leaves the region -- zeroing
    /// what the lap made, the object among it -- after that read and before
    /// this call (RegionPointsTo.OpenLoops).
    /// A TYPE CONVERTED TO OBJECT: its one RuntimeType (Lowering.Convert).
    public static object? TypeObject(Type? type) => RuntimeType.Of(type);

    /// AN OBJECT CAST TO TYPE: the type a RuntimeType is, null for null, and
    /// .NET's InvalidCastException for anything else.
    public static Type? TypeOfObject(object? value)
    {
        if (value == null) return null;
        if (value is RuntimeType type) return type.Handle;
        throw new InvalidCastException(value.GetType(), "System.Type");
    }

    public static void InvalidCastOfType(Type type, string wanted)
    {
        throw new InvalidCastException(type, wanted);
    }

    /// A FAILED CAST TO A TYPE ONLY RUN TIME KNOWS -- a shared copy's T --
    /// both read off their descriptors (Lowering.CastFailedTo), the wanted
    /// one named as Type.ToString writes it, as the compiler writes a type
    /// it knows.
    public static void InvalidCastToType(Type type, Type wanted)
    {
        throw new InvalidCastException(type, String.TypeText(wanted.FullName));
    }

    /// A NULL DEREFERENCE, thrown as .NET throws it. The fault handler
    /// (Platform.Fault) makes the faulting thread call this as if from the
    /// instruction that read or wrote the null page, with the frame it was in
    /// and that instruction, so the trace begins where the program was.
    public static void NullFault(nuint frame, nuint pc)
    {
        NullReferenceException e = new NullReferenceException();
        string? site = Frame(pc);
        e.Placed$(site ?? "", Frames(frame));
        throw e;
    }

    /// Whether a fault at `address` may be a NullReferenceException: on the
    /// null page and below it -- the first 64 KB, which Linux never maps
    /// (vm.mmap_min_addr), so that a field or an element at an offset from a
    /// null reference lands there too -- on a thread of this program that is
    /// not holding the heap or collecting. A fault anywhere else, or inside
    /// the collector, is no program's to catch and stays fatal.
    public static bool NullFaultCatchable(nuint address)
    {
        if (address >= 65536) return false;
        nuint me = Sys.ThreadBlock();
        if (me == 0) return false;
        return !GcLock.HeldByMe() && !GcLock.IsCollector(me);
    }

    /// Null unboxed to a value type: .NET's NullReferenceException.
    public static void NullUnboxed()
    {
        throw new NullReferenceException();
    }

    public static void InvalidCast(object o)
    {
        // Rendered through the object's own ToString, which for a class with
        // none of its own is its type name -- the thing a person debugging
        // the cast wants to see. (GetType() is not available on a plain
        // `object` in this dialect.) The type it was meant to be is on the
        // line that threw.
        throw new InvalidCastException("Unable to cast object '" + o + "' to the requested type.");
    }

    public static void GenericVirtualMissing(object o, string method)
    {
        throw new MissingMethodException("No compiled implementation of the generic virtual method '" + method
            + "' for object '" + o + "'.");
    }

    // ---- 64-bit division on a 32-bit machine -----------------------------------
    //
    // The 486 divides 64 by 32 at best. These are the shift-and-subtract
    // routines every `/` and `%` on a long becomes, so NOTHING in them may
    // divide a long, or the call would recurse until the stack ran out. Only
    // shifts, compares, subtraction and bit operations, all of which the
    // backend does on register pairs.

    /// Leading zero bits of an unsigned value; 64 for zero. BSR on a half
    /// (Sys.BitScanReverse), because DivU calls it twice per division.
    private static int Clz64(ulong x)
    {
        uint high = (uint)(x >> 32);
        if (high != 0)
        {
            return 31 - Sys.BitScanReverse(high);
        }
        uint low = (uint)x;
        return low == 0 ? 64 : 63 - Sys.BitScanReverse(low);
    }

    /// Unsigned quotient. The divisor is lined up with the dividend's top set
    /// bit and walked down one bit at a time, so a small quotient costs a few
    /// steps and a full 64-bit one costs 64. A zero divisor answers zero: the
    /// compiler checks for zero before it calls, so this cannot be reached
    /// from `/`, and the callers inside this file never pass one.
    // A DIVISOR THAT FITS IN 32 BITS -- every time conversion, every stride
    // and size, nearly every division there is -- goes through the
    // processor's 32-bit DIV: the high word once, then what is left with the
    // low word by Hacker's Delight's divlu (two 32-by-16 steps on 16-bit
    // halves, the divisor normalized), all in uint, which the backend divides
    // with one instruction. The walk below took up to 64 steps of 64-bit
    // shifts, compares and subtractions; the NT shared page's clock, divided
    // five times a round, was a fifth of a dual Pentium's time in it.

    /// Leading zero bits of a 32-bit value; 32 for zero.
    private static int Clz32(uint x)
    {
        return x == 0 ? 32 : 31 - Sys.BitScanReverse(x);
    }

    /// (u1:u0) / v and its remainder, for u1 < v and v nonzero: the quotient
    /// fits 32 bits. Hacker's Delight, divlu.
    private static uint DivLU(uint u1, uint u0, uint v, out uint remainder)
    {
        uint b = 65536;
        int s = Clz32(v);
        v = v << s;
        uint vn1 = v >> 16, vn0 = v & (uint)0xFFFF;
        uint un32 = s == 0 ? u1 : (u1 << s) | (u0 >> (32 - s));
        uint un10 = u0 << s;
        uint un1 = un10 >> 16, un0 = un10 & (uint)0xFFFF;
        uint q1 = un32 / vn1;
        uint rhat = un32 - q1 * vn1;
        while (q1 >= b || q1 * vn0 > b * rhat + un1)
        {
            q1 = q1 - 1;
            rhat = rhat + vn1;
            if (rhat >= b) break;
        }
        uint un21 = un32 * b + un1 - q1 * v;
        uint q0 = un21 / vn1;
        rhat = un21 - q0 * vn1;
        while (q0 >= b || q0 * vn0 > b * rhat + un0)
        {
            q0 = q0 - 1;
            rhat = rhat + vn1;
            if (rhat >= b) break;
        }
        remainder = (un21 * b + un0 - q0 * v) >> s;
        return q1 * b + q0;
    }

    /// a / b and a % b for a divisor below 2^32.
    private static ulong UDivShort(ulong a, uint b, out ulong remainder)
    {
        uint hi = (uint)(a >> 32), lo = (uint)a;
        uint qhi = 0;
        if (hi >= b)
        {
            qhi = hi / b;
            hi = hi - qhi * b;
        }
        uint r;
        uint qlo = DivLU(hi, lo, b, out r);
        remainder = (ulong)r;
        return ((ulong)qhi << 32) | (ulong)qlo;
    }

    private static ulong UDiv(ulong a, ulong b)
    {
        if (b == (ulong)0 || a < b)
        {
            return 0;
        }
        if ((b >> 32) == (ulong)0)
        {
            ulong unused;
            return UDivShort(a, (uint)b, out unused);
        }

        // Shifting a 64-bit value by 64 is not defined, and b << 32 etc. above
        // avoided it by construction; here `shift` is at most 63 because a >= b
        // means b has no more leading zeros than a.
        int shift = Clz64(b) - Clz64(a);
        ulong d = b << shift;
        ulong q = 0;

        while (shift >= 0)
        {
            q = q << 1;
            if (a >= d)
            {
                a = a - d;
                q = q | (ulong)1;
            }
            d = d >> 1;
            shift = shift - 1;
        }
        return q;
    }

    /// Unsigned remainder: the same walk, keeping what is left instead of the
    /// bits taken. Written out rather than as a - b * UDiv(a, b) to save the
    /// multiply, which on a 486 is not free either.
    private static ulong URem(ulong a, ulong b)
    {
        if (b == (ulong)0)
        {
            return a;
        }
        if (a < b)
        {
            return a;
        }
        if ((b >> 32) == (ulong)0)
        {
            ulong left;
            UDivShort(a, (uint)b, out left);
            return left;
        }

        int shift = Clz64(b) - Clz64(a);
        ulong d = b << shift;

        while (shift >= 0)
        {
            if (a >= d)
            {
                a = a - d;
            }
            d = d >> 1;
            shift = shift - 1;
        }
        return a;
    }

    /// The magnitude of a signed value as an unsigned one. Negating
    /// long.MinValue wraps to itself as a long and is exactly 2^63 as a ulong,
    /// which is the right answer.
    private static ulong Magnitude(long v)
    {
        if (v < 0)
        {
            return (ulong)(0 - v);
        }
        return (ulong)v;
    }

    public static long DivU(long a, long b)
    {
        return (long)UDiv((ulong)a, (ulong)b);
    }

    public static long RemU(long a, long b)
    {
        return (long)URem((ulong)a, (ulong)b);
    }

    /// Signed quotient with C#'s semantics: truncated toward zero. A divisor
    /// of -1 never arrives: the compiler takes it apart first, and throws
    /// OverflowException for long.MinValue / -1 as .NET does.
    public static long DivS(long a, long b)
    {
        ulong q = UDiv(Magnitude(a), Magnitude(b));

        if ((a < 0) != (b < 0))
        {
            return 0 - (long)q;
        }
        return (long)q;
    }

    /// Signed remainder: the sign of the DIVIDEND, as C# specifies, so that
    /// a == (a / b) * b + a % b holds for every pair. A divisor of -1 never
    /// arrives here either; long.MinValue % -1 throws, as .NET's does.
    public static long RemS(long a, long b)
    {
        ulong r = URem(Magnitude(a), Magnitude(b));

        if (a < 0)
        {
            return 0 - (long)r;
        }
        return (long)r;
    }

    // ---- floating point ----------------------------------------------------------
    //
    // The x87 has instructions for most of these but the backend does not
    // select them yet, so they are software. Every one uses the integer
    // conversion, which the backend performs with the control word set to
    // truncate -- so (long)x is C#'s (long)x, toward zero.

    // 2^52: above this every double is already an integer (the mantissa has
    // no fraction bits left), and below it the value fits a long exactly.
    // A method rather than a const: this file keeps to integer constants.
    private static double IntegralAbove()
    {
        return 4503599627370496.0;
    }

    /// THE NaN AN INVALID OPERATION MAKES, the sign bit set, as the
    /// processor's 0/0 makes it and as .NET's `2.0 % 0.0` answers. Made from
    /// its bits because the constant folder would happily turn 0.0 / 0.0
    /// into a compile-time value we do not control.
    private static double NaN()
    {
        return Sys.FromBits(unchecked((long)0xFFF8000000000000));
    }

    private static bool IsNaN(double x)
    {
        return x != x;
    }

    private static bool IsInfinite(double x)
    {
        return (Sys.Bits(x) & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000;
    }

    /// Toward zero. NaN and infinities pass through the size test unchanged,
    /// NaN because every comparison with it is false and infinity because it
    /// is larger than the bound.
    public static double Truncate(double x)
    {
        if (IsNaN(x))
        {
            return x;
        }
        if (x >= IntegralAbove() || x <= 0.0 - IntegralAbove())
        {
            return x;
        }
        // A negative value that truncates to zero is -0.0, as .NET's is:
        // Math.Ceiling(-0.5) prints as -0.
        double t = (double)(long)x;
        if (t == 0.0 && Sys.Bits(x) < 0)
        {
            return Sys.FromBits(unchecked((long)0x8000000000000000));
        }
        return t;
    }

    public static double Floor(double x)
    {
        double t = Truncate(x);

        if (t > x)
        {
            return t - 1.0;
        }
        return t;
    }

    public static double Ceiling(double x)
    {
        double t = Truncate(x);

        if (t < x)
        {
            return t + 1.0;
        }
        return t;
    }

    /// C#'s Math.Round: to the nearest integer, and a tie to the EVEN one, so
    /// 2.5 rounds to 2 and 3.5 to 4. Not what a schoolbook says, and exactly
    /// what .NET says, which is the rule this library follows.
    public static double Round(double x)
    {
        double f = Floor(x);

        if (f == x)
        {
            return x;
        }

        double fraction = x - f;
        double made;

        if (fraction < 0.5)
        {
            made = f;
        }
        else if (fraction > 0.5)
        {
            made = f + 1.0;
        }
        else if (((long)f & 1) == 0)
        {
            // A tie. f is integral and within 2^52 (or Floor would have
            // answered x itself), so its parity is the low bit of its
            // integer value.
            made = f;
        }
        else
        {
            made = f + 1.0;
        }
        // A NEGATIVE NUMBER THAT ROUNDS TO ZERO IS -0, as .NET's is:
        // Math.Round(-0.4) and Math.Round(-0.5) print as -0. Floor's -1 plus
        // one was +0.
        if (made == 0.0 && x < 0.0)
        {
            return Sys.FromBits(unchecked((long)0x8000000000000000));
        }
        return made;
    }

    /// C#'s Math.Min and Max propagate NaN: if either is NaN the answer is
    /// NaN, where a bare comparison would silently pick the other.
    public static double Min(double a, double b)
    {
        if (IsNaN(a))
        {
            return a;
        }
        if (IsNaN(b))
        {
            return b;
        }
        // Equal, one of them -0.0: .NET orders -0.0 below +0.0.
        if (a == b)
        {
            return Sys.Bits(a) < 0 ? a : b;
        }
        return a < b ? a : b;
    }

    public static double Max(double a, double b)
    {
        if (IsNaN(a))
        {
            return a;
        }
        if (IsNaN(b))
        {
            return b;
        }
        if (a == b)
        {
            return Sys.Bits(a) < 0 ? b : a;
        }
        return a > b ? a : b;
    }

    /// a * b + c ROUNDED ONCE, as the hardware's fused multiply-add and C's
    /// fma round it, and as Math.FusedMultiplyAdd answers. No processor this
    /// targets has the instruction, so it is done in integers: the product
    /// of the two 53-bit mantissas is exact in 106 bits, c is lined up with
    /// it in a 128-bit window whose lost bits are kept as one sticky bit, and
    /// the sum is rounded to nearest, ties to even, once -- subnormals,
    /// overflow and an exact cancellation (+0) as IEEE 754 has them.
    public static double FusedMultiplyAdd(double a, double b, double c)
    {
        ulong ua = (ulong)Sys.Bits(a);
        ulong ub = (ulong)Sys.Bits(b);
        ulong uc = (ulong)Sys.Bits(c);
        int ea = (int)((ua >> 52) & 0x7FF);
        int eb = (int)((ub >> 52) & 0x7FF);
        int ec = (int)((uc >> 52) & 0x7FF);

        // A NaN or an infinity among the factors, or a zero one: the product
        // is exact, or no number, and the plain sum rounds once.
        if (ea == 0x7FF || eb == 0x7FF || (ua << 1) == (ulong)0 || (ub << 1) == (ulong)0)
        {
            return a * b + c;
        }
        // c infinite or NaN beside a finite product: c itself.
        if (ec == 0x7FF)
        {
            return c + c;
        }

        ulong productSign = (ua ^ ub) >> 63;
        ulong ma = ua & 0x000FFFFFFFFFFFFF;
        ulong mb = ub & 0x000FFFFFFFFFFFFF;
        if (ea == 0) { ea = 1; } else { ma = ma | 0x0010000000000000; }
        if (eb == 0) { eb = 1; } else { mb = mb | 0x0010000000000000; }

        // THE PRODUCT, its top bit moved to bit 125 of hi:lo, and its scale:
        // the value is hi:lo x 2^scale.
        ulong lo;
        ulong hi = MultiplyWide(ma, mb, out lo);
        int up = (hi != (ulong)0 ? Clz64(hi) : 64 + Clz64(lo)) - 2;
        if (up >= 64)
        {
            hi = lo << (up - 64);
            lo = 0;
        }
        else if (up > 0)
        {
            hi = (hi << up) | (lo >> (64 - up));
            lo = lo << up;
        }
        int scale = ea + eb - 2150 - up;

        ulong sign = productSign;
        if ((uc << 1) != (ulong)0)
        {
            ulong mc = uc & 0x000FFFFFFFFFFFFF;
            if (ec == 0) { ec = 1; } else { mc = mc | 0x0010000000000000; }
            int top = 63 - Clz64(mc);
            ulong chi = mc << (61 - top);
            ulong clo = 0;
            int cscale = ec - 1075 - (61 - top) - 64;

            // The smaller of the two shifted down to the larger's scale.
            if (cscale > scale)
            {
                hi = ShiftRightSticky(hi, lo, cscale - scale, out lo);
                scale = cscale;
            }
            else if (scale > cscale)
            {
                chi = ShiftRightSticky(chi, clo, scale - cscale, out clo);
            }

            ulong csign = uc >> 63;
            if (csign == productSign)
            {
                ulong sum = lo + clo;
                hi = hi + chi + (sum < lo ? (ulong)1 : (ulong)0);
                lo = sum;
            }
            else if (hi > chi || (hi == chi && lo >= clo))
            {
                hi = hi - chi - (lo < clo ? (ulong)1 : (ulong)0);
                lo = lo - clo;
            }
            else
            {
                hi = chi - hi - (clo < lo ? (ulong)1 : (ulong)0);
                lo = clo - lo;
                sign = csign;
            }
            // AN EXACT CANCELLATION IS +0, in the default rounding.
            if (hi == (ulong)0 && lo == (ulong)0)
            {
                return 0.0;
            }
        }

        // The leading bit's place, and the mantissa's last place: 2^(e - 52),
        // or the subnormals' 2^-1074 when e is below the normal range.
        int lead = hi != (ulong)0 ? 127 - Clz64(hi) : 63 - Clz64(lo);
        int last = scale + lead - 52;
        if (last < -1074)
        {
            last = -1074;
        }
        int drop = last - scale;
        ulong m;
        bool above = false;
        bool half = false;
        if (drop <= 0)
        {
            // Every bit kept, and room to spare: a subnormal sum of tiny
            // numbers, its mantissa shifted up exactly.
            m = lo << (0 - drop);
        }
        else if (drop >= 128)
        {
            // ALL OF IT BELOW HALF THE LAST PLACE: a product far under the
            // subnormals, whose leading bit (126 at most) is under the
            // place's half. A zero of its sign -- and the shifts below,
            // which a count of 64 or more wraps, are never asked to try.
            m = 0;
        }
        else
        {
            // What the shift drops, against half of the last place kept.
            ulong restHi;
            ulong restLo;
            ulong halfHi;
            ulong halfLo;
            if (drop >= 64)
            {
                m = drop == 64 ? hi : hi >> (drop - 64);
                restHi = drop == 64 ? (ulong)0 : hi & (((ulong)1 << (drop - 64)) - 1);
                restLo = lo;
                halfHi = drop == 64 ? (ulong)0 : (ulong)1 << (drop - 65);
                halfLo = drop == 64 ? (ulong)0x8000000000000000 : (ulong)0;
            }
            else
            {
                m = (lo >> drop) | (hi << (64 - drop));
                restHi = 0;
                restLo = lo & (((ulong)1 << drop) - 1);
                halfHi = 0;
                halfLo = (ulong)1 << (drop - 1);
            }
            above = restHi > halfHi || (restHi == halfHi && restLo > halfLo);
            half = restHi == halfHi && restLo == halfLo;
        }
        if (above || (half && (m & (ulong)1) != (ulong)0))
        {
            m = m + 1;
        }
        if (m >= 0x0020000000000000)
        {
            m = m >> 1;
            last = last + 1;
        }
        if (m == (ulong)0)
        {
            return Sys.FromBits((long)(sign << 63));
        }
        if (last + 52 > 1023)
        {
            return Sys.FromBits((long)((sign << 63) | 0x7FF0000000000000));
        }
        if (m < 0x0010000000000000)
        {
            return Sys.FromBits((long)((sign << 63) | m));
        }
        return Sys.FromBits((long)((sign << 63) | ((ulong)(last + 1075) << 52) | (m - 0x0010000000000000)));
    }

    /// The 128-bit product of two 64-bit words: the high word answered, the
    /// low one through `lo`. Four 32-bit products, which is all a 486 has.
    private static ulong MultiplyWide(ulong a, ulong b, out ulong lo)
    {
        ulong aLo = a & 0xFFFFFFFF;
        ulong aHi = a >> 32;
        ulong bLo = b & 0xFFFFFFFF;
        ulong bHi = b >> 32;
        ulong ll = aLo * bLo;
        ulong lh = aLo * bHi;
        ulong hl = aHi * bLo;
        ulong hh = aHi * bHi;
        ulong middle = (ll >> 32) + (lh & 0xFFFFFFFF) + (hl & 0xFFFFFFFF);
        lo = (middle << 32) | (ll & 0xFFFFFFFF);
        return hh + (lh >> 32) + (hl >> 32) + (middle >> 32);
    }

    /// hi:lo shifted right by n, 0 < n, every bit shifted out folded into the
    /// lowest bit kept: the result rounds as the exact value would.
    private static ulong ShiftRightSticky(ulong hi, ulong lo, int n, out ulong outLo)
    {
        if (n >= 128)
        {
            outLo = (hi | lo) != (ulong)0 ? (ulong)1 : (ulong)0;
            return 0;
        }
        if (n >= 64)
        {
            ulong lost = n == 64 ? lo : lo | (hi << (128 - n));
            outLo = (n == 64 ? hi : hi >> (n - 64)) | (lost != (ulong)0 ? (ulong)1 : (ulong)0);
            return 0;
        }
        ulong gone = lo << (64 - n);
        outLo = (lo >> n) | (hi << (64 - n)) | (gone != (ulong)0 ? (ulong)1 : (ulong)0);
        return hi >> n;
    }

    /// C#'s `%` on doubles, which is C's fmod: the remainder of a truncating
    /// division, with the sign of the dividend. Computed as a - b * trunc(a/b),
    /// which is exact when the quotient is small and loses low bits when a is
    /// enormous relative to b; a loop of exact subtractions would fix that at
    /// a cost no caller here has asked for.
    public static double Remainder(double x, double y)
    {
        // EXACTLY, as C#'s `%` and C's fmod are: x - n*y with n the quotient
        // truncated, and no rounding anywhere -- the result is always
        // representable. `x - Truncate(x / y) * y` is not that once the
        // quotient passes 2^53: 1e300 % 3.0 came out as whatever the rounded
        // product left behind. So the mantissas are divided the long way,
        // one bit of the quotient per step, as a C library does it.
        ulong ux = (ulong)Sys.Bits(x);
        ulong uy = (ulong)Sys.Bits(y);
        int ex = (int)((ux >> 52) & 0x7FF);
        int ey = (int)((uy >> 52) & 0x7FF);
        ulong sign = ux & 0x8000000000000000;

        // y zero, y NaN, or x infinite or NaN: NaN (x NaN or y NaN propagate).
        if ((uy << 1) == 0 || IsNaN(y) || ex == 0x7FF)
        {
            return IsNaN(x) ? x : IsNaN(y) ? y : NaN();
        }
        // |x| no greater than |y|: x itself, or a zero of x's sign.
        if ((ux << 1) <= (uy << 1))
        {
            return (ux << 1) == (uy << 1) ? 0.0 * x : x;
        }

        // Both to a 53-bit integer mantissa with the implicit bit, a
        // subnormal normalised by shifting and lowering its exponent.
        ulong mx;
        if (ex == 0)
        {
            for (ulong t = ux << 12; (t >> 63) == 0; t = t << 1) ex = ex - 1;
            mx = ux << (1 - ex);
        }
        else
        {
            mx = (ux & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
        }
        ulong my;
        if (ey == 0)
        {
            for (ulong t = uy << 12; (t >> 63) == 0; t = t << 1) ey = ey - 1;
            my = uy << (1 - ey);
        }
        else
        {
            my = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
        }

        // The remainder, one exponent step at a time.
        for (; ex > ey; ex = ex - 1)
        {
            ulong d = mx - my;
            if ((d >> 63) == 0)
            {
                if (d == 0) return 0.0 * x;
                mx = d;
            }
            mx = mx << 1;
        }
        ulong last = mx - my;
        if ((last >> 63) == 0)
        {
            if (last == 0) return 0.0 * x;
            mx = last;
        }
        while ((mx >> 52) == 0)
        {
            mx = mx << 1;
            ex = ex - 1;
        }

        // Back to a double: normal with its exponent, or subnormal shifted down.
        if (ex > 0)
        {
            mx = (mx - 0x0010000000000000) | ((ulong)ex << 52);
        }
        else
        {
            mx = mx >> (1 - ex);
        }
        return Sys.FromBits((long)(mx | sign));
    }

    /// Exact in single precision too: a float's remainder, taken exactly in
    /// double, is exactly representable as a float.
    public static float RemainderSingle(float a, float b)
    {
        return (float)Remainder((double)a, (double)b);
    }

    // ---- raw memory ------------------------------------------------------------

    /// memcmp over raw addresses: the sign of the first differing byte taken
    /// as UNSIGNED, or zero when all `count` bytes agree: Sys.CompareBytes.
    /// Strings have their own (StringEqual, StringCompare), which walk code
    /// units in pairs.
    public static int CompareBytes(nuint a, nuint b, nuint count)
    {
        nuint i = 0;

        // Aligned equal words can be skipped on every target. A differing
        // word still goes through the unsigned-byte comparison below, so the
        // answer does not depend on target endianness. Never read past count.
        if (((a ^ b) & 3) == 0)
        {
            // Matching misalignment needs at most three byte comparisons
            // before both addresses become safe for aligned word loads.
            while (i < count && ((a + i) & 3) != 0)
            {
                byte x = Sys.Read8(a + i);
                byte y = Sys.Read8(b + i);
                if (x != y)
                {
                    return x < y ? -1 : 1;
                }
                i = i + 1;
            }
            while (count - i >= 4)
            {
                if (Sys.Read32(a + i) != Sys.Read32(b + i))
                {
                    break;
                }
                i = i + 4;
            }
        }

        while (i < count)
        {
            byte x = Sys.Read8(a + i);
            byte y = Sys.Read8(b + i);

            if (x != y)
            {
                return x < y ? -1 : 1;
            }
            i = i + 1;
        }
        return 0;
    }

    /// Exchanges `count` bytes between two addresses. Memory.Swap.
    public static void SwapBytes(nuint first, nuint second, nuint count)
    {
        nuint i = 0;

        while (i < count)
        {
            byte x = Sys.Read8(first + i);
            Sys.Write8(first + i, Sys.Read8(second + i));
            Sys.Write8(second + i, x);
            i = i + 1;
        }
    }

    /// Reverses a block in place: `low` walks up and `high` walks down and
    /// each of `pairs` steps swaps the two. Memory.Reverse passes the first
    /// and last byte and count / 2 pairs, so the middle byte of an odd block
    /// is left where it is, which is where it belongs.
    public static void ReverseBytes(nuint low, nuint high, nuint pairs)
    {
        nuint i = 0;

        while (i < pairs)
        {
            byte x = Sys.Read8(low);
            Sys.Write8(low, Sys.Read8(high));
            Sys.Write8(high, x);
            low = low + 1;
            high = high - 1;
            i = i + 1;
        }
    }

    /// The index of the first set bit in a bitmap of `bits` bits at `bitmap`,
    /// bit 0 being the low bit of the first byte, or -1 when none is set.
    /// Whole zero bytes are skipped a byte at a time; a word at a time is the
    /// obvious next step if a caller ever shows up with megabytes of them.
    public static int FirstSet(nuint bitmap, nuint bits)
    {
        nuint bit = 0;

        while (bit < bits)
        {
            byte b = Sys.Read8(bitmap + (bit >> 3));

            if (b == 0)
            {
                bit = bit + 8;
                continue;
            }

            nuint within = bit & 7;

            while (within < 8)
            {
                if (bit >= bits)
                {
                    return -1;
                }
                if (((b >> (int)within) & 1) != 0)
                {
                    return (int)bit;
                }
                within = within + 1;
                bit = bit + 1;
            }
        }
        return -1;
    }

    /// How many of the first `bits` bits at `bitmap` are set.
    public static nuint PopCountBlock(nuint bitmap, nuint bits)
    {
        nuint count = 0;
        nuint bit = 0;

        while (bit + 8 <= bits)
        {
            count = count + (nuint)PopulationCount(Sys.Read8(bitmap + (bit >> 3)));
            bit = bit + 8;
        }

        // A last partial byte: only the bits below `bits` count.
        if (bit < bits)
        {
            int b = Sys.Read8(bitmap + (bit >> 3));
            int keep = (int)(bits - bit);
            count = count + (nuint)PopulationCount(b & ((1 << keep) - 1));
        }
        return count;
    }

    // ---- bit tricks ----------------------------------------------------------------

    /// The population count by the parallel fold: each step sums adjacent
    /// fields twice as wide as the last. Twelve operations for 64 bits, and
    /// no table.
    public static long PopulationCount(long value)
    {
        ulong x = (ulong)value;
        long m1 = 0x5555555555555555;
        long m2 = 0x3333333333333333;
        long m4 = 0x0F0F0F0F0F0F0F0F;

        x = x - ((x >> 1) & (ulong)m1);
        x = (x & (ulong)m2) + ((x >> 2) & (ulong)m2);
        x = (x + (x >> 4)) & (ulong)m4;
        // Fold the eight byte counts into the top byte. The low 64 bits of
        // x * 0x0101010101010101 hold the sum in their top byte, and the
        // product is a plain wrapping multiply, which is what `*` does here.
        x = x * (ulong)0x0101010101010101;
        return (long)(x >> 56);
    }

    public static long LeadingZeroCount(long value)
    {
        return Clz64((ulong)value);
    }

    /// The same over a word, 8 * WordSize.Bytes for zero: on i386 by the
    /// 32-bit steps, half the 64-bit ones' work, for the marker resolves a
    /// pointer by one of each (HeapChunks.StartAtOrBelow, NextStart).
    public static int LeadingZeroCount(nuint value)
    {
#if TARGET_64BIT
        return Clz64(value);
#else
        return Clz32((uint)value);
#endif
    }

    public static int TrailingZeroCount(nuint value)
    {
        if (value == 0)
        {
            return 8 * WordSize.Bytes;
        }
        nuint lowest = value & (0 - value);
#if TARGET_64BIT
        return 63 - Clz64(lowest);
#else
        return 31 - Clz32((uint)lowest);
#endif
    }

    /// Trailing zeros; 64 for zero. The lowest set bit is isolated with
    /// x & -x, and the leading-zero count of that says where it was.
    public static long TrailingZeroCount(long value)
    {
        if (value == 0)
        {
            return 64;
        }

        ulong x = (ulong)value;
        ulong lowest = x & (ulong)(0 - value);
        return 63 - Clz64(lowest);
    }

    /// Reverses the eight bytes: the little-endian word becomes big-endian.
    public static long ByteSwap(long value)
    {
        ulong x = (ulong)value;
        ulong r = 0;
        int i = 0;

        while (i < 8)
        {
            r = (r << 8) | (x & (ulong)255);
            x = x >> 8;
            i = i + 1;
        }
        return (long)r;
    }

    /// Rotations by any count; the count is taken modulo 64, and a rotate by
    /// zero is spelt out because shifting a 64-bit value by 64 is not.
    public static long RotateLeft(long value, long count)
    {
        int n = (int)(count & 63);

        if (n == 0)
        {
            return value;
        }

        ulong x = (ulong)value;
        return (long)((x << n) | (x >> (64 - n)));
    }

    public static long RotateRight(long value, long count)
    {
        int n = (int)(count & 63);

        if (n == 0)
        {
            return value;
        }

        ulong x = (ulong)value;
        return (long)((x >> n) | (x << (64 - n)));
    }

    // Legacy x86 has no AES instruction assistance. Returning false must not
    // modify any caller storage: the crypto library then uses its software path.
    public static bool TryAesEncryptBlock(nuint state, nuint roundKeys, int rounds) { return false; }
    public static bool TryAesDecryptBlock(nuint state, nuint roundKeys, int rounds) { return false; }
    public static bool TryAesKey128Next(nuint output, nuint previous, int roundConstant) { return false; }
    public static bool TryAesKey256Next(nuint output, nuint earlier, nuint recent, int control) { return false; }

    public static long ReverseBits(long value)
    {
        ulong source = (ulong)value, result = 0;
        for (int bit = 0; bit < 64; bit++)
        {
            result = (result << 1) | (source & 1);
            source >>= 1;
        }
        return (long)result;
    }

    public static long CarrylessMultiply(long left, long right, out long high)
    {
        ulong a = (ulong)left, b = (ulong)right, aHigh = 0, low = 0, upper = 0;
        for (int bit = 0; bit < 64; bit++)
        {
            ulong mask = 0UL - (b & 1);
            low ^= a & mask;
            upper ^= aHigh & mask;
            aHigh = (aHigh << 1) | (a >> 63);
            a <<= 1;
            b >>= 1;
        }
        high = (long)upper;
        return (long)low;
    }

    public static long GaloisFieldMultiply(long left, long right)
    {
        int a = (int)left & 255, b = (int)right & 255, result = 0;
        for (int bit = 0; bit < 8; bit++)
        {
            result ^= a & (0 - (b & 1));
            a = ((a << 1) ^ (0x11b & (0 - (a >> 7)))) & 255;
            b >>= 1;
        }
        return result;
    }

    public static long MultiplyAccumulate(long left, long right, long carry, out long high)
    {
        ulong product = (ulong)left * (ulong)right;
        ulong sum = product + (ulong)carry;
        high = (long)((ulong)MultiplyHighUnsigned(left, right) + (sum < product ? 1UL : 0UL));
        return (long)sum;
    }

    /// The high 64 bits of the 128-bit unsigned product, from four 32 x 32
    /// partial products. The middle two are summed with their carry kept,
    /// which is the whole difficulty of doing this without a wide register.
    public static long MultiplyHighUnsigned(long a, long b)
    {
        ulong x = (ulong)a;
        ulong y = (ulong)b;
        ulong mask = (ulong)0xFFFFFFFF;
        ulong x0 = x & mask;
        ulong x1 = x >> 32;
        ulong y0 = y & mask;
        ulong y1 = y >> 32;

        ulong p00 = x0 * y0;
        ulong p01 = x0 * y1;
        ulong p10 = x1 * y0;
        ulong p11 = x1 * y1;

        // The middle column: two 64-bit products plus the carry from the
        // low column, which can itself overflow 64 bits -- so it is summed
        // in two halves.
        ulong middle = (p00 >> 32) + (p01 & mask) + (p10 & mask);
        ulong high = p11 + (p01 >> 32) + (p10 >> 32) + (middle >> 32);
        return (long)high;
    }

    /// The signed version is the unsigned one corrected for each negative
    /// operand: interpreting a negative a as unsigned added 2^64 to it, which
    /// contributed b * 2^64 to the product, i.e. b to the high word.
    public static long MultiplyHigh(long a, long b)
    {
        long high = MultiplyHighUnsigned(a, b);

        if (a < 0)
        {
            high = high - b;
        }
        if (b < 0)
        {
            high = high - a;
        }
        return high;
    }

    // ---- checksums -----------------------------------------------------------------
    //
    // Sys.Checksum(at, bytes, kind, seed), with the old machine's msum
    // selectors so Memory.Sum and the rest keep their meanings:
    //
    //   0  plain byte sum        seed + every byte
    //   1  Internet checksum     RFC 1071, folded and complemented
    //   2  CRC-32C (Castagnoli)  reflected, 0x82F63B78
    //   3  Adler-32              seed 0 means the standard start of 1
    //   4  CRC-32 (IEEE, zlib)   reflected, 0xEDB88320
    //   5  POSIX cksum           unreflected 0x04C11DB7, no length trailer
    //
    // `kind` carries the selector in its low byte. Bit 8 is the old unit's
    // "begun" flag: with it set, `seed` is the RAW running state of a
    // previous call rather than a fresh seed, and the block is treated as
    // a continuation, so a file can be summed in pieces. std.cor never sets
    // it. The CRC tables are built on first use rather than at start-up.

    // The most bytes Adler-32 can take between reductions with 32-bit sums;
    // see the selector-3 branch.
    const int AdlerBlock = 5552;

    // The two reflected polynomials are written as LITERALS where they are
    // used, deliberately: a `const long` initialised from a literal above
    // int.MaxValue is folded sign-extended as of this writing, and the
    // high bits then leak into the table through the shifts. A literal in
    // a long argument position is typed long and is correct -- verified
    // against the standard check values.

    static uint[] _crcTable;      // 256 entries, IEEE
    static uint[] _crcTableC;     // the same for Castagnoli

    private static uint[] CrcTable(long polynomial)
    {
        uint[] table = polynomial == 0xEDB88320 ? _crcTable : _crcTableC;

        if (table != null)
        {
            return table;
        }

        table = new uint[256];

        for (int n = 0; n < 256; n++)
        {
            long crc = n;

            for (int bit = 0; bit < 8; bit++)
            {
                if ((crc & 1) != 0)
                {
                    crc = (crc >> 1) ^ polynomial;
                }
                else
                {
                    crc = crc >> 1;
                }
            }
            table[n] = (uint)crc;
        }

        if (polynomial == 0xEDB88320)
        {
            _crcTable = table;
        }
        else
        {
            _crcTableC = table;
        }
        return table;
    }


    public static long Checksum(nuint at, nuint bytes, int kind, long seed)
    {
        int selector = kind & 255;
        long mask32 = 0xFFFFFFFF;
        // Branch, not `bool begun = ... != 0`; see FormatDecimal for why.
        bool begun = false;

        if ((kind & 256) != 0)
        {
            begun = true;
        }

        if (selector == 0)
        {
            long sum = seed;
            nuint i = 0;

            while (i < bytes)
            {
                sum = sum + Sys.Read8(at + i);
                i = i + 1;
            }
            return sum;
        }

        if (selector == 1)
        {
            // Big-endian 16-bit words, end-around carry after each, an odd
            // trailing byte padded with zero, and the complement at the end.
            long sum = seed;
            nuint i = 0;

            while (i < bytes)
            {
                uint word = (uint)Sys.Read8(at + i) << 8;

                if (i + 1 < bytes)
                {
                    word = word | Sys.Read8(at + i + 1);
                }
                sum = sum + word;
                sum = (sum & 0xFFFF) + (sum >> 16);
                i = i + 2;
            }
            sum = (sum & 0xFFFF) + (sum >> 16);
            return (~sum) & 0xFFFF;
        }

        if (selector == 2 || selector == 4)
        {
            uint[] table = CrcTable(selector == 2 ? 0x82F63B78 : 0xEDB88320);
            long crc = begun ? (seed & mask32) : ((~seed) & mask32);
            nuint i = 0;

            while (i < bytes)
            {
                int index = (int)((crc ^ Sys.Read8(at + i)) & 255);
                crc = (crc >> 8) ^ (long)table[index];
                i = i + 1;
            }
            return (~crc) & mask32;
        }

        if (selector == 3)
        {
            long start = begun ? seed : (seed == 0 ? 1 : seed);
            long a = start & 0xFFFF;
            long b = (start >> 16) & 0xFFFF;
            nuint i = 0;

            // 65521 is the largest prime below 2^16. The reduction is done
            // every 5552 bytes rather than every byte -- the most that fits
            // before b can overflow 32 bits -- but here a and b are longs
            // and a reduction after each block of up to 5552 is simply fewer
            // divisions, which on this machine are library calls.
            while (i < bytes)
            {
                nuint block = bytes - i;
                if (block > AdlerBlock)
                {
                    block = AdlerBlock;
                }
                nuint end = i + block;

                while (i < end)
                {
                    a = a + Sys.Read8(at + i);
                    b = b + a;
                    i = i + 1;
                }
                a = URemSmall(a, 65521);
                b = URemSmall(b, 65521);
            }
            return (b << 16) | a;
        }

        if (selector == 5)
        {
            // POSIX cksum's CRC is the unreflected form: bytes enter at the
            // top and the register shifts left. Bit at a time, because cksum
            // is run on whole files rarely enough that a table is not worth
            // its 1 KB.
            long crc = begun ? (seed & mask32) : ((~seed) & mask32);
            nuint i = 0;

            while (i < bytes)
            {
                crc = crc ^ ((long)Sys.Read8(at + i) << 24);

                for (int bit = 0; bit < 8; bit++)
                {
                    if ((crc & 0x80000000) != 0)
                    {
                        crc = ((crc << 1) ^ 0x04C11DB7) & mask32;
                    }
                    else
                    {
                        crc = (crc << 1) & mask32;
                    }
                }
                i = i + 1;
            }
            return (~crc) & mask32;
        }

        return 0;
    }

    /// value % m for a non-negative value and a small positive m, through the
    /// unsigned helper so this file keeps its no-`%`-on-long rule.
    private static long URemSmall(long value, long m)
    {
        return (long)URem((ulong)value, (ulong)m);
    }

    // ---- the string unit -------------------------------------------------------------
    //
    // The old machine had a string unit; std.cor reaches it through Sys.String*
    // and these are those operations in software. Each takes an exact span --
    // a start and a count, in UTF-16 code units -- and does no checking of its
    // own: String above checks, and a caller that comes straight here is a
    // caller that asked to.

    /// The index of the first code unit equal to `value` in s[at, at + count), or -1.
    public static int StringFind(string s, int at, int value, int count)
    {
        int v = value & 0xFFFF;
        int end = at + count;

        for (int i = at; i < end; i++)
        {
            if (Sys.GetChar(s, i) == v)
            {
                return i;
            }
        }
        return -1;
    }

    /// The same walking DOWN from `at` for `count` units, so LastIndexOf
    /// passes the last index and the length.
    public static int StringFindReverse(string s, int at, int value, int count)
    {
        int v = value & 0xFFFF;
        int i = at;

        while (count > 0 && i >= 0)
        {
            if (Sys.GetChar(s, i) == v)
            {
                return i;
            }
            i = i - 1;
            count = count - 1;
        }
        return -1;
    }

    /// Where `what` (from whatAt to its end) first occurs in s within the
    /// `count` units from `at`, or -1. An empty needle is found at `at`, as
    /// the old unit answered and as String.IndexOf expects.
    public static int StringSearch(string s, int at, string what, int whatAt, int count)
    {
        int needle = what.Length - whatAt;

        if (needle <= 0)
        {
            return at;
        }
        if (needle > count)
        {
            return -1;
        }

        int first = Sys.GetChar(what, whatAt);
        int last = at + count - needle;

        for (int i = at; i <= last; i++)
        {
            if (Sys.GetChar(s, i) != first)
            {
                continue;
            }

            int k = 1;

            while (k < needle && Sys.GetChar(s, i + k) == Sys.GetChar(what, whatAt + k))
            {
                k = k + 1;
            }
            if (k == needle)
            {
                return i;
            }
        }
        return -1;
    }

    /// ORDINAL ORDER of two spans of the same length: the first code unit that
    /// differs decides, by its value, which is .NET's string.CompareOrdinal.
    /// Answers the difference of those two units, or 0.
    ///
    /// Equal pairs of units are passed over as one 32-bit load each
    /// (Sys.GetCharPair); the pair that differs, or the unit left over, is
    /// read a unit at a time for the order.
    public static int StringCompare(string a, int aAt, string b, int bAt, int count)
    {
        int i = 0;
        int pairs = count - 1;

        while (i < pairs && Sys.GetCharPair(a, aAt + i) == Sys.GetCharPair(b, bAt + i))
        {
            i = i + 2;
        }
        for (; i < count; i++)
        {
            int x = Sys.GetChar(a, aAt + i);
            int y = Sys.GetChar(b, bAt + i);

            if (x != y)
            {
                return x - y;
            }
        }
        return 0;
    }

    /// Whether `count` bytes at `a` and `b` are the same: a machine word at a
    /// time, then the bytes left (Sys.BytesEqual: a byte span's SequenceEqual).
    public static bool BytesEqual(nuint a, nuint b, nuint count)
    {
        nuint i = 0;
        for (; i + WordSize.Bytes <= count; i += WordSize.Bytes)
        {
            if (Sys.ReadAddress(a + i) != Sys.ReadAddress(b + i)) return false;
        }
        for (; i < count; i++)
        {
            if (Sys.Read8(a + i) != Sys.Read8(b + i)) return false;
        }
        return true;
    }

    /// Whether two spans of `count` code units are the same units: two at a
    /// time, one 32-bit load from each (Sys.GetCharPair), with a 32-bit
    /// cursor, then the unit left over. Every string equality comes here --
    /// String.Equals, ==, the tables' key match, StartsWith and EndsWith.
    public static bool StringEqual(string a, int aAt, string b, int bAt, int count)
    {
        int i = 0;
        int pairs = count - 1;

        while (i < pairs)
        {
            if (Sys.GetCharPair(a, aAt + i) != Sys.GetCharPair(b, bAt + i))
            {
                return false;
            }
            i = i + 2;
        }
        return i >= count || Sys.GetChar(a, aAt + i) == Sys.GetChar(b, bAt + i);
    }

    /// Invariant case, IN PLACE, over the span; answers the count. Each
    /// character is mapped as .NET's ToLowerInvariant maps a string: a unit
    /// alone, or a surrogate pair as the one character it spells (its case
    /// partner is always a pair too). An unpaired surrogate has no case.
    public static int StringLower(string s, int at, int count)
    {
        MapCase(s, at, count, false);
        return count;
    }

    public static int StringUpper(string s, int at, int count)
    {
        MapCase(s, at, count, true);
        return count;
    }

    private static void MapCase(string s, int at, int count, bool upper)
    {
        int end = at + count;
        int i = at;

        while (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c >= 0xD800 && c <= 0xDBFF && i + 1 < end)
            {
                int d = Sys.GetChar(s, i + 1);

                if (d >= 0xDC00 && d <= 0xDFFF)
                {
                    int point = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00);
                    int mapped = upper ? UnicodeCase.Upper(point) : UnicodeCase.Lower(point);
                    Sys.SetChar(s, i, 0xD800 + ((mapped - 0x10000) >> 10));
                    Sys.SetChar(s, i + 1, 0xDC00 + ((mapped - 0x10000) & 0x3FF));
                    i = i + 2;
                    continue;
                }
            }
            Sys.SetChar(s, i, upper ? UnicodeCase.Upper(c) : UnicodeCase.Lower(c));
            i = i + 1;
        }
    }

    /// FNV-1a over the code units of the span, starting from `seed`: xor the
    /// unit in, multiply by the 64-bit FNV prime. StringComparer's
    /// fold-to-lower path in the standard library repeats it by hand, so the
    /// two must agree unit for unit.
    public static long StringHash(string s, int at, int count, long seed)
    {
        long h = seed;
        int end = at + count;

        for (int i = at; i < end; i++)
        {
            h = (h ^ Sys.GetChar(s, i)) * 0x100000001B3;
        }
        return h;
    }

    /// A WHOLE STRING'S HASH, worked out once and kept: a string cannot
    /// change, so the hash it had it has for ever, and a compiler asks the
    /// same names for theirs thousands of times over. It is kept in the four
    /// bytes after the count, which the header pads to eight-byte elements
    /// and nothing else uses; 0 there means not yet worked out, so a hash
    /// that comes out 0 is kept as 1. A literal's is written in by the
    /// compiler (Lowering.InternString), because a literal lives in read-only
    /// data and must never be written here.
    ///
    /// 32-bit FNV-1a over the code units: one 32-bit multiply a unit where
    /// the 64-bit one was three on this processor, for a hash that is an int
    /// all the same. Every hash of a whole string -- string.GetHashCode,
    /// StringComparer.Ordinal, the tables' KeyHash -- is this one, so they
    /// agree; nothing the compiler writes depends on its value.
    ///
    /// TWO HALVES: the kept hash read here, small enough for every caller
    /// to take in its own body -- a table's probe asks this of every key --
    /// and the working out (StringHashWorkedOut) called only the first time.
    public static int StringHashCode(string s)
    {
        long cached = Sys.Read32(Sys.ObjectAddress(s) + StringHashAt);
        if (cached != 0)
        {
            return (int)cached;
        }
        return StringHashWorkedOut(s);
    }

    /// A string's hash the first time it is asked for, kept on the string
    /// (StringHashCode). NEVER TAKEN BACK IN: called from one place, it was
    /// inlined into the half meant to be small, and the half was its size.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int StringHashWorkedOut(string s)
    {
        nuint at = Sys.ObjectAddress(s) + StringHashAt;
        uint h = 2166136261;
        int n = s.Length;
        int pairs = n - 1;
        int i = 0;
        // A pair of units a load, each still hashed on its own: the low half
        // is the first unit on this little-endian machine.
        while (i < pairs)
        {
            uint two = (uint)Sys.GetCharPair(s, i);
            h = (h ^ (two & 0xFFFF)) * 16777619;
            h = (h ^ (two >> 16)) * 16777619;
            i = i + 2;
        }
        if (i < n)
        {
            h = (h ^ (uint)Sys.GetChar(s, i)) * 16777619;
        }
        if (h == 0)
        {
            h = 1;
        }
        Sys.Write32(at, h);
        return (int)h;
    }

    const int StringHashAt = 2 * WordSize.Bytes + 4;

    /// Whether two strings' hashes are both already known and are different
    /// -- then they differ, whatever their units. Neither is worked out here.
    public static bool KnownHashesDiffer(string a, string b)
    {
        long x = Sys.Read32(Sys.ObjectAddress(a) + StringHashAt);
        long y = Sys.Read32(Sys.ObjectAddress(b) + StringHashAt);
        return x != 0 && y != 0 && x != y;
    }

    /// Sets `count` code units from dstAt to `value`; answers count.
    public static int StringFill(string dst, int dstAt, int value, int count)
    {
        int v = value & 0xFFFF;
        int end = dstAt + count;

        for (int i = dstAt; i < end; i++)
        {
            Sys.SetChar(dst, i, v);
        }
        return count;
    }

    /// The decimal text of `value` into dst at `at`, up to `capacity` units;
    /// answers how many were written. See FormatDecimal for the edges.
    public static int StringFormat(string dst, int at, long value, int capacity)
    {
        return FormatDecimal(dst, at, value, capacity);
    }

    /// Parses an optional sign and decimal digits from the span and answers
    /// the value; stops at the first unit that is not a digit. A sign with no
    /// digit after it is zero. The old unit faulted on overflow; this one
    /// wraps, which is the unchecked C# result of the same multiply-and-add.
    public static long StringNumber(string s, int at, int count)
    {
        int i = at;
        int end = at + count;
        bool negative = false;

        if (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c == 45)
            {
                negative = true;
                i = i + 1;
            }
            else if (c == 43)
            {
                i = i + 1;
            }
        }

        long value = 0;

        while (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c < 48 || c > 57)
            {
                break;
            }
            // Accumulated negatively so that long.MinValue parses: its
            // magnitude is one more than long.MaxValue holds.
            value = value * 10 - (c - 48);
            i = i + 1;
        }

        if (negative)
        {
            return value;
        }
        return 0 - value;
    }

    /// Copies `count` code units, correct when the two spans overlap in either
    /// direction (a copy upward is safe when the destination is below the
    /// source, and downward when it is above); answers count.
    public static int StringCopy(string dst, int dstAt, string src, int srcAt, int count)
    {
        if (count <= 0)
        {
            return 0;
        }

        if (Sys.ObjectAddress(dst) == Sys.ObjectAddress(src) && dstAt > srcAt)
        {
            for (int i = count - 1; i >= 0; i = i - 1)
            {
                Sys.SetChar(dst, dstAt + i, Sys.GetChar(src, srcAt + i));
            }
            return count;
        }

        for (int i = 0; i < count; i++)
        {
            Sys.SetChar(dst, dstAt + i, Sys.GetChar(src, srcAt + i));
        }
        return count;
    }
}
