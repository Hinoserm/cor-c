        + "\u0000\u07FE\u0000\u0800\u0000\u0816\u0000\u081A\u0000\u081B\u0000\u0824\u0000\u0825\u0000\u0828\u0000\u0829\u0000\u082E\u0000\u0830\u0000\u083F"
        + "\u0000\u0840\u0000\u0859\u0000\u085C\u0000\u085E\u0000\u085F\u0000\u0860\u0000\u086B\u0000\u0870\u0000\u0888\u0000\u0889\u0000\u088F\u0000\u0890"
        + "\u0000\u0892\u0000\u0898\u0000\u08A0\u0000\u08C9\u0000\u08CA\u0000\u08E2\u0000\u08E3\u0000\u0903\u0000\u0904\u0000\u093A\u0000\u093B\u0000\u093C"
        + "\u0000\u093D\u0000\u093E\u0000\u0941\u0000\u0949\u0000\u094D\u0000\u094E\u0000\u0950\u0000\u0951\u0000\u0958\u0000\u0962\u0000\u0964\u0000\u0966"
        + "\u0000\u0970\u0000\u0971\u0000\u0972\u0000\u0981\u0000\u0982\u0000\u0984\u0000\u0985\u0000\u098D\u0000\u098F\u0000\u0991\u0000\u0993\u0000\u09A9"
        + "\u0000\u09AA\u0000\u09B1\u0000\u09B2\u0000\u09B3\u0000\u09B6\u0000\u09BA\u0000\u09BC\u0000\u09BD\u0000\u09BE\u0000\u09C1\u0000\u09C5\u0000\u09C7"
        + "\u0000\u09C9\u0000\u09CB\u0000\u09CD\u0000\u09CE\u0000\u09CF\u0000\u09D7\u0000\u09D8\u0000\u09DC\u0000\u09DE\u0000\u09DF\u0000\u09E2\u0000\u09E4"
