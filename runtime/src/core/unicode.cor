        + "\u0000\u1FE8\u0000\u1FED\u0000\u1FF0\u0000\u1FF2\u0000\u1FF5\u0000\u1FF6\u0000\u1FF8\u0000\u1FFC\u0000\u1FFD\u0000\u1FFF\u0000\u2000\u0000\u200B"
        + "\u0000\u2010\u0000\u2016\u0000\u2018\u0000\u2019\u0000\u201A\u0000\u201B\u0000\u201D\u0000\u201E\u0000\u201F\u0000\u2020\u0000\u2028\u0000\u2029"
        + "\u0000\u202A\u0000\u202F\u0000\u2030\u0000\u2039\u0000\u203A\u0000\u203B\u0000\u203F\u0000\u2041\u0000\u2044\u0000\u2045\u0000\u2046\u0000\u2047"
        + "\u0000\u2052\u0000\u2053\u0000\u2054\u0000\u2055\u0000\u205F\u0000\u2060\u0000\u2065\u0000\u2066\u0000\u2070\u0000\u2071\u0000\u2072\u0000\u2074"
        + "\u0000\u207A\u0000\u207D\u0000\u207E\u0000\u207F\u0000\u2080\u0000\u208A\u0000\u208D\u0000\u208E\u0000\u208F\u0000\u2090\u0000\u209D\u0000\u20A0"
        + "\u0000\u20C1\u0000\u20D0\u0000\u20DD\u0000\u20E1\u0000\u20E2\u0000\u20E5\u0000\u20F1\u0000\u2100\u0000\u2102\u0000\u2103\u0000\u2107\u0000\u2108"
        + "\u0000\u210A\u0000\u210B\u0000\u210E\u0000\u2110\u0000\u2113\u0000\u2114\u0000\u2115\u0000\u2116\u0000\u2118\u0000\u2119\u0000\u211E\u0000\u2124"
        + "\u0000\u2125\u0000\u2126\u0000\u2127\u0000\u2128\u0000\u2129\u0000\u212A\u0000\u212E\u0000\u212F\u0000\u2130\u0000\u2134\u0000\u2135\u0000\u2139"
        + "\u0000\u213A\u0000\u213C\u0000\u213E\u0000\u2140\u0000\u2145\u0000\u2146\u0000\u214A\u0000\u214B\u0000\u214C\u0000\u214E\u0000\u214F\u0000\u2150"
        + "\u0000\u2160\u0000\u2183\u0000\u2184\u0000\u2185\u0000\u2189\u0000\u218A\u0000\u218C\u0000\u2190\u0000\u2195\u0000\u219A\u0000\u219C\u0000\u21A0"
        + "\u0000\u21A1\u0000\u21A3\u0000\u21A4\u0000\u21A6\u0000\u21A7\u0000\u21AE\u0000\u21AF\u0000\u21CE\u0000\u21D0\u0000\u21D2\u0000\u21D3\u0000\u21D4"
        + "\u0000\u21D5\u0000\u21F4\u0000\u2300\u0000\u2308\u0000\u2309\u0000\u230A\u0000\u230B\u0000\u230C\u0000\u2320\u0000\u2322\u0000\u2329\u0000\u232A"
