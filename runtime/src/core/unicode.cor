        + "\u0000\u058F\u0000\u0590\u0000\u0591\u0000\u05BE\u0000\u05BF\u0000\u05C0\u0000\u05C1\u0000\u05C3\u0000\u05C4\u0000\u05C6\u0000\u05C7\u0000\u05C8"
