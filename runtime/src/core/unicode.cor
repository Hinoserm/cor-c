    const string RunStarts =
          "\u0000\u0000\u0000\u0020\u0000\u0021\u0000\u0024\u0000\u0025\u0000\u0028\u0000\u0029\u0000\u002A\u0000\u002B\u0000\u002C\u0000\u002D\u0000\u002E"
