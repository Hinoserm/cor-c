// ---- Unicode: UTF-8 transcoding, case and categories ------------------------------------
//
// A string is UTF-16 code units, as C#'s is. Everything outside a program --
// a file, a terminal, a path handed to the kernel -- is bytes, and the bytes
// are UTF-8; the conversion between the two is here, in the runtime, so the
// printing routines and the standard library make it the same way.
//
// The case and category tables are the Unicode Character Database's
// (UnicodeData.txt, version 15.0), the same source .NET's invariant casing and
// char.GetUnicodeCategory answer from. They are written as string literals of
// UTF-16 code units: a literal is read-only data in the image, laid out exactly
// as the tables want to be read, with no code to build it at start-up. They
// were generated from UnicodeData.txt and are not edited by hand.

/// UTF-16 to UTF-8 and back.
///
/// Ill-formed input is what .NET's UTF8Encoding makes of it by default: an
/// unpaired surrogate encodes as U+FFFD's three bytes, and each maximal
/// ill-formed subsequence of bytes decodes as one U+FFFD (Unicode 15, 3.9,
/// "U+FFFD Substitution of Maximal Subparts").
static class Utf8Transcoder
{
    /// The code point of the pair at s[i], or of the unit alone; -1 for an
    /// unpaired surrogate, which has none.
    private static int CodePointAt(string s, int i, int end)
    {
        int c = Sys.GetChar(s, i);

        if (c < 0xD800 || c > 0xDFFF)
        {
            return c;
        }
        if (c <= 0xDBFF && i + 1 < end)
        {
            int d = Sys.GetChar(s, i + 1);
            if (d >= 0xDC00 && d <= 0xDFFF)
            {
                return 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00);
            }
        }
        return -1;
    }

    /// How many bytes s[at, at + count) is as UTF-8.
    public static int ByteCount(string s, int at, int count)
    {
        int end = at + count;
        int bytes = 0;
        int i = at;

        while (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c < 0x80) { bytes = bytes + 1; i = i + 1; continue; }
            if (c < 0x800) { bytes = bytes + 2; i = i + 1; continue; }

            int point = CodePointAt(s, i, end);
            if (point >= 0x10000) { bytes = bytes + 4; i = i + 2; continue; }
            bytes = bytes + 3;
            i = i + 1;
        }
        return bytes;
    }

    /// s[at, at + count) as UTF-8, written into `into` from `into[intoAt]`;
    /// answers how many bytes. `into` must have ByteCount's worth of room.
    public static int Encode(string s, int at, int count, byte[] into, int intoAt)
    {
        int end = at + count;
        int o = intoAt;
        int i = at;

        while (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c < 0x80)
            {
                into[o] = (byte)c;
                o = o + 1;
                i = i + 1;
                continue;
            }
            if (c < 0x800)
            {
                into[o] = (byte)(0xC0 | (c >> 6));
                into[o + 1] = (byte)(0x80 | (c & 0x3F));
                o = o + 2;
                i = i + 1;
                continue;
            }

            int point = CodePointAt(s, i, end);

            if (point >= 0x10000)
            {
                into[o] = (byte)(0xF0 | (point >> 18));
                into[o + 1] = (byte)(0x80 | ((point >> 12) & 0x3F));
                into[o + 2] = (byte)(0x80 | ((point >> 6) & 0x3F));
                into[o + 3] = (byte)(0x80 | (point & 0x3F));
                o = o + 4;
                i = i + 2;
                continue;
            }
            if (point < 0)
            {
                point = 0xFFFD;
            }
            into[o] = (byte)(0xE0 | (point >> 12));
            into[o + 1] = (byte)(0x80 | ((point >> 6) & 0x3F));
            into[o + 2] = (byte)(0x80 | (point & 0x3F));
            o = o + 3;
            i = i + 1;
        }
        return o - intoAt;
    }

    /// s[at, at + count) as UTF-8, written to memory at `address`; answers
    /// how many bytes. Allocates nothing: what a kernel writes a message with
    /// before it has a heap, and how a string is copied out to a user's
    /// buffer. The memory must have ByteCount's worth of room.
    public static int EncodeTo(string s, int at, int count, long address)
    {
        int end = at + count;
        long o = address;
        int i = at;

        while (i < end)
        {
            int c = Sys.GetChar(s, i);

            if (c < 0x80)
            {
                Sys.PokeByte(o, c);
                o = o + 1;
                i = i + 1;
                continue;
            }
            if (c < 0x800)
            {
                Sys.PokeByte(o, 0xC0 | (c >> 6));
                Sys.PokeByte(o + 1, 0x80 | (c & 0x3F));
                o = o + 2;
                i = i + 1;
                continue;
            }

            int point = CodePointAt(s, i, end);

            if (point >= 0x10000)
            {
                Sys.PokeByte(o, 0xF0 | (point >> 18));
                Sys.PokeByte(o + 1, 0x80 | ((point >> 12) & 0x3F));
                Sys.PokeByte(o + 2, 0x80 | ((point >> 6) & 0x3F));
                Sys.PokeByte(o + 3, 0x80 | (point & 0x3F));
                o = o + 4;
                i = i + 2;
                continue;
            }
            if (point < 0)
            {
                point = 0xFFFD;
            }
            Sys.PokeByte(o, 0xE0 | (point >> 12));
            Sys.PokeByte(o + 1, 0x80 | ((point >> 6) & 0x3F));
            Sys.PokeByte(o + 2, 0x80 | (point & 0x3F));
            o = o + 3;
            i = i + 1;
        }
        return (int)(o - address);
    }

    /// s[at, at + count) as a new array of its UTF-8.
    public static byte[] Encode(string s, int at, int count)
    {
        byte[] made = new byte[ByteCount(s, at, count)];
        Encode(s, at, count, made, 0);
        return made;
    }

    /// The same with a zero byte after it: what a C string, a path handed to
    /// the kernel, is.
    public static byte[] EncodeTerminated(string s)
    {
        int n = ByteCount(s, 0, s.Length);
        byte[] made = new byte[n + 1];
        Encode(s, 0, s.Length, made, 0);
        return made;
    }

    /// The length of the well-formed sequence starting with `lead` given what
    /// follows (Unicode 15, table 3-7), or minus the length of its maximal
    /// ill-formed subpart -- the bytes one U+FFFD stands for. `next` answers
    /// the byte at an offset from the lead, or -1 past the end.
    private static int Sequence(int lead, int b1, int b2, int b3)
    {
        if (lead < 0x80) return 1;
        if (lead < 0xC2 || lead > 0xF4) return -1;

        int lo = 0x80, hi = 0xBF;
        if (lead == 0xE0) lo = 0xA0;
        else if (lead == 0xED) hi = 0x9F;
        else if (lead == 0xF0) lo = 0x90;
        else if (lead == 0xF4) hi = 0x8F;

        if (b1 < lo || b1 > hi) return -1;
        if (lead < 0xE0) return 2;
        if (b2 < 0x80 || b2 > 0xBF) return -2;
        if (lead < 0xF0) return 3;
        if (b3 < 0x80 || b3 > 0xBF) return -3;
        return 4;
    }

    private static int ByteAt(byte[]? bytes, long address, int i, int end)
    {
        if (i >= end) return -1;
        return bytes != null ? bytes[i] : (int)Sys.PeekByte(address + i);
    }

    /// The UTF-16 length and, when `into` is given, the text of the UTF-8 in
    /// bytes[at, at + count) -- or, with no array, at the address.
    private static int Transcode(byte[]? bytes, long address, int at, int count, string? into)
    {
        int end = at + count;
        int i = at;
        int o = 0;
        // NEVER PAST THE STRING, whatever the bytes say now: sized by a first
        // pass over the same bytes, a string is overrun by a second pass that
        // reads them changed (another thread's store between the two).
        int limit = into != null ? into.Length : 0;

        while (i < end)
        {
            int lead = ByteAt(bytes, address, i, end);

            if (lead < 0x80)
            {
                if (into != null && o < limit) Sys.SetChar(into, o, lead);
                o = o + 1;
                i = i + 1;
                continue;
            }

            int length = Sequence(lead, ByteAt(bytes, address, i + 1, end),
                                  ByteAt(bytes, address, i + 2, end), ByteAt(bytes, address, i + 3, end));

            if (length < 0)
            {
                if (into != null && o < limit) Sys.SetChar(into, o, 0xFFFD);
                o = o + 1;
                i = i - length;
                continue;
            }

            int point;
            if (length == 2)
                point = ((lead & 0x1F) << 6) | (ByteAt(bytes, address, i + 1, end) & 0x3F);
            else if (length == 3)
                point = ((lead & 0x0F) << 12) | ((ByteAt(bytes, address, i + 1, end) & 0x3F) << 6)
                      | (ByteAt(bytes, address, i + 2, end) & 0x3F);
            else
                point = ((lead & 0x07) << 18) | ((ByteAt(bytes, address, i + 1, end) & 0x3F) << 12)
                      | ((ByteAt(bytes, address, i + 2, end) & 0x3F) << 6) | (ByteAt(bytes, address, i + 3, end) & 0x3F);

            if (point >= 0x10000)
            {
                if (into != null && o + 1 < limit)
                {
                    Sys.SetChar(into, o, 0xD800 + ((point - 0x10000) >> 10));
                    Sys.SetChar(into, o + 1, 0xDC00 + ((point - 0x10000) & 0x3FF));
                }
                o = o + 2;
            }
            else
            {
                if (into != null && o < limit) Sys.SetChar(into, o, point);
                o = o + 1;
            }
            i = i + length;
        }
        return o;
    }

    /// How many UTF-16 code units the UTF-8 in bytes[at, at + count) is.
    public static int CharCount(byte[] bytes, int at, int count)
    {
        return Transcode(bytes, 0, at, count, null);
    }

    /// The UTF-8 in bytes[at, at + count) as a string.
    public static string Decode(byte[] bytes, int at, int count)
    {
        string made = Sys.NewChars(Transcode(bytes, 0, at, count, null));
        Transcode(bytes, 0, at, count, made);
        return made;
    }

    /// The UTF-8 in `count` bytes of memory at `address` as a string: what
    /// the kernel hands a program (its arguments, its environment, a
    /// directory entry's name).
    public static string Decode(long address, int count)
    {
        // Read ONCE, into bytes nobody else can reach: the memory is a
        // program's, and another of its threads may be writing it.
        if (count <= 0) return "";
        byte[] bytes = new byte[count];
        Sys.MemoryCopy(Sys.ArrayData(bytes), address, count);
        return Decode(bytes, 0, count);
    }

    /// The zero-terminated UTF-8 at `address` as a string.
    public static string DecodeTerminated(long address)
    {
        int length = 0;
        while (Sys.PeekByte(address + length) != 0) { length = length + 1; }
        return Decode(address, length);
    }

    /// Whether bytes[at, at + count) is well-formed UTF-8; the index of the
    /// first byte that is not, or -1.
    public static int FirstInvalid(byte[] bytes, int at, int count)
    {
        int end = at + count;
        int i = at;

        while (i < end)
        {
            int lead = bytes[i];
            if (lead < 0x80) { i = i + 1; continue; }
            int length = Sequence(lead, ByteAt(bytes, 0, i + 1, end), ByteAt(bytes, 0, i + 2, end), ByteAt(bytes, 0, i + 3, end));
            if (length < 0) return i;
            i = i + length;
        }
        return -1;
    }

    /// The length of the maximal ill-formed subpart at bytes[i] (1 to 3), for
    /// a decoder that reports the bytes it could not decode.
    public static int InvalidLength(byte[] bytes, int i, int end)
    {
        int length = Sequence(bytes[i], ByteAt(bytes, 0, i + 1, end), ByteAt(bytes, 0, i + 2, end), ByteAt(bytes, 0, i + 3, end));
        return length < 0 ? -length : length;
    }
}

/// Invariant case: the Unicode simple case mappings, one code point to one, as
/// char.ToUpperInvariant, Rune.ToUpperInvariant and string.ToUpperInvariant
/// map. A code point with no mapping, a surrogate half among them, maps to
/// itself.
static class UnicodeCase
{
    // Runs of seven units: first, last and the delta added, each as two units
    // (high sixteen bits, then low), and the step -- 1 for a run of
    // consecutive code points, 2 for the alternating upper/lower pairs of
    // Latin Extended and its like. Sorted by first, and no two runs overlap.
    const string UpperRuns =
          "\u0000\u0061\u0000\u007A\uFFFF\uFFE0\u0001\u0000\u00B5\u0000\u00B5\u0000\u02E7\u0001\u0000\u00E0\u0000\u00F6\uFFFF\uFFE0\u0001\u0000\u00F8\u0000"
        + "\u00FE\uFFFF\uFFE0\u0001\u0000\u00FF\u0000\u00FF\u0000\u0079\u0001\u0000\u0101\u0000\u012F\uFFFF\uFFFF\u0002\u0000\u0131\u0000\u0131\uFFFF\uFF18"
        + "\u0001\u0000\u0133\u0000\u0137\uFFFF\uFFFF\u0002\u0000\u013A\u0000\u0148\uFFFF\uFFFF\u0002\u0000\u014B\u0000\u0177\uFFFF\uFFFF\u0002\u0000\u017A"
        + "\u0000\u017E\uFFFF\uFFFF\u0002\u0000\u017F\u0000\u017F\uFFFF\uFED4\u0001\u0000\u0180\u0000\u0180\u0000\u00C3\u0001\u0000\u0183\u0000\u0185\uFFFF"
        + "\uFFFF\u0002\u0000\u0188\u0000\u0188\uFFFF\uFFFF\u0001\u0000\u018C\u0000\u018C\uFFFF\uFFFF\u0001\u0000\u0192\u0000\u0192\uFFFF\uFFFF\u0001\u0000"
        + "\u0195\u0000\u0195\u0000\u0061\u0001\u0000\u0199\u0000\u0199\uFFFF\uFFFF\u0001\u0000\u019A\u0000\u019A\u0000\u00A3\u0001\u0000\u019E\u0000\u019E"
        + "\u0000\u0082\u0001\u0000\u01A1\u0000\u01A5\uFFFF\uFFFF\u0002\u0000\u01A8\u0000\u01A8\uFFFF\uFFFF\u0001\u0000\u01AD\u0000\u01AD\uFFFF\uFFFF\u0001"
        + "\u0000\u01B0\u0000\u01B0\uFFFF\uFFFF\u0001\u0000\u01B4\u0000\u01B6\uFFFF\uFFFF\u0002\u0000\u01B9\u0000\u01B9\uFFFF\uFFFF\u0001\u0000\u01BD\u0000"
        + "\u01BD\uFFFF\uFFFF\u0001\u0000\u01BF\u0000\u01BF\u0000\u0038\u0001\u0000\u01C5\u0000\u01C5\uFFFF\uFFFF\u0001\u0000\u01C6\u0000\u01C6\uFFFF\uFFFE"
        + "\u0001\u0000\u01C8\u0000\u01C8\uFFFF\uFFFF\u0001\u0000\u01C9\u0000\u01C9\uFFFF\uFFFE\u0001\u0000\u01CB\u0000\u01CB\uFFFF\uFFFF\u0001\u0000\u01CC"
        + "\u0000\u01CC\uFFFF\uFFFE\u0001\u0000\u01CE\u0000\u01DC\uFFFF\uFFFF\u0002\u0000\u01DD\u0000\u01DD\uFFFF\uFFB1\u0001\u0000\u01DF\u0000\u01EF\uFFFF"
        + "\uFFFF\u0002\u0000\u01F2\u0000\u01F2\uFFFF\uFFFF\u0001\u0000\u01F3\u0000\u01F3\uFFFF\uFFFE\u0001\u0000\u01F5\u0000\u01F5\uFFFF\uFFFF\u0001\u0000"
        + "\u01F9\u0000\u021F\uFFFF\uFFFF\u0002\u0000\u0223\u0000\u0233\uFFFF\uFFFF\u0002\u0000\u023C\u0000\u023C\uFFFF\uFFFF\u0001\u0000\u023F\u0000\u0240"
        + "\u0000\u2A3F\u0001\u0000\u0242\u0000\u0242\uFFFF\uFFFF\u0001\u0000\u0247\u0000\u024F\uFFFF\uFFFF\u0002\u0000\u0250\u0000\u0250\u0000\u2A1F\u0001"
        + "\u0000\u0251\u0000\u0251\u0000\u2A1C\u0001\u0000\u0252\u0000\u0252\u0000\u2A1E\u0001\u0000\u0253\u0000\u0253\uFFFF\uFF2E\u0001\u0000\u0254\u0000"
        + "\u0254\uFFFF\uFF32\u0001\u0000\u0256\u0000\u0257\uFFFF\uFF33\u0001\u0000\u0259\u0000\u0259\uFFFF\uFF36\u0001\u0000\u025B\u0000\u025B\uFFFF\uFF35"
        + "\u0001\u0000\u025C\u0000\u025C\u0000\uA54F\u0001\u0000\u0260\u0000\u0260\uFFFF\uFF33\u0001\u0000\u0261\u0000\u0261\u0000\uA54B\u0001\u0000\u0263"
        + "\u0000\u0263\uFFFF\uFF31\u0001\u0000\u0265\u0000\u0265\u0000\uA528\u0001\u0000\u0266\u0000\u0266\u0000\uA544\u0001\u0000\u0268\u0000\u0268\uFFFF"
        + "\uFF2F\u0001\u0000\u0269\u0000\u0269\uFFFF\uFF2D\u0001\u0000\u026A\u0000\u026A\u0000\uA544\u0001\u0000\u026B\u0000\u026B\u0000\u29F7\u0001\u0000"
        + "\u026C\u0000\u026C\u0000\uA541\u0001\u0000\u026F\u0000\u026F\uFFFF\uFF2D\u0001\u0000\u0271\u0000\u0271\u0000\u29FD\u0001\u0000\u0272\u0000\u0272"
        + "\uFFFF\uFF2B\u0001\u0000\u0275\u0000\u0275\uFFFF\uFF2A\u0001\u0000\u027D\u0000\u027D\u0000\u29E7\u0001\u0000\u0280\u0000\u0280\uFFFF\uFF26\u0001"
        + "\u0000\u0282\u0000\u0282\u0000\uA543\u0001\u0000\u0283\u0000\u0283\uFFFF\uFF26\u0001\u0000\u0287\u0000\u0287\u0000\uA52A\u0001\u0000\u0288\u0000"
        + "\u0288\uFFFF\uFF26\u0001\u0000\u0289\u0000\u0289\uFFFF\uFFBB\u0001\u0000\u028A\u0000\u028B\uFFFF\uFF27\u0001\u0000\u028C\u0000\u028C\uFFFF\uFFB9"
        + "\u0001\u0000\u0292\u0000\u0292\uFFFF\uFF25\u0001\u0000\u029D\u0000\u029D\u0000\uA515\u0001\u0000\u029E\u0000\u029E\u0000\uA512\u0001\u0000\u0345"
        + "\u0000\u0345\u0000\u0054\u0001\u0000\u0371\u0000\u0373\uFFFF\uFFFF\u0002\u0000\u0377\u0000\u0377\uFFFF\uFFFF\u0001\u0000\u037B\u0000\u037D\u0000"
        + "\u0082\u0001\u0000\u03AC\u0000\u03AC\uFFFF\uFFDA\u0001\u0000\u03AD\u0000\u03AF\uFFFF\uFFDB\u0001\u0000\u03B1\u0000\u03C1\uFFFF\uFFE0\u0001\u0000"
        + "\u03C2\u0000\u03C2\uFFFF\uFFE1\u0001\u0000\u03C3\u0000\u03CB\uFFFF\uFFE0\u0001\u0000\u03CC\u0000\u03CC\uFFFF\uFFC0\u0001\u0000\u03CD\u0000\u03CE"
        + "\uFFFF\uFFC1\u0001\u0000\u03D0\u0000\u03D0\uFFFF\uFFC2\u0001\u0000\u03D1\u0000\u03D1\uFFFF\uFFC7\u0001\u0000\u03D5\u0000\u03D5\uFFFF\uFFD1\u0001"
        + "\u0000\u03D6\u0000\u03D6\uFFFF\uFFCA\u0001\u0000\u03D7\u0000\u03D7\uFFFF\uFFF8\u0001\u0000\u03D9\u0000\u03EF\uFFFF\uFFFF\u0002\u0000\u03F0\u0000"
        + "\u03F0\uFFFF\uFFAA\u0001\u0000\u03F1\u0000\u03F1\uFFFF\uFFB0\u0001\u0000\u03F2\u0000\u03F2\u0000\u0007\u0001\u0000\u03F3\u0000\u03F3\uFFFF\uFF8C"
        + "\u0001\u0000\u03F5\u0000\u03F5\uFFFF\uFFA0\u0001\u0000\u03F8\u0000\u03F8\uFFFF\uFFFF\u0001\u0000\u03FB\u0000\u03FB\uFFFF\uFFFF\u0001\u0000\u0430"
        + "\u0000\u044F\uFFFF\uFFE0\u0001\u0000\u0450\u0000\u045F\uFFFF\uFFB0\u0001\u0000\u0461\u0000\u0481\uFFFF\uFFFF\u0002\u0000\u048B\u0000\u04BF\uFFFF"
        + "\uFFFF\u0002\u0000\u04C2\u0000\u04CE\uFFFF\uFFFF\u0002\u0000\u04CF\u0000\u04CF\uFFFF\uFFF1\u0001\u0000\u04D1\u0000\u052F\uFFFF\uFFFF\u0002\u0000"
        + "\u0561\u0000\u0586\uFFFF\uFFD0\u0001\u0000\u10D0\u0000\u10FA\u0000\u0BC0\u0001\u0000\u10FD\u0000\u10FF\u0000\u0BC0\u0001\u0000\u13F8\u0000\u13FD"
        + "\uFFFF\uFFF8\u0001\u0000\u1C80\u0000\u1C80\uFFFF\uE792\u0001\u0000\u1C81\u0000\u1C81\uFFFF\uE793\u0001\u0000\u1C82\u0000\u1C82\uFFFF\uE79C\u0001"
        + "\u0000\u1C83\u0000\u1C84\uFFFF\uE79E\u0001\u0000\u1C85\u0000\u1C85\uFFFF\uE79D\u0001\u0000\u1C86\u0000\u1C86\uFFFF\uE7A4\u0001\u0000\u1C87\u0000"
        + "\u1C87\uFFFF\uE7DB\u0001\u0000\u1C88\u0000\u1C88\u0000\u89C2\u0001\u0000\u1D79\u0000\u1D79\u0000\u8A04\u0001\u0000\u1D7D\u0000\u1D7D\u0000\u0EE6"
        + "\u0001\u0000\u1D8E\u0000\u1D8E\u0000\u8A38\u0001\u0000\u1E01\u0000\u1E95\uFFFF\uFFFF\u0002\u0000\u1E9B\u0000\u1E9B\uFFFF\uFFC5\u0001\u0000\u1EA1"
        + "\u0000\u1EFF\uFFFF\uFFFF\u0002\u0000\u1F00\u0000\u1F07\u0000\u0008\u0001\u0000\u1F10\u0000\u1F15\u0000\u0008\u0001\u0000\u1F20\u0000\u1F27\u0000"
        + "\u0008\u0001\u0000\u1F30\u0000\u1F37\u0000\u0008\u0001\u0000\u1F40\u0000\u1F45\u0000\u0008\u0001\u0000\u1F51\u0000\u1F57\u0000\u0008\u0002\u0000"
        + "\u1F60\u0000\u1F67\u0000\u0008\u0001\u0000\u1F70\u0000\u1F71\u0000\u004A\u0001\u0000\u1F72\u0000\u1F75\u0000\u0056\u0001\u0000\u1F76\u0000\u1F77"
        + "\u0000\u0064\u0001\u0000\u1F78\u0000\u1F79\u0000\u0080\u0001\u0000\u1F7A\u0000\u1F7B\u0000\u0070\u0001\u0000\u1F7C\u0000\u1F7D\u0000\u007E\u0001"
