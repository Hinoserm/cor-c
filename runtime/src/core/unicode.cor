        + "\u0000\u0C04\u0000\u0C05\u0000\u0C0D\u0000\u0C0E\u0000\u0C11\u0000\u0C12\u0000\u0C29\u0000\u0C2A\u0000\u0C3A\u0000\u0C3C\u0000\u0C3D\u0000\u0C3E"
        + "\u0000\u0C41\u0000\u0C45\u0000\u0C46\u0000\u0C49\u0000\u0C4A\u0000\u0C4E\u0000\u0C55\u0000\u0C57\u0000\u0C58\u0000\u0C5B\u0000\u0C5D\u0000\u0C5E"
