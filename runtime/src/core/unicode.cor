        + "\u0000\u0C85\u0000\u0C8D\u0000\u0C8E\u0000\u0C91\u0000\u0C92\u0000\u0CA9\u0000\u0CAA\u0000\u0CB4\u0000\u0CB5\u0000\u0CBA\u0000\u0CBC\u0000\u0CBD"
        + "\u0000\u0CBE\u0000\u0CBF\u0000\u0CC0\u0000\u0CC5\u0000\u0CC6\u0000\u0CC7\u0000\u0CC9\u0000\u0CCA\u0000\u0CCC\u0000\u0CCE\u0000\u0CD5\u0000\u0CD7"
        + "\u0000\u0CDD\u0000\u0CDF\u0000\u0CE0\u0000\u0CE2\u0000\u0CE4\u0000\u0CE6\u0000\u0CF0\u0000\u0CF1\u0000\u0CF3\u0000\u0CF4\u0000\u0D00\u0000\u0D02"
        + "\u0000\u0D04\u0000\u0D0D\u0000\u0D0E\u0000\u0D11\u0000\u0D12\u0000\u0D3B\u0000\u0D3D\u0000\u0D3E\u0000\u0D41\u0000\u0D45\u0000\u0D46\u0000\u0D49"
        + "\u0000\u0D4A\u0000\u0D4D\u0000\u0D4E\u0000\u0D4F\u0000\u0D50\u0000\u0D54\u0000\u0D57\u0000\u0D58\u0000\u0D5F\u0000\u0D62\u0000\u0D64\u0000\u0D66"
        + "\u0000\u0D70\u0000\u0D79\u0000\u0D7A\u0000\u0D80\u0000\u0D81\u0000\u0D82\u0000\u0D84\u0000\u0D85\u0000\u0D97\u0000\u0D9A\u0000\u0DB2\u0000\u0DB3"
        + "\u0000\u0DBC\u0000\u0DBD\u0000\u0DBE\u0000\u0DC0\u0000\u0DC7\u0000\u0DCA\u0000\u0DCB\u0000\u0DCF\u0000\u0DD2\u0000\u0DD5\u0000\u0DD6\u0000\u0DD7"
        + "\u0000\u0DD8\u0000\u0DE0\u0000\u0DE6\u0000\u0DF0\u0000\u0DF2\u0000\u0DF4\u0000\u0DF5\u0000\u0E01\u0000\u0E31\u0000\u0E32\u0000\u0E34\u0000\u0E3B"
        + "\u0000\u0E3F\u0000\u0E40\u0000\u0E46\u0000\u0E47\u0000\u0E4F\u0000\u0E50\u0000\u0E5A\u0000\u0E5C\u0000\u0E81\u0000\u0E83\u0000\u0E84\u0000\u0E85"
        + "\u0000\u0E86\u0000\u0E8B\u0000\u0E8C\u0000\u0EA4\u0000\u0EA5\u0000\u0EA6\u0000\u0EA7\u0000\u0EB1\u0000\u0EB2\u0000\u0EB4\u0000\u0EBD\u0000\u0EBE"
        + "\u0000\u0EC0\u0000\u0EC5\u0000\u0EC6\u0000\u0EC7\u0000\u0EC8\u0000\u0ECF\u0000\u0ED0\u0000\u0EDA\u0000\u0EDC\u0000\u0EE0\u0000\u0F00\u0000\u0F01"
        + "\u0000\u0F04\u0000\u0F13\u0000\u0F14\u0000\u0F15\u0000\u0F18\u0000\u0F1A\u0000\u0F20\u0000\u0F2A\u0000\u0F34\u0000\u0F35\u0000\u0F36\u0000\u0F37"
        + "\u0000\u0F38\u0000\u0F39\u0000\u0F3A\u0000\u0F3B\u0000\u0F3C\u0000\u0F3D\u0000\u0F3E\u0000\u0F40\u0000\u0F48\u0000\u0F49\u0000\u0F6D\u0000\u0F71"
        + "\u0000\u0F7F\u0000\u0F80\u0000\u0F85\u0000\u0F86\u0000\u0F88\u0000\u0F8D\u0000\u0F98\u0000\u0F99\u0000\u0FBD\u0000\u0FBE\u0000\u0FC6\u0000\u0FC7"
        + "\u0000\u0FCD\u0000\u0FCE\u0000\u0FD0\u0000\u0FD5\u0000\u0FD9\u0000\u0FDB\u0000\u1000\u0000\u102B\u0000\u102D\u0000\u1031\u0000\u1032\u0000\u1038"
        + "\u0000\u1039\u0000\u103B\u0000\u103D\u0000\u103F\u0000\u1040\u0000\u104A\u0000\u1050\u0000\u1056\u0000\u1058\u0000\u105A\u0000\u105E\u0000\u1061"
        + "\u0000\u1062\u0000\u1065\u0000\u1067\u0000\u106E\u0000\u1071\u0000\u1075\u0000\u1082\u0000\u1083\u0000\u1085\u0000\u1087\u0000\u108D\u0000\u108E"
        + "\u0000\u108F\u0000\u1090\u0000\u109A\u0000\u109D\u0000\u109E\u0000\u10A0\u0000\u10C6\u0000\u10C7\u0000\u10C8\u0000\u10CD\u0000\u10CE\u0000\u10D0"
        + "\u0000\u10FB\u0000\u10FC\u0000\u10FD\u0000\u1100\u0000\u1249\u0000\u124A\u0000\u124E\u0000\u1250\u0000\u1257\u0000\u1258\u0000\u1259\u0000\u125A"
        + "\u0000\u125E\u0000\u1260\u0000\u1289\u0000\u128A\u0000\u128E\u0000\u1290\u0000\u12B1\u0000\u12B2\u0000\u12B6\u0000\u12B8\u0000\u12BF\u0000\u12C0"
        + "\u0000\u12C1\u0000\u12C2\u0000\u12C6\u0000\u12C8\u0000\u12D7\u0000\u12D8\u0000\u1311\u0000\u1312\u0000\u1316\u0000\u1318\u0000\u135B\u0000\u135D"
        + "\u0000\u1360\u0000\u1369\u0000\u137D\u0000\u1380\u0000\u1390\u0000\u139A\u0000\u13A0\u0000\u13F6\u0000\u13F8\u0000\u13FE\u0000\u1400\u0000\u1401"
        + "\u0000\u166D\u0000\u166E\u0000\u166F\u0000\u1680\u0000\u1681\u0000\u169B\u0000\u169C\u0000\u169D\u0000\u16A0\u0000\u16EB\u0000\u16EE\u0000\u16F1"
        + "\u0000\u16F9\u0000\u1700\u0000\u1712\u0000\u1715\u0000\u1716\u0000\u171F\u0000\u1732\u0000\u1734\u0000\u1735\u0000\u1737\u0000\u1740\u0000\u1752"
        + "\u0000\u1754\u0000\u1760\u0000\u176D\u0000\u176E\u0000\u1771\u0000\u1772\u0000\u1774\u0000\u1780\u0000\u17B4\u0000\u17B6\u0000\u17B7\u0000\u17BE"
        + "\u0000\u17C6\u0000\u17C7\u0000\u17C9\u0000\u17D4\u0000\u17D7\u0000\u17D8\u0000\u17DB\u0000\u17DC\u0000\u17DD\u0000\u17DE\u0000\u17E0\u0000\u17EA"
        + "\u0000\u17F0\u0000\u17FA\u0000\u1800\u0000\u1806\u0000\u1807\u0000\u180B\u0000\u180E\u0000\u180F\u0000\u1810\u0000\u181A\u0000\u1820\u0000\u1843"
        + "\u0000\u1844\u0000\u1879\u0000\u1880\u0000\u1885\u0000\u1887\u0000\u18A9\u0000\u18AA\u0000\u18AB\u0000\u18B0\u0000\u18F6\u0000\u1900\u0000\u191F"
        + "\u0000\u1920\u0000\u1923\u0000\u1927\u0000\u1929\u0000\u192C\u0000\u1930\u0000\u1932\u0000\u1933\u0000\u1939\u0000\u193C\u0000\u1940\u0000\u1941"
        + "\u0000\u1944\u0000\u1946\u0000\u1950\u0000\u196E\u0000\u1970\u0000\u1975\u0000\u1980\u0000\u19AC\u0000\u19B0\u0000\u19CA\u0000\u19D0\u0000\u19DA"
