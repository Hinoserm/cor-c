        + "\u0000\u1EA0\u0000\u1EFE\u0000\u0001\u0002\u0000\u1F08\u0000\u1F0F\uFFFF\uFFF8\u0001\u0000\u1F18\u0000\u1F1D\uFFFF\uFFF8\u0001\u0000\u1F28\u0000"
        + "\u1F2F\uFFFF\uFFF8\u0001\u0000\u1F38\u0000\u1F3F\uFFFF\uFFF8\u0001\u0000\u1F48\u0000\u1F4D\uFFFF\uFFF8\u0001\u0000\u1F59\u0000\u1F5F\uFFFF\uFFF8"
        + "\u0002\u0000\u1F68\u0000\u1F6F\uFFFF\uFFF8\u0001\u0000\u1F88\u0000\u1F8F\uFFFF\uFFF8\u0001\u0000\u1F98\u0000\u1F9F\uFFFF\uFFF8\u0001\u0000\u1FA8"
        + "\u0000\u1FAF\uFFFF\uFFF8\u0001\u0000\u1FB8\u0000\u1FB9\uFFFF\uFFF8\u0001\u0000\u1FBA\u0000\u1FBB\uFFFF\uFFB6\u0001\u0000\u1FBC\u0000\u1FBC\uFFFF"
        + "\uFFF7\u0001\u0000\u1FC8\u0000\u1FCB\uFFFF\uFFAA\u0001\u0000\u1FCC\u0000\u1FCC\uFFFF\uFFF7\u0001\u0000\u1FD8\u0000\u1FD9\uFFFF\uFFF8\u0001\u0000"
        + "\u1FDA\u0000\u1FDB\uFFFF\uFF9C\u0001\u0000\u1FE8\u0000\u1FE9\uFFFF\uFFF8\u0001\u0000\u1FEA\u0000\u1FEB\uFFFF\uFF90\u0001\u0000\u1FEC\u0000\u1FEC"
        + "\uFFFF\uFFF9\u0001\u0000\u1FF8\u0000\u1FF9\uFFFF\uFF80\u0001\u0000\u1FFA\u0000\u1FFB\uFFFF\uFF82\u0001\u0000\u1FFC\u0000\u1FFC\uFFFF\uFFF7\u0001"
        + "\u0000\u2126\u0000\u2126\uFFFF\uE2A3\u0001\u0000\u212A\u0000\u212A\uFFFF\uDF41\u0001\u0000\u212B\u0000\u212B\uFFFF\uDFBA\u0001\u0000\u2132\u0000"
        + "\u2132\u0000\u001C\u0001\u0000\u2160\u0000\u216F\u0000\u0010\u0001\u0000\u2183\u0000\u2183\u0000\u0001\u0001\u0000\u24B6\u0000\u24CF\u0000\u001A"
        + "\u0001\u0000\u2C00\u0000\u2C2F\u0000\u0030\u0001\u0000\u2C60\u0000\u2C60\u0000\u0001\u0001\u0000\u2C62\u0000\u2C62\uFFFF\uD609\u0001\u0000\u2C63"
