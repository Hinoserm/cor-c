        + "\u0000\u24EA\u0000\u2500\u0000\u25B7\u0000\u25B8\u0000\u25C1\u0000\u25C2\u0000\u25F8\u0000\u2600\u0000\u266F\u0000\u2670\u0000\u2768\u0000\u2769"
