        + "\u0000\u0A51\u0000\u0A52\u0000\u0A59\u0000\u0A5D\u0000\u0A5E\u0000\u0A5F\u0000\u0A66\u0000\u0A70\u0000\u0A72\u0000\u0A75\u0000\u0A76\u0000\u0A77"
        + "\u0000\u0A81\u0000\u0A83\u0000\u0A84\u0000\u0A85\u0000\u0A8E\u0000\u0A8F\u0000\u0A92\u0000\u0A93\u0000\u0AA9\u0000\u0AAA\u0000\u0AB1\u0000\u0AB2"
        + "\u0000\u0AB4\u0000\u0AB5\u0000\u0ABA\u0000\u0ABC\u0000\u0ABD\u0000\u0ABE\u0000\u0AC1\u0000\u0AC6\u0000\u0AC7\u0000\u0AC9\u0000\u0ACA\u0000\u0ACB"
        + "\u0000\u0ACD\u0000\u0ACE\u0000\u0AD0\u0000\u0AD1\u0000\u0AE0\u0000\u0AE2\u0000\u0AE4\u0000\u0AE6\u0000\u0AF0\u0000\u0AF1\u0000\u0AF2\u0000\u0AF9"
        + "\u0000\u0AFA\u0000\u0B00\u0000\u0B01\u0000\u0B02\u0000\u0B04\u0000\u0B05\u0000\u0B0D\u0000\u0B0F\u0000\u0B11\u0000\u0B13\u0000\u0B29\u0000\u0B2A"
        + "\u0000\u0B31\u0000\u0B32\u0000\u0B34\u0000\u0B35\u0000\u0B3A\u0000\u0B3C\u0000\u0B3D\u0000\u0B3E\u0000\u0B3F\u0000\u0B40\u0000\u0B41\u0000\u0B45"
