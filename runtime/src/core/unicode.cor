        + "\u0000\u007B\u0000\u007C\u0000\u007D\u0000\u007E\u0000\u007F\u0000\u00A0\u0000\u00A1\u0000\u00A2\u0000\u00A6\u0000\u00A7\u0000\u00A8\u0000\u00A9"
        + "\u0000\u00AA\u0000\u00AB\u0000\u00AC\u0000\u00AD\u0000\u00AE\u0000\u00AF\u0000\u00B0\u0000\u00B1\u0000\u00B2\u0000\u00B4\u0000\u00B5\u0000\u00B6"
        + "\u0000\u00B8\u0000\u00B9\u0000\u00BA\u0000\u00BB\u0000\u00BC\u0000\u00BF\u0000\u00C0\u0000\u00D7\u0000\u00D8\u0000\u00DF\u0000\u00F7\u0000\u00F8"
        + "\u0000\u0100\u0000\u0101\u0000\u0102\u0000\u0103\u0000\u0104\u0000\u0105\u0000\u0106\u0000\u0107\u0000\u0108\u0000\u0109\u0000\u010A\u0000\u010B"
        + "\u0000\u010C\u0000\u010D\u0000\u010E\u0000\u010F\u0000\u0110\u0000\u0111\u0000\u0112\u0000\u0113\u0000\u0114\u0000\u0115\u0000\u0116\u0000\u0117"
        + "\u0000\u0118\u0000\u0119\u0000\u011A\u0000\u011B\u0000\u011C\u0000\u011D\u0000\u011E\u0000\u011F\u0000\u0120\u0000\u0121\u0000\u0122\u0000\u0123"
        + "\u0000\u0124\u0000\u0125\u0000\u0126\u0000\u0127\u0000\u0128\u0000\u0129\u0000\u012A\u0000\u012B\u0000\u012C\u0000\u012D\u0000\u012E\u0000\u012F"
        + "\u0000\u0130\u0000\u0131\u0000\u0132\u0000\u0133\u0000\u0134\u0000\u0135\u0000\u0136\u0000\u0137\u0000\u0139\u0000\u013A\u0000\u013B\u0000\u013C"
        + "\u0000\u013D\u0000\u013E\u0000\u013F\u0000\u0140\u0000\u0141\u0000\u0142\u0000\u0143\u0000\u0144\u0000\u0145\u0000\u0146\u0000\u0147\u0000\u0148"
        + "\u0000\u014A\u0000\u014B\u0000\u014C\u0000\u014D\u0000\u014E\u0000\u014F\u0000\u0150\u0000\u0151\u0000\u0152\u0000\u0153\u0000\u0154\u0000\u0155"
