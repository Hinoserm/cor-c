        + "\uD5E4\u0001\u0000\u2C6E\u0000\u2C6E\uFFFF\uD603\u0001\u0000\u2C6F\u0000\u2C6F\uFFFF\uD5E1\u0001\u0000\u2C70\u0000\u2C70\uFFFF\uD5E2\u0001\u0000"
        + "\u2C72\u0000\u2C72\u0000\u0001\u0001\u0000\u2C75\u0000\u2C75\u0000\u0001\u0001\u0000\u2C7E\u0000\u2C7F\uFFFF\uD5C1\u0001\u0000\u2C80\u0000\u2CE2"
        + "\u0000\u0001\u0002\u0000\u2CEB\u0000\u2CED\u0000\u0001\u0002\u0000\u2CF2\u0000\u2CF2\u0000\u0001\u0001\u0000\uA640\u0000\uA66C\u0000\u0001\u0002"
        + "\u0000\uA680\u0000\uA69A\u0000\u0001\u0002\u0000\uA722\u0000\uA72E\u0000\u0001\u0002\u0000\uA732\u0000\uA76E\u0000\u0001\u0002\u0000\uA779\u0000"
        + "\uA77B\u0000\u0001\u0002\u0000\uA77D\u0000\uA77D\uFFFF\u75FC\u0001\u0000\uA77E\u0000\uA786\u0000\u0001\u0002\u0000\uA78B\u0000\uA78B\u0000\u0001"
        + "\u0001\u0000\uA78D\u0000\uA78D\uFFFF\u5AD8\u0001\u0000\uA790\u0000\uA792\u0000\u0001\u0002\u0000\uA796\u0000\uA7A8\u0000\u0001\u0002\u0000\uA7AA"
        + "\u0000\uA7AA\uFFFF\u5ABC\u0001\u0000\uA7AB\u0000\uA7AB\uFFFF\u5AB1\u0001\u0000\uA7AC\u0000\uA7AC\uFFFF\u5AB5\u0001\u0000\uA7AD\u0000\uA7AD\uFFFF"
        + "\u5ABF\u0001\u0000\uA7AE\u0000\uA7AE\uFFFF\u5ABC\u0001\u0000\uA7B0\u0000\uA7B0\uFFFF\u5AEE\u0001\u0000\uA7B1\u0000\uA7B1\uFFFF\u5AD6\u0001\u0000"
        + "\uA7B2\u0000\uA7B2\uFFFF\u5AEB\u0001\u0000\uA7B3\u0000\uA7B3\u0000\u03A0\u0001\u0000\uA7B4\u0000\uA7C2\u0000\u0001\u0002\u0000\uA7C4\u0000\uA7C4"
        + "\uFFFF\uFFD0\u0001\u0000\uA7C5\u0000\uA7C5\uFFFF\u5ABD\u0001\u0000\uA7C6\u0000\uA7C6\uFFFF\u75C8\u0001\u0000\uA7C7\u0000\uA7C9\u0000\u0001\u0002"
        + "\u0000\uA7D0\u0000\uA7D0\u0000\u0001\u0001\u0000\uA7D6\u0000\uA7D8\u0000\u0001\u0002\u0000\uA7F5\u0000\uA7F5\u0000\u0001\u0001\u0000\uFF21\u0000"
        + "\uFF3A\u0000\u0020\u0001\u0001\u0400\u0001\u0427\u0000\u0028\u0001\u0001\u04B0\u0001\u04D3\u0000\u0028\u0001\u0001\u0570\u0001\u057A\u0000\u0027"
        + "\u0001\u0001\u057C\u0001\u058A\u0000\u0027\u0001\u0001\u058C\u0001\u0592\u0000\u0027\u0001\u0001\u0594\u0001\u0595\u0000\u0027\u0001\u0001\u0C80"
        + "\u0001\u0CB2\u0000\u0040\u0001\u0001\u18A0\u0001\u18BF\u0000\u0020\u0001\u0001\u6E40\u0001\u6E5F\u0000\u0020\u0001\u0001\uE900\u0001\uE921\u0000"
        + "\u0022\u0001";

    private static int Field(string runs, int at)
    {
        return (runs[at] << 16) | runs[at + 1];
    }

    private static int Map(string runs, int c)
    {
        int low = 0;
        int high = runs.Length / 7 - 1;

        while (low <= high)
        {
            int mid = (low + high) >> 1;
            int first = Field(runs, mid * 7);
            int last = Field(runs, mid * 7 + 2);

            if (c < first) { high = mid - 1; continue; }
            if (c > last) { low = mid + 1; continue; }
            if ((c - first) % runs[mid * 7 + 6] != 0) return c;
            return c + Field(runs, mid * 7 + 4);
        }
        return c;
    }

    public static int Upper(int c)
    {
        if (c < 0x80) return c >= 97 && c <= 122 ? c - 32 : c;
        return Map(UpperRuns, c);
    }

    public static int Lower(int c)
    {
        if (c < 0x80) return c >= 65 && c <= 90 ? c + 32 : c;
        return Map(LowerRuns, c);
    }
}

/// The Unicode general category of a code point, numbered as .NET's
/// System.Globalization.UnicodeCategory numbers them: UppercaseLetter 0,
/// LowercaseLetter 1, ... OtherNotAssigned 29.
static class UnicodeCategories
{
    // Where each run of one category begins, as two units (the code point's
    // high and low sixteen bits), and the category of each run. The first run
