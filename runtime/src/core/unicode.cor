    public static double Of(int codePoint)
    {
        int low = 0;
        int high = Values.Length / 6 - 1;

        while (low <= high)
        {
            int mid = (low + high) >> 1;
            int at = mid * 6;
            int point = (Values[at] << 16) | Values[at + 1];

            if (codePoint < point) { high = mid - 1; continue; }
            if (codePoint > point) { low = mid + 1; continue; }

            long numerator = ((long)Values[at + 2] << 32) | ((long)Values[at + 3] << 16) | Values[at + 4];
            if ((numerator & 0x800000000000L) != 0) numerator = numerator - 0x1000000000000L;
            return (double)numerator / Values[at + 5];
        }
        return -1.0;
    }
