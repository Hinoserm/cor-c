// The memory library: a garbage-collected heap, so a program only ever says
// `new` and nothing about memory at all.
//
// Runtime.Alloc, AllocLeaf and AllocObject are the calls the compiler makes
// for memory (docs/X86-BACKEND.md, "Memory"), and they come here: a free-list
// heap with boundary-tag coalescing and a concurrent mark-sweep collector,
// memory from the operating system through Platform.Map in chunks, given back
// when a chunk empties.
//
// NON-MOVING, and PRECISE WHERE IT CAN BE. The stacks, the registers, the
// statics and every block the compiler cannot describe -- a struct's block,
// a cell, a coroutine's frame -- are read word by word: every word that
// lands on a live block keeps it, and nothing is ever moved, because a word
// only guessed to be a pointer cannot be updated. Being wrong that way
// retains something already dead; being wrong the other way frees something
// in use. So every uncertainty is resolved towards keeping. An OBJECT --
// a class instance, a box, a closure, an array (KindObject) -- is read by its
// descriptor's reference map, and a string or a byte array not at all.
//
// GENERATIONAL where the platform allows it (the generations section below):
// most collections are minor ones that mark, index and sweep only what was
// allocated since the last.
//
// The collector is the last of four places an object can live: static data,
// the frame, owned by one owner and freed by the compiler, and here. What the
// compiler can prove never reaches this file.
//
// THREE MODULES, the seams the memory library is built along:
//
//   HeapChunks   memory from the operating system: the chunk list, the cap,
//                which chunk an address is in. Knows nothing about blocks.
//   GcRoots      where the roots are: the stack, the registers, the statics,
//                and the ranges registered with it.
//   Gc           blocks, the free list, allocation, marking and the sweep.
//                The block layout below is Gc's alone.

// ---- what a block looks like ------------------------------------------------
//
// Sizes are multiples of eight, so the low three bits of the size word carry
// the flags. Offsets are in bytes; a word is four.
//
//   +0          size | flags                    (the header word)
//   +W          the next free block             while it is free
//   +2W         the payload, the address handed out; 8-aligned
//   +2W         the PREVIOUS free block          while it is free
//   +size-W     size | flags again               (the footer word)
// Every free block, large or small, is on its bin's list through those two
// words, which are payload again once the block is allocated. W is the
// machine word (WordSize.Bytes):
// four on i386, where every offset here is the one the collector was written
// with, and eight in long mode.
//
// The size is at BOTH ENDS on purpose, and that is what makes coalescing
// possible: the block after this one is at +size, and the one BEFORE it can
// only be found by reading backwards, through its footer. Removing a neighbour
// uses its links in its bin's list.
//
// A payload is 8-aligned because the block is and the header is two words,
// which is what a long or a double field in an object needs.
//
// A BLOCK IN A SIZE-CLASS PAGE HAS NO FOOTER (size classes, below):
//
//   +0          size | flags                    (the header word)
//   +W          the next free block             while it is free
//   +2W         the payload, to +size
//
// Its page already says what the footer would: every block of the page is
// its class's size, on its class's grid from the page's first block, so the
// block below one is one class size down and a block's end is where the
// next slot begins. A page never merges, so nothing reads backwards through
// it either. The word is payload instead -- four bytes of every small object
// on i386, and most objects are small -- and a class's block is its payload
// and its header rounded to eight, no more (ClassRounding).
//
// So whatever reads a block's END must know which kind of chunk it is in:
// TailIn says what follows the payload, nothing in a page and the footer
// elsewhere, and Whole is the test of a block's integrity that the footer
// agreeing with the header was -- in a page, the class's size on the
// class's grid. A footer is never written into a page: there it would be
// the last word of somebody's object.

// ---- what a chunk looks like ------------------------------------------------
//
// The heap is a list of chunks from the operating system, each carrying a
// small record in its own first bytes -- so taking a chunk never itself needs
// an allocation, which matters because a chunk is taken exactly when the
// heap cannot allocate anything:
//
//   +0    next chunk, or 0
//   +W    end: one past the last block laid down (the bump pointer's floor)
//   +2W   limit: one past the chunk's memory
//   +3W   raw page-anchor table, or 0 when not allocated
//   +4W   flags: young (allocated in since the last collection)
//   +5W   the live bytes the last sweep of it found
//   +6W   the live blocks the last sweep of it found
//   +8W   the first block (8-aligned on both word sizes)
//
// The record is not a block and is never swept.

public static class Gc
{
    // AN ADDRESS IS A nuint (Sys's), and so is a length in memory: one
    // register on i386. These layout figures are ints, which a nuint's sum
    // and a long's count take alike.
    const int HeaderBytes = 2 * WordSize.Bytes;
    const int FooterBytes = WordSize.Bytes;
    const int Overhead = 3 * WordSize.Bytes;
    // What a request is rounded by for a block of a size-class page: the
    // header and no footer ("what a block looks like").
    const int ClassRounding = HeaderBytes + 7;

    /// A mixed chunk's block for a request: its header, payload and footer,
    /// rounded to eight, and never below Smallest -- in long mode a request
    /// of nothing is 24 bytes, which no walk of a mixed chunk steps over.
    static nuint MixedNeed(nuint bytes)
    {
        nuint need = (bytes + Overhead + 7) & SizeMask;
        return need < Smallest ? Smallest : need;
    }

    const int FlagFree = 1;
    const int FlagMark = 2;
    const int FlagScan = 4;
    const int FlagMask = 7;
    // The header word less its flags: the block's size.
    const nuint SizeMask = ~(nuint)FlagMask;

    // THE HEADER'S SECOND WORD SAYS WHAT A LIVE BLOCK HOLDS. Free, it is the
    // free list's link -- a block's address, a multiple of eight, or 0 --
    // and every allocation writes it: 0 for a block that may hold
    // references, KindLeaf for one that cannot (a string, an array of
    // bytes or characters, Runtime.AllocLeaf). A leaf is marked and never
    // scanned. Scanning every word of every live block was most of a
    // collection's work: the kernel's registry, some twenty megabytes of
    // names and values, cost two million pointer lookups a collection on a
    // 233 MHz board. KindLeaf is not a multiple of eight, so no link left
    // behind by a free block can be taken for it.
    const int KindAt = WordSize.Bytes;
    const int KindLeaf = 0x4C454146;

    // AND KindObject FOR A BLOCK THAT IS AN OBJECT WITH A DESCRIPTOR: a class
    // instance, a box, a closure, an array (Runtime.AllocObject, which the
    // compiler calls exactly where it stores a vtable at the payload's first
    // word). Its references are the ones its descriptor names (ScanObject),
    // not every word it holds: the fields that are numbers, flags and
    // lengths are not looked up at all, and a number that happens to look
    // like a pointer keeps nothing alive. Everything else the compiler
    // allocates -- a struct's block, a cell, a coroutine's frame -- is still
    // scanned word by word. Not a multiple of eight, as KindLeaf is not.
    const int KindObject = 0x4F424A54;

    // AND KindFreed FOR A REGION'S BLOCK GIVEN BACK BELOW THE TOP of its
    // region (RegionFree): dead, its bytes kept until the pointer comes back
    // down over it. Never scanned, never copied (ScanRegion, CopyRegion). Not
    // a multiple of eight either.
    const int KindFreed = 0x46524545;

    // THE DESCRIPTOR, as the compiler lays it (Lowering.cs, DescName...):
    // twelve words before the vtable an object's first word points at.
    public const int DescWords = 12;
    public const int DescSizeWord = 1;
    public const int DescSelfWord = 5;
    public const int DescFlagsWord = 6;
    public const int DescPayloadWord = 7;
    public const int DescRefMapWord = 8;
    public const int DescGcFlagsWord = 9;
    const int DescDepthWord = 2;           // as Runtime's type tests read them
    const int DescDisplayWord = 3;
    public const int SequenceFlag = 1;         // DescFlags: an array or a string
    public const int StringFlag = 2;
    public const int ElementsAreReferences = 1; // DescGcFlags, on an array
    public const int ValueBlocksFlag = 4;       // DescGcFlags: structs held by pointer, listed after the reference map
    public const int ArrayCountAt = 2 * WordSize.Bytes;

    // The smallest block that can describe itself while free: header, two
    // links, footer. A remainder below this cannot be a block, so a split
    // that would leave one gives the caller the extra bytes instead.
    const int Smallest = 4 * WordSize.Bytes;

    // THE LEAST BLOCK OF ANY SIZE-CLASS PAGE: the 16-byte class
    // (StartClasses), which in long mode is a bare header. A WALK OF A CHAIN
    // OF BLOCKS a page can be part of stops only below this. A mixed chunk's
    // blocks are at least Smallest (four words, 32 bytes in long mode;
    // MixedNeed), and walks that stopped below that read a page of the two
    // least classes as empty. Its blocks were given no start in the
    // snapshot (StampPage) and could not be found by the marker
    // (SnapshotBlockIn): kept as newcomers, never scanned, and what only they
    // held was swept from under them (1247, 1472). Their marks were not taken
    // off either (UnmarkRange). On i386 the two are the same 16 bytes.
    const int LeastBlock = 16;

    // Collect when this much has been allocated since the last collection:
    // 256 KB to begin with, and thereafter between one and three times the
    // live size, as the machine has room (NextThreshold). The live size
    // after the last collection is the only measure of the program the
    // collector really knows; the machine's free memory says how much of
    // that measure it can afford to spend on garbage between collections.
    const int MinThreshold = 262144;
    const int MaxGrowth = 3;

    // THE ADDRESS SPACE IS A LIMIT TOO. A 32-bit process has four gigabytes
    // of it at most (three under a 32-bit kernel), and its code, its threads'
    // stacks and this collector's own tables live there beside the heap: a
    // native compiler paced by the machine's free memory alone grew its heap
    // to four gigabytes of a server with sixty free and had every mapping
    // refused. So on 32-bit the heap is paced to stay under two and a half
    // (NextThreshold), and GC.GetGCMemoryInfo says so as the process's total,
    // which is what the build's work admission reads. Long mode has no such
    // ceiling worth the name.
    //
    // HOW MUCH is asked of the kernel as the heap starts (Platform.AddressSpace,
    // SetCeiling): under a 64-bit kernel the whole four gigabytes are the
    // process's, and three and a quarter of them the heap's; under a 32-bit
    // kernel, or when nobody says, the two and a half that fit in three.
    // 0 until then, as every static of the collector must be.
    public static long HeapCeiling;
#if TARGET_64BIT
    const long NarrowCeiling = 0;
    const long WideCeiling = 0;
#else
    const long NarrowCeiling = 2684354560;
    const long WideCeiling = 3489660928;
#endif

    // The mark queue: a block of the operating system's, not a heap block,
    // taken at start at MarkBytes. A live graph wider than it finishes
    // through the rescan path below, which needs no memory at all -- and
    // walks the whole heap: at 256 KB the self-hosted compiler overflowed it
    // in 46 of its 60 collections compiling hello.cs, 46 walks of a 380 MB
    // heap. So a cycle that overflows asks for four times the queue for the
    // next one (FitMarkQueue), as far as a thirty-second of the heap: a
    // program on a small machine keeps the small queue, and one with
    // hundreds of megabytes live gets the megabytes of queue its graph needs.
    // SIXTY-FOUR KILOBYTES TO BEGIN WITH, the same for every program: a
    // megabyte from the start was three times the whole heap of a ring-1
    // kernel on a 64 MB machine, and a compiler whose graph is wider has
    // its queue four times over within two cycles, while its heap is small
    // and the walks an overflow costs are short.
    const int MarkBytes = 65536;
    const int MarkShare = 32;

    // Exact-size doubly linked lists through 256 bytes (31 bins), then eight
    // lists to each power of two, and a bitmap of the non-empty ones (the
    // free index). One list per power of two, searched first fit, was not
    // enough: native self-compilation piled 249,079 fragments into one range
    // and probed billions of times. Eighths keep a bin's blocks close in
    // size, a fit looks at no more than FitDepth of them before taking the
    // next non-empty bin's head, and the bitmap finds that bin at once.
    const int ExactLimit = 256;
    const int ExactBins = 31;      // 16..256 bytes, eight apart
    const int LargeSteps = 8;      // bins to each power of two above ExactLimit
    const int LargeTop = 31;       // the highest bit length with bins of its own
    const int Bins = ExactBins + (LargeTop - 8) * LargeSteps;
    const int BinsBytes = (Bins + (Bins + 8 * WordSize.Bytes - 1) / (8 * WordSize.Bytes)) * WordSize.Bytes; // heads, then the non-empty bitmap

    // ---- heaps (docs/HEAPS.md) ---------------------------------------------
    //
    // ONE COLLECTOR, ANY NUMBER OF HEAPS: a kernel gives each of its modules
    // one. The mark, the roots, the chunk index, the pacing and the cycle are
    // every heap's; what a heap has of its own is where its memory comes
    // from and goes back to -- its bump chunk, its free bins, its size-class
    // pages with room and its pool of empty ones -- so that a module's
    // memory is its own and can all be given back when it goes.
    //
    // A HEAP IS A PAGE OF THE OPERATING SYSTEM'S, not a managed object: its
    // record, then its class pages' list heads, then its bins. Every chunk
    // says in its header which heap it is of (HeapChunks.HeapOf), and a
    // block freed or swept goes to its own chunk's heap's bins and lists
    // whichever heap the code doing it works for (Link, ListPage,
    // RetirePage). An allocation comes from the heap its thread is in
    // (Tls.Heap), which the allocator works for under the heap lock (_h).
    // A program that makes no heap has heap 0 alone, and pays one compare
    // where a free would look up its chunk's heap (_heapCount).
    const int HeapCurrentAt = 0 * WordSize.Bytes;      // the chunk the bump pointer is in
    const int HeapBumpAt = 1 * WordSize.Bytes;         // first untouched byte in the current chunk
    const int HeapLimitAt = 2 * WordSize.Bytes;        // one past the current chunk
    const int HeapSmallFreeAt = 3 * WordSize.Bytes;    // blocks in the exact-size bins, 16..256 bytes
    const int HeapPoolAt = 4 * WordSize.Bytes;         // empty pages, through their next-page word
    const int HeapPoolBytesAt = 5 * WordSize.Bytes;
    const int HeapSweepCurrentAt = 6 * WordSize.Bytes; // the chunk that was current at the sweep's stop,
    const int HeapSweepEndAt = 7 * WordSize.Bytes;     //   and where its blocks ended then
    const int HeapBytesAt = 8 * WordSize.Bytes;        // its chunks' sizes, summed
    const int HeapChunksAt = 9 * WordSize.Bytes;       // and how many
    const int HeapNextAt = 10 * WordSize.Bytes;        // the next heap made, or 0
    const int HeapNumberAt = 11 * WordSize.Bytes;      // 0 for the first heap, then in the order made
    const int HeapClassPagesAt = 16 * WordSize.Bytes;  // Classes words: pages with room, unowned
    const int HeapBinsAt = (16 + 40) * WordSize.Bytes; // Bins free-list heads, then the non-empty bitmap
    const int HeapClassCountAt = HeapBinsAt + BinsBytes; // Classes words: its pages of each class (SmallPageFor)
    const int HeapRecordBytes = 4096;

    static nuint _heap0;        // the first heap's record: the program's, or the kernel's
    static long _heapCount;     // heaps made and not released
    static nuint _heapsMade;
    static nuint _h;            // the heap the allocator works for; the heap lock is held

    /// The heap whose chunks are being taken: what HeapChunks writes in a
    /// new chunk's header. The heap lock is held.
    public static nuint WorkingHeap => _h;
    /// What the working heap holds, or -1 when it is the first heap, which
    /// is measured as the whole (HeapChunks.ChunkAsk): a count of bytes.
    public static long WorkingHeapBytes => _h == _heap0 || _h == 0 ? -1 : (long)Sys.ReadAddress(_h + HeapBytesAt);

    static nuint _current { get { return Sys.ReadAddress(_h + HeapCurrentAt); } set { Sys.WriteAddress(_h + HeapCurrentAt, value); } }
    static nuint _bump { get { return Sys.ReadAddress(_h + HeapBumpAt); } set { Sys.WriteAddress(_h + HeapBumpAt, value); } }
    static nuint _limit { get { return Sys.ReadAddress(_h + HeapLimitAt); } set { Sys.WriteAddress(_h + HeapLimitAt, value); } }
    static nuint _bins => _h == 0 ? 0 : _h + HeapBinsAt;
    static nuint _smallFree { get { return Sys.ReadAddress(_h + HeapSmallFreeAt); } set { Sys.WriteAddress(_h + HeapSmallFreeAt, value); } }

    static long _since;         // bytes allocated since the last collection
    static long _threshold;     // collect when _since reaches this
    static long _liveBytes;     // block bytes found live by the last sweep
    static long _liveBlocks;
    static long _allocated;     // bytes allocated ever: retired buffers' used parts and large blocks

    static nuint _markAt;       // the grey queue, or 0 (GcLock.GreyHead/GreyTail)
    static nuint _markCount;    // its capacity in entries, a power of two
    static nuint _markBytes;    // its size, a power of two
    static nuint _markWanted;   // the size an overflow asked the next cycle for, or 0
    static nuint _markPeak;

    // ---- a collection that lets the other threads run while it marks -----
    //
    // SNAPSHOT AT THE BEGINNING. The world stops twice, briefly: once to
    // write down where every object starts and read the roots, and once to
    // read the roots again, finish, and sweep. Between the two the
    // collecting thread marks and every other thread runs.
    //
    //   - The marker never reads anything a running thread may change. It
    //     finds the object a word points at through a bitmap of the object
    //     starts AS THEY WERE at the first stop, and a copy of the chunk
    //     index made then, and it writes only the flags of those objects --
    //     which no running thread touches, because nothing is freed while a
    //     mark is under way (Free) and an allocation is carved from memory
    //     that was free at the snapshot.
    //   - What a running thread overwrites, it reports first (Barrier): the
    //     compiler emits the report at every store of a reference into the
    //     heap or a static. So everything reachable at the snapshot is
    //     marked, whatever is unlinked meanwhile.
    //   - What is allocated meanwhile has no start bit, is therefore never
    //     marked, and is kept by the sweep for exactly that reason.
    //
    // A program with one thread, or a heap whose snapshot tables could not
    // be had, collects the old way: one stop for all of it.
    static nuint _cycle;            // which collection the snapshot tables are of
    static bool _snapshots;         // every chunk has its table for this cycle
    static bool _concurrent;        // this cycle lets the world run while marking
    static nuint _barrier;          // the barrier's ring, or 0
    // PLACES ENOUGH FOR THE STAMP ROUND. Until every thread has written its
    // buffer's starts down (Marking 1) each store is logged, old value and
    // new, and a ring of 16384 filled within a millisecond of a compiler's
    // stores while a thread in a long loop had not yet come to a safepoint:
    // thirty of a stage-2 compile's 173 cycles were given up for it, each
    // one a whole mark thrown away and a major cycle forced after it. So a
    // ring that fills asks the next cycle for four times the places, up to
    // two megabytes (FitBarrier), as the mark queue does: a program whose
    // threads store little keeps the small ring its first cycle had.
    const int BarrierBytes = 65536;
    const int BarrierMost = 2097152;
    // The ring's first two words hold its count of places (a power of two,
    // two words each), so a barrier reads a ring and its size together.
    static nuint _barrierWanted;    // the ring a full one asked the next cycle for, or 0

    public static long ConcurrentCycles;
    public static long BarrierTaken;
    public static long BarrierOverflows;

    // Work counters, for finding out where a collection's time goes.
    public static long MarkCalls;
    /// Frees the program asked for and the collector was left with: while a
    /// mark or a sweep was under way, and on top of the allocator or the lock.
    public static long FreesDroppedMarking, FreesDropped;
    /// Whether MarkCalls and the new-mark count are kept: Corsac.GC.Stats, or a
    /// program that reads them (the compiler's benchmark build) setting it.
    /// Every marking thread bumping the two shared words for every word it
    /// read passed their cache line between the cores for each one.
    public static bool CountMarks;
    // WHERE A MINOR CYCLE'S ROOT WORDS COME FROM, counted for the profile:
    // the kilobytes of old chunks' cards, of young chunks' (by block), the
    // blocks the stacks held, and the stacks and registers themselves.
    public static nuint OldCardWords;

    /// The words of the statics a minor collection read by their cards, and
    /// the words it would have read whole (Gc.ScanStatics).
    public static long StaticCardWords, StaticWordsSkipped;
    public static long YoungCardWords;
    public static long HeldWords;
    public static long StackWords;
    public static nuint TakenCards;
    public static long WalkSteps;
    public static long ProbeSteps;
    public static long SweepVisits;
    public static long RescanPasses;
    static bool _collecting;
    static bool _ready;

    /// How many collections have run. A test reads it to prove one happened.
    public static long Collections;

    // ---- generations ---------------------------------------------------------
    //
    // MOST OF WHAT A PROGRAM MAKES IS DEAD BY THE NEXT COLLECTION, and a
    // collection that marks the whole live heap, rebuilds every chunk's start
    // table and sweeps every chunk to find that out costs the whole heap each
    // time. So the collector is generational -- and stays non-moving, since
    // the stacks are read word by word and nothing may move -- by STICKY
    // MARKS: a block that survives a collection keeps its mark and scanned
    // flags and is OLD; one allocated since carries neither and is YOUNG.
    //
    // A MINOR collection marks only what is young and reachable. Its roots
    // are the ordinary ones, the CARDS -- a byte for every kilobyte of the
    // address space, set by the compiler after every store of a reference
    // (Runtime.Cards) -- which lead it to the old objects written since the
    // last cycle (TakeCards, ScanTakenCards), and the blocks the stacks held at the last
    // collection (Hold): an object the compiler is still initialising is
    // written without a barrier, a collection can fall between its allocation
    // and those writes, and it is on a stack when it does. A pointer into an
    // old chunk is not followed at all (its blocks are all old). Only YOUNG
    // chunks -- allocated in since the last collection (HeapChunks.IsYoung) --
    // have their start tables built and are swept; the free lists of the
    // others are left as they are.
    //
    // A MAJOR collection clears every mark as it builds the start tables and
    // then runs as a whole-heap one always has; its survivors keep their marks
    // and are old. One runs when the live heap has grown by the pacing's
    // measure since the last (NextIsMinor), first of all, when asked for
    // (GC.Collect), when memory ran out, and after anything that makes the
    // old generation's marks untrustworthy (an abandoned cycle, a record of
    // the stacks' blocks that overflowed).
    //
    // 32-bit only, and only where a mapping costs only the pages touched: the
    // card table is the address space over 1024, four megabytes reserved and
    // a page committed for every four megabytes of heap. Elsewhere every
    // collection is major, as before.
    static bool _generational;
    static bool _minor;             // the cycle under way is a minor one
    static bool _forceMajor;        // the next cycle must be major
    static long _majorLive;         // what the last major collection found live
    public static long MinorCollections;
    /// Set through AppContext.SetSwitch("Corsac.GC.Stats", true) (SayStats).
    public static bool StatsAsked;
    /// Set through AppContext.SetData("Corsac.GC.Workers", n): how many
    /// workers the first collection starts, in place of the platform's count.
    /// No initialiser: the collector reads these before any static constructor.
    public static bool WorkersSet;
    public static long WorkersAsked;
    public static long MajorCollections;
    /// Why each whole cycle was one: asked for (GC.Collect, memory, a cycle
    /// given up, a full record of held blocks), the first, minors costing as
    /// much, the live heap grown, or no generations at all.
    public static long MajorsAsked, MajorsFirst, MajorsCostly, MajorsGrown, MajorsUngenerational;
    const int CardTableBytes = 4194304;
    const int NurseryLeast = 1048576;
    // The blocks the stacks held: a count word, then (block, size) pairs.
    // Two tables, swapped at every cycle: what the last one held is read
    // (RescanHeld) while this one's is written (Hold).
    const int HeldMax = 32768;
    const int HeldEntry = 2 * WordSize.Bytes;
    const int HeldBytes = (HeldMax + 1) * HeldEntry;
    static nuint _held;
    static nuint _holding;
    // THE CARDS AS THEY WERE AT THE SNAPSHOT (TakeCards): moved here, and the
    // live table cleared, in one step under the heap lock. A store made after
    // it -- of an object made after it, above all, which this cycle keeps but
    // cannot mark -- leaves its card set for the next cycle. Read and cleared
    // in the cycle's marking (ScanTakenCards).
    static nuint _taken;
    // THE CARDS A PAGE'S OLD BLOCKS LIE IN, a byte a card as the cards are,
    // written as each page is swept (SweepPage, SweepPageAlone): what a
    // minor cycle's snapshot read off every young page's blocks one by one
    // (OldCards), kept instead from the sweep that made them old, so that
    // the snapshot need not walk the pages at all (_pagesUnwalked). 0 when
    // there is none to be had: the pages are walked.
    static nuint _oldCards;

    static bool _verifyGenerations;
    static long _verifyReports;
    // WORDS THE MARKER NEVER READS (VerifyMajor's "marker reads it 0"): a
    // number that equals an address -- a Windows reservation's base, a
    // thread's start -- or a reference map that left a field out. Said, a
    // few, on a count of their own: on the reports' count, the same base
    // said at every cycle used up the forty within seconds of a boot, and
    // every cycle after went unchecked.
    static long _verifyUnread;

    /// The checks of marking (VerifyMajor, and VerifyMinor for a minor
    /// cycle) asked for by a program rather than the platform: a kernel sets
    /// it from its command line (gc.verify=1). Read at every collection, so
    /// it may be set after the heap started.
    public static bool VerifyMarks;

    /// The reports the checks of marking have made (VerifyMinor, VerifyMajor,
    /// VerifyNewcomers, VerifyStopBlock), a test's to read: 0 when nothing
    /// was found. A number taken for an address, said on a count of its own
    /// (_verifyUnread), is not one.
    public static long VerifyReports => _verifyReports;

    /// Only the major cycles' marks checked (VerifyMajor), and nothing else
    /// changed: a kernel's gc.verifymajors=1, light enough that the boots it
    /// runs in still reach what the full check (VerifyMarks) slows them past.
    public static bool VerifyMajors;

    /// VerifyMajors at every Nth major cycle only (1, or 0, for every one):
    /// a kernel's gc.verifymajors=N, so that a check slow enough to close
    /// the window it looks for can still run in a boot that reaches it.
    public static long VerifyMajorsEvery;
    static long _majorsSeen;

    // Whether this major cycle is one VerifyMajors checks.
    static bool MajorChecked()
    {
        if (!VerifyMajors) return false;
        _majorsSeen = _majorsSeen + 1;
        return VerifyMajorsEvery <= 1 || _majorsSeen % VerifyMajorsEvery == 0;
    }

    /// Every size-class page walked at every minor cycle, as a checking one
    /// walks them: the unwalked minor cycle (_pagesUnwalked) never taken. A
    /// kernel sets it from its command line (gc.walkpages=1).
    public static bool WalkPages;

    /// At every minor cycle that leaves the pages unwalked, every young
    /// page walked anyway and each old block's cards looked up in _oldCards:
    /// a card set there for none is a store into an old block the cycle
    /// would not read (CheckOldCardsOf). A kernel sets it from its command
    /// line (gc.checkoldcards=1).
    public static bool CheckOldCards;

    // THE FREE JOURNAL (gc.freejournal=1): every block a sweep frees, and
    // every one freed by hand, written down by its address -- the cycle,
    // whether it was minor, concurrent, or a free by hand -- so that a
    // block found free under a live reference says which collection took
    // it (FreedAt). A table of JournalSlots address and word pairs, mapped
    // once as it is turned on: nothing is asked for while a sweep runs.
    const int JournalSlots = 65536;
    static nuint _journalAddr, _journalInfo;

    public static void FreeJournalOn()
    {
        if (_journalAddr != 0) return;
        _journalAddr = Platform.Map(JournalSlots * WordSize.Bytes);
        _journalInfo = _journalAddr != 0 ? Platform.Map(JournalSlots * WordSize.Bytes) : 0;
        if (_journalInfo == 0) _journalAddr = 0;
        // A refused array store says what the journal knows of what it held (Runtime.ArrayStoreRefused).
        if (_journalAddr != 0) Runtime.ArrayStoreReport = Sys.AddressOf(SayRefusedStore);
    }

    // A hook (Sys.Call): the stored value, the array, and a word unused.
    static nuint SayRefusedStore(nuint value, nuint array, nuint unused)
    {
        SayFreed("array store: the value", value);
        SayFreed("array store: the array", array);
        return 0;
    }

    /// `how`: 1 a sweep's, 2 a free by hand. The journal's word holds the
    /// cycle's low bits on i386 and all of them in long mode.
    static void NoteFreed(nuint block, int how)
    {
        if (_journalAddr == 0) return;
        nuint slot = ((block >> 3) & (JournalSlots - 1)) * WordSize.Bytes;
        Sys.WriteAddress(_journalAddr + slot, block);
        nuint flags = (nuint)((_minor ? 1 : 0) | (_concurrent ? 2 : 0) | (how == 2 ? 4 : 0) | (_collecting ? 8 : 0));
        Sys.WriteAddress(_journalInfo + slot, ((nuint)_cycle << 4) | flags);
    }

    /// What the journal says of the block whose payload is at `payload`:
    /// (cycle << 4) | 1 minor | 2 concurrent | 4 by hand | 8 inside a
    /// collection, or -1 when it holds nothing for that block.
    public static long FreedAt(nuint payload)
    {
        if (_journalAddr == 0) return -1;
        nuint block = payload - HeaderBytes;
        nuint slot = ((block >> 3) & (JournalSlots - 1)) * WordSize.Bytes;
        return Sys.ReadAddress(_journalAddr + slot) == block ? (long)Sys.ReadAddress(_journalInfo + slot) : -1;
    }

    /// The cycle being run, or the last one run (FreedAt's counterpart).
    public static nuint Cycle() { return _cycle; }

    /// What the free journal says of the block at `payload`, said: its word
    /// (FreedAt) and the cycle now. Nothing when the journal is off.
    public static void SayFreed(string what, nuint payload)
    {
        if (_journalAddr == 0) return;
        SayNumber(what + " at ", payload);
        SayNumber(what + ", its first word ", Sys.ReadAddress(payload));
        SayNumber(what + ", freed: journal word ((cycle<<4)|1 minor|2 concurrent|4 by hand|8 in a collection), -1 none ", FreedAt(payload));
        SayNumber(what + ", the cycle now ", _cycle);
    }
    static long _oldCardsReports;
    static long _aloneSaid;

    /// Corsac.GC.Verify: after a minor cycle has marked, every old block is
    /// read word by word, and a word that lands on a young block this cycle
    /// did not mark -- which the sweep is about to free -- is reported: the
    /// old block, the offset in it, and what it points at. A missing barrier
    /// shows up as exactly the object and field it missed. An old object that
    /// has become garbage can hold such a word legitimately; a report is a
    /// place to look, not a verdict.
    static void VerifyMinor()
    {
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 20)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            nuint tail = TailIn(chunk);
            while (block < end && _verifyReports < 20)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end) || !Whole(chunk, block, word))
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == FlagMark && Sys.ReadAddress(block + KindAt) != KindLeaf)
                {
                    nuint p = block + HeaderBytes;
                    while (p < block + size - tail)
                    {
                        nuint target = MarkerReads(block, size, p, tail) ? BlockForPointer(Sys.ReadAddress(p)) : 0;
                        if (target != 0)
                        {
                            nuint seen = Sys.ReadAddress(target);
                            nuint home = HeapChunks.OfSnapshot(target + HeaderBytes);
                            if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen))
                            {
                                SayNumber("gc verify: old block ", block);
                                SayNumber("gc verify:   kind ", Sys.ReadAddress(block + KindAt));
                                SayNumber("gc verify:   offset ", p - block);
                                SayNumber("gc verify:   points at young ", target);
                                SayNumber("gc verify:   whose kind is ", Sys.ReadAddress(target + KindAt));
                                SayNumber("gc verify:   its chunk young ", HeapChunks.IsYoung(home) ? 1 : 0);
                                SayNumber("gc verify:   starts this cycle ", HeapChunks.StartsCycle(home) == _cycle ? 1 : 0);
                                SayNumber("gc verify:   is a start ", HeapChunks.IsStart(home, target) ? 1 : 0);
                                SayNumber("gc verify:   old block's card ", Sys.Read8(Runtime.Cards + (p >> Runtime.CardShift)));
                                SayNumber("gc verify:   old block's chunk young ", HeapChunks.IsYoung(HeapChunks.Of(block)) ? 1 : 0);
                                // Which type, for nm: the vtable is the payload's first word.
                                SayNumber("gc verify:   old block's vtable ", Sys.ReadAddress(block + HeaderBytes));
                                SayNumber("gc verify:   old block's header ", word);
                                SayNumber("gc verify:   old block held last cycle ", WasHeld(block) ? 1 : 0);
                                SayNumber("gc verify:   young block's size ", seen & SizeMask);
                                _verifyReports = _verifyReports + 1;
                            }
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    /// Corsac.GC.Verify, after a MAJOR cycle has marked: every marked block
    /// is read word by word, and a word that is the start of a block the
    /// sweep is about to free is reported -- the block, its vtable (for nm),
    /// the offset, and whether the marker reads that word. Read and still
    /// unmarked is a fault in marking. Not read is a reference map that left
    /// a field out, or a number that happens to look like an address; the
    /// report says which object and which word, and nm says which type.
    static void VerifyMajor()
    {
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 40)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            nuint tail = TailIn(chunk);
            while (block < end && _verifyReports < 40)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end) || !Whole(chunk, block, word))
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == FlagMark && Sys.ReadAddress(block + KindAt) != KindLeaf)
                {
                    nuint p = block + HeaderBytes;
                    while (p < block + size - tail)
                    {
                        nuint target = BlockForPointer(Sys.ReadAddress(p));
                        if (target != 0 && target != block)
                        {
                            nuint seen = Sys.ReadAddress(target);
                            nuint home = HeapChunks.OfSnapshot(target + HeaderBytes);
                            bool reads = MarkerReads(block, size, p, tail);
                            if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen)
                                && Sys.ReadAddress(p) == target + HeaderBytes
                                // A NUMBER IN AN ARRAY OF NUMBERS -- an identity hash
                                // above all -- that equals an address is no pointer:
                                // the marker rightly never reads it, and forty such
                                // reports in one int[] were all the verifier said.
                                && !NumbersOnly(block)
                                && (reads || _verifyUnread < 8))
                            {
                                if (!reads) _verifyUnread = _verifyUnread + 1;
                                SayNumber("gc verify major: marked block ", block);
                                SayNumber("gc verify major:   its vtable ", Sys.ReadAddress(block + HeaderBytes));
                                SayNumber("gc verify major:   kind ", Sys.ReadAddress(block + KindAt));
                                SayNumber("gc verify major:   offset ", p - block - HeaderBytes);
                                SayNumber("gc verify major:   marker reads it ", reads ? 1 : 0);
                                SayNumber("gc verify major:   points at unmarked ", target);
                                SayNumber("gc verify major:   whose vtable ", Sys.ReadAddress(target + HeaderBytes));
                                SayNumber("gc verify major:   whose kind ", Sys.ReadAddress(target + KindAt));
                                if (reads)
                                {
                                    // WHERE EACH LIES AND WHAT THE SNAPSHOT SAID OF IT: a
                                    // parent marked and never scanned, or a target in a page
                                    // whose starts some path wrote or failed to write.
                                    nuint parentHome = HeapChunks.OfSnapshot(block + HeaderBytes);
                                    SayNumber("gc verify major:   cycle ", _cycle);
                                    SayNumber("gc verify major:   parent scanned ", (word & FlagScan) != 0 ? 1 : 0);
                                    SayNumber("gc verify major:   parent start ", parentHome != 0 && HeapChunks.IsStart(parentHome, block) ? 1 : 0);
                                    SayNumber("gc verify major:   parent page class ", parentHome != 0 ? HeapChunks.PageClass(parentHome) : 0);
                                    // No owner, 0: a page held by none, or no page at all.
                                    SayNumber("gc verify major:   parent page owner ", parentHome != 0 && HeapChunks.PageClass(parentHome) != 0 ? HeapChunks.Owner(parentHome) : 0);
                                    SayNumber("gc verify major:   parent starts cycle ", parentHome != 0 ? HeapChunks.StartsCycle(parentHome) : HeapChunks.NoCycle);
                                    SayNumber("gc verify major:   target start ", HeapChunks.IsStart(home, target) ? 1 : 0);
                                    SayNumber("gc verify major:   target page class ", HeapChunks.PageClass(home));
                                    SayNumber("gc verify major:   target page owner ", HeapChunks.PageClass(home) != 0 ? HeapChunks.Owner(home) : 0);
                                    SayNumber("gc verify major:   target starts cycle ", HeapChunks.StartsCycle(home));
                                    SayNumber("gc verify major:   target page young ", HeapChunks.IsYoung(home) ? 1 : 0);
                                    nuint at = GcThreads.BufferAtOrAbove(HeapChunks.First(home));
                                    SayNumber("gc verify major:   target page captured ", at < GcThreads.BufferCount() && GcThreads.BufferBase(at) == HeapChunks.First(home) ? 1 : 0);
                                    SayFreed("gc verify major:   target", target + HeaderBytes);
                                    _verifyReports = _verifyReports + 1;
                                }
                            }
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    /// VerifyMajors, after a concurrent major has marked: every word of the
    /// statics, and of the ranges registered as roots, that is the start of
    /// a block of the snapshot left unmarked. Under snapshot marking what a
    /// root holds at the end was either held at the snapshot -- marked -- or
    /// made since -- a newcomer; anything else is a root the marker missed,
    /// and everything only it holds is about to be freed. A number that
    /// happens to equal an address reads the same, so at most eight are
    /// said a cycle.
    static void VerifyStaticRoots()
    {
        long said = 0;
        said = VerifyRootRange(Sys.DataStart(), Sys.DataEnd(), said);
        nuint i = 0;
        while (GcRoots.ExtraTable() != 0 && i < GcRoots.ExtraCount())
        {
            nuint slot = GcRoots.ExtraTable() + i * (2 * WordSize.Bytes);
            nuint start = Sys.ReadAddress(slot);
            if (start != 0 && start != GcRoots.ClaimMark() && !PassedOver(start)) said = VerifyRootRange(start, Sys.ReadAddress(slot + WordSize.Bytes), said);
            i = i + 1;
        }
    }

    static long VerifyRootRange(nuint from, nuint to, long said)
    {
        nuint p = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
        while (p < to && said < 8)
        {
            nuint word = Sys.ReadAddress(p);
            nuint target = BlockForPointer(word);
            if (target != 0 && word == target + HeaderBytes)
            {
                nuint seen = Sys.ReadAddress(target);
                nuint home = HeapChunks.OfSnapshot(target + HeaderBytes);
                if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen))
                {
                    SayNumber("gc verify roots: static word at ", p);
                    SayNumber("gc verify roots:   points at unmarked ", target);
                    SayNumber("gc verify roots:   whose vtable ", Sys.ReadAddress(target + HeaderBytes));
                    SayNumber("gc verify roots:   whose kind ", Sys.ReadAddress(target + KindAt));
                    SayNumber("gc verify roots:   cycle ", _cycle);
                    SayNumber("gc verify roots:   target start ", HeapChunks.IsStart(home, target) ? 1 : 0);
                    SayNumber("gc verify roots:   target page young ", HeapChunks.IsYoung(home) ? 1 : 0);
                    SayFreed("gc verify roots:   target", target + HeaderBytes);
                    said = said + 1;
                    _verifyReports = _verifyReports + 1;
                }
            }
            p = p + WordSize.Bytes;
        }
        return said;
    }

    /// Corsac.GC.Verify (or VerifyMarks), after a concurrent cycle has
    /// marked: every NEWCOMER -- kept by the sweep because it is not in the
    /// snapshot, and never traced -- read word by word, and a word the marker
    /// would read that is the start of a block of the snapshot left unmarked
    /// is reported: the sweep is about to free what a kept object holds.
    /// VerifyMajor reads only marked blocks, and a newcomer holding such a
    /// block is the shape every hole in stamping has had: a names array made
    /// in a page the snapshot never saw, before its thread answered STAMP,
    /// filled with a string only that thread's stack held (test 1011).
    static void VerifyNewcomers()
    {
        _verifySaidPage = 0;
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 40)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            nuint tail = TailIn(chunk);
            while (block < end && _verifyReports < 40)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end) || !Whole(chunk, block, word))
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == 0 && Sys.ReadAddress(block + KindAt) != KindLeaf && Newcomer(chunk, block, word))
                {
                    nuint p = block + HeaderBytes;
                    while (p < block + size - tail)
                    {
                        nuint target = MarkerReads(block, size, p, tail) ? BlockForPointer(Sys.ReadAddress(p)) : 0;
                        if (target != 0 && target != block)
                        {
                            nuint seen = Sys.ReadAddress(target);
                            nuint home = HeapChunks.OfSnapshot(target + HeaderBytes);
                            if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen))
                            {
                                SayNumber("gc verify newcomer: block ", block);
                                SayNumber("gc verify newcomer:   its vtable ", Sys.ReadAddress(block + HeaderBytes));
                                SayNumber("gc verify newcomer:   its chunk starts this cycle ", HeapChunks.StartsCycle(chunk) == _cycle ? 1 : 0);
                                SayNumber("gc verify newcomer:   its chunk is a page ", HeapChunks.PageClass(chunk));
                                SayNumber("gc verify newcomer:   its chunk owner ", HeapChunks.Owner(chunk));
                                SayNumber("gc verify newcomer:   offset ", p - block - HeaderBytes);
                                SayNumber("gc verify newcomer:   points at unmarked ", target);
                                SayNumber("gc verify newcomer:   whose vtable ", Sys.ReadAddress(target + HeaderBytes));
                                SayNumber("gc verify newcomer:   whose kind ", Sys.ReadAddress(target + KindAt));
                                SayNumber("gc verify newcomer:   whose chunk is a page ", HeapChunks.PageClass(home));
                                SayNumber("gc verify newcomer:   whose chunk owner ", HeapChunks.Owner(home));
                                SayNumber("gc verify newcomer:   minor ", _minor ? 1 : 0);
                                if (chunk != _verifySaidPage) SayNewcomerPage(chunk);
                                _verifyReports = _verifyReports + 1;
                            }
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    static nuint _verifySaidPage;

    /// THE PAGE A NEWCOMER LIES IN, once: how much of it has starts this
    /// cycle and where they stop, whether the walk stepped over it as a
    /// thread's, and whether its owner's cache still holds it -- which of
    /// stamping's paths left it out.
    static void SayNewcomerPage(nuint chunk)
    {
        _verifySaidPage = chunk;
        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        long live = 0;
        long started = 0;
        nuint firstMissing = 0;
        nuint lastStarted = 0;
        nuint block = first;
        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < LeastBlock || Beyond(block, size, end)) break;
            if ((word & FlagFree) == 0)
            {
                live = live + 1;
                if (HeapChunks.IsStart(chunk, block))
                {
                    started = started + 1;
                    lastStarted = block;
                }
                else if (firstMissing == 0) firstMissing = block;
            }
            block = block + size;
        }
        SayNumber("gc verify page: chunk ", chunk);
        SayNumber("gc verify page:   first ", first);
        SayNumber("gc verify page:   end ", end);
        SayNumber("gc verify page:   walk stopped at ", block);
        SayNumber("gc verify page:   starts cycle ", HeapChunks.StartsCycle(chunk));
        SayNumber("gc verify page:   cycle ", _cycle);
        SayNumber("gc verify page:   live slots ", live);
        SayNumber("gc verify page:   with starts ", started);
        SayNumber("gc verify page:   first without ", firstMissing);
        SayNumber("gc verify page:   last with ", lastStarted);
        nuint at = GcThreads.BufferAtOrAbove(first);
        SayNumber("gc verify page:   captured ", at < GcThreads.BufferCount() && GcThreads.BufferBase(at) == first ? 1 : 0);
        SayNumber("gc verify page:   young ", HeapChunks.IsYoung(chunk) ? 1 : 0);
        SayNumber("gc verify page:   pooled ", HeapChunks.IsPooled(chunk) ? 1 : 0);
        nuint tb = HeapChunks.Owner(chunk);
        if (tb == 0) return;
        // The page's class plus one, 0 for none: its two words of a cache.
        nuint cls = HeapChunks.PageClass(chunk);
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        nuint saved = Sys.ReadAddress(tb + Tls.ClassesSaved);
        SayNumber("gc verify page:   owner's cache ", cache);
        SayNumber("gc verify page:   owner's saved cache ", saved);
        SayNumber("gc verify page:   in cache ", cache != 0 && cls != 0 && Sys.ReadAddress(cache + (cls - 1) * (2 * WordSize.Bytes)) == chunk ? 1 : 0);
        SayNumber("gc verify page:   in saved cache ", saved != 0 && cls != 0 && Sys.ReadAddress(saved + (cls - 1) * (2 * WordSize.Bytes)) == chunk ? 1 : 0);
        SayNumber("gc verify page:   owner state ", Sys.ReadAddress(tb + Tls.State));
        SayNumber("gc verify page:   owner epoch ", Sys.ReadAddress(tb + Tls.Epoch));
        SayNumber("gc verify page:   round epoch ", Sys.ReadAddress(GcLock.Words() + GcLock.Epoch));
        SayNumber("gc verify page:   owner alloc base ", Sys.ReadAddress(tb + Tls.AllocBase));
    }

    /// AN ESCAPE FROM A REGION, under the verifier: every live heap block's
    /// words the marker reads, and one that lands in any registered thread's
    /// region arena is reported -- the holder, its vtable, the offset, the
    /// address and what it points at. A heap object never holds a region's
    /// block: the region ends and zeroes it, or the thread ends and its arena
    /// is given back, while the heap object still reads it. The heap lock is
    /// held, so no thread on the table gives its arena back meanwhile.
    static void VerifyRegionEscapes()
    {
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 40)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            nuint tail = TailIn(chunk);
            while (block < end && _verifyReports < 40)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end) || !Whole(chunk, block, word))
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == FlagMark && Sys.ReadAddress(block + KindAt) != KindLeaf && !NumbersOnly(block))
                {
                    nuint p = block + HeaderBytes;
                    while (p < block + size - tail && _verifyReports < 40)
                    {
                        nuint at = Sys.ReadAddress(p);
                        nuint tb = at != 0 && MarkerReads(block, size, p, tail) ? RegionOwner(at) : 0;
                        if (tb != 0)
                        {
                            SayNumber("gc verify region: heap block ", block);
                            SayNumber("gc verify region:   its vtable ", Sys.ReadAddress(block + HeaderBytes));
                            SayNumber("gc verify region:   kind ", Sys.ReadAddress(block + KindAt));
                            SayNumber("gc verify region:   offset ", p - block - HeaderBytes);
                            SayNumber("gc verify region:   holds arena address ", at);
                            SayNumber("gc verify region:   which reads ", Sys.ReadAddress(at));
                            SayNumber("gc verify region:   still filled ", Filled(tb, ChunkOf(tb, at), at) ? 1 : 0);
                            SayNumber("gc verify region:   thread block ", tb);
                            SayNumber("gc verify region:   minor ", _minor ? 1 : 0);
                            _verifyReports = _verifyReports + 1;
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    // The registered thread whose arena holds `at`, or 0.
    static nuint RegionOwner(nuint at)
    {
        nuint n = GcThreads.Count();
        for (nuint i = 0; i < n; i++)
        {
            nuint tb = GcThreads.BlockAt(i);
            if (tb != 0 && InRegion(tb, at)) return tb;
        }
        return 0;
    }

    /// Whether the record RescanHeld read this cycle names a block (the verifier).
    static bool WasHeld(nuint block)
    {
        nuint count = Sys.ReadAddress(_held);
        if (count > HeldMax) count = HeldMax;
        for (nuint i = 0; i < count; i++)
        {
            if (Sys.ReadAddress(_held + HeldEntry + i * HeldEntry) == block) return true;
        }
        return false;
    }

    static void StartGenerations()
    {
        _verifyGenerations = Platform.VerifyGenerations();
        if (HeapCeiling == 0 || !Platform.MapsCommitLazily)
        {
            return;
        }
        // THE CARDS COMMITTED ON FIRST TOUCH (Platform.MapLazy): a card is a
        // byte for every kilobyte of the address space, and only the heap's
        // are ever read or written. The held-block tables are not: a single
        // collection may write the whole of one, in bursts no page fault
        // should have to keep up with (a kernel's lazy faults take frames set
        // aside beforehand), and they are a sixteenth of the cards' size.
        nuint cards = Platform.MapLazy(CardTableBytes);
        nuint taken = Platform.MapLazy(CardTableBytes);
        nuint held = Platform.Map(HeldBytes);
        nuint holding = Platform.Map(HeldBytes);
        if (cards == 0 || taken == 0 || held == 0 || holding == 0)
        {
            if (cards != 0) Platform.Unmap(cards, CardTableBytes);
            if (taken != 0) Platform.Unmap(taken, CardTableBytes);
            if (held != 0) Platform.Unmap(held, HeldBytes);
            if (holding != 0) Platform.Unmap(holding, HeldBytes);
            return;
        }
        _taken = taken;
        _oldCards = Platform.MapLazy(CardTableBytes);
        _held = held;
        _holding = holding;
        Runtime.Cards = cards;
        _generational = true;
        // THE CARDS OF WHAT IS THERE ALREADY, committed now (CommitCards):
        // the heap's chunks and the statics, which every store into either
        // marks. From here each chunk's are committed as it is mapped.
        for (nuint chunk = HeapChunks.Newest(); chunk != 0; chunk = HeapChunks.Next(chunk))
        {
            CommitCards(chunk, HeapChunks.End(chunk) - chunk);
        }
        CommitCards(Sys.DataStart(), Sys.DataEnd() - Sys.DataStart());
    }

    /// THE CARDS OF [at, at + bytes) COMMITTED, in both tables: what a store
    /// there marks is a page that is there, so a card mark never takes a
    /// lazily committed page's fault (Platform.MapLazy) for memory the
    /// collector knows of. Called in thread context as the heap grows by a
    /// chunk (HeapChunks.Take, TakePages), and by a platform for memory of
    /// its own that holds references -- a kernel's stacks, an arena. Nothing
    /// where the tables are committed by touch anyway (Platform.Commit).
    public static void CommitCards(nuint at, nuint bytes)
    {
        nuint cards = Runtime.Cards;
        if (cards == 0 || bytes == 0) return;
        nuint first = at >> Runtime.CardShift;
        nuint last = (at + bytes - 1) >> Runtime.CardShift;
        Platform.Commit(cards + first, last - first + 1);
        if (_taken != 0) Platform.Commit(_taken + first, last - first + 1);
        if (_oldCards != 0) Platform.Commit(_oldCards + first, last - first + 1);
    }

    /// Whether the cycle about to run may be minor: there has been a major
    /// one to make the old generation, nothing has made its marks doubtful,
    /// and the old generation has not grown past what the pacing allows
    /// since (OldGrowth).
    static bool NextIsMinor()
    {
        return _generational && !_forceMajor && _majorLive != 0 && !_minorsCostly
            && _liveBytes < _majorLive + OldGrowth(_majorLive);
    }

    // THE HEAP IS PACED BY THE LIVE SIZE, NEVER BY THE MACHINE'S FREE MEMORY.
    // Paced by free memory, the native compiler compiling hello.cs (4.3 GB
    // allocated, 100-140 MB live after a major) let its old generation grow
    // to four times the last major's live size before the next major
    // (NextThreshold's three times, a server having the room), and took a
    // nursery of up to 64 MB on top: 890 MB of heap, 955 MB resident. None
    // of it bought time: a minor's cost follows the bytes allocated since the
    // last cycle -- its sweep of the young pages, the survivors it marks --
    // not the number of cycles, so the whole-heap pace changed only how much
    // garbage lay about between majors. Held to one live size of old growth
    // and a nursery of one live size, the same compile took 455 MB resident
    // and ran faster (11.8 s to about 10.4 s), with a major every 400 MB of
    // allocation instead of every 700.
    //
    // A hard limit -- a cap, the 32-bit ceiling -- still bounds both
    // (NextThreshold), so collections come sooner near it.

    /// How much the old generation may grow past the last major's live size
    /// before the next cycle is major: that live size, within what a hard
    /// limit allows.
    static long OldGrowth(long majorLive)
    {
        long bound = NextThreshold(majorLive);
        long growth = majorLive < bound ? majorLive : bound;
        // A QUARTER WHEN MEMORY IS SHORT (ShortHook): a ring-1 kernel's heap
        // let its old generation reach twice its live size before a major,
        // and held 22 MB with 9 live while the machine ran out.
        if (MemoryShort()) growth = growth / 4;
        return growth > MinThreshold ? growth : MinThreshold;
    }

    // PACED BY WHAT THEY COST. A minor cycle is worth running only if it
    // costs less than a major one. Where most chunks have had something
    // allocated in them -- a fragmented heap, where new objects fill the
    // holes between old ones -- a minor walks nearly all of the heap and
    // reads a card for nearly every old object, and costs nearly what a
    // major does. So the last minor and major cycles are timed (PauseClock),
    // and a minor that costs as much as a major stops them until the next
    // major, which tries one again; the pace meanwhile stays the nursery's.
    // When collections come changes; what a program computes never does.
    static long _minorMicros;
    static long _majorMicros;
    // 0-initialised, as every static of the collector must be: it runs
    // before anything that could run a static constructor.
    static bool _minorsCostly;
    const int PacedMicros = 10000;

    /// The next threshold after a cycle of the kind given, its length known.
    static long Paced(long live, bool minor, long micros)
    {
        if (minor)
        {
            _minorMicros = micros;
        }
        else
        {
            _majorMicros = micros;
        }
        // Below a hundredth of a second a major cycle's length is mostly the
        // clock's noise, and a small heap's pace is the nursery's either way.
        if (_minorMicros == 0 || _majorMicros < PacedMicros)
        {
            _minorsCostly = false;
            return Nursery(live);
        }
        // The major cycle that follows a stop to minors tries one again.
        // AT THE SAME PACE: a major that costs no more than a minor costs no
        // more at a minor's pace, and the heap stays one live size over.
        // Paced as a whole heap -- NextThreshold -- the native compiler's
        // heap doubled (950 MB to 1.9 GB at its peak) the moment marking got
        // cheap enough for its minors, mostly reading cards, to be judged
        // costly.
        _minorsCostly = minor && _minorMicros >= _majorMicros;
        return Nursery(live);
    }

    /// How much a program allocates between minor collections: the live
    /// size the last major found (the current one before any), at least
    /// NurseryLeast, and less near a hard limit (NextThreshold). A
    /// larger nursery buys nothing -- a minor's cost follows what was
    /// allocated, not how often it runs -- and costs its size in memory; a
    /// smaller one reads the same old objects' cards more often.
    static long Nursery(long live)
    {
        if (_nurseryFixed != 0)
        {
            return _nurseryFixed;
        }
        long n = _majorLive != 0 && _majorLive < live ? _majorLive : live;
        // A QUARTER OF IT WHEN MEMORY IS SHORT: the nursery is memory the
        // heap holds between cycles, and the pool keeps as much again.
        if (MemoryShort()) n = n / 4;
        if (n < NurseryLeast) n = NurseryLeast;
        // NEAR A HARD LIMIT a quarter of what it leaves, as before: a nursery
        // as large as the limit allows spreads each cycle's survivors over
        // that many fresh pages, and the holes they leave are no room for a
        // large array -- the compile above ran out of a 192 MB cap with 60 MB
        // of them.
        long bound = NextThreshold(live);
        if (n <= bound) return n;
        n = bound / 4;
        return n > MinThreshold ? n : MinThreshold;
    }

    /// The table the last cycle recorded becomes the one to read; the other
    /// is emptied for this cycle to record into.
    static void SwapHeld()
    {
        nuint read = _holding;
        _holding = _held;
        _held = read;
        Sys.WriteAddress(_holding, 0);
    }

    /// A block a stack or a register held, recorded for the next cycle.
    /// Several threads record at once (their own stacks, in the SCAN round).
    /// A full table makes the next cycle major: every block it could not
    /// record is then found the whole-heap way.
    static void Hold(nuint block)
    {
        nuint slot = Sys.AtomicAdd(_holding, 1u);
        if (slot >= HeldMax)
        {
            _forceMajor = true;
            return;
        }
        nuint at = _holding + HeldEntry + slot * HeldEntry;
        Sys.WriteAddress(at, block);
        Sys.WriteAddress(at + WordSize.Bytes, Sys.ReadAddress(block) & SizeMask);
    }

    /// The block whose payload a word points at the start of -- in any chunk,
    /// young or old -- or 0. Checked as whole (Whole), as BlockForPointer's
    /// exact case is; an interior pointer is not recorded.
    static nuint ExactBlock(nuint at)
    {
        if ((at & 7) != 0)
        {
            return 0;
        }
        nuint chunk = _snapshots ? HeapChunks.OfSnapshot(at) : HeapChunks.Of(at);
        if (chunk == 0)
        {
            return 0;
        }
        nuint block = at - HeaderBytes;
        if (block < HeapChunks.First(chunk))
        {
            return 0;
        }
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        if (size < LeastBlock || Beyond(block, size, HeapChunks.End(chunk)) || (word & FlagFree) != 0
            || !Whole(chunk, block, word))
        {
            return 0;
        }
        return block;
    }

    /// A word of a stack or a register: recorded, when it is a block, for the
    /// next cycle, and marked.
    static void MarkRoot(nuint at)
    {
        if (_generational)
        {
            nuint block = ExactBlock(at);
            if (block != 0)
            {
                Hold(block);
            }
        }
        MarkAt(at);
    }

    // ---- live registers, not stale ones ----------------------------------------
    //
    // A CALLEE-SAVED REGISTER KEEPS WHATEVER WAS LAST PUT IN IT. Every function
    // that uses EBX, ESI or EDI saves its caller's value in its prologue and
    // puts it back, so a pointer left in one by code long finished is carried
    // from frame to frame -- and a new thread starts with its parent's. Read
    // as roots, those saved words kept whole compilations alive: a compile
    // process's stack held the binders of units it had finished, through a
    // closure in a register nobody had used since.
    //
    // The compiler's stack maps (X86Backend.EmitStackMaps) say, at
    // each call, which of the three the caller holds live and which its
    // prologue saves where. So a thread reading its OWN stack walks the frame
    // chain: a frame's saved registers are the values of the frame outside it
    // (or of the first one further out that uses the register), and are
    // marked only where that frame's map says the register is live. Every
    // other word of every frame is read as before, a word at a time; a frame
    // with no map -- C, a signal frame, a stub -- is read whole and forgets
    // where the registers were. What stops being read is a dead register's
    // saved copy, and nothing else.
#if !TARGET_64BIT
    const int MapMagic = 0x314D5343;        // 'CSM1'
    const int MapVersion = 0;
    const int MapHeader = 36;
    const int MapCheckpoint = 12;
    const uint UnknownFrame = 0x80000000;
    const int DirectoryMagic = 0x52444D43;  // 'CMDR'
    const int LiveEbx = 8, LiveEsi = 64, LiveEdi = 128;
    // THE INDEX IS ONE RECORD A TABLE -- (first code address, the end of what
    // it covers, the table), sorted -- not one a call site: the compiler's
    // 234,000 sites were 2.8 MB of index. A return address finds its table
    // here by binary search, and its site in the table from the checkpoint
    // before it (the table's layout, below).
    static nuint _maps;
    const int MapRecord = 3 * WordSize.Bytes;
    static nuint _mapCount;
    static bool _mapsBuilt;

    /// Every stack map table of every registered image, indexed by the code
    /// it covers. Once, at the first collection, with the heap lock held.
    /// THE INDEX IS BUILT AGAIN when an image comes or goes after it was
    /// built (Runtime.RegisterFrames, Runtime.UnregisterFrames): a kernel
    /// module loaded or taken out while the kernel runs. The next collection
    /// rebuilds it, with the heap lock held, before it reads a stack.
    public static void MapsChanged()
    {
#if !TARGET_64BIT
        _mapsBuilt = false;
#endif
    }

    static nuint _mapsBytes;

    static void BuildMaps()
    {
        _mapsBuilt = true;
        if (_maps != 0)
        {
            Platform.Unmap(_maps, _mapsBytes);
            _maps = 0;
            _mapCount = 0;
        }
        nuint total = 0;
        long pass = 0;
        while (pass < 2)
        {
            nuint filled = 0;
            nuint m = 0;
            while (m < Runtime.MetadataCount())
            {
                nuint directory = Runtime.Metadata(m);
                m = m + 1;
                if (directory == 0 || Sys.Read32(directory) != DirectoryMagic || Sys.Read32(directory + 4) != 0
                    || Sys.Read32(directory + 12) != 16)
                {
                    continue;
                }
                nuint records = Sys.Read32(directory + 8);
                nuint r = 0;
                while (r < records && r < 100000)
                {
                    nuint record = directory + 16 + r * 16;
                    r = r + 1;
                    nuint table = Sys.Read32(record + 8);
                    if (table == 0 || Sys.Read32(table) != MapMagic || Sys.Read32(table + 4) != MapVersion
                        || Sys.Read32(table + 12) == 0)
                    {
                        continue;
                    }
                    if (pass == 1 && filled < total)
                    {
                        nuint basis = Sys.Read32(table + 16);
                        Sys.WriteAddress(_maps + filled * MapRecord, basis);
                        Sys.WriteAddress(_maps + filled * MapRecord + WordSize.Bytes, basis + Sys.Read32(table + 24));
                        Sys.WriteAddress(_maps + filled * MapRecord + 2 * WordSize.Bytes, table);
                        filled = filled + 1;
                    }
                    else if (pass == 0)
                    {
                        total = total + 1;
                    }
                }
            }
            if (pass == 0)
            {
                if (total == 0)
                {
                    return;
                }
                _maps = Platform.Map(total * MapRecord);
                if (_maps == 0)
                {
                    return;
                }
                _mapsBytes = total * MapRecord;
            }
            else
            {
                _mapCount = filled;
            }
            pass = pass + 1;
        }
        SortMaps();
    }

    // THE TABLE (StackMapTable in the linker's object model, where the layout
    // is written down in full). After a 36-byte header -- 'CSM1', 0, the
    // function and site counts, the base at +16, the checkpoint count at
    // +20, the span at +24, the stream's offset at +28 and the bitmap
    // pool's at +32 -- come the checkpoints, 12 bytes every thirty-second
    // site: the anchor (the code offset that site's delta counts from), the
    // site's offset in the table and its function record's. Then the stream,
    // all ULEB128: per function its start past the anchor, its frame size
    // << 3 | saved registers, its frame slots' bitmap reference; per call
    // site its return address past the anchor (never 0) and its bitmap
    // reference << 4 | live registers | 8 for a call with no map; a 0 ends
    // the function. Registers are bit 0 EBX, 1 ESI, 2 EDI. A bitmap
    // reference is odd for one inline (ref >> 1, bit b the word at
    // EBP - 4(b+1)) and even for one in the pool (at ref >> 1: dense, sparse
    // or a difference from another of the pool; KeepPooled).
    //
    // A lookup is a binary search of the checkpoints and then a read forward
    // of at most thirty-two sites: every site after a checkpoint lies above
    // its anchor and every site before it at or below. Nothing allocates.

    /// A ULEB128 of a stack-map table at `at`, with `at` left just past it.
    static nuint MapUleb(nuint at, out nuint next)
    {
        nuint value = 0;
        int shift = 0;
        while (true)
        {
            nuint b = Sys.Read8(at);
            at = at + 1;
            value = value | ((b & 127) << shift);
            if ((b & 128) == 0)
            {
                next = at;
                return value;
            }
            shift = shift + 7;
        }
    }

    /// EBX, ESI and EDI as the table packs them (bits 0, 1, 2) by hardware number.
    static nuint MapRegisters(nuint bits)
    {
        return ((bits & 1) << 3) | ((bits & 2) << 5) | ((bits & 4) << 5);
    }

    /// The call site a return address is: true, with its live registers (by
    /// hardware number, every one and UnknownFrame for a call with no map)
    /// and its function's saved ones from bit 16, its function's frame size,
    /// the bitmap references of its live spill slots and of its function's
    /// frame slots, and its table; false if no table has it.
    static bool MapSite(nuint ret, out nuint regs, out nuint frameSize, out nuint slots, out nuint objects, out nuint table)
    {
        regs = 0;
        frameSize = 0;
        slots = 0;
        objects = 0;
        table = 0;
        nuint low = 0;
        nuint high = _mapCount;
        while (low < high)
        {
            nuint middle = low + (high - low) / 2;
            if (MapKey(middle) <= ret) low = middle + 1;
            else high = middle;
        }
        if (low == 0) return false;
        nuint record = _maps + (low - 1) * MapRecord;
        if (ret >= Sys.ReadAddress(record + WordSize.Bytes)) return false;
        nuint t = Sys.ReadAddress(record + 2 * WordSize.Bytes);
        nuint offset = ret - Sys.ReadAddress(record);
        // The last checkpoint whose anchor is below the address.
        low = 0;
        high = Sys.Read32(t + 20);
        while (low < high)
        {
            nuint middle = low + (high - low) / 2;
            if (Sys.Read32(t + MapHeader + middle * MapCheckpoint) < offset) low = middle + 1;
            else high = middle;
        }
        if (low == 0) return false;
        nuint point = t + MapHeader + (low - 1) * MapCheckpoint;
        nuint anchor = Sys.Read32(point);
        nuint at = t + Sys.Read32(point + 4);
        nuint end = t + Sys.Read32(t + 32);
        // The record of the function the checkpoint is in: its start (which
        // the anchor has already passed), its frame, its frame slots.
        nuint info = t + Sys.Read32(point + 8);
        MapUleb(info, out info);
        nuint frame = MapUleb(info, out info);
        nuint own = MapUleb(info, out info);
        while (at < end)
        {
            nuint delta = MapUleb(at, out at);
            if (delta == 0)
            {
                // Past the function's last site: the next function's record.
                if (at >= end) return false;
                anchor = anchor + MapUleb(at, out at);
                frame = MapUleb(at, out at);
                own = MapUleb(at, out at);
                continue;
            }
            anchor = anchor + delta;
            nuint payload = MapUleb(at, out at);
            if (anchor > offset) return false;
            if (anchor == offset)
            {
                nuint saved = MapRegisters(frame & 7) << 16;
                if ((payload & 8) != 0) regs = 0xFF | saved | UnknownFrame;
                else regs = MapRegisters(payload & 7) | saved;
                frameSize = frame >> 3;
                slots = payload >> 4;
                objects = own;
                table = t;
                return true;
            }
        }
        return false;
    }

    /// A frame's words a bitmap reference names: inline (odd, bit b of
    /// ref >> 1 the word at frame - 4(b+1)) or pooled in the table (even).
    /// Those at or above `from` only.
    static nuint KeepMap(nuint frame, nuint table, nuint reference, nuint from, nuint copy, nuint at)
    {
        if ((reference & 1) == 0)
        {
            nuint pool = table + Sys.Read32(table + 32);
            return KeepPooled(frame, pool, pool + (reference >> 1), from, copy, at);
        }
        nuint bits = reference >> 1;
        nuint b = 0;
        while (bits != 0)
        {
            if ((bits & 1) != 0)
            {
                nuint slot = frame - 4 * (b + 1);
                if (slot >= from)
                {
                    at = KeepWord(Sys.ReadAddress(slot), copy, at);
                }
            }
            bits = bits >> 1;
            b = b + 1;
        }
        return at;
    }

    static nuint MapKey(nuint i)
    {
        return Sys.ReadAddress(_maps + i * MapRecord);
    }

    static void SwapMaps(nuint a, nuint b)
    {
        nuint k = 0;
        while (k < MapRecord)
        {
            nuint held = Sys.ReadAddress(_maps + a * MapRecord + k);
            Sys.WriteAddress(_maps + a * MapRecord + k, Sys.ReadAddress(_maps + b * MapRecord + k));
            Sys.WriteAddress(_maps + b * MapRecord + k, held);
            k = k + WordSize.Bytes;
        }
    }

    static void SiftMaps(nuint at, nuint count)
    {
        while (true)
        {
            nuint child = at * 2 + 1;
            if (child >= count)
            {
                return;
            }
            if (child + 1 < count && MapKey(child + 1) > MapKey(child))
            {
                child = child + 1;
            }
            if (MapKey(at) >= MapKey(child))
            {
                return;
            }
            SwapMaps(at, child);
            at = child;
        }
    }

    /// In place, allocating nothing: a heap sort.
    static void SortMaps()
    {
        nuint n = _mapCount;
        nuint i = n / 2;
        while (i > 0)
        {
            i = i - 1;
            SiftMaps(i, n);
        }
        nuint end = n;
        while (end > 1)
        {
            end = end - 1;
            SwapMaps(0, end);
            SiftMaps(0, end);
        }
    }

    /// Whether this thread's own stack can be read with its registers' liveness.
    public static bool PreciseRegisters()
    {
        return _mapCount != 0;
    }

    /// A word of this thread's own stack, kept: marked, or written into
    /// `copy` at `at` (a stack copied at STAMP). Answers where the next goes.
    static nuint KeepWord(nuint word, nuint copy, nuint at)
    {
        if (copy != 0)
        {
            Sys.WriteAddress(copy + at * WordSize.Bytes, word);
            return at + 1;
        }
        if (_census && !_minor)
        {
            long before = _censusMarked;
            MarkRoot(word);
            Drain();
            long got = _censusMarked - before;
            if (got >= CensusRootBytes)
            {
                SayNumber("gc census root: kind ", 6);
                SayNumber("gc census root:   word ", word);
                SayNumber("gc census root:   bytes ", got);
                Runtime.WriteLiteral(2, "gc census root:   in the frame of\n");
                Runtime.SayFrame(2, _keepingFor);
                nuint held = BlockForPointer(word);
                if (held != 0)
                {
                    SayNumber("gc census root:   its kind ", Sys.ReadAddress(held + KindAt));
                    SayNumber("gc census root:   its first word ", Sys.ReadAddress(held + HeaderBytes));
                    SayNumber("gc census root:   its size ", Sys.ReadAddress(held) & SizeMask);
                }
            }
            return at;
        }
        MarkRoot(word);
        return at;
    }

    /// The code address of the frame the walk is in, for the census.
    static nuint _keepingFor;

    /// [from, to) of this stack, every word kept but the three saved slots.
    static nuint KeepRange(nuint from, nuint to, nuint s1, nuint s2, nuint s3, nuint copy, nuint at)
    {
        nuint p = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
        while (p < to)
        {
            if (p != s1 && p != s2 && p != s3)
            {
                at = KeepWord(Sys.ReadAddress(p), copy, at);
            }
            p = p + WordSize.Bytes;
        }
        return at;
    }

    /// The words of a frame a pooled bitmap names, kept -- those at or above
    /// `from` only. A bitmap written whole (KeepBitmap), or a DIFFERENCE (a
    /// zero head): its root's words but those it lacks, then those it adds.
    /// The root is never a difference itself, and each word is read once.
    static nuint KeepPooled(nuint frame, nuint pool, nuint bitmap, nuint from, nuint copy, nuint at)
    {
        nuint p = 0;
        if (MapUleb(bitmap, out p) != 0)
        {
            return KeepBitmap(frame, bitmap, 0, 0, from, copy, at);
        }
        nuint root = MapUleb(p, out p);
        nuint lacking = MapUleb(p, out p);
        nuint list = p;
        nuint n = 0;
        while (n < lacking)
        {
            MapUleb(p, out p);
            n = n + 1;
        }
        at = KeepBitmap(frame, pool + root, list, lacking, from, copy, at);
        nuint adding = MapUleb(p, out p);
        // One past each word named: the first is its distance from the
        // frame's first word, each next one's past the last, less one.
        nuint past = 0;
        n = 0;
        while (n < adding)
        {
            past = past + MapUleb(p, out p) + 1;
            nuint slot = frame - 4 * past;
            if (slot >= from)
            {
                at = KeepWord(Sys.ReadAddress(slot), copy, at);
            }
            n = n + 1;
        }
        return at;
    }

    /// The words of a frame a bitmap written whole names, kept -- those at
    /// or above `from` only, and not the `skips` words listed at `skip` (a
    /// sparse list, ascending, as a difference gives). Dense (a byte count
    /// << 1, then the bytes, bit b of byte k the word at frame - 4(8k + b +
    /// 1)) or sparse (a word count << 1 | 1, then the first word and each
    /// next word's distance past it less one).
    static nuint KeepBitmap(nuint frame, nuint bitmap, nuint skip, nuint skips, nuint from, nuint copy, nuint at)
    {
        nuint p = 0;
        nuint head = MapUleb(bitmap, out p);
        nuint bytes = head >> 1;
        // The next word the skip list leaves out; read only while one is left.
        nuint gone = 0;
        if (skips > 0)
        {
            gone = MapUleb(skip, out skip);
        }
        if ((head & 1) != 0)
        {
            // One past each word named, as KeepPooled counts them.
            nuint past = 0;
            nuint n = 0;
            while (n < bytes)
            {
                past = past + MapUleb(p, out p) + 1;
                nuint word = past - 1;
                while (skips > 0 && gone < word)
                {
                    skips = skips - 1;
                    if (skips > 0)
                    {
                        gone = gone + MapUleb(skip, out skip) + 1;
                    }
                }
                nuint slot = frame - 4 * (word + 1);
                if (slot >= from && (skips == 0 || gone != word))
                {
                    at = KeepWord(Sys.ReadAddress(slot), copy, at);
                }
                n = n + 1;
            }
            return at;
        }
        nuint k = 0;
        while (k < bytes)
        {
            nuint bits = Sys.Read8(p + k);
            nuint b = 0;
            while (bits != 0)
            {
                if ((bits & 1) != 0)
                {
                    nuint word = k * 8 + b;
                    while (skips > 0 && gone < word)
                    {
                        skips = skips - 1;
                        if (skips > 0)
                        {
                            gone = gone + MapUleb(skip, out skip) + 1;
                        }
                    }
                    nuint slot = frame - 4 * (word + 1);
                    if (slot >= from && (skips == 0 || gone != word))
                    {
                        at = KeepWord(Sys.ReadAddress(slot), copy, at);
                    }
                }
                bits = bits >> 1;
                b = b + 1;
            }
            k = k + 1;
        }
        return at;
    }

    /// THIS THREAD'S OWN STACK, [from, to), read by the stack maps. A frame
    /// the maps know is read as they describe it: the spill slots live at its
    /// call, its IR frame slots as they are, the arguments it is pushing, and
    /// its callee-saved registers where the frames under it saved them, if it
    /// holds them live -- and not its dead spill slots, the words it has not
    /// written yet, or the saved copies of registers it does not use. What a
    /// word left there by code long finished pointed at was kept alive by
    /// being read: whole compilations, through a closure in a slot the frame
    /// had not reached yet. A frame the maps do not know -- C, a signal
    /// frame, the walk's own -- is read whole, and forgets where the
    /// registers were. Marks what it keeps, or, given `copy`, writes it there
    /// and answers how many words it wrote.
    public static nuint ScanOwnStack(nuint from, nuint to, nuint copy)
    {
        const int w = WordSize.Bytes;
        nuint atEbx = 0;
        nuint atEsi = 0;
        nuint atEdi = 0;
        nuint at = 0;
        nuint start = from;
        nuint below = 0;
        nuint frame = Sys.FramePointer();
        while (frame != 0 && frame < to)
        {
            nuint regs = 0;
            nuint frameSize = 0;
            nuint slots = 0;
            nuint objects = 0;
            nuint table = 0;
            bool known = false;
            if (below != 0)
            {
                // The site's live registers, its function's saved ones from
                // bit 16, and UnknownFrame for a call with no map.
                known = MapSite(Sys.ReadAddress(below + w), out regs, out frameSize, out slots, out objects, out table);
            }
            _keepingFor = below != 0 ? Sys.ReadAddress(below + w) : 0;
            nuint end = frame + 2 * w;
            if (known && (regs & UnknownFrame) == 0)
            {
                // Its live registers at the call it is in: where the frames
                // under it saved them.
                if ((regs & LiveEbx) != 0 && atEbx != 0) at = KeepWord(Sys.ReadAddress(atEbx), copy, at);
                if ((regs & LiveEsi) != 0 && atEsi != 0) at = KeepWord(Sys.ReadAddress(atEsi), copy, at);
                if ((regs & LiveEdi) != 0 && atEdi != 0) at = KeepWord(Sys.ReadAddress(atEdi), copy, at);
                // Its own saves: the values of the frames outside it.
                nuint slot = frame - frameSize;
                if ((regs & (LiveEbx << 16)) != 0) { slot = slot - w; atEbx = slot; }
                if ((regs & (LiveEsi << 16)) != 0) { slot = slot - w; atEsi = slot; }
                if ((regs & (LiveEdi << 16)) != 0) { slot = slot - w; atEdi = slot; }
                // The arguments it is pushing, under its saved registers.
                nuint lowest = start > from ? start : from;
                if (slot > lowest)
                {
                    at = KeepRange(lowest, slot < to ? slot : to, 0, 0, 0, copy, at);
                }
                // Its spill slots live at the call, and its IR frame slots.
                at = KeepMap(frame, table, slots, from, copy, at);
                at = KeepMap(frame, table, objects, from, copy, at);
            }
            else
            {
                // Read whole: its saved registers among its words.
                if (known)
                {
                    nuint regsAll = regs;
                    if ((regsAll & LiveEbx) != 0 && atEbx != 0) at = KeepWord(Sys.ReadAddress(atEbx), copy, at);
                    if ((regsAll & LiveEsi) != 0 && atEsi != 0) at = KeepWord(Sys.ReadAddress(atEsi), copy, at);
                    if ((regsAll & LiveEdi) != 0 && atEdi != 0) at = KeepWord(Sys.ReadAddress(atEdi), copy, at);
                }
                else
                {
                    // WHAT THE FRAMES UNDER IT SAVED, whatever it holds: a
                    // frame no map describes -- C called from managed code,
                    // calling back in -- may never touch a register and so
                    // carry a reference of a frame outside it through to
                    // the callback, whose saves are below the words read
                    // whole. Forgotten here, a reference held only in ESI
                    // across qsort was freed while qsort ran.
                    if (atEbx != 0) at = KeepWord(Sys.ReadAddress(atEbx), copy, at);
                    if (atEsi != 0) at = KeepWord(Sys.ReadAddress(atEsi), copy, at);
                    if (atEdi != 0) at = KeepWord(Sys.ReadAddress(atEdi), copy, at);
                }
                atEbx = 0;
                atEsi = 0;
                atEdi = 0;
                if (end > start && end > from)
                {
                    at = KeepRange(start > from ? start : from, end < to ? end : to, 0, 0, 0, copy, at);
                }
            }
            if (end > start)
            {
                start = end;
            }
            nuint next = Sys.ReadAddress(frame);
            if (next <= frame)
            {
                break;
            }
            below = frame;
            frame = next;
        }
        if (start < to)
        {
            at = KeepRange(start > from ? start : from, to, 0, 0, 0, copy, at);
        }
        return at;
    }
#else
    /// No stack maps on x86-64 (BuildMaps is i386's): nothing to rebuild.
    public static void MapsChanged()
    {
    }

    public static bool PreciseRegisters()
    {
        return false;
    }

    public static nuint ScanOwnStack(nuint from, nuint to, nuint copy)
    {
        return 0;
    }
#endif

    // WHICH ROOT HOLDS WHAT (the census, a whole cycle): each root word marked
    // and the queue drained before the next, so the bytes a word newly marks
    // are the ones only it -- or it first -- reaches, and a word that holds
    // CensusRootBytes or more is said: its kind (1 the collector's stack, 2 the
    // statics, 3 a registered range, 4 a thread's stack, 5 a stack as it was
    // at STAMP), where it is, what it holds, and how much. A stale word on a
    // stack that keeps a whole compilation alive is found here.
    const int CensusRootBytes = 4194304;
    static long _censusMarked;

    public static void ScanRootsAttributed(nuint from, nuint to, int kind, bool stack)
    {
        if (!_census || _minor)
        {
            // A RANGE OF ROOTS A BUDGET AT A TIME, the platform asked between
            // (YieldHook) whenever the heap lock is not this thread's -- the
            // concurrent cycle's root scan, whose program threads may run
            // meanwhile anyway: a kernel's statics and its modules' data are
            // megabytes, read in one go they were 40-60 ms the processor gave
            // nobody (an audio mixer woken at once, run 50 ms later, on a
            // K6-III). A word scanned is scanned once either way.
            if (YieldHook != 0 && to - from > RootsBetweenYields * WordSize.Bytes && !GcLock.HeldByMe())
            {
                nuint at = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
                while (at < to)
                {
                    nuint end = at + RootsBetweenYields * WordSize.Bytes;
                    if (end > to || end < at) end = to;
                    if (stack) ScanRoots(at, end);
                    else ScanRange(at, end);
                    at = end;
                    if (at < to) Sys.Call(YieldHook, 0, 0, 0);
                }
                return;
            }
            if (stack) ScanRoots(from, to);
            else ScanRange(from, to);
            return;
        }
        nuint p = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
        while (p < to)
        {
            long before = _censusMarked;
            nuint word = Sys.ReadAddress(p);
            if (stack) MarkRoot(word);
            else MarkAt(word);
            Drain();
            long got = _censusMarked - before;
            if (got >= CensusRootBytes)
            {
                SayNumber("gc census root: kind ", kind);
                SayNumber("gc census root:   at ", p);
                SayNumber("gc census root:   word ", word);
                SayNumber("gc census root:   bytes ", got);
                // On this thread's own stack, the function whose frame it is
                // in: the frame chain walked up to the first frame above it.
                // A slot below frame F is F's function's: the one the frame
                // under F returns into.
                if (kind == 1)
                {
                    nuint below = Sys.FramePointer();
                    nuint frame = below;
                    while (frame != 0 && frame <= p)
                    {
                        nuint next = Sys.ReadAddress(frame);
                        if (next <= frame) { frame = 0; break; }
                        below = frame;
                        frame = next;
                    }
                    if (frame != 0)
                    {
                        Runtime.WriteLiteral(2, "gc census root:   in the frame of\n");
                        Runtime.SayFrame(2, Sys.ReadAddress(below + WordSize.Bytes));
                    }
                }
                nuint held = BlockForPointer(word);
                if (held != 0)
                {
                    SayNumber("gc census root:   its kind ", Sys.ReadAddress(held + KindAt));
                    SayNumber("gc census root:   its first word ", Sys.ReadAddress(held + HeaderBytes));
                    SayNumber("gc census root:   its size ", Sys.ReadAddress(held) & SizeMask);
                }
            }
            p = p + WordSize.Bytes;
        }
    }

    /// Every aligned word of a stack or a thread's saved registers, each
    /// marked as a root (MarkRoot), not scanned as a block's fields.
    public static void ScanRoots(nuint from, nuint to)
    {
        nuint p = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
        StackWords = StackWords + (long)((to - p) / WordSize.Bytes);

        while (p < to)
        {
            MarkRoot(Sys.ReadAddress(p));
            p = p + WordSize.Bytes;
        }
    }

    /// A minor collection's roots besides the ordinary ones: the blocks the
    /// stacks held at the last cycle, scanned if they are there still and old
    /// now (a block may have been freed, or freed and made again, since).
    static void RescanHeld()
    {
        nuint count = Sys.ReadAddress(_held);
        if (count > HeldMax) count = HeldMax;
        for (nuint i = 0; i < count; i++)
        {
            nuint at = _held + HeldEntry + i * HeldEntry;
            nuint block = Sys.ReadAddress(at);
            nuint size = Sys.ReadAddress(at + WordSize.Bytes);
            nuint chunk = HeapChunks.OfSnapshot(block + HeaderBytes);
            if (chunk == 0 || Beyond(block, size, HeapChunks.End(chunk)))
            {
                continue;
            }
            // In a chunk whose starts this cycle wrote down, a block is one
            // only where a start is: a header left inside a free block by a
            // free since -- or a sweep's dead run -- is none.
            if (_snapshots && HeapChunks.StartsCycle(chunk) == _cycle && !HeapChunks.IsStart(chunk, block))
            {
                continue;
            }
            nuint word = Sys.ReadAddress(block);
            if ((word & SizeMask) == size && (word & (FlagFree | FlagMark)) == FlagMark
                && Whole(chunk, block, word))
            {
                HeldWords = HeldWords + (long)(size / WordSize.Bytes);
                ScanBlock(block, size, TailIn(chunk));
            }
        }
    }

    // WHERE THE CARDS' TAKING IS, between steps of the stop: the snapshot
    // chunk by its index, and -- while one is under way (_cardsOpen) -- the
    // next card of it and its last.
    static nuint _cardsWhich, _cardsCard, _cardsLast;
    static bool _cardsOpen, _cardsYoung, _cardsUnwalked;

    static void BeginCards()
    {
        _cardsWhich = 0;
        _cardsOpen = false;
    }

    /// AT THE SNAPSHOT: every set card over the heap cleared, with the heap
    /// lock held, and -- for a minor cycle -- moved into the taken table, to
    /// be read while marking (ScanTakenCards). A card a store sets afterwards
    /// stays set for the next cycle.
    ///
    /// A YOUNG CHUNK'S CARD IS TAKEN ONLY OVER AN OLD OBJECT. Every store that
    /// fills a new object sets its card, so nearly every kilobyte allocated
    /// since the last cycle has one set, and none of them needs reading: a
    /// young object is traced if anything reaches it. The snapshot walk has
    /// just flagged (2) every card an old block other than a leaf lies in
    /// (OldCards), whether set yet or not -- a store may land between the
    /// walk and this -- and only a set card so flagged, or one over a
    /// thread's buffer (which the walk stepped over), is kept.
    ///
    /// On from where they were, until `budget` cards are done (-1: all):
    /// true when every snapshot chunk's are.
    static bool TakeCardsSome(bool minor, long budget)
    {
        nuint cards = Runtime.Cards;
        long work = 0;
        while (true)
        {
            nuint chunk = HeapChunks.SnapshotChunk(_cardsWhich);
            if (chunk == 0) return true;
            if (!_cardsOpen)
            {
                // A page this cycle did not walk (_pagesUnwalked): young by its
                // flag, and its old blocks' cards in _oldCards, which its last
                // sweep wrote.
                _cardsUnwalked = _pagesUnwalked && HeapChunks.PageClass(chunk) != 0;
                _cardsYoung = _cardsUnwalked ? HeapChunks.IsYoung(chunk) : HeapChunks.StartsCycle(chunk) == _cycle;
                if (CheckOldCards && minor && _cardsUnwalked && _cardsYoung) CheckOldCardsOf(chunk);
                _cardsCard = HeapChunks.First(chunk) >> Runtime.CardShift;
                _cardsLast = (HeapChunks.End(chunk) - 1) >> Runtime.CardShift;
                _cardsOpen = true;
            }
            bool young = _cardsYoung, unwalked = _cardsUnwalked;
            nuint card = _cardsCard;
            nuint last = _cardsLast;
            while (card <= last)
            {
                if (budget >= 0 && work >= budget)
                {
                    _cardsCard = card;
                    return false;
                }
                work = work + 1;
                bool set = Sys.Read8(cards + card) != 0;
                if (set)
                {
                    Sys.Write8(cards + card, 0);
                }
                if (!minor)
                {
                    card = card + 1;
                    continue;
                }
                if (!young)
                {
                    if (set) Sys.Write8(_taken + card, 1);
                }
                else
                {
                    bool old = unwalked ? Sys.Read8(_oldCards + card) != 0 : Sys.Read8(_taken + card) == 2;
                    bool keep = set && (old || BufferOverlaps(card << Runtime.CardShift, (card + 1) << Runtime.CardShift));
                    Sys.Write8(_taken + card, keep ? (byte)1 : (byte)0);
                }
                card = card + 1;
            }
            _cardsWhich = _cardsWhich + 1;
            _cardsOpen = false;
        }
    }

    /// CheckOldCards: an unwalked young page's blocks stepped through by
    /// its class, and every old block (marked and scanned, not a leaf) on a
    /// card _oldCards does not hold said -- the page, the block, its header,
    /// its kind and vtable, the card and whether a store set it, whether a
    /// thread's buffer covers it, and the page's owner. Before the cards are
    /// taken, so what TakeCards will keep can be told from it.
    static void CheckOldCardsOf(nuint chunk)
    {
        if (_oldCardsReports >= 24) return;
        nuint size = ClassSize(HeapChunks.PageClass(chunk) - 1);
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        while (block + size <= end && _oldCardsReports < 24)
        {
            nuint header = Sys.ReadAddress(block);
            if ((header & SizeMask) != size) return;
            if ((header & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan) && Sys.ReadAddress(block + KindAt) != KindLeaf)
            {
                nuint card = block >> Runtime.CardShift;
                nuint last = (block + size - 1) >> Runtime.CardShift;
                while (card <= last)
                {
                    if (Sys.Read8(_oldCards + card) == 0)
                    {
                        SayNumber("gc old cards: page ", chunk);
                        SayNumber("gc old cards:   old block not on _oldCards ", block);
                        SayNumber("gc old cards:   header ", header);
                        SayNumber("gc old cards:   kind ", Sys.ReadAddress(block + KindAt));
                        SayNumber("gc old cards:   vtable ", Sys.ReadAddress(block + HeaderBytes));
                        SayNumber("gc old cards:   card ", card);
                        SayNumber("gc old cards:   card set by a store ", Sys.Read8(Runtime.Cards + card));
                        SayNumber("gc old cards:   a buffer covers it ", BufferOverlaps(card << Runtime.CardShift, (card + 1) << Runtime.CardShift) ? 1 : 0);
                        SayNumber("gc old cards:   page owner ", HeapChunks.Owner(chunk));
                        SayNumber("gc old cards:   cycle ", _cycle);
                        _oldCardsReports = _oldCardsReports + 1;
                        break;
                    }
                    card = card + 1;
                }
            }
            block = block + size;
        }
    }

    // ---- the statics by their cards ----------------------------------------
    //
    // A MINOR COLLECTION READS THE STATICS AS IT READS AN OLD CHUNK: only the
    // kilobytes whose cards a store set since the last cycle. A young object
    // a static holds was put there since the last cycle -- it was made since
    // -- and every store of a reference into a static marks its card: the
    // compiler marks it after the store as it does a field's, in the
    // collector's and the runtime's own classes too (Lowering.CardMarkAt),
    // Interlocked's exchanges with it, a struct copied in for each reference
    // in it. A static set before the cards existed is set before the first
    // collection, which is major. What holds references in the statics and
    // is written without a store the compiler sees is read whole every time:
    // the main thread's block (Tls), where the thread's statics table, its
    // async context and the rest are poked; and every range registered as
    // roots (GcRoots.Register) is scanned whole as before. A major collection
    // reads them all.
    //
    // ONLY WHERE THE PLATFORM SAYS SO (StaticsByCards): a user-mode Linux
    // program, whose statics are written by compiled code alone. A kernel's
    // may be written by hand at ring 0, and reads its statics whole until
    // its platform sets this.

    /// Set by a platform whose statics take a reference only through a store
    /// the compiler card-marks; false reads them whole at every collection.
    public static bool StaticsByCards;

    // Whether this cycle reads the statics by their cards: minor, with
    // generations, a platform that allows it, and no census -- whose roots
    // are each attributed, and read whole.
    static bool StaticsCarded() => _minor && _generational && StaticsByCards && !_census && Runtime.Cards != 0 && _taken != 0;

    /// AT THE SNAPSHOT, with TakeCards: the statics' set cards cleared, and
    /// for a minor cycle moved into the taken table to be read (ScanStatics).
    /// A store after this sets its card for the next cycle; one between this
    /// and the scan is the barrier's, as an old chunk's is.
    static void TakeStaticCards(bool minor)
    {
        if (!StaticsByCards || Runtime.Cards == 0 || _taken == 0) return;
        nuint cards = Runtime.Cards;
        bool take = StaticsCarded();
        nuint first = Sys.DataStart() >> Runtime.CardShift;
        nuint last = (Sys.DataEnd() - 1) >> Runtime.CardShift;
        for (nuint card = first; card <= last; card++)
        {
            if (Sys.Read8(cards + card) == 0) continue;
            Sys.Write8(cards + card, 0);
            if (take) Sys.Write8(_taken + card, 1);
        }
    }

    /// The statics [from, to) marked from: whole, or -- a minor cycle that
    /// may (StaticsCarded) -- the kilobytes whose cards were taken at the
    /// snapshot, and the main thread's block whole.
    public static void ScanStatics(nuint from, nuint to)
    {
        if (!StaticsCarded())
        {
            ScanRootsAttributed(from, to, 2, false);
            return;
        }
        nuint block = Sys.MainThreadBlock();
        if (block >= from && block < to) ScanRange(block, block + Tls.Bytes);
        nuint first = from >> Runtime.CardShift;
        nuint last = (to - 1) >> Runtime.CardShift;
        nuint read = 0;
        for (nuint card = first; card <= last; card++)
        {
            if (Sys.Read8(_taken + card) == 0) continue;
            Sys.Write8(_taken + card, 0);
            nuint low = card << Runtime.CardShift;
            nuint high = low + (1 << Runtime.CardShift);
            if (low < from) low = from;
            if (high > to) high = to;
            ScanRange(low, high);
            read = read + (high - low);
        }
        StaticCardWords = StaticCardWords + (long)(read / WordSize.Bytes);
        StaticWordsSkipped = StaticWordsSkipped + (long)((to - from - read) / WordSize.Bytes);
    }

    /// Flags every card an old block lies in, for TakeCards -- a leaf holds
    /// no reference and flags none.
    static void OldCards(nuint block, nuint size)
    {
        if (Sys.ReadAddress(block + KindAt) == KindLeaf)
        {
            return;
        }
        nuint card = block >> Runtime.CardShift;
        nuint last = (block + size - 1) >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.Write8(_taken + card, 2);
            card = card + 1;
        }
    }

    /// Whether [from, to) overlaps a captured thread buffer.
    static bool BufferOverlaps(nuint from, nuint to)
    {
        nuint i = GcThreads.BufferAtOrAbove(from);
        if (i > 0 && GcThreads.BufferLimit(i - 1) > from)
        {
            return true;
        }
        return i < GcThreads.BufferCount() && GcThreads.BufferBase(i) < to;
    }

    /// Every card set since TakeCards, over the snapshot's chunks, added to
    /// the ones this cycle reads -- and left set (the concurrent path, after
    /// its first round).
    static void PeekCards()
    {
        nuint cards = Runtime.Cards;
        nuint which = 0;
        nuint chunk = HeapChunks.SnapshotChunk(0);
        while (chunk != 0)
        {
            nuint card = HeapChunks.First(chunk) >> Runtime.CardShift;
            nuint last = (HeapChunks.End(chunk) - 1) >> Runtime.CardShift;
            while (card <= last)
            {
                if (Sys.Read8(cards + card) != 0)
                {
                    Sys.Write8(_taken + card, 1);
                }
                card = card + 1;
            }
            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// A MINOR CYCLE'S OTHER ROOTS: the kilobytes whose cards were taken at
    /// the snapshot -- a pointer an old object was given since the last cycle
    /// is in one of them -- read once the start tables are whole, and their
    /// taken cards cleared.
    ///
    /// AN OLD CHUNK'S are read word by word: every block in it is old, and
    /// its start table is the last major cycle's, which this one does not
    /// trust. A YOUNG CHUNK'S are read block by block (ScanCardBlocks): only
    /// the old blocks, and only the words of them that are references and in
    /// the kilobyte. The young blocks there are not roots: read as roots,
    /// every young object a dead one pointed at would be kept, and made old.
    static void ScanTakenCards()
    {
        // ON THE WORKERS TOO, chunk by chunk, when they are marking beside
        // this thread: each chunk's cards are its own, and what they find is
        // marked and queued as any marker's finds are. Read here alone, the
        // cards were most of a minor cycle's roots, and the workers waited.
        bool shared = _cardsTogether;
        Sys.AtomicSwap(Sys.AddressOf(ref _cardNext), 0);
        if (shared)
        {
            Sys.AtomicSwap32(Sys.AddressOf(ref _job), 3);
            Platform.Wake(GcLock.Words() + GcLock.GreyTail, 0x7FFFFFFF);
        }
        ScanCardsSome();
        if (shared)
        {
            // Marking what the workers' cards shared out while they finish.
            while (Sys.Read32(Sys.AddressOf(ref _cardBusy)) != 0)
            {
                if (DrainSome(-1) == 0) Sys.Pause();
            }
            Sys.AtomicSwap32(Sys.AddressOf(ref _job), 0);
        }
    }

    /// Whether the card scan is shared with the workers (CollectInner).
    static bool _cardsTogether;
    static nuint _cardNext;
    static int _cardBusy;       // how many workers are reading cards

    /// Snapshot chunks taken and their cards read until there are none.
    // WHAT THE CARDS FIND IS MARKED ONTO THE READER'S OWN STACK (ClaimLocal)
    // and scanned by it after each chunk, busy (Active) all the while: each
    // find was a push through the shared queue's locked instructions.
    static void ScanCardsSome()
    {
        nuint ctl = GcLock.Words();
        Sys.AtomicAdd32(ctl + GcLock.Active, 1);
        nuint local = ClaimLocal();
        while (true)
        {
            Sys.AtomicAdd32(Sys.AddressOf(ref _cardBusy), 1);
            nuint which = Sys.AtomicAdd(Sys.AddressOf(ref _cardNext), 1u);
            nuint chunk = HeapChunks.SnapshotChunk(which);
            if (chunk == 0)
            {
                Sys.AtomicAdd32(Sys.AddressOf(ref _cardBusy), -1);
                break;
            }
            ScanChunkCards(chunk, local);
            if (local != 0) DrainLocal(local);
            Sys.AtomicAdd32(Sys.AddressOf(ref _cardBusy), -1);
        }
        if (local != 0) ReleaseLocal(local);
        Sys.AtomicAdd32(ctl + GcLock.Active, -1);
    }

    /// Scans this thread's own stack until it is empty; given up, what is
    /// left goes with the queue (GiveUp).
    static void DrainLocal(nuint local)
    {
        nuint ctl = GcLock.Words();
        while (Sys.Read32(ctl + GcLock.Abort) == 0)
        {
            nuint entry = PopLocal(local);
            if (entry == 0) return;
            nuint block = Untag(entry);
            nuint tail = TailOfEntry(entry);
            if (ClaimScan(block, tail)) ScanBlock(block, Sys.ReadAddress(block) & SizeMask, tail, local);
        }
    }

    /// One chunk's taken cards, read and cleared.
    static void ScanChunkCards(nuint chunk, nuint local)
    {
        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        // A page is read block by block by its class whatever its start
        // table (ScanCardBlocks): only its old blocks, walked or not.
        bool indexed = _snapshots && (HeapChunks.StartsCycle(chunk) == _cycle || _pagesUnwalked && HeapChunks.PageClass(chunk) != 0);
        nuint card = first >> Runtime.CardShift;
        nuint last = (end - 1) >> Runtime.CardShift;
        nuint taken = 0;
        nuint words = 0;
        // A BUDGET OF CARDS AT A TIME, the platform asked between (YieldHook)
        // whenever the heap lock is not this thread's -- a concurrent minor
        // cycle's cards, read while the program runs anyway: a chunk's cards
        // read in one go held a K6-III's one processor tens of milliseconds
        // (the root scan's reason, ScanRootsAttributed).
        bool yields = YieldHook != 0 && !GcLock.HeldByMe();
        long sinceYield = 0;
        while (card <= last)
        {
            if (Sys.Read8(_taken + card) != 0)
            {
                if (yields && ++sinceYield > CardsBetweenYields)
                {
                    if (local != 0) DrainLocal(local);
                    Sys.Call(YieldHook, 0, 0, 0);
                    sinceYield = 1;
                }
                Sys.Write8(_taken + card, 0);
                nuint from = card << Runtime.CardShift;
                nuint to = from + (1 << Runtime.CardShift);
                if (from < first) from = first;
                if (to > end) to = end;
                taken = taken + 1;
                if (indexed)
                {
                    ScanCardBlocks(chunk, from, to, local);
                }
                else
                {
                    words = words + (to - from) / WordSize.Bytes;
                    ScanRange(from, to, local);
                }
            }
            card = card + 1;
        }
        if (taken != 0) Sys.AtomicAdd(Sys.AddressOf(ref TakenCards), taken);
        if (words != 0) Sys.AtomicAdd(Sys.AddressOf(ref OldCardWords), words);
    }

    /// The old blocks of [from, to) in a chunk whose starts this cycle wrote,
    /// each read for its references in the range only.
    static void ScanCardBlocks(nuint chunk, nuint from, nuint to, nuint local)
    {
        // A SIZE-CLASS PAGE's blocks are where its class puts them: stepped
        // through by size, not found by searching the start bits. A free
        // block or a newcomer carries no marks, and the test below passes it
        // by as the bits would have.
        if (HeapChunks.PageClass(chunk) != 0)
        {
            nuint size = ClassSize(HeapChunks.PageClass(chunk) - 1);
            nuint first = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            // A word's division: one instruction on i386.
            nuint at = from <= first ? first : first + (from - first) / size * size;
            while (at < to && at < end)
            {
                nuint header = Sys.ReadAddress(at);
                if ((header & SizeMask) != size)
                {
                    return;
                }
                if ((header & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan))
                {
                    ScanBlockWithin(at, size, 0, from, to, local);
                }
                at = at + size;
            }
            return;
        }
        nuint block = HeapChunks.StartAtOrBelow(chunk, from & ~(nuint)7);
        if (block == 0)
        {
            block = HeapChunks.NextStart(chunk, from);
        }
        while (block != 0 && block < to)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < LeastBlock)
            {
                return;
            }
            // OLD ONLY: marked AND scanned, as the last sweep left every
            // survivor. One this cycle has reached and not yet scanned is
            // queued, and will be read whole.
            if ((block >= from || size > from - block) && (word & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan))
            {
                ScanBlockWithin(block, size, FooterBytes, from, to, local);
            }
            block = HeapChunks.NextStart(chunk, block + 8);
        }
    }

    /// ScanBlock's rules, over the part of a block inside [from, to): a
    /// leaf not at all, an object by its reference map or its reference
    /// elements, an array of integers not at all (its stores take no card),
    /// and anything no descriptor describes word by word. `tail`: what
    /// follows its payload (TailIn).
    static void ScanBlockWithin(nuint block, nuint size, nuint tail, nuint from, nuint to, nuint local)
    {
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind == KindLeaf)
        {
            return;
        }
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        nuint end = block + size - tail;
        nuint low = from > payload ? from : payload;
        nuint high = to < end ? to : end;
        if (low >= high)
        {
            return;
        }
        nuint vt = Sys.ReadAddress(payload);
        YoungCardWords = YoungCardWords + (long)((high - low) / w);
        if (kind != KindObject || vt == 0 || (_anyQuarantined && InQuarantine(vt)))
        {
            ScanRange(low, high, local);
            return;
        }
        nuint desc = vt - DescWords * w;
        if (Sys.ReadAddress(desc + DescSelfWord * w) != desc)
        {
            ScanRange(low, high, local);
            return;
        }
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0 || (Sys.ReadAddress(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0)
            {
                return;
            }
            if (Sys.ReadAddress(desc + DescSizeWord * w) != w)
            {
                ScanRange(low, high, local);
                return;
            }
            nuint count = Sys.ReadAddress(payload + ArrayCountAt) & 0x7FFFFFFF;
            nuint first = payload + Sys.ReadAddress(desc + DescPayloadWord * w);
            nuint last = first + count * w;
            if (last > end || last < first)
            {
                ScanRange(low, high, local);
                return;
            }
            ScanRange(low > first ? low : first, high < last ? high : last, local);
            return;
        }
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0)
        {
            return;
        }
        nuint words = Sys.ReadAddress(map);
        nuint index = (low - payload + w - 1) / w;
        nuint stop = (high - payload + w - 1) / w;
        if (stop > words) stop = words;
        while (index < stop)
        {
            nuint bits = Sys.ReadAddress(map + (1 + index / 32) * w) & 0xFFFFFFFF;
            if (((bits >> (int)(index & 31)) & 1) != 0)
            {
                MarkRef(Sys.ReadAddress(payload + index * w), local);
            }
            index = index + 1;
        }
    }

    /// Runtime.CardMarkObject: every card of the block a payload is in -- what
    /// a coroutine's frame is saved into at each suspension, word by word
    /// and without a barrier (AsyncTransform).
    public static void CardMarkObject(nuint payload)
    {
        nuint cards = Runtime.Cards;
        if (cards == 0 || payload == 0)
        {
            return;
        }
        nuint block = payload - HeaderBytes;
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        nuint end = payload;
        // A SMALL BLOCK HAS NO FOOTER TO AGREE in a size-class page, and the
        // page is not looked up here (no lock is held): a kilobyte or less is
        // two cards at most, and a card set over something else costs a scan
        // of it, never a miss.
        if (size >= LeastBlock && size < 0x40000000 && (size <= ClassMax || Sys.ReadAddress(block + size - FooterBytes) == word))
        {
            end = block + size - 1;
        }
        nuint card = payload >> Runtime.CardShift;
        nuint last = end >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.Write8(cards + card, 1);
            card = card + 1;
        }
    }

    /// Runtime.ShadeObject: every reference a block holds, reported as a
    /// barrier reports the one a store overwrites (Note), while a collection
    /// marks -- a coroutine's machine, about to have its frame saved over it
    /// word by word with no barrier (AsyncTransform). A reference the machine
    /// held at the snapshot, read into the frame at a resumption after its
    /// thread answered STAMP and then saved over before the marker read the
    /// machine, was the frame's alone, and the stack copy had been taken
    /// before it got there: stored on into an object the mark had scanned
    /// already, or saved back into the machine once the mark had read it, it
    /// was never marked, and was swept under them. The words reported are
    /// the ones the marker reads (ScanBlockWithin).
    public static void ShadeObject(nuint payload)
    {
        if (Runtime.Marking == 0 || payload == 0) return;
        nuint tb = Sys.ThreadBlock();
        nuint was = tb == 0 ? 0 : Sys.ReadAddress(tb + Tls.InAlloc);
        if (tb != 0) Sys.WriteAddress(tb + Tls.InAlloc, 1);
        ShadeWords(payload);
        if (tb != 0) Sys.WriteAddress(tb + Tls.InAlloc, was);
    }

    static void ShadeWords(nuint payload)
    {
        const int w = WordSize.Bytes;
        nuint block = payload - HeaderBytes;
        nuint size = Sys.ReadAddress(block) & SizeMask;
        nuint kind = Sys.ReadAddress(block + KindAt);
        // A machine still in its kickoff's frame is on a stack, which the
        // stack copies hold as it was; a size no block has is not read.
        if (size < LeastBlock || size >= 0x1000000 || kind == KindLeaf || size <= HeaderBytes) return;
        // A footer, where there is one, is read too: it repeats the header,
        // a size, which no block's address is, and Note passes it by.
        nuint end = block + size;
        nuint vt = Sys.ReadAddress(payload);
        if (kind != KindObject || vt == 0 || (_anyQuarantined && InQuarantine(vt)))
        {
            ShadeRange(payload, end);
            return;
        }
        nuint desc = vt - DescWords * w;
        if (Sys.ReadAddress(desc + DescSelfWord * w) != desc
            || (Sys.ReadAddress(desc + DescFlagsWord * w) & SequenceFlag) != 0)
        {
            ShadeRange(payload, end);
            return;
        }
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0) return;
        nuint words = Sys.ReadAddress(map);
        nuint most = (end - payload) / w;
        if (words > most) words = most;
        for (nuint i = 0; i < words; i++)
        {
            if (((Sys.ReadAddress(map + (1 + i / 32) * w) >> (int)(i & 31)) & 1) == 0) continue;
            nuint value = Sys.ReadAddress(payload + i * w);
            if (value != 0) Note(value, 0);
        }
    }

    static void ShadeRange(nuint from, nuint to)
    {
        for (nuint p = from; p < to; p = p + WordSize.Bytes)
        {
            nuint value = Sys.ReadAddress(p);
            if (value != 0) Note(value, 0);
        }
    }

    // ---- what a program can ask ---------------------------------------------

    /// Bytes the sweep found live at the last collection.
    public static long LiveBytes
    {
        get { return _liveBytes; }
    }

    /// Blocks the sweep found live at the last collection.
    public static long LiveBlocks
    {
        get { return _liveBlocks; }
    }

    /// The deepest the mark queue got in the last collection: how many
    /// blocks were reached through other blocks rather than from a root.
    public static long MarkPeak
    {
        get { return (long)_markPeak; }
    }

    /// Bytes allocated since the last collection, and the amount that
    /// triggers the next one.
    public static long Since
    {
        get
        {
            // EXACT FOR THE THREAD THAT ASKS (GC.GetTotalMemory): its lists
            // are charged as they are handed over (Charge), so what is still
            // on them was never handed out; what it took and has not yet had
            // folded in (Tls.ClassBytes) was.
            nuint tb = Sys.ThreadBlock();
            // A count that may be below nought: a word read signed.
            long pending = tb != 0 ? SignedWord(tb + Tls.ClassBytes) : 0;
            long since = _since + pending - OwnListBytes();
            return since > 0 ? since : 0;
        }
    }

    /// Links of a list OwnListBytes reads between two lets-go of the flag.
    const int OwnListStep = 32;

    /// THE BYTES ON THIS THREAD'S OWN CLASS LISTS, charged as each list was
    /// handed over (Charge) and not yet taken: what the counters a program
    /// reads (Since, Allocated, AllocatedByThread) take off, so that they say
    /// what was handed out -- a string made and freed in a loop goes back on
    /// its list, and costs nothing, as it did when each block was counted as
    /// it was taken. Another thread's lists are not this one's to walk;
    /// theirs stay as charged until they are handed back (RetireClasses), as
    /// their counts not yet folded in were never counted before.
    ///
    /// READ A FEW LINKS AT A TIME. Inside the allocator (Tls.InAlloc) an
    /// interrupt that allocates or frees between two links is refused, and
    /// so is a kernel's preemption: held across whole lists, a program that
    /// read the counter at every call (the NT layer's per-call accounting)
    /// kept a K6-III's one processor inside the walk, and the shell never
    /// ran again. So the flag is held for OwnListStep links and let go
    /// between, where the thread may be preempted. A list changed meanwhile
    /// -- an interrupt's allocation popped the link in hand -- ends the walk
    /// of it at the page's bounds or its count, and the figure is short by
    /// what that interrupt did, for this one read. Between two steps the
    /// platform is asked (YieldHook), as between a collection's budgets,
    /// unless the thread may not be preempted (Tls.PreemptCount). A class
    /// whose page changed meanwhile adds nothing for this read -- its lists
    /// handed back (ShedPages, which uncharges them), or an interrupt's
    /// allocation that emptied the list and refilled the class: its links
    /// are counted aside and added only when its walk ends with the cache
    /// and its page still the ones it began with, and the figure is short
    /// by the whole list the other way. That check sees the page, not the
    /// list: the same page handed
    /// back and refilled between two steps reads as unchanged, and the
    /// figure is off by what was on it, for this one read. On top of the
    /// allocator itself, nothing is read.
    public static long OwnListBytes()
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0 || _classSize == 0 || Sys.ReadAddress(tb + Tls.InAlloc) != 0) return 0;
        long bytes = 0;
        for (nuint c = 0; c < Classes; c++)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
            if (cache == 0)
            {
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                break;
            }
            nuint size = ClassSize(c);
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            nuint block = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes) + WordSize.Bytes);
            if (page == 0)
            {
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                continue;
            }
            nuint first = HeapChunks.First(page);
            nuint end = HeapChunks.End(page);
            // Bounded by the page: a link outside it ends the walk.
            nuint left = (end - first) / size + 1;
            nuint step = 0;
            nuint counted = 0;
            bool gone = false;
            while (block != 0 && block >= first && block < end && left > 0)
            {
                counted = counted + size;
                block = Sys.ReadAddress(block + KindAt);
                left = left - 1;
                step = step + 1;
                if (step == OwnListStep && block != 0)
                {
                    // Let go, and the platform asked (YieldHook): a preemption
                    // refused meanwhile is taken here, not at a next interrupt
                    // that would land in the walk again. Not asked with the
                    // heap lock held, or where the thread may not be
                    // preempted (Tls.PreemptCount): only let go.
                    Sys.WriteAddress(tb + Tls.InAlloc, 0);
                    if (YieldHook != 0 && !GcLock.HeldByMe() && Sys.ReadAddress(tb + Tls.PreemptCount) == 0)
                    {
                        Sys.Call(YieldHook, 0, 0, 0);
                    }
                    step = 0;
                    Sys.WriteAddress(tb + Tls.InAlloc, 1);
                    // THE LISTS MAY HAVE GONE MEANWHILE: a round took the
                    // cache (Classes into ClassesSaved) and ShedPages handed
                    // the lists back to their pages, which a sweep may then
                    // release. The walk goes on only while the cache and
                    // this class's page are still the ones it began with.
                    nuint now = Sys.ReadAddress(tb + Tls.Classes);
                    if (now == 0) now = Sys.ReadAddress(tb + Tls.ClassesSaved);
                    if (now != cache || Sys.ReadAddress(cache + c * (2 * WordSize.Bytes)) != page)
                    {
                        gone = true;
                        break;
                    }
                }
            }
            if (!gone) bytes = bytes + (long)counted;
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
        }
        return bytes;
    }

    /// Bytes allocated since the program began, by every thread: what their
    /// retired buffers handed out and their large blocks. A buffer still in
    /// use is counted when it is retired; the calling thread's is added here.
    public static long Allocated
    {
        get
        {
            GcLock.Enter();
            long total = _allocated;
            GcLock.Exit();
            long made = total + InBuffer(Sys.ThreadBlock()) - OwnListBytes();
            return made > 0 ? made : 0;
        }
    }

    /// Bytes this thread has allocated since it began.
    public static long AllocatedByThread
    {
        get
        {
            nuint block = Sys.ThreadBlock();
            if (block == 0) return Allocated;
            // A 64-bit count, in the two words its slot spans on i386 and the
            // first of them in long mode (Tls.Allocated).
            long made = (long)Sys.Read64(block + Tls.Allocated) + InBuffer(block) - OwnListBytes();
            return made > 0 ? made : 0;
        }
    }

    internal static long InBufferOf(nuint block) => InBuffer(block);

    /// Bytes allocated by every thread, their current buffers counted as
    /// they stand: what GC.GetTotalAllocatedBytes(true) answers, with no
    /// collection, as .NET's. THE TOTAL AND THE OTHERS' BUFFERS READ IN ONE
    /// HOLD OF THE LOCK: read in two, a buffer retired between them was in
    /// neither, and a second answer could be less than the first. AND NEVER
    /// LESS THAN ONE GIVEN BEFORE, as .NET's never is: another thread's
    /// buffer counts the whole class list charged at its refill, whose
    /// unused bytes come off when its classes are retired (RetireClasses) --
    /// the thread ends, or is stopped short -- and the total went down by
    /// them. The highest answer is kept, under the lock.
    public static long AllocatedPrecisely
    {
        get
        {
            GcLock.Enter();
            long total = _allocated + GcThreads.OthersInBuffersLocked();
            GcLock.Exit();
            long made = total + InBuffer(Sys.ThreadBlock()) - OwnListBytes();
            if (made < 0) made = 0;
            GcLock.Enter();
            if (made < _saidPrecisely) made = _saidPrecisely;
            else _saidPrecisely = made;
            GcLock.Exit();
            return made;
        }
    }

    static long _saidPrecisely;

    /// What `block`'s current allocation buffer has handed out so far.
    static long InBuffer(nuint block)
    {
        if (block == 0) return 0;
        // THIS THREAD'S OWN, read inside the allocator (Tls.InAlloc): an
        // interrupt that refilled the buffer between the two reads paired
        // one buffer's base with another's pointer, and the count was the
        // distance between two chunks. Another thread's is read under the
        // heap lock, or stopped.
        bool own = block == Sys.ThreadBlock();
        nuint inside = own ? Sys.ReadAddress(block + Tls.InAlloc) : 0;
        if (own) Sys.WriteAddress(block + Tls.InAlloc, 1);
        nuint started = Sys.ReadAddress(block + Tls.AllocBase);
        nuint at = Sys.ReadAddress(block + Tls.AllocPtr);
        // And what its class lists have handed out and not yet been counted:
        // a count that may be below nought, its word read signed.
        long counted = (long)(started != 0 && at > started ? at - started : 0) + SignedWord(block + Tls.ClassBytes);
        if (own) Sys.WriteAddress(block + Tls.InAlloc, inside);
        return counted;
    }

    /// Charges `bytes` to the program and to the thread whose block this is.
    /// Under GcLock, or for a thread that is stopped.
    static void Count(nuint block, long bytes)
    {
        _allocated = _allocated + bytes;
        if (block == 0) return;
        // A 64-bit count (Tls.Allocated); one taken back is added as its
        // two's complement.
        Sys.Write64(block + Tls.Allocated, Sys.Read64(block + Tls.Allocated) + (ulong)bytes);
    }

    public static long Threshold
    {
        get { return _threshold; }
    }

    /// Bytes taken from the operating system so far.
    public static long HeapBytes
    {
        get { return HeapChunks.HeapBytes; }
    }

    /// Caps what the heap may take from the operating system. 0 removes
    /// the cap. A program that knows it must fit in so much memory says so
    /// here, and gets a collection instead of a bigger heap when it reaches
    /// it -- and an out-of-memory stop if the collection does not help.
    public static void SetLimit(long bytes)
    {
        HeapChunks.SetLimit(bytes);
    }

    // ---- reading and writing a block ----------------------------------------

    static nuint SizeOfBlock(nuint block)
    {
        return Sys.ReadAddress(block) & SizeMask;
    }

    static bool IsFree(nuint block)
    {
        return (Sys.ReadAddress(block) & FlagFree) != 0;
    }

    /// Writes a block's size and flags at BOTH ENDS, so it can be found from
    /// either side.
    static void Stamp(nuint block, nuint size, nuint flags)
    {
        Sys.WriteAddress(block, size | flags);
        Sys.WriteAddress(block + size - FooterBytes, size | flags);
    }

    /// A size-class page's block written: its header, and nothing at its
    /// end -- it has no footer, and the word there is its payload's last.
    static void StampClass(nuint block, nuint size, nuint flags)
    {
        Sys.WriteAddress(block, size | flags);
    }

    /// Stamp or StampClass, as the chunk the block is in has footers or not.
    static void StampIn(nuint chunk, nuint block, nuint size, nuint flags)
    {
        Sys.WriteAddress(block, size | flags);
        if (HeapChunks.PageClass(chunk) == 0) Sys.WriteAddress(block + size - FooterBytes, size | flags);
    }

    /// What follows a block's payload in `chunk`: its footer in a chunk of
    /// mixed blocks, nothing in a size-class page. A payload ends at
    /// block + size - TailIn.
    static nuint TailIn(nuint chunk)
    {
        return HeapChunks.PageClass(chunk) != 0 ? 0 : (nuint)FooterBytes;
    }

    /// TailIn for a block whose chunk is not at hand, by the plain index:
    /// under the heap lock or with the world stopped, never by a marker
    /// running beside the program (OfSnapshot is its index). A block in no
    /// chunk answers as a footed one.
    static nuint TailOf(nuint block)
    {
        nuint chunk = HeapChunks.Of(block);
        return chunk != 0 ? TailIn(chunk) : FooterBytes;
    }

    /// WHETHER A BLOCK OF `size` BYTES AT `at` RUNS PAST `end`, asked
    /// without adding: the size is a header's, which a conservative root or
    /// a broken chain can make anything, and `at + size` wraps in 32 bits to
    /// an address that passes. An `at` past `end` is beyond as well.
    static bool Beyond(nuint at, nuint size, nuint end)
    {
        return at > end || size > end - at;
    }

    /// WHETHER `word`, READ AT `block` IN `chunk`, HEADS A WHOLE BLOCK -- the
    /// test the footer agreeing with the header always was. In a mixed chunk
    /// that is still the footer; in a size-class page, which has none, the
    /// header's size is the class's and the block lies on the class's grid,
    /// which is two facts just as far apart: one the page's, one the
    /// block's. The caller has checked the size is sane and the block inside
    /// the chunk's laid-out end.
    static bool Whole(nuint chunk, nuint block, nuint word)
    {
        nuint size = word & SizeMask;
        nuint c = HeapChunks.PageClass(chunk);
        if (c != 0)
        {
            nuint first = HeapChunks.First(chunk);
            // In 32 bits a long division is a call; a page is 32 KB at most.
            return size == ClassSize(c - 1) && block >= first && OnGrid(block - first, c - 1);
        }
        return Sys.ReadAddress(block + size - FooterBytes) == word;
    }

    // ---- the free list ------------------------------------------------------

    /// Which bin a block of `size` bytes belongs in: one for every eight
    /// bytes up to ExactLimit, then eight to each power of two above it,
    /// every bin a list (the free index, below).
    static int BinOf(nuint size)
    {
        if (size <= ExactLimit)
        {
            return (int)(size >> 3) - 2;
        }

        // 264..287 is bin 31, 288..319 bin 32 and so on: the bit length
        // picks the power of two, the three bits under the top one pick the
        // eighth of it. Anything past 2^31 shares the top bin.
        int length = 8 * WordSize.Bytes - Runtime.LeadingZeroCount(size);
        if (length > LargeTop)
        {
            return Bins - 1;
        }
        return ExactBins + (length - 9) * LargeSteps + (int)((size >> (length - 4)) & (LargeSteps - 1));
    }

    static nuint BinHead(int bin)
    {
        return Sys.ReadAddress(_bins + (nuint)bin * WordSize.Bytes);
    }

    static void SetBinHead(int bin, nuint block)
    {
        Sys.WriteAddress(_bins + (nuint)bin * WordSize.Bytes, block);
    }

    // ---- the free index ---------------------------------------------------
    //
    // EVERY BIN IS A LIST, and a bitmap after the heads says which are not
    // empty, so linking, unlinking and finding a fit cost the same whatever
    // the heap holds (a two-level segregated fit, "TLSF"). A free block's
    // payload holds its links: the next at KindAt, the previous where the
    // payload starts.
    //
    // A fit is the first block that fits in the request's own bin, looked
    // for a few blocks deep, or else the head of the first non-empty bin
    // above it, which fits whatever it is. Large bins were AVL trees ordered
    // by size, a best fit; every link and unlink rebalanced one, keeping a
    // height and a largest-size in every node, and on a fragmented heap that
    // rebalancing was an eighth of what the compiler did at all. A block a
    // fit splits puts its remainder back, so a good fit costs little over
    // the best one.

    const int BitsPerWord = 8 * WordSize.Bytes;

    /// The words of the non-empty bitmap, after the Bins heads.
    const int MapWords = (Bins + BitsPerWord - 1) / BitsPerWord;

    /// How many blocks of the request's own bin a fit looks at.
    const int FitDepth = 8;

    static nuint MapWord(int bin)
    {
        return _bins + (nuint)(Bins + bin / BitsPerWord) * WordSize.Bytes;
    }

    static void MarkBin(int bin)
    {
        nuint at = MapWord(bin);
        Sys.WriteAddress(at, Sys.ReadAddress(at) | ((nuint)1 << (bin % BitsPerWord)));
    }

    static void UnmarkBin(int bin)
    {
        nuint at = MapWord(bin);
        Sys.WriteAddress(at, Sys.ReadAddress(at) & ~((nuint)1 << (bin % BitsPerWord)));
    }

    static bool BinMarked(int bin)
    {
        return (Sys.ReadAddress(MapWord(bin)) & ((nuint)1 << (bin % BitsPerWord))) != 0;
    }

    /// The lowest non-empty bin at or above `from`, or -1.
    static int NextNonEmpty(int from)
    {
        if (from < 0) from = 0;
        if (from >= Bins) return -1;
        int word = from / BitsPerWord;
        nuint bits = Sys.ReadAddress(MapWord(from)) & ~(((nuint)1 << (from % BitsPerWord)) - 1);
        while (bits == 0)
        {
            word = word + 1;
            if (word >= MapWords) return -1;
            bits = Sys.ReadAddress(MapWord(word * BitsPerWord));
        }
        int bin = word * BitsPerWord + Runtime.TrailingZeroCount(bits);
        return bin < Bins ? bin : -1;
    }

    /// The highest non-empty bin at or below `from`, or -1.
    static int PrevNonEmpty(int from)
    {
        if (from < 0) return -1;
        if (from >= Bins) from = Bins - 1;
        int word = from / BitsPerWord;
        int keep = from % BitsPerWord;
        nuint bits = Sys.ReadAddress(MapWord(from));
        if (keep != BitsPerWord - 1) bits = bits & (((nuint)1 << (keep + 1)) - 1);
        while (bits == 0)
        {
            if (word == 0) return -1;
            word = word - 1;
            bits = Sys.ReadAddress(MapWord(word * BitsPerWord));
        }
        return word * BitsPerWord + BitsPerWord - 1 - Runtime.LeadingZeroCount(bits);
    }

    /// The first of the few blocks from `node` on at least `need` bytes, or 0.
    static nuint FirstFit(nuint node, nuint need)
    {
        long looked = 0;
        while (node != 0 && looked < FitDepth)
        {
            ProbeSteps = ProbeSteps + 1;
            if (SizeOfBlock(node) >= need)
            {
                return node;
            }
            node = Sys.ReadAddress(node + KindAt);
            looked = looked + 1;
        }
        return 0;
    }

    // Allocation-free diagnostic. Run under the heap lock so a failure
    // describes one consistent index. Normal programs do not call this.
    public static nuint FreeIndexErrorBlock;
    public static long FreeIndexErrorKind;

    static long BadIndex(nuint node, long kind)
    {
        FreeIndexErrorBlock = node;
        FreeIndexErrorKind = kind;
        return -1;
    }

    static bool IndexBlock(nuint node, int bin)
    {
        if ((node & 7) != 0) return false;
        nuint chunk = HeapChunks.Of(node);
        if (chunk == 0) return false;
        nuint header = Sys.ReadAddress(node);
        nuint size = header & SizeMask;
        return size >= Smallest && node >= HeapChunks.First(chunk)
            && !Beyond(node, size, HeapChunks.End(chunk)) && (header & FlagFree) != 0
            && Sys.ReadAddress(node + size - FooterBytes) == header && BinOf(size) == bin;
    }

    public static bool CheckFreeIndex()
    {
        GcLock.Enter();
        FreeIndexErrorBlock = 0;
        FreeIndexErrorKind = 0;
        long seen = 0;
        bool okay = true;
        nuint working = _h;
        for (nuint h = _heap0; h != 0 && okay; h = Sys.ReadAddress(h + HeapNextAt))
        {
            _h = h;
            nuint small = 0;
            int bin = 0;
            while (bin < Bins && okay)
            {
                nuint node = BinHead(bin);
                if (BinMarked(bin) != (node != 0)) { BadIndex(node, 8); okay = false; }
                nuint previous = 0;
                while (node != 0 && okay)
                {
                    seen = seen + 1;
                    if (bin <= BinOf(ExactLimit)) small = small + 1;
                    if (seen > HeapChunks.HeapBytes / Smallest || !IndexBlock(node, bin)
                        || Sys.ReadAddress(node + HeaderBytes) != previous)
                    { BadIndex(node, 6); okay = false; }
                    // IN ITS OWN HEAP'S BINS: a block of another heap's
                    // chunk here is freed into this heap's memory, and the
                    // chunk given back under it.
                    else if (_heapCount > 1 && HeapOfBlock(node) != h)
                    { BadIndex(node, 9); okay = false; }
                    else { previous = node; node = Sys.ReadAddress(node + KindAt); }
                }
                bin = bin + 1;
            }
            if (okay && small != _smallFree) { BadIndex(0, 7); okay = false; }
        }
        _h = working;
        GcLock.Exit();
        return okay;
    }

    static void Link(nuint block)
    {
        // TO ITS OWN HEAP'S BINS, whichever heap the caller works for.
        nuint working = _h;
        if (_heapCount > 1) _h = HeapOfBlock(block);
        nuint size = SizeOfBlock(block);
        int bin = BinOf(size);
        nuint head = BinHead(bin);

        if (size <= ExactLimit)
        {
            _smallFree = _smallFree + 1;
        }

        Sys.WriteAddress(block + KindAt, head);
        Sys.WriteAddress(block + HeaderBytes, 0);

        if (head != 0)
        {
            Sys.WriteAddress(head + HeaderBytes, block);
        }
        else
        {
            MarkBin(bin);
        }
        SetBinHead(bin, block);
        _h = working;
    }

    static void Unlink(nuint block)
    {
        nuint working = _h;
        if (_heapCount > 1) _h = HeapOfBlock(block);
        nuint size = SizeOfBlock(block);
        nuint next = Sys.ReadAddress(block + KindAt);
        nuint prev = Sys.ReadAddress(block + HeaderBytes);

        if (size <= ExactLimit)
        {
            _smallFree = _smallFree - 1;
        }

        if (prev == 0)
        {
            int bin = BinOf(size);
            SetBinHead(bin, next);
            if (next == 0)
            {
                UnmarkBin(bin);
            }
        }
        else
        {
            Sys.WriteAddress(prev + KindAt, next);
        }

        if (next != 0)
        {
            Sys.WriteAddress(next + HeaderBytes, prev);
        }
        _h = working;
    }

    /// Empties every heap's bins; the sweep rebuilds them.
    static void ClearBins()
    {
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            Sys.WriteAddress(h + HeapSmallFreeAt, 0);
            nuint word = 0;
            while (word < Bins + MapWords)
            {
                Sys.WriteAddress(h + HeapBinsAt + word * WordSize.Bytes, 0);
                word = word + 1;
            }
        }
    }

    // ---- heaps (above, "heaps") --------------------------------------------

    /// A heap's record, its page mapped (and so zero) and the heap put on the
    /// list after heap 0; 0 when the operating system has no page. The heap
    /// lock is held, or the heap is starting.
    static nuint MakeHeap()
    {
        nuint h = Platform.Map(HeapRecordBytes);
        if (h == 0)
        {
            return 0;
        }
        Sys.WriteAddress(h + HeapNumberAt, _heapsMade);
        _heapsMade = _heapsMade + 1;
        if (_heap0 != 0)
        {
            Sys.WriteAddress(h + HeapNextAt, Sys.ReadAddress(_heap0 + HeapNextAt));
            Sys.WriteAddress(_heap0 + HeapNextAt, h);
        }
        _heapCount = _heapCount + 1;
        return h;
    }

    /// A chunk of `bytes` taken for heap `h` (less than zero: given back).
    /// A heap grown by a chunk of `bytes`.
    public static void HeapGrew(nuint h, nuint bytes)
    {
        if (h == 0)
        {
            return;
        }
        Sys.WriteAddress(h + HeapBytesAt, Sys.ReadAddress(h + HeapBytesAt) + bytes);
        Sys.WriteAddress(h + HeapChunksAt, Sys.ReadAddress(h + HeapChunksAt) + 1);
    }

    /// A heap shrunk by a chunk of `bytes` given back or handed on.
    public static void HeapShrank(nuint h, nuint bytes)
    {
        if (h == 0)
        {
            return;
        }
        Sys.WriteAddress(h + HeapBytesAt, Sys.ReadAddress(h + HeapBytesAt) - bytes);
        Sys.WriteAddress(h + HeapChunksAt, Sys.ReadAddress(h + HeapChunksAt) - 1);
    }

    /// The heap lock taken by `tb` (1 for no thread block): the allocator
    /// works for its heap.
    public static void LockedFor(nuint tb)
    {
        nuint h = tb > 1 ? Sys.ReadAddress(tb + Tls.Heap) : 0;
        _h = h != 0 ? h : _heap0;
    }

    /// The heap a block of the heap is of: its chunk's. With one heap, that
    /// one, without a lookup.
    static nuint HeapOfBlock(nuint block)
    {
        if (_heapCount <= 1) return _heap0;
        nuint chunk = HeapChunks.Of(block);
        return chunk != 0 ? HeapChunks.HeapOf(chunk) : _h;
    }

    /// The heap a chunk is of.
    static nuint HeapOfChunk(nuint chunk)
    {
        return _heapCount > 1 ? HeapChunks.HeapOf(chunk) : _heap0;
    }

    /// Whether a chunk is the one its heap's bump pointer is in.
    static bool IsCurrentChunk(nuint chunk)
    {
        return chunk != 0 && Sys.ReadAddress(HeapOfChunk(chunk) + HeapCurrentAt) == chunk;
    }

    /// Where a chunk's blocks end now: its heap's bump pointer, when they
    /// are being bumped into, or its end.
    static nuint ChunkEndNow(nuint chunk)
    {
        nuint h = HeapOfChunk(chunk);
        return Sys.ReadAddress(h + HeapCurrentAt) == chunk ? Sys.ReadAddress(h + HeapBumpAt) : HeapChunks.End(chunk);
    }

    /// The first heap: the program's, or the kernel's. 0 before the heap
    /// has started.
    public static nuint KernelHeap => _heap0;

    /// A heap of its own for a kernel module (docs/HEAPS.md): its record,
    /// or 0 when the operating system has no page for one. Its first chunk
    /// is taken at its first allocation.
    public static nuint NewHeap()
    {
        GcLock.Enter();
        if (!_ready)
        {
            Start();
        }
        nuint h = MakeHeap();
        GcLock.Exit();
        return h;
    }

    /// The heap the thread whose block is `tb` allocates in made `heap` (a
    /// record; 0 or KernelHeap for the first). ITS BUFFER AND ITS CLASS
    /// PAGES GO BACK FIRST, to the heap they came from, as a thread that
    /// leaves gives them back (GcThreads.Deregister): what it allocates next
    /// comes from the new heap's chunks and pages, by the slow path. The
    /// heap lock is taken; the thread is the caller.
    public static void SwitchHeap(nuint tb, nuint heap)
    {
        if (heap == _heap0) heap = 0;
        if (tb == 0)
        {
            return;
        }
        nuint was = Sys.ReadAddress(tb + Tls.Heap);
        if (was == heap)
        {
            return;
        }
        const int w = WordSize.Bytes;
        nuint from = was == 0 ? 0 : Sys.ReadAddress(was + HeapNumberAt);
        nuint to = heap == 0 ? 0 : Sys.ReadAddress(heap + HeapNumberAt);
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);

        // THE WAY OF EVERY GATE: no lock. The class cache in use is taken
        // out of the block in one swap, put on the shelf in the place of the
        // heap being left, and the cache of the heap being entered put in.
        // Inside the allocator meanwhile (Tls.InAlloc), so that an interrupt
        // neither answers a round nor frees on top of it. The swap is how a
        // round that is taking the cache this moment is told apart: it
        // writes the cache aside first and takes it by compare-and-swap
        // (GcThreads.Round); a zero found here with a cache aside is a
        // round's, and the switch is made the long way.
        if (shelf != 0 && from < ShelfHeaps && to < ShelfHeaps)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint classes = Sys.AtomicSwap(tb + Tls.Classes, 0u);
            if (classes != 0 || Sys.ReadAddress(tb + Tls.ClassesSaved) == 0)
            {
                Sys.WriteAddress(shelf + from * w, classes);
                nuint next = Sys.ReadAddress(shelf + to * w);
                Sys.WriteAddress(shelf + to * w, 0);
                Sys.WriteAddress(tb + Tls.Heap, heap);
                Sys.AtomicSwap(tb + Tls.Classes, next);
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                // A round opened while the cache was out of the block did not
                // take it: answered now, as the slow path would before taking.
                if (GcThreads.Owes(tb)) GcThreads.Park();
                return;
            }
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
        }

        // THE LONG WAY, under the lock: the first switch, which makes the
        // shelf, or one a round has taken the cache from. The cache in use
        // is given back to its heap (its pages stamped first while this
        // thread owes the round STAMP) and shelved empty; the other heap's
        // is put in. THE SHELF MADE FIRST, outside it: nothing is mapped under
        // a spin lock, and a thread's shelf is its own (a round reads 0 or an
        // empty page).
        if (shelf == 0)
        {
            shelf = Platform.Map(ShelfBytes);
            Sys.WriteAddress(tb + Tls.Shelf, shelf);
        }
        GcLock.Enter();
        if (_ready)
        {
            if (_stamping && !StampedAlready(tb)) StampPages(tb);
            RetireClasses(tb);
        }
        if (shelf != 0 && from < ShelfHeaps && to < ShelfHeaps)
        {
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
            Sys.WriteAddress(shelf + from * w, cache);
            Sys.WriteAddress(tb + Tls.ClassesSaved, 0);
            Sys.WriteAddress(tb + Tls.Classes, Sys.ReadAddress(shelf + to * w));
            Sys.WriteAddress(shelf + to * w, 0);
        }
        Sys.WriteAddress(tb + Tls.Heap, heap);
        GcLock.Exit();
    }

    /// THE SHELF GIVEN BACK, by the thread whose block it is: every class
    /// cache it holds for a heap but `keep` (0 or KernelHeap for the first),
    /// or only the one of `heap` (DropShelf). A cache shelved at a switch is
    /// kept for the next entry into its heap, its pages the block's; a kernel
    /// whose blocks are its processors' and never end kept one page a class
    /// of every heap a processor had entered, for good -- half a megabyte of
    /// each small driver module's heap with nothing live in it. Under the
    /// lock, as a thread that leaves gives its caches back (ForgetClasses):
    /// the pages stamped first while the thread owes the round STAMP, then
    /// nobody's, each on its heap's list, those with nothing live released
    /// by the next sweep. The cache's table stays, empty, on the shelf: the
    /// next entry into the heap takes it down and refills it, with no
    /// mapping (a page a heap a block, kept for speed).
    public static void DropShelves(nuint keep)
    {
        DropShelfOf(keep == _heap0 ? 0 : keep, NoHeap);
    }

    public static void DropShelf(nuint heap)
    {
        DropShelfOf(NoHeap, heap == _heap0 ? 0 : heap);
    }

    // None: DropShelfOf's keep or only when it names no heap.
    const nuint NoHeap = ~(nuint)0;

    static void DropShelfOf(nuint keep, nuint only)
    {
        nuint tb = Sys.ThreadBlock();
        nuint shelf = tb != 0 ? Sys.ReadAddress(tb + Tls.Shelf) : 0;
        if (shelf == 0 || !_ready)
        {
            return;
        }
        // The heaps by number; -1 for none.
        long keepNumber = keep == NoHeap ? -1 : keep == 0 ? 0 : (long)Sys.ReadAddress(keep + HeapNumberAt);
        long onlyNumber = only == NoHeap ? -1 : only == 0 ? 0 : (long)Sys.ReadAddress(only + HeapNumberAt);
        GcLock.Enter();
        bool stamping = _stamping && !StampedAlready(tb);
        for (nuint h = 0; h < ShelfUsed; h++)
        {
            if ((long)h == keepNumber || onlyNumber >= 0 && (long)h != onlyNumber) continue;
            nuint cache = Sys.ReadAddress(shelf + h * WordSize.Bytes);
            if (cache == 0) continue;
            if (stamping) StampCache(cache);
            RetireCache(tb, cache);
        }
        GcLock.Exit();
    }

    /// A thread block's shelf (Tls.Shelf): a page of the operating system's,
    /// a word a heap by its number -- the class cache the thread had in it
    /// when it left, or 0. A heap numbered past it is switched the long way.
    const int ShelfBytes = 4096;
    const int ShelfHeaps = ShelfBytes / WordSize.Bytes;
    /// The places a shelf has used at most: one a heap made so far.
    static nuint ShelfUsed => _heapsMade < ShelfHeaps ? _heapsMade : ShelfHeaps;

    /// What a heap holds: the bytes its last sweeps found live, the bytes
    /// of its chunks and pages, of those what is not live, and how many
    /// chunks and pages.
    public static void HeapFigures(nuint heap, out long live, out long held, out long free, out long chunks)
    {
        live = 0;
        held = 0;
        free = 0;
        chunks = 0;
        if (heap == 0 || !_ready)
        {
            return;
        }
        GcLock.Enter();
        for (nuint chunk = HeapChunks.Newest(); chunk != 0; chunk = HeapChunks.Next(chunk))
        {
            if (HeapOfChunk(chunk) == heap && !HeapChunks.IsPooled(chunk)) live = live + (long)HeapChunks.LiveBytes(chunk);
        }
        held = (long)Sys.ReadAddress(heap + HeapBytesAt);
        chunks = (long)Sys.ReadAddress(heap + HeapChunksAt);
        GcLock.Exit();
        free = held - live;
    }

    /// Where a heap's bytes are (HeapFigures, taken apart): its pool, empty
    /// pages kept for the next refill; its size-class pages that are in use
    /// and what their last sweeps found live in them; and its chunks of
    /// mixed blocks and what is live in those. A module heap held at three
    /// times what is live keeps the difference in one of the three.
    public static void HeapMakeup(nuint heap, out long pooled, out long pages, out long pagesLive, out long mixed, out long mixedLive)
    {
        pooled = 0;
        pages = 0;
        pagesLive = 0;
        mixed = 0;
        mixedLive = 0;
        if (heap == 0 || !_ready)
        {
            return;
        }
        GcLock.Enter();
        for (nuint chunk = HeapChunks.Newest(); chunk != 0; chunk = HeapChunks.Next(chunk))
        {
            if (HeapOfChunk(chunk) != heap) continue;
            nuint size = HeapChunks.PageSize(chunk);
            if (HeapChunks.IsPooled(chunk)) pooled = pooled + (long)size;
            else if (HeapChunks.PageClass(chunk) != 0)
            {
                pages = pages + (long)size;
                pagesLive = pagesLive + (long)HeapChunks.LiveBytes(chunk);
            }
            else
            {
                mixed = mixed + (long)size;
                mixedLive = mixedLive + (long)HeapChunks.LiveBytes(chunk);
            }
        }
        GcLock.Exit();
    }

    /// A heap given back: every chunk and page of it that holds nothing live
    /// goes back to the operating system, and what still holds something --
    /// an object of the module's that the kernel still refers to, which
    /// Gc.CountHeld and Gc.Revoke were for -- becomes the first heap's, so
    /// that nothing still in use is ever unmapped. Then its record. Answers
    /// false, and does nothing, while a thread is still in the heap, for
    /// the first heap, for one that is not a heap, and when threads went on
    /// handing the heap's pages back through eight collections (NoteUnowned):
    /// the caller tries again later.
    public static bool ReleaseHeap(nuint heap)
    {
        if (heap == 0 || heap == _heap0 || !_ready)
        {
            return false;
        }
        // WHAT IS GARBAGE NOW, FOUND, by a major collection whose counts are
        // whole: none taken while a page or buffer of a module heap was
        // handed back after its sweep began (NoteUnowned), whose counts that
        // sweep never took. Collected again while one was; and while threads
        // keep handing them back, not released at all rather than released
        // by counts that may be stale.
        for (long tries = 0; ; tries++)
        {
            // A THREAD THAT MAY NOT WAIT (CollectMade false) gives no heap
            // back: the counts would be another cycle's, and the sweep it
            // would wait out below may never end.
            if (!CollectMade()) return false;
            GcLock.Enter();
            if (!WaitOutAnyCycle())
            {
                GcLock.Exit();
                return false;
            }
            if (_unowned == _unownedAtMajorSweep) break;
            GcLock.Exit();
            if (tries >= 7) return false;
        }
        bool known = false;
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            if (Sys.ReadAddress(h + HeapNextAt) == heap) known = true;
        }
        if (!known || GcThreads.AnyInHeap(heap))
        {
            GcLock.Exit();
            return false;
        }
        // EVERY THREAD'S CACHE OF IT, from their shelves: its pages are
        // nobody's again, and those with nothing live in them go below.
        nuint number = Sys.ReadAddress(heap + HeapNumberAt);
        if (number < ShelfHeaps)
        {
            nuint threads = GcThreads.Count() > 0 ? GcThreads.Count() : 1;
            for (nuint i = 0; i < threads; i++)
            {
                nuint tb = GcThreads.BlockAt(i);
                nuint shelf = tb != 0 ? Sys.ReadAddress(tb + Tls.Shelf) : 0;
                nuint parked = shelf != 0 ? Sys.ReadAddress(shelf + number * WordSize.Bytes) : 0;
                if (parked == 0) continue;
                Sys.WriteAddress(shelf + number * WordSize.Bytes, 0);
                KeepCachedPages(parked);
                RetireCache(tb, parked);
                Platform.Unmap(parked, 4096);
            }
        }
        nuint working = _h;
        _h = heap;
        SyncEnd();
        // The pool first: nothing in it.
        while (_pool != 0)
        {
            nuint page = _pool;
            _pool = HeapChunks.PageNext(page);
            HeapChunks.SetPageNext(page, 0);
            ReleaseChunk(page);
            PagesReleased = PagesReleased + 1;
        }
        _poolBytes = 0;
        if (_recycle != 0 && HeapOfChunk(_recycle) == heap) _recycle = 0;
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            nuint after = HeapChunks.Next(chunk);
            if (HeapChunks.HeapOf(chunk) == heap)
            {
                if (HeapChunks.PageClass(chunk) != 0)
                {
                    // A page: off this heap's list, and back, or onto the
                    // first heap's.
                    if (HeapChunks.IsListed(chunk)) UnlistPage(chunk);
                    if (HeapChunks.LiveBlocks(chunk) == 0 && HeapChunks.Owner(chunk) == 0)
                    {
                        ReleaseChunk(chunk);
                        PagesReleased = PagesReleased + 1;
                    }
                    else
                    {
                        HeapChunks.SetHeapOf(chunk, _heap0);
                        HeapShrank(heap, HeapChunks.PageSize(chunk));
                        HeapGrew(_heap0, HeapChunks.PageSize(chunk));
                        if (HeapChunks.PageFree(chunk) != 0) ListPage(chunk);
                    }
                }
                else
                {
                    // An ordinary chunk: its free blocks off this heap's
                    // bins, and the chunk back or the first heap's, its free
                    // blocks onto the first heap's bins.
                    // NOT ONE A THREAD'S BUFFER IS IN: a thread keeps its
                    // buffer as it changes heaps (SwitchHeap shelves only its
                    // class cache), and bumps in it still.
                    UnlinkFreeIn(chunk);
                    if (HeapChunks.LiveBlocks(chunk) == 0 && HeapChunks.LiveBytes(chunk) == 0
                        && !GcThreads.BufferWithin(HeapChunks.First(chunk), HeapChunks.Limit(chunk)))
                    {
                        ReleaseChunk(chunk);
                    }
                    else
                    {
                        nuint size = HeapChunks.Limit(chunk) - chunk;
                        HeapChunks.SetHeapOf(chunk, _heap0);
                        HeapShrank(heap, size);
                        HeapGrew(_heap0, size);
                        LinkFreeIn(chunk);
                    }
                }
            }
            chunk = after;
        }
        // Off the list of heaps, and its page back.
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            if (Sys.ReadAddress(h + HeapNextAt) == heap)
            {
                Sys.WriteAddress(h + HeapNextAt, Sys.ReadAddress(heap + HeapNextAt));
                break;
            }
        }
        _heapCount = _heapCount - 1;
        _h = working == heap ? _heap0 : working;
        Platform.Unmap(heap, HeapRecordBytes);
        GcLock.Exit();
        return true;
    }

    /// THE PAGES OF A CACHE TAKEN OFF A SHELF BY ReleaseHeap, KEPT: a page a
    /// thread's cache owns is never swept, so what it says is live is from
    /// before the thread took it -- nothing, for a page taken fresh -- and
    /// the collection ReleaseHeap ran first stepped over it. Judged by that,
    /// its objects went back with the heap while the kernel still held them:
    /// a registry key made in NT's gate under a cache entry of the kernel's,
    /// a lock's word array in the GUI's. Each is counted live, so that it
    /// becomes the first heap's, whose next sweep counts it and gives it
    /// back if nothing in it is.
    static void KeepCachedPages(nuint cache)
    {
        for (nuint c = 0; c < Classes; c++)
        {
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            if (page != 0 && HeapChunks.LiveBlocks(page) == 0) HeapChunks.SetLive(page, 1, HeapChunks.LiveBytes(page));
        }
    }

    /// Every free block of a chunk onto its heap's bins (not one freed in
    /// place, which is on none): the chunk has just become another heap's
    /// (ReleaseHeap), and its chain is walkable end to end.
    static void LinkFreeIn(nuint chunk)
    {
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < Smallest || Beyond(block, size, end))
            {
                return;
            }
            if ((word & FlagFree) != 0 && !IsInPlace(block))
            {
                Link(block);
            }
            block = block + size;
        }
    }

    // ---- chunks ---------------------------------------------------------------

    /// Whether a chunk of `ask` bytes should wait for a collection: one past
    /// the 32-bit ceiling, when half the pace has been allocated since the
    /// last collection -- enough garbage for a collection to be worth its
    /// cost. Near the ceiling the pace itself is half of what is left
    /// (NextThreshold), so the heap is slowed as it nears the limit. Judged
    /// by the pace and never by the chunk: a heap at the ceiling because its
    /// free memory is in holes -- 920 MB live in 2.7 GB, of the self-hosted
    /// compiler -- otherwise ran a whole collection for every megabyte it
    /// took, and freed nothing. The allocator's last try waives it
    /// (_growPast): the ceiling slows a heap and never fails one.
    public static bool GrowthWaits(nuint ask)
    {
        return HeapCeiling != 0 && !_collecting && !_growPast && HeapChunks.HeapBytes + (long)ask > HeapCeiling
            && _since >= _threshold / 2;
    }

    // The allocator's last try, which the ceiling does not refuse. The heap
    // lock is held.
    static bool _growPast;

    /// Takes a chunk of at least `need` block bytes and makes it current.
    /// Whatever the old current chunk had left above its bump pointer
    /// becomes a free block first, so nothing is stranded. Answers false
    /// when the cap or the operating system refuses.
    static bool Grow(nuint need)
    {
        nuint raw = HeapChunks.Take(need);

        if (raw == 0)
        {
            // SAID NOTHING, the cap's refusal, the system's or a wait at the
            // ceiling: the request that ends out of memory is caught or not,
            // and the heap's report is said only if it is not
            // (ThrowOutOfMemory), as .NET says nothing of a caught one.
            return false;
        }

        // The tail of the chunk being left. If it cannot describe itself
        // (below Smallest) it stays unused: less than four words.
        // ITS END RAISED OVER IT FIRST: a block is found in its chunk -- and
        // so in its heap's bins (Link) -- only below the chunk's end.
        if (_current != 0)
        {
            LeaveCurrent();
        }

        _current = raw;
        _bump = HeapChunks.First(raw);
        _limit = HeapChunks.Limit(raw);
        return true;
    }

    /// The working heap's current chunk left: what it had above its bump
    /// pointer a free block, when it can describe itself (Smallest), and its
    /// end brought up to its limit BEFORE that block is linked. A block is
    /// found in its chunk only below the chunk's end (HeapChunks.Of), and a
    /// block found in none went to the first heap's bins: a module heap's
    /// tail in the kernel heap's bins, its chunk swept back to the system,
    /// and the next free there wrote into the unmapped page (the GUI
    /// module's first gate calls, Gc.Link from Grow).
    static void LeaveCurrent()
    {
        nuint tail = _limit - _bump;
        if (tail >= Smallest)
        {
            HeapChunks.SetEnd(_current, _limit);
            Stamp(_bump, tail, FlagFree);
            Link(_bump);
            _bump = _limit;
        }
        HeapChunks.SetEnd(_current, _bump);
    }

    // ---- handing memory out ---------------------------------------------------

    // The largest request: leaves room for the rounding below.
    const int MaxRequest = 0x7FFFFFFF - Overhead - 7;

    // ---- regions --------------------------------------------------------------
    //
    // A REGION IS A CALL whose every object certain allocations make is
    // proved dead by the time it returns (the compiler's RegionPointsTo):
    // those are bumped out of the thread's own arena and given back together,
    // the bump pointer set back and the bytes zeroed, when it returns. Regions
    // nest; each is the stretch of the arena past where it began. Blocks in
    // the arena are laid out as the heap's are, header, kind and footer, so
    // that the collector reads them: the arena's live part is scanned with
    // the thread's stack, for what heap objects they hold, and never swept.
    // A free of a block in it does nothing; the region's end gives it back.
    // Nothing on the heap holds one (the proof), and the collector takes no
    // pointer into the arena for a block of its own (ExactBlock: not a chunk).
    //
    // THE ARENA IS AS BIG AS WHAT IS IN IT. Nothing is set aside for it: a
    // thread that never opens a region has none, and the first region it
    // opens maps one chunk, the size of what it first needs rounded to a
    // page. The arena grows by another chunk whenever the innermost region's
    // next block does not fit -- as big as the block, or as the chunks before
    // it together if that is bigger, so that an arena of gigabytes is a few
    // dozen chunks and never more than twice what its regions hold. A
    // region's end hands back every chunk past the one it began in but the
    // next, kept as the spare: a loop whose laps cross a chunk's end maps
    // nothing per lap.
    //
    // A REGION THE COMPILER SIZED needs no more than it said. Where the link
    // proved how many bytes a boundary's region holds at most in one call --
    // or a loop's in one lap -- RegionEnter and RegionLoop are handed that
    // count (0 where nothing was proved): the region is laid down where the
    // whole of it fits, in the chunk being filled if it has the room, else
    // in a chunk mapped for exactly that many bytes, rounded to the page,
    // or in the spare if that is big enough. Only regions of a size nobody
    // proved grow by the doubling rule above.
    //
    // A CHUNK IS NAMED BY ITS END, where its trailer is: its first byte, the
    // chunks before and after it (0 for none), and how far it was filled
    // when the arena moved on past it (its first byte, for the spare). The
    // first chunk's trailer also holds the lowest first byte and the highest
    // end of all of them, which every free asks before it walks the chunks.
    // Tls.RegionBase is the first chunk, Tls.RegionEnd the one being filled
    // and Tls.RegionAt the bump pointer in it. Places in the arena are
    // ordered chunk by chunk, and by address within one.

    /// Bytes given back by regions' ends, and allocations a region could not
    /// take because the system had no memory to grow the arena by (made on
    /// the heap instead).
    public static long RegionFreedBytes;
    public static long RegionMisses;
    /// Blocks given back before their region's end, from its top
    /// (RegionFree): the bump pointer taken back over them, and their bytes
    /// -- not counted again in RegionFreedBytes when the region ends.
    public static long RegionTopFrees;
    public static long RegionTopFreedBytes;
    /// Arrays grown where they were, at their region's top (RegionGrow),
    /// where a new one would have been made and the old left behind.
    public static long RegionGrownInPlace;
    // THE ARENA'S LAYOUT AS RUNTIME'S FAST PATHS LAY BLOCKS AND RECORDS
    // DOWN (Runtime.AllocRegion, RegionEnter, RegionLeave), which the link
    // inlines at every site, boundary and leave: the same constants as the
    // long ways here, named for them.
    public const int BlockHeaderBytes = HeaderBytes;
    public const int BlockFooterBytes = FooterBytes;
    public const int BlockKindAt = KindAt;
    public const int BlockRounding = Overhead + 7;
    public const nuint BlockSizeMask = SizeMask;
    /// What a request is rounded by for a size-class block (Runtime.AllocFast).
    public const int ClassBlockRounding = ClassRounding;
    public const int SmallestBlock = Smallest;
    public const int MostRequest = MaxRequest;
    public const int RegionRecordBytes = RecordBytes;
    public const int RecordFrameAt = HeaderBytes + WordSize.Bytes;
    public const int RecordLoopMark = LoopMark;

    /// Blocks made in regions: each given back when its region ends, as a
    /// free would have given it back (what Frees counts for the heap).
    /// Counted in each thread's block as they are made, and added here
    /// where a region or a lap ends and as the thread ends
    /// (CountRegionBlocks): one word every thread wrote at every block was
    /// a cache line passed between processors.
    public static long RegionBlocks;
    /// Regions opened with the size the link proved for them.
    public static long RegionsSized;

    // ---- what the arenas take of the system (SayStats) ---------------------
    //
    // "IF IT'S 21 KB, THEN IT'S 21 KB": what the regions map against what
    // they fill, process-wide, so that a program's regions can be held to
    // taking what they need and no more. Counted only where the arena maps,
    // moves on, cuts back or hands back -- never on a bump allocation: plain
    // adds as the collector's other counters are, and an atomic add and a
    // compare-and-swap for the two that are summed over threads and peaked.

    /// Bytes mapped for arenas now, over every thread, and the most at once.
    public static nuint ArenaMappedNow;

    /// Region allocations sent to the heap for the cap (RegionArenaCap).
    public static long RegionCapped;
    static long _regionArenaCap;

    /// The most the region arenas may map: a sixteenth of the machine (or of
    /// its control group), 64 MB where nobody says, and never under 16 MB nor
    /// over 256 MB -- an arena that large holds garbage, not a working set.
    static long RegionArenaCap()
    {
        long cap = _regionArenaCap;
        if (cap != 0) return cap;
        long total = Platform.TotalMemory();
        cap = total > 0 ? total / 16 : 67108864;
        if (cap < 16777216) cap = 16777216;
        if (cap > 268435456) cap = 268435456;
        _regionArenaCap = cap;
        return cap;
    }
    public static nuint ArenaMappedPeak;
    /// Bytes the arenas held filled, over every thread, as each last measured
    /// its own (ArenaMeasure), and the most at once. Measured where a region
    /// ends or a lap is cut, where the arena moves on to another chunk, and
    /// before a block is given back from the top -- the moments its fill
    /// stops rising -- and only while the stats are asked for.
    public static nuint ArenaUsedNow;
    public static nuint ArenaUsedPeak;
    /// Chunks mapped and handed back, and the bytes asked of the system in all.
    public static long ArenaChunksMapped;
    public static long ArenaChunksUnmapped;
    public static long ArenaAskedBytes;
    /// Times the arena moved on into the spare a region's end kept, mapping nothing.
    public static long ArenaSparesReused;
    /// Sized room asked (Room: a sized region's, a sized loop's lap): found in
    /// the chunk being filled, or in another -- the spare, or one mapped for
    /// exactly that many bytes.
    public static long SizedRoomHere;
    public static long SizedRoomElsewhere;

    // A record's block: header, the two words, footer, rounded as blocks are.
    const int RecordBytes = (Overhead + 2 * WordSize.Bytes + 7) & ~7;

    // A chunk's trailer: first byte, before, after, filled to, and in the
    // first chunk's only, the lowest first byte and highest end, and how far
    // the arena was filled when last measured (ArenaMeasure).
    const int TrailerBytes = 7 * WordSize.Bytes;
    // The first chunk's trailer word holding how many bytes this thread's
    // arena was filled to when it was last measured (ArenaMeasure).
    const int TrailerMeasured = 6;
    // What a chunk's size is rounded to: the page the system maps.
    const int ChunkPage = 4096;

    static nuint ChunkStart(nuint chunk) => Sys.ReadAddress(chunk);
    static nuint ChunkAfter(nuint chunk) => Sys.ReadAddress(chunk + 2 * WordSize.Bytes);

    // How far `chunk` is filled: the bump pointer, for the one being filled.
    static nuint ChunkTop(nuint tb, nuint chunk)
    {
        return chunk == Sys.ReadAddress(tb + Tls.RegionEnd) ? Sys.ReadAddress(tb + Tls.RegionAt) : Sys.ReadAddress(chunk + 3 * WordSize.Bytes);
    }

    // EACH REGION BEGINS WITH ITS RECORD, a leaf block of two words: the
    // region it is inside (0 for none) and the frame of the call that opened
    // it, its low bit set for a loop's region (LoopMark: a frame pointer is
    // a word apart from the next, so the bit is never the frame's own). A
    // throw that leaves that call runs no RegionLeave; the next region
    // opened or allocation made from a frame above it finds the frame gone
    // and closes it then (PopStale), and an outer region's own leave sets the
    // arena back below anything opened inside it.

    // The frame word's mark of a loop's region (RegionLoop).
    const int LoopMark = 1;

    // The frame a record names, without its mark.
    static nuint OpenerFrame(nuint record) => Sys.ReadAddress(record + HeaderBytes + WordSize.Bytes) & ~(nuint)LoopMark;

    /// THE INNERMOST OPEN REGION, `record` (0 for none), and with it the
    /// frame that opened it (Tls.RegionFloor), which every allocation in a
    /// region put in place reads instead of the record: the two always
    /// change together, and only on their own thread.
    public static void SetOpen(nuint tb, nuint record)
    {
        Sys.WriteAddress(tb + Tls.RegionFloor, record == 0 ? 0 : OpenerFrame(record));
        Sys.WriteAddress(tb + Tls.RegionOpen, record);
    }

    /// No region: what RegionEnter and RegionLoop answer when there is none,
    /// the word of all ones -- the -1 the compiled code passes and tests.
    public const nuint NoRecord = ~(nuint)0;

    /// Opens a region for the call whose frame is `frame`: what RegionLeave
    /// is handed back, NoRecord when there is none (no regions on this
    /// platform, or no memory to grow the arena by). `bytes` is the most the
    /// region holds besides its record, as the link proved it; 0 when it is
    /// not known.
    public static nuint RegionEnter(nuint frame, nuint bytes)
    {
        return Enter(frame, bytes, 0);
    }

    // RegionEnter, the record's frame word marked with `mark`: LoopMark for
    // the first region a thread opens being a loop's.
    static nuint Enter(nuint frame, nuint bytes, nuint mark)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0) return NoRecord;
        if (Sys.ReadAddress(tb + Tls.RegionBase) == 0)
        {
            // A continuation's run with an arena of its own (Tls.TaskArena)
            // has one where the platform gives its blocks none.
            if (!Platform.Regions() && Sys.ReadAddress(tb + Tls.TaskArena) == 0) return NoRecord;
            nuint chunk = MapChunk(tb, RecordBytes + bytes, bytes > 0);
            if (chunk == 0) return NoRecord;
            Sys.WriteAddress(tb + Tls.RegionAt, ChunkStart(chunk));
            Sys.WriteAddress(tb + Tls.RegionEnd, chunk);
            Sys.WriteAddress(tb + Tls.RegionBase, chunk);
        }
        // Every region opened at or below this frame is one a throw has left:
        // two live calls never share a frame.
        PopStale(tb, frame, true);
        // The record and all the region holds, together where they fit.
        // Without the memory for that, it grows as an unsized one does.
        if (bytes > 0)
        {
            Room(tb, RecordBytes + bytes);
            RegionsSized = RegionsSized + 1;
        }
        return OpenRecord(tb, frame | mark);
    }

    // Room for `need` bytes at the arena's pointer: the chunk being filled,
    // or the spare, or a chunk mapped for exactly them. False when the system
    // has no memory to give.
    static bool Room(nuint tb, nuint need)
    {
        if (need <= Sys.ReadAddress(tb + Tls.RegionEnd) - Sys.ReadAddress(tb + Tls.RegionAt))
        {
            SizedRoomHere = SizedRoomHere + 1;
            return true;
        }
        SizedRoomElsewhere = SizedRoomElsewhere + 1;
        return NextChunk(tb, need, true);
    }

    /// A LOOP'S REGION, at the top of every lap of a loop whose laps each
    /// leave dead what they make in it (RegionPointsTo, "loops"). `record`
    /// is what the last lap's call answered, NoRecord on the first: the region is
    /// opened then, and from the next lap on what the last made in it is
    /// given back -- the pointer set back to just past the record, and the
    /// bytes zeroed -- with any region still open inside it. Opened inside
    /// a region of the same frame, the function's own, and never closing
    /// it: two regions of one frame are one call's.
    /// `bytes` is the most one lap makes in it, as the link proved it; 0
    /// when it is not known. A lap whose bytes do not fit after the record
    /// goes on in the spare, which the next lap's cut keeps.
    public static nuint RegionLoop(nuint record, nuint frame, nuint bytes)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0) return NoRecord;
        CountRegionBlocks(tb);
        if (record != NoRecord)
        {
            nuint chunk = ChunkOf(tb, record);
            if (Filled(tb, chunk, record) && OpenerFrame(record) == frame)
            {
                nuint freed = Cut(tb, chunk, record + RecordBytes);
                SetOpen(tb, record);
                RegionFreedBytes = RegionFreedBytes + (long)freed;
                FreedBytes = FreedBytes + (long)freed;
                // Without the memory for the lap, it grows as an unsized
                // region does (AllocRegion).
                if (bytes > 0) Room(tb, bytes);
                return record;
            }
        }
        nuint opened = Sys.ReadAddress(tb + Tls.RegionBase) == 0 ? Enter(frame, 0, LoopMark) : OpenLooped(tb, frame);
        if (opened != NoRecord && bytes > 0) Room(tb, bytes);
        return opened;
    }

    static nuint OpenLooped(nuint tb, nuint frame)
    {
        PopStale(tb, frame, false);
        return OpenRecord(tb, frame | LoopMark);
    }

    // A region's record laid down at the arena's pointer, the arena grown
    // when it does not fit: NoRecord when the system has no memory for it.
    static nuint OpenRecord(nuint tb, nuint frame)
    {
        nuint record = Sys.ReadAddress(tb + Tls.RegionAt);
        if (RecordBytes > Sys.ReadAddress(tb + Tls.RegionEnd) - record)
        {
            if (!NextChunk(tb, RecordBytes, false)) return NoRecord;
            record = Sys.ReadAddress(tb + Tls.RegionAt);
        }
        Stamp(record, RecordBytes, 0);
        Sys.WriteAddress(record + KindAt, KindLeaf);
        Sys.WriteAddress(record + HeaderBytes, Sys.ReadAddress(tb + Tls.RegionOpen));
        Sys.WriteAddress(record + HeaderBytes + WordSize.Bytes, frame);
        Sys.WriteAddress(tb + Tls.RegionAt, record + RecordBytes);
        SetOpen(tb, record);
        return record;
    }

    /// Closes the region `record` begins, and any still open inside it:
    /// everything made in them given back.
    public static void RegionLeave(nuint record)
    {
        nuint tb = Sys.ThreadBlock();
        // No arena, or one handed back as the thread ends: nothing to give.
        if (record == NoRecord || tb == 0 || Sys.ReadAddress(tb + Tls.RegionBase) == 0) return;
        CountRegionBlocks(tb);
        nuint chunk = ChunkOf(tb, record);
        if (!Filled(tb, chunk, record)) return;
        nuint outer = Sys.ReadAddress(record + HeaderBytes);
        nuint freed = Cut(tb, chunk, record);
        SetOpen(tb, outer);
        // The record is the region's own, not anything the program made.
        RegionFreedBytes = RegionFreedBytes + (long)(freed - RecordBytes);
        FreedBytes = FreedBytes + (long)(freed - RecordBytes);
    }

    // THE ARENA SET BACK to `to`, a place in `chunk` no further than how far
    // it is filled: everything past it zeroed, as a fresh chunk is, and the
    // chunks past `chunk` handed back to the system, but the next, kept as
    // the spare. The bytes given back.
    static nuint Cut(nuint tb, nuint chunk, nuint to)
    {
        // As full as it gets before this cut: measured first.
        ArenaMeasure(tb);
        nuint freed = CutBack(tb, chunk, to);
        ArenaMeasure(tb);
        return freed;
    }

    static nuint CutBack(nuint tb, nuint chunk, nuint to)
    {
        const int w = WordSize.Bytes;
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint at = Sys.ReadAddress(tb + Tls.RegionAt);
        nuint top = chunk == last ? at : Sys.ReadAddress(chunk + 3 * w);
        // The pointer first: a scan that lands in the middle reads no further
        // than `to`, never the bytes being cleared. AND THE CHUNK WITH IT,
        // with no handshake between the two (Tls.InAlloc): `to` paired with
        // the old chunk being filled, when the cut is in an earlier one, is
        // a scan from that chunk's start to an address in another.
        nuint inside = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Sys.WriteAddress(tb + Tls.RegionAt, to);
        Sys.WriteAddress(tb + Tls.RegionEnd, chunk);
        Sys.WriteAddress(tb + Tls.InAlloc, inside);
        nuint freed = top - to;
        if (top > to) Sys.MemorySet(to, 0, top - to);
        if (chunk != last)
        {
            // THE CHUNKS PAST `chunk` KEPT AS SPARES, cleared and empty, as
            // far as ArenaKeepBytes reaches -- the first always -- and only
            // the rest handed back. Kept to one spare, a region that crossed
            // two chunks' ends mapped and unmapped the second at every lap
            // and every call. Every chunk from the spare to the one being
            // filled had bytes in it, which are counted and, where it is
            // kept, cleared; any past that one is a spare already, empty.
            nuint spare = ChunkAfter(chunk);
            nuint budget = ArenaKeepBytes();
            nuint kept = 0;
            nuint keep = chunk;          // the last chunk kept
            bool keeping = true;
            bool used = true;           // up to and including the one being filled
            nuint c = spare;
            while (c != 0)
            {
                nuint filled = used ? (c == last ? at : Sys.ReadAddress(c + 3 * w)) - ChunkStart(c) : 0;
                freed = freed + filled;
                nuint size = c + TrailerBytes - ChunkStart(c);
                if (keeping && (keep == chunk || kept + size <= budget))
                {
                    // NOT CLEARED NOW: how far it is dirty is written down
                    // (SpareDirty), and cleared as the arena moves into it
                    // (NextChunk). A spare handed back later, or with its
                    // thread's arena, is never cleared at all.
                    if (filled > 0 && ChunkStart(c) + filled > SpareDirty(c)) Sys.WriteAddress(c + SpareDirtyAt * w, ChunkStart(c) + filled);
                    Sys.WriteAddress(c + 3 * w, ChunkStart(c));
                    kept = kept + size;
                    keep = c;
                }
                else
                {
                    // Past the budget: this and every one after it handed
                    // back (DropChunks), counted first while they held bytes.
                    keeping = false;
                    if (!used) break;
                }
                if (c == last) used = false;
                c = ChunkAfter(c);
            }
            DropChunks(tb, keep);
        }
        return freed;
    }

    // A SPARE'S DIRTY TOP, in a word of its trailer only the first chunk uses
    // otherwise (its lowest start; a spare is never the first): how far its
    // bytes were left as its regions left them, its start when it is clean.
    // Nothing reads a spare's bytes -- every walk stops at the chunk being
    // filled (ScanRegion, CopyRegion, RegionWords), and a spare is filled to
    // its first byte (ChunkTop) -- until the arena moves into it, which
    // clears them first (NextChunk).
    const int SpareDirtyAt = 4;

    static nuint SpareDirty(nuint chunk)
    {
        nuint dirty = Sys.ReadAddress(chunk + SpareDirtyAt * WordSize.Bytes);
        return dirty > ChunkStart(chunk) && dirty <= chunk ? dirty : ChunkStart(chunk);
    }

    /// The bytes of spare chunks an arena keeps past the one being filled
    /// (CutBack): the platform's collection allowance where it sets one (a
    /// kernel's, a thirty-second of memory), else 16 MB.
    static nuint ArenaKeepBytes()
    {
        long cap = Platform.GcThreshold();
        return cap > 0 ? (nuint)cap : 16777216;
    }

    // The innermost region's next `need` bytes do not fit in the chunk being
    // filled: on into the spare, if they fit there, or a chunk mapped for
    // them -- for exactly them when `exact`, a region the compiler sized.
    // False when the system has no memory to give.
    static bool NextChunk(nuint tb, nuint need, bool exact)
    {
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint next = ChunkAfter(last);
        if (next != 0 && next - ChunkStart(next) < need)
        {
            DropChunks(tb, last);
            next = 0;
        }
        if (next == 0) next = MapChunk(tb, need, exact);
        else
        {
            ArenaSparesReused = ArenaSparesReused + 1;
            // The spare's bytes cleared now that they are to be handed out
            // (SpareDirty): a fresh chunk is zero, and so must this be.
            nuint dirty = SpareDirty(next);
            if (dirty > ChunkStart(next)) Sys.MemorySet(ChunkStart(next), 0, dirty - ChunkStart(next));
            Sys.WriteAddress(next + SpareDirtyAt * WordSize.Bytes, ChunkStart(next));
        }
        if (next == 0) return false;
        // How far the chunk left behind is filled, before it stops being the
        // one the bump pointer is in.
        Sys.WriteAddress(last + 3 * WordSize.Bytes, Sys.ReadAddress(tb + Tls.RegionAt));
        // As full as the chunk left behind will get: measured as it is left.
        ArenaMeasure(tb);
        // THE POINTER AND THE CHUNK IT IS IN CHANGE TOGETHER (Tls.InAlloc):
        // a handshake that lands between the two stores reads the arena for
        // its answer (ScanRegion, CopyRegion), and a pointer into the next
        // chunk paired with the last one as the chunk being filled walked
        // from the last chunk's start to an address in another mapping.
        nuint inside = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Sys.WriteAddress(tb + Tls.RegionAt, ChunkStart(next));
        Sys.WriteAddress(tb + Tls.RegionEnd, next);
        Sys.WriteAddress(tb + Tls.InAlloc, inside);
        return true;
    }

    // A chunk mapped after the one being filled, with room for `need` bytes
    // and -- unless `exact` -- as big as the chunks up to it together: 0
    // when the system has no memory to give.
    static nuint MapChunk(nuint tb, nuint need, bool exact)
    {
        const int w = WordSize.Bytes;
        nuint first = Sys.ReadAddress(tb + Tls.RegionBase);
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint bytes = need + TrailerBytes;
        nuint held = 0;
        nuint c = exact ? 0 : first;
        while (c != 0)
        {
            held = held + (c + TrailerBytes - ChunkStart(c));
            if (c == last) break;
            c = ChunkAfter(c);
        }
        if (held > bytes) bytes = held;
        bytes = (bytes + ChunkPage - 1) & ~(nuint)(ChunkPage - 1);
        // UNDER THE HEAP'S CAP, as .NET's hard limit is a limit on all it
        // manages: past it the arena maps no more, and what a region would
        // have made comes from the heap (AllocRegion), the collector's to
        // keep within the cap or to say is out of memory. Uncounted, a
        // function making sixty megabytes for its own use under a cap of four
        // made them all in its region.
        long cap = HeapChunks.Cap;
        if (cap != 0 && (long)ArenaMappedNow + HeapChunks.HeapBytes + (long)bytes > cap) return 0;
        nuint start = Platform.Map(bytes);
        if (start == 0) return 0;
        // Stores into its blocks mark cards: theirs committed now.
        CommitCards(start, bytes);
        ArenaMapped(bytes);
        nuint chunk = start + bytes - TrailerBytes;
        Sys.WriteAddress(chunk, start);
        Sys.WriteAddress(chunk + w, last);
        Sys.WriteAddress(chunk + 2 * w, 0);
        Sys.WriteAddress(chunk + 3 * w, start);
        if (last != 0) Sys.WriteAddress(last + 2 * w, chunk);
        nuint head = first != 0 ? first : chunk;
        if (first == 0 || start < Sys.ReadAddress(head + 4 * w)) Sys.WriteAddress(head + 4 * w, start);
        if (first == 0 || chunk > Sys.ReadAddress(head + 5 * w)) Sys.WriteAddress(head + 5 * w, chunk);
        return chunk;
    }

    // Every chunk past `keep` handed back to the system, and the first
    // chunk's bounds taken again over those left.
    static void DropChunks(nuint tb, nuint keep)
    {
        const int w = WordSize.Bytes;
        nuint c = ChunkAfter(keep);
        if (c == 0) return;
        Sys.WriteAddress(keep + 2 * w, 0);
        while (c != 0)
        {
            nuint after = ChunkAfter(c);
            nuint start = ChunkStart(c);
            ArenaUnmapped(c + TrailerBytes - start);
            Platform.Unmap(start, c + TrailerBytes - start);
            c = after;
        }
        nuint first = Sys.ReadAddress(tb + Tls.RegionBase);
        nuint low = ChunkStart(first);
        nuint high = first;
        c = ChunkAfter(first);
        while (c != 0)
        {
            if (ChunkStart(c) < low) low = ChunkStart(c);
            if (c > high) high = c;
            c = ChunkAfter(c);
        }
        Sys.WriteAddress(first + 4 * w, low);
        Sys.WriteAddress(first + 5 * w, high);
    }

    // The chunk of this thread's arena `at` is in, the spare's too; 0 for none.
    static nuint ChunkOf(nuint tb, nuint at)
    {
        nuint first = Sys.ReadAddress(tb + Tls.RegionBase);
        if (first == 0 || at < Sys.ReadAddress(first + 4 * WordSize.Bytes) || at >= Sys.ReadAddress(first + 5 * WordSize.Bytes)) return 0;
        // The one being filled first: nearly every question is about it.
        nuint c = Sys.ReadAddress(tb + Tls.RegionEnd);
        if (at >= ChunkStart(c) && at < c) return c;
        c = first;
        while (c != 0)
        {
            if (at >= ChunkStart(c) && at < c) return c;
            c = ChunkAfter(c);
        }
        return 0;
    }

    // Whether `at`, in `chunk`, is in a region still open: below how far the
    // chunk is filled (the spare is filled to its first byte).
    static bool Filled(nuint tb, nuint chunk, nuint at)
    {
        return chunk != 0 && at < ChunkTop(tb, chunk);
    }

    // Whether `owner` is in the innermost region, the one `open` begins.
    static bool InInnermost(nuint tb, nuint open, nuint owner)
    {
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        // Both in the chunk being filled, as nearly always.
        if (open >= ChunkStart(last) && open < last) return owner >= open && owner < Sys.ReadAddress(tb + Tls.RegionAt);
        nuint held = ChunkOf(tb, owner);
        if (!Filled(tb, held, owner)) return false;
        nuint begun = ChunkOf(tb, open);
        if (held == begun) return owner >= open;
        // In a chunk after the one the region began in.
        nuint c = ChunkAfter(begun);
        while (c != 0)
        {
            if (c == held) return true;
            if (c == last) break;
            c = ChunkAfter(c);
        }
        return false;
    }

    /// A catch in the frame `frame`: the regions a throw it caught left open,
    /// every one opened by a frame below it.
    public static void RegionCatch(nuint frame)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb != 0 && Sys.ReadAddress(tb + Tls.RegionOpen) != 0) PopStale(tb, frame, false);
    }

    /// Regions whose calls a throw has left: every one opened by a frame
    /// below `frame` (deeper in the stack), or at it too when `at` -- a new
    /// region is opened there, so whatever was opened there is gone.
    static void PopStale(nuint tb, nuint frame, bool at)
    {
        nuint open = Sys.ReadAddress(tb + Tls.RegionOpen);
        while (open != 0 && Below(OpenerFrame(open), frame, at))
        {
            RegionLeave(open);
            open = Sys.ReadAddress(tb + Tls.RegionOpen);
        }
    }

    static bool Below(nuint opened, nuint frame, bool at)
    {
        return opened < frame || at && opened == frame;
    }

    // How many frames OnStackWithin walks up to the innermost region's
    // opener before it gives up (and the block goes on the heap).
    const int FrameWalk = 64;

    // WHETHER `owner` IS ON THIS THREAD'S STACK IN A FRAME THAT RETURNS NO
    // LATER THAN THE INNERMOST REGION ENDS, the one `open` begins: storage
    // made for it in that region is then dead when it is, as storage beside
    // an owner in the region is. The link's lifetime pass puts a collection
    // that never leaves its call in the call's frame, and its storage, made
    // beside it, went to the heap.
    //
    // Every prologue is `push ebp; mov ebp, esp`, so the frame pointers are a
    // chain of callers (a leaf, which may give EBP a value after, calls
    // nothing and so is never on it from here), each higher on the stack than the one it called (the
    // stack grows down). The walk up it from this frame must meet the
    // opener's frame exactly: that proves the opener is a live call on this
    // stack, above everything between, and the stack between this frame's
    // pointer and the opener's frame is that call's and its callees' --
    // nothing of the heap's or the arena's lies inside it.
    //
    // A FUNCTION'S REGION (RegionEnter) ends as its opener returns, so an
    // owner below the opener's frame pointer -- in the opener's own locals
    // or a frame it called, deeper -- and at or above the stack pointer, so
    // in a call still running, returns no later. (A boundary is never
    // inlined, so the frame is its call's alone: RegionPointsTo.Open.)
    //
    // A LOOP'S REGION (RegionLoop) ends at the end of a lap, while its frame
    // lives on: an owner in that frame may outlive the lap, and does not
    // qualify. One in a frame the loop's function called does: that call
    // returns before the lap it runs in ends. So the owner must be below the
    // frame pointer of the opener's callee on this chain -- the callee's
    // locals and deeper -- and with no callee (the allocation made in the
    // opener's own frame, inlined there) nothing qualifies.
    static bool OnStackWithin(nuint open, nuint owner)
    {
        nuint word = Sys.ReadAddress(open + HeaderBytes + WordSize.Bytes);
        nuint opener = word & ~(nuint)LoopMark;
        nuint at = owner;
        if (at < Sys.Stack() || at >= opener) return false;
        nuint callee = 0;
        nuint fp = Sys.FramePointer();
        for (int k = 0; k < FrameWalk && fp != 0 && fp < opener; k++)
        {
            nuint next = Sys.ReadAddress(fp);
            if (next <= fp) return false;
            callee = fp;
            fp = next;
        }
        if (fp != opener) return false;
        if ((word & LoopMark) == 0) return true;
        return callee != 0 && at < callee;
    }

    /// What this thread counted in its block (Tls.RegionCount), added to RegionBlocks.
    public static void CountRegionBlocks(nuint tb)
    {
        nuint counted = Sys.ReadAddress(tb + Tls.RegionCount);
        if (counted == 0) return;
        Sys.WriteAddress(tb + Tls.RegionCount, 0);
        RegionBlocks = RegionBlocks + (long)counted;
    }

    /// A block in the innermost open region -- when `owner` is 0, or is
    /// itself in that region, or is on this thread's stack in a frame that
    /// returns no later than that region ends (OnStackWithin) -- or on the
    /// heap. `frame` is the allocating function's: a region opened below it
    /// is one a throw has left.
    public static nuint AllocRegion(nuint bytes, nuint kind, nuint owner, nuint frame)
    {
        nuint tb = Sys.ThreadBlock();
        nuint open = tb == 0 ? 0 : Sys.ReadAddress(tb + Tls.RegionOpen);
        if (open != 0 && Below(OpenerFrame(open), frame, false))
        {
            PopStale(tb, frame, false);
            open = Sys.ReadAddress(tb + Tls.RegionOpen);
        }
        // Beside an object on the heap, in an outer region, or in a frame
        // that outlives the region: on the heap.
        if (open == 0 || bytes > MaxRequest
            || owner != 0 && !InInnermost(tb, open, owner) && !OnStackWithin(open, owner))
        {
            return AllocWord(bytes, kind);
        }
        nuint at = Sys.ReadAddress(tb + Tls.RegionAt);
        nuint need = MixedNeed(bytes);
        if (need > Sys.ReadAddress(tb + Tls.RegionEnd) - at)
        {
            // NO MORE THAN A SIXTEENTH OF THE MACHINE IN REGIONS. A region
            // holds everything made in it until it ends, and one around a
            // thread's whole body -- a loop that fills a list and clears it,
            // lap after lap -- held every lap's garbage until the thread
            // ended: the arena grew until the kernel refused the mapping.
            // Past the cap a region's blocks come from the heap, where the
            // collector takes them: they die no later than the region would
            // have ended, as every one of its blocks does.
            if ((long)ArenaMappedNow + (long)need > RegionArenaCap())
            {
                RegionCapped = RegionCapped + 1;
                return AllocWord(bytes, kind);
            }
            if (!NextChunk(tb, need, false))
            {
                RegionMisses = RegionMisses + 1;
                return AllocWord(bytes, kind);
            }
            at = Sys.ReadAddress(tb + Tls.RegionAt);
        }
        Stamp(at, need, 0);
        Sys.WriteAddress(at + KindAt, kind);
        // The block laid down before the pointer passes it: a scan sees it
        // whole or not at all.
        Sys.WriteAddress(tb + Tls.RegionAt, at + need);
        Sys.WriteAddress(tb + Tls.RegionCount, Sys.ReadAddress(tb + Tls.RegionCount) + 1);
        return at + HeaderBytes;
    }

    /// <summary>
    /// A REGION'S BLOCK GIVEN BACK BEFORE ITS REGION ENDS, by a free that
    /// proved it dead: where it ends exactly at the innermost region's bump
    /// pointer, in the chunk being filled and past the region's record, the
    /// pointer comes back down over it and its bytes are zeroed, so the next
    /// allocation takes them -- and on down over every block under it given
    /// back already. Anywhere else in that stretch it is marked given back
    /// (KindFreed), for the pointer to come down over later; elsewhere it
    /// waits for its region's end, as every region block did. A List grown
    /// in a region, freed with its arrays, leaves nothing behind: each array
    /// it outgrew was given back as it grew (OutgrownStorage.Release, an
    /// owned field's old value), marked below the one that replaced it.
    ///
    /// ONLY FOR A BLOCK READ FROM A FIELD OF AN OBJECT STILL ALIVE (FreeHeld):
    /// such a pointer is the block itself. One kept in a register may name
    /// memory a loop's lap has given back and the next lap has made again --
    /// Runtime.Free and FreeReplaced do nothing for a region's block.
    ///
    /// The thread's own, never stopped part-way in a way the collector can
    /// see: the pointer moves down before the bytes are cleared, so a scan
    /// of the stopped thread reads no further than the blocks still live,
    /// and a block's mark is one word, which ScanRegion reads before or
    /// after but never half.
    /// </summary>
    public static void RegionFree(nuint at)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0 || at == 0) return;
        nuint open = Sys.ReadAddress(tb + Tls.RegionOpen);
        if (open == 0) return;
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint top = Sys.ReadAddress(tb + Tls.RegionAt);
        nuint start = ChunkStart(last);
        // The innermost region's part of the chunk being filled: past its
        // record, or the whole chunk when it began in one before.
        nuint floor = open >= start && open < last ? open + RecordBytes : start;
        nuint block = at - HeaderBytes;
        if (block < floor || block >= top) return;
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        if (size < Smallest || Beyond(block, size, top) || Sys.ReadAddress(block + size - FooterBytes) != word) return;
        if (Sys.ReadAddress(block + KindAt) == KindFreed) return;
        if (block + size != top)
        {
            Sys.WriteAddress(block + KindAt, KindFreed);
            return;
        }
        // As full as it gets before the pointer comes down: measured first.
        ArenaMeasure(tb);
        nuint freed = 0;
        while (true)
        {
            Sys.WriteAddress(tb + Tls.RegionAt, block);
            Sys.MemorySet(block, 0, size);
            freed = freed + size;
            RegionTopFrees = RegionTopFrees + 1;
            if (block - floor < Smallest) break;
            // The block below, by its footer: on down while it is one given back.
            nuint below = Sys.ReadAddress(block - FooterBytes);
            nuint under = below & SizeMask;
            if (under < Smallest || under > block - floor) break;
            nuint prev = block - under;
            if (Sys.ReadAddress(prev) != below || Sys.ReadAddress(prev + KindAt) != KindFreed) break;
            block = prev;
            size = under;
        }
        RegionTopFreedBytes = RegionTopFreedBytes + (long)freed;
        FreedBytes = FreedBytes + (long)freed;
    }

    /// <summary>
    /// AN ARRAY GROWN WHERE IT IS, to `length` elements, when it is the block
    /// at the innermost region's top in the chunk being filled and the chunk
    /// has the room: the bump pointer goes on past the new end, the block's
    /// size and its count follow, and the new elements are the zeroed bytes
    /// the arena keeps past its pointer. False otherwise -- anywhere else, on
    /// the heap -- and nothing is changed.
    ///
    /// ONLY FOR AN ARRAY HELD BY ITS COLLECTION'S OWN STORAGE FIELD AND
    /// NOTHING ELSE (List's items, never lent; a builder's buffer, a string
    /// no one else is ever handed): every reader reads its length again
    /// through that field, and none holds the old one.
    ///
    /// A stopped thread's arena reads whole after every step: the pointer
    /// moves first, so a scan meets the block at its old size and then the
    /// zeroed bytes after it, which end the chunk's walk; the new footer is
    /// written past the old end, the old footer -- now inside the elements --
    /// cleared, then the header, and the count last, so a scan never reads
    /// more elements than the block holds, nor a word that is not one.
    /// </summary>
    public static bool RegionGrow(nuint at, long length)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0 || at == 0 || length <= 0 || length > 0x7FFFFFFF) return false;
        nuint open = Sys.ReadAddress(tb + Tls.RegionOpen);
        if (open == 0) return false;
        const int w = WordSize.Bytes;
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint top = Sys.ReadAddress(tb + Tls.RegionAt);
        nuint start = ChunkStart(last);
        nuint floor = open >= start && open < last ? open + RecordBytes : start;
        nuint block = at - HeaderBytes;
        if (block < floor || block >= top) return false;
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        if (size < Smallest || block + size != top || Sys.ReadAddress(block + size - FooterBytes) != word || (word & ~SizeMask) != 0) return false;
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind != KindObject && kind != KindLeaf) return false;
        // An array, or a string's characters, by its descriptor.
        nuint vt = Sys.ReadAddress(at);
        if (vt == 0 || InQuarantine(vt)) return false;
        nuint desc = vt - DescWords * w;
        if ((Sys.ReadAddress(desc + DescSelfWord * w)) != desc) return false;
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) == 0) return false;
        nuint stride = Sys.ReadAddress(desc + DescSizeWord * w);
        nuint payload = Sys.ReadAddress(desc + DescPayloadWord * w);
        nuint count = Sys.ReadAddress(at + ArrayCountAt) & 0x7FFFFFFF;
        // In range, checked above: a count, as a word.
        nuint elements = (nuint)length;
        // The product bounded before it is made: in 32 bits a count near
        // 2^30 of words wrapped it small, and the region grew by a few bytes
        // under a count of a billion.
        if (stride == 0 || elements <= count || payload > MaxRequest || elements > (MaxRequest - payload) / stride) return false;
        nuint need = (payload + elements * stride + Overhead + 7) & SizeMask;
        if (need <= size || need > last - block) return false;
        // The pointer first, then the footer past the old end, the old footer
        // cleared, the header, and the count last.
        Sys.WriteAddress(tb + Tls.RegionAt, block + need);
        Sys.WriteAddress(block + need - FooterBytes, need);
        Sys.WriteAddress(block + size - FooterBytes, 0);
        Sys.WriteAddress(block, need);
        Sys.Write32(at + ArrayCountAt, (Sys.Read32(at + ArrayCountAt) & 0x80000000) | (uint)length);
        RegionGrownInPlace = RegionGrownInPlace + 1;
        return true;
    }

    /// Whether the block of a region's `at` is an object -- the only kind
    /// with a type to read and fields it may own. A captured variable's cell
    /// or a frame's spilled words are scanned blocks of no type, an array
    /// of numbers a leaf.
    public static bool RegionObject(nuint at)
    {
        return Sys.ReadAddress(at - HeaderBytes + KindAt) == KindObject;
    }

    /// The same of any block the allocator made, the heap's or a region's,
    /// which carry the kind in the same header word: a struct's block is no
    /// object, its first word a field and no descriptor.
    public static bool ObjectBlock(nuint at)
    {
        return at != 0 && (at & 7) == 0 && Sys.ReadAddress(at - HeaderBytes + KindAt) == KindObject;
    }

    /// Whether `at` is in the calling thread's arena.
    public static bool InOwnRegion(nuint at)
    {
        nuint tb = Sys.ThreadBlock();
        return tb != 0 && at != 0 && InRegion(tb, at);
    }

    /// A thread's arena given back as the thread ends.
    public static void ReleaseRegion(nuint tb)
    {
        if (tb != 0) CountRegionBlocks(tb);
        nuint c = tb == 0 ? 0 : Sys.ReadAddress(tb + Tls.RegionBase);
        if (c == 0) return;
        // What it last said it held filled, no longer held.
        nuint measured = Sys.ReadAddress(c + TrailerMeasured * WordSize.Bytes);
        if (measured != 0) Sys.AtomicAdd(Sys.AddressOf(ref ArenaUsedNow), -measured);
        Sys.WriteAddress(tb + Tls.RegionBase, 0);
        Sys.WriteAddress(tb + Tls.RegionAt, 0);
        SetOpen(tb, 0);
        Sys.WriteAddress(tb + Tls.RegionEnd, 0);
        while (c != 0)
        {
            nuint after = ChunkAfter(c);
            nuint start = ChunkStart(c);
            ArenaUnmapped(c + TrailerBytes - start);
            Platform.Unmap(start, c + TrailerBytes - start);
            c = after;
        }
    }

    // A chunk of `bytes` mapped for an arena: counted, and the peak raised.
    static void ArenaMapped(nuint bytes)
    {
        ArenaChunksMapped = ArenaChunksMapped + 1;
        ArenaAskedBytes = ArenaAskedBytes + (long)bytes;
        Sys.AtomicAdd(Sys.AddressOf(ref ArenaMappedNow), bytes);
        RaisePeak(Sys.AddressOf(ref ArenaMappedPeak), ArenaMappedNow);
    }

    // A chunk of `bytes` handed back to the system.
    static void ArenaUnmapped(nuint bytes)
    {
        ArenaChunksUnmapped = ArenaChunksUnmapped + 1;
        Sys.AtomicAdd(Sys.AddressOf(ref ArenaMappedNow), 0 - bytes);
    }

    // HOW FULL THIS THREAD'S ARENA IS NOW, chunk by chunk to the one being
    // filled, put in place of what it last said in the process-wide sum,
    // and the peak raised. Only while the stats are asked for: a region's
    // end walks its chunks, a handful, for nothing otherwise.
    static void ArenaMeasure(nuint tb)
    {
        if (!(StatsAsked || CountingCollected)) return;
        nuint first = Sys.ReadAddress(tb + Tls.RegionBase);
        if (first == 0) return;
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint filled = 0;
        nuint c = first;
        while (c != 0)
        {
            filled = filled + (ChunkTop(tb, c) - ChunkStart(c));
            if (c == last) break;
            c = ChunkAfter(c);
        }
        nuint at = first + TrailerMeasured * WordSize.Bytes;
        nuint had = Sys.ReadAddress(at);
        if (filled == had) return;
        Sys.WriteAddress(at, filled);
        Sys.AtomicAdd(Sys.AddressOf(ref ArenaUsedNow), filled - had);
        if (filled > had) RaisePeak(Sys.AddressOf(ref ArenaUsedPeak), ArenaUsedNow);
    }

    // The word at `at` made `value` if that is more: a compare-and-swap, so
    // two threads raising it at once keep the larger.
    static void RaisePeak(nuint at, nuint value)
    {
        while (true)
        {
            nuint had = Sys.ReadAddress(at);
            if (value <= had) return;
            if (Sys.Cas(at, had, value) == had) return;
        }
    }

    /// Whether `at` is in this thread's arena.
    static bool InRegion(nuint tb, nuint at)
    {
        return ChunkOf(tb, at) != 0;
    }

    /// The arena's live blocks marked from, as a stack's words are.
    public static void ScanRegion(nuint tb)
    {
        nuint c = Sys.ReadAddress(tb + Tls.RegionBase);
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        while (c != 0)
        {
            nuint p = ChunkStart(c);
            nuint end = ChunkTop(tb, c);
            while (p < end)
            {
                nuint size = Sys.ReadAddress(p) & SizeMask;
                if (size < Smallest || Beyond(p, size, end)) break;
                // A block given back below the top holds nothing live (RegionFree).
                if (Sys.ReadAddress(p + KindAt) != KindFreed) ScanBlock(p, size, FooterBytes);
                p = p + size;
            }
            if (c == last) break;
            c = ChunkAfter(c);
        }
    }

    /// The words the arena's live part takes: at most what a copy of it
    /// (CopyRegion) writes.
    public static nuint RegionWords(nuint tb)
    {
        nuint c = Sys.ReadAddress(tb + Tls.RegionBase);
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint words = 0;
        while (c != 0)
        {
            nuint filled = ChunkTop(tb, c) - ChunkStart(c);
            if (filled > 0) words = words + filled / WordSize.Bytes;
            if (c == last) break;
            c = ChunkAfter(c);
        }
        return words;
    }

    /// THE ARENA AS IT IS, written to `copy` for STAMP's snapshot
    /// (GcThreads.CopyStack): a stack's copy keeps what the stack held at
    /// the snapshot, and the arena is the stack's as far as the heap is
    /// concerned. Without it a reference held only in a region's object
    /// could be moved into an object made since -- new, so stored with no
    /// barrier -- and the region's end zeroes where it was before SCAN reads
    /// the arena: the newcomer is kept, never traced, and what it holds is
    /// swept. The payloads of every block but a leaf, read as a stack's
    /// words are; past a header that does not read as a block (never, while
    /// the thread is stopped or is the one copying) the rest of its chunk
    /// whole, which is never wrong. Answers how many words it wrote.
    ///
    /// ONLY THE WORDS THAT COULD MARK SOMETHING: not a null, and not an
    /// address in the arena itself, which is no heap block and marks
    /// nothing. An arena a loop has filled -- a thread's body making objects
    /// until it is told to stop, every one dead at its return -- is
    /// megabytes of such words, written into fresh pages at every cycle and
    /// read again; three threads' arenas were most of a small heap's run.
    public static nuint CopyRegion(nuint tb, nuint copy)
    {
        const int w = WordSize.Bytes;
        nuint c = Sys.ReadAddress(tb + Tls.RegionBase);
        nuint last = Sys.ReadAddress(tb + Tls.RegionEnd);
        nuint n = 0;
        while (c != 0)
        {
            nuint p = ChunkStart(c);
            nuint end = ChunkTop(tb, c);
            while (p < end)
            {
                nuint size = Sys.ReadAddress(p) & SizeMask;
                nuint from = p + HeaderBytes;
                nuint to = p + size - FooterBytes;
                if (size < Smallest || Beyond(p, size, end))
                {
                    from = p;
                    to = end;
                    size = end - p;
                }
                else if (Sys.ReadAddress(p + KindAt) == KindLeaf || Sys.ReadAddress(p + KindAt) == KindFreed)
                {
                    from = to;
                }
                while (from < to)
                {
                    nuint word = Sys.ReadAddress(from);
                    if (word != 0 && !InRegion(tb, word))
                    {
                        Sys.WriteAddress(copy + n * w, word);
                        n = n + 1;
                    }
                    from = from + w;
                }
                p = p + size;
            }
            if (c == last) break;
            c = ChunkAfter(c);
        }
        return n;
    }

    /// The heap. Zeroed memory for `bytes`, 8-aligned.
    ///
    /// THE FAST PATH, kept to a few instructions so the inliner can put it at
    /// every `new`: round the size, bump the pointer within the current
    /// chunk, stamp the block, and count it towards the next collection.
    /// An available fitting block in the request's size bin diverts it to the
    /// locked index for reuse. Unrelated free sizes do not prevent a thread
    /// from using its private buffer. The unlocked head/maximum check is only
    /// a hint; the slow path takes a block under the heap lock.
    /// Everything else -- a full chunk, a collection due, a size out of
    /// range, the heap not started -- falls to AllocSlow. Memory above the
    /// bump pointer is untouched since the operating system zeroed it, so
    /// the fast path clears nothing; that is why the bump pointer never
    /// moves backwards.
    ///
    /// The chunk's own end word is NOT updated here; the slow path, a
    /// collection and Free bring it up to date first (SyncEnd), which is
    /// every place that reads it.
    public static nuint Alloc(nuint bytes)
    {
        return AllocKind(bytes, 0);
    }

    /// The same for a block that will hold no references -- a string, an
    /// array of bytes or characters: marked when reachable, never scanned
    /// (KindLeaf).
    public static nuint AllocLeaf(nuint bytes)
    {
        return AllocKind(bytes, KindLeaf);
    }

    /// The same for an object the caller is about to give its vtable:
    /// scanned by its descriptor's reference map (KindObject).
    public static nuint AllocObject(nuint bytes)
    {
        return AllocKind(bytes, KindObject);
    }

    // ---- GUARDS, while the heap check is on ------------------------------
    //
    // Every block made has room after what was asked for: a fill of 0xCD
    // bytes, then a magic word, the bytes asked for, and two return addresses
    // of the code that asked. A write past the end of any object lands in
    // the fill or the words and is found -- at the object's free, at every
    // sweep, at every heap walk -- with the object's type and who made it.
    // FOUR WORDS AND EIGHT BYTES OF FILL: 24 on i386, 40 in long mode. A flat
    // 24 there was the four words alone less a word, and the guard written
    // the object's last eight bytes over -- a heap-checked x86-64 program's
    // tables went round for ever.
    const int GuardBytes = 4 * WordSize.Bytes + 8;
    const int GuardMagic = 0x6A11EDC0;
    static long _guardReports;

    /// WHAT THE HEAP CHECK HAS SAID (Corsac.GC.HeapCheck), counted: a guard
    /// written over, a footer or a next header overwritten after its block
    /// was made, a class list holding a live block, two owners of one range
    /// -- each said on standard error as well. What a run with the check on
    /// asks to know it was clean.
    public static long HeapCheckReports => _guardReports + _recentReports + _listReports + _ownerReports;

    static nuint AllocKind(nuint bytes, nuint kind)
    {
        if (!_heapCheck || bytes > MaxRequest) return AllocKindUnguarded(bytes, kind);
        nuint at = AllocKindUnguarded(bytes + GuardBytes, kind);
        if (at != 0) PaintGuard(at, bytes);
        return at;
    }

    static void PaintGuard(nuint at, nuint bytes)
    {
        nuint block = at - HeaderBytes;
        nuint size = Sys.ReadAddress(block) & SizeMask;
        const int w = WordSize.Bytes;
        // THE GUARD ENDS A WORD SHORT OF THE BLOCK whatever its chunk: at the
        // footer in a mixed chunk, and in a page, which has none, before the
        // payload's last word, which nothing then writes. CheckGuard reads
        // it where this wrote it without asking which.
        nuint tail = block + size - FooterBytes;          // the footer, or that last word
        nuint words = tail - 4 * w;                       // magic, bytes, two callers
        for (nuint p = at + bytes; p < words; p++) Sys.Write8(p, 0xCD);
        Sys.WriteAddress(words, GuardMagic);
        Sys.WriteAddress(words + w, bytes);
        nuint fp = Sys.FramePointer();
        nuint r1 = 0, r2 = 0;
        for (int i = 0; i < 4 && fp != 0; i++)
        {
            nuint back = Sys.ReadAddress(fp + w);
            if (i == 2) r1 = back;
            if (i == 3) r2 = back;
            nuint next = Sys.ReadAddress(fp);
            fp = next > fp ? next : 0;
        }
        Sys.WriteAddress(words + 2 * w, r1);
        Sys.WriteAddress(words + 3 * w, r2);
    }

    /// The guard of a live, guarded block intact, or said (with `where`).
    /// Anything without the magic is a block made before the check was on.
    public static void CheckGuard(nuint block, string where)
    {
        if (!_heapCheck || _guardReports >= 24) return;
        nuint word = Sys.ReadAddress(block);
        if ((word & FlagFree) != 0) return;
        nuint size = word & SizeMask;
        if (size < Smallest + GuardBytes) return;
        const int w = WordSize.Bytes;
        nuint tail = block + size - FooterBytes;
        nuint words = tail - 4 * w;
        nuint at = block + HeaderBytes;
        nuint magic = Sys.ReadAddress(words);
        nuint bytes = Sys.ReadAddress(words + w);
        bool magicGood = magic == GuardMagic;
        if (!magicGood)
        {
            // Not guarded, or the words themselves were written over: only
            // the second if the fill before them is still the fill.
            // Or zeroed whole, footer too: a live small block keeps its
            // footer equal to its header (only a large one is ever folded,
            // dead, into a free run), so magic, fill and footer all zero on
            // one the header still calls live is the zeroing writer's. (A
            // page's block has no footer; the word read there is its last,
            // zero unless written past the guard.)
            bool zeroed = size <= ClassMax && magic == 0 && Sys.ReadAddress(tail) == 0 && words - 1 >= at && Sys.Read8(words - 1) == 0;
            if (!zeroed && (words - 1 < at || Sys.Read8(words - 1) != 0xCD)) return;
        }
        // The first byte past the request that is not the fill, or 0.
        nuint bad = 0;
        if (magicGood && bytes <= words - at)
        {
            for (nuint p = at + bytes; p < words; p++) if (Sys.Read8(p) != 0xCD) { bad = p; break; }
        }
        // A block the sweep folded, dead, into a run of free ones keeps its
        // header and loses its footer; only the guard itself is evidence.
        if (magicGood && bad == 0) return;
        _guardReports = _guardReports + 1;
        Runtime.WriteLiteral(2, "gc guard: an object's guard written over, found by ");
        Runtime.WriteLiteral(2, where);
        SayNumber(" -- block ", block);
        SayNumber("gc guard:   size ", size);
        SayNumber("gc guard:   bytes asked for ", bytes);
        SayNumber("gc guard:   its type word ", Sys.ReadAddress(at));
        SayNumber("gc guard:   first bad byte at offset ", bad == 0 ? -1 : (long)(bad - at));
        SayNumber("gc guard:   holding ", bad == 0 ? magic : Sys.Read8(bad));
        SayNumber("gc guard:   footer ", Sys.ReadAddress(tail));
        Runtime.WriteLiteral(2, "gc guard:   made by:\n");
        Runtime.SayFrame(2, Sys.ReadAddress(words + 2 * w));
        Runtime.SayFrame(2, Sys.ReadAddress(words + 3 * w));
        Runtime.WriteLiteral(2, "gc guard:   found at:\n");
        Runtime.SayTrace(2, Sys.FramePointer());
        // Put right, so the same damage is said once.
        if (magicGood && bytes <= words - at) for (nuint p = at + bytes; p < words; p++) Sys.Write8(p, 0xCD);
    }

    public const int ObjectKind = KindObject;
    public const int LeafKind = KindLeaf;

    /// THE WAY IN FOR COMPILED CODE, IN WORDS: AllocKindUnguarded's two fast
    /// paths again, a request of compiled code's (a word, a negative one a
    /// huge one and refused here). Anything unusual (the guard check,
    /// a bad size, an empty list, a full buffer) is the long path's.
    public static nuint AllocWord(nuint bytes, nuint kind)
    {
        if (_heapCheck || bytes > MaxRequest)
        {
            return AllocKind(bytes, kind);
        }
        nuint request = bytes;
        nuint what = kind;
        const int w = WordSize.Bytes;
        nuint tb = Sys.ThreadBlock();
        // A class's block has no footer: the request and the header only.
        nuint small = (request + ClassRounding) & SizeMask;
        if (small <= ClassMax)
        {
            // IN THE ALLOCATOR BEFORE THE CACHE IS READ (Tls.InAlloc), as the
            // bump below is before its pointer is: a kernel sends a thread to
            // its handshake at any instruction, and an answer -- or a wait
            // counted as stopped, whose pages ShedPages may give up -- landing
            // between the read and the pop would leave this thread popping
            // off a cache it had been answered for. ShedPages gives back the
            // lists of a thread whose cache the last round took and which is
            // not in the allocator: one that had read its cache here and not
            // yet said so popped a block RetireClasses had just put on its
            // page's list, and the block was handed out twice -- the NT
            // kernel's address-space list found zeroed under it at a first
            // logon with memory short.
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            if (cache == 0)
            {
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                return AllocSlow(request, what);
            }
            nuint c = Sys.ReadAddress(_classOf + (small >> 3) * w);
            nuint slot = cache + c * (2 * w);
            nuint free = Sys.ReadAddress(slot + w);
            if (free == 0)
            {
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                return AllocSlow(request, what);
            }
            nuint size = Sys.ReadAddress(_classSize + c * w);
            Sys.WriteAddress(slot + w, Sys.ReadAddress(free + KindAt));
            Sys.WriteAddress(free, size);
            Sys.WriteAddress(free + KindAt, what);
            // Not counted here: the list was, as it was handed over (ClassRefill).
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return free + HeaderBytes;
        }
        nuint need = MixedNeed(request);
        // Not to be stopped from outside between here and the bump: see AllocKindUnguarded.
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        nuint block = Sys.ReadAddress(tb + Tls.AllocPtr);
        // ROOM COUNTED, not the end summed (AllocRegion's same rule): in 32
        // bits a request of hundreds of megabytes from a buffer near the top
        // of the address space wrapped the sum below the limit, and the bump
        // handed out memory from address zero up. AND A LIMIT BELOW THE
        // POINTER IS NO ROOM: a round takes the limit away -- 0 under a live
        // pointer -- to send this thread to the slow path, and the room
        // counted from it wrapped to all there is: the thread bumped on past
        // its buffer over whatever lay beyond (739). AN EXACT FIT IS ROOM
        // (BufferFits).
        if (!BufferFits(block, need, Sys.ReadAddress(tb + Tls.AllocLimit)))
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return AllocSlow(request, what);
        }
        nuint next = block + need;
        Sys.WriteAddress(tb + Tls.AllocPtr, next);
        Sys.WriteAddress(block, need);
        Sys.WriteAddress(block + KindAt, what);
        Sys.WriteAddress(next - FooterBytes, need);
        Sys.WriteAddress(tb + Tls.InAlloc, 0);
        return block + HeaderBytes;
    }

    /// WHETHER THE BUFFER FROM `block` TO `limit` HOLDS `need` BYTES.
    ///
    /// The room is counted (limit - block) and the end never summed: in 32
    /// bits block + need can wrap below the limit and pass. A limit below
    /// the pointer is no room at all -- a round takes the limit away (the
    /// bump above says why).
    ///
    /// What is left past the request must be nothing, or at least a free
    /// block (Smallest), which Retire stamps there. AN EXACT FIT IS A FIT:
    /// refused, it sent the request to the slow path, which retired the
    /// buffer and its last hole's worth with it -- a recycled hole that held
    /// two requests answered one, its other half was passed over until the
    /// next collection, and the heap grew for the request instead (737).
    static bool BufferFits(nuint block, nuint need, nuint limit)
    {
        if (limit < block) return false;
        nuint room = limit - block;
        return need == room || need <= room && room - need >= Smallest;
    }

    static nuint AllocKindUnguarded(nuint bytes, nuint kind)
    {
        nuint tb = Sys.ThreadBlock();
        nuint need = MixedNeed(bytes);
        nuint small = (bytes + ClassRounding) & SizeMask;

        // A SMALL BLOCK OFF THIS THREAD'S LIST FOR ITS CLASS (size classes):
        // no lock, no clearing -- a free block in a page is zero already, its
        // last word too, for it has no footer. No cache (none yet, or a
        // handshake took it away) or an empty list is the slow path's.
        if (small <= ClassMax && bytes <= MaxRequest)
        {
            // Inside the allocator before the cache is read, as in AllocWord:
            // ShedPages passes over a thread only while it says so.
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            if (cache != 0)
            {
                nuint c = Sys.ReadAddress(_classOf + (small >> 3) * WordSize.Bytes);
                nuint slot = cache + c * (2 * WordSize.Bytes);
                nuint free = Sys.ReadAddress(slot + WordSize.Bytes);
                if (free != 0)
                {
                    nuint size = Sys.ReadAddress(_classSize + c * WordSize.Bytes);
                    if (_heapCheck) CheckOutsideBuffer(free, free + size, "gc owner check: a class block inside the live buffer (fast)");
                    Sys.WriteAddress(slot + WordSize.Bytes, Sys.ReadAddress(free + KindAt));
                    Sys.WriteAddress(free, size);
                    Sys.WriteAddress(free + KindAt, kind);
                    Sys.WriteAddress(tb + Tls.InAlloc, 0);
                    if (_heapCheck) { CheckMade(free, "class fast path", 0); CheckList(Sys.ReadAddress(slot + WordSize.Bytes), size, "class fast path"); }
                    return free + HeaderBytes;
                }
            }
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return AllocSlow(bytes, kind);
        }
        // Not to be stopped from outside between here and the bump
        // (Tls.InAlloc): the limit read below is the promise the buffer is
        // still this thread's, and an interrupting collector must not
        // retire it before the pointer has moved past the object.
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        nuint block = Sys.ReadAddress(tb + Tls.AllocPtr);

        // A BUFFER WITH ROOM ANSWERS, whatever the free index holds. Asking
        // it first sent every allocation whose size had a hole anywhere to
        // the heap lock -- on a fragmented heap, nearly all of them, with
        // every thread queued behind whichever was collecting -- and put the
        // object in that hole's chunk, young for the next minor cycle to
        // walk. Holes are reused as buffers are refilled (AllocSlow).
        if (bytes > MaxRequest || !BufferFits(block, need, Sys.ReadAddress(tb + Tls.AllocLimit)))
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return AllocSlow(bytes, kind);
        }

        nuint next = block + need;
        Sys.WriteAddress(tb + Tls.AllocPtr, next);
        Sys.WriteAddress(block, need);
        Sys.WriteAddress(block + KindAt, kind);
        Sys.WriteAddress(next - FooterBytes, need);
        Sys.WriteAddress(tb + Tls.InAlloc, 0);
        if (_heapCheck) CheckMade(block, "bump fast path", FooterBytes);
        return block + HeaderBytes;
    }

    // ---- size classes ----------------------------------------------------------
    //
    // EVERY BLOCK OF A KILOBYTE OR LESS COMES FROM A PAGE OF ITS SIZE CLASS:
    // a 32 KB chunk (HeapChunks.PageBytes) laid out as blocks of one size,
    // each with its header as any block has, so that everything that walks
    // a chunk -- the start table, the census, the heap check -- walks a page
    // by the same chain of sizes. NOT ITS FOOTER: the page says the size,
    // and the word is the object's ("what a block looks like"), so a class
    // is a payload and a header, and a payload ends at the block's end
    // (TailIn). What a page does NOT do is merge: a block dies
    // and goes back on its page's free list at its own size, for the next
    // allocation of that class, wherever it lies.
    //
    // That is the whole point. One heap of mixed blocks bumped through by
    // everybody left the survivors of every phase of a compiler scattered a
    // kilobyte apart: 153 MB live in a 512 MB heap had 383 MB free in holes
    // of 256 bytes to 4 KB, not one of them 256 KB, and a list's backing
    // array could not be had. A free block of a class is reusable by the
    // next object of its class whatever surrounds it, a page with nothing
    // left alive goes back whole -- to the pool, for any class, or to the
    // operating system -- and the heap stays near its live size.
    //
    // A THREAD OWNS ONE PAGE OF A CLASS AT A TIME (Tls.Classes): its free
    // list is the thread's to pop with no lock, exactly as a buffer is the
    // thread's to bump. So an owned page is, to the collector, a buffer: it
    // is captured with the buffers (GcThreads.CaptureBuffersInto) and every
    // walk steps over it; its objects are written into the snapshot by its
    // owner (StampBuffer) and unmarked with the buffers (UnmarkBuffer); the
    // sweep keeps it whole. Only a page nobody owns is swept, and its free
    // list rebuilt from nothing. A page is given up when its list runs dry,
    // when the collector that owns it starts a collection, and when its
    // thread goes.
    //
    // THE PAYLOAD OF A FREE BLOCK IN A PAGE IS ZERO, to its last word: the
    // sweep and Free clear a block as it dies, so the fast path, like the
    // bump, clears nothing and writes only the header and the kind. Its
    // header is its size with FlagFree, its kind word the next free block
    // of the list it is on.

    public const int ClassMax = 1024;      // the largest block a class holds
    public const int Classes = 39;
    // PUBLIC FOR THE ALLOCATION INLINED AT EVERY `new` (Runtime.AllocFast),
    // which reads them as AllocWord does. Mapped once, at Start, and never
    // moved: 0 until then, which sends that path to the long way.
    public static nuint _classSize;  // Classes words: each class's block size
    /// THE ONE TEST THE ALLOCATION IN PLACE MAKES (Runtime.AllocFast): the
    /// thread's class cache, ANDed with this, is 0 -- the slow path -- with
    /// no cache (none yet, or a handshake took it, which is how a thread is
    /// sent to answer) and whenever this is: before the heap starts, while
    /// the heap check wants its guards, and while a sampler counts
    /// allocations (Runtime.AllocHook). All ones otherwise. A word, so the
    /// test is a load, an AND and a branch. Set by FastPathsChanged, which
    /// every change to those calls.
    public static nuint FastClassMask;

    public static void FastPathsChanged()
    {
        FastClassMask = _classSize != 0 && !_heapCheck && Runtime.AllocHook == 0 ? nuint.MaxValue : 0;
        FastRegionMask = Runtime.AllocHook == 0 ? nuint.MaxValue : 0;
        FastFreeMask = _classSize != 0 && !_heapCheck && !_verify && !VerifyingFieldFrees && !AllocSamples.Tracking
            && Runtime.FreeLogRing == 0 && IgnoredFrees == 0 && SkippedFreePaths == 0 ? nuint.MaxValue : 0;
    }

    /// THE SAME FOR AN ALLOCATION IN A REGION (Runtime.AllocRegionSized,
    /// AllocRegion): all ones but while a sampler counts (AllocHook), whose
    /// samples the long way takes. 0 too until the heap starts, which is at
    /// the first allocation of any kind.
    public static nuint FastRegionMask;
    public static nuint _classOf;    // ClassMax / 8 + 1 words: need >> 3 -> class
    static nuint _classPages => _h + HeapClassPagesAt;
    static nuint _classStep;        // Classes words: ceil(2^32 / the class's size), for OnGrid
    static nuint _pool { get { return Sys.ReadAddress(_h + HeapPoolAt); } set { Sys.WriteAddress(_h + HeapPoolAt, value); } }
    static nuint _poolBytes { get { return Sys.ReadAddress(_h + HeapPoolBytesAt); } set { Sys.WriteAddress(_h + HeapPoolBytesAt, value); } }
    public static long PagesTaken, PagesPooled, PagesReleased, PagesRefilled;

    /// The heap lock's trips: requests the fast paths sent to AllocSlow, and
    /// of those the refills of a thread's class cache, and the refills that
    /// laid out more of the page it owned (FormatMore). Counted under the lock.
    public static long SlowPaths, ClassRefills, ClassLaidFurther;
    /// Small requests that found no page and collected for one.
    public static long ClassStarved;
    /// Small requests answered with a free slot of a bigger class (TakeLarger).
    public static long ClassBorrowed;

    /// The class tables, mapped once as the heap starts.
    static bool StartClasses()
    {
        nuint tables = Platform.Map(4096);
        if (tables == 0)
        {
            return false;
        }
        _classSize = tables;
        _classOf = tables + 64 * WordSize.Bytes;
        _classStep = tables + 256 * WordSize.Bytes;
        nuint size = LeastBlock;
        nuint c = 0;
        while (size <= ClassMax)
        {
            Sys.WriteAddress(_classSize + c * WordSize.Bytes, size);
            Sys.WriteAddress(_classStep + c * WordSize.Bytes, Reciprocal(size));
            c = c + 1;
            // Eighths of each power of two above 128: no block wastes more
            // than an eighth of itself to its class.
            if (size < 128) size = size + 8;
            else if (size < 256) size = size + 16;
            else if (size < 512) size = size + 32;
            else size = size + 64;
        }
        nuint k = 0;
        for (nuint i = 0; i <= ClassMax / 8; i++)
        {
            while (Sys.ReadAddress(_classSize + k * WordSize.Bytes) < i * 8) k = k + 1;
            Sys.WriteAddress(_classOf + i * WordSize.Bytes, k);
        }
        return true;
    }

    static nuint ClassSize(nuint c)
    {
        return Sys.ReadAddress(_classSize + c * WordSize.Bytes);
    }

    /// WHETHER `offset` INTO A PAGE OF CLASS `c` IS A BLOCK'S START, without
    /// a division. A division by a size not known until run time is checked
    /// for zero, and the check's throw reaches, through an unhandled
    /// exception's report, the whole program: put on the barrier's path
    /// (Whole, through BlockForPointer), it told the link every store a
    /// collection makes may write any field, and nothing owned what it held.
    /// The quotient is the offset times ceil(2^32 / size), high half: an
    /// offset inside a page (under 2^16) and a size of at most ClassMax
    /// leave the error under 2^-16 of a block, so the floor is exact.
    static bool OnGrid(nuint offset, nuint c)
    {
        if (offset >= 0x10000) return false;
        // Up to 44 bits before the shift: a 64-bit product on i386 too.
        nuint quotient = (nuint)(((ulong)offset * Sys.ReadAddress(_classStep + c * WordSize.Bytes)) >> 32);
        return quotient * ClassSize(c) == offset;
    }

    /// ceil(2^32 / size) by shifts and subtraction: no division, for the
    /// reason OnGrid gives.
    static nuint Reciprocal(nuint size)
    {
        // In 64 bits on either machine: 2^32 itself is the dividend. The
        // answer fits a word, a class being sixteen bytes at least.
        ulong quotient = 0, rest = 0;
        for (int bit = 32; bit >= 0; bit--)
        {
            rest = rest << 1;
            if (bit == 32) rest = rest | 1;
            quotient = quotient << 1;
            if (rest >= size) { rest = rest - size; quotient = quotient | 1; }
        }
        return (nuint)(rest != 0 ? quotient + 1 : quotient);
    }

    /// This thread's class cache, mapped at its first small allocation. The
    /// heap lock is held.
    static nuint EnsureCache(nuint tb)
    {
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache != 0)
        {
            return cache;
        }
        cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        if (cache == 0)
        {
            cache = Platform.Map(4096);
            if (cache == 0)
            {
                return 0;
            }
        }
        Sys.WriteAddress(tb + Tls.ClassesSaved, 0);
        Sys.WriteAddress(tb + Tls.Classes, cache);
        return cache;
    }

    /// A page laid out afresh for class `c`: its first few kilobytes as free
    /// blocks, on its list in address order; the rest is laid out as it is
    /// needed (FormatMore). Its memory above the header is zero (fresh from
    /// the operating system, or cleared by PopPool).
    ///
    /// A FEW KILOBYTES, NOT THE PAGE: laid out whole, every class a program
    /// touched wrote thirty-two kilobytes, and a program that allocated a
    /// handful of objects of each of twenty classes had most of a megabyte
    /// of its own memory for it -- init, a getty, each with the same -- on a
    /// machine of 64 MB. Only what is laid out is touched, and End says how
    /// far that is, as it always has for the blocks a page holds.
    static void FormatPage(nuint page, nuint c)
    {
        nuint size = ClassSize(c);
        nuint first = HeapChunks.First(page);
        if (_heapCheck) CheckOutsideBuffer(page, HeapChunks.Limit(page), "gc owner check: a class page laid out over the live buffer");
        nuint made = LayOut(page, first, size, (first + LayOutBytes) & ~(nuint)(LayOutBytes - 1));
        HeapChunks.SetPageFree(page, made != 0 ? first : 0);
        HeapChunks.SetPageClass(page, c + 1);
        HeapChunks.SetLargestHole(page, made * size);
        HeapChunks.SetLive(page, 0, 0);
        HeapChunks.SetPooled(page, false);
        // NOT THE STARTS OF WHAT WAS HERE BEFORE: an object laid where one
        // began at this cycle's stop would be taken for that one.
        HeapChunks.ClearStarts(page, HeapChunks.NoCycle - 1);
    }

    static void ListPage(nuint page)
    {
        nuint list = HeapOfChunk(page) + HeapClassPagesAt + (HeapChunks.PageClass(page) - 1) * WordSize.Bytes;
        nuint head = Sys.ReadAddress(list);
        HeapChunks.SetPageLinks(page, head, 0);
        if (head != 0) HeapChunks.SetPagePrev(head, page);
        Sys.WriteAddress(list, page);
        HeapChunks.SetListed(page, true);
    }

    static void UnlistPage(nuint page)
    {
        nuint next = HeapChunks.PageNext(page);
        nuint prev = HeapChunks.PagePrev(page);
        if (prev != 0) HeapChunks.SetPageNext(prev, next);
        else Sys.WriteAddress(HeapOfChunk(page) + HeapClassPagesAt + (HeapChunks.PageClass(page) - 1) * WordSize.Bytes, next);
        if (next != 0) HeapChunks.SetPagePrev(next, prev);
        HeapChunks.SetPageLinks(page, 0, 0);
        HeapChunks.SetListed(page, false);
    }

    /// The empty pages kept for reuse: a sixty-fourth of the heap, and never
    /// fewer than a few, so that a program whose small objects come and go
    /// does not map and unmap a page each time.
    static nuint PoolLimit()
    {
        // WHAT THE NEXT CYCLE WILL ALLOCATE: the pages emptied by this sweep
        // are the ones the program is about to fill again. Kept to a sixty-
        // fourth of the heap, the rest were unmapped and mapped straight back
        // -- a sorted index insert and removal each, a sixth of a compile.
        long want = _threshold;
        long least = 8L * HeapChunks.PageBytes;
        return (nuint)(want > least ? want : least);
    }

    /// THE POOL OF ONE HEAP. The first heap's is the collector's (PoolLimit):
    /// what the next cycle will allocate. Another's -- a kernel module's -- is
    /// an eighth of what it holds: a driver's heap with forty kilobytes live
    /// kept a whole threshold of empty pages, nine hundred kilobytes, for an
    /// allocation rate that never needed one.
    static nuint PoolLimitOf(nuint h)
    {
        if (h == _heap0) return PoolLimit();
        return Sys.ReadAddress(h + HeapBytesAt) / 8;
    }

    /// A page with nothing alive in it, off its list and pooled or given
    /// back. Nobody owns it. The heap lock is held.
    static void RetirePage(nuint page)
    {
        CountClassPage(HeapOfChunk(page), HeapChunks.PageClass(page) - 1, -1);
        if (HeapChunks.IsListed(page)) UnlistPage(page);
        HeapChunks.SetLive(page, 0, 0);
        HeapChunks.SetYoung(page, false);
        // NOT POOLED NEAR THE CAP (OverCap, by the soft cap): a pooled page is
        // mapped and counted, and a large array -- which only a new mapping
        // can hold -- found the cap filled by pages kept for small objects.
        // In its own heap's pool.
        nuint h = HeapOfChunk(page);
        nuint pooled = Sys.ReadAddress(h + HeapPoolBytesAt);
        if (pooled + HeapChunks.PageSize(page) <= PoolLimitOf(h) && !HeapChunks.OverCap() && !MemoryShort())
        {
            HeapChunks.SetPooled(page, true);
            HeapChunks.SetPageNext(page, Sys.ReadAddress(h + HeapPoolAt));
            Sys.WriteAddress(h + HeapPoolAt, page);
            Sys.WriteAddress(h + HeapPoolBytesAt, pooled + HeapChunks.PageSize(page));
            PagesPooled = PagesPooled + 1;
            return;
        }
        ReleaseChunk(page);
        PagesReleased = PagesReleased + 1;
    }

    /// WHETHER THE MACHINE IS SHORT OF MEMORY, as its platform says
    /// (ShortHook): then an emptied page goes back to it rather than into the
    /// pool, and a collection ends by draining the pool. Kept for the next
    /// cycle, they held a ring-1 kernel's heap at twice what was live while
    /// the machine could not start another one.
    static bool MemoryShort()
    {
        return ShortHook != 0 && Sys.Call(ShortHook, 0, 0, 0) != 0;
    }

    /// A chunk given back, with every walk that might be about to step onto
    /// it moved past first. The heap lock is held and nothing is marking.
    static void ReleaseChunk(nuint chunk)
    {
        if (_sweepAt == chunk) _sweepAt = HeapChunks.Next(chunk);
        if (_recycleNext == chunk) _recycleNext = HeapChunks.Next(chunk);
        if (_recycle == chunk) _recycle = 0;
        HeapChunks.Release(chunk);
    }

    /// Every pooled page given back, for a caller outside the collector (the
    /// kernel, when memory is short): DrainPool under the heap lock. Answers
    /// how many pages went; none while a collection runs.
    public static long GiveBackPool()
    {
        if (!_ready)
        {
            return 0;
        }
        GcLock.Enter();
        long before = PagesReleased;
        DrainPool();
        long given = PagesReleased - before;
        GcLock.Exit();
        return given;
    }

    /// Every pooled page given back to the operating system: the room a cap
    /// leaves is wanted for something else. Never while a collection runs --
    /// the marker's snapshot names these chunks. The heap lock is held.
    public static bool DrainPool()
    {
        if (_collecting || Runtime.Marking != 0)
        {
            return false;
        }
        bool drained = false;
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            while (Sys.ReadAddress(h + HeapPoolAt) != 0)
            {
                nuint page = Sys.ReadAddress(h + HeapPoolAt);
                Sys.WriteAddress(h + HeapPoolAt, HeapChunks.PageNext(page));
                HeapChunks.SetPageNext(page, 0);
                ReleaseChunk(page);
                PagesReleased = PagesReleased + 1;
                drained = true;
            }
            Sys.WriteAddress(h + HeapPoolBytesAt, 0);
        }
        return drained;
    }

    /// A HEAP STILL SMALL TAKES SMALL PAGES, DOUBLING. A thread holds a page
    /// of every class it uses, and a page of the batch is 32 KB: a driver
    /// module's heap that touched fifteen classes held half a megabyte for a
    /// few kilobytes live. Until it holds SmallHeapBytes, a heap other than
    /// the first takes a page of a class it holds none of
    /// (HeapClassCountAt) of SmallPageBytes, one mapping, and each page more
    /// of it twice the last, to the batch's: a class it allocates in steadily
    /// is on the batch's pages after three refills, so that a refill comes as
    /// seldom as it did (a gate's heap made a hundred thousand strings with
    /// eight times the refills on small pages alone), and as its pages are
    /// retired its next ones are small again.
    const int SmallPageBytes = 4096;
    const int SmallHeapBytes = 262144;

    static nuint SmallPageFor(nuint c)
    {
        if (_h == _heap0 || Sys.ReadAddress(_h + HeapBytesAt) >= SmallHeapBytes) return 0;
        nuint held = Sys.ReadAddress(_h + HeapClassCountAt + c * WordSize.Bytes);
        if (held >= 8) return 0;
        nuint bytes = (nuint)SmallPageBytes << (int)held;
        return bytes < HeapChunks.BatchBytes() ? bytes : 0;
    }

    /// A page of class `c` taken for heap `h` (1) or retired (-1).
    static void CountClassPage(nuint h, nuint c, int by)
    {
        if (h == 0 || c >= Classes) return;
        nuint at = h + HeapClassCountAt + c * WordSize.Bytes;
        Sys.WriteAddress(at, Sys.ReadAddress(at) + (nuint)by);
    }

    /// Pages mapped a batch at a time: one answered, the rest pooled. A
    /// page a time was a mapping and an index insert each, for tens of
    /// thousands of them.
    const int PageBatch = 32;
    static nuint _batchTaken;       // a word for TakePages to answer in

    static nuint TakeBatch()
    {
        if (_batchTaken == 0) _batchTaken = _classSize + 250 * WordSize.Bytes;
        nuint first = HeapChunks.TakePages(PageBatch, _batchTaken);
        nuint n = Sys.ReadAddress(_batchTaken);
        if (first == 0 || n == 0)
        {
            return 0;
        }
        // The rest of the batch is made a page at a time as it is asked
        // for (HeapChunks.TakeFresh), never pooled untouched.
        PagesTaken = PagesTaken + (long)n;
        return first;
    }

    static nuint PopPool(nuint c)
    {
        nuint page = _pool;
        if (page == 0)
        {
            return 0;
        }
        _pool = HeapChunks.PageNext(page);
        HeapChunks.SetPageNext(page, 0);
        _poolBytes = _poolBytes - HeapChunks.PageSize(page);
        // A page never formatted is as the operating system gave it: zero.
        if (HeapChunks.End(page) != HeapChunks.First(page))
        {
            // Only what was laid out was ever written (FormatPage).
            ZeroWords(HeapChunks.First(page), HeapChunks.End(page));
        }
        FormatPage(page, c);
        return page;
    }

    /// Free blocks of `size` laid from `from` up to `stop` (one block at
    /// least, none past the page's limit), linked in address order, the last
    /// to nothing, and End moved past them. How many.
    static nuint LayOut(nuint page, nuint from, nuint size, nuint stop)
    {
        nuint limit = HeapChunks.PageBlockLimit(page);
        nuint n = 0;
        nuint block = from;
        while (block + size <= limit && (n == 0 || block + size <= stop))
        {
            n = n + 1;
            block = block + size;
        }
        block = from;
        for (nuint i = 0; i < n; i++)
        {
            StampClass(block, size, FlagFree);
            Sys.WriteAddress(block + KindAt, i + 1 < n ? block + size : 0);
            block = block + size;
        }
        HeapChunks.SetEnd(page, block);
        return n;
    }

    const int LayOutBytes = 4096;

    /// More of a page laid out, when its list has run dry: the head of the
    /// new blocks, or 0 when the page is laid out to its limit.
    ///
    /// FOR A THREAD THAT USED ITS LIST UP (`doubling`, ClassRefill), AS MUCH
    /// AGAIN AS IS LAID OUT ALREADY, to the next 4 KB boundary: a page whose
    /// blocks were used up is of a class its thread is making many of.
    /// Another 4 KB a time, a class of half a kilobyte or more came back to
    /// the heap lock every few objects -- four in five of a list-building
    /// loop's slow paths were this -- and doubling still leaves a thread no
    /// more laid out and unused than it has used. For one block (TakeLarger,
    /// RetireClasses), the next 4 KB: what nobody asked for stays untouched.
    static nuint FormatMore(nuint page, nuint c, bool doubling)
    {
        nuint size = ClassSize(c);
        nuint end = HeapChunks.End(page);
        if (end + size > HeapChunks.PageBlockLimit(page)) return 0;
        nuint laid = end - HeapChunks.First(page);
        nuint step = doubling && laid > LayOutBytes ? laid : LayOutBytes;
        nuint stop = (end + step) & ~(nuint)(LayOutBytes - 1);
        return LayOut(page, end, size, stop) != 0 ? end : 0;
    }

    /// This thread's cache of class `c` given free blocks: what other
    /// threads freed into its page, else another page -- one with room,
    /// a pooled one, a new one. False when none can be had. The heap lock
    /// is held.
    static bool ClassRefill(nuint tb, nuint c)
    {
        ClassRefills = ClassRefills + 1;
        nuint cache = EnsureCache(tb);
        if (cache == 0)
        {
            return false;
        }
        nuint slot = cache + c * (2 * WordSize.Bytes);
        nuint page = Sys.ReadAddress(slot);
        if (page != 0)
        {
            nuint returned = HeapChunks.PageFree(page);
            if (returned != 0)
            {
                HeapChunks.SetPageFree(page, 0);
                Charge(tb, HeapChunks.LargestHole(page));
                HeapChunks.SetLargestHole(page, 0);
                Sys.WriteAddress(slot + WordSize.Bytes, returned);
                return true;
            }
            // Its list dry: the next of its kilobytes laid out, while any
            // are left (FormatPage). WHILE STAMPING IS OPEN TOO: the blocks
            // have no start in the snapshot, and what is made in them is
            // written in by this thread's STAMP answer if it comes after,
            // and new and kept if it came before (StampedAlready). Given up
            // with its tail unlaid instead, a page went on no list, and
            // under a small cap, which stamps for much of its time, half of
            // an 8 MB heap was the tails of pages nobody could reach.
            nuint more = FormatMore(page, c, true);
            if (more != 0)
            {
                ClassLaidFurther = ClassLaidFurther + 1;
                Charge(tb, HeapChunks.End(page) - more);
                Sys.WriteAddress(slot + WordSize.Bytes, more);
                return true;
            }
            // Used up: nobody's, on no list, until a sweep finds room in it.
            // WHILE STAMPING IS OPEN, AND THIS THREAD HAS NOT ANSWERED, its
            // objects are written in first, as a retired buffer's are
            // (Retire): the snapshot stepped over it as this thread's, and
            // this thread's STAMP answer will look only at the pages it owns
            // then. Unstamped they were kept and never traced, and what only
            // they held was swept.
            if (_stamping && !StampedAlready(tb)) StampPage(page);
            HeapChunks.SetOwner(page, 0);
            Sys.WriteAddress(slot, 0);
            // Handed back by its owner, with counts the sweep never took (NoteUnowned).
            NoteUnownedPage(page);
        }
        page = Sys.ReadAddress(_classPages + c * WordSize.Bytes);
        if (page != 0)
        {
            UnlistPage(page);
            PagesRefilled = PagesRefilled + 1;
        }
        else
        {
            page = PopPool(c);
            if (page == 0)
            {
                nuint small = SmallPageFor(c);
                page = small != 0 ? HeapChunks.TakeOne(small) : 0;
                if (page == 0) page = HeapChunks.TakeFresh();
                if (page != 0) PagesTaken = PagesTaken + 1;
                else page = TakeBatch();
                if (page == 0)
                {
                    return false;
                }
                FormatPage(page, c);
            }
            CountClassPage(HeapOfChunk(page), c, 1);
        }
        nuint head = HeapChunks.PageFree(page);
        HeapChunks.SetPageFree(page, 0);
        HeapChunks.SetOwner(page, tb);
        HeapChunks.SetYoung(page, true);
        // CHARGED AS IT IS HANDED OVER, the whole list (Charge).
        Charge(tb, HeapChunks.LargestHole(page));
        HeapChunks.SetLargestHole(page, 0);
        Sys.WriteAddress(slot, page);
        Sys.WriteAddress(slot + WordSize.Bytes, head);
        return head != 0;
    }

    /// A THREAD'S LIST IS COUNTED AS IT IS HANDED OVER, every block on it,
    /// into the thread's pending count (Tls.ClassBytes, folded into the
    /// pressure counter by FoldClassBytes) -- not a block at a time as each
    /// is taken: the allocation compiled code makes in place (Runtime.
    /// AllocFast) is then a pop and a header, with no count to add to. What
    /// the thread hands back untaken goes off it again (RetireClasses); a
    /// block it frees onto its own list is still on a list it was charged
    /// for, and is neither counted again nor taken off. Charged a page at a
    /// time this was once a threshold's worth of pressure at once for a
    /// program touching a dozen classes -- when a threshold was 256 KB; a
    /// page's list is a sixteenth of the least nursery now. The bytes are a
    /// page's free bytes (LargestHole), kept as blocks go on and off its
    /// list, or what FormatMore just laid out. The heap lock is held.
    static void Charge(nuint tb, nuint bytes)
    {
        if (tb == 0 || bytes == 0) return;
        Sys.WriteAddress(tb + Tls.ClassBytes, Sys.ReadAddress(tb + Tls.ClassBytes) + bytes);
    }

    /// Every page a thread owns given up: what is left of each list goes
    /// back to its page, and a page with room goes on its class's list. The
    /// heap lock is held, and the thread is not in the allocator.
    public static void RetireClasses(nuint tb)
    {
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        RetireCache(tb, cache);
    }

    /// One of the thread's class caches -- the one in use, or one on its
    /// shelf (SwitchHeap) -- given back: its pages are nobody's again.
    static void RetireCache(nuint tb, nuint cache)
    {
        if (cache == 0 || _classSize == 0)
        {
            return;
        }
        NoteUnowned(cache);
        for (nuint c = 0; c < Classes; c++)
        {
            nuint slot = cache + c * (2 * WordSize.Bytes);
            nuint page = Sys.ReadAddress(slot);
            if (page == 0) continue;
            nuint head = Sys.ReadAddress(slot + WordSize.Bytes);
            if (head != 0)
            {
                // What the thread never took goes onto the page's bytes.
                nuint size = ClassSize(c);
                nuint unused = size;
                nuint tail = head;
                while (Sys.ReadAddress(tail + KindAt) != 0)
                {
                    tail = Sys.ReadAddress(tail + KindAt);
                    unused = unused + size;
                }
                Sys.WriteAddress(tail + KindAt, HeapChunks.PageFree(page));
                HeapChunks.SetPageFree(page, head);
                HeapChunks.SetLargestHole(page, HeapChunks.LargestHole(page) + unused);
                // Charged as the list was handed over (Charge), never taken:
                // off the pressure and off what the thread is said to have
                // allocated, where the charge was folded in already.
                Uncharge(tb, unused);
            }
            // A page given up with its list dry but not all laid out: more
            // laid out, so that it goes on its class's list and its room is
            // found (FormatPage). While stamping is open too, as in
            // ClassRefill: the blocks have no start in the snapshot.
            if (HeapChunks.PageFree(page) == 0)
            {
                nuint more = FormatMore(page, c, false);
                if (more != 0)
                {
                    HeapChunks.SetPageFree(page, more);
                    HeapChunks.SetLargestHole(page, HeapChunks.End(page) - more);
                }
            }
            HeapChunks.SetOwner(page, 0);
            Sys.WriteAddress(slot, 0);
            Sys.WriteAddress(slot + WordSize.Bytes, 0);
            if (HeapChunks.PageFree(page) != 0 && !HeapChunks.IsListed(page))
            {
                ListPage(page);
            }
        }
    }

    /// THREADS' HALF-EMPTY PAGES GIVEN BACK WHILE MEMORY IS SHORT
    /// (ShortHook), as a cycle ends (FinishCycle): a thread keeps a page of
    /// every class it has used, and a page another thread owns no sweep can
    /// empty or give back -- a 32 MB machine's GUI kernel held 52 pages,
    /// 1.7 MB, for 0.4 MB of objects. Given back, the pages go on their
    /// classes' lists, the next allocation of any thread fills them before a
    /// new one is made, and those the next sweep finds empty are pooled and
    /// released.
    ///
    /// ONLY BETWEEN CYCLES, AND ONLY A THREAD THE LAST ROUND TOOK THE CACHE
    /// OF: its Classes word is 0, so its next small allocation comes to the
    /// slow path, which waits for the heap lock this holds; and it is not in
    /// the allocator (InAlloc). Given back at a round's answer -- in the
    /// middle of a cycle -- a page the sweep had yet to reach was released
    /// twice, and the GUI kernel died sweeping a chunk whose header the
    /// first release had given back (Service.Unmap: "unmapping a linked heap
    /// chunk", a limit of 0). The heap lock is held.
    static void ShedPages()
    {
        if (ShortHook == 0 || Sys.Call(ShortHook, 0, 0, 0) == 0) return;
        nuint self = Sys.ThreadBlock();
        nuint count = GcThreads.Count();
        for (nuint i = 0; i < count; i++)
        {
            nuint tb = GcThreads.BlockAt(i);
            // ONLY A THREAD THAT IS BLOCKED (Tls.State): a running one may
            // have read its class cache just before a handshake took it, and
            // be about to pop off it (AllocWord, Runtime.AllocFast) -- its
            // InAlloc not yet set, and its pages not to be given up then.
            if (tb == 0 || tb == self || Sys.ReadAddress(tb + Tls.InAlloc) != 0 || Sys.ReadAddress(tb + Tls.State) == 0) continue;
            if (Sys.ReadAddress(tb + Tls.Classes) != 0 || Sys.ReadAddress(tb + Tls.ClassesSaved) == 0) continue;
            RetireClasses(tb);
            PagesShed = PagesShed + 1;
        }
    }

    /// Threads' pages given back by ShedPages.
    public static long PagesShed;

    // PAGES AND BUFFERS OF A HEAP NOT THE FIRST, HANDED BACK BY A THREAD
    // (RetireCache, ClassRefill's page used up, Retire): a page a thread's
    // cache owns, and a buffer it bumps in, is never swept while it does, so
    // what the last sweep counted live there is from before -- nothing, for a
    // page or a chunk taken fresh. Handed back after the last major sweep
    // began, its counts are stale until a sweep counts them again, and
    // ReleaseHeap must not judge the heap by them. Found by reading, after a
    // kernel unloading its NT module unmapped a page of the NT heap holding a
    // string the kernel still held: a thread handing back NT pages after
    // ReleaseHeap's collection -- an NT thread ending, or one filling a page
    // in an NT gate -- leaves exactly that. The first heap's are not
    // counted: it is never released, and its threads hand pages back all the
    // time. The heap lock is held at every count.
    static long _unowned;
    static long _unownedAtMajorSweep;

    static void NoteUnownedPage(nuint page)
    {
        if (page != 0 && _heapCount > 1 && HeapOfChunk(page) != _heap0) _unowned = _unowned + 1;
    }

    static void NoteUnowned(nuint cache)
    {
        if (_heapCount <= 1) return;
        for (nuint c = 0; c < Classes; c++)
        {
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            if (page != 0 && HeapOfChunk(page) != _heap0) { _unowned = _unowned + 1; return; }
        }
    }

    /// A thread that is going: its pages given up and its cache unmapped.
    public static void ForgetClasses(nuint tb)
    {
        // ITS PAGES STAMPED FIRST while it still owes STAMP, as its buffer is
        // (Retire): the snapshot stepped over them as this thread's, and
        // once given up nobody's answer looks in them.
        if (_stamping && !StampedAlready(tb)) StampPages(tb);
        RetireClasses(tb);
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        Sys.WriteAddress(tb + Tls.Classes, 0);
        Sys.WriteAddress(tb + Tls.ClassesSaved, 0);
        if (cache != 0) Platform.Unmap(cache, 4096);
        // AND THE ONES ON ITS SHELF, the heaps it had been in.
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);
        if (shelf != 0)
        {
            for (nuint h = 0; h < ShelfUsed; h++)
            {
                nuint parked = Sys.ReadAddress(shelf + h * WordSize.Bytes);
                if (parked == 0) continue;
                RetireCache(tb, parked);
                Platform.Unmap(parked, 4096);
            }
            Sys.WriteAddress(tb + Tls.Shelf, 0);
            Platform.Unmap(shelf, ShelfBytes);
        }
    }

    /// A block of a page freed by hand: cleared, marked free, and onto the
    /// freeing thread's own list when the page is its own, else onto the
    /// page's. The heap lock is held and no collection is under way.
    static void ClassFree(nuint page, nuint block, nuint size, nuint tb)
    {
        NoteFreed(block, 2);
        if (_heapCheck) Forget(block);
        ZeroWords(block + HeaderBytes, block + size);
        StampClass(block, size, FlagFree);
        nuint owner = HeapChunks.Owner(page);
        nuint cache = tb != 0 ? Sys.ReadAddress(tb + Tls.Classes) : 0;
        if (cache == 0 && tb != 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        nuint slot = cache + (HeapChunks.PageClass(page) - 1) * (2 * WordSize.Bytes);
        // ONTO THE THREAD'S OWN LIST, a list it was charged for (Charge):
        // a block made and freed in a loop is no pressure past that once.
        if (owner != 0 && owner == tb && cache != 0 && Sys.ReadAddress(slot) == page)
        {
            Sys.WriteAddress(block + KindAt, Sys.ReadAddress(slot + WordSize.Bytes));
            Sys.WriteAddress(slot + WordSize.Bytes, block);
            return;
        }
        // Onto the page's, and off the freeing thread's count as well: the
        // block's allocation is most likely still in that count, not yet
        // folded, and taken off the pressure counter first it was lost to
        // the counter's floor of zero -- a program freeing everything it
        // made collected every few hundred kilobytes.
        Uncount(tb, size);
        HeapChunks.SetLargestHole(page, HeapChunks.LargestHole(page) + size);
        Sys.WriteAddress(block + KindAt, HeapChunks.PageFree(page));
        HeapChunks.SetPageFree(page, block);
        if (owner == 0 && !HeapChunks.IsListed(page))
        {
            ListPage(page);
        }
    }

    /// A small block freed, off the pressure it was counted as: off the
    /// thread's unfolded count as far as that goes, the rest off the
    /// pressure counter. The count is NEVER NEGATIVE: a word, read back on
    /// a 32-bit processor it is unsigned, and a count of minus a kilobyte
    /// folded in as four gigabytes of pressure -- a collection every few
    /// allocations. The heap lock is held.
    static void Uncount(nuint tb, nuint size)
    {
        // A count that may be below nought (Tls.ClassBytes): read signed.
        long pending = tb != 0 ? SignedWord(tb + Tls.ClassBytes) : 0;
        long bytes = (long)size;
        long off = pending < bytes ? pending : bytes;
        if (off > 0)
        {
            Sys.WriteAddress(tb + Tls.ClassBytes, (nuint)(pending - off));
        }
        if (bytes > off)
        {
            _since = _since - (bytes - off);
            if (_since < 0) _since = 0;
        }
    }

    /// A list's bytes charged (Charge) and handed back untaken: off the
    /// thread's pending count as far as that goes, the rest off the pressure
    /// counter and off the allocated counts it was folded into (Count). The
    /// heap lock is held.
    static void Uncharge(nuint tb, nuint size)
    {
        long pending = tb != 0 ? SignedWord(tb + Tls.ClassBytes) : 0;
        long bytes = (long)size;
        long off = pending < bytes ? pending : bytes;
        if (off > 0) Sys.WriteAddress(tb + Tls.ClassBytes, (nuint)(pending - off));
        long rest = bytes - off;
        if (rest <= 0) return;
        _since = _since - rest;
        if (_since < 0) _since = 0;
        Count(tb, -rest);
    }

    /// This thread's small allocations counted into the pressure counter
    /// and its allocated bytes. The heap lock is held.
    /// A signed count kept in a word slot, as its two's complement (Tls.ClassBytes
    /// goes below nought): the word read at its own width, sign and all.
    static long SignedWord(nuint at)
    {
#if TARGET_64BIT
        return (long)Sys.ReadAddress(at);
#else
        return (int)Sys.ReadAddress(at);
#endif
    }

    static void FoldClassBytes(nuint tb)
    {
        long bytes = SignedWord(tb + Tls.ClassBytes);
        if (bytes == 0)
        {
            return;
        }
        Sys.WriteAddress(tb + Tls.ClassBytes, 0);
        _since = _since + bytes;
        Count(tb, bytes);
    }

    /// One block off a class cache's list, stamped as an object of `kind`.
    /// 0 when the list is empty.
    static nuint PopClass(nuint slot, nuint c, nuint kind)
    {
        nuint block = Sys.ReadAddress(slot + WordSize.Bytes);
        if (block == 0)
        {
            return 0;
        }
        nuint size = ClassSize(c);
        if (_heapCheck) CheckOutsideBuffer(block, block + size, "gc owner check: a class block inside the live buffer");
        Sys.WriteAddress(slot + WordSize.Bytes, Sys.ReadAddress(block + KindAt));
        Sys.WriteAddress(block, size);
        Sys.WriteAddress(block + KindAt, kind);
        if (_heapCheck) { CheckMade(block, "PopClass", 0); CheckList(Sys.ReadAddress(slot + WordSize.Bytes), size, "PopClass"); }
        return block + HeaderBytes;
    }

    /// A block just handed out: its header and footer agree, or it is said
    /// with the call trace (the heap check).
    // THE LAST BLOCKS HANDED OUT (4096 of them, a slice read each time), each with the three calls that asked for
    // it, read again at every allocation after: a footer that was right when
    // the block was made and is not now was overwritten in between, and the
    // allocation that finds it is a few steps after whatever did it.
    const int RecentBlocks = 4096;
    const int RecentSlice = 64;
    static nuint _recentCheck;
    const int RecentWords = 7;             // block, three callers, path, serial, the allocating thread's block
    public static long AllocSerial;
    static nuint _recent;
    static nuint _recentAt;
    static long _recentReports;

    // THE RING BY ADDRESS: a remembered block freed is forgotten there and
    // then (Forget, from every way a block is freed), not left to be read
    // again once its bytes are a free run or a bigger block's contents. One
    // slot per hash; a collision only loses the older entry's recheck.
    const int RecentIndexSlots = 8192;
    static nuint _recentIndex;

    static nuint RecentSlot(nuint block)
    {
        return _recentIndex + ((block >> 3) & (RecentIndexSlots - 1)) * WordSize.Bytes;
    }

    /// A block freed: out of the recent ring, if it is there.
    static void Forget(nuint block)
    {
        if (_recentIndex == 0) return;
        nuint slot = RecentSlot(block);
        nuint e = Sys.ReadAddress(slot);
        if (e != 0 && Sys.ReadAddress(e) == block) Sys.WriteAddress(e, 0);
    }

    static void Remember(nuint block, int path)
    {
        if (_recent == 0)
        {
            // The ring and, after it, the word its entries are claimed from.
            _recent = Platform.Map(RecentBlocks * RecentWords * WordSize.Bytes + WordSize.Bytes);
            if (_recent == 0) return;
            _recentIndex = Platform.Map(RecentIndexSlots * WordSize.Bytes);
        }
        const int w = WordSize.Bytes;
        // ONE ENTRY PER ALLOCATION ON EVERY PROCESSOR: claimed atomically, and
        // its block written last, so a reader never takes a half-made entry
        // for a block.
        nuint claimed = Sys.AtomicAdd(_recent + RecentBlocks * RecentWords * w, 1u);
        nuint e = _recent + (claimed % RecentBlocks) * RecentWords * w;
        _recentAt = claimed + 1;
        Sys.WriteAddress(e, 0);
        Sys.WriteAddress(e + 6 * w, Sys.ThreadBlock());
        nuint fp = Sys.FramePointer();
        // Past Remember's callers inside the collector (CheckMade, the
        // allocator, Runtime's entry) to the code that asked for the block.
        for (int skip = 0; skip < 3 && fp != 0; skip++)
        {
            nuint next = Sys.ReadAddress(fp);
            fp = next > fp ? next : 0;
        }
        Sys.WriteAddress(e + 4 * w, (nuint)path);
        AllocSerial = AllocSerial + 1;
        Sys.WriteAddress(e + 5 * w, (nuint)AllocSerial);
        for (nuint i = 1; i < 4; i++)
        {
            nuint back = 0;
            if (fp != 0)
            {
                back = Sys.ReadAddress(fp + w);
                nuint next = Sys.ReadAddress(fp);
                fp = next > fp ? next : 0;
            }
            Sys.WriteAddress(e + i * w, back);
        }
        Sys.WriteAddress(e, block);
        if (_recentIndex != 0)
        {
            // ONE SLOT PER HASH, AND A COLLISION LOSES THE OLDER ENTRY'S
            // RECHECK, as the ring says: dropped here, not left behind. Kept,
            // it could no longer be forgotten (Forget finds entries by their
            // slot), its block freed and made again under it, and read in
            // the moment another allocation had made it and not yet painted
            // its guard -- "zeroed whole by a writer", of nothing written.
            nuint slot = RecentSlot(block);
            nuint older = Sys.ReadAddress(slot);
            if (older != 0 && older != e && Sys.ReadAddress(older) != 0 && Sys.ReadAddress(older) != block && RecentSlot(Sys.ReadAddress(older)) == slot) Sys.WriteAddress(older, 0);
            Sys.WriteAddress(slot, e);
        }
    }

    /// Whether a block still starts at `block`: on its class's grid in a
    /// class page, or where a walk from the chunk's nearest start anchor
    /// lands. A walk that meets a broken size first cannot say, and answers
    /// yes, so damage below is never taken for a stale entry.
    static bool StillBlockStart(nuint block)
    {
        nuint chunk = HeapChunks.Of(block);
        if (chunk == 0) return false;
        nuint first = HeapChunks.First(chunk);
        if (block < first || block >= HeapChunks.End(chunk)) return false;
        nuint c = HeapChunks.PageClass(chunk);
        if (c != 0) return OnGrid(block - first, c - 1);
        nuint at = HeapChunks.MarkStart(chunk, block + HeaderBytes);
        nuint end = HeapChunks.End(chunk);
        for (long n = 0; at < block && n < 100000; n++)
        {
            nuint size = Sys.ReadAddress(at) & SizeMask;
            if (size < LeastBlock || Beyond(at, size, end) || Sys.ReadAddress(at + size - FooterBytes) != Sys.ReadAddress(at)) return true;
            at = at + size;
        }
        return at == block;
    }

    /// `making`: the block being handed out as this runs (CheckMade), which
    /// is no block to read yet -- its header says live, its guard is not
    /// painted until its allocation returns (AllocKind) -- and which an
    /// entry the ring could not forget may still name: an earlier block at
    /// the same address, freed while its hash slot was a later block's
    /// (Forget). Read then, it was "zeroed whole by a writer" on every
    /// allocation of a program that freed and made the same block again.
    static void CheckRecent(nuint making)
    {
        if (_recent == 0 || _recentReports >= 12) return;
        const int w = WordSize.Bytes;
        nuint n = _recentAt < RecentBlocks ? _recentAt : RecentBlocks;
        if (n == 0) return;
        // A slice at a time, so every remembered block is read again every
        // RecentBlocks / RecentSlice allocations.
        for (int j = 0; j < RecentSlice; j++)
        {
            nuint k = _recentCheck % n;
            _recentCheck = _recentCheck + 1;
            nuint e = _recent + k * RecentWords * w;
            nuint block = Sys.ReadAddress(e);
            if (block == 0 || block == making) continue;
            // ONLY THIS THREAD'S: another's newest block may be being made on
            // another processor at this moment -- its header there, its guard
            // and footer not yet -- and it is that thread's own recheck that
            // reads it, once it is whole.
            if (Sys.ReadAddress(e + 6 * w) != Sys.ThreadBlock()) continue;
            // Its chunk given back since -- the sweep found nothing live in
            // it -- and its memory with it: nothing there to read.
            if (HeapChunks.Of(block) == 0) { Sys.WriteAddress(e, 0); continue; }
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            // Freed since, or taken again: no longer the block it was.
            if ((word & FlagFree) != 0 || size < LeastBlock || size > 65536) { Sys.WriteAddress(e, 0); continue; }
            // Or no block starts there any more: freed, folded into a free
            // run and handed out again inside a bigger block, whose contents
            // may look like a header at the old address.
            if (!StillBlockStart(block)) { Sys.WriteAddress(e, 0); continue; }
            CheckGuard(block, "the recheck of recent blocks");
            // A BLOCK OF A PAGE HAS NO FOOTER: what a write past its end
            // reaches first is the next slot's header, which keeps the
            // class's size whatever else happens to it -- made, freed,
            // marked. Paths 1, 3 and 5 hand out a page's block (Remember).
            nuint path = Sys.ReadAddress(e + 4 * w);
            bool paged = path == 1 || path == 3 || path == 5;
            nuint watched = paged ? block + size : block + size - FooterBytes;
            nuint foot = Sys.ReadAddress(watched);
            if (paged)
            {
                nuint home = HeapChunks.Of(block);
                if (home == 0 || watched >= HeapChunks.End(home) || (foot & SizeMask) == size) continue;
            }
            else if (foot == word) continue;
            // SWEPT, AND FOLDED INTO A DEAD RUN that ends where it ended: the
            // run's footer is its footer now, and the run's header -- read back
            // through that footer's size -- says the same. Forget missed it:
            // its hash slot had gone to a block remembered later.
            else if ((foot & FlagFree) != 0 && (foot & SizeMask) >= size
                && HeapChunks.Of(watched + FooterBytes - (foot & SizeMask)) == HeapChunks.Of(block)
                && Sys.ReadAddress(watched + FooterBytes - (foot & SizeMask)) == foot) { Sys.WriteAddress(e, 0); continue; }
            _recentReports = _recentReports + 1;
            SayNumber(paged ? "gc owner check: the next slot's header overwritten after it was made, block "
                : "gc owner check: a footer overwritten after it was made, block ", block);
            SayNumber("gc owner check:   header ", word);
            SayNumber(paged ? "gc owner check:   next header now " : "gc owner check:   footer now ", foot);
            SayNumber("gc owner check:   made by ", Sys.ReadAddress(e + w));
            SayNumber("gc owner check:   and ", Sys.ReadAddress(e + 2 * w));
            SayNumber("gc owner check:   and ", Sys.ReadAddress(e + 3 * w));
            SayNumber("gc owner check:   made by path (1 class fast, 2 bump, 3 PopClass, 4 class fallback, 5 a bigger class's slot) ", path);
            SayNumber("gc owner check:   its allocation number ", Sys.ReadAddress(e + 5 * w));
            SayNumber("gc owner check:   allocations made now ", AllocSerial);
            SayPage(block);
            SayJournal(watched);
            if (OverwriteHook != 0) Sys.Call(OverwriteHook, block, size, 0);
            Runtime.WriteLiteral(2, "gc owner check:   found at:\n");
            Runtime.SayTrace(2, Sys.FramePointer());
            Sys.WriteAddress(e, 0);
        }
    }

    // A CLASS'S FREE LIST WALKED after each block taken from it, while the
    // heap check is on: every node must be a free block of that class's
    // size in a page of that class. A node that is not -- a live object on
    // the list -- is the block that will be handed out a second time.
    static long _listReports;

    static void CheckList(nuint head, nuint size, string how)
    {
        if (_listReports >= 12) return;
        nuint node = head;
        for (long n = 0; node != 0 && n < 256; n++)
        {
            nuint word = Sys.ReadAddress(node);
            // No footer to agree (a page's block has none): free, and the class's size.
            if ((word & FlagFree) == 0 || (word & SizeMask) != size)
            {
                _listReports = _listReports + 1;
                Runtime.WriteLiteral(2, "gc owner check: a class list holds a block that is not free, by the ");
                Runtime.WriteLiteral(2, how);
                SayNumber(" -- node ", node);
                SayNumber("gc owner check:   its header ", word);
                SayNumber("gc owner check:   class size ", size);
                SayNumber("gc owner check:   place in the list ", n);
                Runtime.SayTrace(2, Sys.FramePointer());
                return;
            }
            node = Sys.ReadAddress(node + KindAt);
        }
    }

    /// Called with the footer of each block of WatchSize made while the heap
    /// check is on, when set -- for a page's block, which has none, the next
    /// slot's header, the word a write past its end reaches first: a kernel
    /// points a debug register at it, so the write that later breaks it
    /// traps where it is made (GcWatchpoint).
    public static nuint WatchHook;
    public static nuint WatchSize;
    /// Called with each block whose footer the recheck finds overwritten:
    /// a kernel then watches that page's writes for the next time.
    public static nuint OverwriteHook;

    /// The page a block is in, as the collector sees it: its class, where
    /// its grid starts and is laid out to, and every grid slot's header.
    static void SayPage(nuint block)
    {
        nuint chunk = HeapChunks.Of(block);
        SayNumber("gc owner check:   chunk ", chunk);
        if (chunk == 0) return;
        nuint c = HeapChunks.PageClass(chunk);
        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        SayNumber("gc owner check:   its class ", c);
        SayNumber("gc owner check:   first ", first);
        SayNumber("gc owner check:   end ", end);
        SayNumber("gc owner check:   owner ", HeapChunks.Owner(chunk));
        if (c <= 1) return;
        nuint size = ClassSize(c - 1);
        SayNumber("gc owner check:   grid ", size);
        SayNumber("gc owner check:   block's offset from first ", block - first);
        for (nuint b = first; b + size <= end && b < first + 64 * size; b = b + size)
        {
            SayNumber("gc owner check:     slot header ", Sys.ReadAddress(b));
        }
    }

    /// `tail`: what follows its payload, nothing for a page's block
    /// (TailIn). A page's block has no footer to be wrong; what is watched
    /// for it is the word a write past its end reaches first, the next
    /// slot's header (FooterBroken).
    static void CheckMade(nuint block, string how, nuint tail)
    {
        CheckRecent(block);
        Remember(block, how == "class fast path" ? 1 : how == "bump fast path" ? 2 : how == "PopClass" ? 3 : how == "a bigger class's slot" ? 5 : 4);
        if (WatchHook != 0 && (Sys.ReadAddress(block) & SizeMask) == WatchSize)
        {
            Sys.Call(WatchHook, block + WatchSize - tail, 0, 0);
        }
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        if (size >= LeastBlock && (tail == 0 || Sys.ReadAddress(block + size - FooterBytes) == word)) return;
        Runtime.WriteLiteral(2, "gc owner check: handed out with its footer wrong by the ");
        Runtime.WriteLiteral(2, how);
        SayNumber(" -- block ", block);
        SayNumber("gc owner check:   header ", word);
        SayNumber("gc owner check:   footer ", size >= LeastBlock && tail != 0 ? Sys.ReadAddress(block + size - FooterBytes) : 0);
        Runtime.SayTrace(2, Sys.FramePointer());
    }

    /// The objects in the pages a thread owns written into the snapshot, as
    /// StampBuffer writes a buffer's.
    static void StampPages(nuint tb)
    {
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        StampCache(cache);
        // THE SHELF'S TOO: a cache made from since the snapshot and then
        // shelved at a gate holds what the thread made before it answered.
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);
        if (shelf == 0) return;
        for (nuint h = 0; h < ShelfUsed; h++)
        {
            StampCache(Sys.ReadAddress(shelf + h * WordSize.Bytes));
        }
    }

    static void StampCache(nuint cache)
    {
        if (cache == 0) return;
        for (nuint c = 0; c < Classes; c++)
        {
            StampPage(Sys.ReadAddress(cache + c * (2 * WordSize.Bytes)));
        }
    }

    // A THREAD'S PAGES IN STEPS: its own cache, then its shelf's, a page at
    // a time, from where the last step left -- the collector's own in its
    // stop (nothing of the program runs on it meanwhile), and a blocked
    // thread's that the collector answers STAMP for (GcThreads.Work). That
    // thread is given back between steps and claimed again. Its caches
    // stand still when the steps go on: it can leave its blocking only by
    // answering (EndBlocking), and the steps end if it has answered, is
    // claimed by another, or was moved to another stack (MoveStack).
    static nuint _selfShelf, _selfClass;

    public static void BeginSelfStamp()
    {
        // Its own cache first (NoHeap), then the shelf's from 0: the step
        // after NoHeap is 0.
        _selfShelf = NoHeap;
        _selfClass = 0;
    }

    /// StampPages(tb), on from where it was, until `budget` pages are done
    /// (-1: all): true when all are.
    public static bool StampPagesSome(nuint tb, long budget)
    {
        long work = 0;
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);
        while (true)
        {
            nuint cache;
            if (_selfShelf == NoHeap)
            {
                cache = Sys.ReadAddress(tb + Tls.Classes);
                if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
            }
            else if (shelf == 0 || _selfShelf >= ShelfUsed) return true;
            else cache = Sys.ReadAddress(shelf + _selfShelf * WordSize.Bytes);
            while (cache != 0 && _selfClass < Classes)
            {
                if (budget >= 0 && work >= budget) return false;
                StampPage(Sys.ReadAddress(cache + _selfClass * (2 * WordSize.Bytes)));
                _selfClass = _selfClass + 1;
                work = work + 1;
            }
            _selfShelf = _selfShelf + 1;
            _selfClass = 0;
        }
    }

    /// WHETHER THREAD `tb` HAS ANSWERED THIS CYCLE'S STAMP: the round is
    /// the open one and its epoch is the round's. What it made before it
    /// answered, its answer wrote in; what it has made since is new, and
    /// must NOT be written in. Written in, an object made after the answer
    /// is one the marker looks for and must find -- and nothing need lead
    /// to it: a string held only by an array just made, whose elements are
    /// stored with no barrier, would never be marked, and would be swept
    /// from under the array. Laid out while stamping, a page holds more of
    /// what its thread made after answering when it is given up. Before
    /// the round is asked, nobody has answered it. The heap lock is held.
    static bool StampedAlready(nuint tb)
    {
        nuint ctl = GcLock.Words();
        return Sys.ReadAddress(ctl + GcLock.Request) == GcThreads.Stamp
            && Sys.ReadAddress(tb + Tls.Epoch) == Sys.ReadAddress(ctl + GcLock.Epoch);
    }

    /// WHETHER THREAD `tb` STILL OWES THIS CYCLE'S STAMP: stamping is open
    /// and it has not answered. The heap lock is held.
    static bool OwesStamp(nuint tb)
    {
        return _stamping && !StampedAlready(tb);
    }

    /// A block thread `tb` was just handed from memory nobody owns -- a
    /// bigger class's slot, the mixed heap's free blocks or bump space --
    /// written into the snapshot when the thread still owes STAMP, as its
    /// own buffer's and pages' objects are by its answer (StampBuffer). Made
    /// before the answer and left out, it was a newcomer: kept and never
    /// traced, while what it held came from a stack not yet scanned -- a
    /// string stored into an array just made, with no barrier, and then
    /// dropped from the stack, was swept from under the array. Outside a
    /// stop, a block of a chunk the snapshot did not walk is left alone:
    /// that chunk holds only newcomers. Inside one, every block is listed
    /// as well (NoteStopBlock). The heap lock is held.
    static void StampHandedOut(nuint tb, nuint block, nuint chunk)
    {
        if (!OwesStamp(tb)) return;
        if (_stopOpen) StopBlocks = StopBlocks + 1;
        if (chunk == 0) chunk = HeapChunks.OfSnapshot(block);
        // One of a snapshot chunk the stop's walk has not reached: the chunk
        // walked first (EnsureWalked).
        if (chunk != 0) EnsureWalked(chunk, block);
        // EVERY BLOCK HANDED OUT MID-STOP IS LISTED, and at step 3 marked and
        // read as roots (ScanStopBlocks): made while the collection runs, it
        // is live for it -- allocated black. Given only its start bit, as a
        // block made before its thread answers is after the stop, it was a
        // snapshot object traced only through what reached it, and the
        // verifier (Corsac.GC.Verify) found reachable young objects left
        // unmarked whenever stops ran long with blocks handed out singly:
        // about twenty a run of 2435, none with the blocks listed. A block
        // no start table of this cycle holds -- a chunk mapped since the
        // snapshot, an old chunk a minor cycle does not walk -- is listed
        // the same way, and AnswerBeforeTaking, which keeps such space out
        // before an answer, does not wait mid-stop.
        // A page's block by the chunk it lies in, not its snapshot chunk:
        // one mapped since the snapshot has none, and its blocks, read as
        // having a footer, were scanned a word short.
        if (_stopOpen) NoteStopBlock(block, TailOf(block) == 0);
        if (chunk == 0 || HeapChunks.StartsCycle(chunk) != _cycle) return;
        HeapChunks.SetStartShared(chunk, block);
    }

    /// One owned page's objects written into the snapshot (StampPages).
    static void StampPage(nuint page)
    {
        {
            // A page given up mid-stop whose chunk the walk has not reached:
            // walked first, or its stamps would be cleared by the walk after.
            EnsureWalked(page);
            if (page == 0 || HeapChunks.StartsCycle(page) != _cycle) return;
            nuint at = HeapChunks.First(page);
            nuint end = HeapChunks.End(page);
            while (at < end)
            {
                nuint word = Sys.ReadAddress(at);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(at, size, end)) break;
                if ((word & FlagFree) == 0)
                {
                    HeapChunks.SetStartShared(page, at);
                    if (_generational && !_minor && (word & (FlagMark | FlagScan)) != 0)
                    {
                        StampClass(at, size, word & FlagMask & ~(nuint)(FlagMark | FlagScan));
                    }
                }
                at = at + size;
            }
        }
    }

    /// The marks this collection left in [at, end) of a page taken off,
    /// where the sweep will not: without generations only.
    static void UnmarkRange(nuint at, nuint end)
    {
        if (_generational) return;
        while (at < end)
        {
            nuint word = Sys.ReadAddress(at);
            nuint size = word & SizeMask;
            if (size < LeastBlock || Beyond(at, size, end)) return;
            if ((word & FlagFree) == 0 && (word & (FlagMark | FlagScan)) != 0)
            {
                StampClass(at, size, word & FlagMask & ~(nuint)(FlagMark | FlagScan));
            }
            at = at + size;
        }
    }

    static void UnmarkPages(nuint tb)
    {
        if (_generational) return;
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        UnmarkCache(cache);
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);
        if (shelf == 0) return;
        for (nuint h = 0; h < ShelfUsed; h++)
        {
            UnmarkCache(Sys.ReadAddress(shelf + h * WordSize.Bytes));
        }
    }

    static void UnmarkCache(nuint cache)
    {
        if (cache == 0) return;
        for (nuint c = 0; c < Classes; c++)
        {
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            if (page != 0) UnmarkRange(HeapChunks.First(page), HeapChunks.End(page));
        }
    }

    /// Adds the pages a thread owns to a capture table as spans to step over;
    /// answers the new count.
    public static nuint CapturePages(nuint tb, nuint table, nuint count, nuint capacity)
    {
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0) cache = Sys.ReadAddress(tb + Tls.ClassesSaved);
        count = CaptureCache(cache, table, count, capacity);
        // The shelf's pages are the thread's as much. Read without the
        // thread's say -- it shelves without the lock -- a cache on its way
        // between the shelf and the block may be missed: its pages are
        // owned, and the sweep keeps an owned page whole all the same.
        nuint shelf = Sys.ReadAddress(tb + Tls.Shelf);
        if (shelf == 0) return count;
        for (nuint h = 0; h < ShelfUsed; h++)
        {
            count = CaptureCache(Sys.ReadAddress(shelf + h * WordSize.Bytes), table, count, capacity);
        }
        return count;
    }

    static nuint CaptureCache(nuint cache, nuint table, nuint count, nuint capacity)
    {
        if (cache == 0) return count;
        for (nuint c = 0; c < Classes && count < capacity; c++)
        {
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            if (page == 0) continue;
            // Appended: the caller sorts the whole table once (CaptureBuffersInto).
            Sys.WriteAddress(table + count * (2 * WordSize.Bytes), HeapChunks.First(page));
            Sys.WriteAddress(table + count * (2 * WordSize.Bytes) + WordSize.Bytes, HeapChunks.End(page));
            count = count + 1;
        }
        return count;
    }

    /// Sweeps one size-class page. The heap lock is held (or the world is
    /// stopped). A page captured at BeginSweep, or owned since, is some
    /// thread's buffer and kept whole; a pooled one holds nothing.
    static void SweepPage(nuint page)
    {
        if (HeapChunks.IsPooled(page))
        {
            return;
        }
        // SWEPT ALREADY by the workers beside the collector (SweepPagesTogether):
        // what is left is this page's place on its class's lists, which only
        // one thread may change, and its counts.
        if (HeapChunks.IsSwept(page))
        {
            HeapChunks.SetSwept(page, false);
            _sweepLive = _sweepLive + (long)HeapChunks.LiveBlocks(page);
            _sweepLiveBytes = _sweepLiveBytes + (long)HeapChunks.LiveBytes(page);
            CollectedBytes = CollectedBytes + (long)HeapChunks.Owner(page);
            HeapChunks.SetOwner(page, 0);
            PlacePage(page, HeapChunks.LiveBlocks(page), HeapChunks.PageFree(page), HeapChunks.LargestHole(page),
                HeapChunks.End(page) - HeapChunks.First(page));
            return;
        }
        nuint first = HeapChunks.First(page);
        nuint end = HeapChunks.End(page);
        nuint step = GcThreads.BufferAtOrAbove(first);
        bool captured = step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == first;
        if (captured || HeapChunks.Owner(page) != 0)
        {
            OldCardsOfPage(page, 1);
            if (!captured) UnmarkRange(first, end);
            _sweepLive = _sweepLive + (long)HeapChunks.LiveBlocks(page);
            _sweepLiveBytes = _sweepLiveBytes + (long)(end - first);
            HeapChunks.SetYoung(page, true);
            return;
        }
        nuint size = ClassSize(HeapChunks.PageClass(page) - 1);
        nuint head = 0;
        nuint tail = 0;
        nuint live = 0;
        nuint liveBytes = 0;
        nuint freeBytes = 0;
        bool stillYoung = false;
        nuint block = first;
        nuint run = 0;           // the first of the dead blocks not yet cleared (ClearDeadRun)
        OldCardsOfPage(page, 0);
        while (block + size <= end)
        {
            nuint word = Sys.ReadAddress(block);
            if ((word & SizeMask) != size)
            {
                break;
            }
            SweepVisits = SweepVisits + 1;
            if (_heapCheck) CheckGuard(block, "a class page's sweep");
            if ((word & FlagFree) == 0 && ((word & FlagMark) != 0 || _concurrent && Newcomer(page, block, word)))
            {
                if (_verify && !_minor && (word & FlagMark) != 0)
                {
                    CheckDangling(block, size);
                }
                if (_census && !_minor)
                {
                    Census(block, size);
                }
                if (run != 0)
                {
                    ClearDeadRun(run, block, size);
                    if (tail == 0) head = run;
                    else Sys.WriteAddress(tail + KindAt, run);
                    tail = block - size;
                    freeBytes = freeBytes + (block - run);
                    run = 0;
                }
                // AN OLD BLOCK'S HEADER IS LEFT AS IT IS (SameHeader).
                if (_generational && (word & FlagMark) != 0)
                {
                    if (word != (size | FlagMark | FlagScan)) StampClass(block, size, FlagMark | FlagScan);
                    OldCardsOfBlock(block, size);
                }
                else
                {
                    if (word != size) StampClass(block, size, 0);
                    stillYoung = stillYoung || (word & FlagMark) == 0;
                }
                live = live + 1;
                liveBytes = liveBytes + size;
            }
            else
            {
                if ((word & FlagFree) == 0)
                {
                    CollectedBytes = CollectedBytes + (long)size;
                    if (AllocSamples.Tracking) AllocSamples.Collected(block + HeaderBytes);
                    if (_deadCensus)
                    {
                        if (_deadAt == 0)
                        {
                            _deadAt = Platform.Map(CensusSlots * CensusEntry);
                        }
                        CensusInto(_deadAt, block, size);
                    }
                    // Cleared with the dead blocks next to it (ClearDeadRun),
                    // but one at a time under the heap check, whose journal
                    // names each range cleared.
                    if (!_heapCheck)
                    {
                        if (run == 0) run = block;
                        block = block + size;
                        continue;
                    }
                    Forget(block);
                    ZeroWords(block + HeaderBytes, block + size);
                    StampClass(block, size, FlagFree);
                }
                if (run != 0)
                {
                    ClearDeadRun(run, block, size);
                    if (tail == 0) head = run;
                    else Sys.WriteAddress(tail + KindAt, run);
                    tail = block - size;
                    freeBytes = freeBytes + (block - run);
                    run = 0;
                }
                Sys.WriteAddress(block + KindAt, 0);
                if (tail == 0) head = block;
                else Sys.WriteAddress(tail + KindAt, block);
                tail = block;
                freeBytes = freeBytes + size;
            }
            block = block + size;
        }
        if (run != 0)
        {
            ClearDeadRun(run, block, size);
            if (tail == 0) head = run;
            else Sys.WriteAddress(tail + KindAt, run);
            freeBytes = freeBytes + (block - run);
        }
        HeapChunks.SetPageFree(page, head);
        HeapChunks.SetLive(page, live, liveBytes);
        HeapChunks.SetLargestHole(page, freeBytes);
        HeapChunks.SetYoung(page, stillYoung);
        _sweepLive = _sweepLive + (long)live;
        _sweepLiveBytes = _sweepLiveBytes + (long)liveBytes;
        PlacePage(page, live, head, freeBytes, end - first);
    }

    /// THE PAGE'S OWN PART OF ITS SWEEP, which any thread may do: each block
    /// stamped live or freed and zeroed, the free ones threaded into the
    /// page's own list, and the page's record written. Nothing shared is
    /// touched: the bytes the collector freed wait in the owner word, which
    /// is 0 on every page swept here, for the collector to count (SweepPage).
    /// Only with no checking, census or verifying asked for, which the
    /// collector's own sweep does.
    static void SweepPageAlone(nuint page)
    {
        // IN WORDS, as SnapshotPage is: the loop every block of every young
        // page goes through at every cycle, and in longs on a 32-bit
        // processor its sums and counts were an add and an adc each, held
        // in the frame for want of registers.
        nuint first = (nuint)HeapChunks.First(page);
        nuint end = (nuint)HeapChunks.End(page);
        nuint size = ClassSize(HeapChunks.PageClass(page) - 1);
        nuint oldHeader = size | (nuint)(FlagMark | FlagScan);
        const int kindAt = KindAt;
        nuint head = 0;
        nuint tail = 0;
        nuint live = 0;
        nuint liveBytes = 0;
        nuint freeBytes = 0;
        nuint collected = 0;
        bool stillYoung = false;
        bool generational = _generational;
        bool concurrent = _concurrent;
        nuint block = first;
        nuint run = 0;          // the first of the dead blocks not yet cleared (ClearDeadRun)
        OldCardsOfPage(page, 0);
        while (block + size <= end)
        {
            nuint word = Sys.ReadAddress(block);
            if ((word & ~(nuint)7) != size)
            {
                break;
            }
            bool marked = (word & FlagMark) != 0;
            bool free = (word & FlagFree) != 0;
            // NEWCOMER ASKED ONLY OF A CONCURRENT CYCLE, the one kind that has
            // any: asked of every dead block, it was a call of three 64-bit
            // arguments a block to answer false.
            bool alive = !free && (marked || concurrent && Newcomer(page, block, word));
            if (!alive && !free)
            {
                // Dead: cleared with the dead blocks next to it, below.
                if (run == 0) run = block;
                collected = collected + size;
                block = block + size;
                continue;
            }
            if (run != 0)
            {
                ClearDeadRun(run, block, size);
                if (tail == 0) head = run;
                else Sys.WriteAddress((tail + kindAt), run);
                tail = block - size;
                freeBytes = freeBytes + (block - run);
                run = 0;
            }
            if (alive)
            {
                // AN OLD BLOCK'S HEADER IS LEFT AS IT IS (SameHeader).
                if (generational && marked)
                {
                    if (word != oldHeader) Sys.WriteAddress(block, oldHeader);
                    OldCardsOfBlock(block, size);
                }
                else
                {
                    if (word != size) Sys.WriteAddress(block, size);
                    stillYoung = stillYoung || !marked;
                }
                live = live + 1;
                liveBytes = liveBytes + size;
            }
            else
            {
                Sys.WriteAddress((block + kindAt), 0);
                if (tail == 0) head = block;
                else Sys.WriteAddress((tail + kindAt), block);
                tail = block;
                freeBytes = freeBytes + size;
            }
            block = block + size;
        }
        if (run != 0)
        {
            ClearDeadRun(run, block, size);
            if (tail == 0) head = run;
            else Sys.WriteAddress((tail + kindAt), run);
            freeBytes = freeBytes + (block - run);
        }
        HeapChunks.SetPageFree(page, head);
        HeapChunks.SetLive(page, live, liveBytes);
        HeapChunks.SetLargestHole(page, freeBytes);
        HeapChunks.SetYoung(page, stillYoung);
        HeapChunks.SetOwner(page, collected);
        HeapChunks.SetSwept(page, true);
    }

    /// A page's old-block cards (_oldCards) all cleared, as its sweep begins,
    /// or all set: a page a thread owns, which the sweep does not walk and
    /// whose marked blocks stay old, is taken to have an old block in every
    /// kilobyte -- a card read for nothing costs a read, a card missed costs
    /// a young object swept from under an old one.
    static void OldCardsOfPage(nuint page, long value)
    {
        if (_oldCards == 0) return;
        nuint first = page >> Runtime.CardShift;
        nuint last = ((HeapChunks.Limit(page) - 1)) >> Runtime.CardShift;
        Sys.MemorySet(_oldCards + first, (int)value, last - first + 1);
    }

    /// An old block's cards set in _oldCards (a leaf's none: it holds no reference).
    static void OldCardsOfBlock(nuint block, nuint size)
    {
        if (_oldCards == 0 || Sys.ReadAddress(block + KindAt) == KindLeaf) return;
        nuint card = block >> Runtime.CardShift;
        nuint last = ((block + size - 1)) >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.Write8(_oldCards + card, 1);
            card = card + 1;
        }
    }

    /// A RUN OF DEAD BLOCKS OF A PAGE, [run, stop), cleared at once and laid
    /// down as free blocks of `size`, each linked to the next and the last
    /// to nothing: the caller links the run in after whatever it last freed.
    /// Cleared one by one, every dead block of a sweep was a call and two
    /// string instructions (Sys.MemorySet: the words, then the bytes left),
    /// whose start-up costs more than clearing a small block's few words
    /// does -- and a minor cycle frees millions of blocks of a few words,
    /// most of them next to each other: what died together was made
    /// together. One clear for the run, then a header and a link a block.
    /// Clearing the headers with the payloads is safe for the reason the
    /// sweep is: nobody reads a page's dead blocks while it is swept.
    /// Words, not longs, as the marker's loops are (ScanRange).
    static void ClearDeadRun(nuint run, nuint stop, nuint size)
    {
        if (_journalAddr != 0) for (nuint b = run; b < stop; b = b + size) NoteFreed(b, 1);
        Sys.MemorySet(run, 0, stop - run);
        nuint at = (nuint)run;
        nuint last = (nuint)(stop - size);
        nuint step = (nuint)size;
        nuint header = size | FlagFree;
        while (at < last)
        {
            Sys.WriteAddress(at, header);
            Sys.WriteAddress((at + KindAt), (at + step));
            at = at + step;
        }
        Sys.WriteAddress(last, header);
    }

    // SAME HEADER, NOT WRITTEN AGAIN (SweepPage, SweepPageAlone): an old
    // block a minor cycle passes keeps its marks, so its header is already
    // what the sweep would write. Written anyway, every old object in every
    // young page dirtied its cache line each minor cycle, a write-back per
    // line for nothing.

    // THE PAGES SWEPT TOGETHER. A collection with the world stopped sweeps
    // its pages on the workers too, before its own walk of the chunks: a
    // queue of the pages to sweep, taken from by every thread, then the
    // walk, which finds them swept and only lists them (SweepPage). The
    // mixed chunks, whose free runs go on the shared lists, stay its own.
    static nuint _pageQueue;
    static nuint _pageQueueBytes;
    static nuint _pageCount;
    static int _pageNext;       // the next page of the queue a worker takes
    static nuint _pagesDone;
    static int _job;            // what the workers do while the word is odd: 0 mark, 1 sweep pages, 2 snapshot pages, 3 cards
    const int PagesTogether = 512;

    static void SweepPagesTogether()
    {
        if (Workers == 0 || _census || _heapCheck || _verify || _deadCensus || _concurrent || AllocSamples.Tracking || HeapChunks.HeapBytes < WorkersWorthBytes) return;
        const int w = WordSize.Bytes;
        nuint chunks = 0;
        for (nuint each = HeapChunks.Newest(); each != 0; each = HeapChunks.Next(each)) chunks = chunks + 1;
        nuint wanted = chunks * w;
        if (wanted > _pageQueueBytes)
        {
            // The smaller queue is left mapped: kernels have no unmap, and a
            // queue grows only as the heap does.
            _pageQueueBytes = wanted * 2;
            _pageQueue = Platform.Map(_pageQueueBytes);
            if (_pageQueue == 0) { _pageQueueBytes = 0; return; }
        }
        nuint n = 0;
        nuint cap = _pageQueueBytes / w;
        for (nuint chunk = HeapChunks.Newest(); chunk != 0 && n < cap; chunk = HeapChunks.Next(chunk))
        {
            if (HeapChunks.PageClass(chunk) == 0 || HeapChunks.IsPooled(chunk) || HeapChunks.Owner(chunk) != 0) continue;
            if (_minor && !HeapChunks.IsYoung(chunk)) continue;
            nuint step = GcThreads.BufferAtOrAbove(HeapChunks.First(chunk));
            if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == HeapChunks.First(chunk)) continue;
            Sys.WriteAddress(_pageQueue + n * w, chunk);
            n = n + 1;
        }
        if (n < PagesTogether) return;
        _pageCount = n;
        Sys.AtomicSwap32(Sys.AddressOf(ref _pageNext), 0);
        Sys.AtomicSwap(Sys.AddressOf(ref _pagesDone), 0);
        Sys.AtomicSwap32(Sys.AddressOf(ref _job), 1);
        WorkersMark(true);
        SweepPagesSome();
        while (Sys.ReadAddress(Sys.AddressOf(ref _pagesDone)) < n) Sys.Pause();
        WorkersMark(false);
        Sys.AtomicSwap32(Sys.AddressOf(ref _job), 0);
    }

    /// Pages taken off the queue and swept until it is empty.
    static void SweepPagesSome()
    {
        const int w = WordSize.Bytes;
        while (true)
        {
            nuint i = (nuint)Sys.AtomicAdd32(Sys.AddressOf(ref _pageNext), 1);
            if (i >= _pageCount) return;
            SweepPageAlone(Sys.ReadAddress(_pageQueue + i * w));
            Sys.AtomicAdd(Sys.AddressOf(ref _pagesDone), 1);
        }
    }

    /// A swept page put where it belongs: retired when nothing in it lives,
    /// listed for reuse when half free, off the list otherwise.
    static void PlacePage(nuint page, nuint live, nuint head, nuint freeBytes, nuint span)
    {
        if (live == 0)
        {
            RetirePage(page);
        }
        // ONLY A PAGE AT LEAST HALF FREE IS LISTED FOR REUSE. The objects a
        // thread puts in a listed page are young among old neighbours: the
        // stores that fill them in mark cards the old blocks share, and the
        // next minor cycle reads those old blocks whole and looks up every
        // reference in them; it sweeps the whole page again too. Handed
        // every page with a free slot, the native compiler's minor cycles
        // read 155 million words of old blocks through cards compiling
        // hello.cs; handed only pages half free, 50 million, and its minor
        // cycles took 3.9 s where they took 5.3. A fuller page waits for
        // its neighbours to die, or for the next major cycle's sweep.
        //
        // EXCEPT NEAR A LIMIT (_reuseEveryPage): past half a cap or of the
        // 32-bit ceiling, or with the machine short, the slots of a fuller
        // page are what is left.
        else if (head != 0 && (_reuseEveryPage || freeBytes >= (span >> 1)))
        {
            if (!HeapChunks.IsListed(page)) ListPage(page);
        }
        else if (HeapChunks.IsListed(page))
        {
            UnlistPage(page);
        }
    }

    // ---- allocation buffers ---------------------------------------------------
    //
    // A thread bumps in a buffer of its OWN -- a block taken from the shared
    // heap under the lock and then carved up with no lock at all -- which is
    // what makes allocation on several threads cost what it costs on one.
    //
    // THE ONE INVARIANT the rest of this file depends on: every byte of every
    // chunk below its end word must be walkable as a chain of blocks, because
    // marking, sweeping and coalescing all walk. A buffer between its pointer
    // and its limit is NOT a block -- it is untouched memory -- so a buffer is
    // RETIRED (its tail stamped as one free block) before anything walks, and
    // the only thing that walks is a collection, which happens with every
    // thread stopped. That is the whole reason the world is stopped at all.
    //
    // The fast path keeps Smallest bytes back so that the tail is always big
    // enough to describe itself; a remainder of eight bytes would be a hole
    // nothing could walk past.

    const int BufferBytes = 65536;

    /// The smallest free fragment worth making a buffer of (Refill).
    const int MinFragment = 4096;

    /// Queued blocks an allocating thread scans while a mark is under way.
    const int AssistBudget = 32;

    // This is only an allocation-policy hint. A concurrent owner may change
    // the bin after this read; AllocSlow always rechecks/takes under the heap
    // lock. Never dereference the observed free-block address without that
    // lock. The bin table itself remains mapped for the heap's lifetime.
    static bool HasReusableFree(nuint need)
    {
        if (_bins == 0) return false;
        if (need <= ExactLimit)
            return _smallFree != 0 && BinHead((int)(need >> 3) - 2) != 0;
        // A block in a bin above the request's fits whatever it is, and
        // that is one bitmap search. Only the bitmap is read here; the
        // locked allocation path resolves a stale answer.
        return NextNonEmpty(BinOf(need) + 1) >= 0;
    }

    /// A fresh allocation buffer for the thread whose block is `block`, big
    /// enough for a request of `need`. The heap lock must be held.
    static bool Refill(nuint block, nuint need)
    {
        Retire(block);

        // Reuse free memory before consuming fresh address space. A 64 KiB
        // buffer is a preference, not a minimum: otherwise thousands of
        // smaller holes can coexist with repeated megabyte heap growth.
        nuint arena = TakeFree(BufferBytes);
        // A FRAGMENT WORTH A BUFFER: at least a few kilobytes. A fragment
        // barely larger than the request is a buffer used up by it, and the
        // next allocation is back here.
        if (arena == 0) arena = TakeBufferFragment(need + Smallest > MinFragment ? need + Smallest : MinFragment);
        if (arena != 0)
            ZeroWords(arena + HeaderBytes, arena + SizeOfBlock(arena) - FooterBytes);
        else arena = TakeBump(BufferBytes);

        if (arena == 0)
        {
            if (Grow(BufferBytes))
            {
                arena = Take(BufferBytes);
            }
        }

        if (arena == 0)
        {
            return false;
        }

        nuint size = SizeOfBlock(arena);
        if (_heapCheck)
        {
            nuint home = HeapChunks.Of(arena);
            if (home == 0 || HeapChunks.PageClass(home) != 0) OwnerFault("gc owner check: a buffer carved outside a mixed chunk", arena, home);
        }

        // NOT CHARGED HERE: what the buffer hands out is charged as it is
        // retired (Retire), so a buffer whose top block is freed and taken
        // again in a loop costs the pressure counter nothing. Charged whole
        // as it was taken, a loop that freed everything it made still paid
        // a collection for every few buffers.
        Sys.WriteAddress(block + Tls.AllocBase, arena);
        Sys.WriteAddress(block + Tls.AllocPtr, arena);
        Sys.WriteAddress(block + Tls.AllocLimit, arena + size);
        return true;
    }

    // ---- recycling: where young objects go --------------------------------
    //
    // A MINOR COLLECTION COSTS WHAT THE YOUNG CHUNKS HOLD, because it walks
    // each chunk anything was handed out in, whole: its anchors, its sweep.
    // Handed a best-fitting hole anywhere, the young objects of one cycle
    // landed in nearly every chunk of a fragmented heap, and a "minor"
    // collection of a compiler with a gigabyte and a half live walked three
    // gigabytes -- as dear as a major one, and paced as a cheap one.
    //
    // So the holes are reused a chunk at a time. After a collection the
    // chunks are taken in list order, each that is at least an eighth free,
    // and a buffer is refilled from the next hole that fits in the chunk
    // being recycled, in address order, until the chunk is done. A cycle's
    // young objects then lie in as few chunks as their bytes can fill. A
    // hole fits a request that fills it exactly -- the buffer is then used
    // up, which Retire allows -- or leaves a tail that can describe itself.
    //
    // AND ONLY A HOLE OF SEVERAL CARDS. Young objects in a small hole share
    // its cards with the old blocks either side, and the stores that fill
    // them in mark those cards: the next minor cycle reads every old block
    // in each, and resolves every pointer it finds there. Recycling holes
    // of any size, a stage 2 minor cycle read 23 million words of old blocks
    // through young objects' cards, against a third of a million through
    // old ones'. A hole of RecycleMin or more has cards only young objects
    // lie in, which no minor cycle takes. The smaller holes stay in the
    // free index, for an exact fit when no chunk is left to recycle and to
    // merge with a neighbour when it dies.
    //
    // The walk is safe because every block below a chunk's end is a whole
    // block (it runs with the heap lock held and never during a sweep),
    // except inside a buffer a thread is bumping in -- which is NOT a chain
    // of blocks: above its pointer lies whatever a free of the thread's top
    // block left there, and the thread may be writing a header this moment.
    // So every thread's buffer is taken down first (the heap lock keeps them
    // where they are: only the bump pointers move without it) and the walk
    // steps over each whole, as the sweep does. It takes only a listed free
    // block, never one freed in place, which is not on a list.

    /// The smallest hole recycling hands out: four cards (Runtime.CardShift).
    const int RecycleMin = 4096;

    /// A chunk is recycled when at least this fraction of it -- one part in
    /// eight -- was free at its last sweep. The holes of a fuller chunk wait
    /// until something beside them dies.
    const int RecycleShift = 3;

    static nuint _recycle;           // the chunk whose holes are being handed out, or 0
    static nuint _recycleAt;         // the next block in it to look at
    static nuint _recycleNext;      // the next chunk to consider
    static nuint _recycleBuffers;    // the threads' buffers as a walk begins, mapped once
    static nuint _recycleBuffersFor;   // the thread capacity it was mapped for (GcThreads.Sized)

    /// Called as a collection ends: every chunk may be recycled again.
    static void RestartRecycling()
    {
        _recycle = 0;
        _recycleAt = 0;
        _recycleNext = HeapChunks.Newest();
    }

    /// The bump pointer's chunk is walked too, up to its end as it stands at
    /// each step (SyncEnd keeps it there).
    static bool Recyclable(nuint chunk)
    {
        // Only the heap the allocator works for: a hole is its heap's.
        if (HeapChunks.PageClass(chunk) != 0 || HeapOfChunk(chunk) != _h)
        {
            return false;
        }
        if (HeapChunks.LargestHole(chunk) < RecycleMin)
        {
            return false;
        }
        nuint used = HeapChunks.End(chunk) - HeapChunks.First(chunk);
        nuint live = HeapChunks.LiveBytes(chunk);
        return live <= used && used - live >= (used >> RecycleShift);
    }

    /// The thread whose block is `block` given a buffer from the next hole
    /// that fits `need` in the chunk being recycled. The heap lock is held.
    static bool Recycle(nuint block, nuint need)
    {
        nuint arena = NextHole(need);
        if (arena == 0)
        {
            return false;
        }
        Retire(block);
        nuint size = SizeOfBlock(arena);
        ZeroWords(arena + HeaderBytes, arena + size - FooterBytes);
        Sys.WriteAddress(block + Tls.AllocBase, arena);
        Sys.WriteAddress(block + Tls.AllocPtr, arena);
        Sys.WriteAddress(block + Tls.AllocLimit, arena + size);
        return true;
    }

    /// The next hole that fits `need` in the chunk being recycled, taken off
    /// its list and stamped allocated, at most a buffer's worth (the rest is
    /// put back); or zero when no recyclable chunk is left. The heap lock is
    /// held.
    static nuint NextHole(nuint need)
    {
        if (_sweeping || _collecting)
        {
            return 0;
        }
        // NOTHING LEFT TO RECYCLE, said before the buffers are captured and
        // sorted: the walk below would answer 0 at its first look, and every
        // refill after the last hole paid for the capture all the same.
        if (_recycle == 0 && _recycleNext == 0)
        {
            return 0;
        }

        _recycleBuffers = GcThreads.Sized(_recycleBuffers, ref _recycleBuffersFor);
        if (_recycleBuffers == 0)
        {
            return 0;
        }
        nuint buffers = GcThreads.CaptureBuffersInto(_recycleBuffers);

        while (true)
        {
            // ANOTHER HEAP'S CHUNK BEING RECYCLED is left to that heap.
            if (_recycle != 0 && HeapOfChunk(_recycle) != _h)
            {
                return 0;
            }
            if (_recycle == 0)
            {
                nuint chunk = _recycleNext;
                while (chunk != 0 && !Recyclable(chunk))
                {
                    chunk = HeapChunks.Next(chunk);
                }
                if (chunk == 0)
                {
                    _recycleNext = 0;
                    return 0;
                }
                _recycle = chunk;
                _recycleAt = HeapChunks.First(chunk);
                _recycleNext = HeapChunks.Next(chunk);
            }

            nuint end = HeapChunks.End(_recycle);
            nuint at = _recycleAt;
            nuint step = 0;

            while (at < end)
            {
                // A THREAD'S BUFFER is stepped over whole.
                while (step < buffers && Sys.ReadAddress(_recycleBuffers + step * (2 * WordSize.Bytes)) < at)
                {
                    step = step + 1;
                }
                if (step < buffers && Sys.ReadAddress(_recycleBuffers + step * (2 * WordSize.Bytes)) == at)
                {
                    at = Sys.ReadAddress(_recycleBuffers + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    step = step + 1;
                    continue;
                }

                nuint word = Sys.ReadAddress(at);
                nuint size = word & SizeMask;

                if (size < Smallest || Beyond(at, size, end) || Sys.ReadAddress(at + size - FooterBytes) != word)
                {
                    break;
                }
                if ((word & FlagFree) != 0 && size >= RecycleMin && (size == need || size >= need + Smallest)
                    && !IsInPlace(at))
                {
                    Unlink(at);
                    if (size >= BufferBytes + Smallest)
                    {
                        Stamp(at + BufferBytes, size - BufferBytes, FlagFree);
                        Link(at + BufferBytes);
                        size = BufferBytes;
                    }
                    _recycleAt = at + size;
                    Stamp(at, size, 0);
                    HeapChunks.YoungAt(at);
                    return at;
                }
                at = at + size;
            }
            _recycle = 0;
        }
    }

    // Largest available fragment below the preferred buffer size. Keep it
    // whole for this thread rather than splitting off a one-object buffer.
    // All tree/list reads occur under the heap lock held by Refill.
    static nuint TakeBufferFragment(nuint minimum)
    {
        // As TakeFree: nothing from the lists while a minor sweep runs.
        if (_sweeping && _minor)
        {
            return 0;
        }
        int lowest = BinOf(minimum);
        int bin = PrevNonEmpty(BinOf(BufferBytes - 8));
        while (bin >= lowest)
        {
            nuint block = FirstFit(BinHead(bin), minimum);
            if (block != 0)
            {
                nuint size = SizeOfBlock(block);
                Unlink(block);
                Stamp(block, size, 0);
                HeapChunks.YoungAt(block);
                return block;
            }
            bin = PrevNonEmpty(bin - 1);
        }
        return 0;
    }

    /// Gives a thread's buffer back: whatever it has not handed out becomes
    /// one free block, so the chunk can be walked again. The heap lock must be
    /// held -- by the thread itself as it starts a collection, or by the
    /// collector on behalf of a thread it has already stopped.
    public static void Retire(nuint block)
    {
        if (block == 0)
        {
            return;
        }

        nuint at = Sys.ReadAddress(block + Tls.AllocPtr);
        nuint limit = Sys.ReadAddress(block + Tls.AllocLimit);
        nuint started = Sys.ReadAddress(block + Tls.AllocBase);

        // What the buffer handed out is allocated for good, by its thread.
        if (started != 0 && at > started)
        {
            Count(block, (long)(at - started));
            _since = _since + (long)(at - started);
        }

        // A module heap's buffer handed back: its chunk's counts are stale
        // until a sweep takes them (NoteUnowned).
        if (started != 0 && _heapCount > 1)
        {
            nuint chunk = HeapChunks.Of(started);
            if (chunk != 0 && HeapOfChunk(chunk) != _heap0) _unowned = _unowned + 1;
        }

        // A thread asked to answer a handshake had its limit taken away, so
        // that its next allocation comes to the slow path (GcThreads.Round);
        // the real one is kept aside.
        if (limit == 0)
        {
            limit = Sys.ReadAddress(block + Tls.AllocSaved);
        }

        // WHILE STAMPING IS OPEN a buffer's objects are written into the
        // snapshot before it goes: the snapshot stepped over it, and once
        // it is retired its owner's STAMP answer would look in the next one.
        // Not once its owner has answered (StampedAlready).
        if (_stamping && !StampedAlready(block))
        {
            StampBuffer(block);
        }

        // What Free left in place goes to the bins now that the buffer is
        // heap again.
        if (_inPlace > 0 && started != 0 && at > started)
        {
            LinkFreedInPlace(started, at);
        }

        Sys.WriteAddress(block + Tls.AllocSaved, 0);
        Sys.WriteAddress(block + Tls.AllocBase, 0);
        Sys.WriteAddress(block + Tls.AllocPtr, 0);
        Sys.WriteAddress(block + Tls.AllocLimit, 0);

        if (at == 0 || limit <= at || limit - at < Smallest)
        {
            return;
        }
        Stamp(at, limit - at, FlagFree);
        Link(at);
    }

    // A BLOCK FREED IN PLACE (Free, above) is free and in no bin. Its link
    // word -- a bin's next, a tree's left child, always a block address or
    // zero -- holds InPlace instead, which no block address is.
    const int InPlace = 1;

    /// Blocks freed in place and not yet in a bin.
    static long _inPlace;

    static bool IsInPlace(nuint block)
    {
        return Sys.ReadAddress(block + KindAt) == InPlace;
    }

    static void FreeInPlace(nuint block, nuint size)
    {
        if (_heapCheck) Forget(block);
        Stamp(block, size, FlagFree);
        Sys.WriteAddress(block + KindAt, InPlace);
        _inPlace = _inPlace + 1;
    }

    /// Every block freed in place in [from, to) linked into its bin, as its
    /// buffer is retired: each as it is, not merged, because a collection
    /// may be under way whose snapshot knows each one's start. The heap
    /// lock is held and nobody else writes below the buffer's pointer.
    static void LinkFreedInPlace(nuint from, nuint to)
    {
        nuint at = from;

        while (at < to && _inPlace > 0)
        {
            nuint word = Sys.ReadAddress(at);
            nuint size = word & SizeMask;

            if (size < Smallest || Beyond(at, size, to))
            {
                return;
            }
            if ((word & FlagFree) != 0 && IsInPlace(at))
            {
                Link(at);
                _inPlace = _inPlace - 1;
            }
            at = at + size;
        }
    }

    /// The blocks a thread's buffer gave to the bins while it was the only
    /// thread, taken back out and kept in place: a second thread is about to
    /// run, and must not be handed them (Free). The heap lock is held; the
    /// thread may be bumping above its pointer meanwhile, and may clear its
    /// own top block (Free's fast path), where the walk stops.
    public static void KeepBufferInPlace(nuint thread)
    {
        if (thread == 0 || _bins == 0)
        {
            return;
        }
        nuint at = Sys.ReadAddress(thread + Tls.AllocBase);
        nuint to = Sys.ReadAddress(thread + Tls.AllocPtr);

        while (at != 0 && at < to)
        {
            nuint word = Sys.ReadAddress(at);
            nuint size = word & SizeMask;

            if (size < Smallest || Beyond(at, size, to) || Sys.ReadAddress(at + size - FooterBytes) != word)
            {
                return;
            }
            if ((word & FlagFree) != 0 && !IsInPlace(at))
            {
                Unlink(at);
                FreeInPlace(at, size);
            }
            at = at + size;
        }
    }

    /// Every heap's current chunk's end word, brought up to its bump pointer.
    static void SyncEnd()
    {
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            nuint current = Sys.ReadAddress(h + HeapCurrentAt);
            if (current != 0)
            {
                HeapChunks.SetEnd(current, Sys.ReadAddress(h + HeapBumpAt));
            }
        }
    }

    /// NOTHING NEW BEFORE THIS THREAD'S STAMP ANSWER. A page or a buffer
    /// taken between the snapshot and that answer may be one the snapshot
    /// does not cover -- a pooled page laid out afresh, a chunk mapped
    /// since, a hole in an old chunk a minor cycle skipped -- and its
    /// objects are newcomers, never traced. Made before the answer, they
    /// could hold what was then only on this thread's stack: a string put
    /// into a new array, with no barrier, and dropped before the answer
    /// copied the stack. So the answer comes first, waiting out the few
    /// instructions between the snapshot and the round being asked. Not
    /// on top of the allocator (an interrupt's allocation, on a kernel):
    /// that cannot answer, and goes on as it always has.
    ///
    /// WHEREVER THE ALLOCATOR HAS LET GO OF THE HEAP LOCK, not only as it
    /// comes in: a cycle may have begun while it was let go of. Asked only
    /// on the way in, a thread that waited out one cycle for room
    /// (WaitOutCycle) came back inside the next one's stamping, still owing
    /// its answer, and took a fresh page: the array it made there was never
    /// traced, and the string only that array held was swept from under it.
    /// The heap lock is held, and let go of and taken again while waiting.
    static void AnswerBeforeTaking(nuint tb)
    {
        // NOT WHILE A STOP IS OPEN: nothing taken then but single blocks,
        // each written into the snapshot as it is handed out, or listed and
        // scanned as a root after the round (StampHandedOut), and the round
        // this waits for is not asked until the stop is done.
        while (tb != 0 && Sys.ReadAddress(tb + Tls.InAlloc) == 0 && _stamping && !_stopOpen && !StampedAlready(tb))
        {
            GcLock.Exit();
            GcThreads.Park();
            Sys.Pause();
            GcLock.Enter();
        }

        // A buffer limit taken away to ask for that answer (GcThreads.Round)
        // is given back: the buffer was this thread's all along.
        if (tb != 0 && Sys.ReadAddress(tb + Tls.AllocLimit) == 0 && Sys.ReadAddress(tb + Tls.AllocSaved) != 0)
        {
            Sys.WriteAddress(tb + Tls.AllocLimit, Sys.ReadAddress(tb + Tls.AllocSaved));
            Sys.WriteAddress(tb + Tls.AllocSaved, 0);
        }
        if (tb != 0 && Sys.ReadAddress(tb + Tls.Classes) == 0 && Sys.ReadAddress(tb + Tls.ClassesSaved) != 0)
        {
            Sys.WriteAddress(tb + Tls.Classes, Sys.ReadAddress(tb + Tls.ClassesSaved));
            Sys.WriteAddress(tb + Tls.ClassesSaved, 0);
        }
    }

    /// Everything the fast path does not: the free list, a collection when
    /// one is due, a new chunk, and out of memory.
    ///
    /// THIS AND EVERYTHING IT CALLS ALLOCATES NOTHING: no `new`, no arrays, no
    /// strings. Every one of those is a call to this. The one exception is
    /// the exception out of memory throws, made once, by the first request
    /// to come this way, before it has taken or holds anything.
    static nuint AllocSlow(nuint bytes, nuint kind)
    {
        // Whether the request was sized with a guard (AllocKind): read before
        // anything here can start the heap, which is where the check is read.
        bool checking = _heapCheck;
        if (!_outOfMemoryMade)
        {
            _outOfMemoryMade = true;
            _outOfMemoryMaker = Sys.ThreadBlock();
            OutOfMemoryException made = new OutOfMemoryException(true);
            made.Reserve$(new nuint[Runtime.TraceDepth]);
            _outOfMemory = made;
            _outOfMemoryMaker = 0;
        }

        // The size checked BEFORE it is rounded, with a bound that leaves
        // room for the rounding: rounding first lets a huge request wrap
        // negative and slip past the check.
        if (bytes > MaxRequest)
        {
            ThrowOutOfMemory(bytes, false);
        }

        nuint need = MixedNeed(bytes);
        nuint tb = Sys.ThreadBlock();

        // THE SAFEPOINT every allocating thread reaches: the collector's open
        // round answered, if this thread owes it -- never a wait -- and, while
        // a mark is under way, a little of the marking done here, so that the
        // threads that cause a collection help to finish it.
        if (GcLock.IsCollecting())
        {
            GcThreads.Park();
            Assist(AssistBudget);
        }

        GcLock.Enter();
        SlowPaths = SlowPaths + 1;
        AnswerBeforeTaking(tb);
        FoldClassBytes(tb);

        if (!_ready)
        {
            Start();
        }
        // THE HEAP CHECK IS KNOWN ONCE THE HEAP HAS STARTED (Start reads the
        // knob) -- here, or in the allocation of the exception made in
        // advance above. A request sized before that has no room for a
        // guard, and a block remembered unguarded was taken by every recheck
        // after for one a zeroing writer had cleared whole. Asked again, it
        // is guarded as every later request is.
        if (_heapCheck && !checking)
        {
            GcLock.Exit();
            return AllocKind(bytes, kind);
        }
        SyncEnd();

        // Pressure first: a program that has allocated a threshold's worth
        // since the last collection is collected now, whether or not this
        // request would have fitted, so the heap tracks the live size rather
        // than the allocation rate.
        if (_thresholdCap != 0 && _threshold > _thresholdCap)
        {
            _threshold = _thresholdCap;
        }
        bool due = _since + (long)need >= _threshold;
        if (!due && ShortHook != 0 && _since + (long)need >= ShortThreshold() && HeapChunks.Any()
            && Sys.Call(ShortHook, 0, 0, 0) != 0)
        {
            due = true;
            ShortCollections = ShortCollections + 1;
        }
        if (due && HeapChunks.Any())
        {
            // A PLATFORM MAY SAY "NOT HERE". This collection is owed because
            // a quota was reached, not because memory ran out, so it can be
            // put off: the quota stays exceeded and the next allocation made
            // somewhere better pays it. A kernel says so when interrupts are
            // off -- a collection stops the world for tens of milliseconds,
            // and started there it stops every device on the machine for as
            // long. Put off only so far: past four quotas it is taken
            // wherever it falls, and the collection that memory itself
            // demands (below) asks nobody.
            bool later = DeferHook != 0 && _since + (long)need < _threshold * 4
                      && Sys.Call(DeferHook, 0, 0, 0) != 0;
            if (later) Deferred = Deferred + 1;
            else
            {
                CollectLocked();
                if (MemoryShort()) DrainPool();
            }
        }

        nuint small = (bytes + ClassRounding) & SizeMask;
        if (small <= ClassMax && _classSize != 0)
        {
            return AllocClass(tb, small, need, kind);
        }

        // A small request takes a buffer of its own and is answered from it,
        // so the allocations after it need no lock. Prefer an existing fitting
        // size-class block, but unrelated free sizes must not disable every
        // thread's private buffer. If refill fails, Take below can still split
        // a larger free block; the heap cap and collection policy are unchanged.
        // A different thread may have consumed the exact-bin hint which
        // brought us here. Keep our existing arena if it still has room;
        // replacing it would throw away capacity merely because of a race.
        //
        // THE CHUNK BEING RECYCLED IS ASKED FIRST (recycling, above): a hole
        // that fits, taken from anywhere else, is a hole in whatever chunk
        // it is in, and that chunk is young for the next minor collection to
        // walk. Only when no chunk is left to recycle does an exact-size
        // hole from the free index win over a fresh buffer.
        // A FULL BUFFER IS REPLACED BY A BUFFER while the heap has room to
        // grow, never answered a block at a time. Preferring a free block of
        // the request's exact size sent every allocation after the buffer
        // ran out through here, under the heap lock, for as long as such
        // blocks lasted -- the lock's release was the costliest instruction
        // of a self-hosted compile's allocator. Only a heap that cannot grow
        // -- at its cap, or at the 32-bit ceiling -- takes its holes one
        // request at a time, which is what it has left. The small holes stay
        // for the requests too large for a buffer, and for the sweep to join.
        bool room = Sys.ReadAddress(tb + Tls.AllocPtr) != 0
            && BufferFits(Sys.ReadAddress(tb + Tls.AllocPtr), need, Sys.ReadAddress(tb + Tls.AllocLimit));
        bool tight = HeapChunks.SoftCap != 0 && HeapChunks.HeapBytes + BufferBytes > HeapChunks.SoftCap
            || HeapCeiling != 0 && HeapChunks.HeapBytes + BufferBytes > HeapCeiling;
        if (need + Smallest <= BufferBytes
            && (room || !_stopOpen && (Recycle(tb, need) || (!(tight && HasReusableFree(need)) && Refill(tb, need)))))
        {
            nuint from = Sys.ReadAddress(tb + Tls.AllocPtr);

            Sys.WriteAddress(tb + Tls.AllocPtr, from + need);
            Sys.WriteAddress(from, need);
            Sys.WriteAddress(from + KindAt, kind);
            Sys.WriteAddress(from + need - FooterBytes, need);
            GcLock.Exit();
            return from + HeaderBytes;
        }

        // Large backing arrays must not share their mapping with small,
        // long-lived nodes: one surviving node would pin the whole mapping
        // after the array dies. Give these objects page-rounded chunks whose
        // padding belongs to the same block, so no small allocation enters it.
        // FROM A BUFFER'S SIZE, 64 KiB: anything smaller goes in a thread's
        // buffer among small objects. A dedicated array freed by hand -- the
        // storage a List or Dictionary outgrew (OutgrownStorage) -- gives its
        // whole chunk straight back to the system (Free), and one found dead
        // goes back with the sweep (SweepNext): neither leaves a hole, and
        // neither counts against a cap after.
        bool dedicated = need >= BufferBytes;
        nuint block = dedicated ? TakeDedicated(need) : Take(need);

        if (block == 0)
        {
            if (!dedicated && Grow(need))
            {
                block = Take(need);
            }
            // A MAPPING OF ITS OWN IS A PREFERENCE, and when it is refused --
            // at the ceiling, above all -- the free space the heap already has
            // comes before a collection. The other way round, every array of
            // 64 KB or more made at the ceiling forced a whole-heap cycle, and
            // a compiler with a gigabyte live and as much again free between
            // its objects marked the gigabyte every hundred megabytes.
            if (block == 0 && dedicated)
            {
                block = Take(need);
            }
        }

        // Growth refused -- the cap, or the operating system. A collection
        // may free enough; if it does not, the last resort is to ask for a
        // chunk once more (the cap may have been met by garbage just freed).
        //
        // SOMEBODY ELSE'S COLLECTION MAY BE HALF WAY THROUGH, marking while
        // this thread runs. It cannot be joined and another cannot be begun;
        // it is waited out, and if what it frees is still not enough -- it
        // frees only what was garbage when it began -- this thread runs one
        // of its own.
        //
        // WHY A LARGE REQUEST CAN FAIL WITH THE HEAP HALF FREE: free memory
        // serves it only as a whole mapping. A request of a megabyte or more
        // -- or of MixedChunkMost, where a platform bounds the mixed chunks --
        // is larger than any mixed chunk (ChunkAsk), so no hole can hold it,
        // and the collector moves nothing to make one; a size-class page's
        // free slots serve only its class. Under a cap the heap's room is
        // counted in mapped bytes, so what a large request can be given is
        // the cap less every chunk still mapped -- and a chunk with one live
        // object in it is mapped. What these tries can do is give back every
        // chunk and page with nothing alive in it -- the whole collection
        // releases the mixed chunks and dedicated arrays it finds dead
        // (SweepNext) and retires the empty pages (PlacePage), and the pool
        // of empty pages is drained below -- and then, failing that, open
        // the reserve kept under the cap for this (HeapChunks.Reserve).
        long lapped = 0;
        nuint failedAt = HeapChunks.NoCycle;
        long givenUp = 0;
        for (long attempt = 0; block == 0 && attempt < 3; attempt++)
        {
            // A cycle has not found the room: the platform asked for it,
            // with the heap lock let go (WaitForRoom).
            if (attempt > 0) WaitForRoom(tb, need);
            // Memory itself ran out: only a whole collection finds all of it.
            _forceMajor = true;
            // A CYCLE ALREADY UNDER WAY when this request first came up short
            // frees only what was garbage when it began, and it may be a
            // minor one: waited out, it is not counted as a try, as in
            // AllocClass. Only the first can be such a cycle -- every cycle
            // begun later is numbered past failedAt -- so the loop ends.
            if (failedAt == HeapChunks.NoCycle) failedAt = _cycle;
            bool early = false;
            // MAY NOT WAIT (WaitOutCycle false): the last try at once, then
            // out of memory -- as an allocation that may not sleep is in a
            // kernel, never a wait the waiter itself keeps from ending.
            bool cannotWait = false;
            if (_collecting)
            {
                nuint waited = _cycle;
                cannotWait = !WaitOutCycle();
                if (cannotWait) RefusedAllocations = RefusedAllocations + 1;
                early = !cannotWait && waited <= failedAt;
            }
            else early = CollectedNothing(ref givenUp);

            // THE POOL OF EMPTY PAGES IS GIVEN BACK: a whole collection has
            // not found this request's room, and pages kept to spare a
            // mapping later are room the system could give it now. Only
            // with no cycle under way (another thread may have begun one
            // while this one waited): its snapshot names the pooled pages,
            // and the next try drains them instead.
            DrainPool();

            // THE LAST TRY IS NOT HELD AT THE CEILING (GrowthWaits). AND THE
            // RESERVE IS OPEN to a large request after a whole collection --
            // what it is kept for; not after a cycle begun before the need,
            // which may have been minor and left dead arrays mapped -- and to
            // any request on the last try, which would otherwise be out of
            // memory.
            _growPast = attempt == 2 || cannotWait;
            HeapChunks.ReserveOpen = dedicated && !early || attempt == 2 || cannotWait;
            HeapChunks.PastCap = cannotWait;
            block = dedicated ? TakeDedicated(need) : Take(need);

            if (block == 0 && !dedicated && Grow(need))
            {
                block = Take(need);
            }
            // Mapping failure must not reject usable existing free space.
            if (block == 0 && dedicated) block = Take(need);
            _growPast = false;
            HeapChunks.ReserveOpen = false;
            HeapChunks.PastCap = false;
            if (block == 0 && cannotWait) break;
            if (block == 0 && early)
            {
                attempt = attempt - 1;
                continue;
            }
            if (block == 0 && attempt == 2 && MostlyGarbage(lapped))
            {
                lapped = lapped + 1;
                attempt = 0;
            }
        }

        if (block == 0)
        {
            ThrowOutOfMemory(need, true);
        }

        _since = _since + (long)SizeOfBlock(block);
        Count(Sys.ThreadBlock(), (long)SizeOfBlock(block));
        Sys.WriteAddress(block + KindAt, kind);
        StampHandedOut(tb, block, 0);
        GcLock.Exit();
        return block + HeaderBytes;
    }

    /// A small block for AllocSlow: off this thread's class list, refilled
    /// if it is empty; failing a page, from the mixed heap's free blocks;
    /// failing those, after a collection, as the large path does. The heap
    /// lock is held and let go.
    ///
    /// TWO SIZES FOR ONE REQUEST: `small`, its block in a page, which has no
    /// footer, and `need`, its block anywhere else, which has. A block of
    /// the mixed heap taken at the class's size would be a word short.
    static nuint AllocClass(nuint tb, nuint small, nuint need, nuint kind)
    {
        nuint c = Sys.ReadAddress(_classOf + (small >> 3) * WordSize.Bytes);
        nuint failedAt = HeapChunks.NoCycle;
        long lapped = 0;
        long givenUp = 0;
        // MAY NOT WAIT for a cycle under way (WaitOutCycle false): the last
        // try at once, then out of memory, as in AllocSlow.
        bool cannotWait = false;
        for (long attempt = 0; attempt < 4; attempt++)
        {
            // After a whole cycle has failed it: room asked for, the lock
            // let go meanwhile (WaitForRoom).
            if (attempt >= 2 && !cannotWait) WaitForRoom(tb, ClassSize(c));
            // THE LAST TRY, after three cycles: not held at the ceiling
            // (GrowthWaits), and the reserve under the cap open to it
            // (HeapChunks.Reserve) -- set here, after the lock was last let
            // go, and shut again before it is (ShutLastTry), so that no other
            // thread's request grows into the reserve on this one's behalf.
            _growPast = attempt == 3;
            HeapChunks.ReserveOpen = attempt == 3;
            HeapChunks.PastCap = cannotWait;
            nuint cache = EnsureCache(tb);
            if (cache != 0)
            {
                nuint slot = cache + c * (2 * WordSize.Bytes);
                nuint at = PopClass(slot, c, kind);
                if (at == 0 && !_stopOpen && ClassRefill(tb, c))
                {
                    at = PopClass(slot, c, kind);
                }
                if (at != 0)
                {
                    ShutLastTry();
                    GcLock.Exit();
                    return at;
                }
            }
            // NO PAGE TO BE HAD -- the cap, the ceiling: a free block of the
            // mixed heap serves as well, at the request's size with its
            // footer; then a free slot of a bigger class's page (TakeLarger);
            // then the current chunk's bump space, and another chunk's tail.
            nuint block = TakeFree(need);
            if (block == 0)
            {
                block = TakeLarger(tb, c, attempt == 3);
                if (block != 0)
                {
                    _since = _since + (long)SizeOfBlock(block);
                    Count(tb, (long)SizeOfBlock(block));
                    Sys.WriteAddress(block + KindAt, kind);
                    if (_heapCheck) CheckMade(block, "a bigger class's slot", 0);
                    ShutLastTry();
                    GcLock.Exit();
                    return block + HeaderBytes;
                }
            }
            // THE CURRENT CHUNK'S BUMP SPACE, which AdoptTail passes by as
            // the chunk it would move from: under an 8 MB cap the first
            // chunk, a megabyte, had 983 KB above its bump pointer when a
            // 32-byte request ran out of memory, every small object having
            // gone to the pages.
            if (block == 0) block = TakeBump(need);
            if (block == 0 && AdoptTail(need))
            {
                block = TakeBump(need);
            }
            // MID-STOP NO PAGE IS TAKEN (_stopOpen): the heap grows for the
            // block instead, rather than the request waiting for the cycle.
            if (block == 0 && _stopOpen && Grow(need))
            {
                block = TakeBump(need);
            }
            if (block != 0)
            {
                ZeroWords(block + HeaderBytes, block + SizeOfBlock(block) - FooterBytes);
                _since = _since + (long)SizeOfBlock(block);
                Count(tb, (long)SizeOfBlock(block));
                Sys.WriteAddress(block + KindAt, kind);
                if (_heapCheck) CheckMade(block, "class fallback", FooterBytes);
                StampHandedOut(tb, block, 0);
                ShutLastTry();
                GcLock.Exit();
                return block + HeaderBytes;
            }
            ShutLastTry();
            if (cannotWait) break;
            if (attempt == 3)
            {
                if (!MostlyGarbage(lapped)) break;
                lapped = lapped + 1;
                attempt = 1;
            }
            ClassStarved = ClassStarved + 1;
            _forceMajor = true;
            // A CYCLE ALREADY UNDER WAY when this thread first came up short
            // is waited out without counting as a try: it frees only what was
            // garbage when it began, and under a small cap with several
            // threads a cycle is nearly always under way, so the tries went
            // to cycles begun before the need. Only that first one can be
            // such a cycle, so the loop still ends.
            if (failedAt == HeapChunks.NoCycle) failedAt = _cycle;
            if (_collecting)
            {
                nuint waited = _cycle;
                if (!WaitOutCycle())
                {
                    // The pool is not given back first, as the last try's
                    // way otherwise is (attempt 2, below): a cycle is almost
                    // always still under way, whose snapshot names its pages
                    // (DrainPool refuses then). A class's refill takes a
                    // pooled page before a mapping all the same (ClassRefill).
                    RefusedAllocations = RefusedAllocations + 1;
                    cannotWait = true;
                    attempt = 2;
                    continue;
                }
                if (waited <= failedAt)
                {
                    attempt = attempt - 1;
                    continue;
                }
            }
            else if (CollectedNothing(ref givenUp))
            {
                attempt = attempt - 1;
                continue;
            }
            if (attempt == 2) DrainPool();
        }
        ShutLastTry();
        ThrowOutOfMemory(small, true);
        return 0;
    }

    /// The last try's allowances taken back: the ceiling and the reserve.
    /// The heap lock is held.
    static void ShutLastTry()
    {
        _growPast = false;
        HeapChunks.ReserveOpen = false;
        HeapChunks.PastCap = false;
    }

    /// A FREE SLOT OF A BIGGER CLASS, for a request of class `c` that found
    /// no page: the head of the nearest bigger class's listed page, handed
    /// out whole, at that class's size -- the page is walked at its own size
    /// (SweepPage), so the slack is the object's. Within twice the request,
    /// or any size when `any`. 0 when no listed page has one. The page
    /// is not taken: it stays listed while its list lasts, then is laid out
    /// further, then is nobody's until a sweep finds room in it, as a used-up
    /// page is (ClassRefill). Written into the snapshot when thread `tb`
    /// owes STAMP (StampHandedOut), and so not from a page the snapshot did
    /// not walk meanwhile. The heap lock is held.
    ///
    /// UNDER A CAP THE CLASSES DO NOT SHARE: a page keeps its class until
    /// nothing in it lives, and an 8 MB heap ran out of memory for a 32-byte
    /// request with 3 MB free in 66,000 slots of 48 bytes.
    static nuint TakeLarger(nuint tb, nuint c, bool any)
    {
        nuint want = ClassSize(c);
        bool owes = OwesStamp(tb);
        for (nuint k = c + 1; k < Classes; k++)
        {
            nuint size = ClassSize(k);
            if (!any && size > 2 * want) break;
            nuint page = Sys.ReadAddress(_classPages + k * WordSize.Bytes);
            if (page == 0 || owes && HeapChunks.StartsCycle(page) != _cycle) continue;
            nuint block = HeapChunks.PageFree(page);
            // WHAT IS LAID OUT HERE GOES ON THE PAGE'S LIST UNCHARGED, its
            // bytes in LargestHole with the rest of the list's: the refill
            // that takes the page charges them (ClassRefill), and handed back
            // unused they are uncharged (RetireClasses). Left out, the refill
            // charged none of them, the hand-back uncharged them all, and the
            // allocation total and the pacing ran low by the difference.
            if (block == 0)
            {
                block = FormatMore(page, k, false);
                if (block == 0)
                {
                    UnlistPage(page);
                    continue;
                }
                HeapChunks.SetLargestHole(page, HeapChunks.LargestHole(page) + (HeapChunks.End(page) - block));
            }
            if (_heapCheck) CheckOutsideBuffer(block, block + size, "gc owner check: a bigger class's slot inside the live buffer");
            nuint next = Sys.ReadAddress(block + KindAt);
            if (next == 0)
            {
                next = FormatMore(page, k, false);
                if (next != 0) HeapChunks.SetLargestHole(page, HeapChunks.LargestHole(page) + (HeapChunks.End(page) - next));
            }
            HeapChunks.SetPageFree(page, next);
            // A hint, which may be below the size taken: none left then.
            nuint hole = HeapChunks.LargestHole(page);
            HeapChunks.SetLargestHole(page, hole > size ? hole - size : 0);
            if (next == 0) UnlistPage(page);
            Sys.WriteAddress(block, size);
            Sys.WriteAddress(block + KindAt, 0);
            HeapChunks.SetYoung(page, true);
            StampHandedOut(tb, block, page);
            ClassBorrowed = ClassBorrowed + 1;
            return block;
        }
        return 0;
    }

    /// WHAT THE COLLECTOR WAS DOING when a fault stopped the program, for
    /// the fault report (Runtime.ReportFault): a fault in a live object is
    /// most often a collection's doing, and whether one was marking or
    /// sweeping, and of which kind the last one was, says where to look.
    public static void SayState()
    {
        SayNumber("gc: cycle ", _cycle);
        SayNumber("gc:   minor collections ", MinorCollections);
        SayNumber("gc:   major collections ", MajorCollections);
        SayNumber("gc:   concurrent cycles ", ConcurrentCycles);
        SayNumber("gc:   given up ", Aborted);
        SayNumber("gc:   collecting now ", _collecting ? 1 : 0);
        SayNumber("gc:   sweeping now ", _sweeping ? 1 : 0);
        SayNumber("gc:   marking now ", Runtime.Marking);
        SayNumber("gc:   this or last cycle minor ", _minor ? 1 : 0);
        SayNumber("gc:   frees ", Frees);
        SayNumber("gc:   live bytes ", _liveBytes);
    }

    /// A label and a number on standard error without allocating: the
    /// digits are written into a fixed buffer on the stack of static data.
    static nuint _digits;           // a page for the digits, mapped in Start

    /// Called as the allocator gives up, with the request: the platform's
    /// own account of where the heap went. It must allocate nothing.
    public static nuint OutOfMemoryHook;

    internal static void SayNumber(string label, long value)
    {
        SayDigits(label, value < 0 ? 0 - (ulong)value : (ulong)value, value < 0);
    }

    /// An address or a length, said unsigned: a kernel's address in the top
    /// half of long mode is no negative number.
    internal static void SayNumber(string label, nuint value)
    {
        SayDigits(label, value, false);
    }

    /// A 64-bit total, said unsigned.
    internal static void SayNumber(string label, ulong value)
    {
        SayDigits(label, value, false);
    }

    static void SayDigits(string label, ulong n, bool negative)
    {
        Runtime.WriteLiteral(2, label);

        if (_digits == 0)
        {
            return;
        }

        nuint at = 24;

        if (n == 0)
        {
            at = at - 1;
            Sys.Write8(_digits + at, 48);
        }

        while (n > 0 && at > 1)
        {
            at = at - 1;
            Sys.Write8(_digits + at, (byte)(48 + n % 10));
            n = n / 10;
        }

        if (negative)
        {
            at = at - 1;
            Sys.Write8(_digits + at, 45);
        }

        Platform.WriteBytes(2, _digits + at, 24 - at);
        Runtime.WriteLiteral(2, "\n");
    }

    // The largest heap and live size any collection ended with, for SayStats.
    static long _peakHeap;
    static long _peakLive;
    static long _minorPauseMicros;
    static long _allocatedTotal;
    static long _marksNew;
    /// Bytes the program freed itself (Free): a count, read only for the stats.
    public static long FreedBytes;
    /// Bytes the collector's sweeps reclaimed: what the program did not free.
    public static long CollectedBytes;
    /// Whether the stats will be said, and so whether a chunk released whole is
    /// walked to count what in it was the collector's (set at start-up).
    public static bool CountingCollected;

    /// The bytes of a chunk's blocks that are not free, by its chain of sizes.
    /// Every block of a chunk the program had not freed, charged to the
    /// sampled entry that made it (Corsac.GC.AllocSample): the collector's.
    static void CollectedIn(nuint chunk)
    {
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < LeastBlock || Beyond(block, size, end)) break;
            if ((word & FlagFree) == 0) AllocSamples.Collected(block + HeaderBytes);
            block = block + size;
        }
    }

    static long UnfreedBytes(nuint chunk)
    {
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        long total = 0;
        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < LeastBlock || Beyond(block, size, end)) break;
            if ((word & FlagFree) == 0) total = total + (long)size;
            block = block + size;
        }
        return total;
    }

    /// The collector's counts, pauses and sizes on standard error, when the
    /// platform asks for them (the image's Corsac.GC.Stats knob, on Linux)
    /// or the program does (StatsAsked, the AppContext switch of the same
    /// name: corc's --gc-stats). Called at exit. A flag of its own, set by
    /// the switch: asking AppContext here made every program carry its table
    /// and lock, and none could run without the collector.
    public static void SayStats()
    {
        if (!_ready || !(StatsAsked || Platform.GcStats())) return;
        SayNumber("gc: collections ", Collections);
        SayNumber("gc: minor ", MinorCollections);
        SayNumber("gc: major ", MajorCollections);
        SayNumber("gc: majors grown ", MajorsGrown);
        SayNumber("gc: majors costly ", MajorsCostly);
        // The majors nothing in the pacing called for: asked for (GC.Collect,
        // GC.GetTotalMemory(true), an allocation the heap had no room for, a
        // full held-block table) and the first; and the ones without
        // generations at all.
        SayNumber("gc: majors asked ", MajorsAsked);
        SayNumber("gc: majors first ", MajorsFirst);
        SayNumber("gc: majors without generations ", MajorsUngenerational);
        SayNumber("gc: pause ms ", PauseMicros / 1000);
        SayNumber("gc: minor pause ms ", _minorPauseMicros / 1000);
        SayNumber("gc: snapshot ms ", SnapshotMicros / 1000);
        SayNumber("gc: roots ms ", RootMicros / 1000);
        SayNumber("gc: mark ms ", MarkMicros / 1000);
        SayNumber("gc: sweep ms ", SweepMicros / 1000);
        SayNumber("gc: marks ", MarkCalls);
        SayNumber("gc: marks new ", _marksNew);
        SayNumber("gc: cards taken ", TakenCards);
        SayNumber("gc: card words ", YoungCardWords);
        SayNumber("gc: old card words ", OldCardWords);
        SayNumber("gc: static card words ", StaticCardWords);
        SayNumber("gc: static words skipped ", StaticWordsSkipped);
        // The pressure counter's total is what went out and did not come back
        // by hand: a byte freed by the program is taken off it again. What was
        // handed out, all of it, is that and the program's frees together.
        SayNumber("gc: allocated MB ", (_allocatedTotal + _since + FreedBytes) / 1048576);
        SayNumber("gc: allocated net of the program's frees MB ", (_allocatedTotal + _since) / 1048576);
        // WHAT THE COMPILER GAVE BACK ITSELF, of all the heap handed out: the
        // share of memory the program managed without the collector. (What
        // escape analysis kept in frames never reaches the heap at all.)
        SayNumber("gc: frees ", Frees);
        SayNumber("gc: freed by the program MB ", FreedBytes / 1048576);
        SayNumber("gc: freed by the program bytes ", FreedBytes);
        SayNumber("gc: frees dropped while marking ", FreesDroppedMarking);
        SayNumber("gc: frees dropped otherwise ", FreesDropped);
        SayNumber("gc: freed by the collector MB ", CollectedBytes / 1048576);
        SayNumber("gc: freed by the collector bytes ", CollectedBytes);
        // Everything regions gave back: at their ends, and from their tops
        // before (RegionTopFreedBytes, also given alone below).
        SayNumber("gc: given back by regions MB ", (RegionFreedBytes + RegionTopFreedBytes) / 1048576);
        SayNumber("gc: given back by regions bytes ", RegionFreedBytes + RegionTopFreedBytes);
        SayNumber("gc: region allocations the system had no memory for ", RegionMisses);
        SayNumber("gc: region allocations past the arenas' cap ", RegionCapped);
        // WHAT THE ARENAS TOOK OF THE SYSTEM against what they held: the
        // regions take what they need and no more.
        SayNumber("gc: arena peak mapped bytes ", ArenaMappedPeak);
        SayNumber("gc: arena peak used bytes ", ArenaUsedPeak);
        SayNumber("gc: arena mapped per used at peak percent ", ArenaUsedPeak > 0 ? ArenaMappedPeak * 100 / ArenaUsedPeak : 0);
        SayNumber("gc: arena mapped now bytes ", ArenaMappedNow);
        SayNumber("gc: arena bytes asked of the system ", ArenaAskedBytes);
        SayNumber("gc: arena chunks mapped ", ArenaChunksMapped);
        SayNumber("gc: arena chunks unmapped ", ArenaChunksUnmapped);
        SayNumber("gc: arena spares reused ", ArenaSparesReused);
        nuint sayingThread = Sys.ThreadBlock();
        if (sayingThread != 0) CountRegionBlocks(sayingThread);
        SayNumber("gc: region blocks ", RegionBlocks);
        SayNumber("gc: sized regions ", RegionsSized);
        SayNumber("gc: sized room in the chunk ", SizedRoomHere);
        SayNumber("gc: sized room in another chunk ", SizedRoomElsewhere);
        SayNumber("gc: grown in place ", RegionGrownInPlace);
        SayNumber("gc: region top frees ", RegionTopFrees);
        SayNumber("gc: region top freed bytes ", RegionTopFreedBytes);
        // WHO GAVE BACK WHAT WAS GIVEN BACK: the program's frees against the
        // collector's sweeps -- by the bytes each actually reclaimed.
        long given = FreedBytes + CollectedBytes;
        SayNumber("gc: freed by the program percent ", given > 0 ? FreedBytes * 100 / given : 0);
        SayNumber("gc: sweep visits ", SweepVisits);
        SayNumber("gc: slow paths ", SlowPaths);
        SayNumber("gc: class refills ", ClassRefills);
        SayNumber("gc: class pages laid out further ", ClassLaidFurther);
        SayNumber("gc: pages taken ", PagesTaken);
        SayNumber("gc: pages pooled ", PagesPooled);
        SayNumber("gc: pages released ", PagesReleased);
        SayNumber("gc: pages refilled ", PagesRefilled);
        SayNumber("gc: last major live ", _majorLive);
        SayNumber("gc: live now ", _liveBytes);
        SayNumber("gc: peak live ", _peakLive);
        SayNumber("gc: heap now ", HeapChunks.HeapBytes);
        SayNumber("gc: peak heap ", _peakHeap);
    }

    /// A block of `need` bytes from the free list or the bump pointer, stamped
    /// allocated and with its payload zeroed, or zero.
    static nuint Take(nuint need)
    {
        nuint block = TakeFree(need);

        if (block != 0)
        {
            // Reused memory holds whatever its last owner left; a field read
            // before it is assigned must see its default.
            ZeroWords(block + HeaderBytes, block + SizeOfBlock(block) - FooterBytes);
            return block;
        }

        block = TakeBump(need);

        // Memory above the bump pointer has never been touched since the
        // operating system handed it over zeroed, so it needs no clearing.
        // That is the one reason the bump pointer never moves backwards.
        return block;
    }

    static nuint TakeDedicated(nuint need)
    {
        nuint chunk = HeapChunks.Take(need, true);
        if (chunk == 0) return 0;
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.Limit(chunk);
        Stamp(block, end - block, 0);
        HeapChunks.SetEnd(chunk, end);
        return block;
    }

    /// A free block of at least `need` bytes: an exact bin's head, or one of
    /// the first few blocks of the request's large bin that fits, else the
    /// head of the next non-empty bin (the free index). The remainder of a larger block is split off
    /// and put back, unless it would be too small to describe itself, in
    /// which case the caller gets it.
    static nuint TakeFree(nuint need)
    {
        // NOT WHILE A MINOR SWEEP RUNS. It keeps the free lists, and they
        // still name the free blocks of young chunks it has not reached: one
        // handed out now becomes a buffer the sweep then walks into -- it was
        // captured by no one -- stopping at the thread's bump pointer and
        // leaving the rest of the chunk unswept and miscounted. A major sweep
        // empties the lists first (BeginSweep) and rebuilds them as it goes,
        // so everything on them then is swept already. The bump pointer and
        // new chunks answer meanwhile; the sweep is short.
        if (_sweeping && _minor)
        {
            return 0;
        }
        int bin = BinOf(need);

        // An exact bin's head fits exactly. A large bin's blocks may be
        // smaller than the request: the first few are looked at.
        nuint block = need <= ExactLimit ? BinHead(bin) : FirstFit(BinHead(bin), need);

        if (block == 0)
        {
            int above = NextNonEmpty(bin + 1);
            if (above >= 0)
            {
                block = BinHead(above);
            }
        }

        if (block == 0)
        {
            return 0;
        }

        nuint size = SizeOfBlock(block);
        Unlink(block);

        if (size - need >= Smallest)
        {
            nuint rest = block + need;
            Stamp(rest, size - need, FlagFree);
            Link(rest);
        }
        else
        {
            need = size;
        }
        Stamp(block, need, 0);
        // WHAT IS HANDED OUT IS YOUNG, and so is the chunk it is in: the next
        // minor collection walks and sweeps it (generations, below).
        HeapChunks.YoungAt(block);
        return block;
    }

    /// A CHUNK'S UNBUMPED TAIL, taken when nothing else answers. A sweep
    /// lowers a chunk's end over the dead blocks at its top, and that space
    /// was reachable only while the chunk was current: a capped heap with
    /// megabytes of it answered a 56-byte request with out of memory
    /// (252_concurrent_mark, once in a loaded run). The chunk being left
    /// gives its own tail to the free lists first, as Grow's does.
    ///
    /// Only an ordinary chunk: not a size-class page (its tail is laid out for
    /// its class), not one a thread allocates in, not one in the pool, and
    /// not while a collection may be sweeping. And the tail is cleared: what
    /// a sweep handed back above the end holds its dead blocks' bytes, and the
    /// bump pointer hands out what is above it without clearing it.
    static bool AdoptTail(nuint need)
    {
        if (_collecting || _sweeping || Runtime.Marking != 0) return false;
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            if (chunk != _current && HeapChunks.PageClass(chunk) == 0 && HeapChunks.Owner(chunk) == 0 && !HeapChunks.IsPooled(chunk)
                && HeapOfChunk(chunk) == _h && !IsCurrentChunk(chunk) && HeapChunks.Limit(chunk) - HeapChunks.End(chunk) >= need)
            {
                Sys.MemorySet(HeapChunks.End(chunk), 0, HeapChunks.Limit(chunk) - HeapChunks.End(chunk));
                if (_current != 0)
                {
                    LeaveCurrent();
                }
                _current = chunk;
                _bump = HeapChunks.End(chunk);
                _limit = HeapChunks.Limit(chunk);
                return true;
            }
            chunk = HeapChunks.Next(chunk);
        }
        return false;
    }

    static nuint TakeBump(nuint need)
    {
        if (_current == 0 || need > _limit - _bump)
        {
            return 0;
        }

        nuint block = _bump;
        _bump = _bump + need;
        HeapChunks.SetEnd(_current, _bump);
        Stamp(block, need, 0);
        HeapChunks.SetYoung(_current, true);
        return block;
    }

    /// Zeroes [from, to) a word at a time. A loop rather than the block-set
    /// intrinsic because the string instruction the backend selects for it
    /// mis-assigns its fixed registers as of this writing (see the note on
    /// Os.CString in runtime/src/platforms/linux/system.cor); a loop is right on any backend.
    static void ZeroWords(nuint from, nuint to)
    {
        // THE STRING INSTRUCTION: every reused buffer is cleared here, a
        // buffer's worth at every refill, and a loop that stored a word at a
        // time with a 64-bit pointer on a 32-bit processor was most of what
        // an allocation's slow path cost. (The selector's fixed registers for
        // `rep stos` are right now; the class library's heap uses it too.)
        if (to > from)
        {
            if (_heapCheck) Journal(from, to);
            // A FEW WORDS ARE STORED, NOT SET: the string instructions' start
            // costs more than a small block's clearing, and Sys.MemorySet is
            // two of them (the words, then the bytes left over, even when
            // there are none). Most blocks cleared -- every block freed by
            // hand (ClassFree and Free's rewind), every hole reused -- are a
            // few words. In words, not longs: on a 32-bit processor a 64-bit
            // pointer took an add and an adc a store.
            nuint bytes = to - from;
            if (bytes <= ZeroLoopBytes && ((from | bytes) & (WordSize.Bytes - 1)) == 0)
            {
                nuint at = from;
                const int w = WordSize.Bytes;
                while (at < to)
                {
                    Sys.WriteAddress(at, 0);
                    at = at + w;
                }
                return;
            }
            Sys.MemorySet(from, 0, bytes);
        }
    }

    const int ZeroLoopBytes = 256;

    // WHAT THE COLLECTOR CLEARED, while the heap check is on: every range
    // ZeroWords clears and every boundary a merge wipes, with three return
    // addresses, in a ring. A header or footer the check finds zeroed is
    // looked up in it: an entry covering the word names the path that
    // cleared it, and no entry says the allocator did not -- something
    // wrote past the end of an object.
    const int JournalEntries = 8192;
    const int JournalWords = 5;
    static nuint _journal;
    static nuint _journalAt;

    static void Journal(nuint from, nuint to)
    {
        if (_journal == 0)
        {
            _journal = Platform.Map(JournalEntries * JournalWords * WordSize.Bytes);
            if (_journal == 0) return;
        }
        nuint e = _journal + (_journalAt % JournalEntries) * JournalWords * WordSize.Bytes;
        _journalAt = _journalAt + 1;
        const int w = WordSize.Bytes;
        Sys.WriteAddress(e, from);
        Sys.WriteAddress(e + w, to);
        nuint fp = Sys.FramePointer();
        for (nuint i = 0; i < 3; i++)
        {
            nuint back = 0;
            if (fp != 0)
            {
                back = Sys.ReadAddress(fp + w);
                nuint next = Sys.ReadAddress(fp);
                fp = next > fp ? next : 0;
            }
            Sys.WriteAddress(e + (2 + i) * w, back);
        }
    }

    // TWO OWNERS OF ONE RANGE, while the heap check is on: a class page laid
    // out over the thread's live buffer, a buffer carved from a class page,
    // or a top-of-buffer rewind over a block that is not the buffer's own.
    // Said with the call trace where it happens, the first twelve.
    static long _ownerReports;

    static void OwnerFault(string what, nuint a, nuint b)
    {
        if (_ownerReports >= 12) return;
        _ownerReports = _ownerReports + 1;
        Runtime.WriteLiteral(2, what);
        SayNumber(" -- at ", a);
        SayNumber("gc owner check:   and ", b);
        nuint tb = Sys.ThreadBlock();
        if (tb != 0)
        {
            SayNumber("gc owner check:   buffer base ", Sys.ReadAddress(tb + Tls.AllocBase));
            SayNumber("gc owner check:   buffer pointer ", Sys.ReadAddress(tb + Tls.AllocPtr));
            SayNumber("gc owner check:   buffer limit ", Sys.ReadAddress(tb + Tls.AllocLimit));
        }
        Runtime.SayTrace(2, Sys.FramePointer());
    }

    /// A write about to be made into [at, at + count), checked while the
    /// heap check is on: it must lie inside one live block's payload, and
    /// that block must not be a string (strings are never written once
    /// made). Said with the call trace otherwise. For kernel code that
    /// writes through an address it keeps (a file read into a buffer).
    public static void CheckTarget(nuint at, nuint count)
    {
        if (!_heapCheck || count <= 0 || GcLock.HeldByMe()) return;
        nuint stringType = Sys.ReadAddress(Sys.ObjectAddress(""));
        GcLock.Enter();
        nuint chunk = HeapChunks.Of(at);
        nuint block = 0, size = 0, tail = FooterBytes;
        if (chunk != 0)
        {
            tail = TailIn(chunk);
            nuint first = HeapChunks.First(chunk);
            nuint c = HeapChunks.PageClass(chunk);
            if (c > 1)
            {
                size = ClassSize(c - 1);
                // In the page's header, before its first block: none.
                block = at < first ? 0 : first + ((at - first) / size) * size;
            }
            else if (c == 0)
            {
                nuint end = ChunkEndNow(chunk);
                nuint b = first;
                while (b < end)
                {
                    nuint z = Sys.ReadAddress(b) & SizeMask;
                    if (z < Smallest) break;
                    if (at < b + z) { block = b; size = z; break; }
                    b = b + z;
                }
            }
        }
        if (block != 0)
        {
            nuint word = Sys.ReadAddress(block);
            bool free = (word & FlagFree) != 0;
            bool outside = at < block + HeaderBytes || at + count > block + size - tail;
            bool text = !free && (Sys.ReadAddress(block + HeaderBytes)) == stringType;
            if (free || outside || text)
            {
                GcLock.Exit();
                OwnerFault(free ? "gc owner check: a write into a free block" : outside ? "gc owner check: a write past its block" : "gc owner check: a write into a string", at, block);
                SayNumber("gc owner check:   bytes ", count);
                SayNumber("gc owner check:   block header ", word);
                return;
            }
        }
        GcLock.Exit();
    }

    /// Whether the word at `at` is the end of a live block of a class page
    /// and is broken: the heap check's question for a kernel watching one
    /// page's writes (GcWatchpoint). The block, or 0. A page's block has no
    /// footer, so its end is the next slot's header (CheckMade's watched
    /// word), broken when it no longer holds the class's size -- which
    /// making, freeing and marking that slot all keep. Reads only; takes no
    /// lock (the caller is a trap handler).
    public static nuint FooterBroken(nuint at)
    {
        nuint chunk = HeapChunks.Of(at);
        if (chunk == 0) return 0;
        nuint c = HeapChunks.PageClass(chunk);
        if (c <= 1) return 0;
        nuint size = ClassSize(c - 1);
        nuint first = HeapChunks.First(chunk);
        nuint next = at & ~(nuint)3;
        if (next < first + size || next >= HeapChunks.End(chunk)) return 0;
        if (!OnGrid(next - first, c - 1)) return 0;
        nuint block = next - size;
        nuint word = Sys.ReadAddress(block);
        if ((word & FlagFree) != 0 || (word & SizeMask) != size) return 0;
        return (Sys.ReadAddress(next) & SizeMask) == size ? 0 : block;
    }

    /// [from, to) inside this thread's live buffer: a fault.
    static void CheckOutsideBuffer(nuint from, nuint to, string what)
    {
        nuint tb = Sys.ThreadBlock();
        if (tb == 0) return;
        nuint bas = Sys.ReadAddress(tb + Tls.AllocBase);
        nuint limit = Sys.ReadAddress(tb + Tls.AllocLimit);
        if (limit == 0) limit = Sys.ReadAddress(tb + Tls.AllocSaved);
        if (bas != 0 && from < limit && to > bas) OwnerFault(what, from, to);
    }

    /// Every journal entry covering `at`, newest first.
    static void SayJournal(nuint at)
    {
        if (_journal == 0) return;
        const int w = WordSize.Bytes;
        long seen = 0;
        nuint n = _journalAt < JournalEntries ? _journalAt : JournalEntries;
        for (nuint k = 1; k <= n && seen < 6; k++)
        {
            nuint e = _journal + ((_journalAt - k) % JournalEntries) * JournalWords * w;
            if (Sys.ReadAddress(e) <= at && at < Sys.ReadAddress(e + w))
            {
                SayNumber("gc heap check:   cleared by an entry this many clears ago ", k);
                SayNumber("gc heap check:     from ", Sys.ReadAddress(e));
                SayNumber("gc heap check:     to ", Sys.ReadAddress(e + w));
                SayNumber("gc heap check:     called from ", Sys.ReadAddress(e + 2 * w));
                SayNumber("gc heap check:     and from ", Sys.ReadAddress(e + 3 * w));
                SayNumber("gc heap check:     and from ", Sys.ReadAddress(e + 4 * w));
                seen = seen + 1;
            }
        }
        if (seen == 0) SayNumber("gc heap check:   no clear by the collector covers ", at);
    }

    /// Under a control group's memory limit the heap is capped as .NET caps
    /// it in a container, three quarters of the limit -- or, at 512 MB and
    /// below, all but an eighth and at least 32 MB -- and never below 20 MB:
    /// the rest is the program's code, stacks and the collector's own
    /// tables. The cap paces the collector and is the total GC.GetGCMemoryInfo
    /// reports, which is what the build sizes its parallel work by.
    const int ContainerFloor = 20971520;
    const int SmallMachine = 536870912;
    static nuint _lastFreeClass;
    const int SmallReserve = 33554432;

    /// The heap's ceiling for the address space this process has.
    static void SetCeiling()
    {
        HeapCeiling = CeilingToBe();
    }

    /// THE CEILING AND THE CAP START SETS, known before it has: what
    /// GC.GetGCMemoryInfo answers before the first allocation, as .NET's
    /// answers its hard limit from the start. The ceiling by the address
    /// space; the cap the program's own (SetLimit), else the image's knob
    /// (Platform.HeapLimit), else its share of what its control group
    /// allows (ContainerCap); 0 for none.
    public static long CeilingToBe()
    {
        if (_ready) return HeapCeiling;
        return Platform.AddressSpace() > 3221225472 ? WideCeiling : NarrowCeiling;
    }

    public static long CapToBe()
    {
        if (_ready || HeapChunks.Cap != 0) return HeapChunks.Cap;
        long asked = Platform.HeapLimit();
        if (asked != 0) return asked;
        long limit = Platform.MemoryLimit();
        return limit != 0 ? ContainerCap(limit) : 0;
    }

    /// ON A SMALL MACHINE, what the program needs beside its heap: its code,
    /// stacks and the collector's tables came to 16 MB when a compile was
    /// stopped at the cap, and a quarter of 256 MB held 64 back for them --
    /// the heap the compile needed was there and refused. An eighth, and
    /// never less than 32 MB, below 512 MB; past that a quarter, as .NET's
    /// container cap, which is what the build sizes its parallel work by.
    static long ContainerCap(long limit)
    {
        long reserve = limit / 8 > SmallReserve ? limit / 8 : SmallReserve;
        long cap = limit <= SmallMachine ? limit - reserve : limit / 4 * 3;
        return cap > ContainerFloor ? cap : ContainerFloor;
    }

    static void Start()
    {
        // Kept where the program asked for it before the heap started
        // (CheckFrees as its first statement), which this set back to off.
        _verify = _verify || Platform.VerifyFrees();
        VerifyingFieldFrees = Platform.VerifyFieldFrees();
        IgnoredFrees = Platform.IgnoreFrees();
        // AS THE SWITCH ASKS TOO (AppContext's Corsac.GC.Stats): asked only by
        // the platform's flag, the report the switch prints read the
        // collector's frees and its marks as none.
        CountingCollected = CountingCollected || StatsAsked || Platform.GcStats();
        SkippedFreePaths = Platform.SkippedFreePaths();
        GuardReleases = Platform.GuardReleases();
        _census = Platform.GcCensus();
        _deadCensus = _census && (_deadCensusAsked || Platform.GcDeadCensus());
        _thresholdCap = Platform.GcThreshold();
        _nurseryFixed = Platform.GcNursery();
        // Kept where the program turned it on before the heap started (CheckHeapOn).
        _heapCheck = _heapCheck || Platform.HeapCheck();
        CountMarks = CountMarks || StatsAsked || Platform.GcStats();
        if (Platform.FreeLog())
        {
            Runtime.StartFreeLog();
        }
        if (_verify || VerifyingFieldFrees)
        {
            StartQuarantine();
        }
        SetCeiling();
        long asked = Platform.HeapLimit();
        if (asked != 0 && HeapChunks.Cap == 0)
        {
            HeapChunks.SetLimit(asked);
        }
        if (HeapChunks.Cap == 0)
        {
            long limit = Platform.MemoryLimit();
            if (limit != 0) HeapChunks.SetLimit(ContainerCap(limit));
        }
        _ready = true;
        _threshold = MinThreshold;
        _digits = Platform.Map(4096);
        _heap0 = MakeHeap();
        _h = _heap0;

        if (_h == 0 || !StartClasses())
        {
            OutOfMemory();
        }
        FastPathsChanged();
        MapBarrier(BarrierBytes);
        _markAt = Platform.Map(MarkBytes);

        if (_markAt != 0)
        {
            _markBytes = MarkBytes;
            _markCount = MarkBytes / GreyEntry;
        }
        StartGenerations();
        AllocSamples.Start();
    }

    /// THE EXCEPTION OUT OF MEMORY THROWS, made in advance (AllocSlow, by the
    /// first request to come that way) as .NET makes its own: when the heap
    /// has run out, making one is the thing that cannot be done. One for the
    /// run, thrown again each time with the trace of that throw, as .NET's
    /// is. The flag is a latch -- set before the exception is made, never
    /// cleared -- so it is made once (Escape's latched blocks); two first
    /// requests racing may make two, and either serves. One that finds the
    /// latch set while another thread is still making it (_outOfMemoryMaker)
    /// and then runs out itself waits for it (ThrowOutOfMemory).
    static OutOfMemoryException? _outOfMemory;
    static bool _outOfMemoryMade;
    static nuint _outOfMemoryMaker;

    /// The request the heap last could not answer, for its report.
    static nuint _failedNeed;

    /// OUT OF MEMORY, THROWN as .NET throws it, and catchable as there: the
    /// exception made in advance, its trace taken with nothing made
    /// (Exception.Refill$), and the heap lock let go first -- `locked` says
    /// whether this thread holds it -- for the catch may allocate, and an
    /// unwind must leave no lock behind. What the platform can say of where
    /// the heap went comes first (OutOfMemoryHook), as it always did; what
    /// the heap held is said only if nothing catches it (SayOutOfMemory,
    /// from Runtime.Unhandled). With nothing made yet to throw, the heap's
    /// report ends the process, as it did before there was a throw.
    static void ThrowOutOfMemory(nuint need, bool locked)
    {
        // Nothing the hook does may allocate.
        if (OutOfMemoryHook != 0) Sys.Call(OutOfMemoryHook, need, 0, 0);
        _failedNeed = need;
        // MADE BY ANOTHER THREAD AT THIS MOMENT, the first request of all,
        // which this one raced: waited for, as a thread that is blocked, the
        // heap lock let go meanwhile, for the maker allocates it. Its maker
        // running out making it ends the process, as below.
        if (_outOfMemory == null && _outOfMemoryMaker != 0 && _outOfMemoryMaker != Sys.ThreadBlock())
        {
            if (locked) GcLock.Exit();
            GcThreads.BeginBlocking();
            while (_outOfMemory == null && _outOfMemoryMaker != 0) Platform.Yield();
            GcThreads.EndBlocking();
            if (locked) GcLock.Enter();
        }
        // ONE READ OF THE STATIC, the value thrown: what a throw hands a
        // catch is judged by where it came from (Escape.ThrowVerdict), and a
        // local written in the wait as well was any exception at all, which
        // made every catch in the program keep what it caught.
        OutOfMemoryException? thrown = _outOfMemory;
        if (thrown == null)
        {
            if (!locked) GcLock.Enter();
            SayHeld();
            OutOfMemory();
            return;
        }
        Runtime.OutOfMemoryReport = Sys.AddressOf(Gc.SayOutOfMemory);
        if (locked) GcLock.Exit();
        thrown.Refill$(Sys.FramePointer());
        throw thrown;
    }

    /// The heap's report for an out-of-memory exception nobody caught
    /// (Runtime.OutOfMemoryReport, a hook's three words): what it held, under
    /// its lock, with nothing made.
    public static nuint SayOutOfMemory(nuint a, nuint b, nuint c)
    {
        GcLock.Enter();
        SayHeld();
        GcLock.Exit();
        return 0;
    }

    /// What the heap held when it ran out, every figure, its free bins and
    /// its free shape. The heap lock is held.
    static void SayHeld()
    {
        if (_failedNeed > MaxRequest) SayNumber("out of memory: a request larger than any object may be ", _failedNeed);
        else SayNumber("out of memory: request ", _failedNeed);
        SayNumber("out of memory: heap ", HeapChunks.HeapBytes);
        SayNumber("out of memory: since last collection ", _since);
        SayNumber("out of memory: live bytes at last collection ", _liveBytes);
        SayNumber("out of memory: live blocks at last collection ", _liveBlocks);
        SayNumber("out of memory: small free blocks ", _smallFree);
        SayNumber("out of memory: bump bytes remaining ", _limit - _bump);
        SayNumber("out of memory: anchor metadata bytes ", HeapChunks.BlockAnchorBytes);
        SayNumber("out of memory: cap ", HeapChunks.Cap);
        SayNumber("out of memory: reserve under the cap ", HeapChunks.ReserveBytes);
        SayNumber("out of memory: pooled page bytes ", _poolBytes);
        SayNumber("out of memory: threshold ", _threshold);
        SayNumber("out of memory: ceiling ", HeapCeiling);
        SayNumber("out of memory: collections ", Collections);
        SayNumber("out of memory: of them major ", MajorCollections);
        SayNumber("out of memory: mark queue bytes ", _markBytes);
        if (_bins != 0)
        {
            for (int bin = 0; bin < Bins; bin++)
            {
                nuint root = BinHead(bin);
                if (root == 0) continue;
                SayNumber("out of memory: free bin ", bin);
                SayNumber("out of memory: first block ", SizeOfBlock(root));
            }
        }
        SayFreeShape();
    }

    /// Nothing left: the message is a literal, which is data the compiler laid
    /// out and not an object this heap made, so printing it allocates nothing.
    static void OutOfMemory()
    {
        OutOfMemory("out of memory: the operating system would give no more\n");
    }

    /// The report, and then WHO ASKED: the frame table the code generator
    /// writes says what each address in the image is, and the saved frame
    /// pointers are a list of callers with each return address beside them.
    /// Runtime.SayTrace walks the one and writes names out of the other
    /// without building anything, which is the only kind of trace this path
    /// may print -- Exception.StackTrace's needs a string, and a string needs
    /// the heap that has just run out.
    static void OutOfMemory(string text)
    {
        Runtime.WriteLiteral(2, text);
        // WHAT THE HEAP HELD, for whoever reads the report: whether the live
        // size ran into the ceiling, or the chunks did while little was live.
        SayNumber("  heap bytes ", HeapChunks.HeapBytes);
        SayNumber("  live at the last collection ", _liveBytes);
        SayNumber("  allocated since ", _since);
        SayNumber("  threshold ", _threshold);
        SayNumber("  ceiling ", HeapCeiling);
        SayNumber("  collections ", Collections);
        SayNumber("  of them major ", MajorCollections);
        SayNumber("  mark queue bytes ", _markBytes);
        Runtime.SayTrace(2, Sys.FramePointer());
        Platform.Exit(137);
    }

    // ---- giving memory back by hand -----------------------------------------------
    //
    // The COMPILER calls this, through Runtime.Free, for the objects it
    // proves dead: a tier 1 allocation whose size is not a constant and so
    // could not become a frame slot, and a tier 2 owned object at the last
    // use the optimiser found (X86-BACKEND.md, "Memory"). A program still
    // never frees anything itself, and this is exactly as safe as the proof
    // behind it -- a freed object still referenced is memory handed out twice,
    // which is why only the optimiser, and not source, is allowed to say it.

    /// Returns an allocation to the free list, merged with its free
    /// neighbours. Boundary tags find the neighbours directly; exact bins
    /// unlink in constant time and large-bin trees in logarithmic time.
    /// Anything that is not exactly the payload of a live
    /// block -- zero, a null reference, an interior pointer, a frame slot, a
    /// pointer into someone else's memory, a block already free -- is ignored,
    /// because the compiler frees what it has proved dead and a wrong proof
    /// must cost nothing worse than the memory it forgot to give back.
    // Whether `at` is in a heap chunk, asked under the heap lock: the index
    // is nobody's to read without it. Not for a caller inside the allocator.
    static bool OnHeapLocked(nuint at)
    {
        GcLock.Enter();
        bool on = HeapChunks.Of(at) != 0;
        GcLock.Exit();
        return on;
    }

    public static void Free(nuint at)
    {
        // NOT ON TOP OF THE ALLOCATOR, NOR OF THE HEAP LOCK'S HOLDER. A
        // kernel's thread is a processor, and the compiler's frees reach
        // interrupt handlers too: a handler that lets go of an owned field
        // frees with nothing allocated. Landed inside the allocator's fast
        // path (Tls.InAlloc), the top-of-buffer rewind below would move the
        // bump pointer the code under it has read and not yet moved; landed
        // on the lock's holder, GcLock.Enter would wait on itself for ever.
        // The object is left to the collector, as a wrong proof's is.
        //
        // A null first, which an owned variable's first assignment hands
        // over (FreeReplaced), and with no thread block nothing to read:
        // before one exists there is no fast path to be on top of.
        if (at == 0 || IgnoredFrees != 0 && IgnoredFrees != 'p' && IgnoredFrees != 'f' && IgnoredFrees != 'r'
            && IgnoredFrees != 'v' && IgnoredFrees != 'w' && IgnoredFrees != 'o' && IgnoredFrees != 's')
        {
            return;
        }
        // NO HEAP YET: nothing to free was made by it -- an owned variable
        // that held a literal, a free before the first allocation -- and
        // asking its lock maps the lock's words, which on bare metal before
        // Platform.SetHeap stopped the image ("no heap").
        if (!HeapChunks.Any())
        {
            return;
        }
        if (FreeOwnBlock((nuint)at))
        {
            return;
        }
        nuint self = Sys.ThreadBlock();
        // In a region: given back with the rest of it when it ends.
        if (self != 0 && InRegion(self, at)) return;
        if (self != 0 && Sys.ReadAddress(self + Tls.InAlloc) != 0 || GcLock.HeldByMe())
        {
            FreesDropped = FreesDropped + 1;
            return;
        }
        if (AllocSamples.Tracking) AllocSamples.Freed(at);
        // ON THE HEAP ONLY: a wrong proof's free of a literal laid out in the
        // image has no header before it, and the span its first word makes
        // ran past everything mapped.
        if (_heapCheck && (at & 3) == 0 && OnHeapLocked(at))
        {
            nuint guarded = at - HeaderBytes;
            nuint head = Sys.ReadAddress(guarded);
            nuint span = head & SizeMask;
            if (span >= Smallest && span < 0x1000000 && Sys.ReadAddress(guarded + span - FooterBytes) == head) CheckGuard(guarded, "its free");
        }

        // LOGGED (Corsac.GC.FreeLog), with the two calls it came through, for
        // the fault report to look through.
        if (Runtime.FreeLogRing != 0)
        {
            nuint fp = Sys.FramePointer();
            nuint caller = Sys.ReadAddress(fp);
            Runtime.LogPlainFree(at, caller != 0 ? Sys.ReadAddress(caller + WordSize.Bytes) : 0, Sys.ReadAddress(fp + WordSize.Bytes));
        }

        if (Verifying())
        {
            GcLock.Enter();
            VerifyFree(at);
            GcLock.Exit();
            return;
        }

        // NOTHING IS FREED WHILE A MARK IS UNDER WAY. (Deferring such frees
        // past the collection was tried, 10-01: a block marked to keep it
        // through the sweep was still taken by the size-class page logic --
        // a page a thread gives up mid-cycle -- and freed again later. The
        // compiler, which collects stop-the-world, drops none here.) The marker reads and
        // flags the objects of its snapshot with nothing held; an object
        // that went back to the free list under it, was merged with its
        // neighbour and handed out again, would have its flags written into
        // the middle of somebody's data. The sweep that ends the mark finds
        // it unreferenced and frees it then.
        if (Runtime.Marking != 0 || _sweeping)
        {
            FreesDroppedMarking = FreesDroppedMarking + 1;
            return;
        }

        nuint tb = Sys.ThreadBlock();

        // THE TOP BLOCK OF THIS THREAD'S OWN BUFFER goes straight back to it:
        // the last thing the thread bumped is the next thing it will get, at
        // the same address, through the fast path and with no lock -- which is
        // the whole of what a formatting buffer or an enumerator in a loop
        // costs. Only this thread may touch this buffer, so nothing is held.
        //
        // NOT TO BE ANSWERED FOR IN THE MIDDLE (Tls.InAlloc, as in Alloc): a
        // collector stamping this buffer's objects for the thread, or
        // unmarking them, reads the pointer this is about to move.
        //
        // AND KNOWN WITHOUT THE CHUNK INDEX. A block inside this thread's own
        // live buffer is mapped, and its header is this thread's to read; the
        // index is not anybody's to read without the heap lock -- a chunk
        // released and unmapped, or the index itself moved, under a reader
        // that had no lock faulted inside HeapChunks.Of. Every other block is
        // validated under the lock, below.
        nuint inside = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        nuint ptr = Sys.ReadAddress(tb + Tls.AllocPtr);
        nuint block = at - HeaderBytes;
        nuint word = 0;
        nuint size = 0;
        if (ptr != 0 && (at & 7) == 0 && block >= Sys.ReadAddress(tb + Tls.AllocBase) && block < ptr)
        {
            word = Sys.ReadAddress(block);
            size = word & SizeMask;
        }

        // Not while a collection is anywhere under way: the block may carry
        // the snapshot's start, and an object bumped into it again would be
        // swept as the one that was freed.
        if ((SkippedFreePaths & 33) == 0 && Runtime.Marking == 0 && !_sweeping && !_collecting && size >= Smallest && (word & FlagFree) == 0
            && block + size == ptr && Sys.ReadAddress(block + size - FooterBytes) == word)
        {
            if (VerifyingFieldFrees)
            {
                ReportFreedAgain(block, at);
            }
            if (_heapCheck && !GcLock.HeldByMe())
            {
                GcLock.Enter();
                nuint home = HeapChunks.Of(block);
                if (home == 0 || HeapChunks.PageClass(home) != 0 || ValidAllocated(at) != block)
                {
                    OwnerFault("gc owner check: a top-of-buffer rewind over a block not the buffer's", block, home);
                }
                GcLock.Exit();
            }
            // The fast path's one assumption is that memory above the pointer
            // has never been written; the bytes are cleared here instead.
            ZeroWords(block, ptr);
            Sys.WriteAddress(tb + Tls.AllocPtr, block);
            Frees = Frees + 1;
            FreedBytes = FreedBytes + (long)size;
            Sys.WriteAddress(tb + Tls.InAlloc, inside);
            return;
        }

        // A BLOCK OF ONE OF THIS THREAD'S OWN PAGES goes onto the thread's own
        // list for its class with no lock, as the allocator's fast path takes
        // one off it: the page, its record, the list and the thread's pending
        // count are all this thread's while it owns the page, and the block's
        // header -- a live object's, mapped -- says its class. Only while its
        // count still holds the block (no pressure to give back), and never
        // with a collection anywhere under way. Every free the compiler writes
        // took the heap lock, and the lock was most of what freeing cost.
        if ((SkippedFreePaths & 128) == 0 && Runtime.Marking == 0 && !_sweeping && !_collecting && !_heapCheck && (at & 7) == 0)
        {
            // Its page found among the thread's own first: nothing is read at
            // an address a wrong proof handed over until it is known to lie in
            // one of them -- a free of an address in no chunk at all must
            // cost nothing.
            nuint cache = Sys.ReadAddress(tb + Tls.Classes);
            nuint c = 0;
            nuint page = 0;
            // FROM THE CLASS THE LAST FREE FOUND, round: frees come in runs of
            // one type, and every class's page was asked in order first. Only
            // a hint -- shared by every thread, read and written without a
            // lock -- since the page's own range decides.
            nuint first = _lastFreeClass;
            if (first >= Classes) first = 0;
            long tried = 0;
            c = first;
            while (cache != 0 && tried < Classes)
            {
                nuint mine = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
                if (mine != 0 && block >= HeapChunks.First(mine) && block < HeapChunks.End(mine))
                {
                    page = mine;
                    _lastFreeClass = c;
                    break;
                }
                c = c + 1;
                if (c == Classes) c = 0;
                tried = tried + 1;
            }
            if (page != 0 && HeapChunks.Owner(page) == tb && _classSize != 0)
            {
                nuint bytes = Sys.ReadAddress(_classSize + c * WordSize.Bytes);
                nuint head = Sys.ReadAddress(block);
                nuint slot = cache + c * (2 * WordSize.Bytes);
                // WHOLE AS A PAGE'S BLOCK IS (Whole): live, the class's size,
                // on the class's grid. It has no footer to agree.
                if ((head & SizeMask) == bytes && (head & FlagFree) == 0 && block + bytes <= HeapChunks.End(page)
                    && (int)(block - HeapChunks.First(page)) % (int)bytes == 0)
                {
                    if (VerifyingFieldFrees)
                    {
                        ReportFreedAgain(block, at);
                    }
                    ZeroWords(block + HeaderBytes, block + bytes);
                    StampClass(block, bytes, FlagFree);
                    // Back on a list the thread was charged for (Charge).
                    Sys.WriteAddress(block + KindAt, Sys.ReadAddress(slot + WordSize.Bytes));
                    Sys.WriteAddress(slot + WordSize.Bytes, block);
                    Frees = Frees + 1;
                    FreedBytes = FreedBytes + (long)bytes;
                    Sys.WriteAddress(tb + Tls.InAlloc, inside);
                    return;
                }
            }
        }

        Sys.WriteAddress(tb + Tls.InAlloc, inside);
        GcLock.Enter();

        // AGAIN, NOW THAT THE LOCK IS HELD, and for the WHOLE of a collection,
        // not only while it marks or sweeps. A collection begins with this lock
        // held and its snapshot says this block is an object; freed and handed
        // out again before the sweep, the new object would carry the old one's
        // start and be swept as the old one, dead -- and a dedicated chunk
        // given back here would be walked by the sweep after it was unmapped.
        if (Runtime.Marking != 0 || _sweeping || _collecting)
        {
            GcLock.Exit();
            return;
        }

        block = ValidAllocated(at);
        if (block == 0)
        {
            GcLock.Exit();
            return;
        }
        size = SizeOfBlock(block);
        if (VerifyingFieldFrees)
        {
            ReportFreedAgain(block, at);
        }
        if ((SkippedFreePaths & 32) != 0)
        {
            nuint p = at;
            while (p < block + size - FooterBytes)
            {
                Sys.Write32(p, Poison);
                p = p + 4;
            }
        }

        SyncEnd();

        // A BLOCK OF A SIZE-CLASS PAGE goes back to its class, never merged.
        nuint owning = HeapChunks.Of(block);
        if (owning != 0 && HeapChunks.PageClass(owning) != 0)
        {
            // A BLOCK OFF ITS PAGE'S GRID, or not live: a pointer from before
            // the page was laid out again for another class, or one freed
            // already. Freed, it clears across the blocks either side and
            // puts a block on the list that overlaps them. Refused and said
            // while the heap check is on.
            if (_heapCheck)
            {
                nuint grid = ClassSize(HeapChunks.PageClass(owning) - 1);
                nuint first = HeapChunks.First(owning);
                nuint head = Sys.ReadAddress(block);
                if ((block - first) % grid != 0 || (head & FlagFree) != 0 || (head & SizeMask) != grid)
                {
                    GcLock.Exit();
                    if (_badFrees < 12)
                    {
                        _badFrees = _badFrees + 1;
                        SayNumber("gc owner check: a free off its page's grid or not live, at ", at);
                        SayNumber("gc owner check:   offset in the page ", block - first);
                        SayNumber("gc owner check:   the page's class size ", grid);
                        SayNumber("gc owner check:   header there ", head);
                        Runtime.SayTrace(2, Sys.FramePointer());
                    }
                    return;
                }
                // ITS GUARD, which the look at the free's start passed by: it
                // asks the footer, and a page's block has none.
                CheckGuard(block, "its free");
            }
            Frees = Frees + 1;
            FreedBytes = FreedBytes + (long)size;
            ClassFree(owning, block, size, tb);
            GcLock.Exit();
            return;
        }

        // The bytes go back off the pressure counter. `_since` measures how
        // much of the heap has gone out and not come back, because that is
        // what says a collection would find something; memory returned by
        // hand has already been found, and counting it again would collect a
        // program that frees everything it allocates -- exactly the program
        // that needs no collection at all.
        _since = _since - (long)size;

        if (_since < 0)
        {
            _since = 0;
        }
        Frees = Frees + 1;
        FreedBytes = FreedBytes + (long)size;

        // Dedicated arrays own their complete chunk, including page padding.
        // Return it directly rather than putting it into bins where small
        // objects could occupy it and pin the former large-object mapping.
        nuint whole = HeapChunks.Of(block);
        if (whole != 0 && !IsCurrentChunk(whole) && block == HeapChunks.First(whole)
            && block + size == HeapChunks.Limit(whole))
        {
            if ((SkippedFreePaths & 8) != 0)
            {
                GcLock.Exit();
                return;
            }
            if (GuardReleases)
            {
                SayNumber("gc: guarded release of a dedicated chunk at ", whole);
                SayNumber("gc:   its block ", block);
                SayNumber("gc:   size ", size);
                Runtime.WriteLiteral(2, "gc:   freed by:\n");
                Runtime.SayTrace(2, Sys.FramePointer());
            }
            // Not a chunk the recycling walk may still step onto.
            if (whole == _recycleNext) _recycleNext = HeapChunks.Next(whole);
            if (whole == _recycle) _recycle = 0;
            HeapChunks.Release(whole, GuardReleases);
            GcLock.Exit();
            return;
        }

        // A BLOCK INSIDE A LIVE ALLOCATION BUFFER, WITH OTHER THREADS RUNNING,
        // IS FREED WHERE IT LIES: marked free and in place (InPlace), and left
        // out of the bins until its buffer is retired (Retire links it then).
        // A buffer is its thread's alone -- STAMP walks it as that thread's
        // chain of blocks and the sweep steps over it whole -- and a block of
        // it out of a bin, handed to another thread as an object or taken as
        // that thread's whole buffer inside this one, broke both: the owner's
        // objects went unstamped and were swept while still referenced. With
        // one thread there is nobody to hand it to, and it goes to its bin at
        // once, for the thread's own next allocation of its size.
        nuint holder = GcThreads.BufferHolding(block);

        if (holder != 0 && GcThreads.Others())
        {
            if ((SkippedFreePaths & 2) != 0)
            {
                GcLock.Exit();
                return;
            }
            FreeInPlace(block, size);
            GcLock.Exit();
            return;
        }

        // THE TOP BLOCK GOES BACK TO THE BUMP POINTER, not to a bin. A small
        // object allocated and freed in a loop -- the formatting buffer, the
        // enumerator, the closure the optimiser could not turn into a frame
        // slot -- is the last thing the bump pointer handed out, so giving
        // the bytes straight back means the next allocation reuses the same
        // address through the fast path and the heap does not move at all.
        //
        // The cost is restoring the fast path's one assumption: memory above
        // the bump pointer has never been written, so allocation zeroes
        // nothing. The bytes are cleared here instead, which is why only
        // small blocks take this road -- clearing a megabyte on the way past
        // would be a worse bargain than a bin.
        if ((SkippedFreePaths & 36) == 0 && holder == 0 && _current != 0 && block + size == _bump && size <= ExactLimit
            && block >= HeapChunks.First(_current))
        {
            ZeroWords(block, _bump);
            _bump = block;
            SyncEnd();
            // The recycling walk resumes at a block start. Left above the
            // lowered bump pointer, it would lie inside whatever is carved
            // there next, and read that as blocks.
            if (_recycle == _current && _recycleAt > _bump)
            {
                _recycleAt = _bump;
            }
            GcLock.Exit();
            return;
        }
        if ((SkippedFreePaths & 16) == 0)
        {
            Merge(block);
        }
        GcLock.Exit();
    }

    /// THE COMMON FREE, IN WORDS AND FIRST: a block of a size-class page the
    /// freeing thread owns, put on that thread's own list for its class,
    /// with no lock. The same as the free below of a block of the thread's
    /// own page (and its checks), found the way the marker finds a page's
    /// block (PageBlock): the page by the 4 KB table, the class by the page,
    /// the grid by the class's reciprocal. Where it went through a region
    /// test, the allocator and lock tests, a dozen flags in longs, and then
    /// looked for the page among every class the thread holds -- each a
    /// 64-bit compare -- and tested the grid with a division. False for
    /// anything else, which the rest of Free takes as before: a block not on
    /// a page this thread owns, a collection under way, any of the checking
    /// or logging modes (FastFreeMask), the heap lock held or the allocator
    /// interrupted on this thread (Tls.InAlloc), no class cache.
    static bool FreeOwnBlock(nuint at)
    {
        nuint slots = HeapChunks.SlotTable;
        nuint tb = Sys.ThreadBlock();
        if (FastFreeMask == 0 || slots == 0 || (at & 7) != 0 || tb == 0 || Sys.ReadAddress(tb + Tls.InAlloc) != 0)
        {
            return false;
        }
#if TARGET_64BIT
        // OUTSIDE THE TABLE'S WINDOW (HeapChunks.SlotLow) the table says
        // nothing, and the rest of Free finds the block's chunk by the
        // index. On i386 the window is every address, and the span a word
        // cannot hold.
        if (!HeapChunks.InSlotWindow(at))
        {
            return false;
        }
#endif
        nuint words = GcLock.Words();
        if (words != 0 && Sys.ReadAddress(words + GcLock.Held) == tb)
        {
            return false;
        }
        // IN THE ALLOCATOR BEFORE A COLLECTION'S FLAGS ARE READ, as the rest
        // of Free is: a handshake that lands between the two answers STAMP,
        // and its StampPages writes the start of the block about to be freed
        // here. Freed with the flags read before it, the block went back on
        // this thread's list with the snapshot's start, the next object made
        // in it was taken for the snapshot's -- and, held only by objects
        // made since, never marked and swept under them (the NT kernel's
        // address spaces losing their reservation lists and locks).
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        if (Runtime.Marking != 0 || _sweeping || _collecting)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return false;
        }
        nuint page = Sys.ReadAddress(slots + (at >> 12) * WordSize.Bytes);
        nuint cls = page == 0 ? 0 : Sys.ReadAddress(page + (nuint)HeapChunks.ClassAt);
        if (cls == 0 || Sys.ReadAddress(page + (nuint)HeapChunks.OwnerAt) != tb)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return false;
        }
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        nuint c = cls - 1;
        nuint slot = cache + c * (nuint)(2 * WordSize.Bytes);
        nuint block = PageBlock(page, at, cls);
        nuint size = block == 0 ? 0 : Sys.ReadAddress(block) & ~(nuint)7;
        // ITS OWN PAGE IN ITS OWN CACHE, the block whole -- live, the class's
        // size, on the grid (PageBlock), and the payload's start: a pointer
        // into the middle of one is no object handed to a free.
        if (cache == 0 || Sys.ReadAddress(slot) != page || block == 0 || block + HeaderBytes != at
            || (Sys.ReadAddress(block) & FlagFree) != 0)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            return false;
        }
        ZeroWords(block + HeaderBytes, block + size);
        Sys.WriteAddress(block, size | FlagFree);
        Sys.WriteAddress(block + KindAt, Sys.ReadAddress(slot + WordSize.Bytes));
        Sys.WriteAddress(slot + WordSize.Bytes, block);
        Frees = Frees + 1;
        FreedBytes = FreedBytes + (long)size;
        Sys.WriteAddress(tb + Tls.InAlloc, 0);
        return true;
    }

    /// All ones but while a free must take the long way for what it checks or
    /// says: the heap check, the checked frees (_verify, VerifyingFieldFrees),
    /// the sampler's tracking, the free log, ignored or skipped free paths,
    /// and before the heap starts (FastPathsChanged).
    public static nuint FastFreeMask;

    /// How many calls to Free actually returned a block. A test reads it to
    /// tell a free that happened from one that was ignored.
    public static long Frees;

    // CHECKED MODE FOR THE COMPILER'S FREES (Platform.VerifyFrees; on Linux,
    // the image's Corsac.GC.VerifyFrees knob). A free is otherwise quiet
    // about what it is handed and gives the bytes straight back, so a wrong
    // one -- an object still in use, one freed twice -- reads as a working
    // program until the bytes happen to be taken again. Checked, a freed
    // block is never given back: its payload is filled with a pattern no
    // pointer has and it becomes a leaf the collector reclaims once nothing
    // reaches it. A read after the free finds the pattern (and a pointer read
    // through it faults) instead of whatever came next; a second free of it
    // is reported and ends the process with 97. A pointer that is not an
    // object at all -- static data a reassigned variable held -- is ignored,
    // as it always is.
    //
    // ASKED ONCE, IN Start, at the first allocation: the image's knobs say
    // the same for the whole run, and a free is no place to walk them.
    static bool _verify;
    /// Which frees are ignored (Corsac.GC.IgnoreFrees, Platform.IgnoreFrees): 0
    /// none; 'p', 'f' or 'r' one kind, which Runtime asks; anything else all.
    public static long IgnoredFrees;

    /// The free paths skipped (Corsac.GC.FreePaths, Platform.SkippedFreePaths): t 1, i 2, b 4, d 8, m 16;
    /// p 32 poisons every block freed (and skips t and b).
    static long SkippedFreePaths;

    /// The same, set by a program after the heap has started -- a kernel from
    /// its command line (gc.freepaths=N) -- to find which path a fault needs.
    /// The compiler's frees of one kind left undone, as the Linux platform's
    /// Corsac.GC.IgnoreFrees letter says ('r' owned variables and outgrown
    /// collection storage, 'f' field frees, 'p' the region paths), turned on
    /// by a program after the heap has started -- a kernel from its command
    /// line (gc.ignorefrees=r): the bisection of a block freed under a holder.
    public static void IgnoreFrees(long letter)
    {
        GcLock.Enter();
        IgnoredFrees = letter;
        FastPathsChanged();
        GcLock.Exit();
    }

    public static void SkipFreePaths(long paths)
    {
        GcLock.Enter();
        SkippedFreePaths = paths;
        FastPathsChanged();
        GcLock.Exit();
    }

    /// Released chunks guarded rather than unmapped (Corsac.GC.GuardReleases).
    public static bool GuardReleases;
    const uint Poison = 0xFEEEFEEE;

    /// How many blocks the checked mode has taken back and filled.
    public static long VerifiedFrees;

    static bool Verifying()
    {
        return _verify;
    }

    /// The checked mode for the compiler's frees (VerifyFree), turned on by
    /// a program after the heap has started -- a kernel from its command
    /// line (gc.checkfrees=1). From here on nothing freed is handed out
    /// again: each free poisons the block and records who freed it, and a
    /// second free of it is reported with both callers.
    public static void CheckFrees()
    {
        GcLock.Enter();
        if (!_verify)
        {
            _verify = true;
            if (_quarantine == 0) StartQuarantine();
            // WHO MADE EACH BLOCK, AND WHO FREED IT (Sites): every allocation
            // from here on, through the allocation hook where no sampler has
            // it already, which takes every allocation off the fast paths.
            if (Runtime.AllocHook == 0 && _sites == 0) StartSites();
            if (_sites != 0 && Runtime.AllocHook == 0)
            {
                Runtime.AllocHookEvery = true;
                Runtime.AllocHook = Sys.AddressOf(RecordAllocSite);
            }
        }
        FastPathsChanged();
        GcLock.Exit();
    }

    /// The checked mode for the compiler's FIELD frees alone (FreeField ->
    /// FreeFieldChecked), turned on after the heap has started -- a kernel
    /// from its command line (gc.checkfields=1): each block an owned field
    /// gave back is poisoned and kept, with who made it and who freed it,
    /// and a write into it after its free is reported. Fewer than every
    /// free, so its quarantine fits where gc.checkfrees=1's does not.
    public static void CheckFieldFrees(nuint keptBytes)
    {
        GcLock.Enter();
        if (!VerifyingFieldFrees)
        {
            VerifyingFieldFrees = true;
            _quarantineCap = keptBytes;
            if (_quarantine == 0) StartQuarantine();
            if (Runtime.AllocHook == 0 && _sites == 0) StartSites();
            if (_sites != 0 && Runtime.AllocHook == 0)
            {
                Runtime.AllocHookEvery = true;
                Runtime.AllocHook = Sys.AddressOf(RecordAllocSite);
            }
        }
        FastPathsChanged();
        GcLock.Exit();
    }

    // ---- who made each block and who freed it, in the checked mode ----
    //
    // A REPORT NAMING A BLOCK IS ONLY HALF AN ANSWER without the code that
    // made it and the code that gave it back. The freed block's own last
    // words hold its freeing calls (VerifyFree), but a block of two words has
    // room for none, and nothing kept who made it. So, checking, a table
    // keyed by block holds both: four return addresses of the allocating
    // calls, five of the freeing ones. Fixed in size and lossy (a slot taken
    // by a later block is overwritten), outside the heap and no root: what
    // it holds keeps nothing alive.
    const int SiteSlots = 65536, SiteWords = 10;
    static nuint _sites;

    static void StartSites()
    {
        nuint table = Platform.Map(SiteSlots * SiteWords * WordSize.Bytes);
        if (table != 0) _sites = table;
    }

    static nuint SiteEntry(nuint at, bool make)
    {
        if (_sites == 0 || at == 0) return 0;
        nuint h = ((at >> 3) * 40503) & (SiteSlots - 1);
        nuint empty = 0;
        for (nuint probe = 0; probe < 8; probe++)
        {
            nuint e = _sites + ((h + probe) & (SiteSlots - 1)) * SiteWords * WordSize.Bytes;
            nuint key = Sys.ReadAddress(e);
            if (key == at) return e;
            if (key == 0 && empty == 0) empty = e;
        }
        if (!make) return 0;
        nuint slot = empty != 0 ? empty : _sites + h * SiteWords * WordSize.Bytes;
        for (nuint k = 1; k < SiteWords; k++) Sys.WriteAddress(slot + k * WordSize.Bytes, 0);
        Sys.WriteAddress(slot, at);
        return slot;
    }

    // The return addresses up the frame chain from `frame`, into words
    // first..first+count-1 of an entry.
    static void SiteFrames(nuint entry, nuint first, nuint count, nuint frame)
    {
        for (nuint k = 0; k < count; k++)
        {
            nuint word = entry + (first + k) * WordSize.Bytes;
            if (frame == 0) { Sys.WriteAddress(word, 0); continue; }
            Sys.WriteAddress(word, Sys.ReadAddress(frame + WordSize.Bytes));
            nuint next = Sys.ReadAddress(frame);
            frame = next != 0 && next > frame ? next : 0;
        }
    }

    /// The allocation hook while checking (Runtime.AllocHook): the block and
    /// the allocator's frame, from which the allocating calls are read.
    static nuint RecordAllocSite(nuint frameKind, nuint bytes, nuint at)
    {
        nuint entry = SiteEntry(at, true);
        if (entry == 0) return 0;
        SiteFrames(entry, 1, 4, frameKind & ~(nuint)3);
        for (nuint k = 5; k < SiteWords; k++) Sys.WriteAddress(entry + k * WordSize.Bytes, 0);
        return 0;
    }

    static void RecordFreeSite(nuint at)
    {
        nuint entry = SiteEntry(at, true);
        if (entry != 0) SiteFrames(entry, 5, 5, Sys.FramePointer());
    }

    /// What the table knows of the block at `at`, for a report.
    static void SaySites(nuint at, string what)
    {
        nuint entry = SiteEntry(at, false);
        if (entry == 0) return;
        Runtime.WriteLiteral(2, what);
        Runtime.WriteLiteral(2, " made by:\n");
        for (nuint k = 1; k < 5; k++) { nuint back = Sys.ReadAddress(entry + k * WordSize.Bytes); if (back != 0) Runtime.SayFrame(2, back); }
        if (Sys.ReadAddress(entry + 5 * WordSize.Bytes) == 0) return;
        Runtime.WriteLiteral(2, what);
        Runtime.WriteLiteral(2, " freed by:\n");
        for (nuint k = 5; k < SiteWords; k++) { nuint back = Sys.ReadAddress(entry + k * WordSize.Bytes); if (back != 0) Runtime.SayFrame(2, back); }
    }

    /// Corsac.GC.VerifyFrees=f: only field frees are checked (Runtime.FreeField).
    public static bool VerifyingFieldFrees;

    /// In the checked mode for field frees, an ordinary free of a block a
    /// field free already took -- poisoned and kept -- is the same object
    /// freed twice: unchecked, both frees give the block back, and two
    /// allocations are handed one piece of memory. Reported with the field
    /// free's sites and this one's, and fatal (96).
    static void ReportFreedAgain(nuint block, nuint at)
    {
        nuint end = block + SizeOfBlock(block) - FooterBytes;
        if (Sys.ReadAddress(block + KindAt) != KindLeaf || Sys.Read32(at) != Poison || (at + 4 < end && Sys.Read32(at + 4) != Poison))
        {
            return;
        }
        SayNumber("gc: checked field free: the block is freed again, block ", at);
        SayNumber("gc:   size ", SizeOfBlock(block));
        SaySites(at, "gc:   the block was");
        Runtime.WriteLiteral(2, "gc: first freed as a field by:\n");
        nuint site = end - 4;
        while (site >= at + 8)
        {
            nuint first = Sys.Read32(site);
            if (first == Poison || first == 0)
            {
                break;
            }
            Runtime.SayFrame(2, first + 0x08000000);
            site = site - 4;
        }
        Runtime.WriteLiteral(2, "gc: freed again by:\n");
        Runtime.SayTrace(2, Sys.FramePointer());
        Platform.Exit(96);
    }

    /// A field free in the checked mode for field frees: poisoned and kept,
    /// its free recorded in it, under the heap lock.
    public static void FreeFieldChecked(nuint at)
    {
        if (at == 0 || GcLock.HeldByMe())
        {
            return;
        }
        GcLock.Enter();
        VerifyFree(at);
        GcLock.Exit();
    }

    // THE LAST FREES KEPT, in the checked mode. A block freed twice is found
    // by its pattern only while it is still the freed block: once the
    // collector has taken it back and handed it out again, a second free
    // lands on the new object -- a list's array, taken from under the list --
    // and nothing can tell. So the blocks freed last stay out of the
    // collector's hands: a ring of their addresses is a root range, and a
    // block leaves the ring only when later frees have pushed it out --
    // sixteen million of them, more than a compile of a
    // large unit makes, so a free that comes long after the block's first
    // is caught too; the ring is mapped lazily and only this mode has one.
    // Its first word counts the frees.
    // Four million when only the field frees are checked, which are fewer.
    // A plain field set in StartQuarantine: the collector has no static
    // initialiser to run.
    const int QuarantineAll = 16777216;
    const int QuarantineFields = 4194304;
    static nuint _quarantineEntries;
    static nuint _quarantine;

    static void StartQuarantine()
    {
        _quarantineEntries = _verify ? (nuint)QuarantineAll : QuarantineFields;
        _quarantineBudget = _verify ? (nuint)QuarantineAllBytes : QuarantineFieldBytes;
        // A KERNEL'S CAP (CheckFieldFrees): what a 128 MB machine can keep poisoned.
        if (_quarantineCap > 0 && _quarantineBudget > _quarantineCap) _quarantineBudget = _quarantineCap;
        // AND ITS RING TO MATCH: one entry for each smallest block the budget
        // can keep. Sixteen megabytes of ring, mapped and scanned as a root
        // range at every collection, were a 128 MB machine's whole margin.
        if (_quarantineCap > 0 && _quarantineEntries > _quarantineBudget / Smallest) _quarantineEntries = _quarantineBudget / Smallest;
        nuint bytes = (_quarantineEntries + 1) * WordSize.Bytes;
        nuint ring = Platform.Map(bytes);
        if (ring != 0 && Runtime.RegisterRoots(ring + WordSize.Bytes, ring + bytes))
        {
            _quarantine = ring;
        }
    }

    // AND BY BYTES: the blocks kept are the latest up to a budget, the
    // oldest let go past it. Kept by count alone, the field frees -- arrays,
    // most of them -- filled a 32-bit heap's address space. Always called
    // with the heap lock held, so the ring's counts are plain words.
    // 384 MB checking every free, 128 MB checking field frees only: a
    // second free comes soon after the first, and the heap needs the room.
    const int QuarantineAllBytes = 402653184;
    const int QuarantineFieldBytes = 134217728;
    static nuint _quarantineBudget;
    static nuint _quarantineCap;
    static nuint _quarantineHead;
    static nuint _quarantineCount;
    static nuint _quarantineBytes;

    static void Quarantine(nuint at)
    {
        if (_quarantine == 0)
        {
            return;
        }
        nuint size = Sys.ReadAddress(at - HeaderBytes) & SizeMask;
        while (_quarantineCount > 0 && (_quarantineCount == _quarantineEntries || _quarantineBytes + size > _quarantineBudget))
        {
            nuint oldest = _quarantine + WordSize.Bytes + _quarantineHead * WordSize.Bytes;
            nuint held = Sys.ReadAddress(oldest);
            Sys.WriteAddress(oldest, 0);
            _quarantineBytes = _quarantineBytes - (Sys.ReadAddress(held - HeaderBytes) & SizeMask);
            _quarantineHead = (_quarantineHead + 1) % _quarantineEntries;
            _quarantineCount = _quarantineCount - 1;
        }
        nuint slot = (_quarantineHead + _quarantineCount) % _quarantineEntries;
        Sys.WriteAddress(_quarantine + WordSize.Bytes + slot * WordSize.Bytes, at);
        _quarantineCount = _quarantineCount + 1;
        _quarantineBytes = _quarantineBytes + size;
        Sys.WriteAddress(_quarantine, Sys.ReadAddress(_quarantine) + 1);
    }

    /// In the checked mode, a field free (Runtime.FreeField) whose OWNER has
    /// already been freed: the field is read out of a block that belongs to
    /// nobody -- to whoever was handed it next, when frees are not checked --
    /// and what it holds is freed. Reported with both frees, and fatal (98).
    public static void VerifyFieldOwner(nuint owner, nuint offset)
    {
        if (!_verify || owner == 0 || GcLock.HeldByMe())
        {
            return;
        }
        // Under the heap lock: the chunk index is not read without it.
        GcLock.Enter();
        nuint block = ValidAllocated(owner);
        nuint end = block == 0 ? 0 : block + SizeOfBlock(block) - FooterBytes;
        bool freed = block != 0 && Sys.ReadAddress(block + KindAt) == KindLeaf && Sys.Read32(owner) == Poison
            && (owner + 4 >= end || Sys.Read32(owner + 4) == Poison);
        GcLock.Exit();
        if (!freed)
        {
            return;
        }
        SayNumber("gc: checked free: a field freed out of an owner already freed, owner ", owner);
        SayNumber("gc:   field offset ", offset);
        Runtime.WriteLiteral(2, "gc: the owner was freed by:\n");
        nuint site = end - 4;
        while (site >= owner + 8)
        {
            nuint first = Sys.Read32(site);
            if (first == Poison || first == 0)
            {
                break;
            }
            Runtime.SayFrame(2, first + 0x08000000);
            site = site - 4;
        }
        Runtime.WriteLiteral(2, "gc: its field is freed now by:\n");
        Runtime.SayTrace(2, Sys.FramePointer());
        Platform.Exit(98);
    }

    // THE HEAP CHECKED (Corsac.GC.HeapCheck): as every collection begins (0)
    // and ends (1), with the heap lock held. Every chunk's blocks walked from
    // its first to its end, stepping over the buffers threads are bumping in:
    // each a size that fits, a header its footer agrees with; each listed free
    // block counted. Every thread's buffer walked from its base to its bump
    // pointer the same way. Every free list walked, each node a whole free
    // block of its bin (IndexBlock), linked both ways. What the walks counted
    // listed must be what the lists hold. The first faults are said, and the
    // process ends with 94. A diagnostic: it walks the whole heap twice a
    // collection.
    // Public for Runtime.AllocFast, which leaves a checked heap's guards to AllocWord.
    public static bool _heapCheck;
    static long _badFrees;

    /// The heap check (CheckHeap, before and after every collection) turned
    /// on by a program after the heap has started -- a kernel from its
    /// command line (gc.heapcheck=1).
    // ---- revoking a kernel module's objects ------------------------------------
    //
    // A module forced out while objects of its types are still alive
    // (docs/software/DRIVERS.md, "Forced") leaves vtables and descriptors that
    // are about to be unmapped. Every such object is TOMBSTONED at the start
    // of a collection, with the heap lock held and no cycle under way: its
    // vtable word points at a Revoked table -- a descriptor that is no type's,
    // so every cast and type test of it fails, and a vtable whose every slot
    // calls Revoked, which hands the caller to the platform to be ended
    // (Platform.Revoked: a kernel kills the thread or crashes the program; a
    // program on Linux dies) -- and its block becomes one the collector reads
    // word by word, as it reads a struct's (KindAt 0). So the object keeps its
    // size and everything it refers to is kept for as long as it is: kernel
    // code that still holds it as a base class it knows reads fields that are
    // good. Its own descriptor is never read again, and the collector frees it
    // once nothing refers to it.
    //
    // THE TABLE IS AS LONG AS THE LONGEST VTABLE OF THE MODULE (Revoke's
    // `slots`): an interface's methods are numbered over every interface the
    // program declares, so a module's vtables run to thousands of slots, and
    // a call through a slot past the table's end would jump wherever the
    // word after it pointed. A longer table is made for a module that needs
    // one; the older ones stay, for the objects already pointing at them.
    //
    // QUARANTINED RANGES (Quarantine): a kernel tells the collector which
    // addresses are a module's that was forced out, unmapped and not to be
    // reused. Every read of an object's descriptor first asks whether its
    // vtable lies in one, and reads such an object word by word instead --
    // the fault the read would take is in the collector, with nobody to end
    // but the machine. None should be found: the kernel unmaps a module's
    // code before its objects are tombstoned, so nothing can make one after
    // the walk. A later Revoke tombstones any that are, all the same.

    static nuint _revokeLow, _revokeHigh, _revokedTable, _revokedSlots, _revokeSlots, _revokedCount;
    static bool _revokeCountOnly;
    const int RevokedSlotsLeast = 1024;
    // The class display's length: deeper than any class chain is.
    const int RevokedDepth = 256;
    const int DescNameWord = 0;

    /// Every object whose vtable is in [low, high) tombstoned; how many, or
    /// -1 when no collection could be made (CollectMade): nothing was.
    /// Runs a full collection to do it.
    public static long Revoke(nuint low, nuint high)
    {
        return Revoke(low, high, 0);
    }

    /// The same, with a Revoked table of at least `slots` vtable slots: the
    /// longest vtable of a type in [low, high).
    /// The range is set before the collection is asked for: one another
    /// thread has under way may see it part way, and tombstone what it
    /// finds then; refused (-1), what it did is not counted.
    public static long Revoke(nuint low, nuint high, nuint slots)
    {
        if (high <= low) return 0;
        _revokedCount = 0;
        _revokeSlots = slots;
        _revokeLow = low;
        _revokeHigh = high;
        bool made = CollectMade();
        _revokeLow = 0;
        _revokeHigh = 0;
        return made ? (long)_revokedCount : -1;
    }

    /// How many objects not yet freed have their vtable in [low, high),
    /// touching none: whether a module is free of objects of its types
    /// before its image goes. Runs a full collection first, so garbage of
    /// its types has been swept and what is counted is what lived through
    /// one. -1 when no collection could be made (CollectMade).
    public static long CountIn(nuint low, nuint high)
    {
        if (!CollectMade()) return -1;
        _revokeCountOnly = true;
        try { return Revoke(low, high); }
        finally { _revokeCountOnly = false; }
    }

    /// Where every slot of the Revoked table leads.
    static void Revoked()
    {
        Platform.Revoked();
    }

    static nuint RevokedVtable(nuint slots)
    {
        const int w = WordSize.Bytes;
        if (slots < RevokedSlotsLeast) slots = RevokedSlotsLeast;
        if (_revokedTable != 0 && slots <= _revokedSlots) return _revokedTable + DescWords * w;
        // The descriptor, the vtable after it, and a class display of
        // RevokedDepth zeros after that.
        nuint bytes = (DescWords + slots + RevokedDepth) * w;
        nuint table = Platform.Map(bytes);
        if (table == 0) return _revokedTable != 0 && _revokedSlots >= slots ? _revokedTable + DescWords * w : 0;
        Sys.MemorySet(table, 0, bytes);
        // The descriptor names itself, as every one does (the census and the
        // type tests check it), and is no type: as deep in a class chain as
        // any type can be, so the compiler's inline test of a class reads
        // its display at the class's depth, and every entry of the display is
        // 0, which is no class. No interfaces, no element, no references (the
        // block is read word by word, never through this). Its name is one
        // of the runtime's own strings, never the module's.
        string name = "Revoked";
        Sys.WriteAddress(table + DescNameWord * w, Sys.ReadAddress(Sys.AddressOf(ref name)));
        Sys.WriteAddress(table + DescSelfWord * w, table);
        Sys.WriteAddress(table + DescDepthWord * w, RevokedDepth - 1);
        Sys.WriteAddress(table + DescDisplayWord * w, table + (DescWords + slots) * w);
        nuint stub = Sys.AddressOf(Revoked);
        for (nuint i = 0; i < slots; i++) Sys.WriteAddress(table + (DescWords + i) * w, stub);
        _revokedTable = table;
        _revokedSlots = slots;
        return table + DescWords * w;
    }

    /// One block of the walk: tombstoned, counted, or handed to a visitor.
    static void AtStart(nuint block, nuint vtable)
    {
        if ((Sys.ReadAddress(block) & FlagFree) != 0 || Sys.ReadAddress(block + KindAt) != KindObject) return;
        nuint vt = Sys.ReadAddress(block + HeaderBytes);
        if (_visiting)
        {
            if (_visitOne != 0 && vt == _visitOne)
            {
                _visited = _visited + 1;
                Sys.Call(_visitOneBy, block + HeaderBytes, 0, 0);
            }
            for (nuint i = 0; i < _visitCount; i++)
            {
                // A pair with a 0 word is passed by: a vtable of 0 matches
                // an object half made, a visitor of 0 is no call.
                nuint by = Sys.ReadAddress(_visitPairs + (i * 2 + 1) * WordSize.Bytes);
                if (vt == 0 || by == 0 || Sys.ReadAddress(_visitPairs + i * 2 * WordSize.Bytes) != vt) continue;
                _visited = _visited + 1;
                Sys.Call(by, block + HeaderBytes, 0, 0);
            }
            return;
        }
        if (_revokeHigh == 0) return;
        bool mine = vt >= _revokeLow && vt < _revokeHigh;
        // One a module forced out earlier made after its walk: there should
        // be none (see above), and one found is tombstoned with these.
        if (!mine && (_revokeCountOnly || !InQuarantine(vt))) return;
        _revokedCount = _revokedCount + 1;
        if (_revokeCountOnly) return;
        Sys.WriteAddress(block + HeaderBytes, vtable);
        Sys.WriteAddress(block + KindAt, 0);
    }

    /// The walk CheckHeap makes -- every chunk's chain, every thread's
    /// buffer up to its pointer -- with the heap lock held: at the start of
    /// a collection, tombstoning (Revoke) and counting (CountIn) as it
    /// goes; or visiting alone (VisitInstances, _visiting), at any time.
    static void WalkAtStart()
    {
        nuint vtable = 0;
        if (!_visiting && _revokeHigh != 0 && !_revokeCountOnly)
        {
            vtable = RevokedVtable(_revokeSlots);
            if (vtable == 0) return;
        }
        _heapCheckTable = GcThreads.Sized(_heapCheckTable, ref _heapCheckTableFor);
        if (_heapCheckTable == 0) return;
        nuint buffers = GcThreads.CaptureBuffersInto(_heapCheckTable);
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            // A SIZE-CLASS PAGE is laid out whole in blocks of its class's
            // size, free or not, whether or not a thread is allocating from
            // it now: stepped through by size to its limit.
            if (HeapChunks.PageClass(chunk) != 0)
            {
                // To the end of what is laid out (FormatPage lays a page out
                // as it goes), not its limit: past that nothing is a block,
                // and reading there maps a page for nothing.
                nuint size = ClassSize(HeapChunks.PageClass(chunk) - 1);
                nuint limit = HeapChunks.End(chunk);
                for (nuint at = HeapChunks.First(chunk); at + size <= limit; at = at + size)
                {
                    if ((Sys.ReadAddress(at) & SizeMask) != size) break;
                    AtStart(at, vtable);
                }
                chunk = HeapChunks.Next(chunk);
                continue;
            }
            nuint block = HeapChunks.First(chunk);
            nuint end = ChunkEndNow(chunk);
            nuint step = 0;
            while (block < end)
            {
                while (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) < block) step = step + 1;
                if (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) == block)
                {
                    block = Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    step = step + 1;
                    continue;
                }
                nuint size = Sys.ReadAddress(block) & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end)) break;
                AtStart(block, vtable);
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
        for (nuint i = 0; i < buffers; i++)
        {
            nuint at = Sys.ReadAddress(_heapCheckTable + i * (2 * WordSize.Bytes));
            nuint upto = GcThreads.BufferPointer(at);
            while (at < upto)
            {
                nuint word = Sys.ReadAddress(at);
                nuint size = word & SizeMask;
                if (word == 0 || size < LeastBlock || Beyond(at, size, upto)) break;
                AtStart(at, vtable);
                at = at + size;
            }
        }
    }

    // ---- every object of some types, visited ------------------------------------
    //
    // A kernel that killed a thread finds the locks it left held this way
    // (every IrqSpinLock and KernelGate on the heap, os/kernel/arch/x86/
    // modules.cor): a walk of the heap with the heap lock held, every object
    // whose vtable is one asked for handed to that one's visitor. The
    // visitor must not allocate, take the heap lock or wait.
    //
    // NO COLLECTION, AND NO WAIT FOR ONE. The walk is CheckHeap's, sound at
    // any point of another thread's cycle: the sweep takes the lock chunk by
    // chunk (SweepWhileTheyRun), so each chunk is walked whole, swept or not,
    // and the mark changes a header's flags, never its size. Run as a full
    // collection, it waited out a cycle another thread was making, and on
    // one processor a caller that may not be preempted -- the kernel letting
    // go of a killed thread's locks, its count raised -- spun for ever while
    // that cycle's collector, yielded between budgets, never ran again. The
    // heap lock is still taken, and a collection made alone holds it to its
    // end: one that may not give the processor away there (YieldHook) holds
    // it for no longer than its work. An object no longer reachable and not
    // yet swept is visited too.

    static bool _visiting;
    static nuint _visitOne, _visitOneBy;    // one type: its vtable and visitor
    static nuint _visitPairs, _visitCount;  // several: pairs of words, how many
    static nuint _visited;

    /// `visitor(payload)` called for every object whose vtable is `vtable`;
    /// how many there were, or -1 when no walk could be made: the heap lock
    /// is this thread's already (an interrupt on top of the allocator), or
    /// there was no room for the table of buffers. The heap lock is held
    /// during the walk, and a visitor must not fault: it would be left held.
    public static long VisitInstances(nuint vtable, nuint visitor)
    {
        if (vtable == 0 || visitor == 0) return 0;
        return Visit(vtable, visitor, 0, 0);
    }

    /// The same for several types in one walk: `count` pairs of words at
    /// `pairs`, a vtable and its visitor each, read during the walk. How
    /// many objects were visited.
    public static long VisitInstancesOf(nuint pairs, nuint count)
    {
        if (pairs == 0 || count == 0) return 0;
        return Visit(0, 0, pairs, count);
    }

    static long Visit(nuint one, nuint oneBy, nuint pairs, nuint count)
    {
        if (!HeapChunks.Any()) return 0;
        // The heap lock this thread holds already would be taken again.
        if (GcLock.HeldByMe()) return -1;
        GcLock.Enter();
        _visitOne = one;
        _visitOneBy = oneBy;
        _visitPairs = pairs;
        _visitCount = count;
        _visited = 0;
        _visiting = true;
        WalkAtStart();
        _visiting = false;
        _visitOne = _visitOneBy = _visitPairs = _visitCount = 0;
        // No table of buffers, no walk (WalkAtStart): said, not counted 0.
        long visited = _heapCheckTable != 0 ? (long)_visited : -1;
        GcLock.Exit();
        return visited;
    }

    // ---- quarantined ranges ------------------------------------------------------

    const int QuarantinedMax = 32;
    // OF THE PLATFORM'S MEMORY, which no collection reads: the hull of them
    // all, then QuarantinedMax pairs (low, high). Kept in statics, the hull's
    // low bound was a word pointing into the range, counted by
    // CountReferencesInto as a reference -- the runtime's own, and the count
    // that lets a forced-out module's range go back never reached 0.
    static nuint _quarantined;
    static bool _anyQuarantined;        // whether the hull holds anything: the one load the hot paths pay

    static nuint QuarantinedPair(nuint i) => _quarantined + (i + 1) * 2 * WordSize.Bytes;

    /// [low, high) is a module's, forced out: its descriptors are unmapped
    /// and an object whose vtable is there is read word by word. False when
    /// the table is full.
    public static bool Quarantine(nuint low, nuint high)
    {
        if (high <= low) return false;
        if (_quarantined == 0)
        {
            _quarantined = Platform.Map((QuarantinedMax + 1) * 2 * WordSize.Bytes);
            if (_quarantined == 0) return false;
            Sys.MemorySet(_quarantined, 0, (QuarantinedMax + 1) * 2 * WordSize.Bytes);
        }
        for (nuint i = 0; i < QuarantinedMax; i++)
        {
            nuint at = QuarantinedPair(i);
            if (Sys.ReadAddress(at + WordSize.Bytes) != 0) continue;
            Sys.WriteAddress(at, low);
            Sys.WriteAddress(at + WordSize.Bytes, high);
            Hull();
            return true;
        }
        return false;
    }

    /// [low, high) given back: its addresses may be anybody's again.
    public static void Unquarantine(nuint low, nuint high)
    {
        if (_quarantined == 0) return;
        for (nuint i = 0; i < QuarantinedMax; i++)
        {
            nuint at = QuarantinedPair(i);
            if (Sys.ReadAddress(at) != low || Sys.ReadAddress(at + WordSize.Bytes) != high) continue;
            Sys.WriteAddress(at + WordSize.Bytes, 0);
            Sys.WriteAddress(at, 0);
        }
        Hull();
    }

    static void Hull()
    {
        nuint low = 0, high = 0;
        for (nuint i = 0; i < QuarantinedMax; i++)
        {
            nuint at = QuarantinedPair(i);
            nuint h = Sys.ReadAddress(at + WordSize.Bytes);
            if (h == 0) continue;
            nuint l = Sys.ReadAddress(at);
            if (high == 0 || l < low) low = l;
            if (h > high) high = h;
        }
        // Low first: a reader that sees the new high with the old low asks
        // the table, which is right either way.
        Sys.WriteAddress(_quarantined, low);
        Sys.WriteAddress(_quarantined + WordSize.Bytes, high);
        _anyQuarantined = high != 0;
    }

    /// Whether `address` is in a quarantined range. One load and a branch
    /// when there is none, which is always outside a kernel that has forced
    /// a module out.
    public static bool InQuarantine(nuint address)
    {
        if (!_anyQuarantined || address >= Sys.ReadAddress(_quarantined + WordSize.Bytes) || address < Sys.ReadAddress(_quarantined)) return false;
        for (nuint i = 0; i < QuarantinedMax; i++)
        {
            nuint at = QuarantinedPair(i);
            if (address >= Sys.ReadAddress(at) && address < Sys.ReadAddress(at + WordSize.Bytes)) return true;
        }
        return false;
    }

    // ---- what is held of a module's types from outside it ----------------------
    //
    // A PLAIN rmmod asks whether anything outside the module holds an object
    // of its types, and must leave the module working when something does.
    // A collection run without its statics as roots would answer, and free
    // what only its statics held -- under statics it is about to need again.
    // So the answer is had in two phases of ONE collection (CountHeld):
    //
    //   1. The module's statics are not a root (the registered range that
    //      starts at `rootFrom` is passed over), and the objects the kernel
    //      holds of it on purpose -- its drivers and buses, registered in the
    //      kernel's tables -- are marked before anything else and not
    //      scanned, so nothing is reached through them. When the mark is
    //      over, every marked object of its types is held from outside it,
    //      and counted.
    //   2. Then the statics and those objects are scanned and the mark run
    //      to its end again, so what they hold is kept, and the sweep frees
    //      only what nothing at all holds.
    //
    // Only a major cycle counts, and only the cycle that began after it was
    // asked for: one already under way had read its roots before.

    static nuint _heldLow, _heldHigh, _heldRootFrom, _heldRootTo;
    static nuint _heldExempt, _heldExempts;
    static nuint _heldCycle;
    static long _heldFound;
    static long _heldPhase;             // 0 none, 1 asked, 2 counted

    /// How many objects whose vtable is in [low, high) are held other than
    /// through the root range [rootFrom, rootTo) and the objects at the
    /// payload addresses in `exempt`; -1 when no collection could tell.
    public static long CountHeld(nuint low, nuint high, nuint rootFrom, nuint rootTo, nuint[] exempt)
    {
        if (high <= low) return 0;
        for (int tries = 0; tries < 4; tries++)
        {
            _heldLow = low;
            _heldHigh = high;
            _heldRootFrom = rootFrom;
            _heldRootTo = rootTo;
            _heldExempt = Sys.ArrayData(exempt);
            _heldExempts = (nuint)exempt.Length;
            _heldCycle = 0;
            _heldFound = 0;
            _heldPhase = 1;
            Collect();
            long phase = _heldPhase;
            _heldPhase = 0;
            _heldCycle = 0;
            _heldExempts = 0;
            _heldExempt = 0;
            Sys.KeepAlive(exempt);
            if (phase == 2) return _heldFound;
        }
        return -1;
    }

    /// Whether the registered root range starting at `start` is passed over
    /// in this cycle's roots (CountHeld's phase 1).
    public static bool PassedOver(nuint start)
    {
        return _heldPhase == 1 && _heldCycle == _cycle && start == _heldRootFrom;
    }

    /// The cycle about to begin is the one that counts, when one was asked
    /// for and none has taken it yet. With the heap lock, as a cycle starts.
    static void ClaimHeldCycle()
    {
        if (_heldPhase == 1 && _heldCycle == 0 && !_minor) _heldCycle = _cycle + 1;
    }

    /// Phase 1's marks: the exempt objects marked and taken as scanned, so
    /// the mark never goes through them. After the cycle's marks were
    /// cleared and before its first root.
    static void MarkExempt()
    {
        if (_heldPhase != 1 || _heldCycle != _cycle) return;
        for (nuint i = 0; i < _heldExempts; i++)
        {
            nuint payload = Sys.ReadAddress(_heldExempt + i * WordSize.Bytes);
            if (payload == 0) continue;
            nuint block = BlockForPointer(payload);
            if (block != 0) SetFlag(block, FlagMark | FlagScan, TailOf(block));
        }
    }

    static bool Exempt(nuint payload)
    {
        for (nuint i = 0; i < _heldExempts; i++)
            if ((Sys.ReadAddress(_heldExempt + i * WordSize.Bytes)) == payload) return true;
        return false;
    }

    static void CountHeldBlock(nuint block)
    {
        nuint word = Sys.ReadAddress(block);
        if ((word & (FlagFree | FlagMark)) != FlagMark || Sys.ReadAddress(block + KindAt) != KindObject) return;
        nuint vt = Sys.ReadAddress(block + HeaderBytes);
        if (vt < _heldLow || vt >= _heldHigh || Exempt(block + HeaderBytes)) return;
        _heldFound = _heldFound + 1;
    }

    /// The end of phase 1: every marked object of the module's types that
    /// is not exempt counted, then the statics and the exempt objects
    /// scanned. True when it did so, and the mark must be run to its end
    /// again.
    static bool CountHeldAndKeep()
    {
        if (_heldPhase != 1 || _heldCycle != _cycle || _minor) return false;
        _heldFound = 0;
        if (_snapshots)
        {
            nuint which = 0;
            nuint chunk = HeapChunks.SnapshotChunk(0);
            while (chunk != 0)
            {
                nuint block = HeapChunks.StartsCycle(chunk) == _cycle ? HeapChunks.NextStart(chunk, HeapChunks.First(chunk)) : 0;
                while (block != 0)
                {
                    CountHeldBlock(block);
                    block = HeapChunks.NextStart(chunk, block + 8);
                }
                which = which + 1;
                chunk = HeapChunks.SnapshotChunk(which);
            }
        }
        else
        {
            nuint chunk = HeapChunks.Newest();
            while (chunk != 0)
            {
                nuint block = HeapChunks.First(chunk);
                nuint end = HeapChunks.PageClass(chunk) != 0 ? HeapChunks.Limit(chunk) : HeapChunks.End(chunk);
                while (block < end)
                {
                    nuint size = Sys.ReadAddress(block) & SizeMask;
                    if (size < LeastBlock || Beyond(block, size, end)) break;
                    CountHeldBlock(block);
                    block = block + size;
                }
                chunk = HeapChunks.Next(chunk);
            }
        }
        _heldPhase = 2;
        // Phase 2: what the statics and the exempt objects hold, kept.
        if (_heldRootTo > _heldRootFrom) ScanRootsAttributed(_heldRootFrom, _heldRootTo, 3, false);
        for (nuint i = 0; i < _heldExempts; i++)
        {
            nuint payload = Sys.ReadAddress(_heldExempt + i * WordSize.Bytes);
            if (payload == 0) continue;
            nuint block = BlockForPointer(payload);
            if (block != 0) ScanBlock(block, Sys.ReadAddress(block) & SizeMask, TailOf(block));
        }
        Drain();
        return true;
    }

    // ---- references into a range, counted ---------------------------------------
    //
    // Whether a quarantined range can be given back: a collection in which
    // every word the mark looks at that is not a heap block's address -- a
    // static, a stack slot, a field -- is counted when it points into the
    // range. A pointer held as a number in a field the descriptor says is a
    // number is not seen; nothing the kernel keeps of a module is held so.
    // The range is kept as one byte below it and its end, so that the
    // bounds themselves, in these statics, are not counted.

    static nuint _referencesBelow, _referencesEnd;
    static nuint _references;

    /// How many words the mark finds pointing into [low, high). Runs a full
    /// collection to know; -1 when none could be made (CollectMade).
    public static long CountReferencesInto(nuint low, nuint high)
    {
        if (high <= low) return 0;
        _references = 0;
        _referencesBelow = low - 1;
        _referencesEnd = high;
        bool made = CollectMade();
        _referencesEnd = 0;
        _referencesBelow = 0;
        return made ? (long)_references : -1;
    }

    /// WHO HOLDS WHAT POINTS INTO [low, high): a forced-out module's range
    /// kept by references CountReferencesInto counts but cannot name. After
    /// a collection, the statics and the ranges registered as roots are read
    /// word by word, and every block still allocated in the heap -- a
    /// thread's buffer stepped over, as the heap check steps over it -- and
    /// each word in the range is said, the first `max` of them, on standard
    /// error: "gc refs: static at X", "gc refs: root range word at X", or
    /// "gc refs: block B (N bytes) of TYPE at +OFFSET" -- only the words the
    /// marker reads as references (BlockReferencesInto). A stack or a register
    /// is no word read here: what the marking count finds that this does not
    /// is said as held by stacks or registers. Answers how many words were
    /// found. For finding what keeps a module; nothing calls it otherwise.
    public static long ReferencesIntoReport(nuint low, nuint high, long max)
    {
        if (high <= low || !_ready) return 0;
        long marked = CountReferencesInto(low, high);
        if (marked < 0) return -1;
        GcLock.Enter();
        if (!WaitOutAnyCycle())
        {
            GcLock.Exit();
            return -1;
        }
        long found = ReferencesInRange(Sys.DataStart(), Sys.DataEnd(), low, high, max, 0, "gc refs: static at ");
        nuint i = 0;
        while (GcRoots.ExtraTable() != 0 && i < GcRoots.ExtraCount())
        {
            nuint slot = GcRoots.ExtraTable() + i * (2 * WordSize.Bytes);
            nuint start = Sys.ReadAddress(slot);
            if (start != 0 && start != GcRoots.ClaimMark()) found = ReferencesInRange(start, Sys.ReadAddress(slot + WordSize.Bytes), low, high, max, found, "gc refs: root range word at ");
            i = i + 1;
        }
        _heapCheckTable = GcThreads.Sized(_heapCheckTable, ref _heapCheckTableFor);
        nuint buffers = _heapCheckTable != 0 ? GcThreads.CaptureBuffersInto(_heapCheckTable) : 0;
        for (nuint chunk = HeapChunks.Newest(); chunk != 0; chunk = HeapChunks.Next(chunk))
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = chunk == _current ? _bump : HeapChunks.End(chunk);
            if (end > HeapChunks.Limit(chunk) || end < block) continue;
            nuint step = 0;
            bool paged = HeapChunks.PageClass(chunk) != 0;
            while (block < end)
            {
                while (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) < block) step = step + 1;
                if (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) == block)
                {
                    block = Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    step = step + 1;
                    continue;
                }
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end)) break;
                if ((word & FlagFree) == 0) found = BlockReferencesInto(block, size, paged, low, high, max, found);
                block = block + size;
            }
        }
        GcLock.Exit();
        SayNumber("gc refs: words found in statics, roots and the heap ", found);
        SayNumber("gc refs: references the marking counted ", marked);
        return found;
    }

    /// THE WORDS OF A BLOCK THE MARKER READS AS REFERENCES, those into
    /// [low, high) said: none of a leaf's (a string, an array of numbers);
    /// an object's fields its descriptor's map names, an array's elements
    /// when they are references; every word of a block no descriptor
    /// describes, and of an object whose vtable is quarantined -- a forced-out
    /// module's own type, read word by word, as the marker reads it.
    static long BlockReferencesInto(nuint block, nuint size, bool paged, nuint low, nuint high, long max, long found)
    {
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        nuint end = paged ? block + size : block + size - FooterBytes;
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind == KindLeaf) return found;
        nuint vt = Sys.ReadAddress(payload);
        nuint desc = vt - DescWords * w;
        bool described = kind == KindObject && vt != 0 && !InQuarantine(vt) && (Sys.ReadAddress(desc + DescSelfWord * w)) == desc;
        if (!described)
        {
            for (nuint q = payload; q + w <= end; q = q + w) found = BlockWordInto(payload, size, q, low, high, max, found);
            return found;
        }
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0 || (Sys.ReadAddress(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0 || Sys.ReadAddress(desc + DescSizeWord * w) != w) return found;
            nuint count = Sys.ReadAddress(payload + ArrayCountAt) & 0x7FFFFFFF;
            nuint first = payload + Sys.ReadAddress(desc + DescPayloadWord * w);
            nuint last = first + count * w;
            if (last > end || last < first) return found;
            for (nuint q = first; q < last; q = q + w) found = BlockWordInto(payload, size, q, low, high, max, found);
            return found;
        }
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0) return found;
        nuint words = Sys.ReadAddress(map);
        for (nuint index = 0; index < words; index++)
        {
            nuint bits = Sys.ReadAddress(map + (1 + index / 32) * w) & 0xFFFFFFFF;
            if (((bits >> (int)(index & 31)) & 1) != 0 && payload + (index + 1) * w <= end)
                found = BlockWordInto(payload, size, payload + index * w, low, high, max, found);
        }
        return found;
    }

    static long BlockWordInto(nuint payload, nuint size, nuint q, nuint low, nuint high, long max, long found)
    {
        nuint word = Sys.ReadAddress(q);
        if (word < low || word >= high) return found;
        if (found < max)
        {
            SayNumber("gc refs: block ", payload);
            SayNumber("gc refs:   bytes ", size);
            SayNumber("gc refs:   at offset ", q - payload);
            SayNumber("gc refs:   pointing at ", word);
            SayHolderType(payload);
        }
        return found + 1;
    }

    static long ReferencesInRange(nuint from, nuint to, nuint low, nuint high, long max, long found, string what)
    {
        nuint p = (from + WordSize.Bytes - 1) & ~(nuint)(WordSize.Bytes - 1);
        while (p < to)
        {
            nuint w = Sys.ReadAddress(p);
            if (w >= low && w < high)
            {
                if (found < max)
                {
                    SayNumber(what, p);
                    SayNumber("gc refs:   pointing at ", w);
                }
                found = found + 1;
            }
            p = p + WordSize.Bytes;
        }
        return found;
    }

    /// The type of the object at `payload`, said, when its first word is a
    /// vtable whose descriptor names itself: its name's bytes as they lie
    /// (Lowering.InternNameBytes: UTF-8, its token bytes left as they are),
    /// or a string's units' low bytes. Nothing is made.
    static void SayHolderType(nuint payload)
    {
        const int w = WordSize.Bytes;
        nuint vt = Sys.ReadAddress(payload);
        nuint desc = vt - DescWords * w;
        if (vt < 4096 || Sys.ReadAddress(desc + DescSelfWord * w) != desc)
        {
            SayNumber("gc refs:   untyped, first word ", vt);
            return;
        }
        nuint name = Sys.ReadAddress(desc + DescNameWord * w);
        Runtime.WriteLiteral(2, "gc refs:   of type ");
        if (name != 0)
        {
            nuint nameVt = Sys.ReadAddress(name);
            nuint count = Sys.ReadAddress(name + ArrayCountAt) & 0x7FFFFFFF;
            nuint first = name + Sys.ReadAddress(nameVt - DescWords * w + DescPayloadWord * w);
            nuint stride = Sys.ReadAddress(nameVt - DescWords * w + DescSizeWord * w);
            for (nuint k = 0; k < count && k < 200; k++)
            {
                long b = stride == 2 ? Sys.Read8(first + 2 * k) : Sys.Read8(first + k);
                Platform.WriteBytes(2, Sys.AddressOf(ref b), 1);
            }
        }
        Runtime.WriteLiteral(2, "\n");
    }

    static void NoteReference(nuint at)
    {
        if (at > _referencesBelow && at < _referencesEnd)
            Sys.AtomicAdd(Sys.AddressOf(ref _references), 1);
    }

    public static void CheckHeapOn()
    {
        _heapCheck = true;
        FastPathsChanged();
        HeapChunks.CheckOverlaps = true;
    }

    /// THE WHOLE HEAP VERIFIED (a kernel's gcverify=1): every collection,
    /// minor and major, has its marks walked (VerifyMinor: an old block
    /// pointing at a young one this cycle did not mark, a missed card;
    /// VerifyMajor: a kept block pointing at one about to be freed;
    /// VerifyNewcomers), and the chunks, buffers and free lists checked
    /// before and after (CheckHeap). The first walk that reports anything
    /// stops the program through VerifyStopHook (the kernel's own crash),
    /// or exits 93: the reports said what, where and in which collection.
    public static bool VerifyHeap;
    public static nuint VerifyStopHook;

    public static void VerifyHeapOn()
    {
        VerifyHeap = true;
        CheckHeapOn();
    }

    static void VerifyStop(long reportsBefore)
    {
        if (!VerifyHeap || _verifyReports == reportsBefore) return;
        SayNumber("gc verify: HEAP BROKEN in collection ", Collections);
        SayNumber("gc verify:   minor ", _minor ? 1 : 0);
        if (VerifyStopHook != 0) Sys.Call(VerifyStopHook, (nuint)(_verifyReports - reportsBefore), (nuint)Collections, 0);
        Platform.Exit(93);
    }
    static nuint _heapCheckTable;
    static nuint _heapCheckTableFor;
    static long _heapCheckFaults;

    static void CheckFault(string what, nuint at, nuint word, long when)
    {
        _heapCheckFaults = _heapCheckFaults + 1;
        Runtime.WriteLiteral(2, what);
        SayNumber(" -- at ", at);
        SayNumber("gc heap check:   word ", word);
        SayNumber("gc heap check:   when (0 before, 1 after a collection) ", when);
        SayNumber("gc heap check:   cycle ", _cycle);
        if (_heapCheckFaults >= 8)
        {
            Platform.Exit(94);
        }
    }

    /// WHERE AN EXHAUSTED HEAP'S BYTES ARE, for the out-of-memory report:
    /// every chunk walked, free blocks counted by power-of-two size, live
    /// blocks and thread buffers totalled. A heap refused at its cap with a
    /// fraction of it live is fragmented or leaking, and this says which.
    static void SayFreeShape()
    {
        _heapCheckTable = GcThreads.Sized(_heapCheckTable, ref _heapCheckTableFor);
        if (_heapCheckTable == 0) return;
        nuint buffers = GcThreads.CaptureBuffersInto(_heapCheckTable);
        nuint bufferBytes = 0;
        nuint usedBytes = 0;
        nuint freeBytes = 0;
        nuint chunks = 0;
        nuint tails = 0;
        nuint classTails = 0, classChunks = 0, pooledTails = 0, ownedTails = 0, plainTails = 0, currentTail = 0;
        nuint ownedPageTails = 0, listedPageTails = 0, unlistedPageTails = 0, unlistedPages = 0, pooledPages = 0;
        nuint inPlaceBytes = 0;
        nuint inPlaceBig = 0;
        nuint listedBig = 0;
        nuint counts = _digits + 2048;           // 32 counts, 32 byte totals
        ZeroWords(counts, counts + 64 * WordSize.Bytes);
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            chunks = chunks + 1;
            nuint block = HeapChunks.First(chunk);
            nuint end = ChunkEndNow(chunk);
            tails = tails + HeapChunks.Limit(chunk) - end;
            // Whose the tail is: a class page's (only its class can use it),
            // a thread's buffer, the pool's, or the mixed heap's.
            nuint tail = HeapChunks.Limit(chunk) - end;
            if (HeapChunks.PageClass(chunk) != 0)
            {
                classTails = classTails + tail;
                classChunks = classChunks + 1;
                // Whose a class page's tail is: a thread's own page's, a
                // listed one's, or one on no list, which nobody can reach.
                if (HeapChunks.IsPooled(chunk)) pooledPages = pooledPages + 1;
                else if (HeapChunks.Owner(chunk) != 0) ownedPageTails = ownedPageTails + tail;
                else if (HeapChunks.IsListed(chunk)) listedPageTails = listedPageTails + tail;
                else if (end + ClassSize(HeapChunks.PageClass(chunk) - 1) <= HeapChunks.PageBlockLimit(chunk))
                {
                    unlistedPageTails = unlistedPageTails + tail;
                    unlistedPages = unlistedPages + 1;
                }
            }
            else if (HeapChunks.IsPooled(chunk)) pooledTails = pooledTails + tail;
            else if (HeapChunks.Owner(chunk) != 0) ownedTails = ownedTails + tail;
            else
            {
                plainTails = plainTails + tail;
                if (IsCurrentChunk(chunk)) currentTail = tail;
            }
            nuint step = 0;
            while (block < end)
            {
                while (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) < block) step = step + 1;
                if (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) == block)
                {
                    nuint past = Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    bufferBytes = bufferBytes + past - block;
                    block = past;
                    step = step + 1;
                    continue;
                }
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end)) break;
                if ((word & FlagFree) != 0)
                {
                    nuint b = 0;
                    nuint below = 2;
                    while (b < 31 && below <= size)
                    {
                        b = b + 1;
                        below = below * 2;
                    }
                    Sys.WriteAddress(counts + b * WordSize.Bytes, Sys.ReadAddress(counts + b * WordSize.Bytes) + 1);
                    Sys.WriteAddress(counts + (32 + b) * WordSize.Bytes, Sys.ReadAddress(counts + (32 + b) * WordSize.Bytes) + size);
                    freeBytes = freeBytes + size;
                    if (IsInPlace(block))
                    {
                        inPlaceBytes = inPlaceBytes + size;
                        if (size >= 8192) inPlaceBig = inPlaceBig + 1;
                    }
                    else if (size >= 8192) listedBig = listedBig + 1;
                }
                else usedBytes = usedBytes + size;
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
        SayNumber("heap shape: chunks ", chunks);
        SayNumber("heap shape: used bytes ", usedBytes);
        SayNumber("heap shape: free bytes ", freeBytes);
        SayNumber("heap shape: buffer bytes ", bufferBytes);
        SayNumber("heap shape: free in place, bytes ", inPlaceBytes);
        SayNumber("heap shape: free in place, 8 KB or more ", inPlaceBig);
        SayNumber("heap shape: free listed, 8 KB or more ", listedBig);
        SayNumber("heap shape: a listed block of 8 KB found by BinOf ", NextNonEmpty(BinOf(8192) + 1));
        SayNumber("heap shape: chunk tails unbumped ", tails);
        SayNumber("heap shape:   of class pages ", classTails);
        SayNumber("heap shape:   class pages ", classChunks);
        SayNumber("heap shape:     pooled ", pooledPages);
        SayNumber("heap shape:     tails of threads' own pages ", ownedPageTails);
        SayNumber("heap shape:     tails of listed pages ", listedPageTails);
        SayNumber("heap shape:     tails of pages on no list ", unlistedPageTails);
        SayNumber("heap shape:     pages on no list with a tail ", unlistedPages);
        SayNumber("heap shape:   of pooled chunks ", pooledTails);
        SayNumber("heap shape:   of threads' chunks ", ownedTails);
        SayNumber("heap shape:   of the mixed heap ", plainTails);
        SayNumber("heap shape:     of its current chunk ", currentTail);
        for (nuint b = 0; b < 32; b++)
        {
            nuint n = Sys.ReadAddress(counts + b * WordSize.Bytes);
            if (n == 0) continue;
            SayNumber("heap shape: free blocks below 2^", b + 1);
            SayNumber("heap shape:   count ", n);
            SayNumber("heap shape:   bytes ", Sys.ReadAddress(counts + (32 + b) * WordSize.Bytes));
        }
    }

    static void CheckHeap(long when)
    {
        _heapCheckTable = GcThreads.Sized(_heapCheckTable, ref _heapCheckTableFor);
        if (_heapCheckTable == 0)
        {
            return;
        }
        nuint buffers = GcThreads.CaptureBuffersInto(_heapCheckTable);
        nuint listed = 0;
        nuint chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = ChunkEndNow(chunk);
            if (end > HeapChunks.Limit(chunk) || end < block)
            {
                CheckFault("gc heap check: a chunk's end outside it", chunk, end, when);
                end = block;
            }
            nuint step = 0;
            while (block < end)
            {
                while (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) < block)
                {
                    step = step + 1;
                }
                if (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) == block)
                {
                    block = Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    step = step + 1;
                    continue;
                }
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                if (size < LeastBlock || Beyond(block, size, end))
                {
                    CheckFault("gc heap check: a chunk's chain breaks", block, word, when);
                    break;
                }
                if (step < buffers && Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)) < block + size)
                {
                    CheckFault("gc heap check: a buffer begins inside a block", block, Sys.ReadAddress(_heapCheckTable + step * (2 * WordSize.Bytes)), when);
                }
                if (!Whole(chunk, block, word))
                {
                    SayNumber("gc heap check: header ", word);
                    SayNumber("gc heap check:   kind ", Sys.ReadAddress(block + KindAt));
                    SayNumber("gc heap check:   first payload word ", Sys.ReadAddress(block + HeaderBytes));
                    SayNumber("gc heap check:   footer at ", block + size - FooterBytes);
                    SayNumber("gc heap check:   page class ", HeapChunks.PageClass(chunk));
                    SayJournal(block + size - FooterBytes);
                    // The whole block, a word a line, for whoever reads the
                    // log to decode: a string's units say what made it.
                    for (nuint wd = block; wd < block + size && wd < block + 512; wd = wd + 4)
                    {
                        SayNumber("gc heap check:   word ", Sys.Read32(wd));
                    }
                    if (HeapChunks.PageClass(chunk) != 0) CheckFault("gc heap check: a page's block off its class's size or grid", block, word, when);
                    else CheckFault("gc heap check: a header and its footer disagree", block, Sys.ReadAddress(block + size - FooterBytes), when);
                }
                if ((word & FlagFree) == 0) CheckGuard(block, "the heap walk");
                if ((word & FlagFree) != 0 && !IsInPlace(block) && HeapChunks.PageClass(chunk) == 0)
                {
                    listed = listed + 1;
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
        // THE BUFFERS, each its own chain up to where its thread has bumped.
        // A block freed in place is free and on no list; one freed while the
        // thread was alone is on a list.
        nuint i = 0;
        while (i < buffers)
        {
            nuint at = Sys.ReadAddress(_heapCheckTable + i * (2 * WordSize.Bytes));
            nuint upto = GcThreads.BufferPointer(at);
            while (at < upto)
            {
                // Its thread bumps with no lock: the pointer moves first and
                // the header is written after, and a free of its top block
                // clears it before the pointer comes back. A zero is a block
                // being made or unmade, and the walk ends there.
                nuint word = Sys.ReadAddress(at);
                nuint size = word & SizeMask;
                if (word == 0)
                {
                    break;
                }
                if (size < LeastBlock || Beyond(at, size, upto))
                {
                    CheckFault("gc heap check: a buffer's chain breaks", at, word, when);
                    break;
                }
                if (!Beyond(at, size, upto) && at + size != upto && Sys.ReadAddress(at + size - FooterBytes) != word)
                {
                    CheckFault("gc heap check: a buffer's header and footer disagree", at, Sys.ReadAddress(at + size - FooterBytes), when);
                }
                if ((word & FlagFree) != 0 && !IsInPlace(at))
                {
                    listed = listed + 1;
                }
                at = at + size;
            }
            i = i + 1;
        }
        // THE LISTS, every heap's.
        nuint nodes = 0;
        nuint working = _h;
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            _h = h;
            nuint small = 0;
            int bin = 0;
            while (bin < Bins)
            {
                nuint node = BinHead(bin);
                nuint previous = 0;
                if (BinMarked(bin) != (node != 0))
                {
                    CheckFault("gc heap check: a bin's bit and its list disagree", (nuint)bin, node, when);
                }
                while (node != 0)
                {
                    nodes = nodes + 1;
                    if (bin <= BinOf(ExactLimit)) small = small + 1;
                    if (!IndexBlock(node, bin))
                    {
                        CheckFault("gc heap check: a listed block is no free block of its bin", node, Sys.ReadAddress(node), when);
                        break;
                    }
                    if (_heapCount > 1 && HeapOfBlock(node) != h)
                    {
                        CheckFault("gc heap check: a listed block is another heap's", node, h, when);
                        break;
                    }
                    if (Sys.ReadAddress(node + HeaderBytes) != previous)
                    {
                        CheckFault("gc heap check: a listed block's back link is wrong", node, Sys.ReadAddress(node + HeaderBytes), when);
                        break;
                    }
                    if (nodes > listed + 1000000)
                    {
                        CheckFault("gc heap check: a list does not end", node, (nuint)bin, when);
                        break;
                    }
                    previous = node;
                    node = Sys.ReadAddress(node + KindAt);
                }
                bin = bin + 1;
            }
            if (small != _smallFree)
            {
                CheckFault("gc heap check: the small free count is wrong", small, _smallFree, when);
            }
        }
        _h = working;
        if (nodes != listed)
        {
            CheckFault("gc heap check: the lists hold a different number of blocks than the walks found listed", nodes, listed, when);
        }
    }

    // THE CENSUS (Corsac.GC.Census): what a whole sweep found live, by what
    // it is. An object with a descriptor is counted under its vtable; a leaf
    // (a string, an array of bytes or characters) under Leaf; a block no
    // descriptor describes -- a struct's, a cell, a frame -- under its size,
    // Untyped + size, because what they are is how big they are. An open
    // table of the operating system's, so counting allocates nothing; the
    // largest CensusShown are said as each whole cycle ends.
    const int CensusSlots = 65536;
    const int CensusEntry = 3 * WordSize.Bytes;       // key, bytes, blocks
    const int CensusShown = 30;
    const int CensusLeaf = 1;
    const int CensusNoVtable = 2;
    const int CensusUntyped = 0x40000000;
    static bool _census;
    static bool _deadCensus;        // Corsac.GC.DeadCensus: what sweeps found dead, by type, over the run
    static nuint _deadAt;
    static long _thresholdCap;      // Corsac.GC.Threshold, or 0
    static long _nurseryFixed;      // System.GC.Gen0Size, or 0
    static nuint _censusAt;

    /// The census asked for after start (AppContext.SetSwitch("Corsac.GC.Census", true):
    /// corc's --gc-census): every whole collection counts what it found live, as the
    /// image's Corsac.GC.Census knob does from the first.
    public static void AskCensus()
    {
        _censusAsked = true;
        _census = true;
    }

    /// And what every sweep found dead, by type, over the run
    /// (AppContext.SetSwitch("Corsac.GC.DeadCensus", true): corc's
    /// --gc-dead-census), as the image's knob of the same name does: what
    /// the collector, not the program, gave back, and of which types.
    public static void AskDeadCensus()
    {
        _deadCensusAsked = true;
        AskCensus();
        _deadCensus = true;
    }

    static bool _deadCensusAsked;

    // ---- who holds what: the parent census ----
    //
    // A TYPE AT THE TOP OF THE CENSUS SAYS WHAT, NOT WHY: twenty megabytes of
    // int arrays alive in a native compile, and a seventh of that in the same
    // compile under .NET. Asked for (AppContext "Corsac.GC.ParentCensus":
    // corc's --gc-parent-census), every whole collection's census also walks
    // each live object's reference fields and counts what each one holds by
    // the pair of types -- the field's object's and the holder's -- with its
    // bytes. An array is not walked: its elements are counted as its own.
    const int ParentEntry = 4 * WordSize.Bytes;        // child, parent, bytes, blocks
    static nuint _parentAt;
    static bool _parentAsked;

    public static void AskParentCensus()
    {
        _parentAsked = true;
        AskCensus();
    }

    static void StartParentCensus()
    {
        if (!_parentAsked) return;
        if (_parentAt == 0) _parentAt = Platform.Map(CensusSlots * ParentEntry);
        if (_parentAt != 0) ZeroWords(_parentAt, _parentAt + CensusSlots * ParentEntry);
    }

    /// What the live block holds, by type, if it is an object described by its descriptor.
    static void ParentCensus(nuint block)
    {
        if (_parentAt == 0 || Sys.ReadAddress(block + KindAt) != KindObject) return;
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        nuint vt = Sys.ReadAddress(payload);
        if (vt == 0 || InQuarantine(vt)) return;
        nuint desc = vt - DescWords * w;
        if ((Sys.ReadAddress(desc + DescSelfWord * w)) != desc) return;
        if ((Sys.ReadAddress(desc + DescFlagsWord * w) & SequenceFlag) != 0) return;
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0) return;
        nuint end = block + (Sys.ReadAddress(block) & SizeMask);
        nuint words = Sys.ReadAddress(map);
        for (nuint k = 0; k < words; k++)
        {
            if (((Sys.ReadAddress(map + (1 + k / 32) * w) & 0xFFFFFFFF) & ((nuint)1 << (int)(k % 32))) == 0) continue;
            nuint at = payload + k * w;
            if (at + w > end) break;
            nuint child = Sys.ReadAddress(at);
            if (child == 0 || HeapChunks.Of(child) == 0) continue;
            nuint childBlock = child - HeaderBytes;
            nuint childSize = Sys.ReadAddress(childBlock) & SizeMask;
            if (childSize == 0) continue;
            ParentAdd(CensusKey(childBlock, childSize), vt, childSize);
        }
    }

    static void ParentAdd(nuint child, nuint parent, nuint size)
    {
        const int w = WordSize.Bytes;
        nuint slot = (((child >> 3) * 0x9E3779B1) ^ ((parent >> 3) * 40503)) & (CensusSlots - 1);
        for (long probes = 0; probes < CensusSlots; probes++)
        {
            nuint at = _parentAt + slot * ParentEntry;
            nuint there = Sys.ReadAddress(at);
            if (there == 0 || there == child && Sys.ReadAddress(at + w) == parent)
            {
                Sys.WriteAddress(at, child);
                Sys.WriteAddress(at + w, parent);
                Sys.WriteAddress(at + 2 * w, Sys.ReadAddress(at + 2 * w) + size);
                Sys.WriteAddress(at + 3 * w, Sys.ReadAddress(at + 3 * w) + 1);
                return;
            }
            slot = (slot + 1) & (CensusSlots - 1);
        }
    }

    /// The largest pairs, taken out as they are said.
    static void SayParents()
    {
        if (_parentAt == 0) return;
        const int w = WordSize.Bytes;
        Runtime.WriteLiteral(2, "gc parent census: what live objects hold, by type\n");
        for (int said = 0; said < 2 * CensusShown; said++)
        {
            nuint best = 0, bestBytes = 0;
            bool any = false;
            for (nuint slot = 0; slot < CensusSlots; slot++)
            {
                nuint bytes = Sys.ReadAddress(_parentAt + slot * ParentEntry + 2 * w);
                if (bytes > bestBytes) { bestBytes = bytes; best = slot; any = true; }
            }
            if (!any) return;
            nuint at = _parentAt + best * ParentEntry;
            SayNumber("gc parent census: bytes ", bestBytes);
            SayNumber("gc parent census:   blocks ", Sys.ReadAddress(at + 3 * w));
            SayNumber("gc parent census:   child ", Sys.ReadAddress(at));
            SayNumber("gc parent census:   parent ", Sys.ReadAddress(at + w));
            Sys.WriteAddress(at + 2 * w, 0);
        }
    }

    // Asked by the program (AskCensus); every collection asks the platform
    // afresh as well, and must not take back what the program asked for.
    static bool _censusAsked;

    static void StartCensus()
    {
        if (_censusAt == 0)
        {
            _censusAt = Platform.Map(CensusSlots * CensusEntry);
            if (_censusAt == 0)
            {
                return;
            }
        }
        ZeroWords(_censusAt, _censusAt + CensusSlots * CensusEntry);
        StartParentCensus();
    }

    static void Census(nuint block, nuint size)
    {
        CensusInto(_censusAt, block, size);
        if (_parentAt != 0) ParentCensus(block);
    }

    static void CensusInto(nuint table, nuint block, nuint size)
    {
        if (table == 0)
        {
            return;
        }
        CensusAdd(table, CensusKey(block, size), size);
    }

    /// What the census counts a block as: its type where its descriptor says
    /// one, CensusLeaf, CensusNoVtable, or CensusUntyped plus its size.
    static nuint CensusKey(nuint block, nuint size)
    {
        const int w = WordSize.Bytes;
        nuint kind = Sys.ReadAddress(block + KindAt);
        nuint key;
        if (kind == KindLeaf)
        {
            // BY ITS TYPE TOO, where its descriptor says one: a string, a
            // byte array, an int array -- the leaves of a link were half of
            // what it held, and one line saying "leaves" said nothing more.
            nuint lvt = Sys.ReadAddress(block + HeaderBytes);
            nuint ldesc = lvt - DescWords * w;
            // Read only where a descriptor can be: inside the image, below its
            // end, and not in the heap -- a leaf of raw bytes has any word first.
            nuint imageEnd = Sys.DataEnd();
            bool described = lvt > DescWords * w && lvt < imageEnd && imageEnd - lvt < 0x10000000 && HeapChunks.Of(lvt) == 0
                && !InQuarantine(lvt) && (Sys.ReadAddress(ldesc + DescSelfWord * w)) == ldesc;
            key = described ? lvt : CensusLeaf;
        }
        else if (kind == KindObject)
        {
            nuint vt = Sys.ReadAddress(block + HeaderBytes);
            nuint desc = vt - DescWords * w;
            key = vt != 0 && !InQuarantine(vt) && (Sys.ReadAddress(desc + DescSelfWord * w)) == desc ? vt : CensusNoVtable;
        }
        else
        {
            key = CensusUntyped + (size < 0x10000000 ? size : 0x0FFFFFFF);
        }
        return key;
    }

    static void CensusAdd(nuint table, nuint key, nuint size)
    {
        const int w = WordSize.Bytes;
        nuint slot = ((key >> 3) * 0x9E3779B1) & (CensusSlots - 1);
        long probes = 0;
        while (probes < CensusSlots)
        {
            nuint at = table + slot * CensusEntry;
            nuint there = Sys.ReadAddress(at);
            if (there == key || there == 0)
            {
                Sys.WriteAddress(at, key);
                Sys.WriteAddress(at + w, Sys.ReadAddress(at + w) + size);
                Sys.WriteAddress(at + 2 * w, Sys.ReadAddress(at + 2 * w) + 1);
                return;
            }
            slot = (slot + 1) & (CensusSlots - 1);
            probes = probes + 1;
        }
    }

    /// The largest entries, each taken out as it is said: "census bytes
    /// blocks key", the key a vtable address, 1 for leaves, 2 for objects
    /// with no vtable yet, or 0x40000000 plus the size of an untyped block.
    static void SayCensus()
    {
        SayNumber("gc census: whole cycle, live bytes ", _liveBytes);
        HeapChunks.SayMakeup();
        SayTable(_censusAt, "gc census: bytes ", "gc census:   blocks ", "gc census:   key ", true);
        if (_deadCensus && _deadAt != 0)
        {
            Runtime.WriteLiteral(2, "gc dead census: everything swept so far\n");
            SayTable(_deadAt, "gc dead census: bytes ", "gc dead census:   blocks ", "gc dead census:   key ", false);
        }
        SayParents();
        // And where the allocations came from, when they are sampled.
        AllocSamples.Top(CensusShown);
    }

    /// The largest entries of a census table; `take` clears each as it is
    /// said (the live table is made afresh every whole cycle), the dead one
    /// keeps counting.
    static void SayTable(nuint table, string bytesLabel, string blocksLabel, string keyLabel, bool take)
    {
        const int w = WordSize.Bytes;
        long said = 0;
        nuint lastBytes = nuint.MaxValue;
        nuint lastKey = 0;
        while (said < CensusShown)
        {
            bool found = false;
            nuint best = 0;
            nuint bestBytes = 0;
            nuint slot = 0;
            while (slot < CensusSlots)
            {
                nuint bytes = Sys.ReadAddress(table + slot * CensusEntry + w);
                nuint key = Sys.ReadAddress(table + slot * CensusEntry);
                // Without taking entries out, the next is the largest below
                // the last said (and, among equals, a larger key).
                bool below = take || bytes < lastBytes || (bytes == lastBytes && key > lastKey);
                if (below && bytes > bestBytes)
                {
                    bestBytes = bytes;
                    best = slot;
                    found = true;
                }
                slot = slot + 1;
            }
            if (!found)
            {
                return;
            }
            nuint at = table + best * CensusEntry;
            SayNumber(bytesLabel, bestBytes);
            SayNumber(blocksLabel, Sys.ReadAddress(at + 2 * w));
            SayNumber(keyLabel, Sys.ReadAddress(at));
            lastBytes = bestBytes;
            lastKey = Sys.ReadAddress(at);
            if (take)
            {
                Sys.WriteAddress(at + w, 0);
            }
            said = said + 1;
        }
    }

    // DANGLING REFERENCES, in the checked mode: at every whole sweep, each
    // live object read by its descriptor -- the fields that are references,
    // the elements of an array of them -- and a reference to a block the
    // program freed (poisoned and kept, VerifyFree) reported: the holder, its
    // vtable, the field, and who freed what it holds. A read after a free
    // that meets an int or a string's characters reads the pattern and goes
    // on quietly; the reference that leads there is found here instead. The
    // heap lock is held (SweepNext). The first DanglingMost are reported, and
    // the process ends with 95.
    const int DanglingMost = 12;
    static long _danglingReports;

    static void CheckDangling(nuint block, nuint size)
    {
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        nuint end = block + size - FooterBytes;
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind == KindLeaf || IsPoisoned(payload, end))
        {
            return;
        }
        nuint vt = Sys.ReadAddress(payload);
        nuint desc = vt - DescWords * w;
        // A BLOCK NO DESCRIPTOR DESCRIBES -- a struct's, a cell, a frame --
        // word by word, as the marker reads it: a struct is copied a word at
        // a time, so a reference freed out of one copy is still in the other.
        if (kind != KindObject || vt == 0 || InQuarantine(vt) || (Sys.ReadAddress(desc + DescSelfWord * w)) != desc)
        {
            if (kind == KindObject)
            {
                return;
            }
            nuint q = payload;
            while (q + w <= end)
            {
                CheckDanglingField(payload, 0, q);
                q = q + w;
            }
            return;
        }
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0 || (Sys.ReadAddress(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0
                || Sys.ReadAddress(desc + DescSizeWord * w) != w)
            {
                return;
            }
            nuint count = Sys.ReadAddress(payload + ArrayCountAt) & 0x7FFFFFFF;
            nuint first = payload + Sys.ReadAddress(desc + DescPayloadWord * w);
            nuint last = first + count * w;
            if (last > end || last < first)
            {
                return;
            }
            nuint p = first;
            while (p < last)
            {
                CheckDanglingField(payload, vt, p);
                p = p + w;
            }
            return;
        }
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0)
        {
            return;
        }
        nuint words = Sys.ReadAddress(map);
        nuint index = 0;
        while (index < words)
        {
            nuint bits = Sys.ReadAddress(map + (1 + index / 32) * w) & 0xFFFFFFFF;
            if (((bits >> (int)(index & 31)) & 1) != 0 && payload + (index + 1) * w <= end)
            {
                CheckDanglingField(payload, vt, payload + index * w);
            }
            index = index + 1;
        }
    }

    // WRITTEN AFTER ITS FREE. The checks above find a second free and a heap
    // object still holding a freed block; neither sees a write through a
    // reference only a stack or a register still holds -- a local the
    // compiler's free outlived. Unchecked, that write lands in whatever was
    // handed the block next. So at every whole collection each block still in
    // quarantine is read again: every word below the free's record of its
    // callers (VerifyFree, up to six words at the end, none of them the
    // pattern) must still be the pattern. A word that is not is said, with
    // its offset, what it holds and who freed the block, and put back so it
    // is said once.
    const int WrittenMost = 24;
    static long _writtenReports;

    static void CheckQuarantine()
    {
        if (_quarantine == 0 || _writtenReports >= WrittenMost)
        {
            return;
        }
        for (nuint n = 0; n < _quarantineCount; n++)
        {
            nuint at = Sys.ReadAddress(_quarantine + WordSize.Bytes + ((_quarantineHead + n) % _quarantineEntries) * WordSize.Bytes);
            if (at == 0)
            {
                continue;
            }
            nuint block = at - HeaderBytes;
            nuint end = block + (Sys.ReadAddress(block) & SizeMask) - FooterBytes;
            nuint record = end - 4;
            long kept = 0;
            while (kept < 6 && record >= at + 8 && Sys.Read32(record) != Poison)
            {
                record = record - 4;
                kept = kept + 1;
            }
            for (nuint p = at; p <= record; p = p + 4)
            {
                long now = Sys.Read32(p);
                if (now == Poison)
                {
                    continue;
                }
                SayNumber("gc: checked free: written after its free, block ", at);
                SayNumber("gc:   at offset ", p - at);
                SayNumber("gc:   now holding ", now);
                SayNumber("gc:   block bytes ", end - at);
                SaySites(at, "gc:   the block was");
                Runtime.WriteLiteral(2, "gc:   freed by:\n");
                nuint site = end - 4;
                while (site > record)
                {
                    Runtime.SayFrame(2, Sys.Read32(site) + 0x08000000);
                    site = site - 4;
                }
                nuint q = at;
                while (q <= record)
                {
                    Sys.Write32(q, Poison);
                    q = q + 4;
                }
                _writtenReports = _writtenReports + 1;
                if (_writtenReports >= WrittenMost)
                {
                    return;
                }
                break;
            }
        }
    }

    /// Whether [payload, end) begins with the checked mode's pattern: a block
    /// VerifyFree took. Its kind word says leaf.
    static bool IsPoisoned(nuint payload, nuint end)
    {
        return Sys.ReadAddress(payload - HeaderBytes + KindAt) == KindLeaf && Sys.Read32(payload) == Poison
            && (payload + 4 >= end || Sys.Read32(payload + 4) == Poison);
    }

    // The pairs already reported, so that one holder a cycle after another
    // does not use up the reports. A small ring of the operating system's.
    const int SeenPairs = 64;
    static nuint _seen;

    static bool Seen(nuint holder, nuint target)
    {
        if (_seen == 0)
        {
            _seen = Platform.Map(SeenPairs * 2 * WordSize.Bytes);
            if (_seen == 0)
            {
                return false;
            }
        }
        nuint i = 0;
        while (i < SeenPairs)
        {
            nuint at = _seen + i * 2 * WordSize.Bytes;
            if (Sys.ReadAddress(at) == holder && Sys.ReadAddress(at + WordSize.Bytes) == target)
            {
                return true;
            }
            if (Sys.ReadAddress(at) == 0)
            {
                Sys.WriteAddress(at, holder);
                Sys.WriteAddress(at + WordSize.Bytes, target);
                return false;
            }
            i = i + 1;
        }
        return false;
    }

    static void CheckDanglingField(nuint holder, nuint vt, nuint field)
    {
        nuint target = Sys.ReadAddress(field);
        if (target == 0 || (target & 7) != 0)
        {
            return;
        }
        nuint block = target - HeaderBytes;
        nuint chunk = HeapChunks.Of(block);
        if (chunk == 0 || block < HeapChunks.First(chunk))
        {
            return;
        }
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;
        if (size < LeastBlock || Beyond(block, size, HeapChunks.End(chunk)) || (word & FlagFree) != 0
            || !Whole(chunk, block, word))
        {
            return;
        }
        nuint end = block + size - FooterBytes;
        if (!IsPoisoned(target, end) || Seen(holder, target))
        {
            return;
        }
        // A FINISHED COROUTINE'S FRAME -- no descriptor, its state word -1 --
        // keeps what its last run left in its saved slots, and nothing reads
        // them again: an iterator gives back what it made when it ends, and
        // its machine, still held by whoever walked it, is no holder.
        if (vt == 0 && (int)Sys.ReadAddress(holder + 2 * WordSize.Bytes) == -1)
        {
            return;
        }
        _danglingReports = _danglingReports + 1;
        SayNumber("gc: checked free: a live object still holds a freed block, holder ", holder);
        SayNumber("gc:   holder's vtable ", vt);
        SayNumber("gc:   field offset ", field - holder);
        nuint holderSize = Sys.ReadAddress(holder - HeaderBytes) & SizeMask;
        SayNumber("gc:   holder's block size ", holderSize);
        SayNumber("gc:   holder's kind word ", Sys.ReadAddress(holder - HeaderBytes + KindAt));
        nuint shown = 0;
        while (shown < 8 && holder + (shown + 1) * WordSize.Bytes <= holder - HeaderBytes + holderSize - FooterBytes)
        {
            SayNumber("gc:   holder word ", Sys.ReadAddress(holder + shown * WordSize.Bytes));
            shown = shown + 1;
        }
        SayNumber("gc:   freed block ", target);
        SayNumber("gc:   its size ", size);
        SaySites(holder, "gc:   the holder was");
        SaySites(target, "gc:   the freed block was");
        Runtime.WriteLiteral(2, "gc: it was freed by:\n");
        nuint site = end - 4;
        while (site >= target + 8)
        {
            nuint first = Sys.Read32(site);
            if (first == Poison || first == 0)
            {
                break;
            }
            Runtime.SayFrame(2, first + 0x08000000);
            site = site - 4;
        }
        if (_danglingReports >= DanglingMost)
        {
            Platform.Exit(95);
        }
    }

    static void VerifyFree(nuint at)
    {
        if (at == 0)
        {
            return;
        }
        nuint block = ValidAllocated(at);
        if (block == 0)
        {
            return;
        }
        nuint end = block + SizeOfBlock(block) - FooterBytes;
        if (Sys.ReadAddress(block + KindAt) == KindLeaf && Sys.Read32(at) == Poison && (at + 4 >= end || Sys.Read32(at + 4) == Poison))
        {
            SayNumber("gc: checked free: freed twice, block ", at);
            SaySites(at, "gc:   the block was");
            // Who freed it first -- the return addresses the first free left
            // in the block's last words (below), less 0x08000000 -- and who
            // frees it now.
            Runtime.WriteLiteral(2, "gc: first freed by:\n");
            nuint site = end - 4;
            while (site >= at + 8)
            {
                nuint first = Sys.Read32(site);
                if (first == Poison || first == 0)
                {
                    break;
                }
                Runtime.SayFrame(2, first + 0x08000000);
                site = site - 4;
            }
            Runtime.WriteLiteral(2, "gc: freed again by:\n");
            Runtime.SayTrace(2, Sys.FramePointer());
            Platform.Exit(97);
        }
        nuint p = at;
        while (p < end)
        {
            Sys.Write32(p, Poison);
            p = p + 4;
        }
        // AND WHO FREED IT, in the block's last words: the return addresses
        // of the calls that led here, less 0x08000000 so that none of them
        // is a pointer either (a read through one still faults, low in the
        // space where nothing is mapped). The first words keep the pattern,
        // which the double-free check reads and most reads after a free
        // meet first. Add 0x08000000 back and ask nm, or gdb's info symbol.
        nuint frame = Sys.FramePointer();
        nuint slot = end - 4;
        int depth = 0;
        while (depth < 6 && slot >= at + 8 && frame != 0)
        {
            nuint next = Sys.ReadAddress(frame);
            nuint back = Sys.ReadAddress(frame + WordSize.Bytes);
            if (back < 0x08000000 || next != 0 && next <= frame)
            {
                break;
            }
            Sys.Write32(slot, (uint)(back - 0x08000000));
            slot = slot - 4;
            depth = depth + 1;
            frame = next;
        }
        Sys.WriteAddress(block + KindAt, KindLeaf);
        RecordFreeSite(at);
        Quarantine(at);
        VerifiedFrees = VerifiedFrees + 1;
        Frees = Frees + 1;
    }

    /// The header of an exact, live allocation, or zero for anything foreign,
    /// interior, malformed or already free.
    /// WHETHER `at` IS A LIVE OBJECT'S PAYLOAD, by the checks Free makes: in
    /// this thread's own buffer without the lock, anywhere else under it --
    /// and an OBJECT, made with a descriptor, as the marker judges one. What
    /// Runtime.Free asks before it reads a header to free the fields an object
    /// owns: a pointer freed twice, one into static data and a headerless
    /// cell (a struct's box, a captured variable) have no descriptor to read,
    /// and Free promises to ignore the first two and give back the third.
    public static bool LiveObject(nuint at)
    {
        // No heap yet, nothing of its (Free).
        if (at == 0 || (at & 7) != 0 || !HeapChunks.Any())
        {
            return false;
        }
        nuint block = at - HeaderBytes;
        nuint tb = Sys.ThreadBlock();
        // INSIDE THE ALLOCATOR BEFORE ITS OWN BUFFER AND PAGES ARE READ
        // (Tls.InAlloc), as Free is: an interrupt that frees or refills
        // between the reads moves the buffer under them, and ShedPages gives
        // back the pages of a thread that is not in the allocator -- a page
        // found in the cache here, given back and released before its record
        // was read, was a read of memory no longer mapped. Already inside
        // (an interrupt on top of the allocator): nothing of its is read.
        if (tb != 0 && Sys.ReadAddress(tb + Tls.InAlloc) != 0)
        {
            return false;
        }
        if (tb != 0)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint ptr = Sys.ReadAddress(tb + Tls.AllocPtr);
            if (ptr != 0 && block >= Sys.ReadAddress(tb + Tls.AllocBase) && block < ptr)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                bool whole = size >= Smallest && (word & FlagFree) == 0 && !Beyond(block, size, ptr)
                    && Sys.ReadAddress(block + size - FooterBytes) == word && Described(block, at);
                Sys.WriteAddress(tb + Tls.InAlloc, 0);
                return whole;
            }
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
        }
        if (GcLock.HeldByMe())
        {
            return false;
        }
        // ONE OF THIS THREAD'S OWN PAGES, as Free asks: its page, its record
        // and its blocks' headers are this thread's while it owns the page,
        // so they are read with no lock. Every free of an object a compiler
        // made took the heap lock twice, here and in Free.
        if (tb != 0 && Runtime.Marking == 0 && !_sweeping && !_collecting)
        {
            Sys.WriteAddress(tb + Tls.InAlloc, 1);
            nuint bytes = OwnPageBlock(tb, block);
            bool described = bytes > 0 && Described(block, at);
            Sys.WriteAddress(tb + Tls.InAlloc, 0);
            if (bytes > 0) return described;
        }
        GcLock.Enter();
        bool live = ValidAllocated(at) != 0 && Described(block, at);
        GcLock.Exit();
        return live;
    }

    /// The bytes of the block at `block` when it lies in one of this
    /// thread's own pages and its header reads as an allocated block of the
    /// page's class there; 0 otherwise. Nothing is read at the block until it
    /// is known to lie in such a page.
    static nuint OwnPageBlock(nuint tb, nuint block)
    {
        nuint cache = Sys.ReadAddress(tb + Tls.Classes);
        if (cache == 0 || _classSize == 0) return 0;
        // BY THE 4 KB TABLE, as the marker and FreeOwnBlock find a page's
        // block: its page, the page's class, the grid by the class's
        // reciprocal. The search below went through every class the thread
        // holds, a 64-bit compare each, and tested the grid with a division,
        // at every free the compiler's lifetime rules make (Runtime.Free asks
        // this before it frees an object's owned fields).
        nuint slots = HeapChunks.SlotTable;
#if TARGET_64BIT
        // Outside the table's window (FreeOwnBlock), the search below.
        if (!HeapChunks.InSlotWindow(block))
        {
            slots = 0;
        }
#endif
        if (slots != 0)
        {
            nuint page = Sys.ReadAddress(slots + ((nuint)block >> 12) * WordSize.Bytes);
            if (page == 0) return 0;
            nuint cls = Sys.ReadAddress(page + (nuint)HeapChunks.ClassAt);
            if (cls == 0 || Sys.ReadAddress(page + (nuint)HeapChunks.OwnerAt) != tb) return 0;
            if (Sys.ReadAddress((nuint)cache + (cls - 1) * (nuint)(2 * WordSize.Bytes)) != page) return 0;
            nuint found = PageBlock(page, (nuint)block + HeaderBytes, cls);
            if (found != (nuint)block || (Sys.ReadAddress(found) & FlagFree) != 0) return 0;
            return (Sys.ReadAddress(found) & ~(nuint)7);
        }
        for (nuint c = 0; c < Classes; c = c + 1)
        {
            nuint page = Sys.ReadAddress(cache + c * (2 * WordSize.Bytes));
            if (page == 0 || block < HeapChunks.First(page) || block >= HeapChunks.End(page)) continue;
            if (HeapChunks.Owner(page) != tb) return 0;
            nuint bytes = Sys.ReadAddress(_classSize + c * WordSize.Bytes);
            nuint head = Sys.ReadAddress(block);
            // Whole as a page's block is (Whole): no footer to agree.
            if ((head & SizeMask) == bytes && (head & FlagFree) == 0 && block + bytes <= HeapChunks.End(page)
                && (int)(block - HeapChunks.First(page)) % (int)bytes == 0)
            {
                return bytes;
            }
            return 0;
        }
        return 0;
    }

    /// A block made as an object whose first word names a real descriptor.
    static bool Described(nuint block, nuint at)
    {
        if (Sys.ReadAddress(block + KindAt) != KindObject)
        {
            return false;
        }
        nuint vt = Sys.ReadAddress(at);
        if (vt == 0)
        {
            return false;
        }
        nuint desc = vt - DescWords * WordSize.Bytes;
        return (Sys.ReadAddress(desc + DescSelfWord * WordSize.Bytes)) == desc;
    }

    static nuint ValidAllocated(nuint at)
    {
        if ((at & 7) != 0 || at < HeaderBytes)
        {
            return 0;
        }

        nuint block = at - HeaderBytes;
        nuint chunk = HeapChunks.Of(block);

        if (chunk == 0)
        {
            return 0;
        }

        nuint end = HeapChunks.End(chunk);
        nuint word = Sys.ReadAddress(block);
        nuint size = word & SizeMask;

        if (size < LeastBlock || Beyond(block, size, end) || (word & FlagFree) != 0)
        {
            return 0;
        }
        if (!Whole(chunk, block, word))
        {
            return 0;
        }
        return block;
    }

    /// Frees a block and coalesces it with a free neighbour on either side.
    static void Merge(nuint block)
    {
        if (_heapCheck) Forget(block);
        nuint chunk = HeapChunks.Of(block);

        if (chunk == 0)
        {
            return;
        }

        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        nuint size = SizeOfBlock(block);

        // Forward: the block after this one starts where this one ends.
        nuint next = block + size;

        nuint holder = GcThreads.BufferHolding(block);

        // A MERGE WIPES THE BOUNDARIES IT REMOVES. Left inside the free block,
        // a swallowed header and footer still agree on a size, and the one of
        // an old block still carries its marks: the record of the blocks the
        // stacks held (RescanHeld) found such a header where a held block had
        // been and scanned what lay behind it as that object's fields -- a
        // dead object's, or, in the poisoned mode, the pattern read as a
        // vtable. Nothing reads inside a free block but its own links.
        if (next < end && IsFree(next) && !IsInPlace(next) && GcThreads.BufferHolding(next) == holder)
        {
            nuint nextSize = SizeOfBlock(next);
            Unlink(next);
            if (_heapCheck) Journal(block + size - FooterBytes, next + KindAt + WordSize.Bytes);
            Sys.WriteAddress(block + size - FooterBytes, 0);
            Sys.WriteAddress(next, 0);
            Sys.WriteAddress(next + KindAt, 0);
            size = size + nextSize;
        }

        // Backward: through the footer of the block below, which is the word
        // just under this header. That is what the footer is for.
        if (block > first)
        {
            nuint back = Sys.ReadAddress(block - FooterBytes);

            nuint prev = block - (back & SizeMask);

            if ((back & FlagFree) != 0 && !IsInPlace(prev) && GcThreads.BufferHolding(prev) == holder)
            {

                Unlink(prev);
                size = size + SizeOfBlock(prev);
                if (_heapCheck) Journal(block - FooterBytes, block + KindAt + WordSize.Bytes);
                Sys.WriteAddress(block - FooterBytes, 0);
                Sys.WriteAddress(block, 0);
                Sys.WriteAddress(block + KindAt, 0);
                block = prev;
            }
        }

        Stamp(block, size, FlagFree);
        Link(block);

        // A MERGE REMOVES BOUNDARIES, and the recycling walk resumes at one.
        // Swallowed into this block, the block it would have read next keeps
        // its old header and footer inside it, and the walk would take that
        // as a listed free block of its own: unlinked from no list, handed out
        // as a buffer, and handed out again as part of this one.
        if (_recycle == chunk && block < _recycleAt && _recycleAt < block + size)
        {
            _recycleAt = block;
        }
    }

    // ---- collecting -------------------------------------------------------------

    /// The block a word might point at or into, or zero.
    ///
    /// The header and footer agreeing is a strong test: two words, far apart,
    /// both saying the same size, on an eight-byte boundary, inside the heap.
    /// In a size-class page, which has no footers, the page's class and grid
    /// say it instead (Whole). A number that passes by accident costs one
    /// retained block.
    ///
    /// An exact payload address is the common case and constant time. An
    /// INTERIOR pointer -- a span into the middle of an array, an address
    /// computed by the string routines -- starts at the first block touching
    /// its page. The collection-time anchors preserve the authoritative block
    /// walk and its inclusive payload-end rule, without starting at the
    /// beginning of a potentially very densely populated megabyte chunk.
    static nuint BlockForPointer(nuint at)
    {
        if (_snapshots)
        {
            return SnapshotBlock(at);
        }

        // One past a payload -- a span's end -- is one past the block's
        // footer's start, which is still inside the chunk's used extent, so
        // the plain lookup finds it. NOT IN A PAGE: a block there has no
        // footer, its payload ends where it does, and one past the last
        // laid-out block's is the page's end, which the lookup does not
        // count as the page's. The byte below finds it; a block's end is
        // eight-aligned, so nothing else is asked twice.
        nuint chunk = HeapChunks.Of(at);
        if (chunk == 0 && (at & 7) == 0)
        {
            nuint below = HeapChunks.Of(at - 1);
            if (below != 0 && HeapChunks.PageClass(below) != 0) chunk = below;
        }

        if (chunk == 0 || (_minor && !HeapChunks.IsYoung(chunk)))
        {
            return 0;
        }

        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);

        if ((at & 7) == 0 && at >= first + HeaderBytes)
        {
            nuint exact = at - HeaderBytes;
            nuint word = Sys.ReadAddress(exact);
            nuint size = word & SizeMask;

            if (size >= LeastBlock && !Beyond(exact, size, end)
                && Whole(chunk, exact, word))
            {
                return exact;
            }
        }

        nuint tail = TailIn(chunk);
        nuint block = HeapChunks.MarkStart(chunk, at);

        while (block < end)
        {
            // Blocks advance monotonically. Once this payload starts after
            // the candidate, no later block can contain it. The preceding
            // block's inclusive one-past-end test has already had its turn.
            if (at < block + HeaderBytes) return 0;

            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;

            if (size < LeastBlock || Beyond(block, size, end)
                || !Whole(chunk, block, word))
            {
                // The chain of sizes is broken; nothing below is trustworthy.
                return 0;
            }

            // The payload, INCLUDING one past its end: a span's end pointer is
            // a real root, and retaining one block by accident is the cheap
            // side of that bet.
            if (at >= block + HeaderBytes && at <= block + size - tail)
            {
                return block;
            }
            WalkSteps = WalkSteps + 1;
            block = block + size;
        }
        return 0;
    }

    /// The object of the snapshot that `at` points into, or 0. Reads the
    /// snapshot's own tables and one header that no running thread writes:
    /// safe with the world running.
    static nuint SnapshotBlock(nuint at)
    {
        nuint chunk = HeapChunks.OfSnapshot(at);
        // A page by its class, as the marker finds it, where the pages were
        // not walked for their start bits (_pagesUnwalked).
        if (chunk != 0 && _pagesUnwalked && HeapChunks.PageClass(chunk) != 0)
        {
            return PageBlock((nuint)chunk, (nuint)at, (nuint)HeapChunks.PageClass(chunk));
        }

        if (chunk == 0 || HeapChunks.StartsCycle(chunk) != _cycle)
        {
            return 0;
        }

        // A payload begins a header past its block, so the block begins at
        // or below `at - HeaderBytes`; the nearest start at or below that
        // is the only candidate, and its size says whether it reaches.
        nuint highest = (at - HeaderBytes) & ~(nuint)7;

        if (highest < HeapChunks.First(chunk))
        {
            return 0;
        }

        // A REFERENCE IS A PAYLOAD'S START nearly always -- an interior
        // pointer is a span or a string routine's -- and that is one bit.
        if ((at & 7) == 0 && HeapChunks.IsStart(chunk, highest))
        {
            return highest;
        }

        nuint block = HeapChunks.StartAtOrBelow(chunk, highest);

        if (block == 0)
        {
            return 0;
        }

        nuint size = Sys.ReadAddress(block) & SizeMask;

        // One past its payload included, as BlockForPointer's walk does: in
        // a page the block's own end (TailIn).
        if (size < LeastBlock || at > block + size - TailIn(chunk))
        {
            return 0;
        }

        return block;
    }

    // ---- marking, by many threads at once --------------------------------
    //
    // THE COLLECTOR IS NOT THE ONLY MARKER. A store's barrier marks what it
    // overwrites and what it writes; a thread that allocates while a mark is
    // under way scans a few queued blocks before it goes on; an idle
    // processor scans until there is nothing left; the collecting thread
    // scans most. So a mark is a compare-and-swap on the header -- exactly one
    // thread wins it, and that thread queues the block -- and the queue is a
    // ring many threads push to and take from with nothing held (the barrier
    // ring's signature scheme, with a compare-and-swap to take as well).
    //
    // A FULL QUEUE LOSES NOTHING. A block that could not be queued keeps its
    // mark and the Overflow word says so; a rescan pass (RescanMarked) finds
    // every block marked and not yet scanned, and scans it.

    const int GreyEntry = 2 * WordSize.Bytes;       // a signature and a block

    static nuint GreySignature(nuint place)
    {
        return (place & 0x7FFFFFFF) | 0x80000000;
    }

    /// Whether marking has nothing left in hand: the queue is empty and no
    /// thread is scanning a block it took. Read in that order, so that a
    /// thread between taking the last block and scanning it is seen.
    static bool GreyIdle()
    {
        nuint ctl = GcLock.Words();
        nuint head = Sys.ReadAddress(ctl + GcLock.GreyHead);
        nuint tail = Sys.ReadAddress(ctl + GcLock.GreyTail);
        return head == tail && Sys.Read32(ctl + GcLock.Active) == 0;
    }

    /// Adds `flag` to a block's header -- and then its footer, when `tail`
    /// says it has one (TailIn) -- against every other thread doing the
    /// same. True only for the thread that set it; false for a free block
    /// and for one that already had it.
    static bool SetFlag(nuint block, nuint flag, nuint tail)
    {
        while (true)
        {
            nuint word = Sys.ReadAddress(block);

            if ((word & FlagFree) != 0 || (word & flag) != 0)
            {
                return false;
            }

            if ((Sys.Cas(block, word, word | flag)) == word)
            {
                if (tail != 0) SyncFooter(block);
                return true;
            }
        }
    }

    /// The footer brought up to the header. Two threads adding two flags
    /// may write their footers in either order; the one that sees the header
    /// change under it writes again.
    static void SyncFooter(nuint block)
    {
        while (true)
        {
            nuint word = Sys.ReadAddress(block);
            Sys.WriteAddress(block + (word & SizeMask) - FooterBytes, word);

            if (Sys.ReadAddress(block) == word)
            {
                return;
            }
        }
    }

    /// Marks the block a word might refer to and queues it for scanning.
    static void MarkAt(nuint at)
    {
        MarkWord((nuint)at, 0);
    }

    /// EVERY BLOCK EVER MARKED, as a count that only grows: the queue's tail,
    /// which the compare-and-swap that queues a block advances anyway, and
    /// the overflows that were marked without a place (PushGrey). A locked
    /// add a mark of its own was a fifth of MarkAt's time. Termination looks
    /// for no change in it across a round.
    static nuint Marked(nuint ctl)
    {
        return Sys.ReadAddress(ctl + GcLock.Pushes) + (Sys.ReadAddress(ctl + GcLock.GreyTail));
    }

    /// Scans queued blocks until there are none ready.
    static void Drain()
    {
        if (YieldHook == 0)
        {
            DrainSome(-1);
            return;
        }
        // A BUDGET AT A TIME, the platform asked between (YieldHook): what
        // is left over goes back on the queue (DrainSome), so nothing is
        // lost, and marking is only later.
        while (DrainSome(MarkBetweenYields) >= MarkBetweenYields)
        {
            Sys.Call(YieldHook, 0, 0, 0);
        }
    }

    /// LET THE PROCESSOR GO INSIDE A LONG COLLECTION: a platform whose
    /// threads are not preempted -- a kernel on one processor -- had every
    /// other thread wait for a whole mark and sweep on the thread that
    /// allocated (an audio mixer woken 120-195 ms late, at 32 MB live on a
    /// K6-III). Called with 0 between OwnListStep links of a counter's read
    /// of the thread's own lists (OwnListBytes), between MarkBetweenYields
    /// blocks marked and between SweepBetweenYields chunks swept; it may
    /// give the processor to a thread that is ready, and must not allocate.
    /// The heap lock is let go there, but for a collection made alone
    /// (CollectAlone), whose marking holds it throughout: there the platform
    /// must not give the processor away (it can tell, Runtime.HoldsHeapLock),
    /// nor where the thread's preempt count is raised (Tls.PreemptCount):
    /// the platform must refuse there itself, as every caller but
    /// OwnListBytes, which leaves the call out, asks regardless. Called with 1
    /// by a thread about to wait for another's collection to end, with the
    /// heap lock not held -- blocked (WaitForCollector), or still counted
    /// running and answering rounds as it waits (WaitOutAnyCycle, for
    /// ReleaseHeap and ReferencesIntoReport): it should give the processor
    /// to a thread that is ready whether or not one is due, since the
    /// collector may be one of them -- and answer nonzero when this thread
    /// may not give it away and may wait for ever (a kernel's thread with
    /// its preemption count raised, or interrupts off), which then does
    /// without that cycle's end: an allocation takes its last try at once,
    /// with the cap lifted for it (HeapChunks.PastCap); a collection asked
    /// for is not made, and what needed one says so (CollectMade). 0
    /// answers otherwise. 0: none.
    public static nuint YieldHook;
    const int MarkBetweenYields = 4096;
    const int RootsBetweenYields = 4096;            // words of a root range
    const int CardsBetweenYields = 64;              // taken cards of a chunk
    const int SweepBetweenYields = 16;

    /// Scans at most `budget` queued blocks -- all of them when it is
    /// negative -- and answers how many. Any thread may: the one that takes
    /// a block scans it, and says it is busy (Active) from before the take
    /// until after the scan, so that nobody decides the mark is over while
    /// a block is in its hands.
    static long DrainSome(long budget)
    {
        nuint ctl = GcLock.Words();
        long done = 0;

        // BUSY ONCE FOR THE RUN, not once a block: from before the first take
        // to after the last scan the thread holds a block or is about to, and
        // two locked additions a block were a large part of what marking a
        // gigabyte cost.
        Sys.AtomicAdd32(ctl + GcLock.Active, 1);

        // ITS OWN STACK FOR WHAT IT MARKS (ClaimLocal), taken from before its
        // own pops: the shared queue's compare-and-swap and locked exchange
        // a block, on one line every marker went through, were most of what
        // marking cost (MarkWord's stalls were the two locked instructions).
        nuint local = ClaimLocal();
        bool aborted = false;

        // THE COUNT IN WORDS: compared a 64-bit long a block, it was an add
        // and an adc, a compare and an sbb, held in the frame.
        int left = budget < 0 || budget > 0x7FFFFFFF ? 0x7FFFFFFF : (int)budget;
        int scanned = 0;
        while (scanned < left)
        {
            if (Sys.Read32(ctl + GcLock.Abort) != 0)
            {
                aborted = true;
                break;
            }

            nuint entry = local != 0 ? PopLocal(local) : 0;
            if (entry == 0) entry = PopGrey();

            if (entry == 0)
            {
                break;
            }

            nuint block = Untag(entry);
            nuint tail = TailOfEntry(entry);
            if (ClaimScan(block, tail))
            {
                ScanBlock(block, Sys.ReadAddress(block) & ~(nuint)7, tail, local);
            }

            scanned = scanned + 1;
        }
        done = (long)scanned;

        if (local != 0)
        {
            // What it still holds goes back on the shared queue, a budget
            // spent; given up, the queue is emptied anyway (GiveUp). Its
            // marks counted before it says it is idle: Marked must have
            // grown by then, or a round could see nothing marked.
            if (!aborted) ShareLocal(local, 0);
            ReleaseLocal(local);
        }

        Sys.AtomicAdd32(ctl + GcLock.Active, -1);
        return done;
    }

    // ---- each marker's own stack --------------------------------------------
    //
    // A POOL OF STACKS, one claimed by each thread for the length of a drain
    // (DrainSome): a collector worker has no thread block to keep one in, and
    // the drain passes it down its own scan (MarkWord's `local`). Pushes and
    // pops are plain loads and stores; the shared queue sees only what is
    // shared out (ShareLocal) and what the roots, the barrier and the cards
    // push, which do not drain. A stack is three words -- its depth, the
    // blocks marked into it, pushes since it last looked at the queue --
    // and LocalEntries places.
    const int LocalStacks = 32;
    const int LocalEntries = 2048;
    const int LocalHead = 3;
    /// The pool: LocalStacks claim words, then the stacks. 0 until a drain
    /// first asks; mapped once, never given back.
    static nuint _localPool;

    static nuint LocalStackBytes()
    {
        return (nuint)((LocalHead + LocalEntries) * WordSize.Bytes);
    }

    /// A free stack, emptied, or 0 when every one is in use (the drain then
    /// pushes to the shared queue, as all of them once did).
    static nuint ClaimLocal()
    {
        nuint pool = _localPool;
        if (pool == 0)
        {
            nuint bytes = (LocalStacks + LocalStacks * (LocalHead + LocalEntries)) * WordSize.Bytes;
            nuint fresh = Platform.Map(bytes);
            if (fresh == 0) return 0;
            if (Sys.Cas(Sys.AddressOf(ref _localPool), 0, fresh) != 0) Platform.Unmap(fresh, bytes);
            pool = _localPool;
        }
        const int w = WordSize.Bytes;
        for (nuint k = 0; k < LocalStacks; k++)
        {
            nuint claim = pool + k * WordSize.Bytes;
            if (Sys.ReadAddress(claim) == 0 && Sys.Cas(claim, 0, 1) == 0)
            {
                nuint stack = (nuint)pool + (nuint)LocalStacks * w + (nuint)k * LocalStackBytes();
                Sys.WriteAddress(stack, 0);
                Sys.WriteAddress((stack + w), 0);
                Sys.WriteAddress((stack + 2 * w), 0);
                return stack;
            }
        }
        return 0;
    }

    /// The stack given back, its marks added to every block ever marked (Marked).
    static void ReleaseLocal(nuint stack)
    {
        nuint ctl = GcLock.Words();
        nuint marked = Sys.ReadAddress(stack + WordSize.Bytes);
        if (marked != 0) Sys.AtomicAdd(ctl + GcLock.Pushes, marked);
        nuint pool = _localPool;
        nuint k = (stack - (nuint)pool - (nuint)(LocalStacks * WordSize.Bytes)) / LocalStackBytes();
        Sys.AtomicSwap(pool + k * WordSize.Bytes, 0);
    }

    /// A block this drain has just marked, on its own stack: half of it
    /// shared out when full, and some when the shared queue runs low while
    /// other markers could take it.
    static void PushLocal(nuint stack, nuint block)
    {
        const int w = WordSize.Bytes;
        nuint depth = Sys.ReadAddress(stack);
        if (depth >= (nuint)LocalEntries)
        {
            ShareLocal(stack, LocalEntries / 2);
            depth = Sys.ReadAddress(stack);
        }
        Sys.WriteAddress((stack + ((nuint)LocalHead + depth) * w), block);
        Sys.WriteAddress(stack, (depth + 1));
        Sys.WriteAddress((stack + w), (Sys.ReadAddress(stack + w) + 1));
        nuint since = Sys.ReadAddress(stack + 2 * w) + 1;
        if (since < 64)
        {
            Sys.WriteAddress((stack + 2 * w), since);
            return;
        }
        Sys.WriteAddress((stack + 2 * w), 0);
        // SHARED WHILE OTHERS COULD TAKE IT: workers that look at a queue
        // below the depth that wakes them (WorkerWakeDepth) find nothing.
        if (Workers == 0 || depth + 1 < 2 * (nuint)WorkerWakeDepth) return;
        nuint ctl = GcLock.Words();
        nuint head = Sys.ReadAddress((nuint)ctl + (nuint)GcLock.GreyHead);
        nuint queued = Sys.ReadAddress((nuint)ctl + (nuint)GcLock.GreyTail) - head;
        if (queued < (nuint)WorkerWakeDepth) ShareLocal(stack, ((depth + 1) / 2));
    }

    /// The top block of this drain's own stack, or 0 when it is empty.
    static nuint PopLocal(nuint stack)
    {
        nuint depth = Sys.ReadAddress(stack);
        if (depth == 0) return 0;
        depth = depth - 1;
        Sys.WriteAddress(stack, depth);
        return Sys.ReadAddress(stack + ((nuint)LocalHead + depth) * WordSize.Bytes);
    }

    /// Moves blocks from the top of this drain's stack to the shared queue
    /// until `keep` are left: those pushes are counted there (Marked) and
    /// wake parked workers as any push does.
    static void ShareLocal(nuint stack, nuint keep)
    {
        while (Sys.ReadAddress(stack) > keep)
        {
            nuint block = PopLocal(stack);
            PushGrey(block);
        }
    }

    /// Whether a push found the queue full since this was last asked.
    static bool TakeOverflow()
    {
        if (Sys.AtomicSwap32(GcLock.Words() + GcLock.Overflow, 0) == 0)
        {
            return false;
        }
        AskForBiggerQueue();
        return true;
    }

    /// AN OVERFLOW ASKS THE NEXT CYCLE FOR FOUR TIMES THE QUEUE, as far as a
    /// thirty-second of the heap (a power of two, as the ring's index needs).
    /// This cycle rescans as it always has; the queue is changed only between
    /// cycles, when it is empty (FitMarkQueue). A small heap therefore never
    /// grows past the queue it started with.
    static void AskForBiggerQueue()
    {
        nuint share = (nuint)(HeapChunks.HeapBytes / MarkShare);
        nuint bigger = _markBytes * 4;
        while (bigger > _markBytes && bigger > share)
        {
            bigger = bigger / 2;
        }
        if (bigger > _markBytes && bigger > _markWanted)
        {
            _markWanted = bigger;
        }
    }

    /// The queue an overflow asked for, taken now, while no mark is under
    /// way and the ring is empty. The new ring reads as empty from its first
    /// place, whatever the head and tail count: an unwritten place never
    /// carries a signature (GreySignature sets the top bit). A system that
    /// will not give the memory keeps the old queue, which still works.
    static void FitMarkQueue()
    {
        nuint wanted = _markWanted;
        _markWanted = 0;
        if (wanted <= _markBytes)
        {
            return;
        }
        nuint fresh = Platform.Map(wanted);
        if (fresh == 0)
        {
            return;
        }
        if (_markAt != 0)
        {
            Platform.Unmap(_markAt, _markBytes);
        }
        _markAt = fresh;
        _markBytes = wanted;
        _markCount = wanted / GreyEntry;
    }

    /// A ROOT RANGE REGISTERED WHILE A MARK IS UNDER WAY IS MARKED FROM NOW.
    /// The registered ranges are read once a collection, with the
    /// collector's own roots (GcRoots.ScanAll, before the SCAN round); a
    /// thread's stack is read when it answers SCAN, from wherever it stands
    /// then. A kernel's thread is a processor, and a process parks its
    /// kernel stack (a registered range, KernelContinuation) and goes to
    /// the scheduler's: parked after the roots were read and before its
    /// processor answered, the stack was neither -- the processor answered
    /// from the scheduler's stack -- and an object only it held was swept
    /// under a live frame. An exec's ElfLoader, held by its frame through
    /// every disc read, became another exec's symbol names, and four
    /// processors took page faults in Bind and Reach (2026-09-26).
    ///
    /// Marked here the way the barrier marks once pointers resolve
    /// (Marking 2); in the stamping phase before it (Marking 1) the range
    /// is read with the roots, which have not been yet. Not answered for in
    /// the middle (Tls.InAlloc), as the barrier is not: a round that saw
    /// this thread out would let the mark end with a push still to come.
    ///
    /// THE REGISTERS FIRST. The range is the stack this runs on, registered
    /// before its owner's registers are spilled into it, so a reference
    /// held only in EBX, ESI or EDI is not in it yet. The prologue here
    /// pushes the caller's values of every one (Sys.SaveRegisters) inside the
    /// range, as Platform.EnterCollection does for the collector; never put
    /// in place in a caller, whose own prologue pushes only what it uses.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void MarkRegistered(nuint start, nuint end)
    {
        Sys.SaveRegisters();
        // The range is published (GcRoots.Register) before this reads the
        // phase, and the collector sets the phase before it reads the
        // ranges: one of the two sees the other.
        Sys.Fence();

        if (Runtime.Marking == 0)
        {
            return;
        }

        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Sys.Fence();

        if (Runtime.Marking == 2)
        {
            ScanRange(start, end);
            RegisteredMidMark = RegisteredMidMark + 1;
        }

        Sys.WriteAddress(tb + Tls.InAlloc, was);
    }

    /// Root ranges marked from as they were registered, a mark under way.
    public static long RegisteredMidMark;

    // ---- marking ---------------------------------------------------------------
    //
    // THE MARKER'S INNER LOOP: from a word read out of a live object to its
    // block, the block's flag, the grey queue and back, for every word of
    // every live object -- kept to the machine's word, one register an
    // address on i386 as in long mode.

    /// `local`: the draining thread's own stack (ClaimLocal), where what it
    /// marks goes with no atomic operation, or 0 for the shared queue.
    ///
    /// WHETHER THE BLOCK HAS A FOOTER is learnt here, where its chunk is
    /// found anyway, and travels with it: a page's block has none, so its
    /// flags go to its header alone and its payload runs to its end
    /// (TailIn). It is queued with PagedBit set in its address -- eight-
    /// aligned, the low bits are free -- and whoever pops it reads the bit
    /// back (Untag) rather than look the chunk up again for every block.
    // A CALL OF ITS OWN, so that what calls it stays small enough to be put
    // in place in the scan loops (MarkRef): put into MarkRef itself, it
    // made that a call, and every null word a scan met paid for one.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void MarkWord(nuint at, nuint local)
    {
        if (CountMarks) MarkCalls = MarkCalls + 1;
        nuint block;
        nuint tail;
        nuint slots = _markSlots;
        if (slots != 0)
        {
            // ONE LOAD FOR THE CHUNK, by the word's 4 KB (HeapChunks.Of's
            // table): 0 for a null, a number, a code or static address --
            // most of the words a scan meets -- and for a chunk not mapped.
            // Where OfSnapshot searched the snapshot's chunks from a word per
            // 64 KB and read each one's limit. No chunk is given back while a
            // mark runs (Free and the pool's drain refuse then, and the sweep
            // comes after), and one made since holds only newcomers: a page's
            // are refused by their headers or marked and kept, a mixed
            // chunk's by its start table, which is not this cycle's.
            nuint chunk = InWindow(at) ? Sys.ReadAddress(slots + (at >> 12) * WordSize.Bytes) : 0;
            block = 0;
            tail = 0;
            if (chunk != 0)
            {
                nuint cls = Sys.ReadAddress(chunk + (nuint)HeapChunks.ClassAt);
                if (cls != 0 && !_concurrent)
                {
                    block = PageBlock(chunk, at, cls);
                }
                else if (at < Sys.ReadAddress(chunk + (nuint)HeapChunks.LimitAt))
                {
                    // A mixed chunk's block by its start bits; and a page's
                    // too in a cycle beside running threads, whose newcomers
                    // only the start bits tell (PageBlock).
                    block = SnapshotBlockIn(chunk, at);
                    tail = cls != 0 ? (nuint)0 : FooterBytes;
                }
            }
        }
        else if (_snapshots)
        {
            nuint chunk = HeapChunks.OfSnapshot(at);
            block = chunk == 0 ? 0 : SnapshotBlockIn(chunk, at);
            tail = block == 0 ? 0 : (nuint)TailIn(chunk);
        }
        else
        {
            block = (nuint)BlockForPointer(at);
            tail = block == 0 ? 0 : (nuint)TailOf(block);
        }

        if (block == 0)
        {
            // Not the heap's: counted when a quarantined range's references
            // are (CountReferencesInto).
            if (_referencesEnd != 0) NoteReference(at);
            return;
        }

        // NOTHING IN A LEAF TO FOLLOW: marked and scanned at once, by one
        // compare-and-swap that sets both, where it took two -- a string's
        // or an array of numbers' mark was two locked instructions. Its kind
        // is read first: a live block's never changes, and a free block's
        // word there is a link, a multiple of eight that KindLeaf is not --
        // and the swap refuses a free block anyway. A word pointing at a free
        // block is a number that happens to look like a pointer.
        bool leaf = Sys.ReadAddress(block + KindAt) == KindLeaf;
        if (!MarkFlags(block, leaf ? (nuint)(FlagMark | FlagScan) : FlagMark, tail))
        {
            return;
        }
        if (CountMarks) _marksNew = _marksNew + 1;
        if (_census)
        {
            _censusMarked = _censusMarked + (long)(Sys.ReadAddress(block) & SizeMask);
        }
        if (leaf)
        {
            return;
        }

        if (tail == 0) block = block | (nuint)PagedBit;
        if (local != 0) PushLocal(local, block);
        else PushGrey(block);
    }

    /// THE BLOCK OF A SIZE-CLASS PAGE A WORD POINTS INTO, by its class: the
    /// offset times the class's reciprocal (OnGrid's), with no start bits
    /// read and no division. The candidate is the block holding the word a
    /// header below `at` -- a payload pointer is one past its header, and
    /// one past a payload's end is still its block, as SnapshotBlockIn has
    /// it -- and it is one only if its header says the class's size: the
    /// page's tail not yet laid out, its header, its start table, are not.
    /// Free blocks pass here and are refused by the mark (MarkFlags).
    ///
    /// NO START BITS: ONLY WITH THE WORLD STOPPED (MarkWord asks it only when
    /// the cycle is not concurrent), when every block a page holds was there
    /// at the snapshot -- the start bits would say the same of each, and
    /// need not be written (BuildBlockAnchors, _pagesUnwalked). Beside
    /// running threads a page's newcomers are told by their missing start
    /// bits, which this cannot see. In a minor cycle a page not walked holds
    /// old blocks only, marked already, and free ones: the mark refuses both.
    static nuint PageBlock(nuint page, nuint at, nuint cls)
    {
        nuint first = page + (nuint)HeapChunks.FirstAt;
        nuint highest = (at - HeaderBytes) & ~(nuint)7;
        if (at < first + HeaderBytes || highest >= Sys.ReadAddress(page + (nuint)HeapChunks.EndAt))
        {
            return 0;
        }
        nuint c = cls - 1;
        nuint size = Sys.ReadAddress((nuint)_classSize + c * WordSize.Bytes);
        nuint offset = highest - first;
        // Under 2^16 in a page, as OnGrid requires for the floor to be exact.
        if (offset >= 0x10000) return 0;
        ulong quotient = ((ulong)offset * Sys.ReadAddress(_classStep + c * WordSize.Bytes)) >> 32;
        nuint block = first + (nuint)quotient * size;
        if ((Sys.ReadAddress(block) & ~(nuint)7) != size || at > block + size)
        {
            return 0;
        }
        return block;
    }

    /// The marker's 4 KB table (HeapChunks.SlotTable) while the snapshot is
    /// whole (BuildBlockAnchors), else 0: MarkWord's way in, and MarkRef's.
    static nuint _markSlots;

    /// A word of a block being scanned, marked from: those that lie in no
    /// chunk -- null above all -- turned away by one load before the call.
    static void MarkRef(nuint at, nuint local)
    {
        nuint slots = _markSlots;
        if (slots != 0 && (!InWindow(at) || Sys.ReadAddress(slots + (at >> 12) * WordSize.Bytes) == 0))
        {
            return;
        }
        MarkWord(at, local);
    }

    /// Whether a word lies in the 4 KB table's window (HeapChunks.SlotLow,
    /// SlotSpan): every address on i386; in long mode a word outside it is
    /// in no chunk while the marker reads the table (HeapChunks.Whole), and
    /// its table word would be outside the table.
    static bool InWindow(nuint at)
    {
#if TARGET_64BIT
        return HeapChunks.InSlotWindow(at);
#else
        return true;
#endif
    }

    /// The bit a queued block carries when it lies in a size-class page and
    /// has no footer (MarkWord).
    const int PagedBit = 1;

    /// A queued block's address, its tag taken off.
    static nuint Untag(nuint entry)
    {
        return entry & ~(nuint)7;
    }

    /// What follows a queued block's payload, by its tag (TailIn).
    static nuint TailOfEntry(nuint entry)
    {
        return (entry & (nuint)PagedBit) != 0 ? (nuint)0 : FooterBytes;
    }

    /// The mark: `flags` added to the header (and footer) of a block not yet
    /// marked, against every other marker -- SetFlag, but refusing only a
    /// free block or a marked one, so that a leaf's mark can carry its scan
    /// flag with it (MarkWord). True only for the thread that marked it.
    static bool MarkFlags(nuint block, nuint flags, nuint tail)
    {
        while (true)
        {
            nuint word = Sys.ReadAddress(block);

            if ((word & (nuint)(FlagFree | FlagMark)) != 0)
            {
                return false;
            }

            if ((nuint)Sys.Cas(block, word, (word | flags)) == word)
            {
                if (tail != 0) SyncFooter(block);
                return true;
            }
        }
    }

    /// A QUEUED BLOCK'S SCAN CLAIMED WITH A PLAIN STORE, where SetFlag takes
    /// a locked compare-and-swap: one locked instruction a marked object, the
    /// second of two, and a locked instruction is a full fence on top of its
    /// own twenty-odd cycles. The swap is not needed here. A block is queued
    /// once, by the thread whose swap marked it (MarkWord), so whoever pops
    /// it is the only one to claim it from a queue; the header's one other
    /// writer while it is marked and unscanned is RescanMarked, which adds
    /// the same flag -- so the store can lose nothing but that flag, which
    /// it sets itself -- and at worst the block is scanned twice, which
    /// marks nothing twice (MarkWord refuses a marked block). Nothing frees,
    /// merges or splits a block while a mark runs (Free refuses then).
    /// `tail`: what follows its payload (TailIn).
    static bool ClaimScan(nuint block, nuint tail)
    {
        nuint word = Sys.ReadAddress(block);
        if ((word & (nuint)(FlagFree | FlagScan)) != 0)
        {
            return false;
        }
        Sys.WriteAddress(block, (word | FlagScan));
        if (tail != 0) SyncFooter(block);
        return true;
    }

    /// Queues a block this thread has just marked.
    static void PushGrey(nuint block)
    {
        nuint ctl = (nuint)GcLock.Words();
        nuint ring = (nuint)_markAt;
        nuint count = (nuint)_markCount;

        while (true)
        {
            // The head first: it only follows the tail, so a tail read after
            // it is never behind it, and their difference never wraps.
            nuint head = Sys.ReadAddress(ctl + (nuint)GcLock.GreyHead);
            nuint tail = Sys.ReadAddress(ctl + (nuint)GcLock.GreyTail);

            if (ring == 0 || tail - head >= count)
            {
                // Marked and not queued: counted here, as the queue's tail
                // counts every block that was (Marked).
                Sys.AtomicAdd((ctl + (nuint)GcLock.Pushes), 1);
                Sys.AtomicSwap32((ctl + (nuint)GcLock.Overflow), 1);
                return;
            }

            // Claimed with a compare-and-swap and not an add, so that a place
            // is only ever claimed when it is free: an add past a full ring
            // would leave a claim nobody fills, and every taker would stop at
            // it for good.
            if ((nuint)Sys.Cas((ctl + (nuint)GcLock.GreyTail), tail, (tail + 1)) != tail)
            {
                continue;
            }

            nuint at = ring + (tail & (count - 1)) * (nuint)GreyEntry;
            Sys.WriteAddress((at + WordSize.Bytes), block);
            Sys.AtomicSwap(at, GreySignature(tail));

            nuint depth = tail + 1 - head;
            if (depth > _markPeak) _markPeak = depth;
            if (Workers != 0) WakeWorkers(depth);
            return;
        }
    }

    /// The next queued block, or 0 when none is ready to take -- the queue is
    /// empty, or the next place is claimed and not yet written, which its
    /// pusher is a few instructions from doing.
    static nuint PopGrey()
    {
        nuint ctl = (nuint)GcLock.Words();

        while (true)
        {
            nuint head = Sys.ReadAddress(ctl + (nuint)GcLock.GreyHead);
            nuint tail = Sys.ReadAddress(ctl + (nuint)GcLock.GreyTail);

            if (head == tail || _markAt == 0)
            {
                return 0;
            }

            nuint at = (nuint)_markAt + (head & ((nuint)_markCount - 1)) * (nuint)GreyEntry;

            if (Sys.ReadAddress(at) != (nuint)GreySignature(head))
            {
                return 0;
            }

            // Read before the take: once the head has moved past this place a
            // pusher may claim it again and write over the block.
            nuint block = Sys.ReadAddress(at + WordSize.Bytes);

            if ((nuint)Sys.Cas((ctl + (nuint)GcLock.GreyHead), head, (head + 1)) == head)
            {
                return block;
            }
        }
    }

    /// A marked block's references marked in turn: none for a leaf, the ones
    /// its descriptor names for an object, every word for the rest. `tail`:
    /// what follows its payload (TailIn). `local`: the draining thread's own
    /// stack (ClaimLocal) for what this marks, or 0 for the shared queue.
    static void ScanBlock(nuint block, nuint size, nuint tail, nuint local = 0)
    {
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind == KindLeaf)
        {
            return;
        }
        nuint payload = block + HeaderBytes;
        nuint end = block + size - tail;
        // NO PAYLOAD, NOTHING TO READ: a 16-byte page block in long mode is a
        // bare header, and an object's type word would be the next block's.
        if (end <= payload) return;
        if (kind != KindObject || !ScanObject(payload, end, local))
        {
            ScanRange(payload, end, local);
        }
    }

    /// Every word-aligned word of [from, to) marked from, as a reference may
    /// be any of them; `local` as ScanBlock's.
    static void ScanRange(nuint from, nuint to, nuint local = 0)
    {
        const int w = WordSize.Bytes;
        nuint p = (from + w - 1) & ~(nuint)(w - 1);

        while (p < to)
        {
            MarkRef(Sys.ReadAddress(p), local);
            p = p + w;
        }
    }

    /// AN OBJECT BY ITS DESCRIPTOR: the words its reference map names, or,
    /// for an array of references, its elements. False when the object
    /// cannot be read that way -- no vtable yet (made, not yet described:
    /// nothing is in it), a first word that is not a descriptor's vtable, an
    /// array of anything but references, a count past the block -- and the
    /// caller scans every word instead, which is never wrong. The array's
    /// count is checked against the room before it is multiplied: in 32 bits
    /// count * w can wrap, and `last > end` alone would then pass.
    static bool ScanObject(nuint payload, nuint end, nuint local)
    {
        const int w = WordSize.Bytes;
        nuint vt = Sys.ReadAddress(payload);
        if (vt == 0 || (_anyQuarantined && InQuarantine(vt)))
        {
            return false;
        }
        nuint desc = vt - (nuint)DescWords * w;
        if (Sys.ReadAddress(desc + (nuint)DescSelfWord * w) != desc)
        {
            return false;
        }
        nuint flags = Sys.ReadAddress(desc + (nuint)DescFlagsWord * w);
        if ((flags & (nuint)SequenceFlag) != 0)
        {
            if ((flags & (nuint)StringFlag) != 0)
            {
                return true;
            }
            // AN ARRAY OF NUMBERS HOLDS NO REFERENCE, as in .NET: read word by
            // word, every hash code and offset that looked like an address
            // was looked up -- a large part of marking a compiler's heap --
            // and kept whatever it happened to land on.
            if ((Sys.ReadAddress(desc + (nuint)DescGcFlagsWord * w) & (nuint)ElementsAreReferences) == 0)
            {
                return true;
            }
            if (Sys.ReadAddress(desc + (nuint)DescSizeWord * w) != w)
            {
                return false;
            }
            nuint count = Sys.ReadAddress(payload + (nuint)ArrayCountAt) & 0x7FFFFFFF;
            nuint first = payload + Sys.ReadAddress(desc + (nuint)DescPayloadWord * w);
            if (first > end || count > (end - first) >> WordSize.Shift)
            {
                return false;
            }
            ScanRange(first, first + count * w, local);
            return true;
        }
        nuint map = Sys.ReadAddress(desc + (nuint)DescRefMapWord * w);
        if (map == 0)
        {
            return true;
        }
        // The map: how many words it covers, then 32 bits to a word.
        nuint words = Sys.ReadAddress(map);
        nuint k = 0;
        while (k * 32 < words)
        {
            uint bits = (uint)Sys.ReadAddress(map + (1 + k) * w);
            nuint at = payload + k * 32 * w;
            while (bits != 0)
            {
                if ((bits & 1) != 0 && at + w <= end)
                {
                    MarkRef(Sys.ReadAddress(at), local);
                }
                bits = bits >> 1;
                at = at + w;
            }
            k = k + 1;
        }
        return true;
    }

    /// The block of `at` as SnapshotBlock finds it, in the snapshot's chunk
    /// of `at` (HeapChunks.OfSnapshot) that the caller has found, the
    /// chunk's start bits read once: it says too whether the block has a
    /// footer.
    static nuint SnapshotBlockIn(nuint chunk, nuint at)
    {
        nuint starts = HeapChunks.Starts(chunk);
        if (starts == 0 || Sys.ReadAddress(starts) != _cycle)
        {
            return 0;
        }

        // A payload begins a header past its block, so the block begins at
        // or below `at - HeaderBytes`; the nearest start at or below that
        // is the only candidate, and its size says whether it reaches.
        nuint highest = (at - HeaderBytes) & ~(nuint)7;
        if (highest < HeapChunks.First(chunk))
        {
            return 0;
        }
        nuint block = HeapChunks.StartAtOrBelow(chunk, starts, highest, (at & 7) == 0);
        if (block == 0)
        {
            return 0;
        }
        if (block == highest && (at & 7) == 0)
        {
            return block;
        }
        nuint size = Sys.ReadAddress(block) & ~(nuint)7;
        if (size < LeastBlock || at > block + size - (nuint)TailIn(chunk))
        {
            return 0;
        }
        return block;
    }

    /// Whether the marker reads the word at `at` of a block -- ScanBlock's
    /// and ScanObject's rules, for the verifier (VerifyMinor), which must
    /// not report a number in an object's int field that looks like an
    /// address: the marker never follows it, and nothing depends on it.
    /// Whether a block is an array of numbers: one the marker never scans.
    static bool NumbersOnly(nuint block)
    {
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        if (Sys.ReadAddress(block + KindAt) != KindObject) return false;
        nuint vt = Sys.ReadAddress(payload);
        if (vt == 0 || InQuarantine(vt)) return false;
        nuint desc = vt - DescWords * w;
        if ((Sys.ReadAddress(desc + DescSelfWord * w)) != desc) return false;
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        return (flags & SequenceFlag) != 0 && (flags & StringFlag) == 0
            && (Sys.ReadAddress(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0;
    }

    static bool MarkerReads(nuint block, nuint size, nuint at, nuint tail)
    {
        const int w = WordSize.Bytes;
        nuint payload = block + HeaderBytes;
        nuint end = block + size - tail;
        nuint kind = Sys.ReadAddress(block + KindAt);
        if (kind == KindLeaf)
        {
            return false;
        }
        nuint vt = Sys.ReadAddress(payload);
        if (kind != KindObject || vt == 0 || InQuarantine(vt))
        {
            return true;
        }
        nuint desc = vt - DescWords * w;
        if ((Sys.ReadAddress(desc + DescSelfWord * w)) != desc)
        {
            return true;
        }
        nuint flags = Sys.ReadAddress(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0)
            {
                return false;
            }
            // AN ARRAY OF INTEGERS is not scanned (ScanObject), and an
            // integer is not a reference to the card contract either -- its
            // stores take no card -- and one that happens to equal an
            // address, an identity hash above all, is no pointer.
            if ((Sys.ReadAddress(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0)
            {
                return false;
            }
            if (Sys.ReadAddress(desc + DescSizeWord * w) != w)
            {
                return true;
            }
            nuint count = Sys.ReadAddress(payload + ArrayCountAt) & 0x7FFFFFFF;
            nuint first = payload + Sys.ReadAddress(desc + DescPayloadWord * w);
            nuint last = first + count * w;
            if (last > end || last < first)
            {
                return true;
            }
            return at >= first && at < last;
        }
        nuint map = Sys.ReadAddress(desc + DescRefMapWord * w);
        if (map == 0 || at < payload || ((at - payload) & (w - 1)) != 0)
        {
            return false;
        }
        nuint index = (at - payload) / w;
        if (index >= Sys.ReadAddress(map))
        {
            return false;
        }
        return ((Sys.ReadAddress(map + (1 + index / 32) * w) >> (int)(index & 31)) & 1) != 0;
    }

    /// Runs a collection. Everything reachable from the stack, the registers
    /// and the statics is kept; everything else goes back on the free list.
    /// Entered through GcRoots so the registers are on the stack first --
    /// see GcRoots for the reasoning -- and reached only from Alloc.
    public static void Collect()
    {
        CollectMade();
    }

    /// Collect, answering whether a collection was made: false when another
    /// thread's was under way and the platform said this thread may not
    /// wait it out (WaitForCollector). What needs the collection's walk or
    /// its counts -- Revoke, CountIn, CountReferencesInto, ReleaseHeap --
    /// asks this, and says it could not.
    public static bool CollectMade()
    {
        // ASKED FOR, it is whole: GC.Collect promises every unreachable
        // object is gone, and a minor collection leaves the old ones be.
        // No heap yet, nothing to collect: and asking its lock would map
        // the lock's words before SetHeap (Free).
        if (!HeapChunks.Any()) return true;
        _forceMajor = true;
        long tries = 0;
        while (true)
        {
            GcLock.Enter();

            if (!_collecting)
            {
                long had = Collections;
                long abortedHad = Aborted;
                CollectLocked();
                GcLock.Exit();
                // GIVEN UP -- a barrier report lost to a full ring -- nothing
                // was freed, and the call promised what was unreachable is
                // gone: again, a few times, each major with a ring fitted
                // larger (FitBarrier). Not for ever: a ring that overflows
                // every time leaves the call as an allocation's would.
                tries = tries + 1;
                if (Collections != had || Aborted == abortedHad || tries >= 4) return true;
                _forceMajor = true;
                continue;
            }

            // Somebody else's collection is between its two stops. Asking
            // for one means wanting one that STARTED after the call: wait
            // that one out, as a thread that is blocked and readable.
            // A THREAD THAT MAY NOT GIVE THE PROCESSOR AWAY (WaitForCollector
            // false) cannot wait that cycle out: none is made for it.
            GcLock.Exit();
            GcThreads.BeginBlocking();
            nuint cycling = GcLock.Words() + GcLock.Cycling;
            bool waited = true;

            while (waited && Sys.Read32(cycling) != 0)
            {
                waited = WaitForCollector(cycling);
            }

            GcThreads.EndBlocking();
            if (!waited) return false;
        }
    }

    /// Waits for another thread's collection the platform refused
    /// (WaitForCollector false), and of them the allocations that went
    /// without it, taking their last try at once. Counted without a lock:
    /// a figure to read, not to reckon with.
    public static long RefusedWaits, RefusedAllocations;

    /// With the heap lock held, until no cycle is under way at all -- none
    /// marking, none sweeping -- answering every round meanwhile, the lock
    /// let go while waiting. False, the lock held again, when the platform
    /// says this thread may not wait (YieldHook with 1, as WaitForCollector
    /// asks it).
    static bool WaitOutAnyCycle()
    {
        while (_collecting || _sweeping || Runtime.Marking != 0)
        {
            GcLock.Exit();
            if (YieldHook != 0 && Sys.Call(YieldHook, 1, 0, 0) != 0)
            {
                GcLock.Enter();
                return false;
            }
            GcThreads.Park();
            Sys.Pause();
            GcLock.Enter();
        }
        return true;
    }

    /// One wait for another thread's collection to end: the platform asked
    /// first to give the processor away (YieldHook with 1). Its collector
    /// may be a thread that yielded between budgets; on one processor, a
    /// platform whose wait only spins and that never preempts a thread
    /// blocked here had it never run again. False, and no wait, when the
    /// platform answers that this thread may not give the processor away
    /// and so may wait for ever (a kernel's thread with its preemption
    /// count raised): the caller does without the cycle's end.
    static bool WaitForCollector(nuint cycling)
    {
        if (YieldHook != 0 && Sys.Call(YieldHook, 1, 0, 0) != 0)
        {
            RefusedWaits = RefusedWaits + 1;
            return false;
        }
        if (Sys.Read32(cycling) != 0) Platform.Wait(cycling, 1);
        return true;
    }

    /// A collection for a request that came up short, with the heap lock
    /// held: whether it was GIVEN UP and freed nothing (GiveUp), which is no
    /// try of the request's -- a few times over, `givenUp` counting, so a
    /// ring that overflows every cycle still ends in out of memory.
    static bool CollectedNothing(ref long givenUp)
    {
        long had = Collections;
        long abortedHad = Aborted;
        CollectLocked();
        if (Collections != had || Aborted == abortedHad || givenUp >= 4) return false;
        givenUp = givenUp + 1;
        _forceMajor = true;
        return true;
    }

    /// With the heap lock held, waits until the collection in progress has
    /// finished -- letting go of the lock to do it, since that collection
    /// needs it for its second stop -- as a thread that is blocked, readable
    /// and counted as stopped. The next one may have begun by the time the
    /// lock is had again: its STAMP is answered before the allocator that
    /// waited takes anything (AnswerBeforeTaking). False when the platform
    /// said this thread may not wait (WaitForCollector): the cycle may
    /// still be under way, and the request goes without it.
    static bool WaitOutCycle()
    {
        nuint cycling = GcLock.Words() + GcLock.Cycling;
        GcLock.Exit();
        GcThreads.BeginBlocking();
        bool waited = true;

        while (waited && Sys.Read32(cycling) != 0)
        {
            waited = WaitForCollector(cycling);
        }

        GcThreads.EndBlocking();
        GcLock.Enter();
        AnswerBeforeTaking(Sys.ThreadBlock());
        return waited;
    }

    // ---- a collection ---------------------------------------------------------
    //
    // NOBODY IS EVER STOPPED. A collection with one thread simply runs,
    // start to end, on that thread (CollectAlone): there is nobody to stop.
    // A collection with several runs while every thread goes on working
    // (CollectConcurrently), and asks each of them, in HANDSHAKE ROUNDS
    // (GcThreads.Round), for the part only that thread can do -- at its next
    // safepoint, or done for it by the collector if it is blocked:
    //
    //   1. The barrier goes on (Marking 1: it logs what stores overwrite and
    //      write), and with the heap lock held the collector writes down where
    //      every object starts -- stepping over the allocation buffers threads
    //      are bumping in, which are not walkable.
    //   2. STAMP: each thread writes down where the objects in its own buffer
    //      start. After this round every object that existed at the snapshot
    //      can be found from a pointer into it.
    //   3. The barrier marks from now on (Marking 2): the old value and the
    //      new, both. What it logged meanwhile is marked. The collector marks
    //      from its own stack and the statics.
    //   4. SCAN: each thread marks from its own stack and registers.
    //   5. The mark runs -- the collector, threads that allocate, idle
    //      processors -- and ACK rounds follow until one passes in which
    //      nothing at all was marked: then everything reachable is marked,
    //      because the barrier marks directly and what it finds unmarked can
    //      only be garbage or new.
    //   6. The barrier goes off, one more ACK round sees every thread out of
    //      it, and the sweep runs chunk by chunk, stepping over the buffers
    //      in use, with every thread still working.
    //
    // WHAT IS NEW IS KEPT. An object allocated after the snapshot has no
    // start bit; the marker cannot find it and the sweep keeps it (Newcomer).
    // What it refers to arrived through a store the barrier saw, or through
    // the stack of a thread that has not yet answered SCAN.

    /// The same collection with the heap lock already held, and held again
    /// when this returns. It is let go of while the others are asked for
    /// their part and while the mark and the sweep run: a caller must carry
    /// nothing it read of the heap across this call.
    /// How long the program has stood still for its collector, in
    /// microseconds: the calling thread for the whole of each collection it
    /// made (GC.GetTotalPauseDuration). The heap lock is held.
    public static long PauseMicros;

    /// The last collection's length and the longest yet, in microseconds,
    /// timed as PauseMicros is (PauseClock): what one collection keeps the
    /// thread that made it, and on a platform whose threads are not
    /// preempted, everyone else.
    public static long LastPauseMicros, LongestPauseMicros;

    /// A monotonic clock in microseconds, from a platform that has one to
    /// read from any thread at any time (Linux's clock_gettime); 0 where
    /// there is none, and pauses go untimed.
    public static nuint PauseClock;

    static void CollectLocked()
    {
        if (!HeapChunks.Any() || _collecting)
        {
            return;
        }
        if (_heapCheck)
        {
            CheckHeap(0);
        }
        if (_revokeHigh != 0)
        {
            WalkAtStart();
        }
#if !TARGET_64BIT
        if (!_mapsBuilt)
        {
            BuildMaps();
        }
#endif

        // An indirect call answers a word, so the clock is read modulo 2^32
        // microseconds; the difference of two is exact for any collection
        // shorter than an hour and eleven minutes.
        FitMarkQueue();
        _minor = NextIsMinor();
        if (!_minor)
        {
            if (!_generational) MajorsUngenerational = MajorsUngenerational + 1;
            else if (_forceMajor) MajorsAsked = MajorsAsked + 1;
            else if (_majorLive == 0) MajorsFirst = MajorsFirst + 1;
            else if (_minorsCostly) MajorsCostly = MajorsCostly + 1;
            else MajorsGrown = MajorsGrown + 1;
        }
        _forceMajor = false;
        ClaimHeldCycle();
        if (_generational)
        {
            SwapHeld();
        }
        // Asked afresh at every collection: a program may be told to take
        // the census after it started (Platform.CensusWanted).
        _census = _censusAsked || Platform.GcCensus();
        _deadCensus = _census && (_deadCensusAsked || Platform.GcDeadCensus());
        _thresholdCap = Platform.GcThreshold();
        nuint clock = PauseClock;
        uint began = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        bool minor = _minor;
        long before = Collections;
        try { CollectBoth(); }
        finally
        {
            // A step that threw leaves no stop open: refills would stay off.
            _stopOpen = false;
            if (_heapCheck)
            {
                CheckHeap(1);
            }
            if (clock != 0)
            {
                long took = (long)(Sys.Low32(Sys.Call(clock, 0, 0, 0)) - began);
                PauseMicros = PauseMicros + took;
                LastPauseMicros = took;
                if (took > LongestPauseMicros) LongestPauseMicros = took;
                if (minor) _minorPauseMicros = _minorPauseMicros + took;
                // A cycle that finished sets the pace of the next by what it
                // cost; one given up leaves it as it was.
                if (_generational && Collections != before)
                {
                    _threshold = Paced(_liveBytes, minor, took < 1 ? 1 : took);
                }
            }
        }
    }

    static void CollectBoth()
    {
        if (!GcThreads.Others())
        {
            CollectAlone();
            return;
        }

        // SEVERAL THREADS ARE NEVER COLLECTED ALONE. CollectAlone reads one
        // stack, this one's; every other thread's is read only by the rounds
        // a concurrent collection asks, and without them an object another
        // thread holds only in a register or on its stack is swept from under
        // it. The two tables the concurrent collection needs are asked for
        // again if Start could not have them; without them there is no safe
        // collection at all, and saying so is the only honest answer.
        if (_barrier == 0) MapBarrier(BarrierBytes);
        if (_markAt == 0)
        {
            _markAt = Platform.Map(MarkBytes);
            if (_markAt != 0)
            {
                _markBytes = MarkBytes;
                _markCount = MarkBytes / GreyEntry;
            }
        }
        if (_barrier == 0 || _markAt == 0)
        {
            OutOfMemory("out of memory: no room for the collector's tables, and several threads to collect for\n");
        }
        CollectConcurrently();
    }

    public static nuint PauseHook;

    /// Asked before a collection that pressure, not shortage, calls for:
    /// nonzero puts it off. It must not allocate. See AllocSlow.
    public static nuint DeferHook;
    public static long Deferred;

    /// Asked at every slow allocation: nonzero says the machine is short of
    /// memory, and a collection is due after a quarter of the live size has
    /// been allocated rather than all of it (ShortThreshold). A heap that may
    /// double before it is collected is a heap that holds its live size in
    /// garbage, which a machine with room to spare can afford and one without
    /// cannot. It must not allocate. 0, a platform that never says so.
    public static nuint ShortHook;

    /// THE PLATFORM ASKED FOR ROOM, WITH THE HEAP LOCK LET GO: called with
    /// the bytes a map was refused for, after a whole cycle has not found
    /// them; nonzero when the platform made room. A ring-1 kernel's map no
    /// longer sleeps for memory with this heap's lock held -- every other
    /// thread of the kernel waited behind it, up to a second -- it fails at
    /// once, and the wait is here, the thread counted as blocked. 0: none.
    public static nuint RoomHook;

    /// The heap lock is held on entry and on return, and let go between: the
    /// platform asked for `need` bytes of room (RoomHook), then whatever was
    /// owed while this thread was away -- a handshake's answer, a buffer
    /// given back -- seen to as at the allocator's entry. The caller's state
    /// is what it reads again after: the free lists, a cycle under way.
    /// <summary>
    /// WHETHER A REQUEST THE LAST TRY FAILED IS STILL NOT OUT OF MEMORY: the
    /// last collection found less than half the heap live, so what fills it
    /// is garbage made since, and more cycles find room. Under load, a
    /// thread short of a block waits out a cycle and wakes to find the other
    /// threads, running all the while, have filled the heap again; three
    /// tries were three such races lost, and a program holding 3.8 MB in a
    /// 21 MB heap was told it was out of memory (test 1185 on a busy
    /// machine). A few laps more, two cycles each, and only while the heap
    /// is mostly garbage: a program that really holds the heap still hears
    /// it on the third try. AND ONLY WHILE OTHERS ARE MAKING IT (_since): with
    /// nothing made since the last cycle, what the heap holds besides its
    /// live bytes is holes too small for the request, and no cycle mends
    /// them -- a compile at a 256 MB cap ran its collections back to back
    /// for ten minutes, every request lapping, rather than ending.
    /// </summary>
    static bool MostlyGarbage(long lapped) => lapped < MostLaps && _liveBytes * 2 < HeapChunks.HeapBytes && _since > 0;
    const int MostLaps = 8;

    static void WaitForRoom(nuint tb, nuint need)
    {
        if (RoomHook == 0 || tb == 0 || Sys.ReadAddress(tb + Tls.InAlloc) != 0) return;
        GcLock.Exit();
        Sys.Call(RoomHook, need, 0, 0);
        GcLock.Enter();
        AnswerBeforeTaking(tb);
    }
    public static long ShortCollections;

    static long ShortThreshold()
    {
        // AN EIGHTH: on a machine short of memory every megabyte of garbage
        // is a megabyte a program or the page cache does not have.
        long eighth = _liveBytes / 8;
        return eighth > MinThreshold ? eighth : MinThreshold;
    }

    /// Collections given up half way -- a barrier report lost to a full
    /// ring -- and begun again later. Nothing is freed by one.
    public static long Aborted;

    /// Handshake rounds asked for, over all collections.
    public static long HandshakeRounds;

    static bool _rootsOnly;         // CollectInner: the collector's own roots and no more
    static long _sinceAtStop;

    /// One thread, nobody to ask: the whole collection, here and now.
    static void CollectAlone()
    {
        nuint ctl = GcLock.Words();
        nuint self = Sys.ThreadBlock();

        // A platform that wants to know how long its only thread stood still
        // says so here: called with 0 as the collection begins and 1 as it
        // ends. It must not allocate.
        Sys.AtomicSwap32(ctl + GcLock.Cycling, 1);
        Sys.AtomicSwap32(ctl + GcLock.Collecting, 1);
        Sys.AtomicSwap(ctl + GcLock.Collector, self);
        if (PauseHook != 0) Sys.Call(PauseHook, 0, 0, 0);

        Retire(self);
        RetireClasses(self);
        GcThreads.CaptureBuffers();
        _collecting = true;
        _concurrent = false;
        _sinceAtStop = _since;
        SyncEnd();
        _cycle = _cycle + 1;
        Sys.AtomicSwap32(ctl + GcLock.Overflow, _markAt == 0 ? 1 : 0);
        StartWorkers();
        // THE SNAPSHOT'S WALK TIMED TOO: every young chunk's blocks read
        // before the roots are, which none of roots, mark and sweep counted.
        nuint clock = PauseClock;
        uint t = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        BuildBlockAnchors(false);
        // Under CheckOldCards, which cycles are collected alone and leave the
        // pages unwalked: the first few, then every fiftieth.
        if (CheckOldCards)
        {
            _aloneSaid = _aloneSaid + 1;
            if (_aloneSaid <= 4 || _aloneSaid % 50 == 0)
            {
                SayNumber("gc old cards: collected alone, cycle ", _cycle);
                SayNumber("gc old cards:   minor ", _minor ? 1 : 0);
                SayNumber("gc old cards:   pages unwalked ", _pagesUnwalked ? 1 : 0);
                SayNumber("gc old cards:   alone so far ", _aloneSaid);
            }
        }
        if (clock != 0) SnapshotMicros = SnapshotMicros + (long)(Sys.Low32(Sys.Call(clock, 0, 0, 0)) - t);
        _rootsOnly = false;
        GcRoots.Enter();

        if (PauseHook != 0) Sys.Call(PauseHook, 1, 0, 0);
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap32(ctl + GcLock.Collecting, 0);
        Sys.AtomicSwap32(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Entered through GcRoots.Enter, with every register on the stack:
    /// either the collector's own roots of a concurrent collection, or the
    /// whole of a collection with one thread.
    public static void CollectInner()
    {
        // The workers mark what the roots queue as they queue it.
        // Not for a census, whose sums are plain additions.
        // Not for a small heap, whose marking is over before the workers
        // are awake: waking them and stopping them again cost more than the
        // whole of such a collection.
        bool helped = !_concurrent && !_rootsOnly && !_census && HeapChunks.HeapBytes >= WorkersWorthBytes;
        if (helped) WorkersMark(true);
        _cardsTogether = helped && Workers > 0 && !_verify && !_heapCheck;
        nuint clock = PauseClock;
        uint t0 = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        if (!_concurrent) MarkExempt();
        GcRoots.ScanAll();

        // A MINOR CYCLE'S OTHER ROOTS, read with the ordinary ones: what old
        // objects were given since the last cycle, and what the stacks held
        // then (generations, above). A major cycle only clears the cards.
        if (_minor)
        {
            ScanTakenCards();
            RescanHeld();
        }

        if (_rootsOnly)
        {
            return;
        }

        uint t1 = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        MarkToEmpty();
        if (CountHeldAndKeep()) MarkToEmpty();
        uint t2 = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        // Idle, as MarkToEmpty found them: none holds a block, and the queue
        // is empty. A worker between its check of the word and its next take
        // finds nothing to take.
        if (helped) WorkersMark(false);
        long reportsBefore = _verifyReports;
        if (_minor && (_verifyGenerations || VerifyMarks || VerifyHeap)) VerifyMinor();
        if (!_minor && (_verifyGenerations || VerifyMarks || VerifyHeap || MajorChecked())) VerifyMajor();
        if (_verifyGenerations || VerifyMarks || VerifyHeap) VerifyRegionEscapes();
        VerifyStop(reportsBefore);
        HeapChunks.SetBlockAnchorsActive(false);
        if (_verify || VerifyingFieldFrees) CheckQuarantine();
        BeginSweep();
        SweepPagesTogether();
        while (SweepNext()) { }
        if (clock != 0)
        {
            uint t3 = Sys.Low32(Sys.Call(clock, 0, 0, 0));
            RootMicros = RootMicros + (long)(t1 - t0);
            MarkMicros = MarkMicros + (long)(t2 - t1);
            SweepMicros = SweepMicros + (long)(t3 - t2);
        }
        FinishCycle();
    }

    // WHERE A COLLECTION ALONE SPENDS ITS PAUSE: roots and cards, marking,
    // and sweeping (Corsac.GC.Stats).
    public static long SnapshotMicros;
    public static long RootMicros;
    public static long MarkMicros;
    public static long SweepMicros;

    // ---- the stop, in steps --------------------------------------------------
    //
    // THE STOP NEVER HOLDS THE HEAP LOCK FOR LONG. Its walk of the heap
    // (BuildBlockAnchors), its taking of the cards and its stamping of the
    // collector's own pages are each O(heap); held whole under the lock -- on
    // a kernel, with nothing preemptible -- they were 110-280 ms in which a
    // K6-III's audio mixer did not run. So the collector does them in steps
    // of StopBudget blocks, letting the lock go and asking the platform
    // (YieldHook) between two.
    //
    // WHAT THE STEPS MUST NOT LET IN: space a slow path takes in a chunk the
    // walk has passed holds objects with no start bit, newcomers, kept and
    // never traced -- and its thread has not answered STAMP, so a snapshot
    // string it stores in a new array (no barrier fills one) and drops from
    // its stack was swept from under the array. So WHILE A STOP IS OPEN
    // (_stopOpen) a slow path refills no buffer and no page: each request is
    // answered by one block, written into the snapshot as any block handed
    // out before its thread answers is (StampHandedOut). And whatever needs
    // a chunk's snapshot mid-stop -- that block's chunk, a page or a buffer
    // given up as a thread ends or changes heaps at a gate -- walks that one
    // chunk first if the stop's walk has not (EnsureWalked), which then
    // passes it: everything is written in as it was before the stop came in
    // steps, a major cycle's marks taken off with it. And every block handed
    // out mid-stop, a chunk's mapped since the snapshot among them (it has
    // no start table), is listed, and marked and read as roots once every
    // thread has answered (ScanStopBlocks): allocated black, it lives
    // through the cycle, and comes out of it old. Fast paths go
    // on in the buffers and pages captured before the stop, as they always
    // did beside it. Nobody waits on the stop: a thread with its count
    // raised allocates as any other, paying at most the walk of the chunks
    // it touches.

    /// The work a step of the stop does before the lock is let go: blocks of
    /// the walk, cards of the card table, and a 2048th of it in pages of the
    /// collector's own. Set by a
    /// platform or a test, 8192 when not (or set below 1); a field with no
    /// initialiser, so that the collector has no static initialiser of its
    /// own to run.
    public static long StopBudget
    {
        get { return _stopBudget > 0 ? _stopBudget : 8192; }
        set { _stopBudget = value; }
    }
    static long _stopBudget;

    static bool _stopOpen;
    // The blocks handed out mid-stop, a page's with its low bit set (it has
    // no footer): segments of StopSegmentWords words, mapped and never the
    // heap's, linked by their first word and never copied, so the lock is
    // held for no copy of the list as it grows. _stopList is the first,
    // _stopLast the one filled now, _stopCount the words used in it.
    const int StopSegmentWords = 4096;
    static nuint _stopList, _stopLast, _stopCount;
    static bool _stopListLost;

    /// Blocks answered one by one in a stop's steps; the stop's steps; the
    /// longest a step held the heap lock, in microseconds (PauseClock).
    public static long StopBlocks, StopSteps, LongestStopStep;
    static uint _stepFrom;

    static void NoteStopBlock(nuint block, bool page)
    {
        if (_stopLast == 0 || _stopCount == StopSegmentWords)
        {
            nuint segment = _stopLast != 0 ? Sys.ReadAddress(_stopLast) : 0;
            if (segment == 0 && _stopList != 0 && _stopLast == 0) segment = _stopList;
            if (segment == 0)
            {
                segment = Platform.Map(StopSegmentWords * WordSize.Bytes);
                if (segment == 0)
                {
                    // No room to write it down: the cycle is given up at the
                    // stop's end, a block not listed being one no root leads to.
                    _stopListLost = true;
                    return;
                }
                Sys.WriteAddress(segment, 0);
                if (_stopList == 0) _stopList = segment;
                else Sys.WriteAddress(_stopLast, segment);
            }
            _stopLast = segment;
            _stopCount = 1;
        }
        Sys.WriteAddress(_stopLast + _stopCount * WordSize.Bytes, page ? block | 1 : block);
        _stopCount = _stopCount + 1;
    }

    /// The list emptied for a stop: its segments kept, mapped, for the next.
    static void ResetStopBlocks()
    {
        _stopLast = 0;
        _stopCount = 0;
    }

    /// The heap lock let go between two of the stop's steps, the platform
    /// asked, and the lock taken again.
    static void StopStep()
    {
        StopSteps = StopSteps + 1;
        StopStepTimed();
        GcLock.Exit();
        if (YieldHook != 0) Sys.Call(YieldHook, 0, 0, 0);
        GcLock.Enter();
        nuint clock = PauseClock;
        _stepFrom = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
    }

    static void StopStepTimed()
    {
        nuint clock = PauseClock;
        if (clock == 0 || _stepFrom == 0) return;
        long took = (long)(Sys.Low32(Sys.Call(clock, 0, 0, 0)) - _stepFrom);
        if (took > LongestStopStep) LongestStopStep = took;
    }

    /// Every block handed out mid-stop (NoteStopBlock) marked, and what it
    /// holds read as roots, once every thread has answered STAMP and the
    /// barrier marks what any store writes (Marking 2): allocated black.
    /// Entered without the heap lock: nothing writes the list after the
    /// stop, and no block of the heap is freed while marking. The checks
    /// (VerifyStopBlock) take it for each block they read. A budget at a
    /// time, the platform asked between (ScanRootsAttributed): a dedicated
    /// array may be megabytes.
    static void ScanStopBlocks()
    {
        nuint segment = _stopList;
        long since = 0;
        while (segment != 0 && _stopLast != 0)
        {
            nuint used = segment == _stopLast ? _stopCount : StopSegmentWords;
            for (nuint i = 1; i < used; i++)
            {
                // A list of tens of thousands of blocks read with no yield
                // was a mark's budget many times over: the platform is asked
                // between, as the mark does (MarkBetweenYields).
                since = since + 1;
                if (since >= MarkBetweenYields && YieldHook != 0)
                {
                    Sys.Call(YieldHook, 0, 0, 0);
                    since = 0;
                }
                nuint entry = Sys.ReadAddress(segment + i * WordSize.Bytes);
                nuint block = entry & ~(nuint)1;
                nuint tail = (entry & 1) != 0 ? 0 : (nuint)FooterBytes;
                nuint size = Sys.ReadAddress(block) & SizeMask;
                if (size < LeastBlock) continue;
                MarkFlags((nuint)block, (nuint)(FlagMark | FlagScan), (nuint)tail);
                if (Sys.ReadAddress(block + KindAt) == KindLeaf) continue;
                ScanRootsAttributed(block + HeaderBytes, block + size - tail, 3, false);
                // ITS CARDS SET AGAIN. Black, it is old once the cycle ends,
                // and what it holds that the marker could not mark -- a
                // newcomer, in a page the walk passed by, or a chunk mapped
                // since the snapshot -- stays young: only a card leads the
                // next minor cycle to it. The card its own fill set may
                // already be gone, taken by this stop's TakeCardsSome while
                // the block was still young and its kilobyte not read; set
                // now, after the stop has taken its cards, it is the next
                // cycle's to take.
                CardsOver(block + HeaderBytes, block + size - tail);
                // Under the lock: the chunk index is nobody's to read without it.
                if (_verifyGenerations || VerifyMarks || VerifyHeap || VerifyStopBlocks)
                {
                    GcLock.Enter();
                    VerifyStopBlock(block, size, tail);
                    GcLock.Exit();
                }
            }
            if (segment == _stopLast) break;
            segment = Sys.ReadAddress(segment);
        }
        ResetStopBlocks();
    }

    /// Corsac.GC.Verify, for a block handed out mid-stop just marked and read
    /// (ScanStopBlocks): a reference in it to a block left unmarked -- a
    /// newcomer, which the marker cannot mark -- with the card over it clear
    /// is reported. The block is old once the cycle ends, the newcomer
    /// young, and without that card the next minor cycle frees what it
    /// holds. Run just after ScanStopBlocks sets the block's cards again, it
    /// guards that step: it finds nothing unless the step is lost or sets
    /// too few cards, and then it reports at once (measured on 2435 with
    /// the step taken out: 8 runs of 8 reported). That the card lives on to
    /// the next cycle's TakeCards it does not see; the next minor cycle's
    /// check (VerifyMinor) does. Counted on its own (StopBlockReports), to a
    /// cap of its own, for a test to read apart from the other checks.
    public static long StopBlockReports;

    /// VerifyStopBlock alone, without the rest of the checks of marking: what
    /// a test asks for that must finish inside its time (2435), where every
    /// cycle's whole-heap checks (VerifyMarks) do not.
    public static bool VerifyStopBlocks;

    /// The cards over [from, to) set: a block's own extent, read off its
    /// size, never its footer -- which another marker may not have written
    /// yet when it took the block first.
    static void CardsOver(nuint from, nuint to)
    {
        nuint cards = Runtime.Cards;
        if (cards == 0 || to <= from) return;
        nuint card = from >> Runtime.CardShift;
        nuint last = ((to - 1)) >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.Write8(cards + card, 1);
            card = card + 1;
        }
    }

    static void VerifyStopBlock(nuint block, nuint size, nuint tail)
    {
        nuint cards = Runtime.Cards;
        if (cards == 0) return;
        nuint p = block + HeaderBytes;
        while (p < block + size - tail && StopBlockReports < 20)
        {
            nuint w = Sys.ReadAddress(p);
            nuint chunk = MarkerReads(block, size, p, tail) && (w & 7) == 0 ? HeapChunks.Of(w) : 0;
            if (chunk != 0 && w - HeaderBytes >= HeapChunks.First(chunk)
                && Sys.Read8(cards + (p >> Runtime.CardShift)) == 0)
            {
                nuint target = w - HeaderBytes;
                nuint word = Sys.ReadAddress(target);
                nuint size2 = word & SizeMask;
                if (size2 >= LeastBlock && !Beyond(target, size2, HeapChunks.End(chunk)) && Whole(chunk, target, word)
                    && (word & (FlagMark | FlagFree)) == 0)
                {
                    SayNumber("gc verify stop block: block ", block);
                    SayNumber("gc verify stop block:   its vtable ", Sys.ReadAddress(block + HeaderBytes));
                    SayNumber("gc verify stop block:   offset ", p - block);
                    SayNumber("gc verify stop block:   points at unmarked ", target);
                    SayNumber("gc verify stop block:   whose kind ", Sys.ReadAddress(target + KindAt));
                    SayNumber("gc verify stop block:   whose chunk starts this cycle ", HeapChunks.StartsCycle(chunk) == _cycle ? 1 : 0);
                    SayNumber("gc verify stop block:   is a start ", HeapChunks.IsStart(chunk, target) ? 1 : 0);
                    SayNumber("gc verify stop block:   minor ", _minor ? 1 : 0);
                    _verifyReports = _verifyReports + 1;
                    StopBlockReports = StopBlockReports + 1;
                }
            }
            p = p + WordSize.Bytes;
        }
    }

    /// Several threads: the collection runs beside them. Entered and left
    /// with the heap lock held.
    static void CollectConcurrently()
    {
        nuint ctl = GcLock.Words();
        nuint self = Sys.ThreadBlock();

        Sys.AtomicSwap32(ctl + GcLock.Cycling, 1);
        Sys.AtomicSwap(ctl + GcLock.Collector, self);
        Sys.AtomicSwap32(ctl + GcLock.Abort, 0);
        Sys.AtomicSwap32(ctl + GcLock.Overflow, 0);
        Sys.AtomicSwap32(ctl + GcLock.Collecting, 1);
        _collecting = true;
        _sinceAtStop = _since;
        SyncEnd();
        _cycle = _cycle + 1;
        FitBarrier();
        ResetBarrier();

        // 1. The barrier logs, then the snapshot of where objects start. The
        //    collector's own buffer is stepped over like everybody's and its
        //    objects written in here: the round below counts the collector as
        //    having answered, and a buffer retired unstamped holds objects
        //    that are kept and never traced -- what only they refer to was
        //    swept from under them.
        Runtime.Marking = 1;

        // THE BARRIER ON IN EVERY THREAD BEFORE THE SNAPSHOT IS TAKEN. A thread
        // that read Marking as 0 just before it changed, and stopped before
        // its store, overwrote the field after another thread's STAMP had
        // copied that thread's stack -- which then read the old value and
        // hid it in a newcomer, never traced -- and reported nothing: the
        // value was swept while the newcomer held it. Every thread passes a
        // safepoint here, and none falls between a barrier's test and its
        // store, so every store from here on is reported. Before stamping is
        // open, with the heap lock let go: a thread allocating meanwhile owes
        // no STAMP yet (AnswerBeforeTaking), and waits for no other -- one
        // that neither allocates nor blocks holds this round up, but parks
        // nobody else -- and what it makes is in the snapshot taken below.
        GcLock.Exit();
        GcThreads.Round(GcThreads.Ack);
        GcLock.Enter();

        _stamping = true;
        if (!GcThreads.StartStackCopies())
        {
            Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 1);
        }
        RetireClasses(self);
        GcThreads.CaptureBuffers();

        // THE STOP, IN STEPS (above): the walk, the cards, the collector's
        // own pages, each a StopBudget at a time with the lock let go
        // between, and nothing but single blocks handed out meanwhile.
        _stopOpen = true;
        _stopListLost = false;
        ResetStopBlocks();
        nuint stepClock = PauseClock;
        _stepFrom = stepClock != 0 ? Sys.Low32(Sys.Call(stepClock, 0, 0, 0)) : 0;
        BeginAnchors(true);
        while (!WalkAnchors(StopBudget)) StopStep();
        EndAnchors();
        if (_generational)
        {
            BeginCards();
            while (!TakeCardsSome(_minor, StopBudget)) StopStep();
            TakeStaticCards(_minor);
        }

        if (!_snapshots)
        {
            _stopOpen = false;
            ResetStopBlocks();
            StopStepTimed();
            GcLock.Exit();
            GiveUp(false);
            return;
        }

        // THE COLLECTOR'S OWN STACK AND ARENA ARE NOT COPIED: no code of the
        // program runs on this thread from here until GcRoots reads both
        // (ScanAll, step 3) -- only the rounds, the barrier and the marking --
        // so no region of it ends and nothing moves off its stack in between,
        // and what they hold then is what they held at the snapshot.
        BeginSelfStamp();
        long pages = StopBudget / 2048 > 0 ? StopBudget / 2048 : 1;
        while (!StampPagesSome(self, pages)) StopStep();
        StampOwnBuffer(self);
        _stopOpen = false;
        StopStepTimed();
        // A block of a new chunk not written down -- no room for the list --
        // is a newcomer no root leads to; and a chunk walked on demand after
        // the walk's end (an old chunk a minor cycle made young since) whose
        // chain broke has half a start table: no sound cycle, either way.
        if (_stopListLost || !_walkEvery)
        {
            _snapshots = false;
            _markSlots = 0;
            ResetStopBlocks();
            GcLock.Exit();
            GiveUp(false);
            return;
        }

        _concurrent = true;
        ConcurrentCycles = ConcurrentCycles + 1;

        // 2. Every thread's own buffer. THE ROUND IS ASKED WITHOUT THE LOCK
        //    LET GO since stamping opened: an allocator waits for it there
        //    (AnswerBeforeTaking), and on a kernel one that may not give the
        //    processor away could wait there for ever, were the collector
        //    preempted in between. Asked, the round is one it answers itself.
        GcThreads.Round(GcThreads.Stamp, true);

        if (Sys.Read32(ctl + GcLock.BarrierLost) != 0)
        {
            GiveUp(false);
            return;
        }

        // A STORE IN FLIGHT AT THE SNAPSHOT -- its barrier found Marking
        // still 0, so its value was never reported -- has landed by now, and
        // its card with it: every thread has passed a safepoint since, and
        // none falls between a barrier's test and the card mark after the
        // store. Its card may have been set after TakeCards looked. So a
        // minor cycle reads every card set now as well, and leaves it set:
        // what was stored after the snapshot is the next cycle's to read too.
        if (_minor)
        {
            PeekCards();
        }

        // 3. The barrier marks. Buffers retired from here on are not stamped:
        //    a thread may have answered SCAN before it allocated what is in
        //    them, and stamping would make them findable and then unmarked.
        GcLock.Enter();
        _stamping = false;
        GcLock.Exit();
        MarkExempt();
        Runtime.Marking = 2;
        // Before the ranges are read: a range registered from here on is
        // marked by its registrar (MarkRegistered), one before is read below.
        Sys.Fence();
        TakeBarrier(false);
        // The stacks as they were at STAMP (GcThreads.CopyStack).
        GcThreads.ScanStackCopies();
        // And every block handed out mid-stop, black (ScanStopBlocks).
        // The checks' count from here: the stop blocks' own (VerifyStopBlock)
        // made while they are read are this cycle's as much as the mark's.
        long verifiedBefore = _verifyReports;
        ScanStopBlocks();
        _rootsOnly = true;
        GcRoots.Enter();
        _rootsOnly = false;

        // 4. Every thread's stack. When it has been answered, every thread
        //    has passed a safepoint since it saw the barrier mark, so every
        //    report it logged is signed and in the ring.
        GcThreads.Round(GcThreads.Scan);

        if (TakeBarrier(true))
        {
            GiveUp(true);
            return;
        }

        // 5. Mark to the end, and prove it is the end -- twice when what is
        //    held of a module's types is being counted (CountHeld): the
        //    count at the first end, then what the module holds itself
        //    marked, to the end again.
        while (true)
        {
            while (true)
            {
                MarkToEmpty();
                nuint before = Marked(ctl);
                GcThreads.Round(GcThreads.Ack);
                MarkToEmpty();

                if (Marked(ctl) == before)
                {
                    break;
                }
            }
            if (!CountHeldAndKeep())
            {
                break;
            }
        }

        // 6. The barrier off; everybody seen out of it; the sweep.
        Runtime.Marking = 0;
        GcThreads.Round(GcThreads.Ack);
        MarkToEmpty();
        if (_minor && (_verifyGenerations || VerifyMarks || VerifyHeap)) VerifyMinor();
        bool majorChecked = !_minor && MajorChecked();
        if (!_minor && (_verifyGenerations || VerifyMarks || VerifyHeap || majorChecked)) VerifyMajor();
        // A checked major's newcomers and roots too: a block only a newcomer
        // or a static holds, left unmarked, is a whole subtree VerifyMajor
        // never reads -- it starts from marked blocks.
        if (_verifyGenerations || VerifyMarks || VerifyHeap || majorChecked) VerifyNewcomers();
        if (majorChecked) VerifyStaticRoots();

        GcLock.Enter();
        if (_verifyGenerations || VerifyMarks || VerifyHeap) VerifyRegionEscapes();
        VerifyStop(verifiedBefore);
        HeapChunks.SetBlockAnchorsActive(false);
        GcThreads.CaptureBuffers();
        GcThreads.UnmarkBuffers();
        if (_verify || VerifyingFieldFrees) CheckQuarantine();
        BeginSweep();
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap32(ctl + GcLock.Collecting, 0);
        GcLock.Exit();

        SweepWhileTheyRun();

        GcLock.Enter();
        FinishCycle();
        Sys.AtomicSwap32(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Stamping is open: a buffer retired now has its objects' starts
    /// written down first (Retire). From the snapshot until SCAN is asked.
    static bool _stamping;

    /// Scans until nothing is queued, nothing is being scanned, and no push
    /// was lost to a full queue.
    static void MarkToEmpty()
    {
        nuint ctl = GcLock.Words();

        while (true)
        {
            Drain();

            if (TakeOverflow())
            {
                RescanPasses = RescanPasses + 1;
                RescanMarked();
                continue;
            }

            if (GreyIdle())
            {
                return;
            }

            // Somebody else has a block in hand, or a push is half made: it
            // is a few instructions from done. A spin, not Platform.Wait: that
            // sleeps WHILE a word holds a value, and there is no value here
            // to sleep on -- waiting on Active being 0 slept for ever the
            // moment it was.
            Sys.Pause();
        }
    }

    // ---- the collector's workers ---------------------------------------------
    //
    // A PROGRAM WITH ONE THREAD STILL HAS A MACHINE OF MANY. Its collection
    // runs with the world stopped (CollectAlone), and marking a compiler's
    // heap on one processor was half of what the compiler did. So threads of
    // the collector's own, started at its first collection, mark beside it:
    // the queue was built for many markers (PushGrey, PopGrey, DrainSome) and
    // the finish already waits for every one of them to be idle (GreyIdle).
    //
    // A worker is not a thread of the program. It has no thread block -- its
    // GS is its parent's, and nothing it runs reads one -- no Thread, no
    // signals, and it is not registered, so the program stays one thread to
    // every other part of the collector. It sleeps on _workWord, and marks
    // while the word is odd.
    static nuint _workWord;
    static bool _workersTried;
    public static long Workers;

    // WHAT A PLATFORM OFFERS FOR THEM, if it does (Linux does, at its first
    // thread block): how many to start, starting one, and a worker's first
    // call. 0 anywhere else -- a kernel's platform starts none.
    public static nuint WorkerCountHook;
    public static nuint WorkerStartHook;
    public static nuint WorkerQuietHook;

    /// Where a worker lives, from its first instruction.
    public static void CollectorWorker(nuint unused)
    {
        if (WorkerQuietHook != 0) Sys.Call(WorkerQuietHook, 0, 0, 0);
        nuint at = Sys.AddressOf(ref _workWord);
        nuint ctl = GcLock.Words();
        long idle = 0;
        while (true)
        {
            nuint word = Sys.ReadAddress(at);
            if ((word & 1) == 0)
            {
                idle = 0;
                Platform.Wait(at, (int)Sys.Low32(word));
                continue;
            }
            // Sweeping pages: take them until there are none, then sleep
            // until the word changes.
            if (Sys.Read32(Sys.AddressOf(ref _job)) == 1)
            {
                SweepPagesSome();
                Platform.Wait(at, (int)Sys.Low32(word));
                continue;
            }
            // Snapshotting pages, the same way.
            if (Sys.Read32(Sys.AddressOf(ref _job)) == 2)
            {
                SnapshotPagesSome();
                Platform.Wait(at, (int)Sys.Low32(word));
                continue;
            }
            // Reading cards, then marking with the rest: the cards' finds
            // are on the queue the marking below takes from.
            if (Sys.Read32(Sys.AddressOf(ref _job)) == 3)
            {
                ScanCardsSome();
            }
            // AN IDLE WORKER LOOKS AND DOES NOT TOUCH. Its check of the queue
            // is two plain reads; a take that found nothing was two locked
            // additions on the line every push and take of the marking thread
            // goes through, and that slowed the marking it was there to help.
            nuint tail = Sys.ReadAddress(ctl + GcLock.GreyTail);
            if ((Sys.ReadAddress(ctl + GcLock.GreyHead)) != tail)
            {
                if (DrainSome(-1) != 0)
                {
                    idle = 0;
                    continue;
                }
            }
            idle = idle + 1;
            if (idle < WorkerSpins)
            {
                Sys.Pause();
                continue;
            }
            // PARKED until a push leaves work enough to share (PushGrey), or
            // the marking ends (WorkersMark). The tail is the word slept on:
            // a push between the look above and the sleep has moved it, and
            // the sleep does not begin.
            Sys.AtomicAdd32(Sys.AddressOf(ref _sleepers), 1);
            if ((Sys.ReadAddress(at) & 1) != 0) Platform.Wait(ctl + GcLock.GreyTail, (int)Sys.Low32(tail));
            Sys.AtomicAdd32(Sys.AddressOf(ref _sleepers), -1);
            idle = 0;
        }
    }

    /// The heap below which a collection runs on its own thread alone.
    const int WorkersWorthBytes = 32 * 1048576;

    /// Looks at an empty queue before a worker parks.
    const int WorkerSpins = 256;
    /// Workers parked on the queue's tail.
    static int _sleepers;       // a count
    /// The depth at which a push wakes them: less is the pusher's own to scan.
    const int WorkerWakeDepth = 64;

    /// Wakes the parked workers when the queue holds work to share.
    static void WakeWorkers(nuint depth)
    {
        if (depth >= WorkerWakeDepth && Sys.Read32(Sys.AddressOf(ref _sleepers)) != 0)
        {
            Platform.Wake(GcLock.Words() + GcLock.GreyTail, 0x7FFFFFFF);
        }
    }

    /// The workers, started once, at the first collection that has a queue
    /// to share. Nothing here allocates: the heap lock is held.
    static void StartWorkers()
    {
        if (_workersTried || _markAt == 0) return;
        _workersTried = true;
        if (WorkerCountHook == 0 || WorkerStartHook == 0) return;
        long wanted = WorkersSet ? WorkersAsked : (long)Sys.Call(WorkerCountHook, 0, 0, 0);
        for (long i = 0; i < wanted; i++)
        {
            if (Sys.Call(WorkerStartHook, Sys.AddressOf(Gc.CollectorWorker), 0, 0) == 0) break;
            Workers = Workers + 1;
        }
    }

    /// The workers marking, and not.
    static void WorkersMark(bool on)
    {
        if (Workers == 0) return;
        nuint at = Sys.AddressOf(ref _workWord);
        nuint word = Sys.ReadAddress(at);
        if (((word & 1) != 0) == on) return;
        Sys.AtomicAdd(at, 1);
        if (on) Platform.Wake(at, 0x7FFFFFFF);
        // Parked on the tail, they go back to sleeping on the word.
        else if (Sys.Read32(Sys.AddressOf(ref _sleepers)) != 0) Platform.Wake(GcLock.Words() + GcLock.GreyTail, 0x7FFFFFFF);
    }

    /// A concurrent collection that cannot finish soundly -- a barrier
    /// report was lost to a full ring -- is given up: every thread is seen out
    /// of its barrier, what was marked is unmarked, and nothing is freed. The
    /// next allocation that wants a collection starts a new one. Entered
    /// without the heap lock; left holding it.
    static void GiveUp(bool marked)
    {
        nuint ctl = GcLock.Words();

        Runtime.Marking = 0;
        Sys.AtomicSwap32(ctl + GcLock.Abort, 1);
        GcThreads.Round(GcThreads.Ack);
        GcThreads.ReleaseStackCopies();

        while (Sys.Read32(ctl + GcLock.Active) != 0)
        {
            Sys.Pause();
        }

        Sys.AtomicSwap(ctl + GcLock.GreyHead, Sys.ReadAddress(ctl + GcLock.GreyTail));
        Sys.AtomicSwap32(ctl + GcLock.Overflow, 0);

        if (marked)
        {
            ClearMarks();
        }

        GcLock.Enter();
        _stamping = false;
        HeapChunks.SetBlockAnchorsActive(false);
        _snapshots = false;
        _markSlots = 0;
        _pagesUnwalked = false;
        _concurrent = false;
        _collecting = false;
        // The marks just cleared may have been an old block's: only a major
        // cycle, which clears and makes them all again, may follow.
        _forceMajor = true;
        _minor = false;
        Aborted = Aborted + 1;
        Sys.AtomicSwap32(ctl + GcLock.Abort, 0);
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap32(ctl + GcLock.Collecting, 0);
        Sys.AtomicSwap32(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Every mark and scanned flag of the snapshot taken off again, for a
    /// collection given up. Every thread is out of its barrier and nobody is
    /// marking; the snapshot's objects are never written by a running thread.
    static void ClearMarks()
    {
        nuint which = 0;
        nuint chunk = HeapChunks.SnapshotChunk(0);

        while (chunk != 0)
        {
            if (HeapChunks.StartsCycle(chunk) == _cycle)
            {
                nuint block = HeapChunks.NextStart(chunk, HeapChunks.First(chunk));

                while (block != 0)
                {
                    nuint word = Sys.ReadAddress(block);

                    if ((word & (FlagMark | FlagScan)) != 0)
                    {
                        StampIn(chunk, block, word & SizeMask, word & FlagMask & ~(nuint)(FlagMark | FlagScan));
                    }

                    block = HeapChunks.NextStart(chunk, block + 8);
                }
            }

            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// The end of a collection, with the heap lock held.
    static void FinishCycle()
    {
        _liveBlocks = _sweepLive;
        _liveBytes = _sweepLiveBytes;
        if (_census && !_minor && _censusAt != 0)
        {
            SayCensus();
        }
        _sweeping = false;
        RestartRecycling();
        _snapshots = false;
        _markSlots = 0;
        _pagesUnwalked = false;
        _concurrent = false;
        ShedPages();

        // What was allocated while the mark ran was not looked at by it and
        // still counts towards the next.
        _allocatedTotal = _allocatedTotal + _sinceAtStop;
        _since = _since > _sinceAtStop ? _since - _sinceAtStop : 0;
        if (_minor)
        {
            MinorCollections = MinorCollections + 1;
        }
        else
        {
            MajorCollections = MajorCollections + 1;
            _majorLive = _liveBytes > MinThreshold ? _liveBytes : MinThreshold;
        }
        if (_liveBytes > _peakLive) _peakLive = _liveBytes;
        if (HeapChunks.HeapBytes > _peakHeap) _peakHeap = HeapChunks.HeapBytes;
        _threshold = _generational ? Nursery(_liveBytes) : NextThreshold(_liveBytes);
        _minor = false;
        Collections = Collections + 1;
        _collecting = false;
    }

    /// HOW MUCH GARBAGE THE NEXT CYCLE MAY LET PILE UP: at least the live
    /// size, which is what this collector has always allowed and all a small
    /// machine can spare, and up to three times it where the room is there.
    ///
    /// Every collection marks the whole live heap, so the marking paid per
    /// byte allocated is live / threshold: at once the live size the
    /// self-hosted compiler ran sixty collections compiling hello.cs, most of
    /// its time. The room is half of what the operating system says is free
    /// -- the other half left to everything else on the machine -- or, under
    /// a cap (a kernel's heap, SetLimit), half of what the cap has left -- and
    /// never more than half of what the address space has left (HeapCeiling). A
    /// platform that cannot say keeps the old pace. A 32 MB board, where a
    /// program's live size is most of what is free, gets exactly the old
    /// threshold; a server with gigabytes free gets three times it.
    ///
    /// Called with the heap lock held: nothing here allocates.
    static long NextThreshold(long live)
    {
        long floor = live > MinThreshold ? live : MinThreshold;
        long room;
        long bound = -1;            // half of what a hard limit leaves; -1 for none
        if (HeapChunks.SoftCap != 0)
        {
            // THE SOFT CAP, the reserve left out (HeapChunks.Reserve): what
            // ordinary growth may reach, and so what the pace is set by.
            long left = HeapChunks.SoftCap - live;
            room = left > 0 ? left / 2 : 0;
            bound = room;
        }
        else
        {
            room = Platform.FreeMemoryQuietly() / 2;
        }
        if (HeapCeiling != 0)
        {
            long left = HeapCeiling - live;
            long spare = left > 0 ? left / 2 : 0;
            if (spare < room) room = spare;
            if (bound < 0 || spare < bound) bound = spare;
        }
        long most = floor * MaxGrowth;
        long wanted = room < most ? room : most;
        long next = wanted > floor ? wanted : floor;
        // UNDER A HARD LIMIT -- a cap, the 32-bit ceiling -- THE FLOOR GIVES
        // WAY. Allowing the live size again as garbage is the old pace, but
        // with a gigabyte and a half live under a ceiling of two and a half it
        // let the heap outgrow the address space: near a limit, collections
        // come sooner instead. Free memory alone is no limit: a 32 MB board
        // keeps its old pace.
        if (bound >= 0 && next > bound)
        {
            next = bound > MinThreshold ? bound : MinThreshold;
        }
        return next;
    }

    /// With the world running and the heap lock NOT held between chunks.
    static void SweepWhileTheyRun()
    {
        long swept = 0;
        while (true)
        {
            GcLock.Enter();
            bool more = SweepNext();
            GcLock.Exit();
            if (!more) return;
            swept = swept + 1;
            if (YieldHook != 0 && swept % SweepBetweenYields == 0) Sys.Call(YieldHook, 0, 0, 0);
        }
    }

    /// Every block that is marked and not yet scanned, scanned: the blocks a
    /// full queue could not take. By the snapshot's start bits when there are
    /// any, which is safe with every thread running; otherwise, with one
    /// thread, by walking.
    static void RescanMarked()
    {
        nuint chunk = _snapshots ? HeapChunks.SnapshotChunk(0) : HeapChunks.Newest();
        nuint which = 0;

        while (chunk != 0)
        {
            nuint block = HeapChunks.First(chunk);
            nuint end = HeapChunks.End(chunk);
            nuint tail = TailIn(chunk);

            // A page this cycle did not walk has no start bits of this
            // cycle: its blocks by their chain, below, as a chunk's are
            // without a snapshot.
            if (_snapshots && !(_pagesUnwalked && HeapChunks.PageClass(chunk) != 0))
            {
                block = HeapChunks.StartsCycle(chunk) == _cycle ? HeapChunks.NextStart(chunk, block) : 0;

                while (block != 0)
                {
                    nuint flags = Sys.ReadAddress(block);

                    if ((flags & FlagMark) != 0 && (flags & FlagScan) == 0 && SetFlag(block, FlagScan, tail))
                    {
                        ScanBlock(block, Sys.ReadAddress(block) & SizeMask, tail);
                        Drain();
                    }

                    block = HeapChunks.NextStart(chunk, block + 8);
                }

                which = which + 1;
                chunk = HeapChunks.SnapshotChunk(which);
                continue;
            }

            while (block < end)
            {
                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;

                if (size < LeastBlock || Beyond(block, size, end))
                {
                    // Broken metadata cannot be walked safely; stop at
                    // this chunk rather than read what is not there.
                    block = end;
                }
                else
                {
                    if ((word & FlagMark) != 0 && (word & FlagScan) == 0 && SetFlag(block, FlagScan, tail))
                    {
                        ScanBlock(block, size, tail);
                        Drain();
                    }
                    block = block + size;
                }
            }
            if (_snapshots)
            {
                which = which + 1;
                chunk = HeapChunks.SnapshotChunk(which);
                continue;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    // ---- what the other threads do for a collection ------------------------------

    /// Where the objects in a thread's own buffer start, written into the
    /// snapshot (the STAMP round, or its buffer being retired while stamping
    /// is open). By the thread itself, or by the collector while it is
    /// blocked: nobody else is bumping in the buffer meanwhile.
    public static void StampBuffer(nuint block)
    {
        StampPages(block);
        StampOwnBuffer(block);
    }

    /// The objects in a thread's buffer written into the snapshot: StampBuffer
    /// without the pages.
    public static void StampOwnBuffer(nuint block)
    {
        nuint at = Sys.ReadAddress(block + Tls.AllocBase);
        nuint upto = Sys.ReadAddress(block + Tls.AllocPtr);

        if (at == 0 || upto <= at)
        {
            return;
        }

        nuint chunk = HeapChunks.OfSnapshot(at);
        // Retired mid-stop, in a chunk the walk has not reached: walked first.
        EnsureWalked(chunk);

        // A buffer in a chunk made since the snapshot holds only newcomers.
        if (chunk == 0 || HeapChunks.StartsCycle(chunk) != _cycle)
        {
            return;
        }

        while (at < upto)
        {
            nuint word = Sys.ReadAddress(at);
            nuint size = word & SizeMask;

            if (size < Smallest || Beyond(at, size, upto))
            {
                return;
            }

            if ((word & FlagFree) == 0)
            {
                HeapChunks.SetStartShared(chunk, at);
                // A MAJOR CYCLE CLEARS THE MARKS HERE TOO: survivors in a live
                // buffer keep theirs (UnmarkBuffer), and this is where a major
                // cycle first walks them, as BuildBlockAnchors walks the rest.
                if (_generational && !_minor && (word & (FlagMark | FlagScan)) != 0)
                {
                    Stamp(at, size, word & FlagMask & ~(nuint)(FlagMark | FlagScan));
                }
            }

            at = at + size;
        }
    }

    /// The marks this collection left on the objects in a thread's buffer,
    /// taken off. The sweep steps over a buffer in use -- it is not a chain of
    /// blocks past its bump pointer -- and so never reaches the objects in it
    /// to clear them, as it does every other block's; left marked and
    /// scanned, the next collection would find them done already, never scan
    /// them, and sweep what only they refer to. Below the bump pointer the
    /// objects are whole and nobody but a collector writes their headers; the
    /// heap lock is held, so the buffer is not retired meanwhile.
    public static void UnmarkBuffer(nuint block)
    {
        UnmarkPages(block);
        nuint at = Sys.ReadAddress(block + Tls.AllocBase);
        nuint upto = Sys.ReadAddress(block + Tls.AllocPtr);

        // WITH GENERATIONS A SURVIVOR IS OLD, in a buffer or not: its marks
        // are what say so. Made young again here, one that only an old object
        // pointed at -- whose card this cycle read and cleared -- would be
        // found by nothing the next minor cycle, and swept once its buffer
        // was retired. A major cycle clears them as it stamps (StampBuffer).
        if (at == 0 || _generational)
        {
            return;
        }

        while (at < upto)
        {
            nuint word = Sys.ReadAddress(at);
            nuint size = word & SizeMask;

            if (size < Smallest || Beyond(at, size, upto))
            {
                return;
            }

            if ((word & (FlagMark | FlagScan)) != 0)
            {
                Stamp(at, size, word & FlagMask & ~(nuint)(FlagMark | FlagScan));
            }

            at = at + size;
        }
    }

    /// A thread's stack, from `from` up to its base, marked from.
    public static void ScanStack(nuint block, nuint from)
    {
        nuint to = Sys.ReadAddress(block + Tls.StackBase);
        // The thread's region arena with its stack: what it made there holds
        // heap objects, and nothing else marks them for it.
        ScanRegion(block);

        if (from != 0 && to > from)
        {
            if (block == Sys.ThreadBlock() && PreciseRegisters())
            {
                ScanOwnStack(from, to, 0);
            }
            else
            {
                ScanRootsAttributed(from, to, 4, true);
            }
        }
    }

    /// A few queued blocks scanned by a thread that is allocating while a
    /// mark is under way: the collection's cost shared by the threads that
    /// cause it, and done sooner on a machine with processors to spare.
    public static long Assist(long budget)
    {
        if (Runtime.Marking != 2 || _markAt == 0)
        {
            return 0;
        }

        return DrainSome(budget);
    }

    // ---- the barrier's ring ----------------------------------------------
    //
    // Many writers, one reader, nothing held. A writer claims a place with
    // one atomic add, stores its value there, and then SIGNS the place with
    // the number it claimed; the reader takes places in order and takes one
    // only if it carries the number the reader has reached. The numbers
    // never start again, so a signature is good for one visit of one place.
    //
    // WHY A SIGNATURE AND NOT JUST "NOT ZERO". A writer is never stopped
    // for a collection between claiming and storing (Tls.InAlloc) -- but on
    // a kernel it can be BLOCKED there: an interrupt arrives on top of it,
    // the handler waits for a lock, and a thread waiting for a lock counts
    // as stopped. The stop goes ahead with a place claimed and empty, and
    // the store comes late, perhaps cycles later, into a place that by then
    // belongs to somebody else's claim. Unsigned, the reader would take the
    // stale value for the new claim and miss the real one. Signed with an
    // old number, it is nobody's, and is written over.
    //
    // A place found claimed and unsigned at a stop means a report is
    // missing; so does a full ring. Either is remembered (BarrierLost) and
    // the mark is finished the long way, with the world stopped -- which
    // reads the late writer's stack, where the missing value is.

    static void MapBarrier(nuint bytes)
    {
        nuint ring = Platform.Map(bytes + 2 * WordSize.Bytes);
        if (ring == 0) return;
        Sys.WriteAddress(ring, bytes / (2 * WordSize.Bytes));
        Sys.Fence();
        _barrier = ring;
    }

    /// The ring a full one asked for, taken before a mark begins. The old
    /// ring stays mapped: a barrier stopped between claiming a place and
    /// writing it writes it late, perhaps cycles later, into the ring it
    /// read, and that must still be memory. Growing four times at a time up
    /// to BarrierMost, what is left behind is under a third of the last.
    static void FitBarrier()
    {
        nuint wanted = _barrierWanted;
        _barrierWanted = 0;
        if (wanted > BarrierMost) wanted = BarrierMost;
        if (_barrier == 0 || wanted <= Sys.ReadAddress(_barrier) * (2 * WordSize.Bytes)) return;
        MapBarrier(wanted);
    }

    static void ResetBarrier()
    {
        nuint ctl = GcLock.Words();

        // Whatever was claimed since the last mark ended was claimed by a
        // barrier already past its test of Marking: it reports on a graph
        // this snapshot does not need to be told about.
        Sys.AtomicSwap(ctl + GcLock.BarrierHead, Sys.ReadAddress(ctl + GcLock.BarrierTail));
        Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 0);
    }

    static nuint Signature(nuint place)
    {
        return (place & 0x7FFFFFFF) | 0x80000000;
    }

    /// What the compiled barrier calls, through Runtime.WriteBarrier, when a
    /// reference is about to be stored at `slot` while a mark is under way:
    /// the reference about to be overwritten, which the snapshot may reach
    /// only through here, and the one going in, which costs a word and
    /// covers a store somebody made without a barrier.
    ///
    /// TWO WAYS. While the threads are still writing down where their own
    /// buffers' objects start (Marking 1) a pointer cannot yet be resolved,
    /// so the two words are logged in the ring. Afterwards (Marking 2) they
    /// are marked on the spot: that is what lets a collection end without
    /// stopping anybody, because a mark already made is not made again, and
    /// once everything reachable is marked the barrier finds nothing new.
    public static void Barrier(nuint slot, nuint value)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Note(Sys.ReadAddress(slot), value);
        Sys.WriteAddress(tb + Tls.InAlloc, was);
    }

    /// THE STORE SEQUENCES' BARRIER: the report, the store and its card,
    /// all inside the thread's InAlloc, for a thread its collector stops at
    /// any instruction (Lowering.StoreSequences). Barrier alone restored
    /// InAlloc in its own epilogue and returned to the stub to store: a
    /// thread sent to its handshake in between could answer the next
    /// cycle's snapshot with its report given to the last one, and then
    /// overwrite a reference the new mark was never told of -- one another
    /// thread had copied into an object that mark had already scanned. Sent
    /// after this has returned, it has nothing left to do but return.
    public static void BarrierStore(nuint slot, nuint value)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Note(Sys.ReadAddress(slot), value);
        Sys.WriteAddress(slot, value);
        Card(slot);
        Sys.WriteAddress(tb + Tls.InAlloc, was);
    }

    /// BarrierStore for an exchange: the reference the slot held.
    public static nuint BarrierExchange(nuint slot, nuint value)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        nuint old = Sys.AtomicSwap(slot, value);
        Note(old, value);
        Card(slot);
        Sys.WriteAddress(tb + Tls.InAlloc, was);
        return old;
    }

    /// BarrierStore for a compare-exchange: what the slot held, and `value`
    /// in it -- reported, with its card -- only where that was `expected`.
    public static nuint BarrierCompareExchange(nuint slot, nuint value, nuint expected)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        nuint seen = Sys.Cas(slot, expected, value);
        if (seen == expected)
        {
            Note(seen, value);
            Card(slot);
        }
        Sys.WriteAddress(tb + Tls.InAlloc, was);
        return seen;
    }

    // The card of `slot`, where there is a table.
    static void Card(nuint slot)
    {
        nuint cards = Runtime.Cards;
        if (cards != 0) Sys.Write8(cards + (slot >> Runtime.CardShift), 1);
    }

    /// Barrier, told the overwritten reference itself: for an object whose
    /// fields the optimiser keeps in registers (Runtime.WriteBarrierValues).
    public static void BarrierValues(nuint old, nuint value)
    {
        nuint tb = Sys.ThreadBlock();
        nuint was = Sys.ReadAddress(tb + Tls.InAlloc);
        Sys.WriteAddress(tb + Tls.InAlloc, 1);
        Note(old, value);
        Sys.WriteAddress(tb + Tls.InAlloc, was);
    }

    /// The two references a barrier reports: marked on the spot, or logged.
    static void Note(nuint old, nuint value)
    {
        if (Runtime.Marking == 2)
        {
            if (old != 0)
            {
                MarkAt(old);
            }

            if (value != 0 && value != old)
            {
                MarkAt(value);
            }
        }
        else
        {
            if (old != 0)
            {
                Report(old);
            }

            if (value != 0 && value != old)
            {
                Report(value);
            }
        }
    }

    static void Report(nuint value)
    {
        nuint ctl = GcLock.Words();

        if (_barrier == 0)
        {
            return;
        }

        nuint ring = _barrier;
        nuint count = Sys.ReadAddress(ring);
        nuint place = Sys.AtomicAdd(ctl + GcLock.BarrierTail, 1u);
        nuint head = Sys.ReadAddress(ctl + GcLock.BarrierHead);

        if (((place - head)) >= count)
        {
            Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 1);
            if (_barrierWanted == 0) _barrierWanted = count * (2 * WordSize.Bytes) * 4;
            return;
        }

        nuint at = ring + (1 + (place & (count - 1))) * (2 * WordSize.Bytes);
        Sys.WriteAddress(at + WordSize.Bytes, value);
        Sys.AtomicSwap(at, Signature(place));
    }

    /// Marks what has been reported. With the world running it stops at a
    /// place claimed and not yet written; with the world stopped (`all`)
    /// there is no such place, only ones given up. Answers whether any
    /// report was dropped.
    static bool TakeBarrier(bool all)
    {
        nuint ctl = GcLock.Words();

        if (_barrier == 0)
        {
            return false;
        }

        nuint head = Sys.ReadAddress(ctl + GcLock.BarrierHead);
        nuint tail = Sys.ReadAddress(ctl + GcLock.BarrierTail);

        while (head != tail)
        {
            nuint at = _barrier + (1 + (head & (Sys.ReadAddress(_barrier) - 1))) * (2 * WordSize.Bytes);

            if ((Sys.ReadAddress(at)) != Signature(head))
            {
                // Claimed, not signed. With the world running its writer is
                // a few instructions away: come back. At a stop there is no
                // such thing as a moment: the report is missing.
                if (!all)
                {
                    break;
                }

                Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 1);
            }
            else
            {
                nuint value = Sys.ReadAddress(at + WordSize.Bytes);
                Sys.AtomicSwap(at, 0);
                BarrierTaken = BarrierTaken + 1;
                MarkAt(value);
            }

            head = (head + 1);
        }

        Sys.AtomicSwap(ctl + GcLock.BarrierHead, head);
        return Sys.Read32(ctl + GcLock.BarrierLost) != 0;
    }

    // Built with the heap lock held. With one thread its buffer has been
    // retired and every chunk walks; with several (`stepping`), the buffers
    // other threads are bumping in are not walkable, and are stepped over
    // whole -- GcThreads.CaptureBuffers wrote them down, sorted, a moment
    // before, and none can be replaced while the lock is held. Their objects
    // are written in by their owners (the STAMP round). Marking changes flags,
    // not block boundaries. The anchors are disabled before sweep can merge
    // blocks, and rebuilt next time.
    static void BuildBlockAnchors(bool stepping)
    {
        BeginAnchors(stepping);
        WalkAnchors(-1);
        EndAnchors();
        // THE CARDS, taken at the same stop: kept to be read by a minor cycle,
        // simply cleared by a major one, which marks everything anyway.
        if (_generational)
        {
            BeginCards();
            TakeCardsSome(_minor, -1);
            TakeStaticCards(_minor);
        }
    }

    // THE WALK IN STEPS (CollectConcurrently's stop): where it is, so that it
    // goes on after the heap lock was let go between two of them. A chunk is
    // begun -- its anchors prepared, its starts cleared -- and its blocks
    // walked, as many as a step's budget, and resumed at the block it left.
    static nuint _walkChunk;         // the chunk in hand or next to begin; 0 at the end
    static nuint _walkBlock;         // the next block of a mixed chunk in hand; 0 for none
    static nuint _walkEnd, _walkPage, _walkStep, _walkAnchors;
    static bool _walkEvery, _walkTogether, _walkStepping;

    static void BeginAnchors(bool stepping)
    {
        HeapChunks.SetBlockAnchorsActive(false);
        _walkEvery = HeapChunks.SnapshotIndex();
        // THE SIZE-CLASS PAGES SNAPSHOTTED TOGETHER, with the world stopped
        // and the workers there: each page's anchors, starts and stamps are
        // its own, and its cards are bytes set to the same value whoever
        // sets them. Listed in the walk below, done after it (SnapshotTogether).
        _walkTogether = !stepping && Workers > 0 && !_census && !_heapCheck && !_verify && !_deadCensus
                     && HeapChunks.HeapBytes >= WorkersWorthBytes && SnapshotQueue();
        // A MINOR CYCLE WITH THE WORLD STOPPED WALKS NO PAGE. A page's walk
        // wrote each block's start bit, flagged the cards its old blocks lie
        // in (OldCards), and -- in a major cycle -- took their marks off. The
        // marker finds a page's blocks by its class now (PageBlock), with
        // nothing made since the snapshot to tell apart; the old blocks'
        // cards are kept as each page is swept (_oldCards); and a minor
        // cycle takes no marks off. So only a major cycle, one beside
        // running threads (whose newcomers only start bits tell), or one
        // checking or counting walks them. A page left so keeps the start
        // table of an earlier cycle, which everything that reads one tells
        // by its cycle (StartsCycle) and takes the page by its class instead.
        _pagesUnwalked = _minor && !stepping && _oldCards != 0 && !_census && !_deadCensus && !_heapCheck
                      && !_verify && !_verifyGenerations && !VerifyHeap && !VerifyMarks && !WalkPages && _referencesEnd == 0
                      && HeapChunks.Whole;
        _snapCount = 0;
        _walkStepping = stepping;
        if (stepping) HeapChunks.MarkWalks();
        _walkChunk = HeapChunks.Newest();
        _walkBlock = 0;
    }

    /// The walk, on from where it was, until `budget` blocks are done (-1:
    /// all): true when every chunk is. A chunk walked already this cycle --
    /// on demand, by whoever needed it mid-stop (EnsureWalked) -- is passed.
    static bool WalkAnchors(long budget)
    {
        long work = 0;
        while (true)
        {
            if (_walkBlock != 0)
            {
                if (!WalkMixed(budget, ref work)) return false;
                _walkChunk = HeapChunks.Next(_walkChunk);
                continue;
            }
            nuint chunk = _walkChunk;
            if (chunk == 0) return true;
            if (budget >= 0 && work >= budget) return false;
            if (_walkStepping && HeapChunks.StartsCycle(chunk) == _cycle)
            {
                _walkChunk = HeapChunks.Next(chunk);
                continue;
            }
            if (!BeginChunk(chunk, ref work)) _walkChunk = HeapChunks.Next(chunk);
        }
    }

    /// One chunk begun: passed (an old one in a minor cycle, a page left
    /// unwalked), its anchors prepared and its starts cleared, and a page
    /// snapshotted whole -- false, the chunk done -- or a mixed chunk's walk
    /// set up from its first block (_walkBlock) -- true, WalkMixed to go on.
    static bool BeginChunk(nuint chunk, ref long work)
    {
        bool stepping = _walkStepping;
        // A MINOR CYCLE LOOKS ONLY AT YOUNG CHUNKS: an old chunk keeps
        // the start table of its last cycle, which SnapshotBlock does not
        // trust for this one, so a pointer into it is not followed -- its
        // blocks are all old, and old is kept. Young as the stop began, in
        // steps (MarkWalks): one made young since is not walked.
        if (_minor && !(stepping ? HeapChunks.Walks(chunk) : HeapChunks.IsYoung(chunk))) return false;
        if (_pagesUnwalked && HeapChunks.PageClass(chunk) != 0)
        {
            PagesUnwalked = PagesUnwalked + 1;
            return false;
        }
        nuint anchors = HeapChunks.PrepareBlockAnchors(chunk);
        if (anchors == 0)
        {
            _walkEvery = false;
            return false;
        }
        nuint pages = HeapChunks.BlockAnchorCount(chunk);
        for (nuint i = 0; i < pages; i++) Sys.WriteAddress(anchors + i * WordSize.Bytes, 0);
        HeapChunks.ClearStarts(chunk, _cycle);
        work = work + (long)pages;
        // A SIZE-CLASS PAGE by arithmetic, not by chain (SnapshotPage).
        if (HeapChunks.PageClass(chunk) != 0)
        {
            nuint first = HeapChunks.First(chunk);
            nuint at = stepping ? GcThreads.BufferAtOrAbove(first) : GcThreads.BufferCount();
            bool captured = at < GcThreads.BufferCount() && GcThreads.BufferBase(at) == first;
            if (!captured && !HeapChunks.IsPooled(chunk))
            {
                if (_walkTogether && _snapCount < _snapCap)
                {
                    Sys.WriteAddress(_snapQueue + _snapCount * 2 * WordSize.Bytes, chunk);
                    Sys.WriteAddress(_snapQueue + (_snapCount * 2 + 1) * WordSize.Bytes, anchors);
                    _snapCount = _snapCount + 1;
                }
                else
                {
                    if (!SnapshotPage(chunk, anchors)) _walkEvery = false;
                    work = work + (long)((HeapChunks.End(chunk) - first) / ClassSize(HeapChunks.PageClass(chunk) - 1));
                }
            }
            return false;
        }
        _walkChunk = chunk;
        _walkBlock = HeapChunks.First(chunk);
        _walkEnd = HeapChunks.End(chunk);
        _walkPage = 0;
        _walkStep = stepping ? GcThreads.BufferAtOrAbove(_walkBlock) : GcThreads.BufferCount();
        _walkAnchors = anchors;
        return true;
    }

    /// WALKED ON DEMAND, mid-stop: a chunk whose snapshot something needs now
    /// -- a page or a buffer given up, a block handed out of it -- is walked
    /// at once by whoever needs it, if the stop's walk has not been through
    /// it, and that walk passes it after. The chunk the walk has in hand is
    /// finished. Only this one chunk: a page is 32 KB, a mixed chunk a
    /// megabyte at most, or what a platform bounds it to (MixedChunkMost).
    /// Under the heap lock, so no two walk one chunk. Not
    /// a chunk the snapshot does not hold (mapped since), nor an old one in
    /// a minor cycle (old as the stop began, HeapChunks.Walks, whatever it
    /// has become since) -- neither is walked at all.
    static void EnsureWalked(nuint chunk) => EnsureWalked(chunk, 0);

    /// The same for `block` of it: a block in the part of the chunk in hand
    /// the walk has been through needs no more of it.
    static void EnsureWalked(nuint chunk, nuint block)
    {
        if (!_stopOpen || chunk == 0) return;
        bool inHand = chunk == _walkChunk && _walkBlock != 0;
        if (inHand && block != 0 && block < _walkBlock) return;
        if (!inHand)
        {
            if (HeapChunks.StartsCycle(chunk) == _cycle) return;
            if (_minor && !HeapChunks.Walks(chunk)) return;
            if (HeapChunks.OfSnapshot(HeapChunks.First(chunk)) != chunk) return;
        }
        nuint clock = PauseClock;
        uint t = clock != 0 ? Sys.Low32(Sys.Call(clock, 0, 0, 0)) : 0;
        long work = 0;
        if (inHand)
        {
            WalkMixed(-1, ref work);
            _walkChunk = HeapChunks.Next(chunk);
        }
        else
        {
            nuint savedChunk = _walkChunk, savedBlock = _walkBlock, savedEnd = _walkEnd;
            nuint savedPage = _walkPage, savedStep = _walkStep, savedAnchors = _walkAnchors;
            _walkBlock = 0;
            if (BeginChunk(chunk, ref work)) WalkMixed(-1, ref work);
            _walkChunk = savedChunk; _walkBlock = savedBlock; _walkEnd = savedEnd;
            _walkPage = savedPage; _walkStep = savedStep; _walkAnchors = savedAnchors;
        }
        StopWalksOnDemand = StopWalksOnDemand + 1;
        if (clock != 0)
        {
            long took = (long)(Sys.Low32(Sys.Call(clock, 0, 0, 0)) - t);
            if (took > LongestWalkOnDemand) LongestWalkOnDemand = took;
        }
    }

    /// Chunks walked on demand mid-stop (EnsureWalked), and the longest of
    /// those walks in microseconds (PauseClock): what a thread that is not
    /// the collector paid for a stop.
    public static long StopWalksOnDemand, LongestWalkOnDemand;

    /// A mixed chunk's blocks from _walkBlock: false when the budget ran out
    /// first, with where it was kept; true when the chunk is done.
    static bool WalkMixed(long budget, ref long work)
    {
        nuint chunk = _walkChunk;
        nuint block = _walkBlock;
        nuint end = _walkEnd;
        nuint page = _walkPage;
        nuint step = _walkStep;
        nuint anchors = _walkAnchors;
        bool stepping = _walkStepping;
        while (block < end)
        {
            if (budget >= 0 && work >= budget)
            {
                _walkBlock = block;
                _walkPage = page;
                _walkStep = step;
                return false;
            }
            work = work + 1;
            if (stepping)
            {
                while (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < block) step = step + 1;
                if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == block)
                {
                    block = GcThreads.BufferLimit(step);
                    step = step + 1;
                    continue;
                }
            }
            nuint header = Sys.ReadAddress(block);
            nuint size = header & SizeMask;
            // A CHAIN THAT BREAKS leaves the rest of the chunk without
            // starts, and an object without a start is a newcomer: kept
            // and never traced. No snapshot, then, and the collection
            // is given up rather than run on half of one.
            if (size < Smallest || Beyond(block, size, end)
                || Sys.ReadAddress(block + size - FooterBytes) != header) { _walkEvery = false; break; }
            nuint last = (block + size - 1 - chunk) / 4096;
            while (page <= last)
            {
                Sys.WriteAddress(anchors + page * WordSize.Bytes, block);
                page = page + 1;
            }
            // WHERE EVERY OBJECT STARTS, as of this stop: what the
            // marker finds objects by from here on (SnapshotBlock).
            if ((header & FlagFree) == 0) HeapChunks.SetStart(chunk, block);
            // WHICH KILOBYTES HOLD AN OLD OBJECT, for TakeCards: a card
            // over nothing but young blocks is not read (OldCards).
            if (_minor && (header & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan)) OldCards(block, size);
            // A MAJOR CYCLE MAKES EVERY BLOCK YOUNG AGAIN, taking off
            // the marks the old kept, and finds the live ones afresh.
            if (_generational && !_minor && (header & (FlagMark | FlagScan)) != 0)
            {
                Stamp(block, size, header & FlagMask & ~(nuint)(FlagMark | FlagScan));
            }
            block = block + size;
        }
        _walkBlock = 0;
        return true;
    }

    /// The walk's end: the pages left for the workers, the anchors on, and
    /// whether the snapshot is whole.
    static void EndAnchors()
    {
        if (_snapCount > 0 && !SnapshotTogether()) _walkEvery = false;
        HeapChunks.SetBlockAnchorsActive(true);
        _snapshots = _walkEvery;
        // THE MARKER'S LOOKUP BY THE 4 KB TABLE (MarkWord), where the
        // snapshot is whole and no quarantined range's references are being
        // counted -- which wants every word that is not the heap's said.
        // In long mode only while every chunk is inside the table's window
        // (HeapChunks.Whole): a word outside it is then no heap's, and is
        // turned away before the table is read (InWindow).
        _markSlots = 0;
        if (_walkEvery && _referencesEnd == 0 && HeapChunks.Whole) _markSlots = HeapChunks.SlotTable;
    }

    /// Whether this cycle's snapshot left the pages unwalked (BuildBlockAnchors).
    static bool _pagesUnwalked;
    /// Pages a minor cycle's snapshot did not walk, over every cycle.
    public static long PagesUnwalked;

    static nuint _snapQueue;
    static nuint _snapQueueBytes;
    static nuint _snapCap;
    static nuint _snapCount;
    static int _snapNext;
    static nuint _snapDone;
    static nuint _snapBroken;

    /// Room in the snapshot queue for a page of every chunk: two words each,
    /// the page and its anchor table. False when there is none to be had.
    static bool SnapshotQueue()
    {
        const int w = WordSize.Bytes;
        nuint chunks = 0;
        for (nuint each = HeapChunks.Newest(); each != 0; each = HeapChunks.Next(each)) chunks = chunks + 1;
        nuint wanted = chunks * 2 * w;
        if (wanted > _snapQueueBytes)
        {
            // The smaller queue is left mapped, as the sweep's is.
            nuint bytes = wanted * 2;
            nuint at = Platform.Map(bytes);
            if (at == 0) return false;
            _snapQueue = at;
            _snapQueueBytes = bytes;
        }
        _snapCap = _snapQueueBytes / (2 * w);
        return true;
    }

    /// The queued pages snapshotted by every worker and this thread; false
    /// when one of them was broken (SnapshotPage), as the walk would say.
    static bool SnapshotTogether()
    {
        Sys.AtomicSwap32(Sys.AddressOf(ref _snapNext), 0);
        Sys.AtomicSwap(Sys.AddressOf(ref _snapDone), 0);
        Sys.AtomicSwap(Sys.AddressOf(ref _snapBroken), 0);
        bool helped = _snapCount >= PagesTogether;
        if (helped)
        {
            Sys.AtomicSwap32(Sys.AddressOf(ref _job), 2);
            WorkersMark(true);
        }
        SnapshotPagesSome();
        if (helped)
        {
            while (Sys.ReadAddress(Sys.AddressOf(ref _snapDone)) < _snapCount) Sys.Pause();
            WorkersMark(false);
            Sys.AtomicSwap32(Sys.AddressOf(ref _job), 0);
        }
        nuint broken = Sys.ReadAddress(Sys.AddressOf(ref _snapBroken));
        _snapCount = 0;
        return broken == 0;
    }

    /// Queued pages taken and snapshotted until there are none.
    static void SnapshotPagesSome()
    {
        const int w = WordSize.Bytes;
        while (true)
        {
            nuint i = (nuint)Sys.AtomicAdd32(Sys.AddressOf(ref _snapNext), 1);
            if (i >= _snapCount) return;
            nuint chunk = Sys.ReadAddress(_snapQueue + i * 2 * w);
            nuint anchors = Sys.ReadAddress(_snapQueue + (i * 2 + 1) * w);
            if (!SnapshotPage(chunk, anchors)) Sys.AtomicSwap(Sys.AddressOf(ref _snapBroken), 1);
            Sys.AtomicAdd(Sys.AddressOf(ref _snapDone), 1);
        }
    }

    /// A size-class page's part of the snapshot (BuildBlockAnchors), without
    /// walking it as a chain: every block is the class's size, so the anchor
    /// of each 4 KB is arithmetic, and the start bits of a word's worth of
    /// blocks are gathered and written once. What the chain walk does to each
    /// block -- its start, its old cards, a major cycle's unmarking -- is done
    /// here for each allocated one. The heap lock is held and nobody owns the
    /// page. False when a header is not the class's size: the page is broken,
    /// and so is the snapshot.
    static bool SnapshotPage(nuint chunk, nuint anchors)
    {
        nuint size = ClassSize(HeapChunks.PageClass(chunk) - 1);
        nuint first = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        nuint count = HeapChunks.BlockAnchorCount(chunk);
        for (nuint p = 0; p < count; p++)
        {
            nuint at = chunk + p * 4096;
            nuint block = at <= first ? first : first + (at - first) / size * size;
            Sys.WriteAddress(anchors + p * WordSize.Bytes, block < end ? block : 0);
        }
        // IN WORDS, as the marker's loops are (ScanRange): this runs for
        // every block of every young page at every cycle, and in longs on a
        // 32-bit processor each sum was an add and an adc, each compare two,
        // and the start bit a 64-bit shift.
        const int w = WordSize.Bytes;
        nuint starts = anchors + count * WordSize.Bytes + WordSize.Bytes;
        int wordAt = -1;
        nuint bits = 0;
        nuint block2 = first;
        while (block2 < end)
        {
            nuint header = Sys.ReadAddress(block2);
            if ((header & ~(nuint)7) != size)
            {
                return false;
            }
            if ((header & FlagFree) == 0)
            {
                nuint bit = (block2 - chunk) >> 3;
                int word = (int)(bit >> (3 + WordSize.Shift));
                if (word != wordAt)
                {
                    if (wordAt >= 0) Sys.WriteAddress((starts + (nuint)wordAt * w), bits);
                    wordAt = word;
                    bits = Sys.ReadAddress(starts + (nuint)word * w);
                }
                bits = bits | ((nuint)1 << (int)(bit & (8 * WordSize.Bytes - 1)));
                nuint marks = header & (nuint)(FlagMark | FlagScan);
                if (_minor && marks == (nuint)(FlagMark | FlagScan)) OldCards(block2, size);
                if (_generational && !_minor && marks != 0)
                {
                    StampClass(block2, size, header & FlagMask & ~(nuint)(FlagMark | FlagScan));
                }
            }
            block2 = block2 + size;
        }
        if (wordAt >= 0) Sys.WriteAddress((starts + (nuint)wordAt * w), bits);
        return true;
    }

    /// Walks every block in every chunk: unmarked ones become free, adjacent
    /// dead ones become one free block, and the marks on the survivors are
    /// cleared. The free list is rebuilt from nothing, which is simpler than
    /// editing it and no slower, since every block is visited anyway.
    /// Whether any block in a chunk was marked by this collection.
    static bool AnyLive(nuint chunk)
    {
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);

        // A thread is bumping in it.
        nuint step = GcThreads.BufferAtOrAbove(block);
        if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < end)
        {
            return true;
        }

        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;

            if (size < LeastBlock || Beyond(block, size, end))
            {
                return false;
            }

            if ((word & FlagMark) != 0 || _concurrent && Newcomer(chunk, block, word))
            {
                return true;
            }

            block = block + size;
        }

        return false;
    }

    /// Allocated while the mark ran: not in the snapshot, so never marked,
    /// and kept because of it. Only a collection that let the world run has
    /// any.
    static bool Newcomer(nuint chunk, nuint block, nuint word)
    {
        if (!_concurrent || (word & FlagFree) != 0)
        {
            return false;
        }

        return HeapChunks.StartsCycle(chunk) != _cycle || !HeapChunks.IsStart(chunk, block);
    }

    // THE SWEEP, A CHUNK AT A TIME. With the world stopped it is simply run
    // to the end. With the world running it is safe because of where a
    // running thread can be:
    //
    //   - The free index is emptied at the stop (BeginSweep). What a thread
    //     takes afterwards comes from a block this sweep has already put
    //     back, from the bump space past where the current chunk ended AT
    //     THE STOP -- which is as far as that chunk is walked -- from a chunk
    //     made since, which is not on the list being walked, OR from the tail
    //     of a buffer somebody retired meanwhile (Refill, Deregister). That
    //     last one CAN be in a chunk not yet swept, and it is safe for one
    //     reason only: every buffer in use at BeginSweep was captured there,
    //     whole, base to limit, and every walk steps over the captured span
    //     unread whatever has happened inside it since. A retired tail is
    //     linked where it lies (Retire uses Link, never Merge), so it never
    //     reaches outside that span. Change either and this breaks: a walk
    //     would meet a chain it cannot read, or objects made after the mark
    //     with nothing to say they are new.
    //   - Nothing is freed by hand while it runs (Free), so no block is put
    //     on the free index that the walk would then put on it again.
    //   - What is allocated meanwhile is unmarked and outside the snapshot:
    //     kept, like everything else allocated since the first stop.
    //   - One chunk is swept per hold of the heap lock, so a thread that
    //     needs the heap waits for a chunk and not for the heap.
    static bool _sweeping;
    static nuint _sweepAt;           // the next chunk to sweep, or 0
    // The chunk that was its heap's current at the stop, and where its
    // blocks ended then: of the heap the sweep works for (SweepNext).
    static nuint _sweepCurrent => Sys.ReadAddress(_h + HeapSweepCurrentAt);
    static nuint _sweepCurrentEnd => Sys.ReadAddress(_h + HeapSweepEndAt);
    static long _sweepLive;
    static long _sweepLiveBytes;
    static bool _reuseEveryPage;    // this sweep lists every page with a free slot (SweepPage)

    static void BeginSweep()
    {
        // A MINOR SWEEP LEAVES THE FREE LISTS: the old chunks it does not
        // walk keep theirs, and a young chunk's free blocks are taken off
        // them one by one as it is walked (SweepNext).
        if (!_minor)
        {
            ClearBins();
        }
        _reuseEveryPage = HeapChunks.Cap != 0 && HeapChunks.HeapBytes > HeapChunks.Cap / 2
            || HeapCeiling != 0 && HeapChunks.HeapBytes > HeapCeiling / 2
            || MemoryShort();
        _sweeping = true;
        // What was handed back before this point the sweep counts (NoteUnowned).
        if (!_minor) _unownedAtMajorSweep = _unowned;
        _sweepAt = HeapChunks.Newest();
        for (nuint h = _heap0; h != 0; h = Sys.ReadAddress(h + HeapNextAt))
        {
            nuint current = Sys.ReadAddress(h + HeapCurrentAt);
            Sys.WriteAddress(h + HeapSweepCurrentAt, current);
            Sys.WriteAddress(h + HeapSweepEndAt, current != 0 ? HeapChunks.End(current) : 0);
        }
        _sweepLive = 0;
        _sweepLiveBytes = 0;
        if (_census && !_minor)
        {
            StartCensus();
        }
    }

    /// Every listed free block of a chunk off its list (not one freed in
    /// place, which never was on one). The chunk is wholly dead: its chain
    /// is walkable end to end.
    static void UnlinkFreeIn(nuint chunk)
    {
        nuint block = HeapChunks.First(chunk);
        nuint end = HeapChunks.End(chunk);
        while (block < end)
        {
            nuint word = Sys.ReadAddress(block);
            nuint size = word & SizeMask;
            if (size < Smallest || Beyond(block, size, end))
            {
                return;
            }
            if ((word & FlagFree) != 0 && !IsInPlace(block))
            {
                Unlink(block);
            }
            block = block + size;
        }
    }

    /// Puts a run of dead blocks back as one free block.
    ///
    /// A MINOR SWEEP KEPT THE FREE LISTS, so a run's free members are on them
    /// still. A run that is one listed free block and nothing else -- a hole
    /// nothing beside it died to widen -- is left exactly where it is. Taking
    /// it off and putting it back rotated the large-block trees for every
    /// hole in every young chunk, every minor cycle, and on a fragmented heap
    /// that was most of what a collection cost. A run that did merge has its
    /// listed members taken off first; they are still whole blocks, because
    /// nothing is stamped until here.
    static void CloseDeadRun(nuint start, nuint size, nuint blocks, nuint listed)
    {
        if (blocks == 1 && listed == 1)
        {
            return;
        }
        if (listed != 0)
        {
            nuint at = start;
            nuint end = start + size;
            while (at < end)
            {
                nuint word = Sys.ReadAddress(at);
                if ((word & FlagFree) != 0 && !IsInPlace(at))
                {
                    Unlink(at);
                }
                at = at + (word & SizeMask);
            }
        }
        if ((SkippedFreePaths & 64) != 0 && size > HeaderBytes + FooterBytes)
        {
            nuint p = start + HeaderBytes;
            while (p < start + size - FooterBytes)
            {
                Sys.Write32(p, Poison);
                p = p + 4;
            }
        }
        Stamp(start, size, FlagFree);
        Link(start);
    }

    /// Sweeps one chunk. The heap lock is held (or the world is stopped).
    /// Answers whether there is another. FOR THE CHUNK'S OWN HEAP: what it
    /// frees goes to that heap's bins and lists, and that heap's bump chunk
    /// is the one left alone.
    static bool SweepNext()
    {
        nuint working = _h;
        if (_heapCount > 1 && _sweepAt != 0) _h = HeapChunks.HeapOf(_sweepAt);
        bool more = SweepChunk();
        _h = working;
        return more;
    }

    static bool SweepChunk()
    {
        nuint chunk = _sweepAt;

        if (chunk == 0)
        {
            return false;
        }

        nuint live = 0;
        nuint liveBytes = 0;

        {
            // A CHUNK WITH NOTHING LIVE IN IT GOES BACK. Not the current one,
            // which the bump pointer is in the middle of; every other chunk
            // this collection found wholly dead is unmapped whole and its
            // pages are the operating system's again. That is what makes a
            // program's memory shrink after it has grown, and the kernel's.
            nuint after = HeapChunks.Next(chunk);
            _sweepAt = after;

            // A PAGE THE WORKERS SWEPT is listed whatever its age now: their
            // sweep may have found it old.
            if (HeapChunks.PageClass(chunk) != 0 && HeapChunks.IsSwept(chunk))
            {
                SweepPage(chunk);
                return _sweepAt != 0;
            }

            // AN OLD CHUNK IS LEFT ALONE by a minor sweep: nothing in it was
            // made since the last cycle, nothing in it can have died that a
            // minor cycle would know of, and what its last sweep found live
            // still counts.
            if (_minor && !HeapChunks.IsYoung(chunk))
            {
                _sweepLive = _sweepLive + (long)HeapChunks.LiveBlocks(chunk);
                _sweepLiveBytes = _sweepLiveBytes + (long)HeapChunks.LiveBytes(chunk);
                return after != 0;
            }

            if (HeapChunks.PageClass(chunk) != 0)
            {
                SweepPage(chunk);
                return _sweepAt != 0;
            }

            if (chunk != _current && chunk != _sweepCurrent && !AnyLive(chunk))
            {
                // A MINOR SWEEP KEPT THE FREE LISTS, and this chunk's free
                // blocks are on them: taken off before its memory goes back,
                // or the lists would point into memory no longer there.
                if (_minor)
                {
                    UnlinkFreeIn(chunk);
                }
                // What of it the program had not freed already is the
                // collector's: walked for the count only when it is asked for.
                if (CountingCollected) CollectedBytes = CollectedBytes + UnfreedBytes(chunk);
                if (AllocSamples.Tracking) CollectedIn(chunk);
                HeapChunks.Release(chunk);
                return after != 0;
            }

            nuint block = HeapChunks.First(chunk);
            nuint end = chunk == _sweepCurrent ? _sweepCurrentEnd : HeapChunks.End(chunk);
            nuint deadStart = 0;
            nuint deadSize = 0;
            nuint deadBlocks = 0;
            nuint deadListed = 0;
            nuint largest = 0;
            nuint step = GcThreads.BufferAtOrAbove(block);
            // What keeps the chunk young for the next cycle: a buffer a thread
            // is still bumping in, the bump pointer, or a block made while
            // this cycle marked (a newcomer, kept unmarked).
            bool stillYoung = chunk == _current || chunk == _sweepCurrent;

            while (block < end)
            {
                // A BUFFER A THREAD IS BUMPING IN (captured at BeginSweep):
                // not a chain of blocks, and all of it kept this time.
                while (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < block) step = step + 1;
                if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == block)
                {
                    if (deadSize != 0)
                    {
                        CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                        if (deadSize > largest) largest = deadSize;
                        deadSize = 0;
                    }
                    liveBytes = liveBytes + (GcThreads.BufferLimit(step) - block);
                    block = GcThreads.BufferLimit(step);
                    step = step + 1;
                    stillYoung = true;
                    continue;
                }

                nuint word = Sys.ReadAddress(block);
                nuint size = word & SizeMask;
                SweepVisits = SweepVisits + 1;

                if (size < Smallest || Beyond(block, size, end))
                {
                    block = end;
                }
                else
                {
                    if (_heapCheck && (word & FlagFree) == 0) CheckGuard(block, "a chunk's sweep");
                    if ((word & FlagMark) == 0 && !(_concurrent && Newcomer(chunk, block, word)))
                    {
                        // A free block a minor sweep meets is still on the free
                        // lists (it kept them); it joins the dead run, so it
                        // comes off first -- unless it was freed in place in a
                        // buffer and never listed (FreeInPlace), whose link
                        // word is the InPlace mark and not a neighbour.
                        if (deadSize == 0)
                        {
                            deadStart = block;
                            deadBlocks = 0;
                            deadListed = 0;
                        }
                        if (_minor && (word & FlagFree) != 0 && !IsInPlace(block))
                        {
                            deadListed = deadListed + 1;
                        }
                        deadBlocks = deadBlocks + 1;
                        deadSize = deadSize + size;
                        if ((word & FlagFree) == 0) CollectedBytes = CollectedBytes + (long)size;
                        if (AllocSamples.Tracking && (word & FlagFree) == 0) AllocSamples.Collected(block + HeaderBytes);
                        if (_heapCheck) Forget(block);
                        if (_deadCensus && (word & FlagFree) == 0)
                        {
                            if (_deadAt == 0)
                            {
                                _deadAt = Platform.Map(CensusSlots * CensusEntry);
                            }
                            CensusInto(_deadAt, block, size);
                        }
                    }
                    else
                    {
                        if (deadSize != 0)
                        {
                            CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                            if (deadSize > largest) largest = deadSize;
                            deadSize = 0;
                        }

                        // CHECKED FREES: a live object still holding a block
                        // the program freed is a free the compiler got wrong.
                        if (_verify && !_minor && (word & FlagMark) != 0)
                        {
                            CheckDangling(block, size);
                        }
                        if (_census && !_minor)
                        {
                            Census(block, size);
                        }

                        // A SURVIVOR IS OLD, and keeps the marks that say so;
                        // a newcomer is young and stays unmarked (generations).
                        // NOT WRITTEN WHERE BOTH ENDS SAY IT ALREADY (SameHeader):
                        // a block here is a kilobyte or more, and its footer
                        // another cache line, dirtied and written back for
                        // every old array a minor sweep passed.
                        nuint flags = _generational && (word & FlagMark) != 0 ? (nuint)(FlagMark | FlagScan) : 0;
                        if (word != (size | flags) || Sys.ReadAddress(block + size - FooterBytes) != (size | flags))
                        {
                            Stamp(block, size, flags);
                        }
                        if (flags == 0)
                        {
                            stillYoung = stillYoung || (word & FlagMark) == 0;
                        }
                        live = live + 1;
                        liveBytes = liveBytes + size;
                    }
                    block = block + size;
                }
            }

            if (deadSize != 0)
            {
                CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                if (deadSize > largest) largest = deadSize;
            }
            HeapChunks.SetLive(chunk, live, liveBytes);
            HeapChunks.SetLargestHole(chunk, largest);
            HeapChunks.SetYoung(chunk, stillYoung);
        }

        _sweepLive = _sweepLive + (long)live;
        _sweepLiveBytes = _sweepLiveBytes + (long)liveBytes;
        return _sweepAt != 0;
    }
}

// ---- chunks: memory from the operating system --------------------------------
//
// The heap is a list of chunks, each carrying a small record in its own
// first bytes -- so taking a chunk never itself needs an allocation, which
// matters because a chunk is taken exactly when the heap cannot allocate:
//
//   +0    next chunk, or 0
//   +W    end: one past the last block laid down (the bump pointer's floor)
//   +2W   limit: one past the chunk's memory
//   +3W   raw page-anchor table, or 0 when not allocated
//   +4W   flags: young (allocated in since the last collection)
//   +5W   the live bytes the last sweep of it found
//   +6W   the live blocks the last sweep of it found
//   +8W   the first block (8-aligned on both word sizes)
//
// The record is not a block and is never swept. This class knows nothing
// about blocks; it is the part of the heap a precise collector keeps.

public static class HeapChunks
{
    const int ChunkNext = 0;
    const int ChunkEnd = WordSize.Bytes;
    const int ChunkLimit = 2 * WordSize.Bytes;
    const int ChunkAnchors = 3 * WordSize.Bytes;
    // THE GENERATIONS' WORDS (Gc, "generations"): whether anything was
    // allocated in the chunk since the last collection -- a YOUNG chunk,
    // which the next minor collection walks and sweeps -- and what its last
    // sweep found live in it, so a chunk a minor collection leaves alone
    // still counts towards what is live. Eight words in all, so the first
    // block stays eight-aligned on both word sizes.
    const int ChunkFlags = 4 * WordSize.Bytes;
    const int ChunkLiveBytes = 5 * WordSize.Bytes;
    const int ChunkLiveBlocks = 6 * WordSize.Bytes;
    // The largest free run its last sweep left, so that recycling passes by
    // a chunk whose holes are all too small without walking it (Gc.NextHole).
    const int ChunkLargestHole = 7 * WordSize.Bytes;
    // A SIZE-CLASS PAGE'S WORDS (Gc, "size classes"): its class plus one (0
    // for a chunk of mixed blocks), its free list -- the page's own while no
    // thread owns it, the blocks other threads freed while one does -- its
    // neighbours on its class's list of pages with room, and the thread that
    // owns it, or 0. On a page the largest-hole word is its free bytes.
    const int ChunkClass = 8 * WordSize.Bytes;
    /// For the marker's lookups (Gc.MarkWord): where a chunk's end,
    /// limit and class are, and where its first block is.
    public const int EndAt = ChunkEnd, LimitAt = ChunkLimit, ClassAt = ChunkClass, FirstAt = ChunkBytes, OwnerAt = ChunkOwner;

    /// THE CHUNK OF EVERY 4 KB (Of's table), for the marker and the frees:
    /// the word of an address `at` in the window (SlotLow, SlotSpan) is at
    /// SlotTable + (at >> 12) words, the shift unsigned. 0 where there is
    /// none -- not a platform that commits lazily.
    public static nuint SlotTable
    {
        get { return _slotBias; }
    }

    /// The first address the table covers: 0 on i386, where it covers all
    /// four gigabytes; in long mode, the bottom of the window where the heap
    /// is (SlotsSet). An address `at` is in the window when at - SlotLow,
    /// unsigned, is below SlotSpan.
    public static nuint SlotLow
    {
        get { return _slotLow; }
    }

    /// Whether `at` lies in the window the table covers: every address on
    /// i386; in long mode the 64 GiB the first chunk placed.
    public static bool InSlotWindow(nuint at) => InWindow(at - _slotLow);

    /// WHETHER THE TABLE SAYS OF EVERY CHUNK: there is one, and no chunk lies
    /// even partly outside its window -- always on i386, where the window is
    /// all four gigabytes; in long mode while the heap has kept to the 64 GiB
    /// the first chunk placed it in. The marker reads the table only then
    /// (Gc.BuildBlockAnchors), and turns away the words outside the window:
    /// a pointer into a chunk the table cannot say of would be taken for
    /// nobody's, its object never marked and swept with the garbage.
    public static bool Whole
    {
        get { return _slotBias != 0 && _outsideWindow == 0; }
    }
    const int ChunkFree = 9 * WordSize.Bytes;
    const int ChunkPageNext = 10 * WordSize.Bytes;
    const int ChunkPagePrev = 11 * WordSize.Bytes;
    const int ChunkOwner = 12 * WordSize.Bytes;
    // The chunk before it in the list (newer), or 0 for the newest: with
    // thousands of pages, finding it by walking made every release a walk.
    const int ChunkPrevious = 13 * WordSize.Bytes;
    // THE HEAP IT IS OF (Gc, "heaps"): the record of the heap that took it,
    // whose bins its free blocks go to and whose lists its pages are on.
    // Sixteen words in all, so the first block stays eight-aligned.
    const int ChunkHeap = 14 * WordSize.Bytes;
    const int ChunkBytes = 16 * WordSize.Bytes;
    const int ChunkYoung = 1;
    const int ChunkListed = 2;     // a page on its class's list
    const int ChunkPooled = 4;     // an empty page kept for any class
    const int ChunkSwept = 8;      // a page the workers swept, for the collector to list (Gc.SweepPage)
    const int ChunkWalks = 16;     // young when the stop began: the cycle's walk is through it (MarkWalks)

    /// A size-class page at its largest: small enough that a thread owning
    /// one of every class holds little, large enough that the start table
    /// inside it is a few hundred bytes of it.
    public const int PageBytes = 32768;

    /// THE PAGES A BATCH IS CUT INTO, by the machine (Platform.GcThreshold, a
    /// kernel's thirty-second of memory): a quarter of the largest on a
    /// machine of 64 MB or less, a half to 128 MB, the largest above and
    /// where there is no such cap -- a compiler's heap keeps its pages as
    /// they were. A thread owns a page of every class it uses, thirty-nine
    /// classes: at 32 KiB a page, a 32 MB machine's kernel held ninety
    /// pages, 2.9 MB, for 0.7 MB of small objects. Each page says its own
    /// size (its limit), so pages of a size chosen before are as good.
    /// The size of a page of the batch, for a heap choosing smaller ones (Gc.SmallPageFor).
    public static nuint BatchBytes() => BatchPageBytes();

    static nuint BatchPageBytes()
    {
        long cap = Platform.GcThreshold();
        if (cap > 0 && cap <= 2097152) return PageBytes / 4;
        if (cap > 0 && cap <= 4194304) return PageBytes / 2;
        return PageBytes;
    }

    /// A page's own size: its limit less its start.
    public static nuint PageSize(nuint page)
    {
        return Sys.ReadAddress(page + ChunkLimit) - page;
    }

    // WHAT A CHUNK IS NORMALLY: a sixteenth of the heap as it stands,
    // between 64 KiB and a megabyte, or MixedChunkMost where a platform
    // sets it (ChunkAsk). A large heap -- a compiler's
    // -- still asks the operating system rarely and keeps its chunk list
    // short; a small one grows and gives back in small steps. A megabyte
    // always kept a megabyte for a few live blocks: a 32 MB machine's GUI
    // kernel held its heap at three times what was live. A single
    // allocation larger gets a chunk of its own size.
    const int ChunkLeast = 65536, ChunkMost = 1048576;
    /// The least a heap other than the first grows by (ChunkAsk).
    const int ModuleChunkLeast = 16384;

    /// THE MOST A MIXED CHUNK MAY BE, as a platform sets it (0: ChunkMost,
    /// a megabyte). A chunk's blocks are found by their chain from its first,
    /// so its size is what one walk of it costs -- the stop's walk in steps
    /// passes chunk by chunk, but a thread that needs a chunk's snapshot
    /// mid-stop walks the whole of it (Gc.EnsureWalked), and every thread
    /// waiting for the heap lock waits as long. A kernel on a K6-III asks a
    /// quarter of a megabyte. Never below ChunkLeast; a request larger than
    /// a mixed chunk takes one of its own, as ever.
    public static long MixedChunkMost;

    static nuint ChunkAsk()
    {
        // NOT PAST AN EIGHTH OF A COLLECTION'S ALLOWANCE where the platform
        // sets one from the machine (a kernel's ThresholdCap, Mem.Total /
        // 32): 128 KiB on a 32 MB machine, a megabyte from 256 MB up. A
        // program with no such cap -- a compiler -- keeps the megabyte.
        long most = ChunkMost;
        long cap = Platform.GcThreshold();
        if (cap > 0) most = (cap / 8 + 4095) & -4096;
        long ceiling = MixedChunkMost > 0 && MixedChunkMost < ChunkMost ? MixedChunkMost : ChunkMost;
        if (ceiling < ChunkLeast) ceiling = ChunkLeast;
        if (most < ChunkLeast) most = ChunkLeast;
        if (most > ceiling) most = ceiling;
        // A KERNEL MODULE'S HEAP BY ITS OWN SIZE, not the machine's: a
        // driver's first object past a kilobyte took a chunk measured on
        // every heap together, a quarter of a megabyte for a ring buffer.
        long own = Gc.WorkingHeapBytes;
        long least = own >= 0 ? ModuleChunkLeast : ChunkLeast;
        long ask = ((own >= 0 ? own : _heapBytes) / 16 + 4095) & -4096;
        return (nuint)(ask < least ? least : ask > most ? most : ask);
    }

    static nuint _chunks;        // newest chunk first
    static nuint _floor;         // lowest block address in any chunk
    static nuint _ceiling;       // one past the highest chunk
    static nuint _memo;          // the chunk the last lookup hit
    static long _heapBytes;     // every chunk's size, summed
    static long _cap;           // the most to take from the OS; 0 = no cap
    // Raw metadata, not managed objects: allocating it must not recurse into
    // the collector. Mutations, like the chunk list, hold the heap lock.
    // One word per chunk; one initial page covers a 1 GiB ordinary heap.
    // _index is the first entry, inside a mapping at _indexBase with room at
    // BOTH ENDS: the operating system hands mappings out top down, so a new
    // chunk is most often the lowest yet, and an index with room only at its
    // end moved every entry for it -- forty thousand pages of a compiler's
    // heap, a seventh of its time. An entry goes in by moving the shorter
    // side.
    static nuint _index;
    static nuint _indexBase;
    // THE CHUNK OF EVERY 4 KB OF A WINDOW OF THE ADDRESS SPACE, one word
    // each (Of): a free's chunk found by one read where a binary search over
    // the index took most of what a compiler's fifty million frees cost the
    // thread making them. Mapped once, where a mapping costs only the pages
    // touched (Platform.MapsCommitLazily): a page of the table covers a
    // megabyte or more of heap. 0 where there is none; the index answers
    // then, and outside the window.
    //
    // THE WINDOW IS WHERE THE HEAP IS. On i386 it is all four gigabytes, a
    // table of 4 MiB. Long mode's 47 bits would want a table of 256 GiB,
    // and Linux maps every chunk near the top of them, so there the window
    // is 64 GiB placed by the first chunk (SlotsSet), a table of 128 MiB of
    // address space, committed only where the heap is. _slotBias is the
    // table less the window's first word, so that an address's word is
    // _slotBias + (at >> 12) words, as on i386, where the two are the same.
    static nuint _slots;
    static nuint _slotBias;
    static nuint _slotLow;
    static bool _slotsTried;
    // THE CHUNKS NOT WHOLLY INSIDE THE WINDOW, counted as each is entered
    // and taken out (SlotsSet): while there are none the table says of
    // every chunk, and a word outside the window is no heap's (Whole).
    static long _outsideWindow;
    const int SlotShift = 12;
    // THE WINDOW'S SIZE, as a shift: 64 GiB in long mode, and on i386 the
    // whole of 32 bits, which no word holds as a number -- so a word inside
    // it is said by its shift (InWindow), and SlotSpan is a long.
#if TARGET_64BIT
    const int SpanShift = 36;
#else
    const int SpanShift = 32;
#endif
    public const long SlotSpan = 1L << SpanShift;
    const nuint SlotEntries = (nuint)1 << (SpanShift - SlotShift);

    /// Whether `offset`, an address less the window's first, lies inside it:
    /// always on i386, where the window is everything.
    static bool InWindow(nuint offset) => SpanShift >= 8 * WordSize.Bytes || offset >> SpanShift == 0;

    // Chunk `chunk`'s mapped range, every 4 KB of it inside the window, set
    // to `value`. Unsigned, as addresses are: a kernel's heap in the top
    // half of long mode is above every other.
    static void SlotsSet(nuint chunk, nuint value)
    {
        if (!_slotsTried)
        {
            _slotsTried = true;
            if (Platform.MapsCommitLazily) _slots = Platform.Map(SlotEntries * WordSize.Bytes);
#if TARGET_64BIT
            // THE WINDOW BY THE FIRST CHUNK: the system hands mappings out
            // top down, so the chunks after it land below it. Its top is
            // an eighth of the span past the chunk's limit rounded up to an
            // eighth, room for a heap that grows upward instead -- a
            // kernel's. Never past the top of the address space (a kernel
            // linked in the top two gigabytes), nor below its bottom.
            nuint eighth = (nuint)1 << (SpanShift - 3);
            nuint limit = Sys.ReadAddress(chunk + ChunkLimit);
            nuint top = ((limit + eighth - 1) & ~(eighth - 1)) + eighth;
            if (top < limit) _slotLow = ~(((nuint)1 << SpanShift) - 1);
            else if (top > (nuint)1 << SpanShift) _slotLow = top - ((nuint)1 << SpanShift);
#endif
            if (_slots != 0) _slotBias = _slots - (_slotLow >> SlotShift) * WordSize.Bytes;
        }
        if (_slots == 0) return;
        nuint low = _slotLow;
        nuint end = Sys.ReadAddress(chunk + ChunkLimit);
        nuint from = chunk & ~(nuint)((1 << SlotShift) - 1);
        // Counted in as it is entered, out as it is taken out, at the same
        // limit: a chunk's limit is written once, as it is made.
        if (from < low || !InWindow(end - low - 1)) _outsideWindow = _outsideWindow + (value != 0 ? 1 : -1);
        if (from < low) from = low;
        for (nuint at = from; at < end && InWindow(at - low); at = at + (1 << SlotShift))
            Sys.WriteAddress(_slots + ((at - low) >> SlotShift) * WordSize.Bytes, value);
    }
    static nuint _indexCount;
    static nuint _indexCapacity;
    static bool _indexFailed;
    static bool _anchorsActive;
    static long _anchorBytes;

    public static long BlockAnchorBytes { get { return _anchorBytes; } }

    public static nuint BlockAnchorCount(nuint chunk)
    {
        return (Limit(chunk) - chunk + 4095) / 4096;
    }

    // After the anchors, in the same mapping: the cycle the start bits are
    // of, and the start bits -- one for every eight bytes of the chunk, set
    // where an allocated block began at that cycle's first stop. A bitmap
    // word is a machine word, so a compare-and-swap of one touches nothing
    // but its own bits.
    const int StartBits = 8 * WordSize.Bytes;
    // Offsets into a chunk are never negative, so the bit and word a block's
    // start is at are shifts, not the signed divisions a 32-bit processor
    // pays a correction for; the marker asks for one on every pointer.
    const int StartShift = 3 + WordSize.Shift;
    const int StartBitMask = StartBits - 1;

    static nuint StartWords(nuint chunk)
    {
        return ((Limit(chunk) - chunk) / 8 + StartBits - 1) / StartBits;
    }

    static nuint AnchorBytes(nuint chunk)
    {
        return (BlockAnchorCount(chunk) * WordSize.Bytes + WordSize.Bytes + StartWords(chunk) * WordSize.Bytes + 4095) & ~(nuint)4095;
    }

    /// Where a chunk's start bits are (after its anchors), or 0 for a chunk without them.
    public static nuint Starts(nuint chunk)
    {
        nuint anchors = Sys.ReadAddress(chunk + ChunkAnchors);
        return anchors == 0 ? 0 : anchors + BlockAnchorCount(chunk) * WordSize.Bytes;
    }

    public static nuint StartsCycle(nuint chunk)
    {
        nuint starts = Starts(chunk);
        return starts == 0 ? NoCycle : Sys.ReadAddress(starts);
    }

    /// What StartsCycle answers for a chunk with no table: no cycle's.
    public const nuint NoCycle = ~(nuint)0;

    public static void ClearStarts(nuint chunk, nuint cycle)
    {
        nuint starts = Starts(chunk);
        if (starts == 0) return;
        nuint words = StartWords(chunk);
        for (nuint i = 0; i < words; i++) Sys.WriteAddress(starts + WordSize.Bytes + i * WordSize.Bytes, 0);
        Sys.WriteAddress(starts, cycle);
    }

    public static void SetStart(nuint chunk, nuint block)
    {
        nuint starts = Starts(chunk);
        if (starts == 0) return;
        nuint bit = (block - chunk) >> 3;
        nuint at = starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes;
        Sys.WriteAddress(at, Sys.ReadAddress(at) | ((nuint)1 << (int)(bit & StartBitMask)));
    }

    /// SetStart when other threads are writing starts into the same table
    /// at the same time -- each its own buffer, but buffers share words of
    /// the table where they meet.
    public static void SetStartShared(nuint chunk, nuint block)
    {
        nuint starts = Starts(chunk);
        if (starts == 0) return;
        nuint bit = (block - chunk) >> 3;
        nuint at = starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes;
        nuint mask = (nuint)1 << (int)(bit & StartBitMask);

        while (true)
        {
            nuint word = Sys.ReadAddress(at);
            if ((word & mask) != 0) return;
            if ((Sys.Cas(at, word, (word | mask))) == word) return;
        }
    }

    public static bool IsStart(nuint chunk, nuint block)
    {
        nuint starts = Starts(chunk);
        if (starts == 0) return false;
        nuint bit = (block - chunk) >> 3;
        return (Sys.ReadAddress(starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes) & ((nuint)1 << (int)(bit & StartBitMask))) != 0;
    }

    /// The highest start at or below `address`, or 0.
    public static nuint StartAtOrBelow(nuint chunk, nuint address)
    {
        nuint starts = Starts(chunk);
        return starts == 0 ? 0 : StartAtOrBelow(chunk, starts, address, false);
    }

    /// The lowest start at or above `address`, or 0.
    public static nuint NextStart(nuint chunk, nuint address)
    {
        nuint starts = Starts(chunk);
        if (starts == 0) return 0;
        nuint words = StartWords(chunk);
        nuint bit = (address - chunk + 7) >> 3;
        nuint word = bit >> StartShift;
        if (word >= words) return 0;
        nuint bits = (Sys.ReadAddress(starts + WordSize.Bytes + word * WordSize.Bytes)) & ~(((nuint)1 << (int)(bit & StartBitMask)) - 1);

        while (bits == 0)
        {
            word = word + 1;
            if (word >= words) return 0;
            bits = Sys.ReadAddress(starts + WordSize.Bytes + word * WordSize.Bytes);
        }

        nuint low = (nuint)Runtime.TrailingZeroCount(bits);
        return chunk + (word * StartBits + low) * 8;
    }

    // THE CHUNK INDEX AS IT WAS AT THE STOP. The live one is edited in
    // place, and moved, under the heap lock; the marker holds no lock.
    static nuint _snap;
    static nuint _snapCount;
    static nuint _snapCapacity;

    // ONE BIT FOR EVERY 64 KiB OF ADDRESS SPACE A SNAPSHOT CHUNK TOUCHES.
    // The marker asks OfSnapshot of every word it scans, and most of them --
    // counts, characters, flags -- point nowhere near the heap: the bit
    // turns those away with one load, where the search of the index cost a
    // dozen 64-bit compares on a 32-bit processor. That search was a third
    // of all the processor time of a 233 MHz board's boot. In long mode;
    // a 32-bit process has a word per megabyte instead, which also names
    // the chunk (_snapMegabytes).
    static nuint _snapRegions;
    const int RegionShift = 16;
#if TARGET_64BIT
    // LONG MODE HAS 2^47 BYTES OF USER ADDRESS SPACE, and a flat bit per 64
    // KiB of it would be two gigabytes of map. So the bits are two-level: a
    // top table of one word per 4 GiB -- 2^15 of them, whose pages the kernel
    // commits only as words are written -- each naming an 8 KiB bitmap for
    // its 4 GiB, made the first time a chunk lands there. A heap is a handful
    // of them, and clearing those is what a snapshot costs, not the whole top
    // table. A bitmap the system would not give turns the filter off for the
    // cycle, and the index search answers alone, as it did before the filter.
    const int RegionTops = 32768;
    const int RegionTopShift = 32;
    const int RegionMapBytes = 8192;           // 2^32 >> 16 bits, per 4 GiB
    static nuint _snapRegionUsed;                // top slots holding a bitmap, one word each
    static nuint _snapRegionUsedCount;
    static bool _snapFilterOff;

    static nuint RegionBitmap(nuint top)
    {
        nuint bitmap = Sys.ReadAddress(_snapRegions + top * WordSize.Bytes);
        if (bitmap != 0) return bitmap;
        bitmap = Platform.Map(RegionMapBytes);
        if (bitmap == 0) return 0;
        Sys.WriteAddress(_snapRegions + top * WordSize.Bytes, bitmap);
        Sys.WriteAddress(_snapRegionUsed + _snapRegionUsedCount * WordSize.Bytes, top);
        _snapRegionUsedCount = _snapRegionUsedCount + 1;
        return bitmap;
    }
#else
    // A WORD PER 64 KB, not per megabyte: a size-class page is 32 KB, and a
    // megabyte of them had its thirty-two walked in order for every word the
    // marker scanned into it. At 64 KB a slot reaches two pages and perhaps
    // the end of a larger chunk.
    const int MegabyteShift = 16;
    const int MegabyteMapBytes = 65536 * 4;    // a word per 64 KB of 4 GiB
    static nuint _snapMegabytes;
#endif

    public static bool SnapshotIndex()
    {
        _snapCount = 0;
        if (_indexFailed || _index == 0) return false;

        if (_snapCapacity < _indexCount)
        {
            if (_snap != 0) Platform.Unmap(_snap, _snapCapacity * WordSize.Bytes);
            _snapCapacity = 0;
            _snap = Platform.Map(_indexCapacity * WordSize.Bytes);
            if (_snap == 0) return false;
            _snapCapacity = _indexCapacity;
        }

        for (nuint i = 0; i < _indexCount; i++) Sys.WriteAddress(_snap + i * WordSize.Bytes, Sys.ReadAddress(_index + i * WordSize.Bytes));
        _snapCount = _indexCount;

#if TARGET_64BIT
        if (_snapRegions == 0)
        {
            _snapRegions = Platform.Map(RegionTops * WordSize.Bytes);
            _snapRegionUsed = _snapRegions == 0 ? 0 : Platform.Map(RegionTops * WordSize.Bytes);
            if (_snapRegionUsed == 0) _snapRegions = 0;
        }
        _snapFilterOff = _snapRegions == 0;
        if (_snapRegions != 0)
        {
            for (nuint k = 0; k < _snapRegionUsedCount; k++)
            {
                nuint bitmap = Sys.ReadAddress(_snapRegions + Sys.ReadAddress(_snapRegionUsed + k * WordSize.Bytes) * WordSize.Bytes);
                for (nuint i = 0; i < RegionMapBytes; i = i + WordSize.Bytes) Sys.WriteAddress(bitmap + i, 0);
            }
            for (nuint i = 0; i < _snapCount && !_snapFilterOff; i++)
            {
                nuint chunk = Sys.ReadAddress(_snap + i * WordSize.Bytes);
                nuint last = (Sys.ReadAddress(chunk + ChunkLimit) - 1) >> RegionShift;
                for (nuint r = chunk >> RegionShift; r <= last; r++)
                {
                    nuint top = r >> (RegionTopShift - RegionShift);
                    nuint bitmap = top < RegionTops ? RegionBitmap(top) : 0;
                    if (bitmap == 0) { _snapFilterOff = true; break; }
                    nuint within = r & (((nuint)1 << (RegionTopShift - RegionShift)) - 1);
                    nuint at = bitmap + (within >> 3);
                    Sys.Write8(at, (byte)(Sys.Read8(at) | (1 << (int)(within & 7))));
                }
            }
        }
#else
        // A WORD FOR EVERY MEGABYTE OF THE ADDRESS SPACE, naming the first
        // snapshot chunk that reaches into it (its index plus one; 0 for none).
        // A chunk is taken a megabyte at a time unless a cap says otherwise,
        // so a megabyte has one chunk in it or two, and OfSnapshot answers
        // with a load and a compare where a search of the index took a dozen
        // 64-bit compares -- for every word the marker scans.
        if (_snapMegabytes == 0) _snapMegabytes = Platform.Map(MegabyteMapBytes);
        if (_snapMegabytes != 0)
        {
            // Cleared by the string instruction: a word a time with a 64-bit
            // index was sixty-five thousand trips at every collection.
            Sys.MemorySet(_snapMegabytes, 0, MegabyteMapBytes);
            for (nuint i = 0; i < _snapCount; i++)
            {
                nuint chunk = Sys.ReadAddress(_snap + i * WordSize.Bytes);
                nuint last = ((Sys.ReadAddress(chunk + ChunkLimit)) - 1) >> MegabyteShift;
                for (nuint m = chunk >> MegabyteShift; m <= last; m++)
                {
                    nuint at = _snapMegabytes + m * WordSize.Bytes;
                    if (Sys.ReadAddress(at) == 0) Sys.WriteAddress(at, i + 1);
                }
            }
        }
#endif
        return true;
    }

    public static nuint SnapshotChunk(nuint i)
    {
        return i < _snapCount ? Sys.ReadAddress(_snap + i * WordSize.Bytes) : 0;
    }

    public static nuint OfSnapshot(nuint at)
    {
#if TARGET_64BIT
        if (!_snapFilterOff && _snapRegions != 0)
        {
            nuint top = at >> RegionTopShift;
            if (top >= RegionTops) return 0;
            nuint bitmap = Sys.ReadAddress(_snapRegions + top * WordSize.Bytes);
            if (bitmap == 0) return 0;
            nuint within = (at >> RegionShift) & (((nuint)1 << (RegionTopShift - RegionShift)) - 1);
            if ((Sys.Read8(bitmap + (within >> 3)) & (1 << (int)(within & 7))) == 0) return 0;
        }
#else
        if (_snapMegabytes != 0)
        {
            nuint address = at;
            nuint entry = Sys.ReadAddress(_snapMegabytes + (address >> MegabyteShift) * WordSize.Bytes);
            if (entry == 0) return 0;
            nuint i = entry - 1;
            // The chunks from there on, in address order, while one could hold it.
            while (i < _snapCount)
            {
                nuint chunk = Sys.ReadAddress(_snap + i * WordSize.Bytes);
                if (chunk > address) return 0;
                if (address < (Sys.ReadAddress(chunk + ChunkLimit))) return chunk;
                i = i + 1;
            }
            return 0;
        }
#endif
        nuint low = 0, high = _snapCount;
        while (low < high)
        {
            nuint middle = low + (high - low) / 2;
            if ((Sys.ReadAddress(_snap + middle * WordSize.Bytes)) <= at) low = middle + 1;
            else high = middle;
        }
        if (low == 0) return 0;
        nuint candidate = Sys.ReadAddress(_snap + (low - 1) * WordSize.Bytes);
        return at < (Sys.ReadAddress(candidate + ChunkLimit)) ? candidate : 0;
    }

    public static nuint PrepareBlockAnchors(nuint chunk)
    {
        nuint anchors = Sys.ReadAddress(chunk + ChunkAnchors);
        if (anchors == 0)
        {
            nuint bytes = AnchorBytes(chunk);
            anchors = Platform.Map(bytes);
            if (anchors != 0)
            {
                Sys.WriteAddress(chunk + ChunkAnchors, anchors);
                _anchorBytes = _anchorBytes + (long)bytes;
            }
        }
        return anchors;
    }

    public static void SetBlockAnchorsActive(bool active) { _anchorsActive = active; }

    public static nuint MarkStart(nuint chunk, nuint address)
    {
        if (_anchorsActive)
        {
            nuint anchors = Sys.ReadAddress(chunk + ChunkAnchors);
            if (anchors != 0)
            {
                nuint block = Sys.ReadAddress(anchors + ((address - chunk) / 4096) * WordSize.Bytes);
                if (block != 0) return block;
            }
        }
        // A metadata allocation failure preserves the authoritative walk.
        return First(chunk);
    }

    static nuint IndexLowerBound(nuint address)
    {
        nuint low = 0, high = _indexCount;
        while (low < high)
        {
            nuint middle = low + (high - low) / 2;
            if (Sys.ReadAddress(_index + middle * WordSize.Bytes) < address) low = middle + 1;
            else high = middle;
        }
        return low;
    }

    static void IndexAdd(nuint chunk)
    {
        IndexAddRun(chunk, 1, 0);
    }

    /// The heap check's: a range about to become heap that some chunk
    /// already holds is memory with two owners -- the address space handed
    /// out twice, or a chunk let go while still indexed. Said with the calls.
    public static bool CheckOverlaps;
    static long _overlapReports;

    static void CheckNew(nuint raw, nuint bytes)
    {
        if (!CheckOverlaps || _overlapReports >= 8) return;
        for (nuint at = raw; at < raw + bytes; at = at + 4096)
        {
            nuint holder = Of(at);
            if (holder == 0) continue;
            _overlapReports = _overlapReports + 1;
            Gc.SayNumber("gc owner check: new heap memory already a chunk's, at ", at);
            Gc.SayNumber("gc owner check:   the new range starts ", raw);
            Gc.SayNumber("gc owner check:   bytes ", bytes);
            Gc.SayNumber("gc owner check:   the chunk holding it ", holder);
            Gc.SayNumber("gc owner check:   its class ", PageClass(holder));
            Runtime.SayTrace(2, Sys.FramePointer());
            return;
        }
    }

    /// `n` chunks at `first`, `first + step`, ... entered together: none of
    /// the index lies between them, so the entries around them move once.
    static void IndexAddRun(nuint first, nuint n, nuint step)
    {
        for (nuint k = 0; k < n; k++) SlotsSet(first + k * step, first + k * step);
        if (_indexFailed) return;
        nuint front = _index == 0 ? 0 : (_index - _indexBase) / WordSize.Bytes;
        nuint back = _indexCapacity - front - _indexCount;
        if (front < n && back < n)
        {
            nuint capacity = _indexCapacity == 0 ? 1024 : _indexCapacity * 2;
            while (capacity < _indexCount + 2 * n) capacity = capacity * 2;
            nuint grown = Platform.Map(capacity * WordSize.Bytes);
            if (grown == 0)
            {
                // Never publish an incomplete index. The authoritative list
                // still contains every chunk and remains a correct fallback.
                _indexFailed = true;
                if (_indexBase != 0) Platform.Unmap(_indexBase, _indexCapacity * WordSize.Bytes);
                _index = 0;
                _indexBase = 0;
                _indexCount = 0;
                _indexCapacity = 0;
                return;
            }
            // The room split between the ends.
            nuint lead = (capacity - _indexCount) / 2;
            for (nuint i = 0; i < _indexCount; i++)
                Sys.WriteAddress(grown + (lead + i) * WordSize.Bytes, Sys.ReadAddress(_index + i * WordSize.Bytes));
            // THE OLD TABLE IS KEPT, not unmapped: a reader that had loaded
            // its address -- the collector resolving a pointer with nothing
            // held -- may still be searching it, and an unmapped page under
            // it faulted. Doubling, all the tables left behind come to less
            // than the one in use.
            _indexBase = grown;
            _index = grown + lead * WordSize.Bytes;
            _indexCapacity = capacity;
            front = lead;
            back = capacity - lead - _indexCount;
        }
        nuint at = IndexLowerBound(first);
        if (front >= n && (at < _indexCount - at || back < n))
        {
            // The entries below the run `n` places down, into the room in front.
            nuint moved = _index - n * WordSize.Bytes;
            for (nuint i = 0; i < at; i++)
                Sys.WriteAddress(moved + i * WordSize.Bytes, Sys.ReadAddress(_index + i * WordSize.Bytes));
            for (nuint k = 0; k < n; k++)
                Sys.WriteAddress(moved + (at + k) * WordSize.Bytes, first + k * step);
            _index = moved;
        }
        else
        {
            for (nuint i = _indexCount; i > at; i--)
                Sys.WriteAddress(_index + (i - 1 + n) * WordSize.Bytes, Sys.ReadAddress(_index + (i - 1) * WordSize.Bytes));
            for (nuint k = 0; k < n; k++)
                Sys.WriteAddress(_index + (at + k) * WordSize.Bytes, first + k * step);
        }
        _indexCount = _indexCount + n;
    }

    static void IndexRemove(nuint chunk)
    {
        SlotsSet(chunk, 0);
        if (_indexFailed || _indexCount == 0) return;
        nuint at = IndexLowerBound(chunk);
        if (at == _indexCount || Sys.ReadAddress(_index + at * WordSize.Bytes) != chunk) return;
        if (at < _indexCount - 1 - at)
        {
            // The entries below it one place up, and the front moves up.
            for (nuint i = at; i > 0; i--)
                Sys.WriteAddress(_index + i * WordSize.Bytes, Sys.ReadAddress(_index + (i - 1) * WordSize.Bytes));
            Sys.WriteAddress(_index, 0);
            _index = _index + WordSize.Bytes;
            _indexCount--;
            return;
        }
        for (nuint i = at + 1; i < _indexCount; i++)
            Sys.WriteAddress(_index + (i - 1) * WordSize.Bytes, Sys.ReadAddress(_index + i * WordSize.Bytes));
        _indexCount--;
        Sys.WriteAddress(_index + _indexCount * WordSize.Bytes, 0);
    }

    public static long HeapBytes
    {
        get { return _heapBytes; }
    }

    /// Whether one more page would pass the cap -- the cap as it stands for
    /// this request (CapNow): an emptied page near it goes back to the system
    /// rather than into the pool (Gc.RetirePage), so the reserve below it is
    /// never held by pages kept for reuse.
    public static bool OverCap()
    {
        long cap = CapNow();
        return cap != 0 && _heapBytes + (long)BatchPageBytes() > cap;
    }

    // THE RESERVE UNDER THE CAP: the last few megabytes of it, which the heap
    // grows into only for a request that would otherwise fail (ReserveOpen).
    // A capped heap filled to its cap with free memory in pieces -- holes in
    // mixed chunks, slots of size-class pages, none of them a whole chunk
    // the system could take back -- refused a two-megabyte Dictionary rehash
    // with eighty-five megabytes free: no hole of a mixed chunk is larger
    // than the chunk (a megabyte at most, or MixedChunkMost; ChunkAsk), the
    // collector moves nothing, and a large array is only ever a new mapping.
    // And a rehash, or
    // a list's growth, needs the new array while the old one is still alive:
    // the old one goes back the moment the copy is made (OutgrownStorage),
    // but not before. Held back from ordinary growth, the reserve is there
    // after a whole collection for exactly that moment. A thirty-second of
    // the cap, between 64 KiB and 8 MiB and never more than a quarter of it:
    // 7 MB of a compiler's 224, a few hundred kilobytes of a small kernel's
    // heap. Shifts, not a division: nothing here may throw.
    const int ReserveMost = 8388608;

    static long Reserve()
    {
        long reserve = (_cap >> 5) & -4096;
        if (reserve < ChunkLeast) reserve = ChunkLeast;
        if (reserve > ReserveMost) reserve = ReserveMost;
        if (reserve > (_cap >> 2)) reserve = (_cap >> 2) & -4096;
        return reserve;
    }

    /// Set by the allocator, with the heap lock held, only around its tries
    /// after a whole collection has not found a request's room (Gc.AllocSlow,
    /// Gc.AllocClass), and cleared again before the lock goes.
    public static bool ReserveOpen;

    /// The cap ordinary growth stops at: the cap less its reserve, 0 for none.
    /// What the collector paces itself by (Gc.NextThreshold), so that a heap
    /// is collected before it reaches the reserve rather than at it.
    public static long SoftCap
    {
        get { return _cap == 0 ? 0 : _cap - Reserve(); }
    }

    /// The cap for the request being answered now: the whole of it while the
    /// reserve is open, else the soft cap; an eighth more (a batch of pages
    /// at least) for a request the cap is lifted for (PastCap). 0 for none.
    static long CapNow()
    {
        if (PastCap && _cap != 0)
        {
            // An eighth, and never less than one batch of pages: under a
            // small cap an eighth is not a page.
            long lift = _cap >> 3;
            if (lift < (long)BatchPageBytes()) lift = (long)BatchPageBytes();
            return _cap + lift;
        }
        return ReserveOpen ? _cap : SoftCap;
    }

    /// Set by the allocator, with the heap lock held, around the last try of
    /// a request whose thread may not wait for another's collection (a
    /// kernel's, its preemption count raised), and cleared before the lock
    /// goes: such a request can neither wait for the cycle that would free
    /// its room nor fail where it stands, and takes it from the system
    /// instead, as an allocation that may not sleep does in a kernel -- up to
    /// an eighth past the cap, a batch of pages at least (CapNow), so that a
    /// thread allocating in a loop while a cycle stands still cannot take
    /// the machine's memory.
    /// The next cycle brings the heap back under.
    public static bool PastCap;

    /// The bytes held back below the cap, for the out-of-memory report.
    public static long ReserveBytes
    {
        get { return _cap == 0 ? 0 : Reserve(); }
    }

    public static void SetLimit(long bytes)
    {
        _cap = bytes;
    }

    /// The cap SetLimit put on the heap, or 0 for none.
    public static long Cap
    {
        get { return _cap; }
    }

    public static bool Any()
    {
        return _chunks != 0;
    }

    /// The newest chunk, the head of the list; Next walks towards the oldest.
    public static nuint Newest()
    {
        return _chunks;
    }

    /// The heap a chunk is of: its record (Gc, "heaps").
    public static nuint HeapOf(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkHeap);
    }

    /// A chunk given to another heap, by Gc.ReleaseHeap; its own lists and
    /// bins are the caller's to move.
    public static void SetHeapOf(nuint chunk, nuint heap)
    {
        Sys.WriteAddress(chunk + ChunkHeap, heap);
    }

    public static nuint Next(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkNext);
    }

    /// Where a chunk's blocks begin.
    public static nuint First(nuint chunk)
    {
        return chunk + ChunkBytes;
    }

    // ---- size-class pages ------------------------------------------------

    /// A page's class plus one, or 0 for a chunk of mixed blocks.
    public static nuint PageClass(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkClass);
    }

    /// What the heap is made of, said with the census: size-class pages
    /// (and how many sit pooled, empty), chunks of mixed blocks and what
    /// their last sweeps found live in them, and the largest chunk -- where
    /// a heap mapped at twice what is live keeps the difference. The heap
    /// lock is held; nothing is allocated.
    public static void SayMakeup()
    {
        nuint pages = 0, pooled = 0, mixed = 0, mixedBytes = 0, mixedLive = 0, largest = 0;
        for (nuint chunk = _chunks; chunk != 0; chunk = Sys.ReadAddress(chunk + ChunkNext))
        {
            nuint size = Sys.ReadAddress(chunk + ChunkLimit) - chunk;
            if (PageClass(chunk) != 0)
            {
                pages = pages + 1;
                if (IsPooled(chunk)) pooled = pooled + 1;
                continue;
            }
            mixed = mixed + 1;
            mixedBytes = mixedBytes + size;
            mixedLive = mixedLive + Sys.ReadAddress(chunk + ChunkLiveBytes);
            if (size > largest) largest = size;
        }
        Gc.SayNumber("gc census: heap bytes ", _heapBytes);
        Gc.SayNumber("gc census:   size-class pages ", pages);
        Gc.SayNumber("gc census:   of them pooled ", pooled);
        Gc.SayNumber("gc census:   mixed chunks ", mixed);
        Gc.SayNumber("gc census:   their bytes ", mixedBytes);
        Gc.SayNumber("gc census:   live in them ", mixedLive);
        Gc.SayNumber("gc census:   largest chunk ", largest);
    }

    public static void SetPageClass(nuint chunk, nuint classPlusOne)
    {
        Sys.WriteAddress(chunk + ChunkClass, classPlusOne);
    }

    public static nuint PageFree(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkFree);
    }

    public static void SetPageFree(nuint chunk, nuint head)
    {
        Sys.WriteAddress(chunk + ChunkFree, head);
    }

    public static nuint PageNext(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkPageNext);
    }

    public static nuint PagePrev(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkPagePrev);
    }

    public static void SetPageLinks(nuint chunk, nuint next, nuint prev)
    {
        Sys.WriteAddress(chunk + ChunkPageNext, next);
        Sys.WriteAddress(chunk + ChunkPagePrev, prev);
    }

    public static void SetPageNext(nuint chunk, nuint next)
    {
        Sys.WriteAddress(chunk + ChunkPageNext, next);
    }

    public static void SetPagePrev(nuint chunk, nuint prev)
    {
        Sys.WriteAddress(chunk + ChunkPagePrev, prev);
    }

    public static nuint Owner(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkOwner);
    }

    public static void SetOwner(nuint chunk, nuint thread)
    {
        Sys.WriteAddress(chunk + ChunkOwner, thread);
    }

    public static bool IsListed(nuint chunk)
    {
        return (Sys.ReadAddress(chunk + ChunkFlags) & ChunkListed) != 0;
    }

    public static void SetListed(nuint chunk, bool listed)
    {
        nuint flags = Sys.ReadAddress(chunk + ChunkFlags);
        Sys.WriteAddress(chunk + ChunkFlags, listed ? flags | ChunkListed : flags & ~(nuint)ChunkListed);
    }

    public static bool IsSwept(nuint chunk)
    {
        return (Sys.ReadAddress(chunk + ChunkFlags) & ChunkSwept) != 0;
    }

    public static void SetSwept(nuint chunk, bool swept)
    {
        nuint flags = Sys.ReadAddress(chunk + ChunkFlags);
        Sys.WriteAddress(chunk + ChunkFlags, swept ? flags | ChunkSwept : flags & ~(nuint)ChunkSwept);
    }

    public static bool IsPooled(nuint chunk)
    {
        return (Sys.ReadAddress(chunk + ChunkFlags) & ChunkPooled) != 0;
    }

    public static void SetPooled(nuint chunk, bool pooled)
    {
        nuint flags = Sys.ReadAddress(chunk + ChunkFlags);
        Sys.WriteAddress(chunk + ChunkFlags, pooled ? flags | ChunkPooled : flags & ~(nuint)ChunkPooled);
    }

    /// The bytes a page keeps at its end for its own start table, rounded
    /// to eight: the anchors, the cycle word and the start bits that
    /// AnchorBytes would have mapped a page of its own for.
    public static nuint PageTableBytes(nuint size)
    {
        nuint anchors = (size + 4095) / 4096;
        nuint starts = (size / 8 + StartBits - 1) / StartBits;
        return ((anchors + 1 + starts) * WordSize.Bytes + 7) & ~(nuint)7;
    }

    /// Where a page's blocks must end: its start table lies above.
    public static nuint PageBlockLimit(nuint chunk)
    {
        nuint size = PageSize(chunk);
        return chunk + size - PageTableBytes(size);
    }

    /// Up to `want` new size-class pages in one mapping, laid end to end:
    /// the highest made now -- a chunk of its own, empty (its end is its
    /// first block), its start table inside it, indexed -- and answered,
    /// one through `taken`; the others made one at a time as they are asked
    /// for (TakeFresh). 0 when the cap, the ceiling or the operating
    /// system refuses even one. Not yet formatted for a class
    /// (Gc.FormatPage). The heap lock is held.
    public static nuint TakePages(nuint want, nuint taken)
    {
        Sys.WriteAddress(taken, 0);
        nuint pageBytes = BatchPageBytes();
        if (Gc.GrowthWaits(pageBytes))
        {
            return 0;
        }
        nuint n = want;
        long cap = CapNow();
        if (cap != 0)
        {
            long room = (cap - _heapBytes) / (long)pageBytes;
            if (room < 1) return 0;
            if ((ulong)room < n) n = (nuint)room;
        }
        if (n < 1)
        {
            return 0;
        }
        nuint raw = Platform.Map(n * pageBytes);
        if (raw == 0 && n > 1)
        {
            n = 1;
            raw = Platform.Map(pageBytes);
        }
        if (raw == 0)
        {
            return 0;
        }
        Maps = Maps + 1;
        Gc.CommitCards(raw, n * pageBytes);
        CheckNew(raw, n * pageBytes);
        // ONE PAGE MADE NOW, THE REST AS THEY ARE ASKED FOR (TakeFresh). A
        // page's header is a write, and on an operating system that gives
        // memory on first touch the batch's thirty-two headers took its
        // megabyte at once -- the GUI kernel's heap held fifteen of them
        // with two and a half live. Mapped and counted as one, the batch
        // is taken from the top down: each page made after is below every
        // chunk indexed (mappings come top down), an insert at the index's
        // front, and no lookup ever reads a page not yet made.
        nuint top = raw + (n - 1) * pageBytes;
        MakePage(top, pageBytes);
        _freshLow = raw;
        _freshNext = top;
        _freshBytes = pageBytes;
        Sys.WriteAddress(taken, 1);
        return top;
    }

    /// ONE SIZE-CLASS PAGE OF `bytes` IN A MAPPING OF ITS OWN, made -- its
    /// header written, listed, indexed and counted -- or zero when the cap,
    /// the ceiling or the operating system refuses it. What a heap still
    /// small takes (Gc.SmallPageFor): not a page of the batch, whose size is
    /// the first heap's. The heap lock is held.
    public static nuint TakeOne(nuint bytes)
    {
        if (Gc.GrowthWaits(bytes))
        {
            return 0;
        }
        long cap = CapNow();
        if (cap != 0 && _heapBytes + (long)bytes > cap)
        {
            return 0;
        }
        nuint raw = Platform.Map(bytes);
        if (raw == 0)
        {
            return 0;
        }
        Maps = Maps + 1;
        Gc.CommitCards(raw, bytes);
        CheckNew(raw, bytes);
        MakePage(raw, bytes);
        return raw;
    }

    // THE BATCH'S PAGES NOT YET MADE: [_freshLow, _freshNext), mapped and
    // untouched, given out from the top down.
    static nuint _freshLow, _freshNext, _freshBytes;

    /// A page of the last batch not yet given out, made now -- its header
    /// written, listed, indexed -- or zero when the batch is used up. The
    /// heap lock is held.
    public static nuint TakeFresh()
    {
        if (_freshNext <= _freshLow) return 0;
        nuint page = _freshNext - _freshBytes;
        _freshNext = page;
        MakePage(page, _freshBytes);
        return page;
    }

    /// A size-class page's header written, the page listed and indexed and
    /// counted: an empty chunk of its own (its end is its first block).
    static void MakePage(nuint page, nuint size)
    {
        Sys.WriteAddress(page + ChunkNext, _chunks);
        Sys.WriteAddress(page + ChunkPrevious, 0);
        if (_chunks != 0) Sys.WriteAddress(_chunks + ChunkPrevious, page);
        Sys.WriteAddress(page + ChunkEnd, page + ChunkBytes);
        Sys.WriteAddress(page + ChunkLimit, page + size);
        Sys.WriteAddress(page + ChunkFlags, ChunkYoung);
        Sys.WriteAddress(page + ChunkAnchors, PageBlockLimit(page));
        Sys.WriteAddress(page + ChunkHeap, Gc.WorkingHeap);
        Gc.HeapGrew(Gc.WorkingHeap, size);
        _chunks = page;
        _heapBytes = _heapBytes + (long)size;
        IndexAdd(page);
        if (_floor == 0 || page + ChunkBytes < _floor)
        {
            _floor = page + ChunkBytes;
        }
        if (page + size > _ceiling)
        {
            _ceiling = page + size;
        }
    }

    /// Whether anything was allocated in the chunk since the last collection.
    public static bool IsYoung(nuint chunk)
    {
        return (Sys.ReadAddress(chunk + ChunkFlags) & ChunkYoung) != 0;
    }

    public static void SetYoung(nuint chunk, bool young)
    {
        nuint flags = Sys.ReadAddress(chunk + ChunkFlags);
        Sys.WriteAddress(chunk + ChunkFlags, young ? flags | ChunkYoung : flags & ~(nuint)ChunkYoung);
    }

    /// WHAT A MINOR CYCLE'S WALK IS THROUGH, fixed as its stop begins: every
    /// chunk young then (ChunkWalks), and no other. Taken whole under the
    /// heap lock, the walk saw young as it was at its start; in steps, a
    /// hole handed out of an old chunk between two makes the chunk young
    /// (YoungAt), and walked then -- by the stop's walk, or on demand -- the
    /// chunk had a start table of the cycle its old blocks were never meant
    /// to be judged by. A pass over the chunk list, not the heap. The heap
    /// lock is held.
    public static void MarkWalks()
    {
        for (nuint chunk = _chunks; chunk != 0; chunk = Sys.ReadAddress(chunk + ChunkNext))
        {
            nuint flags = Sys.ReadAddress(chunk + ChunkFlags);
            Sys.WriteAddress(chunk + ChunkFlags, (flags & ChunkYoung) != 0 ? flags | ChunkWalks : flags & ~(nuint)ChunkWalks);
        }
    }

    /// Whether the cycle's walk is through the chunk (MarkWalks): young when
    /// the stop began.
    public static bool Walks(nuint chunk)
    {
        return (Sys.ReadAddress(chunk + ChunkFlags) & ChunkWalks) != 0;
    }

    /// The chunk a block handed out lies in, made young. Heap lock held.
    public static void YoungAt(nuint block)
    {
        nuint chunk = Of(block);
        if (chunk != 0)
        {
            SetYoung(chunk, true);
        }
    }

    public static nuint LiveBytes(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkLiveBytes);
    }

    public static nuint LiveBlocks(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkLiveBlocks);
    }

    public static nuint LargestHole(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkLargestHole);
    }

    public static void SetLargestHole(nuint chunk, nuint bytes)
    {
        Sys.WriteAddress(chunk + ChunkLargestHole, bytes);
    }

    public static void SetLive(nuint chunk, nuint blocks, nuint bytes)
    {
        Sys.WriteAddress(chunk + ChunkLiveBlocks, blocks);
        Sys.WriteAddress(chunk + ChunkLiveBytes, bytes);
    }

    /// One past the last block laid down in a chunk.
    public static nuint End(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkEnd);
    }

    /// Takes a chunk out of the list and gives its memory back. The floor and
    /// ceiling are left as they were: an address inside a gone chunk still
    /// fails the lookup that follows the envelope test.
    /// Chunks taken from the operating system and given back, and of those
    /// given back the ones not of the usual size -- a large array's own:
    /// what says whether a program's heap is churning its mappings.
    public static long Maps, Releases, BigReleases;

    public static void Release(nuint chunk, bool guard = false)
    {
        nuint size = Sys.ReadAddress(chunk + ChunkLimit) - chunk;
        IndexRemove(chunk);

        nuint next = Sys.ReadAddress(chunk + ChunkNext);
        nuint previous = Sys.ReadAddress(chunk + ChunkPrevious);
        if (previous != 0) Sys.WriteAddress(previous + ChunkNext, next);
        else if (_chunks == chunk) _chunks = next;
        if (next != 0) Sys.WriteAddress(next + ChunkPrevious, previous);

        if (_memo == chunk)
        {
            _memo = 0;
        }

        _heapBytes = _heapBytes - (long)size;
        Gc.HeapShrank(Sys.ReadAddress(chunk + ChunkHeap), size);
        Releases = Releases + 1;
        if (size > ChunkMost) BigReleases = BigReleases + 1;
        nuint anchors = Sys.ReadAddress(chunk + ChunkAnchors);
        // A PAGE'S START TABLE IS INSIDE IT, and goes with it.
        if (anchors != 0 && (anchors < chunk || anchors >= chunk + size))
        {
            nuint bytes = AnchorBytes(chunk);
            Platform.Unmap(anchors, bytes);
            _anchorBytes = _anchorBytes - (long)bytes;
        }
        // Only a dedicated chunk a free gives back is guarded: the sweep's
        // empty chunks, guarded too, used up the address space of a 32-bit
        // process in minutes, and a free is what the guard is for.
        if (guard)
        {
            Platform.Guard(chunk, size);
            return;
        }
        Platform.Unmap(chunk, size);
    }

    public static void SetEnd(nuint chunk, nuint end)
    {
        Sys.WriteAddress(chunk + ChunkEnd, end);
    }

    /// One past the chunk's memory.
    public static nuint Limit(nuint chunk)
    {
        return Sys.ReadAddress(chunk + ChunkLimit);
    }

    /// The chunk whose laid-down blocks contain an address, or zero. The
    /// chunk hit last is tried first, because a run of pointers from one
    /// object mostly lands in one chunk. Other addresses use binary search;
    /// only an index allocation failure requires walking the chunk list.
    public static nuint Of(nuint at)
    {
        if (at < _floor || at >= _ceiling)
        {
            return 0;
        }

        nuint memo = _memo;

        if (memo != 0 && at >= memo + ChunkBytes && at < Sys.ReadAddress(memo + ChunkEnd))
        {
            return memo;
        }

        // Inside the table's window the table is exact; outside it, the index.
        if (_slots != 0 && InWindow(at - _slotLow))
        {
            nuint slot = Sys.ReadAddress(_slots + ((at - _slotLow) >> (int)SlotShift) * WordSize.Bytes);
            if (slot != 0 && at >= slot + ChunkBytes && at < Sys.ReadAddress(slot + ChunkEnd))
            {
                _memo = slot;
                return slot;
            }
            return 0;
        }

        if (!_indexFailed)
        {
            // Find the greatest chunk base <= at. Mappings cannot overlap;
            // the live extent check rejects headers, gaps and unused tails.
            nuint low = 0, high = _indexCount;
            while (low < high)
            {
                nuint middle = low + (high - low) / 2;
                if (Sys.ReadAddress(_index + middle * WordSize.Bytes) <= at) low = middle + 1;
                else high = middle;
            }
            if (low == 0) return 0;
            nuint candidate = Sys.ReadAddress(_index + (low - 1) * WordSize.Bytes);
            if (at >= candidate + ChunkBytes && at < Sys.ReadAddress(candidate + ChunkEnd))
            {
                _memo = candidate;
                return candidate;
            }
            return 0;
        }

        nuint chunk = _chunks;

        while (chunk != 0)
        {
            if (at >= chunk + ChunkBytes && at < Sys.ReadAddress(chunk + ChunkEnd))
            {
                _memo = chunk;
                return chunk;
            }
            chunk = Sys.ReadAddress(chunk + ChunkNext);
        }
        return 0;
    }

    /// A chunk still on the list whose memory lies in [at, at + bytes), or
    /// zero: what a platform's Unmap asks before it gives memory back, since
    /// memory given back from under a linked chunk is a fault the next time
    /// the list is walked or grown, far from whoever gave it back.
    public static nuint LinkedWithin(nuint at, nuint bytes)
    {
        for (nuint chunk = _chunks; chunk != 0; chunk = Sys.ReadAddress(chunk + ChunkNext))
        {
            if (chunk - at < bytes || chunk < at && Sys.ReadAddress(chunk + ChunkLimit) > at) return chunk;
        }
        return 0;
    }

    /// A new chunk with room for at least `need` bytes of blocks, or zero
    /// when the cap or the operating system refuses. Zeroed, page-aligned.
    public static nuint Take(nuint need, bool dedicated = false)
    {
        nuint minimum = (need + ChunkBytes + 4095) & ~(nuint)4095;
        nuint usual = ChunkAsk();
        nuint ask = dedicated || minimum > usual ? minimum : usual;

        // THE CEILING IS WHERE GROWTH WAITS FOR A COLLECTION (Gc.GrowthWaits):
        // refused here, the allocator collects first and asks again.
        if (Gc.GrowthWaits(ask))
        {
            return 0;
        }

        // The preferred growth quantum is not a minimum allocation size.
        // A smaller remaining cap (or address-space hole) can still satisfy
        // this request. Count actual mapped pages against the heap cap --
        // the soft cap, unless the reserve is open for this request.
        // INTO THE RESERVE, ONLY WHAT IS ASKED: a usual chunk taken there
        // for a small request spent a megabyte of it on a few bytes.
        long cap = CapNow();
        long soft = SoftCap;
        if (soft != 0 && _heapBytes + (long)ask > soft) ask = minimum;

        // THE POOL OF EMPTY PAGES GOES FIRST: kept to spare the mapping, it
        // is no reason to refuse a large array its room.
        if (cap != 0 && _heapBytes + (long)ask > cap && Gc.DrainPool())
        {
            if (_heapBytes + (long)ask > cap) ask = minimum;
        }

        // Refused at the cap, silently: the request that ends out of memory
        // is caught or not, and the heap's report is said only if it is not
        // (Gc.ThrowOutOfMemory).
        if (cap != 0 && _heapBytes + (long)ask > cap)
        {
            return 0;
        }

        nuint raw = Platform.Map(ask);
        if (raw == 0 && ask > minimum)
        {
            ask = minimum;
            raw = Platform.Map(ask);
        }

        if (raw == 0)
        {
            return 0;
        }

        Maps = Maps + 1;
        Sys.WriteAddress(raw + ChunkNext, _chunks);
        Sys.WriteAddress(raw + ChunkEnd, raw + ChunkBytes);
        Sys.WriteAddress(raw + ChunkLimit, raw + ask);
        Sys.WriteAddress(raw + ChunkFlags, ChunkYoung);
        // ITS START TABLE WITH IT: a collection must never map, because the
        // collection that needs to is the one the address space ran out for.
        // Taken lazily, at the first collection, it was refused exactly then,
        // the snapshot was given up, and nothing could be freed at all.
        if (PrepareBlockAnchors(raw) == 0)
        {
            Platform.Unmap(raw, ask);
            Maps = Maps - 1;
            return 0;
        }
        Sys.WriteAddress(raw + ChunkPrevious, 0);
        if (_chunks != 0) Sys.WriteAddress(_chunks + ChunkPrevious, raw);
        Sys.WriteAddress(raw + ChunkHeap, Gc.WorkingHeap);
        Gc.HeapGrew(Gc.WorkingHeap, ask);
        _chunks = raw;
        _heapBytes = _heapBytes + (long)ask;
        Gc.CommitCards(raw, ask);
        CheckNew(raw, ask);
        IndexAdd(raw);

        // Most words a conservative collector looks at are integers, code
        // addresses or null; the envelope rejects them before the list is
        // walked.
        if (_floor == 0 || raw + ChunkBytes < _floor)
        {
            _floor = raw + ChunkBytes;
        }
        if (raw + ask > _ceiling)
        {
            _ceiling = raw + ask;
        }
        return raw;
    }
    // ---- the marker's start-bit lookup (Gc.MarkWord) --------------------------

    /// The highest start at or below `address` -- `address` itself when its
    /// bit is set, which `exact` asks for first -- or 0. IsStart and
    /// StartAtOrBelow in one, on start bits already found.
    public static nuint StartAtOrBelow(nuint chunk, nuint starts, nuint address, bool exact)
    {
        const int w = WordSize.Bytes;
        nuint bit = (address - chunk) >> 3;
        nuint word = bit >> StartShift;
        nuint bits = Sys.ReadAddress((starts + w + word * w));
        nuint keep = bit & (nuint)StartBitMask;
        if (exact && (bits & ((nuint)1 << (int)keep)) != 0)
        {
            return address;
        }
        if (keep != (nuint)StartBitMask) bits = bits & (((nuint)1 << (int)(keep + 1)) - 1);

        while (bits == 0)
        {
            if (word == 0) return 0;
            word = word - 1;
            bits = Sys.ReadAddress((starts + w + word * w));
        }

        nuint top = (nuint)(StartBitMask - Runtime.LeadingZeroCount(bits));
        return chunk + (word * (nuint)StartBits + top) * 8;
    }
}

// ---- roots: where the live pointers begin ----------------------------------------
//
// The conservative collector's roots are RANGES OF MEMORY: every word in
// them is handed to Gc.MarkAt, and the ones that land on a block keep it.
// A precise collector replaces this class with one that walks stack maps
// and reference maps and hands over exact slots; Gc's marking does not
// care which.

static class GcRoots
{
    /// Enters a collection with every register on the stack.
    ///
    /// THE REGISTERS. A pointer held only in a register is still a pointer,
    /// and the collector reads memory, so every register must be in memory
    /// below the point the stack scan starts from. The reasoning, which is
    /// the reason Collect is reached only from Alloc:
    ///
    ///   - EAX, ECX and EDX are caller-saved: any value the caller of Alloc
    ///     still needs after the call is already somewhere else -- a frame
    ///     slot or a callee-saved register -- because the call clobbers them.
    ///   - EBX, ESI and EDI are callee-saved: a caller's live value in one of
    ///     them survives the call untouched, which means it may be ONLY in
    ///     that register. It reaches the stack when some frame between the
    ///     caller and the scan pushes that register in its prologue. The
    ///     backend pushes exactly the callee-saved registers a function uses,
    ///     so the guarantee is made explicit: Platform.EnterCollection says
    ///     it uses all of them (Sys.SaveRegisters, no instruction), so its
    ///     prologue pushes them, and only THEN calls back into
    ///     Gc.CollectInner. Those pushes are above CollectInner's ESP and
    ///     inside the range ScanAll scans.
    ///   - EBP is the frame pointer, pushed by every prologue (only a leaf,
    ///     which calls nothing, gives it a value after).
    ///
    /// This is a property of the backend's prologue that a test checks by
    /// reading the code (tests/integration/save-registers.sh); it is not
    /// something the language can state.
    public static void Enter()
    {
        Platform.EnterCollection();
    }

    /// Every root range: the machine stack from the current ESP (which
    /// includes the collector's own frames, harmlessly) up to the stack
    /// pointer the process was entered with, and the statics between the
    /// linker's __data_start and _end -- the data and bss sections, where
    /// every static field lives.
    public static void ScanAll()
    {
        // This thread's stack, from where the collector is standing to the
        // top the thread began at. Every OTHER thread's stack is marked from
        // by that thread itself, or by the collector for it while it is
        // blocked, in the SCAN round (GcThreads) -- never by stopping it.
        // THIS THREAD'S OWN TOP, which is the process's entry stack only for
        // the main thread. A child thread's collection read from its stack
        // pointer to the MAIN thread's entry -- through every other thread's
        // stack mapped between, dead frames and all -- and a stale pointer
        // there to a finished iterator kept a whole earlier compilation alive:
        // a compile process grew by a unit's binding for every unit it built.
        nuint self = Sys.ThreadBlock();
        nuint top = self != 0 ? Sys.ReadAddress(self + Tls.StackBase) : 0;
        if (top == 0 || top < Sys.Stack())
        {
            top = Sys.EntryStack();
        }
        if (Gc.PreciseRegisters())
        {
            Gc.ScanOwnStack(Sys.Stack(), top, 0);
        }
        else
        {
            Gc.ScanRootsAttributed(Sys.Stack(), top, 1, true);
        }
        // And its region arena, as every other thread's is with its stack.
        if (self != 0) Gc.ScanRegion(self);
        Gc.ScanStatics(Sys.DataStart(), Sys.DataEnd());

        nuint i = 0;

        while (_extra != 0 && i < ExtraMax)
        {
            nuint start = Sys.ReadAddress(_extra + i * (2 * WordSize.Bytes));
            // A slot whose start is the claim mark is one a thread is filling
            // in: its end is not written yet and there is nothing to scan.
            if (start != 0 && start != Claiming && !Gc.PassedOver(start))
            {
                Gc.ScanRootsAttributed(start, Sys.ReadAddress(_extra + i * (2 * WordSize.Bytes) + WordSize.Bytes), 3, false);
            }
            i = i + 1;
        }
    }

    // ---- roots the collector is told about ----------------------------------
    //
    // Sys.DataStart and Sys.DataEnd are the linker's __data_start and _end,
    // which describe ONE image. When this library is a shared object, its
    // statics and the executable's statics are two separate ranges and only
    // one of them is the one those symbols resolve to, so the other has to be
    // handed over at start -- as does any memory outside the heap that holds
    // references (a mapped region, a thread's stack). A range registered here
    // is scanned exactly as the statics are.
    //
    // The table is memory of the operating system's rather than a static
    // array, because registering a root must not itself allocate: it happens
    // before the heap is up, and a heap block would also be a block the
    // collector has to keep alive forever.

    const int ExtraMax = 128;

    /// The registered root ranges, for the collector's checks (Gc.VerifyStaticRoots).
    public static nuint ExtraTable() => _extra;
    public static nuint ExtraCount() => ExtraMax;
    public static nuint ClaimMark() => Claiming;
    const int ExtraBytes = ExtraMax * (2 * WordSize.Bytes);

    // A slot's start word is also how it is owned: zero is free, this is
    // taken but not yet filled in, anything else is a range being scanned.
    const int Claiming = 1;

    static nuint _extra;

    /// Adds [start, end) to the root ranges every collection scans. Answers
    /// false only if the table is full or the operating system refuses it,
    /// which a caller registering a handful of ranges at start cannot hit.
    public static bool Register(nuint start, nuint end)
    {
        if (start == 0 || end <= start)
        {
            return false;
        }

        if (_extra == 0)
        {
            // PUBLISHED ONCE (GcLock.Words): a registration written into a
            // table another first caller then replaced was never scanned.
            nuint fresh = Platform.Map(ExtraBytes);
            if (fresh != 0 && Sys.Cas(Sys.AddressOf(ref _extra), 0, fresh) != 0) Platform.Unmap(fresh, ExtraBytes);

            if (_extra == 0)
            {
                return false;
            }
        }

        // A SLOT IS TAKEN, NOT CHOSEN. Two threads registering at once --
        // two processors parking a kernel continuation, each on its own
        // stack -- both found the same slot empty and both wrote into it:
        // one's start beside the other's end. The pair that came out named
        // a range beginning on one stack and ending on another, with
        // whatever lay between them, and the next collection walked into
        // the gap and faulted in the kernel. The start word is claimed
        // first, with a compare and swap, and nothing else is written to
        // the slot until it belongs to this thread.
        for (nuint i = 0; i < ExtraMax; i++)
        {
            nuint at = _extra + i * (2 * WordSize.Bytes);

            if (Sys.Cas(at, 0, Claiming) != 0)
            {
                continue;
            }

            Sys.WriteAddress(at + WordSize.Bytes, end);
            Sys.Fence();                  // the end is there before the start says so
            Sys.WriteAddress(at, start);
            Gc.MarkRegistered(start, end);
            return true;
        }

        return false;
    }

    // The caller serializes root registration/removal against collection.
    public static bool Unregister(nuint start, nuint end)
    {
        for (nuint i = 0; _extra != 0 && i < ExtraMax; i++)
        {
            nuint at = _extra + i * (2 * WordSize.Bytes);
            if (start == 0 || Sys.ReadAddress(at) != start || Sys.ReadAddress(at + WordSize.Bytes) != end) continue;
            // The start goes first, and atomically: a slot whose start is
            // zero is free, and it must not become free while its end still
            // names this stack.
            Sys.AtomicSwap(at, 0);
            Sys.WriteAddress(at + WordSize.Bytes, 0);
            return true;
        }
        return false;
    }
}

// ---- one heap, many threads ---------------------------------------------------
//
// THE RULE. The heap -- the free lists, the chunk list, the bump pointer, the
// mark queue and every counter here -- belongs to whoever holds GcLock. A
// thread allocating out of its own buffer holds nothing, because nothing else
// may touch that buffer; everything else takes the lock.
//
// STOPPING THE WORLD, without a signal. A conservative collector reads other
// threads' stacks, so they must not be running while it does, and it must not
// sweep while another thread is bumping in a buffer whose tail is not yet a
// block. So the collector:
//
//   1. sets `collecting`, with the lock held (only the holder ever collects),
//   2. takes every other thread's allocation buffer away, by zeroing its
//      limit -- the fast path's bound, so the very next allocation on that
//      thread cannot bump and comes to the slow path,
//   3. waits until every other registered thread says it has stopped: at the
//      slow path, at the lock, or on its way into a system call that blocks,
//   4. retires their buffers itself, with the lock held, so every chunk is a
//      chain of blocks again, then marks and sweeps,
//   5. clears `collecting` and wakes everyone.
//
// WHAT THIS DOES NOT DO, and it is the known limitation: a thread that is
// neither allocating nor blocking is not stopped, and the collector waits for
// it. A long computation that allocates nothing therefore DELAYS every other
// thread's collection until it allocates, blocks or ends. Nothing is lost and
// nothing is corrupted -- the collector simply waits -- but a program can be
// written whose pause is as long as its longest allocation-free stretch. The
// fix is the safepoint poll the design calls for (X86-BACKEND.md, "Memory"):
// the compiler emitting a check of one word at every back edge and call, which
// turns "eventually allocates" into "within a loop iteration". Until then this
// is the contract, and it is why the runtime's own waits -- the futex in
// lib/threading.cor, the sleep in the scheduler -- say so through
// Runtime.BeginBlocking.

/// The heap lock, and the flag that says a collection is running. Both are
/// words of memory from the operating system rather than static fields: a
/// futex needs an address, and a static field has none the language can take.
public static class GcLock
{
    public const int Collecting = 0 * WordSize.Bytes;   // 1 while a collection is running
    public const int Held = 1 * WordSize.Bytes;         // the heap lock: 0 free, else the thread block of its holder
    public const int Collector = 2 * WordSize.Bytes;    // the thread block of whoever is collecting
    public const int Cycling = 3 * WordSize.Bytes;     // 1 from a collection's first stop to the end of its last
    public const int BarrierTail = 4 * WordSize.Bytes; // the barrier's ring: places claimed,
    public const int BarrierHead = 5 * WordSize.Bytes; //   places taken,
    public const int BarrierLost = 6 * WordSize.Bytes; //   and whether a report was dropped
    // HANDSHAKES (GcThreads): what the collector is asking every thread to
    // do, which round of asking this is, and how many have not done it yet.
    public const int Epoch = 7 * WordSize.Bytes;       // the round; a thread's Tls.Epoch says which it has done
    public const int Request = 8 * WordSize.Bytes;     // what the round asks: GcThreads.Stamp, Scan or Ack
    public const int Pending = 9 * WordSize.Bytes;     // threads that still owe this round
    // THE GREY QUEUE (Gc.PushGrey): blocks marked and not yet scanned, many
    // pushers and many takers, nothing held.
    public const int GreyTail = 10 * WordSize.Bytes;    // places claimed
    public const int GreyHead = 11 * WordSize.Bytes;    // places taken
    public const int Pushes = 12 * WordSize.Bytes;      // blocks marked with the queue full; with GreyTail, every block ever marked (Gc.Marked)
    public const int Active = 13 * WordSize.Bytes;      // threads scanning a block they took off the queue
    public const int Overflow = 14 * WordSize.Bytes;    // a push found the queue full: the rescan finds it
    public const int Abort = 15 * WordSize.Bytes;       // this cycle is being given up (a lost barrier report)
    // What the collector sleeps on while it waits for a round: moved on by
    // everything that could let the round finish -- an answer, a thread
    // blocking, a thread leaving -- so that a wake sent before the collector
    // went to sleep is never lost (the futex sleeps only while it is unmoved).
    public const int Stirs = 16 * WordSize.Bytes;

    static nuint _words;

    /// The collection round now, without making the control words: 0 while
    /// nothing has made them, since no round has been asked yet.
    public static nuint EpochIfMade()
    {
        nuint at = _words;
        return at == 0 ? 0 : Sys.ReadAddress(at + Epoch);
    }

    /// The control words when something has made them, else 0.
    public static nuint WordsIfMade()
    {
        return _words;
    }

    public static nuint Words()
    {
        if (_words == 0)
        {
            // PUBLISHED ONCE, as ClaimLocal's pool is: two processors asking
            // first each mapped words of their own, and spun on two locks
            // that excluded nothing.
            nuint fresh = Platform.Map(4096);
            if (fresh != 0 && Sys.Cas(Sys.AddressOf(ref _words), 0, fresh) != 0) Platform.Unmap(fresh, 4096);
        }
        return _words;
    }

    /// Whether somebody is collecting, at the moment of asking. Cheap, and
    /// false before anything has ever allocated.
    public static bool IsCollecting()
    {
        nuint at = _words;

        if (at == 0)
        {
            return false;
        }
        return Sys.Read32(at + Collecting) != 0;
    }

    /// Whether THIS thread holds the heap lock. On a kernel an interrupt
    /// lands on top of the holder -- the collector sweeping a chunk, an
    /// allocation refilling its buffer -- and anything it then does that
    /// might allocate would wait for a lock its own thread holds, for ever.
    /// What can be put off, asks this first.
    public static bool HeldByMe()
    {
        nuint at = _words;
        nuint me = Sys.ThreadBlock();
        if (me == 0) me = 1;
        return at != 0 && Sys.ReadAddress(at + Held) == me;
    }

    /// Whether `block` is the thread doing the collection that is running.
    /// THE COLLECTOR NEVER STOPS FOR ITSELF. On a kernel it is interrupted
    /// like anybody else, and the handler may wait for a lock -- a wait that
    /// is a blocking region, whose end parks the thread until the collection
    /// is over. Parked there, on the collector's own stack, it never is.
    public static bool IsCollector(nuint block)
    {
        nuint at = _words;
        return at != 0 && block != 0 && Sys.ReadAddress(at + Collector) == block;
    }

    public static void Enter()
    {
        nuint at = Words() + Held;

        // THE WORD THAT SAYS IT IS HELD SAYS BY WHOM, in the one exchange
        // that takes it. Two words -- held, then holder -- left an instant
        // between them in which an interrupt on top of the new holder was
        // told nobody it knew held the lock.
        nuint me = Sys.ThreadBlock();
        if (me == 0) me = 1;

        long spins = 0;
        // NOT PREEMPTED WHILE IT IS HELD (Tls.PreemptCount), raised before
        // the take and down again for each wait: a thread that wants it spins.
        Runtime.PreemptOff();
        while (Sys.Cas(at, 0, me) != 0)
        {
            Runtime.PreemptOn();
            // A thread spinning for this lock is a thread the collector is
            // waiting for; without this the two would wait for each other.
            if (IsCollecting())
            {
                GcThreads.Park();
            }
            // THE HOLDER MAY BE WAITING FOR A PROCESSOR, and on one processor
            // it is certainly waiting for this one: spinning out the rest of
            // the tick for it helps nobody. After a short spin, the processor
            // is given up (sched_yield; a ring-1 kernel's hook), and the
            // holder can run and let go.
            if (++spins % 64 == 0)
            {
                Platform.Yield();
            }
            Sys.Pause();
            Runtime.PreemptOff();
        }
        // THE ALLOCATOR WORKS FOR THE HOLDER'S HEAP until it lets go.
        Gc.LockedFor(me);
    }

    public static void Exit()
    {
        Sys.AtomicSwap(Words() + Held, 0);
        Runtime.PreemptOn();
    }
}

/// Every thread the collector must know about: where its stack is, and
/// whether it is running.
///
/// The table is memory of the operating system's and not an array, for the
/// same reason GcRoots' extra roots are: registering a thread must not
/// allocate, and a heap block here would be one the collector had to keep
/// alive forever. A program with one thread never makes the table at all.
public static class GcThreads
{
    const int Max = 256;

    static nuint _blocks;       // _capacity words: the registered threads' blocks
    static nuint _capacity;      // Max at first, doubled as threads come
    static nuint _count;
    static nuint _first;         // the one thread, before there is a table

    public static nuint Count()
    {
        return _count;
    }

    /// Whether any thread but this one is registered: whether there is
    /// anybody for a collection to let run.
    public static bool Others()
    {
        return _blocks != 0 && _count > 1;
    }

    /// What every other registered thread's current buffer has handed out:
    /// a precise total of allocation without a collection
    /// (GC.GetTotalAllocatedBytes(true)). The heap lock is held, as
    /// Gc.InBuffer reads another thread's.
    internal static long OthersInBuffersLocked()
    {
        nuint self = Sys.ThreadBlock();
        long total = 0;
        for (nuint i = 0; i < _count; i++)
        {
            nuint block = At(i);
            if (block != self) total = total + Gc.InBufferOf(block);
        }
        return total;
    }

    static nuint At(nuint i)
    {
        return Sys.ReadAddress(_blocks + i * WordSize.Bytes);
    }

    /// Registered thread `i`'s block (Gc.ShedPages), 0 past the table. The
    /// heap lock is held.
    /// Whether any thread's buffer lies in [from, to). The heap lock is held.
    public static bool BufferWithin(nuint from, nuint to)
    {
        nuint n = _blocks == 0 ? (_first != 0 ? 1u : 0u) : _count;
        for (nuint i = 0; i < n; i++)
        {
            nuint block = _blocks == 0 ? _first : At(i);
            nuint start = Sys.ReadAddress(block + Tls.AllocBase);
            if (start != 0 && start >= from && start < to) return true;
        }
        return false;
    }

    /// Whether any thread allocates in `heap` (Tls.Heap). The heap lock is
    /// held.
    public static bool AnyInHeap(nuint heap)
    {
        if (_blocks == 0)
        {
            return _first != 0 && Sys.ReadAddress(_first + Tls.Heap) == heap;
        }
        for (nuint i = 0; i < _count; i++)
        {
            nuint block = At(i);
            if (block != 0 && Sys.ReadAddress(block + Tls.Heap) == heap) return true;
        }
        return false;
    }

    public static nuint BlockAt(nuint i)
    {
        if (_blocks == 0) return i == 0 ? _first : 0;
        return i < _count ? At(i) : 0;
    }

    /// Adds a thread. The first one is only written down, because a program
    /// with one thread needs no table and must not ask for memory it will
    /// never read (a bare-metal program has no heap at all until it says so).
    ///
    /// A thread added while a collection is asking its rounds owes none of
    /// them: its stack began after every snapshot the collection took, and
    /// what it was handed came from a thread that does owe them.
    public static void Register(nuint block)
    {
        if (block == 0)
        {
            return;
        }

        // The FIRST thread is only written down, and takes no lock: a program
        // with one thread must not be made to ask for memory it will never
        // read, and on bare metal there is no memory to ask for until the
        // program has said where the heap is -- which is why its epoch is
        // read without making the control words (a boot loader's entry
        // registers its thread before Main can call Platform.SetHeap).
        if (_blocks == 0 && _first == 0)
        {
            Sys.WriteAddress(block + Tls.Epoch, GcLock.EpochIfMade());
            _first = block;
            return;
        }

        GcLock.Enter();

        // Tested again with the lock held: two threads starting a third and a
        // fourth at once would otherwise both make the table.
        if (_blocks == 0)
        {
            _blocks = Platform.Map(Max * WordSize.Bytes);
            _capacity = _blocks != 0 ? (nuint)Max : 0;
            Add(_first);
            _first = 0;
        }

        // FROM ONE THREAD TO TWO: what the one gave its bins from inside its
        // buffer is taken back and kept in place (Gc.Free).
        if (_count == 1)
        {
            Gc.KeepBufferInPlace(At(0));
        }
        Sys.WriteAddress(block + Tls.Epoch, Sys.ReadAddress(GcLock.Words() + GcLock.Epoch));
        Add(block);
        GcLock.Exit();
    }

    /// The thread whose live allocation buffer holds `at`, or 0. The heap
    /// lock is held, so no buffer is taken or retired meanwhile. The calling
    /// thread's own is looked at first: it holds what that thread frees.
    public static nuint BufferHolding(nuint at)
    {
        nuint self = Sys.ThreadBlock();

        if (Holds(self, at))
        {
            return self;
        }
        if (_blocks == 0)
        {
            return _first != self && Holds(_first, at) ? _first : 0;
        }
        for (nuint i = 0; i < _count; i++)
        {
            nuint t = At(i);

            if (t != self && Holds(t, at))
            {
                return t;
            }
        }
        return 0;
    }

    static bool Holds(nuint thread, nuint at)
    {
        if (thread == 0)
        {
            return false;
        }
        nuint start = Sys.ReadAddress(thread + Tls.AllocBase);
        nuint limit = Sys.ReadAddress(thread + Tls.AllocLimit);

        // A thread asked to answer a handshake has its limit kept aside.
        if (limit == 0)
        {
            limit = Sys.ReadAddress(thread + Tls.AllocSaved);
        }
        return start != 0 && at >= start && at < limit;
    }

    /// Called with the lock held.
    static void Add(nuint block)
    {
        // A THREAD PAST THE TABLE'S END WAS NOT WRITTEN DOWN, and nothing
        // said so: its stack was never scanned, and what only it held was
        // swept while it still ran and handed out again. An NT kernel past
        // its 256th thread broke three tables at once as a process started.
        // The table doubles instead, under the heap lock as every reader of
        // it is; the old one stays mapped for a reader that read its address.
        if (_blocks != 0 && _count == _capacity && block != 0)
        {
            nuint bigger = Platform.Map(_capacity * 2 * WordSize.Bytes);
            if (bigger == 0)
            {
                Runtime.WriteLiteral(2, "gc: no memory for the thread table; a thread would go unscanned\n");
                Platform.Exit(97);
            }
            for (nuint i = 0; i < _count; i++) Sys.WriteAddress(bigger + i * WordSize.Bytes, At(i));
            Sys.Fence();
            _blocks = bigger;
            _capacity = _capacity * 2;
        }
        if (_blocks != 0 && _count < _capacity && block != 0)
        {
            Sys.WriteAddress(_blocks + _count * WordSize.Bytes, block);
            _count = _count + 1;
        }
    }

    /// Takes a thread out: its stack is about to stop being a stack. A round
    /// it still owes is answered here -- its buffer's objects are written down
    /// as it is retired, and its stack no longer matters -- so the collector
    /// does not wait for a thread that is gone. A thread being answered for
    /// by the collector at this moment (Busy) is waited out first.
    public static void Deregister(nuint block)
    {
        if (_blocks == 0)
        {
            if (_first == block)
            {
                _first = 0;
            }
            return;
        }

        while (true)
        {
            nuint state = Sys.ReadAddress(block + Tls.State);

            if (state != Busy && (Sys.Cas(block + Tls.State, state, Gone)) == state)
            {
                break;
            }

            Sys.Pause();
        }

        GcLock.Enter();
        Gc.Retire(block);
        Gc.ForgetClasses(block);
        Settle(block);

        nuint i = 0;

        while (i < _count)
        {
            if (At(i) == block)
            {
                Sys.WriteAddress(_blocks + i * WordSize.Bytes, At(_count - 1));
                _count = _count - 1;
                i = _count;
            }
            else
            {
                i = i + 1;
            }
        }

        GcLock.Exit();
    }

    // ---- handshakes ----------------------------------------------------------
    //
    // THE COLLECTOR NEVER STOPS A THREAD. It asks, in rounds: it names what
    // the round wants (GcLock.Request), counts the threads that owe it
    // (Pending), and moves the round number on (Epoch). A running thread
    // answers at its next safepoint -- its next slow allocation, the end of a
    // wait, a spin on the heap lock, or on a kernel an interrupt the collector
    // sends for the purpose -- does the round's work on its own buffer or its
    // own stack, and carries on. A thread that is blocked cannot answer, so
    // the collector answers for it: it takes the thread's state from Stopped
    // to Busy, does the work on the stack the thread published, and gives the
    // state back; a thread whose wait ends meanwhile waits for Busy to pass
    // before it runs (EndBlocking).
    //
    // To be answered soon, a running thread's buffer limit is taken away as
    // the round is asked, so its very next allocation comes to the slow path.

    /// What a round asks.
    public const int Stamp = 1;    // write down where your buffer's objects start
    public const int Scan = 2;     // mark from your stack
    public const int Ack = 3;      // pass a safepoint: be out of any barrier

    /// Thread states (Tls.State).
    public const int Running = 0;
    public const int Stopped = 1;
    public const int Busy = 2;     // stopped, and the collector is answering for it
    public const int Gone = 3;     // deregistering

    public static long Answered, AnsweredFor;

    /// WHETHER A ROUND IS OPEN, for the polls a loop's back edge makes
    /// (BackEdgePolls): non-zero from before the round's epoch is published
    /// until every thread has answered it. A loop that allocates nothing and
    /// never blocks reads only this word a lap, and calls Runtime.Poll when it
    /// is set.
    public static nuint Asking;

    /// Prompts sent while waiting for a round (Platform.PromptStop), over
    /// all rounds.
    public static long Prompts;

    /// The turns of the round's wait between two prompts: the first gap,
    /// and the most it doubles to while prompts move nobody.
    const int PromptGapLeast = 16;
    const int PromptGapMost = 1024;

    /// Asks every other thread for `request` and returns when all have
    /// answered. Called by the collector without the heap lock, or holding
    /// it (the overload below). While it waits it answers for the blocked,
    /// marks what is queued, prompts the ones that have not answered, and
    /// waits a turn.
    public static void Round(nuint request) => Round(request, false);

    /// The same with the heap lock already held (`held`), let go once the
    /// round is asked.
    public static void Round(nuint request, bool held)
    {
        nuint ctl = GcLock.Words();
        nuint self = Sys.ThreadBlock();

        if (!held) GcLock.Enter();
        nuint epoch = (Sys.ReadAddress(ctl + GcLock.Epoch) + 1) & 0x7FFFFFFF;
        nuint owed = 0;
        nuint i = 0;

        while (i < _count)
        {
            nuint block = At(i);

            if (block != self && Sys.ReadAddress(block + Tls.State) == Gone)
            {
                // Leaving, and waiting for this lock to do it: not counted, so
                // marked square with the round, or its Settle on the way out
                // would take a count some other thread still owes.
                //
                // ITS BUFFER IS STAMPED HERE, for it. It bumps nothing more,
                // and it cannot retire the buffer until this lock is let go
                // -- perhaps after stamping has closed, when Retire no longer
                // writes the objects in. Unstamped they would be newcomers:
                // kept, never traced, and what only they refer to swept.
                if (request == Stamp)
                {
                    Gc.StampBuffer(block);
                }
                Sys.WriteAddress(block + Tls.Epoch, epoch);
            }
            else if (block != self)
            {
                owed = owed + 1;

                // The buffer's limit taken away: the next allocation on that
                // thread comes to the slow path, which answers.
                nuint limit = Sys.ReadAddress(block + Tls.AllocLimit);
                if (limit != 0)
                {
                    Sys.WriteAddress(block + Tls.AllocSaved, limit);
                    Sys.AtomicSwap(block + Tls.AllocLimit, 0);
                }
                // And its class cache: small allocations answer as well.
                // BY COMPARE-AND-SWAP, written aside first: the thread itself
                // may be taking the word at this moment to shelve it as it
                // changes heaps (Gc.SwitchHeap), and the one that swaps it
                // out has it. Lost to the thread, nothing is kept aside, and
                // the thread answers at its next safepoint.
                nuint classes = Sys.ReadAddress(block + Tls.Classes);
                if (classes != 0)
                {
                    Sys.WriteAddress(block + Tls.ClassesSaved, classes);
                    if ((Sys.Cas(block + Tls.Classes, classes, 0)) != classes)
                    {
                        Sys.WriteAddress(block + Tls.ClassesSaved, 0);
                    }
                }
            }
            i = i + 1;
        }

        Sys.AtomicSwap(ctl + GcLock.Request, request);
        Sys.AtomicSwap32(ctl + GcLock.Pending, (int)owed);
        // The polls' way in (Runtime.Poll), and the word they read.
        Runtime.PollHook = Sys.AddressOf(GcThreads.PollAnswer);
        Asking = 1;
        // Last: a thread that sees the new round sees what it asks and how
        // many owe it.
        Sys.AtomicSwap(ctl + GcLock.Epoch, epoch);
        Sys.WriteAddress(self + Tls.Epoch, epoch);
        GcLock.Exit();
        Gc.HandshakeRounds = Gc.HandshakeRounds + 1;

        // RE-PROMPT PACING. A prompt interrupts every processor that still
        // owes the round; one found inside a store sequence puts its answer
        // off to the next prompt (the kernel counts those). Prompting again
        // every few turns would keep those processors in their interrupt
        // handlers and the collector hot on interrupts, so while a prompt
        // moves nobody the gap to the next doubles, up to PromptGapMost
        // turns, and falls back to the first gap as soon as anyone answers.
        // Nothing here gives up: a round waits until everybody has answered,
        // and a put-off answer is only a later one.
        long turns = 0;
        long gap = PromptGapLeast;
        long nextPrompt = 0;
        long owedAtPrompt = Pending();

        while (true)
        {
            // Read BEFORE looking for blocked threads: one that blocks after
            // the look moves it, and the sleep below does not happen.
            nuint stirs = Sys.Read32(ctl + GcLock.Stirs);

            if (Pending() <= 0)
            {
                Asking = 0;
                return;
            }

            AnswerForStopped(epoch, request);

            if (Pending() <= 0)
            {
                Asking = 0;
                return;
            }

            if (request != Stamp)
            {
                Gc.Assist(64);
            }

            if (turns >= nextPrompt)
            {
                long owedNow = Pending();
                if (owedNow < owedAtPrompt)
                {
                    gap = PromptGapLeast;
                }
                else if (turns != 0 && gap < PromptGapMost)
                {
                    gap = gap * 2;
                }
                owedAtPrompt = owedNow;
                nextPrompt = turns + gap;
                Prompts = Prompts + 1;
                Platform.PromptStop();
            }

            turns = turns + 1;
            Platform.Wait(ctl + GcLock.Stirs, (int)Sys.Low32(stirs));
            Sys.Pause();
        }
    }

    /// The round, done for every thread that owes it and is blocked. The
    /// heap lock is held for each thread's look and work -- the table a
    /// thread starting or ending may be changing, and the pages a foreign
    /// free writes while a stamp walks them -- and let go BETWEEN threads,
    /// the platform asked there (YieldHook). Held for the whole walk, a
    /// kernel with many threads parked in it stamped and copied every one in
    /// one go: 44 ms of a K6-III's one processor, an audio mixer waiting it
    /// out. Each look starts again from the first thread: a thread ending
    /// meanwhile moves the last one into its place, and a walk that went on
    /// from where it was could pass a thread that owes the round by. One
    /// answered is passed by its epoch.
    static void AnswerForStopped(nuint epoch, nuint request)
    {
        nuint ctl = GcLock.Words();
        nuint self = Sys.ThreadBlock();

        while (true)
        {
            GcLock.Enter();
            nuint block = 0;
            nuint i = 0;
            while (i < _count)
            {
                nuint at = At(i);
                if (at != self && Sys.ReadAddress(at + Tls.Epoch) != epoch
                    && (Sys.Cas(at + Tls.State, Stopped, Busy)) == Stopped)
                {
                    if (Sys.ReadAddress(at + Tls.Epoch) != epoch)
                    {
                        block = at;
                        break;
                    }
                    // Answered between the two looks: given back as it was.
                    Sys.AtomicSwap(at + Tls.State, Stopped);
                    Platform.Wake(at + Tls.State, 1);
                }
                i = i + 1;
            }
            if (block == 0)
            {
                GcLock.Exit();
                return;
            }

            // Blocked: its stack from where it stopped, and the registers it
            // stopped with (Tls.Spill).
            if (request == Scan)
            {
                Gc.ScanRoots(block + Tls.Spill, block + Tls.Spill + Sys.ReadAddress(block + Tls.SpillCount) * WordSize.Bytes);
            }
            // HELD BUSY ONLY UNDER THE HEAP LOCK (Work): let go with the
            // thread still claimed, a one-processor kernel preempted the
            // collector there, and the thread, leaving its blocking, spun on
            // Busy for ever (EndBlocking). Given back between steps instead:
            // a thread that leaves meanwhile answers for itself, and one
            // moved to another stack is begun again on the next look.
            if (!Work(block, request, Sys.ReadAddress(block + Tls.StackLimit), true, epoch))
            {
                GcLock.Exit();
                if (Gc.YieldHook != 0) Sys.Call(Gc.YieldHook, 0, 0, 0);
                continue;
            }
            if (Claim(block, epoch))
            {
                Sys.AtomicAdd32(ctl + GcLock.Pending, -1);
                AnsweredFor = AnsweredFor + 1;
            }

            Sys.AtomicSwap(block + Tls.State, Stopped);
            Platform.Wake(block + Tls.State, 1);
            GcLock.Exit();
            if (Gc.YieldHook != 0) Sys.Call(Gc.YieldHook, 0, 0, 0);
        }
    }

    /// What a round asks, done on `block`'s behalf with its stack from `from`.
    /// False when a blocked thread (`locked`, held Busy) could not be held
    /// through its page steps: not claimed again, answered, or moved to
    /// another stack meanwhile. It is not held Busy then, and whatever is
    /// left is for its own answer or the next look (AnswerForStopped).
    static bool Work(nuint block, nuint request, nuint from, bool locked, nuint epoch)
    {
        if (request == Stamp && !locked)
        {
            // A thread answering for itself holds no lock: it may be
            // preempted anywhere in this, as anywhere else.
            Gc.StampBuffer(block);
            CopyStack(block, from);
        }
        else if (request == Stamp)
        {
            // FOR A BLOCKED THREAD, UNDER THE HEAP LOCK: the pages in steps,
            // the lock let go and the platform asked between two. A thread
            // with a shelf of module heaps holds hundreds of pages, and
            // stamped whole under the lock they kept a one-processor kernel's
            // mixer from running.
            //
            // THE THREAD GIVEN BACK BETWEEN STEPS (Stopped), and claimed
            // again (Busy) with the lock. Busy is a word spun on: the thread
            // leaving its blocking waits it out (EndBlocking), and a kernel's
            // wait for it gives the processor to nobody. Held across the
            // lock let go, the collector was preempted holding it, and the
            // thread -- a one-processor kernel's audio mixer -- spun on it
            // for ever. Claimed again, still owing the round, and on the
            // stack it was on, the thread has not run in between: leaving
            // its blocking it answers at once (EndBlocking), so its pages
            // and its stack are as they were, and the steps go on. Not
            // claimed again (Busy in a MoveStack, Running in its answer,
            // Gone), or answered, it is left to itself: its answer, or the
            // MoveStack's end, stirs the collector to look again. A pair
            // stored back unchanged (the same trap's stack again) is
            // harmless: the read is the same one. Moved to another
            // stack meanwhile (MoveStack: a trap from a program, the thread
            // still counted stopped), `from` is the old stack's: given back,
            // and the next look (AnswerForStopped) begins it again from the
            // new one -- or CopyStack read from one stack to the other's
            // top, across whatever lies between.
            nuint limitAt = Sys.ReadAddress(block + Tls.StackLimit);
            nuint baseAt = Sys.ReadAddress(block + Tls.StackBase);
            Gc.BeginSelfStamp();
            long pages = Gc.StopBudget / 2048 > 0 ? Gc.StopBudget / 2048 : 1;
            while (!Gc.StampPagesSome(block, pages))
            {
                Sys.AtomicSwap(block + Tls.State, Stopped);
                Platform.Wake(block + Tls.State, 1);
                GcLock.Exit();
                if (Gc.YieldHook != 0) Sys.Call(Gc.YieldHook, 0, 0, 0);
                GcLock.Enter();
                if ((Sys.Cas(block + Tls.State, Stopped, Busy)) != Stopped)
                {
                    return false;
                }
                if (Sys.ReadAddress(block + Tls.Epoch) == epoch
                    || Sys.ReadAddress(block + Tls.StackLimit) != limitAt || Sys.ReadAddress(block + Tls.StackBase) != baseAt)
                {
                    Sys.AtomicSwap(block + Tls.State, Stopped);
                    Platform.Wake(block + Tls.State, 1);
                    return false;
                }
            }
            Gc.StampOwnBuffer(block);
            CopyStack(block, from);
        }
        else if (request == Scan)
        {
            Gc.ScanStack(block, from);
            // THE BLOCK'S OWN REFERENCES, wherever the block is: a kernel's
            // is not on the thread's stack, as a hosted thread's is.
            Gc.ScanRoots(block + Tls.ThreadStatics, block + Tls.ThreadStatics + WordSize.Bytes);
            Gc.ScanRoots(block + Tls.AsyncContext, block + Tls.AsyncContext + WordSize.Bytes);
            Gc.ScanRoots(block + Tls.Owner, block + Tls.Owner + WordSize.Bytes);
        }
        return true;
    }

    /// The blocks that owe the open round, into `blocks` with each one's
    /// state into `states`: how many there are, however many fit. Nothing is
    /// allocated -- a kernel asks this from inside a round that has gone on
    /// too long, to say which thread it waits for.
    /// Every registered block with its state and the round it last
    /// answered, into the three arrays: how many there are, however many
    /// fit. Allocation-free, without the heap lock -- for a kernel's report
    /// of a round that does not end, which must not wait on anything.
    public static int Census(nuint[] blocks, nuint[] states, nuint[] epochs)
    {
        int n = 0;
        nuint count = _count;
        for (nuint i = 0; i < count && n < blocks.Length; i++)
        {
            nuint block = At(i);
            blocks[n] = block;
            states[n] = Sys.ReadAddress(block + Tls.State);
            epochs[n] = Sys.ReadAddress(block + Tls.Epoch);
            n = n + 1;
        }
        return n;
    }

    public static int Owing(nuint[] blocks, nuint[] states)
    {
        nuint at = GcLock.Words();
        nuint epoch = Sys.ReadAddress(at + GcLock.Epoch);
        if (Pending() <= 0) return 0;
        int n = 0;
        GcLock.Enter();
        for (nuint i = 0; i < _count; i++)
        {
            nuint block = At(i);
            if (GcLock.IsCollector(block) || Sys.ReadAddress(block + Tls.Epoch) == epoch) continue;
            if (n < blocks.Length) { blocks[n] = block; states[n] = Sys.ReadAddress(block + Tls.State); }
            n = n + 1;
        }
        GcLock.Exit();
        return n;
    }

    // THE STACKS AS THEY WERE AT STAMP. A thread's stack is read for marking
    // when it answers SCAN, which is later; in between it runs, and a
    // reference it held only on its stack can go into an object made since
    // the snapshot -- a struct's copy, a box, a cell, an array's elements,
    // all written with no barrier because the block is new -- and off the
    // stack. That object is a newcomer: kept by the sweep, never traced. So
    // what it holds was marked by nothing, and swept from under it: a tuple's
    // string copied out of a dropped tuple came back as somebody's text.
    //
    // So each thread's stack and saved registers are copied as it answers
    // STAMP -- the moment its buffer's objects are written down, which is
    // the moment its view of the heap is the snapshot's -- and the copies are
    // marked from once pointers resolve (Marking 2). Whatever a stack held
    // then is marked; whatever it picks up afterwards came out of the heap,
    // where overwriting it takes the barrier. A copy that cannot be made
    // loses the cycle, as a lost barrier report does (BarrierLost).
    // The table: a word counting the copies claimed, then one entry of two
    // words (the copy, its bytes) for each; mapped once, the count cleared at
    // every cycle. The count is in the table so that threads claim entries
    // with one atomic add on memory, as the collector's other counters are.
    const int CopyEntry = 3 * WordSize.Bytes;      // the copy, the bytes written, the bytes mapped
    const int NoCopy = 0;
    static nuint _stackCopies;
    static nuint _stackCopiesFor;    // the threads it has an entry for (Max, or the grown table's capacity)

    static nuint CopyAt(nuint i)
    {
        return _stackCopies + CopyEntry + i * CopyEntry;
    }

    /// Called by the collector as a concurrent cycle begins, the heap lock
    /// held: the table ready and empty.
    public static bool StartStackCopies()
    {
        // AN ENTRY FOR EVERY THREAD THERE IS ROOM FOR: past the 256th, a
        // thread's stack had no copy, the cycle was lost (BarrierLost) and
        // begun again, and three hundred threads collected for minutes. The
        // table follows the thread table's capacity, mapped again between
        // cycles -- the last one gave every copy back (ReleaseStackCopies).
        nuint capacity = _capacity > 0 ? _capacity : Max;
        if (_stackCopies != 0 && _stackCopiesFor < capacity)
        {
            Platform.Unmap(_stackCopies, (_stackCopiesFor + 1) * CopyEntry);
            _stackCopies = 0;
        }
        if (_stackCopies == 0)
        {
            _stackCopies = Platform.Map((capacity + 1) * CopyEntry);
            if (_stackCopies == 0)
            {
                return false;
            }
            _stackCopiesFor = capacity;
        }
        Sys.AtomicSwap(_stackCopies, NoCopy);
        return true;
    }

    static void CopyStack(nuint block, nuint from)
    {
        nuint ctl = GcLock.Words();
        const int w = WordSize.Bytes;
        nuint to = Sys.ReadAddress(block + Tls.StackBase);
        nuint start = (from + w - 1) & ~(nuint)(w - 1);
        nuint stackWords = to > start ? (to - start) / w : NoCopy;
        nuint spilled = Sys.ReadAddress(block + Tls.SpillCount);
        if (spilled > Tls.SpillMax)
        {
            spilled = NoCopy;
        }
        nuint words = stackWords + spilled;
        // And its region arena, live as it is now (Gc.CopyRegion): what an
        // object there holds was the thread's at the snapshot as surely as
        // its stack's words were.
        nuint regionWords = Gc.RegionWords(block);
        if (words == 0 && regionWords == 0)
        {
            return;
        }
        if (_stackCopies == 0)
        {
            Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 1);
            return;
        }
        nuint slot = Sys.AtomicAdd(_stackCopies, 1u);
        // Room for a live register's value in every frame beside the stack's
        // own words (Gc.ScanOwnStack): twice them, mapped, and touched only
        // as far as written; the arena's words after them.
        nuint mapped = (2 * words + 16 + regionWords) * w;
        nuint copy = slot < _stackCopiesFor ? Platform.Map(mapped) : NoCopy;
        if (copy == 0)
        {
            Sys.AtomicSwap32(ctl + GcLock.BarrierLost, 1);
            return;
        }
        nuint kept = 0;
        if (block == Sys.ThreadBlock() && Gc.PreciseRegisters())
        {
            // Its own stack, answering STAMP itself: its live registers, not
            // their stale copies (Gc.ScanOwnStack). Never more words than
            // the stack has.
            kept = Gc.ScanOwnStack(start, to, copy);
        }
        else
        {
            nuint i = 0;
            while (i < stackWords)
            {
                Sys.WriteAddress(copy + i * w, Sys.ReadAddress(start + i * w));
                i = i + 1;
            }
            nuint j = 0;
            while (j < spilled)
            {
                Sys.WriteAddress(copy + (stackWords + j) * w, Sys.ReadAddress(block + Tls.Spill + j * w));
                j = j + 1;
            }
            kept = words;
        }
        kept = kept + Gc.CopyRegion(block, copy + kept * w);
        Sys.WriteAddress(CopyAt(slot) + w, kept * w);
        Sys.WriteAddress(CopyAt(slot) + 2 * w, mapped);
        Sys.AtomicSwap(CopyAt(slot), copy);
    }

    /// Every copy marked from and given back: the collector, Marking 2, every
    /// thread having answered STAMP.
    public static void ScanStackCopies()
    {
        if (_stackCopies == 0)
        {
            return;
        }
        nuint count = Sys.ReadAddress(_stackCopies);
        if (count > _stackCopiesFor) count = _stackCopiesFor;
        for (nuint i = 0; i < count; i++)
        {
            nuint copy = Sys.ReadAddress(CopyAt(i));
            if (copy != 0)
            {
                Gc.ScanRootsAttributed(copy, copy + Sys.ReadAddress(CopyAt(i) + WordSize.Bytes), 5, false);
            }
        }
        ReleaseStackCopies();
    }

    /// Every copy given back, read or not: after the scan, or for a cycle
    /// given up.
    public static void ReleaseStackCopies()
    {
        if (_stackCopies == 0)
        {
            return;
        }
        nuint count = Sys.ReadAddress(_stackCopies);
        if (count > _stackCopiesFor) count = _stackCopiesFor;
        for (nuint i = 0; i < count; i++)
        {
            nuint copy = Sys.ReadAddress(CopyAt(i));
            if (copy != 0)
            {
                Platform.Unmap(copy, Sys.ReadAddress(CopyAt(i) + 2 * WordSize.Bytes));
                Sys.WriteAddress(CopyAt(i), NoCopy);
            }
        }
        Sys.AtomicSwap(_stackCopies, NoCopy);
    }

    /// Whether `block` owes the round that is open. NO CONTROL WORDS, NO
    /// ROUND: before anything has made them no collection has asked
    /// anything, and making them here -- for a blocking call before the
    /// first allocation, which ends asking this -- would want memory a
    /// bare-metal image may not have been given yet ("no heap").
    public static bool Owes(nuint block)
    {
        nuint at = GcLock.WordsIfMade();

        return at != 0 && block != 0 && Pending() > 0
            && Sys.ReadAddress(block + Tls.Epoch) != Sys.ReadAddress(at + GcLock.Epoch)
            && !GcLock.IsCollector(block);
    }

    /// This thread's answer to the open round, if it owes one, with its stack
    /// from `stack` up -- every register already below `stack` (a safepoint's
    /// spill, or a kernel's trap frame).
    public static void Answer(nuint stack)
    {
        nuint block = Sys.ThreadBlock();

        // Not from inside the allocator (InAlloc), and not while holding the
        // heap lock: an interrupt that lands in the middle of a buffer being
        // replaced finds its base new and its pointer old, and would write
        // down objects that are not there. The thread answers at its next
        // safepoint instead; the collector asks again.
        // NOR FROM A THREAD NOT RUNNING: one gone from the table on its way
        // out (Runtime.EndThread) still runs a few loops -- its foreground
        // count's lock -- whose back edges poll (BackEdgePolls), and an
        // answer for it would scan a stack the collector no longer counts.
        if (!Owes(block) || Sys.ReadAddress(block + Tls.InAlloc) != 0 || GcLock.HeldByMe()
            || Sys.ReadAddress(block + Tls.State) != Running)
        {
            return;
        }

        nuint ctl = GcLock.Words();
        nuint epoch = Sys.ReadAddress(ctl + GcLock.Epoch);
        nuint request = Sys.ReadAddress(ctl + GcLock.Request);

        Work(block, request, stack, false, 0);
        Settle(block);
        Answered = Answered + 1;
        Sys.WriteAddress(block + Tls.HandshakeArmed, 0);
    }

    /// `block` is square with the open round, and the collector is told.
    static void Settle(nuint block)
    {
        nuint ctl = GcLock.Words();
        nuint epoch = Sys.ReadAddress(ctl + GcLock.Epoch);

        if (Pending() <= 0 || GcLock.IsCollector(block) || !Claim(block, epoch))
        {
            return;
        }

        Sys.AtomicAdd32(ctl + GcLock.Pending, -1);
        Stir();
    }

    /// The round's answer for `block` taken, once: its epoch moved to the
    /// round's by compare-and-swap, true only for the one that moved it.
    ///
    /// A CHECK AND THEN A STORE COUNTED ONE THREAD TWICE. A kernel sends a
    /// thread that owes a round to answer it from wherever the thread is
    /// (the handshake), and it can land inside this very answer, between
    /// the check and the store: the handshake answered, then the answer it
    /// interrupted answered again. Pending went to -1, no thread owed
    /// anything, and the collector waited for ever -- the NT kernel's stall
    /// at boot, csrss never serving its port.
    static bool Claim(nuint block, nuint epoch)
    {
        while (true)
        {
            nuint old = Sys.ReadAddress(block + Tls.Epoch);

            if (old == epoch)
            {
                return false;
            }

            if (Sys.Cas(block + Tls.Epoch, old, epoch) == old)
            {
                return true;
            }
        }
    }

    /// Pending, as the signed word it is: a count gone below zero is a
    /// count that is done, not four thousand million threads to wait for.
    static long Pending()
    {
        return (int)Sys.Read32(GcLock.Words() + GcLock.Pending);
    }

    /// The collector, if it is asleep waiting for a round, woken to look.
    static void Stir()
    {
        nuint ctl = GcLock.Words();
        Sys.AtomicAdd32(ctl + GcLock.Stirs, 1);
        Platform.Wake(ctl + GcLock.Stirs, 1);
    }

    /// A safepoint: the open round answered, if this thread owes one. Never
    /// a wait.
    public static void Park()
    {
        Platform.SafePoint(Running);
    }

    /// Park, as a hook is called (Runtime.PollHook): what a loop's poll
    /// answers a round with.
    public static nuint PollAnswer(nuint a, nuint b, nuint c)
    {
        Park();
        return 0;
    }

    /// This thread is about to wait on something that only another thread can
    /// answer: it counts as stopped, and its stack is read where it stands,
    /// until EndBlocking. The collector, waiting for it to answer a round,
    /// is told, so that it answers for it.
    ///
    /// ITS CALLER'S REGISTERS, AS THE CALLER LEFT THEM (Sys.CallerRegister):
    /// the caller's is the frame that stays while the thread waits, and the
    /// registers it holds then are the ones the collector must read. Copied
    /// from inside a frame below it -- Platform.SafePoint's, as it was --
    /// they were that frame's own, and a caller's reference its prologue had
    /// pushed went with it the moment the wait wrote over it. Never put in
    /// place in a caller: what it reads is its caller's. Runtime.BeginBlocking
    /// and Runtime.EnterNative do the same for theirs.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void BeginBlocking()
    {
#if TARGET_64BIT
        BeginBlockingWith(Sys.CallerRegister(0), Sys.CallerRegister(1), Sys.CallerRegister(2), Sys.CallerRegister(3), Sys.CallerRegister(4));
#else
        BeginBlockingWith(Sys.CallerRegister(0), Sys.CallerRegister(1), Sys.CallerRegister(2), 0, 0);
#endif
    }

    /// THE WAIT SAID, with the callee-saved registers of the frame that waits
    /// (EBX, ESI and EDI on i386, the rest 0; RBX and R12 to R15 in long
    /// mode), handed over by the function that frame called: written into the
    /// thread block (Tls.Spill) only if the thread counts as stopped, as
    /// arguments in a frame of its own until then -- an interrupt a kernel
    /// takes on the thread meanwhile, waiting itself, writes its own and
    /// leaves these. What a program without a collector drops
    /// (Escape.ThreadBlockingWith).
    public static void BeginBlockingWith(nuint a, nuint b, nuint c, nuint d, nuint e)
    {
        nuint self = Sys.ThreadBlock();

        if (!Stops(self))
        {
            return;
        }

        Sys.WriteAddress(self + Tls.Spill, a);
        Sys.WriteAddress(self + Tls.Spill + WordSize.Bytes, b);
        Sys.WriteAddress(self + Tls.Spill + 2 * WordSize.Bytes, c);
#if TARGET_64BIT
        Sys.WriteAddress(self + Tls.Spill + 3 * WordSize.Bytes, d);
        Sys.WriteAddress(self + Tls.Spill + 4 * WordSize.Bytes, e);
        Sys.WriteAddress(self + Tls.SpillCount, 5);
#else
        Sys.WriteAddress(self + Tls.SpillCount, 3);
#endif
        SafePoint(Stopped);
    }

    /// Whether a thread about to wait counts as stopped meanwhile: not the
    /// collector, not inside the allocator or the barrier, not holding the
    /// heap lock (EndBlocking's reasons).
    public static bool Stops(nuint self)
    {
        return !GcLock.IsCollector(self) && Sys.ReadAddress(self + Tls.InAlloc) == 0 && !GcLock.HeldByMe();
    }



    // NOT FROM INSIDE THE ALLOCATOR OR THE BARRIER (Tls.InAlloc), NOR WITH
    // THE HEAP LOCK HELD. On a kernel an interrupt lands anywhere, its
    // handler may wait for a lock, and a wait is a blocking region -- on the
    // thread block of whatever it interrupted. If that was the few
    // instructions between an allocation's limit check and its bump, a
    // barrier's claim and its store, or a buffer half replaced under the heap
    // lock, counting the thread as stopped would let the collector answer for
    // it with a buffer half bumped or half replaced, or read a ring with a
    // report still missing. So there the wait is made as a running thread
    // (BeginBlocking tests the same, and the two always agree: the lock and
    // the allocator are the interrupted code's, held across the wait).
    public static void EndBlocking()
    {
        nuint block = Sys.ThreadBlock();

        if (!Stops(block))
        {
            return;
        }

        // Back to running -- unless the collector is answering for this
        // thread at this moment, reading its stack: then it waits the
        // moment out, since what it would do next is change that stack.
        while (true)
        {
            nuint state = Sys.ReadAddress(block + Tls.State);

            if (state == Running || state == Gone)
            {
                break;
            }

            if (state == Stopped && (Sys.Cas(block + Tls.State, Stopped, Running)) == Stopped)
            {
                break;
            }

            Platform.Wait(block + Tls.State, Busy);
            Sys.Pause();
        }

        if (Owes(block))
        {
            Platform.SafePoint(Running);
        }
    }

    /// A thread counted as stopped that is now standing on another stack --
    /// a kernel's trap entry, arriving from a program on the process's own
    /// kernel stack -- says so: where the collector reads it from and the
    /// top it reads up to, changed together. The block is claimed from the
    /// collector (Stopped to Busy, as the collector claims it to answer for
    /// the thread) for the two stores, so no scan ever pairs one stack's
    /// limit with another's top and reads across whatever lies between
    /// them. A running thread only moves its top.
    public static void MoveStack(nuint limit, nuint top)
    {
        nuint block = Sys.ThreadBlock();

        while (true)
        {
            nuint state = Sys.ReadAddress(block + Tls.State);

            if (state != Stopped && state != Busy)
            {
                Sys.WriteAddress(block + Tls.StackBase, top);
                return;
            }

            if (state == Stopped && (Sys.Cas(block + Tls.State, Stopped, Busy)) == Stopped)
            {
                Sys.WriteAddress(block + Tls.StackLimit, limit);
                Sys.WriteAddress(block + Tls.StackBase, top);
                Sys.AtomicSwap(block + Tls.State, Stopped);
                // THE COLLECTOR TOLD, when the thread owes the round: one
                // that found it Busy here passed it by (AnswerForStopped),
                // and with nobody else to answer for went to sleep on the
                // stirs -- which a thread stopped and owing, with nothing
                // more to come from it, never moved.
                if (Owes(block)) Stir();
                return;
            }

            Platform.Wait(block + Tls.State, Busy);
            Sys.Pause();
        }
    }

    /// What Platform.SafePoint calls first: when the thread is about to count
    /// as stopped, the frame it pushed every callee-saved register into,
    /// [from, to), copied into the thread block (Tls.Spill). Those registers
    /// are pushed at the frame's bottom, under its locals, so a frame larger
    /// than the room is copied from the bottom. The frame is gone once
    /// SafePoint returns and the wait begins; the copy is what the collector
    /// reads instead. Nothing in the runtime stops that way any more: a wait
    /// says so through BeginBlocking, which writes its caller's registers
    /// down itself (Sys.CallerRegister); Running asks nothing here.
    public static void Spill(int mode, nuint from, nuint to)
    {
        if (mode == Running)
        {
            return;
        }

        nuint block = Sys.ThreadBlock();
        nuint words = to > from ? (to - from) / WordSize.Bytes : 0;

        if (words > Tls.SpillMax)
        {
            words = Tls.SpillMax;
        }

        for (nuint i = 0; i < words; i++)
        {
            Sys.WriteAddress(block + Tls.Spill + i * WordSize.Bytes, Sys.ReadAddress(from + i * WordSize.Bytes));
        }

        Sys.WriteAddress(block + Tls.SpillCount, words);
    }

    /// What Platform.SafePoint and BeginBlocking call once every callee-saved
    /// register is on the stack -- which is the whole reason they are entered
    /// that way, and the same reasoning as GcRoots.Enter's.
    public static void SafePoint(int mode)
    {
        nuint block = Sys.ThreadBlock();

        if (mode == Running)
        {
            Answer(Sys.Stack());
            return;
        }

        // Stopping: where this thread's live stack begins. Everything above
        // it, up to the top it started from, is what the collector reads.
        Sys.WriteAddress(block + Tls.StackLimit, Sys.Stack());
        Sys.AtomicSwap(block + Tls.State, Stopped);

        if (Owes(block))
        {
            // The collector is waiting for this thread; it may be asleep
            // waiting. Now it can answer for it.
            Stir();
        }
    }

    // ---- the buffers in use, for the walks to step over ------------------------

    // A buffer and a page of every class for each thread the table has room
    // for (_capacity, which grows): a table mapped for fewer is mapped again
    // (Sized), and nothing past its end is ever written.
    static nuint SpanMax => (_capacity > 0 ? _capacity : Max) * (Gc.Classes + 1);
    static nuint _buffers;           // SpanMax pairs: base, limit; sorted by base
    static nuint _buffersFor;
    static nuint _bufferCount;

    /// Every registered thread's allocation buffer as it stands, sorted by
    /// where it begins. The heap lock is held, so none is being replaced.
    public static void CaptureBuffers()
    {
        _bufferCount = 0;
        _buffers = Sized(_buffers, ref _buffersFor);
        if (_buffers == 0)
        {
            return;
        }

        _bufferCount = CaptureBuffersInto(_buffers);
    }

    /// Every registered thread's buffer, base and limit, into `table`
    /// (room for SpanMax pairs), sorted by base; answers how many. The
    /// heap lock is held, so no buffer is replaced meanwhile -- a thread only
    /// bumps its pointer inside its own without it.
    public static nuint CaptureBuffersInto(nuint table)
    {
        nuint count = 0;
        nuint i = 0;

        while (i < _count || (i == 0 && _blocks == 0 && _first != 0))
        {
            nuint block = _blocks == 0 ? _first : At(i);
            nuint from = Sys.ReadAddress(block + Tls.AllocBase);
            nuint limit = Sys.ReadAddress(block + Tls.AllocLimit);

            if (limit == 0)
            {
                limit = Sys.ReadAddress(block + Tls.AllocSaved);
            }

            if (from != 0 && limit > from && count < SpanMax)
            {
                Sys.WriteAddress(table + count * (2 * WordSize.Bytes), from);
                Sys.WriteAddress(table + count * (2 * WordSize.Bytes) + WordSize.Bytes, limit);
                count = count + 1;
            }

            // ITS PAGES TOO: a page a thread owns is its buffer as much.
            count = Gc.CapturePages(block, table, count, SpanMax);

            if (_blocks == 0)
            {
                break;
            }
            i = i + 1;
        }
        SortPairs(table, count);
        return count;
    }

    // BY BASE, ONCE, IN PLACE: a heap sort of the (base, limit) pairs. Kept
    // in order as each was added, a buffer and a page of every class for
    // every thread was an insertion sort of thousands, twice a collection:
    // three hundred threads made every collection take minutes.
    static void SortPairs(nuint table, nuint count)
    {
        if (count < 2) return;
        for (nuint start = count / 2; start > 0; start--) SiftPair(table, start - 1, count);
        for (nuint end = count - 1; end > 0; end--)
        {
            SwapPairs(table, 0, end);
            SiftPair(table, 0, end);
        }
    }

    static void SiftPair(nuint table, nuint root, nuint count)
    {
        while (true)
        {
            nuint child = root * 2 + 1;
            if (child >= count) return;
            if (child + 1 < count && Sys.ReadAddress(table + (child + 1) * (2 * WordSize.Bytes)) > Sys.ReadAddress(table + child * (2 * WordSize.Bytes))) child = child + 1;
            if (Sys.ReadAddress(table + root * (2 * WordSize.Bytes)) >= Sys.ReadAddress(table + child * (2 * WordSize.Bytes))) return;
            SwapPairs(table, root, child);
            root = child;
        }
    }

    static void SwapPairs(nuint table, nuint a, nuint b)
    {
        nuint pa = table + a * (2 * WordSize.Bytes), pb = table + b * (2 * WordSize.Bytes);
        nuint baseA = Sys.ReadAddress(pa), limitA = Sys.ReadAddress(pa + WordSize.Bytes);
        Sys.WriteAddress(pa, Sys.ReadAddress(pb));
        Sys.WriteAddress(pa + WordSize.Bytes, Sys.ReadAddress(pb + WordSize.Bytes));
        Sys.WriteAddress(pb, baseA);
        Sys.WriteAddress(pb + WordSize.Bytes, limitA);
    }

    /// The bump pointer of the registered thread whose buffer begins at
    /// `start`, or `start` when none does. The heap lock is held.
    public static nuint BufferPointer(nuint start)
    {
        if (_blocks == 0)
        {
            return _first != 0 && Sys.ReadAddress(_first + Tls.AllocBase) == start ? Sys.ReadAddress(_first + Tls.AllocPtr) : start;
        }
        for (nuint i = 0; i < _count; i++)
        {
            nuint t = At(i);
            if (Sys.ReadAddress(t + Tls.AllocBase) == start)
            {
                return Sys.ReadAddress(t + Tls.AllocPtr);
            }
        }
        return start;
    }

    public static nuint BufferTableBytes()
    {
        return SpanMax * (2 * WordSize.Bytes);
    }

    /// `table` if it was mapped for the thread capacity there is now (`mappedFor`),
    /// else one mapped for it; 0 when there is no memory. The old one stays
    /// mapped: a capture table is scratch, and a reader may hold its address.
    public static nuint Sized(nuint table, ref nuint mappedFor)
    {
        nuint capacity = _capacity > 0 ? _capacity : Max;
        if (table != 0 && mappedFor >= capacity) return table;
        nuint made = Platform.Map(BufferTableBytes());
        if (made != 0) mappedFor = capacity;
        return made;
    }

    public static nuint BufferCount()
    {
        return _bufferCount;
    }

    /// Every registered thread's buffer unmarked (Gc.UnmarkBuffer), as the
    /// sweep that steps over them begins. The heap lock is held.
    public static void UnmarkBuffers()
    {
        if (_blocks == 0)
        {
            if (_first != 0) Gc.UnmarkBuffer(_first);
            return;
        }

        for (nuint i = 0; i < _count; i++)
        {
            Gc.UnmarkBuffer(At(i));
        }
    }

    public static nuint BufferBase(nuint i)
    {
        return Sys.ReadAddress(_buffers + i * (2 * WordSize.Bytes));
    }

    public static nuint BufferLimit(nuint i)
    {
        return Sys.ReadAddress(_buffers + i * (2 * WordSize.Bytes) + WordSize.Bytes);
    }

    /// The first captured buffer beginning at or above `address`.
    public static nuint BufferAtOrAbove(nuint address)
    {
        // HALVED, NOT WALKED: the table is sorted by base (CaptureBuffers),
        // and a sweep asks this of every chunk -- a buffer and up to
        // thirty-nine pages a thread, walked from the first each time.
        nuint low = 0;
        nuint high = _bufferCount;

        while (low < high)
        {
            nuint middle = low + (high - low) / 2;
            if (BufferBase(middle) < address) low = middle + 1;
            else high = middle;
        }

        return low;
    }
}
