// The memory library: a garbage-collected heap, so a program only ever says
// `new` and nothing about memory at all.
//
// Runtime.Alloc, AllocLeaf and AllocObject are the calls the compiler makes
// for memory (docs/X86-BACKEND.md, "Memory"), and they come here: a free-list
// heap with boundary-tag coalescing and a concurrent mark-sweep collector,
// memory from the operating system through Platform.Map in chunks, given back
// when a chunk empties.
//
// NON-MOVING, and PRECISE WHERE IT CAN BE. The stacks, the registers, the
// statics and every block the compiler cannot describe -- a struct's block,
// a cell, a coroutine's frame -- are read word by word: every word that
// lands on a live block keeps it, and nothing is ever moved, because a word
// only guessed to be a pointer cannot be updated. Being wrong that way
// retains something already dead; being wrong the other way frees something
// in use. So every uncertainty is resolved towards keeping. An OBJECT --
// a class instance, a box, a closure, an array (KindObject) -- is read by its
// descriptor's reference map, and a string or a byte array not at all.
//
// GENERATIONAL where the platform allows it (the generations section below):
// most collections are minor ones that mark, index and sweep only what was
// allocated since the last.
//
// The collector is the last of four places an object can live: static data,
// the frame, owned by one owner and freed by the compiler, and here. What the
// compiler can prove never reaches this file.
//
// THREE MODULES, the seams the memory library is built along:
//
//   HeapChunks   memory from the operating system: the chunk list, the cap,
//                which chunk an address is in. Knows nothing about blocks.
//   GcRoots      where the roots are: the stack, the registers, the statics,
//                and the ranges registered with it.
//   Gc           blocks, the free list, allocation, marking and the sweep.
//                The block layout below is Gc's alone.

// ---- what a block looks like ------------------------------------------------
//
// Sizes are multiples of eight, so the low three bits of the size word carry
// the flags. Offsets are in bytes; a word is four.
//
//   +0          size | flags                    (the header word)
//   +W          the next free block             while it is free
//   +2W         the payload, the address handed out; 8-aligned
//   +2W         the PREVIOUS free block          while it is free
//   +size-W     size | flags again               (the footer word)
// Every free block, large or small, is on its bin's list through those two
// words, which are payload again once the block is allocated. W is the
// machine word (WordSize.Bytes):
// four on i386, where every offset here is the one the collector was written
// with, and eight in long mode.
//
// The size is at BOTH ENDS on purpose, and that is what makes coalescing
// possible: the block after this one is at +size, and the one BEFORE it can
// only be found by reading backwards, through its footer. Removing a neighbour
// uses its links in its bin's list.
//
// A payload is 8-aligned because the block is and the header is two words,
// which is what a long or a double field in an object needs.

// ---- what a chunk looks like ------------------------------------------------
//
// The heap is a list of chunks from the operating system, each carrying a
// small record in its own first bytes -- so taking a chunk never itself needs
// an allocation, which matters because a chunk is taken exactly when the
// heap cannot allocate anything:
//
//   +0    next chunk, or 0
//   +W    end: one past the last block laid down (the bump pointer's floor)
//   +2W   limit: one past the chunk's memory
//   +3W   raw page-anchor table, or 0 when not allocated
//   +4W   flags: young (allocated in since the last collection)
//   +5W   the live bytes the last sweep of it found
//   +6W   the live blocks the last sweep of it found
//   +8W   the first block (8-aligned on both word sizes)
//
// The record is not a block and is never swept.

static class Gc
{
    const long HeaderBytes = 2 * WordSize.Bytes;
    const long FooterBytes = WordSize.Bytes;
    const long Overhead = 3 * WordSize.Bytes;

    const long FlagFree = 1;
    const long FlagMark = 2;
    const long FlagScan = 4;
    const long FlagMask = 7;
    const long SizeMask = -8;

    // THE HEADER'S SECOND WORD SAYS WHAT A LIVE BLOCK HOLDS. Free, it is the
    // free list's link -- a block's address, a multiple of eight, or 0 --
    // and every allocation writes it: 0 for a block that may hold
    // references, KindLeaf for one that cannot (a string, an array of
    // bytes or characters, Runtime.AllocLeaf). A leaf is marked and never
    // scanned. Scanning every word of every live block was most of a
    // collection's work: the kernel's registry, some twenty megabytes of
    // names and values, cost two million pointer lookups a collection on a
    // 233 MHz board. KindLeaf is not a multiple of eight, so no link left
    // behind by a free block can be taken for it.
    const long KindAt = WordSize.Bytes;
    const long KindLeaf = 0x4C454146;

    // AND KindObject FOR A BLOCK THAT IS AN OBJECT WITH A DESCRIPTOR: a class
    // instance, a box, a closure, an array (Runtime.AllocObject, which the
    // compiler calls exactly where it stores a vtable at the payload's first
    // word). Its references are the ones its descriptor names (ScanObject),
    // not every word it holds: the fields that are numbers, flags and
    // lengths are not looked up at all, and a number that happens to look
    // like a pointer keeps nothing alive. Everything else the compiler
    // allocates -- a struct's block, a cell, a coroutine's frame -- is still
    // scanned word by word. Not a multiple of eight, as KindLeaf is not.
    const long KindObject = 0x4F424A54;

    // THE DESCRIPTOR, as the compiler lays it (Lowering.cs, DescName...):
    // twelve words before the vtable an object's first word points at.
    const long DescWords = 12;
    const long DescSizeWord = 1;
    const long DescSelfWord = 5;
    const long DescFlagsWord = 6;
    const long DescPayloadWord = 7;
    const long DescRefMapWord = 8;
    const long DescGcFlagsWord = 9;
    const long SequenceFlag = 1;         // DescFlags: an array or a string
    const long StringFlag = 2;
    const long ElementsAreReferences = 1; // DescGcFlags, on an array
    const long ArrayCountAt = 2 * WordSize.Bytes;

    // The smallest block that can describe itself while free: header, two
    // links, footer. A remainder below this cannot be a block, so a split
    // that would leave one gives the caller the extra bytes instead.
    const long Smallest = 4 * WordSize.Bytes;

    // Collect when this much has been allocated since the last collection:
    // 256 KB to begin with, and thereafter between one and three times the
    // live size, as the machine has room (NextThreshold). The live size
    // after the last collection is the only measure of the program the
    // collector really knows; the machine's free memory says how much of
    // that measure it can afford to spend on garbage between collections.
    const long MinThreshold = 262144;
    const long MaxGrowth = 3;

    // THE ADDRESS SPACE IS A LIMIT TOO. A 32-bit process has four gigabytes
    // of it at most (three under a 32-bit kernel), and its code, its threads'
    // stacks and this collector's own tables live there beside the heap: a
    // native compiler paced by the machine's free memory alone grew its heap
    // to four gigabytes of a server with sixty free and had every mapping
    // refused. So on 32-bit the heap is paced to stay under two and a half
    // (NextThreshold), and GC.GetGCMemoryInfo says so as the process's total,
    // which is what the build's work admission reads. Long mode has no such
    // ceiling worth the name.
    //
    // HOW MUCH is asked of the kernel as the heap starts (Platform.AddressSpace,
    // SetCeiling): under a 64-bit kernel the whole four gigabytes are the
    // process's, and three and a quarter of them the heap's; under a 32-bit
    // kernel, or when nobody says, the two and a half that fit in three.
    // Zero until then, as every static of the collector must be.
    public static long HeapCeiling;
#if TARGET_64BIT
    const long NarrowCeiling = 0;
    const long WideCeiling = 0;
#else
    const long NarrowCeiling = 2684354560;
    const long WideCeiling = 3489660928;
#endif

    // The mark queue: a block of the operating system's, not a heap block,
    // taken at start at MarkBytes. A live graph wider than it finishes
    // through the rescan path below, which needs no memory at all -- and
    // walks the whole heap: at 256 KB the self-hosted compiler overflowed it
    // in 46 of its 60 collections compiling hello.cs, 46 walks of a 380 MB
    // heap. So a cycle that overflows asks for four times the queue for the
    // next one (FitMarkQueue), as far as a thirty-second of the heap: a
    // program on a small machine keeps the small queue, and one with
    // hundreds of megabytes live gets the megabytes of queue its graph needs.
    const long MarkBytes = 262144;
    const long MarkShare = 32;

    // Exact-size doubly linked lists through 256 bytes (31 bins), then eight
    // lists to each power of two, and a bitmap of the non-empty ones (the
    // free index). One list per power of two, searched first fit, was not
    // enough: native self-compilation piled 249,079 fragments into one range
    // and probed billions of times. Eighths keep a bin's blocks close in
    // size, a fit looks at no more than FitDepth of them before taking the
    // next non-empty bin's head, and the bitmap finds that bin at once.
    const long ExactLimit = 256;
    const long ExactBins = 31;      // 16..256 bytes, eight apart
    const long LargeSteps = 8;      // bins to each power of two above ExactLimit
    const long LargeTop = 31;       // the highest bit length with bins of its own
    const long Bins = ExactBins + (LargeTop - 8) * LargeSteps;
    const long BinsBytes = (Bins + (Bins + 8 * WordSize.Bytes - 1) / (8 * WordSize.Bytes)) * WordSize.Bytes; // heads, then the non-empty bitmap

    // A long zero and one, named: assigning an int literal to a long local
    // inside a nested block is mis-typed by the lowering as of this writing
    // (see Runtime.Alloc's note in runtime.cor), and a const long is not.
    const long Zero = 0;
    const long One = 1;

    static long _current;       // the chunk the bump pointer is in
    static long _bump;          // first untouched byte in the current chunk
    static long _limit;         // one past the current chunk
    static long _bins;          // Bins free-list heads, a page of the OS's, or 0
    static long _smallFree;     // blocks in the exact-size bins, 16..256 bytes

    static long _since;         // bytes allocated since the last collection
    static long _threshold;     // collect when _since reaches this
    static long _liveBytes;     // block bytes found live by the last sweep
    static long _liveBlocks;
    static long _allocated;     // bytes allocated ever: retired buffers' used parts and large blocks

    static long _markAt;        // the grey queue, or 0 (GcLock.GreyHead/GreyTail)
    static long _markCount;     // its capacity in entries, a power of two
    static long _markBytes;     // its size, a power of two
    static long _markWanted;    // the size an overflow asked the next cycle for, or 0
    static long _markPeak;

    // ---- a collection that lets the other threads run while it marks -----
    //
    // SNAPSHOT AT THE BEGINNING. The world stops twice, briefly: once to
    // write down where every object starts and read the roots, and once to
    // read the roots again, finish, and sweep. Between the two the
    // collecting thread marks and every other thread runs.
    //
    //   - The marker never reads anything a running thread may change. It
    //     finds the object a word points at through a bitmap of the object
    //     starts AS THEY WERE at the first stop, and a copy of the chunk
    //     index made then, and it writes only the flags of those objects --
    //     which no running thread touches, because nothing is freed while a
    //     mark is under way (Free) and an allocation is carved from memory
    //     that was free at the snapshot.
    //   - What a running thread overwrites, it reports first (Barrier): the
    //     compiler emits the report at every store of a reference into the
    //     heap or a static. So everything reachable at the snapshot is
    //     marked, whatever is unlinked meanwhile.
    //   - What is allocated meanwhile has no start bit, is therefore never
    //     marked, and is kept by the sweep for exactly that reason.
    //
    // A program with one thread, or a heap whose snapshot tables could not
    // be had, collects the old way: one stop for all of it.
    static long _cycle;             // which collection the snapshot tables are of
    static bool _snapshots;         // every chunk has its table for this cycle
    static bool _concurrent;        // this cycle lets the world run while marking
    static long _barrier;           // the barrier's ring, or 0
    const long BarrierCount = 16384;        // places, two words each
    const long BarrierBytes = BarrierCount * (2 * WordSize.Bytes);

    public static long ConcurrentCycles;
    public static long BarrierTaken;
    public static long BarrierOverflows;


    // Work counters, for finding out where a collection's time goes.
    public static long MarkCalls;
    // WHERE A MINOR CYCLE'S ROOT WORDS COME FROM, counted for the profile:
    // the kilobytes of old chunks' cards, of young chunks' (by block), the
    // blocks the stacks held, and the stacks and registers themselves.
    public static long OldCardWords;
    public static long YoungCardWords;
    public static long HeldWords;
    public static long StackWords;
    public static long TakenCards;
    public static long WalkSteps;
    public static long ProbeSteps;
    public static long SweepVisits;
    public static long RescanPasses;
    static bool _collecting;
    static bool _ready;

    /// How many collections have run. A test reads it to prove one happened.
    public static long Collections;

    // ---- generations ---------------------------------------------------------
    //
    // MOST OF WHAT A PROGRAM MAKES IS DEAD BY THE NEXT COLLECTION, and a
    // collection that marks the whole live heap, rebuilds every chunk's start
    // table and sweeps every chunk to find that out costs the whole heap each
    // time. So the collector is generational -- and stays non-moving, since
    // the stacks are read word by word and nothing may move -- by STICKY
    // MARKS: a block that survives a collection keeps its mark and scanned
    // flags and is OLD; one allocated since carries neither and is YOUNG.
    //
    // A MINOR collection marks only what is young and reachable. Its roots
    // are the ordinary ones, the CARDS -- a byte for every kilobyte of the
    // address space, set by the compiler after every store of a reference
    // (Runtime.Cards) -- which lead it to the old objects written since the
    // last cycle (TakeCards, ScanTakenCards), and the blocks the stacks held at the last
    // collection (Hold): an object the compiler is still initialising is
    // written without a barrier, a collection can fall between its allocation
    // and those writes, and it is on a stack when it does. A pointer into an
    // old chunk is not followed at all (its blocks are all old). Only YOUNG
    // chunks -- allocated in since the last collection (HeapChunks.IsYoung) --
    // have their start tables built and are swept; the free lists of the
    // others are left as they are.
    //
    // A MAJOR collection clears every mark as it builds the start tables and
    // then runs as a whole-heap one always has; its survivors keep their marks
    // and are old. One runs when the live heap has grown by the pacing's
    // measure since the last (NextIsMinor), first of all, when asked for
    // (GC.Collect), when memory ran out, and after anything that makes the
    // old generation's marks untrustworthy (an abandoned cycle, a record of
    // the stacks' blocks that overflowed).
    //
    // 32-bit only, and only where a mapping costs only the pages touched: the
    // card table is the address space over 1024, four megabytes reserved and
    // a page committed for every four megabytes of heap. Elsewhere every
    // collection is major, as before.
    static bool _generational;
    static bool _minor;             // the cycle under way is a minor one
    static bool _forceMajor;        // the next cycle must be major
    static long _majorLive;         // what the last major collection found live
    public static long MinorCollections;
    public static long MajorCollections;
    const long CardTableBytes = 4194304;
    const long NurseryMost = 67108864;
    // The blocks the stacks held: a count word, then (block, size) pairs.
    // Two tables, swapped at every cycle: what the last one held is read
    // (RescanHeld) while this one's is written (Hold).
    const long HeldMax = 32768;
    const long HeldEntry = 2 * WordSize.Bytes;
    const long HeldBytes = (HeldMax + 1) * HeldEntry;
    static long _held;
    static long _holding;
    // THE CARDS AS THEY WERE AT THE SNAPSHOT (TakeCards): moved here, and the
    // live table cleared, in one step under the heap lock. A store made after
    // it -- of an object made after it, above all, which this cycle keeps but
    // cannot mark -- leaves its card set for the next cycle. Read and cleared
    // in the cycle's marking (ScanTakenCards).
    static long _taken;

    static bool _verifyGenerations;
    static long _verifyReports;

    /// CORSAC_GC_VERIFY: after a minor cycle has marked, every old block is
    /// read word by word, and a word that lands on a young block this cycle
    /// did not mark -- which the sweep is about to free -- is reported: the
    /// old block, the offset in it, and what it points at. A missing barrier
    /// shows up as exactly the object and field it missed. An old object that
    /// has become garbage can hold such a word legitimately; a report is a
    /// place to look, not a verdict.
    static void VerifyMinor()
    {
        long chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 20)
        {
            long block = HeapChunks.First(chunk);
            long end = HeapChunks.End(chunk);
            while (block < end && _verifyReports < 20)
            {
                long word = Sys.Peek(block);
                long size = word & SizeMask;
                if (size < Smallest || block + size > end || Sys.Peek(block + size - FooterBytes) != word)
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == FlagMark && Sys.Peek(block + KindAt) != KindLeaf)
                {
                    long p = block + HeaderBytes;
                    while (p < block + size - FooterBytes)
                    {
                        long target = MarkerReads(block, size, p) ? BlockForPointer(Sys.Peek(p)) : 0;
                        if (target != 0)
                        {
                            long seen = Sys.Peek(target);
                            long home = HeapChunks.OfSnapshot(target + HeaderBytes);
                            if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen))
                            {
                                SayNumber("gc verify: old block ", block);
                                SayNumber("gc verify:   kind ", Sys.Peek(block + KindAt));
                                SayNumber("gc verify:   offset ", p - block);
                                SayNumber("gc verify:   points at young ", target);
                                SayNumber("gc verify:   whose kind is ", Sys.Peek(target + KindAt));
                                SayNumber("gc verify:   its chunk young ", HeapChunks.IsYoung(home) ? 1 : 0);
                                SayNumber("gc verify:   starts this cycle ", HeapChunks.StartsCycle(home) == _cycle ? 1 : 0);
                                SayNumber("gc verify:   is a start ", HeapChunks.IsStart(home, target) ? 1 : 0);
                                SayNumber("gc verify:   old block's card ", Sys.PeekByte(Runtime.Cards + ((p & WordSize.AddressMask) >> Runtime.CardShift)));
                                SayNumber("gc verify:   old block's chunk young ", HeapChunks.IsYoung(HeapChunks.Of(block)) ? 1 : 0);
                                // Which type, for nm: the vtable is the payload's first word.
                                SayNumber("gc verify:   old block's vtable ", Sys.Peek(block + HeaderBytes));
                                SayNumber("gc verify:   old block's header ", word);
                                SayNumber("gc verify:   old block held last cycle ", WasHeld(block) ? 1 : 0);
                                SayNumber("gc verify:   young block's size ", seen & SizeMask);
                                _verifyReports = _verifyReports + 1;
                            }
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    /// CORSAC_GC_VERIFY, after a MAJOR cycle has marked: every marked block
    /// is read word by word, and a word that is the start of a block the
    /// sweep is about to free is reported -- the block, its vtable (for nm),
    /// the offset, and whether the marker reads that word. Read and still
    /// unmarked is a fault in marking. Not read is a reference map that left
    /// a field out, or a number that happens to look like an address; the
    /// report says which object and which word, and nm says which type.
    static void VerifyMajor()
    {
        long chunk = HeapChunks.Newest();
        while (chunk != 0 && _verifyReports < 40)
        {
            long block = HeapChunks.First(chunk);
            long end = HeapChunks.End(chunk);
            while (block < end && _verifyReports < 40)
            {
                long word = Sys.Peek(block);
                long size = word & SizeMask;
                if (size < Smallest || block + size > end || Sys.Peek(block + size - FooterBytes) != word)
                {
                    break;
                }
                if ((word & (FlagFree | FlagMark)) == FlagMark && Sys.Peek(block + KindAt) != KindLeaf)
                {
                    long p = block + HeaderBytes;
                    while (p < block + size - FooterBytes)
                    {
                        long target = BlockForPointer(Sys.Peek(p));
                        if (target != 0 && target != block)
                        {
                            long seen = Sys.Peek(target);
                            long home = HeapChunks.OfSnapshot(target + HeaderBytes);
                            if ((seen & (FlagMark | FlagFree)) == 0 && home != 0 && !Newcomer(home, target, seen)
                                && Sys.Peek(p) == target + HeaderBytes)
                            {
                                SayNumber("gc verify major: marked block ", block);
                                SayNumber("gc verify major:   its vtable ", Sys.Peek(block + HeaderBytes));
                                SayNumber("gc verify major:   kind ", Sys.Peek(block + KindAt));
                                SayNumber("gc verify major:   offset ", p - block - HeaderBytes);
                                SayNumber("gc verify major:   marker reads it ", MarkerReads(block, size, p) ? 1 : 0);
                                SayNumber("gc verify major:   points at unmarked ", target);
                                SayNumber("gc verify major:   whose vtable ", Sys.Peek(target + HeaderBytes));
                                SayNumber("gc verify major:   whose kind ", Sys.Peek(target + KindAt));
                                _verifyReports = _verifyReports + 1;
                            }
                        }
                        p = p + WordSize.Bytes;
                    }
                }
                block = block + size;
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    /// Whether the record RescanHeld read this cycle names a block (the verifier).
    static bool WasHeld(long block)
    {
        long count = Sys.Peek(_held);
        if (count > HeldMax) count = HeldMax;
        for (long i = 0; i < count; i++)
        {
            if (Sys.Peek(_held + HeldEntry + i * HeldEntry) == block) return true;
        }
        return false;
    }

    static void StartGenerations()
    {
        _verifyGenerations = Platform.VerifyGenerations();
        if (HeapCeiling == 0 || !Platform.MapsCommitLazily)
        {
            return;
        }
        long cards = Platform.Map(CardTableBytes);
        long taken = Platform.Map(CardTableBytes);
        long held = Platform.Map(HeldBytes);
        long holding = Platform.Map(HeldBytes);
        if (cards == 0 || taken == 0 || held == 0 || holding == 0)
        {
            if (cards != 0) Platform.Unmap(cards, CardTableBytes);
            if (taken != 0) Platform.Unmap(taken, CardTableBytes);
            if (held != 0) Platform.Unmap(held, HeldBytes);
            if (holding != 0) Platform.Unmap(holding, HeldBytes);
            return;
        }
        _taken = taken;
        _held = held;
        _holding = holding;
        Runtime.Cards = cards;
        _generational = true;
    }

    /// Whether the cycle about to run may be minor: there has been a major
    /// one to make the old generation, nothing has made its marks doubtful,
    /// and the live heap has not grown past what the pacing allows since.
    static bool NextIsMinor()
    {
        return _generational && !_forceMajor && _majorLive != 0 && !_minorsCostly
            && _liveBytes < _majorLive + NextThreshold(_majorLive);
    }

    // PACED BY WHAT THEY COST. A minor cycle is worth running only if it
    // costs less per byte allocated than a major one. Where most chunks
    // have had something allocated in them -- a fragmented heap, where new
    // objects fill the holes between old ones -- a minor walks nearly all of
    // the heap and reads a card for nearly every old object, and costs
    // nearly what a major does; run every 64 MB, as a nursery would be, the
    // self-hosted compiler spent three times its old collection time. So
    // the last minor and major cycles are timed (PauseClock), the nursery
    // is the whole-heap threshold scaled by what a minor costs against a
    // major, and a minor that costs as much as a major stops them until the
    // next major, which tries one again. When collections come changes;
    // what a program computes never does.
    static long _minorMicros;
    static long _majorMicros;
    // Zero-initialised, as every static of the collector must be: it runs
    // before anything that could run a static constructor.
    static bool _minorsCostly;
    const long PacedMicros = 10000;

    /// The next threshold after a cycle of the kind given, its length known.
    static long Paced(long live, bool minor, long micros)
    {
        long major = NextThreshold(live);
        if (minor)
        {
            _minorMicros = micros;
        }
        else
        {
            _majorMicros = micros;
        }
        // Below a hundredth of a second a major cycle's length is mostly the
        // clock's noise, and a small heap's pace is the nursery's either way.
        if (_minorMicros == 0 || _majorMicros < PacedMicros)
        {
            _minorsCostly = false;
            return Nursery(live);
        }
        if (minor)
        {
            _minorsCostly = _minorMicros >= _majorMicros;
        }
        else
        {
            // The major cycle that follows a stop to minors tries one again.
            _minorsCostly = false;
        }
        if (_minorsCostly)
        {
            return major;
        }
        long scaled = _minorMicros >= _majorMicros ? major : major / _majorMicros * _minorMicros + (major % _majorMicros) * _minorMicros / _majorMicros;
        long least = Nursery(live);
        if (scaled < least) scaled = least;
        return scaled < major ? scaled : major;
    }

    /// How much a program allocates between minor collections: a quarter of
    /// what the pacing would allow between whole-heap ones, within
    /// [MinThreshold, 64 MB]. A small board collects its nursery often and
    /// cheaply; a server lets it grow.
    static long Nursery(long live)
    {
        long n = NextThreshold(live) / 4;
        if (n < MinThreshold) n = MinThreshold;
        if (n > NurseryMost) n = NurseryMost;
        return n;
    }

    /// The table the last cycle recorded becomes the one to read; the other
    /// is emptied for this cycle to record into.
    static void SwapHeld()
    {
        long read = _holding;
        _holding = _held;
        _held = read;
        Sys.Poke(_holding, Zero);
    }

    /// A block a stack or a register held, recorded for the next cycle.
    /// Several threads record at once (their own stacks, in the SCAN round).
    /// A full table makes the next cycle major: every block it could not
    /// record is then found the whole-heap way.
    static void Hold(long block)
    {
        long slot = Sys.AtomicAdd(_holding, 1);
        if (slot >= HeldMax)
        {
            _forceMajor = true;
            return;
        }
        long at = _holding + HeldEntry + slot * HeldEntry;
        Sys.Poke(at, block);
        Sys.Poke(at + WordSize.Bytes, Sys.Peek(block) & SizeMask);
    }

    /// The block whose payload a word points at the start of -- in any chunk,
    /// young or old -- or 0. Checked by its size at both ends, as
    /// BlockForPointer's exact case is; an interior pointer is not recorded.
    static long ExactBlock(long at)
    {
        if ((at & 7) != 0)
        {
            return 0;
        }
        long chunk = _snapshots ? HeapChunks.OfSnapshot(at) : HeapChunks.Of(at);
        if (chunk == 0)
        {
            return 0;
        }
        long block = at - HeaderBytes;
        if (block < HeapChunks.First(chunk))
        {
            return 0;
        }
        long word = Sys.Peek(block);
        long size = word & SizeMask;
        if (size < Smallest || block + size > HeapChunks.End(chunk) || (word & FlagFree) != 0
            || Sys.Peek(block + size - FooterBytes) != word)
        {
            return 0;
        }
        return block;
    }

    /// A word of a stack or a register: recorded, when it is a block, for the
    /// next cycle, and marked.
    static void MarkRoot(long at)
    {
        if (_generational)
        {
            long block = ExactBlock(at);
            if (block != 0)
            {
                Hold(block);
            }
        }
        MarkAt(at);
    }

    /// ScanRange for a stack or a thread's saved registers (MarkRoot).
    public static void ScanRoots(long from, long to)
    {
        long p = (from + WordSize.Bytes - 1) & -WordSize.Bytes;
        StackWords = StackWords + (to - p) / WordSize.Bytes;

        while (p < to)
        {
            MarkRoot(Sys.Peek(p));
            p = p + WordSize.Bytes;
        }
    }

    /// A minor collection's roots besides the ordinary ones: the blocks the
    /// stacks held at the last cycle, scanned if they are there still and old
    /// now (a block may have been freed, or freed and made again, since).
    static void RescanHeld()
    {
        long count = Sys.Peek(_held);
        if (count > HeldMax) count = HeldMax;
        for (long i = 0; i < count; i++)
        {
            long at = _held + HeldEntry + i * HeldEntry;
            long block = Sys.Peek(at);
            long size = Sys.Peek(at + WordSize.Bytes);
            long chunk = HeapChunks.OfSnapshot(block + HeaderBytes);
            if (chunk == 0 || block + size > HeapChunks.End(chunk))
            {
                continue;
            }
            long word = Sys.Peek(block);
            if ((word & SizeMask) == size && (word & (FlagFree | FlagMark)) == FlagMark
                && Sys.Peek(block + size - FooterBytes) == word)
            {
                HeldWords = HeldWords + size / WordSize.Bytes;
                ScanBlock(block, size);
            }
        }
    }

    /// AT THE SNAPSHOT: every set card over the heap cleared, with the heap
    /// lock held, and -- for a minor cycle -- moved into the taken table, to
    /// be read while marking (ScanTakenCards). A card a store sets afterwards
    /// stays set for the next cycle.
    ///
    /// A YOUNG CHUNK'S CARD IS TAKEN ONLY OVER AN OLD OBJECT. Every store that
    /// fills a new object sets its card, so nearly every kilobyte allocated
    /// since the last cycle has one set, and none of them needs reading: a
    /// young object is traced if anything reaches it. The snapshot walk has
    /// just flagged (2) every card an old block other than a leaf lies in
    /// (OldCards), whether set yet or not -- a store may land between the
    /// walk and this -- and only a set card so flagged, or one over a
    /// thread's buffer (which the walk stepped over), is kept.
    static void TakeCards(bool minor)
    {
        long cards = Runtime.Cards;
        long which = 0;
        long chunk = HeapChunks.SnapshotChunk(0);
        while (chunk != 0)
        {
            bool young = HeapChunks.StartsCycle(chunk) == _cycle;
            long card = (HeapChunks.First(chunk) & WordSize.AddressMask) >> Runtime.CardShift;
            long last = ((HeapChunks.End(chunk) - 1) & WordSize.AddressMask) >> Runtime.CardShift;
            while (card <= last)
            {
                bool set = Sys.PeekByte(cards + card) != 0;
                if (set)
                {
                    Sys.PokeByte(cards + card, 0);
                }
                if (!minor)
                {
                    card = card + 1;
                    continue;
                }
                if (!young)
                {
                    if (set) Sys.PokeByte(_taken + card, 1);
                }
                else
                {
                    bool old = Sys.PeekByte(_taken + card) == 2;
                    bool keep = set && (old || BufferOverlaps(card << Runtime.CardShift, (card + 1) << Runtime.CardShift));
                    Sys.PokeByte(_taken + card, keep ? 1 : 0);
                }
                card = card + 1;
            }
            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// Flags every card an old block lies in, for TakeCards -- a leaf holds
    /// no reference and flags none.
    static void OldCards(long block, long size)
    {
        if (Sys.Peek(block + KindAt) == KindLeaf)
        {
            return;
        }
        long card = (block & WordSize.AddressMask) >> Runtime.CardShift;
        long last = ((block + size - 1) & WordSize.AddressMask) >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.PokeByte(_taken + card, 2);
            card = card + 1;
        }
    }

    /// Whether [from, to) overlaps a captured thread buffer.
    static bool BufferOverlaps(long from, long to)
    {
        long i = GcThreads.BufferAtOrAbove(from);
        if (i > 0 && GcThreads.BufferLimit(i - 1) > from)
        {
            return true;
        }
        return i < GcThreads.BufferCount() && GcThreads.BufferBase(i) < to;
    }

    /// Every card set since TakeCards, over the snapshot's chunks, added to
    /// the ones this cycle reads -- and left set (the concurrent path, after
    /// its first round).
    static void PeekCards()
    {
        long cards = Runtime.Cards;
        long which = 0;
        long chunk = HeapChunks.SnapshotChunk(0);
        while (chunk != 0)
        {
            long card = (HeapChunks.First(chunk) & WordSize.AddressMask) >> Runtime.CardShift;
            long last = ((HeapChunks.End(chunk) - 1) & WordSize.AddressMask) >> Runtime.CardShift;
            while (card <= last)
            {
                if (Sys.PeekByte(cards + card) != 0)
                {
                    Sys.PokeByte(_taken + card, 1);
                }
                card = card + 1;
            }
            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// A MINOR CYCLE'S OTHER ROOTS: the kilobytes whose cards were taken at
    /// the snapshot -- a pointer an old object was given since the last cycle
    /// is in one of them -- read once the start tables are whole, and their
    /// taken cards cleared.
    ///
    /// AN OLD CHUNK'S are read word by word: every block in it is old, and
    /// its start table is the last major cycle's, which this one does not
    /// trust. A YOUNG CHUNK'S are read block by block (ScanCardBlocks): only
    /// the old blocks, and only the words of them that are references and in
    /// the kilobyte. The young blocks there are not roots: read as roots,
    /// every young object a dead one pointed at would be kept, and made old.
    static void ScanTakenCards()
    {
        long which = 0;
        long chunk = HeapChunks.SnapshotChunk(0);
        while (chunk != 0)
        {
            long first = HeapChunks.First(chunk);
            long end = HeapChunks.End(chunk);
            bool indexed = _snapshots && HeapChunks.StartsCycle(chunk) == _cycle;
            long card = (first & WordSize.AddressMask) >> Runtime.CardShift;
            long last = ((end - 1) & WordSize.AddressMask) >> Runtime.CardShift;
            while (card <= last)
            {
                if (Sys.PeekByte(_taken + card) != 0)
                {
                    Sys.PokeByte(_taken + card, 0);
                    long from = card << Runtime.CardShift;
                    long to = from + (1 << Runtime.CardShift);
                    if (from < first) from = first;
                    if (to > end) to = end;
                    TakenCards = TakenCards + 1;
                    if (indexed)
                    {
                        ScanCardBlocks(chunk, from, to);
                    }
                    else
                    {
                        OldCardWords = OldCardWords + (to - from) / WordSize.Bytes;
                        ScanRange(from, to);
                    }
                }
                card = card + 1;
            }
            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// The old blocks of [from, to) in a chunk whose starts this cycle wrote,
    /// each read for its references in the range only.
    static void ScanCardBlocks(long chunk, long from, long to)
    {
        long block = HeapChunks.StartAtOrBelow(chunk, from & -8);
        if (block == 0)
        {
            block = HeapChunks.NextStart(chunk, from);
        }
        while (block != 0 && block < to)
        {
            long word = Sys.Peek(block);
            long size = word & SizeMask;
            if (size < Smallest)
            {
                return;
            }
            // OLD ONLY: marked AND scanned, as the last sweep left every
            // survivor. One this cycle has reached and not yet scanned is
            // queued, and will be read whole.
            if (block + size > from && (word & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan))
            {
                ScanBlockWithin(block, size, from, to);
            }
            block = HeapChunks.NextStart(chunk, block + 8);
        }
    }

    /// ScanBlock's rules, over the part of a block inside [from, to): a
    /// leaf not at all, an object by its reference map or its reference
    /// elements, an array of integers not at all (its stores take no card),
    /// and anything no descriptor describes word by word.
    static void ScanBlockWithin(long block, long size, long from, long to)
    {
        long kind = Sys.Peek(block + KindAt);
        if (kind == KindLeaf)
        {
            return;
        }
        long w = WordSize.Bytes;
        long payload = block + HeaderBytes;
        long end = block + size - FooterBytes;
        long low = from > payload ? from : payload;
        long high = to < end ? to : end;
        if (low >= high)
        {
            return;
        }
        long vt = Sys.Peek(payload) & WordSize.AddressMask;
        YoungCardWords = YoungCardWords + (high - low) / w;
        if (kind != KindObject || vt == 0)
        {
            ScanRange(low, high);
            return;
        }
        long desc = vt - DescWords * w;
        if ((Sys.Peek(desc + DescSelfWord * w) & WordSize.AddressMask) != desc)
        {
            ScanRange(low, high);
            return;
        }
        long flags = Sys.Peek(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0 || (Sys.Peek(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0)
            {
                return;
            }
            if (Sys.Peek(desc + DescSizeWord * w) != w)
            {
                ScanRange(low, high);
                return;
            }
            long count = Sys.Peek(payload + ArrayCountAt) & 0x7FFFFFFF;
            long first = payload + Sys.Peek(desc + DescPayloadWord * w);
            long last = first + count * w;
            if (last > end || last < first)
            {
                ScanRange(low, high);
                return;
            }
            ScanRange(low > first ? low : first, high < last ? high : last);
            return;
        }
        long map = Sys.Peek(desc + DescRefMapWord * w) & WordSize.AddressMask;
        if (map == 0)
        {
            return;
        }
        long words = Sys.Peek(map);
        long index = (low - payload + w - 1) / w;
        long stop = (high - payload + w - 1) / w;
        if (stop > words) stop = words;
        while (index < stop)
        {
            long bits = Sys.Peek(map + (1 + index / 32) * w) & 0xFFFFFFFF;
            if (((bits >> (int)(index & 31)) & 1) != 0)
            {
                MarkAt(Sys.Peek(payload + index * w));
            }
            index = index + 1;
        }
    }

    /// Runtime.CardMarkObject: every card of the block a payload is in -- what
    /// a coroutine's frame is saved into at each suspension, word by word
    /// and without a barrier (AsyncTransform).
    public static void CardMarkObject(long payload)
    {
        long cards = Runtime.Cards;
        if (cards == 0 || payload == 0)
        {
            return;
        }
        long block = payload - HeaderBytes;
        long word = Sys.Peek(block);
        long size = word & SizeMask;
        long end = payload;
        if (size >= Smallest && size < 0x40000000 && Sys.Peek(block + size - FooterBytes) == word)
        {
            end = block + size - 1;
        }
        long card = (payload & WordSize.AddressMask) >> Runtime.CardShift;
        long last = (end & WordSize.AddressMask) >> Runtime.CardShift;
        while (card <= last)
        {
            Sys.PokeByte(cards + card, 1);
            card = card + 1;
        }
    }

    // ---- what a program can ask ---------------------------------------------

    /// Bytes the sweep found live at the last collection.
    public static long LiveBytes
    {
        get { return _liveBytes; }
    }

    /// Blocks the sweep found live at the last collection.
    public static long LiveBlocks
    {
        get { return _liveBlocks; }
    }

    /// The deepest the mark queue got in the last collection: how many
    /// blocks were reached through other blocks rather than from a root.
    public static long MarkPeak
    {
        get { return _markPeak; }
    }

    /// Bytes allocated since the last collection, and the amount that
    /// triggers the next one.
    public static long Since
    {
        get { return _since; }
    }

    /// Bytes allocated since the program began, by every thread: what their
    /// retired buffers handed out and their large blocks. A buffer still in
    /// use is counted when it is retired; the calling thread's is added here.
    public static long Allocated
    {
        get
        {
            GcLock.Enter();
            long total = _allocated;
            GcLock.Exit();
            return total + InBuffer(Sys.ThreadBlock());
        }
    }

    /// Bytes this thread has allocated since it began.
    public static long AllocatedByThread
    {
        get
        {
            long block = Sys.ThreadBlock();
            if (block == 0) return Allocated;
            return (Sys.Peek(block + Tls.Allocated) & 0xFFFFFFFF)
                 + ((Sys.Peek(block + Tls.Allocated + WordSize.Bytes) & 0xFFFFFFFF) << 32)
                 + InBuffer(block);
        }
    }

    /// What `block`'s current allocation buffer has handed out so far.
    static long InBuffer(long block)
    {
        if (block == 0) return 0;
        long started = Sys.Peek(block + Tls.AllocBase);
        long at = Sys.Peek(block + Tls.AllocPtr);
        return started != 0 && at > started ? at - started : 0;
    }

    /// Charges `bytes` to the program and to the thread whose block this is.
    /// Under GcLock, or for a thread that is stopped.
    static void Count(long block, long bytes)
    {
        _allocated = _allocated + bytes;
        if (block == 0) return;
        long total = (Sys.Peek(block + Tls.Allocated) & 0xFFFFFFFF)
                   + ((Sys.Peek(block + Tls.Allocated + WordSize.Bytes) & 0xFFFFFFFF) << 32) + bytes;
        Sys.Poke(block + Tls.Allocated, total & 0xFFFFFFFF);
        Sys.Poke(block + Tls.Allocated + WordSize.Bytes, total >> 32);
    }

    public static long Threshold
    {
        get { return _threshold; }
    }

    /// Bytes taken from the operating system so far.
    public static long HeapBytes
    {
        get { return HeapChunks.HeapBytes; }
    }

    /// Caps what the heap may take from the operating system. Zero removes
    /// the cap. A program that knows it must fit in so much memory says so
    /// here, and gets a collection instead of a bigger heap when it reaches
    /// it -- and an out-of-memory stop if the collection does not help.
    public static void SetLimit(long bytes)
    {
        HeapChunks.SetLimit(bytes);
    }

    // ---- reading and writing a block ----------------------------------------

    static long SizeOfBlock(long block)
    {
        return Sys.Peek(block) & SizeMask;
    }

    static bool IsFree(long block)
    {
        return (Sys.Peek(block) & FlagFree) != 0;
    }

    /// Writes a block's size and flags at BOTH ENDS, so it can be found from
    /// either side.
    static void Stamp(long block, long size, long flags)
    {
        Sys.Poke(block, size | flags);
        Sys.Poke(block + size - FooterBytes, size | flags);
    }

    // ---- the free list ------------------------------------------------------

    /// Which bin a block of `size` bytes belongs in: one for every eight
    /// bytes up to ExactLimit, then eight to each power of two above it,
    /// every bin a list (the free index, below).
    static long BinOf(long size)
    {
        if (size <= ExactLimit)
        {
            return (size >> 3) - 2;
        }

        // 264..287 is bin 31, 288..319 bin 32 and so on: the bit length
        // picks the power of two, the three bits under the top one pick the
        // eighth of it. Anything past 2^31 shares the top bin.
        long length = 64 - Runtime.LeadingZeroCount(size);
        if (length > LargeTop)
        {
            return Bins - 1;
        }
        return ExactBins + (length - 9) * LargeSteps + ((size >> (int)(length - 4)) & (LargeSteps - 1));
    }

    static long BinHead(long bin)
    {
        return Sys.Peek(_bins + bin * WordSize.Bytes);
    }

    static void SetBinHead(long bin, long block)
    {
        Sys.Poke(_bins + bin * WordSize.Bytes, block);
    }

    // ---- the free index ---------------------------------------------------
    //
    // EVERY BIN IS A LIST, and a bitmap after the heads says which are not
    // empty, so linking, unlinking and finding a fit cost the same whatever
    // the heap holds (a two-level segregated fit, "TLSF"). A free block's
    // payload holds its links: the next at KindAt, the previous where the
    // payload starts.
    //
    // A fit is the first block that fits in the request's own bin, looked
    // for a few blocks deep, or else the head of the first non-empty bin
    // above it, which fits whatever it is. Large bins were AVL trees ordered
    // by size, a best fit; every link and unlink rebalanced one, keeping a
    // height and a largest-size in every node, and on a fragmented heap that
    // rebalancing was an eighth of what the compiler did at all. A block a
    // fit splits puts its remainder back, so a good fit costs little over
    // the best one.

    const long BitsPerWord = 8 * WordSize.Bytes;

    /// The words of the non-empty bitmap, after the Bins heads.
    const long MapWords = (Bins + BitsPerWord - 1) / BitsPerWord;

    /// How many blocks of the request's own bin a fit looks at.
    const long FitDepth = 8;

    static long MapWord(long bin)
    {
        return _bins + (Bins + bin / BitsPerWord) * WordSize.Bytes;
    }

    static void MarkBin(long bin)
    {
        long at = MapWord(bin);
        Sys.Poke(at, Sys.Peek(at) | (One << (int)(bin % BitsPerWord)));
    }

    static void UnmarkBin(long bin)
    {
        long at = MapWord(bin);
        Sys.Poke(at, Sys.Peek(at) & ~(One << (int)(bin % BitsPerWord)));
    }

    static bool BinMarked(long bin)
    {
        return (Sys.Peek(MapWord(bin)) & (One << (int)(bin % BitsPerWord))) != 0;
    }

    /// The lowest non-empty bin at or above `from`, or -1.
    static long NextNonEmpty(long from)
    {
        if (from < 0) from = 0;
        if (from >= Bins) return -1;
        long word = from / BitsPerWord;
        long bits = Sys.Peek(_bins + (Bins + word) * WordSize.Bytes) & WordSize.AddressMask
                  & ~((One << (int)(from % BitsPerWord)) - 1);
        while (bits == 0)
        {
            word = word + 1;
            if (word >= MapWords) return -1;
            bits = Sys.Peek(_bins + (Bins + word) * WordSize.Bytes) & WordSize.AddressMask;
        }
        long bin = word * BitsPerWord + Runtime.TrailingZeroCount(bits);
        return bin < Bins ? bin : -1;
    }

    /// The highest non-empty bin at or below `from`, or -1.
    static long PrevNonEmpty(long from)
    {
        if (from < 0) return -1;
        if (from >= Bins) from = Bins - 1;
        long word = from / BitsPerWord;
        long keep = from % BitsPerWord;
        long bits = Sys.Peek(_bins + (Bins + word) * WordSize.Bytes) & WordSize.AddressMask;
        if (keep != BitsPerWord - 1) bits = bits & ((One << (int)(keep + 1)) - 1);
        while (bits == 0)
        {
            if (word == 0) return -1;
            word = word - 1;
            bits = Sys.Peek(_bins + (Bins + word) * WordSize.Bytes) & WordSize.AddressMask;
        }
        return word * BitsPerWord + 63 - Runtime.LeadingZeroCount(bits);
    }

    /// The first of the few blocks from `node` on at least `need` bytes, or 0.
    static long FirstFit(long node, long need)
    {
        long looked = 0;
        while (node != 0 && looked < FitDepth)
        {
            ProbeSteps = ProbeSteps + 1;
            if (SizeOfBlock(node) >= need)
            {
                return node;
            }
            node = Sys.Peek(node + KindAt);
            looked = looked + 1;
        }
        return 0;
    }

    // Allocation-free diagnostic. Run under the heap lock so a failure
    // describes one consistent index. Normal programs do not call this.
    public static long FreeIndexErrorBlock;
    public static long FreeIndexErrorKind;

    static long BadIndex(long node, long kind)
    {
        FreeIndexErrorBlock = node;
        FreeIndexErrorKind = kind;
        return -1;
    }

    static bool IndexBlock(long node, long bin)
    {
        if ((node & 7) != 0) return false;
        long chunk = HeapChunks.Of(node);
        if (chunk == 0) return false;
        long header = Sys.Peek(node);
        long size = header & SizeMask;
        return size >= Smallest && node >= HeapChunks.First(chunk)
            && node + size <= HeapChunks.End(chunk) && (header & FlagFree) != 0
            && Sys.Peek(node + size - FooterBytes) == header && BinOf(size) == bin;
    }


    public static bool CheckFreeIndex()
    {
        GcLock.Enter();
        FreeIndexErrorBlock = Zero;
        FreeIndexErrorKind = Zero;
        long small = 0;
        long seen = 0;
        bool okay = true;
        if (_bins != 0)
        {
            long bin = 0;
            while (bin < Bins && okay)
            {
                long node = BinHead(bin);
                if (BinMarked(bin) != (node != 0)) { BadIndex(node, 8); okay = false; }
                long previous = 0;
                while (node != 0 && okay)
                {
                    seen = seen + 1;
                    if (bin <= BinOf(ExactLimit)) small = small + 1;
                    if (seen > HeapChunks.HeapBytes / Smallest || !IndexBlock(node, bin)
                        || Sys.Peek(node + HeaderBytes) != previous)
                    { BadIndex(node, 6); okay = false; }
                    else { previous = node; node = Sys.Peek(node + KindAt); }
                }
                bin = bin + 1;
            }
            if (okay && small != _smallFree) { BadIndex(Zero, 7); okay = false; }
        }
        GcLock.Exit();
        return okay;
    }

    static void Link(long block)
    {
        long size = SizeOfBlock(block);
        long bin = BinOf(size);
        long head = BinHead(bin);

        if (size <= ExactLimit)
        {
            _smallFree = _smallFree + 1;
        }

        Sys.Poke(block + KindAt, head);
        Sys.Poke(block + HeaderBytes, Zero);

        if (head != 0)
        {
            Sys.Poke(head + HeaderBytes, block);
        }
        else
        {
            MarkBin(bin);
        }
        SetBinHead(bin, block);
    }

    static void Unlink(long block)
    {
        long size = SizeOfBlock(block);
        long next = Sys.Peek(block + KindAt);
        long prev = Sys.Peek(block + HeaderBytes);

        if (size <= ExactLimit)
        {
            _smallFree = _smallFree - 1;
        }

        if (prev == 0)
        {
            long bin = BinOf(size);
            SetBinHead(bin, next);
            if (next == 0)
            {
                UnmarkBin(bin);
            }
        }
        else
        {
            Sys.Poke(prev + KindAt, next);
        }

        if (next != 0)
        {
            Sys.Poke(next + HeaderBytes, prev);
        }
    }

    /// Empties every bin; the sweep rebuilds them.
    static void ClearBins()
    {
        long word = 0;
        _smallFree = 0;

        while (word < Bins + MapWords)
        {
            Sys.Poke(_bins + word * WordSize.Bytes, Zero);
            word = word + 1;
        }
    }

    // ---- chunks ---------------------------------------------------------------

    /// Whether a chunk of `ask` bytes should wait for a collection: one past
    /// the 32-bit ceiling, when half the pace has been allocated since the
    /// last collection -- enough garbage for a collection to be worth its
    /// cost. Near the ceiling the pace itself is half of what is left
    /// (NextThreshold), so the heap is slowed as it nears the limit. Judged
    /// by the pace and never by the chunk: a heap at the ceiling because its
    /// free memory is in holes -- 920 MB live in 2.7 GB, of the self-hosted
    /// compiler -- otherwise ran a whole collection for every megabyte it
    /// took, and freed nothing. The allocator's last try waives it
    /// (_growPast): the ceiling slows a heap and never fails one.
    public static bool GrowthWaits(long ask)
    {
        _ceilingRefused = false;
        if (HeapCeiling == 0 || _collecting || _growPast || HeapChunks.HeapBytes + ask <= HeapCeiling
            || _since < _threshold / 2)
        {
            return false;
        }
        _ceilingRefused = true;
        return true;
    }

    // Set when GrowthWaits refused the last chunk asked for, so that Grow
    // does not report a wait at the ceiling as the system's refusal.
    static bool _ceilingRefused;

    // The allocator's last try, which the ceiling does not refuse. The heap
    // lock is held.
    static bool _growPast;

    /// Takes a chunk of at least `need` block bytes and makes it current.
    /// Whatever the old current chunk had left above its bump pointer
    /// becomes a free block first, so nothing is stranded. Answers false
    /// when the cap or the operating system refuses.
    static bool Grow(long need)
    {
        long raw = HeapChunks.Take(need);

        if (raw == 0)
        {
            // Waiting for a collection at the ceiling is no failure to report.
            if (!_ceilingRefused) SayNumber("heap: no chunk for ", need);
            _ceilingRefused = false;
            return false;
        }

        // The tail of the chunk being left. If it cannot describe itself
        // (below Smallest) it stays unused; that is at most fifteen bytes.
        if (_current != 0)
        {
            long tail = _limit - _bump;

            if (tail >= Smallest)
            {
                Stamp(_bump, tail, FlagFree);
                Link(_bump);
                _bump = _limit;
            }
            HeapChunks.SetEnd(_current, _bump);
        }

        _current = raw;
        _bump = HeapChunks.First(raw);
        _limit = HeapChunks.Limit(raw);
        return true;
    }

    // ---- handing memory out ---------------------------------------------------

    // The largest request: leaves room for the rounding below.
    const long MaxRequest = 0x7FFFFFFF - Overhead - 7;

    /// The heap. Zeroed memory for `bytes`, 8-aligned.
    ///
    /// THE FAST PATH, kept to a few instructions so the inliner can put it at
    /// every `new`: round the size, bump the pointer within the current
    /// chunk, stamp the block, and count it towards the next collection.
    /// An available fitting block in the request's size bin diverts it to the
    /// locked index for reuse. Unrelated free sizes do not prevent a thread
    /// from using its private buffer. The unlocked head/maximum check is only
    /// a hint; the slow path takes a block under the heap lock.
    /// Everything else -- a full chunk, a collection due, a size out of
    /// range, the heap not started -- falls to AllocSlow. Memory above the
    /// bump pointer is untouched since the operating system zeroed it, so
    /// the fast path clears nothing; that is why the bump pointer never
    /// moves backwards.
    ///
    /// The chunk's own end word is NOT updated here; the slow path, a
    /// collection and Free bring it up to date first (SyncEnd), which is
    /// every place that reads it.
    public static long Alloc(long bytes)
    {
        return AllocKind(bytes, 0);
    }

    /// The same for a block that will hold no references -- a string, an
    /// array of bytes or characters: marked when reachable, never scanned
    /// (KindLeaf).
    public static long AllocLeaf(long bytes)
    {
        return AllocKind(bytes, KindLeaf);
    }

    /// The same for an object the caller is about to give its vtable:
    /// scanned by its descriptor's reference map (KindObject).
    public static long AllocObject(long bytes)
    {
        return AllocKind(bytes, KindObject);
    }

    static long AllocKind(long bytes, long kind)
    {
        long tb = Sys.ThreadBlock();
        long need = (bytes + Overhead + 7) & SizeMask;
        // Not to be stopped from outside between here and the bump
        // (Tls.InAlloc): the limit read below is the promise the buffer is
        // still this thread's, and an interrupting collector must not
        // retire it before the pointer has moved past the object.
        Sys.Poke(tb + Tls.InAlloc, 1);
        long block = Sys.Peek(tb + Tls.AllocPtr);
        long next = block + need;

        // A BUFFER WITH ROOM ANSWERS, whatever the free index holds. Asking
        // it first sent every allocation whose size had a hole anywhere to
        // the heap lock -- on a fragmented heap, nearly all of them, with
        // every thread queued behind whichever was collecting -- and put the
        // object in that hole's chunk, young for the next minor cycle to
        // walk. Holes are reused as buffers are refilled (AllocSlow).
        if (bytes < 0 || bytes > MaxRequest || next + Smallest > Sys.Peek(tb + Tls.AllocLimit))
        {
            Sys.Poke(tb + Tls.InAlloc, 0);
            return AllocSlow(bytes, kind);
        }

        Sys.Poke(tb + Tls.AllocPtr, next);
        Sys.Poke(block, need);
        Sys.Poke(block + KindAt, kind);
        Sys.Poke(next - FooterBytes, need);
        Sys.Poke(tb + Tls.InAlloc, 0);
        return block + HeaderBytes;
    }

    // ---- allocation buffers ---------------------------------------------------
    //
    // A thread bumps in a buffer of its OWN -- a block taken from the shared
    // heap under the lock and then carved up with no lock at all -- which is
    // what makes allocation on several threads cost what it costs on one.
    //
    // THE ONE INVARIANT the rest of this file depends on: every byte of every
    // chunk below its end word must be walkable as a chain of blocks, because
    // marking, sweeping and coalescing all walk. A buffer between its pointer
    // and its limit is NOT a block -- it is untouched memory -- so a buffer is
    // RETIRED (its tail stamped as one free block) before anything walks, and
    // the only thing that walks is a collection, which happens with every
    // thread stopped. That is the whole reason the world is stopped at all.
    //
    // The fast path keeps Smallest bytes back so that the tail is always big
    // enough to describe itself; a remainder of eight bytes would be a hole
    // nothing could walk past.

    const long BufferBytes = 65536;

    /// Queued blocks an allocating thread scans while a mark is under way.
    const long AssistBudget = 32;

    // This is only an allocation-policy hint. A concurrent owner may change
    // the bin after this read; AllocSlow always rechecks/takes under the heap
    // lock. Never dereference the observed free-block address without that
    // lock. The bin table itself remains mapped for the heap's lifetime.
    static bool HasReusableFree(long need)
    {
        if (_bins == 0) return false;
        if (need <= ExactLimit)
            return _smallFree != 0 && BinHead((need >> 3) - 2) != 0;
        // A block in a bin above the request's fits whatever it is, and
        // that is one bitmap search. Only the bitmap is read here; the
        // locked allocation path resolves a stale answer.
        return NextNonEmpty(BinOf(need) + 1) >= 0;
    }

    /// A fresh allocation buffer for the thread whose block is `block`, big
    /// enough for a request of `need`. The heap lock must be held.
    static bool Refill(long block, long need)
    {
        Retire(block);

        // Reuse free memory before consuming fresh address space. A 64 KiB
        // buffer is a preference, not a minimum: otherwise thousands of
        // smaller holes can coexist with repeated megabyte heap growth.
        long arena = TakeFree(BufferBytes);
        if (arena == 0) arena = TakeBufferFragment(need + Smallest);
        if (arena != 0)
            ZeroWords(arena + HeaderBytes, arena + SizeOfBlock(arena) - FooterBytes);
        else arena = TakeBump(BufferBytes);

        if (arena == 0)
        {
            if (Grow(BufferBytes))
            {
                arena = Take(BufferBytes);
            }
        }

        if (arena == 0)
        {
            return false;
        }

        long size = SizeOfBlock(arena);

        // The pressure counter is charged the whole buffer here, once, rather
        // than each allocation out of it: the fast path must not touch a word
        // another thread also writes, and the buffer is what this thread has
        // actually taken out of the heap.
        _since = _since + size;
        Sys.Poke(block + Tls.AllocBase, arena);
        Sys.Poke(block + Tls.AllocPtr, arena);
        Sys.Poke(block + Tls.AllocLimit, arena + size);
        return true;
    }

    // ---- recycling: where young objects go --------------------------------
    //
    // A MINOR COLLECTION COSTS WHAT THE YOUNG CHUNKS HOLD, because it walks
    // each chunk anything was handed out in, whole: its anchors, its sweep.
    // Handed a best-fitting hole anywhere, the young objects of one cycle
    // landed in nearly every chunk of a fragmented heap, and a "minor"
    // collection of a compiler with a gigabyte and a half live walked three
    // gigabytes -- as dear as a major one, and paced as a cheap one.
    //
    // So the holes are reused a chunk at a time. After a collection the
    // chunks are taken in list order, each that is at least an eighth free,
    // and a buffer is refilled from the next hole that fits in the chunk
    // being recycled, in address order, until the chunk is done. A cycle's
    // young objects then lie in as few chunks as their bytes can fill. A
    // hole fits a request that fills it exactly -- the buffer is then used
    // up, which Retire allows -- or leaves a tail that can describe itself.
    //
    // AND ONLY A HOLE OF SEVERAL CARDS. Young objects in a small hole share
    // its cards with the old blocks either side, and the stores that fill
    // them in mark those cards: the next minor cycle reads every old block
    // in each, and resolves every pointer it finds there. Recycling holes
    // of any size, a stage 2 minor cycle read 23 million words of old blocks
    // through young objects' cards, against a third of a million through
    // old ones'. A hole of RecycleMin or more has cards only young objects
    // lie in, which no minor cycle takes. The smaller holes stay in the
    // free index, for an exact fit when no chunk is left to recycle and to
    // merge with a neighbour when it dies.
    //
    // The walk is safe because every block below a chunk's end is a whole
    // block (it runs with the heap lock held and never during a sweep),
    // except inside a buffer a thread is bumping in -- which is NOT a chain
    // of blocks: above its pointer lies whatever a free of the thread's top
    // block left there, and the thread may be writing a header this moment.
    // So every thread's buffer is taken down first (the heap lock keeps them
    // where they are: only the bump pointers move without it) and the walk
    // steps over each whole, as the sweep does. It takes only a listed free
    // block, never one freed in place, which is not on a list.

    /// The smallest hole recycling hands out: four cards (Runtime.CardShift).
    const long RecycleMin = 4096;

    /// A chunk is recycled when at least this fraction of it -- one part in
    /// eight -- was free at its last sweep. The holes of a fuller chunk wait
    /// until something beside them dies.
    const long RecycleShift = 3;

    static long _recycle;           // the chunk whose holes are being handed out, or 0
    static long _recycleAt;         // the next block in it to look at
    static long _recycleNext;       // the next chunk to consider
    static long _recycleBuffers;    // the threads' buffers as a walk begins, mapped once

    /// Called as a collection ends: every chunk may be recycled again.
    static void RestartRecycling()
    {
        _recycle = Zero;
        _recycleAt = Zero;
        _recycleNext = HeapChunks.Newest();
    }

    /// The bump pointer's chunk is walked too, up to its end as it stands at
    /// each step (SyncEnd keeps it there).
    static bool Recyclable(long chunk)
    {
        if (HeapChunks.LargestHole(chunk) < RecycleMin)
        {
            return false;
        }
        long used = HeapChunks.End(chunk) - HeapChunks.First(chunk);
        return used - HeapChunks.LiveBytes(chunk) >= (used >> RecycleShift);
    }

    /// The thread whose block is `block` given a buffer from the next hole
    /// that fits `need` in the chunk being recycled. The heap lock is held.
    static bool Recycle(long block, long need)
    {
        long arena = NextHole(need);
        if (arena == 0)
        {
            return false;
        }
        Retire(block);
        long size = SizeOfBlock(arena);
        ZeroWords(arena + HeaderBytes, arena + size - FooterBytes);
        _since = _since + size;
        Sys.Poke(block + Tls.AllocBase, arena);
        Sys.Poke(block + Tls.AllocPtr, arena);
        Sys.Poke(block + Tls.AllocLimit, arena + size);
        return true;
    }

    /// The next hole that fits `need` in the chunk being recycled, taken off
    /// its list and stamped allocated, at most a buffer's worth (the rest is
    /// put back); or zero when no recyclable chunk is left. The heap lock is
    /// held.
    static long NextHole(long need)
    {
        if (_sweeping || _collecting)
        {
            return 0;
        }

        if (_recycleBuffers == 0)
        {
            _recycleBuffers = Platform.Map(GcThreads.BufferTableBytes());
            if (_recycleBuffers == 0)
            {
                return 0;
            }
        }
        long buffers = GcThreads.CaptureBuffersInto(_recycleBuffers);

        while (true)
        {
            if (_recycle == 0)
            {
                long chunk = _recycleNext;
                while (chunk != 0 && !Recyclable(chunk))
                {
                    chunk = HeapChunks.Next(chunk);
                }
                if (chunk == 0)
                {
                    _recycleNext = Zero;
                    return 0;
                }
                _recycle = chunk;
                _recycleAt = HeapChunks.First(chunk);
                _recycleNext = HeapChunks.Next(chunk);
            }

            long end = HeapChunks.End(_recycle);
            long at = _recycleAt;
            long step = 0;

            while (at < end)
            {
                // A THREAD'S BUFFER is stepped over whole.
                while (step < buffers && Sys.Peek(_recycleBuffers + step * (2 * WordSize.Bytes)) < at)
                {
                    step = step + 1;
                }
                if (step < buffers && Sys.Peek(_recycleBuffers + step * (2 * WordSize.Bytes)) == at)
                {
                    at = Sys.Peek(_recycleBuffers + step * (2 * WordSize.Bytes) + WordSize.Bytes);
                    step = step + 1;
                    continue;
                }

                long word = Sys.Peek(at);
                long size = word & SizeMask;

                if (size < Smallest || at + size > end || Sys.Peek(at + size - FooterBytes) != word)
                {
                    break;
                }
                if ((word & FlagFree) != 0 && size >= RecycleMin && (size == need || size >= need + Smallest)
                    && !IsInPlace(at))
                {
                    Unlink(at);
                    if (size - BufferBytes >= Smallest)
                    {
                        Stamp(at + BufferBytes, size - BufferBytes, FlagFree);
                        Link(at + BufferBytes);
                        size = BufferBytes;
                    }
                    _recycleAt = at + size;
                    Stamp(at, size, Zero);
                    HeapChunks.YoungAt(at);
                    return at;
                }
                at = at + size;
            }
            _recycle = Zero;
        }
    }

    // Largest available fragment below the preferred buffer size. Keep it
    // whole for this thread rather than splitting off a one-object buffer.
    // All tree/list reads occur under the heap lock held by Refill.
    static long TakeBufferFragment(long minimum)
    {
        long lowest = BinOf(minimum);
        long bin = PrevNonEmpty(BinOf(BufferBytes - 8));
        while (bin >= lowest)
        {
            long block = FirstFit(BinHead(bin), minimum);
            if (block != 0)
            {
                long size = SizeOfBlock(block);
                Unlink(block);
                Stamp(block, size, Zero);
                HeapChunks.YoungAt(block);
                return block;
            }
            bin = PrevNonEmpty(bin - 1);
        }
        return 0;
    }

    /// Gives a thread's buffer back: whatever it has not handed out becomes
    /// one free block, so the chunk can be walked again. The heap lock must be
    /// held -- by the thread itself as it starts a collection, or by the
    /// collector on behalf of a thread it has already stopped.
    public static void Retire(long block)
    {
        if (block == 0)
        {
            return;
        }

        long at = Sys.Peek(block + Tls.AllocPtr);
        long limit = Sys.Peek(block + Tls.AllocLimit);
        long started = Sys.Peek(block + Tls.AllocBase);

        // What the buffer handed out is allocated for good, by its thread.
        if (started != 0 && at > started)
        {
            Count(block, at - started);
        }

        // A thread asked to answer a handshake had its limit taken away, so
        // that its next allocation comes to the slow path (GcThreads.Round);
        // the real one is kept aside.
        if (limit == 0)
        {
            limit = Sys.Peek(block + Tls.AllocSaved);
        }

        // WHILE STAMPING IS OPEN a buffer's objects are written into the
        // snapshot before it goes: the snapshot stepped over it, and once
        // it is retired its owner's STAMP answer would look in the next one.
        if (_stamping)
        {
            StampBuffer(block);
        }

        // What Free left in place goes to the bins now that the buffer is
        // heap again.
        if (_inPlace > 0 && started != 0 && at > started)
        {
            LinkFreedInPlace(started, at);
        }

        Sys.Poke(block + Tls.AllocSaved, Zero);
        Sys.Poke(block + Tls.AllocBase, Zero);
        Sys.Poke(block + Tls.AllocPtr, Zero);
        Sys.Poke(block + Tls.AllocLimit, Zero);

        if (at == 0 || limit - at < Smallest)
        {
            return;
        }
        // Refill charged the entire arena. Its unused tail has now been
        // returned, so it is no longer allocation pressure. Buffers never
        // survive a collection: retirement precedes resetting _since.
        _since = _since - (limit - at);
        if (_since < 0) _since = Zero;
        Stamp(at, limit - at, FlagFree);
        Link(at);
    }

    // A BLOCK FREED IN PLACE (Free, above) is free and in no bin. Its link
    // word -- a bin's next, a tree's left child, always a block address or
    // zero -- holds InPlace instead, which no block address is.
    const long InPlace = 1;

    /// Blocks freed in place and not yet in a bin.
    static long _inPlace;

    static bool IsInPlace(long block)
    {
        return Sys.Peek(block + KindAt) == InPlace;
    }

    static void FreeInPlace(long block, long size)
    {
        Stamp(block, size, FlagFree);
        Sys.Poke(block + KindAt, InPlace);
        _inPlace = _inPlace + 1;
    }

    /// Every block freed in place in [from, to) linked into its bin, as its
    /// buffer is retired: each as it is, not merged, because a collection
    /// may be under way whose snapshot knows each one's start. The heap
    /// lock is held and nobody else writes below the buffer's pointer.
    static void LinkFreedInPlace(long from, long to)
    {
        long at = from;

        while (at < to && _inPlace > 0)
        {
            long word = Sys.Peek(at);
            long size = word & SizeMask;

            if (size < Smallest || at + size > to)
            {
                return;
            }
            if ((word & FlagFree) != 0 && IsInPlace(at))
            {
                Link(at);
                _inPlace = _inPlace - 1;
            }
            at = at + size;
        }
    }

    /// The blocks a thread's buffer gave to the bins while it was the only
    /// thread, taken back out and kept in place: a second thread is about to
    /// run, and must not be handed them (Free). The heap lock is held; the
    /// thread may be bumping above its pointer meanwhile, and may clear its
    /// own top block (Free's fast path), where the walk stops.
    public static void KeepBufferInPlace(long thread)
    {
        if (thread == 0 || _bins == 0)
        {
            return;
        }
        long at = Sys.Peek(thread + Tls.AllocBase);
        long to = Sys.Peek(thread + Tls.AllocPtr);

        while (at != 0 && at < to)
        {
            long word = Sys.Peek(at);
            long size = word & SizeMask;

            if (size < Smallest || at + size > to || Sys.Peek(at + size - FooterBytes) != word)
            {
                return;
            }
            if ((word & FlagFree) != 0 && !IsInPlace(at))
            {
                Unlink(at);
                FreeInPlace(at, size);
            }
            at = at + size;
        }
    }

    /// The current chunk's end word, brought up to the bump pointer.
    static void SyncEnd()
    {
        if (_current != 0)
        {
            HeapChunks.SetEnd(_current, _bump);
        }
    }

    /// Everything the fast path does not: the free list, a collection when
    /// one is due, a new chunk, and out of memory.
    ///
    /// THIS AND EVERYTHING IT CALLS ALLOCATES NOTHING: no `new`, no arrays, no
    /// strings. Every one of those is a call to this.
    static long AllocSlow(long bytes, long kind)
    {
        // The size checked BEFORE it is rounded, with a bound that leaves
        // room for the rounding: rounding first lets a huge request wrap
        // negative and slip past the check.
        if (bytes < 0 || bytes > MaxRequest)
        {
            OutOfMemory("out of memory: a request larger than any object may be\n");
        }

        long need = (bytes + Overhead + 7) & SizeMask;
        long tb = Sys.ThreadBlock();

        // THE SAFEPOINT every allocating thread reaches: the collector's open
        // round answered, if this thread owes it -- never a wait -- and, while
        // a mark is under way, a little of the marking done here, so that the
        // threads that cause a collection help to finish it.
        if (GcLock.IsCollecting())
        {
            GcThreads.Park();
            Assist(AssistBudget);
        }

        GcLock.Enter();

        // A buffer limit taken away to ask for that answer (GcThreads.Round)
        // is given back: the buffer was this thread's all along.
        if (Sys.Peek(tb + Tls.AllocLimit) == 0 && Sys.Peek(tb + Tls.AllocSaved) != 0)
        {
            Sys.Poke(tb + Tls.AllocLimit, Sys.Peek(tb + Tls.AllocSaved));
            Sys.Poke(tb + Tls.AllocSaved, Zero);
        }

        if (!_ready)
        {
            Start();
        }
        SyncEnd();

        // Pressure first: a program that has allocated a threshold's worth
        // since the last collection is collected now, whether or not this
        // request would have fitted, so the heap tracks the live size rather
        // than the allocation rate.
        bool due = _since + need >= _threshold;
        if (!due && ShortHook != 0 && _since + need >= ShortThreshold() && HeapChunks.Any()
            && Sys.Call(ShortHook, 0, 0, 0) != 0)
        {
            due = true;
            ShortCollections = ShortCollections + 1;
        }
        if (due && HeapChunks.Any())
        {
            // A PLATFORM MAY SAY "NOT HERE". This collection is owed because
            // a quota was reached, not because memory ran out, so it can be
            // put off: the quota stays exceeded and the next allocation made
            // somewhere better pays it. A kernel says so when interrupts are
            // off -- a collection stops the world for tens of milliseconds,
            // and started there it stops every device on the machine for as
            // long. Put off only so far: past four quotas it is taken
            // wherever it falls, and the collection that memory itself
            // demands (below) asks nobody.
            bool later = DeferHook != 0 && _since + need < _threshold * 4
                      && Sys.Call(DeferHook, 0, 0, 0) != 0;
            if (later) Deferred = Deferred + 1;
            else CollectLocked();
        }

        // A small request takes a buffer of its own and is answered from it,
        // so the allocations after it need no lock. Prefer an existing fitting
        // size-class block, but unrelated free sizes must not disable every
        // thread's private buffer. If refill fails, Take below can still split
        // a larger free block; the heap cap and collection policy are unchanged.
        // A different thread may have consumed the exact-bin hint which
        // brought us here. Keep our existing arena if it still has room;
        // replacing it would throw away capacity merely because of a race.
        //
        // THE CHUNK BEING RECYCLED IS ASKED FIRST (recycling, above): a hole
        // that fits, taken from anywhere else, is a hole in whatever chunk
        // it is in, and that chunk is young for the next minor collection to
        // walk. Only when no chunk is left to recycle does an exact-size
        // hole from the free index win over a fresh buffer.
        bool room = Sys.Peek(tb + Tls.AllocPtr) != 0
            && Sys.Peek(tb + Tls.AllocPtr) + need + Smallest <= Sys.Peek(tb + Tls.AllocLimit);
        if (need + Smallest <= BufferBytes
            && (room || Recycle(tb, need) || (!HasReusableFree(need) && Refill(tb, need))))
        {
            long from = Sys.Peek(tb + Tls.AllocPtr);

            Sys.Poke(tb + Tls.AllocPtr, from + need);
            Sys.Poke(from, need);
            Sys.Poke(from + KindAt, kind);
            Sys.Poke(from + need - FooterBytes, need);
            GcLock.Exit();
            return from + HeaderBytes;
        }

        // Large backing arrays must not share their mapping with small,
        // long-lived nodes: one surviving node would pin the whole mapping
        // after the array dies. Give these objects page-rounded chunks whose
        // padding belongs to the same block, so no small allocation enters it.
        bool dedicated = need >= BufferBytes;
        long block = dedicated ? TakeDedicated(need) : Take(need);

        if (block == 0)
        {
            if (!dedicated && Grow(need))
            {
                block = Take(need);
            }
            // A MAPPING OF ITS OWN IS A PREFERENCE, and when it is refused --
            // at the ceiling, above all -- the free space the heap already has
            // comes before a collection. The other way round, every array of
            // 64 KB or more made at the ceiling forced a whole-heap cycle, and
            // a compiler with a gigabyte live and as much again free between
            // its objects marked the gigabyte every hundred megabytes.
            if (block == 0 && dedicated)
            {
                block = Take(need);
            }
        }

        // Growth refused -- the cap, or the operating system. A collection
        // may free enough; if it does not, the last resort is to ask for a
        // chunk once more (the cap may have been met by garbage just freed).
        //
        // SOMEBODY ELSE'S COLLECTION MAY BE HALF WAY THROUGH, marking while
        // this thread runs. It cannot be joined and another cannot be begun;
        // it is waited out, and if what it frees is still not enough -- it
        // frees only what was garbage when it began -- this thread runs one
        // of its own.
        for (long attempt = 0; block == 0 && attempt < 3; attempt++)
        {
            // Memory itself ran out: only a whole collection finds all of it.
            _forceMajor = true;
            if (_collecting) WaitOutCycle();
            else CollectLocked();

            // THE LAST TRY IS NOT HELD AT THE CEILING (GrowthWaits).
            _growPast = attempt == 2;
            block = dedicated ? TakeDedicated(need) : Take(need);

            if (block == 0 && !dedicated && Grow(need))
            {
                block = Take(need);
            }
            // Mapping failure must not reject usable existing free space.
            if (block == 0 && dedicated) block = Take(need);
            _growPast = false;
        }

        if (block == 0)
        {
            SayNumber("out of memory: request ", need);
            SayNumber("out of memory: heap ", HeapChunks.HeapBytes);
            SayNumber("out of memory: since last collection ", _since);
            SayNumber("out of memory: live bytes at last collection ", _liveBytes);
            SayNumber("out of memory: live blocks at last collection ", _liveBlocks);
            SayNumber("out of memory: small free blocks ", _smallFree);
            SayNumber("out of memory: bump bytes remaining ", _limit - _bump);
            SayNumber("out of memory: anchor metadata bytes ", HeapChunks.BlockAnchorBytes);
            if (_bins != 0)
            {
                for (long bin = 0; bin < Bins; bin++)
                {
                    long root = BinHead(bin);
                    if (root == 0) continue;
                    SayNumber("out of memory: free bin ", bin);
                    SayNumber("out of memory: first block ", SizeOfBlock(root));
                }
            }
            OutOfMemory();
        }

        _since = _since + SizeOfBlock(block);
        Count(Sys.ThreadBlock(), SizeOfBlock(block));
        Sys.Poke(block + KindAt, kind);
        GcLock.Exit();
        return block + HeaderBytes;
    }

    /// WHAT THE COLLECTOR WAS DOING when a fault stopped the program, for
    /// the fault report (Runtime.ReportFault): a fault in a live object is
    /// most often a collection's doing, and whether one was marking or
    /// sweeping, and of which kind the last one was, says where to look.
    public static void SayState()
    {
        SayNumber("gc: cycle ", _cycle);
        SayNumber("gc:   minor collections ", MinorCollections);
        SayNumber("gc:   major collections ", MajorCollections);
        SayNumber("gc:   concurrent cycles ", ConcurrentCycles);
        SayNumber("gc:   given up ", Aborted);
        SayNumber("gc:   collecting now ", _collecting ? 1 : 0);
        SayNumber("gc:   sweeping now ", _sweeping ? 1 : 0);
        SayNumber("gc:   marking now ", Runtime.Marking);
        SayNumber("gc:   this or last cycle minor ", _minor ? 1 : 0);
        SayNumber("gc:   frees ", Frees);
        SayNumber("gc:   live bytes ", _liveBytes);
    }

    /// A label and a number on standard error without allocating: the
    /// digits are written into a fixed buffer on the stack of static data.
    static long _digits;            // a page for the digits, mapped in Start

    static void SayNumber(string label, long value)
    {
        Runtime.WriteLiteral(2, label);

        if (_digits == 0)
        {
            return;
        }

        long n = value < 0 ? 0 - value : value;
        int at = 24;

        if (n == 0)
        {
            at = at - 1;
            Sys.PokeByte(_digits + at, 48);
        }

        while (n > 0 && at > 1)
        {
            at = at - 1;
            Sys.PokeByte(_digits + at, 48 + n % 10);
            n = n / 10;
        }

        if (value < 0)
        {
            at = at - 1;
            Sys.PokeByte(_digits + at, 45);
        }

        Platform.WriteBytes(2, _digits + at, 24 - at);
        Runtime.WriteLiteral(2, "\n");
    }

    /// A block of `need` bytes from the free list or the bump pointer, stamped
    /// allocated and with its payload zeroed, or zero.
    static long Take(long need)
    {
        long block = TakeFree(need);

        if (block != 0)
        {
            // Reused memory holds whatever its last owner left; a field read
            // before it is assigned must see its default.
            ZeroWords(block + HeaderBytes, block + SizeOfBlock(block) - FooterBytes);
            return block;
        }

        block = TakeBump(need);

        // Memory above the bump pointer has never been touched since the
        // operating system handed it over zeroed, so it needs no clearing.
        // That is the one reason the bump pointer never moves backwards.
        return block;
    }

    static long TakeDedicated(long need)
    {
        long chunk = HeapChunks.Take(need, true);
        if (chunk == 0) return 0;
        long block = HeapChunks.First(chunk);
        long end = HeapChunks.Limit(chunk);
        Stamp(block, end - block, Zero);
        HeapChunks.SetEnd(chunk, end);
        return block;
    }

    /// A free block of at least `need` bytes: an exact bin's head, or one of
    /// the first few blocks of the request's large bin that fits, else the
    /// head of the next non-empty bin (the free index). The remainder of a larger block is split off
    /// and put back, unless it would be too small to describe itself, in
    /// which case the caller gets it.
    static long TakeFree(long need)
    {
        long bin = BinOf(need);

        // An exact bin's head fits exactly. A large bin's blocks may be
        // smaller than the request: the first few are looked at.
        long block = need <= ExactLimit ? BinHead(bin) : FirstFit(BinHead(bin), need);

        if (block == 0)
        {
            long above = NextNonEmpty(bin + 1);
            if (above >= 0)
            {
                block = BinHead(above);
            }
        }

        if (block == 0)
        {
            return 0;
        }

        long size = SizeOfBlock(block);
        Unlink(block);

        if (size - need >= Smallest)
        {
            long rest = block + need;
            Stamp(rest, size - need, FlagFree);
            Link(rest);
        }
        else
        {
            need = size;
        }
        Stamp(block, need, Zero);
        // WHAT IS HANDED OUT IS YOUNG, and so is the chunk it is in: the next
        // minor collection walks and sweeps it (generations, below).
        HeapChunks.YoungAt(block);
        return block;
    }

    static long TakeBump(long need)
    {
        if (_current == 0 || _bump + need > _limit)
        {
            return 0;
        }

        long block = _bump;
        _bump = _bump + need;
        HeapChunks.SetEnd(_current, _bump);
        Stamp(block, need, Zero);
        HeapChunks.SetYoung(_current, true);
        return block;
    }

    /// Zeroes [from, to) a word at a time. A loop rather than the block-set
    /// intrinsic because the string instruction the backend selects for it
    /// mis-assigns its fixed registers as of this writing (see the note on
    /// Os.CString in lib/sys/linux.cor); a loop is right on any backend.
    static void ZeroWords(long from, long to)
    {
        long p = from;
        long w = WordSize.Bytes;

        // EIGHT WORDS A TURN. Every reused buffer and hole is cleared here,
        // and on a 32-bit processor the pointer is a 64-bit number: a word at
        // a time spent its time adding, comparing and spilling that, not
        // storing.
        long unrolled = to - 8 * w;
        while (p <= unrolled)
        {
            Sys.Poke(p, Zero);
            Sys.Poke(p + w, Zero);
            Sys.Poke(p + 2 * w, Zero);
            Sys.Poke(p + 3 * w, Zero);
            Sys.Poke(p + 4 * w, Zero);
            Sys.Poke(p + 5 * w, Zero);
            Sys.Poke(p + 6 * w, Zero);
            Sys.Poke(p + 7 * w, Zero);
            p = p + 8 * w;
        }

        while (p < to)
        {
            Sys.Poke(p, Zero);
            p = p + w;
        }
    }

    /// Under a control group's memory limit the heap is capped as .NET caps
    /// it in a container: three quarters of the limit, and never below 20 MB
    /// -- the rest is the program's code, stacks and the collector's own
    /// tables. The cap paces the collector and is the total GC.GetGCMemoryInfo
    /// reports, which is what the build sizes its parallel work by.
    const long ContainerFloor = 20971520;

    /// The heap's ceiling for the address space this process has.
    static void SetCeiling()
    {
        HeapCeiling = Platform.AddressSpace() > 3221225472 ? WideCeiling : NarrowCeiling;
    }

    static void Start()
    {
        _verify = Platform.VerifyFrees();
        IgnoredFrees = Platform.IgnoreFrees();
        if (Platform.FreeLog())
        {
            Runtime.StartFreeLog();
        }
        if (_verify)
        {
            StartQuarantine();
        }
        SetCeiling();
        if (HeapChunks.Cap == 0)
        {
            long limit = Platform.MemoryLimit();
            if (limit != 0)
            {
                long cap = limit / 4 * 3;
                HeapChunks.SetLimit(cap > ContainerFloor ? cap : ContainerFloor);
            }
        }
        _ready = true;
        _threshold = MinThreshold;
        _digits = Platform.Map(4096);
        _bins = Platform.Map(BinsBytes);

        if (_bins == 0)
        {
            OutOfMemory();
        }
        _barrier = Platform.Map(BarrierBytes);
        _markAt = Platform.Map(MarkBytes);

        if (_markAt != 0)
        {
            _markBytes = MarkBytes;
            _markCount = MarkBytes / GreyEntry;
        }
        StartGenerations();
    }

    /// Nothing left: the message is a literal, which is data the compiler laid
    /// out and not an object this heap made, so printing it allocates nothing.
    static void OutOfMemory()
    {
        OutOfMemory("out of memory: the operating system would give no more\n");
    }

    /// The report, and then WHO ASKED: the frame table the code generator
    /// writes says what each address in the image is, and the saved frame
    /// pointers are a list of callers with each return address beside them.
    /// Runtime.SayTrace walks the one and writes names out of the other
    /// without building anything, which is the only kind of trace this path
    /// may print -- Exception.StackTrace's needs a string, and a string needs
    /// the heap that has just run out.
    static void OutOfMemory(string text)
    {
        Runtime.WriteLiteral(2, text);
        // WHAT THE HEAP HELD, for whoever reads the report: whether the live
        // size ran into the ceiling, or the chunks did while little was live.
        SayNumber("  heap bytes ", HeapChunks.HeapBytes);
        SayNumber("  live at the last collection ", _liveBytes);
        SayNumber("  allocated since ", _since);
        SayNumber("  threshold ", _threshold);
        SayNumber("  ceiling ", HeapCeiling);
        SayNumber("  collections ", Collections);
        SayNumber("  of them major ", MajorCollections);
        SayNumber("  mark queue bytes ", _markBytes);
        Runtime.SayTrace(2, Sys.FramePointer());
        Platform.Exit(137);
    }

    // ---- giving memory back by hand -----------------------------------------------
    //
    // The COMPILER calls this, through Runtime.Free, for the objects it
    // proves dead: a tier 1 allocation whose size is not a constant and so
    // could not become a frame slot, and a tier 2 owned object at the last
    // use the optimiser found (X86-BACKEND.md, "Memory"). A program still
    // never frees anything itself, and this is exactly as safe as the proof
    // behind it -- a freed object still referenced is memory handed out twice,
    // which is why only the optimiser, and not source, is allowed to say it.

    /// Returns an allocation to the free list, merged with its free
    /// neighbours. Boundary tags find the neighbours directly; exact bins
    /// unlink in constant time and large-bin trees in logarithmic time.
    /// Anything that is not exactly the payload of a live
    /// block -- zero, a null reference, an interior pointer, a frame slot, a
    /// pointer into someone else's memory, a block already free -- is ignored,
    /// because the compiler frees what it has proved dead and a wrong proof
    /// must cost nothing worse than the memory it forgot to give back.
    public static void Free(long at)
    {
        // NOT ON TOP OF THE ALLOCATOR, NOR OF THE HEAP LOCK'S HOLDER. A
        // kernel's thread is a processor, and the compiler's frees reach
        // interrupt handlers too: a handler that lets go of an owned field
        // frees with nothing allocated. Landed inside the allocator's fast
        // path (Tls.InAlloc), the top-of-buffer rewind below would move the
        // bump pointer the code under it has read and not yet moved; landed
        // on the lock's holder, GcLock.Enter would wait on itself for ever.
        // The object is left to the collector, as a wrong proof's is.
        //
        // A null first, which an owned variable's first assignment hands
        // over (FreeReplaced), and with no thread block nothing to read:
        // before one exists there is no fast path to be on top of.
        if (at == 0 || IgnoredFrees != 0 && IgnoredFrees != 'p' && IgnoredFrees != 'f' && IgnoredFrees != 'r')
        {
            return;
        }
        long self = Sys.ThreadBlock();
        if (self != 0 && Sys.Peek(self + Tls.InAlloc) != 0 || GcLock.HeldByMe())
        {
            return;
        }

        if (Verifying())
        {
            GcLock.Enter();
            VerifyFree(at);
            GcLock.Exit();
            return;
        }

        // NOTHING IS FREED WHILE A MARK IS UNDER WAY. The marker reads and
        // flags the objects of its snapshot with nothing held; an object
        // that went back to the free list under it, was merged with its
        // neighbour and handed out again, would have its flags written into
        // the middle of somebody's data. The sweep that ends the mark finds
        // it unreferenced and frees it then.
        if (Runtime.Marking != 0 || _sweeping)
        {
            return;
        }

        long tb = Sys.ThreadBlock();

        // THE TOP BLOCK OF THIS THREAD'S OWN BUFFER goes straight back to it:
        // the last thing the thread bumped is the next thing it will get, at
        // the same address, through the fast path and with no lock -- which is
        // the whole of what a formatting buffer or an enumerator in a loop
        // costs. Only this thread may touch this buffer, so nothing is held.
        //
        // NOT TO BE ANSWERED FOR IN THE MIDDLE (Tls.InAlloc, as in Alloc): a
        // collector stamping this buffer's objects for the thread, or
        // unmarking them, reads the pointer this is about to move.
        //
        // AND KNOWN WITHOUT THE CHUNK INDEX. A block inside this thread's own
        // live buffer is mapped, and its header is this thread's to read; the
        // index is not anybody's to read without the heap lock -- a chunk
        // released and unmapped, or the index itself moved, under a reader
        // that had no lock faulted inside HeapChunks.Of. Every other block is
        // validated under the lock, below.
        long inside = Sys.Peek(tb + Tls.InAlloc);
        Sys.Poke(tb + Tls.InAlloc, 1);
        long ptr = Sys.Peek(tb + Tls.AllocPtr);
        long block = at - HeaderBytes;
        long word = 0;
        long size = 0;
        if (ptr != 0 && (at & 7) == 0 && block >= Sys.Peek(tb + Tls.AllocBase) && block < ptr)
        {
            word = Sys.Peek(block);
            size = word & SizeMask;
        }

        // Not while a collection is anywhere under way: the block may carry
        // the snapshot's start, and an object bumped into it again would be
        // swept as the one that was freed.
        if (Runtime.Marking == 0 && !_sweeping && !_collecting && size >= Smallest && (word & FlagFree) == 0
            && block + size == ptr && Sys.Peek(block + size - FooterBytes) == word)
        {
            // The fast path's one assumption is that memory above the pointer
            // has never been written; the bytes are cleared here instead.
            ZeroWords(block, ptr);
            Sys.Poke(tb + Tls.AllocPtr, block);
            Frees = Frees + 1;
            Sys.Poke(tb + Tls.InAlloc, inside);
            return;
        }

        Sys.Poke(tb + Tls.InAlloc, inside);
        GcLock.Enter();

        // AGAIN, NOW THAT THE LOCK IS HELD, and for the WHOLE of a collection,
        // not only while it marks or sweeps. A collection begins with this lock
        // held and its snapshot says this block is an object; freed and handed
        // out again before the sweep, the new object would carry the old one's
        // start and be swept as the old one, dead -- and a dedicated chunk
        // given back here would be walked by the sweep after it was unmapped.
        if (Runtime.Marking != 0 || _sweeping || _collecting)
        {
            GcLock.Exit();
            return;
        }

        block = ValidAllocated(at);
        if (block == 0)
        {
            GcLock.Exit();
            return;
        }
        size = SizeOfBlock(block);

        SyncEnd();

        // The bytes go back off the pressure counter. `_since` measures how
        // much of the heap has gone out and not come back, because that is
        // what says a collection would find something; memory returned by
        // hand has already been found, and counting it again would collect a
        // program that frees everything it allocates -- exactly the program
        // that needs no collection at all.
        _since = _since - size;

        if (_since < 0)
        {
            _since = 0;
        }
        Frees = Frees + 1;

        // Dedicated arrays own their complete chunk, including page padding.
        // Return it directly rather than putting it into bins where small
        // objects could occupy it and pin the former large-object mapping.
        long whole = HeapChunks.Of(block);
        if (whole != 0 && whole != _current && block == HeapChunks.First(whole)
            && block + size == HeapChunks.Limit(whole))
        {
            // Not a chunk the recycling walk may still step onto.
            if (whole == _recycleNext) _recycleNext = HeapChunks.Next(whole);
            if (whole == _recycle) _recycle = Zero;
            HeapChunks.Release(whole);
            GcLock.Exit();
            return;
        }

        // A BLOCK INSIDE A LIVE ALLOCATION BUFFER, WITH OTHER THREADS RUNNING,
        // IS FREED WHERE IT LIES: marked free and in place (InPlace), and left
        // out of the bins until its buffer is retired (Retire links it then).
        // A buffer is its thread's alone -- STAMP walks it as that thread's
        // chain of blocks and the sweep steps over it whole -- and a block of
        // it out of a bin, handed to another thread as an object or taken as
        // that thread's whole buffer inside this one, broke both: the owner's
        // objects went unstamped and were swept while still referenced. With
        // one thread there is nobody to hand it to, and it goes to its bin at
        // once, for the thread's own next allocation of its size.
        long holder = GcThreads.BufferHolding(block);

        if (holder != 0 && GcThreads.Others())
        {
            FreeInPlace(block, size);
            GcLock.Exit();
            return;
        }

        // THE TOP BLOCK GOES BACK TO THE BUMP POINTER, not to a bin. A small
        // object allocated and freed in a loop -- the formatting buffer, the
        // enumerator, the closure the optimiser could not turn into a frame
        // slot -- is the last thing the bump pointer handed out, so giving
        // the bytes straight back means the next allocation reuses the same
        // address through the fast path and the heap does not move at all.
        //
        // The cost is restoring the fast path's one assumption: memory above
        // the bump pointer has never been written, so allocation zeroes
        // nothing. The bytes are cleared here instead, which is why only
        // small blocks take this road -- clearing a megabyte on the way past
        // would be a worse bargain than a bin.
        if (holder == 0 && _current != 0 && block + size == _bump && size <= ExactLimit
            && block >= HeapChunks.First(_current))
        {
            ZeroWords(block, _bump);
            _bump = block;
            SyncEnd();
            GcLock.Exit();
            return;
        }
        Merge(block);
        GcLock.Exit();
    }

    /// How many calls to Free actually returned a block. A test reads it to
    /// tell a free that happened from one that was ignored.
    public static long Frees;

    // CHECKED MODE FOR THE COMPILER'S FREES (Platform.VerifyFrees; on Linux,
    // CORSAC_VERIFY_FREES=1 in the environment). A free is otherwise quiet
    // about what it is handed and gives the bytes straight back, so a wrong
    // one -- an object still in use, one freed twice -- reads as a working
    // program until the bytes happen to be taken again. Checked, a freed
    // block is never given back: its payload is filled with a pattern no
    // pointer has and it becomes a leaf the collector reclaims once nothing
    // reaches it. A read after the free finds the pattern (and a pointer read
    // through it faults) instead of whatever came next; a second free of it
    // is reported and ends the process with 97. A pointer that is not an
    // object at all -- static data a reassigned variable held -- is ignored,
    // as it always is.
    //
    // ASKED ONCE, IN Start, ON THE MAIN THREAD. The environment is found
    // through the loader's stack, and Sys.EntryStack is the stack of the
    // thread asking: a child thread's first free, asking itself, read its
    // own stack as if it were the environment and faulted. Start runs at
    // the first allocation, before any thread can exist.
    static bool _verify;
    /// Which frees are ignored (CORSAC_IGNORE_FREES, Platform.IgnoreFrees): 0
    /// none; 'p', 'f' or 'r' one kind, which Runtime asks; anything else all.
    public static long IgnoredFrees;
    const long Poison = 0xFEEEFEEE;

    /// How many blocks the checked mode has taken back and filled.
    public static long VerifiedFrees;

    static bool Verifying()
    {
        return _verify;
    }

    // THE LAST FREES KEPT, in the checked mode. A block freed twice is found
    // by its pattern only while it is still the freed block: once the
    // collector has taken it back and handed it out again, a second free
    // lands on the new object -- a list's array, taken from under the list --
    // and nothing can tell. So the blocks freed last stay out of the
    // collector's hands: a ring of their addresses is a root range, and a
    // block leaves the ring only when later frees have pushed it out --
    // sixteen million of them, more than a compile of a
    // large unit makes, so a free that comes long after the block's first
    // is caught too; the ring is mapped lazily and only this mode has one.
    // Its first word counts the frees.
    const long QuarantineEntries = 16777216;
    static long _quarantine;

    static void StartQuarantine()
    {
        long bytes = (QuarantineEntries + 1) * WordSize.Bytes;
        long ring = Platform.Map(bytes);
        if (ring != 0 && Runtime.RegisterRoots(ring + WordSize.Bytes, ring + bytes))
        {
            _quarantine = ring;
        }
    }

    static void Quarantine(long at)
    {
        if (_quarantine == 0)
        {
            return;
        }
        long n = Sys.AtomicAdd(_quarantine, 1);
        Sys.Poke(_quarantine + WordSize.Bytes + (n % QuarantineEntries) * WordSize.Bytes, at);
    }

    /// In the checked mode, a field free (Runtime.FreeField) whose OWNER has
    /// already been freed: the field is read out of a block that belongs to
    /// nobody -- to whoever was handed it next, when frees are not checked --
    /// and what it holds is freed. Reported with both frees, and fatal (98).
    public static void VerifyFieldOwner(long owner, long offset)
    {
        if (!_verify || owner == 0 || GcLock.HeldByMe())
        {
            return;
        }
        // Under the heap lock: the chunk index is not read without it.
        GcLock.Enter();
        long block = ValidAllocated(owner);
        long end = block == 0 ? 0 : block + SizeOfBlock(block) - FooterBytes;
        bool freed = block != 0 && Sys.Peek(block + KindAt) == KindLeaf && Sys.PeekWord(owner) == Poison
            && (owner + 4 >= end || Sys.PeekWord(owner + 4) == Poison);
        GcLock.Exit();
        if (!freed)
        {
            return;
        }
        SayNumber("gc: checked free: a field freed out of an owner already freed, owner ", owner);
        SayNumber("gc:   field offset ", offset);
        Runtime.WriteLiteral(2, "gc: the owner was freed by:\n");
        long site = end - 4;
        while (site >= owner + 8)
        {
            long first = Sys.PeekWord(site);
            if (first == Poison || first == 0)
            {
                break;
            }
            Runtime.SayFrame(2, first + 0x08000000);
            site = site - 4;
        }
        Runtime.WriteLiteral(2, "gc: its field is freed now by:\n");
        Runtime.SayTrace(2, Sys.FramePointer());
        Platform.Exit(98);
    }

    static void VerifyFree(long at)
    {
        if (at == 0)
        {
            return;
        }
        long block = ValidAllocated(at);
        if (block == 0)
        {
            return;
        }
        long end = block + SizeOfBlock(block) - FooterBytes;
        if (Sys.Peek(block + KindAt) == KindLeaf && Sys.PeekWord(at) == Poison && (at + 4 >= end || Sys.PeekWord(at + 4) == Poison))
        {
            SayNumber("gc: checked free: freed twice, block ", at);
            // Who freed it first -- the return addresses the first free left
            // in the block's last words (below), less 0x08000000 -- and who
            // frees it now.
            Runtime.WriteLiteral(2, "gc: first freed by:\n");
            long site = end - 4;
            while (site >= at + 8)
            {
                long first = Sys.PeekWord(site);
                if (first == Poison || first == 0)
                {
                    break;
                }
                Runtime.SayFrame(2, first + 0x08000000);
                site = site - 4;
            }
            Runtime.WriteLiteral(2, "gc: freed again by:\n");
            Runtime.SayTrace(2, Sys.FramePointer());
            Platform.Exit(97);
        }
        long p = at;
        while (p < end)
        {
            Sys.PokeWord(p, Poison);
            p = p + 4;
        }
        // AND WHO FREED IT, in the block's last words: the return addresses
        // of the calls that led here, less 0x08000000 so that none of them
        // is a pointer either (a read through one still faults, low in the
        // space where nothing is mapped). The first words keep the pattern,
        // which the double-free check reads and most reads after a free
        // meet first. Add 0x08000000 back and ask nm, or gdb's info symbol.
        long frame = Sys.FramePointer();
        long slot = end - 4;
        int depth = 0;
        while (depth < 6 && slot >= at + 8 && frame != 0)
        {
            long next = Sys.Peek(frame);
            long back = Sys.Peek(frame + WordSize.Bytes) & WordSize.AddressMask;
            if (back < 0x08000000 || next != 0 && next <= frame)
            {
                break;
            }
            Sys.PokeWord(slot, back - 0x08000000);
            slot = slot - 4;
            depth = depth + 1;
            frame = next;
        }
        Sys.Poke(block + KindAt, KindLeaf);
        Quarantine(at);
        VerifiedFrees = VerifiedFrees + 1;
        Frees = Frees + 1;
    }

    /// The header of an exact, live allocation, or zero for anything foreign,
    /// interior, malformed or already free.
    static long ValidAllocated(long at)
    {
        if ((at & 7) != 0 || at < HeaderBytes)
        {
            return 0;
        }

        long block = at - HeaderBytes;
        long chunk = HeapChunks.Of(block);

        if (chunk == 0)
        {
            return 0;
        }

        long end = HeapChunks.End(chunk);
        long word = Sys.Peek(block);
        long size = word & SizeMask;

        if (size < Smallest || block + size > end || (word & FlagFree) != 0)
        {
            return 0;
        }
        if (Sys.Peek(block + size - FooterBytes) != word)
        {
            return 0;
        }
        return block;
    }

    /// Frees a block and coalesces it with a free neighbour on either side.
    static void Merge(long block)
    {
        long chunk = HeapChunks.Of(block);

        if (chunk == 0)
        {
            return;
        }

        long first = HeapChunks.First(chunk);
        long end = HeapChunks.End(chunk);
        long size = SizeOfBlock(block);

        // Forward: the block after this one starts where this one ends.
        long next = block + size;

        long holder = GcThreads.BufferHolding(block);

        if (next < end && IsFree(next) && !IsInPlace(next) && GcThreads.BufferHolding(next) == holder)
        {
            Unlink(next);
            size = size + SizeOfBlock(next);
        }

        // Backward: through the footer of the block below, which is the word
        // just under this header. That is what the footer is for.
        if (block > first)
        {
            long back = Sys.Peek(block - FooterBytes);

            long prev = block - (back & SizeMask);

            if ((back & FlagFree) != 0 && !IsInPlace(prev) && GcThreads.BufferHolding(prev) == holder)
            {

                Unlink(prev);
                size = size + SizeOfBlock(prev);
                block = prev;
            }
        }

        Stamp(block, size, FlagFree);
        Link(block);
    }

    // ---- collecting -------------------------------------------------------------

    /// The block a word might point at or into, or zero.
    ///
    /// The header and footer agreeing is a strong test: two words, far apart,
    /// both saying the same size, on an eight-byte boundary, inside the heap.
    /// A number that passes by accident costs one retained block.
    ///
    /// An exact payload address is the common case and constant time. An
    /// INTERIOR pointer -- a span into the middle of an array, an address
    /// computed by the string routines -- starts at the first block touching
    /// its page. The collection-time anchors preserve the authoritative block
    /// walk and its inclusive payload-end rule, without starting at the
    /// beginning of a potentially very densely populated megabyte chunk.
    static long BlockForPointer(long at)
    {
        if (_snapshots)
        {
            return SnapshotBlock(at);
        }

        // One past a payload -- a span's end -- is one past the block's
        // footer's start, which is still inside the chunk's used extent, so
        // the plain lookup finds it; no boundary case needs a second look.
        long chunk = HeapChunks.Of(at);

        if (chunk == 0 || (_minor && !HeapChunks.IsYoung(chunk)))
        {
            return 0;
        }

        long first = HeapChunks.First(chunk);
        long end = HeapChunks.End(chunk);

        if ((at & 7) == 0 && at >= first + HeaderBytes)
        {
            long exact = at - HeaderBytes;
            long word = Sys.Peek(exact);
            long size = word & SizeMask;

            if (size >= Smallest && exact + size <= end
                && Sys.Peek(exact + size - FooterBytes) == word)
            {
                return exact;
            }
        }

        long block = HeapChunks.MarkStart(chunk, at);

        while (block < end)
        {
            // Blocks advance monotonically. Once this payload starts after
            // the candidate, no later block can contain it. The preceding
            // block's inclusive one-past-end test has already had its turn.
            if (at < block + HeaderBytes) return 0;

            long word = Sys.Peek(block);
            long size = word & SizeMask;

            if (size < Smallest || block + size > end
                || Sys.Peek(block + size - FooterBytes) != word)
            {
                // The chain of sizes is broken; nothing below is trustworthy.
                return 0;
            }

            // The payload, INCLUDING one past its end: a span's end pointer is
            // a real root, and retaining one block by accident is the cheap
            // side of that bet.
            if (at >= block + HeaderBytes && at <= block + size - FooterBytes)
            {
                return block;
            }
            WalkSteps = WalkSteps + 1;
            block = block + size;
        }
        return 0;
    }

    /// The object of the snapshot that `at` points into, or 0. Reads the
    /// snapshot's own tables and one header that no running thread writes:
    /// safe with the world running.
    static long SnapshotBlock(long at)
    {
        long chunk = HeapChunks.OfSnapshot(at);

        if (chunk == 0 || HeapChunks.StartsCycle(chunk) != _cycle)
        {
            return 0;
        }

        // A payload begins a header past its block, so the block begins at
        // or below `at - HeaderBytes`; the nearest start at or below that
        // is the only candidate, and its size says whether it reaches.
        long highest = (at - HeaderBytes) & -8;

        if (highest < HeapChunks.First(chunk))
        {
            return 0;
        }

        // A REFERENCE IS A PAYLOAD'S START nearly always -- an interior
        // pointer is a span or a string routine's -- and that is one bit.
        if ((at & 7) == 0 && HeapChunks.IsStart(chunk, highest))
        {
            return highest;
        }

        long block = HeapChunks.StartAtOrBelow(chunk, highest);

        if (block == 0)
        {
            return 0;
        }

        long size = Sys.Peek(block) & SizeMask;

        if (size < Smallest || at > block + size - FooterBytes)
        {
            return 0;
        }

        return block;
    }

    // ---- marking, by many threads at once --------------------------------
    //
    // THE COLLECTOR IS NOT THE ONLY MARKER. A store's barrier marks what it
    // overwrites and what it writes; a thread that allocates while a mark is
    // under way scans a few queued blocks before it goes on; an idle
    // processor scans until there is nothing left; the collecting thread
    // scans most. So a mark is a compare-and-swap on the header -- exactly one
    // thread wins it, and that thread queues the block -- and the queue is a
    // ring many threads push to and take from with nothing held (the barrier
    // ring's signature scheme, with a compare-and-swap to take as well).
    //
    // A FULL QUEUE LOSES NOTHING. A block that could not be queued keeps its
    // mark and the Overflow word says so; a rescan pass (RescanMarked) finds
    // every block marked and not yet scanned, and scans it.

    const long GreyEntry = 2 * WordSize.Bytes;       // a signature and a block

    static long GreySignature(long place)
    {
        return (place & 0x7FFFFFFF) | 0x80000000;
    }

    /// Queues a block this thread has just marked.
    static void PushGrey(long block)
    {
        long ctl = GcLock.Words();

        while (true)
        {
            long tail = Sys.Peek(ctl + GcLock.GreyTail) & WordSize.AddressMask;
            long head = Sys.Peek(ctl + GcLock.GreyHead) & WordSize.AddressMask;

            if (_markAt == 0 || ((tail - head) & WordSize.AddressMask) >= _markCount)
            {
                Sys.AtomicSwap(ctl + GcLock.Overflow, 1);
                return;
            }

            // Claimed with a compare-and-swap and not an add, so that a place
            // is only ever claimed when it is free: an add past a full ring
            // would leave a claim nobody fills, and every taker would stop at
            // it for good.
            if ((Sys.Cas(ctl + GcLock.GreyTail, tail, (tail + 1) & WordSize.AddressMask) & WordSize.AddressMask) != tail)
            {
                continue;
            }

            long at = _markAt + (tail & (_markCount - 1)) * GreyEntry;
            Sys.Poke(at + WordSize.Bytes, block);
            Sys.AtomicSwap(at, GreySignature(tail));

            long depth = (tail + 1 - head) & WordSize.AddressMask;
            if (depth > _markPeak) _markPeak = depth;
            return;
        }
    }

    /// The next queued block, or 0 when there is none ready to take -- the
    /// queue is empty, or the next place is claimed and not yet written,
    /// which its pusher is a few instructions from doing.
    static long PopGrey()
    {
        long ctl = GcLock.Words();

        while (true)
        {
            long head = Sys.Peek(ctl + GcLock.GreyHead) & WordSize.AddressMask;
            long tail = Sys.Peek(ctl + GcLock.GreyTail) & WordSize.AddressMask;

            if (head == tail || _markAt == 0)
            {
                return 0;
            }

            long at = _markAt + (head & (_markCount - 1)) * GreyEntry;

            if ((Sys.Peek(at) & WordSize.AddressMask) != GreySignature(head))
            {
                return 0;
            }

            // Read before the take: once the head has moved past this place a
            // pusher may claim it again and write over the block.
            long block = Sys.Peek(at + WordSize.Bytes);

            if ((Sys.Cas(ctl + GcLock.GreyHead, head, (head + 1) & WordSize.AddressMask) & WordSize.AddressMask) == head)
            {
                return block;
            }
        }
    }

    /// Whether marking has nothing left in hand: the queue is empty and no
    /// thread is scanning a block it took. Read in that order, so that a
    /// thread between taking the last block and scanning it is seen.
    static bool GreyIdle()
    {
        long ctl = GcLock.Words();
        long head = Sys.Peek(ctl + GcLock.GreyHead) & WordSize.AddressMask;
        long tail = Sys.Peek(ctl + GcLock.GreyTail) & WordSize.AddressMask;
        return head == tail && Sys.Peek(ctl + GcLock.Active) == 0;
    }

    /// Adds `flag` to a block's header -- and then its footer -- against every
    /// other thread doing the same. True only for the thread that set it;
    /// false for a free block and for one that already had it.
    static bool SetFlag(long block, long flag)
    {
        while (true)
        {
            long word = Sys.Peek(block) & WordSize.AddressMask;

            if ((word & FlagFree) != 0 || (word & flag) != 0)
            {
                return false;
            }

            if ((Sys.Cas(block, word, word | flag) & WordSize.AddressMask) == word)
            {
                SyncFooter(block);
                return true;
            }
        }
    }

    /// The footer brought up to the header. Two threads adding two flags
    /// may write their footers in either order; the one that sees the header
    /// change under it writes again.
    static void SyncFooter(long block)
    {
        while (true)
        {
            long word = Sys.Peek(block);
            Sys.Poke(block + (word & SizeMask) - FooterBytes, word);

            if (Sys.Peek(block) == word)
            {
                return;
            }
        }
    }

    /// Marks the block a word might refer to and queues it for scanning.
    static void MarkAt(long at)
    {
        MarkCalls = MarkCalls + 1;
        long block = BlockForPointer(at);

        // A word pointing at a free block is a number that happens to look
        // like a pointer: SetFlag refuses it.
        if (block == 0 || !SetFlag(block, FlagMark))
        {
            return;
        }

        // Nothing in it to follow: scanned as soon as marked.
        if (Sys.Peek(block + KindAt) == KindLeaf)
        {
            SetFlag(block, FlagScan);
            return;
        }

        Sys.AtomicAdd(GcLock.Words() + GcLock.Pushes, 1);
        PushGrey(block);
    }

    /// Scans queued blocks until there are none ready.
    static void Drain()
    {
        DrainSome(-1);
    }

    /// Scans at most `budget` queued blocks -- all of them when it is
    /// negative -- and answers how many. Any thread may: the one that takes
    /// a block scans it, and says it is busy (Active) from before the take
    /// until after the scan, so that nobody decides the mark is over while
    /// a block is in its hands.
    static long DrainSome(long budget)
    {
        long ctl = GcLock.Words();
        long done = 0;

        // BUSY ONCE FOR THE RUN, not once a block: from before the first take
        // to after the last scan the thread holds a block or is about to, and
        // two locked additions a block were a large part of what marking a
        // gigabyte cost.
        Sys.AtomicAdd(ctl + GcLock.Active, 1);

        while (budget < 0 || done < budget)
        {
            if (Sys.Peek(ctl + GcLock.Abort) != 0)
            {
                break;
            }

            long block = PopGrey();

            if (block == 0)
            {
                break;
            }

            if (SetFlag(block, FlagScan))
            {
                ScanBlock(block, Sys.Peek(block) & SizeMask);
            }

            done = done + 1;
        }

        Sys.AtomicAdd(ctl + GcLock.Active, -1);
        return done;
    }

    /// Whether a push found the queue full since this was last asked.
    static bool TakeOverflow()
    {
        if (Sys.AtomicSwap(GcLock.Words() + GcLock.Overflow, 0) == 0)
        {
            return false;
        }
        AskForBiggerQueue();
        return true;
    }

    /// AN OVERFLOW ASKS THE NEXT CYCLE FOR FOUR TIMES THE QUEUE, as far as a
    /// thirty-second of the heap (a power of two, as the ring's index needs).
    /// This cycle rescans as it always has; the queue is changed only between
    /// cycles, when it is empty (FitMarkQueue). A small heap therefore never
    /// grows past the queue it started with.
    static void AskForBiggerQueue()
    {
        long share = HeapChunks.HeapBytes / MarkShare;
        long bigger = _markBytes * 4;
        while (bigger > _markBytes && bigger > share)
        {
            bigger = bigger / 2;
        }
        if (bigger > _markBytes && bigger > _markWanted)
        {
            _markWanted = bigger;
        }
    }

    /// The queue an overflow asked for, taken now, while no mark is under
    /// way and the ring is empty. The new ring reads as empty from its first
    /// place, whatever the head and tail count: an unwritten place never
    /// carries a signature (GreySignature sets the top bit). A system that
    /// will not give the memory keeps the old queue, which still works.
    static void FitMarkQueue()
    {
        long wanted = _markWanted;
        _markWanted = 0;
        if (wanted <= _markBytes)
        {
            return;
        }
        long fresh = Platform.Map(wanted);
        if (fresh == 0)
        {
            return;
        }
        if (_markAt != 0)
        {
            Platform.Unmap(_markAt, _markBytes);
        }
        _markAt = fresh;
        _markBytes = wanted;
        _markCount = wanted / GreyEntry;
    }

    /// A ROOT RANGE REGISTERED WHILE A MARK IS UNDER WAY IS MARKED FROM NOW.
    /// The registered ranges are read once a collection, with the
    /// collector's own roots (GcRoots.ScanAll, before the SCAN round); a
    /// thread's stack is read when it answers SCAN, from wherever it stands
    /// then. A kernel's thread is a processor, and a process parks its
    /// kernel stack (a registered range, KernelContinuation) and goes to
    /// the scheduler's: parked after the roots were read and before its
    /// processor answered, the stack was neither -- the processor answered
    /// from the scheduler's stack -- and an object only it held was swept
    /// under a live frame. An exec's ElfLoader, held by its frame through
    /// every disc read, became another exec's symbol names, and four
    /// processors took page faults in Bind and Reach (2026-09-26).
    ///
    /// Marked here the way the barrier marks once pointers resolve
    /// (Marking 2); in the stamping phase before it (Marking 1) the range
    /// is read with the roots, which have not been yet. Not answered for in
    /// the middle (Tls.InAlloc), as the barrier is not: a round that saw
    /// this thread out would let the mark end with a push still to come.
    ///
    /// THE REGISTERS FIRST. The range is the stack this runs on, registered
    /// before its owner's registers are spilled into it, so a reference
    /// held only in EBX, ESI or EDI is not in it yet. Three longs live
    /// across the scan are six halves in the three registers a call
    /// preserves, and the prologue here pushes the caller's values of them
    /// inside the range, as Platform.EnterCollection does for the collector.
    public static void MarkRegistered(long start, long end)
    {
        // The range is published (GcRoots.Register) before this reads the
        // phase, and the collector sets the phase before it reads the
        // ranges: one of the two sees the other.
        Sys.Fence();

        if (Runtime.Marking == 0)
        {
            return;
        }

        long tb = Sys.ThreadBlock();
        long was = Sys.Peek(tb + Tls.InAlloc);
        Sys.Poke(tb + Tls.InAlloc, 1);
        Sys.Fence();

        if (Runtime.Marking == 2)
        {
            long a = _spill + 1;
            long b = _spill + 2;
            long c = _spill + 3;
            ScanRange(start, end);
            _spill = a + b + c;
            RegisteredMidMark = RegisteredMidMark + 1;
        }

        Sys.Poke(tb + Tls.InAlloc, was);
    }

    /// Where MarkRegistered's register pressure is kept, so that nothing can
    /// prove it dead. Never read for its value.
    static long _spill;

    /// Root ranges marked from as they were registered, a mark under way.
    public static long RegisteredMidMark;

    /// Marks everything reachable from a range of memory, a word at a time.
    /// Public because GcRoots feeds the roots through it.
    /// A marked block's references marked in turn: none for a leaf, the
    /// ones its descriptor names for an object, every word for the rest.
    static void ScanBlock(long block, long size)
    {
        long kind = Sys.Peek(block + KindAt);
        if (kind == KindLeaf)
        {
            return;
        }
        long payload = block + HeaderBytes;
        long end = block + size - FooterBytes;
        if (kind != KindObject || !ScanObject(payload, end))
        {
            ScanRange(payload, end);
        }
    }

    /// AN OBJECT BY ITS DESCRIPTOR: the words its reference map names, or,
    /// for an array of references, its elements. False when the object
    /// cannot be read that way -- no vtable yet (made, not yet described:
    /// nothing is in it), a first word that is not a descriptor's vtable, an
    /// array of anything but references, a count past the block -- and the
    /// caller scans every word instead, which is never wrong.
    static bool ScanObject(long payload, long end)
    {
        long w = WordSize.Bytes;
        long vt = Sys.Peek(payload) & WordSize.AddressMask;
        if (vt == 0)
        {
            return false;
        }
        long desc = vt - DescWords * w;
        if ((Sys.Peek(desc + DescSelfWord * w) & WordSize.AddressMask) != desc)
        {
            return false;
        }
        long flags = Sys.Peek(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0)
            {
                return true;
            }
            if ((Sys.Peek(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0
                || Sys.Peek(desc + DescSizeWord * w) != w)
            {
                return false;
            }
            long count = Sys.Peek(payload + ArrayCountAt) & 0x7FFFFFFF;
            long first = payload + Sys.Peek(desc + DescPayloadWord * w);
            long last = first + count * w;
            if (last > end || last < first)
            {
                return false;
            }
            ScanRange(first, last);
            return true;
        }
        long map = Sys.Peek(desc + DescRefMapWord * w) & WordSize.AddressMask;
        if (map == 0)
        {
            return true;
        }
        // The map: how many words it covers, then 32 bits to a word.
        long words = Sys.Peek(map);
        long k = 0;
        while (k * 32 < words)
        {
            long bits = Sys.Peek(map + (1 + k) * w) & 0xFFFFFFFF;
            long bit = 0;
            while (bits != 0)
            {
                if ((bits & 1) != 0)
                {
                    long at = payload + (k * 32 + bit) * w;
                    if (at + w <= end)
                    {
                        MarkAt(Sys.Peek(at));
                    }
                }
                bits = bits >> 1;
                bit = bit + 1;
            }
            k = k + 1;
        }
        return true;
    }

    /// Whether the marker reads the word at `at` of a block -- ScanBlock's
    /// and ScanObject's rules, for the verifier (VerifyMinor), which must
    /// not report a number in an object's int field that looks like an
    /// address: the marker never follows it, and nothing depends on it.
    static bool MarkerReads(long block, long size, long at)
    {
        long w = WordSize.Bytes;
        long payload = block + HeaderBytes;
        long end = block + size - FooterBytes;
        long kind = Sys.Peek(block + KindAt);
        if (kind == KindLeaf)
        {
            return false;
        }
        long vt = Sys.Peek(payload) & WordSize.AddressMask;
        if (kind != KindObject || vt == 0)
        {
            return true;
        }
        long desc = vt - DescWords * w;
        if ((Sys.Peek(desc + DescSelfWord * w) & WordSize.AddressMask) != desc)
        {
            return true;
        }
        long flags = Sys.Peek(desc + DescFlagsWord * w);
        if ((flags & SequenceFlag) != 0)
        {
            if ((flags & StringFlag) != 0)
            {
                return false;
            }
            // AN ARRAY OF INTEGERS is scanned word by word when it is
            // marked (this code has kept addresses in them), but an integer
            // is not a reference to the card contract -- its stores take no
            // card -- and one that happens to equal an address, an identity
            // hash above all, is no pointer a minor cycle owes anything to.
            if ((Sys.Peek(desc + DescGcFlagsWord * w) & ElementsAreReferences) == 0)
            {
                return false;
            }
            if (Sys.Peek(desc + DescSizeWord * w) != w)
            {
                return true;
            }
            long count = Sys.Peek(payload + ArrayCountAt) & 0x7FFFFFFF;
            long first = payload + Sys.Peek(desc + DescPayloadWord * w);
            long last = first + count * w;
            if (last > end || last < first)
            {
                return true;
            }
            return at >= first && at < last;
        }
        long map = Sys.Peek(desc + DescRefMapWord * w) & WordSize.AddressMask;
        if (map == 0 || at < payload || ((at - payload) & (w - 1)) != 0)
        {
            return false;
        }
        long index = (at - payload) / w;
        if (index >= Sys.Peek(map))
        {
            return false;
        }
        return ((Sys.Peek(map + (1 + index / 32) * w) >> (int)(index & 31)) & 1) != 0;
    }

    public static void ScanRange(long from, long to)
    {
        long p = (from + WordSize.Bytes - 1) & -WordSize.Bytes;

        while (p < to)
        {
            MarkAt(Sys.Peek(p));
            p = p + WordSize.Bytes;
        }
    }

    /// Runs a collection. Everything reachable from the stack, the registers
    /// and the statics is kept; everything else goes back on the free list.
    /// Entered through GcRoots so the registers are on the stack first --
    /// see GcRoots for the reasoning -- and reached only from Alloc.
    public static void Collect()
    {
        // ASKED FOR, it is whole: GC.Collect promises every unreachable
        // object is gone, and a minor collection leaves the old ones be.
        _forceMajor = true;
        while (true)
        {
            GcLock.Enter();

            if (!_collecting)
            {
                CollectLocked();
                GcLock.Exit();
                return;
            }

            // Somebody else's collection is between its two stops. Asking
            // for one means wanting one that STARTED after the call: wait
            // that one out, as a thread that is blocked and readable.
            GcLock.Exit();
            GcThreads.BeginBlocking();
            long cycling = GcLock.Words() + GcLock.Cycling;

            while (Sys.Peek(cycling) != 0)
            {
                Platform.Wait(cycling, 1);
            }

            GcThreads.EndBlocking();
        }
    }

    /// With the heap lock held, waits until the collection in progress has
    /// finished -- letting go of the lock to do it, since that collection
    /// needs it for its second stop -- as a thread that is blocked, readable
    /// and counted as stopped.
    static void WaitOutCycle()
    {
        long cycling = GcLock.Words() + GcLock.Cycling;
        GcLock.Exit();
        GcThreads.BeginBlocking();

        while (Sys.Peek(cycling) != 0)
        {
            Platform.Wait(cycling, 1);
        }

        GcThreads.EndBlocking();
        GcLock.Enter();
    }

    // ---- a collection ---------------------------------------------------------
    //
    // NOBODY IS EVER STOPPED. A collection with one thread simply runs,
    // start to end, on that thread (CollectAlone): there is nobody to stop.
    // A collection with several runs while every thread goes on working
    // (CollectConcurrently), and asks each of them, in HANDSHAKE ROUNDS
    // (GcThreads.Round), for the part only that thread can do -- at its next
    // safepoint, or done for it by the collector if it is blocked:
    //
    //   1. The barrier goes on (Marking 1: it logs what stores overwrite and
    //      write), and with the heap lock held the collector writes down where
    //      every object starts -- stepping over the allocation buffers threads
    //      are bumping in, which are not walkable.
    //   2. STAMP: each thread writes down where the objects in its own buffer
    //      start. After this round every object that existed at the snapshot
    //      can be found from a pointer into it.
    //   3. The barrier marks from now on (Marking 2): the old value and the
    //      new, both. What it logged meanwhile is marked. The collector marks
    //      from its own stack and the statics.
    //   4. SCAN: each thread marks from its own stack and registers.
    //   5. The mark runs -- the collector, threads that allocate, idle
    //      processors -- and ACK rounds follow until one passes in which
    //      nothing at all was marked: then everything reachable is marked,
    //      because the barrier marks directly and what it finds unmarked can
    //      only be garbage or new.
    //   6. The barrier goes off, one more ACK round sees every thread out of
    //      it, and the sweep runs chunk by chunk, stepping over the buffers
    //      in use, with every thread still working.
    //
    // WHAT IS NEW IS KEPT. An object allocated after the snapshot has no
    // start bit; the marker cannot find it and the sweep keeps it (Newcomer).
    // What it refers to arrived through a store the barrier saw, or through
    // the stack of a thread that has not yet answered SCAN.

    /// The same collection with the heap lock already held, and held again
    /// when this returns. It is let go of while the others are asked for
    /// their part and while the mark and the sweep run: a caller must carry
    /// nothing it read of the heap across this call.
    /// How long the program has stood still for its collector, in
    /// microseconds: the calling thread for the whole of each collection it
    /// made (GC.GetTotalPauseDuration). The heap lock is held.
    public static long PauseMicros;

    /// A monotonic clock in microseconds, from a platform that has one to
    /// read from any thread at any time (Linux's clock_gettime); 0 where
    /// there is none, and pauses go untimed.
    public static long PauseClock;

    static void CollectLocked()
    {
        if (!HeapChunks.Any() || _collecting)
        {
            return;
        }

        // An indirect call answers a word, so the clock is read modulo 2^32
        // microseconds; the difference of two is exact for any collection
        // shorter than an hour and eleven minutes.
        FitMarkQueue();
        _minor = NextIsMinor();
        _forceMajor = false;
        if (_generational)
        {
            SwapHeld();
        }
        long clock = PauseClock;
        long began = clock != 0 ? Sys.Call(clock, 0, 0, 0) : 0;
        bool minor = _minor;
        long before = Collections;
        try { CollectBoth(); }
        finally
        {
            if (clock != 0)
            {
                long took = (Sys.Call(clock, 0, 0, 0) - began) & 0xFFFFFFFF;
                PauseMicros = PauseMicros + took;
                // A cycle that finished sets the pace of the next by what it
                // cost; one given up leaves it as it was.
                if (_generational && Collections != before)
                {
                    _threshold = Paced(_liveBytes, minor, took < 1 ? 1 : took);
                }
            }
        }
    }

    static void CollectBoth()
    {
        if (!GcThreads.Others())
        {
            CollectAlone();
            return;
        }

        // SEVERAL THREADS ARE NEVER COLLECTED ALONE. CollectAlone reads one
        // stack, this one's; every other thread's is read only by the rounds
        // a concurrent collection asks, and without them an object another
        // thread holds only in a register or on its stack is swept from under
        // it. The two tables the concurrent collection needs are asked for
        // again if Start could not have them; without them there is no safe
        // collection at all, and saying so is the only honest answer.
        if (_barrier == 0) _barrier = Platform.Map(BarrierBytes);
        if (_markAt == 0)
        {
            _markAt = Platform.Map(MarkBytes);
            if (_markAt != 0)
            {
                _markBytes = MarkBytes;
                _markCount = MarkBytes / GreyEntry;
            }
        }
        if (_barrier == 0 || _markAt == 0)
        {
            OutOfMemory("out of memory: no room for the collector's tables, and several threads to collect for\n");
        }
        CollectConcurrently();
    }

    public static long PauseHook;

    /// Asked before a collection that pressure, not shortage, calls for:
    /// nonzero puts it off. It must not allocate. See AllocSlow.
    public static long DeferHook;
    public static long Deferred;

    /// Asked at every slow allocation: nonzero says the machine is short of
    /// memory, and a collection is due after a quarter of the live size has
    /// been allocated rather than all of it (ShortThreshold). A heap that may
    /// double before it is collected is a heap that holds its live size in
    /// garbage, which a machine with room to spare can afford and one without
    /// cannot. It must not allocate. 0, a platform that never says so.
    public static long ShortHook;
    public static long ShortCollections;

    static long ShortThreshold()
    {
        long quarter = _liveBytes / 4;
        return quarter > MinThreshold ? quarter : MinThreshold;
    }

    /// Collections given up half way -- a barrier report lost to a full
    /// ring -- and begun again later. Nothing is freed by one.
    public static long Aborted;

    /// Handshake rounds asked for, over all collections.
    public static long HandshakeRounds;

    static bool _rootsOnly;         // CollectInner: the collector's own roots and no more
    static long _sinceAtStop;

    /// One thread, nobody to ask: the whole collection, here and now.
    static void CollectAlone()
    {
        long ctl = GcLock.Words();
        long self = Sys.ThreadBlock();

        // A platform that wants to know how long its only thread stood still
        // says so here: called with 0 as the collection begins and 1 as it
        // ends. It must not allocate.
        Sys.AtomicSwap(ctl + GcLock.Cycling, 1);
        Sys.AtomicSwap(ctl + GcLock.Collecting, 1);
        Sys.AtomicSwap(ctl + GcLock.Collector, self);
        if (PauseHook != 0) Sys.Call(PauseHook, 0, 0, 0);

        Retire(self);
        GcThreads.CaptureBuffers();
        _collecting = true;
        _concurrent = false;
        _sinceAtStop = _since;
        SyncEnd();
        _cycle = _cycle + 1;
        Sys.AtomicSwap(ctl + GcLock.Overflow, _markAt == 0 ? 1 : 0);
        BuildBlockAnchors(false);
        _rootsOnly = false;
        GcRoots.Enter();

        if (PauseHook != 0) Sys.Call(PauseHook, 1, 0, 0);
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap(ctl + GcLock.Collecting, 0);
        Sys.AtomicSwap(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Entered through GcRoots.Enter, with every register on the stack:
    /// either the collector's own roots of a concurrent collection, or the
    /// whole of a collection with one thread.
    public static void CollectInner()
    {
        GcRoots.ScanAll();

        // A MINOR CYCLE'S OTHER ROOTS, read with the ordinary ones: what old
        // objects were given since the last cycle, and what the stacks held
        // then (generations, above). A major cycle only clears the cards.
        if (_minor)
        {
            ScanTakenCards();
            RescanHeld();
        }

        if (_rootsOnly)
        {
            return;
        }

        MarkToEmpty();
        if (_minor && _verifyGenerations) VerifyMinor();
        if (!_minor && _verifyGenerations) VerifyMajor();
        HeapChunks.SetBlockAnchorsActive(false);
        BeginSweep();
        while (SweepNext()) { }
        FinishCycle();
    }

    /// Several threads: the collection runs beside them. Entered and left
    /// with the heap lock held.
    static void CollectConcurrently()
    {
        long ctl = GcLock.Words();
        long self = Sys.ThreadBlock();

        Sys.AtomicSwap(ctl + GcLock.Cycling, 1);
        Sys.AtomicSwap(ctl + GcLock.Collector, self);
        Sys.AtomicSwap(ctl + GcLock.Abort, 0);
        Sys.AtomicSwap(ctl + GcLock.Overflow, 0);
        Sys.AtomicSwap(ctl + GcLock.Collecting, 1);
        _collecting = true;
        _sinceAtStop = _since;
        SyncEnd();
        _cycle = _cycle + 1;
        ResetBarrier();

        // 1. The barrier logs, then the snapshot of where objects start. The
        //    collector's own buffer is stepped over like everybody's and its
        //    objects written in here: the round below counts the collector as
        //    having answered, and a buffer retired unstamped holds objects
        //    that are kept and never traced -- what only they refer to was
        //    swept from under them.
        Runtime.Marking = 1;
        _stamping = true;
        GcThreads.CaptureBuffers();
        BuildBlockAnchors(true);

        if (!_snapshots)
        {
            GcLock.Exit();
            GiveUp(false);
            return;
        }

        StampBuffer(self);

        _concurrent = true;
        ConcurrentCycles = ConcurrentCycles + 1;
        GcLock.Exit();

        // 2. Every thread's own buffer.
        GcThreads.Round(GcThreads.Stamp);

        if (Sys.Peek(ctl + GcLock.BarrierLost) != 0)
        {
            GiveUp(false);
            return;
        }

        // A STORE IN FLIGHT AT THE SNAPSHOT -- its barrier found Marking
        // still 0, so its value was never reported -- has landed by now, and
        // its card with it: every thread has passed a safepoint since, and
        // none falls between a barrier's test and the card mark after the
        // store. Its card may have been set after TakeCards looked. So a
        // minor cycle reads every card set now as well, and leaves it set:
        // what was stored after the snapshot is the next cycle's to read too.
        if (_minor)
        {
            PeekCards();
        }

        // 3. The barrier marks. Buffers retired from here on are not stamped:
        //    a thread may have answered SCAN before it allocated what is in
        //    them, and stamping would make them findable and then unmarked.
        GcLock.Enter();
        _stamping = false;
        GcLock.Exit();
        Runtime.Marking = 2;
        // Before the ranges are read: a range registered from here on is
        // marked by its registrar (MarkRegistered), one before is read below.
        Sys.Fence();
        TakeBarrier(false);
        _rootsOnly = true;
        GcRoots.Enter();
        _rootsOnly = false;

        // 4. Every thread's stack. When it has been answered, every thread
        //    has passed a safepoint since it saw the barrier mark, so every
        //    report it logged is signed and in the ring.
        GcThreads.Round(GcThreads.Scan);

        if (TakeBarrier(true))
        {
            GiveUp(true);
            return;
        }

        // 5. Mark to the end, and prove it is the end.
        while (true)
        {
            MarkToEmpty();
            long before = Sys.Peek(ctl + GcLock.Pushes);
            GcThreads.Round(GcThreads.Ack);
            MarkToEmpty();

            if (Sys.Peek(ctl + GcLock.Pushes) == before)
            {
                break;
            }
        }

        // 6. The barrier off; everybody seen out of it; the sweep.
        Runtime.Marking = 0;
        GcThreads.Round(GcThreads.Ack);
        MarkToEmpty();
        if (_minor && _verifyGenerations) VerifyMinor();
        if (!_minor && _verifyGenerations) VerifyMajor();

        GcLock.Enter();
        HeapChunks.SetBlockAnchorsActive(false);
        GcThreads.CaptureBuffers();
        GcThreads.UnmarkBuffers();
        BeginSweep();
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap(ctl + GcLock.Collecting, 0);
        GcLock.Exit();

        SweepWhileTheyRun();

        GcLock.Enter();
        FinishCycle();
        Sys.AtomicSwap(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Stamping is open: a buffer retired now has its objects' starts
    /// written down first (Retire). From the snapshot until SCAN is asked.
    static bool _stamping;

    /// Scans until nothing is queued, nothing is being scanned, and no push
    /// was lost to a full queue.
    static void MarkToEmpty()
    {
        long ctl = GcLock.Words();

        while (true)
        {
            Drain();

            if (TakeOverflow())
            {
                RescanPasses = RescanPasses + 1;
                RescanMarked();
                continue;
            }

            if (GreyIdle())
            {
                return;
            }

            // Somebody else has a block in hand, or a push is half made: it
            // is a few instructions from done. A spin, not Platform.Wait: that
            // sleeps WHILE a word holds a value, and there is no value here
            // to sleep on -- waiting on Active being 0 slept for ever the
            // moment it was.
            Sys.Pause();
        }
    }

    /// A concurrent collection that cannot finish soundly -- a barrier
    /// report was lost to a full ring -- is given up: every thread is seen out
    /// of its barrier, what was marked is unmarked, and nothing is freed. The
    /// next allocation that wants a collection starts a new one. Entered
    /// without the heap lock; left holding it.
    static void GiveUp(bool marked)
    {
        long ctl = GcLock.Words();

        Runtime.Marking = 0;
        Sys.AtomicSwap(ctl + GcLock.Abort, 1);
        GcThreads.Round(GcThreads.Ack);

        while (Sys.Peek(ctl + GcLock.Active) != 0)
        {
            Sys.Pause();
        }

        Sys.AtomicSwap(ctl + GcLock.GreyHead, Sys.Peek(ctl + GcLock.GreyTail));
        Sys.AtomicSwap(ctl + GcLock.Overflow, 0);

        if (marked)
        {
            ClearMarks();
        }

        GcLock.Enter();
        _stamping = false;
        HeapChunks.SetBlockAnchorsActive(false);
        _snapshots = false;
        _concurrent = false;
        _collecting = false;
        // The marks just cleared may have been an old block's: only a major
        // cycle, which clears and makes them all again, may follow.
        _forceMajor = true;
        _minor = false;
        Aborted = Aborted + 1;
        Sys.AtomicSwap(ctl + GcLock.Abort, 0);
        Sys.AtomicSwap(ctl + GcLock.Collector, 0);
        Sys.AtomicSwap(ctl + GcLock.Collecting, 0);
        Sys.AtomicSwap(ctl + GcLock.Cycling, 0);
        Platform.Wake(ctl + GcLock.Cycling, 0x7FFFFFFF);
    }

    /// Every mark and scanned flag of the snapshot taken off again, for a
    /// collection given up. Every thread is out of its barrier and nobody is
    /// marking; the snapshot's objects are never written by a running thread.
    static void ClearMarks()
    {
        long which = 0;
        long chunk = HeapChunks.SnapshotChunk(0);

        while (chunk != 0)
        {
            if (HeapChunks.StartsCycle(chunk) == _cycle)
            {
                long block = HeapChunks.NextStart(chunk, HeapChunks.First(chunk));

                while (block != 0)
                {
                    long word = Sys.Peek(block);

                    if ((word & (FlagMark | FlagScan)) != 0)
                    {
                        Stamp(block, word & SizeMask, word & FlagMask & ~(FlagMark | FlagScan));
                    }

                    block = HeapChunks.NextStart(chunk, block + 8);
                }
            }

            which = which + 1;
            chunk = HeapChunks.SnapshotChunk(which);
        }
    }

    /// The end of a collection, with the heap lock held.
    static void FinishCycle()
    {
        _liveBlocks = _sweepLive;
        _liveBytes = _sweepLiveBytes;
        _sweeping = false;
        RestartRecycling();
        _snapshots = false;
        _concurrent = false;

        // What was allocated while the mark ran was not looked at by it and
        // still counts towards the next.
        _since = _since > _sinceAtStop ? _since - _sinceAtStop : Zero;
        if (_minor)
        {
            MinorCollections = MinorCollections + 1;
        }
        else
        {
            MajorCollections = MajorCollections + 1;
            _majorLive = _liveBytes > MinThreshold ? _liveBytes : MinThreshold;
        }
        _threshold = _generational ? Nursery(_liveBytes) : NextThreshold(_liveBytes);
        _minor = false;
        Collections = Collections + 1;
        _collecting = false;
    }

    /// HOW MUCH GARBAGE THE NEXT CYCLE MAY LET PILE UP: at least the live
    /// size, which is what this collector has always allowed and all a small
    /// machine can spare, and up to three times it where the room is there.
    ///
    /// Every collection marks the whole live heap, so the marking paid per
    /// byte allocated is live / threshold: at once the live size the
    /// self-hosted compiler ran sixty collections compiling hello.cs, most of
    /// its time. The room is half of what the operating system says is free
    /// -- the other half left to everything else on the machine -- or, under
    /// a cap (a kernel's heap, SetLimit), half of what the cap has left -- and
    /// never more than half of what the address space has left (HeapCeiling). A
    /// platform that cannot say keeps the old pace. A 32 MB board, where a
    /// program's live size is most of what is free, gets exactly the old
    /// threshold; a server with gigabytes free gets three times it.
    ///
    /// Called with the heap lock held: nothing here allocates.
    static long NextThreshold(long live)
    {
        long floor = live > MinThreshold ? live : MinThreshold;
        long room;
        long bound = -1;            // half of what a hard limit leaves; -1 for none
        if (HeapChunks.Cap != 0)
        {
            long left = HeapChunks.Cap - live;
            room = left > 0 ? left / 2 : 0;
            bound = room;
        }
        else
        {
            room = Platform.FreeMemoryQuietly() / 2;
        }
        if (HeapCeiling != 0)
        {
            long left = HeapCeiling - live;
            long spare = left > 0 ? left / 2 : 0;
            if (spare < room) room = spare;
            if (bound < 0 || spare < bound) bound = spare;
        }
        long most = floor * MaxGrowth;
        long wanted = room < most ? room : most;
        long next = wanted > floor ? wanted : floor;
        // UNDER A HARD LIMIT -- a cap, the 32-bit ceiling -- THE FLOOR GIVES
        // WAY. Allowing the live size again as garbage is the old pace, but
        // with a gigabyte and a half live under a ceiling of two and a half it
        // let the heap outgrow the address space: near a limit, collections
        // come sooner instead. Free memory alone is no limit: a 32 MB board
        // keeps its old pace.
        if (bound >= 0 && next > bound)
        {
            next = bound > MinThreshold ? bound : MinThreshold;
        }
        return next;
    }

    /// With the world running and the heap lock NOT held between chunks.
    static void SweepWhileTheyRun()
    {
        while (true)
        {
            GcLock.Enter();
            bool more = SweepNext();
            GcLock.Exit();
            if (!more) return;
        }
    }

    /// Every block that is marked and not yet scanned, scanned: the blocks a
    /// full queue could not take. By the snapshot's start bits when there are
    /// any, which is safe with every thread running; otherwise, with one
    /// thread, by walking.
    static void RescanMarked()
    {
        long chunk = _snapshots ? HeapChunks.SnapshotChunk(0) : HeapChunks.Newest();
        long which = 0;

        while (chunk != 0)
        {
            long block = HeapChunks.First(chunk);
            long end = HeapChunks.End(chunk);

            if (_snapshots)
            {
                block = HeapChunks.StartsCycle(chunk) == _cycle ? HeapChunks.NextStart(chunk, block) : 0;

                while (block != 0)
                {
                    long flags = Sys.Peek(block);

                    if ((flags & FlagMark) != 0 && (flags & FlagScan) == 0 && SetFlag(block, FlagScan))
                    {
                        ScanBlock(block, Sys.Peek(block) & SizeMask);
                        Drain();
                    }

                    block = HeapChunks.NextStart(chunk, block + 8);
                }

                which = which + 1;
                chunk = HeapChunks.SnapshotChunk(which);
                continue;
            }

            while (block < end)
            {
                long word = Sys.Peek(block);
                long size = word & SizeMask;

                if (size < Smallest || block + size > end)
                {
                    // Broken metadata cannot be walked safely; stop at
                    // this chunk rather than read what is not there.
                    block = end;
                }
                else
                {
                    if ((word & FlagMark) != 0 && (word & FlagScan) == 0 && SetFlag(block, FlagScan))
                    {
                        ScanBlock(block, size);
                        Drain();
                    }
                    block = block + size;
                }
            }
            chunk = HeapChunks.Next(chunk);
        }
    }

    // ---- what the other threads do for a collection ------------------------------

    /// Where the objects in a thread's own buffer start, written into the
    /// snapshot (the STAMP round, or its buffer being retired while stamping
    /// is open). By the thread itself, or by the collector while it is
    /// blocked: nobody else is bumping in the buffer meanwhile.
    public static void StampBuffer(long block)
    {
        long at = Sys.Peek(block + Tls.AllocBase);
        long upto = Sys.Peek(block + Tls.AllocPtr);

        if (at == 0 || upto <= at)
        {
            return;
        }

        long chunk = HeapChunks.OfSnapshot(at);

        // A buffer in a chunk made since the snapshot holds only newcomers.
        if (chunk == 0 || HeapChunks.StartsCycle(chunk) != _cycle)
        {
            return;
        }

        while (at < upto)
        {
            long word = Sys.Peek(at);
            long size = word & SizeMask;

            if (size < Smallest || at + size > upto)
            {
                return;
            }

            if ((word & FlagFree) == 0)
            {
                HeapChunks.SetStartShared(chunk, at);
                // A MAJOR CYCLE CLEARS THE MARKS HERE TOO: survivors in a live
                // buffer keep theirs (UnmarkBuffer), and this is where a major
                // cycle first walks them, as BuildBlockAnchors walks the rest.
                if (_generational && !_minor && (word & (FlagMark | FlagScan)) != 0)
                {
                    Stamp(at, size, word & FlagMask & ~(FlagMark | FlagScan));
                }
            }

            at = at + size;
        }
    }

    /// The marks this collection left on the objects in a thread's buffer,
    /// taken off. The sweep steps over a buffer in use -- it is not a chain of
    /// blocks past its bump pointer -- and so never reaches the objects in it
    /// to clear them, as it does every other block's; left marked and
    /// scanned, the next collection would find them done already, never scan
    /// them, and sweep what only they refer to. Below the bump pointer the
    /// objects are whole and nobody but a collector writes their headers; the
    /// heap lock is held, so the buffer is not retired meanwhile.
    public static void UnmarkBuffer(long block)
    {
        long at = Sys.Peek(block + Tls.AllocBase);
        long upto = Sys.Peek(block + Tls.AllocPtr);

        // WITH GENERATIONS A SURVIVOR IS OLD, in a buffer or not: its marks
        // are what say so. Made young again here, one that only an old object
        // pointed at -- whose card this cycle read and cleared -- would be
        // found by nothing the next minor cycle, and swept once its buffer
        // was retired. A major cycle clears them as it stamps (StampBuffer).
        if (at == 0 || _generational)
        {
            return;
        }

        while (at < upto)
        {
            long word = Sys.Peek(at);
            long size = word & SizeMask;

            if (size < Smallest || at + size > upto)
            {
                return;
            }

            if ((word & (FlagMark | FlagScan)) != 0)
            {
                Stamp(at, size, word & FlagMask & ~(FlagMark | FlagScan));
            }

            at = at + size;
        }
    }

    /// A thread's stack, from `from` up to its base, marked from.
    public static void ScanStack(long block, long from)
    {
        long to = Sys.Peek(block + Tls.StackBase);

        if (from != 0 && to > from)
        {
            ScanRoots(from, to);
        }
    }

    /// A few queued blocks scanned by a thread that is allocating while a
    /// mark is under way: the collection's cost shared by the threads that
    /// cause it, and done sooner on a machine with processors to spare.
    public static long Assist(long budget)
    {
        if (Runtime.Marking != 2 || _markAt == 0)
        {
            return 0;
        }

        return DrainSome(budget);
    }

    // ---- the barrier's ring ----------------------------------------------
    //
    // Many writers, one reader, nothing held. A writer claims a place with
    // one atomic add, stores its value there, and then SIGNS the place with
    // the number it claimed; the reader takes places in order and takes one
    // only if it carries the number the reader has reached. The numbers
    // never start again, so a signature is good for one visit of one place.
    //
    // WHY A SIGNATURE AND NOT JUST "NOT ZERO". A writer is never stopped
    // for a collection between claiming and storing (Tls.InAlloc) -- but on
    // a kernel it can be BLOCKED there: an interrupt arrives on top of it,
    // the handler waits for a lock, and a thread waiting for a lock counts
    // as stopped. The stop goes ahead with a place claimed and empty, and
    // the store comes late, perhaps cycles later, into a place that by then
    // belongs to somebody else's claim. Unsigned, the reader would take the
    // stale value for the new claim and miss the real one. Signed with an
    // old number, it is nobody's, and is written over.
    //
    // A place found claimed and unsigned at a stop means a report is
    // missing; so does a full ring. Either is remembered (BarrierLost) and
    // the mark is finished the long way, with the world stopped -- which
    // reads the late writer's stack, where the missing value is.

    static void ResetBarrier()
    {
        long ctl = GcLock.Words();

        // Whatever was claimed since the last mark ended was claimed by a
        // barrier already past its test of Marking: it reports on a graph
        // this snapshot does not need to be told about.
        Sys.AtomicSwap(ctl + GcLock.BarrierHead, Sys.Peek(ctl + GcLock.BarrierTail));
        Sys.AtomicSwap(ctl + GcLock.BarrierLost, 0);
    }

    static long Signature(long place)
    {
        return (place & 0x7FFFFFFF) | 0x80000000;
    }

    /// What the compiled barrier calls, through Runtime.WriteBarrier, when a
    /// reference is about to be stored at `slot` while a mark is under way:
    /// the reference about to be overwritten, which the snapshot may reach
    /// only through here, and the one going in, which costs a word and
    /// covers a store somebody made without a barrier.
    ///
    /// TWO WAYS. While the threads are still writing down where their own
    /// buffers' objects start (Marking 1) a pointer cannot yet be resolved,
    /// so the two words are logged in the ring. Afterwards (Marking 2) they
    /// are marked on the spot: that is what lets a collection end without
    /// stopping anybody, because a mark already made is not made again, and
    /// once everything reachable is marked the barrier finds nothing new.
    public static void Barrier(long slot, long value)
    {
        long tb = Sys.ThreadBlock();
        long was = Sys.Peek(tb + Tls.InAlloc);
        Sys.Poke(tb + Tls.InAlloc, 1);
        Note(Sys.Peek(slot), value);
        Sys.Poke(tb + Tls.InAlloc, was);
    }

    /// Barrier, told the overwritten reference itself: for an object whose
    /// fields the optimiser keeps in registers (Runtime.WriteBarrierValues).
    public static void BarrierValues(long old, long value)
    {
        long tb = Sys.ThreadBlock();
        long was = Sys.Peek(tb + Tls.InAlloc);
        Sys.Poke(tb + Tls.InAlloc, 1);
        Note(old, value);
        Sys.Poke(tb + Tls.InAlloc, was);
    }

    /// The two references a barrier reports: marked on the spot, or logged.
    static void Note(long old, long value)
    {
        if (Runtime.Marking == 2)
        {
            if (old != 0)
            {
                MarkAt(old);
            }

            if (value != 0 && value != old)
            {
                MarkAt(value);
            }
        }
        else
        {
            if (old != 0)
            {
                Report(old);
            }

            if (value != 0 && value != old)
            {
                Report(value);
            }
        }
    }

    static void Report(long value)
    {
        long ctl = GcLock.Words();

        if (_barrier == 0)
        {
            return;
        }

        long place = Sys.AtomicAdd(ctl + GcLock.BarrierTail, 1) & WordSize.AddressMask;
        long head = Sys.Peek(ctl + GcLock.BarrierHead) & WordSize.AddressMask;

        if (((place - head) & WordSize.AddressMask) >= BarrierCount)
        {
            Sys.AtomicSwap(ctl + GcLock.BarrierLost, 1);
            return;
        }

        long at = _barrier + (place & (BarrierCount - 1)) * (2 * WordSize.Bytes);
        Sys.Poke(at + WordSize.Bytes, value);
        Sys.AtomicSwap(at, Signature(place));
    }

    /// Marks what has been reported. With the world running it stops at a
    /// place claimed and not yet written; with the world stopped (`all`)
    /// there is no such place, only ones given up. Answers whether any
    /// report was dropped.
    static bool TakeBarrier(bool all)
    {
        long ctl = GcLock.Words();

        if (_barrier == 0)
        {
            return false;
        }

        long head = Sys.Peek(ctl + GcLock.BarrierHead) & WordSize.AddressMask;
        long tail = Sys.Peek(ctl + GcLock.BarrierTail) & WordSize.AddressMask;

        while (head != tail)
        {
            long at = _barrier + (head & (BarrierCount - 1)) * (2 * WordSize.Bytes);

            if ((Sys.Peek(at) & WordSize.AddressMask) != Signature(head))
            {
                // Claimed, not signed. With the world running its writer is
                // a few instructions away: come back. At a stop there is no
                // such thing as a moment: the report is missing.
                if (!all)
                {
                    break;
                }

                Sys.AtomicSwap(ctl + GcLock.BarrierLost, 1);
            }
            else
            {
                long value = Sys.Peek(at + WordSize.Bytes);
                Sys.AtomicSwap(at, 0);
                BarrierTaken = BarrierTaken + 1;
                MarkAt(value);
            }

            head = (head + 1) & WordSize.AddressMask;
        }

        Sys.AtomicSwap(ctl + GcLock.BarrierHead, head);
        return Sys.Peek(ctl + GcLock.BarrierLost) != 0;
    }

    // Built with the heap lock held. With one thread its buffer has been
    // retired and every chunk walks; with several (`stepping`), the buffers
    // other threads are bumping in are not walkable, and are stepped over
    // whole -- GcThreads.CaptureBuffers wrote them down, sorted, a moment
    // before, and none can be replaced while the lock is held. Their objects
    // are written in by their owners (the STAMP round). Marking changes flags,
    // not block boundaries. The anchors are disabled before sweep can merge
    // blocks, and rebuilt next time.
    static void BuildBlockAnchors(bool stepping)
    {
        HeapChunks.SetBlockAnchorsActive(false);
        bool every = HeapChunks.SnapshotIndex();
        long chunk = HeapChunks.Newest();
        while (chunk != 0)
        {
            // A MINOR CYCLE LOOKS ONLY AT YOUNG CHUNKS: an old chunk keeps
            // the start table of its last cycle, which SnapshotBlock does not
            // trust for this one, so a pointer into it is not followed -- its
            // blocks are all old, and old is kept.
            if (_minor && !HeapChunks.IsYoung(chunk))
            {
                chunk = HeapChunks.Next(chunk);
                continue;
            }
            long anchors = HeapChunks.PrepareBlockAnchors(chunk);
            if (anchors == 0) every = false;
            if (anchors != 0)
            {
                long pages = HeapChunks.BlockAnchorCount(chunk);
                for (long i = 0; i < pages; i++) Sys.Poke(anchors + i * WordSize.Bytes, Zero);
                HeapChunks.ClearStarts(chunk, _cycle);
                long block = HeapChunks.First(chunk);
                long end = HeapChunks.End(chunk);
                long page = 0;
                long step = stepping ? GcThreads.BufferAtOrAbove(block) : GcThreads.BufferCount();
                while (block < end)
                {
                    if (stepping)
                    {
                        while (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < block) step = step + 1;
                        if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == block)
                        {
                            block = GcThreads.BufferLimit(step);
                            step = step + 1;
                            continue;
                        }
                    }
                    long header = Sys.Peek(block);
                    long size = header & SizeMask;
                    // A CHAIN THAT BREAKS leaves the rest of the chunk without
                    // starts, and an object without a start is a newcomer: kept
                    // and never traced. No snapshot, then, and the collection
                    // is given up rather than run on half of one.
                    if (size < Smallest || block + size > end
                        || Sys.Peek(block + size - FooterBytes) != header) { every = false; break; }
                    long last = (block + size - 1 - chunk) / 4096;
                    while (page <= last)
                    {
                        Sys.Poke(anchors + page * WordSize.Bytes, block);
                        page = page + 1;
                    }
                    // WHERE EVERY OBJECT STARTS, as of this stop: what the
                    // marker finds objects by from here on (SnapshotBlock).
                    if ((header & FlagFree) == 0) HeapChunks.SetStart(chunk, block);
                    // WHICH KILOBYTES HOLD AN OLD OBJECT, for TakeCards: a card
                    // over nothing but young blocks is not read (OldCards).
                    if (_minor && (header & (FlagFree | FlagMark | FlagScan)) == (FlagMark | FlagScan)) OldCards(block, size);
                    // A MAJOR CYCLE MAKES EVERY BLOCK YOUNG AGAIN, taking off
                    // the marks the old kept, and finds the live ones afresh.
                    if (_generational && !_minor && (header & (FlagMark | FlagScan)) != 0)
                    {
                        Stamp(block, size, header & FlagMask & ~(FlagMark | FlagScan));
                    }
                    block = block + size;
                }
            }
            chunk = HeapChunks.Next(chunk);
        }
        HeapChunks.SetBlockAnchorsActive(true);
        _snapshots = every;
        // THE CARDS, taken at the same stop: kept to be read by a minor cycle,
        // simply cleared by a major one, which marks everything anyway.
        if (_generational)
        {
            TakeCards(_minor);
        }
    }

    /// Walks every block in every chunk: unmarked ones become free, adjacent
    /// dead ones become one free block, and the marks on the survivors are
    /// cleared. The free list is rebuilt from nothing, which is simpler than
    /// editing it and no slower, since every block is visited anyway.
    /// Whether any block in a chunk was marked by this collection.
    static bool AnyLive(long chunk)
    {
        long block = HeapChunks.First(chunk);
        long end = HeapChunks.End(chunk);

        // A thread is bumping in it.
        long step = GcThreads.BufferAtOrAbove(block);
        if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < end)
        {
            return true;
        }

        while (block < end)
        {
            long word = Sys.Peek(block);
            long size = word & SizeMask;

            if (size < Smallest || block + size > end)
            {
                return false;
            }

            if ((word & FlagMark) != 0 || Newcomer(chunk, block, word))
            {
                return true;
            }

            block = block + size;
        }

        return false;
    }

    /// Allocated while the mark ran: not in the snapshot, so never marked,
    /// and kept because of it. Only a collection that let the world run has
    /// any.
    static bool Newcomer(long chunk, long block, long word)
    {
        if (!_concurrent || (word & FlagFree) != 0)
        {
            return false;
        }

        return HeapChunks.StartsCycle(chunk) != _cycle || !HeapChunks.IsStart(chunk, block);
    }

    // THE SWEEP, A CHUNK AT A TIME. With the world stopped it is simply run
    // to the end. With the world running it is safe because of where a
    // running thread can be:
    //
    //   - The free index is emptied at the stop (BeginSweep). What a thread
    //     takes afterwards comes from a block this sweep has already put
    //     back, from the bump space past where the current chunk ended AT
    //     THE STOP -- which is as far as that chunk is walked -- from a chunk
    //     made since, which is not on the list being walked, OR from the tail
    //     of a buffer somebody retired meanwhile (Refill, Deregister). That
    //     last one CAN be in a chunk not yet swept, and it is safe for one
    //     reason only: every buffer in use at BeginSweep was captured there,
    //     whole, base to limit, and every walk steps over the captured span
    //     unread whatever has happened inside it since. A retired tail is
    //     linked where it lies (Retire uses Link, never Merge), so it never
    //     reaches outside that span. Change either and this breaks: a walk
    //     would meet a chain it cannot read, or objects made after the mark
    //     with nothing to say they are new.
    //   - Nothing is freed by hand while it runs (Free), so no block is put
    //     on the free index that the walk would then put on it again.
    //   - What is allocated meanwhile is unmarked and outside the snapshot:
    //     kept, like everything else allocated since the first stop.
    //   - One chunk is swept per hold of the heap lock, so a thread that
    //     needs the heap waits for a chunk and not for the heap.
    static bool _sweeping;
    static long _sweepAt;           // the next chunk to sweep, or 0
    static long _sweepCurrent;      // the chunk that was current at the stop,
    static long _sweepCurrentEnd;   //   and where its blocks ended then
    static long _sweepLive;
    static long _sweepLiveBytes;

    static void BeginSweep()
    {
        // A MINOR SWEEP LEAVES THE FREE LISTS: the old chunks it does not
        // walk keep theirs, and a young chunk's free blocks are taken off
        // them one by one as it is walked (SweepNext).
        if (!_minor)
        {
            ClearBins();
        }
        _sweeping = true;
        _sweepAt = HeapChunks.Newest();
        _sweepCurrent = _current;
        _sweepCurrentEnd = _current != 0 ? HeapChunks.End(_current) : Zero;
        _sweepLive = Zero;
        _sweepLiveBytes = Zero;
    }

    /// Every listed free block of a chunk off its list (not one freed in
    /// place, which never was on one). The chunk is wholly dead: its chain
    /// is walkable end to end.
    static void UnlinkFreeIn(long chunk)
    {
        long block = HeapChunks.First(chunk);
        long end = HeapChunks.End(chunk);
        while (block < end)
        {
            long word = Sys.Peek(block);
            long size = word & SizeMask;
            if (size < Smallest || block + size > end)
            {
                return;
            }
            if ((word & FlagFree) != 0 && !IsInPlace(block))
            {
                Unlink(block);
            }
            block = block + size;
        }
    }

    /// Puts a run of dead blocks back as one free block.
    ///
    /// A MINOR SWEEP KEPT THE FREE LISTS, so a run's free members are on them
    /// still. A run that is one listed free block and nothing else -- a hole
    /// nothing beside it died to widen -- is left exactly where it is. Taking
    /// it off and putting it back rotated the large-block trees for every
    /// hole in every young chunk, every minor cycle, and on a fragmented heap
    /// that was most of what a collection cost. A run that did merge has its
    /// listed members taken off first; they are still whole blocks, because
    /// nothing is stamped until here.
    static void CloseDeadRun(long start, long size, long blocks, long listed)
    {
        if (blocks == 1 && listed == 1)
        {
            return;
        }
        if (listed != 0)
        {
            long at = start;
            long end = start + size;
            while (at < end)
            {
                long word = Sys.Peek(at);
                if ((word & FlagFree) != 0 && !IsInPlace(at))
                {
                    Unlink(at);
                }
                at = at + (word & SizeMask);
            }
        }
        Stamp(start, size, FlagFree);
        Link(start);
    }

    /// Sweeps one chunk. The heap lock is held (or the world is stopped).
    /// Answers whether there is another.
    static bool SweepNext()
    {
        long chunk = _sweepAt;

        if (chunk == 0)
        {
            return false;
        }

        long live = 0;
        long liveBytes = 0;

        {
            // A CHUNK WITH NOTHING LIVE IN IT GOES BACK. Not the current one,
            // which the bump pointer is in the middle of; every other chunk
            // this collection found wholly dead is unmapped whole and its
            // pages are the operating system's again. That is what makes a
            // program's memory shrink after it has grown, and the kernel's.
            long after = HeapChunks.Next(chunk);
            _sweepAt = after;

            // AN OLD CHUNK IS LEFT ALONE by a minor sweep: nothing in it was
            // made since the last cycle, nothing in it can have died that a
            // minor cycle would know of, and what its last sweep found live
            // still counts.
            if (_minor && !HeapChunks.IsYoung(chunk))
            {
                _sweepLive = _sweepLive + HeapChunks.LiveBlocks(chunk);
                _sweepLiveBytes = _sweepLiveBytes + HeapChunks.LiveBytes(chunk);
                return after != 0;
            }

            if (chunk != _current && chunk != _sweepCurrent && !AnyLive(chunk))
            {
                // A MINOR SWEEP KEPT THE FREE LISTS, and this chunk's free
                // blocks are on them: taken off before its memory goes back,
                // or the lists would point into memory no longer there.
                if (_minor)
                {
                    UnlinkFreeIn(chunk);
                }
                HeapChunks.Release(chunk);
                return after != 0;
            }

            long block = HeapChunks.First(chunk);
            long end = chunk == _sweepCurrent ? _sweepCurrentEnd : HeapChunks.End(chunk);
            long deadStart = 0;
            long deadSize = 0;
            long deadBlocks = 0;
            long deadListed = 0;
            long largest = 0;
            long step = GcThreads.BufferAtOrAbove(block);
            // What keeps the chunk young for the next cycle: a buffer a thread
            // is still bumping in, the bump pointer, or a block made while
            // this cycle marked (a newcomer, kept unmarked).
            bool stillYoung = chunk == _current || chunk == _sweepCurrent;

            while (block < end)
            {
                // A BUFFER A THREAD IS BUMPING IN (captured at BeginSweep):
                // not a chain of blocks, and all of it kept this time.
                while (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) < block) step = step + 1;
                if (step < GcThreads.BufferCount() && GcThreads.BufferBase(step) == block)
                {
                    if (deadSize != 0)
                    {
                        CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                        if (deadSize > largest) largest = deadSize;
                        deadSize = Zero;
                    }
                    liveBytes = liveBytes + (GcThreads.BufferLimit(step) - block);
                    block = GcThreads.BufferLimit(step);
                    step = step + 1;
                    stillYoung = true;
                    continue;
                }

                long word = Sys.Peek(block);
                long size = word & SizeMask;
                SweepVisits = SweepVisits + 1;

                if (size < Smallest || block + size > end)
                {
                    block = end;
                }
                else
                {
                    if ((word & FlagMark) == 0 && !Newcomer(chunk, block, word))
                    {
                        // A free block a minor sweep meets is still on the free
                        // lists (it kept them); it joins the dead run, so it
                        // comes off first -- unless it was freed in place in a
                        // buffer and never listed (FreeInPlace), whose link
                        // word is the InPlace mark and not a neighbour.
                        if (deadSize == 0)
                        {
                            deadStart = block;
                            deadBlocks = Zero;
                            deadListed = Zero;
                        }
                        if (_minor && (word & FlagFree) != 0 && !IsInPlace(block))
                        {
                            deadListed = deadListed + 1;
                        }
                        deadBlocks = deadBlocks + 1;
                        deadSize = deadSize + size;
                    }
                    else
                    {
                        if (deadSize != 0)
                        {
                            CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                            if (deadSize > largest) largest = deadSize;
                            deadSize = Zero;
                        }

                        // A SURVIVOR IS OLD, and keeps the marks that say so;
                        // a newcomer is young and stays unmarked (generations).
                        if (_generational && (word & FlagMark) != 0)
                        {
                            Stamp(block, size, FlagMark | FlagScan);
                        }
                        else
                        {
                            Stamp(block, size, Zero);
                            stillYoung = stillYoung || (word & FlagMark) == 0;
                        }
                        live = live + 1;
                        liveBytes = liveBytes + size;
                    }
                    block = block + size;
                }
            }

            if (deadSize != 0)
            {
                CloseDeadRun(deadStart, deadSize, deadBlocks, deadListed);
                if (deadSize > largest) largest = deadSize;
            }
            HeapChunks.SetLive(chunk, live, liveBytes);
            HeapChunks.SetLargestHole(chunk, largest);
            HeapChunks.SetYoung(chunk, stillYoung);
        }

        _sweepLive = _sweepLive + live;
        _sweepLiveBytes = _sweepLiveBytes + liveBytes;
        return _sweepAt != 0;
    }
}

// ---- chunks: memory from the operating system --------------------------------
//
// The heap is a list of chunks, each carrying a small record in its own
// first bytes -- so taking a chunk never itself needs an allocation, which
// matters because a chunk is taken exactly when the heap cannot allocate:
//
//   +0    next chunk, or 0
//   +W    end: one past the last block laid down (the bump pointer's floor)
//   +2W   limit: one past the chunk's memory
//   +3W   raw page-anchor table, or 0 when not allocated
//   +4W   flags: young (allocated in since the last collection)
//   +5W   the live bytes the last sweep of it found
//   +6W   the live blocks the last sweep of it found
//   +8W   the first block (8-aligned on both word sizes)
//
// The record is not a block and is never swept. This class knows nothing
// about blocks; it is the part of the heap a precise collector keeps.

static class HeapChunks
{
    const long ChunkNext = 0;
    const long ChunkEnd = WordSize.Bytes;
    const long ChunkLimit = 2 * WordSize.Bytes;
    const long ChunkAnchors = 3 * WordSize.Bytes;
    // THE GENERATIONS' WORDS (Gc, "generations"): whether anything was
    // allocated in the chunk since the last collection -- a YOUNG chunk,
    // which the next minor collection walks and sweeps -- and what its last
    // sweep found live in it, so a chunk a minor collection leaves alone
    // still counts towards what is live. Eight words in all, so the first
    // block stays eight-aligned on both word sizes.
    const long ChunkFlags = 4 * WordSize.Bytes;
    const long ChunkLiveBytes = 5 * WordSize.Bytes;
    const long ChunkLiveBlocks = 6 * WordSize.Bytes;
    // The largest free run its last sweep left, so that recycling passes by
    // a chunk whose holes are all too small without walking it (Gc.NextHole).
    const long ChunkLargestHole = 7 * WordSize.Bytes;
    const long ChunkBytes = 8 * WordSize.Bytes;
    const long ChunkYoung = 1;

    // What a chunk is normally: a megabyte, so the operating system is asked
    // rarely and the chunk list stays short for the collector to walk. A
    // single allocation larger than that gets a chunk of its own size.
    const long ChunkAsk = 1048576;

    static long _chunks;        // newest chunk first
    static long _floor;         // lowest block address in any chunk
    static long _ceiling;       // one past the highest chunk
    static long _memo;          // the chunk the last lookup hit
    static long _heapBytes;     // every chunk's size, summed
    static long _cap;           // the most to take from the OS; 0 = no cap
    // Raw metadata, not managed objects: allocating it must not recurse into
    // the collector. Mutations, like the chunk list, hold the heap lock.
    // One word per chunk; one initial page covers a 1 GiB ordinary heap.
    static long _index;
    static long _indexCount;
    static long _indexCapacity;
    static bool _indexFailed;
    static bool _anchorsActive;
    static long _anchorBytes;

    public static long BlockAnchorBytes { get { return _anchorBytes; } }

    public static long BlockAnchorCount(long chunk)
    {
        return (Limit(chunk) - chunk + 4095) / 4096;
    }

    // After the anchors, in the same mapping: the cycle the start bits are
    // of, and the start bits -- one for every eight bytes of the chunk, set
    // where an allocated block began at that cycle's first stop. A bitmap
    // word is a machine word, so a compare-and-swap of one touches nothing
    // but its own bits.
    const long StartBits = 8 * WordSize.Bytes;
    // Offsets into a chunk are never negative, so the bit and word a block's
    // start is at are shifts, not the signed divisions a 32-bit processor
    // pays a correction for; the marker asks for one on every pointer.
    const int StartShift = 3 + WordSize.Shift;
    const long StartBitMask = StartBits - 1;

    static long StartWords(long chunk)
    {
        return ((Limit(chunk) - chunk) / 8 + StartBits - 1) / StartBits;
    }

    static long AnchorBytes(long chunk)
    {
        return (BlockAnchorCount(chunk) * WordSize.Bytes + WordSize.Bytes + StartWords(chunk) * WordSize.Bytes + 4095) & -4096;
    }

    static long Starts(long chunk)
    {
        long anchors = Sys.Peek(chunk + ChunkAnchors);
        return anchors == 0 ? 0 : anchors + BlockAnchorCount(chunk) * WordSize.Bytes;
    }

    public static long StartsCycle(long chunk)
    {
        long starts = Starts(chunk);
        return starts == 0 ? -1 : Sys.Peek(starts);
    }

    public static void ClearStarts(long chunk, long cycle)
    {
        long starts = Starts(chunk);
        if (starts == 0) return;
        long words = StartWords(chunk);
        for (long i = 0; i < words; i++) Sys.Poke(starts + WordSize.Bytes + i * WordSize.Bytes, 0);
        Sys.Poke(starts, cycle);
    }

    public static void SetStart(long chunk, long block)
    {
        long starts = Starts(chunk);
        if (starts == 0) return;
        long bit = (block - chunk) >> 3;
        long at = starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes;
        Sys.Poke(at, Sys.Peek(at) | (1L << (int)(bit & StartBitMask)));
    }

    /// SetStart when other threads are writing starts into the same table
    /// at the same time -- each its own buffer, but buffers share words of
    /// the table where they meet.
    public static void SetStartShared(long chunk, long block)
    {
        long starts = Starts(chunk);
        if (starts == 0) return;
        long bit = (block - chunk) >> 3;
        long at = starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes;
        long mask = 1L << (int)(bit & StartBitMask);

        while (true)
        {
            long word = Sys.Peek(at) & WordSize.AddressMask;
            if ((word & mask) != 0) return;
            if ((Sys.Cas(at, word, (word | mask) & WordSize.AddressMask) & WordSize.AddressMask) == word) return;
        }
    }

    public static bool IsStart(long chunk, long block)
    {
        long starts = Starts(chunk);
        if (starts == 0) return false;
        long bit = (block - chunk) >> 3;
        return (Sys.Peek(starts + WordSize.Bytes + (bit >> StartShift) * WordSize.Bytes) & (1L << (int)(bit & StartBitMask))) != 0;
    }

    /// The highest start at or below `address`, or 0.
    public static long StartAtOrBelow(long chunk, long address)
    {
        long starts = Starts(chunk);
        if (starts == 0) return 0;
        long bit = (address - chunk) >> 3;
        long word = bit >> StartShift;
        long bits = Sys.Peek(starts + WordSize.Bytes + word * WordSize.Bytes) & WordSize.AddressMask;
        long keep = bit & StartBitMask;
        if (keep != StartBitMask) bits = bits & ((1L << (int)(keep + 1)) - 1);

        while (bits == 0)
        {
            if (word == 0) return 0;
            word = word - 1;
            bits = Sys.Peek(starts + WordSize.Bytes + word * WordSize.Bytes) & WordSize.AddressMask;
        }

        // The highest set bit by counting, not by stepping down a 64-bit
        // word a bit at a time: this answers every card an old block lies
        // in, and every pointer the marker resolves.
        long top = 63 - Runtime.LeadingZeroCount(bits);
        return chunk + (word * StartBits + top) * 8;
    }

    /// The lowest start at or above `address`, or 0.
    public static long NextStart(long chunk, long address)
    {
        long starts = Starts(chunk);
        if (starts == 0) return 0;
        long words = StartWords(chunk);
        long bit = (address - chunk + 7) >> 3;
        long word = bit >> StartShift;
        if (word >= words) return 0;
        long bits = (Sys.Peek(starts + WordSize.Bytes + word * WordSize.Bytes) & WordSize.AddressMask) & ~((1L << (int)(bit & StartBitMask)) - 1);

        while (bits == 0)
        {
            word = word + 1;
            if (word >= words) return 0;
            bits = Sys.Peek(starts + WordSize.Bytes + word * WordSize.Bytes) & WordSize.AddressMask;
        }

        long low = Runtime.TrailingZeroCount(bits);
        return chunk + (word * StartBits + low) * 8;
    }

    // THE CHUNK INDEX AS IT WAS AT THE STOP. The live one is edited in
    // place, and moved, under the heap lock; the marker holds no lock.
    static long _snap;
    static long _snapCount;
    static long _snapCapacity;

    // ONE BIT FOR EVERY 64 KiB OF ADDRESS SPACE A SNAPSHOT CHUNK TOUCHES.
    // The marker asks OfSnapshot of every word it scans, and most of them --
    // counts, characters, flags -- point nowhere near the heap: the bit
    // turns those away with one load, where the search of the index cost a
    // dozen 64-bit compares on a 32-bit processor. That search was a third
    // of all the processor time of a 233 MHz board's boot. In long mode;
    // a 32-bit process has a word per megabyte instead, which also names
    // the chunk (_snapMegabytes).
    static long _snapRegions;
    const long RegionShift = 16;
#if TARGET_64BIT
    // LONG MODE HAS 2^47 BYTES OF USER ADDRESS SPACE, and a flat bit per 64
    // KiB of it would be two gigabytes of map. So the bits are two-level: a
    // top table of one word per 4 GiB -- 2^15 of them, whose pages the kernel
    // commits only as words are written -- each naming an 8 KiB bitmap for
    // its 4 GiB, made the first time a chunk lands there. A heap is a handful
    // of them, and clearing those is what a snapshot costs, not the whole top
    // table. A bitmap the system would not give turns the filter off for the
    // cycle, and the index search answers alone, as it did before the filter.
    const long RegionTops = 32768;
    const long RegionTopShift = 32;
    const long RegionMapBytes = 8192;           // 2^32 >> 16 bits, per 4 GiB
    static long _snapRegionUsed;                // top slots holding a bitmap, one word each
    static long _snapRegionUsedCount;
    static bool _snapFilterOff;

    static long RegionBitmap(long top)
    {
        long bitmap = Sys.Peek(_snapRegions + top * WordSize.Bytes);
        if (bitmap != 0) return bitmap;
        bitmap = Platform.Map(RegionMapBytes);
        if (bitmap == 0) return 0;
        Sys.Poke(_snapRegions + top * WordSize.Bytes, bitmap);
        Sys.Poke(_snapRegionUsed + _snapRegionUsedCount * WordSize.Bytes, top);
        _snapRegionUsedCount = _snapRegionUsedCount + 1;
        return bitmap;
    }
#else
    const long MegabyteShift = 20;
    const long MegabyteMapBytes = 4096 * 4;     // a word per megabyte of 4 GiB
    static long _snapMegabytes;
#endif

    public static bool SnapshotIndex()
    {
        _snapCount = 0;
        if (_indexFailed || _index == 0) return false;

        if (_snapCapacity < _indexCount)
        {
            if (_snap != 0) Platform.Unmap(_snap, _snapCapacity * WordSize.Bytes);
            _snapCapacity = 0;
            _snap = Platform.Map(_indexCapacity * WordSize.Bytes);
            if (_snap == 0) return false;
            _snapCapacity = _indexCapacity;
        }

        for (long i = 0; i < _indexCount; i++) Sys.Poke(_snap + i * WordSize.Bytes, Sys.Peek(_index + i * WordSize.Bytes));
        _snapCount = _indexCount;

#if TARGET_64BIT
        if (_snapRegions == 0)
        {
            _snapRegions = Platform.Map(RegionTops * WordSize.Bytes);
            _snapRegionUsed = _snapRegions == 0 ? 0 : Platform.Map(RegionTops * WordSize.Bytes);
            if (_snapRegionUsed == 0) _snapRegions = 0;
        }
        _snapFilterOff = _snapRegions == 0;
        if (_snapRegions != 0)
        {
            for (long k = 0; k < _snapRegionUsedCount; k++)
            {
                long bitmap = Sys.Peek(_snapRegions + Sys.Peek(_snapRegionUsed + k * WordSize.Bytes) * WordSize.Bytes);
                for (long i = 0; i < RegionMapBytes; i = i + WordSize.Bytes) Sys.Poke(bitmap + i, 0);
            }
            for (long i = 0; i < _snapCount && !_snapFilterOff; i++)
            {
                long chunk = Sys.Peek(_snap + i * WordSize.Bytes);
                long last = (Sys.Peek(chunk + ChunkLimit) - 1) >> RegionShift;
                for (long r = chunk >> RegionShift; r <= last; r++)
                {
                    long top = r >> (RegionTopShift - RegionShift);
                    long bitmap = top >= 0 && top < RegionTops ? RegionBitmap(top) : 0;
                    if (bitmap == 0) { _snapFilterOff = true; break; }
                    long within = r & ((1L << (RegionTopShift - RegionShift)) - 1);
                    long at = bitmap + (within >> 3);
                    Sys.PokeByte(at, Sys.PeekByte(at) | (1 << (int)(within & 7)));
                }
            }
        }
#else
        // A WORD FOR EVERY MEGABYTE OF THE ADDRESS SPACE, naming the first
        // snapshot chunk that reaches into it (its index plus one; 0 for none).
        // A chunk is taken a megabyte at a time unless a cap says otherwise,
        // so a megabyte has one chunk in it or two, and OfSnapshot answers
        // with a load and a compare where a search of the index took a dozen
        // 64-bit compares -- for every word the marker scans.
        if (_snapMegabytes == 0) _snapMegabytes = Platform.Map(MegabyteMapBytes);
        if (_snapMegabytes != 0)
        {
            for (long i = 0; i < MegabyteMapBytes; i = i + WordSize.Bytes) Sys.Poke(_snapMegabytes + i, 0);
            for (long i = 0; i < _snapCount; i++)
            {
                long chunk = Sys.Peek(_snap + i * WordSize.Bytes) & WordSize.AddressMask;
                long last = ((Sys.Peek(chunk + ChunkLimit) & WordSize.AddressMask) - 1) >> MegabyteShift;
                for (long m = chunk >> MegabyteShift; m <= last; m++)
                {
                    long at = _snapMegabytes + m * WordSize.Bytes;
                    if (Sys.Peek(at) == 0) Sys.Poke(at, i + 1);
                }
            }
        }
#endif
        return true;
    }

    public static long SnapshotChunk(long i)
    {
        return i < _snapCount ? Sys.Peek(_snap + i * WordSize.Bytes) : 0;
    }

    public static long OfSnapshot(long at)
    {
#if TARGET_64BIT
        if (!_snapFilterOff && _snapRegions != 0)
        {
            long top = at >> RegionTopShift;
            if (top < 0 || top >= RegionTops) return 0;
            long bitmap = Sys.Peek(_snapRegions + top * WordSize.Bytes);
            if (bitmap == 0) return 0;
            long within = (at >> RegionShift) & ((1L << (RegionTopShift - RegionShift)) - 1);
            if ((Sys.PeekByte(bitmap + (within >> 3)) & (1 << (int)(within & 7))) == 0) return 0;
        }
#else
        if (_snapMegabytes != 0)
        {
            long address = at & WordSize.AddressMask;
            long i = (Sys.Peek(_snapMegabytes + (address >> MegabyteShift) * WordSize.Bytes) & WordSize.AddressMask) - 1;
            if (i < 0) return 0;
            // The chunks from there on, in address order, while one could hold it.
            while (i < _snapCount)
            {
                long chunk = Sys.Peek(_snap + i * WordSize.Bytes) & WordSize.AddressMask;
                if (chunk > address) return 0;
                if (address < (Sys.Peek(chunk + ChunkLimit) & WordSize.AddressMask)) return chunk;
                i = i + 1;
            }
            return 0;
        }
#endif
        long low = 0, high = _snapCount;
        while (low < high)
        {
            long middle = low + (high - low) / 2;
            if ((Sys.Peek(_snap + middle * WordSize.Bytes) & WordSize.AddressMask) <= (at & WordSize.AddressMask)) low = middle + 1;
            else high = middle;
        }
        if (low == 0) return 0;
        long candidate = Sys.Peek(_snap + (low - 1) * WordSize.Bytes);
        return (at & WordSize.AddressMask) < (Sys.Peek(candidate + ChunkLimit) & WordSize.AddressMask) ? candidate : 0;
    }

    public static long PrepareBlockAnchors(long chunk)
    {
        long anchors = Sys.Peek(chunk + ChunkAnchors);
        if (anchors == 0)
        {
            long bytes = AnchorBytes(chunk);
            anchors = Platform.Map(bytes);
            if (anchors != 0)
            {
                Sys.Poke(chunk + ChunkAnchors, anchors);
                _anchorBytes = _anchorBytes + bytes;
            }
        }
        return anchors;
    }

    public static void SetBlockAnchorsActive(bool active) { _anchorsActive = active; }

    public static long MarkStart(long chunk, long address)
    {
        if (_anchorsActive)
        {
            long anchors = Sys.Peek(chunk + ChunkAnchors);
            if (anchors != 0)
            {
                long block = Sys.Peek(anchors + ((address - chunk) / 4096) * WordSize.Bytes);
                if (block != 0) return block;
            }
        }
        // A metadata allocation failure preserves the authoritative walk.
        return First(chunk);
    }

    static long IndexLowerBound(long address)
    {
        long low = 0, high = _indexCount;
        while (low < high)
        {
            long middle = low + (high - low) / 2;
            if (Sys.Peek(_index + middle * WordSize.Bytes) < address) low = middle + 1;
            else high = middle;
        }
        return low;
    }

    static void IndexAdd(long chunk)
    {
        if (_indexFailed) return;
        if (_indexCount == _indexCapacity)
        {
            long capacity = _indexCapacity == 0 ? 1024 : _indexCapacity * 2;
            long grown = Platform.Map(capacity * WordSize.Bytes);
            if (grown == 0)
            {
                // Never publish an incomplete index. The authoritative list
                // still contains every chunk and remains a correct fallback.
                _indexFailed = true;
                if (_index != 0) Platform.Unmap(_index, _indexCapacity * WordSize.Bytes);
                _index = 0;
                _indexCount = 0;
                _indexCapacity = 0;
                return;
            }
            for (long i = 0; i < _indexCount; i++)
                Sys.Poke(grown + i * WordSize.Bytes, Sys.Peek(_index + i * WordSize.Bytes));
            // THE OLD TABLE IS KEPT, not unmapped: a reader that had loaded
            // its address -- the collector resolving a pointer with nothing
            // held -- may still be searching it, and an unmapped page under
            // it faulted. Doubling, all the tables left behind come to less
            // than the one in use.
            _index = grown;
            _indexCapacity = capacity;
        }
        long at = IndexLowerBound(chunk);
        for (long i = _indexCount; i > at; i--)
            Sys.Poke(_index + i * WordSize.Bytes, Sys.Peek(_index + (i - 1) * WordSize.Bytes));
        Sys.Poke(_index + at * WordSize.Bytes, chunk);
        _indexCount++;
    }

    static void IndexRemove(long chunk)
    {
        if (_indexFailed || _indexCount == 0) return;
        long at = IndexLowerBound(chunk);
        if (at == _indexCount || Sys.Peek(_index + at * WordSize.Bytes) != chunk) return;
        for (long i = at + 1; i < _indexCount; i++)
            Sys.Poke(_index + (i - 1) * WordSize.Bytes, Sys.Peek(_index + i * WordSize.Bytes));
        _indexCount--;
        Sys.Poke(_index + _indexCount * WordSize.Bytes, 0);
    }

    public static long HeapBytes
    {
        get { return _heapBytes; }
    }

    public static void SetLimit(long bytes)
    {
        _cap = bytes;
    }

    /// The cap SetLimit put on the heap, or 0 for none.
    public static long Cap
    {
        get { return _cap; }
    }

    public static bool Any()
    {
        return _chunks != 0;
    }

    /// The newest chunk, the head of the list; Next walks towards the oldest.
    public static long Newest()
    {
        return _chunks;
    }

    public static long Next(long chunk)
    {
        return Sys.Peek(chunk + ChunkNext);
    }

    /// Where a chunk's blocks begin.
    public static long First(long chunk)
    {
        return chunk + ChunkBytes;
    }

    /// Whether anything was allocated in the chunk since the last collection.
    public static bool IsYoung(long chunk)
    {
        return (Sys.Peek(chunk + ChunkFlags) & ChunkYoung) != 0;
    }

    public static void SetYoung(long chunk, bool young)
    {
        long flags = Sys.Peek(chunk + ChunkFlags);
        Sys.Poke(chunk + ChunkFlags, young ? flags | ChunkYoung : flags & ~ChunkYoung);
    }

    /// The chunk a block handed out lies in, made young. Heap lock held.
    public static void YoungAt(long block)
    {
        long chunk = Of(block);
        if (chunk != 0)
        {
            SetYoung(chunk, true);
        }
    }

    public static long LiveBytes(long chunk)
    {
        return Sys.Peek(chunk + ChunkLiveBytes);
    }

    public static long LiveBlocks(long chunk)
    {
        return Sys.Peek(chunk + ChunkLiveBlocks);
    }

    public static long LargestHole(long chunk)
    {
        return Sys.Peek(chunk + ChunkLargestHole);
    }

    public static void SetLargestHole(long chunk, long bytes)
    {
        Sys.Poke(chunk + ChunkLargestHole, bytes);
    }

    public static void SetLive(long chunk, long blocks, long bytes)
    {
        Sys.Poke(chunk + ChunkLiveBlocks, blocks);
        Sys.Poke(chunk + ChunkLiveBytes, bytes);
    }

    /// One past the last block laid down in a chunk.
    public static long End(long chunk)
    {
        return Sys.Peek(chunk + ChunkEnd);
    }

    /// Takes a chunk out of the list and gives its memory back. The floor and
    /// ceiling are left as they were: an address inside a gone chunk still
    /// fails the lookup that follows the envelope test.
    /// Chunks taken from the operating system and given back, and of those
    /// given back the ones not of the usual size -- a large array's own:
    /// what says whether a program's heap is churning its mappings.
    public static long Maps, Releases, BigReleases;

    public static void Release(long chunk)
    {
        long size = Sys.Peek(chunk + ChunkLimit) - chunk;
        IndexRemove(chunk);

        if (_chunks == chunk)
        {
            _chunks = Sys.Peek(chunk + ChunkNext);
        }
        else
        {
            long walk = _chunks;

            while (walk != 0 && Sys.Peek(walk + ChunkNext) != chunk)
            {
                walk = Sys.Peek(walk + ChunkNext);
            }

            if (walk != 0)
            {
                Sys.Poke(walk + ChunkNext, Sys.Peek(chunk + ChunkNext));
            }
        }

        if (_memo == chunk)
        {
            _memo = 0;
        }

        _heapBytes = _heapBytes - size;
        Releases = Releases + 1;
        if (size != ChunkAsk) BigReleases = BigReleases + 1;
        long anchors = Sys.Peek(chunk + ChunkAnchors);
        if (anchors != 0)
        {
            long bytes = AnchorBytes(chunk);
            Platform.Unmap(anchors, bytes);
            _anchorBytes = _anchorBytes - bytes;
        }
        Platform.Unmap(chunk, size);
    }

    public static void SetEnd(long chunk, long end)
    {
        Sys.Poke(chunk + ChunkEnd, end);
    }

    /// One past the chunk's memory.
    public static long Limit(long chunk)
    {
        return Sys.Peek(chunk + ChunkLimit);
    }

    /// The chunk whose laid-down blocks contain an address, or zero. The
    /// chunk hit last is tried first, because a run of pointers from one
    /// object mostly lands in one chunk. Other addresses use binary search;
    /// only an index allocation failure requires walking the chunk list.
    public static long Of(long at)
    {
        if (at < _floor || at >= _ceiling)
        {
            return 0;
        }

        long memo = _memo;

        if (memo != 0 && at >= memo + ChunkBytes && at < Sys.Peek(memo + ChunkEnd))
        {
            return memo;
        }

        if (!_indexFailed)
        {
            // Find the greatest chunk base <= at. Mappings cannot overlap;
            // the live extent check rejects headers, gaps and unused tails.
            long low = 0, high = _indexCount;
            while (low < high)
            {
                long middle = low + (high - low) / 2;
                if (Sys.Peek(_index + middle * WordSize.Bytes) <= at) low = middle + 1;
                else high = middle;
            }
            if (low == 0) return 0;
            long candidate = Sys.Peek(_index + (low - 1) * WordSize.Bytes);
            if (at >= candidate + ChunkBytes && at < Sys.Peek(candidate + ChunkEnd))
            {
                _memo = candidate;
                return candidate;
            }
            return 0;
        }

        long chunk = _chunks;

        while (chunk != 0)
        {
            if (at >= chunk + ChunkBytes && at < Sys.Peek(chunk + ChunkEnd))
            {
                _memo = chunk;
                return chunk;
            }
            chunk = Sys.Peek(chunk + ChunkNext);
        }
        return 0;
    }

    /// A new chunk with room for at least `need` bytes of blocks, or zero
    /// when the cap or the operating system refuses. Zeroed, page-aligned.
    public static long Take(long need, bool dedicated = false)
    {
        long minimum = (need + ChunkBytes + 4095) & -4096;
        long ask = dedicated || minimum > ChunkAsk ? minimum : ChunkAsk;

        // THE CEILING IS WHERE GROWTH WAITS FOR A COLLECTION (Gc.GrowthWaits):
        // refused here, the allocator collects first and asks again.
        if (Gc.GrowthWaits(ask))
        {
            return 0;
        }

        // The preferred growth quantum is not a minimum allocation size.
        // A smaller remaining cap (or address-space hole) can still satisfy
        // this request. Count actual mapped pages against the heap cap.
        if (_cap != 0 && _heapBytes + ask > _cap) ask = minimum;

        if (_cap != 0 && _heapBytes + ask > _cap)
        {
            string capped = "heap: the cap refused a chunk\n";
            Runtime.WriteLiteral(2, capped);
            return 0;
        }

        long raw = Platform.Map(ask);
        if (raw == 0 && ask > minimum)
        {
            ask = minimum;
            raw = Platform.Map(ask);
        }

        if (raw == 0)
        {
            return 0;
        }

        Maps = Maps + 1;
        Sys.Poke(raw + ChunkNext, _chunks);
        Sys.Poke(raw + ChunkEnd, raw + ChunkBytes);
        Sys.Poke(raw + ChunkLimit, raw + ask);
        Sys.Poke(raw + ChunkFlags, ChunkYoung);
        // ITS START TABLE WITH IT: a collection must never map, because the
        // collection that needs to is the one the address space ran out for.
        // Taken lazily, at the first collection, it was refused exactly then,
        // the snapshot was given up, and nothing could be freed at all.
        if (PrepareBlockAnchors(raw) == 0)
        {
            Platform.Unmap(raw, ask);
            Maps = Maps - 1;
            return 0;
        }
        _chunks = raw;
        _heapBytes = _heapBytes + ask;
        IndexAdd(raw);

        // Most words a conservative collector looks at are integers, code
        // addresses or null; the envelope rejects them before the list is
        // walked.
        if (_floor == 0 || raw + ChunkBytes < _floor)
        {
            _floor = raw + ChunkBytes;
        }
        if (raw + ask > _ceiling)
        {
            _ceiling = raw + ask;
        }
        return raw;
    }
}

// ---- roots: where the live pointers begin ----------------------------------------
//
// The conservative collector's roots are RANGES OF MEMORY: every word in
// them is handed to Gc.MarkAt, and the ones that land on a block keep it.
// A precise collector replaces this class with one that walks stack maps
// and reference maps and hands over exact slots; Gc's marking does not
// care which.

static class GcRoots
{
    /// Enters a collection with every register on the stack.
    ///
    /// THE REGISTERS. A pointer held only in a register is still a pointer,
    /// and the collector reads memory, so every register must be in memory
    /// below the point the stack scan starts from. The reasoning, which is
    /// the reason Collect is reached only from Alloc:
    ///
    ///   - EAX, ECX and EDX are caller-saved: any value the caller of Alloc
    ///     still needs after the call is already somewhere else -- a frame
    ///     slot or a callee-saved register -- because the call clobbers them.
    ///   - EBX, ESI and EDI are callee-saved: a caller's live value in one of
    ///     them survives the call untouched, which means it may be ONLY in
    ///     that register. It reaches the stack when some frame between the
    ///     caller and the scan pushes that register in its prologue. The
    ///     backend pushes exactly the callee-saved registers a function uses,
    ///     so the guarantee is made explicit: Platform.EnterCollection uses
    ///     all of them (on Linux, by making a system call, which needs EBX,
    ///     ECX, EDX, ESI and EDI), so its prologue pushes them, and only THEN
    ///     calls back into Gc.CollectInner. Those pushes are above
    ///     CollectInner's ESP and inside the range ScanAll scans.
    ///   - EBP is the frame pointer, pushed by every prologue.
    ///
    /// This is a property of the backend's prologue that a test checks by
    /// reading the assembly; it is not something the language can state.
    public static void Enter()
    {
        Platform.EnterCollection();
    }

    /// Every root range: the machine stack from the current ESP (which
    /// includes the collector's own frames, harmlessly) up to the stack
    /// pointer the process was entered with, and the statics between the
    /// linker's __data_start and _end -- the data and bss sections, where
    /// every static field lives.
    public static void ScanAll()
    {
        // This thread's stack, from where the collector is standing to the
        // top the thread began at. Every OTHER thread's stack is marked from
        // by that thread itself, or by the collector for it while it is
        // blocked, in the SCAN round (GcThreads) -- never by stopping it.
        Gc.ScanRoots(Sys.Stack(), Sys.EntryStack());
        Gc.ScanRange(Sys.DataStart(), Sys.DataEnd());

        long i = 0;

        while (_extra != 0 && i < ExtraMax)
        {
            long start = Sys.Peek(_extra + i * (2 * WordSize.Bytes));
            // A slot whose start is the claim mark is one a thread is filling
            // in: its end is not written yet and there is nothing to scan.
            if (start != 0 && start != Claiming)
            {
                Gc.ScanRange(start, Sys.Peek(_extra + i * (2 * WordSize.Bytes) + WordSize.Bytes));
            }
            i = i + 1;
        }
    }

    // ---- roots the collector is told about ----------------------------------
    //
    // Sys.DataStart and Sys.DataEnd are the linker's __data_start and _end,
    // which describe ONE image. When this library is a shared object, its
    // statics and the executable's statics are two separate ranges and only
    // one of them is the one those symbols resolve to, so the other has to be
    // handed over at start -- as does any memory outside the heap that holds
    // references (a mapped region, a thread's stack). A range registered here
    // is scanned exactly as the statics are.
    //
    // The table is memory of the operating system's rather than a static
    // array, because registering a root must not itself allocate: it happens
    // before the heap is up, and a heap block would also be a block the
    // collector has to keep alive forever.

    const long ExtraMax = 128;
    const long ExtraBytes = ExtraMax * (2 * WordSize.Bytes);

    // A slot's start word is also how it is owned: zero is free, this is
    // taken but not yet filled in, anything else is a range being scanned.
    const long Claiming = 1;

    static long _extra;

    /// Adds [start, end) to the root ranges every collection scans. Answers
    /// false only if the table is full or the operating system refuses it,
    /// which a caller registering a handful of ranges at start cannot hit.
    public static bool Register(long start, long end)
    {
        if (start == 0 || end <= start)
        {
            return false;
        }

        if (_extra == 0)
        {
            _extra = Platform.Map(ExtraBytes);

            if (_extra == 0)
            {
                return false;
            }
        }

        // A SLOT IS TAKEN, NOT CHOSEN. Two threads registering at once --
        // two processors parking a kernel continuation, each on its own
        // stack -- both found the same slot empty and both wrote into it:
        // one's start beside the other's end. The pair that came out named
        // a range beginning on one stack and ending on another, with
        // whatever lay between them, and the next collection walked into
        // the gap and faulted in the kernel. The start word is claimed
        // first, with a compare and swap, and nothing else is written to
        // the slot until it belongs to this thread.
        for (long i = 0; i < ExtraMax; i++)
        {
            long at = _extra + i * (2 * WordSize.Bytes);

            if (Sys.Cas(at, 0, Claiming) != 0)
            {
                continue;
            }

            Sys.Poke(at + WordSize.Bytes, end);
            Sys.Fence();                  // the end is there before the start says so
            Sys.Poke(at, start);
            Gc.MarkRegistered(start, end);
            return true;
        }

        return false;
    }

    // The caller serializes root registration/removal against collection.
    public static bool Unregister(long start, long end)
    {
        for (long i = 0; _extra != 0 && i < ExtraMax; i++)
        {
            long at = _extra + i * (2 * WordSize.Bytes);
            if (start == 0 || Sys.Peek(at) != start || Sys.Peek(at + WordSize.Bytes) != end) continue;
            // The start goes first, and atomically: a slot whose start is
            // zero is free, and it must not become free while its end still
            // names this stack.
            Sys.AtomicSwap(at, 0);
            Sys.Poke(at + WordSize.Bytes, 0);
            return true;
        }
        return false;
    }
}

// ---- one heap, many threads ---------------------------------------------------
//
// THE RULE. The heap -- the free lists, the chunk list, the bump pointer, the
// mark queue and every counter here -- belongs to whoever holds GcLock. A
// thread allocating out of its own buffer holds nothing, because nothing else
// may touch that buffer; everything else takes the lock.
//
// STOPPING THE WORLD, without a signal. A conservative collector reads other
// threads' stacks, so they must not be running while it does, and it must not
// sweep while another thread is bumping in a buffer whose tail is not yet a
// block. So the collector:
//
//   1. sets `collecting`, with the lock held (only the holder ever collects),
//   2. takes every other thread's allocation buffer away, by zeroing its
//      limit -- the fast path's bound, so the very next allocation on that
//      thread cannot bump and comes to the slow path,
//   3. waits until every other registered thread says it has stopped: at the
//      slow path, at the lock, or on its way into a system call that blocks,
//   4. retires their buffers itself, with the lock held, so every chunk is a
//      chain of blocks again, then marks and sweeps,
//   5. clears `collecting` and wakes everyone.
//
// WHAT THIS DOES NOT DO, and it is the known limitation: a thread that is
// neither allocating nor blocking is not stopped, and the collector waits for
// it. A long computation that allocates nothing therefore DELAYS every other
// thread's collection until it allocates, blocks or ends. Nothing is lost and
// nothing is corrupted -- the collector simply waits -- but a program can be
// written whose pause is as long as its longest allocation-free stretch. The
// fix is the safepoint poll the design calls for (X86-BACKEND.md, "Memory"):
// the compiler emitting a check of one word at every back edge and call, which
// turns "eventually allocates" into "within a loop iteration". Until then this
// is the contract, and it is why the runtime's own waits -- the futex in
// lib/threading.cor, the sleep in the scheduler -- say so through
// Runtime.BeginBlocking.

/// The heap lock, and the flag that says a collection is running. Both are
/// words of memory from the operating system rather than static fields: a
/// futex needs an address, and a static field has none the language can take.
static class GcLock
{
    public const long Collecting = 0 * WordSize.Bytes;   // 1 while a collection is running
    public const long Held = 1 * WordSize.Bytes;         // the heap lock: 0 free, else the thread block of its holder
    public const long Collector = 2 * WordSize.Bytes;    // the thread block of whoever is collecting
    public const long Cycling = 3 * WordSize.Bytes;     // 1 from a collection's first stop to the end of its last
    public const long BarrierTail = 4 * WordSize.Bytes; // the barrier's ring: places claimed,
    public const long BarrierHead = 5 * WordSize.Bytes; //   places taken,
    public const long BarrierLost = 6 * WordSize.Bytes; //   and whether a report was dropped
    // HANDSHAKES (GcThreads): what the collector is asking every thread to
    // do, which round of asking this is, and how many have not done it yet.
    public const long Epoch = 7 * WordSize.Bytes;       // the round; a thread's Tls.Epoch says which it has done
    public const long Request = 8 * WordSize.Bytes;     // what the round asks: GcThreads.Stamp, Scan or Ack
    public const long Pending = 9 * WordSize.Bytes;     // threads that still owe this round
    // THE GREY QUEUE (Gc.PushGrey): blocks marked and not yet scanned, many
    // pushers and many takers, nothing held.
    public const long GreyTail = 10 * WordSize.Bytes;    // places claimed
    public const long GreyHead = 11 * WordSize.Bytes;    // places taken
    public const long Pushes = 12 * WordSize.Bytes;      // blocks ever marked: termination looks for no change
    public const long Active = 13 * WordSize.Bytes;      // threads scanning a block they took off the queue
    public const long Overflow = 14 * WordSize.Bytes;    // a push found the queue full: the rescan finds it
    public const long Abort = 15 * WordSize.Bytes;       // this cycle is being given up (a lost barrier report)
    // What the collector sleeps on while it waits for a round: moved on by
    // everything that could let the round finish -- an answer, a thread
    // blocking, a thread leaving -- so that a wake sent before the collector
    // went to sleep is never lost (the futex sleeps only while it is unmoved).
    public const long Stirs = 16 * WordSize.Bytes;

    static long _words;

    /// The collection round now, without making the control words: 0 while
    /// nothing has made them, since no round has been asked yet.
    public static long EpochIfMade()
    {
        long at = _words;
        return at == 0 ? 0 : Sys.Peek(at + Epoch);
    }

    public static long Words()
    {
        if (_words == 0)
        {
            _words = Platform.Map(4096);
        }
        return _words;
    }

    /// Whether somebody is collecting, at the moment of asking. Cheap, and
    /// false before anything has ever allocated.
    public static bool IsCollecting()
    {
        long at = _words;

        if (at == 0)
        {
            return false;
        }
        return Sys.Peek(at + Collecting) != 0;
    }

    /// Whether THIS thread holds the heap lock. On a kernel an interrupt
    /// lands on top of the holder -- the collector sweeping a chunk, an
    /// allocation refilling its buffer -- and anything it then does that
    /// might allocate would wait for a lock its own thread holds, for ever.
    /// What can be put off, asks this first.
    public static bool HeldByMe()
    {
        long at = _words;
        long me = Sys.ThreadBlock();
        if (me == 0) me = 1;
        return at != 0 && Sys.Peek(at + Held) == me;
    }

    /// Whether `block` is the thread doing the collection that is running.
    /// THE COLLECTOR NEVER STOPS FOR ITSELF. On a kernel it is interrupted
    /// like anybody else, and the handler may wait for a lock -- a wait that
    /// is a blocking region, whose end parks the thread until the collection
    /// is over. Parked there, on the collector's own stack, it never is.
    public static bool IsCollector(long block)
    {
        long at = _words;
        return at != 0 && block != 0 && Sys.Peek(at + Collector) == block;
    }

    public static void Enter()
    {
        long at = Words() + Held;

        // THE WORD THAT SAYS IT IS HELD SAYS BY WHOM, in the one exchange
        // that takes it. Two words -- held, then holder -- left an instant
        // between them in which an interrupt on top of the new holder was
        // told nobody it knew held the lock.
        long me = Sys.ThreadBlock();
        if (me == 0) me = 1;

        while (Sys.Cas(at, 0, me) != 0)
        {
            // A thread spinning for this lock is a thread the collector is
            // waiting for; without this the two would wait for each other.
            if (IsCollecting())
            {
                GcThreads.Park();
            }
            Sys.Pause();
        }
    }

    public static void Exit()
    {
        Sys.AtomicSwap(Words() + Held, 0);
    }
}

/// Every thread the collector must know about: where its stack is, and
/// whether it is running.
///
/// The table is memory of the operating system's and not an array, for the
/// same reason GcRoots' extra roots are: registering a thread must not
/// allocate, and a heap block here would be one the collector had to keep
/// alive forever. A program with one thread never makes the table at all.
static class GcThreads
{
    const long Max = 256;

    static long _blocks;        // Max words: the registered threads' blocks
    static long _count;
    static long _first;         // the one thread, before there is a table

    public static long Count()
    {
        return _count;
    }

    /// Whether any thread but this one is registered: whether there is
    /// anybody for a collection to let run.
    public static bool Others()
    {
        return _blocks != 0 && _count > 1;
    }

    static long At(long i)
    {
        return Sys.Peek(_blocks + i * WordSize.Bytes);
    }

    /// Adds a thread. The first one is only written down, because a program
    /// with one thread needs no table and must not ask for memory it will
    /// never read (a bare-metal program has no heap at all until it says so).
    ///
    /// A thread added while a collection is asking its rounds owes none of
    /// them: its stack began after every snapshot the collection took, and
    /// what it was handed came from a thread that does owe them.
    public static void Register(long block)
    {
        if (block == 0)
        {
            return;
        }

        // The FIRST thread is only written down, and takes no lock: a program
        // with one thread must not be made to ask for memory it will never
        // read, and on bare metal there is no memory to ask for until the
        // program has said where the heap is -- which is why its epoch is
        // read without making the control words (a boot loader's entry
        // registers its thread before Main can call Platform.SetHeap).
        if (_blocks == 0 && _first == 0)
        {
            Sys.Poke(block + Tls.Epoch, GcLock.EpochIfMade());
            _first = block;
            return;
        }

        GcLock.Enter();

        // Tested again with the lock held: two threads starting a third and a
        // fourth at once would otherwise both make the table.
        if (_blocks == 0)
        {
            _blocks = Platform.Map(Max * WordSize.Bytes);
            Add(_first);
            _first = 0;
        }

        // FROM ONE THREAD TO TWO: what the one gave its bins from inside its
        // buffer is taken back and kept in place (Gc.Free).
        if (_count == 1)
        {
            Gc.KeepBufferInPlace(At(0));
        }
        Sys.Poke(block + Tls.Epoch, Sys.Peek(GcLock.Words() + GcLock.Epoch));
        Add(block);
        GcLock.Exit();
    }

    /// The thread whose live allocation buffer holds `at`, or 0. The heap
    /// lock is held, so no buffer is taken or retired meanwhile. The calling
    /// thread's own is looked at first: it holds what that thread frees.
    public static long BufferHolding(long at)
    {
        long self = Sys.ThreadBlock();

        if (Holds(self, at))
        {
            return self;
        }
        if (_blocks == 0)
        {
            return _first != self && Holds(_first, at) ? _first : 0;
        }
        for (long i = 0; i < _count; i++)
        {
            long t = At(i);

            if (t != self && Holds(t, at))
            {
                return t;
            }
        }
        return 0;
    }

    static bool Holds(long thread, long at)
    {
        if (thread == 0)
        {
            return false;
        }
        long start = Sys.Peek(thread + Tls.AllocBase);
        long limit = Sys.Peek(thread + Tls.AllocLimit);

        // A thread asked to answer a handshake has its limit kept aside.
        if (limit == 0)
        {
            limit = Sys.Peek(thread + Tls.AllocSaved);
        }
        return start != 0 && at >= start && at < limit;
    }

    /// Called with the lock held.
    static void Add(long block)
    {
        if (_blocks != 0 && _count < Max && block != 0)
        {
            Sys.Poke(_blocks + _count * WordSize.Bytes, block);
            _count = _count + 1;
        }
    }

    /// Takes a thread out: its stack is about to stop being a stack. A round
    /// it still owes is answered here -- its buffer's objects are written down
    /// as it is retired, and its stack no longer matters -- so the collector
    /// does not wait for a thread that is gone. A thread being answered for
    /// by the collector at this moment (Busy) is waited out first.
    public static void Deregister(long block)
    {
        if (_blocks == 0)
        {
            if (_first == block)
            {
                _first = 0;
            }
            return;
        }

        while (true)
        {
            long state = Sys.Peek(block + Tls.State);

            if (state != Busy && (Sys.Cas(block + Tls.State, state, Gone) & WordSize.AddressMask) == state)
            {
                break;
            }

            Sys.Pause();
        }

        GcLock.Enter();
        Gc.Retire(block);
        Settle(block);

        long i = 0;

        while (i < _count)
        {
            if (At(i) == block)
            {
                Sys.Poke(_blocks + i * WordSize.Bytes, At(_count - 1));
                _count = _count - 1;
                i = _count;
            }
            else
            {
                i = i + 1;
            }
        }

        GcLock.Exit();
    }

    // ---- handshakes ----------------------------------------------------------
    //
    // THE COLLECTOR NEVER STOPS A THREAD. It asks, in rounds: it names what
    // the round wants (GcLock.Request), counts the threads that owe it
    // (Pending), and moves the round number on (Epoch). A running thread
    // answers at its next safepoint -- its next slow allocation, the end of a
    // wait, a spin on the heap lock, or on a kernel an interrupt the collector
    // sends for the purpose -- does the round's work on its own buffer or its
    // own stack, and carries on. A thread that is blocked cannot answer, so
    // the collector answers for it: it takes the thread's state from Stopped
    // to Busy, does the work on the stack the thread published, and gives the
    // state back; a thread whose wait ends meanwhile waits for Busy to pass
    // before it runs (EndBlocking).
    //
    // To be answered soon, a running thread's buffer limit is taken away as
    // the round is asked, so its very next allocation comes to the slow path.

    /// What a round asks.
    public const long Stamp = 1;    // write down where your buffer's objects start
    public const long Scan = 2;     // mark from your stack
    public const long Ack = 3;      // pass a safepoint: be out of any barrier

    /// Thread states (Tls.State).
    public const long Running = 0;
    public const long Stopped = 1;
    public const long Busy = 2;     // stopped, and the collector is answering for it
    public const long Gone = 3;     // deregistering

    public static long Answered, AnsweredFor;

    /// Asks every other thread for `request` and returns when all have
    /// answered. Called by the collector, without the heap lock. While it
    /// waits it answers for the blocked, marks what is queued, prompts the
    /// ones that have not answered, and waits a turn.
    public static void Round(long request)
    {
        long ctl = GcLock.Words();
        long self = Sys.ThreadBlock();

        GcLock.Enter();
        long epoch = (Sys.Peek(ctl + GcLock.Epoch) + 1) & 0x7FFFFFFF;
        long owed = 0;
        long i = 0;

        while (i < _count)
        {
            long block = At(i);

            if (block != self && Sys.Peek(block + Tls.State) == Gone)
            {
                // Leaving, and waiting for this lock to do it: not counted, so
                // marked square with the round, or its Settle on the way out
                // would take a count some other thread still owes.
                //
                // ITS BUFFER IS STAMPED HERE, for it. It bumps nothing more,
                // and it cannot retire the buffer until this lock is let go
                // -- perhaps after stamping has closed, when Retire no longer
                // writes the objects in. Unstamped they would be newcomers:
                // kept, never traced, and what only they refer to swept.
                if (request == Stamp)
                {
                    Gc.StampBuffer(block);
                }
                Sys.Poke(block + Tls.Epoch, epoch);
            }
            else if (block != self)
            {
                owed = owed + 1;

                // The buffer's limit taken away: the next allocation on that
                // thread comes to the slow path, which answers.
                long limit = Sys.Peek(block + Tls.AllocLimit);
                if (limit != 0)
                {
                    Sys.Poke(block + Tls.AllocSaved, limit);
                    Sys.AtomicSwap(block + Tls.AllocLimit, 0);
                }
            }
            i = i + 1;
        }

        Sys.AtomicSwap(ctl + GcLock.Request, request);
        Sys.AtomicSwap(ctl + GcLock.Pending, owed);
        // Last: a thread that sees the new round sees what it asks and how
        // many owe it.
        Sys.AtomicSwap(ctl + GcLock.Epoch, epoch);
        Sys.Poke(self + Tls.Epoch, epoch);
        GcLock.Exit();
        Gc.HandshakeRounds = Gc.HandshakeRounds + 1;

        long turns = 0;

        while (true)
        {
            // Read BEFORE looking for blocked threads: one that blocks after
            // the look moves it, and the sleep below does not happen.
            long stirs = Sys.Peek(ctl + GcLock.Stirs);
            long pending = Sys.Peek(ctl + GcLock.Pending);

            if (pending <= 0)
            {
                return;
            }

            AnswerForStopped(epoch, request);

            if (Sys.Peek(ctl + GcLock.Pending) <= 0)
            {
                return;
            }

            if (request != Stamp)
            {
                Gc.Assist(64);
            }

            if ((turns & 0xF) == 0)
            {
                Platform.PromptStop();
            }

            turns = turns + 1;
            Platform.Wait(ctl + GcLock.Stirs, stirs);
            Sys.Pause();
        }
    }

    /// The round, done for every thread that owes it and is blocked. The
    /// heap lock is held for the walk of the table, which a thread starting
    /// or ending may otherwise be changing.
    static void AnswerForStopped(long epoch, long request)
    {
        long ctl = GcLock.Words();
        long self = Sys.ThreadBlock();

        GcLock.Enter();
        long i = 0;

        while (i < _count)
        {
            long block = At(i);

            if (block != self && Sys.Peek(block + Tls.Epoch) != epoch
                && (Sys.Cas(block + Tls.State, Stopped, Busy) & WordSize.AddressMask) == Stopped)
            {
                if (Sys.Peek(block + Tls.Epoch) != epoch)
                {
                    // Blocked: its stack from where it stopped, and the
                    // registers it stopped with (Tls.Spill).
                    if (request == Scan)
                    {
                        Gc.ScanRoots(block + Tls.Spill, block + Tls.Spill + Sys.Peek(block + Tls.SpillCount) * WordSize.Bytes);
                    }
                    Work(block, request, Sys.Peek(block + Tls.StackLimit));
                    Sys.Poke(block + Tls.Epoch, epoch);
                    Sys.AtomicAdd(ctl + GcLock.Pending, -1);
                    AnsweredFor = AnsweredFor + 1;
                }

                Sys.AtomicSwap(block + Tls.State, Stopped);
                Platform.Wake(block + Tls.State, 1);
            }
            i = i + 1;
        }

        GcLock.Exit();
    }

    /// What a round asks, done on `block`'s behalf with its stack from `from`.
    static void Work(long block, long request, long from)
    {
        if (request == Stamp)
        {
            Gc.StampBuffer(block);
        }
        else if (request == Scan)
        {
            Gc.ScanStack(block, from);
        }
    }

    /// Whether `block` owes the round that is open.
    public static bool Owes(long block)
    {
        long at = GcLock.Words();

        return block != 0 && Sys.Peek(at + GcLock.Pending) > 0
            && Sys.Peek(block + Tls.Epoch) != Sys.Peek(at + GcLock.Epoch)
            && !GcLock.IsCollector(block);
    }

    /// This thread's answer to the open round, if it owes one, with its stack
    /// from `stack` up -- every register already below `stack` (a safepoint's
    /// spill, or a kernel's trap frame).
    public static void Answer(long stack)
    {
        long block = Sys.ThreadBlock();

        // Not from inside the allocator (InAlloc), and not while holding the
        // heap lock: an interrupt that lands in the middle of a buffer being
        // replaced finds its base new and its pointer old, and would write
        // down objects that are not there. The thread answers at its next
        // safepoint instead; the collector asks again.
        if (!Owes(block) || Sys.Peek(block + Tls.InAlloc) != 0 || GcLock.HeldByMe())
        {
            return;
        }

        long ctl = GcLock.Words();
        long epoch = Sys.Peek(ctl + GcLock.Epoch);
        long request = Sys.Peek(ctl + GcLock.Request);

        Work(block, request, stack);
        Settle(block);
        Answered = Answered + 1;
        Sys.Poke(block + Tls.HandshakeArmed, 0);
    }

    /// `block` is square with the open round, and the collector is told.
    static void Settle(long block)
    {
        long ctl = GcLock.Words();
        long epoch = Sys.Peek(ctl + GcLock.Epoch);

        if (Sys.Peek(ctl + GcLock.Pending) <= 0 || Sys.Peek(block + Tls.Epoch) == epoch
            || GcLock.IsCollector(block))
        {
            return;
        }

        Sys.Poke(block + Tls.Epoch, epoch);
        Sys.AtomicAdd(ctl + GcLock.Pending, -1);
        Stir();
    }

    /// The collector, if it is asleep waiting for a round, woken to look.
    static void Stir()
    {
        long ctl = GcLock.Words();
        Sys.AtomicAdd(ctl + GcLock.Stirs, 1);
        Platform.Wake(ctl + GcLock.Stirs, 1);
    }

    /// A safepoint: the open round answered, if this thread owes one. Never
    /// a wait.
    public static void Park()
    {
        Platform.SafePoint(Running);
    }

    /// This thread is about to wait on something that only another thread can
    /// answer: it counts as stopped, and its stack is read where it stands,
    /// until EndBlocking. The collector, waiting for it to answer a round,
    /// is told, so that it answers for it.
    public static void BeginBlocking()
    {
        long self = Sys.ThreadBlock();

        if (GcLock.IsCollector(self) || Sys.Peek(self + Tls.InAlloc) != 0 || GcLock.HeldByMe())
        {
            return;
        }

        Platform.SafePoint(Stopped);
    }

    // NOT FROM INSIDE THE ALLOCATOR OR THE BARRIER (Tls.InAlloc), NOR WITH
    // THE HEAP LOCK HELD. On a kernel an interrupt lands anywhere, its
    // handler may wait for a lock, and a wait is a blocking region -- on the
    // thread block of whatever it interrupted. If that was the few
    // instructions between an allocation's limit check and its bump, a
    // barrier's claim and its store, or a buffer half replaced under the heap
    // lock, counting the thread as stopped would let the collector answer for
    // it with a buffer half bumped or half replaced, or read a ring with a
    // report still missing. So there the wait is made as a running thread
    // (BeginBlocking tests the same, and the two always agree: the lock and
    // the allocator are the interrupted code's, held across the wait).
    public static void EndBlocking()
    {
        long block = Sys.ThreadBlock();

        if (GcLock.IsCollector(block) || Sys.Peek(block + Tls.InAlloc) != 0 || GcLock.HeldByMe())
        {
            return;
        }

        // Back to running -- unless the collector is answering for this
        // thread at this moment, reading its stack: then it waits the
        // moment out, since what it would do next is change that stack.
        while (true)
        {
            long state = Sys.Peek(block + Tls.State);

            if (state == Running || state == Gone)
            {
                break;
            }

            if (state == Stopped && (Sys.Cas(block + Tls.State, Stopped, Running) & WordSize.AddressMask) == Stopped)
            {
                break;
            }

            Platform.Wait(block + Tls.State, Busy);
            Sys.Pause();
        }

        if (Owes(block))
        {
            Platform.SafePoint(Running);
        }
    }

    /// A thread counted as stopped that is now standing on another stack --
    /// a kernel's trap entry, arriving from a program on the process's own
    /// kernel stack -- says so: where the collector reads it from and the
    /// top it reads up to, changed together. The block is claimed from the
    /// collector (Stopped to Busy, as the collector claims it to answer for
    /// the thread) for the two stores, so no scan ever pairs one stack's
    /// limit with another's top and reads across whatever lies between
    /// them. A running thread only moves its top.
    public static void MoveStack(long limit, long top)
    {
        long block = Sys.ThreadBlock();

        while (true)
        {
            long state = Sys.Peek(block + Tls.State);

            if (state != Stopped && state != Busy)
            {
                Sys.Poke(block + Tls.StackBase, top);
                return;
            }

            if (state == Stopped && (Sys.Cas(block + Tls.State, Stopped, Busy) & WordSize.AddressMask) == Stopped)
            {
                Sys.Poke(block + Tls.StackLimit, limit);
                Sys.Poke(block + Tls.StackBase, top);
                Sys.AtomicSwap(block + Tls.State, Stopped);
                return;
            }

            Platform.Wait(block + Tls.State, Busy);
            Sys.Pause();
        }
    }

    /// What Platform.SafePoint calls first when the thread is about to count
    /// as stopped: the frame it pushed every callee-saved register into,
    /// [from, to), copied into the thread block (Tls.Spill). Those registers
    /// are pushed at the frame's bottom, under its locals, so a frame larger
    /// than the room is copied from the bottom. The frame is gone once
    /// SafePoint returns and the wait begins; the copy is what the collector
    /// reads instead, and it stays true for the whole wait, because a
    /// register a caller left a value in is either pushed again by some
    /// frame still on the stack or not touched at all until the wait ends.
    public static void Spill(long mode, long from, long to)
    {
        if (mode == Running)
        {
            return;
        }

        long block = Sys.ThreadBlock();
        long words = to > from ? (to - from) / WordSize.Bytes : 0;

        if (words > Tls.SpillMax)
        {
            words = Tls.SpillMax;
        }

        for (long i = 0; i < words; i++)
        {
            Sys.Poke(block + Tls.Spill + i * WordSize.Bytes, Sys.Peek(from + i * WordSize.Bytes));
        }

        Sys.Poke(block + Tls.SpillCount, words);
    }

    /// What Platform.SafePoint calls once every callee-saved register is on
    /// the stack -- which is the whole reason it is entered that way, and the
    /// same reasoning as GcRoots.Enter's.
    public static void SafePoint(long mode)
    {
        long block = Sys.ThreadBlock();

        if (mode == Running)
        {
            Answer(Sys.Stack());
            return;
        }

        // Stopping: where this thread's live stack begins. Everything above
        // it, up to the top it started from, is what the collector reads.
        Sys.Poke(block + Tls.StackLimit, Sys.Stack());
        Sys.AtomicSwap(block + Tls.State, Stopped);

        if (Owes(block))
        {
            // The collector is waiting for this thread; it may be asleep
            // waiting. Now it can answer for it.
            Stir();
        }
    }

    // ---- the buffers in use, for the walks to step over ------------------------

    const long BufferMax = Max;
    static long _buffers;           // BufferMax pairs: base, limit; sorted by base
    static long _bufferCount;

    /// Every registered thread's allocation buffer as it stands, sorted by
    /// where it begins. The heap lock is held, so none is being replaced.
    public static void CaptureBuffers()
    {
        _bufferCount = 0;

        if (_buffers == 0)
        {
            _buffers = Platform.Map(BufferMax * (2 * WordSize.Bytes));

            if (_buffers == 0)
            {
                return;
            }
        }

        _bufferCount = CaptureBuffersInto(_buffers);
    }

    /// Every registered thread's buffer, base and limit, into `table`
    /// (room for BufferMax pairs), sorted by base; answers how many. The
    /// heap lock is held, so no buffer is replaced meanwhile -- a thread only
    /// bumps its pointer inside its own without it.
    public static long CaptureBuffersInto(long table)
    {
        long count = 0;
        long i = 0;

        while (i < _count || (i == 0 && _blocks == 0 && _first != 0))
        {
            long block = _blocks == 0 ? _first : At(i);
            long from = Sys.Peek(block + Tls.AllocBase);
            long limit = Sys.Peek(block + Tls.AllocLimit);

            if (limit == 0)
            {
                limit = Sys.Peek(block + Tls.AllocSaved);
            }

            if (from != 0 && limit > from && count < BufferMax)
            {
                // Insertion by base: a few entries, captured twice a collection.
                long at = count;

                while (at > 0 && Sys.Peek(table + (at - 1) * (2 * WordSize.Bytes)) > from)
                {
                    Sys.Poke(table + at * (2 * WordSize.Bytes), Sys.Peek(table + (at - 1) * (2 * WordSize.Bytes)));
                    Sys.Poke(table + at * (2 * WordSize.Bytes) + WordSize.Bytes, Sys.Peek(table + (at - 1) * (2 * WordSize.Bytes) + WordSize.Bytes));
                    at = at - 1;
                }

                Sys.Poke(table + at * (2 * WordSize.Bytes), from);
                Sys.Poke(table + at * (2 * WordSize.Bytes) + WordSize.Bytes, limit);
                count = count + 1;
            }

            if (_blocks == 0)
            {
                break;
            }
            i = i + 1;
        }
        return count;
    }

    public static long BufferTableBytes()
    {
        return BufferMax * (2 * WordSize.Bytes);
    }

    public static long BufferCount()
    {
        return _bufferCount;
    }

    /// Every registered thread's buffer unmarked (Gc.UnmarkBuffer), as the
    /// sweep that steps over them begins. The heap lock is held.
    public static void UnmarkBuffers()
    {
        if (_blocks == 0)
        {
            if (_first != 0) Gc.UnmarkBuffer(_first);
            return;
        }

        for (long i = 0; i < _count; i++)
        {
            Gc.UnmarkBuffer(At(i));
        }
    }

    public static long BufferBase(long i)
    {
        return Sys.Peek(_buffers + i * (2 * WordSize.Bytes));
    }

    public static long BufferLimit(long i)
    {
        return Sys.Peek(_buffers + i * (2 * WordSize.Bytes) + WordSize.Bytes);
    }

    /// The first captured buffer beginning at or above `address`.
    public static long BufferAtOrAbove(long address)
    {
        long i = 0;

        while (i < _bufferCount && BufferBase(i) < address)
        {
            i = i + 1;
        }

        return i;
    }
}
