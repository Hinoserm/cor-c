// The bare-metal platform library: the ONLY file that knows there is no
// operating system under the program.
//
// It sits exactly where runtime/src/platforms/linux/system.cor sits and answers exactly the same
// questions, so that nothing above it -- runtime/src/core/runtime.cor, runtime/src/core/gc.cor,
// stdlib/src/System/Core.cor, the program -- can tell which one is linked. Where system.cor
// makes an `int 0x80`, this drives the hardware directly with the port I/O
// intrinsics (docs/software/X86-BACKEND.md and X86-KERNEL.md, "Drivers: port
// I/O"), or calls the routine a kernel installed for it.
//
//   corc compile program.cor --freestanding --base 0x10000 --flat -o image.bin
//
// The driver links this file instead of system.cor when --freestanding is
// given, and leaves out the rest of the Linux platform (threading.cor,
// abi.cor, files.cor) and the class library over it: a Thread wants clone(2)
// and futexes, a file wants a kernel to keep it, and there is none to ask.
// (CORSAC's ring-1 kernels have one, below them, and compile files.cor
// beside this themselves: Os, below.) The scheduler
// (runtime/src/core/threading.cor) stays, and asks Clock and Native, at the
// end of this file, for what it needs of the machine.
//
// THE CONTRACT, the questions system.cor's Platform answers too:
//
//   Platform   what runtime/src/core/runtime.cor and gc.cor need from a system:
//              memory, exit, writing bytes, a call that may wait, and the
//              collector's questions (its checked modes, its pace, the
//              machine's memory, the other threads).
//                long Platform.Map(long bytes)  zeroed, aligned, or 0
//                void Platform.Exit(int code)   does not return
//                long Platform.WriteBytes(int fd, long at, long count)
//                long Platform.Blocking(long n, long a, long b, long c, ...)
//                void Platform.EnterCollection()
//              And the hooks: a kernel's routines (by Sys.AddressOf) for
//              what the bare machine has no answer to -- memory page by
//              page, a wait and a wake, the time, the async scheduler's
//              loop, an exit -- installed by CORSAC's kernel for itself,
//              and by its ring-1 kernels to ask the kernel BELOW them.
//              With none installed, each answers with the machine alone.
//   IConsole   where the bytes a program prints go: the console driver the
//              program links and points Platform.Console at, or nowhere.
//   Os         the handful of system.cor's Os names that mean anything with
//              no files and no processes.
//
// THREE THINGS ARE DIFFERENT FROM LINUX, and every one of them is a fact
// about the machine rather than a shortcut:
//
//   - MEMORY IS NOT ASKED FOR, it is taken. There is no mmap and nothing that
//     knows what is already in use, so the heap is one region whose bounds
//     the image is given: Platform.SetHeap, called before anything
//     allocates. Nobody can guess them, so an image that allocates with
//     neither them nor a MapHook stops with "no heap" (Map). The region is
//     handed out in pages, as mmap hands memory out, and what is given back
//     (Unmap) is handed out again; a kernel that keeps memory page by page
//     installs MapHook and UnmapHook, and what is mapped through them goes
//     back to it.
//   - NOTHING ZEROES .bss. The flat image's loader is told how many bytes
//     follow the image and has to clear them; a program that skipped that
//     would find its statics full of whatever was in memory.
//   - EXIT IS NOT A RETURN TO ANYTHING. There is nowhere to go, so the code
//     goes out of QEMU's isa-debug-exit port when one is attached -- that
//     machine exits with (code << 1) | 1 -- and then the processor is halted
//     with interrupts off, forever. An image that installed ExitHook calls
//     it first. A ring-1 kernel's ends the image through the kernel below
//     and does not return; the kernel's own returns for anything but a
//     module's unwind, and the machine then stops as above.

/// The I/O ports this file drives, all of them fixed by forty years of PC
/// hardware. A number here is a place on the machine, not a choice.
static class Port
{
    /// QEMU's isa-debug-exit device, when the machine was started with
    /// `-device isa-debug-exit,iobase=0xf4,iosize=4`. Writing a byte ends the
    /// emulation with (byte << 1) | 1, so 3 becomes an exit status of 7 and
    /// zero is not available -- which is why a success is reported as some
    /// agreed non-zero number and not as 0.
    public const int DebugExit = 0xF4;

    /// The keyboard controller's fast A20 gate: bit 1 of port 0x92.
    public const int SystemControlA = 0x92;
}

/// Where the bytes a program prints go. The platform library knows no
/// hardware: the program links the driver it wants (os/kernel/drivers/
/// uart8250.cor, vga.cor) and points this at it before printing. Until
/// then output is dropped, which is what a machine with no console does.
interface IConsole
{
    void Write(long address, long count);
}

/// What runtime/src/core/runtime.cor and runtime/src/core/gc.cor ask of the system.
///
/// The heap is the caller of Map, so NOTHING in this class may allocate: no
/// `new`, no arrays, no strings built at run time. A string LITERAL is data
/// the compiler laid out, and is fine. That is system.cor's rule and it is
/// the same rule here.
static class Platform
{
    /// A call that may wait, made as a blocking one to the collector, as the
    /// Linux platform makes one. A ring-1 kernel has a kernel below it, and
    /// System.IO's reads and writes come here (files.cor) on their way down
    /// its gate, which parks the call for as long as a pipe's server or a
    /// disc takes to answer. A thread parked there that the collector
    /// counted as running would hold every collection another thread
    /// started until the call came back. The stack is read where it stands
    /// meanwhile; the words the call was handed are on it, and they keep
    /// what they point into. Made by the collector, from inside the
    /// allocator or a barrier, or with the heap lock held, the call is a
    /// running thread's after all (GcThreads.BeginBlocking declines there);
    /// with one thread there is nobody to wait for it, and the bracket is a
    /// safepoint. Answers the kernel's raw number, as Sys.Syscall does.
    public static long Blocking(long n, long a, long b, long c, long d = 0, long e = 0, long f = 0)
    {
        Runtime.BeginBlocking();
        long raw = Sys.Syscall(n, a, b, c, d, e, f);
        Runtime.EndBlocking();
        return raw;
    }

    // THE COLLECTOR'S SETTINGS ARE THE IMAGE'S KNOBS here as hosted (corc's
    // --runtime-knob NAME=VALUE, Runtime.KnobValue): the same names and the
    // same readings as the Linux platform's, with what a kernel says on its
    // command line (CensusWanted, AllocSampleWanted, DeadCensusWanted,
    // ThresholdCap) beside them. Read with nothing allocated, at any time.

    /// Corsac.GC.VerifyFrees: the checked mode for the compiler's frees
    /// (Gc.VerifyFree); =f the fields freed with their owner only.
    public static bool VerifyFrees() => Runtime.KnobFlag("Corsac.GC.VerifyFrees") && Runtime.KnobLetter("Corsac.GC.VerifyFrees") != 'f';

    /// Corsac.GC.IgnoreFrees: which of the compiler's frees are ignored (the
    /// Linux platform's IgnoreFrees says what each letter is).
    public static long IgnoreFrees() => Runtime.KnobFlag("Corsac.GC.IgnoreFrees") ? Runtime.KnobLetter("Corsac.GC.IgnoreFrees") : 0;

    public static bool VerifyFieldFrees() => Runtime.KnobFlag("Corsac.GC.VerifyFrees") && Runtime.KnobLetter("Corsac.GC.VerifyFrees") == 'f';

    /// Corsac.GC.FreeLog: every field free recorded in a ring (Runtime.FreeLog).
    public static bool FreeLog() => Runtime.KnobFlag("Corsac.GC.FreeLog");

    /// Corsac.GC.FreePaths: the free paths skipped (Runtime.FreePathsMask).
    public static long SkippedFreePaths() => Runtime.FreePathsMask();

    /// Corsac.GC.GuardReleases: a chunk the heap releases is kept back
    /// rather than handed to the UnmapHook -- Guard makes nothing
    /// inaccessible here, there being no protection to ask for, so a stale
    /// reference reads what was there instead of faulting.
    public static bool GuardReleases() => Runtime.KnobFlag("Corsac.GC.GuardReleases");

    public static void Guard(long at, long bytes)
    {
    }

    /// Where the bump region begins and ends. A limit of zero means nobody
    /// has said (SetHeap), and Map stops the image rather than guess.
    private static long _at;
    private static long _limit;

    /// THE REGION IS HANDED OUT IN PAGES, aligned and whole, as the contract
    /// every platform keeps says (runtime.cor, "Platform.Map"): the
    /// collector's table of the chunk at every 4 KB (HeapChunks.SlotsSet)
    /// holds one chunk a page, and two chunks sharing a page -- the bump's
    /// 8-byte steps after an odd-sized table -- left the one that lost the
    /// entry unfound there, its live objects no heap's to the marker.
    const long RegionPage = 4096;

    /// The region's bookkeeping -- the bump, the free ranges -- taken round
    /// every change. Map and Unmap are called with the heap's lock held and
    /// without it (Marshal.AllocHGlobal), on a kernel's processors at once,
    /// AND FROM AN INTERRUPT HANDLER: a handler allocates nothing, but the
    /// owner it drops may hold a dedicated chunk, which Gc.Free hands back
    /// here (HeapChunks.Release). Taken with interrupts off where this code
    /// may turn them off (Platform.HandlerLockEnter), or a handler's free
    /// landing while thread code held it spun for ever with them off.
    private static nint _regionLock;

    static long LockRegion()
    {
        return HandlerLockEnter(Sys.AddressOf(ref _regionLock));
    }

    static void UnlockRegion(long held)
    {
        HandlerLockLeave(Sys.AddressOf(ref _regionLock), held);
    }

    /// Where the region began, which _at has moved on from: with _limit, the
    /// whole of the memory an image alone on the machine has (TotalMemory).
    private static long _start;

    /// The loader's word on where memory is.
    ///
    /// Called before the program allocates anything -- from the top of Main,
    /// or by whatever set the image up -- with the bounds of a region that is
    /// really there and really free. Whoever loaded the image is the only
    /// thing that knows: the firmware's memory map is gone by the time this
    /// code runs.
    public static void SetHeap(long start, long end)
    {
#if !TARGET_64BIT
        // NOT TO THE TOP OF 32 BITS: a chunk ending at 4 GiB has a limit word
        // of 0, and the collector's table, its sweep and its release then
        // saw no chunk there, or a negative size.
        if (end > 0x100000000 - RegionPage) end = 0x100000000 - RegionPage;
#endif
        long held = LockRegion();
        // ONCE, OR AGAIN ONLY BEFORE ANYTHING WAS HANDED OUT: the chunks the
        // first region gave are the collector's, and a second region over
        // or beside them would hand the same memory out twice, or send the
        // old chunks to an UnmapHook that never mapped them.
        if (_limit != 0 && _at != _start)
        {
            UnlockRegion(held);
            string text = "heap: Platform.SetHeap was called again after the heap was used\n";
            long units = Sys.StringData(text);
            for (int i = 0; i < text.Length; i++) WriteBytes(2, units + i * 2, 1);
            Exit(137);
        }
        _at = (start + RegionPage - 1) & -RegionPage;
        _start = _at;
        _limit = end & -RegionPage;
        UnlockRegion(held);
    }

    /// Where this image's data segment starts in the linear space: 0 for a
    /// flat image, the segment's base for one that is not (CORSAC's NT
    /// kernel, which says so before it makes a call). A kernel below is
    /// handed linear addresses (Linear), so files.cor's calls work either way.
    public static long SegmentBase;

    /// The linear address of `at`, an address in this image's own segment.
    public static long Linear(long at)
    {
        return at + SegmentBase;
    }

    /// Where memory comes from once there is an operating system in this
    /// image: the kernel installs the two routines (by Sys.AddressOf) that
    /// map and unmap kernel memory page by page, and from then on the bump
    /// region below is only what was handed out before they existed.
    public static long MapHook;
    public static long UnmapHook;

    /// MEMORY GIVEN BACK. What the region handed out (SetHeap) is the
    /// region's again, hooks or none -- a kernel's UnmapHook is for what its
    /// MapHook mapped, and was handed the region's memory before (the bump
    /// below _at) -- kept in a list of free ranges, in address order and
    /// joined with its neighbours, each saying its next and its size in its
    /// first two words, for Map to hand out again; the top of what was
    /// handed out goes back to the bump. Without it, every chunk the
    /// collector gave back -- a dead large array's, a page with nothing live
    /// -- was gone for good, and a heap that had run out once could never
    /// answer again. Anything else goes to the hook, which returns its frames.
    public static void Unmap(long at, long bytes)
    {
        if (_limit != 0 && at >= _start && at < _limit)
        {
            long held = LockRegion();
            Release(at, (bytes + RegionPage - 1) & -RegionPage);
            UnlockRegion(held);
            return;
        }
        if (UnmapHook != 0)
        {
            Sys.Call(UnmapHook, at, bytes, 0);
        }
    }

    /// The region's free ranges (Unmap), the lowest first, and their bytes.
    private static long _freeRanges;
    private static long _freeBytes;
    private const long RangeLeast = 2 * WordSize.Bytes;

    static long RangeNext(long range) => Sys.Peek(range);
    static long RangeSize(long range) => Sys.Peek(range + WordSize.Bytes);

    static void SetRange(long range, long next, long size)
    {
        Sys.Poke(range, next);
        Sys.Poke(range + WordSize.Bytes, size);
    }

    static void Release(long at, long size)
    {
        if (size < RangeLeast || at + size > _at) return;
        // The top of what was handed out: the bump's again, with the free
        // range it then ends at.
        if (at + size == _at)
        {
            _at = at;
            long before = 0;
            long range = _freeRanges;
            while (range != 0 && RangeNext(range) != 0) { before = range; range = RangeNext(range); }
            if (range != 0 && range + RangeSize(range) == _at)
            {
                _at = range;
                _freeBytes = _freeBytes - RangeSize(range);
                if (before == 0) _freeRanges = 0; else Sys.Poke(before, 0);
            }
            return;
        }
        long previous = 0;
        long next = _freeRanges;
        while (next != 0 && next < at) { previous = next; next = RangeNext(next); }
        _freeBytes = _freeBytes + size;
        // Joined with what follows it, and with what comes before.
        if (next != 0 && at + size == next)
        {
            size = size + RangeSize(next);
            next = RangeNext(next);
        }
        if (previous != 0 && previous + RangeSize(previous) == at)
        {
            SetRange(previous, next, RangeSize(previous) + size);
            return;
        }
        SetRange(at, next, size);
        if (previous == 0) _freeRanges = at; else Sys.Poke(previous, at);
    }

    /// `need` bytes of the free ranges, the first that holds them, from its
    /// end; 0 when none does.
    static long TakeRange(long need)
    {
        long previous = 0;
        long range = _freeRanges;
        while (range != 0)
        {
            long size = RangeSize(range);
            if (size >= need)
            {
                _freeBytes = _freeBytes - need;
                if (size - need >= RangeLeast)
                {
                    Sys.Poke(range + WordSize.Bytes, size - need);
                    return range + size - need;
                }
                // The whole of it: what is over is too little to list, and
                // goes with it.
                _freeBytes = _freeBytes - (size - need);
                if (previous == 0) _freeRanges = RangeNext(range); else Sys.Poke(previous, RangeNext(range));
                return range;
            }
            previous = range;
            range = RangeNext(range);
        }
        return 0;
    }

    /// The processor given up to whatever else is ready, by the hook -- a
    /// ring-1 kernel's, which asks the kernel -- or, with none (the kernel
    /// itself, which has no one to ask), nothing.
    public static long YieldHook;

    public static void Yield()
    {
        if (YieldHook != 0) Sys.Call(YieldHook, 0, 0, 0);
    }

    /// A file mapped read-only by the hook -- a ring-1 kernel's, whose pages
    /// are the file cache's own (Service.MapFileBytes) -- called with the
    /// path's UTF-8 bytes, as every path is, their count and where to write
    /// the length. No hook: 0, and the caller reads the file instead. The
    /// one member here that allocates (the path's bytes): System.IO's, never
    /// the heap's, so the heap never comes back into it.
    public static long MapFileHook;

    public static long MapReadOnly(string path, out long length)
    {
        length = 0;
        if (MapFileHook == 0 || path.Length == 0) return 0;
        byte[] name = Utf8Transcoder.Encode(path, 0, path.Length);
        long bytes = 0;
        long at = Sys.Call(MapFileHook, Sys.ArrayData(name), name.Length, Sys.AddressOf(ref bytes));
        if (at != 0) length = bytes;
        return at;
    }

    /// Fresh, zeroed, page-aligned memory of `bytes`, or 0 when there is
    /// none: the region's given back (Unmap) first, then the kernel's once
    /// it has installed MapHook, and the bump region's until then -- every
    /// piece of the region whole pages (RegionPage).
    public static long Map(long bytes)
    {
        // The region's own given back first (Unmap), whoever maps the rest.
        if (_freeRanges != 0 && bytes > 0)
        {
            long want = (bytes + RegionPage - 1) & -RegionPage;
            long reusing = LockRegion();
            long reused = TakeRange(want);
            UnlockRegion(reusing);
            if (reused != 0)
            {
                Zero(reused, want);
                return reused;
            }
        }
        if (MapHook != 0)
        {
            return Sys.Call(MapHook, bytes, 0, 0);
        }

        if (_limit == 0)
        {
            // Nobody said where memory is, and on bare metal nobody can
            // guess: the megabyte after the image may be the video hole,
            // the kernel's load address, or not exist. The program says,
            // from the memory map it was handed, before it allocates.
            // With no heap there is nothing to encode into: the literal's
            // UTF-16 units are written a byte each, the low byte first on
            // x86, which for this ASCII text is the whole character.
            string text = "no heap: Platform.SetHeap was not called\n";
            long units = Sys.StringData(text);
            for (int i = 0; i < text.Length; i++) WriteBytes(2, units + i * 2, 1);
            Exit(137);
        }

        if (bytes <= 0 || bytes > _limit - _start) return 0;
        long need = (bytes + RegionPage - 1) & -RegionPage;

        long held = LockRegion();
        if (need > _limit - _at)
        {
            UnlockRegion(held);
            return 0;
        }
        long got = _at;
        _at = _at + need;
        UnlockRegion(held);
        Zero(got, need);
        return got;
    }

    /// The promise Map makes: every byte handed out is zero.
    ///
    /// Memory left by a bootloader is not, and a heap that inherited it would
    /// hand an object a vtable pointer made of stale bytes.
    private static void Zero(long at, long count)
    {
        Sys.MemorySet(at, 0, count);
    }

    /// Where EnterCollection's spill values are kept between calls, so that
    /// nothing can prove them dead. Never read for its value.
    private static long _spill;

    // ---- the thread block ------------------------------------------------
    //
    // ONE THREAD, and no operating system to give it a segment: the block's
    // address lives in a word of .bss that Sys.ThreadBlock reads and the
    // compiler's entry stub has already filled in, so a freestanding program
    // needs neither GS nor a call here to throw or to allocate. These exist
    // so that the runtime above is written once.

    public static void SetThreadBlock(long block)
    {
        Sys.Poke(block + Tls.Self, block);
        Sys.SetThreadBlock(block);
    }

    /// Nobody else can change the word, so a wait would never end: the
    /// collector here is the only thread there is -- until a kernel with
    /// several processors installs WaitHook, which is called once per turn
    /// of a stopped thread's wait and is where that processor answers what
    /// it must answer with interrupts off (a TLB flush another processor
    /// is waiting on).
    public static long WaitHook;

    public static void Wait(long at, long value)
    {
        if (WaitHook != 0)
        {
            Sys.Call(WaitHook, at, value, 0);
        }
    }

    /// The other half, for the same kernel: a word a Wait may be sleeping
    /// for has changed, and the sleeper is to be woken (WakeHook).
    public static long WakeHook;

    public static void Wake(long at, long count)
    {
        if (WakeHook != 0)
        {
            Sys.Call(WakeHook, at, count, 0);
        }
    }

    /// THE TIME, from a kernel that keeps it: called with no arguments and
    /// answering nanoseconds since it started. A kernel's own threads may
    /// not latch the 8254 behind it -- a ring-1 kernel's view of time is
    /// the cell its kernel writes -- so one that has a clock installs this,
    /// and Clock.Now, which the scheduler's timers read too, asks the PIT
    /// only where nobody did.
    public static long NanosHook;

    /// WHO ENDS A CALLER OF A REVOKED OBJECT (Gc.Revoke): the kernel installs
    /// it -- a program is crashed, a kernel thread killed -- and it does not
    /// return. With none installed the processor stops.
    public static long RevokedHook;

    public static void Revoked()
    {
        if (RevokedHook != 0) Sys.Call(RevokedHook, 0, 0, 0);
        if (!RingZero()) Leave(1);
        while (true) Sys.Hlt();
    }

    // RING 0 ALONE MAY HALT. A ring-1 service, or a process, that comes to
    // the end with no hook leaves through its system's exit -- a ring-1
    // image's Sys.Syscall is its kernel's gate (--ring1-syscalls) -- where
    // HLT, and an OUT past its IOPL, was a general-protection fault.
    public static bool RingZero() => (Sys.ReadCodeSegment() & 3) == 0;

    // EXIT_GROUP, the whole program's end in Linux's numbers, which a ring-1
    // gate takes too: exit (1, 60) ends the calling thread alone.
#if TARGET_64BIT
    const long ExitCall = 231;
#else
    const long ExitCall = 252;
#endif

    /// The end above ring 0: the system's exit, and should it come back --
    /// a gate that has no exit -- the time offered for ever. NEVER AN OUT,
    /// a CLI or a HLT up here: with IOPL 1 the debug port's write was
    /// allowed and ended a whole QEMU machine for one service, and the halt
    /// after it a general-protection fault.
    [DoesNotReturn]
    private static void Leave(int code)
    {
        Sys.Syscall(ExitCall, code, 0, 0);
        while (true)
        {
            Yield();
            Sys.Pause();
        }
    }

    public static long Nanos() => Clock.Now();

    /// THE PROCESSORS, from a kernel that knows how many there are: called
    /// with no arguments and answering the count (Os.ProcessorCount, which
    /// is what Environment.ProcessorCount asks). A ring-1 kernel installs it
    /// as it starts, as it does its other hooks, with its kernel's answer
    /// (Service.ProcessorCount); with none the image counts one.
    public static long ProcessorCountHook;

    // ---- WHAT AN IMAGE ON TOP OF A KERNEL SAYS OF ITS MEMORY -------------------
    //
    // A freestanding image alone on the machine -- the kernel, a loader, a
    // boot test -- answers as it always has: its mappings are its own frames
    // taken whole, no card table, no region arena, every collection whole,
    // nothing known of the machine's memory but the region it was given
    // (SetHeap), which is all it has. An image with a kernel BELOW
    // it -- CORSAC's ring-1 kernels -- has mappings that kernel commits page
    // by page when they are first touched (ring 0's MapChunk and ZeroIn),
    // threads of its own each with a thread block of its own, and a kernel
    // to ask what is free. It says so, once, as it starts and before it
    // allocates anything, by setting the four below (Service.UsePlatform in
    // CORSAC's ring 1); the collector reads them as it starts (Gc.Start,
    // StartGenerations) and at its first region (RegionEnter).

    /// The machine's memory, in bytes, as the kernel below says it; 0 where
    /// no kernel says (alone on the machine: its own allocator owns it, and
    /// the collector's heap is the region it was given).
    public static long TotalMemoryBytes;

    /// Who says what is free, a kernel's routine (by Sys.AddressOf) called
    /// with no arguments and answering bytes; 0 for nobody. Called by the
    /// collector with its heap held, so it allocates nothing.
    public static long FreeMemoryHook;

    /// THE MEMORY THE COLLECTOR MAY USE, which GC.GetGCMemoryInfo reports as
    /// its total: what the kernel below says the machine has, when one said
    /// (TotalMemoryBytes). Alone on the machine, the region the image was
    /// given -- all the memory it has, and all its heap can ever be, where a
    /// 32-bit process's address space would be a number nothing here has.
    /// And 0, unknown, for an image whose memory a kernel maps (MapHook)
    /// without saying how much there is: the bump region is then only what
    /// was handed out before the hook.
    public static long TotalMemory()
    {
        if (TotalMemoryBytes != 0) return TotalMemoryBytes;
        if (MapHook == 0) return _limit - _start;
        return 0;
    }

    /// What is free of it, from the same source as the total: alone on the
    /// machine, where the total is the region, what the region has not
    /// handed out yet; otherwise the kernel's figure (FreeMemoryHook), 0
    /// where it does not say. Never one of each: a region's free against a
    /// machine's total is a load (GC.GetGCMemoryInfo's, total less free)
    /// of nothing real. The collector paces itself by FreeMemoryQuietly
    /// instead, which asks only a kernel, so an image alone keeps the pace
    /// it always had.
    /// What is free, or -1 where nothing can say: none left is 0, which a
    /// region used up is (GC.GetGCMemoryInfo's load is then all of it).
    public static long AvailableMemory()
    {
        if (TotalMemoryBytes == 0 && MapHook == 0) return _limit - _at + _freeBytes;
        return FreeMemoryHook == 0 ? -1 : FreeMemoryQuietly();
    }

    /// MEMORY COMMITTED AS IT IS FIRST TOUCHED, for the collector's tables that
    /// cover the whole address space and are read only where the heap is
    /// (Gc.StartGenerations): a kernel's routine that hands out addresses and
    /// makes each page when it is first touched (ring 0's KernelMapLazy), or,
    /// with none, an ordinary Map -- a ring-1 kernel's, which its kernel
    /// commits on touch already.
    public static long MapLazyHook;

    public static long MapLazy(long bytes)
    {
        if (MapLazyHook != 0) return Sys.Call(MapLazyHook, bytes, 0, 0);
        return Map(bytes);
    }

    /// The pages of [at, at + bytes) of a MapLazy range committed now, in
    /// thread context, by the kernel's routine (CommitHook) -- so nothing
    /// the collector knows will be touched waits on a fault (Gc.CommitCards).
    /// No hook: nothing to do.
    public static long CommitHook;

    public static void Commit(long at, long bytes)
    {
        if (CommitHook != 0) Sys.Call(CommitHook, at, bytes, 0);
    }

    /// Whether a mapping costs only the pages that are touched: false alone
    /// on the machine -- the collector keeps no card table and collects the
    /// whole heap -- and true for an image whose kernel commits its memory
    /// on first touch, which turns generations on: two card tables of four
    /// megabytes each and the held-block tables reserved, a few pages of
    /// them committed (Gc.StartGenerations). Set before the first
    /// allocation, which is when the collector starts and reads it.
    public static bool MapsCommitLazily;

    /// Nonzero: every thread has a region arena, mapped chunk by chunk as
    /// its regions need (Regions); 0 for none. Set before any thread opens
    /// a region.
    public static long RegionArenaBytes;

    // ---- THE ASYNC SCHEDULER'S CONTRACT, for a kernel that runs it --------------
    //
    // Alone on the machine the scheduler is its own event loop (Scheduler.
    // RunUntil, over Clock and Native). A kernel provides the scheduler
    // instead: its own loop runs the continuations, its clock answers the
    // time (NanosHook), and what is current travels with each task.

    /// Where a continuation goes: a kernel's routine (by Sys.AddressOf)
    /// called with the work and the context it runs in (Scheduler.Post: an
    /// Action's word and an AsyncContext's, or 0), which queues them for its
    /// scheduler loop to run through Scheduler.RunPosted. 0: this
    /// scheduler's own ring. Called in thread context only -- an interrupt
    /// handler completes through InterruptCompletions, never here.
    public static long PostHook;

    /// What is current, as a kernel keeps it (AsyncContext): called with
    /// AsyncContext.CaptureOp (answers a word for what is current now: an
    /// object's, which the context then holds as its Owner; asked only where
    /// a flow begins), EnterOp and the Owner's word as a continuation starts
    /// (the platform may make it current or only note it; it answers a word)
    /// and LeaveOp and that answer as it ends. 0: no context flows.
    public static long ContextHook;

    /// Called with no arguments by InterruptCompletions.Complete -- from an
    /// interrupt handler, so it may not allocate or wait -- once a task is
    /// queued for finishing: a kernel wakes an idle processor to run its
    /// loop. 0: nobody to tell.
    public static long CompletedHook;

    /// Nonzero: each continuation's run on a thread block has a region
    /// arena of its own (AsyncContext; Tls.TaskArena), mapped chunk by chunk
    /// as its regions need and given back as the run ends. 0: continuations
    /// run with the block's own arena words, whatever they are.
    public static long TaskArenaBytes;

    /// WHERE THE RUNNING CODE'S OWN WORDS ARE, when that is not the thread
    /// block. A kernel's thread block is a processor's, and a system call
    /// that parks comes back on whichever processor resumes it: what the
    /// call made its own -- its [ThreadStatic] table, the type initializer
    /// it is running -- must go with the call, not stay with the processor.
    ///
    /// ThreadStaticsHook, called with nothing: the address of the word that
    /// holds the running code's [ThreadStatic] table (ThreadStatics), or 0
    /// for the thread block's own (Tls.ThreadStatics).
    public static long ThreadStaticsHook;

    /// TypeInitOwnerHook, called with nothing: the block that names the
    /// running code as a type initializer's owner -- a word at
    /// Tls.TypeInitWait says what it waits for -- or 0 for the thread block.
    /// The same block names it as a Monitor's owner (MonitorOwner).
    public static long TypeInitOwnerHook;

    /// TypeInitWaitHook, called with the type's state word and the owner it
    /// holds: 1 when the wait was made (a parked call that slept a moment,
    /// which the caller follows by looking again), 0 to wait here as any
    /// thread does (Runtime.EnterTypeInitialization).
    public static long TypeInitWaitHook;

    /// Corsac.GC.Verify: no old object pointing at a young one the minor
    /// cycle is about to sweep, checked after each one's mark.
    public static bool VerifyGenerations() => Runtime.KnobFlag("Corsac.GC.Verify");

    /// Set by a program that was asked for the collector's census of what
    /// is live, by type, at every whole collection -- a kernel from its
    /// command line (gui.census=1) -- and read at each collection.
    public static bool CensusWanted;

    /// Or the image's Corsac.GC.Census (or DeadCensus), asked once.
    public static bool GcCensus()
    {
        if (_censusKnob == 0) _censusKnob = (Runtime.KnobFlag("Corsac.GC.Census") || Runtime.KnobFlag("Corsac.GC.DeadCensus")) ? 2 : 1;
        return CensusWanted || _censusKnob == 2;
    }

    static int _censusKnob;

    /// The most a collection may wait for, in bytes allocated since the last
    /// one, or 0 for the collector's own pace: set by a kernel to a share of
    /// the machine (Mem.Total / 32), so that on a small one the heap stays
    /// near what is live instead of twice it. Read at every collection.
    public static long ThresholdCap;

    /// The image's Corsac.GC.Threshold when it has one, as hosted, before
    /// the kernel's share of the machine.
    public static long GcThreshold()
    {
        long knob = Runtime.KnobNumber("Corsac.GC.Threshold");
        return knob != 0 ? knob : ThresholdCap;
    }

    /// System.GC.Gen0Size: that much allocated between minor cycles.
    public static long GcNursery() => Runtime.KnobNumber("System.GC.Gen0Size");

    /// No region arena alone on the machine: a thread block there is a
    /// processor's, and the tasks that park and resume on any processor
    /// would share it. Regions wait for the task switch to carry the arena's
    /// words with the task. An image whose every thread has a block of its
    /// own -- a ring-1 kernel's -- turns them on (RegionArenaBytes); each
    /// arena is then mapped chunk by chunk as its regions need.
    public static bool Regions()
    {
        return RegionArenaBytes > 0;
    }

    /// System.GC.HeapHardLimit, .NET's own knob: the heap's hard limit,
    /// within the region it was given.
    public static long HeapLimit() => Runtime.KnobNumber("System.GC.HeapHardLimit");

    /// Set by a kernel asked for where its allocations come from
    /// (gui.allocsample=1): every sixteenth sampled by site
    /// (AllocSamples), the heaviest said at each census.
    public static bool AllocSampleWanted;

    public static bool AllocSample()
    {
        return AllocSampleWanted || Runtime.KnobFlag("Corsac.GC.AllocSample");
    }

    /// No record of which sampled blocks were freed: twelve megabytes.
    public static bool AllocSampleFrees()
    {
        return false;
    }

    /// Set with CensusWanted by a kernel asked for the census of what its
    /// collections swept too, by type (gui.deadcensus=1): what a heap that
    /// holds steady is churning through.
    public static bool DeadCensusWanted;

    public static bool GcDeadCensus()
    {
        return DeadCensusWanted || Runtime.KnobFlag("Corsac.GC.DeadCensus");
    }

    /// Corsac.GC.Stats: the collector's counts said at exit.
    public static bool GcStats() => Runtime.KnobFlag("Corsac.GC.Stats");

    /// Corsac.GC.HeapCheck: the heap's structure checked at every collection.
    public static bool HeapCheck() => Runtime.KnobFlag("Corsac.GC.HeapCheck");

    /// No process address space to speak of: a kernel's heap has its cap.
    /// No signals to report a fault through: an exception handler is the
    /// kernel's own.
    public static void ArmFaultReport()
    {
    }

    public static long AddressSpace()
    {
        return 0;
    }

    /// No control groups: a kernel's heap has the cap its kernel gives it.
    public static long MemoryLimit()
    {
        return 0;
    }

    /// What the kernel below says is free (FreeMemoryHook), which the
    /// collector paces its threshold by (Gc.NextThreshold: half of it, at
    /// most three live sizes); 0, the old pace, with nobody to ask.
    public static long FreeMemoryQuietly()
    {
        if (FreeMemoryHook == 0) return 0;
        return Sys.Call(FreeMemoryHook, 0, 0, 0);
    }

    // ---- what Monitor asks (core threading.cor) ----------------------------

    /// Who holds a lock: the running code, named as a type initializer's
    /// owner is (Runtime.EnterTypeInitialization) -- the block the kernel's
    /// TypeInitOwnerHook answers, or, where it answers 0 or there is none,
    /// the thread block. Word-aligned either way, so bit 0 is free for
    /// Monitor's "somebody is asleep" mark.
    ///
    /// THE CODE THAT TAKES A LOCK IS THE CODE THAT GIVES IT BACK: an await
    /// is refused while a Monitor is held (CS1996, Binder.AwaitChecks), so a
    /// lock never travels with a task to another processor. What may move is
    /// a call that parks: in ring 0 it is named by its call's owner (the
    /// process whose kernel stack it is on), which goes with it, and the
    /// processor's own code -- its scheduler and the tasks it runs -- by the
    /// processor's block. In ring 1 every thread has a block of its own.
    ///
    /// AN INTERRUPT HANDLER NEVER TAKES A MONITOR the code it interrupted
    /// may hold: it runs as that code, on its stack and its block, so it
    /// would be taken for the owner and walk into the middle of the lock.
    /// What an interrupt shares is guarded by the kernels' IrqSpinLock.
    public static long MonitorOwner()
    {
        if (TypeInitOwnerHook != 0)
        {
            long owner = Sys.Call(TypeInitOwnerHook, 0, 0, 0);
            if (owner != 0) return owner;
        }
        return Sys.ThreadBlock();
    }

    /// Nobody to sleep on: a contended lock is waited for by looking again,
    /// yielding between looks (YieldHook) and then pausing. Ring 1 may not
    /// HLT, and its yield lets another thread run -- the holder among them;
    /// ring 0's answers the TLB shootdown a holder may be waiting on.
    public static void MonitorBlock(long at, long value)
    {
        Yield();
        Sys.Pause();
    }

    /// Nobody asleep to wake: the waiter looks again (MonitorBlock).
    public static void MonitorWake(long at)
    {
    }

    /// Asks every thread still running to stop for a collection: nothing
    /// on one thread, and on a kernel an interrupt to every other processor
    /// that is running managed code (StopHook, installed by the kernel).
    public static long StopHook;

    public static void PromptStop()
    {
        if (StopHook != 0)
        {
            Sys.Call(StopHook, 0, 0, 0);
        }
    }

    /// Every processor serialised (Interlocked.MemoryBarrierProcessWide): on
    /// one processor a fence, and on a kernel's several whatever it installs
    /// here to interrupt the others and fence each (BarrierHook).
    public static long BarrierHook;

    public static void ProcessWideBarrier()
    {
        Sys.Fence();
        if (BarrierHook != 0)
        {
            Sys.Call(BarrierHook, 0, 0, 0);
        }
    }

    /// The one thread never has to stop for another, but the shape is the
    /// runtime's and not the machine's. The register pressure is the same
    /// trick EnterCollection uses below, for the same reason.
    public static void SafePoint(long mode)
    {
        long a = _spill + 1;
        long b = _spill + 2;
        long c = _spill + 3;
#if TARGET_64BIT
        long d = _spill + 4;
        long e = _spill + 5;
        long f = _spill + 6;
#endif
        GcThreads.Spill(mode, Sys.Stack(), Sys.FramePointer());
        GcThreads.SafePoint(mode);
#if TARGET_64BIT
        _spill = a + b + c + d + e + f;
#else
        _spill = a + b + c;
#endif
    }

    /// Enters a collection with every callee-saved register on the stack.
    ///
    /// The collector scans from Gc.CollectInner's stack pointer upwards, so a
    /// reference that the caller of Runtime.Alloc left in EBX, ESI or EDI is
    /// invisible to it unless something pushed those registers first. What
    /// pushes them is this function's own prologue, and the prologue pushes
    /// exactly the callee-saved registers the allocator handed out -- so the
    /// job here is to need all three.
    ///
    /// system.cor gets that from a system call, whose arguments the backend
    /// loads into EBX, ECX, EDX, ESI and EDI. There is no system call here,
    /// and `int 0x80` on a machine with no interrupt table is a triple fault,
    /// so the pressure is made honestly instead: six 32-bit halves live
    /// across the call, more than the three registers that survive one, which
    /// leaves the allocator no choice. See GcRoots in runtime/src/core/gc.cor for the
    /// full reasoning.
    public static void EnterCollection()
    {
        long a = _spill + 1;
        long b = _spill + 2;
        long c = _spill + 3;
#if TARGET_64BIT
        // Long mode keeps five callee-saved registers (RBX, R12-R15) and a
        // long fits one, so six values across the call are what fills them.
        long d = _spill + 4;
        long e = _spill + 5;
        long f = _spill + 6;
        if (Runtime.CollectorLinked()) Gc.CollectInner();
        _spill = a + b + c + d + e + f;
#else
        if (Runtime.CollectorLinked()) Gc.CollectInner();
        _spill = a + b + c;
#endif
    }

    /// An image that is not alone on the machine -- CORSAC's ring-1 kernels,
    /// where a port write or a HLT is a fault -- installs this, and exiting
    /// becomes a call to it, which does not return. CORSAC's kernel installs
    /// one too, for an unwind that a module forced out began; for anything
    /// else it returns, and the machine stops below as it always has.
    public static long ExitHook;

    /// Ends the program. There is nothing to return to, so this stops.
    ///
    /// Under QEMU with `-device isa-debug-exit,iobase=0xf4,iosize=4` the
    /// write ends the emulation and the process exits with (code << 1) | 1,
    /// which is how a test harness reads the result. On real hardware the
    /// port is nothing, the write goes nowhere, and the halt below is the
    /// whole of it.
    ///
    /// [DoesNotReturn], as .NET's own exit is, for C#'s null analysis; the
    /// loop at its end is what proves it (Binder.CallNeverReturns).
    [DoesNotReturn]
    public static void Exit(int code)
    {
        // WHAT THE PROGRAM LEFT TO BE DONE AT ITS END FIRST (Runtime.ExitHandler),
        // as Linux's Exit does: buffered console output reaches its device. A
        // ring-1 service that printed and returned from Main lost its last
        // lines. Not the collector's statistics, which a kernel has no use for.
        Runtime.ExitHandler();
        if (ExitHook != 0)
        {
            Sys.Call(ExitHook, code, 0, 0);
        }
        if (!RingZero())
        {
            Leave(code);
        }

        Sys.PortOut8(Port.DebugExit, code & 0xFF);
        Sys.Cli();

        while (true)
        {
            Sys.Hlt();
        }
    }

    /// Where the runtime's output goes: the console the program pointed this
    /// at, and nowhere until it did. There is one console, and fd 1 and fd 2
    /// are both it.
    public static IConsole? Console;

    /// WHERE THE BYTES GO WITHOUT AN OBJECT: a host's routine, called with
    /// the descriptor, the address and the count -- a Windows image's
    /// standard error (Win32.Write) -- so that writing needs nothing made.
    public static long WriteHook;

    /// Returns the count, always: a console that is not there swallows bytes
    /// rather than failing, and there is nowhere to report a failure to.
    /// The heap's own reports come here -- out of memory among them -- so a
    /// console driver's Write may not allocate either.
    public static long WriteBytes(int fd, long address, long count)
    {
        if (WriteHook != 0)
        {
            Sys.Call(WriteHook, fd, address, count);
            return count;
        }
        if (Console != null)
        {
            Console.Write(address, count);
        }
        return count;
    }

    /// THE 386'S ATOMICS WITH INTERRUPTS OFF (Runtime.AtomicAdd386 and its
    /// kin): the 386 has no XADD and no CMPXCHG, and on its one processor
    /// nothing else runs while interrupts are off -- a handler's atomic
    /// included, which a lock would have deadlocked. ONE PROCESSOR IS THE
    /// PROFILE'S PREMISE: interrupts off on one processor are nothing to
    /// another, so an image that starts a second one is a 486's or later
    /// (--cpu=486), never a 386's; the backend's 386 compare-exchange
    /// sequence (X86Backend's __corsac_refcas) rests on the same. Where this code may turn
    /// them off: its privilege level (CS's low bits) at most EFLAGS.IOPL, a
    /// kernel's ring 0 or a ring-1 service with IOPL 1. Anywhere else -- the
    /// bare-metal runtime run as a process, as its tests run it -- under one
    /// lock taken by XCHG. Answers the flags, for Leave to turn interrupts
    /// back on only where they were, or LockHeld.
    public static long AtomicsEnter()
    {
        long flags = Sys.ReadFlags();
        if ((Sys.ReadCodeSegment() & 3) <= ((flags >> 12) & 3))
        {
            Sys.Cli();
            return flags;
        }
        while (Sys.AtomicSwap32(Sys.AddressOf(ref Runtime.Atomics386), 1) != 0)
        {
            Yield();
        }
        return LockHeld;
    }

    public static void AtomicsLeave(long held)
    {
        if (held == LockHeld) Sys.AtomicSwap32(Sys.AddressOf(ref Runtime.Atomics386), 0);
        else if ((held & InterruptFlag) != 0) Sys.Sti();
    }

    /// A LOCK AN INTERRUPT HANDLER TAKES TOO, the word at `at`: interrupts
    /// off first where this code may turn them off -- a handler cannot then
    /// come in on this processor while the lock is held, and find it held
    /// by the code it interrupted, and wait for ever -- then the word taken
    /// by exchange, a pause a turn, against another processor's holder.
    /// WHERE INTERRUPTS STAY ON -- a ring-1 service with IOPL 0, a process --
    /// the holder may be a thread of this processor that was preempted, and
    /// the time is offered to it (Yield) every so many turns, where the
    /// spin burnt whole time slices while it waited to run. Answers what
    /// Leave is handed.
    public static long HandlerLockEnter(long at)
    {
        long flags = Sys.ReadFlags();
        bool may = (Sys.ReadCodeSegment() & 3) <= ((flags >> 12) & 3);
        if (may) Sys.Cli();
        int turns = 0;
        while (Sys.AtomicSwap(at, 1) != 0)
        {
            Sys.Pause();
            if (!may && (++turns & 63) == 0) Yield();
        }
        return may ? flags : 0;
    }

    public static void HandlerLockLeave(long at, long held)
    {
        Sys.AtomicSwap(at, 0);
        if ((held & InterruptFlag) != 0) Sys.Sti();
    }

    /// EFLAGS.IF.
    const long InterruptFlag = 0x200;
    /// What AtomicsEnter answers for the lock: no flags word is negative.
    const long LockHeld = -1;
}

/// The parts of system.cor's `Os` that mean anything with no kernel.
///
/// Deliberately small. A name that cannot be honoured is worse than a name
/// that is not there: a program that calls Os.Open on bare metal has a
/// mistake in it, and a compile error is where that mistake should surface.
/// Partial for the one exception: CORSAC's ring-1 kernels, which have a
/// kernel below them that answers Linux's file calls, compile the Linux
/// platform's files.cor beside this for them.
static partial class Os
{
    /// The processors the kernel below says this image runs on
    /// (Platform.ProcessorCountHook), and never fewer than one, as .NET's
    /// count never is. With no kernel to say, one: a machine with no
    /// operating system runs one thread.
    public static int ProcessorCount()
    {
        if (Platform.ProcessorCountHook == 0) return 1;
        long count = Sys.Call(Platform.ProcessorCountHook, 0, 0, 0);
        return count > 0 ? (int)count : 1;
    }

    /// Everything written goes to the console whatever the descriptor, as
    /// the string's UTF-8; answers how many bytes that was.
    public static int Write(int fd, string s)
    {
        byte[] bytes = Utf8Transcoder.Encode(s, 0, s.Length);
        Platform.WriteBytes(fd, Sys.ArrayData(bytes), bytes.Length);
        return bytes.Length;
    }

    public static void Print(string s)
    {
        Write(1, s);
    }

    public static void PrintLine(string s)
    {
        Write(1, s);
        Write(1, "\n");
    }

    /// Stops the program with `code`, which is what returning from Main does.
    [DoesNotReturn]
    public static void Exit(int code)
    {
        Platform.Exit(code);
    }

    /// Opens the A20 gate through the system control port, so that addresses
    /// above the first megabyte do not wrap onto it. A bootloader that has
    /// already done this may call it again; setting the bit twice is
    /// harmless.
    public static void EnableA20()
    {
        int now = Sys.PortIn8(Port.SystemControlA);

        if ((now & 2) == 0)
        {
            // Bit 0 of that port is a system reset. It is masked off here
            // because writing it back as read is fine and writing it set is
            // a reboot.
            Sys.PortOut8(Port.SystemControlA, (now | 2) & 0xFE);
        }
    }

    /// Stops this processor until an interrupt arrives. With interrupts off
    /// this is the end of the program, which is what an idle loop in a
    /// program with no scheduler means.
    public static void Idle()
    {
        // Above ring 0 the time is offered instead (Platform.RingZero).
        if (!Platform.RingZero())
        {
            Platform.Yield();
            return;
        }
        Sys.Hlt();
    }

    // ---- what Environment asks (stdlib/src/System/environment.cor) ---------
    //
    // NOBODY STARTED THIS PROGRAM: no operating system laid an argument
    // vector or an environment block on its stack, and no process holds a
    // working directory or a number for it. Environment is the library's
    // here too, and these are the true answers to what it asks -- an entry
    // block of argc 0 with no arguments and no variables, no directory to
    // change to, the one program there is, and the machine's clock -- not a
    // copy of Environment beside the library's.

    /// argc 0, argv's terminating null, envp's terminating null: four words
    /// in either word size, laid down in the image.
    static readonly long[] NoEntryBlock = { 0, 0, 0, 0 };

    /// Where argc, argv and envp would be: the empty block. (Windows makes
    /// a real one: runtime/src/platforms/win32/files.cor.)
#if !TARGET_WINDOWS
    public static long MainEntryStack() { return Sys.ArrayData(NoEntryBlock); }
#endif

    /// envp, as on Linux: past argc, argv's entries and argv's null.
    public static long EnvironAddress()
    {
        long sp = MainEntryStack();
        return sp + WordSize.Bytes + WordSize.Bytes * Sys.Peek(sp) + WordSize.Bytes;
    }

    /// A NUL-terminated UTF-8 string at an address.
    public static string StringAt(long at) { return Utf8Transcoder.DecodeTerminated(at); }

    /// No working directory to change: ENOSYS, which Environment reports as
    /// the IOException .NET gives for a directory that cannot be entered.
    public static int Chdir(string path) { return -38; }

    /// The one program a machine with no operating system runs.
    public static int Getpid() { return 1; }

    /// No name on a network: nothing has given the machine one.
#if !TARGET_WINDOWS
    public static string? NodeName() { return null; }

    /// No operating system to name: Environment.OSVersion is PlatformID.Other, 0.0.0.0.
    public static int[] SystemVersion(out string servicePack)
    {
        servicePack = "";
        return new int[] { 7, 0, 0, 0, 0 };
    }
#endif

    /// No users: -1, and Environment.UserName reads what the image was given.
    public static long EffectiveUserId() { return -1; }

    /// Nanoseconds on the machine's one clock, whichever clock is asked for:
    /// with no operating system there is no wall clock apart from it.
    public static long Nanos(int clock) { return Platform.Nanos(); }
}

// ---- what the scheduler asks of the machine -------------------------------
//
// The scheduler (runtime/src/core/threading.cor) runs tasks here exactly as
// it does under Linux; these are the four things it asks for, answered with
// no kernel: the time, a sleep until a deadline, a wait and a wake on a
// word. There are no threads on bare metal until the kernel makes them, so
// a wait is a spin on the clock and a wake is nothing.

// WINDOWS HAS ITS OWN CLOCK AND THREADS (runtime/src/platforms/win32/threading.cor):
// the performance counter and CreateThread, under these same names.
#if !TARGET_WINDOWS
/// A monotonic nanosecond clock from the PIT, with no interrupts.
///
/// The 8254's channel 0 counts down at 1193182 Hz from whatever the BIOS
/// loaded (65536, every 54.9 ms, in mode 3) -- or from what StartClock
/// loads, once a kernel wants a tick. Read by latching, and the wraps are
/// counted by noticing the count went up: which works only if Now() is
/// called at least once a period -- half a period in mode 3, 27.5 ms --
/// and it is, because the only thing that waits on this clock is a loop
/// that calls Now().
///
/// IN MODE 3 THE COUNT FALLS BY TWO A TICK, from the reload to nothing
/// twice a period (the square wave's two halves): counted as ticks, the
/// clock ran twice as fast as time until StartClock, and every timeout
/// taken before it -- a loader's wait, Task.Delay, Monitor.Wait -- was
/// half as long. The mode is read back from the 8254 at the first look.
static class Clock
{
    const int Control = 0x43;
    const int Channel0 = 0x40;
    const long Hz = 1193182;
    const long NanosPerSecond = 1000000000;

    static long _reload = 65536;         // what channel 0 reloads to
    static long _last = -1;              // the count last seen
    static long _elapsedTicks;           // PIT ticks accumulated across wraps
    static long _tickedTicks;            // PIT ticks of the periods the kernel's interrupts counted
    static long _latest;                 // the last time answered: never less again
    static bool _interrupts;
    static bool _squareWave;             // channel 0 in mode 3: the count falls by two a tick

    /// The 8254 is one device and its latch-then-two-reads one operation:
    /// an interrupt handler or another processor reading between them reads
    /// the other half of someone else's count. Taken by XCHG, with interrupts
    /// off where this code may turn them off (its ring at most EFLAGS.IOPL);
    /// a kernel with a clock of its own (NanosHook) never comes here.
    static nint _pitLock;

    static long Enter() { return Platform.HandlerLockEnter(Sys.AddressOf(ref _pitLock)); }

    static void Leave(long flags) { Platform.HandlerLockLeave(Sys.AddressOf(ref _pitLock), flags); }

    /// The count now, latched so both bytes belong to one instant.
    static long Count()
    {
        Sys.PortOut8(Control, 0x00);    // latch channel 0
        int lo = Sys.PortIn8(Channel0);
        int hi = Sys.PortIn8(Channel0);
        return lo | (hi << 8);
    }

    /// Whether channel 0 runs in mode 3, the square wave (or 7, its other
    /// spelling): the read-back command latches its status alone, whose bits
    /// 1 to 3 are the mode.
    static bool SquareWave()
    {
        Sys.PortOut8(Control, 0xE2);    // read back: status, not count, of channel 0
        int status = Sys.PortIn8(Channel0);
        return ((status >> 1) & 3) == 3;
    }

    /// PIT ticks as nanoseconds, in two steps so that no product overflows:
    /// ticks times a billion passes a long's range after two hours.
    static long NanosOf(long ticks)
    {
        long seconds = ticks / Hz;
        return seconds * NanosPerSecond + (ticks - seconds * Hz) * NanosPerSecond / Hz;
    }

    public static long Now()
    {
        if (Platform.NanosHook != 0) return Sys.Call(Platform.NanosHook, 0, 0, 0);
        long flags = Enter();
        long ticks;
        if (_interrupts)
        {
            // The interrupt counts whole periods; the counter says how far
            // into the current one. A reload the interrupt has not yet been
            // answered for reads as a period gone backwards, which the
            // floor below holds at the last answer until it is.
            ticks = _tickedTicks + (_reload - Count());
        }
        else
        {
            long c = Count();
            if (_last < 0)
            {
                _last = c;
                _squareWave = SquareWave();
            }
            // The counter counts DOWN, so what elapsed is last minus now; a
            // negative answer means it reloaded in between, and the period
            // that reload stands for is added back.
            long delta = _last - c;
            if (delta < 0)
            {
                delta = delta + _reload;
            }
            // In mode 3 what fell is two a tick.
            if (_squareWave)
            {
                delta = delta / 2;
            }
            _elapsedTicks = _elapsedTicks + delta;
            _last = c;
            ticks = _elapsedTicks;
        }
        long now = NanosOf(ticks);
        if (now < _latest) now = _latest;
        _latest = now;
        Leave(flags);
        return now;
    }

    public static long NowMilliseconds()
    {
        return Now() / 1000000;
    }

    /// Programs channel 0 for a periodic interrupt at `hz` (mode 2) and
    /// switches Now() to counting the kernel's ticks. The kernel's timer
    /// handler calls OnTick each period. A period is counted as the PIT
    /// ticks it really is (the reload), not as a second over `hz`, which the
    /// reload only approximates: 11931 ticks at 100 Hz is 9.99914 ms, and
    /// counting 10 gained seven seconds a day.
    public static void StartClock(long hz)
    {
        if (hz < 19)
        {
            hz = 19;
        }
        long flags = Enter();
        long before = _interrupts ? _tickedTicks + (_reload - Count()) : _elapsedTicks;
        _reload = Hz / hz;
        Sys.PortOut8(Control, 0x34);    // channel 0, lo/hi, mode 2, binary
        Sys.PortOut8(Channel0, (int)(_reload & 0xFF));
        Sys.PortOut8(Channel0, (int)((_reload >> 8) & 0xFF));
        // On from the time already counted, so that Now() goes on rising.
        _tickedTicks = before;
        _interrupts = true;
        Leave(flags);
    }

    /// The kernel's timer handler, once each period, with interrupts off:
    /// under the clock's lock too, so that another processor's Now() never
    /// reads the count half written. No deadlock with this processor's own
    /// Now(), which holds the lock only with interrupts off.
    public static void OnTick()
    {
        long flags = Enter();
        _tickedTicks = _tickedTicks + _reload;
        Leave(flags);
    }

    public static bool InterruptsOn()
    {
        return _interrupts;
    }

    /// WHETHER A HALT WILL END: the clock ticks (InterruptsOn), interrupts
    /// are enabled where this code stands (EFLAGS.IF), and this is ring 0,
    /// the one ring HLT runs in. InterruptsOn says only that the PIT was
    /// programmed: a Monitor.Wait or a timer's wait reached with interrupts
    /// off halted for ever.
    public static bool MayHalt()
    {
        return _interrupts && (Sys.ReadFlags() & 0x200) != 0 && (Sys.ReadCodeSegment() & 3) == 0;
    }

    /// Waits for the clock to reach `deadline`: a halt per tick when the
    /// kernel drives interrupts, a spin on the counter otherwise -- offered
    /// to whatever else is ready and paused between looks, as Native's
    /// waits are.
    public static void SleepUntil(long deadline)
    {
        while (Now() < deadline)
        {
            if (MayHalt())
            {
                Sys.Hlt();
            }
            else
            {
                Platform.Yield();
                Sys.Pause();
            }
        }
    }
}

/// Waiting and waking with no threads: a wait on a word returns when the
/// word changes, which on bare metal is an interrupt handler's doing,
/// another processor's or, in ring 1, another thread's, so it is a bounded
/// spin with the processor halted between looks when interrupts are on,
/// and otherwise given to whatever else is ready (Platform.Yield: ring 1
/// may not HLT).
///
/// The rest of the Linux Native surface -- stacks, clone, thread ids --
/// has no meaning here and is not offered; a program that asks for a
/// Thread on bare metal gets a compile error, which is the right answer
/// until the kernel provides one.
static class Native
{
    public static void Wait(long at, long expect)
    {
        for (int i = 0; i < 1000000 && Sys.PeekWord(at) == expect; i++)
        {
            Idle();
        }
    }

    /// As Wait, giving up once `nanoseconds` have passed by Clock (a
    /// timed Monitor.Wait's). A return by timeout or by the word changing
    /// looks the same; every caller re-reads its word and its clock.
    public static void WaitFor(long at, long expect, long nanoseconds)
    {
        long deadline = Clock.Now() + nanoseconds;

        while (Sys.PeekWord(at) == expect && Clock.Now() < deadline)
        {
            Idle();
        }
    }

    /// One look's pause: a halt until the next interrupt when the clock
    /// ticks; when it does not, the processor offered to others and a
    /// spin's pause after, as a contended Monitor waits (Platform.
    /// MonitorBlock): ring 0's yield only answers a TLB shootdown, and
    /// returns at once.
    static void Idle()
    {
        if (Clock.MayHalt())
        {
            Sys.Hlt();
        }
        else
        {
            Platform.Yield();
            Sys.Pause();
        }
    }

    // A KERNEL'S SLEEPERS ARE WOKEN BY ITS HOOK (Platform.WakeHook), as the
    // collector's are: a Monitor's Pulse on one processor otherwise reached a
    // waiter halted on another only at its next tick.
    public static void Wake(long at, long count)
    {
        Platform.Wake(at, count);
    }

    public static void WakeAll(long at)
    {
        Platform.Wake(at, int.MaxValue);
    }

    public static long CurrentThreadId()
    {
        return 0;
    }
}

#endif
