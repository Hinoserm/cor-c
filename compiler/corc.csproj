<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Corsac</RootNamespace>
    <AssemblyName>corc</AssemblyName>
    <!-- The programs this one replaced, still reachable by their old names. -->
    <ToolAliases>corlink=link;build=build</ToolAliases>
    <StartupObject>Corsac.Program</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!--
      HOW THE COMPILER COLLECTS ITS GARBAGE, which is worth saying out loud
      because it is worth about a third of the wall clock.

      The compiler allocates hard and keeps almost nothing: the kernel's 118
      units churn 24 GiB and hold under 200 MB. With the default workstation
      collector, eight worker threads doing that spend their time stopped for
      each other. The same work cost 2.2 times the processor time at eight
      workers as at one, and eight finished no sooner than four.

      So: the server collector, which gives each heap its own thread, with
      the background collector off (there is nothing long-lived for it to
      find) and four heaps rather than one per core, which was pure waste on
      a large machine.

      NO HARD LIMIT. There was one, 768 MB, because a limit makes the
      collector collect instead of grow. But a hard limit is a wall: past it
      the process aborts, whatever it was doing. A whole program's link
      holds every unit's hints at once, and its region solve alone may hold
      up to a gigabyte by its own budget (RegionSolver.HeapBudget, the same
      on every machine so that every machine makes the same image): the
      linker's own unit tests, a program of 204 units, died at the wall, and
      the self-host only lived because its script raised the limit from
      outside. A program's size is not the compiler's to cap. What the link
      holds is kept small where it is held (the hints' names once each, no
      copy of every call); the machine's memory is the limit, as it is for
      any program. The native compiler's runtime reads its own (Platform:
      the control group's, the address space's), and DOTNET_GCHeapHardLimit
      still sets one for a machine that wants it.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GCHeapCount>4</GCHeapCount>
  </PropertyGroup>

  <!--
    The heap count again, spelled the way the .NET SDK wants it. The
    properties above are what THIS repository's build tool reads; the SDK
    knows nothing of GCHeapCount and would write a runtimeconfig.json
    without it. Both spellings are kept so the two builds cannot drift
    apart.
  -->
  <!--
    Guarded so that only the SDK sees them: this repository's toolchain
    rebuilds itself with the compiler it already has, and that compiler
    evaluates this file BEFORE the new one exists. An item type the old
    evaluator has never heard of would stop the bootstrap; a condition it
    finds false is skipped before the type is looked at.
  -->
  <ItemGroup Condition="'$(MSBuildRuntimeType)' != ''">
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="$(GCHeapCount)" />
  </ItemGroup>



  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <!-- The project evaluator is the build utility's (build.csproj compiles
         these six), and corc uses that one: compiled into both, a program
         referencing corc saw every one of its types twice (ProjectTests). -->
    <Compile Remove="src/projects/EvaluatedProject.cs;src/projects/ProjectEvaluator.cs;src/projects/ProjectGraph.cs;src/projects/ProjectCondition.cs;src/projects/ProjectGlob.cs;src/projects/ProjectItem.cs" />
    <ProjectReference Include="../linker/linker.csproj" />
    <ProjectReference Include="../tools/build/build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The backend's tests (tests/arch/x86) drive the allocator and the region passes directly. -->
    <InternalsVisibleTo Include="x86tests" />
    <!-- The optimizer's tests set a function's parameter classes as lowering would (ParamClassTests). -->
    <InternalsVisibleTo Include="OptTests" />
    <!-- The metadata tests read the parameter classes lowering keeps (ParamClassLoweringTests). -->
    <InternalsVisibleTo Include="MetadataTests" />
  </ItemGroup>
</Project>
