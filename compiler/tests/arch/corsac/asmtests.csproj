<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Excluded from the main build the same way compiler/tests/x86 is: corc.csproj
    removes tests/** from its compile items, so this project is built and run on
    its own and cannot break the compiler by existing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Corsac.Tests.Asm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../corc.csproj" />
  </ItemGroup>

</Project>
