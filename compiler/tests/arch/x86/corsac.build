<Build FormatVersion="1" DefaultTargets="test">
  <Target Name="test">
    <Compile Project="x86tests.csproj" Toolchain="managed" />
    <Test Name="backend-default-486" Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
    </Test>
    <Test Name="backend-386-selection" Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
      <Argument Value="--cpu=386" />
      <Argument Value="--fpu=387" />
    </Test>
    <Test Name="backend-mmx" Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
      <Argument Value="--cpu=pentium-mmx" />
    </Test>
    <Test Name="backend-mmx-excluded" Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
      <Argument Value="--cpu=pentium-mmx" />
      <Argument Value="--disable-mmx" />
    </Test>
    <Test Name="backend-k6-plus-tcg" Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
      <Argument Value="--cpu=k6-3+" />
      <Argument Value="--qemu-cpu=athlon" />
    </Test>
  </Target>
  <Target Name="benchmark">
    <Compile Project="x86tests.csproj" Toolchain="managed" />
    <Exec Executable="dotnet">
      <Argument Value="bin/managed/Release/net10.0/x86tests.dll" />
      <Argument Value="--benchmark-packed" />
    </Exec>
  </Target>
</Build>
