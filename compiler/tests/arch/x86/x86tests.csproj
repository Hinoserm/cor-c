<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The backend's tests, against the compiler as it is built (corc.csproj):
    a project that compiled a chosen set of the compiler's sources itself
    fell behind them, every file it named needing more it did not.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Corsac.Tests.X86</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PackedMemoryBenchmarks.cs" />
    <Compile Include="EmittedInstructionAudit.cs" />
    <ProjectReference Include="../../../corc.csproj" />
  </ItemGroup>

</Project>
