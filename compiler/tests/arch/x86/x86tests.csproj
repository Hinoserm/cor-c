<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the backend's sources directly rather than referencing
    corc.csproj, so the backend can be tested while other parts of the
    compiler are mid-change. Everything the IR needs (Types, Target) comes
    along; the front end, the optimiser and the driver do not.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Corsac.Tests.X86</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../src/ir/*.cs" />
    <Compile Include="../../../src/optimizations/LinkSummary.cs" />
    <Compile Include="../../../src/arch/x86/backend/*.cs" />
    <ProjectReference Include="../../../../linker/linker.csproj" />
    <Compile Include="../../../src/frontend/symbols/*.cs" />
    <Compile Include="../../../src/frontend/syntax/*.cs" />
    <Compile Include="../../../src/frontend/Token.cs" />
    <Compile Include="../../../src/arch/x86/MachineAbi.cs" />
    <Compile Include="../../../src/arch/corsac/assembler/Isa.cs" />
  </ItemGroup>

</Project>
