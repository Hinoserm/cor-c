<Build FormatVersion="1" DefaultTargets="test">
  <Target Name="test">
    <Compile Project="OptTests.csproj" Toolchain="managed" />
    <Test Name="optimizer" Executable="dotnet" Timeout="00:05:00">
      <Argument Value="bin/managed/Release/net10.0/OptTests.dll" />
    </Test>
  </Target>
</Build>
