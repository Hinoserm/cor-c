/// .NET's Marshal, its COM members: interface pointers and the objects they
/// are, references, wrappers released, HRESULTs, BSTRs and VARIANTs.
static partial class Marshal
{
    public static nint GetIUnknownForObject(object o)
    {
        if (o == null) throw new ArgumentNullException("o");
        return System.Runtime.InteropServices.ComMarshal.InterfaceFor(o, System.Runtime.InteropServices.ComMarshal.IidIUnknown);
    }

    public static nint GetIDispatchForObject(object o)
    {
        if (o == null) throw new ArgumentNullException("o");
        nint p = System.Runtime.InteropServices.ComMarshal.InterfaceFor(o, System.Runtime.InteropServices.ComMarshal.IidIDispatch);
        if (p == 0) throw new InvalidCastException("The object has no IDispatch.");
        return p;
    }

    /// The interface `t` of a managed object (its COM-callable wrapper's,
    /// found by the interface's full name) or of a COM object (asked for
    /// the IID its wrapper class was made for).
    public static nint GetComInterfaceForObject(object o, Type t)
    {
        if (o == null) throw new ArgumentNullException("o");
        System.__ComObject? c = o as System.__ComObject;
        if (c != null && c._iid.Length > 0) return System.Runtime.InteropServices.ComMarshal.Query(c.Unknown, c._iid);
        System.Runtime.InteropServices.IComCallable? callable = o as System.Runtime.InteropServices.IComCallable;
        if (callable != null)
        {
            foreach (System.Runtime.InteropServices.ComInterfaceEntry e in callable.__ComInterfaces())
                if (e.Name == t.FullName || e.Name.EndsWith("." + t.Name))
                    return System.Runtime.InteropServices.ComMarshal.InterfaceFor(o, e.Iid);
        }
        throw new InvalidCastException("The object has no COM interface " + t.FullName + ".");
    }

    public static nint GetComInterfaceForObject<T, TInterface>(T o)
    {
        if (o == null) throw new ArgumentNullException("o");
        return GetComInterfaceForObject((object)o, typeof(TInterface));
    }

    public static object GetObjectForIUnknown(nint pUnk)
    {
        if (pUnk == 0) throw new ArgumentNullException("pUnk");
        return System.Runtime.InteropServices.ComMarshal.ObjectFor(pUnk)!;
    }

    public static object GetTypedObjectForIUnknown(nint pUnk, Type t) { return GetObjectForIUnknown(pUnk); }

    /// A wrapper of its own, never one already made for the same object.
    public static object GetUniqueObjectForIUnknown(nint unknown)
    {
        if (unknown == 0) throw new ArgumentNullException("unknown");
        return new System.__ComObject(unknown);
    }

    public static int QueryInterface(nint pUnk, ref Guid iid, out nint ppv)
    {
        if (pUnk == 0) throw new ArgumentNullException("pUnk");
        ppv = System.Runtime.InteropServices.ComMarshal.Query(pUnk, iid.ToString());
        return ppv == 0 ? System.Runtime.InteropServices.ComMarshal.ENoInterface : 0;
    }

    public static int AddRef(nint pUnk)
    {
        if (pUnk == 0) throw new ArgumentNullException("pUnk");
        return System.Runtime.InteropServices.ComMarshal.AddRef(pUnk);
    }

    public static int Release(nint pUnk)
    {
        if (pUnk == 0) throw new ArgumentNullException("pUnk");
        return System.Runtime.InteropServices.ComMarshal.Release(pUnk);
    }

    public static bool IsComObject(object o) { return o is System.__ComObject; }

    /// The wrapper's count of the times it was handed out, less one; at 0
    /// what it holds of the object is let go.
    public static int ReleaseComObject(object o)
    {
        System.__ComObject? c = o as System.__ComObject;
        if (c == null) throw new ArgumentException("The object's type must be __ComObject or derived from __ComObject.", "o");
        if (c._released) return 0;
        c._releases--;
        if (c._releases <= 0) { c.ReleaseAll(); return 0; }
        return c._releases;
    }

    public static int FinalReleaseComObject(object o)
    {
        System.__ComObject? c = o as System.__ComObject;
        if (c == null) throw new ArgumentException("The object's type must be __ComObject or derived from __ComObject.", "o");
        c.ReleaseAll();
        return 0;
    }

    public static int GetHRForException(Exception? e) { return e == null ? 0 : System.Runtime.InteropServices.ComMarshal.HResultOf(e); }

    public static Exception? GetExceptionForHR(int errorCode) { return errorCode >= 0 ? null : System.Runtime.InteropServices.ComMarshal.ExceptionFor(errorCode); }

    public static void ThrowExceptionForHR(int errorCode) { System.Runtime.InteropServices.ComMarshal.Check(errorCode); }

    public static nint StringToBSTR(string? s) { return System.Runtime.InteropServices.ComMarshal.AllocBstr(s); }
    public static string PtrToStringBSTR(nint ptr)
    {
        if (ptr == 0) throw new ArgumentNullException("ptr");
        return System.Runtime.InteropServices.ComMarshal.FromBstr(ptr)!;
    }
    public static void FreeBSTR(nint ptr) { System.Runtime.InteropServices.ComMarshal.FreeBstr(ptr); }

    public static string? PtrToStringUni(nint ptr) { return System.Runtime.InteropServices.ComMarshal.FromWide(ptr); }
    public static nint StringToHGlobalUni(string? s) { return System.Runtime.InteropServices.ComMarshal.AllocWide(s); }
    public static nint StringToCoTaskMemUni(string? s) { return System.Runtime.InteropServices.ComMarshal.AllocWide(s); }

    public static void GetNativeVariantForObject(object? obj, nint pDstNativeVariant)
    {
        if (pDstNativeVariant == 0) throw new ArgumentNullException("pDstNativeVariant");
        System.Runtime.InteropServices.ComMarshal.WriteVariant(pDstNativeVariant, obj);
    }

    public static object? GetObjectForNativeVariant(nint pSrcNativeVariant)
    {
        if (pSrcNativeVariant == 0) throw new ArgumentNullException("pSrcNativeVariant");
        return System.Runtime.InteropServices.ComMarshal.ReadVariant(pSrcNativeVariant);
    }
}
