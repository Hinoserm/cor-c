// .NET'S COM INTEROP, the in-process half: what a program holding a COM
// object and a COM object a program serves are made of, under .NET's names.
//
//   System.__ComObject   a COM object held by managed code (a runtime-callable
//                        wrapper): its IUnknown, the interfaces asked of it,
//                        or -- an object in another process -- the remote
//                        half's record of it (ComRemoteObject).
//   ComFrame             one call through a COM interface's vtable, as the
//                        compiler's wrappers make it (corc's ComDeclarations):
//                        each argument marshalled to its native form and
//                        remembered with its kind, so the same call can go
//                        to an object in this process through its vtable or
//                        to one in another as an ORPC request.
//   ComMarshal           the marshalling itself, kind by kind -- numbers,
//                        VARIANT_BOOL, BSTR, LPWSTR, VARIANT, interfaces,
//                        GUIDs, SAFEARRAYs -- both ways, and HRESULTs.
//   ComCallable          a managed object COM can call (a COM-callable
//                        wrapper): its interface pointers, their vtables,
//                        its reference count and the handle that keeps it
//                        alive while native code holds it; IUnknown's and
//                        IDispatch's entries.
//   ComDispatch          IDispatch from the calling side: GetIDsOfNames and
//                        Invoke, what late binding and dispinterfaces use.
//   Marshal              GetIUnknownForObject, GetObjectForIUnknown,
//                        QueryInterface, AddRef, Release, ReleaseComObject...
//
// No OLE library under any of it: BSTRs, VARIANTs and SAFEARRAYs are laid out
// as oleaut32 lays them (SysAllocString's length word in front of the
// characters; VARIANT 16 bytes on i386, 24 on x86-64; SAFEARRAY with its
// VARTYPE four bytes before it) and made here. A COM call is stdcall on
// i386 -- `delegate* unmanaged[Stdcall]` -- and every argument a stack word:
// two for a 64-bit number, four for a VARIANT or a GUID by value; on
// x86-64 a word each, a VARIANT or GUID by reference, as Win64 passes them.
//
// The remote half -- activation through the GUI kernel's broker, the
// running object table, ORPC and NDR, the object exporter -- is
// ComRemote.cor and ComNdr.cor.

using System;
using System.Collections.Generic;
using System.Text;
using System.Runtime.InteropServices;

namespace System
{
    /// <summary>
    /// A COM object held by managed code: .NET's System.__ComObject. One
    /// made by GetObjectForIUnknown holds the object's IUnknown; one the
    /// compiler wrote for a [ComImport] interface (a cast of a COM object to
    /// the interface) holds that interface too. Interfaces asked of it are
    /// kept, a reference each, until it is released (Marshal.ReleaseComObject).
    /// An object in another process holds no pointer: its ComRemoteObject
    /// carries each call.
    /// </summary>
    public class __ComObject
    {
        internal nuint _unknown;
        internal nuint _pointer;
        internal string _iid = "";
        internal System.Runtime.InteropServices.ComRemoteObject? _remote;
        readonly Dictionary<string, nuint> _asked = new Dictionary<string, nuint>();
        internal int _releases;
        internal bool _released;

        /// The object whose IUnknown is `unknown`: a reference of its own taken.
        public __ComObject(nuint unknown)
        {
            if (unknown == 0) throw new ArgumentNullException("unknown");
            System.Runtime.InteropServices.ComMarshal.AddRef(unknown);
            _unknown = unknown;
            _releases = 1;
        }

        /// An object in another process.
        public __ComObject(System.Runtime.InteropServices.ComRemoteObject remote)
        {
            _remote = remote;
            _releases = 1;
        }

        /// A [ComImport] interface's wrapper over `from`: the interface
        /// `pointer` (a reference the caller gives it) for `iid`.
        protected __ComObject(__ComObject from, nuint pointer, string iid)
        {
            _remote = from._remote;
            _iid = iid;
            _releases = 1;
            if (_remote != null) return;
            System.Runtime.InteropServices.ComMarshal.AddRef(from._unknown);
            _unknown = from._unknown;
            _pointer = pointer;
        }

        /// The interface for `iid` asked of the object, a new reference the
        /// caller owns; 0 when the object has none. For an object in another
        /// process, 1 when it has it (RemQueryInterface), the call made
        /// through the remote record and not a pointer.
        public nuint __Query(string iid)
        {
            Alive();
            if (_remote != null) return _remote.Has(iid) ? (nuint)1 : 0;
            nuint got = System.Runtime.InteropServices.ComMarshal.Query(_unknown, iid);
            return got;
        }

        /// The interface pointer a call for `iid` goes through, held by this
        /// object (not AddRef'd for the caller).
        internal nuint __Interface(string iid)
        {
            Alive();
            if (_remote != null) return 0;
            if (_pointer != 0 && string.Equals(iid, _iid, StringComparison.OrdinalIgnoreCase)) return _pointer;
            nuint known;
            lock (_asked)
            {
                if (_asked.TryGetValue(iid, out known)) return known;
            }
            nuint got = System.Runtime.InteropServices.ComMarshal.Query(_unknown, iid);
            if (got == 0) throw new InvalidCastException("The COM object does not support the interface " + iid + " (E_NOINTERFACE).");
            lock (_asked)
            {
                if (_asked.TryGetValue(iid, out known)) { System.Runtime.InteropServices.ComMarshal.Release(got); return known; }
                _asked[iid] = got;
            }
            return got;
        }

        /// The object's IUnknown, borrowed.
        internal nuint Unknown { get { Alive(); return _unknown; } }

        internal bool IsRemote { get { return _remote != null; } }

        void Alive()
        {
            if (_released) throw new System.Runtime.InteropServices.InvalidComObjectException("COM object that has been separated from its underlying RCW cannot be used.");
        }

        /// Everything this wrapper holds let go: what ReleaseComObject does
        /// when the count it keeps reaches 0.
        internal void ReleaseAll()
        {
            if (_released) return;
            _released = true;
            List<nuint> held = new List<nuint>();
            lock (_asked)
            {
                foreach (KeyValuePair<string, nuint> e in _asked) held.Add(e.Value);
                _asked.Clear();
            }
            foreach (nuint p in held) System.Runtime.InteropServices.ComMarshal.Release(p);
            if (_pointer != 0) System.Runtime.InteropServices.ComMarshal.Release(_pointer);
            if (_unknown != 0) System.Runtime.InteropServices.ComMarshal.Release(_unknown);
            _pointer = 0;
            _unknown = 0;
            if (_remote != null) _remote.Release();
        }

        public override string ToString() { return "System.__ComObject"; }
    }

    /// <summary>A database null: VT_NULL, as .NET's DBNull is.</summary>
    public sealed class DBNull
    {
        public static readonly DBNull Value = new DBNull();
        DBNull() { }
        public override string ToString() { return ""; }
    }
}

namespace System.Runtime.InteropServices
{
    public enum ComInterfaceType
    {
        InterfaceIsDual = 0,
        InterfaceIsIUnknown = 1,
        InterfaceIsIDispatch = 2,
        InterfaceIsIInspectable = 3,
    }

    public enum ClassInterfaceType
    {
        None = 0,
        AutoDispatch = 1,
        AutoDual = 2,
    }

    /// VARENUM, oleaut32's VARIANT types.
    public enum VarEnum
    {
        VT_EMPTY = 0, VT_NULL = 1, VT_I2 = 2, VT_I4 = 3, VT_R4 = 4, VT_R8 = 5, VT_CY = 6, VT_DATE = 7, VT_BSTR = 8,
        VT_DISPATCH = 9, VT_ERROR = 10, VT_BOOL = 11, VT_VARIANT = 12, VT_UNKNOWN = 13, VT_DECIMAL = 14, VT_I1 = 16,
        VT_UI1 = 17, VT_UI2 = 18, VT_UI4 = 19, VT_I8 = 20, VT_UI8 = 21, VT_INT = 22, VT_UINT = 23, VT_VOID = 24,
        VT_HRESULT = 25, VT_PTR = 26, VT_SAFEARRAY = 27, VT_CARRAY = 28, VT_USERDEFINED = 29, VT_LPSTR = 30,
        VT_LPWSTR = 31, VT_RECORD = 36, VT_FILETIME = 64, VT_BLOB = 65, VT_STREAM = 66, VT_STORAGE = 67,
        VT_STREAMED_OBJECT = 68, VT_STORED_OBJECT = 69, VT_BLOB_OBJECT = 70, VT_CF = 71, VT_CLSID = 72,
        VT_VECTOR = 0x1000, VT_ARRAY = 0x2000, VT_BYREF = 0x4000,
    }

    public enum UnmanagedType
    {
        Bool = 2, I1 = 3, U1 = 4, I2 = 5, U2 = 6, I4 = 7, U4 = 8, I8 = 9, U8 = 10, R4 = 11, R8 = 12, Currency = 15,
        BStr = 19, LPStr = 20, LPWStr = 21, LPTStr = 22, ByValTStr = 23, IUnknown = 25, IDispatch = 26, Struct = 27,
        Interface = 28, SafeArray = 29, ByValArray = 30, SysInt = 31, SysUInt = 32, VBByRefStr = 34, AnsiBStr = 35,
        TBStr = 36, VariantBool = 37, FunctionPtr = 38, AsAny = 40, LPArray = 42, LPStruct = 43, CustomMarshaler = 44,
        Error = 45, IInspectable = 46, HString = 47, LPUTF8Str = 48,
    }

    /// <summary>A failure a COM object answered: its HRESULT, .NET's COMException.</summary>
    public class COMException : ExternalException
    {
        internal override int Code => unchecked((int)0x80004005);
        const string Unexpected = "Unexpected HRESULT has been returned from a call to a COM component.";
        public COMException() : base(Unexpected, unchecked((int)0x80004005)) { }
        public COMException(string? message) : base(message ?? Unexpected, unchecked((int)0x80004005)) { }
        public COMException(string? message, int errorCode) : base(message ?? Unexpected, errorCode) { }
        public COMException(string? message, Exception? inner) : base(message ?? Unexpected, inner) { }
    }

    /// <summary>A COM wrapper used after it was released.</summary>
    public class InvalidComObjectException : SystemException
    {
        internal override int Code => unchecked((int)0x80131527);
        public InvalidComObjectException() : base("Attempt has been made to use a COM object that does not have a backing class factory.") { }
        public InvalidComObjectException(string? message) : base(message ?? "Attempt has been made to use a COM object that does not have a backing class factory.") { }
        public InvalidComObjectException(string? message, Exception? inner) : base(message ?? "Attempt has been made to use a COM object that does not have a backing class factory.", inner) { }
    }

    /// <summary>VT_ERROR: an SCODE carried in a VARIANT.</summary>
    public sealed class ErrorWrapper
    {
        public ErrorWrapper(int errorCode) { ErrorCode = errorCode; }
        public ErrorWrapper(Exception e) { ErrorCode = e.HResult; }
        public int ErrorCode { get; }
    }

    /// <summary>VT_UNKNOWN: an object passed as its IUnknown, not its IDispatch.</summary>
    public sealed class UnknownWrapper
    {
        public UnknownWrapper(object? obj) { WrappedObject = obj; }
        public object? WrappedObject { get; }
    }

    /// <summary>VT_DISPATCH: an object passed as its IDispatch.</summary>
    public sealed class DispatchWrapper
    {
        public DispatchWrapper(object? obj) { WrappedObject = obj; }
        public object? WrappedObject { get; }
    }

    /// <summary>VT_BSTR, even for a null string.</summary>
    public sealed class BStrWrapper
    {
        public BStrWrapper(string? value) { WrappedObject = value; }
        public string? WrappedObject { get; }
    }

    /// <summary>VT_BYREF | VT_VARIANT.</summary>
    public sealed class VariantWrapper
    {
        public VariantWrapper(object? obj) { WrappedObject = obj; }
        public object? WrappedObject { get; }
    }

    /// <summary>
    /// What the compiler's COM-callable classes are (corc's ComDeclarations):
    /// their interfaces' entries -- each IID and native vtable -- and their
    /// IDispatch, by name and by number. The methods are written by the
    /// compiler; a class written by hand may implement them too.
    /// </summary>
    public interface IComCallable
    {
        ComInterfaceEntry[] __ComInterfaces();
        int __ComDispId(string name);
        int __ComInvoke(int dispid, int flags, object?[] args, out object? result);
    }

    /// <summary>
    /// One interface a COM-callable object has: its IID and name, how many
    /// slots its base has (3 IUnknown, 7 IDispatch or dual, -1 a
    /// dispinterface), its vtable, and each entry's parameters for the
    /// exporter's stub (ComDeclarations.Signatures).
    /// </summary>
    public sealed class ComInterfaceEntry
    {
        public readonly string Iid;
        public readonly string Name;
        public readonly int BaseSlots;
        public readonly nuint Vtable;
        public readonly string[] Signatures;

        public ComInterfaceEntry(string iid, string name, int baseSlots, nuint vtable, string[] signatures)
        {
            Iid = ComMarshal.Normal(iid);
            Name = name;
            BaseSlots = baseSlots;
            Vtable = vtable;
            Signatures = signatures;
        }

        public bool Dual { get { return BaseSlots == 7 || BaseSlots < 0; } }
    }

    /// <summary>
    /// The remote half's record of an object in another process (ComRemote.cor's
    /// RemoteObject): what an interface asked of it, a vtable call made as an
    /// ORPC request from the frame's remembered arguments, IDispatch's two
    /// calls, and the references given back.
    /// </summary>
    public abstract class ComRemoteObject
    {
        public abstract bool Has(string iid);
        public abstract int Call(string iid, int slot, ComFrame frame);
        public abstract int GetDispId(string name, out int dispid);
        public abstract int Invoke(int dispid, int flags, object?[] args, int byRef, out object? result);
        public abstract void Release();
        /// A native pointer standing for the object, for native code: IUnknown and IDispatch only.
        public abstract nuint Pointer(string iid);
    }

    /// <summary>One argument of a COM call: its kind, its direction (0 in, 1 in and out, 2 out), its value or the slot that holds it.</summary>
    public sealed class ComArg
    {
        public string Kind = "";
        public int Direction;
        public object? Value;
        public nuint Slot;
        public string Iid = "";
    }

    /// <summary>
    /// ONE CALL THROUGH A COM INTERFACE, as the compiler's runtime-callable
    /// wrappers make it: In* for each argument by value, Ref* for one in and
    /// out (a slot of native memory holding it), Out for one out and for the
    /// [retval]; Call; Get* to take each slot's value back; Done in a
    /// `finally`. The native words go to the vtable of an object in this
    /// process; the remembered arguments to an object in another.
    /// </summary>
    public sealed class ComFrame
    {
        const int SlotBytes = 32;
        readonly __ComObject? _target;
        readonly string _iid;
        readonly nuint _self;
        nuint[] _w = new nuint[16];
        int _n;
        bool _preserveSig;
        public readonly List<ComArg> Args = new List<ComArg>();
        readonly List<nuint> _memory = new List<nuint>();
        readonly List<nuint> _strings = new List<nuint>();
        readonly List<nuint> _variants = new List<nuint>();
        readonly List<nuint> _references = new List<nuint>();
        readonly List<nuint> _arrays = new List<nuint>();

        public ComFrame(object target, string iid)
        {
            __ComObject? o = target as __ComObject;
            if (o == null) throw new InvalidCastException("not a COM object");
            _target = o;
            _iid = ComMarshal.Normal(iid);
            _self = o.IsRemote ? 0 : o.__Interface(_iid);
        }

        /// A call on a native interface pointer itself: the exporter's stub.
        public ComFrame(nuint self)
        {
            _iid = "";
            _self = self;
        }

        bool Remote { get { return _target != null && _target.IsRemote; } }

        public bool IsPreserveSig { get { return _preserveSig; } }

        /// The member is [PreserveSig]: its native answer is its result.
        public void PreserveSig() { _preserveSig = true; }

        void Push(nuint w)
        {
            if (_n == _w.Length)
            {
                nuint[] more = new nuint[_w.Length * 2];
                Array.Copy(_w, more, _n);
                _w = more;
            }
            _w[_n++] = w;
        }

        /// A signed argument's word: sign-extended, as C's promotion makes it.
        void PushSigned(int v) { Push(unchecked((nuint)(long)v)); }

        void Push64(long v)
        {
            if (WordSize.Bytes == 8) { Push(unchecked((nuint)v)); return; }
            Push((uint)v);
            Push((uint)(v >> 32));
        }

        void Note(string kind, object? value, string iid = "")
        {
            Args.Add(new ComArg { Kind = kind, Direction = 0, Value = value, Iid = iid });
        }

        nuint NewSlot()
        {
            nuint at = MarshalHeap.Alloc(SlotBytes);
            Sys.MemorySet(at, 0, SlotBytes);
            _memory.Add(at);
            return at;
        }

        // ---- by value --------------------------------------------------------------------

        public void InI1(sbyte v) { Note("I1", v); PushSigned(v); }
        public void InU1(byte v) { Note("U1", v); Push(v); }
        public void InI2(short v) { Note("I2", v); PushSigned(v); }
        public void InU2(ushort v) { Note("U2", v); Push(v); }
        public void InI4(int v) { Note("I4", v); PushSigned(v); }
        public void InU4(uint v) { Note("U4", v); Push(v); }
        public void InI8(long v) { Note("I8", v); Push64(v); }
        public void InU8(ulong v) { Note("U8", v); Push64((long)v); }
        public void InR4(float v) { Note("R4", v); Push((uint)BitConverter.SingleToInt32Bits(v)); }
        public void InR8(double v) { Note("R8", v); Push64(BitConverter.DoubleToInt64Bits(v)); }
        public void InChar(char v) { Note("Char", v); Push(v); }
        public void InVBool(bool v) { Note("VBool", v); Push(v ? (nuint)0xFFFF : 0); }
        public void InBool(bool v) { Note("Bool", v); Push(v ? (nuint)1 : 0); }
        public void InBool1(bool v) { Note("Bool1", v); Push(v ? (nuint)1 : 0); }
        public void InPtr(nuint v) { Note("Ptr", v); Push(v); }

        public void InBstr(string? v)
        {
            Note("Bstr", v);
            if (Remote) return;
            nuint b = ComMarshal.AllocBstr(v);
            if (b != 0) _strings.Add(b);
            Push(b);
        }

        public void InLpwStr(string? v)
        {
            Note("LpwStr", v);
            if (Remote) return;
            nuint p = ComMarshal.AllocWide(v);
            if (p != 0) _memory.Add(p);
            Push(p);
        }

        public void InLpStr(string? v)
        {
            Note("LpStr", v);
            if (Remote) return;
            nuint p = MarshalHeap.Utf8(v);
            if (p != 0) _memory.Add(p);
            Push(p);
        }

        public void InVariant(object? v)
        {
            Note("Variant", v);
            if (Remote) return;
            nuint at = MarshalHeap.Alloc((nuint)ComMarshal.VariantBytes);
            _memory.Add(at);
            ComMarshal.WriteVariant(at, v);
            _variants.Add(at);
            if (WordSize.Bytes == 8) { Push(at); return; }
            for (int i = 0; i < 4; i++) Push(Sys.Read32(at + (nuint)(i * 4)));
        }

        public void InUnknown(object? v) { Note("Unknown", v); if (Remote) return; nuint p = ComMarshal.InterfaceFor(v, ComMarshal.IidIUnknown); if (p != 0) _references.Add(p); Push(p); }
        public void InDispatch(object? v) { Note("Dispatch", v); if (Remote) return; nuint p = ComMarshal.InterfaceFor(v, ComMarshal.IidIDispatch); if (p != 0) _references.Add(p); Push(p); }

        public void InInterface(object? v, string iid)
        {
            Note("Interface", v, iid);
            if (Remote) return;
            nuint p = ComMarshal.InterfaceFor(v, iid);
            if (p != 0) _references.Add(p);
            Push(p);
        }

        public void InGuid(Guid v)
        {
            Note("Guid", v);
            nuint at = MarshalHeap.Alloc(16);
            _memory.Add(at);
            ComMarshal.WriteGuid(at, v);
            if (WordSize.Bytes == 8) { Push(at); return; }
            for (int i = 0; i < 4; i++) Push(Sys.Read32(at + (nuint)(i * 4)));
        }

        public void InSafeArray(object? v)
        {
            Note("SafeArray", v);
            if (Remote) return;
            nuint sa = ComMarshal.SafeArrayFor(v);
            if (sa != 0) _arrays.Add(sa);
            Push(sa);
        }

        // ---- in and out, out --------------------------------------------------------------

        nuint Slotted(string kind, string iid)
        {
            nuint at = NewSlot();
            Args.Add(new ComArg { Kind = kind, Direction = 1, Slot = at, Iid = iid });
            Push(at);
            return at;
        }

        public nuint RefI1(sbyte v) { nuint at = Slotted("I1", ""); ComMarshal.WriteI1(at, v); return at; }
        public nuint RefU1(byte v) { nuint at = Slotted("U1", ""); ComMarshal.WriteU1(at, v); return at; }
        public nuint RefI2(short v) { nuint at = Slotted("I2", ""); ComMarshal.WriteI2(at, v); return at; }
        public nuint RefU2(ushort v) { nuint at = Slotted("U2", ""); ComMarshal.WriteU2(at, v); return at; }
        public nuint RefI4(int v) { nuint at = Slotted("I4", ""); ComMarshal.WriteI4(at, v); return at; }
        public nuint RefU4(uint v) { nuint at = Slotted("U4", ""); ComMarshal.WriteU4(at, v); return at; }
        public nuint RefI8(long v) { nuint at = Slotted("I8", ""); ComMarshal.WriteI8(at, v); return at; }
        public nuint RefU8(ulong v) { nuint at = Slotted("U8", ""); ComMarshal.WriteU8(at, v); return at; }
        public nuint RefR4(float v) { nuint at = Slotted("R4", ""); ComMarshal.WriteR4(at, v); return at; }
        public nuint RefR8(double v) { nuint at = Slotted("R8", ""); ComMarshal.WriteR8(at, v); return at; }
        public nuint RefChar(char v) { nuint at = Slotted("Char", ""); ComMarshal.WriteChar(at, v); return at; }
        public nuint RefVBool(bool v) { nuint at = Slotted("VBool", ""); ComMarshal.WriteVBool(at, v); return at; }
        public nuint RefBool(bool v) { nuint at = Slotted("Bool", ""); ComMarshal.WriteBool(at, v); return at; }
        public nuint RefBool1(bool v) { nuint at = Slotted("Bool1", ""); ComMarshal.WriteBool1(at, v); return at; }
        public nuint RefPtr(nuint v) { nuint at = Slotted("Ptr", ""); ComMarshal.WritePtr(at, v); return at; }
        public nuint RefBstr(string? v) { nuint at = Slotted("Bstr", ""); ComMarshal.WriteBstr(at, v); return at; }
        public nuint RefLpwStr(string? v) { nuint at = Slotted("LpwStr", ""); ComMarshal.WriteLpwStr(at, v); return at; }
        public nuint RefLpStr(string? v) { nuint at = Slotted("LpStr", ""); ComMarshal.WriteLpStr(at, v); return at; }
        public nuint RefVariant(object? v) { nuint at = Slotted("Variant", ""); ComMarshal.WriteVariant(at, v); return at; }
        public nuint RefUnknown(object? v) { nuint at = Slotted("Unknown", ""); ComMarshal.WriteUnknown(at, v); return at; }
        public nuint RefDispatch(object? v) { nuint at = Slotted("Dispatch", ""); ComMarshal.WriteDispatch(at, v); return at; }
        public nuint RefInterface(object? v, string iid) { nuint at = Slotted("Interface", iid); ComMarshal.WriteInterface(at, v, iid); return at; }
        public nuint RefGuid(Guid v) { nuint at = Slotted("Guid", ""); ComMarshal.WriteGuid(at, v); return at; }
        public nuint RefSafeArray(object? v) { nuint at = Slotted("SafeArray", ""); ComMarshal.WriteSafeArray(at, v); return at; }

        /// A slot for an [out] (or the [retval]) of `kind`, zeroed.
        public nuint Out(string kind) { return Out(kind, ""); }

        public nuint Out(string kind, string iid)
        {
            nuint at = NewSlot();
            Args.Add(new ComArg { Kind = kind, Direction = 2, Slot = at, Iid = iid });
            Push(at);
            return at;
        }

        public sbyte GetI1(nuint at) { return ComMarshal.ReadI1(at); }
        public byte GetU1(nuint at) { return ComMarshal.ReadU1(at); }
        public short GetI2(nuint at) { return ComMarshal.ReadI2(at); }
        public ushort GetU2(nuint at) { return ComMarshal.ReadU2(at); }
        public int GetI4(nuint at) { return ComMarshal.ReadI4(at); }
        public uint GetU4(nuint at) { return ComMarshal.ReadU4(at); }
        public long GetI8(nuint at) { return ComMarshal.ReadI8(at); }
        public ulong GetU8(nuint at) { return ComMarshal.ReadU8(at); }
        public float GetR4(nuint at) { return ComMarshal.ReadR4(at); }
        public double GetR8(nuint at) { return ComMarshal.ReadR8(at); }
        public char GetChar(nuint at) { return ComMarshal.ReadChar(at); }
        public bool GetVBool(nuint at) { return ComMarshal.ReadVBool(at); }
        public bool GetBool(nuint at) { return ComMarshal.ReadBool(at); }
        public bool GetBool1(nuint at) { return ComMarshal.ReadBool1(at); }
        public nuint GetPtr(nuint at) { return ComMarshal.ReadPtr(at); }
        public string? GetBstr(nuint at) { return ComMarshal.TakeBstr(at); }
        public string? GetLpwStr(nuint at) { return ComMarshal.TakeLpwStr(at); }
        public string? GetLpStr(nuint at) { return ComMarshal.TakeLpStr(at); }
        public object? GetVariant(nuint at) { return ComMarshal.TakeVariant(at); }
        public object? GetUnknown(nuint at) { return ComMarshal.TakeInterface(at); }
        public object? GetDispatch(nuint at) { return ComMarshal.TakeInterface(at); }
        public object? GetInterface(nuint at) { return ComMarshal.TakeInterface(at); }
        public Guid GetGuid(nuint at) { return ComMarshal.ReadGuid(at); }
        public object? GetSafeArray(nuint at) { return ComMarshal.TakeSafeArray(at); }

        // ---- the call ------------------------------------------------------------------------

        nuint Entry(int slot)
        {
            nuint vtable = Sys.ReadAddress((nuint)_self);
            return Sys.ReadAddress(vtable + (nuint)(slot * WordSize.Bytes));
        }

        /// The call through vtable entry `slot`: its HRESULT (a
        /// [PreserveSig] member's answer).
        public int Call(int slot)
        {
            if (Remote) return _target!._remote!.Call(_iid, slot, this);
            return ComRuntime.CallInt(Entry(slot), _self, _w, _n);
        }

        public long CallLong(int slot) { NotRemote(); return ComRuntime.CallLong(Entry(slot), _self, _w, _n); }
        public double CallDouble(int slot) { NotRemote(); return ComRuntime.CallDouble(Entry(slot), _self, _w, _n); }
        public float CallFloat(int slot) { NotRemote(); return ComRuntime.CallFloat(Entry(slot), _self, _w, _n); }
        public nuint CallPtr(int slot) { NotRemote(); return ComRuntime.CallPtr(Entry(slot), _self, _w, _n); }

        void NotRemote()
        {
            if (Remote) throw new NotSupportedException("a [PreserveSig] member answering anything but an HRESULT is not called across processes");
        }

        /// What the call's arguments held, let go: the BSTRs, VARIANTs and
        /// interfaces made for it, and the slots.
        public void Done()
        {
            foreach (nuint b in _strings) ComMarshal.FreeBstr(b);
            foreach (nuint v in _variants) ComMarshal.VariantClear(v);
            foreach (nuint p in _references) ComMarshal.Release(p);
            foreach (nuint a in _arrays) ComMarshal.SafeArrayDestroy(a);
            foreach (nuint m in _memory) MarshalHeap.Free(m);
            _strings.Clear(); _variants.Clear(); _references.Clear(); _memory.Clear(); _arrays.Clear();
        }
    }

    /// <summary>
    /// COM's MARSHALLING, kind by kind: Read (a slot's value, its owner
    /// unchanged), Write (a value into a slot, made for the slot's owner),
    /// Replace (Write, what the slot held first let go -- an [in, out]
    /// argument a callee changes), Take (Read, then let go), Arg (a value
    /// passed in stack words). And BSTRs, VARIANTs, SAFEARRAYs, interface
    /// pointers and HRESULTs.
    /// </summary>
    public static class ComMarshal
    {
        public const string IidIUnknown = "00000000-0000-0000-C000-000000000046";
        public const string IidIDispatch = "00020400-0000-0000-C000-000000000046";
        public const int SOk = 0, SFalse = 1;
        public const int ENotImpl = unchecked((int)0x80004001), ENoInterface = unchecked((int)0x80004002), EPointer = unchecked((int)0x80004003);
        public const int EFail = unchecked((int)0x80004005), EUnexpected = unchecked((int)0x8000FFFF), EOutOfMemory = unchecked((int)0x8007000E);
        public const int EInvalidArg = unchecked((int)0x80070057), EAccessDenied = unchecked((int)0x80070005);
        public const int DispEUnknownName = unchecked((int)0x80020006), DispEMemberNotFound = unchecked((int)0x80020003);
        public const int DispEException = unchecked((int)0x80020009), DispETypeMismatch = unchecked((int)0x80020005);
        public const int DispEBadParamCount = unchecked((int)0x8002000E), DispEParamNotFound = unchecked((int)0x80020004);
        public const int ClassENoAggregation = unchecked((int)0x80040110), RegdbEClassNotReg = unchecked((int)0x80040154);

        /// VARIANT's size: 16 bytes on i386, 24 on x86-64.
        public static int VariantBytes { get { return WordSize.Bytes == 8 ? 24 : 16; } }

        /// A GUID's text as these keep it: upper case, no braces.
        public static string Normal(string guid) { return guid.Trim().Trim('{', '}').ToUpperInvariant(); }

        // ---- IUnknown on a native pointer --------------------------------------------------

        static nuint Entry(nuint self, int slot)
        {
            nuint vtable = Sys.ReadAddress(self);
            return Sys.ReadAddress(vtable + (nuint)(slot * WordSize.Bytes));
        }

        public static int AddRef(nuint p)
        {
            if (p == 0) return 0;
            return ((delegate* unmanaged[Stdcall]<nuint, int>)Entry(p, 1))(p);
        }

        public static int Release(nuint p)
        {
            if (p == 0) return 0;
            return ((delegate* unmanaged[Stdcall]<nuint, int>)Entry(p, 2))(p);
        }

        /// QueryInterface: a new reference to the interface, or 0.
        public static nuint Query(nuint p, string iid)
        {
            if (p == 0) return 0;
            nuint g = MarshalHeap.Alloc(16 + WordSize.Bytes);
            try
            {
                WriteGuid(g, new Guid(GuidBytes(iid)));
                nuint into = g + 16;
                Sys.WriteAddress(into, 0);
                int hr = ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, int>)Entry(p, 0))(p, g, into);
                return hr < 0 ? 0 : Sys.ReadAddress(into);
            }
            finally { MarshalHeap.Free(g); }
        }

        /// A GUID's sixteen bytes, as Windows lays them out, from its text.
        public static byte[] GuidBytes(string text)
        {
            Guid g;
            if (!Guid.TryParse(Normal(text), out g)) throw new ArgumentException("not a GUID: " + text);
            return g.ToByteArray();
        }

        public static Guid ReadGuid(nuint at)
        {
            byte[] b = new byte[16];
            for (int i = 0; i < 16; i++) b[i] = (byte)Sys.Read8(at + (nuint)i);
            return new Guid(b);
        }

        public static void WriteGuid(nuint at, Guid g)
        {
            byte[] b = g.ToByteArray();
            for (int i = 0; i < 16; i++) Sys.Write8(at + (nuint)i, b[i]);
        }

        public static string GuidText(nuint at) { return Normal(ReadGuid(at).ToString()); }

        // ---- objects and interface pointers -----------------------------------------------

        /// The object a native interface pointer is: the managed object
        /// itself when it is one of this process's COM-callable wrappers, an
        /// object in another process's when it is that's stand-in, else a
        /// new __ComObject over it (its own reference taken).
        public static object? ObjectFor(nuint p)
        {
            if (p == 0) return null;
            object? own = ComCallable.TargetOf(p);
            if (own is RemoteStandIn stand && stand.Holder != null) return stand.Holder;
            if (own != null) return own;
            return new System.__ComObject(p);
        }

        /// The interface `iid` of an object, a new reference: a COM object's
        /// asked of it (QueryInterface), a managed object's its COM-callable
        /// wrapper's. 0 for null, and for an interface it has not.
        public static nuint InterfaceFor(object? o, string iid)
        {
            if (o == null) return 0;
            if (o is UnknownWrapper uw) return InterfaceFor(uw.WrappedObject, IidIUnknown);
            if (o is DispatchWrapper dw) return InterfaceFor(dw.WrappedObject, IidIDispatch);
            string want = Normal(iid);
            System.__ComObject? c = o as System.__ComObject;
            if (c != null)
            {
                if (c.IsRemote) return c._remote!.Pointer(want);
                return Query(c.Unknown, want);
            }
            return ComCallable.For(o).Query(want);
        }

        public static object? ArgUnknown(nuint p) { return ObjectFor(p); }

        public static object? ArgInterface(nuint p) { return ObjectFor(p); }
        public static object? ArgDispatch(nuint p) { return ObjectFor(p); }
        public static object? ReadInterface(nuint at) { return ObjectFor(Sys.ReadAddress(at)); }
        public static object? ReadUnknown(nuint at) { return ReadInterface(at); }
        public static object? ReadDispatch(nuint at) { return ReadInterface(at); }

        /// A slot's interface, made an object; the slot's reference let go.
        public static object? TakeInterface(nuint at)
        {
            nuint p = Sys.ReadAddress(at);
            Sys.WriteAddress(at, 0);
            if (p == 0) return null;
            object? o = ObjectFor(p);
            Release(p);
            return o;
        }

        public static void WriteInterface(nuint at, object? o, string iid) { Sys.WriteAddress(at, (nuint)(InterfaceFor(o, iid))); }
        public static void WriteUnknown(nuint at, object? o) { Sys.WriteAddress(at, (nuint)(InterfaceFor(o, IidIUnknown))); }
        public static void WriteDispatch(nuint at, object? o) { Sys.WriteAddress(at, (nuint)(InterfaceFor(o, IidIDispatch))); }

        public static void ReplaceInterface(nuint at, object? o, string iid)
        {
            nuint old = Sys.ReadAddress(at);
            WriteInterface(at, o, iid);
            Release(old);
        }

        public static void ReplaceUnknown(nuint at, object? o) { ReplaceInterface(at, o, IidIUnknown); }
        public static void ReplaceDispatch(nuint at, object? o) { ReplaceInterface(at, o, IidIDispatch); }
        public static object? ArgObject(nuint p) { return ObjectFor(p); }

        // ---- numbers ----------------------------------------------------------------------

        public static sbyte ArgI1(nuint w) { return (sbyte)w; }
        public static byte ArgU1(nuint w) { return (byte)w; }
        public static short ArgI2(nuint w) { return (short)w; }
        public static ushort ArgU2(nuint w) { return (ushort)w; }
        public static int ArgI4(nuint w) { return (int)w; }
        public static uint ArgU4(nuint w) { return (uint)(int)w; }
        public static long ArgI8(nuint w) { return (long)w; }
        public static long ArgI8(nuint low, nuint high) { return ((long)(int)low & 0xFFFFFFFFL) | ((long)(int)high << 32); }
        public static ulong ArgU8(nuint w) { return (ulong)(long)w; }
        public static ulong ArgU8(nuint low, nuint high) { return (ulong)ArgI8(low, high); }
        public static float ArgR4(nuint w) { return BitConverter.Int32BitsToSingle((int)w); }
        public static double ArgR8(nuint w) { return BitConverter.Int64BitsToDouble((long)w); }
        public static double ArgR8(nuint low, nuint high) { return BitConverter.Int64BitsToDouble(ArgI8(low, high)); }
        public static char ArgChar(nuint w) { return (char)(ushort)w; }
        public static bool ArgVBool(nuint w) { return (short)w != 0; }
        public static bool ArgBool(nuint w) { return (int)w != 0; }
        public static bool ArgBool1(nuint w) { return (byte)w != 0; }
        public static nuint ArgPtr(nuint w) { return w; }

        public static sbyte ReadI1(nuint at) { return (sbyte)Sys.Read8(at); }
        public static byte ReadU1(nuint at) { return (byte)Sys.Read8(at); }
        public static short ReadI2(nuint at) { return (short)Sys.Read16(at); }
        public static ushort ReadU2(nuint at) { return (ushort)Sys.Read16(at); }
        public static int ReadI4(nuint at) { return (int)Sys.Read32(at); }
        public static uint ReadU4(nuint at) { return (uint)Sys.Read32(at); }
        public static long ReadI8(nuint at) { return (long)Sys.Read64(at); }
        public static ulong ReadU8(nuint at) { return (ulong)ReadI8(at); }
        public static float ReadR4(nuint at) { return BitConverter.Int32BitsToSingle(ReadI4(at)); }
        public static double ReadR8(nuint at) { return BitConverter.Int64BitsToDouble(ReadI8(at)); }
        public static char ReadChar(nuint at) { return (char)Sys.Read16(at); }
        public static bool ReadVBool(nuint at) { return Sys.Read16(at) != 0; }
        public static bool ReadBool(nuint at) { return Sys.Read32(at) != 0; }
        public static bool ReadBool1(nuint at) { return Sys.Read8(at) != 0; }
        public static nuint ReadPtr(nuint at) { return Sys.ReadAddress(at); }

        public static void WriteI1(nuint at, sbyte v) { Sys.Write8(at, (byte)v); }
        public static void WriteU1(nuint at, byte v) { Sys.Write8(at, v); }
        public static void WriteI2(nuint at, short v) { Sys.Write16(at, (ushort)v); }
        public static void WriteU2(nuint at, ushort v) { Sys.Write16(at, v); }
        public static void WriteI4(nuint at, int v) { Sys.Write32(at, (uint)v); }
        public static void WriteU4(nuint at, uint v) { Sys.Write32(at, v); }
        public static void WriteI8(nuint at, long v) { Sys.Write32(at, (uint)v); Sys.Write32(at + 4, (uint)(v >> 32)); }
        public static void WriteU8(nuint at, ulong v) { WriteI8(at, (long)v); }
        public static void WriteR4(nuint at, float v) { WriteI4(at, BitConverter.SingleToInt32Bits(v)); }
        public static void WriteR8(nuint at, double v) { WriteI8(at, BitConverter.DoubleToInt64Bits(v)); }
        public static void WriteChar(nuint at, char v) { Sys.Write16(at, v); }
        public static void WriteVBool(nuint at, bool v) { Sys.Write16(at, (ushort)(v ? 0xFFFF : 0)); }
        public static void WriteBool(nuint at, bool v) { Sys.Write32(at, (uint)(v ? 1 : 0)); }
        public static void WriteBool1(nuint at, bool v) { Sys.Write8(at, (byte)(v ? 1 : 0)); }
        public static void WritePtr(nuint at, nuint v) { Sys.WriteAddress(at, v); }

        public static void ReplaceI1(nuint at, sbyte v) { WriteI1(at, v); }
        public static void ReplaceU1(nuint at, byte v) { WriteU1(at, v); }
        public static void ReplaceI2(nuint at, short v) { WriteI2(at, v); }
        public static void ReplaceU2(nuint at, ushort v) { WriteU2(at, v); }
        public static void ReplaceI4(nuint at, int v) { WriteI4(at, v); }
        public static void ReplaceU4(nuint at, uint v) { WriteU4(at, v); }
        public static void ReplaceI8(nuint at, long v) { WriteI8(at, v); }
        public static void ReplaceU8(nuint at, ulong v) { WriteU8(at, v); }
        public static void ReplaceR4(nuint at, float v) { WriteR4(at, v); }
        public static void ReplaceR8(nuint at, double v) { WriteR8(at, v); }
        public static void ReplaceChar(nuint at, char v) { WriteChar(at, v); }
        public static void ReplaceVBool(nuint at, bool v) { WriteVBool(at, v); }
        public static void ReplaceBool(nuint at, bool v) { WriteBool(at, v); }
        public static void ReplaceBool1(nuint at, bool v) { WriteBool1(at, v); }
        public static void ReplacePtr(nuint at, nuint v) { WritePtr(at, v); }

        public static Guid ArgGuid(nuint at) { return ReadGuid(at); }

        public static Guid ArgGuid(nuint a, nuint b, nuint c, nuint d)
        {
            nuint at = MarshalHeap.Alloc(16);
            try
            {
                Sys.Write32(at, (uint)a); Sys.Write32(at + 4, (uint)b); Sys.Write32(at + 8, (uint)c); Sys.Write32(at + 12, (uint)d);
                return ReadGuid(at);
            }
            finally { MarshalHeap.Free(at); }
        }

        public static void ReplaceGuid(nuint at, Guid g) { WriteGuid(at, g); }

        // ---- strings ----------------------------------------------------------------------

        /// SysAllocString: the characters after a 32-bit byte count, ended by
        /// a zero, the pointer to the first character. Null for null.
        public static nuint AllocBstr(string? s)
        {
            if (s == null) return 0;
            nuint block = MarshalHeap.Alloc((nuint)(4 + s.Length * 2 + 2));
            Sys.Write32(block, (uint)(s.Length * 2));
            nuint chars = block + 4;
            for (int i = 0; i < s.Length; i++) Sys.Write16(chars + (nuint)(i * 2), s[i]);
            Sys.Write16(chars + (nuint)(s.Length * 2), 0);
            return chars;
        }

        /// A BSTR of `bytes` bytes (SysAllocStringByteLen), its contents zero.
        public static nuint AllocBstrBytes(int bytes)
        {
            nuint block = MarshalHeap.Alloc((nuint)(4 + bytes + 2));
            Sys.Write32(block, (uint)bytes);
            for (int i = 0; i < bytes + 2; i++) Sys.Write8(block + (nuint)(4 + i), 0);
            return block + 4;
        }

        public static void FreeBstr(nuint b)
        {
            if (b != 0) MarshalHeap.Free(b - 4);
        }

        public static int BstrBytes(nuint b) { return b == 0 ? 0 : (int)Sys.Read32(b - 4); }

        public static string? FromBstr(nuint b)
        {
            if (b == 0) return null;
            int chars = BstrBytes(b) / 2;
            StringBuilder s = new StringBuilder(chars);
            for (int i = 0; i < chars; i++) s.Append((char)Sys.Read16(b + (nuint)(i * 2)));
            return s.ToString();
        }

        public static string? ArgBstr(nuint b) { return FromBstr(b); }
        public static string? ReadBstr(nuint at) { return FromBstr(Sys.ReadAddress(at)); }

        public static string? TakeBstr(nuint at)
        {
            nuint b = Sys.ReadAddress(at);
            Sys.WriteAddress(at, 0);
            string? s = FromBstr(b);
            FreeBstr(b);
            return s;
        }

        public static void WriteBstr(nuint at, string? s) { Sys.WriteAddress(at, (nuint)(AllocBstr(s))); }

        public static void ReplaceBstr(nuint at, string? s)
        {
            FreeBstr(Sys.ReadAddress(at));
            WriteBstr(at, s);
        }

        /// A zero-ended UTF-16 copy (LPWSTR), CoTaskMemAlloc'd.
        public static nuint AllocWide(string? s)
        {
            if (s == null) return 0;
            nuint p = MarshalHeap.Alloc((nuint)(s.Length * 2 + 2));
            for (int i = 0; i < s.Length; i++) Sys.Write16(p + (nuint)(i * 2), s[i]);
            Sys.Write16(p + (nuint)(s.Length * 2), 0);
            return p;
        }

        public static string? FromWide(nuint p)
        {
            if (p == 0) return null;
            StringBuilder s = new StringBuilder();
            for (int i = 0; ; i++)
            {
                int c = (int)Sys.Read16(p + (nuint)(i * 2));
                if (c == 0) break;
                s.Append((char)c);
            }
            return s.ToString();
        }

        public static string? ArgLpwStr(nuint p) { return FromWide(p); }
        public static string? ReadLpwStr(nuint at) { return FromWide(Sys.ReadAddress(at)); }
        public static string? TakeLpwStr(nuint at) { nuint p = Sys.ReadAddress(at); Sys.WriteAddress(at, 0); string? s = FromWide(p); MarshalHeap.Free(p); return s; }
        public static void WriteLpwStr(nuint at, string? s) { Sys.WriteAddress(at, (nuint)(AllocWide(s))); }
        public static void ReplaceLpwStr(nuint at, string? s) { MarshalHeap.Free(Sys.ReadAddress(at)); WriteLpwStr(at, s); }

        public static string? ArgLpStr(nuint p) { return MarshalHeap.FromUtf8(p); }
        public static string? ReadLpStr(nuint at) { return ArgLpStr(Sys.ReadAddress(at)); }
        public static string? TakeLpStr(nuint at) { nuint p = Sys.ReadAddress(at); Sys.WriteAddress(at, 0); string? s = ArgLpStr(p); MarshalHeap.Free(p); return s; }
        public static void WriteLpStr(nuint at, string? s) { Sys.WriteAddress(at, (nuint)(s == null ? 0 : Marshal.StringToHGlobalUTF8(s))); }
        public static void ReplaceLpStr(nuint at, string? s) { MarshalHeap.Free(Sys.ReadAddress(at)); WriteLpStr(at, s); }

        // ---- VARIANT ----------------------------------------------------------------------

        public const int VtEmpty = 0, VtNull = 1, VtI2 = 2, VtI4 = 3, VtR4 = 4, VtR8 = 5, VtCy = 6, VtDate = 7, VtBstr = 8;
        public const int VtDispatch = 9, VtError = 10, VtBool = 11, VtVariant = 12, VtUnknown = 13, VtDecimal = 14;
        public const int VtI1 = 16, VtUi1 = 17, VtUi2 = 18, VtUi4 = 19, VtI8 = 20, VtUi8 = 21, VtInt = 22, VtUint = 23;
        public const int VtArray = 0x2000, VtByRef = 0x4000, VtTypeMask = 0xFFF;

        /// Where a VARIANT's value is: after its type and three reserved words.
        public const int VariantData = 8;

        public static void VariantInit(nuint v)
        {
            for (int i = 0; i < VariantBytes; i++) Sys.Write8(v + (nuint)i, 0);
        }

        /// VariantClear: what the VARIANT owns let go, and it made VT_EMPTY.
        public static void VariantClear(nuint v)
        {
            int vt = (int)Sys.Read16(v);
            if ((vt & VtByRef) == 0)
            {
                if ((vt & VtArray) != 0) SafeArrayDestroy(Sys.ReadAddress(v + (nuint)VariantData));
                else if (vt == VtBstr) FreeBstr(Sys.ReadAddress(v + (nuint)VariantData));
                else if (vt == VtUnknown || vt == VtDispatch) Release(Sys.ReadAddress(v + (nuint)VariantData));
            }
            VariantInit(v);
        }

        /// The DATE of a DateTime: days since 30 December 1899, the fraction the time of day.
        public static double ToOADate(DateTime d)
        {
            const long epoch = 599264352000000000L, day = 864000000000L;
            long ticks = d.Ticks - epoch;
            double days = (double)(ticks / day);
            long rest = ticks % day;
            if (rest < 0) { days -= 1; rest += day; }
            // Before the epoch the fraction counts forward from the day's
            // start but the day backwards, as OLE's DATE does.
            double fraction = (double)rest / day;
            return days < 0 ? days - fraction + 1 + (fraction == 0 ? -1 : 0) : days + fraction;
        }

        public static DateTime FromOADate(double d)
        {
            const long epoch = 599264352000000000L, day = 864000000000L;
            long whole = (long)d;
            double fraction = d - whole;
            if (fraction < 0) fraction = -fraction;
            long ticks = epoch + whole * day + (long)(fraction * day + 0.5);
            return new DateTime(ticks);
        }

        /// An object written as a VARIANT at `v`, as .NET marshals one:
        /// null VT_EMPTY, DBNull VT_NULL, each number its own type, bool
        /// VT_BOOL, string VT_BSTR, DateTime VT_DATE, an array a SAFEARRAY,
        /// a COM object or a managed one VT_DISPATCH when it has IDispatch
        /// (else VT_UNKNOWN), the wrappers what they say.
        public static void WriteVariant(nuint v, object? o)
        {
            VariantInit(v);
            nuint data = v + VariantData;
            int vt;
            if (o == null) vt = VtEmpty;
            else if (o is DBNull) vt = VtNull;
            else if (o is int i) { vt = VtI4; Sys.Write32(data, (uint)i); }
            else if (o is string s) { vt = VtBstr; Sys.WriteAddress(data, (nuint)(AllocBstr(s))); }
            else if (o is bool b) { vt = VtBool; Sys.Write16(data, (ushort)(b ? 0xFFFF : 0)); }
            else if (o is double dbl) { vt = VtR8; WriteR8(data, dbl); }
            else if (o is float f) { vt = VtR4; WriteR4(data, f); }
            else if (o is short sh) { vt = VtI2; Sys.Write16(data, (ushort)sh); }
            else if (o is long l) { vt = VtI8; WriteI8(data, l); }
            else if (o is byte u1) { vt = VtUi1; Sys.Write8(data, u1); }
            else if (o is sbyte i1) { vt = VtI1; Sys.Write8(data, (byte)i1); }
            else if (o is ushort u2) { vt = VtUi2; Sys.Write16(data, u2); }
            else if (o is uint u4) { vt = VtUi4; Sys.Write32(data, u4); }
            else if (o is ulong u8) { vt = VtUi8; WriteI8(data, (long)u8); }
            else if (o is char ch) { vt = VtUi2; Sys.Write16(data, ch); }
            else if (o is DateTime date) { vt = VtDate; WriteR8(data, ToOADate(date)); }
            else if (o is ErrorWrapper ew) { vt = VtError; Sys.Write32(data, (uint)ew.ErrorCode); }
            else if (o is BStrWrapper bw) { vt = VtBstr; Sys.WriteAddress(data, (nuint)(AllocBstr(bw.WrappedObject))); }
            else if (o is UnknownWrapper uw) { vt = VtUnknown; Sys.WriteAddress(data, (nuint)(InterfaceFor(uw.WrappedObject, IidIUnknown))); }
            else if (o is DispatchWrapper dw) { vt = VtDispatch; Sys.WriteAddress(data, (nuint)(InterfaceFor(dw.WrappedObject, IidIDispatch))); }
            else if (o.GetType().IsArray) { vt = VtArray | ArrayVt(o); Sys.WriteAddress(data, (nuint)(SafeArrayFor(o))); }
            else if (o.GetType().IsEnum) { vt = VtI4; Sys.Write32(data, (uint)((int)Long(o))); }
            else
            {
                nuint d = InterfaceFor(o, IidIDispatch);
                if (d != 0) { vt = VtDispatch; Sys.WriteAddress(data, (nuint)d); }
                else { vt = VtUnknown; Sys.WriteAddress(data, (nuint)(InterfaceFor(o, IidIUnknown))); }
            }
            Sys.Write16(v, (ushort)vt);
        }

        public static void ReplaceVariant(nuint v, object? o)
        {
            VariantClear(v);
            WriteVariant(v, o);
        }

        /// The object a VARIANT holds (by reference followed), the VARIANT unchanged.
        public static object? ReadVariant(nuint v)
        {
            int vt = (int)Sys.Read16(v);
            nuint data = v + VariantData;
            if ((vt & VtByRef) != 0)
            {
                nuint at = Sys.ReadAddress(data);
                int bare = vt & ~VtByRef;
                if (bare == VtVariant) return ReadVariant(at);
                return ReadValue(bare, at);
            }
            return ReadValue(vt, data);
        }

        /// A value of type `vt` stored at `at` (a VARIANT's data, a SAFEARRAY's element).
        public static object? ReadValue(int vt, nuint at)
        {
            if ((vt & VtArray) != 0) return FromSafeArray(Sys.ReadAddress(at));
            switch (vt)
            {
                case VtEmpty: return null;
                case VtNull: return DBNull.Value;
                case VtI2: return (short)Sys.Read16(at);
                case VtI4: case VtInt: return (int)Sys.Read32(at);
                case VtR4: return ReadR4(at);
                case VtR8: return ReadR8(at);
                case VtCy: return ReadI8(at) / 10000.0;
                case VtDate: return FromOADate(ReadR8(at));
                case VtBstr: return FromBstr(Sys.ReadAddress(at));
                case VtDispatch: case VtUnknown: return ObjectFor(Sys.ReadAddress(at));
                case VtError: return (int)Sys.Read32(at);
                case VtBool: return Sys.Read16(at) != 0;
                case VtVariant: return ReadVariant(at);
                case VtI1: return (sbyte)Sys.Read8(at);
                case VtUi1: return (byte)Sys.Read8(at);
                case VtUi2: return (ushort)Sys.Read16(at);
                case VtUi4: case VtUint: return (uint)Sys.Read32(at);
                case VtI8: return ReadI8(at);
                case VtUi8: return (ulong)ReadI8(at);
            }
            throw new NotSupportedException("a VARIANT of type " + vt + " has no .NET form here");
        }

        public static object? TakeVariant(nuint v)
        {
            object? o = ReadVariant(v);
            VariantClear(v);
            return o;
        }

        /// A VARIANT passed by value: four stack words on i386.
        public static object? ArgVariant(nuint a, nuint b, nuint c, nuint d)
        {
            nuint at = MarshalHeap.Alloc(16);
            try
            {
                Sys.Write32(at, (uint)a); Sys.Write32(at + 4, (uint)b); Sys.Write32(at + 8, (uint)c); Sys.Write32(at + 12, (uint)d);
                return ReadVariant(at);
            }
            finally { MarshalHeap.Free(at); }
        }

        /// A VARIANT passed by value on x86-64: its address.
        public static object? ArgVariant(nuint at) { return ReadVariant(at); }

        // ---- SAFEARRAY --------------------------------------------------------------------

        public const int FadfHaveVartype = 0x80, FadfBstr = 0x100, FadfUnknown = 0x200, FadfDispatch = 0x400, FadfVariant = 0x800;

        static int SaData { get { return WordSize.Bytes == 8 ? 16 : 12; } }
        static int SaBounds { get { return WordSize.Bytes == 8 ? 24 : 16; } }

        /// The VARTYPE a .NET array's elements become.
        public static int ArrayVt(object o)
        {
            if (o is int[]) return VtI4;
            if (o is string[]) return VtBstr;
            if (o is double[]) return VtR8;
            if (o is byte[]) return VtUi1;
            if (o is short[]) return VtI2;
            if (o is long[]) return VtI8;
            if (o is float[]) return VtR4;
            if (o is bool[]) return VtBool;
            if (o is uint[]) return VtUi4;
            if (o is ushort[]) return VtUi2;
            if (o is sbyte[]) return VtI1;
            if (o is ulong[]) return VtUi8;
            if (o is DateTime[]) return VtDate;
            return VtVariant;
        }

        public static int ElementBytes(int vt)
        {
            switch (vt)
            {
                case VtI1: case VtUi1: return 1;
                case VtI2: case VtUi2: case VtBool: return 2;
                case VtI4: case VtUi4: case VtR4: case VtError: case VtInt: case VtUint: return 4;
                case VtI8: case VtUi8: case VtR8: case VtDate: case VtCy: return 8;
                case VtBstr: case VtUnknown: case VtDispatch: return WordSize.Bytes;
                case VtVariant: return VariantBytes;
            }
            throw new NotSupportedException("a SAFEARRAY of type " + vt);
        }

        /// SafeArrayCreateVector: one dimension, `count` elements from 0, the
        /// VARTYPE kept in front, its data zeroed.
        public static nuint SafeArrayCreate(int vt, int count, int lowerBound)
        {
            int elem = ElementBytes(vt);
            int header = SaBounds + 8;
            nuint block = MarshalHeap.Alloc((nuint)(16 + header));
            for (int i = 0; i < 16 + header; i++) Sys.Write8(block + (nuint)i, 0);
            nuint sa = block + 16;
            int features = FadfHaveVartype | (vt == VtBstr ? FadfBstr : vt == VtUnknown ? FadfUnknown : vt == VtDispatch ? FadfDispatch : vt == VtVariant ? FadfVariant : 0);
            Sys.Write32(sa - 4, (uint)vt);
            Sys.Write16(sa, 1);
            Sys.Write16(sa + 2, (ushort)features);
            Sys.Write32(sa + 4, (uint)elem);
            Sys.Write32(sa + 8, 0);
            nuint data = MarshalHeap.Alloc((nuint)Math.Max(1, elem * count));
            for (int i = 0; i < elem * count; i++) Sys.Write8(data + (nuint)i, 0);
            Sys.WriteAddress(sa + (nuint)SaData, data);
            Sys.Write32(sa + (nuint)SaBounds, (uint)count);
            Sys.Write32(sa + (nuint)(SaBounds + 4), (uint)lowerBound);
            return sa;
        }

        public static int SafeArrayVt(nuint sa)
        {
            int features = (int)Sys.Read16(sa + 2);
            if ((features & FadfHaveVartype) != 0) return (int)Sys.Read32(sa - 4);
            if ((features & FadfBstr) != 0) return VtBstr;
            if ((features & FadfUnknown) != 0) return VtUnknown;
            if ((features & FadfDispatch) != 0) return VtDispatch;
            if ((features & FadfVariant) != 0) return VtVariant;
            int elem = (int)Sys.Read32(sa + 4);
            return elem == 1 ? VtUi1 : elem == 2 ? VtI2 : elem == 8 ? VtR8 : VtI4;
        }

        public static int SafeArrayDims(nuint sa) { return (int)Sys.Read16(sa); }

        /// The elements of every dimension: what a SAFEARRAY holds in all.
        public static int SafeArrayCells(nuint sa)
        {
            int dims = SafeArrayDims(sa), cells = 1;
            for (int d = 0; d < dims; d++) cells *= (int)Sys.Read32(sa + (nuint)(SaBounds + d * 8));
            return cells;
        }

        public static nuint SafeArrayData(nuint sa) { return Sys.ReadAddress(sa + (nuint)SaData); }

        /// SafeArrayDestroy: its elements' BSTRs, interfaces and VARIANTs
        /// let go, then its data and itself.
        public static void SafeArrayDestroy(nuint sa)
        {
            if (sa == 0) return;
            int vt = SafeArrayVt(sa);
            int cells = SafeArrayCells(sa);
            int elem = (int)Sys.Read32(sa + 4);
            nuint data = SafeArrayData(sa);
            if (data != 0)
            {
                for (int i = 0; i < cells; i++)
                {
                    nuint at = data + (nuint)(i * elem);
                    if (vt == VtBstr) FreeBstr(Sys.ReadAddress(at));
                    else if (vt == VtUnknown || vt == VtDispatch) Release(Sys.ReadAddress(at));
                    else if (vt == VtVariant) VariantClear(at);
                }
                MarshalHeap.Free(data);
            }
            MarshalHeap.Free(sa - 16);
        }

        /// A .NET array as a new SAFEARRAY of the VARTYPE its elements are;
        /// 0 for null. One dimension, from 0.
        public static nuint SafeArrayFor(object? a)
        {
            if (a == null) return 0;
            int vt = ArrayVt(a);
            int count = ArrayLength(a);
            nuint sa = SafeArrayCreate(vt, count, 0);
            nuint data = SafeArrayData(sa);
            int elem = ElementBytes(vt);
            for (int i = 0; i < count; i++) WriteValue(vt, data + (nuint)(i * elem), ArrayItem(a, i));
            return sa;
        }

        /// An array's length and one element, whatever its element type.
        public static int ArrayLength(object a)
        {
            if (a is int[] i) return i.Length;
            if (a is double[] d) return d.Length;
            if (a is byte[] b) return b.Length;
            if (a is short[] sh) return sh.Length;
            if (a is long[] l) return l.Length;
            if (a is float[] f) return f.Length;
            if (a is bool[] bo) return bo.Length;
            if (a is uint[] ui) return ui.Length;
            if (a is ushort[] us) return us.Length;
            if (a is sbyte[] sb) return sb.Length;
            if (a is ulong[] ul) return ul.Length;
            if (a is char[] c) return c.Length;
            if (a is DateTime[] dt) return dt.Length;
            if (a is object?[] o) return o.Length;
            throw new NotSupportedException("an array of this type is not marshalled as a SAFEARRAY");
        }

        public static object? ArrayItem(object a, int at)
        {
            if (a is int[] i) return i[at];
            if (a is double[] d) return d[at];
            if (a is byte[] b) return b[at];
            if (a is short[] sh) return sh[at];
            if (a is long[] l) return l[at];
            if (a is float[] f) return f[at];
            if (a is bool[] bo) return bo[at];
            if (a is uint[] ui) return ui[at];
            if (a is ushort[] us) return us[at];
            if (a is sbyte[] sb) return sb[at];
            if (a is ulong[] ul) return ul[at];
            if (a is char[] c) return c[at];
            if (a is DateTime[] dt) return dt[at];
            if (a is object?[] o) return o[at];
            throw new NotSupportedException("an array of this type is not marshalled as a SAFEARRAY");
        }

        /// A value written as type `vt` at `at`: a SAFEARRAY's element.
        public static void WriteValue(int vt, nuint at, object? o)
        {
            switch (vt)
            {
                case VtI1: case VtUi1: Sys.Write8(at, (byte)(Long(o))); return;
                case VtI2: case VtUi2: Sys.Write16(at, (ushort)(Long(o))); return;
                case VtBool: Sys.Write16(at, (ushort)(Bool(o) ? 0xFFFF : 0)); return;
                case VtI4: case VtInt: case VtError: case VtUi4: case VtUint: Sys.Write32(at, (uint)(Long(o))); return;
                case VtR4: WriteR4(at, (float)Double(o)); return;
                case VtI8: case VtUi8: WriteI8(at, Long(o)); return;
                case VtR8: WriteR8(at, Double(o)); return;
                case VtDate: WriteR8(at, o is DateTime d ? ToOADate(d) : Double(o)); return;
                case VtBstr: Sys.WriteAddress(at, (nuint)(AllocBstr(o == null ? null : o.ToString()))); return;
                case VtUnknown: Sys.WriteAddress(at, (nuint)(InterfaceFor(o, IidIUnknown))); return;
                case VtDispatch: Sys.WriteAddress(at, (nuint)(InterfaceFor(o, IidIDispatch))); return;
                case VtVariant: WriteVariant(at, o); return;
            }
            throw new NotSupportedException("a SAFEARRAY of type " + vt);
        }

        /// A SAFEARRAY as a .NET array of its elements' type (one
        /// dimension; a SAFEARRAY of more is read as one of all its cells).
        public static object? FromSafeArray(nuint sa)
        {
            if (sa == 0) return null;
            int vt = SafeArrayVt(sa);
            int cells = SafeArrayCells(sa);
            int elem = (int)Sys.Read32(sa + 4);
            nuint data = SafeArrayData(sa);
            switch (vt)
            {
                case VtI4: case VtInt: case VtError: { int[] r = new int[cells]; for (int i = 0; i < cells; i++) r[i] = (int)Sys.Read32(data + (nuint)(i * elem)); return r; }
                case VtBstr: { string?[] r = new string?[cells]; for (int i = 0; i < cells; i++) r[i] = FromBstr(Sys.ReadAddress(data + (nuint)(i * elem))); return r; }
                case VtR8: { double[] r = new double[cells]; for (int i = 0; i < cells; i++) r[i] = ReadR8(data + (nuint)(i * elem)); return r; }
                case VtUi1: { byte[] r = new byte[cells]; for (int i = 0; i < cells; i++) r[i] = (byte)Sys.Read8(data + (nuint)(i * elem)); return r; }
                case VtI1: { sbyte[] r = new sbyte[cells]; for (int i = 0; i < cells; i++) r[i] = (sbyte)Sys.Read8(data + (nuint)(i * elem)); return r; }
                case VtI2: { short[] r = new short[cells]; for (int i = 0; i < cells; i++) r[i] = (short)Sys.Read16(data + (nuint)(i * elem)); return r; }
                case VtUi2: { ushort[] r = new ushort[cells]; for (int i = 0; i < cells; i++) r[i] = (ushort)Sys.Read16(data + (nuint)(i * elem)); return r; }
                case VtUi4: case VtUint: { uint[] r = new uint[cells]; for (int i = 0; i < cells; i++) r[i] = (uint)Sys.Read32(data + (nuint)(i * elem)); return r; }
                case VtI8: { long[] r = new long[cells]; for (int i = 0; i < cells; i++) r[i] = ReadI8(data + (nuint)(i * elem)); return r; }
                case VtUi8: { ulong[] r = new ulong[cells]; for (int i = 0; i < cells; i++) r[i] = (ulong)ReadI8(data + (nuint)(i * elem)); return r; }
                case VtR4: { float[] r = new float[cells]; for (int i = 0; i < cells; i++) r[i] = ReadR4(data + (nuint)(i * elem)); return r; }
                case VtBool: { bool[] r = new bool[cells]; for (int i = 0; i < cells; i++) r[i] = Sys.Read16(data + (nuint)(i * elem)) != 0; return r; }
                case VtDate: { DateTime[] r = new DateTime[cells]; for (int i = 0; i < cells; i++) r[i] = FromOADate(ReadR8(data + (nuint)(i * elem))); return r; }
                case VtUnknown: case VtDispatch: { object?[] r = new object?[cells]; for (int i = 0; i < cells; i++) r[i] = ObjectFor(Sys.ReadAddress(data + (nuint)(i * elem))); return r; }
                case VtVariant: { object?[] r = new object?[cells]; for (int i = 0; i < cells; i++) r[i] = ReadVariant(data + (nuint)(i * elem)); return r; }
            }
            throw new NotSupportedException("a SAFEARRAY of type " + vt);
        }

        public static object? ArgSafeArray(nuint sa) { return FromSafeArray(sa); }
        public static object? ReadSafeArray(nuint at) { return FromSafeArray(Sys.ReadAddress(at)); }

        public static object? TakeSafeArray(nuint at)
        {
            nuint sa = Sys.ReadAddress(at);
            Sys.WriteAddress(at, 0);
            object? a = FromSafeArray(sa);
            SafeArrayDestroy(sa);
            return a;
        }

        public static void WriteSafeArray(nuint at, object? a) { Sys.WriteAddress(at, (nuint)(SafeArrayFor(a))); }
        public static void ReplaceSafeArray(nuint at, object? a) { SafeArrayDestroy(Sys.ReadAddress(at)); WriteSafeArray(at, a); }

        // ---- HRESULTs ---------------------------------------------------------------------

        /// A failed HRESULT thrown as .NET throws it (Marshal.ThrowExceptionForHR).
        public static void Check(int hr)
        {
            if (hr < 0) throw ExceptionFor(hr);
        }

        public static Exception ExceptionFor(int hr)
        {
            Exception e;
            if (hr == ENoInterface) e = new InvalidCastException("No such interface supported (E_NOINTERFACE).");
            else if (hr == ENotImpl) e = new NotImplementedException("The method or operation is not implemented (E_NOTIMPL).");
            else if (hr == EOutOfMemory) e = new OutOfMemoryException();
            else if (hr == EInvalidArg) e = new ArgumentException("The parameter is incorrect (E_INVALIDARG).");
            else if (hr == EPointer) e = new NullReferenceException("Invalid pointer (E_POINTER).");
            else if (hr == EAccessDenied) e = new UnauthorizedAccessException("Access is denied (E_ACCESSDENIED).");
            else e = new COMException("Error HRESULT 0x" + ((uint)hr).ToString("X8") + " has been returned from a call to a COM component.", hr);
            e.HResult = hr;
            return e;
        }

        /// The HRESULT an exception becomes at COM's boundary.
        public static int HResultOf(Exception e)
        {
            if (e is COMException) return e.HResult;
            if (e.HResult < 0) return e.HResult;
            if (e is InvalidCastException) return ENoInterface;
            if (e is NotImplementedException) return ENotImpl;
            if (e is OutOfMemoryException) return EOutOfMemory;
            if (e is ArgumentException) return EInvalidArg;
            if (e is NullReferenceException) return EPointer;
            if (e is UnauthorizedAccessException) return EAccessDenied;
            return unchecked((int)0x80131500);                       // COR_E_EXCEPTION
        }

        // ---- late binding's conversions --------------------------------------------------

        /// A value made the type `t` as VariantChangeType would make it: a
        /// number of another width or from a string, a string of a number,
        /// a bool of a number; a value already of the type, or an object
        /// wanted, as it is.
        public static object? Coerce(object? value, Type t)
        {
            if (value == null || t == typeof(object)) return value;
            if (value is DBNull) return t == typeof(string) ? null : value;
            if (value.GetType() == t) return value;
            if (t == typeof(int)) return (int)Long(value);
            if (t == typeof(string)) return value is bool tf ? (tf ? "True" : "False") : value.ToString();
            if (t == typeof(bool)) return Bool(value);
            if (t == typeof(double)) return Double(value);
            if (t == typeof(long)) return Long(value);
            if (t == typeof(short)) return (short)Long(value);
            if (t == typeof(byte)) return (byte)Long(value);
            if (t == typeof(float)) return (float)Double(value);
            if (t == typeof(uint)) return (uint)Long(value);
            if (t == typeof(ulong)) return (ulong)Long(value);
            if (t == typeof(ushort)) return (ushort)Long(value);
            if (t == typeof(sbyte)) return (sbyte)Long(value);
            if (t == typeof(char)) return value is string one && one.Length > 0 ? one[0] : (char)Long(value);
            if (t == typeof(DateTime)) return value is double d ? FromOADate(d) : value;
            return value;
        }

        /// A value as a 64-bit integer: a number of any width (a fraction
        /// rounded), a bool -1 or 0 as VARIANT_BOOL is, a string parsed.
        public static long Long(object? v)
        {
            if (v == null) return 0;
            if (v is int i) return i;
            if (v is long l) return l;
            if (v is short sh) return sh;
            if (v is byte b) return b;
            if (v is sbyte sb) return sb;
            if (v is ushort us) return us;
            if (v is uint ui) return ui;
            if (v is ulong ul) return (long)ul;
            if (v is char c) return c;
            if (v is bool bo) return bo ? -1 : 0;
            if (v is double d) return (long)Math.Round(d);
            if (v is float f) return (long)Math.Round((double)f);
            if (v is string s) return long.Parse(s.Trim());
            if (v is DateTime dt) return (long)ToOADate(dt);
            if (v.GetType().IsEnum) return Convert.ToInt64(v);
            throw new InvalidCastException("Type mismatch (DISP_E_TYPEMISMATCH).");
        }

        public static double Double(object? v)
        {
            if (v is double d) return d;
            if (v is float f) return f;
            if (v is string s) return double.Parse(s.Trim());
            if (v is DateTime dt) return ToOADate(dt);
            return Long(v);
        }

        public static bool Bool(object? v)
        {
            if (v is bool b) return b;
            if (v is string s)
            {
                string t = s.Trim();
                if (string.Equals(t, "True", StringComparison.OrdinalIgnoreCase)) return true;
                if (string.Equals(t, "False", StringComparison.OrdinalIgnoreCase)) return false;
                return Double(t) != 0;
            }
            if (v is double d) return d != 0;
            if (v is float f) return f != 0;
            return Long(v) != 0;
        }
    }

    /// <summary>
    /// A MANAGED OBJECT COM CAN CALL (.NET's COM-callable wrapper). Its
    /// interface pointers are entries of one native block, two words each --
    /// the vtable, and the handle that finds the wrapper -- IUnknown's first,
    /// then IDispatch's when the object has one (IComCallable), then each
    /// interface the compiler gave it vtables for. One wrapper an object,
    /// one reference count for all its interfaces, as .NET keeps them; while
    /// the count is above 0 the handle keeps the object alive, and at 0 the
    /// block is let go and the object is the collector's again.
    /// </summary>
    public static class ComCallable
    {
        static readonly object _lock = new object();
        static readonly List<ComCallableWrapper?> _handles = new List<ComCallableWrapper?>();
        static readonly List<int> _free = new List<int>();
        static readonly Dictionary<long, ComCallableWrapper> _byObject = new Dictionary<long, ComCallableWrapper>();
        static nuint _unknownVtable, _dispatchVtable;
        static nuint _qi, _addRef, _release, _typeInfoCount, _typeInfo, _idsOfNames, _invoke;

        static void Thunks()
        {
            if (_qi != 0) return;
            lock (_lock)
            {
                if (_qi != 0) return;
                _addRef = (nuint)&AddRefEntry;
                _release = (nuint)&ReleaseEntry;
                _typeInfoCount = (nuint)&GetTypeInfoCountEntry;
                _typeInfo = (nuint)&GetTypeInfoEntry;
                _idsOfNames = (nuint)&GetIDsOfNamesEntry;
                _invoke = (nuint)&InvokeEntry;
                _qi = (nuint)&QueryInterfaceEntry;
            }
        }

        /// A vtable of `count` entries, IUnknown's three filled in (and
        /// IDispatch's four after them when `dispatch`), the rest the
        /// compiler's to set (SetSlot). Kept for good.
        public static nuint NewVtable(int count, bool dispatch)
        {
            Thunks();
            nuint v = MarshalHeap.Alloc((nuint)(Math.Max(count, 3) * WordSize.Bytes));
            for (int i = 0; i < count; i++) Sys.WriteAddress(v + (nuint)(i * WordSize.Bytes), 0);
            SetSlot(v, 0, _qi);
            SetSlot(v, 1, _addRef);
            SetSlot(v, 2, _release);
            if (dispatch && count >= 7)
            {
                SetSlot(v, 3, _typeInfoCount);
                SetSlot(v, 4, _typeInfo);
                SetSlot(v, 5, _idsOfNames);
                SetSlot(v, 6, _invoke);
            }
            return v;
        }

        public static void SetSlot(nuint vtable, int slot, nuint fn) { Sys.WriteAddress(vtable + (nuint)(slot * WordSize.Bytes), (nuint)fn); }

        internal static nuint UnknownVtable { get { if (_unknownVtable == 0) _unknownVtable = NewVtable(3, false); return _unknownVtable; } }
        internal static nuint DispatchVtable { get { if (_dispatchVtable == 0) _dispatchVtable = NewVtable(7, true); return _dispatchVtable; } }

        /// The wrapper of `o`, made when it has none.
        internal static ComCallableWrapper For(object o)
        {
            long key = Sys.Word(o);
            lock (_lock)
            {
                ComCallableWrapper? w;
                if (_byObject.TryGetValue(key, out w) && w != null) return w;
                IComCallable? callable = o as IComCallable;
                ComInterfaceEntry[] entries = callable != null ? callable.__ComInterfaces() : new ComInterfaceEntry[0];
                w = new ComCallableWrapper(o, entries, callable != null);
                int handle;
                if (_free.Count > 0) { handle = _free[_free.Count - 1]; _free.RemoveAt(_free.Count - 1); _handles[handle] = w; }
                else { handle = _handles.Count; _handles.Add(w); }
                w.Handle = handle;
                w.Build(UnknownVtable, DispatchVtable);
                _byObject[key] = w;
                return w;
            }
        }

        /// The managed object behind one of this process's interface pointers.
        public static object Target(nuint self)
        {
            ComCallableWrapper? w = WrapperOf(self);
            if (w == null) throw new InvalidComObjectException("not an interface of this process's COM-callable wrappers");
            return w.Target;
        }

        /// The same, or null when the pointer is not one of ours: its first
        /// entry is this process's QueryInterface.
        public static object? TargetOf(nuint p)
        {
            if (p == 0 || _qi == 0) return null;
            nuint vtable = Sys.ReadAddress(p);
            if (vtable == 0 || Sys.ReadAddress(vtable) != _qi) return null;
            ComCallableWrapper? w = WrapperOf(p);
            return w == null ? null : w.Target;
        }

        internal static ComCallableWrapper? WrapperOf(nuint self)
        {
            int handle = (int)Sys.ReadAddress(self + (nuint)(WordSize.Bytes));      // the wrapper's second word (Block, below)
            lock (_lock)
            {
                return handle >= 0 && handle < _handles.Count ? _handles[handle] : null;
            }
        }

        internal static int AddRef(ComCallableWrapper w)
        {
            lock (_lock) { return ++w.Refs; }
        }

        internal static int Release(ComCallableWrapper w)
        {
            nuint block = 0;
            int left;
            lock (_lock)
            {
                left = --w.Refs;
                if (left <= 0)
                {
                    left = 0;
                    _byObject.Remove(Sys.Word(w.Target));
                    _handles[w.Handle] = null;
                    _free.Add(w.Handle);
                    block = w.Block;
                    w.Block = 0;
                }
            }
            if (block != 0) MarshalHeap.Free(block);
            return left;
        }

        /// A wrapper made and never given out (a QueryInterface that found
        /// nothing): let go at once.
        internal static void Unused(ComCallableWrapper w)
        {
            bool unused;
            lock (_lock) { unused = w.Refs == 0 && w.Block != 0; }
            if (unused) { AddRef(w); Release(w); }
        }

        // ---- IUnknown -----------------------------------------------------------------------

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int QueryInterfaceEntry(nuint self, nuint riid, nuint ppv)
        {
            try
            {
                if (ppv == 0 || riid == 0) return ComMarshal.EPointer;
                Sys.WriteAddress((nuint)ppv, 0);
                ComCallableWrapper? w = WrapperOf(self);
                if (w == null) return ComMarshal.EUnexpected;
                nuint got = w.Query(ComMarshal.GuidText(riid));
                if (got == 0) return ComMarshal.ENoInterface;
                Sys.WriteAddress((nuint)ppv, (nuint)got);
                return 0;
            }
            catch (Exception e) { return ComMarshal.HResultOf(e); }
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int AddRefEntry(nuint self)
        {
            ComCallableWrapper? w = WrapperOf(self);
            return w == null ? 0 : AddRef(w);
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int ReleaseEntry(nuint self)
        {
            ComCallableWrapper? w = WrapperOf(self);
            return w == null ? 0 : Release(w);
        }

        // ---- IDispatch -----------------------------------------------------------------------

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int GetTypeInfoCountEntry(nuint self, nuint count)
        {
            if (count != 0) Sys.Write32((nuint)count, 0);
            return 0;
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int GetTypeInfoEntry(nuint self, nuint index, nuint lcid, nuint info)
        {
            if (info != 0) Sys.WriteAddress((nuint)info, 0);
            return unchecked((int)0x8002000B);                         // DISP_E_BADINDEX: no type information
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int GetIDsOfNamesEntry(nuint self, nuint riid, nuint names, nuint count, nuint lcid, nuint ids)
        {
            try
            {
                ComCallableWrapper? w = WrapperOf(self);
                IComCallable? c = w == null ? null : w.Target as IComCallable;
                int n = (int)count;
                int hr = 0;
                for (int i = 0; i < n; i++)
                {
                    int id = -1;
                    if (i == 0 && c != null)
                    {
                        string? name = ComMarshal.FromWide(Sys.ReadAddress(names + (nuint)(i * WordSize.Bytes)));
                        if (name != null) id = c.__ComDispId(name);
                    }
                    if (id == -1) hr = ComMarshal.DispEUnknownName;
                    Sys.Write32(ids + (nuint)(i * 4), (uint)id);
                }
                return hr;
            }
            catch (Exception e) { return ComMarshal.HResultOf(e); }
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
        static int InvokeEntry(nuint self, nuint dispid, nuint riid, nuint lcid, nuint flags, nuint parameters, nuint result, nuint exception, nuint argError)
        {
            ComCallableWrapper? w = WrapperOf(self);
            IComCallable? c = w == null ? null : w.Target as IComCallable;
            if (c == null) return ComMarshal.DispEMemberNotFound;
            return ComDispatch.Serve(c, (int)dispid, (int)(flags & 0xFFFF), parameters, result, exception, argError);
        }
    }

    /// <summary>One managed object's COM-callable wrapper (ComCallable).</summary>
    internal sealed class ComCallableWrapper
    {
        public readonly object Target;
        public readonly ComInterfaceEntry[] Entries;
        public readonly bool Dispatch;
        public int Refs;
        public int Handle;
        public nuint Block;

        public ComCallableWrapper(object target, ComInterfaceEntry[] entries, bool dispatch)
        {
            Target = target;
            Entries = entries;
            Dispatch = dispatch;
        }

        int Count { get { return 2 + Entries.Length; } }

        public void Build(nuint unknown, nuint dispatch)
        {
            int w = WordSize.Bytes;
            Block = MarshalHeap.Alloc((nuint)(Count * 2 * w));
            for (int k = 0; k < Count; k++)
            {
                nuint vtable = k == 0 ? unknown : k == 1 ? (Dispatch ? dispatch : 0) : Entries[k - 2].Vtable;
                Sys.WriteAddress(Block + (nuint)(k * 2 * w), vtable);
                Sys.WriteAddress(Block + (nuint)(k * 2 * w + w), (nuint)Handle);
            }
        }

        public nuint Pointer(int k) { return Block + (nuint)(k * 2 * WordSize.Bytes); }

        /// The interface for `iid`, AddRef'd; 0 when the object has none.
        public nuint Query(string iid)
        {
            string want = ComMarshal.Normal(iid);
            int found = -1;
            if (want == ComMarshal.IidIUnknown) found = 0;
            else if (want == ComMarshal.IidIDispatch && Dispatch) found = 1;
            else
            {
                for (int i = 0; i < Entries.Length; i++) if (Entries[i].Iid == want) { found = 2 + i; break; }
            }
            if (found < 0 || Block == 0)
            {
                ComCallable.Unused(this);
                return 0;
            }
            ComCallable.AddRef(this);
            return Pointer(found);
        }

        /// The entry an interface pointer of this wrapper is, or null for IUnknown's and IDispatch's.
        public ComInterfaceEntry? EntryOf(nuint p)
        {
            int k = (int)((p - Block) / (2 * WordSize.Bytes));
            return k >= 2 && k < Count ? Entries[k - 2] : null;
        }
    }

    /// <summary>
    /// IDISPATCH, both sides. Calling: a COM object's member by name or
    /// number, its arguments made VARIANTs (DISPPARAMS, last first), a
    /// property set by DISPID_PROPERTYPUT, the answer and [in, out]
    /// arguments made objects again, an exception's EXCEPINFO a
    /// COMException. Serving: a COM-callable object's IComCallable called
    /// from a DISPPARAMS, its answer and exceptions written back.
    /// </summary>
    public static class ComDispatch
    {
        public const int Method = 1, PropertyGet = 2, PropertyPut = 4, PropertyPutRef = 8;
        public const int DispidPropertyPut = -3;
        const int UserLocale = 0x400;

        /// The member `dispid` (int.MinValue: by `name`) of `target`, called
        /// as `flags` says (Method, PropertyGet, PropertyPut, PropertyPutRef)
        /// with `args`; the arguments whose bit is set in `byRef` passed by
        /// reference and written back.
        public static object? Invoke(object target, int dispid, string name, int flags, object?[] args, int byRef)
        {
            System.__ComObject? c = target as System.__ComObject;
            if (c == null)
            {
                IComCallable? managed = target as IComCallable;
                if (managed == null) throw new InvalidCastException("not a COM object, nor one COM can call");
                int id = dispid == int.MinValue ? managed.__ComDispId(name) : dispid;
                if (id == -1) throw ComMarshal.ExceptionFor(ComMarshal.DispEUnknownName);
                object? result;
                ComMarshal.Check(managed.__ComInvoke(id, flags, args, out result));
                return result;
            }
            if (c.IsRemote)
            {
                int id = dispid;
                if (id == int.MinValue) ComMarshal.Check(c._remote!.GetDispId(name, out id));
                object? result;
                ComMarshal.Check(c._remote!.Invoke(id, flags, args, byRef, out result));
                return result;
            }
            nuint d = c.__Interface(ComMarshal.IidIDispatch);
            return Native(d, dispid == int.MinValue ? GetDispId(d, name) : dispid, flags, args, byRef);
        }

        public static object? Invoke(object target, string name, int flags, object?[] args)
        {
            return Invoke(target, int.MinValue, name, flags, args, 0);
        }

        static nuint Entry(nuint self, int slot) { return Sys.ReadAddress(Sys.ReadAddress(self) + (nuint)(slot * WordSize.Bytes)); }

        /// GetIDsOfNames for one name.
        public static int GetDispId(nuint dispatch, string name)
        {
            nuint text = ComMarshal.AllocWide(name);
            nuint block = MarshalHeap.Alloc(16 + 2 * WordSize.Bytes);
            try
            {
                for (int i = 0; i < 16; i++) Sys.Write8(block + (nuint)i, 0);              // IID_NULL
                nuint names = block + 16;
                nuint id = names + WordSize.Bytes;
                Sys.WriteAddress(names, (nuint)text);
                Sys.Write32((nuint)id, 0xFFFFFFFF);
                // GetIDsOfNames(REFIID, LPOLESTR*, UINT cNames, LCID, DISPID*).
                int hr = ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, uint, uint, nuint, int>)Entry(dispatch, 5))(dispatch, block, names, 1, UserLocale, id);
                ComMarshal.Check(hr);
                return (int)Sys.Read32((nuint)id);
            }
            finally
            {
                MarshalHeap.Free(block);
                MarshalHeap.Free(text);
            }
        }

        /// IDispatch::Invoke on a native pointer.
        public static object? Native(nuint dispatch, int dispid, int flags, object?[] args, int byRef)
        {
            int w = WordSize.Bytes, vb = ComMarshal.VariantBytes, n = args.Length;
            bool put = (flags & (PropertyPut | PropertyPutRef)) != 0;
            nuint variants = MarshalHeap.Alloc((nuint)(Math.Max(1, n) * vb));
            nuint held = MarshalHeap.Alloc((nuint)(Math.Max(1, n) * vb));
            int blockBytes = 4 * w + 20 + vb + 72;
            nuint block = MarshalHeap.Alloc((nuint)blockBytes);
            try
            {
                for (int i = 0; i < n; i++)
                {
                    nuint at = variants + (nuint)((n - 1 - i) * vb);
                    nuint keep = held + (nuint)(i * vb);
                    ComMarshal.VariantInit(keep);
                    if ((byRef & (1 << i)) != 0 && i < 31)
                    {
                        ComMarshal.WriteVariant(keep, args[i]);
                        ComMarshal.VariantInit(at);
                        Sys.Write16(at, ComMarshal.VtByRef | ComMarshal.VtVariant);
                        Sys.WriteAddress(at + (nuint)ComMarshal.VariantData, (nuint)keep);
                    }
                    else ComMarshal.WriteVariant(at, args[i]);
                }
                nuint parameters = block;
                nuint named = block + (nuint)(4 * w);
                nuint iid = named + 4;
                nuint result = iid + 16;
                nuint excep = result + (nuint)vb;
                nuint argErr = excep + 64;
                for (int i = 0; i < blockBytes; i++) Sys.Write8(block + (nuint)i, 0);
                Sys.Write32((nuint)named, unchecked((uint)DispidPropertyPut));
                Sys.WriteAddress(parameters, (nuint)(n == 0 ? 0 : variants));
                Sys.WriteAddress(parameters + (nuint)w, (nuint)(put ? named : 0));
                Sys.Write32(parameters + (nuint)(2 * w), (uint)n);
                Sys.Write32(parameters + (nuint)(2 * w + 4), (uint)(put ? 1 : 0));
                // Invoke(DISPID, REFIID, LCID, WORD wFlags -- a whole word on
                // the stack -- DISPPARAMS*, VARIANT*, EXCEPINFO*, UINT*).
                int hr = ((delegate* unmanaged[Stdcall]<nuint, int, nuint, uint, uint, nuint, nuint, nuint, nuint, int>)Entry(dispatch, 6))(
                    dispatch, dispid, iid, UserLocale, (uint)flags, parameters, put ? 0 : result, excep, argErr);
                if (hr == ComMarshal.DispEException)
                {
                    int scode = (int)Sys.Read32(excep + (nuint)((w == 8 ? 56 : 28)));
                    string? text = ComMarshal.FromBstr(Sys.ReadAddress(excep + (nuint)((w == 8 ? 16 : 8))));
                    FreeExcepInfo(excep);
                    COMException e = new COMException(text ?? "Exception occurred.", scode != 0 ? scode : hr);
                    throw e;
                }
                ComMarshal.Check(hr);
                for (int i = 0; i < n && i < 31; i++)
                    if ((byRef & (1 << i)) != 0) args[i] = ComMarshal.ReadVariant(held + (nuint)(i * vb));
                return put ? null : ComMarshal.TakeVariant(result);
            }
            finally
            {
                for (int i = 0; i < n; i++)
                {
                    ComMarshal.VariantClear(held + (nuint)(i * vb));
                    nuint at = variants + (nuint)((n - 1 - i) * vb);
                    if ((Sys.Read16(at) & ComMarshal.VtByRef) == 0) ComMarshal.VariantClear(at);
                }
                MarshalHeap.Free(variants);
                MarshalHeap.Free(held);
                MarshalHeap.Free(block);
            }
        }

        static void FreeExcepInfo(nuint at)
        {
            int w = WordSize.Bytes;
            for (int k = 0; k < 3; k++)
            {
                nuint field = at + (nuint)(w == 8 ? 8 + k * 8 : 4 + k * 4);
                ComMarshal.FreeBstr(Sys.ReadAddress((nuint)field));
                Sys.WriteAddress((nuint)field, 0);
            }
        }

        /// IDispatch::Invoke served for a COM-callable object: the
        /// DISPPARAMS made objects (positional ones first to last; the value
        /// of a property set last), the call, by-reference arguments and the
        /// answer written back, an exception made an EXCEPINFO.
        public static int Serve(IComCallable target, int dispid, int flags, nuint parameters, nuint result, nuint exception, nuint argError)
        {
            int w = WordSize.Bytes, vb = ComMarshal.VariantBytes;
            try
            {
                nuint variants = parameters == 0 ? 0 : Sys.ReadAddress(parameters);
                nuint names = parameters == 0 ? 0 : Sys.ReadAddress(parameters + (nuint)w);
                int count = parameters == 0 ? 0 : (int)Sys.Read32(parameters + (nuint)(2 * w));
                int named = parameters == 0 ? 0 : (int)Sys.Read32(parameters + (nuint)(2 * w + 4));
                for (int i = 0; i < named; i++)
                    if ((int)Sys.Read32(names + (nuint)(i * 4)) != DispidPropertyPut) return ComMarshal.DispEParamNotFound;
                int positional = count - named;
                object?[] args = new object?[count];
                for (int i = 0; i < positional; i++) args[i] = ComMarshal.ReadVariant(variants + (nuint)((count - 1 - i) * vb));
                if (named == 1) args[positional] = ComMarshal.ReadVariant(variants);
                object? answer;
                int hr = target.__ComInvoke(dispid, flags, args, out answer);
                if (hr < 0) return hr;
                for (int i = 0; i < positional; i++)
                {
                    nuint at = variants + (nuint)((count - 1 - i) * vb);
                    if ((Sys.Read16(at) & ComMarshal.VtByRef) != 0) WriteByRef(at, args[i]);
                }
                if (result != 0)
                {
                    ComMarshal.VariantInit(result);
                    ComMarshal.WriteVariant(result, answer);
                }
                return 0;
            }
            catch (Exception e)
            {
                if (exception != 0)
                {
                    int bytes = w == 8 ? 64 : 32;
                    for (int i = 0; i < bytes; i++) Sys.Write8(exception + (nuint)i, 0);
                    Sys.WriteAddress(exception + (nuint)((w == 8 ? 8 : 4)), (nuint)(ComMarshal.AllocBstr(e.GetType().Name)));
                    Sys.WriteAddress(exception + (nuint)((w == 8 ? 16 : 8)), (nuint)(ComMarshal.AllocBstr(e.Message)));
                    Sys.Write32(exception + (nuint)((w == 8 ? 56 : 28)), (uint)(ComMarshal.HResultOf(e)));
                    return ComMarshal.DispEException;
                }
                return ComMarshal.HResultOf(e);
            }
        }

        /// A by-reference VARIANT argument's target given a new value.
        public static void WriteByRef(nuint variant, object? value)
        {
            int vt = (int)Sys.Read16(variant) & ~ComMarshal.VtByRef;
            nuint at = Sys.ReadAddress(variant + (nuint)ComMarshal.VariantData);
            if (at == 0) return;
            if (vt == ComMarshal.VtVariant) { ComMarshal.ReplaceVariant(at, value); return; }
            if (vt == ComMarshal.VtBstr) { ComMarshal.ReplaceBstr(at, value == null ? null : value.ToString()); return; }
            if (vt == ComMarshal.VtUnknown) { ComMarshal.ReplaceUnknown(at, value); return; }
            if (vt == ComMarshal.VtDispatch) { ComMarshal.ReplaceDispatch(at, value); return; }
            if ((vt & ComMarshal.VtArray) != 0) { ComMarshal.ReplaceSafeArray(at, value); return; }
            ComMarshal.WriteValue(vt, at, value);
        }
    }

    /// <summary>A native COM function called with the interface pointer and its argument words (ComFrame).</summary>
    public static unsafe class ComRuntime
    {
    /// A int-answering native function at `fn`, called with stdcall's rule on i386 (C's elsewhere): `self`, then `n` argument words.
    public static int CallInt(nuint fn, nuint self, nuint[] w, int n)
    {
        switch (n)
        {
            case 0: return ((delegate* unmanaged[Stdcall]<nuint, int>)fn)(self);
            case 1: return ((delegate* unmanaged[Stdcall]<nuint, nuint, int>)fn)(self, w[0]);
            case 2: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, int>)fn)(self, w[0], w[1]);
            case 3: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2]);
            case 4: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3]);
            case 5: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4]);
            case 6: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5]);
            case 7: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6]);
            case 8: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
            case 9: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8]);
            case 10: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]);
            case 11: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10]);
            case 12: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
            case 13: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12]);
            case 14: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12], w[13]);
            case 15: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12], w[13], w[14]);
            case 16: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, int>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12], w[13], w[14], w[15]);
        }
        throw new NotSupportedException("a COM call of more than 16 argument words");
    }

    /// A long-answering native function at `fn`, called with stdcall's rule on i386 (C's elsewhere): `self`, then `n` argument words.
    public static long CallLong(nuint fn, nuint self, nuint[] w, int n)
    {
        switch (n)
        {
            case 0: return ((delegate* unmanaged[Stdcall]<nuint, long>)fn)(self);
            case 1: return ((delegate* unmanaged[Stdcall]<nuint, nuint, long>)fn)(self, w[0]);
            case 2: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, long>)fn)(self, w[0], w[1]);
            case 3: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2]);
            case 4: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3]);
            case 5: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4]);
            case 6: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5]);
            case 7: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6]);
            case 8: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
            case 9: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8]);
            case 10: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]);
            case 11: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10]);
            case 12: return ((delegate* unmanaged[Stdcall]<nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, nuint, long>)fn)(self, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
