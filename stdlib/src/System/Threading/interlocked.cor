// System.Threading.Interlocked: atomic operations on variables shared between
// threads, with .NET's names and answers.
//
// A `ref` parameter is the address of the caller's variable (Sys.AddressOf
// hands it back), and the processor's own atomics work on that address: XADD
// for Add, Increment and Decrement, XCHG for Exchange, CMPXCHG for
// CompareExchange. Every one is a full barrier, as .NET documents.
//
// SIXTY-FOUR BITS ON A 32-BIT PROCESSOR. The 486 has no CMPXCHG8B (it came
// with the Pentium), so the long forms are done under one lock shared by all
// of them: atomic with respect to each other, which is what .NET promises of
// Interlocked on a 32-bit platform -- a plain store to the same long is not
// atomic there either. Read(ref long) takes the same lock, which is the whole
// reason .NET has it.
//
// A REFERENCE STORED BEHIND THE COLLECTOR'S BACK is an object it may free
// while the collection marks with the other threads running. The reference
// forms go through the write barrier first (Runtime.WriteBarrier), exactly as
// the compiler's own stores do, so both the value replaced and the value put
// there are seen.

namespace System.Threading;

public static class Interlocked
{
    static AtomicCell _wide = new AtomicCell();

    // ---- 32 bits ---------------------------------------------------------------

    public static int Increment(ref int location) { return (int)Sys.AtomicAdd(Sys.AddressOf(ref location), 1) + 1; }
    public static int Decrement(ref int location) { return (int)Sys.AtomicAdd(Sys.AddressOf(ref location), -1) - 1; }

    /// Adds, and answers the new value.
    public static int Add(ref int location, int value) { return (int)Sys.AtomicAdd(Sys.AddressOf(ref location), value) + value; }

    /// Stores, and answers what was there.
    public static int Exchange(ref int location, int value) { return (int)Sys.AtomicSwap(Sys.AddressOf(ref location), value); }

    /// Stores `value` if `comparand` is there, and answers what was there
    /// either way: the store happened exactly when the answer is `comparand`.
    public static int CompareExchange(ref int location, int value, int comparand)
    {
        return (int)Sys.Cas(Sys.AddressOf(ref location), comparand, value);
    }

    // ---- 64 bits, under the one lock -----------------------------------------------

    public static long Increment(ref long location) { return Add(ref location, 1); }
    public static long Decrement(ref long location) { return Add(ref location, -1); }

    public static long Add(ref long location, long value)
    {
        _wide.Enter();
        try { location = location + value; return location; }
        finally { _wide.Exit(); }
    }

    public static long Exchange(ref long location, long value)
    {
        _wide.Enter();
        try { long was = location; location = value; return was; }
        finally { _wide.Exit(); }
    }

    public static long CompareExchange(ref long location, long value, long comparand)
    {
        _wide.Enter();
        try
        {
            long was = location;
            if (was == comparand) location = value;
            return was;
        }
        finally { _wide.Exit(); }
    }

    /// A 64-bit read that no concurrent Interlocked write is half way through.
    public static long Read(ref long location)
    {
        _wide.Enter();
        try { return location; }
        finally { _wide.Exit(); }
    }

    // ---- references ------------------------------------------------------------------

    public static object? Exchange(ref object? location, object? value)
    {
        return Exchange<object?>(ref location, value);
    }

    public static object? CompareExchange(ref object? location, object? value, object? comparand)
    {
        return CompareExchange<object?>(ref location, value, comparand);
    }

    public static T Exchange<T>(ref T location, T value) where T : class?
    {
        long at = Sys.AddressOf(ref location);
        long word = Sys.Word(value);
        if (Runtime.Marking != 0) Runtime.WriteBarrier((nint)at, (nint)word);
        // Before the store as well as after it, as the compiler places its
        // own in an image whose threads can be stopped at any instruction
        // (Lowering.CardMarkBefore): a stop between the swap and the mark
        // after it leaves no card for a minor cycle to read.
        Runtime.CardMark((nint)at);
        T old = (T)Sys.FromWord(Sys.AtomicSwap(at, word));
        // After the store, as the compiler places its own card mark: a
        // reference an old object is given is found by the next minor
        // collection through its card (Gc, generations).
        Runtime.CardMark((nint)at);
        return old;
    }

    public static T CompareExchange<T>(ref T location, T value, T comparand) where T : class?
    {
        long at = Sys.AddressOf(ref location);
        long word = Sys.Word(value);
        if (Runtime.Marking != 0) Runtime.WriteBarrier((nint)at, (nint)word);
        Runtime.CardMark((nint)at);
        T seen = (T)Sys.FromWord(Sys.Cas(at, Sys.Word(comparand), word));
        Runtime.CardMark((nint)at);
        return seen;
    }

    // ---- ordering ----------------------------------------------------------------------

    /// Every load and store before this is done before any after it.
    public static void MemoryBarrier() { Sys.Fence(); }
}

/// System.Threading.Volatile: a read no later read is moved before, a write no
/// earlier write is moved after, as .NET has them. Made of Interlocked's
/// operations, each a full barrier -- stronger than asked, and never a read
/// the optimiser keeps from the last time round a loop.
public static class Volatile
{
    public static int Read(ref int location) { return Interlocked.CompareExchange(ref location, 0, 0); }
    public static long Read(ref long location) { return Interlocked.Read(ref location); }
    public static bool Read(ref bool location) { Sys.Fence(); bool seen = location; Sys.Fence(); return seen; }
    public static T Read<T>(ref T location) where T : class? { return Interlocked.CompareExchange<T>(ref location, null!, null!); }

    public static void Write(ref int location, int value) { Interlocked.Exchange(ref location, value); }
    public static void Write(ref long location, long value) { Interlocked.Exchange(ref location, value); }
    public static void Write(ref bool location, bool value) { Sys.Fence(); location = value; Sys.Fence(); }
    public static void Write<T>(ref T location, T value) where T : class? { Interlocked.Exchange<T>(ref location, value); }
}
