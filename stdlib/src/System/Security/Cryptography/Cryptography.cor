// System.Security.Cryptography.RandomNumberGenerator: the operating
// system's randomness, as .NET hands it out. On Linux that is getrandom(2)
// blocking until the pool is seeded, which is exactly what a program
// making keys wants and never what it should have to think about.
static class RandomNumberGenerator
{
    public static void Fill(byte[] data)
    {
        Fill(data, 0, data.Length);
    }

    public static void Fill(byte[] data, int offset, int count)
    {
        int done = 0;
        while (done < count)
        {
            long n = Os.GetRandom(data, offset + done, count - done);
            if (n == -Err.Intr)
            {
                continue;
            }
            if (n <= 0)
            {
                throw new IOException("the system has no randomness to give");
            }
            done = done + (int)n;
        }
    }

    public static byte[] GetBytes(int count)
    {
        byte[] b = new byte[count];
        Fill(b);
        return b;
    }

    public static int GetInt32(int fromInclusive, int toExclusive)
    {
        if (toExclusive <= fromInclusive)
        {
            throw new ArgumentOutOfRangeException("toExclusive");
        }
        long range = (long)toExclusive - fromInclusive;
        byte[] b = new byte[4];
        // Rejection sampling keeps the result uniform.
        long mask = 1;
        while (mask < range)
        {
            mask = mask << 1;
        }
        mask = mask - 1;
        while (true)
        {
            Fill(b);
            long v = ((long)(b[0] & 255) << 24 | (long)(b[1] & 255) << 16 | (long)(b[2] & 255) << 8 | (long)(b[3] & 255)) & mask;
            if (v < range)
            {
                return (int)(fromInclusive + v);
            }
        }
    }

    public static int GetInt32(int toExclusive)
    {
        return GetInt32(0, toExclusive);
    }
}
