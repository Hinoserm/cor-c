// System.Collections.Generic -- the containers std.cor does not carry.
//
// std.cor has List, Dictionary, HashSet, Queue and a small SortedSet, which
// are the ones its own compiler needed. These are the rest of the ones a
// program written for .NET reaches for: a stack, a doubly linked list, and the
// two ordered maps.
//
// SortedList<K,V> and SortedDictionary<K,V> differ in .NET by their storage --
// parallel arrays against a red-black tree -- and so in which operation is
// cheap, not in what they answer. Both are parallel arrays here; the cost is
// that an insert into the middle of a large SortedDictionary shifts rather
// than rotates, and every answer, ordering and exception is .NET's.

using System.Collections.ObjectModel;

// ---- Stack ----------------------------------------------------------------
//
// LAST IN, FIRST OUT, on a growable array whose top is its end -- so Push and
// Pop are both a store and an increment, and nothing ever shifts.
//
// Enumeration is TOP TO BOTTOM, which is .NET's order and the opposite of the
// storage order; a caller who writes `foreach` over a stack expects to see
// what Pop would hand back, in that sequence.

class Stack<T> : IReadOnlyCollection<T>, IEnumerable<T> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private T[] items;
    private int count;
    // WHAT CHANGED IT LAST, counted: every Push and Pop and every Clear (of
    // an empty stack too) move it on, and an enumerator that finds it moved
    // throws, as .NET's does.
    private int version;

    public Stack() {
        items = new T[8];
        count = 0;
    }

    /// STARTED FROM A SEQUENCE, which .NET pushes in the order it walks: the
    /// last one walked is the first one popped.
    public Stack(IEnumerable<T> collection) : this() {
        if (collection == null) { throw new ArgumentNullException("collection"); }
        foreach (T each in collection) { Push(each); }
    }

    /// Room for this many before the first growth. Nothing about what it
    /// holds, which is why .NET's is a hint and not a count.
    public Stack(int capacity) {
        ArgumentOutOfRangeException.ThrowIfNegative(capacity, "capacity");
        items = new T[capacity < 1 ? 1 : capacity];
        count = 0;
    }

    public int Count => count;

    public void Push(T value) {
        if (count == items.Length) { Grow(); }
        items[count] = value;
        count = count + 1;
        version = version + 1;
    }

    public T Pop() {
        if (count == 0) { throw new InvalidOperationException("Stack empty."); }
        version = version + 1;
        count = count - 1;
        T value = items[count];
        items[count] = default(T)!;
        return value;
    }

    public T Peek() {
        if (count == 0) { throw new InvalidOperationException("Stack empty."); }
        return items[count - 1];
    }

    /// .NET's non-throwing pair, added in Core 2.0: false and default(T) when
    /// the stack is empty, instead of the exception.
    public bool TryPop(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = Pop();
        return true;
    }

    public bool TryPeek(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = items[count - 1];
        return true;
    }

    public bool Contains(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (int i = 0; i < count; i++) {
            if (same.Equals(items[i], value)) { return true; }
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i < count; i++) { items[i] = default(T)!; }
        count = 0;
        version = version + 1;
    }

    /// The element `depth` places below the top. Not a .NET member.
    public T ElementFromTop(int depth) { return items[count - 1 - depth]; }

    /// TOP FIRST, like the enumeration, which is what .NET's ToArray gives.
    public T[] ToArray() {
        T[] copy = new T[count];
        for (int i = 0; i < count; i++) { copy[i] = items[count - 1 - i]; }
        return copy;
    }

    // .NET's refusals: a place past the array, its value named, then too little room.
    public void CopyTo(T[] target, int index) {
        if (target == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || index > target.Length) { throw new ArgumentOutOfRangeException("arrayIndex", index, "Index was out of range. Must be non-negative and less than or equal to the size of the collection."); }
        if (target.Length - index < count) { throw new ArgumentException("Offset and length were out of bounds for the array or count is greater than the number of elements from index to the end of the source collection."); }
        for (int i = 0; i < count; i++) { target[index + i] = items[count - 1 - i]; }
    }

    /// .NET's own: a struct, so a foreach over one allocates nothing and does
    /// not hand the collection to an object on the heap (which the lifetime
    /// rules take for its escape). As .NET's: Current is the element the last
    /// MoveNext took -- default before the first and after the last, never an
    /// exception, and still the last one taken once disposed -- and a stack
    /// changed since the walk began is an InvalidOperationException at the
    /// next MoveNext or Reset. `at` is where the last one was taken: the count
    /// before the first, -1 once finished, as .NET's index is.
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly Stack<T> over;
        private readonly int version;
        private int at;
        private T current;
        internal Enumerator(Stack<T> walked) { over = walked; version = walked.version; at = walked.count; current = default(T)!; }
        public T Current => current;
        object? IEnumerator.Current => current;
        public bool MoveNext() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            int next = at - 1;
            if (next >= 0) {
                current = over.items[next];
                at = next;
                return true;
            }
            current = default(T)!;
            at = -1;
            return false;
        }
        public void Reset() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            at = over.count;
            current = default(T)!;
        }
        public void Dispose() { at = -1; }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }

    // Through the interface, as .NET's explicit implementation: the struct, boxed.
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { return GetEnumerator(); }

    // THE ARRAY IS THE STACK'S ALONE -- ToArray and CopyTo copy out of it,
    // the enumerators read through the stack -- so at its region's top it
    // grows where it is (Runtime.GrowInPlace), and elsewhere the one it
    // outgrew is given back after the store that replaces it, as Queue's is
    // (OutgrownStorage, the self-replacing free). Left to the collector,
    // every array a stack outgrew stayed until a collection.
    private void Grow() {
        int size = items.Length * 2;
        if (Runtime.GrowInPlace((nint)Sys.Word(items), size)) { return; }
        T[] bigger = new T[size];
        for (int i = 0; i < count; i++) { bigger[i] = items[i]; }
        T[] outgrown = items;
        items = bigger;
        if (!lent) { OutgrownStorage.Release(outgrown); }
    }

    // ITS ARRAY SHARED WITH A MEMBERWISE COPY (object.MemberwiseClone): the
    // other holds it too, and a growth leaves it to the collector.
    private bool lent;
    internal void LendStorage() { lent = true; }
}

// ---- LinkedList -----------------------------------------------------------
//
// A node holds its own links and the list it belongs to, which is what makes
// LinkedList's contract enforceable: AddAfter and Remove take a NODE, and .NET
// throws InvalidOperationException when that node came from another list.
// Without the back-pointer the operation would quietly corrupt both lists.

class LinkedListNode<T> {
    internal LinkedList<T>? owner;
    internal LinkedListNode<T>? next;
    internal LinkedListNode<T>? prev;

    public T Value;

    public LinkedListNode(T value) {
        Value = value;
        owner = null;
        next = null;
        prev = null;
    }

    public LinkedList<T>? List => owner;

    /// NULL AT THE ENDS. .NET's list is circular inside and its Next hides the
    /// wrap by returning null at the last node; the links here are plain, so
    /// the property is the field.
    public LinkedListNode<T>? Next => next;
    public LinkedListNode<T>? Previous => prev;
}

class LinkedList<T> : ICollection<T>, IReadOnlyCollection<T>, IEnumerable<T> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    bool ICollection<T>.IsReadOnly => false;

    void ICollection<T>.Add(T item) { AddLast(item); }

    private LinkedListNode<T>? head;
    private LinkedListNode<T>? tail;
    private int count;
    // WHAT CHANGED IT LAST, counted: every node put in or taken out and every
    // Clear move it on, as .NET's; a node's Value written does not.
    private int version;

    public LinkedList() {
        head = null;
        tail = null;
        count = 0;
    }

    /// Each of `collection` added last, in its order, as .NET's.
    public LinkedList(IEnumerable<T> collection) : this() {
        if (collection == null) { throw new ArgumentNullException("collection"); }
        foreach (T item in collection) { AddLast(item); }
    }

    public int Count => count;
    public LinkedListNode<T>? First => head;
    public LinkedListNode<T>? Last => tail;

    public LinkedListNode<T> AddFirst(T value) {
        LinkedListNode<T> node = new LinkedListNode<T>(value);
        AddFirst(node);
        return node;
    }

    public void AddFirst(LinkedListNode<T> node) {
        Adopt(node);
        node.prev = null;
        node.next = head;
        if (head != null) { head.prev = node; } else { tail = node; }
        head = node;
        count = count + 1;
        version = version + 1;
    }

    public LinkedListNode<T> AddLast(T value) {
        LinkedListNode<T> node = new LinkedListNode<T>(value);
        AddLast(node);
        return node;
    }

    public void AddLast(LinkedListNode<T> node) {
        Adopt(node);
        node.next = null;
        node.prev = tail;
        if (tail != null) { tail.next = node; } else { head = node; }
        tail = node;
        count = count + 1;
        version = version + 1;
    }

    public LinkedListNode<T> AddAfter(LinkedListNode<T> node, T value) {
        LinkedListNode<T> fresh = new LinkedListNode<T>(value);
        AddAfter(node, fresh);
        return fresh;
    }

    public void AddAfter(LinkedListNode<T> node, LinkedListNode<T> fresh) {
        Mine(node);
        Adopt(fresh);
        fresh.prev = node;
        fresh.next = node.next;
        if (node.next != null) { node.next!.prev = fresh; } else { tail = fresh; }
        node.next = fresh;
        count = count + 1;
        version = version + 1;
    }

    public LinkedListNode<T> AddBefore(LinkedListNode<T> node, T value) {
        LinkedListNode<T> fresh = new LinkedListNode<T>(value);
        AddBefore(node, fresh);
        return fresh;
    }

    public void AddBefore(LinkedListNode<T> node, LinkedListNode<T> fresh) {
        Mine(node);
        Adopt(fresh);
        fresh.next = node;
        fresh.prev = node.prev;
        if (node.prev != null) { node.prev!.next = fresh; } else { head = fresh; }
        node.prev = fresh;
        count = count + 1;
        version = version + 1;
    }

    public LinkedListNode<T>? Find(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (LinkedListNode<T>? walk = head; walk != null; walk = walk!.Next) {
            if (same.Equals(walk.Value, value)) { return walk; }
        }
        return null;
    }

    public LinkedListNode<T>? FindLast(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (LinkedListNode<T>? walk = tail; walk != null; walk = walk!.Previous) {
            if (same.Equals(walk.Value, value)) { return walk; }
        }
        return null;
    }

    public bool Contains(T value) { return Find(value) != null; }

    public void Remove(LinkedListNode<T> node) {
        Mine(node);
        if (node.prev != null) { node.prev!.next = node.next; } else { head = node.next; }
        if (node.next != null) { node.next!.prev = node.prev; } else { tail = node.prev; }
        node.owner = null;
        node.next = null;
        node.prev = null;
        count = count - 1;
        version = version + 1;
    }

    /// True when a node holding that value was there, which is .NET's contract:
    /// the FIRST such node goes, not all of them.
    public bool Remove(T value) {
        LinkedListNode<T>? found = Find(value);
        if (found == null) { return false; }
        Remove(found);
        return true;
    }

    public void RemoveFirst() {
        if (head == null) { throw new InvalidOperationException("The LinkedList is empty."); }
        Remove(head!);
    }

    public void RemoveLast() {
        if (tail == null) { throw new InvalidOperationException("The LinkedList is empty."); }
        Remove(tail!);
    }

    public void Clear() {
        LinkedListNode<T>? walk = head;
        while (walk != null) {
            LinkedListNode<T>? after = walk.next;
            walk.owner = null;
            walk.next = null;
            walk.prev = null;
            walk = after;
        }
        head = null;
        tail = null;
        count = 0;
        version = version + 1;
    }

    public void CopyTo(T[] target, int index) {
        if (target == null) { throw new ArgumentNullException("array"); }
        ArgumentOutOfRangeException.ThrowIfNegative(index, "index");
        if (index > target.Length) { throw new ArgumentOutOfRangeException("index", index, "Must be less than or equal to the size of the collection."); }
        if (target.Length - index < Count) { throw new ArgumentException("Insufficient space in the target location to copy the information."); }
        int i = index;
        for (LinkedListNode<T>? walk = head; walk != null; walk = walk!.Next) {
            target[i] = walk.Value;
            i = i + 1;
        }
    }

    /// .NET's LinkedList<T>.Enumerator: a struct, from the head the list had
    /// when it was made. Current is the value the last MoveNext took, and
    /// stays the last one after the end, as .NET's does; a list changed since
    /// the walk began is an InvalidOperationException at the next MoveNext or
    /// Reset.
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly LinkedList<T> over;
        private readonly int version;
        private LinkedListNode<T>? node;
        private int at;
        private T current;
        internal Enumerator(LinkedList<T> list) { over = list; version = list.version; node = list.head; at = 0; current = default(T)!; }
        public T Current => current;
        object? IEnumerator.Current {
            get {
                if (at == 0 || at == over.count + 1) { ThrowHelper.EnumerationNotRunning(); }
                return current;
            }
        }
        public bool MoveNext() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            LinkedListNode<T>? here = node;
            if (here == null) {
                at = over.count + 1;
                return false;
            }
            at = at + 1;
            current = here.Value;
            node = here.next;
            return true;
        }
        public void Reset() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            current = default(T)!;
            node = over.head;
            at = 0;
        }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { return GetEnumerator(); }

    // A node already in a list cannot be added to another, and a node from
    // another list cannot be used as a position in this one. .NET's wording
    // for both is InvalidOperationException.
    private void Adopt(LinkedListNode<T> node) {
        if (node == null) { throw new ArgumentNullException("node"); }
        if (node.owner != null) {
            throw new InvalidOperationException("The LinkedList node already belongs to a LinkedList.");
        }
        node.owner = this;
    }

    private void Mine(LinkedListNode<T> node) {
        if (node == null) { throw new ArgumentNullException("node"); }
        if (node.owner != this) {
            throw new InvalidOperationException("The LinkedList node does not belong to current LinkedList.");
        }
    }
}

// ---- the ordered maps -----------------------------------------------------
//
// Both keep their keys sorted, so a lookup is a binary search and enumeration
// is in key order. The shared engine is SortedPairs: the two public classes
// differ only in which members .NET gives them.

class SortedPairs<K, V> {
    internal List<K> keys;
    internal List<V> values;
    internal IComparer<K> order;
    // WHAT CHANGED THE MAP LAST, counted, as .NET's SortedList and
    // SortedDictionary count it: an insert, a removal, a value replaced and a
    // clearing (of an empty map too) move it on, and so do SortedDictionary's
    // changes that change nothing (Touch). An enumerator of the map, of its
    // keys or of its values that finds it moved throws.
    internal int version;
    // SEARCHED AS Array.BinarySearch SEARCHES, SortedList's keys are: what
    // the comparer throws comes out held in the InvalidOperationException a
    // sort's failure is (Sorting.Search). SortedDictionary's tree asks its
    // comparer bare, and its failures come out as they were thrown.
    private readonly bool searchedAsArray;

    public SortedPairs(IComparer<K> comparer, bool searchedAsArray) {
        keys = new List<K>();
        values = new List<V>();
        order = comparer;
        this.searchedAsArray = searchedAsArray;
    }

    /// The index of the key, or the ones' complement of where it would go --
    /// Array.BinarySearch's convention, and the reason IndexOfKey can return
    /// the insertion point without a second search.
    public int Search(K key) {
        // NO NULL KEY, as neither of .NET's takes one, asked or added.
        if (key == null) { ThrowHelper.KeyNull(); }
        if (!searchedAsArray) { return Bisect(key); }
        try { return Bisect(key); }
        catch (Exception e) { throw new InvalidOperationException("Failed to compare two elements in the array.", e); }
    }

    private int Bisect(K key) {
        int low = 0;
        int high = keys.Count - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = order.Compare(keys[middle], key);

            if (sign == 0) { return middle; }
            if (sign < 0) { low = middle + 1; } else { high = middle - 1; }
        }
        return ~low;
    }

    public void Insert(int at, K key, V value) {
        keys.Insert(at, key);
        values.Insert(at, value);
        version = version + 1;
    }

    public void RemoveAt(int at) {
        keys.RemoveAt(at);
        values.RemoveAt(at);
        version = version + 1;
    }

    /// A value replaced where it is: a change, as both of .NET's count it.
    public void SetValue(int at, V value) {
        values[at] = value;
        version = version + 1;
    }

    public void Clear() {
        keys.Clear();
        values.Clear();
        version = version + 1;
    }

    /// The room both lists have.
    public int Capacity {
        get => keys.Capacity;
        set { keys.Capacity = value; values.Capacity = value; }
    }

    /// Keys already in order, each once, and their values: the whole map.
    public void Fill(K[] sortedKeys, V[] theirValues) {
        keys = new List<K>(sortedKeys);
        values = new List<V>(theirValues);
    }

    /// A change that changes nothing, as SortedDictionary's tree counts one:
    /// a key added that was there, or a removal asked of a map that holds
    /// anything. Its insertion and its removal turn the tree over on the way
    /// down before they know.
    public void Touch() { version = version + 1; }
}

/// .NET's SortedList<K, V>.Enumerator, handed out as an IEnumerator as .NET
/// hands out its own: the pair the last MoveNext took, default before the
/// first and after the last, and a list changed since the walk began an
/// InvalidOperationException at the next MoveNext or Reset. Through the
/// non-generic interface, before the first or after the last, there is
/// nothing to box; Dispose sets it back to before the first, as .NET's.
class SortedPairsEnumerator<K, V> : IEnumerator<KeyValuePair<K, V>> {
    private readonly SortedPairs<K, V> over;
    private readonly int version;
    private int at;
    private K key;
    private V value;

    public SortedPairsEnumerator(SortedPairs<K, V> pairs) {
        over = pairs;
        version = pairs.version;
        at = 0;
        key = default(K)!;
        value = default(V)!;
    }

    public KeyValuePair<K, V> Current => new KeyValuePair<K, V>(key, value);

    object? IEnumerator.Current {
        get {
            if (at == 0 || at == over.keys.Count + 1) { ThrowHelper.EnumerationNotRunning(); }
            return new KeyValuePair<K, V>(key, value);
        }
    }

    public bool MoveNext() {
        if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
        if ((uint)at < (uint)over.keys.Count) {
            key = over.keys[at];
            value = over.values[at];
            at = at + 1;
            return true;
        }
        at = over.keys.Count + 1;
        key = default(K)!;
        value = default(V)!;
        return false;
    }

    public void Reset() {
        if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
        at = 0;
        key = default(K)!;
        value = default(V)!;
    }

    public void Dispose() {
        at = 0;
        key = default(K)!;
        value = default(V)!;
    }
}

/// .NET's array-backed ordered map: a lookup is a binary search, and the
/// position of a key is part of the API -- IndexOfKey, GetKeyAtIndex,
/// RemoveAt. That is the whole difference from SortedDictionary.
class SortedList<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

    ICollection<K> IDictionary<K, V>.Keys => Keys;
    ICollection<V> IDictionary<K, V>.Values => Values;
    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { Add(item.Key, item.Value); }

    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) {
        return TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value);
    }

    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex", arrayIndex, "Index was out of range. Must be non-negative and less than or equal to the size of the collection."); }
        if (array.Length - arrayIndex < Count) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        for (int i = 0; i < pairs.keys.Count; i++) {
            array[arrayIndex + i] = new KeyValuePair<K, V>(pairs.keys[i], pairs.values[i]);
        }
    }

    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) {
        if (TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value)) { return Remove(item.Key); }
        return false;
    }
    private SortedPairs<K, V> pairs;

    public SortedList() { pairs = new SortedPairs<K, V>(Comparer<K>.Default, true); }
    /// Keys ordered by `comparer`, or by their own order given null, as .NET's.
    public SortedList(IComparer<K>? comparer) { pairs = new SortedPairs<K, V>(comparer ?? Comparer<K>.Default, true); }

    /// Room for `capacity` before the first growth.
    public SortedList(int capacity) {
        ArgumentOutOfRangeException.ThrowIfNegative(capacity, "capacity");
        pairs = new SortedPairs<K, V>(Comparer<K>.Default, true);
        pairs.Capacity = capacity;
    }

    /// As .NET's, the room set through Capacity, whose refusal a negative
    /// one meets ("capacity was less than the current size").
    public SortedList(int capacity, IComparer<K>? comparer) : this(comparer) { Capacity = capacity; }

    public SortedList(IDictionary<K, V> dictionary) : this(dictionary, null) { }

    /// A dictionary's pairs, sorted together by key as .NET sorts them
    /// (Array.Sort of the keys and their values), then refused if two keys
    /// are one under `comparer`: the later of them named.
    public SortedList(IDictionary<K, V> dictionary, IComparer<K>? comparer) : this(dictionary != null ? dictionary.Count : 0, comparer) {
        if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
        int count = dictionary.Count;
        if (count == 0) { return; }
        K[] keys = new K[count];
        V[] values = new V[count];
        dictionary.Keys.CopyTo(keys, 0);
        dictionary.Values.CopyTo(values, 0);
        if (count > 1) {
            IComparer<K> order = pairs.order;
            Array.Sort<K, V>(keys, values, order);
            for (int i = 1; i != keys.Length; i++) {
                if (order.Compare(keys[i - 1], keys[i]) == 0) { throw new ArgumentException("An item with the same key has already been added. Key: " + keys[i]); }
            }
        }
        pairs.Fill(keys, values);
    }

    public int Count => pairs.keys.Count;
    public IComparer<K> Comparer => pairs.order;

    /// The room its keys and values have, as .NET's arrays: never below the
    /// count, and set without a change a walk would see.
    public int Capacity {
        get => pairs.Capacity;
        set {
            if (value < pairs.keys.Count) { throw new ArgumentOutOfRangeException("value", value, "capacity was less than the current size."); }
            pairs.Capacity = value;
        }
    }

    /// Its room cut to its count where that is under 90% of it, as .NET's.
    public void TrimExcess() {
        int threshold = (int)((double)pairs.Capacity * 0.9);
        if (pairs.keys.Count < threshold) { Capacity = pairs.keys.Count; }
    }

    /// The keys in order, and the values in the order of their keys: views
    /// of the list, as .NET's KeyList and ValueList, never written through,
    /// whose walks are refused once the list has changed.
    public IList<K> Keys => keyView ??= new KeyList(pairs);
    public IList<V> Values => valueView ??= new ValueList(pairs);
    private KeyList? keyView;
    private ValueList? valueView;

    // .NET'S REFUSAL OF A PLACE, its value with it: GetKeyAtIndex, the views'
    // indexers, RemoveAt and the rest.
    private static void Place(int index, int count) {
        if ((uint)index >= (uint)count) { throw new ArgumentOutOfRangeException("index", index, "Index was out of range. Must be non-negative and less than the size of the collection."); }
    }

    private const string NestedWrite = "This operation is not supported on SortedList nested types because they require modifying the original SortedList.";

    /// .NET's KeyList: the list's keys in order, a list (not a read-only one)
    /// never written through. A key set at a place is refused in the key
    /// collection's words, anything else in the nested types'.
    private sealed class KeyList : IList<K> {
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        private readonly SortedPairs<K, V> over;

        internal KeyList(SortedPairs<K, V> pairs) { over = pairs; }

        public int Count => over.keys.Count;
        public bool IsReadOnly => true;
        public K this[int index] {
            get { Place(index, over.keys.Count); return over.keys[index]; }
            set { throw new NotSupportedException("Mutating a key collection derived from a dictionary is not allowed."); }
        }
        public bool Contains(K item) { return over.Search(item) >= 0; }
        public int IndexOf(K item) {
            int at = over.Search(item);
            return at >= 0 ? at : -1;
        }
        // Array.Copy's, as .NET copies its keys.
        public void CopyTo(K[] array, int arrayIndex) { over.keys.CopyTo(array, arrayIndex); }
        public IEnumerator<K> GetEnumerator() { return new SortedListKeyEnumerator(over); }

        public void Add(K item) { throw new NotSupportedException(NestedWrite); }
        public void Clear() { throw new NotSupportedException(NestedWrite); }
        public bool Remove(K item) { throw new NotSupportedException(NestedWrite); }
        public void Insert(int index, K item) { throw new NotSupportedException(NestedWrite); }
        public void RemoveAt(int index) { throw new NotSupportedException(NestedWrite); }
    }

    /// .NET's ValueList: as KeyList, the values in the order of their keys.
    private sealed class ValueList : IList<V> {
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        private readonly SortedPairs<K, V> over;

        internal ValueList(SortedPairs<K, V> pairs) { over = pairs; }

        public int Count => over.values.Count;
        public bool IsReadOnly => true;
        public V this[int index] {
            get { Place(index, over.values.Count); return over.values[index]; }
            set { throw new NotSupportedException(NestedWrite); }
        }
        public bool Contains(V item) { return IndexOf(item) >= 0; }
        public int IndexOf(V item) {
            IEqualityComparer<V> same = EqualityComparer<V>.Default;
            for (int i = 0; i < over.values.Count; i++) {
                if (same.Equals(over.values[i], item)) { return i; }
            }
            return -1;
        }
        public void CopyTo(V[] array, int arrayIndex) { over.values.CopyTo(array, arrayIndex); }
        public IEnumerator<V> GetEnumerator() { return new SortedListValueEnumerator(over); }

        public void Add(V item) { throw new NotSupportedException(NestedWrite); }
        public void Clear() { throw new NotSupportedException(NestedWrite); }
        public bool Remove(V item) { throw new NotSupportedException(NestedWrite); }
        public void Insert(int index, V item) { throw new NotSupportedException(NestedWrite); }
        public void RemoveAt(int index) { throw new NotSupportedException(NestedWrite); }
    }

    /// .NET's walk of the keys: on nothing until the first MoveNext and after
    /// the last, refused once the list has changed, set back by Dispose.
    private sealed class SortedListKeyEnumerator : IEnumerator<K> {
        private readonly SortedPairs<K, V> over;
        private readonly int version;
        private int at;
        private K current;

        internal SortedListKeyEnumerator(SortedPairs<K, V> pairs) { over = pairs; version = pairs.version; at = 0; current = default(K)!; }

        public K Current => current;
        object? IEnumerator.Current {
            get {
                if (at == 0 || at == over.keys.Count + 1) { ThrowHelper.EnumerationNotRunning(); }
                return current;
            }
        }
        public bool MoveNext() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            if ((uint)at < (uint)over.keys.Count) {
                current = over.keys[at];
                at = at + 1;
                return true;
            }
            at = over.keys.Count + 1;
            current = default(K)!;
            return false;
        }
        public void Reset() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            at = 0;
            current = default(K)!;
        }
        public void Dispose() {
            at = 0;
            current = default(K)!;
        }
    }

    /// As SortedListKeyEnumerator, the values.
    private sealed class SortedListValueEnumerator : IEnumerator<V> {
        private readonly SortedPairs<K, V> over;
        private readonly int version;
        private int at;
        private V current;

        internal SortedListValueEnumerator(SortedPairs<K, V> pairs) { over = pairs; version = pairs.version; at = 0; current = default(V)!; }

        public V Current => current;
        object? IEnumerator.Current {
            get {
                if (at == 0 || at == over.values.Count + 1) { ThrowHelper.EnumerationNotRunning(); }
                return current;
            }
        }
        public bool MoveNext() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            if ((uint)at < (uint)over.values.Count) {
                current = over.values[at];
                at = at + 1;
                return true;
            }
            at = over.values.Count + 1;
            current = default(V)!;
            return false;
        }
        public void Reset() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            at = 0;
            current = default(V)!;
        }
        public void Dispose() {
            at = 0;
            current = default(V)!;
        }
    }

    /// A DUPLICATE KEY THROWS, which is Add's contract and the difference from
    /// the indexer's setter -- that one replaces.
    public void Add(K key, V value) {
        int at = pairs.Search(key);
        if (at >= 0) { throw new ArgumentException("An item with the same key has already been added. Key: " + key, "key"); }
        pairs.Insert(~at, key, value);
    }

    public V this[K key] {
        get {
            int at = pairs.Search(key);
            if (at < 0) { throw new KeyNotFoundException("The given key '" + key + "' was not present in the dictionary."); }
            return pairs.values[at];
        }
        set {
            int at = pairs.Search(key);
            if (at >= 0) { pairs.SetValue(at, value); } else { pairs.Insert(~at, key, value); }
        }
    }

    public bool ContainsKey(K key) { return pairs.Search(key) >= 0; }

    public bool ContainsValue(V value) { return IndexOfValue(value) >= 0; }

    public bool TryGetValue(K key, out V value) {
        int at = pairs.Search(key);
        if (at < 0) { value = default(V); return false; }
        value = pairs.values[at];
        return true;
    }

    /// NEGATIVE WHEN ABSENT, and .NET promises only "negative" rather than the
    /// complement, so a caller reads it as a not-found flag.
    public int IndexOfKey(K key) {
        int at = pairs.Search(key);
        if (at < 0) { return -1; }
        return at;
    }

    public int IndexOfValue(V value) {
        IEqualityComparer<V> same = EqualityComparer<V>.Default;
        for (int i = 0; i < pairs.values.Count; i++) {
            if (same.Equals(pairs.values[i], value)) { return i; }
        }
        return -1;
    }

    public K GetKeyAtIndex(int index) { Place(index, pairs.keys.Count); return pairs.keys[index]; }
    public V GetValueAtIndex(int index) { Place(index, pairs.keys.Count); return pairs.values[index]; }
    public void SetValueAtIndex(int index, V value) { Place(index, pairs.keys.Count); pairs.SetValue(index, value); }

    public bool Remove(K key) {
        int at = pairs.Search(key);
        if (at < 0) { return false; }
        pairs.RemoveAt(at);
        return true;
    }

    public void RemoveAt(int index) {
        Place(index, pairs.keys.Count);
        pairs.RemoveAt(index);
    }

    public void Clear() { pairs.Clear(); }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return new SortedPairsEnumerator<K, V>(pairs); }
}

/// The ordered map without the positions: a Dictionary whose enumeration is in
/// key order. In .NET it is a tree and inserting is logarithmic; here it is the
/// same store as SortedList, so the ANSWERS match and the insert cost does not.
class SortedDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }


    ICollection<K> IDictionary<K, V>.Keys => Keys;
    ICollection<V> IDictionary<K, V>.Values => Values;
    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { Add(item.Key, item.Value); }

    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) {
        return TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value);
    }

    /// Its pairs in key order, as .NET's (public, as its tree's CopyTo is).
    public void CopyTo(KeyValuePair<K, V>[] array, int index) {
        CopyRoom(array, index, pairs.keys.Count);
        for (int i = 0; i < pairs.keys.Count; i++) { array[index + i] = new KeyValuePair<K, V>(pairs.keys[i], pairs.values[i]); }
    }

    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) {
        if (TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value)) { return Remove(item.Key); }
        return false;
    }
    private SortedPairs<K, V> pairs;

    public SortedDictionary() { pairs = new SortedPairs<K, V>(Comparer<K>.Default, false); }
    /// Keys ordered by `comparer`, or by their own order given null, as .NET's.
    public SortedDictionary(IComparer<K>? comparer) { pairs = new SortedPairs<K, V>(comparer ?? Comparer<K>.Default, false); }

    public SortedDictionary(IDictionary<K, V> dictionary) : this(dictionary, null) { }

    /// A dictionary's pairs added in its order, as .NET's tree adds them: a
    /// key one with an earlier under `comparer` refused, the pair named.
    public SortedDictionary(IDictionary<K, V> dictionary, IComparer<K>? comparer) : this(comparer) {
        if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
        foreach (KeyValuePair<K, V> pair in dictionary) {
            int at = pairs.Search(pair.Key);
            if (at >= 0) { throw new ArgumentException("An item with the same key has already been added. Key: " + pair); }
            pairs.Insert(~at, pair.Key, pair.Value);
        }
    }

    public int Count => pairs.keys.Count;
    public IComparer<K> Comparer => pairs.order;
    /// Its keys and its values, as .NET's KeyCollection and ValueCollection:
    /// views of the map in key order, never written through, whose walks are
    /// refused once the map has changed. Collections, not lists: no index,
    /// and `is IList<K>` false, as .NET's.
    public KeyCollection Keys => keyView ??= new KeyCollection(this);
    public ValueCollection Values => valueView ??= new ValueCollection(this);
    private KeyCollection? keyView;
    private ValueCollection? valueView;

    /// Where a view's CopyTo may write `count` elements, as .NET checks it.
    private static void CopyRoom<E>(E[] array, int index, int count) {
        if (array == null) { throw new ArgumentNullException("array"); }
        ArgumentOutOfRangeException.ThrowIfNegative(index, "index");
        if (index > array.Length || array.Length - index < count) {
            throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length.");
        }
    }

    public sealed class KeyCollection : ICollection<K>, IReadOnlyCollection<K> {
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
        IEnumerator<K> IEnumerable<K>.GetEnumerator() { return GetEnumerator(); }

        private readonly SortedPairs<K, V> over;

        public KeyCollection(SortedDictionary<K, V> dictionary) {
            if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
            over = dictionary.pairs;
        }

        public int Count => over.keys.Count;
        public bool Contains(K item) { return over.Search(item) >= 0; }
        public void CopyTo(K[] array, int index) {
            CopyRoom(array, index, over.keys.Count);
            for (int i = 0; i < over.keys.Count; i++) { array[index + i] = over.keys[i]; }
        }
        public Enumerator GetEnumerator() { return new Enumerator(over); }

        bool ICollection<K>.IsReadOnly => true;
        void ICollection<K>.Add(K item) { throw Refused(); }
        void ICollection<K>.Clear() { throw Refused(); }
        bool ICollection<K>.Remove(K item) { throw Refused(); }
        private static NotSupportedException Refused() { return new NotSupportedException("Mutating a key collection derived from a dictionary is not allowed."); }

        /// As the map's Enumerator, the key alone.
        public struct Enumerator : IEnumerator<K>, IDisposable {
            private readonly SortedPairs<K, V> over;
            private readonly int version;
            private int at;
            private bool taken;
            private K current;
            internal Enumerator(SortedPairs<K, V> pairs) { over = pairs; version = pairs.version; at = 0; taken = false; current = default(K)!; }
            public K Current => current;
            object? IEnumerator.Current {
                get {
                    if (!taken) { ThrowHelper.EnumerationNotRunning(); }
                    return current;
                }
            }
            public bool MoveNext() {
                if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
                if (at < over.keys.Count) {
                    current = over.keys[at];
                    at = at + 1;
                    taken = true;
                    return true;
                }
                taken = false;
                current = default(K)!;
                return false;
            }
            public void Reset() {
                if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
                at = 0;
                taken = false;
                current = default(K)!;
            }
            public void Dispose() { }
        }
    }

    /// As KeyCollection, the values in the order of their keys; Contains
    /// only through the interface, as .NET's.
    public sealed class ValueCollection : ICollection<V>, IReadOnlyCollection<V> {
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
        IEnumerator<V> IEnumerable<V>.GetEnumerator() { return GetEnumerator(); }

        private readonly SortedPairs<K, V> over;

        public ValueCollection(SortedDictionary<K, V> dictionary) {
            if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
            over = dictionary.pairs;
        }

        public int Count => over.values.Count;
        public void CopyTo(V[] array, int index) {
            CopyRoom(array, index, over.values.Count);
            for (int i = 0; i < over.values.Count; i++) { array[index + i] = over.values[i]; }
        }
        public Enumerator GetEnumerator() { return new Enumerator(over); }

        bool ICollection<V>.IsReadOnly => true;
        bool ICollection<V>.Contains(V item) {
            IEqualityComparer<V> same = EqualityComparer<V>.Default;
            for (int i = 0; i < over.values.Count; i++) {
                if (same.Equals(over.values[i], item)) { return true; }
            }
            return false;
        }
        void ICollection<V>.Add(V item) { throw Refused(); }
        void ICollection<V>.Clear() { throw Refused(); }
        bool ICollection<V>.Remove(V item) { throw Refused(); }
        private static NotSupportedException Refused() { return new NotSupportedException("Mutating a value collection derived from a dictionary is not allowed."); }

        /// As the map's Enumerator, the value alone.
        public struct Enumerator : IEnumerator<V>, IDisposable {
            private readonly SortedPairs<K, V> over;
            private readonly int version;
            private int at;
            private bool taken;
            private V current;
            internal Enumerator(SortedPairs<K, V> pairs) { over = pairs; version = pairs.version; at = 0; taken = false; current = default(V)!; }
            public V Current => current;
            object? IEnumerator.Current {
                get {
                    if (!taken) { ThrowHelper.EnumerationNotRunning(); }
                    return current;
                }
            }
            public bool MoveNext() {
                if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
                if (at < over.values.Count) {
                    current = over.values[at];
                    at = at + 1;
                    taken = true;
                    return true;
                }
                taken = false;
                current = default(V)!;
                return false;
            }
            public void Reset() {
                if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
                at = 0;
                taken = false;
                current = default(V)!;
            }
            public void Dispose() { }
        }
    }
    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

    /// A DUPLICATE KEY THROWS, and is a change all the same, as .NET's tree
    /// counts it: its insertion turns the tree over on the way down before
    /// it finds the key there.
    public void Add(K key, V value) {
        int at = pairs.Search(key);
        if (at >= 0) {
            pairs.Touch();
            // The pair named, as .NET's tree names the item it refused.
            throw new ArgumentException("An item with the same key has already been added. Key: " + new KeyValuePair<K, V>(key, value));
        }
        pairs.Insert(~at, key, value);
    }

    public V this[K key] {
        get {
            int at = pairs.Search(key);
            if (at < 0) { throw new KeyNotFoundException("The given key '" + key + "' was not present in the dictionary."); }
            return pairs.values[at];
        }
        set {
            int at = pairs.Search(key);
            if (at >= 0) { pairs.SetValue(at, value); } else { pairs.Insert(~at, key, value); }
        }
    }

    public bool ContainsKey(K key) { return pairs.Search(key) >= 0; }

    public bool ContainsValue(V value) {
        IEqualityComparer<V> same = EqualityComparer<V>.Default;
        for (int i = 0; i < pairs.values.Count; i++) {
            if (same.Equals(pairs.values[i], value)) { return true; }
        }
        return false;
    }

    public bool TryGetValue(K key, out V value) {
        int at = pairs.Search(key);
        if (at < 0) { value = default(V); return false; }
        value = pairs.values[at];
        return true;
    }

    /// A removal asked of a map that holds anything is a change, found or
    /// not, as .NET's tree counts it.
    public bool Remove(K key) {
        int at = pairs.Search(key);
        if (at < 0) {
            if (pairs.keys.Count > 0) { pairs.Touch(); }
            return false;
        }
        pairs.RemoveAt(at);
        return true;
    }

    public void Clear() { pairs.Clear(); }

    /// .NET's SortedDictionary<K, V>.Enumerator: a struct, the pair the last
    /// MoveNext took, default before the first and after the last, and a map
    /// changed since the walk began an InvalidOperationException at the next
    /// MoveNext or Reset.
    public struct Enumerator : IEnumerator<KeyValuePair<K, V>>, IDisposable {
        private readonly SortedPairs<K, V> over;
        private readonly int version;
        private int at;
        private bool taken;
        private KeyValuePair<K, V> current;
        internal Enumerator(SortedPairs<K, V> pairs) { over = pairs; version = pairs.version; at = 0; taken = false; current = default; }
        public KeyValuePair<K, V> Current => current;
        object? IEnumerator.Current {
            get {
                if (!taken) { ThrowHelper.EnumerationNotRunning(); }
                return current;
            }
        }
        public bool MoveNext() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            if (at < over.keys.Count) {
                current = new KeyValuePair<K, V>(over.keys[at], over.values[at]);
                at = at + 1;
                taken = true;
                return true;
            }
            taken = false;
            current = default;
            return false;
        }
        public void Reset() {
            if (version != over.version) { ThrowHelper.CollectionModifiedAfterEnumerator(); }
            at = 0;
            taken = false;
            current = default;
        }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { return new Enumerator(pairs); }
    IEnumerator<KeyValuePair<K, V>> IEnumerable<KeyValuePair<K, V>>.GetEnumerator() { return GetEnumerator(); }
}

// ---- PriorityQueue --------------------------------------------------------
//
// A HEAP WITH FOUR CHILDREN TO A NODE, which is .NET's: the smallest priority
// is always at the root, so Peek is free and Enqueue and Dequeue cost a walk
// of the tree's depth. The element and its priority are kept SEPARATE -- a
// work item and the time it is due, a node and its distance -- rather than
// making the element comparable.
//
// TIES COME OUT IN .NET'S ORDER. .NET documents no order for equal
// priorities, but a program's output depends on the one it has, so the heap
// is .NET's own, member for member: four children, a node sifted up past
// only a strictly greater parent and down past only a strictly smaller
// child, the last node moved to the root on a Dequeue and into the hole on a
// Remove, a whole range heapified from the bottom when the queue was empty,
// and the storage grown by .NET's rule -- so two queues fed the same calls
// hand back the same sequence here and there, and UnorderedItems walks the
// same array order.

class PriorityQueue<TElement, TPriority> {
    private const int Arity = 4;

    private TElement[] elements;
    private TPriority[] priorities;
    private int size;
    private int version;
    private IComparer<TPriority> order;
    private UnorderedItemsCollection? unordered;

    public PriorityQueue() : this(0, null) { }

    /// Room for `initialCapacity` before the first growth.
    public PriorityQueue(int initialCapacity) : this(initialCapacity, null) { }

    /// Priorities ordered by `comparer`, or by their own order given null.
    public PriorityQueue(IComparer<TPriority>? comparer) : this(0, comparer) { }

    public PriorityQueue(int initialCapacity, IComparer<TPriority>? comparer) {
        ArgumentOutOfRangeException.ThrowIfNegative(initialCapacity, "initialCapacity");
        elements = new TElement[initialCapacity];
        priorities = new TPriority[initialCapacity];
        order = comparer ?? Comparer<TPriority>.Default;
    }

    /// Every pair of `items`, heapified at once, as .NET builds it.
    public PriorityQueue(IEnumerable<(TElement Element, TPriority Priority)> items) : this(items, null) { }

    public PriorityQueue(IEnumerable<(TElement Element, TPriority Priority)> items, IComparer<TPriority>? comparer) : this(0, comparer) {
        ArgumentNullException.ThrowIfNull(items, "items");
        foreach ((TElement Element, TPriority Priority) item in items) {
            if (size == elements.Length) { Grow(size + 1); }
            elements[size] = item.Element;
            priorities[size] = item.Priority;
            size = size + 1;
        }
        if (size > 1) { Heapify(); }
    }

    public int Count => size;

    /// How many the storage holds before it next grows (.NET 9).
    public int Capacity => elements.Length;

    public IComparer<TPriority> Comparer => order;

    /// Every element and its priority in the heap's own order, which is no
    /// order of priority: .NET's UnorderedItems, a live view.
    public UnorderedItemsCollection UnorderedItems => unordered ??= new UnorderedItemsCollection(this);

    public void Enqueue(TElement element, TPriority priority) {
        int at = size;
        version = version + 1;
        if (elements.Length == at) { Grow(at + 1); }
        size = at + 1;
        Up(element, priority, at);
    }

    public TElement Peek() {
        if (size == 0) { throw new InvalidOperationException("Queue empty."); }
        return elements[0];
    }

    public TElement Dequeue() {
        if (size == 0) { throw new InvalidOperationException("Queue empty."); }
        TElement top = elements[0];
        RemoveRoot();
        return top;
    }

    public bool TryPeek(out TElement element, out TPriority priority) {
        if (size == 0) {
            element = default(TElement)!;
            priority = default(TPriority)!;
            return false;
        }
        element = elements[0];
        priority = priorities[0];
        return true;
    }

    public bool TryDequeue(out TElement element, out TPriority priority) {
        if (size == 0) {
            element = default(TElement)!;
            priority = default(TPriority)!;
            return false;
        }
        element = elements[0];
        priority = priorities[0];
        RemoveRoot();
        return true;
    }

    /// ENQUEUE AND DEQUEUE IN ONE, and cheaper than the two: when the new item
    /// is no greater than the smallest it never enters the heap at all.
    public TElement EnqueueDequeue(TElement element, TPriority priority) {
        if (size != 0 && order.Compare(priority, priorities[0]) > 0) {
            TElement top = elements[0];
            Down(element, priority, 0);
            version = version + 1;
            return top;
        }
        return element;
    }

    /// DEQUEUE AND ENQUEUE IN ONE: the smallest handed back and the new one
    /// put in its place, which an empty queue cannot do.
    public TElement DequeueEnqueue(TElement element, TPriority priority) {
        if (size == 0) { throw new InvalidOperationException("Queue empty."); }
        TElement top = elements[0];
        if (order.Compare(priority, priorities[0]) > 0) {
            Down(element, priority, 0);
        } else {
            elements[0] = element;
            priorities[0] = priority;
        }
        version = version + 1;
        return top;
    }

    /// EVERY PAIR OF `items`. Into an empty queue they go in at once and the
    /// heap is built from the bottom, as .NET builds it; into a queue that
    /// holds something each is enqueued in turn.
    public void EnqueueRange(IEnumerable<(TElement Element, TPriority Priority)> items) {
        ArgumentNullException.ThrowIfNull(items, "items");
        int n = 0;
        ICollection<(TElement Element, TPriority Priority)>? collection = items as ICollection<(TElement Element, TPriority Priority)>;
        if (collection != null && (n = collection.Count) > elements.Length - size) { Grow(checked(size + n)); }
        if (size == 0) {
            int i = 0;
            foreach ((TElement Element, TPriority Priority) item in items) {
                if (elements.Length == i) { Grow(i + 1); }
                elements[i] = item.Element;
                priorities[i] = item.Priority;
                i = i + 1;
            }
            size = i;
            version = version + 1;
            if (size > 1) { Heapify(); }
        } else {
            foreach ((TElement Element, TPriority Priority) item in items) { Enqueue(item.Element, item.Priority); }
        }
    }

    /// EVERY ONE OF `elements` AT ONE PRIORITY, by the same two roads.
    public void EnqueueRange(IEnumerable<TElement> elements, TPriority priority) {
        ArgumentNullException.ThrowIfNull(elements, "elements");
        int n;
        if (elements is ICollection<TElement> collection && (n = collection.Count) > this.elements.Length - size) { Grow(checked(size + n)); }
        if (size == 0) {
            int i = 0;
            foreach (TElement element in elements) {
                if (this.elements.Length == i) { Grow(i + 1); }
                this.elements[i] = element;
                priorities[i] = priority;
                i = i + 1;
            }
            size = i;
            version = version + 1;
            if (i > 1) { Heapify(); }
        } else {
            foreach (TElement element in elements) { Enqueue(element, priority); }
        }
    }

    /// .NET 9's Remove: the first element, in the heap's order, equal to
    /// `element` by `equalityComparer` (or the default), taken out with its
    /// priority. The last node fills its place and is sifted down from
    /// there, as .NET does it.
    public bool Remove(TElement element, out TElement removedElement, out TPriority priority, IEqualityComparer<TElement>? equalityComparer = null) {
        IEqualityComparer<TElement> same = equalityComparer ?? EqualityComparer<TElement>.Default;
        int index = -1;
        for (int i = 0; i < size; i++) {
            if (same.Equals(element, elements[i])) {
                index = i;
                break;
            }
        }
        if (index < 0) {
            removedElement = default(TElement)!;
            priority = default(TPriority)!;
            return false;
        }
        removedElement = elements[index];
        priority = priorities[index];
        size = size - 1;
        int last = size;
        if (index < last) { Down(elements[last], priorities[last], index); }
        elements[last] = default(TElement)!;
        priorities[last] = default(TPriority)!;
        version = version + 1;
        return true;
    }

    public void Clear() {
        for (int i = 0; i < size; i++) {
            elements[i] = default(TElement)!;
            priorities[i] = default(TPriority)!;
        }
        size = 0;
        version = version + 1;
    }

    /// Room for at least `capacity`, the storage grown by .NET's rule when it
    /// has less; what it holds after.
    public int EnsureCapacity(int capacity) {
        ArgumentOutOfRangeException.ThrowIfNegative(capacity, "capacity");
        if (elements.Length < capacity) {
            Grow(capacity);
            version = version + 1;
        }
        return elements.Length;
    }

    /// The storage cut to what is held, when that is less than nine tenths
    /// of it, as .NET's.
    public void TrimExcess() {
        int threshold = (int)(elements.Length * 0.9);
        if (size < threshold) {
            Resize(size);
            version = version + 1;
        }
    }

    // .NET's growth: twice the size, at least four more, at least what is
    // asked for.
    private void Grow(int least) {
        int grown = 2 * elements.Length;
        if ((uint)grown > (uint)0x7FFFFFC7) { grown = 0x7FFFFFC7; }
        if (grown < elements.Length + 4) { grown = elements.Length + 4; }
        if (grown < least) { grown = least; }
        Resize(grown);
    }

    // THE ARRAYS ARE THE QUEUE'S ALONE, read only through it, so the two it
    // outgrew or trimmed go back after the stores that replace them, as
    // Queue's and Stack's do (OutgrownStorage, the self-replacing free).
    private void Resize(int length) {
        TElement[] moreElements = new TElement[length];
        TPriority[] morePriorities = new TPriority[length];
        for (int i = 0; i < size; i++) {
            moreElements[i] = elements[i];
            morePriorities[i] = priorities[i];
        }
        TElement[] oldElements = elements;
        TPriority[] oldPriorities = priorities;
        elements = moreElements;
        priorities = morePriorities;
        OutgrownStorage.Release(oldElements);
        OutgrownStorage.Release(oldPriorities);
    }

    // The last node taken off the end and sifted down from the root.
    private void RemoveRoot() {
        int last = size - 1;
        size = last;
        version = version + 1;
        if (last > 0) { Down(elements[last], priorities[last], 0); }
        elements[last] = default(TElement)!;
        priorities[last] = default(TPriority)!;
    }

    // Every parent from the last one up, sifted down: a heap in linear time.
    private void Heapify() {
        for (int at = (size - 2) >> 2; at >= 0; at--) { Down(elements[at], priorities[at], at); }
    }

    // A node placed at `at` and moved up past every parent strictly greater.
    private void Up(TElement element, TPriority priority, int at) {
        while (at > 0) {
            int parent = (at - 1) >> 2;
            if (order.Compare(priority, priorities[parent]) >= 0) { break; }
            elements[at] = elements[parent];
            priorities[at] = priorities[parent];
            at = parent;
        }
        elements[at] = element;
        priorities[at] = priority;
    }

    // A node placed at `at` and moved down past the least of its children
    // while that child is strictly smaller.
    private void Down(TElement element, TPriority priority, int at) {
        while (true) {
            int first = (at << 2) + 1;
            if (first >= size) { break; }
            int least = first;
            int bound = Math.Min(first + Arity, size);
            for (int child = first + 1; child < bound; child++) {
                if (order.Compare(priorities[child], priorities[least]) < 0) { least = child; }
            }
            if (order.Compare(priority, priorities[least]) <= 0) { break; }
            elements[at] = elements[least];
            priorities[at] = priorities[least];
            at = least;
        }
        elements[at] = element;
        priorities[at] = priority;
    }

    /// THE QUEUE'S PAIRS IN STORAGE ORDER, as .NET's UnorderedItems: a view
    /// that sees the queue as it is, and whose enumerator refuses to go on
    /// once the queue has changed.
    public sealed class UnorderedItemsCollection : IReadOnlyCollection<(TElement Element, TPriority Priority)> {
        internal readonly PriorityQueue<TElement, TPriority> queue;

        internal UnorderedItemsCollection(PriorityQueue<TElement, TPriority> queue) { this.queue = queue; }

        public int Count => queue.size;

        public Enumerator GetEnumerator() { return new Enumerator(queue); }

        IEnumerator<(TElement Element, TPriority Priority)> IEnumerable<(TElement Element, TPriority Priority)>.GetEnumerator() { return GetEnumerator(); }

        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        public struct Enumerator : IEnumerator<(TElement Element, TPriority Priority)>, IDisposable {
            private readonly PriorityQueue<TElement, TPriority> queue;
            private readonly int version;
            private int index;
            private (TElement Element, TPriority Priority) current;

            internal Enumerator(PriorityQueue<TElement, TPriority> queue) {
                this.queue = queue;
                version = queue.version;
                index = 0;
                current = default;
            }

            public (TElement Element, TPriority Priority) Current => current;

            object? IEnumerator.Current => current;

            public bool MoveNext() {
                if (version == queue.version && (uint)index < (uint)queue.size) {
                    current = (queue.elements[index], queue.priorities[index]);
                    index = index + 1;
                    return true;
                }
                if (version != queue.version) {
                    throw new InvalidOperationException("Collection was modified after the enumerator was instantiated.");
                }
                index = queue.size + 1;
                current = default;
                return false;
            }

            public void Reset() {
                if (version != queue.version) {
                    throw new InvalidOperationException("Collection was modified after the enumerator was instantiated.");
                }
                index = 0;
                current = default;
            }

            public void Dispose() { }
        }
    }
}

// ---- the non-generic collections ------------------------------------------
//
// System.Collections as .NET 1 had it, and as old code still writes it: a
// list, a table, a stack and a queue of objects, and the interfaces they are
// held through. Each is the generic collection of object it amounts to, with
// the non-generic surface over it -- a Hashtable's missing key reads null,
// where a Dictionary's throws.

interface ICollection : IEnumerable {
    int Count { get; }
    bool IsSynchronized { get; }
    object SyncRoot { get; }
}

interface IList : ICollection {
    object? this[int index] { get; set; }
    bool IsFixedSize { get; }
    bool IsReadOnly { get; }
    int Add(object? value);
    void Clear();
    bool Contains(object? value);
    int IndexOf(object? value);
    void Insert(int index, object? value);
    void Remove(object? value);
    void RemoveAt(int index);
}

interface IDictionaryEnumerator : IEnumerator {
    DictionaryEntry Entry { get; }
    object Key { get; }
    object? Value { get; }
}

interface IDictionary : ICollection {
    object? this[object key] { get; set; }
    ICollection Keys { get; }
    ICollection Values { get; }
    bool IsFixedSize { get; }
    bool IsReadOnly { get; }
    void Add(object key, object? value);
    void Clear();
    bool Contains(object key);
    new IDictionaryEnumerator GetEnumerator();
    void Remove(object key);
}

interface IComparer {
    int Compare(object? x, object? y);
}

struct DictionaryEntry {
    private object _key;
    private object? _value;

    public DictionaryEntry(object key, object? value) { _key = key; _value = value; }

    public object Key { get { return _key; } set { _key = value; } }
    public object? Value { get { return _value; } set { _value = value; } }

    public void Deconstruct(out object key, out object? value) { key = _key; value = _value; }
}

/// What ArrayList, Hashtable, Stack and Queue walk with: the objects of a
/// list, in order, read when the walk asks.
sealed class ObjectWalk : IEnumerator {
    private readonly List<object?> _items;
    private int _at = -1;

    public ObjectWalk(List<object?> items) { _items = items; }

    public object Current { get { return _items[_at]!; } }
    public bool MoveNext() { _at = _at + 1; return _at < _items.Count; }
    public void Reset() { _at = -1; }
}

sealed class ObjectCollection : ICollection {
    private readonly List<object?> _items;

    public ObjectCollection(List<object?> items) { _items = items; }

    public int Count { get { return _items.Count; } }
    public bool IsSynchronized { get { return false; } }
    public object SyncRoot { get { return this; } }
    public IEnumerator GetEnumerator() { return new ObjectWalk(_items); }
}

class ArrayList : IList {
    private List<object?> _items;

    public ArrayList() { _items = new List<object?>(); }
    public ArrayList(int capacity) { _items = new List<object?>(capacity); }
    // Any sequence, an array included: .NET's arrays are ICollections, and
    // here an array is the sequence it walks.
    public ArrayList(IEnumerable c) { _items = new List<object?>(); AddRange(c); }

    public virtual int Count { get { return _items.Count; } }
    public virtual int Capacity { get { return _items.Capacity; } set { _items.Capacity = value; } }
    public virtual bool IsFixedSize { get { return false; } }
    public virtual bool IsReadOnly { get { return false; } }
    public virtual bool IsSynchronized { get { return false; } }
    public virtual object SyncRoot { get { return this; } }

    public virtual object? this[int index] { get { return _items[index]; } set { _items[index] = value; } }

    public virtual int Add(object? value) { _items.Add(value); return _items.Count - 1; }
    public virtual void AddRange(IEnumerable c) {
        if (c == null) { throw new ArgumentNullException("c"); }
        IEnumerator walk = c.GetEnumerator();
        while (walk.MoveNext()) { _items.Add(walk.Current); }
    }
    public virtual void Clear() { _items.Clear(); }
    public virtual bool Contains(object? item) { return IndexOf(item) >= 0; }
    public virtual int IndexOf(object? value) {
        for (int i = 0; i < _items.Count; i++) { if (Equals(_items[i], value)) { return i; } }
        return -1;
    }
    public virtual void Insert(int index, object? value) { _items.Insert(index, value); }
    public virtual void Remove(object? obj) { int at = IndexOf(obj); if (at >= 0) { _items.RemoveAt(at); } }
    public virtual void RemoveAt(int index) { _items.RemoveAt(index); }
    public virtual void RemoveRange(int index, int count) { _items.RemoveRange(index, count); }
    public virtual void Reverse() { _items.Reverse(); }
    public virtual void Sort() { _items.Sort((x, y) => Comparer<object?>.Default.Compare(x, y)); }
    public virtual void Sort(IComparer? comparer) {
        if (comparer == null) { Sort(); return; }
        _items.Sort((x, y) => comparer.Compare(x, y));
    }
    public virtual ArrayList GetRange(int index, int count) {
        ArrayList made = new ArrayList(count);
        for (int i = index; i < index + count; i++) { made.Add(_items[i]); }
        return made;
    }
    public virtual object?[] ToArray() { return _items.ToArray(); }
    public virtual IEnumerator GetEnumerator() { return new ObjectWalk(_items); }
}

class Hashtable : IDictionary {
    private readonly Dictionary<object, object?> _map;
    private readonly List<object> _order = new List<object>();

    public Hashtable() { _map = new Dictionary<object, object?>(); }
    public Hashtable(int capacity) { _map = new Dictionary<object, object?>(capacity); }
    public Hashtable(IEqualityComparer<object>? equalityComparer) { _map = new Dictionary<object, object?>(equalityComparer ?? EqualityComparer<object>.Default); }

    public virtual int Count { get { return _map.Count; } }
    public virtual bool IsFixedSize { get { return false; } }
    public virtual bool IsReadOnly { get { return false; } }
    public virtual bool IsSynchronized { get { return false; } }
    public virtual object SyncRoot { get { return this; } }

    // A KEY NOT THERE READS NULL, where a Dictionary's throws; written, it
    // is added.
    public virtual object? this[object key] {
        get {
            if (key == null) { throw new ArgumentNullException("key"); }
            return _map.TryGetValue(key, out object? value) ? value : null;
        }
        set {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (!_map.ContainsKey(key)) { _order.Add(key); }
            _map[key] = value;
        }
    }

    public virtual void Add(object key, object? value) {
        if (key == null) { throw new ArgumentNullException("key"); }
        if (_map.ContainsKey(key)) { throw new ArgumentException("Item has already been added. Key in dictionary: '" + key + "'  Key being added: '" + key + "'"); }
        _map[key] = value;
        _order.Add(key);
    }
    public virtual void Clear() { _map.Clear(); _order.Clear(); }
    public virtual bool Contains(object key) { return ContainsKey(key); }
    public virtual bool ContainsKey(object key) {
        if (key == null) { throw new ArgumentNullException("key"); }
        return _map.ContainsKey(key);
    }
    public virtual bool ContainsValue(object? value) {
        foreach (object? held in _map.Values) { if (Equals(held, value)) { return true; } }
        return false;
    }
    public virtual void Remove(object key) {
        if (key == null) { throw new ArgumentNullException("key"); }
        if (_map.Remove(key)) { _order.Remove(key); }
    }

    public virtual ICollection Keys {
        get {
            List<object?> keys = new List<object?>(_order.Count);
            foreach (object key in _order) { keys.Add(key); }
            return new ObjectCollection(keys);
        }
    }
    public virtual ICollection Values {
        get {
            List<object?> values = new List<object?>(_order.Count);
            foreach (object key in _order) { values.Add(_map[key]); }
            return new ObjectCollection(values);
        }
    }

    public virtual IDictionaryEnumerator GetEnumerator() { return new HashtableWalk(this, _order); }
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private sealed class HashtableWalk : IDictionaryEnumerator {
        private readonly Hashtable _table;
        private readonly List<object> _keys;
        private int _at = -1;

        public HashtableWalk(Hashtable table, List<object> keys) { _table = table; _keys = new List<object>(keys); }

        public DictionaryEntry Entry { get { return new DictionaryEntry(_keys[_at], _table[_keys[_at]]); } }
        public object Key { get { return _keys[_at]; } }
        public object? Value { get { return _table[_keys[_at]]; } }
        public object Current { get { return Entry; } }
        public bool MoveNext() { _at = _at + 1; return _at < _keys.Count; }
        public void Reset() { _at = -1; }
    }
}

class Stack : ICollection {
    private readonly List<object?> _items = new List<object?>();

    public virtual int Count { get { return _items.Count; } }
    public virtual bool IsSynchronized { get { return false; } }
    public virtual object SyncRoot { get { return this; } }

    public virtual void Push(object? obj) { _items.Add(obj); }
    public virtual object? Pop() {
        if (_items.Count == 0) { throw new InvalidOperationException("Stack empty."); }
        object? top = _items[_items.Count - 1];
        _items.RemoveAt(_items.Count - 1);
        return top;
    }
    public virtual object? Peek() {
        if (_items.Count == 0) { throw new InvalidOperationException("Stack empty."); }
        return _items[_items.Count - 1];
    }
    public virtual bool Contains(object? obj) { return _items.Contains(obj); }
    public virtual void Clear() { _items.Clear(); }
    public virtual object?[] ToArray() { object?[] made = _items.ToArray(); Array.Reverse(made); return made; }
    public virtual IEnumerator GetEnumerator() { List<object?> top = new List<object?>(_items); top.Reverse(); return new ObjectWalk(top); }
}

class Queue : ICollection {
    private readonly List<object?> _items = new List<object?>();

    public virtual int Count { get { return _items.Count; } }
    public virtual bool IsSynchronized { get { return false; } }
    public virtual object SyncRoot { get { return this; } }

    public virtual void Enqueue(object? obj) { _items.Add(obj); }
    public virtual object? Dequeue() {
        if (_items.Count == 0) { throw new InvalidOperationException("Queue empty."); }
        object? first = _items[0];
        _items.RemoveAt(0);
        return first;
    }
    public virtual object? Peek() {
        if (_items.Count == 0) { throw new InvalidOperationException("Queue empty."); }
        return _items[0];
    }
    public virtual bool Contains(object? obj) { return _items.Contains(obj); }
    public virtual void Clear() { _items.Clear(); }
    public virtual object?[] ToArray() { return _items.ToArray(); }
    public virtual IEnumerator GetEnumerator() { return new ObjectWalk(new List<object?>(_items)); }
}

// ---- BitArray -------------------------------------------------------------
//
// System.Collections' array of bits, thirty-two to a word. A bool[] would do
// the same job at eight times the storage, which is exactly the trade the type
// exists to make -- a sieve or a free-space map is millions of bits.

class BitArray {
    private int[] words;
    private int length;

    public BitArray(int count) : this(count, false) {
    }

    public BitArray(int count, bool value) {
        if (count < 0) { throw new ArgumentOutOfRangeException("length"); }

        length = count;
        words = new int[(count + 31) / 32];
        if (value) { SetAll(true); }
    }

    public BitArray(bool[] values) {
        length = values.Length;
        words = new int[(length + 31) / 32];
        for (int i = 0; i < length; i++) { Set(i, values[i]); }
    }

    /// EIGHT BITS PER BYTE, the lowest bit of the first byte first, which is
    /// .NET's layout and the one a bitmap on disk is written in.
    public BitArray(byte[] bytes) {
        length = bytes.Length * 8;
        words = new int[(length + 31) / 32];
        for (int i = 0; i < bytes.Length; i++) {
            for (int bit = 0; bit < 8; bit++) {
                if (((bytes[i] >> bit) & 1) == 1) { Set(i * 8 + bit, true); }
            }
        }
    }

    public int Length => length;
    public int Count => length;

    public bool this[int index] {
        get { return Get(index); }
        set { Set(index, value); }
    }

    public bool Get(int index) {
        if (index < 0 || index >= length) { throw new ArgumentOutOfRangeException("index"); }
        return ((words[index / 32] >> (index % 32)) & 1) == 1;
    }

    public void Set(int index, bool value) {
        if (index < 0 || index >= length) { throw new ArgumentOutOfRangeException("index"); }

        int at = index / 32;
        int mask = 1 << (index % 32);

        if (value) { words[at] = words[at] | mask; } else { words[at] = words[at] & ~mask; }
    }

    public void SetAll(bool value) {
        int fill = value ? -1 : 0;

        for (int i = 0; i < words.Length; i++) { words[i] = fill; }
    }

    /// EACH OF THESE CHANGES THIS ARRAY and returns it, which is .NET's
    /// contract and the half that surprises people: `a.And(b)` is not a new
    /// array, it IS a, altered.
    public BitArray And(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] & other.Word(i); }
        return this;
    }

    public BitArray Or(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] | other.Word(i); }
        return this;
    }

    public BitArray Xor(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] ^ other.Word(i); }
        return this;
    }

    public BitArray Not() {
        for (int i = 0; i < words.Length; i++) { words[i] = ~words[i]; }
        return this;
    }

    public bool HasAnySet() {
        for (int i = 0; i < length; i++) {
            if (Get(i)) { return true; }
        }
        return false;
    }

    public bool HasAllSet() {
        for (int i = 0; i < length; i++) {
            if (!Get(i)) { return false; }
        }
        return true;
    }

    /// Not a .NET member: one storage word, so that And and its fellows can
    /// read another array's words. Privacy is per instance here.
    public int Word(int at) { return words[at]; }

    private void Same(BitArray other) {
        if (other == null) { throw new ArgumentNullException("value"); }
        if (other.Length != length) { throw new ArgumentException("Array lengths must be the same."); }
    }
}

// ---- System.Collections.ObjectModel ---------------------------------------
//
// A WRAPPER, NOT A COPY: these hand out a view of a live collection through an
// interface with no way to change it. What they promise is that the CALLER
// cannot add or remove -- the owner still can, and the view shows it.

class ReadOnlyDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private IDictionary<K, V> inner;

    /// A read-only view of `dictionary`, reading through to it.
    public ReadOnlyDictionary(IDictionary<K, V> dictionary) {
        if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
        inner = dictionary;
    }

    public int Count => inner.Count;
    public V this[K key] => inner[key];

    /// The dictionary it wraps.
    protected IDictionary<K, V> Dictionary => inner;

    public ReadOnlyCollection<K> Keys => new ReadOnlyCollection<K>(new List<K>(inner.Keys));
    public ReadOnlyCollection<V> Values => new ReadOnlyCollection<V>(new List<V>(inner.Values));
    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;
    ICollection<K> IDictionary<K, V>.Keys => Keys;
    ICollection<V> IDictionary<K, V>.Values => Values;

    public bool ContainsKey(K key) { return inner.ContainsKey(key); }

    public bool TryGetValue(K key, out V value) { return inner.TryGetValue(key, out value); }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return inner.GetEnumerator(); }

    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => true;
    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) { return inner.Contains(item); }
    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) { inner.CopyTo(array, arrayIndex); }

    V IDictionary<K, V>.this[K key] {
        get { return inner[key]; }
        set { throw ReadOnly(); }
    }

    void IDictionary<K, V>.Add(K key, V value) { throw ReadOnly(); }
    bool IDictionary<K, V>.Remove(K key) { throw ReadOnly(); }
    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { throw ReadOnly(); }
    void ICollection<KeyValuePair<K, V>>.Clear() { throw ReadOnly(); }
    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) { throw ReadOnly(); }

    static NotSupportedException ReadOnly() { return new NotSupportedException("Collection is read-only."); }
}

// ---- StringCollection -----------------------------------------------------
//
// System.Collections.Specialized's list of strings, what Clipboard's file
// drop lists are: nulls allowed, duplicates kept, order as added.

class StringCollection : IEnumerable<string> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private List<string> items = new List<string>();

    public int Count => items.Count;

    public string this[int index] {
        get { return items[index]; }
        set { items[index] = value; }
    }

    public int Add(string value) { items.Add(value); return items.Count - 1; }

    public void AddRange(string[] value) {
        foreach (string s in value) { items.Add(s); }
    }

    public void Insert(int index, string value) { items.Insert(index, value); }
    public void Remove(string value) { items.Remove(value); }
    public void RemoveAt(int index) { items.RemoveAt(index); }
    public void Clear() { items.Clear(); }
    public bool Contains(string value) { return items.Contains(value); }
    public int IndexOf(string value) { return items.IndexOf(value); }

    public void CopyTo(string[] array, int index) {
        for (int i = 0; i < items.Count; i++) { array[index + i] = items[i]; }
    }

    public IEnumerator<string> GetEnumerator() { return items.GetEnumerator(); }
}

// ---- System.Collections.Concurrent -------------------------------------------
//
// Collections many threads may use at once without a lock of their own. Each
// guards itself with its own lock (Monitor); an enumeration is a snapshot
// taken under it, which is what .NET documents for the bag, the queue and the
// stack, and within what it promises for the dictionary -- an enumeration
// that may see changes made while it runs, or not.
/// .NET's Parallel (System.Threading.Tasks): a loop's iterations shared out
/// among the processors, a task for each share, the call returning when all
/// are done -- an iteration's exception thrown as an AggregateException of
/// every one, as Task.WaitAll throws them.
static class Parallel
{
    public static ParallelLoopResult For(int fromInclusive, int toExclusive, Action<int> body)
    {
        int count = toExclusive - fromInclusive;
        if (count <= 0) return new ParallelLoopResult(true);
        int parts = Math.Min(count, Math.Max(1, Environment.ProcessorCount));
        Task[] tasks = new Task[parts];
        int chunk = count / parts, extra = count % parts, start = fromInclusive;
        for (int p = 0; p < parts; p++)
        {
            int from = start, to = start + chunk + (p < extra ? 1 : 0);
            start = to;
            tasks[p] = Task.Run(() => { for (int i = from; i < to; i++) body(i); });
        }
        Task.WaitAll(tasks);
        return new ParallelLoopResult(true);
    }

    public static ParallelLoopResult For(long fromInclusive, long toExclusive, Action<long> body)
    {
        long count = toExclusive - fromInclusive;
        if (count <= 0) return new ParallelLoopResult(true);
        int parts = (int)Math.Min(count, Math.Max(1, Environment.ProcessorCount));
        Task[] tasks = new Task[parts];
        long chunk = count / parts, extra = count % parts, start = fromInclusive;
        for (int p = 0; p < parts; p++)
        {
            long from = start, to = start + chunk + (p < extra ? 1 : 0);
            start = to;
            tasks[p] = Task.Run(() => { for (long i = from; i < to; i++) body(i); });
        }
        Task.WaitAll(tasks);
        return new ParallelLoopResult(true);
    }

    // An asynchronous body for each element (.NET 6): every one started,
    // their tasks awaited together, the first fault thrown.
    public static Task ForEachAsync<T>(IEnumerable<T> source, Func<T, CancellationToken, System.Threading.Tasks.ValueTask> body)
    {
        return ForEachAsync(source, CancellationToken.None, body);
    }

    public static Task ForEachAsync<T>(IEnumerable<T> source, CancellationToken cancellationToken, Func<T, CancellationToken, System.Threading.Tasks.ValueTask> body)
    {
        if (source == null) throw new ArgumentNullException("source");
        if (body == null) throw new ArgumentNullException("body");
        List<Task> running = new List<Task>();
        foreach (T item in source)
        {
            cancellationToken.ThrowIfCancellationRequested();
            T each = item;
            running.Add(Task.Run(() => body(each, cancellationToken).AsTask()));
        }
        return Task.WhenAll(running);
    }

    public static async Task ForEachAsync<T>(IAsyncEnumerable<T> source, Func<T, CancellationToken, System.Threading.Tasks.ValueTask> body)
    {
        if (source == null) throw new ArgumentNullException("source");
        if (body == null) throw new ArgumentNullException("body");
        List<Task> running = new List<Task>();
        await foreach (T item in source)
        {
            T each = item;
            running.Add(Task.Run(() => body(each, CancellationToken.None).AsTask()));
        }
        await Task.WhenAll(running);
    }

    public static ParallelLoopResult ForEach<T>(IEnumerable<T> source, Action<T> body)
    {
        List<T> items = new List<T>(source);
        return For(0, items.Count, i => body(items[i]));
    }

    public static void Invoke(params Action[] actions)
    {
        Task[] tasks = new Task[actions.Length];
        for (int i = 0; i < actions.Length; i++)
        {
            Action action = actions[i];
            tasks[i] = Task.Run(action);
        }
        Task.WaitAll(tasks);
    }
}

/// What a Parallel loop answers: that it ran to the end.
struct ParallelLoopResult
{
    public ParallelLoopResult(bool completed) { IsCompleted = completed; }
    public bool IsCompleted { get; }
    public long? LowestBreakIteration => null;
}

// ---- Rectangular arrays -----------------------------------------------------
//
// `T[,]` AND `T[,,]`, C#'s rectangular arrays: the parser writes the type as
// one of these (Parser.Suffixes), `new T[a, b]` as its constructor and a
// nested initialiser `{ {1, 2}, {3, 4} }` as its elements in row-major order
// with the lengths its braces give. One flat array underneath, indexed
// i * columns + j, each index checked against its own length; enumerated in
// row-major order, as foreach walks one; a negative length is .NET's
// OverflowException and an index out of range its IndexOutOfRangeException.

/// The makers an initialiser of one is written as: its lengths, and its
/// elements row by row as an array whose element type they infer --
/// `new[,] { {1, 2}, {3, 4} }` names none.
static class __Rectangular {
    public static __Rectangular2<T> Of2<T>(int rows, int columns, T[] values) => new __Rectangular2<T>(rows, columns, values);
    public static __Rectangular3<T> Of3<T>(int planes, int rows, int columns, T[] values) => new __Rectangular3<T>(planes, rows, columns, values);
}

sealed class __Rectangular2<T> : IEnumerable<T> {
    private readonly T[] items;
    private readonly int rows;
    private readonly int columns;

    public __Rectangular2(int rows, int columns) {
        if (rows < 0 || columns < 0) { throw new OverflowException("Arithmetic operation resulted in an overflow."); }
        this.rows = rows;
        this.columns = columns;
        items = new T[rows * columns];
    }

    /// The lengths and the elements, row by row: an initialiser's.
    public __Rectangular2(int rows, int columns, T[] values) {
        this.rows = rows;
        this.columns = columns;
        items = values;
    }

    public T this[int i, int j] {
        get {
            if ((uint)i >= (uint)rows || (uint)j >= (uint)columns) { throw new IndexOutOfRangeException(); }
            return items[i * columns + j];
        }
        set {
            if ((uint)i >= (uint)rows || (uint)j >= (uint)columns) { throw new IndexOutOfRangeException(); }
            items[i * columns + j] = value;
        }
    }

    public int Length => items.Length;
    public long LongLength => items.Length;
    public int Rank => 2;

    public int GetLength(int dimension) {
        if (dimension == 0) { return rows; }
        if (dimension == 1) { return columns; }
        throw new IndexOutOfRangeException();
    }
    public long GetLongLength(int dimension) => GetLength(dimension);
    public int GetLowerBound(int dimension) { GetLength(dimension); return 0; }
    public int GetUpperBound(int dimension) => GetLength(dimension) - 1;

    public object Clone() => new __Rectangular2<T>(rows, columns, (T[])items.Clone());

    public IEnumerator<T> GetEnumerator() {
        for (int k = 0; k < items.Length; k++) { yield return items[k]; }
    }
    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();

    public override string ToString() => typeof(T).ToString() + "[,]";
}

sealed class __Rectangular3<T> : IEnumerable<T> {
    private readonly T[] items;
    private readonly int planes;
    private readonly int rows;
    private readonly int columns;

    public __Rectangular3(int planes, int rows, int columns) {
        if (planes < 0 || rows < 0 || columns < 0) { throw new OverflowException("Arithmetic operation resulted in an overflow."); }
        this.planes = planes;
        this.rows = rows;
        this.columns = columns;
        items = new T[planes * rows * columns];
    }

    public __Rectangular3(int planes, int rows, int columns, T[] values) {
        this.planes = planes;
        this.rows = rows;
        this.columns = columns;
        items = values;
    }

    public T this[int i, int j, int k] {
        get {
            if ((uint)i >= (uint)planes || (uint)j >= (uint)rows || (uint)k >= (uint)columns) { throw new IndexOutOfRangeException(); }
            return items[(i * rows + j) * columns + k];
        }
        set {
            if ((uint)i >= (uint)planes || (uint)j >= (uint)rows || (uint)k >= (uint)columns) { throw new IndexOutOfRangeException(); }
            items[(i * rows + j) * columns + k] = value;
        }
    }

    public int Length => items.Length;
    public long LongLength => items.Length;
    public int Rank => 3;

    public int GetLength(int dimension) {
        if (dimension == 0) { return planes; }
        if (dimension == 1) { return rows; }
        if (dimension == 2) { return columns; }
        throw new IndexOutOfRangeException();
    }
    public long GetLongLength(int dimension) => GetLength(dimension);
    public int GetLowerBound(int dimension) { GetLength(dimension); return 0; }
    public int GetUpperBound(int dimension) => GetLength(dimension) - 1;

    public object Clone() => new __Rectangular3<T>(planes, rows, columns, (T[])items.Clone());

    public IEnumerator<T> GetEnumerator() {
        for (int k = 0; k < items.Length; k++) { yield return items[k]; }
    }
    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();

    public override string ToString() => typeof(T).ToString() + "[,,]";
}

namespace System.Collections.Concurrent
{
    /// A collection one thread can add to while another takes from it.
    interface IProducerConsumerCollection<T> : IEnumerable<T>, IReadOnlyCollection<T>
    {
        bool TryAdd(T item);
        bool TryTake(out T item);
        T[] ToArray();
        void CopyTo(T[] array, int index);
    }

    /// An unordered collection: what is taken is whatever the bag gives,
    /// last added first here, as .NET's does for the thread that added it --
    /// and it is read in that order too, newest first, as .NET's one thread's
    /// list is: a bag of 0..5 enumerates 5,4,3,2,1,0, and one made from a
    /// list holds it backwards.
    class ConcurrentBag<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        readonly List<T> _items;
        readonly object _gate = new object();

        public ConcurrentBag()
        {
            _items = new List<T>();
        }

        public ConcurrentBag(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new List<T>(collection);
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Add(T item)
        {
            lock (_gate) { _items.Add(item); }
        }

        public bool TryAdd(T item)
        {
            Add(item);
            return true;
        }

        public bool TryTake(out T result)
        {
            lock (_gate)
            {
                int last = _items.Count - 1;
                if (last < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[last];
                _items.RemoveAt(last);
                return true;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                int last = _items.Count - 1;
                if (last < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[last];
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        public T[] ToArray()
        {
            lock (_gate)
            {
                int count = _items.Count;
                T[] all = new T[count];
                for (int i = 0; i < count; i++) { all[i] = _items[count - 1 - i]; }
                return all;
            }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            ToArray().CopyTo(array, index);
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// First in, first out, for many threads.
    class ConcurrentQueue<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        readonly Queue<T> _items;
        readonly object _gate = new object();

        public ConcurrentQueue()
        {
            _items = new Queue<T>();
        }

        public ConcurrentQueue(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new Queue<T>();
            foreach (T item in collection) { _items.Enqueue(item); }
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Enqueue(T item)
        {
            lock (_gate) { _items.Enqueue(item); }
        }

        public bool TryDequeue(out T result)
        {
            lock (_gate)
            {
                if (_items.Count == 0)
                {
                    result = default!;
                    return false;
                }
                result = _items.Dequeue();
                return true;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                if (_items.Count == 0)
                {
                    result = default!;
                    return false;
                }
                result = _items.Peek();
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        bool IProducerConsumerCollection<T>.TryAdd(T item)
        {
            Enqueue(item);
            return true;
        }

        bool IProducerConsumerCollection<T>.TryTake(out T item)
        {
            return TryDequeue(out item);
        }

        public T[] ToArray()
        {
            lock (_gate) { return _items.ToArray(); }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            T[] snapshot = ToArray();
            if (index < 0 || index > array.Length) { throw new ArgumentOutOfRangeException("index"); }
            if (array.Length - index < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[index + i] = snapshot[i]; }
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// Last in, first out, for many threads.
    class ConcurrentStack<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        readonly List<T> _items;
        readonly object _gate = new object();

        public ConcurrentStack()
        {
            _items = new List<T>();
        }

        public ConcurrentStack(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new List<T>(collection);
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Push(T item)
        {
            lock (_gate) { _items.Add(item); }
        }

        /// Pushes them in order, as one step: the last of them ends on top.
        public void PushRange(T[] items)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            PushRange(items, 0, items.Length);
        }

        public void PushRange(T[] items, int startIndex, int count)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            if (startIndex < 0 || count < 0 || startIndex > items.Length - count) { throw new ArgumentOutOfRangeException("startIndex"); }
            lock (_gate)
            {
                for (int i = 0; i < count; i++) { _items.Add(items[startIndex + i]); }
            }
        }

        public bool TryPop(out T result)
        {
            lock (_gate)
            {
                int top = _items.Count - 1;
                if (top < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[top];
                _items.RemoveAt(top);
                return true;
            }
        }

        /// Pops up to items.Length, top first, answering how many it took.
        public int TryPopRange(T[] items)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            return TryPopRange(items, 0, items.Length);
        }

        public int TryPopRange(T[] items, int startIndex, int count)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            if (startIndex < 0 || count < 0 || startIndex > items.Length - count) { throw new ArgumentOutOfRangeException("startIndex"); }
            lock (_gate)
            {
                int taken = 0;
                while (taken < count && _items.Count > 0)
                {
                    int top = _items.Count - 1;
                    items[startIndex + taken] = _items[top];
                    _items.RemoveAt(top);
                    taken = taken + 1;
                }
                return taken;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                int top = _items.Count - 1;
                if (top < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[top];
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        bool IProducerConsumerCollection<T>.TryAdd(T item)
        {
            Push(item);
            return true;
        }

        bool IProducerConsumerCollection<T>.TryTake(out T item)
        {
            return TryPop(out item);
        }

        /// Top first, as .NET's is.
        public T[] ToArray()
        {
            lock (_gate)
            {
                T[] copy = new T[_items.Count];
                for (int i = 0; i < copy.Length; i++) { copy[i] = _items[_items.Count - 1 - i]; }
                return copy;
            }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            T[] snapshot = ToArray();
            if (index < 0 || index > array.Length) { throw new ArgumentOutOfRangeException("index"); }
            if (array.Length - index < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[index + i] = snapshot[i]; }
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// A dictionary for many threads: every operation is one step, and the
    /// Get-or-Add and Add-or-Update forms are what make read-then-write safe.
    /// A value factory runs outside the lock, as .NET's does -- so it may run
    /// more than once for a key when threads race, and only one result is kept.
    class ConcurrentDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        readonly Dictionary<K, V> _items;
        readonly object _gate = new object();

        public ConcurrentDictionary()
        {
            _items = new Dictionary<K, V>();
        }

        public ConcurrentDictionary(IEqualityComparer<K>? comparer)
        {
            _items = comparer == null ? new Dictionary<K, V>() : new Dictionary<K, V>(comparer);
        }

        public ConcurrentDictionary(IEnumerable<KeyValuePair<K, V>> collection) : this(collection, null)
        {
        }

        public ConcurrentDictionary(IEnumerable<KeyValuePair<K, V>> collection, IEqualityComparer<K>? comparer) : this(comparer)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            foreach (KeyValuePair<K, V> pair in collection)
            {
                if (!_items.TryAdd(pair.Key, pair.Value)) { throw new ArgumentException("The source argument contains duplicate keys."); }
            }
        }

        public ConcurrentDictionary(int concurrencyLevel, int capacity) : this()
        {
            if (concurrencyLevel < 1 && concurrencyLevel != -1) { throw new ArgumentOutOfRangeException("concurrencyLevel"); }
            if (capacity < 0) { throw new ArgumentOutOfRangeException("capacity"); }
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public V this[K key]
        {
            get
            {
                if (TryGetValue(key, out V value)) { return value; }
                throw new KeyNotFoundException("The given key '" + key + "' was not present in the dictionary.");
            }
            set
            {
                lock (_gate) { _items[key] = value; }
            }
        }

        public ICollection<K> Keys { get { lock (_gate) { return new ReadOnlyCollection<K>(new List<K>(_items.Keys)); } } }

        public ICollection<V> Values { get { lock (_gate) { return new ReadOnlyCollection<V>(new List<V>(_items.Values)); } } }

        IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
        IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

        public bool ContainsKey(K key)
        {
            lock (_gate) { return _items.ContainsKey(key); }
        }

        public bool TryGetValue(K key, out V value)
        {
            lock (_gate) { return _items.TryGetValue(key, out value); }
        }

        public bool TryAdd(K key, V value)
        {
            lock (_gate) { return _items.TryAdd(key, value); }
        }

        public bool TryRemove(K key, out V value)
        {
            lock (_gate) { return _items.Remove(key, out value); }
        }

        /// Removes the pair only when the key still holds that value.
        public bool TryRemove(KeyValuePair<K, V> item)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(item.Key, out V held) && EqualityComparer<V>.Default.Equals(held, item.Value))
                {
                    return _items.Remove(item.Key);
                }
                return false;
            }
        }

        /// Replaces the value only when it is still `comparisonValue`.
        public bool TryUpdate(K key, V newValue, V comparisonValue)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(key, out V held) && EqualityComparer<V>.Default.Equals(held, comparisonValue))
                {
                    _items[key] = newValue;
                    return true;
                }
                return false;
            }
        }

        public V GetOrAdd(K key, V value)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(key, out V held)) { return held; }
                _items.Add(key, value);
                return value;
            }
        }

        public V GetOrAdd(K key, Func<K, V> valueFactory)
        {
            if (valueFactory == null) { throw new ArgumentNullException("valueFactory"); }
            if (TryGetValue(key, out V held)) { return held; }
            V made = valueFactory(key);
            return GetOrAdd(key, made);
        }

        public V GetOrAdd<TArg>(K key, Func<K, TArg, V> valueFactory, TArg factoryArgument)
        {
            if (valueFactory == null) { throw new ArgumentNullException("valueFactory"); }
            if (TryGetValue(key, out V held)) { return held; }
            V made = valueFactory(key, factoryArgument);
            return GetOrAdd(key, made);
        }

        public V AddOrUpdate(K key, V addValue, Func<K, V, V> updateValueFactory)
        {
            if (updateValueFactory == null) { throw new ArgumentNullException("updateValueFactory"); }
            while (true)
            {
                if (TryGetValue(key, out V held))
                {
                    V updated = updateValueFactory(key, held);
                    if (TryUpdate(key, updated, held)) { return updated; }
                }
                else if (TryAdd(key, addValue))
                {
                    return addValue;
                }
            }
        }

        public V AddOrUpdate(K key, Func<K, V> addValueFactory, Func<K, V, V> updateValueFactory)
        {
            if (addValueFactory == null) { throw new ArgumentNullException("addValueFactory"); }
            if (updateValueFactory == null) { throw new ArgumentNullException("updateValueFactory"); }
            while (true)
            {
                if (TryGetValue(key, out V held))
                {
                    V updated = updateValueFactory(key, held);
                    if (TryUpdate(key, updated, held)) { return updated; }
                }
                else
                {
                    V added = addValueFactory(key);
                    if (TryAdd(key, added)) { return added; }
                }
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        public KeyValuePair<K, V>[] ToArray()
        {
            lock (_gate)
            {
                KeyValuePair<K, V>[] copy = new KeyValuePair<K, V>[_items.Count];
                int i = 0;
                foreach (KeyValuePair<K, V> pair in _items)
                {
                    copy[i] = pair;
                    i = i + 1;
                }
                return copy;
            }
        }

        public IEnumerator<KeyValuePair<K, V>> GetEnumerator()
        {
            return ((IEnumerable<KeyValuePair<K, V>>)ToArray()).GetEnumerator();
        }

        void IDictionary<K, V>.Add(K key, V value)
        {
            if (!TryAdd(key, value)) { throw new ArgumentException("An item with the same key has already been added. Key: " + key); }
        }

        bool IDictionary<K, V>.Remove(K key)
        {
            return TryRemove(key, out V _);
        }

        bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

        void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item)
        {
            ((IDictionary<K, V>)this).Add(item.Key, item.Value);
        }

        bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item)
        {
            return TryGetValue(item.Key, out V held) && EqualityComparer<V>.Default.Equals(held, item.Value);
        }

        void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            KeyValuePair<K, V>[] snapshot = ToArray();
            if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex"); }
            if (array.Length - arrayIndex < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[arrayIndex + i] = snapshot[i]; }
        }

        bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item)
        {
            return TryRemove(item);
        }
    }
}

