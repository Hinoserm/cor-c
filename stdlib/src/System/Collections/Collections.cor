// System.Collections.Generic -- the containers std.cor does not carry.
//
// std.cor has List, Dictionary, HashSet, Queue and a small SortedSet, which
// are the ones its own compiler needed. These are the rest of the ones a
// program written for .NET reaches for: a stack, a doubly linked list, and the
// two ordered maps.
//
// SortedList<K,V> and SortedDictionary<K,V> differ in .NET by their storage --
// parallel arrays against a red-black tree -- and so in which operation is
// cheap, not in what they answer. Both are parallel arrays here; the cost is
// that an insert into the middle of a large SortedDictionary shifts rather
// than rotates, and every answer, ordering and exception is .NET's.

// ---- Stack ----------------------------------------------------------------
//
// LAST IN, FIRST OUT, on a growable array whose top is its end -- so Push and
// Pop are both a store and an increment, and nothing ever shifts.
//
// Enumeration is TOP TO BOTTOM, which is .NET's order and the opposite of the
// storage order; a caller who writes `foreach` over a stack expects to see
// what Pop would hand back, in that sequence.

class StackEnumerator<T> : IEnumerator<T> {
    private Stack<T> over;
    private int at;

    public StackEnumerator(Stack<T> stack) {
        over = stack;
        at = stack.Count;
    }

    public T Current => over.ElementFromTop(over.Count - 1 - at);

    public bool MoveNext() {
        at = at - 1;
        return at >= 0;
    }
}

class Stack<T> : IReadOnlyCollection<T>, IEnumerable<T> {
    private T[] items;
    private int count;

    public Stack() {
        items = new T[8];
        count = 0;
    }

    /// STARTED FROM A SEQUENCE, which .NET pushes in the order it walks: the
    /// last one walked is the first one popped.
    public Stack(IEnumerable<T> collection) : this() {
        foreach (T each in collection) { Push(each); }
    }

    /// Room for this many before the first growth. Nothing about what it
    /// holds, which is why .NET's is a hint and not a count.
    public Stack(int capacity) {
        items = new T[capacity < 1 ? 1 : capacity];
        count = 0;
    }

    public int Count => count;

    public void Push(T value) {
        if (count == items.Length) { Grow(); }
        items[count] = value;
        count = count + 1;
    }

    public T Pop() {
        if (count == 0) { throw new InvalidOperationException("Stack empty."); }
        count = count - 1;
        T value = items[count];
        items[count] = default(T)!;
        return value;
    }

    public T Peek() {
        if (count == 0) { throw new InvalidOperationException("Stack empty."); }
        return items[count - 1];
    }

    /// .NET's non-throwing pair, added in Core 2.0: false and default(T) when
    /// the stack is empty, instead of the exception.
    public bool TryPop(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = Pop();
        return true;
    }

    public bool TryPeek(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = items[count - 1];
        return true;
    }

    public bool Contains(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (int i = 0; i < count; i++) {
            if (same.Equals(items[i], value)) { return true; }
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i < count; i++) { items[i] = default(T)!; }
        count = 0;
    }

    /// The element `depth` places below the top, which is what the enumerator
    /// walks. Not a .NET member: an enumerator written outside the class has
    /// no other way to read the store.
    public T ElementFromTop(int depth) { return items[count - 1 - depth]; }

    /// TOP FIRST, like the enumeration, which is what .NET's ToArray gives.
    public T[] ToArray() {
        T[] copy = new T[count];
        for (int i = 0; i < count; i++) { copy[i] = items[count - 1 - i]; }
        return copy;
    }

    public void CopyTo(T[] target, int index) {
        for (int i = 0; i < count; i++) { target[index + i] = items[count - 1 - i]; }
    }

    public IEnumerator<T> GetEnumerator() { return new StackEnumerator<T>(this); }

    private void Grow() {
        T[] bigger = new T[items.Length * 2];
        for (int i = 0; i < count; i++) { bigger[i] = items[i]; }
        items = bigger;
    }
}

// ---- LinkedList -----------------------------------------------------------
//
// A node holds its own links and the list it belongs to, which is what makes
// LinkedList's contract enforceable: AddAfter and Remove take a NODE, and .NET
// throws InvalidOperationException when that node came from another list.
// Without the back-pointer the operation would quietly corrupt both lists.

class LinkedListNode<T> {
    internal LinkedList<T>? owner;
    internal LinkedListNode<T>? next;
    internal LinkedListNode<T>? prev;

    public T Value;

    public LinkedListNode(T value) {
        Value = value;
        owner = null;
        next = null;
        prev = null;
    }

    public LinkedList<T>? List => owner;

    /// NULL AT THE ENDS. .NET's list is circular inside and its Next hides the
    /// wrap by returning null at the last node; the links here are plain, so
    /// the property is the field.
    public LinkedListNode<T>? Next => next;
    public LinkedListNode<T>? Previous => prev;
}

class LinkedListEnumerator<T> : IEnumerator<T> {
    private LinkedList<T> over;
    private LinkedListNode<T>? at;
    private bool started;

    public LinkedListEnumerator(LinkedList<T> list) {
        over = list;
        at = null;
        started = false;
    }

    /// MoveNext answered true to get here, so there is a node; C# spells
    /// that with the '!' rather than a test nobody can fail.
    public T Current => at!.Value;

    public bool MoveNext() {
        if (!started) {
            started = true;
            at = over.First;
        } else if (at != null) {
            at = at.Next;
        }
        return at != null;
    }
}

class LinkedList<T> : ICollection<T>, IReadOnlyCollection<T>, IEnumerable<T> {
    bool ICollection<T>.IsReadOnly => false;

    void ICollection<T>.Add(T item) { AddLast(item); }

    private LinkedListNode<T>? head;
    private LinkedListNode<T>? tail;
    private int count;

    public LinkedList() {
        head = null;
        tail = null;
        count = 0;
    }

    public int Count => count;
    public LinkedListNode<T>? First => head;
    public LinkedListNode<T>? Last => tail;

    public LinkedListNode<T> AddFirst(T value) {
        LinkedListNode<T> node = new LinkedListNode<T>(value);
        AddFirst(node);
        return node;
    }

    public void AddFirst(LinkedListNode<T> node) {
        Adopt(node);
        node.prev = null;
        node.next = head;
        if (head != null) { head.prev = node; } else { tail = node; }
        head = node;
        count = count + 1;
    }

    public LinkedListNode<T> AddLast(T value) {
        LinkedListNode<T> node = new LinkedListNode<T>(value);
        AddLast(node);
        return node;
    }

    public void AddLast(LinkedListNode<T> node) {
        Adopt(node);
        node.next = null;
        node.prev = tail;
        if (tail != null) { tail.next = node; } else { head = node; }
        tail = node;
        count = count + 1;
    }

    public LinkedListNode<T> AddAfter(LinkedListNode<T> node, T value) {
        LinkedListNode<T> fresh = new LinkedListNode<T>(value);
        AddAfter(node, fresh);
        return fresh;
    }

    public void AddAfter(LinkedListNode<T> node, LinkedListNode<T> fresh) {
        Mine(node);
        Adopt(fresh);
        fresh.prev = node;
        fresh.next = node.next;
        if (node.next != null) { node.next!.prev = fresh; } else { tail = fresh; }
        node.next = fresh;
        count = count + 1;
    }

    public LinkedListNode<T> AddBefore(LinkedListNode<T> node, T value) {
        LinkedListNode<T> fresh = new LinkedListNode<T>(value);
        AddBefore(node, fresh);
        return fresh;
    }

    public void AddBefore(LinkedListNode<T> node, LinkedListNode<T> fresh) {
        Mine(node);
        Adopt(fresh);
        fresh.next = node;
        fresh.prev = node.prev;
        if (node.prev != null) { node.prev!.next = fresh; } else { head = fresh; }
        node.prev = fresh;
        count = count + 1;
    }

    public LinkedListNode<T>? Find(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (LinkedListNode<T>? walk = head; walk != null; walk = walk!.Next) {
            if (same.Equals(walk.Value, value)) { return walk; }
        }
        return null;
    }

    public LinkedListNode<T>? FindLast(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;
        for (LinkedListNode<T>? walk = tail; walk != null; walk = walk!.Previous) {
            if (same.Equals(walk.Value, value)) { return walk; }
        }
        return null;
    }

    public bool Contains(T value) { return Find(value) != null; }

    public void Remove(LinkedListNode<T> node) {
        Mine(node);
        if (node.prev != null) { node.prev!.next = node.next; } else { head = node.next; }
        if (node.next != null) { node.next!.prev = node.prev; } else { tail = node.prev; }
        node.owner = null;
        node.next = null;
        node.prev = null;
        count = count - 1;
    }

    /// True when a node holding that value was there, which is .NET's contract:
    /// the FIRST such node goes, not all of them.
    public bool Remove(T value) {
        LinkedListNode<T>? found = Find(value);
        if (found == null) { return false; }
        Remove(found);
        return true;
    }

    public void RemoveFirst() {
        if (head == null) { throw new InvalidOperationException("The LinkedList is empty."); }
        Remove(head!);
    }

    public void RemoveLast() {
        if (tail == null) { throw new InvalidOperationException("The LinkedList is empty."); }
        Remove(tail!);
    }

    public void Clear() {
        LinkedListNode<T>? walk = head;
        while (walk != null) {
            LinkedListNode<T>? after = walk.next;
            walk.owner = null;
            walk.next = null;
            walk.prev = null;
            walk = after;
        }
        head = null;
        tail = null;
        count = 0;
    }

    public void CopyTo(T[] target, int index) {
        int i = index;
        for (LinkedListNode<T>? walk = head; walk != null; walk = walk!.Next) {
            target[i] = walk.Value;
            i = i + 1;
        }
    }

    public IEnumerator<T> GetEnumerator() { return new LinkedListEnumerator<T>(this); }

    // A node already in a list cannot be added to another, and a node from
    // another list cannot be used as a position in this one. .NET's wording
    // for both is InvalidOperationException.
    private void Adopt(LinkedListNode<T> node) {
        if (node == null) { throw new ArgumentNullException("node"); }
        if (node.owner != null) {
            throw new InvalidOperationException("The LinkedList node already belongs to a LinkedList.");
        }
        node.owner = this;
    }

    private void Mine(LinkedListNode<T> node) {
        if (node == null) { throw new ArgumentNullException("node"); }
        if (node.owner != this) {
            throw new InvalidOperationException("The LinkedList node does not belong to current LinkedList.");
        }
    }
}

// ---- the ordered maps -----------------------------------------------------
//
// Both keep their keys sorted, so a lookup is a binary search and enumeration
// is in key order. The shared engine is SortedPairs: the two public classes
// differ only in which members .NET gives them.

class SortedPairs<K, V> {
    internal List<K> keys;
    internal List<V> values;
    internal IComparer<K> order;

    public SortedPairs(IComparer<K> comparer) {
        keys = new List<K>();
        values = new List<V>();
        order = comparer;
    }

    /// The index of the key, or the ones' complement of where it would go --
    /// Array.BinarySearch's convention, and the reason IndexOfKey can return
    /// the insertion point without a second search.
    public int Search(K key) {
        int low = 0;
        int high = keys.Count - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = order.Compare(keys[middle], key);

            if (sign == 0) { return middle; }
            if (sign < 0) { low = middle + 1; } else { high = middle - 1; }
        }
        return ~low;
    }

    public void Insert(int at, K key, V value) {
        keys.Insert(at, key);
        values.Insert(at, value);
    }

    public void RemoveAt(int at) {
        keys.RemoveAt(at);
        values.RemoveAt(at);
    }
}

class SortedPairsEnumerator<K, V> : IEnumerator<KeyValuePair<K, V>> {
    private SortedPairs<K, V> over;
    private int at;

    public SortedPairsEnumerator(SortedPairs<K, V> pairs) {
        over = pairs;
        at = -1;
    }

    public KeyValuePair<K, V> Current => new KeyValuePair<K, V>(over.keys[at], over.values[at]);

    public bool MoveNext() {
        at = at + 1;
        return at < over.keys.Count;
    }
}

/// .NET's array-backed ordered map: a lookup is a binary search, and the
/// position of a key is part of the API -- IndexOfKey, GetKeyAtIndex,
/// RemoveAt. That is the whole difference from SortedDictionary.
class SortedList<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {
    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

    ICollection<K> IDictionary<K, V>.Keys => Keys.AsReadOnly();
    ICollection<V> IDictionary<K, V>.Values => Values.AsReadOnly();
    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { Add(item.Key, item.Value); }

    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) {
        return TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value);
    }

    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex"); }
        if (array.Length - arrayIndex < Count) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        foreach (KeyValuePair<K, V> pair in this) {
            array[arrayIndex] = pair;
            arrayIndex = arrayIndex + 1;
        }
    }

    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) {
        if (TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value)) { return Remove(item.Key); }
        return false;
    }
    private SortedPairs<K, V> pairs;

    public SortedList() { pairs = new SortedPairs<K, V>(Comparer<K>.Default); }
    public SortedList(IComparer<K> comparer) { pairs = new SortedPairs<K, V>(comparer); }

    public int Count => pairs.keys.Count;
    public IComparer<K> Comparer => pairs.order;

    /// The keys in order, and the values in the order of their keys.
    public List<K> Keys => pairs.keys;
    public List<V> Values => pairs.values;

    /// A DUPLICATE KEY THROWS, which is Add's contract and the difference from
    /// the indexer's setter -- that one replaces.
    public void Add(K key, V value) {
        int at = pairs.Search(key);
        if (at >= 0) { throw new ArgumentException("An item with the same key has already been added."); }
        pairs.Insert(~at, key, value);
    }

    public V this[K key] {
        get {
            int at = pairs.Search(key);
            if (at < 0) { throw new KeyNotFoundException("The given key was not present in the dictionary."); }
            return pairs.values[at];
        }
        set {
            int at = pairs.Search(key);
            if (at >= 0) { pairs.values[at] = value; } else { pairs.Insert(~at, key, value); }
        }
    }

    public bool ContainsKey(K key) { return pairs.Search(key) >= 0; }

    public bool ContainsValue(V value) { return IndexOfValue(value) >= 0; }

    public bool TryGetValue(K key, out V value) {
        int at = pairs.Search(key);
        if (at < 0) { value = default(V); return false; }
        value = pairs.values[at];
        return true;
    }

    /// NEGATIVE WHEN ABSENT, and .NET promises only "negative" rather than the
    /// complement, so a caller reads it as a not-found flag.
    public int IndexOfKey(K key) {
        int at = pairs.Search(key);
        if (at < 0) { return -1; }
        return at;
    }

    public int IndexOfValue(V value) {
        IEqualityComparer<V> same = EqualityComparer<V>.Default;
        for (int i = 0; i < pairs.values.Count; i++) {
            if (same.Equals(pairs.values[i], value)) { return i; }
        }
        return -1;
    }

    public K GetKeyAtIndex(int index) { return pairs.keys[index]; }
    public V GetValueAtIndex(int index) { return pairs.values[index]; }
    public void SetValueAtIndex(int index, V value) { pairs.values[index] = value; }

    public bool Remove(K key) {
        int at = pairs.Search(key);
        if (at < 0) { return false; }
        pairs.RemoveAt(at);
        return true;
    }

    public void RemoveAt(int index) {
        if (index < 0 || index >= pairs.keys.Count) {
            throw new ArgumentOutOfRangeException("index");
        }
        pairs.RemoveAt(index);
    }

    public void Clear() {
        pairs.keys.Clear();
        pairs.values.Clear();
    }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return new SortedPairsEnumerator<K, V>(pairs); }
}

/// The ordered map without the positions: a Dictionary whose enumeration is in
/// key order. In .NET it is a tree and inserting is logarithmic; here it is the
/// same store as SortedList, so the ANSWERS match and the insert cost does not.
class SortedDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {

    ICollection<K> IDictionary<K, V>.Keys => Keys.AsReadOnly();
    ICollection<V> IDictionary<K, V>.Values => Values.AsReadOnly();
    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { Add(item.Key, item.Value); }

    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) {
        return TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value);
    }

    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex"); }
        if (array.Length - arrayIndex < Count) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        foreach (KeyValuePair<K, V> pair in this) {
            array[arrayIndex] = pair;
            arrayIndex = arrayIndex + 1;
        }
    }

    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) {
        if (TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value)) { return Remove(item.Key); }
        return false;
    }
    private SortedPairs<K, V> pairs;

    public SortedDictionary() { pairs = new SortedPairs<K, V>(Comparer<K>.Default); }
    public SortedDictionary(IComparer<K> comparer) { pairs = new SortedPairs<K, V>(comparer); }

    public int Count => pairs.keys.Count;
    public IComparer<K> Comparer => pairs.order;
    public List<K> Keys => pairs.keys;
    public List<V> Values => pairs.values;
    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

    public void Add(K key, V value) {
        int at = pairs.Search(key);
        if (at >= 0) { throw new ArgumentException("An item with the same key has already been added."); }
        pairs.Insert(~at, key, value);
    }

    public V this[K key] {
        get {
            int at = pairs.Search(key);
            if (at < 0) { throw new KeyNotFoundException("The given key was not present in the dictionary."); }
            return pairs.values[at];
        }
        set {
            int at = pairs.Search(key);
            if (at >= 0) { pairs.values[at] = value; } else { pairs.Insert(~at, key, value); }
        }
    }

    public bool ContainsKey(K key) { return pairs.Search(key) >= 0; }

    public bool ContainsValue(V value) {
        IEqualityComparer<V> same = EqualityComparer<V>.Default;
        for (int i = 0; i < pairs.values.Count; i++) {
            if (same.Equals(pairs.values[i], value)) { return true; }
        }
        return false;
    }

    public bool TryGetValue(K key, out V value) {
        int at = pairs.Search(key);
        if (at < 0) { value = default(V); return false; }
        value = pairs.values[at];
        return true;
    }

    public bool Remove(K key) {
        int at = pairs.Search(key);
        if (at < 0) { return false; }
        pairs.RemoveAt(at);
        return true;
    }

    public void Clear() {
        pairs.keys.Clear();
        pairs.values.Clear();
    }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return new SortedPairsEnumerator<K, V>(pairs); }
}

// ---- PriorityQueue --------------------------------------------------------
//
// A BINARY HEAP: the smallest priority is always at the root, so Peek is free
// and both Enqueue and Dequeue cost a walk of the tree's depth. .NET's shape,
// with the ELEMENT AND ITS PRIORITY SEPARATE -- a work item and the time it is
// due, a node and its distance -- rather than making the element comparable.
//
// TIES ARE NOT ORDERED. Two items of equal priority come out in whichever
// order the heap happens to hold them, which is .NET's documented behaviour
// and not an accident of this implementation.

class PriorityQueue<TElement, TPriority> {
    private List<TElement> items;
    private List<TPriority> keys;
    private IComparer<TPriority> order;

    public PriorityQueue() {
        items = new List<TElement>();
        keys = new List<TPriority>();
        order = Comparer<TPriority>.Default;
    }

    public PriorityQueue(IComparer<TPriority> comparer) {
        items = new List<TElement>();
        keys = new List<TPriority>();
        order = comparer;
    }

    public int Count => items.Count;
    public IComparer<TPriority> Comparer => order;

    public void Enqueue(TElement element, TPriority priority) {
        items.Add(element);
        keys.Add(priority);
        Up(items.Count - 1);
    }

    public TElement Peek() {
        if (items.Count == 0) { throw new InvalidOperationException("The queue is empty."); }
        return items[0];
    }

    public TElement Dequeue() {
        if (items.Count == 0) { throw new InvalidOperationException("The queue is empty."); }

        TElement top = items[0];
        int last = items.Count - 1;

        items[0] = items[last];
        keys[0] = keys[last];
        items.RemoveAt(last);
        keys.RemoveAt(last);

        if (items.Count > 0) { Down(0); }
        return top;
    }

    public bool TryPeek(out TElement element, out TPriority priority) {
        if (items.Count == 0) {
            element = default(TElement);
            priority = default(TPriority);
            return false;
        }
        element = items[0];
        priority = keys[0];
        return true;
    }

    public bool TryDequeue(out TElement element, out TPriority priority) {
        if (items.Count == 0) {
            element = default(TElement);
            priority = default(TPriority);
            return false;
        }
        priority = keys[0];
        element = Dequeue();
        return true;
    }

    /// ENQUEUE AND DEQUEUE IN ONE, and cheaper than the two: when the new item
    /// is already the smallest it never enters the heap at all.
    public TElement EnqueueDequeue(TElement element, TPriority priority) {
        if (items.Count == 0 || order.Compare(priority, keys[0]) <= 0) { return element; }

        TElement top = items[0];

        items[0] = element;
        keys[0] = priority;
        Down(0);
        return top;
    }

    public void Clear() {
        items.Clear();
        keys.Clear();
    }

    private void Up(int at) {
        while (at > 0) {
            int parent = (at - 1) / 2;

            if (order.Compare(keys[at], keys[parent]) >= 0) { return; }
            Swap(at, parent);
            at = parent;
        }
    }

    private void Down(int at) {
        while (true) {
            int left = at * 2 + 1;
            int right = left + 1;
            int least = at;

            if (left < items.Count && order.Compare(keys[left], keys[least]) < 0) { least = left; }
            if (right < items.Count && order.Compare(keys[right], keys[least]) < 0) { least = right; }
            if (least == at) { return; }

            Swap(at, least);
            at = least;
        }
    }

    private void Swap(int a, int b) {
        TElement element = items[a];
        TPriority key = keys[a];

        items[a] = items[b];
        keys[a] = keys[b];
        items[b] = element;
        keys[b] = key;
    }
}

// ---- BitArray -------------------------------------------------------------
//
// System.Collections' array of bits, thirty-two to a word. A bool[] would do
// the same job at eight times the storage, which is exactly the trade the type
// exists to make -- a sieve or a free-space map is millions of bits.

class BitArray {
    private int[] words;
    private int length;

    public BitArray(int count) : this(count, false) {
    }

    public BitArray(int count, bool value) {
        if (count < 0) { throw new ArgumentOutOfRangeException("length"); }

        length = count;
        words = new int[(count + 31) / 32];
        if (value) { SetAll(true); }
    }

    public BitArray(bool[] values) {
        length = values.Length;
        words = new int[(length + 31) / 32];
        for (int i = 0; i < length; i++) { Set(i, values[i]); }
    }

    /// EIGHT BITS PER BYTE, the lowest bit of the first byte first, which is
    /// .NET's layout and the one a bitmap on disk is written in.
    public BitArray(byte[] bytes) {
        length = bytes.Length * 8;
        words = new int[(length + 31) / 32];
        for (int i = 0; i < bytes.Length; i++) {
            for (int bit = 0; bit < 8; bit++) {
                if (((bytes[i] >> bit) & 1) == 1) { Set(i * 8 + bit, true); }
            }
        }
    }

    public int Length => length;
    public int Count => length;

    public bool this[int index] {
        get { return Get(index); }
        set { Set(index, value); }
    }

    public bool Get(int index) {
        if (index < 0 || index >= length) { throw new ArgumentOutOfRangeException("index"); }
        return ((words[index / 32] >> (index % 32)) & 1) == 1;
    }

    public void Set(int index, bool value) {
        if (index < 0 || index >= length) { throw new ArgumentOutOfRangeException("index"); }

        int at = index / 32;
        int mask = 1 << (index % 32);

        if (value) { words[at] = words[at] | mask; } else { words[at] = words[at] & ~mask; }
    }

    public void SetAll(bool value) {
        int fill = value ? -1 : 0;

        for (int i = 0; i < words.Length; i++) { words[i] = fill; }
    }

    /// EACH OF THESE CHANGES THIS ARRAY and returns it, which is .NET's
    /// contract and the half that surprises people: `a.And(b)` is not a new
    /// array, it IS a, altered.
    public BitArray And(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] & other.Word(i); }
        return this;
    }

    public BitArray Or(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] | other.Word(i); }
        return this;
    }

    public BitArray Xor(BitArray other) {
        Same(other);
        for (int i = 0; i < words.Length; i++) { words[i] = words[i] ^ other.Word(i); }
        return this;
    }

    public BitArray Not() {
        for (int i = 0; i < words.Length; i++) { words[i] = ~words[i]; }
        return this;
    }

    public bool HasAnySet() {
        for (int i = 0; i < length; i++) {
            if (Get(i)) { return true; }
        }
        return false;
    }

    public bool HasAllSet() {
        for (int i = 0; i < length; i++) {
            if (!Get(i)) { return false; }
        }
        return true;
    }

    /// Not a .NET member: one storage word, so that And and its fellows can
    /// read another array's words. Privacy is per instance here.
    public int Word(int at) { return words[at]; }

    private void Same(BitArray other) {
        if (other == null) { throw new ArgumentNullException("value"); }
        if (other.Length != length) { throw new ArgumentException("Array lengths must be the same."); }
    }
}

// ---- System.Collections.ObjectModel ---------------------------------------
//
// A WRAPPER, NOT A COPY: these hand out a view of a live collection through an
// interface with no way to change it. What they promise is that the CALLER
// cannot add or remove -- the owner still can, and the view shows it.

class ReadOnlyDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>> {
    private IDictionary<K, V> inner;

    /// A read-only view of `dictionary`, reading through to it.
    public ReadOnlyDictionary(IDictionary<K, V> dictionary) {
        if (dictionary == null) { throw new ArgumentNullException("dictionary"); }
        inner = dictionary;
    }

    public int Count => inner.Count;
    public V this[K key] => inner[key];

    /// The dictionary it wraps.
    protected IDictionary<K, V> Dictionary => inner;

    public ReadOnlyCollection<K> Keys => new ReadOnlyCollection<K>(new List<K>(inner.Keys));
    public ReadOnlyCollection<V> Values => new ReadOnlyCollection<V>(new List<V>(inner.Values));
    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;
    ICollection<K> IDictionary<K, V>.Keys => Keys;
    ICollection<V> IDictionary<K, V>.Values => Values;

    public bool ContainsKey(K key) { return inner.ContainsKey(key); }

    public bool TryGetValue(K key, out V value) { return inner.TryGetValue(key, out value); }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return inner.GetEnumerator(); }

    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => true;
    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) { return inner.Contains(item); }
    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) { inner.CopyTo(array, arrayIndex); }

    V IDictionary<K, V>.this[K key] {
        get { return inner[key]; }
        set { throw ReadOnly(); }
    }

    void IDictionary<K, V>.Add(K key, V value) { throw ReadOnly(); }
    bool IDictionary<K, V>.Remove(K key) { throw ReadOnly(); }
    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) { throw ReadOnly(); }
    void ICollection<KeyValuePair<K, V>>.Clear() { throw ReadOnly(); }
    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) { throw ReadOnly(); }

    static NotSupportedException ReadOnly() { return new NotSupportedException("Collection is read-only."); }
}

// ---- StringCollection -----------------------------------------------------
//
// System.Collections.Specialized's list of strings, what Clipboard's file
// drop lists are: nulls allowed, duplicates kept, order as added.

class StringCollection : IEnumerable<string> {
    private List<string> items = new List<string>();

    public int Count => items.Count;

    public string this[int index] {
        get { return items[index]; }
        set { items[index] = value; }
    }

    public int Add(string value) { items.Add(value); return items.Count - 1; }

    public void AddRange(string[] value) {
        foreach (string s in value) { items.Add(s); }
    }

    public void Insert(int index, string value) { items.Insert(index, value); }
    public void Remove(string value) { items.Remove(value); }
    public void RemoveAt(int index) { items.RemoveAt(index); }
    public void Clear() { items.Clear(); }
    public bool Contains(string value) { return items.Contains(value); }
    public int IndexOf(string value) { return items.IndexOf(value); }

    public void CopyTo(string[] array, int index) {
        for (int i = 0; i < items.Count; i++) { array[index + i] = items[i]; }
    }

    public IEnumerator<string> GetEnumerator() { return items.GetEnumerator(); }
}

// ---- System.Collections.Concurrent -------------------------------------------
//
// Collections many threads may use at once without a lock of their own. Each
// guards itself with its own lock (Monitor); an enumeration is a snapshot
// taken under it, which is what .NET documents for the bag, the queue and the
// stack, and within what it promises for the dictionary -- an enumeration
// that may see changes made while it runs, or not.
namespace System.Collections.Concurrent
{
    /// A collection one thread can add to while another takes from it.
    interface IProducerConsumerCollection<T> : IEnumerable<T>, IReadOnlyCollection<T>
    {
        bool TryAdd(T item);
        bool TryTake(out T item);
        T[] ToArray();
        void CopyTo(T[] array, int index);
    }

    /// An unordered collection: what is taken is whatever the bag gives,
    /// last added first here, as .NET's does for the thread that added it.
    class ConcurrentBag<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
        readonly List<T> _items;
        readonly object _gate = new object();

        public ConcurrentBag()
        {
            _items = new List<T>();
        }

        public ConcurrentBag(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new List<T>(collection);
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Add(T item)
        {
            lock (_gate) { _items.Add(item); }
        }

        public bool TryAdd(T item)
        {
            Add(item);
            return true;
        }

        public bool TryTake(out T result)
        {
            lock (_gate)
            {
                int last = _items.Count - 1;
                if (last < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[last];
                _items.RemoveAt(last);
                return true;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                int last = _items.Count - 1;
                if (last < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[last];
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        public T[] ToArray()
        {
            lock (_gate) { return _items.ToArray(); }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            lock (_gate) { _items.CopyTo(array, index); }
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// First in, first out, for many threads.
    class ConcurrentQueue<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
        readonly Queue<T> _items;
        readonly object _gate = new object();

        public ConcurrentQueue()
        {
            _items = new Queue<T>();
        }

        public ConcurrentQueue(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new Queue<T>();
            foreach (T item in collection) { _items.Enqueue(item); }
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Enqueue(T item)
        {
            lock (_gate) { _items.Enqueue(item); }
        }

        public bool TryDequeue(out T result)
        {
            lock (_gate)
            {
                if (_items.Count == 0)
                {
                    result = default!;
                    return false;
                }
                result = _items.Dequeue();
                return true;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                if (_items.Count == 0)
                {
                    result = default!;
                    return false;
                }
                result = _items.Peek();
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        bool IProducerConsumerCollection<T>.TryAdd(T item)
        {
            Enqueue(item);
            return true;
        }

        bool IProducerConsumerCollection<T>.TryTake(out T item)
        {
            return TryDequeue(out item);
        }

        public T[] ToArray()
        {
            lock (_gate) { return _items.ToArray(); }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            T[] snapshot = ToArray();
            if (index < 0 || index > array.Length) { throw new ArgumentOutOfRangeException("index"); }
            if (array.Length - index < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[index + i] = snapshot[i]; }
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// Last in, first out, for many threads.
    class ConcurrentStack<T> : IProducerConsumerCollection<T>, IReadOnlyCollection<T>, IEnumerable<T>
    {
        readonly List<T> _items;
        readonly object _gate = new object();

        public ConcurrentStack()
        {
            _items = new List<T>();
        }

        public ConcurrentStack(IEnumerable<T> collection)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            _items = new List<T>(collection);
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public void Push(T item)
        {
            lock (_gate) { _items.Add(item); }
        }

        /// Pushes them in order, as one step: the last of them ends on top.
        public void PushRange(T[] items)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            PushRange(items, 0, items.Length);
        }

        public void PushRange(T[] items, int startIndex, int count)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            if (startIndex < 0 || count < 0 || startIndex > items.Length - count) { throw new ArgumentOutOfRangeException("startIndex"); }
            lock (_gate)
            {
                for (int i = 0; i < count; i++) { _items.Add(items[startIndex + i]); }
            }
        }

        public bool TryPop(out T result)
        {
            lock (_gate)
            {
                int top = _items.Count - 1;
                if (top < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[top];
                _items.RemoveAt(top);
                return true;
            }
        }

        /// Pops up to items.Length, top first, answering how many it took.
        public int TryPopRange(T[] items)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            return TryPopRange(items, 0, items.Length);
        }

        public int TryPopRange(T[] items, int startIndex, int count)
        {
            if (items == null) { throw new ArgumentNullException("items"); }
            if (startIndex < 0 || count < 0 || startIndex > items.Length - count) { throw new ArgumentOutOfRangeException("startIndex"); }
            lock (_gate)
            {
                int taken = 0;
                while (taken < count && _items.Count > 0)
                {
                    int top = _items.Count - 1;
                    items[startIndex + taken] = _items[top];
                    _items.RemoveAt(top);
                    taken = taken + 1;
                }
                return taken;
            }
        }

        public bool TryPeek(out T result)
        {
            lock (_gate)
            {
                int top = _items.Count - 1;
                if (top < 0)
                {
                    result = default!;
                    return false;
                }
                result = _items[top];
                return true;
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        bool IProducerConsumerCollection<T>.TryAdd(T item)
        {
            Push(item);
            return true;
        }

        bool IProducerConsumerCollection<T>.TryTake(out T item)
        {
            return TryPop(out item);
        }

        /// Top first, as .NET's is.
        public T[] ToArray()
        {
            lock (_gate)
            {
                T[] copy = new T[_items.Count];
                for (int i = 0; i < copy.Length; i++) { copy[i] = _items[_items.Count - 1 - i]; }
                return copy;
            }
        }

        public void CopyTo(T[] array, int index)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            T[] snapshot = ToArray();
            if (index < 0 || index > array.Length) { throw new ArgumentOutOfRangeException("index"); }
            if (array.Length - index < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[index + i] = snapshot[i]; }
        }

        public IEnumerator<T> GetEnumerator()
        {
            return ((IEnumerable<T>)ToArray()).GetEnumerator();
        }
    }

    /// A dictionary for many threads: every operation is one step, and the
    /// Get-or-Add and Add-or-Update forms are what make read-then-write safe.
    /// A value factory runs outside the lock, as .NET's does -- so it may run
    /// more than once for a key when threads race, and only one result is kept.
    class ConcurrentDictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>>
    {
        readonly Dictionary<K, V> _items;
        readonly object _gate = new object();

        public ConcurrentDictionary()
        {
            _items = new Dictionary<K, V>();
        }

        public ConcurrentDictionary(IEqualityComparer<K>? comparer)
        {
            _items = comparer == null ? new Dictionary<K, V>() : new Dictionary<K, V>(comparer);
        }

        public ConcurrentDictionary(IEnumerable<KeyValuePair<K, V>> collection) : this(collection, null)
        {
        }

        public ConcurrentDictionary(IEnumerable<KeyValuePair<K, V>> collection, IEqualityComparer<K>? comparer) : this(comparer)
        {
            if (collection == null) { throw new ArgumentNullException("collection"); }
            foreach (KeyValuePair<K, V> pair in collection)
            {
                if (!_items.TryAdd(pair.Key, pair.Value)) { throw new ArgumentException("The source argument contains duplicate keys."); }
            }
        }

        public ConcurrentDictionary(int concurrencyLevel, int capacity) : this()
        {
            if (concurrencyLevel < 1 && concurrencyLevel != -1) { throw new ArgumentOutOfRangeException("concurrencyLevel"); }
            if (capacity < 0) { throw new ArgumentOutOfRangeException("capacity"); }
        }

        public int Count { get { lock (_gate) { return _items.Count; } } }

        public bool IsEmpty { get { lock (_gate) { return _items.Count == 0; } } }

        public V this[K key]
        {
            get
            {
                if (TryGetValue(key, out V value)) { return value; }
                throw new KeyNotFoundException("The given key '" + key + "' was not present in the dictionary.");
            }
            set
            {
                lock (_gate) { _items[key] = value; }
            }
        }

        public ICollection<K> Keys { get { lock (_gate) { return new ReadOnlyCollection<K>(new List<K>(_items.Keys)); } } }

        public ICollection<V> Values { get { lock (_gate) { return new ReadOnlyCollection<V>(new List<V>(_items.Values)); } } }

        IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
        IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

        public bool ContainsKey(K key)
        {
            lock (_gate) { return _items.ContainsKey(key); }
        }

        public bool TryGetValue(K key, out V value)
        {
            lock (_gate) { return _items.TryGetValue(key, out value); }
        }

        public bool TryAdd(K key, V value)
        {
            lock (_gate) { return _items.TryAdd(key, value); }
        }

        public bool TryRemove(K key, out V value)
        {
            lock (_gate) { return _items.Remove(key, out value); }
        }

        /// Removes the pair only when the key still holds that value.
        public bool TryRemove(KeyValuePair<K, V> item)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(item.Key, out V held) && EqualityComparer<V>.Default.Equals(held, item.Value))
                {
                    return _items.Remove(item.Key);
                }
                return false;
            }
        }

        /// Replaces the value only when it is still `comparisonValue`.
        public bool TryUpdate(K key, V newValue, V comparisonValue)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(key, out V held) && EqualityComparer<V>.Default.Equals(held, comparisonValue))
                {
                    _items[key] = newValue;
                    return true;
                }
                return false;
            }
        }

        public V GetOrAdd(K key, V value)
        {
            lock (_gate)
            {
                if (_items.TryGetValue(key, out V held)) { return held; }
                _items.Add(key, value);
                return value;
            }
        }

        public V GetOrAdd(K key, Func<K, V> valueFactory)
        {
            if (valueFactory == null) { throw new ArgumentNullException("valueFactory"); }
            if (TryGetValue(key, out V held)) { return held; }
            V made = valueFactory(key);
            return GetOrAdd(key, made);
        }

        public V GetOrAdd<TArg>(K key, Func<K, TArg, V> valueFactory, TArg factoryArgument)
        {
            if (valueFactory == null) { throw new ArgumentNullException("valueFactory"); }
            if (TryGetValue(key, out V held)) { return held; }
            V made = valueFactory(key, factoryArgument);
            return GetOrAdd(key, made);
        }

        public V AddOrUpdate(K key, V addValue, Func<K, V, V> updateValueFactory)
        {
            if (updateValueFactory == null) { throw new ArgumentNullException("updateValueFactory"); }
            while (true)
            {
                if (TryGetValue(key, out V held))
                {
                    V updated = updateValueFactory(key, held);
                    if (TryUpdate(key, updated, held)) { return updated; }
                }
                else if (TryAdd(key, addValue))
                {
                    return addValue;
                }
            }
        }

        public V AddOrUpdate(K key, Func<K, V> addValueFactory, Func<K, V, V> updateValueFactory)
        {
            if (addValueFactory == null) { throw new ArgumentNullException("addValueFactory"); }
            if (updateValueFactory == null) { throw new ArgumentNullException("updateValueFactory"); }
            while (true)
            {
                if (TryGetValue(key, out V held))
                {
                    V updated = updateValueFactory(key, held);
                    if (TryUpdate(key, updated, held)) { return updated; }
                }
                else
                {
                    V added = addValueFactory(key);
                    if (TryAdd(key, added)) { return added; }
                }
            }
        }

        public void Clear()
        {
            lock (_gate) { _items.Clear(); }
        }

        public KeyValuePair<K, V>[] ToArray()
        {
            lock (_gate)
            {
                KeyValuePair<K, V>[] copy = new KeyValuePair<K, V>[_items.Count];
                int i = 0;
                foreach (KeyValuePair<K, V> pair in _items)
                {
                    copy[i] = pair;
                    i = i + 1;
                }
                return copy;
            }
        }

        public IEnumerator<KeyValuePair<K, V>> GetEnumerator()
        {
            return ((IEnumerable<KeyValuePair<K, V>>)ToArray()).GetEnumerator();
        }

        void IDictionary<K, V>.Add(K key, V value)
        {
            if (!TryAdd(key, value)) { throw new ArgumentException("An item with the same key has already been added. Key: " + key); }
        }

        bool IDictionary<K, V>.Remove(K key)
        {
            return TryRemove(key, out V _);
        }

        bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

        void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item)
        {
            ((IDictionary<K, V>)this).Add(item.Key, item.Value);
        }

        bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item)
        {
            return TryGetValue(item.Key, out V held) && EqualityComparer<V>.Default.Equals(held, item.Value);
        }

        void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex)
        {
            if (array == null) { throw new ArgumentNullException("array"); }
            KeyValuePair<K, V>[] snapshot = ToArray();
            if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex"); }
            if (array.Length - arrayIndex < snapshot.Length) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
            for (int i = 0; i < snapshot.Length; i++) { array[arrayIndex + i] = snapshot[i]; }
        }

        bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item)
        {
            return TryRemove(item);
        }
    }
}

