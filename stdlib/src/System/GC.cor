// System.GC: what a program may ask of the garbage collector, with .NET's
// names and answers, over the runtime's collector (runtime/src/core/gc.cor).
//
// ONE GENERATION, AS ANSWERED. The collector is a non-moving mark-sweep,
// generational on i386 by sticky marks (gc.cor, "generations") and
// concurrent where there are threads, but what a program is told is of one
// generation: MaxGeneration is 0, every collection counts as generation 0's,
// and asking for an older generation collects the same heap. .NET permits
// exactly this: MaxGeneration is whatever the runtime says it has.
//
// KEEPALIVE needs no trick here. The collector reads every word of every
// stack and treats any that points into a block -- the block's start or
// anywhere inside it -- as a reference, so an object passed to a call is
// reachable until the call, which is all .NET promises of KeepAlive.
//
// NO FINALIZERS run on this runtime, so SuppressFinalize and
// ReRegisterForFinalize have nothing to change and WaitForPendingFinalizers
// has nothing to wait for; each still checks its argument as .NET does.

namespace System;

public static class GC
{
    /// The oldest generation there is: 0, the only one.
    public static int MaxGeneration { get { return 0; } }

    /// A full collection now.
    public static void Collect() { Gc.Collect(); }

    public static void Collect(int generation) { Collect(generation, GCCollectionMode.Default, true, false); }

    public static void Collect(int generation, GCCollectionMode mode) { Collect(generation, mode, true, mode == GCCollectionMode.Aggressive); }

    public static void Collect(int generation, GCCollectionMode mode, bool blocking) { Collect(generation, mode, blocking, mode == GCCollectionMode.Aggressive); }

    /// .NET's checks, then a full collection however it is asked: this
    /// collector does every one the same way, and compacts none. Aggressive
    /// is refused unless blocking and compacting, as .NET refuses it, but
    /// not by the overloads that leave the two to it.
    public static void Collect(int generation, GCCollectionMode mode, bool blocking, bool compacting)
    {
        ArgumentOutOfRangeException.ThrowIfNegative(generation);
        if (mode < GCCollectionMode.Default || mode > GCCollectionMode.Aggressive)
        {
            throw new ArgumentOutOfRangeException(nameof(mode), "Enum value was out of legal range.");
        }
        if (mode == GCCollectionMode.Aggressive && !blocking)
        {
            throw new ArgumentException("AggressiveGC requires setting the blocking parameter to true.", nameof(blocking));
        }
        if (mode == GCCollectionMode.Aggressive && !compacting)
        {
            throw new ArgumentException("AggressiveGC requires setting the compacting parameter to true.", nameof(compacting));
        }
        Gc.Collect();
    }

    /// How many collections of `generation` have run: all of them for 0,
    /// none for a generation this collector does not have.
    public static int CollectionCount(int generation)
    {
        ArgumentOutOfRangeException.ThrowIfNegative(generation);
        return generation == 0 ? (int)Gc.Collections : 0;
    }

    /// Every object is in generation 0.
    public static int GetGeneration(object obj)
    {
        if (obj == null) throw new ArgumentNullException(nameof(obj));
        return 0;
    }

    /// The bytes thought to be in use: what the last collection found live
    /// and what has been allocated since -- after a collection, if asked.
    public static long GetTotalMemory(bool forceFullCollection)
    {
        if (forceFullCollection) Gc.Collect();
        return Gc.LiveBytes + Gc.Since;
    }

    /// The bytes allocated since the program began. Other threads' current
    /// allocation buffers are counted as they are retired, which is the
    /// imprecision .NET allows when `precise` is false; asked precisely, as
    /// they stand -- read, not collected: .NET never collects here, and a
    /// collection made every allocation profiler's question a pause.
    public static long GetTotalAllocatedBytes(bool precise)
    {
        return precise ? Gc.AllocatedPrecisely : Gc.Allocated;
    }

    public static long GetTotalAllocatedBytes() { return GetTotalAllocatedBytes(false); }

    /// How long the program has stood still for the collector, in all:
    /// every collection, the whole of which the thread that made it waited.
    public static TimeSpan GetTotalPauseDuration() { return new TimeSpan(Gc.PauseMicros * 10); }

    /// The bytes this thread has allocated since it began.
    public static long GetAllocatedBytesForCurrentThread() { return Gc.AllocatedByThread; }

    /// Keeps `obj` reachable up to this call. It was an empty method, which
    /// kept nothing: inlined, it was no use of `obj` at all, and the collector
    /// could take an object whose address a system call was still reading.
    public static void KeepAlive(object? obj) { Sys.KeepAlive(obj); }

    public static void SuppressFinalize(object obj)
    {
        if (obj == null) throw new ArgumentNullException(nameof(obj));
    }

    public static void ReRegisterForFinalize(object obj)
    {
        if (obj == null) throw new ArgumentNullException(nameof(obj));
    }

    public static void WaitForPendingFinalizers() { }

    // ---- memory pressure ---------------------------------------------------
    //
    // MEMORY THE COLLECTOR DOES NOT SEE, held by objects it does -- a native
    // buffer behind a managed handle. Added up as .NET does; once what was
    // added since the last collection passes what that collection found
    // live (a megabyte at least), a collection is made, as .NET's own
    // heuristic makes one for pressure piling up.
    static long _pressure;
    static long _pressureSince;
    static long _pressureCollections;

    public static void AddMemoryPressure(long bytesAllocated)
    {
        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(bytesAllocated);
        _pressure = _pressure + bytesAllocated;
        if (_pressureCollections != Gc.Collections)
        {
            _pressureCollections = Gc.Collections;
            _pressureSince = 0;
        }
        _pressureSince = _pressureSince + bytesAllocated;
        long live = Gc.LiveBytes;
        if (_pressureSince > (live > 1048576 ? live : 1048576))
        {
            _pressureSince = 0;
            Gc.Collect();
            _pressureCollections = Gc.Collections;
        }
    }

    public static void RemoveMemoryPressure(long bytesAllocated)
    {
        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(bytesAllocated);
        _pressure = _pressure > bytesAllocated ? _pressure - bytesAllocated : 0;
    }

    // ---- arrays ------------------------------------------------------------
    //
    // An array left unzeroed, or pinned: every array here is zeroed as it is
    // made, and nothing ever moves, so both are the array a `new` makes --
    // and refuse a negative length as it does (OverflowException).

    public static T[] AllocateUninitializedArray<T>(int length, bool pinned = false) { return new T[length]; }

    public static T[] AllocateArray<T>(int length, bool pinned = false) { return new T[length]; }

    // ---- no-collection regions ---------------------------------------------
    //
    // ENTERED AND LEFT AS .NET'S ARE, a collection made first to give the
    // region its room; the latency mode says NoGCRegion while one is open.
    // This collector does not hold its collections off inside one -- a cycle
    // the heap asks for still runs -- which .NET too allows when the region's
    // size is passed.
    static bool _noGCRegion;
    internal static bool InNoGCRegion => _noGCRegion;

    /// A latency mode asked for while a region is open: the region left, as
    /// .NET leaves it, before the setter refuses (GCSettings.LatencyMode).
    internal static void LeaveNoGCRegion() { _noGCRegion = false; }

    public static bool TryStartNoGCRegion(long totalSize) { return StartNoGCRegion(totalSize); }

    public static bool TryStartNoGCRegion(long totalSize, long lohSize) { return StartNoGCRegion(totalSize); }

    public static bool TryStartNoGCRegion(long totalSize, bool disallowFullBlockingGC) { return StartNoGCRegion(totalSize); }

    public static bool TryStartNoGCRegion(long totalSize, long lohSize, bool disallowFullBlockingGC) { return StartNoGCRegion(totalSize); }

    static bool StartNoGCRegion(long totalSize)
    {
        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(totalSize);
        if (_noGCRegion)
        {
            // .NET's: the region already open is left as it refuses another.
            _noGCRegion = false;
            throw new InvalidOperationException("The NoGCRegion mode was already in progress.");
        }
        Gc.Collect();
        _noGCRegion = true;
        return true;
    }

    public static void EndNoGCRegion()
    {
        if (!_noGCRegion)
        {
            throw new InvalidOperationException("NoGCRegion mode must be set.");
        }
        _noGCRegion = false;
    }

    // ---- full-collection notification --------------------------------------
    //
    // REGISTERED AS .NET'S IS, its thresholds checked. This collector raises
    // no notification: a wait on a registration times out, or for ever
    // ends only when it is cancelled; with none registered it is not
    // applicable.
    static bool _fullGCRegistered;
    static int _fullGCCancels;

    public static void RegisterForFullGCNotification(int maxGenerationThreshold, int largeObjectHeapThreshold)
    {
        if (maxGenerationThreshold <= 0 || maxGenerationThreshold >= 100)
        {
            throw new ArgumentOutOfRangeException(nameof(maxGenerationThreshold), "Argument must be between 1 and 99.");
        }
        if (largeObjectHeapThreshold <= 0 || largeObjectHeapThreshold >= 100)
        {
            throw new ArgumentOutOfRangeException(nameof(largeObjectHeapThreshold), "Argument must be between 1 and 99.");
        }
        _fullGCRegistered = true;
    }

    public static void CancelFullGCNotification()
    {
        _fullGCRegistered = false;
        _fullGCCancels = _fullGCCancels + 1;
    }

    public static GCNotificationStatus WaitForFullGCApproach() { return WaitForFullGC(-1); }

    public static GCNotificationStatus WaitForFullGCApproach(int millisecondsTimeout) { return WaitForFullGC(millisecondsTimeout); }

    public static GCNotificationStatus WaitForFullGCApproach(TimeSpan timeout) { return WaitForFullGC(Timeouts.Guarded(timeout)); }

    public static GCNotificationStatus WaitForFullGCComplete() { return WaitForFullGC(-1); }

    public static GCNotificationStatus WaitForFullGCComplete(int millisecondsTimeout) { return WaitForFullGC(millisecondsTimeout); }

    public static GCNotificationStatus WaitForFullGCComplete(TimeSpan timeout) { return WaitForFullGC(Timeouts.Guarded(timeout)); }

    static GCNotificationStatus WaitForFullGC(int millisecondsTimeout)
    {
        ArgumentOutOfRangeException.ThrowIfLessThan(millisecondsTimeout, -1);
        if (!_fullGCRegistered) return GCNotificationStatus.NotApplicable;
        if (millisecondsTimeout >= 0)
        {
            if (millisecondsTimeout > 0) Clock.SleepUntil(Clock.Now() + (long)millisecondsTimeout * 1000000);
            return _fullGCRegistered ? GCNotificationStatus.Timeout : GCNotificationStatus.Canceled;
        }
        int cancels = _fullGCCancels;
        while (_fullGCCancels == cancels) Clock.SleepUntil(Clock.Now() + 10000000);
        return GCNotificationStatus.Canceled;
    }

    // ---- the collector's configuration -------------------------------------

    /// The heap's limits as they are asked again: here they are read as the
    /// collector paces each cycle, so there is nothing to refresh.
    public static void RefreshMemoryLimit() { }

    /// What the collector was configured with, under .NET's names: no server
    /// collector, one heap, the hard limit the cap sets (0 for none).
    public static IReadOnlyDictionary<string, object> GetConfigurationVariables()
    {
        Dictionary<string, object> made = new Dictionary<string, object>();
        made["ServerGC"] = false;
        made["ConcurrentGC"] = true;
        made["RetainVM"] = false;
        made["GCHeapHardLimit"] = Gc.CapToBe();
        made["GCHeapHardLimitPercent"] = 0L;
        made["GCConserveMem"] = 0L;
        made["GCLargePages"] = false;
        made["HeapCount"] = 1L;
        made["MaxHeapCount"] = 1L;
        made["GCName"] = "";
        return made;
    }

    /// What the collector knew at its last collection: how much memory it
    /// may use (the heap's cap when one is set, the machine's memory
    /// otherwise -- from the start, before the heap has begun, as .NET
    /// answers its hard limit before it has allocated), how full the machine
    /// is, and how big the heap is. The load past which memory is high is
    /// .NET's nine tenths of the machine -- of what a 32-bit process's
    /// address space leaves it -- whatever the cap. One generation,
    /// never compacted, never concurrent (see the top of this file); the
    /// kind asked for changes nothing, as every collection here is the same
    /// kind.
    public static GCMemoryInfo GetGCMemoryInfo()
    {
        return GetGCMemoryInfo(GCKind.Any);
    }

    public static GCMemoryInfo GetGCMemoryInfo(GCKind kind)
    {
        if (kind < GCKind.Any || kind > GCKind.Background)
        {
            throw new ArgumentOutOfRangeException(nameof(kind));
        }
        long physical = Platform.TotalMemory();
        long cap = Gc.CapToBe();
        long total = cap != 0 && (physical == 0 || cap < physical) ? cap : physical;
        // A 32-bit process can hold no more than its address space leaves the
        // heap, whatever the machine has: that is the limit .NET reports for a
        // process, and what a build admitting work by it must see.
        long ceiling = Gc.CeilingToBe();
        if (ceiling != 0 && (total == 0 || ceiling < total)) total = ceiling;
        // -1 where the platform cannot say; 0 is none left, all of it loaded.
        long available = Platform.AvailableMemory();
        long load = physical != 0 && available >= 0 ? physical - available : Gc.HeapBytes;
        long heap = Gc.HeapBytes;
        long live = Gc.LiveBytes;
        long high = physical != 0 ? physical : total;
        if (ceiling != 0 && ceiling < high) high = ceiling;
        return new GCMemoryInfo(total, high / 10 * 9, load, heap, heap > live ? heap - live : 0, heap, live, Gc.Collections);
    }
}

/// What a wait on a full collection's notification answers, as .NET's.
public enum GCNotificationStatus
{
    Succeeded = 0,
    Failed = 1,
    Canceled = 2,
    Timeout = 3,
    NotApplicable = 4,
}

/// How a collection may be done, as .NET names it; this collector does every
/// one the same way.
public enum GCCollectionMode
{
    Default = 0,
    Forced = 1,
    Optimized = 2,
    Aggressive = 3,
}

/// Which collections GetGCMemoryInfo reports on, as .NET names them.
public enum GCKind
{
    Any = 0,
    Ephemeral = 1,
    FullBlocking = 2,
    Background = 3,
}

/// What the collector reported about memory at a collection (System.GCMemoryInfo).
public readonly struct GCMemoryInfo
{
    readonly long _total;
    readonly long _threshold;
    readonly long _load;
    readonly long _heap;
    readonly long _fragmented;
    readonly long _committed;
    readonly long _promoted;
    readonly long _index;

    public GCMemoryInfo(long total, long threshold, long load, long heap, long fragmented, long committed, long promoted, long index)
    {
        _total = total;
        _threshold = threshold;
        _load = load;
        _heap = heap;
        _fragmented = fragmented;
        _committed = committed;
        _promoted = promoted;
        _index = index;
    }

    /// The memory the collector may use: its hard limit, or the machine's.
    public long TotalAvailableMemoryBytes => _total;

    /// The load past which memory counts as high: 90% of the total.
    public long HighMemoryLoadThresholdBytes => _threshold;

    /// Memory in use on the machine when the collection ran.
    public long MemoryLoadBytes => _load;

    public long HeapSizeBytes => _heap;
    public long FragmentedBytes => _fragmented;
    public long TotalCommittedBytes => _committed;

    /// What survived the collection: every live byte, as there is only one generation.
    public long PromotedBytes => _promoted;

    /// Which collection this was, counting from the first.
    public long Index => _index;

    public int Generation => 0;
    public bool Compacted => false;
    public bool Concurrent => false;
    public long PinnedObjectsCount => 0;
    public long FinalizationPendingCount => 0;
    public double PauseTimePercentage => 0.0;
}

