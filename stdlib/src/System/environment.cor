// System.Environment: the process's arguments, environment, working
// directory and exit, as .NET spells them. CurrentManagedThreadId is the
// Linux runtime's (runtime/src/platforms/linux/threading.cor), beside Thread.
static partial class Environment
{
    static string[]? _args;
    static string[]? _env;
    public static int ExitCode;
    public static string NewLine => "\n";

    /// The processors this process may run on.
    public static int ProcessorCount { get { return Os.ProcessorCount(); } }

    /// Whether this process is a 64-bit image: the long-mode target's.
    public static bool Is64BitProcess => WordSize.Bytes == 8;

    /// Whether the kernel under it is 64-bit, which a 32-bit image on an
    /// x86-64 kernel is not, as .NET answers it.
    public static bool Is64BitOperatingSystem => Is64BitProcess
        || System.Runtime.InteropServices.RuntimeInformation.OSArchitecture is
            System.Runtime.InteropServices.Architecture.X64 or System.Runtime.InteropServices.Architecture.Arm64;

    /// THE PROGRAM'S OWN PATH, which .NET 6 added and which is the only honest
    /// way to find anything installed beside it. /proc/self/exe is what the
    /// kernel answers with; argv[0] is what the caller chose to say and may be
    /// a bare name found on PATH.
    public static string? ProcessPath
    {
        get
        {
            string? real = Os.Readlink("/proc/self/exe");

            if (real != null) { return real; }

            string[] argv = GetCommandLineArgs();

            return argv.Length > 0 ? argv[0] : null;
        }
    }

    /// argv as the kernel laid it on the entry stack, argv[0] included, as
    /// .NET's GetCommandLineArgs has it.
    public static string[] GetCommandLineArgs()
    {
        string[]? have = _args;
        if (have != null)
        {
            return have;
        }
        long sp = Os.MainEntryStack();
        int argc = (int)Sys.Peek(sp);
        string[] args = new string[argc];
        for (int i = 0; i < argc; i++)
        {
            args[i] = Os.StringAt(Sys.Peek(sp + WordSize.Bytes + WordSize.Bytes * i));
        }
        _args = args;
        return args;
    }

    static string[] Environ()
    {
        string[]? have = _env;
        if (have != null)
        {
            return have;
        }
        long sp = Os.MainEntryStack();
        long argc = Sys.Peek(sp);
        long at = sp + WordSize.Bytes + WordSize.Bytes * argc + WordSize.Bytes;
        int n = 0;
        while (Sys.Peek(at + WordSize.Bytes * n) != 0)
        {
            n = n + 1;
        }
        string[] all = new string[n];
        for (int i = 0; i < n; i++)
        {
            all[i] = Os.StringAt(Sys.Peek(at + WordSize.Bytes * i));
        }
        _env = all;
        return all;
    }

    /// The address of envp, for execve.
    public static long EnvironAddress()
    {
        return Os.EnvironAddress();
    }

    public static string[] EnvironmentBlock()
    {
        return Environ();
    }

    public static string? GetEnvironmentVariable(string name)
    {
        // Null refused by .NET's name for it.
        if (name == null) throw new ArgumentNullException("variable");
        string[] all = Environ();
        for (int i = 0; i < all.Length; i++)
        {
            string entry = all[i];
            if (entry.Length > name.Length && entry[name.Length] == '=' && String.StartsWith(entry, name))
            {
                return entry.Substring(name.Length + 1);
            }
        }
        return null;
    }

    /// Sets, or with a null or empty value removes, a variable of this
    /// process's environment, as .NET does. It reaches what this process
    /// starts from now on (UnixProcess.Exec, Process.Start); the process's
    /// original block, which the kernel handed over, is left as it was.
    public static void SetEnvironmentVariable(string variable, string? value)
    {
        if (variable == null) throw new ArgumentNullException("variable");
        if (variable.Length == 0 || variable.IndexOf('=') >= 0 || variable[0] == '\0')
            throw new ArgumentException("not a variable name: " + variable, "variable");
        string[] all = Environ();
        List<string> made = new List<string>();
        for (int i = 0; i < all.Length; i++)
        {
            string entry = all[i];
            if (entry.Length > variable.Length && entry[variable.Length] == '=' && String.StartsWith(entry, variable)) continue;
            made.Add(entry);
        }
        if (value != null && value.Length > 0) made.Add(variable + "=" + value);
        _env = made.ToArray();
        _changed = true;
    }

    static bool _changed;

    /// Whether SetEnvironmentVariable has changed the block since the start.
    public static bool EnvironmentChanged => _changed;

    public static Dictionary<string, string> GetEnvironmentVariables()
    {
        Dictionary<string, string> vars = new Dictionary<string, string>();
        string[] all = Environ();
        for (int i = 0; i < all.Length; i++)
        {
            int eq = all[i].IndexOf('=');
            // The FIRST of a name given twice, as .NET's reading of the
            // block keeps it -- and as GetEnvironmentVariable answers.
            if (eq > 0)
            {
                vars.TryAdd(all[i].Substring(0, eq), all[i].Substring(eq + 1));
            }
        }
        return vars;
    }

    public static string CurrentDirectory
    {
        get
        {
            string? cwd = Os.Getcwd();
            return cwd == null ? "/" : cwd;
        }
        set
        {
            ArgumentException.ThrowIfNullOrEmpty(value);
            int r = Os.Chdir(value);
            if (r < 0)
            {
                throw Interop.GetExceptionForIoErrno(r, value, true);
            }
        }
    }

    public static int ProcessId
    {
        get { return Os.Getpid(); }
    }

    /// THE CALLS THAT LED HERE, in the same wording an exception's own
    /// StackTrace uses -- `   at Type.Method in file.cor:line N`, newest
    /// first, one to a line.
    ///
    /// The frame pointer is read HERE and handed over rather than read inside
    /// the walk, so the answer does not change with what the optimiser
    /// inlined into what.
    public static string StackTrace
    {
        get { return Runtime.Trace(Sys.FramePointer()); }
    }

    /// Where the system keeps each kind of folder, as .NET numbers them
    /// (Windows' CSIDL values).
    public enum SpecialFolder
    {
        Desktop = 0, Programs = 2, MyDocuments = 5, Personal = 5, Favorites = 6, Startup = 7, Recent = 8,
        SendTo = 9, StartMenu = 11, MyMusic = 13, MyVideos = 14, DesktopDirectory = 16, MyComputer = 17,
        NetworkShortcuts = 19, Fonts = 20, Templates = 21, CommonStartMenu = 22, CommonPrograms = 23,
        CommonStartup = 24, CommonDesktopDirectory = 25, ApplicationData = 26, PrinterShortcuts = 27,
        LocalApplicationData = 28, InternetCache = 32, Cookies = 33, History = 34, CommonApplicationData = 35,
        Windows = 36, System = 37, ProgramFiles = 38, MyPictures = 39, UserProfile = 40, SystemX86 = 41,
        ProgramFilesX86 = 42, CommonProgramFiles = 43, CommonProgramFilesX86 = 44, CommonTemplates = 45,
        CommonDocuments = 46, CommonAdminTools = 47, AdminTools = 48, CommonMusic = 53, CommonPictures = 54,
        CommonVideos = 55, Resources = 56, LocalizedResources = 57, CommonOemLinks = 58, CDBurning = 59,
    }

    /// What GetFolderPath does about a folder that is not there: answer ""
    /// (None), make it (Create), or answer the path regardless (DoNotVerify).
    public enum SpecialFolderOption
    {
        None = 0,
        Create = 32768,
        DoNotVerify = 16384,
    }

    public static string GetFolderPath(SpecialFolder folder)
    {
        return GetFolderPath(folder, SpecialFolderOption.None);
    }

    /// The folder's path as .NET finds it on Unix: the home directory for
    /// the user's own, the XDG base directories for application data, the
    /// user's XDG directories (user-dirs.dirs) for the desktop, documents,
    /// music, pictures, videos and templates, fixed paths for the shared
    /// ones, and "" for a kind of folder Unix has no place for.
    public static string GetFolderPath(SpecialFolder folder, SpecialFolderOption option)
    {
        if (option != SpecialFolderOption.None && option != SpecialFolderOption.Create && option != SpecialFolderOption.DoNotVerify)
        {
            throw new ArgumentOutOfRangeException(nameof(option));
        }
        string path = FolderPath(folder);
        if (path.Length == 0 || option == SpecialFolderOption.DoNotVerify)
        {
            return path;
        }
        if (!Os.Exists(path))
        {
            if (option != SpecialFolderOption.Create)
            {
                return "";
            }
            MakeDirectories(path);
        }
        return path;
    }

    static string FolderPath(SpecialFolder folder)
    {
        switch (folder)
        {
            case SpecialFolder.CommonApplicationData: return "/usr/share";
            case SpecialFolder.CommonTemplates: return "/usr/share/templates";
        }
        string home = HomeDirectory();
        switch (folder)
        {
            case SpecialFolder.UserProfile: return home;
            case SpecialFolder.MyDocuments: return UserDirectory(home, "XDG_DOCUMENTS_DIR", "Documents");
            case SpecialFolder.ApplicationData: return BaseDirectory("XDG_CONFIG_HOME", home, ".config");
            case SpecialFolder.LocalApplicationData: return BaseDirectory("XDG_DATA_HOME", home, ".local/share");
            case SpecialFolder.Desktop:
            case SpecialFolder.DesktopDirectory: return UserDirectory(home, "XDG_DESKTOP_DIR", "Desktop");
            case SpecialFolder.Templates: return UserDirectory(home, "XDG_TEMPLATES_DIR", "Templates");
            case SpecialFolder.MyVideos: return UserDirectory(home, "XDG_VIDEOS_DIR", "Videos");
            case SpecialFolder.MyMusic: return UserDirectory(home, "XDG_MUSIC_DIR", "Music");
            case SpecialFolder.MyPictures: return UserDirectory(home, "XDG_PICTURES_DIR", "Pictures");
            case SpecialFolder.Fonts: return Joined(home, ".fonts");
        }
        return "";
    }

    /// $HOME, or the root when a process was started without one.
    static string HomeDirectory()
    {
        string? home = GetEnvironmentVariable("HOME");
        return string.IsNullOrEmpty(home) ? "/" : home;
    }

    /// An XDG base directory: the variable when it names an absolute path,
    /// otherwise its default under the home directory.
    static string BaseDirectory(string variable, string home, string fallback)
    {
        string? set = GetEnvironmentVariable(variable);
        return !string.IsNullOrEmpty(set) && set[0] == '/' ? set : Joined(home, fallback);
    }

    /// One of the user's XDG directories: the variable if it is set, then
    /// the line for it in user-dirs.dirs (`XDG_DESKTOP_DIR="$HOME/Desktop"`),
    /// then the conventional name under the home directory.
    static string UserDirectory(string home, string key, string fallback)
    {
        string? set = GetEnvironmentVariable(key);
        if (!string.IsNullOrEmpty(set) && set[0] == '/')
        {
            return set;
        }
        string config = BaseDirectory("XDG_CONFIG_HOME", home, ".config");
        string? text = ReadSmallFile(Joined(config, "user-dirs.dirs"));
        if (text != null)
        {
            foreach (string raw in text.Split('\n'))
            {
                string line = raw.Trim();
                if (!line.StartsWith(key) || line.Length <= key.Length || line[key.Length] != '=')
                {
                    continue;
                }
                string value = line.Substring(key.Length + 1).Trim();
                if (value.Length >= 2 && value[0] == '"' && value[value.Length - 1] == '"')
                {
                    value = value.Substring(1, value.Length - 2);
                }
                if (value.StartsWith("$HOME/"))
                {
                    return Joined(home, value.Substring(6));
                }
                if (value == "$HOME")
                {
                    return home;
                }
                if (value.StartsWith("/"))
                {
                    return value;
                }
            }
        }
        return Joined(home, fallback);
    }

    static string Joined(string directory, string name)
    {
        return directory.EndsWith("/") ? directory + name : directory + "/" + name;
    }

    /// A small file's text, or null when it cannot be read. DECODED WHOLE,
    /// once read: a character whose bytes a read split was two halves when
    /// each read was decoded on its own.
    static string? ReadSmallFile(string path)
    {
        int fd = Os.Open(path, 0);
        if (fd < 0)
        {
            return null;
        }
        byte[] buffer = new byte[4096];
        int have = 0;
        while (true)
        {
            if (have == buffer.Length)
            {
                byte[] wider = new byte[buffer.Length * 2];
                Array.Copy(buffer, wider, have);
                buffer = wider;
            }
            int got = Os.Read(fd, buffer, have, buffer.Length - have);
            if (got <= 0)
            {
                break;
            }
            have = have + got;
        }
        Os.Close(fd);
        return System.Text.Encoding.UTF8.GetString(buffer, 0, have);
    }

    /// Every missing directory along the path, outermost first.
    static void MakeDirectories(string path)
    {
        int at = 1;
        while (at <= path.Length)
        {
            int slash = path.IndexOf('/', at);
            string part = slash < 0 ? path : path.Substring(0, slash);
            if (part.Length > 0 && !Os.Exists(part))
            {
                Os.Mkdir(part, 0x1FF);
            }
            if (slash < 0)
            {
                break;
            }
            at = slash + 1;
        }
    }

    /// WHO THE PROCESS RUNS AS: its effective uid's name in the password
    /// file, as .NET looks it up (getpwuid_r), "" for a uid it does not list
    /// -- not $USER, which whatever started the process set to anything.
    /// Where the platform has no users (EffectiveUserId -1), the variable is
    /// all there is.
    public static string UserName
    {
        get
        {
            long uid = Os.EffectiveUserId();
            if (uid < 0)
            {
                // USER on a Unix with none in its files, USERNAME on Windows.
                string? user = GetEnvironmentVariable("USER") ?? GetEnvironmentVariable("USERNAME");
                return user == null ? "" : user;
            }
            // READ BY THE RUNTIME'S OWN CALLS (ReadSmallFile): File is
            // System.IO's, a library above this one.
            string? passwd = ReadSmallFile("/etc/passwd");
            if (passwd == null) return "";
            string wanted = uid.ToString();
            foreach (string line in passwd.Split('\n'))
            {
                // name:password:uid:gid:...
                int first = line.IndexOf(':');
                if (first <= 0) continue;
                int second = line.IndexOf(':', first + 1);
                if (second < 0) continue;
                int third = line.IndexOf(':', second + 1);
                if (third < 0) continue;
                if (third - second - 1 == wanted.Length && string.CompareOrdinal(line, second + 1, wanted, 0, wanted.Length) == 0)
                    return line.Substring(0, first);
            }
            return "";
        }
    }

    /// .NET's on Unix: the machine's name, the domain it is in being none
    /// the process can ask.
    public static string UserDomainName => MachineName;


    /// The name this machine goes by on the network, as its platform knows
    /// it (Os.NodeName: uname(2)'s nodename on Linux, where .NET reads it);
    /// "localhost" where it has none.
    public static string MachineName
    {
        get
        {
            // The host's name up to its first dot, as .NET's MachineName.
            string? name = Os.NodeName();
            if (name == null || name.Length == 0) return "localhost";
            int dot = name.IndexOf('.');
            return dot > 0 ? name.Substring(0, dot) : name;
        }
    }

    /// `%NAME%` replaced by the variable's value wherever the variable is
    /// set, and left as written where it is not -- .NET's rule, which is
    /// Windows' ExpandEnvironmentStrings.
    public static string ExpandEnvironmentVariables(string name)
    {
        if (name == null) throw new ArgumentNullException(nameof(name));
        string made = "";
        int at = 0;
        while (at < name.Length)
        {
            int open = name.IndexOf('%', at);
            if (open < 0) { made = made + name.Substring(at); break; }
            int close = name.IndexOf('%', open + 1);
            if (close < 0) { made = made + name.Substring(at); break; }
            string variable = name.Substring(open + 1, close - open - 1);
            string? value = variable.Length > 0 ? GetEnvironmentVariable(variable) : null;
            made = made + name.Substring(at, open - at);
            if (value != null) { made = made + value; at = close + 1; }
            else { made = made + "%" + variable; at = close; }       // the closing % may open the next one
        }
        return made;
    }

    /// Milliseconds since the system started, as .NET's: the monotonic
    /// clock, which nothing sets back. (The wall clock, which this was, is
    /// milliseconds since 1970, and wrapped to a negative int at once.)
    public static long TickCount64
    {
        get { return Os.Nanos(ClockId.Monotonic) / 1000000; }
    }

    /// The same, wrapping every 49.7 days as .NET's does.
    public static int TickCount
    {
        get { return (int)(Os.Nanos(ClockId.Monotonic) / 1000000); }
    }

    /// Ends the process now, flushing the console first, as .NET does.
    /// Os.Exit runs whatever was left with Runtime.OnExit, which is the
    /// flush. [DoesNotReturn], as .NET's: a null check that ends in it
    /// guards what follows.
    [DoesNotReturn]
    public static void Exit(int code)
    {
        Os.Exit(code);
    }

}

/// System.AppContext -- where the program was loaded from, and the switches it
/// was started with. BaseDirectory is the one this compiler uses to find the
/// class library beside itself.
///
/// WHAT THE IMAGE WAS BUILT WITH IS DATA HERE TOO: corc's --runtime-knob
/// NAME=VALUE (a project's RuntimeHostConfigurationOption) is answered by
/// GetData as a string, and by TryGetSwitch when it reads as a bool, as
/// .NET's AppContext answers runtimeconfig.json's configProperties. What the
/// program sets itself comes first, as it does in .NET.
static class AppContext
{
    /// .NET's run-time switches: a name and whether it is on, set by the
    /// program, read by whoever asks. The collector asks "Corsac.GC.Stats" as
    /// the process ends (Gc.SayStats).
    static Dictionary<string, bool>? _switches;
    static readonly object _switchLock = new object();

    public static void SetSwitch(string switchName, bool isEnabled)
    {
        if (switchName == null) throw new ArgumentNullException(nameof(switchName));
        if (switchName.Length == 0) throw new ArgumentException("The switch name may not be empty.", nameof(switchName));
        lock (_switchLock)
        {
            _switches ??= new Dictionary<string, bool>();
            _switches[switchName] = isEnabled;
        }
        // The collector's own: read as the process ends, from a flag of its
        // own, so a program that sets no switch carries none of this.
        if (switchName == "Corsac.GC.Stats")
        {
            Gc.StatsAsked = isEnabled;
            // Counted from here on, as the platform's flag counts from the start.
            if (isEnabled) { Gc.CountMarks = true; Gc.CountingCollected = true; }
            Gc.FastPathsChanged();
        }
        if (switchName == "Corsac.GC.AllocSample" && isEnabled) AllocSamples.Begin();
        if (switchName == "Corsac.GC.Census" && isEnabled) Gc.AskCensus();
        if (switchName == "Corsac.GC.DeadCensus" && isEnabled) Gc.AskDeadCensus();
        if (switchName == "Corsac.GC.ParentCensus" && isEnabled) Gc.AskParentCensus();
    }

    public static bool TryGetSwitch(string switchName, out bool isEnabled)
    {
        if (switchName == null) throw new ArgumentNullException(nameof(switchName));
        if (switchName.Length == 0) throw new ArgumentException("The switch name may not be empty.", nameof(switchName));
        lock (_switchLock)
        {
            if (_switches is not null && _switches.TryGetValue(switchName, out bool on)) { isEnabled = on; return true; }
        }
        // A switch nobody set is the data of the same name, when that is a
        // bool's text: "true" or "false", in any case, and nothing else.
        if (GetData(switchName) is string text && bool.TryParse(text, out isEnabled)) return true;
        isEnabled = false;
        return false;
    }

    public static string BaseDirectory
    {
        get
        {
            string? self = Environment.ProcessPath;

            // getcwd(2) directly: System.Environment sits below System.IO in
            // the library the machine links, and asking Directory for it would
            // make the lower one need the higher.
            string? cwd = Os.Getcwd();

            if (self == null) { return cwd == null ? "/" : cwd; }

            string? directory = Path.GetDirectoryName(self);

            // A bare name has an empty directory part: the current one.
            return string.IsNullOrEmpty(directory) ? (cwd == null ? "/" : cwd)
                                     : (directory.EndsWith("/") ? directory : directory + "/");
        }
    }

    static Dictionary<string, object?>? _data;

    public static object? GetData(string name)
    {
        if (name == null) throw new ArgumentNullException(nameof(name));
        // The collector's counters, read as data: what the program freed and
        // what the collector took (counted with Corsac.GC.Stats). Null under
        // .NET, which has neither.
        if (name == "Corsac.GC.FreedBytes") return Gc.FreedBytes;
        if (name == "Corsac.GC.CollectedBytes") return Gc.CollectedBytes;
        // A KNOB READ ONCE IS KEPT AS DATA: .NET's data store holds each one
        // from the start, so every GetData of it is the same string, and a
        // SetData after replaces it as it would any other.
        lock (_switchLock)
        {
            if (_data is not null && _data.TryGetValue(name, out object? value)) return value;
            string? knob = Knob(name);
            if (knob is not null)
            {
                _data ??= new Dictionary<string, object?>();
                _data[name] = knob;
            }
            return knob;
        }
    }

    /// The image's knob `name` as a string (Runtime.KnobValue), or null when
    /// the image was built without it.
    static string? Knob(string name)
    {
        long at = Runtime.KnobValue(name);
        if (at == 0) return null;
        int length = 0;
        while (Sys.PeekHalf(at + length * 2) != 0) length = length + 1;
        char[] units = new char[length];
        for (int i = 0; i < length; i++) units[i] = (char)Sys.PeekHalf(at + i * 2);
        return new string(units);
    }

    public static void SetData(string name, object? data)
    {
        if (name == null) throw new ArgumentNullException(nameof(name));
        lock (_switchLock)
        {
            _data ??= new Dictionary<string, object?>();
            _data[name] = data;
        }
        // The collector's own: how many workers its first collection starts.
        if (name == "Corsac.GC.Workers" && data is int workers)
        {
            Gc.WorkersAsked = workers < 0 ? 0 : workers > 15 ? 15 : workers;
            Gc.WorkersSet = true;
        }
    }
}
