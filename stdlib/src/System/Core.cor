// The CORSAC Script standard library.
//
// Written in the language itself rather than built into the compiler, which is
// the whole reason linking exists: this file is compiled alongside a program
// and type-checked against it, so the library and its user are held to the same
// rules. Anything here can be read, copied and replaced by whoever is using it.
//
//   corsac cc lib/std.cor myprogram.cor --run

// ---- String ---------------------------------------------------------------
// What '+', '==' and the ordering comparisons on strings actually call. The
// compiler lowers those operators into these methods rather than emitting code
// of its own, so the behaviour of the language's own operators is source you
// can read and, if you disagree with it, replace.
//
// A string here is a length word followed by that many bytes — the same shape
// as a byte array, which is why the five Sys primitives below are enough to
// build the whole type. Strings are treated as immutable: nothing outside this
// file writes bytes into one that already exists.

// HOW TWO STRINGS ARE TO BE COMPARED, with .NET's names and .NET's order.
//
// There is one culture on this machine, so the culture-sensitive members mean
// the same as the invariant ones -- but they exist, because source that says
// StringComparison.OrdinalIgnoreCase has to compile, and because the day a
// culture arrives the names are already the right ones.
enum StringComparison {
    CurrentCulture,
    CurrentCultureIgnoreCase,
    InvariantCulture,
    InvariantCultureIgnoreCase,
    Ordinal,
    OrdinalIgnoreCase,
}

// WHAT SPLIT DOES WITH THE PIECES IT MAKES. A FLAGS ENUM, as .NET has it since
// 5: the two options combine, and a caller that wants both writes the `|` it
// would write there.
enum StringSplitOptions {
    None = 0,
    RemoveEmptyEntries = 1,
    TrimEntries = 2,
}

static class String {
    // LINQ's Count(predicate) over a string. A string is a sequence of char in
    // C#; it is a primitive byte string here, so this instance-shaped static
    // helper supplies the same source surface without putting a vtable on it.
    public static int Count(string value, Func<char, bool> test) {
        int count = 0;
        for (int i = 0; i < value.Length; i++) {
            if (test((char)Sys.GetByte(value, i))) { count = count + 1; }
        }
        return count;
    }

    private static void CopyRange(string dst, int dstAt, string src, int srcAt, int count) {
        if (count <= 0) { return; }
        // Every caller owns dst and is copying from a distinct source block.
        // Non-overlap permits the bulk non-temporal path; the ordinary MCp
        // fallback also works on uncached/noncoherent RAM. Unit availability
        // alone would not make vector stores legal on that destination.
        Sys.CopyNoOverlap(dst, dstAt, src, srcAt, count);
    }

    // Called by: a + b
    public static string Concat(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        string result = Sys.NewBytes(la + lb);
        CopyRange(result, 0, a, 0, la);
        CopyRange(result, la, b, 0, lb);
        return result;
    }

    // Called by: a == b, a != b, a < b, and the rest. Ordinal, and the shared
    // prefix decides before the lengths do, so a prefix sorts before what
    // extends it. Culture-aware collation needs tables nobody in this world has.
    public static int Compare(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int n = la;
        if (lb < n) { n = lb; }

        int byBytes = Sys.StringCompare(a, 0, b, 0, n);
        if (byBytes != 0) { return byBytes; }

        if (la < lb) { return 0 - 1; }
        if (la > lb) { return 1; }
        return 0;
    }

    // NULL IS EQUAL TO NULL AND TO NOTHING ELSE, which is .NET's answer and is
    // what `==` on two strings calls: `a.Name == b.Name` must not fault, or say
    // that no name is the empty name.
    // The hash the tables use for a string key, reached by the routine that
    // hashes a key it knows only as a word.
    public static int KeyHash(string s) {
        return (int)Sys.StringHash(s, 0, s.Length, 2166136261);
    }

    public static bool Equals(string? a, string? b) {
        if (a == null) { return b == null; }
        if (b == null) { return false; }
        if (a.Length != b.Length) { return false; }
        return Sys.StringEqual(a, 0, b, 0, a.Length);
    }

    // Called by: "count: " + n
    //
    // Digits come out lowest-first, so they are built backwards into a scratch
    // block and reversed into an exactly-sized string. Two allocations, one
    // pass, and no over-long string left behind in the arena.
    public static string FromInt(long value) {
        string buffer = Sys.NewBytes(20);
        int written = Sys.StringFormat(buffer, 0, value, 20);
        string exact = Sys.NewBytes(written);
        CopyRange(exact, 0, buffer, 0, written);
        return exact;
    }

    // THE SAME, UNSIGNED. A ulong above long.MaxValue has its top bit set,
    // and the signed formatter reads that as a negative number: ulong.MaxValue
    // printed as -1 rather than as 18446744073709551615.
    //
    // One division takes the top digit off, after which what is left is below
    // long.MaxValue and the signed path is exact. Unsigned division is a
    // different instruction from signed division, which is the whole reason
    // this cannot simply call the other one.
    public static string FromUInt(ulong value) {
        if (value <= 9223372036854775807UL) { return FromInt((long)value); }

        ulong rest = value / 10;

        return Concat(FromInt((long)rest), FromInt((long)(value - rest * 10)));
    }

    // ONE CHARACTER, AS A STRING. C# spells it value.ToString() on a char and
    // this is that.
    //
    // It looks too small to be worth a method until something has to build
    // text a character at a time -- a line editor inserting a keystroke, a
    // program showing a control character as ^C -- at which point every caller
    // writes the same two lines and one of them gets the length wrong.
    public static string FromByte(long value) {
        string one = Sys.NewBytes(1);

        Sys.SetByte(one, 0, (int)(value & 255));
        return one;
    }

    // CAPITALISED, because that is what bool.ToString() answers in C# and this
    // is the same function. It used to be lower case, which reads better and is
    // wrong: a program that prints a flag and is then compiled by the .NET
    // build of this compiler would print something different, and a difference
    // that only shows up in output is the kind nobody notices until it is in a
    // file somebody is parsing.
    public static string FromBool(bool value) {
        if (value) { return "True"; }
        return "False";
    }

    // WHAT `"x = " + d` OUGHT TO CALL, and does not yet: the lowering that
    // picks FromInt for an integer and FromBool for a bool refuses a double
    // outright -- "'double' cannot be joined to a string". This is the answer
    // waiting for it, and what `d.ToString()` means once it is wired up.
    // See build/repro-std-double-join.cor.
    public static string FromDouble(double value) {
        return DoubleFormat.General(value, 15);
    }

    public static int IndexOf(string s, int ch) {
        return Sys.StringFind(s, 0, ch, s.Length);
    }

    // EVERYTHING IN A SEQUENCE, SEPARATED. `string.Join(", ", args)`.
    //
    // Each element renders through its ToString, which is what joining one to
    // a string does -- and a class with none of its own answers with its type
    // name, the same as object.ToString() in C#.
    //
    // Compiled ONCE, over the canonical machine word, so `List<TypeRef>` and
    // `List<string>` and `List<Node>` all reach the same routine. A list of a
    // narrow value type -- `List<int>` -- strides by four where the canonical
    // copy strides by eight, and is refused rather than read wrongly.
    public static string Join<T>(string separator, IReadOnlyList<T> values) {
        string result = "";
        int i = 0;
        while (i < values.Count) {
            if (i > 0) { result = result + separator; }
            result = result + values[i];
            i = i + 1;
        }
        return result;
    }

    public static string Join<T>(string separator, T[] values) {
        string result = "";
        int i = 0;
        while (i < values.Length) {
            if (i > 0) { result = result + separator; }
            result = result + values[i];
            i = i + 1;
        }
        return result;
    }

    /// EVERYTHING IN A SEQUENCE, JOINED, with nothing between them. `Concat`
    /// is `Join("")` and .NET has both, because the reason you reach for one
    /// is not the reason you reach for the other.
    public static string Concat<T>(IReadOnlyList<T> values) {
        return Join("", values);
    }

    // ---- string.Format ----------------------------------------------------
    //
    // `{index[,alignment][:format]}`, which is the same grammar an
    // interpolated string is written in -- and NOT the same machinery: an
    // interpolation is taken apart by the compiler at the point it is written,
    // and this one is a format string chosen at RUN time, out of a resource
    // file or a configuration or a message table. That is what it is for.
    //
    // A doubled brace is one brace. An index past the arguments is a
    // FormatException, in .NET's words, rather than a blank -- a message with
    // a hole in it is worse than one that failed.

    public static string Format(string format, params object[] args) {
        if (format == null) { throw new ArgumentNullException("format"); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < format.Length) {
            char c = (char)Sys.GetByte(format, at);

            if (c == '{' && at + 1 < format.Length && Sys.GetByte(format, at + 1) == (int)'{') {
                made.Append('{');
                at = at + 2;
                continue;
            }

            if (c == '}' && at + 1 < format.Length && Sys.GetByte(format, at + 1) == (int)'}') {
                made.Append('}');
                at = at + 2;
                continue;
            }

            if (c != '{') {
                made.Append(c);
                at = at + 1;
                continue;
            }

            int close = String.IndexOf(format, '}', at);

            if (close < 0) { throw new FormatException("Input string was not in a correct format."); }

            string hole = String.Substring(format, at + 1, close - at - 1);

            at = close + 1;

            string indexText = hole;
            string alignText = "";
            string formatText = "";
            int colon = String.IndexOf(hole, ':');

            if (colon >= 0) {
                formatText = String.Substring(hole, colon + 1, hole.Length - colon - 1);
                indexText = String.Substring(hole, 0, colon);
            }

            int comma = String.IndexOf(indexText, ',');

            if (comma >= 0) {
                alignText = String.Substring(indexText, comma + 1, indexText.Length - comma - 1);
                indexText = String.Substring(indexText, 0, comma);
            }

            int index = 0;

            if (!Int32.TryParse(String.Trim(indexText), out index) || index < 0 || index >= args.Length) {
                throw new FormatException("Index (zero based) must be greater than or equal to zero and less than the size of the argument list.");
            }

            int width = 0;

            if (alignText.Length > 0 && !Int32.TryParse(String.Trim(alignText), out width)) {
                throw new FormatException("Input string was not in a correct format.");
            }
            made.Append(Padded(Formatted(args[index], formatText), width));
        }
        return made.ToString();
    }

    public static string Format(string format, object one) {
        return Format(format, new object[] { one });
    }

    public static string Format(string format, object one, object two) {
        return Format(format, new object[] { one, two });
    }

    public static string Format(string format, object one, object two, object three) {
        return Format(format, new object[] { one, two, three });
    }

    /// ONE ARGUMENT, WRITTEN. The format string after the colon belongs to the
    /// VALUE's type -- "X4" to a number, "yyyy-MM-dd" to a date -- which is
    /// what IFormattable means in .NET; here the type is asked for directly,
    /// because a boxed value knows what it is and there is no interface
    /// dispatch to do it through.
    private static string Formatted(object value, string format) {
        if (format.Length == 0) { return "" + value; }
        if (value is int) { return ((int)value).ToString(format); }
        if (value is long) { return ((long)value).ToString(format); }
        if (value is double) { return ((double)value).ToString(format); }
        if (value is DateTime) { return ((DateTime)value).ToString(format); }
        return "" + value;
    }

    /// POSITIVE PADS ON THE LEFT and negative on the right, which is .NET's
    /// rule for an alignment and reads backwards until you think of it as
    /// "right-aligned in a field this wide".
    private static string Padded(string text, int width) {
        if (width == 0) { return text; }
        if (width > 0) { return PadLeft(text, width); }
        return PadRight(text, -width);
    }

    public static string Substring(string s, int start, int count) {
        // Sys.Copy is a block move: it knows how many bytes to shift and
        // nothing whatever about where this string ends, so an unchecked range
        // here would quietly copy whatever sits next to s in the arena. Every
        // other way of reading a string is checked by the machine; this one has
        // to ask for it.
        if (start < 0 || count < 0 || start + count > s.Length) {
            // One past the end, which traps IndexOutOfRange exactly as s[i]
            // would. It becomes a throw once exceptions land.
            count = Sys.GetByte(s, s.Length);
        }

        string result = Sys.NewBytes(count);
        CopyRange(result, 0, s, start, count);
        return result;
    }

    // ---- case, and comparing without it ---------------------------------
    //
    // ASCII ONLY, and that is a statement about this machine rather than a
    // shortcut: its console and its filing system are bytes, and a case rule
    // for anything else needs tables that do not exist here yet. .NET's
    // Invariant versions promise exactly "not the current culture's rule",
    // which is what these are.
    // WHAT `new string(c, n)` MEANS. C# spells it as a constructor and a string
    // here is a primitive with no class to put one on, so the compiler turns
    // that construction into this call -- see Binder. The name is .NET's:
    // string.Repeat does not exist there, but this is the constructor's body
    // and nothing else calls it by name.
    public static string Repeat(char c, int count) {
        if (count <= 0) { return ""; }

        string made = Sys.NewBytes(count);

        Sys.StringFill(made, 0, (int)c, count);
        return made;
    }

    // WHAT `new string(chars)` AND `new string(chars, start, length)` MEAN, for
    // the same reason Repeat exists: C# spells both as constructors and a
    // string here has no class to carry one, so the compiler turns the
    // construction into this call.
    //
    // The range form checks its own arguments, because a constructor in C#
    // throws rather than reading past the array -- and the caller that gets it
    // wrong is usually a decoder writing out however many characters it
    // produced into a buffer it sized once.
    /// One character as a string of one, which is what a char joined to text
    /// becomes.
    public static string FromChar(char c) {
        char[] one = new char[1];

        one[0] = c;
        return FromChars(one);
    }

    public static string FromChars(char[] chars) {
        if (chars == null) { return ""; }

        return FromChars(chars, 0, chars.Length);
    }

    public static string FromChars(char[] chars, int start, int length) {
        if (chars == null) { throw new ArgumentNullException("chars"); }
        if (start < 0 || length < 0 || start + length > chars.Length) {
            throw new ArgumentOutOfRangeException("start");
        }
        if (length == 0) { return ""; }

        string made = Sys.NewBytes(length);

        for (int i = 0; i < length; i++) {
            Sys.SetByte(made, i, (int)chars[start + i] & 255);
        }
        return made;
    }

    public static string ToLowerInvariant(string s) {
        string made = Sys.NewBytes(s.Length);
        CopyRange(made, 0, s, 0, s.Length);
        Sys.StringLower(made, 0, made.Length);
        return made;
    }

    public static string ToUpperInvariant(string s) {
        string made = Sys.NewBytes(s.Length);
        CopyRange(made, 0, s, 0, s.Length);
        Sys.StringUpper(made, 0, made.Length);
        return made;
    }

    // .NET has these as the culture-sensitive pair; on a machine with one
    // culture they are the invariant ones.
    public static string ToLower(string s) { return ToLowerInvariant(s); }
    public static string ToUpper(string s) { return ToUpperInvariant(s); }

    public static bool Equals(string a, string b, StringComparison kind) {
        if (kind == StringComparison.OrdinalIgnoreCase
         || kind == StringComparison.InvariantCultureIgnoreCase
         || kind == StringComparison.CurrentCultureIgnoreCase) {
            return Compare(ToLowerInvariant(a), ToLowerInvariant(b)) == 0;
        }
        return Compare(a, b) == 0;
    }

    // A read-only character view. Strings are UTF-8 byte blocks on this
    // machine, while char is an integer value, so this first implementation
    // materialises the characters into a char array and lets the ordinary span
    // implementation provide slicing and indexing. It preserves the C# API and
    // semantics; a later string-backed span can remove the allocation without
    // changing callers.
    public static ReadOnlySpan<char> AsSpan(string s, int start) {
        char[] chars = new char[s.Length - start];
        for (int i = start; i < s.Length; i++) { chars[i - start] = (char)Sys.GetByte(s, i); }
        return new ReadOnlySpan<char>(chars);
    }

    public static ReadOnlySpan<char> AsSpan(string s) { return AsSpan(s, 0); }

    /// .NET's third overload: a window, not a tail.
    public static ReadOnlySpan<char> AsSpan(string s, int start, int length) {
        char[] made = new char[length];

        for (int i = 0; i < length; i++) { made[i] = s[start + i]; }
        return new ReadOnlySpan<char>(made);
    }

    // ---- the rest of the string surface --------------------------------
    //
    // .NET's names and .NET's answers, ordinal throughout.

    public static bool EndsWith(string s, string suffix) {
        if (suffix.Length > s.Length) { return false; }
        return Sys.StringEqual(s, s.Length - suffix.Length, suffix, 0, suffix.Length);
    }

    public static bool EndsWith(string s, char suffix) {
        return s.Length > 0 && Sys.GetByte(s, s.Length - 1) == (int)suffix;
    }

    public static bool StartsWith(string s, string prefix, StringComparison kind) {
        if (prefix.Length > s.Length) { return false; }
        if (kind == StringComparison.Ordinal) {
            return Sys.StringEqual(s, 0, prefix, 0, prefix.Length);
        }
        return Equals(Substring(s, 0, prefix.Length), prefix, kind);
    }

    public static bool EndsWith(string s, string suffix, StringComparison kind) {
        if (suffix.Length > s.Length) { return false; }
        if (kind == StringComparison.Ordinal) {
            return Sys.StringEqual(s, s.Length - suffix.Length, suffix, 0, suffix.Length);
        }
        return Equals(Substring(s, s.Length - suffix.Length, suffix.Length), suffix, kind);
    }

    public static int IndexOf(string s, string what) {
        if (what.Length == 0) { return 0; }

        if (what.Length > s.Length) { return 0 - 1; }
        return Sys.StringSearch(s, 0, what, 0, s.Length);
    }

    public static int IndexOfAny(string s, char[] any) {
        for (int i = 0; i < s.Length; i++) {
            int ch = Sys.GetByte(s, i);
            for (int j = 0; j < any.Length; j++) {
                if (ch == (int)any[j]) { return i; }
            }
        }
        return 0 - 1;
    }

    public static int LastIndexOf(string s, int ch) {
        if (s.Length == 0) { return 0 - 1; }
        return Sys.StringFindReverse(s, s.Length - 1, ch, s.Length);
    }

    public static bool Contains(string s, string what) { return IndexOf(s, what) >= 0; }
    public static bool Contains(string s, char ch) { return IndexOf(s, (int)ch) >= 0; }

    public static string Substring(string s, int start) { return Substring(s, start, s.Length - start); }

    /// A FALSE ANSWER PROVES THERE IS A STRING, which is what .NET's
    /// [NotNullWhen(false)] says and what makes `if (!IsNullOrEmpty(dir))
    /// { Use(dir); }` the ordinary way to write the check.
    public static bool IsNullOrEmpty([NotNullWhen(false)] string? s) { return s == null || s.Length == 0; }

    public static bool IsNullOrWhiteSpace([NotNullWhen(false)] string? s) {
        if (s == null) { return true; }

        for (int i = 0; i < s.Length; i++) {
            if (!Char.IsWhiteSpace((char)Sys.GetByte(s, i))) { return false; }
        }
        return true;
    }

    public static string TrimStart(string s) {
        int at = 0;

        while (at < s.Length && Char.IsWhiteSpace((char)Sys.GetByte(s, at))) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s) {
        int end = s.Length;

        while (end > 0 && Char.IsWhiteSpace((char)Sys.GetByte(s, end - 1))) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s) { return TrimEnd(TrimStart(s)); }

    // ONE SEPARATOR, which is what a compiler splitting a line on spaces or a
    // path on slashes needs. .NET's overload taking several is not here yet and
    // will be the day something wants it.
    public static string[] Split(string s, char separator) {
        int parts = 1;

        for (int i = 0; i < s.Length; i++) {
            if (Sys.GetByte(s, i) == (int)separator) { parts = parts + 1; }
        }

        string[] made = new string[parts];
        int which = 0;
        int from = 0;

        for (int i = 0; i <= s.Length; i++) {
            if (i == s.Length || Sys.GetByte(s, i) == (int)separator) {
                made[which] = Substring(s, from, i - from);
                which = which + 1;
                from = i + 1;
            }
        }
        return made;
    }

    public static string PadLeft(string s, int width, char with) {
        if (s.Length >= width) { return s; }
        return Concat(Repeat(with, width - s.Length), s);
    }

    public static string PadRight(string s, int width, char with) {
        if (s.Length >= width) { return s; }
        return Concat(s, Repeat(with, width - s.Length));
    }

    public static string PadLeft(string s, int width) { return PadLeft(s, width, ' '); }
    public static string PadRight(string s, int width) { return PadRight(s, width, ' '); }

    // .NET's Replace, over whole strings. Ordinal, like everything else here.
    public static string Replace(string s, string what, string with) {
        if (what.Length == 0) { return s; }

        // COUNT FIRST, THEN ALLOCATE ONCE. The former implementation appended
        // one character at a time, and every append copied everything already
        // produced. Replacing CRLF in a source file was therefore quadratic:
        // stage1.asm happened to fit, while the 188 KiB BIOS consumed hundreds
        // of MiB before the assembler had parsed its first line.
        int matches = 0;
        int at = 0;

        while (at + what.Length <= s.Length) {
            if (at + what.Length <= s.Length
             && Sys.CompareBytes(s, at, what, 0, what.Length) == 0) {
                matches = matches + 1;
                at = at + what.Length;
            } else {
                at = at + 1;
            }
        }

        if (matches == 0) { return s; }

        long length = (long)s.Length
                    + (long)matches * (long)(with.Length - what.Length);
        if (length < 0 || length > 2147483647) {
            throw new OverflowException("replacement result is too large");
        }

        string made = Sys.NewBytes((int)length);
        at = 0;
        int into = 0;

        while (at < s.Length) {
            if (at + what.Length <= s.Length
             && Sys.CompareBytes(s, at, what, 0, what.Length) == 0) {
                CopyRange(made, into, with, 0, with.Length);
                into = into + with.Length;
                at = at + what.Length;
            } else {
                Sys.SetByte(made, into, Sys.GetByte(s, at));
                into = into + 1;
                at = at + 1;
            }
        }
        return made;
    }

    public static bool StartsWith(string s, string prefix) {
        if (prefix.Length > s.Length) { return false; }
        return Sys.StringEqual(s, 0, prefix, 0, prefix.Length);
    }

    public static bool StartsWith(string s, char prefix) {
        return s.Length > 0 && Sys.GetByte(s, 0) == (int)prefix;
    }

    // ---- the parts of the string surface a program reaches for next -------
    //
    // Everything below is .NET's name answering .NET's answer, ordinal
    // throughout for the reason stated at the top of this file: there is one
    // culture here and collation tables for another do not exist.

    // .NET's string.Empty. A literal would do as well and every program that
    // says `string.Empty` would still fail to compile, which is the point.
    public static string Empty => "";

    public static string Concat(string a, string b, string c) {
        return Concat(Concat(a, b), c);
    }

    public static string Concat(string a, string b, string c, string d) {
        return Concat(Concat(a, b), Concat(c, d));
    }

    public static string Concat(string[] values) {
        return Join("", values);
    }

    // WALKED RATHER THAN INDEXED, which is what .NET's Join over a sequence
    // does: an IEnumerable has no count and no index, only a way forward.
    /// THE SEPARATOR AS A CHARACTER, which .NET has beside every string form:
    /// `string.Join(':', paths)` is what a search path is built with.
    public static string Join<T>(char separator, IEnumerable<T> values) {
        return Join(String.FromChar(separator), values);
    }

    public static string Join<T>(char separator, T[] values) {
        return Join(String.FromChar(separator), values);
    }

    public static string Join<T>(string separator, IEnumerable<T> values) {
        StringBuilder made = new StringBuilder();
        bool first = true;

        foreach (T one in values) {
            if (!first) { made.Append(separator); }
            made.Append("" + one);
            first = false;
        }
        return made.ToString();
    }

    public static string Join(string separator, List<string> values) {
        return Join<string>(separator, (IReadOnlyList<string>)values);
    }

    // ---- searching, from somewhere other than the start -------------------

    public static int IndexOf(string s, char ch, int start) {
        for (int i = start < 0 ? 0 : start; i < s.Length; i++) {
            if (Sys.GetByte(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, char ch, int start, int count) {
        int end = start + count;
        if (end > s.Length) { end = s.Length; }
        for (int i = start < 0 ? 0 : start; i < end; i++) {
            if (Sys.GetByte(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, string what, int start) {
        if (start < 0) { start = 0; }
        if (what.Length == 0) { return start <= s.Length ? start : -1; }

        for (int i = start; i + what.Length <= s.Length; i++) {
            if (Sys.StringEqual(s, i, what, 0, what.Length)) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, string what, StringComparison kind) {
        return IndexOf(s, what, 0, kind);
    }

    // CASE-FOLDING FOLDS BOTH SIDES ONCE, not once per position: the naive
    // form lowers a slice of the haystack inside the loop and turns a search
    // into an allocation per character.
    public static int IndexOf(string s, string what, int start, StringComparison kind) {
        if (kind == StringComparison.Ordinal || kind == StringComparison.InvariantCulture
         || kind == StringComparison.CurrentCulture) {
            return IndexOf(s, what, start);
        }
        return IndexOf(ToLowerInvariant(s), ToLowerInvariant(what), start);
    }

    public static int LastIndexOf(string s, string what) {
        if (what.Length == 0) { return s.Length; }

        for (int i = s.Length - what.Length; i >= 0; i--) {
            if (Sys.StringEqual(s, i, what, 0, what.Length)) { return i; }
        }
        return -1;
    }

    public static int LastIndexOf(string s, char ch, int start) {
        for (int i = start >= s.Length ? s.Length - 1 : start; i >= 0; i--) {
            if (Sys.GetByte(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int LastIndexOfAny(string s, char[] any) {
        for (int i = s.Length - 1; i >= 0; i--) {
            int ch = Sys.GetByte(s, i);
            for (int j = 0; j < any.Length; j++) {
                if (ch == (int)any[j]) { return i; }
            }
        }
        return -1;
    }

    public static bool Contains(string s, string what, StringComparison kind) {
        return IndexOf(s, what, 0, kind) >= 0;
    }

    // ---- comparing, the overloads whose extra argument is the whole point --

    public static int Compare(string a, string b, bool ignoreCase) {
        if (ignoreCase) { return Compare(ToLowerInvariant(a), ToLowerInvariant(b)); }
        return Compare(a, b);
    }

    public static int Compare(string a, string b, StringComparison kind) {
        if (kind == StringComparison.OrdinalIgnoreCase
         || kind == StringComparison.InvariantCultureIgnoreCase
         || kind == StringComparison.CurrentCultureIgnoreCase) {
            return Compare(ToLowerInvariant(a), ToLowerInvariant(b));
        }
        return Compare(a, b);
    }

    public static int CompareOrdinal(string a, string b) { return Compare(a, b); }

    // ---- cutting and splicing ---------------------------------------------

    public static string Remove(string s, int start) {
        return Substring(s, 0, start);
    }

    public static string Remove(string s, int start, int count) {
        return Concat(Substring(s, 0, start), Substring(s, start + count, s.Length - start - count));
    }

    public static string Insert(string s, int at, string value) {
        return Concat(Substring(s, 0, at), Concat(value, Substring(s, at, s.Length - at)));
    }

    /// ONE CHARACTER REPLACED BY ANOTHER, which is not the string overload
    /// with one-character strings: the length cannot change, so this writes a
    /// copy in place and allocates once whatever the text is.
    public static string Replace(string s, char what, char with) {
        string made = Sys.NewBytes(s.Length);

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetByte(s, i);
            Sys.SetByte(made, i, c == (int)what ? (int)with : c);
        }
        return made;
    }

    public static char[] ToCharArray(string s) {
        char[] made = new char[s.Length];

        for (int i = 0; i < s.Length; i++) { made[i] = (char)Sys.GetByte(s, i); }
        return made;
    }

    public static char[] ToCharArray(string s, int start, int count) {
        char[] made = new char[count];

        for (int i = 0; i < count; i++) { made[i] = (char)Sys.GetByte(s, start + i); }
        return made;
    }

    // ---- trimming particular characters -----------------------------------
    //
    // .NET's Trim() with no argument trims white space; these trim exactly
    // what they are given, and trimming NOTHING is not the same as trimming
    // white space -- an empty set leaves the string alone.

    private static bool IsIn(char[] any, int ch) {
        for (int i = 0; i < any.Length; i++) {
            if ((int)any[i] == ch) { return true; }
        }
        return false;
    }

    public static string TrimStart(string s, char[] any) {
        int at = 0;
        while (at < s.Length && IsIn(any, Sys.GetByte(s, at))) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s, char[] any) {
        int end = s.Length;
        while (end > 0 && IsIn(any, Sys.GetByte(s, end - 1))) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s, char[] any) { return TrimEnd(TrimStart(s, any), any); }

    public static string TrimStart(string s, char one) {
        int at = 0;
        while (at < s.Length && Sys.GetByte(s, at) == (int)one) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s, char one) {
        int end = s.Length;
        while (end > 0 && Sys.GetByte(s, end - 1) == (int)one) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s, char one) { return TrimEnd(TrimStart(s, one), one); }

    // ---- splitting --------------------------------------------------------
    //
    // BUILT INTO A LIST AND THEN COPIED OUT, rather than counted first and
    // filled second: options that drop or trim entries make the count depend
    // on the pieces themselves, so counting would mean splitting twice.

    private static string[] Finish(List<string> parts, StringSplitOptions options) {
        List<string> kept = new List<string>();

        for (int i = 0; i < parts.Count; i++) {
            string one = parts[i];
            if ((options & StringSplitOptions.TrimEntries) != StringSplitOptions.None) {
                one = Trim(one);
            }
            if ((options & StringSplitOptions.RemoveEmptyEntries) != StringSplitOptions.None
             && one.Length == 0) {
                continue;
            }
            kept.Add(one);
        }
        return kept.ToArray();
    }

    public static string[] Split(string s, char separator, StringSplitOptions options) {
        char[] one = new char[1];
        one[0] = separator;
        return Split(s, one, options);
    }

    public static string[] Split(string s, char[] separators) {
        return Split(s, separators, StringSplitOptions.None);
    }

    public static string[] Split(string s, char[] separators, StringSplitOptions options) {
        List<string> parts = new List<string>();
        int from = 0;

        for (int i = 0; i <= s.Length; i++) {
            if (i == s.Length || IsIn(separators, Sys.GetByte(s, i))) {
                parts.Add(Substring(s, from, i - from));
                from = i + 1;
            }
        }
        return Finish(parts, options);
    }

    public static string[] Split(string s, string separator) {
        return Split(s, separator, StringSplitOptions.None);
    }

    // A SEPARATOR OF NO CHARACTERS SPLITS NOTHING, which is .NET's answer:
    // the whole string comes back as the only piece. Anything else would be
    // an infinite loop dressed up as an empty-string rule.
    public static string[] Split(string s, string separator, StringSplitOptions options) {
        List<string> parts = new List<string>();

        if (separator.Length == 0) {
            parts.Add(s);
            return Finish(parts, options);
        }

        int from = 0;
        int at = 0;

        while (at + separator.Length <= s.Length) {
            if (Sys.StringEqual(s, at, separator, 0, separator.Length)) {
                parts.Add(Substring(s, from, at - from));
                at = at + separator.Length;
                from = at;
            } else {
                at = at + 1;
            }
        }
        parts.Add(Substring(s, from, s.Length - from));
        return Finish(parts, options);
    }

    public static string[] Split(string s, string[] separators, StringSplitOptions options) {
        List<string> parts = new List<string>();
        int from = 0;
        int at = 0;

        while (at < s.Length) {
            int hit = -1;

            for (int j = 0; j < separators.Length; j++) {
                string sep = separators[j];
                if (sep.Length > 0 && at + sep.Length <= s.Length
                 && Sys.StringEqual(s, at, sep, 0, sep.Length)) {
                    hit = j;
                    break;
                }
            }

            if (hit < 0) {
                at = at + 1;
                continue;
            }

            parts.Add(Substring(s, from, at - from));
            at = at + separators[hit].Length;
            from = at;
        }
        parts.Add(Substring(s, from, s.Length - from));
        return Finish(parts, options);
    }

    // THE TEXT REVERSED. .NET spells it `new string(s.Reverse().ToArray())`,
    // which is three allocations and a LINQ pipeline to turn a word round;
    // the name is String.Reverse in every other library on earth.
    public static string Reverse(string s) {
        string made = Sys.NewBytes(s.Length);

        for (int i = 0; i < s.Length; i++) {
            Sys.SetByte(made, i, Sys.GetByte(s, s.Length - 1 - i));
        }
        return made;
    }
}

// ---- char, by the name C# gives its type -----------------------------------
//
// System.IO.Path, and it belongs in the standard library rather than behind
// CORSAC because it TOUCHES NOTHING. Every method here is string arithmetic on
// a name; none of them asks the filing system whether the thing exists, and
// that is true of the real System.IO.Path too. Path.Combine on a machine with
// no disc in it still answers.
//
// Separators are '/' only. This machine's filing system is MINIX and its shell
// is POSIX, so there is one separator and no drive letters; accepting '\\' as
// well would be inventing a convention rather than following one.

static partial class Path {
    public static char DirectorySeparatorChar = '/';

    /// Joins two paths. A SECOND PATH THAT IS ABSOLUTE WINS OUTRIGHT, which is
    /// the rule .NET uses and the one that makes `Combine(baseDir, userPath)`
    /// safe to write: a caller passing an absolute path meant it.
    public static string Combine(string path1, string path2) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path2.Length > 0 && path2[0] == '/') { return path2; }
        if (path1.Length == 0) { return path2; }
        if (path2.Length == 0) { return path1; }
        if (path1[path1.Length - 1] == '/') { return path1 + path2; }
        return path1 + "/" + path2;
    }

    /// Everything before the last separator, or null when there is none.
    ///
    /// NULL AND NOT EMPTY for a bare name, because those are different answers:
    /// "" is the current directory and null is "this name has no directory
    /// part". The assembler's include handling relies on the difference -- it
    /// falls back to the including file's directory when this says null.
    public static string? GetDirectoryName(string path) {
        long i = path.Length - 1;
        while (i >= 0 && path[(int)i] != '/') { i = i - 1; }
        if (i < 0) { return null; }
        if (i == 0) { return "/"; }
        return path.Substring(0, (int)i);
    }

    /// Everything after the last separator; the whole thing when there is none.
    public static string GetFileName(string path) {
        long i = path.Length - 1;
        while (i >= 0 && path[(int)i] != '/') { i = i - 1; }
        return path.Substring((int)(i + 1), (int)(path.Length - i - 1));
    }

    /// The extension INCLUDING its dot, or "" when there is none.
    ///
    /// A dot in a directory name does not count, and neither does a leading dot
    /// on the name itself: ".profile" has no extension, it is a hidden file.
    public static string GetExtension(string path) {
        string name = GetFileName(path);
        long i = name.Length - 1;
        while (i > 0 && name[(int)i] != '.') { i = i - 1; }
        if (i <= 0) { return ""; }
        return name.Substring((int)i, (int)(name.Length - i));
    }

    public static string GetFileNameWithoutExtension(string path) {
        string name = GetFileName(path);
        string ext = GetExtension(path);
        return name.Substring(0, (int)(name.Length - ext.Length));
    }

    /// The OTHER separator, which is the backslash even here: a program that
    /// splits a path on both of .NET's separators has to be able to name it,
    /// and Windows paths turn up in files this machine reads.
    public static char AltDirectorySeparatorChar = '\\';

    /// What separates one path from the next in a LIST of them -- PATH itself.
    /// A colon on Unix, where Windows uses a semicolon.
    public static char PathSeparator = ':';

    public static char VolumeSeparatorChar = ':';

    public static string Combine(string path1, string path2, string path3) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path3 == null) { throw new ArgumentNullException("path3"); }
        return Combine(Combine(path1, path2), path3);
    }

    public static string Combine(string path1, string path2, string path3, string path4) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path3 == null) { throw new ArgumentNullException("path3"); }
        if (path4 == null) { throw new ArgumentNullException("path4"); }
        return Combine(Combine(Combine(path1, path2), path3), path4);
    }

    /// Combines any number of path parts, validating every part even when a
    /// later absolute path discards it. Allocate only the final string.
    public static string Combine(params string[] paths) {
        if (paths == null) { throw new ArgumentNullException("paths"); }
        int start = 0;
        for (int i = 0; i < paths.Length; i++) {
            string part = paths[i];
            if (part == null) { throw new ArgumentNullException("paths"); }
            if (part.Length != 0 && part[0] == '/') { start = i; }
        }
        int length = 0;
        int pieces = 0;
        string last = "";
        for (int i = start; i < paths.Length; i++) {
            string part = paths[i];
            if (part.Length == 0) { continue; }
            checked {
                if (last.Length != 0 && last[last.Length - 1] != '/') { length++; }
                length += part.Length;
            }
            pieces++;
            last = part;
        }
        if (pieces < 2) { return last; }
        string result = Sys.NewBytes(length);
        int at = 0;
        last = "";
        for (int i = start; i < paths.Length; i++) {
            string part = paths[i];
            if (part.Length == 0) { continue; }
            if (last.Length != 0 && last[last.Length - 1] != '/') {
                Sys.SetByte(result, at, 47);
                at++;
            }
            Sys.CopyNoOverlap(result, at, part, 0, part.Length);
            at += part.Length;
            last = part;
        }
        return result;
    }

    /// LIKE Combine, EXCEPT THAT A ROOTED SECOND PART DOES NOT WIN. Combine
    /// throws away everything before an absolute path -- Combine("a", "/b") is
    /// "/b" -- because it is joining a directory to a path that may be either.
    /// Join simply puts one separator between them, which is what a caller
    /// building a path out of parts meant all along.
    public static string Join(string a, string b) {
        if (a.Length == 0) { return b; }
        if (b.Length == 0) { return a; }

        bool ends = Sys.GetByte(a, a.Length - 1) == (int)'/';
        bool starts = Sys.GetByte(b, 0) == (int)'/';

        if (ends && starts) { return String.Concat(a, String.Substring(b, 1, b.Length - 1)); }
        if (ends || starts) { return String.Concat(a, b); }
        return String.Concat(a, String.Concat("/", b));
    }

    public static string Join(string a, string b, string c) { return Join(Join(a, b), c); }

    /// A NEW EXTENSION IN PLACE OF THE OLD ONE, or none at all when the new one
    /// is null -- which is how .NET spells "take the extension off".
    ///
    /// The result is null exactly where the path was, which is what .NET's
    /// [return: NotNullIfNotNull(nameof(path))] says: a caller who passed a
    /// string is handed one.
    [return: NotNullIfNotNull(nameof(path))]
    public static string? ChangeExtension(string? path, string? extension) {
        if (path == null) { return null; }

        int dot = -1;

        for (int i = path.Length - 1; i >= 0; i--) {
            int c = Sys.GetByte(path, i);

            if (c == (int)'/') { break; }
            if (c == (int)'.') { dot = i; break; }
        }

        string stem = dot < 0 ? path : String.Substring(path, 0, dot);

        if (extension == null) { return stem; }
        if (extension.Length == 0) { return stem; }
        if (Sys.GetByte(extension, 0) == (int)'.') { return String.Concat(stem, extension); }
        return String.Concat(stem, String.Concat(".", extension));
    }

    public static bool HasExtension(string path) { return GetExtension(path).Length > 0; }

    /// "/" for an absolute path and the empty string for a relative one, which
    /// is all a machine with one filing system has to say.
    public static string GetPathRoot(string path) {
        return IsPathRooted(path) ? "/" : "";
    }

    public static bool EndsInDirectorySeparator(string path) {
        return path.Length > 0 && Sys.GetByte(path, path.Length - 1) == (int)'/';
    }

    /// THE ROOT KEEPS ITS SLASH: "/" trimmed is still "/", because a path that
    /// is nothing but a separator has nothing left to be.
    public static string TrimEndingDirectorySeparator(string path) {
        if (path.Length <= 1 || !EndsInDirectorySeparator(path)) { return path; }
        return String.Substring(path, 0, path.Length - 1);
    }

    public static bool IsPathRooted(string path) {
        return path.Length > 0 && path[0] == '/';
    }
}

// `char.IsDigit(c)` reaches this the same way `int.TryParse` reaches Int32:
// the keyword is an alias for the type and the checker resolves it. ASCII,
// which is what this machine's console and filing system are.

static class Char {
    public static bool IsDigit(char c) { return c >= '0' && c <= '9'; }
    public static bool IsLetter(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
    public static bool IsLetterOrDigit(char c) { return IsLetter(c) || IsDigit(c); }
    // VERTICAL TAB AND FORM FEED COUNT, which they did not until now: .NET's
    // char.IsWhiteSpace lists them, so text trimmed here and text trimmed
    // there differed by exactly the characters a program that paginates its
    // output emits.
    public static bool IsWhiteSpace(char c) {
        return c == ' ' || c == '\t' || c == '\r' || c == '\n'
            || c == '\v' || c == '\f';
    }
    public static bool IsUpper(char c) { return c >= 'A' && c <= 'Z'; }
    public static bool IsLower(char c) { return c >= 'a' && c <= 'z'; }

    public static char ToUpper(char c) { return IsLower(c) ? (char)(c - 32) : c; }
    public static char ToLower(char c) { return IsUpper(c) ? (char)(c + 32) : c; }
    public static char ToUpperInvariant(char c) { return ToUpper(c); }
    public static char ToLowerInvariant(char c) { return ToLower(c); }

    // .NET's newer, explicitly-ASCII predicates. They say in their NAME what
    // every method in this class in fact does, which is worth having on a
    // machine whose text is bytes: code that means ASCII can say so.
    public static bool IsAscii(char c) { return c <= (char)127; }
    public static bool IsAsciiDigit(char c) { return IsDigit(c); }
    public static bool IsAsciiLetter(char c) { return IsLetter(c); }
    public static bool IsAsciiLetterOrDigit(char c) { return IsLetterOrDigit(c); }
    public static bool IsAsciiLetterUpper(char c) { return IsUpper(c); }
    public static bool IsAsciiLetterLower(char c) { return IsLower(c); }

    public static bool IsAsciiHexDigit(char c) {
        return IsDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    // C0 AND DEL, which is the whole of the control range in ASCII.
    public static bool IsControl(char c) { return c < (char)32 || c == (char)127; }

    // SPACE ALONE in ASCII: Unicode's separator category holds the other
    // space characters and this machine's text has none of them.
    public static bool IsSeparator(char c) { return c == ' '; }

    // The ASCII punctuation, by Unicode's classification: the printable
    // characters that are neither letters, nor digits, nor space. .NET puts
    // the currency and mathematical signs in IsSymbol instead, and so does
    // this -- the split looks arbitrary until something formats a table by it.
    public static bool IsSymbol(char c) {
        return c == '+' || c == '<' || c == '=' || c == '>' || c == '|'
            || c == '~' || c == '$' || c == '^' || c == '`';
    }

    public static bool IsPunctuation(char c) {
        if (!IsAscii(c) || IsControl(c) || c == ' ') { return false; }
        return !IsLetterOrDigit(c) && !IsSymbol(c);
    }

    /// `c.ToString()`, which C# resolves on char and which a string here has
    /// no class to put a method on -- see String.FromByte, whose answer this
    /// is under the name a caller writes.
    public static string ToString(this char c) { return String.FromByte((long)c); }
}

// .NET puts IsHexDigit on Uri, of all places, and this compiler's own lexer
// calls it there. The name is the part that has to match.
/// WHAT A URI MAY BE: a whole one, or a piece to be resolved against another.
enum UriKind {
    RelativeOrAbsolute = 0,
    Absolute = 1,
    Relative = 2,
}

/// A URI, TAKEN APART. scheme://user@host:port/path?query#fragment, each piece
/// named as .NET names it -- which is not as RFC 3986 names them: .NET's Query
/// KEEPS its '?' and its Fragment keeps its '#', so that joining the pieces
/// back up is concatenation and not a reconstruction.
///
/// The path is NORMALISED as .NET normalises it: "/a/../b" is "/b", because a
/// caller comparing two URIs for equality means the same resource and not the
/// same spelling.
class Uri {
    private string scheme;
    private string userInfo;
    private string host;
    private int port;
    private string path;
    private string query;
    private string fragment;
    private bool absolute;

    public Uri(string text) {
        if (text == null) { throw new ArgumentNullException("uriString"); }

        scheme = "";
        userInfo = "";
        host = "";
        port = -1;
        path = "";
        query = "";
        fragment = "";
        absolute = false;
        Parse(text);

        if (!absolute) {
            throw new UriFormatException("Invalid URI: The format of the URI could not be determined.");
        }
    }

    private Uri() {
        scheme = "";
        userInfo = "";
        host = "";
        port = -1;
        path = "";
        query = "";
        fragment = "";
    }

    public string Scheme => scheme;
    public string Host => host;
    public string UserInfo => userInfo;
    public bool IsAbsoluteUri => absolute;
    public string AbsolutePath => path;

    /// THE PATH AS A FILE NAME, which on this machine is the path itself: a
    /// Windows .NET turns file:///C:/x into C:\x, and here there is nothing to
    /// turn.
    public string LocalPath => path;

    public string Query => query;
    public string Fragment => fragment;

    /// THE PORT THE SCHEME MEANS when none was written: 80 for http, 443 for
    /// https, 21 for ftp. .NET reports the default rather than -1, which is
    /// what makes `new Uri("http://x").Port` 80.
    public int Port => port >= 0 ? port : DefaultPort(scheme);

    public bool IsDefaultPort => port < 0 || port == DefaultPort(scheme);

    public string Authority {
        get {
            if (port < 0 || port == DefaultPort(scheme)) { return host; }
            return String.Concat(host, String.Concat(":", String.FromInt(port)));
        }
    }

    public string PathAndQuery => String.Concat(path, query);

    /// THE PATH, CUT AFTER EACH SLASH, each piece keeping the slash that ended
    /// it -- "/a/b/c.html" is "/", "a/", "b/", "c.html". An odd shape until you
    /// notice that concatenating them gives the path back.
    public string[] Segments {
        get {
            List<string> made = new List<string>();
            int at = 0;

            while (at < path.Length) {
                int slash = String.IndexOf(path, '/', at);

                if (slash < 0) {
                    made.Add(String.Substring(path, at, path.Length - at));
                    break;
                }
                made.Add(String.Substring(path, at, slash - at + 1));
                at = slash + 1;
            }
            return made.ToArray();
        }
    }

    public string AbsoluteUri {
        get {
            StringBuilder made = new StringBuilder();

            made.Append(scheme);
            made.Append("://");
            if (userInfo.Length > 0) {
                made.Append(userInfo);
                made.Append('@');
            }
            made.Append(host);
            if (port >= 0 && port != DefaultPort(scheme)) {
                made.Append(':');
                made.Append(port);
            }
            made.Append(path.Length == 0 ? "/" : path);
            made.Append(query);
            made.Append(fragment);
            return made.ToString();
        }
    }

    public string ToString() { return AbsoluteUri; }

    public static bool TryCreate(string text, UriKind kind, out Uri? result) {
        result = null;

        if (text == null) { return false; }

        Uri made = new Uri();

        made.Parse(text);

        if (kind == UriKind.Absolute && !made.IsAbsoluteUri) { return false; }
        if (kind == UriKind.Relative && made.IsAbsoluteUri) { return false; }

        result = made;
        return true;
    }

    // ---- the pieces -------------------------------------------------------

    private void Parse(string text) {
        string rest = text;
        int mark = String.IndexOf(rest, '#');

        if (mark >= 0) {
            fragment = String.Substring(rest, mark, rest.Length - mark);
            rest = String.Substring(rest, 0, mark);
        }

        int ask = String.IndexOf(rest, '?');

        if (ask >= 0) {
            query = String.Substring(rest, ask, rest.Length - ask);
            rest = String.Substring(rest, 0, ask);
        }

        int colon = String.IndexOf(rest, ':');

        if (colon > 0 && colon + 2 < rest.Length
            && Sys.GetByte(rest, colon + 1) == (int)'/' && Sys.GetByte(rest, colon + 2) == (int)'/') {
            scheme = String.ToLowerInvariant(String.Substring(rest, 0, colon));
            absolute = true;
            rest = String.Substring(rest, colon + 3, rest.Length - colon - 3);

            int slash = String.IndexOf(rest, '/');
            string authority = slash < 0 ? rest : String.Substring(rest, 0, slash);

            path = slash < 0 ? "/" : String.Substring(rest, slash, rest.Length - slash);

            int at = String.IndexOf(authority, '@');

            if (at >= 0) {
                userInfo = String.Substring(authority, 0, at);
                authority = String.Substring(authority, at + 1, authority.Length - at - 1);
            }

            int portAt = String.IndexOf(authority, ':');

            if (portAt >= 0) {
                host = String.Substring(authority, 0, portAt);
                port = Int32.Parse(String.Substring(authority, portAt + 1, authority.Length - portAt - 1));
            } else {
                host = authority;
            }
        } else {
            path = rest;
        }
        path = Normalise(path);
    }

    /// "." AND ".." RESOLVED, because two URIs that name the same resource
    /// must compare equal and a path with a ".." in it names something else's
    /// spelling of the same place.
    private static string Normalise(string value) {
        if (String.IndexOf(value, '.') < 0) { return value; }

        bool rooted = value.Length > 0 && Sys.GetByte(value, 0) == (int)'/';
        bool trailing = value.Length > 1 && Sys.GetByte(value, value.Length - 1) == (int)'/';
        string[] parts = String.Split(value, '/');
        List<string> kept = new List<string>();

        for (int i = 0; i < parts.Length; i++) {
            string one = parts[i];

            if (one.Length == 0 || String.Compare(one, ".") == 0) { continue; }
            if (String.Compare(one, "..") == 0) {
                if (kept.Count > 0) { kept.RemoveAt(kept.Count - 1); }
                continue;
            }
            kept.Add(one);
        }

        StringBuilder made = new StringBuilder();

        if (rooted) { made.Append('/'); }
        for (int i = 0; i < kept.Count; i++) {
            if (i > 0) { made.Append('/'); }
            made.Append(kept[i]);
        }
        if (trailing && kept.Count > 0) { made.Append('/'); }
        return made.ToString();
    }

    private static int DefaultPort(string forScheme) {
        if (String.Compare(forScheme, "http") == 0) { return 80; }
        if (String.Compare(forScheme, "https") == 0) { return 443; }
        if (String.Compare(forScheme, "ftp") == 0) { return 21; }
        if (String.Compare(forScheme, "ssh") == 0) { return 22; }
        if (String.Compare(forScheme, "telnet") == 0) { return 23; }
        if (String.Compare(forScheme, "smtp") == 0) { return 25; }
        return -1;
    }

    // ---- escaping ---------------------------------------------------------

    /// PERCENT-ESCAPES EVERYTHING that is not unreserved -- letters, digits and
    /// `-._~` -- which is what a value going INTO a query string needs: a '&'
    /// or a '/' left alone there would be read as structure.
    public static string EscapeDataString(string value) {
        if (value == null) { throw new ArgumentNullException("stringToEscape"); }

        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < value.Length; i++) {
            int c = Sys.GetByte(value, i);

            if ((c >= (int)'a' && c <= (int)'z') || (c >= (int)'A' && c <= (int)'Z')
                || (c >= (int)'0' && c <= (int)'9')
                || c == (int)'-' || c == (int)'.' || c == (int)'_' || c == (int)'~') {
                made.Append((char)c);
                continue;
            }
            made.Append('%');
            made.Append((char)Sys.GetByte(alphabet, c >> 4));
            made.Append((char)Sys.GetByte(alphabet, c & 15));
        }
        return made.ToString();
    }

    public static string UnescapeDataString(string value) {
        if (value == null) { throw new ArgumentNullException("stringToUnescape"); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < value.Length) {
            int c = Sys.GetByte(value, at);

            if (c == (int)'%' && at + 2 < value.Length
                && IsHexDigit((char)Sys.GetByte(value, at + 1))
                && IsHexDigit((char)Sys.GetByte(value, at + 2))) {
                int high = NumberParse.DigitOf(Sys.GetByte(value, at + 1));
                int low = NumberParse.DigitOf(Sys.GetByte(value, at + 2));

                made.Append((char)(high * 16 + low));
                at = at + 3;
                continue;
            }
            made.Append((char)c);
            at = at + 1;
        }
        return made.ToString();
    }

    public static bool IsHexDigit(char c) {
        return Char.IsDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    public static bool IsWellFormedUriString(string text, UriKind kind) {
        Uri? made = null;

        return TryCreate(text, kind, out made);
    }
}

/// The URI could not be read. .NET derives it from FormatException, and a
/// program catching that catches this.
class UriFormatException : FormatException {
    public UriFormatException() : base("Invalid URI: The format of the URI could not be determined.") { }
    public UriFormatException(string message) : base(message) { }
}

// .NET's Convert, with the two members this machine has any use for: text in
// some base to a number, and a number to text in some base. A lexer reading
// `\u0041` calls the first with sixteen.
static class Convert {
    public static int ToInt32(string s, int fromBase) {
        int value = 0;

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetByte(s, i);
            int digit = 0 - 1;

            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 122) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 90) { digit = c - 65 + 10; }

            if (digit < 0 || digit >= fromBase) { return value; }

            value = value * fromBase + digit;
        }
        return value;
    }

    public static ulong ToUInt64(string s, int fromBase) {
        ulong value = 0;

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetByte(s, i);
            int digit = -1;

            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 122) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 90) { digit = c - 65 + 10; }
            if (digit < 0 || digit >= fromBase) { throw new FormatException("invalid digit"); }

            ulong next = value * (ulong)fromBase + (ulong)digit;
            if (next < value) { throw new OverflowException("integer is too large"); }
            value = next;
        }
        return value;
    }

    // ---- the conversions a program actually writes ------------------------
    //
    // .NET's Convert is a wall of overloads, one per pair of types, and the
    // reason it exists at all rather than everybody writing casts is that a
    // cast TRUNCATES and Convert ROUNDS -- to the even neighbour, like
    // Math.Round -- and that a value too large for the destination is an
    // OverflowException here and silent nonsense there.

    public static int ToInt32(string value) { return Int32.Parse(value); }
    public static long ToInt64(string value) { return Int64.Parse(value); }
    public static long ToInt64(string value, int fromBase) { return (long)ToUInt64(value, fromBase); }

    // The other widths in a base, as .NET has them: the digits read whole,
    // and too many for the width an OverflowException. In base 2, 8 and 16
    // .NET reads a signed type's top bit as its sign ("FF" is -1 as an
    // sbyte), and so do these.
    public static byte ToByte(string value, int fromBase) { return (byte)Within(value, fromBase, 0xFF, "an unsigned byte"); }
    public static ushort ToUInt16(string value, int fromBase) { return (ushort)Within(value, fromBase, 0xFFFF, "a UInt16"); }
    public static uint ToUInt32(string value, int fromBase) { return (uint)Within(value, fromBase, 0xFFFFFFFF, "a UInt32"); }
    public static sbyte ToSByte(string value, int fromBase) { return (sbyte)(byte)Within(value, fromBase, 0xFF, "a signed byte"); }
    public static short ToInt16(string value, int fromBase) { return (short)(ushort)Within(value, fromBase, 0xFFFF, "an Int16"); }

    static ulong Within(string value, int fromBase, ulong most, string what) {
        if (fromBase != 2 && fromBase != 8 && fromBase != 10 && fromBase != 16) { throw new ArgumentException("Invalid Base.", "fromBase"); }
        if (value.Length == 0) { throw new FormatException("Could not find any recognizable digits."); }
        string digits = fromBase == 16 && value.Length > 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X') ? value.Substring(2) : value;
        ulong got = ToUInt64(digits, fromBase);
        if (got > most) { throw new OverflowException("Value was either too large or too small for " + what + "."); }
        return got;
    }
    public static double ToDouble(string value) { return Double.Parse(value); }

    public static int ToInt32(double value) { return (int)Checked(Math.Round(value), -2147483648.0, 2147483647.0, "Int32"); }
    public static long ToInt64(double value) { return (long)Checked(Math.Round(value), -9223372036854775808.0, 9223372036854775807.0, "Int64"); }
    public static int ToInt32(long value) { return (int)Checked((double)value, -2147483648.0, 2147483647.0, "Int32"); }
    public static short ToInt16(long value) { return (short)Checked((double)value, -32768.0, 32767.0, "Int16"); }
    public static byte ToByte(long value) { return (byte)Checked((double)value, 0.0, 255.0, "unsigned byte"); }
    public static sbyte ToSByte(long value) { return (sbyte)Checked((double)value, -128.0, 127.0, "signed byte"); }

    public static int ToInt32(bool value) { return value ? 1 : 0; }
    public static double ToDouble(long value) { return (double)value; }

    /// "True" and "False" in any case, which is the only text .NET's
    /// ToBoolean(string) accepts -- "1" and "yes" are a FormatException.
    public static bool ToBoolean(string value) {
        if (value == null) { throw new ArgumentNullException("value"); }

        string folded = String.ToLowerInvariant(value);

        if (String.Compare(folded, "true") == 0) { return true; }
        if (String.Compare(folded, "false") == 0) { return false; }
        throw new FormatException("String was not recognized as a valid Boolean.");
    }

    public static string ToString(long value) { return String.FromInt(value); }
    public static string ToString(bool value) { return value ? "True" : "False"; }

    // A range check that says what .NET says, over doubles because that is the
    // one type every integral value fits in exactly up to 2^53 -- which is
    // where these conversions stop being interesting anyway.
    private static double Checked(double value, double low, double high, string what) {
        if (value < low || value > high) {
            throw new OverflowException(String.Concat("Value was either too large or too small for an ",
                                                      String.Concat(what, ".")));
        }
        return value;
    }

    // ---- base 64 ----------------------------------------------------------
    //
    // THREE BYTES BECOME FOUR CHARACTERS, six bits at a time, and the tail is
    // padded with '=' to keep the length a multiple of four. It is how binary
    // travels through anything that expects text -- a certificate, a mail
    // attachment, a JSON document -- and the alphabet is fixed by RFC 4648, so
    // this and .NET produce the same string byte for byte.
    public static string ToBase64String(byte[] bytes) {
        return ToBase64String(bytes, 0, bytes.Length);
    }

    public static string ToBase64String(byte[] bytes, int offset, int length) {
        string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder made = new StringBuilder();
        int at = offset;
        int end = offset + length;

        while (at < end) {
            int first = bytes[at] & 255;
            int second = at + 1 < end ? bytes[at + 1] & 255 : 0;
            int third = at + 2 < end ? bytes[at + 2] & 255 : 0;
            int block = (first << 16) | (second << 8) | third;

            made.Append((char)Sys.GetByte(alphabet, (block >> 18) & 63));
            made.Append((char)Sys.GetByte(alphabet, (block >> 12) & 63));
            made.Append(at + 1 < end ? (char)Sys.GetByte(alphabet, (block >> 6) & 63) : '=');
            made.Append(at + 2 < end ? (char)Sys.GetByte(alphabet, block & 63) : '=');
            at = at + 3;
        }
        return made.ToString();
    }

    public static byte[] FromBase64String(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }

        int[] values = new int[text.Length];
        int count = 0;

        for (int i = 0; i < text.Length; i++) {
            char c = (char)Sys.GetByte(text, i);
            int value = Base64Value(c);

            // WHITESPACE IS IGNORED and padding ends the data, both of which
            // .NET's decoder does: base 64 arrives wrapped at 76 columns more
            // often than not.
            if (c == ' ' || c == '\n' || c == '\r' || c == '\t') { continue; }
            if (c == '=') { break; }
            if (value < 0) { throw new FormatException("The input is not a valid Base-64 string."); }

            values[count] = value;
            count = count + 1;
        }

        int whole = count / 4;
        int leftover = count % 4;
        int size = whole * 3 + (leftover == 0 ? 0 : leftover - 1);
        byte[] made = new byte[size];
        int written = 0;
        int at = 0;

        while (at + 3 < count) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6) | values[at + 3];

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
            made[written + 2] = (byte)(block & 255);
            written = written + 3;
            at = at + 4;
        }

        if (leftover == 2) {
            made[written] = (byte)(((values[at] << 18) | (values[at + 1] << 12)) >> 16);
        } else if (leftover == 3) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6);

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
        } else if (leftover == 1) {
            throw new FormatException("The input is not a valid Base-64 string.");
        }
        return made;
    }

    private static int Base64Value(char c) {
        if (c >= 'A' && c <= 'Z') { return c - 'A'; }
        if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
        if (c >= '0' && c <= '9') { return c - '0' + 52; }
        if (c == '+') { return 62; }
        if (c == '/') { return 63; }
        return -1;
    }

    /// UPPER CASE AND NO SEPARATORS, which is where .NET 5's ToHexString
    /// differs from BitConverter.ToString: the same bytes, without the dashes.
    public static string ToHexString(byte[] bytes) {
        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < bytes.Length; i++) {
            int value = bytes[i] & 255;

            made.Append((char)Sys.GetByte(alphabet, value >> 4));
            made.Append((char)Sys.GetByte(alphabet, value & 15));
        }
        return made.ToString();
    }

    public static byte[] FromHexString(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }
        if (text.Length % 2 != 0) {
            throw new FormatException("The input is not a valid hex string as its length is not a multiple of 2.");
        }

        byte[] made = new byte[text.Length / 2];

        for (int i = 0; i < made.Length; i++) {
            int high = NumberParse.DigitOf(Sys.GetByte(text, i * 2));
            int low = NumberParse.DigitOf(Sys.GetByte(text, i * 2 + 1));

            if (high < 0 || high > 15 || low < 0 || low > 15) {
                throw new FormatException("The input is not a valid hex string as it contains a non-hex character.");
            }
            made[i] = (byte)(high * 16 + low);
        }
        return made;
    }

    public static string ToString(long value, int toBase) {
        if (value == 0) { return "0"; }

        string digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        string made = "";
        long left = value;

        while (left > 0) {
            made = String.Concat(String.Substring(digits, (int)(left % toBase), 1), made);
            left = left / toBase;
        }
        return made;
    }
}

// .NET's BitConverter, with the four members that reinterpret a number's BITS
// rather than convert its value -- which is what a compiler does to put a
// double in an image and take it out again.
static class BitConverter {
    public static long DoubleToInt64Bits(double value) { return Sys.Bits(value); }
    public static double Int64BitsToDouble(long value) { return Sys.FromBits(value); }
    public static int SingleToInt32Bits(float value) { return (int)Sys.Bits((double)value); }
    public static float Int32BitsToSingle(int value) { return (float)Sys.FromBits(value); }

    /// TRUE, and it is a fact about the processor rather than a choice: every
    /// machine this compiler targets stores the little end first. A program
    /// writing a format that is big-endian on the wire reads this and swaps.
    public static bool IsLittleEndian => true;

    // ---- a number as its bytes -------------------------------------------
    //
    // LITTLE END FIRST, which is what the machine holds them as, so what comes
    // back is the number's storage and not a rendering of it. This is the pair
    // a file format and a network protocol are written with.

    public static byte[] GetBytes(bool value) {
        byte[] made = new byte[1];

        made[0] = (byte)(value ? 1 : 0);
        return made;
    }

    public static byte[] GetBytes(char value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(short value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(ushort value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(int value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(uint value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(long value) { return Spread(value, 8); }
    public static byte[] GetBytes(ulong value) { return Spread((long)value, 8); }
    public static byte[] GetBytes(double value) { return Spread(Sys.Bits(value), 8); }
    public static byte[] GetBytes(float value) { return Spread((long)SingleToInt32Bits(value), 4); }

    public static bool ToBoolean(byte[] bytes, int at) { return bytes[at] != 0; }
    public static char ToChar(byte[] bytes, int at) { return (char)Gather(bytes, at, 2, false); }
    public static short ToInt16(byte[] bytes, int at) { return (short)Gather(bytes, at, 2, true); }
    public static ushort ToUInt16(byte[] bytes, int at) { return (ushort)Gather(bytes, at, 2, false); }
    public static int ToInt32(byte[] bytes, int at) { return (int)Gather(bytes, at, 4, true); }
    public static uint ToUInt32(byte[] bytes, int at) { return (uint)Gather(bytes, at, 4, false); }
    public static long ToInt64(byte[] bytes, int at) { return Gather(bytes, at, 8, true); }
    public static ulong ToUInt64(byte[] bytes, int at) { return (ulong)Gather(bytes, at, 8, true); }
    public static double ToDouble(byte[] bytes, int at) { return Sys.FromBits(Gather(bytes, at, 8, true)); }
    public static float ToSingle(byte[] bytes, int at) { return Int32BitsToSingle((int)Gather(bytes, at, 4, true)); }

    /// THE BYTES IN CAPITALS, SEPARATED BY DASHES -- "00-11-FF". An odd shape
    /// for a ToString until you have read a dump written by one, which is what
    /// it is for; Convert.ToHexString is the same bytes without the dashes.
    public static string ToString(byte[] bytes) { return ToString(bytes, 0, bytes.Length); }

    public static string ToString(byte[] bytes, int at) { return ToString(bytes, at, bytes.Length - at); }

    public static string ToString(byte[] bytes, int at, int count) {
        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < count; i++) {
            int value = bytes[at + i] & 255;

            if (i > 0) { made.Append('-'); }
            made.Append((char)Sys.GetByte(alphabet, value >> 4));
            made.Append((char)Sys.GetByte(alphabet, value & 15));
        }
        return made.ToString();
    }

    private static byte[] Spread(long value, int width) {
        byte[] made = new byte[width];

        for (int i = 0; i < width; i++) { made[i] = (byte)((value >> (i * 8)) & 255); }
        return made;
    }

    private static long Gather(byte[] bytes, int at, int width, bool signed) {
        long value = 0;

        for (int i = 0; i < width; i++) { value = value | ((long)(bytes[at + i] & 255) << (i * 8)); }

        if (signed && width < 8) {
            int spare = 64 - width * 8;

            value = (value << spare) >> spare;
        }
        return value;
    }
}

// ---- the numbers, by the names C# gives their types ------------------------
//
// `int.TryParse(text, out n)` reaches this because `int` is an ALIAS for Int32
// and the checker resolves the keyword to the class. That is C#'s own
// arrangement rather than a trick: every one of these is a real type there,
// with these members on it, and writing `Int64.Parse` compiles in both.

// ---- numbers as text, and text as numbers ---------------------------------
//
// WHAT A FORMAT STRING MEANS. `n.ToString("X8")`, `count.ToString("N0")`,
// `bytes.ToString("D5")` -- a letter saying which shape and an optional number
// saying how many, which is .NET's standard numeric format string in full for
// the integral types. The custom pictures ("#,##0.00") are a different grammar
// and are not here.
//
// It lives in a class of its own because every integral type needs it and each
// of them differs only in how wide its two's complement is -- which is the one
// thing the hexadecimal and binary shapes have to know, since (-1).ToString("X")
// is eight F's for an int and sixteen for a long.
static class NumberFormat {
    private static string Lower = "0123456789abcdef";
    private static string Upper = "0123456789ABCDEF";

    private static string Digits(ulong value, int radix, string alphabet) {
        if (value == 0) { return "0"; }

        string made = "";
        ulong left = value;

        while (left > 0) {
            made = String.Concat(String.Substring(alphabet, (int)(left % (ulong)radix), 1), made);
            left = left / (ulong)radix;
        }
        return made;
    }

    /// The digit count after the letter, or -1 when there is none. ".NET reads
    /// at most two"; anything longer is not a standard format string at all.
    private static int Width(string format) {
        if (format.Length < 2) { return -1; }

        int made = 0;
        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit((char)Sys.GetByte(format, i))) { throw new FormatException(format); }
            made = made * 10 + (Sys.GetByte(format, i) - 48);
        }
        return made;
    }

    /// THOUSANDS SEPARATED BY COMMAS, counting from the right -- which is what
    /// "N" means on an invariant culture, and this machine has only that one.
    private static string Group(string digits) {
        StringBuilder made = new StringBuilder();
        int n = digits.Length;

        for (int i = 0; i < n; i++) {
            if (i > 0 && (n - i) % 3 == 0) { made.Append(','); }
            made.Append((char)Sys.GetByte(digits, i));
        }
        return made.ToString();
    }

    /// `value`, as `format` says, where `bits` is how wide the type is: it
    /// decides what a negative number looks like in hexadecimal and binary,
    /// where .NET shows the two's complement rather than a minus sign.
    public static string Of(long value, int bits, string format) {
        if (format.Length == 0) { return String.FromInt(value); }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = (char)Sys.GetByte(format, 0);
        int width = Width(format);
        ulong whole = (ulong)value;
        ulong bitsOf = bits == 64 ? whole : whole & (((ulong)1 << bits) - (ulong)1);
        bool negative = value < 0;
        string plain = String.FromInt(negative ? -value : value);

        if (kind == 'x') { return Pad(Digits(bitsOf, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(bitsOf, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(bitsOf, 2, Lower), width); }

        if (kind == 'd' || kind == 'D') {
            return negative ? String.Concat("-", Pad(plain, width)) : Pad(plain, width);
        }

        if (kind == 'n' || kind == 'N') {
            string body = Group(plain);
            int places = width < 0 ? 2 : width;
            if (places > 0) { body = String.Concat(body, String.Concat(".", String.Repeat('0', places))); }
            return negative ? String.Concat("-", body) : body;
        }

        if (kind == 'f' || kind == 'F') {
            int places = width < 0 ? 2 : width;
            string body = places > 0
                        ? String.Concat(plain, String.Concat(".", String.Repeat('0', places)))
                        : plain;
            return negative ? String.Concat("-", body) : body;
        }

        if (kind == 'g' || kind == 'G') { return String.FromInt(value); }

        throw new FormatException(format);
    }

    /// The UNSIGNED form, which cannot simply widen to long: a ulong above
    /// long.MaxValue would come out negative and print a minus sign.
    public static string OfUnsigned(ulong value, string format) {
        if (format.Length == 0) { return Digits(value, 10, Lower); }
        if (PictureFormat.Is(format)) { return PictureFormat.OfUnsigned(value, format); }

        char kind = (char)Sys.GetByte(format, 0);
        int width = Width(format);

        if (kind == 'x') { return Pad(Digits(value, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(value, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(value, 2, Lower), width); }
        if (kind == 'd' || kind == 'D' || kind == 'g' || kind == 'G') {
            return Pad(Digits(value, 10, Lower), width);
        }
        if (kind == 'n' || kind == 'N') {
            string body = Group(Digits(value, 10, Lower));
            int places = width < 0 ? 2 : width;
            if (places > 0) { body = String.Concat(body, String.Concat(".", String.Repeat('0', places))); }
            return body;
        }
        throw new FormatException(format);
    }

    private static string Pad(string s, int width) {
        if (width <= s.Length) { return s; }
        return String.Concat(String.Repeat('0', width - s.Length), s);
    }
}

// A REAL NUMBER AS TEXT, which this library could not do at all: a double
// could be computed, stored and compared, and the only way to look at one was
// to scale it to a long and print that. Every test of the maths above does
// exactly that, and every one of them is checking a number it cannot read.
//
// WHAT IS HERE AND WHAT IS NOT. "F", "E", "G" and the default, which is what
// numeric output is written in. The default takes fifteen significant digits
// and trims what they do not need; .NET takes the SHORTEST run of digits that
// reads back as the same double, which needs an exact big-decimal conversion
// (Ryu, Grisu) that nothing here has yet. The two agree on every number whose
// value needs fifteen digits or fewer -- which is every number a program
// writes down -- and differ on the sixteenth-digit tail of a computed one.
static class DoubleFormat {
    /// NOT A NUMBER IS NOT EQUAL TO ITSELF, which is the only test for it that
    /// does not need a bit pattern.
    public static bool IsNaN(double x) { return x != x; }

    public static bool IsInfinity(double x) {
        return x > 1.7976931348623157e308 || x < -1.7976931348623157e308;
    }

    private static string? Special(double x) {
        if (IsNaN(x)) { return "NaN"; }
        if (x > 0.0 && IsInfinity(x)) { return "Infinity"; }
        if (x < 0.0 && IsInfinity(x)) { return "-Infinity"; }
        return null;
    }

    /// `places` digits after the point, rounded half away from zero -- and the
    /// sign is kept even when every digit rounds to nought, because that is
    /// what .NET prints and because -0.00 says something 0.00 does not.
    public static string Fixed(double value, int places) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = value < 0.0;
        double x = negative ? -value : value;

        double scale = 1.0;
        for (int i = 0; i < places; i++) { scale = scale * 10.0; }

        long scaled = (long)(x * scale + 0.5);
        string digits = String.FromInt(scaled);

        if (places == 0) {
            return negative ? String.Concat("-", digits) : digits;
        }

        if (digits.Length <= places) {
            digits = String.Concat(String.Repeat('0', places + 1 - digits.Length), digits);
        }

        string body = String.Concat(String.Substring(digits, 0, digits.Length - places),
                      String.Concat(".", String.Substring(digits, digits.Length - places, places)));
        return negative ? String.Concat("-", body) : body;
    }

    /// The significant digits of |x|, and its decimal exponent, worked out by
    /// scaling into [1, 10) and peeling one digit at a time.
    ///
    /// ONE DIGIT MORE THAN ASKED FOR IS TAKEN, so the last one can be rounded
    /// rather than truncated: 0.999999 to five digits is 1.0000 and not 0.9999.
    private static string Significant(double x, int count, out int exponent) {
        int e = 0;
        double v = x;

        while (v >= 10.0) {
            v = v / 10.0;
            e = e + 1;
        }
        while (v > 0.0 && v < 1.0) {
            v = v * 10.0;
            e = e - 1;
        }

        int[] digits = new int[count + 1];
        for (int i = 0; i <= count; i++) {
            int d = (int)v;
            if (d > 9) { d = 9; }
            digits[i] = d;
            v = (v - (double)d) * 10.0;
        }

        if (digits[count] >= 5) {
            int at = count - 1;
            while (at >= 0) {
                digits[at] = digits[at] + 1;
                if (digits[at] < 10) { break; }
                digits[at] = 0;
                at = at - 1;
            }
            // Every digit carried, so the number rolled over to the next power
            // of ten: 9.99 to two digits is 10, which is 1.0 one exponent up.
            if (at < 0) {
                digits[0] = 1;
                e = e + 1;
            }
        }

        StringBuilder made = new StringBuilder();
        for (int i = 0; i < count; i++) { made.Append((char)(48 + digits[i])); }

        exponent = e;
        return made.ToString();
    }

    private static string TrimZeros(string s) {
        int end = s.Length;
        while (end > 1 && Sys.GetByte(s, end - 1) == 48) { end = end - 1; }
        return String.Substring(s, 0, end);
    }

    /// `d.dddE+eee`, with .NET's three-digit exponent and its default of six
    /// places after the point.
    public static string Scientific(double value, int places, char letter) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = value < 0.0;
        double x = negative ? -value : value;

        if (x == 0.0) {
            string zeros = places > 0 ? String.Concat(".", String.Repeat('0', places)) : "";
            return String.Concat(negative ? "-0" : "0",
                   String.Concat(zeros, String.Concat(String.FromByte((long)letter), "+000")));
        }

        int exponent = 0;
        string digits = Significant(x, places + 1, out exponent);

        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }
        made.Append((char)Sys.GetByte(digits, 0));
        if (places > 0) {
            made.Append('.');
            made.Append(String.Substring(digits, 1, places));
        }
        made.Append(letter);
        made.Append(exponent < 0 ? '-' : '+');

        string power = String.FromInt(exponent < 0 ? -exponent : exponent);
        made.Append(String.PadLeft(power, 3, '0'));
        return made.ToString();
    }

    /// The default shape, which is .NET's "G": plain digits while the exponent
    /// is small enough to read, and scientific when it is not.
    public static string General(double value, int significant) {
        string? special = Special(value);
        if (special != null) { return special; }
        if (value == 0.0) { return "0"; }

        bool negative = value < 0.0;
        double x = negative ? -value : value;

        int exponent = 0;
        string digits = TrimZeros(Significant(x, significant, out exponent));

        // .NET's switch points for a double: below 1e-5 and at or above the
        // precision itself, the exponent form is shorter and it uses it.
        if (exponent < -5 || exponent >= significant) {
            StringBuilder e = new StringBuilder();
            if (negative) { e.Append('-'); }
            e.Append((char)Sys.GetByte(digits, 0));
            if (digits.Length > 1) {
                e.Append('.');
                e.Append(String.Substring(digits, 1, digits.Length - 1));
            }
            e.Append('E');
            e.Append(exponent < 0 ? '-' : '+');
            e.Append(String.PadLeft(String.FromInt(exponent < 0 ? -exponent : exponent), 2, '0'));
            return e.ToString();
        }

        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }

        if (exponent < 0) {
            made.Append("0.");
            made.Append(String.Repeat('0', -exponent - 1));
            made.Append(digits);
            return made.ToString();
        }

        if (digits.Length <= exponent + 1) {
            made.Append(digits);
            made.Append(String.Repeat('0', exponent + 1 - digits.Length));
            return made.ToString();
        }

        made.Append(String.Substring(digits, 0, exponent + 1));
        made.Append('.');
        made.Append(String.Substring(digits, exponent + 1, digits.Length - exponent - 1));
        return made.ToString();
    }

    public static string Of(double value, string format) {
        if (format.Length == 0) { return General(value, 15); }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = (char)Sys.GetByte(format, 0);
        int width = -1;

        if (format.Length > 1) {
            width = 0;
            for (int i = 1; i < format.Length; i++) {
                if (!Char.IsDigit((char)Sys.GetByte(format, i))) { throw new FormatException(format); }
                width = width * 10 + (Sys.GetByte(format, i) - 48);
            }
        }

        if (kind == 'f' || kind == 'F') { return Fixed(value, width < 0 ? 2 : width); }
        if (kind == 'e') { return Scientific(value, width < 0 ? 6 : width, 'e'); }
        if (kind == 'E') { return Scientific(value, width < 0 ? 6 : width, 'E'); }
        if (kind == 'g' || kind == 'G') { return General(value, width <= 0 ? 15 : width); }
        if (kind == 'r' || kind == 'R') { return General(value, 17); }
        if (kind == 'n' || kind == 'N') {
            string body = Fixed(value, width < 0 ? 2 : width);
            bool negative = Sys.GetByte(body, 0) == 45;
            if (negative) { body = String.Substring(body, 1, body.Length - 1); }

            int point = String.IndexOf(body, '.');
            string head = point < 0 ? body : String.Substring(body, 0, point);
            string tail = point < 0 ? "" : String.Substring(body, point, body.Length - point);

            StringBuilder grouped = new StringBuilder();
            if (negative) { grouped.Append('-'); }
            for (int i = 0; i < head.Length; i++) {
                if (i > 0 && (head.Length - i) % 3 == 0) { grouped.Append(','); }
                grouped.Append((char)Sys.GetByte(head, i));
            }
            grouped.Append(tail);
            return grouped.ToString();
        }
        throw new FormatException(format);
    }
}

// ---- a picture of a number ------------------------------------------------
//
// `n.ToString("0.00")`, `total.ToString("#,##0")`, `part.ToString("0%")` --
// .NET's CUSTOM numeric format strings, which are a different grammar from the
// standard ones above: instead of a letter naming a shape, the format IS the
// shape, a digit at a time.
//
// The two placeholders are the whole of it. `0` is a digit that is always
// printed, so it pads with zeros; `#` is a digit that is printed only if the
// number has one, so it trims. Everything else in the picture is itself --
// which is what makes `0;(0);zero` print accounts' negatives in brackets and
// `0%` multiply by a hundred and write the sign.
//
// The sections are split on `;`: positive, negative and zero, in that order.
// A number that falls in a section is formatted by it WITHOUT its sign, which
// is why the negative section has to write its own minus if it wants one.
static class PictureFormat {
    /// WHETHER A FORMAT IS A PICTURE at all, which is what decides between
    /// this file's two grammars. A standard format is a single letter and an
    /// optional number after it; everything else is a picture, including "000"
    /// and "#" and ".00".
    public static bool Is(string format) {
        if (format.Length == 0) { return false; }

        char kind = (char)Sys.GetByte(format, 0);

        if (!Char.IsLetter(kind)) { return true; }

        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit((char)Sys.GetByte(format, i))) { return true; }
        }
        return false;
    }

    public static string Of(double value, string format) {
        string picture = Section(format, value > 0.0 ? 1 : (value < 0.0 ? -1 : 0));
        bool signed = value < 0.0 && Sections(format) < 2;
        double size = value < 0.0 ? 0.0 - value : value;

        if (Has(picture, '%')) { size = size * 100.0; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = size / 1000.0; }

        int places = Decimals(picture);
        string body = DoubleFormat.Fixed(size, places);
        int point = String.IndexOf(body, '.');

        string whole = point < 0 ? body : String.Substring(body, 0, point);
        string fraction = point < 0 ? "" : String.Substring(body, point + 1, body.Length - point - 1);

        return Render(picture, signed, whole, fraction);
    }

    /// The same for a whole number, which must not go through a double: a long
    /// above 2^53 would lose its last digits on the way.
    public static string Of(long value, string format) {
        string picture = Section(format, value > 0 ? 1 : (value < 0 ? -1 : 0));
        bool signed = value < 0 && Sections(format) < 2;
        long size = value < 0 ? -value : value;

        if (Has(picture, '%')) { size = size * 100; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = (size + 500) / 1000; }

        return Render(picture, signed, String.FromInt(size),
                      String.Repeat('0', Decimals(picture)));
    }

    public static string OfUnsigned(ulong value, string format) {
        string picture = Section(format, value > 0 ? 1 : 0);
        ulong size = value;

        if (Has(picture, '%')) { size = size * 100; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = (size + 500) / 1000; }

        return Render(picture, false, Decimal(size), String.Repeat('0', Decimals(picture)));
    }

    /// An unsigned number's digits, which String.FromInt cannot give: a ulong
    /// above long.MaxValue would come back negative.
    private static string Decimal(ulong value) {
        if (value == 0) { return "0"; }

        StringBuilder made = new StringBuilder();
        ulong left = value;

        while (left > 0) {
            made.Append((char)(48 + (int)(left % 10)));
            left = left / 10;
        }
        return String.Reverse(made.ToString());
    }

    // ---- the picture, read ------------------------------------------------

    /// How many sections the format has: positive, negative, zero.
    private static int Sections(string format) {
        int count = 1;

        for (int i = 0; i < format.Length; i++) {
            if (Sys.GetByte(format, i) == (int)';') { count = count + 1; }
        }
        return count;
    }

    /// The section a number of this sign is written by. A missing negative
    /// section means the positive one with a minus in front, and a missing zero
    /// section means the positive one -- .NET's rules, and the reason the sign
    /// is handled here rather than in the renderer.
    private static string Section(string format, int sign) {
        string[] parts = String.Split(format, ';');

        if (sign < 0 && parts.Length >= 2) { return parts[1]; }
        if (sign == 0 && parts.Length >= 3) { return parts[2]; }
        return parts[0];
    }

    private static bool Has(string picture, char c) {
        return String.IndexOf(picture, c) >= 0;
    }

    /// The digits after the point the picture asks for, which is how many the
    /// number is rounded to.
    private static int Decimals(string picture) {
        int point = String.IndexOf(picture, '.');

        if (point < 0) { return 0; }

        int count = 0;

        for (int i = point + 1; i < picture.Length; i++) {
            int c = Sys.GetByte(picture, i);

            if (c == (int)'0' || c == (int)'#') { count = count + 1; }
        }
        return count;
    }

    /// A COMMA WITH NOTHING BUT THE POINT AFTER IT DIVIDES BY A THOUSAND, and
    /// two commas by a million. It is the one part of the grammar nobody
    /// guesses, and it is how a report prints bytes as kilobytes.
    private static int Thousands(string picture) {
        int point = String.IndexOf(picture, '.');
        int end = point < 0 ? picture.Length : point;
        int count = 0;
        int at = end - 1;

        while (at >= 0 && Sys.GetByte(picture, at) == (int)',') {
            count = count + 1;
            at = at - 1;
        }
        return count;
    }

    /// A comma BETWEEN two digit placeholders asks for the thousands to be
    /// separated -- which is a different job from the comma above, told apart
    /// only by what surrounds it.
    private static bool Grouped(string picture) {
        int point = String.IndexOf(picture, '.');
        int end = point < 0 ? picture.Length : point;

        for (int i = 1; i < end - 1; i++) {
            if (Sys.GetByte(picture, i) != (int)',') { continue; }
            if (IsSlot(picture, i - 1) && IsSlot(picture, i + 1)) { return true; }
        }
        return false;
    }

    /// Whether the picture has any digit placeholder at all. One that has none
    /// is pure literal text, and the number is not printed.
    private static bool AnySlot(string picture) {
        for (int i = 0; i < picture.Length; i++) {
            if (IsSlot(picture, i)) { return true; }
        }
        return false;
    }

    private static bool IsSlot(string picture, int at) {
        int c = Sys.GetByte(picture, at);

        return c == (int)'0' || c == (int)'#';
    }

    // ---- the picture, written ---------------------------------------------

    private static string Render(string picture, bool signed, string whole, string fraction) {
        bool group = Grouped(picture);
        int point = String.IndexOf(picture, '.');
        string head = point < 0 ? picture : String.Substring(picture, 0, point);
        string tail = point < 0 ? "" : String.Substring(picture, point + 1, picture.Length - point - 1);

        StringBuilder made = new StringBuilder();

        if (signed) { made.Append('-'); }
        made.Append(Whole(head, whole, group, AnySlot(picture)));

        string after = Fraction(tail, fraction);

        if (after.Length > 0) {
            made.Append('.');
            made.Append(after);
        }
        return made.ToString();
    }

    /// The integer side, right to left: each placeholder takes the next digit
    /// from the right, a `0` with nothing left to take writes a zero and a `#`
    /// writes nothing, and anything that is not a placeholder is itself.
    /// Digits the picture has no room for are not lost -- they go in front,
    /// which is why "00" can still print a thousand.
    private static string Whole(string head, string digits, bool group, bool anywhere) {
        // A NUMBER WHOSE WHOLE PART IS NOUGHT DISAPPEARS when the picture asks
        // for it with '#' alone: .NET prints "" for 0 through "#" and ".5" for
        // a half through "#.##".
        string left = digits;

        if (String.Compare(left, "0") == 0 && String.IndexOf(head, '0') < 0) { left = ""; }

        StringBuilder reversed = new StringBuilder();
        int at = left.Length - 1;
        int written = 0;
        int leftmost = -1;

        for (int i = 0; i < head.Length; i++) {
            if (IsSlot(head, i)) { leftmost = i; break; }
        }

        for (int i = head.Length - 1; i >= 0; i--) {
            char c = (char)Sys.GetByte(head, i);

            if (c == ',') { continue; }

            if (c == '0' || c == '#') {
                if (at >= 0) {
                    if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                    reversed.Append((char)Sys.GetByte(left, at));
                    written = written + 1;
                    at = at - 1;
                } else if (c == '0') {
                    if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                    reversed.Append('0');
                    written = written + 1;
                }

                // MORE DIGITS THAN THE PICTURE HAS ROOM FOR go at the LEFTMOST
                // placeholder, not at the front of the whole thing: "(0)" on a
                // thousand is "(1234)" and not "123(4)". The picture says where
                // the number sits among the literals, not how long it may be.
                if (i == leftmost) {
                    while (at >= 0) {
                        if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                        reversed.Append((char)Sys.GetByte(left, at));
                        written = written + 1;
                        at = at - 1;
                    }
                }
                continue;
            }
            reversed.Append(c);
        }

        // A PICTURE THAT PLACES ONLY THE FRACTION still prints the whole part:
        // ".00" on one and a quarter is "1.25", because the placeholders after
        // the point are what make it a number rather than a literal.
        if (leftmost < 0 && anywhere) {
            while (at >= 0) {
                if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                reversed.Append((char)Sys.GetByte(left, at));
                written = written + 1;
                at = at - 1;
            }
        }
        return String.Reverse(reversed.ToString());
    }

    /// The fraction, left to right, with the trailing digits the picture asked
    /// for with '#' dropped when they are zeros -- which is the whole
    /// difference between "0.00" and "0.##".
    private static string Fraction(string tail, string digits) {
        int keep = digits.Length;
        int slot = 0;

        // Where each placeholder is, so that a trailing zero can be dropped
        // only if the placeholder above it was a '#'.
        for (int i = tail.Length - 1; i >= 0; i--) {
            char c = (char)Sys.GetByte(tail, i);

            if (c != '0' && c != '#') { continue; }

            slot = Slots(tail, i);
            if (c == '0') { break; }
            if (slot <= keep && slot > 0 && Sys.GetByte(digits, slot - 1) == (int)'0') {
                keep = slot - 1;
            } else {
                break;
            }
        }

        StringBuilder made = new StringBuilder();
        int taken = 0;

        for (int i = 0; i < tail.Length; i++) {
            char c = (char)Sys.GetByte(tail, i);

            if (c == '0' || c == '#') {
                if (taken >= keep) { break; }
                made.Append((char)Sys.GetByte(digits, taken));
                taken = taken + 1;
                continue;
            }
            made.Append(c);
        }
        return made.ToString();
    }

    /// How many placeholders there are up to and including this one.
    private static int Slots(string tail, int at) {
        int count = 0;

        for (int i = 0; i <= at; i++) {
            int c = Sys.GetByte(tail, i);

            if (c == (int)'0' || c == (int)'#') { count = count + 1; }
        }
        return count;
    }
}

// TEXT IN SOME BASE, ONCE, for every integral type to share. Each of them had
// its own copy of this loop or, more often, did not have one at all: hex was
// reachable through Convert.ToInt32(s, 16) and nowhere else, so
// `int.TryParse(s, NumberStyles.HexNumber, null, out n)` -- the form a program
// that reads a configuration file writes -- did not compile.
static class NumberParse {
    /// WHAT .NET SAYS WHEN TEXT IS NOT A NUMBER, quoting the text: a message
    /// that names the offending string is the difference between a bug report
    /// and a guess. Parse throws it; TryParse is the same work with the throw
    /// turned into a false.
    public static FormatException Bad(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return new FormatException(String.Concat("The input string '",
                                   String.Concat(s, "' was not in a correct format.")));
    }

    /// The other refusal: the digits were digits and there were too many of
    /// them for the type asked for.
    public static OverflowException TooBig(string what) {
        return new OverflowException(String.Concat("Value was either too large or too small for an ",
                                     String.Concat(what, ".")));
    }

    /// A DIGIT'S VALUE IN ANY BASE UP TO 36, or -1. Letters count from ten in
    /// either case, which is what every base above ten means by them.
    public static int DigitOf(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 122) { return c - 97 + 10; }
        if (c >= 65 && c <= 90) { return c - 65 + 10; }
        return -1;
    }

    /// FALSE ON OVERFLOW AS WELL AS ON RUBBISH, which is .NET's contract for
    /// TryParse and the reason the running value is checked rather than the
    /// result: once it has wrapped there is nothing left to notice.
    public static bool TryUnsigned(string s, int radix, out ulong value) {
        value = 0;
        if (s.Length == 0) { return false; }

        ulong made = 0;
        for (int i = 0; i < s.Length; i++) {
            int digit = DigitOf(Sys.GetByte(s, i));
            if (digit < 0 || digit >= radix) { return false; }

            ulong next = made * (ulong)radix + (ulong)digit;
            if (next < made) { return false; }
            made = next;
        }
        value = made;
        return true;
    }

    /// A SIGN IS DECIMAL ONLY: .NET's HexNumber style rejects one outright,
    /// because a hexadecimal literal already says its sign in its top bit.
    ///
    /// `bits` is the width of the type being parsed into, which decides both
    /// the range a decimal number may occupy and -- for hexadecimal -- where
    /// the sign bit is.
    public static bool TrySigned(string s, int radix, int bits, out long value) {
        value = 0;
        if (s.Length == 0) { return false; }

        bool negative = false;
        int at = 0;

        if (radix == 10 && (s[0] == '-' || s[0] == '+')) {
            negative = s[0] == '-';
            at = 1;
        }
        if (at >= s.Length) { return false; }

        ulong made = 0;
        if (!TryUnsigned(String.Substring(s, at, s.Length - at), radix, out made)) { return false; }

        // HEXADECIMAL IS A BIT PATTERN, not a magnitude: "FFFFFFFF" parsed as
        // an int is -1 in .NET, so the digits are read as the two's complement
        // of the type's width rather than rejected as a number too large.
        if (radix != 10) {
            if (bits == 64) {
                value = (long)made;
                return true;
            }

            ulong span = (ulong)1 << bits;
            if (made >= span) { return false; }

            ulong sign = (ulong)1 << (bits - 1);
            value = made >= sign ? (long)made - (long)span : (long)made;
            return true;
        }

        long high = bits == 64 ? long.MaxValue : ((long)1 << (bits - 1)) - 1;
        long low = -high - 1;

        if (negative) {
            // The most negative value of every width has no positive twin, so
            // it is recognised by its magnitude before the negation that would
            // overflow.
            if (made == (ulong)high + (ulong)1) {
                value = low;
                return true;
            }
            if (made > (ulong)high) { return false; }
            value = -(long)made;
            return true;
        }

        if (made > (ulong)high) { return false; }
        value = (long)made;
        return true;
    }
}

// ---- the narrow integral types, by the names C# gives them -----------------
//
// Each is a thin naming of the two routines above. They exist because
// `byte.TryParse(field, out b)` is what a program that reads a byte writes,
// and because the range check belongs to the TYPE rather than to the caller.

static class SByte {
    public static sbyte MaxValue => sbyte.MaxValue;
    public static sbyte MinValue => sbyte.MinValue;

    public static bool TryParse(string s, out sbyte value) {
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, 10, 8, out wide);
        value = (sbyte)wide;
        return ok;
    }

    public static sbyte Parse(string s) {
        sbyte value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this sbyte value, string format) {
        return NumberFormat.Of(value, 8, format);
    }
}

static class Int16 {
    public static short MaxValue => short.MaxValue;
    public static short MinValue => short.MinValue;

    public static bool TryParse(string s, out short value) {
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, 10, 16, out wide);
        value = (short)wide;
        return ok;
    }

    public static short Parse(string s) {
        short value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this short value, string format) {
        return NumberFormat.Of(value, 16, format);
    }
}

static class UInt16 {
    public static ushort MaxValue => ushort.MaxValue;
    public static ushort MinValue => 0;

    public static bool TryParse(string s, out ushort value) {
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 65535;
        value = (ushort)wide;
        return ok;
    }

    public static ushort Parse(string s) {
        ushort value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this ushort value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }
}

static class UInt32 {
    public static uint MaxValue => uint.MaxValue;
    public static uint MinValue => 0;

    public static bool TryParse(string s, out uint value) {
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 4294967295;
        value = (uint)wide;
        return ok;
    }

    public static bool TryParse(string s, NumberStyles style, IFormatProvider? provider, out uint value) {
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, style == NumberStyles.HexNumber ? 16 : 10, out wide)
               && wide <= 4294967295;
        value = (uint)wide;
        return ok;
    }

    public static uint Parse(string s) {
        uint value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static uint Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static uint Parse(string s, NumberStyles style) {
        return Parse(s, style, CultureInfo.InvariantCulture);
    }

    public static uint Parse(string s, NumberStyles style, IFormatProvider? provider) {
        uint value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static uint Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static string ToString(this uint value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }
}

static class Int64 {
    public static int CompareTo(long value, long other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(long value, object? other) {
        if (other == null) return 1;
        if (other is long number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Int64");
    }
    // THE LIMITS, UNDER THE TYPE'S OWN NAME. `long.MaxValue` is answered by the
    // compiler, which knows the keyword; `Int64.MaxValue` is the same constant
    // written the other way C# allows, and nothing answered it.
    public static long MaxValue => long.MaxValue;
    public static long MinValue => long.MinValue;

    // TRUE WHEN IT PARSED, and the value is only meaningful then -- .NET's
    // contract, and the reason this exists beside Parse: a number that might
    // not be one is ordinary input, not an exceptional case.
    public static bool TryParse(string s, out long value) {
        value = 0;

        if (s.Length == 0) { return false; }

        bool negative = s[0] == '-';
        int at = negative || s[0] == '+' ? 1 : 0;

        if (at >= s.Length) { return false; }

        long made = 0;

        while (at < s.Length) {
            int c = Sys.GetByte(s, at);

            if (c < 48 || c > 57) {
                value = 0;
                return false;
            }

            made = made * 10 + (c - 48);
            at = at + 1;
        }

        value = negative ? -made : made;
        return true;
    }

    // .NET throws FormatException here. There is nothing to throw from a
    // library this low yet, so a number that is not one answers zero -- and
    // TryParse is what a caller that cares uses in .NET anyway.
    public static long Parse(string s) {
        long value = 0;

        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this long value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this long value, string format) {
        return NumberFormat.Of(value, 64, format);
    }

    public static bool TryParse(string s, NumberStyles style, IFormatProvider? provider, out long value) {
        return NumberParse.TrySigned(s, style == NumberStyles.HexNumber ? 16 : 10, 64, out value);
    }

    public static long Parse(string s, NumberStyles style) {
        long value = 0;
        if (!TryParse(s, style, CultureInfo.InvariantCulture, out value)) {
            throw new FormatException(s);
        }
        return value;
    }

    /// The rest of .NET's set: a culture, a style and a culture, and a span.
    public static long Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static long Parse(string s, NumberStyles style, IFormatProvider? provider) {
        long value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static long Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static long Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s.ToString()); }

    public static bool TryParse(ReadOnlySpan<char> s, out long value) {
        return TryParse(s.ToString(), out value);
    }
}

static class Int32 {
    public static int MaxValue => int.MaxValue;
    public static int MinValue => int.MinValue;

    public static bool TryParse(string s, out int value) {
        long wide = 0;
        bool ok = Int64.TryParse(s, out wide);

        value = (int)wide;
        return ok && wide >= -2147483648 && wide <= 2147483647;
    }

    /// A NUMBER OR AN EXCEPTION, which is .NET's contract and was not this
    /// one's: text that is not a number answered zero, so a configuration
    /// file's typo became a silent default. Out of range is an
    /// OverflowException and unreadable text is a FormatException, because a
    /// caller can do something about the first and not about the second.
    public static int Parse(string s) {
        long wide = 0;

        if (!Int64.TryParse(s, out wide)) { throw NumberParse.Bad(s); }
        if (wide < -2147483648 || wide > 2147483647) { throw NumberParse.TooBig("Int32"); }
        return (int)wide;
    }

    public static bool TryParse(ReadOnlySpan<char> s, out int value) {
        return TryParse(s.ToString(), out value);
    }

    public static int Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static int Parse(string s, NumberStyles style, IFormatProvider? provider) {
        int value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static int Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static int Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s.ToString()); }

    public static string ToString(this int value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this int value, string format) {
        return NumberFormat.Of(value, 32, format);
    }

    public static bool TryParse(string s, NumberStyles style, IFormatProvider? provider, out int value) {
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, style == NumberStyles.HexNumber ? 16 : 10, 32, out wide);
        value = (int)wide;
        return ok;
    }

    public static int Parse(string s, NumberStyles style) {
        int value = 0;
        if (!TryParse(s, style, CultureInfo.InvariantCulture, out value)) {
            throw new FormatException(s);
        }
        return value;
    }
}

enum NumberStyles {
    None = 0,
    Integer = 7,
    HexNumber = 515,
}

/// What a formatter or a parser is told to use. .NET's every Parse, TryParse
/// and ToString that takes a culture takes this, and a null means "the current
/// one" -- which on a machine with one culture is the invariant one either way.
interface IFormatProvider {
    object? GetFormat(Type? formatType);
}

class CultureInfo : IFormatProvider {
    public static CultureInfo InvariantCulture => new CultureInfo();
    public static CultureInfo CurrentCulture => new CultureInfo();

    public object? GetFormat(Type? formatType) { return null; }
}

static class UInt64 {
    public static int CompareTo(ulong value, ulong other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(ulong value, object? other) {
        if (other == null) return 1;
        if (other is ulong number) return CompareTo(value, number);
        throw new ArgumentException("object must be a UInt64");
    }
    public static ulong MaxValue => ulong.MaxValue;
    public static ulong MinValue => 0;

    public static bool TryParse(string s, out ulong value) {
        return TryParse(s.AsSpan(), NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    public static bool TryParse(ReadOnlySpan<char> s, NumberStyles style,
                                IFormatProvider? provider, out ulong value) {
        value = 0;
        if (s.Length == 0) { return false; }

        int radix = style == NumberStyles.HexNumber ? 16 : 10;
        for (int i = 0; i < s.Length; i++) {
            int c = (int)s[i];
            int digit = -1;
            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 102) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 70) { digit = c - 65 + 10; }
            if (digit < 0 || digit >= radix) { value = 0; return false; }

            ulong next = value * (ulong)radix + (ulong)digit;
            if (next < value) { value = 0; return false; }
            value = next;
        }
        return true;
    }

    public static ulong Parse(string s) {
        ulong value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    /// The three .NET spells beside the plain one: a culture, a style, and
    /// both. There is one culture on this machine, so the provider says
    /// nothing; the style says which radix.
    public static ulong Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static ulong Parse(string s, NumberStyles style) {
        return Parse(s, style, CultureInfo.InvariantCulture);
    }

    public static ulong Parse(string s, NumberStyles style, IFormatProvider? provider) {
        ulong value = 0;

        if (!TryParse(s.AsSpan(), style, provider, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static ulong Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static string ToString(this ulong value, string format) {
        return NumberFormat.OfUnsigned(value, format);
    }
}

static class Byte {
    public static byte MaxValue => byte.MaxValue;
    public static byte MinValue => 0;

    public static string ToString(this byte value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this byte value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }

    public static bool TryParse(string s, out byte value) {
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 255;
        value = (byte)wide;
        return ok;
    }

    public static bool TryParse(string s, NumberStyles style, IFormatProvider? provider, out byte value) {
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, style == NumberStyles.HexNumber ? 16 : 10, out wide)
               && wide <= 255;
        value = (byte)wide;
        return ok;
    }

    public static byte Parse(string s) {
        byte value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }
}

static class Double {
    public static double Parse(string s, IFormatProvider? provider) {
        if (s.Length == 0) { throw new FormatException("empty real number"); }

        int at = 0;
        bool negative = false;
        if (s[at] == '-' || s[at] == '+') {
            negative = s[at] == '-';
            at = at + 1;
        }

        double value = 0.0;
        bool digit = false;
        while (at < s.Length && s[at] >= '0' && s[at] <= '9') {
            value = value * 10.0 + (double)(s[at] - '0');
            at = at + 1;
            digit = true;
        }

        if (at < s.Length && s[at] == '.') {
            at = at + 1;
            double place = 0.1;
            while (at < s.Length && s[at] >= '0' && s[at] <= '9') {
                value = value + (double)(s[at] - '0') * place;
                place = place * 0.1;
                at = at + 1;
                digit = true;
            }
        }

        if (!digit) { throw new FormatException("invalid real number"); }

        if (at < s.Length && (s[at] == 'e' || s[at] == 'E')) {
            at = at + 1;
            bool down = false;
            if (at < s.Length && (s[at] == '-' || s[at] == '+')) {
                down = s[at] == '-';
                at = at + 1;
            }
            if (at >= s.Length || s[at] < '0' || s[at] > '9') {
                throw new FormatException("invalid real exponent");
            }
            int power = 0;
            while (at < s.Length && s[at] >= '0' && s[at] <= '9') {
                power = power * 10 + (s[at] - '0');
                at = at + 1;
            }
            while (power > 0) {
                value = down ? value / 10.0 : value * 10.0;
                power = power - 1;
            }
        }

        if (at != s.Length) { throw new FormatException("invalid real number"); }
        return negative ? 0.0 - value : value;
    }

    public static double Parse(string s) { return Parse(s, CultureInfo.InvariantCulture); }

    // .NET's contract: false rather than a throw, and the value is only
    // meaningful when it answered true. The parse above reports its refusals
    // by throwing, so this is where that becomes an answer.
    public static bool TryParse(string s, out double value) {
        value = 0.0;
        try {
            value = Parse(s, CultureInfo.InvariantCulture);
            return true;
        } catch (FormatException) {
            value = 0.0;
            return false;
        }
    }

    public static bool TryParse(string s, NumberStyles style, IFormatProvider? provider, out double value) {
        return TryParse(s, out value);
    }

    public static string ToString(this double value, string format) {
        return DoubleFormat.Of(value, format);
    }

    public static bool IsNaN(double value) { return DoubleFormat.IsNaN(value); }
    public static bool IsInfinity(double value) { return DoubleFormat.IsInfinity(value); }

    public static bool IsFinite(double value) {
        return !DoubleFormat.IsNaN(value) && !DoubleFormat.IsInfinity(value);
    }
}

// ---- text as bytes ---------------------------------------------------------
//
// A string on this machine IS its UTF-8 bytes -- a length word and the bytes
// after it -- so an encoding has nothing to convert and everything to name.
// .NET's shape is kept because source says Encoding.UTF8.GetBytes(s).

class UTF8Encoding {
    public byte[] GetBytes(string s) {
        byte[] made = new byte[s.Length];

        for (int i = 0; i < s.Length; i++) { made[i] = (byte)Sys.GetByte(s, i); }
        return made;
    }

    public string GetString(byte[] bytes) {
        string made = Sys.NewBytes(bytes.Length);

        for (int i = 0; i < bytes.Length; i++) { Sys.SetByte(made, i, bytes[i]); }
        return made;
    }

    public string GetString(ReadOnlySpan<byte> bytes) {
        string made = Sys.NewBytes(bytes.Length);

        for (int i = 0; i < bytes.Length; i++) { Sys.SetByte(made, i, bytes[i]); }
        return made;
    }

    public byte[] GetBytes(ReadOnlySpan<byte> bytes) { return bytes.ToArray(); }

    // .NET's overload that reads PART of a block, which is how a name table is
    // read out of an image a name at a time.
    public string GetString(byte[] bytes, int at, int count) {
        string made = Sys.NewBytes(count);

        for (int i = 0; i < count; i++) { Sys.SetByte(made, i, bytes[at + i]); }
        return made;
    }

    public int GetByteCount(string s) { return s.Length; }

    /// HOW MANY UTF-16 CHARS the bytes decode to, which is not how many bytes
    /// there are and not how many characters either: anything above the basic
    /// plane counts twice, because that is what a UTF-16 buffer has to hold.
    public int GetCharCount(byte[] bytes) { return GetChars(bytes).Length; }

    public char[] GetChars(byte[] bytes) { return GetChars(bytes, 0, bytes.Length); }

    public char[] GetChars(byte[] bytes, int index, int count) {
        string text = GetString(bytes, index, count);
        List<char> made = new List<char>();
        int at = 0;

        while (at < text.Length) {
            Rune one = Rune.ReplacementChar;
            int used = 0;

            Rune.TryDecodeFromUtf8(text, at, out one, out used);
            if (used <= 0) { used = 1; }
            at = at + used;

            if (one.IsBmp) {
                made.Add((char)one.Value);
            } else {
                int rest = one.Value - 0x10000;

                made.Add((char)(0xD800 + (rest >> 10)));
                made.Add((char)(0xDC00 + (rest & 0x3FF)));
            }
        }
        return made.ToArray();
    }
}

// .NET's ASCIIEncoding: seven bits, and everything above them is a question
// mark in both directions. That substitution is the whole difference from the
// UTF-8 encoding above on a machine whose strings are bytes, and it is not a
// detail -- a four-character section tag read as ASCII must be four characters
// whatever the image holds, or a corrupt tag reads back as a valid one.
class ASCIIEncoding {
    private const int Substitute = 63;              // '?'

    public byte[] GetBytes(string s) {
        byte[] made = new byte[s.Length];

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetByte(s, i);

            made[i] = (byte)(c > 127 ? Substitute : c);
        }
        return made;
    }

    public string GetString(byte[] bytes) {
        return GetString(bytes, 0, bytes.Length);
    }

    public string GetString(byte[] bytes, int at, int count) {
        string made = Sys.NewBytes(count);

        for (int i = 0; i < count; i++) {
            int c = bytes[at + i];

            Sys.SetByte(made, i, c > 127 ? Substitute : c);
        }
        return made;
    }

    public string GetString(ReadOnlySpan<byte> bytes) {
        string made = Sys.NewBytes(bytes.Length);

        for (int i = 0; i < bytes.Length; i++) {
            int c = bytes[i];

            Sys.SetByte(made, i, c > 127 ? Substitute : c);
        }
        return made;
    }

    public byte[] GetBytes(ReadOnlySpan<byte> bytes) { return bytes.ToArray(); }

    public int GetByteCount(string s) { return s.Length; }

    /// ONE BYTE IS ONE CHARACTER in ASCII, and anything above 127 is not ASCII
    /// at all: .NET's decoder replaces it with '?', which is the substitution
    /// this encoding has always used.
    public int GetCharCount(byte[] bytes) { return bytes.Length; }

    public char[] GetChars(byte[] bytes) { return GetChars(bytes, 0, bytes.Length); }

    public char[] GetChars(byte[] bytes, int index, int count) {
        char[] made = new char[count];

        for (int i = 0; i < count; i++) {
            int c = bytes[index + i] & 255;

            made[i] = c > 127 ? '?' : (char)c;
        }
        return made;
    }
}

/// A UNICODE SCALAR VALUE: U+0000 to U+10FFFF, minus the surrogate range,
/// which is exactly what a `char` cannot always hold -- an emoji is two chars
/// in UTF-16 and one Rune. .NET added the type so that "a character" could
/// stop meaning "a UTF-16 code unit".
struct Rune {
    private int value;

    public Rune(char ch) {
        if ((int)ch >= 0xD800 && (int)ch <= 0xDFFF) {
            throw new ArgumentOutOfRangeException("ch");
        }
        value = (int)ch;
    }

    public Rune(int scalar) {
        if (!IsValid(scalar)) { throw new ArgumentOutOfRangeException("value"); }
        value = scalar;
    }

    /// A SURROGATE PAIR, the two halves a UTF-16 stream splits a big character
    /// into. .NET's constructor takes them because that is the shape text
    /// arrives in from anything speaking UTF-16.
    public Rune(char high, char low) {
        int h = (int)high;
        int l = (int)low;

        if (h < 0xD800 || h > 0xDBFF || l < 0xDC00 || l > 0xDFFF) {
            throw new ArgumentOutOfRangeException("highSurrogate");
        }
        value = 0x10000 + ((h - 0xD800) << 10) + (l - 0xDC00);
    }

    /// U+FFFD, which is what a decoder puts in place of bytes it cannot read.
    public static Rune ReplacementChar => new Rune(0xFFFD);

    public int Value => value;

    public bool IsAscii => value < 128;

    /// IN THE BASIC MULTILINGUAL PLANE -- that is, expressible as a single
    /// UTF-16 char. Everything above needs a surrogate pair.
    public bool IsBmp => value <= 0xFFFF;

    public int Plane => value >> 16;

    public int Utf8SequenceLength {
        get {
            if (value < 0x80) { return 1; }
            if (value < 0x800) { return 2; }
            if (value < 0x10000) { return 3; }
            return 4;
        }
    }

    public int Utf16SequenceLength => value <= 0xFFFF ? 1 : 2;

    public static bool IsValid(int scalar) {
        if (scalar < 0 || scalar > 0x10FFFF) { return false; }
        return scalar < 0xD800 || scalar > 0xDFFF;
    }

    public static bool TryCreate(int scalar, out Rune result) {
        if (!IsValid(scalar)) { result = new Rune(0); return false; }
        result = new Rune(scalar);
        return true;
    }

    public static bool TryCreate(char ch, out Rune result) {
        return TryCreate((int)ch, out result);
    }

    /// THE RUNE STARTING AT A BYTE, and how many bytes it took -- which is the
    /// only way to walk a UTF-8 string, since its characters are not all the
    /// same width. .NET's TryGetRuneAt indexes UTF-16 chars; here the index is
    /// a byte, because that is what a string is indexed by on this machine.
    public static bool TryGetRuneAt(string text, int index, out Rune result) {
        int taken = 0;

        return TryDecodeFromUtf8(text, index, out result, out taken);
    }

    public static bool TryDecodeFromUtf8(string text, int index, out Rune result, out int bytesConsumed) {
        result = ReplacementChar;
        bytesConsumed = 0;

        if (text == null || index < 0 || index >= text.Length) { return false; }

        int lead = Sys.GetByte(text, index);

        if (lead < 0x80) {
            result = new Rune(lead);
            bytesConsumed = 1;
            return true;
        }

        int length = 0;
        int scalar = 0;

        if ((lead & 0xE0) == 0xC0) { length = 2; scalar = lead & 0x1F; }
        else if ((lead & 0xF0) == 0xE0) { length = 3; scalar = lead & 0x0F; }
        else if ((lead & 0xF8) == 0xF0) { length = 4; scalar = lead & 0x07; }
        else { bytesConsumed = 1; return false; }

        if (index + length > text.Length) { bytesConsumed = 1; return false; }

        for (int i = 1; i < length; i++) {
            int next = Sys.GetByte(text, index + i);

            if ((next & 0xC0) != 0x80) { bytesConsumed = i; return false; }
            scalar = (scalar << 6) | (next & 0x3F);
        }

        if (!IsValid(scalar)) { bytesConsumed = length; return false; }

        result = new Rune(scalar);
        bytesConsumed = length;
        return true;
    }

    /// THE CHARACTER AS TEXT, which on this machine is its UTF-8 bytes.
    public string ToString() {
        int length = Utf8SequenceLength;
        string made = Sys.NewBytes(length);

        if (length == 1) {
            Sys.SetByte(made, 0, value);
        } else if (length == 2) {
            Sys.SetByte(made, 0, 0xC0 | (value >> 6));
            Sys.SetByte(made, 1, 0x80 | (value & 0x3F));
        } else if (length == 3) {
            Sys.SetByte(made, 0, 0xE0 | (value >> 12));
            Sys.SetByte(made, 1, 0x80 | ((value >> 6) & 0x3F));
            Sys.SetByte(made, 2, 0x80 | (value & 0x3F));
        } else {
            Sys.SetByte(made, 0, 0xF0 | (value >> 18));
            Sys.SetByte(made, 1, 0x80 | ((value >> 12) & 0x3F));
            Sys.SetByte(made, 2, 0x80 | ((value >> 6) & 0x3F));
            Sys.SetByte(made, 3, 0x80 | (value & 0x3F));
        }
        return made;
    }

    public int CompareTo(Rune other) {
        if (value < other.Value) { return -1; }
        if (value > other.Value) { return 1; }
        return 0;
    }

    public bool Equals(Rune other) { return value == other.Value; }
    public int GetHashCode() { return value; }

    // ---- the character classes ------------------------------------------
    //
    // ASCII ONLY above 127, which is what Char in std.cor does and for the same
    // reason: the Unicode tables are megabytes and nothing on this machine has
    // yet needed them. A caller asking about a Latin letter gets the right
    // answer; one asking about Greek gets false.

    public static bool IsAsciiDigit(Rune r) { return r.Value >= 48 && r.Value <= 57; }
    public static bool IsAsciiLetter(Rune r) { return Char.IsLetter((char)r.Value) && r.IsAscii; }
    public static bool IsDigit(Rune r) { return r.IsAscii && Char.IsDigit((char)r.Value); }
    public static bool IsLetter(Rune r) { return r.IsAscii && Char.IsLetter((char)r.Value); }
    public static bool IsLetterOrDigit(Rune r) { return IsLetter(r) || IsDigit(r); }
    public static bool IsWhiteSpace(Rune r) { return r.IsAscii && Char.IsWhiteSpace((char)r.Value); }
    public static bool IsControl(Rune r) { return r.IsAscii && Char.IsControl((char)r.Value); }
    public static bool IsUpper(Rune r) { return r.IsAscii && Char.IsUpper((char)r.Value); }
    public static bool IsLower(Rune r) { return r.IsAscii && Char.IsLower((char)r.Value); }
    public static bool IsPunctuation(Rune r) { return r.IsAscii && Char.IsPunctuation((char)r.Value); }
    public static bool IsSymbol(Rune r) { return r.IsAscii && Char.IsSymbol((char)r.Value); }

    public static Rune ToUpperInvariant(Rune r) {
        if (!r.IsAscii) { return r; }
        return new Rune((int)Char.ToUpperInvariant((char)r.Value));
    }

    public static Rune ToLowerInvariant(Rune r) {
        if (!r.IsAscii) { return r; }
        return new Rune((int)Char.ToLowerInvariant((char)r.Value));
    }
}

/// UTF-16, which is what .NET's Encoding.Unicode is: two bytes for most
/// characters and a surrogate pair for the rest, little end first unless told
/// otherwise.
///
/// The conversion is real work here, unlike UTF8Encoding's: a string on this
/// machine is UTF-8, so GetBytes decodes and re-encodes rather than copying.
class UnicodeEncoding {
    private bool big;
    private bool mark;

    public UnicodeEncoding() {
        big = false;
        mark = false;
    }

    public UnicodeEncoding(bool bigEndian, bool byteOrderMark) {
        big = bigEndian;
        mark = byteOrderMark;
    }

    /// U+FEFF, in this encoding's byte order, or nothing when the encoding was
    /// not asked to emit one. .NET's GetPreamble.
    public byte[] GetPreamble() {
        if (!mark) { return new byte[0]; }

        byte[] made = new byte[2];

        if (big) { made[0] = 0xFE; made[1] = 0xFF; } else { made[0] = 0xFF; made[1] = 0xFE; }
        return made;
    }

    public int GetByteCount(string s) {
        int count = 0;
        int at = 0;

        while (at < s.Length) {
            Rune one = Rune.ReplacementChar;
            int used = 0;

            Rune.TryDecodeFromUtf8(s, at, out one, out used);
            if (used <= 0) { used = 1; }
            count = count + one.Utf16SequenceLength * 2;
            at = at + used;
        }
        return count;
    }

    public byte[] GetBytes(string s) {
        byte[] made = new byte[GetByteCount(s)];
        int written = 0;
        int at = 0;

        while (at < s.Length) {
            Rune one = Rune.ReplacementChar;
            int used = 0;

            Rune.TryDecodeFromUtf8(s, at, out one, out used);
            if (used <= 0) { used = 1; }
            at = at + used;

            if (one.IsBmp) {
                written = Put(made, written, one.Value);
            } else {
                int rest = one.Value - 0x10000;

                written = Put(made, written, 0xD800 + (rest >> 10));
                written = Put(made, written, 0xDC00 + (rest & 0x3FF));
            }
        }
        return made;
    }

    public string GetString(byte[] bytes) { return GetString(bytes, 0, bytes.Length); }

    public string GetString(byte[] bytes, int index, int count) {
        StringBuilder made = new StringBuilder();
        int at = index;
        int end = index + count;

        while (at + 1 < end) {
            int unit = Unit(bytes, at);
            at = at + 2;

            // A LEADING SURROGATE JOINS THE ONE AFTER IT. A lone half is text
            // no encoder should have produced, and it becomes U+FFFD -- which
            // is what .NET's decoder does with it too.
            if (unit >= 0xD800 && unit <= 0xDBFF && at + 1 < end) {
                int low = Unit(bytes, at);

                if (low >= 0xDC00 && low <= 0xDFFF) {
                    at = at + 2;
                    made.Append(new Rune(0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)).ToString());
                    continue;
                }
            }

            if (unit >= 0xD800 && unit <= 0xDFFF) {
                made.Append(Rune.ReplacementChar.ToString());
                continue;
            }
            made.Append(new Rune(unit).ToString());
        }
        return made.ToString();
    }

    public int GetCharCount(byte[] bytes) { return GetString(bytes).Length; }

    private int Unit(byte[] bytes, int at) {
        int first = bytes[at] & 255;
        int second = bytes[at + 1] & 255;

        return big ? (first << 8) | second : (second << 8) | first;
    }

    private int Put(byte[] into, int at, int unit) {
        if (big) {
            into[at] = (byte)(unit >> 8);
            into[at + 1] = (byte)(unit & 255);
        } else {
            into[at] = (byte)(unit & 255);
            into[at + 1] = (byte)(unit >> 8);
        }
        return at + 2;
    }
}

/// UTF-32: four bytes for every character, whatever it is. Nobody sends text
/// in it and plenty of things hold text in it, because indexing is then what
/// indexing looks like -- the nth character is at the nth position, which is
/// true in neither of the other two.
class UTF32Encoding {
    private bool big;

    public UTF32Encoding() { big = false; }

    public UTF32Encoding(bool bigEndian, bool byteOrderMark) { big = bigEndian; }

    public int GetByteCount(string s) {
        int count = 0;
        int at = 0;

        while (at < s.Length) {
            Rune one = Rune.ReplacementChar;
            int used = 0;

            Rune.TryDecodeFromUtf8(s, at, out one, out used);
            if (used <= 0) { used = 1; }
            at = at + used;
            count = count + 4;
        }
        return count;
    }

    public byte[] GetBytes(string s) {
        byte[] made = new byte[GetByteCount(s)];
        int written = 0;
        int at = 0;

        while (at < s.Length) {
            Rune one = Rune.ReplacementChar;
            int used = 0;

            Rune.TryDecodeFromUtf8(s, at, out one, out used);
            if (used <= 0) { used = 1; }
            at = at + used;

            int value = one.Value;

            for (int i = 0; i < 4; i++) {
                int shift = big ? (24 - i * 8) : (i * 8);

                made[written + i] = (byte)((value >> shift) & 255);
            }
            written = written + 4;
        }
        return made;
    }

    public string GetString(byte[] bytes) { return GetString(bytes, 0, bytes.Length); }

    public string GetString(byte[] bytes, int index, int count) {
        StringBuilder made = new StringBuilder();

        for (int at = index; at + 3 < index + count; at = at + 4) {
            int value = 0;

            for (int i = 0; i < 4; i++) {
                int shift = big ? (24 - i * 8) : (i * 8);

                value = value | ((bytes[at + i] & 255) << shift);
            }

            if (!Rune.IsValid(value)) { value = 0xFFFD; }
            made.Append(new Rune(value).ToString());
        }
        return made.ToString();
    }
}

static class Encoding {
    public static UTF8Encoding UTF8 => new UTF8Encoding();
    public static ASCIIEncoding ASCII => new ASCIIEncoding();

    /// UTF-16, little end first, which is what .NET means by "Unicode" -- the
    /// name is a historical accident and the encoding is one of several.
    public static UnicodeEncoding Unicode => new UnicodeEncoding();
    public static UnicodeEncoding BigEndianUnicode => new UnicodeEncoding(true, true);
    public static UTF32Encoding UTF32 => new UTF32Encoding();
}

// ---- a view of part of an array --------------------------------------------
//
// .NET's Span<T> and ReadOnlySpan<T>, with the members that mean anything on
// this machine: a length, an index, a slice and a copy out. They are `ref
// struct`s there -- a rule about where one may be STORED, which exists because
// a span can point at the stack, and which nothing here can point at.
//
// An array converts to one implicitly, as it does in C#; the compiler makes
// that conversion, since C# spells it as an operator on the type and this has
// no user-defined conversions yet.

struct ReadOnlySpan<T> {
    private T[] items;
    private int from;
    private int count;

    public ReadOnlySpan(T[] source) {
        items = source;
        from = 0;
        count = source.Length;
    }

    public ReadOnlySpan(T[] source, int start, int length) {
        items = source;
        from = start;
        count = length;
    }

    public int Length => count;

    public T this[int index] {
        get { return items[from + index]; }
    }

    public ReadOnlySpan<T> Slice(int start) {
        return new ReadOnlySpan<T>(items, from + start, count - start);
    }

    public ReadOnlySpan<T> Slice(int start, int length) {
        return new ReadOnlySpan<T>(items, from + start, length);
    }

    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[from + i]; }
        return made;
    }

    public string ToString() {
        string made = Sys.NewBytes(count);
        for (int i = 0; i < count; i++) {
            Sys.SetByte(made, i, (int)Sys.Word(items[from + i]));
        }
        return made;
    }

    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[from + i]; }
    }

    /// .NET takes a ReadOnlySpan<T> and a Span<T> reaches it through the
    /// implicit conversion between them, which is a user-defined operator this
    /// compiler does not have -- so the second overload is written out.
    public bool SequenceEqual(Span<T> other) { return SequenceEqual(new ReadOnlySpan<T>(other.ToArray())); }

    public bool SequenceEqual(ReadOnlySpan<T> other) {
        if (count != other.Length) { return false; }

        for (int i = 0; i < count; i++) {
            if (!(Sys.IsObject(items[from + i]) ? Sys.KeyEquals(items[from + i], other[i]) : Sys.Word(items[from + i]) == Sys.Word(other[i]))) { return false; }
        }
        return true;
    }

    /// A span over nothing, which is what a section with no bytes in the file
    /// hands back. Not null: a span is a value and there is no such thing.
    public static ReadOnlySpan<T> Empty => new ReadOnlySpan<T>(new T[0]);

    /// Where the value first appears, or -1. The comparison is the one every
    /// other span operation here makes: the machine word each element is.
    public int IndexOf(T value) {
        for (int i = 0; i < count; i++) {
            if ((Sys.IsObject(items[from + i]) ? Sys.KeyEquals(items[from + i], value) : Sys.Word(items[from + i]) == Sys.Word(value))) { return i; }
        }
        return -1;
    }

    public bool Contains(T value) { return IndexOf(value) >= 0; }
}

struct Span<T> {
    private T[] items;
    private int from;
    private int count;

    public Span(T[] source) {
        items = source;
        from = 0;
        count = source.Length;
    }

    public Span(T[] source, int start, int length) {
        items = source;
        from = start;
        count = length;
    }

    public int Length => count;

    public T this[int index] {
        get { return items[from + index]; }
        set { items[from + index] = value; }
    }

    public Span<T> Slice(int start) {
        return new Span<T>(items, from + start, count - start);
    }

    public Span<T> Slice(int start, int length) {
        return new Span<T>(items, from + start, length);
    }

    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[from + i]; }
        return made;
    }

    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[from + i]; }
    }

    // ELEMENT BY ELEMENT, which is what .NET's SequenceEqual promises: two
    // spans of the same length whose elements are equal, whatever they point
    // at.
    /// .NET takes a ReadOnlySpan<T> and a Span<T> reaches it through the
    /// implicit conversion between them, which is a user-defined operator this
    /// compiler does not have -- so the second overload is written out.
    public bool SequenceEqual(Span<T> other) { return SequenceEqual(new ReadOnlySpan<T>(other.ToArray())); }

    public bool SequenceEqual(ReadOnlySpan<T> other) {
        if (count != other.Length) { return false; }

        for (int i = 0; i < count; i++) {
            if (!(Sys.IsObject(items[from + i]) ? Sys.KeyEquals(items[from + i], other[i]) : Sys.Word(items[from + i]) == Sys.Word(other[i]))) { return false; }
        }
        return true;
    }
}

// ---- numbers in a block of bytes -------------------------------------------
//
// .NET's System.Buffers.Binary.BinaryPrimitives, with the twelve members an
// image format needs. LITTLE-ENDIAN, which is this machine's order and is
// stated in the name of every one of them so that a reader of the source knows
// which end is which without being told twice.

static class BinaryPrimitives {
    public static void WriteUInt16LittleEndian(Span<byte> into, ushort value) {
        into[0] = (byte)(value & 255);
        into[1] = (byte)((value >> 8) & 255);
    }

    public static void WriteInt16LittleEndian(Span<byte> into, short value) {
        WriteUInt16LittleEndian(into, (ushort)value);
    }

    public static void WriteUInt32LittleEndian(Span<byte> into, uint value) {
        for (int i = 0; i < 4; i++) { into[i] = (byte)((value >> (i * 8)) & 255); }
    }

    public static void WriteInt32LittleEndian(Span<byte> into, int value) {
        WriteUInt32LittleEndian(into, (uint)value);
    }

    public static void WriteUInt64LittleEndian(Span<byte> into, ulong value) {
        for (int i = 0; i < 8; i++) { into[i] = (byte)((value >> (i * 8)) & (ulong)255); }
    }

    public static void WriteInt64LittleEndian(Span<byte> into, long value) {
        WriteUInt64LittleEndian(into, (ulong)value);
    }

    public static ushort ReadUInt16LittleEndian(ReadOnlySpan<byte> from) {
        return (ushort)(from[0] | (from[1] << 8));
    }

    public static short ReadInt16LittleEndian(ReadOnlySpan<byte> from) {
        return (short)ReadUInt16LittleEndian(from);
    }

    public static uint ReadUInt32LittleEndian(ReadOnlySpan<byte> from) {
        uint value = 0;

        for (int i = 0; i < 4; i++) { value = value | ((uint)from[i] << (i * 8)); }
        return value;
    }

    public static int ReadInt32LittleEndian(ReadOnlySpan<byte> from) {
        return (int)ReadUInt32LittleEndian(from);
    }

    public static ulong ReadUInt64LittleEndian(ReadOnlySpan<byte> from) {
        ulong value = 0;

        for (int i = 0; i < 8; i++) { value = value | ((ulong)from[i] << (i * 8)); }
        return value;
    }

    public static long ReadInt64LittleEndian(ReadOnlySpan<byte> from) {
        return (long)ReadUInt64LittleEndian(from);
    }
}

// ---- blocks of bytes ------------------------------------------------------
//
// Safe standard-library names for the restartable memory engine. Sys exposes
// raw addresses because a kernel needs them; ordinary code should not have to
// manufacture one or risk running past the array it belongs to.

static class Memory {
    private static long At(byte[] bytes, int start, int count) {
        if (start < 0 || count < 0 || start > bytes.Length - count) {
            throw new IndexOutOfRangeException("byte block is outside its array");
        }
        return Sys.ArrayData(bytes) + start;
    }

    public static void Swap(byte[] first, int firstAt, byte[] second, int secondAt, int count) {
        long a = At(first, firstAt, count);
        long b = At(second, secondAt, count);
        if (count > 0) { Sys.SwapBytes(a, b, count); }
    }

    public static void Reverse(byte[] bytes, int start, int count) {
        long low = At(bytes, start, count);
        if (count > 1) { Sys.ReverseBytes(low, low + count - 1, count / 2); }
    }

    public static long FirstSet(byte[] bytes, int start, int count) {
        long at = At(bytes, start, count);
        return count == 0 ? -1 : Sys.FirstSet(at, count * 8);
    }

    public static long PopCount(byte[] bytes, int start, int count) {
        long at = At(bytes, start, count);
        return count == 0 ? 0 : Sys.PopCountBlock(at, count * 8);
    }

    public static long Sum(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 0, 0);
    }

    public static long InternetChecksum(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 1, 0);
    }

    public static long Crc32C(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 2, 0);
    }

    public static long Adler32(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 3, 0);
    }

    public static long Crc32(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 4, 0);
    }
}

// ---- enumeration ----------------------------------------------------------
//
// WHAT `foreach` ACTUALLY LOOKS FOR, in C# and here, is a GetEnumerator -- the
// pattern, not the interface. A type with one is walked with it whatever it
// says it implements, which is why List<T>.Enumerator being a plain type costs
// no dispatch.
//
// The interfaces exist because signatures say IEnumerable<T>, and because
// something holding only the interface still has to be able to walk what it
// was handed. The one difference from .NET is that IReadOnlyList<T> does NOT
// extend IEnumerable<T> here: an array satisfies IReadOnlyList<T> through a
// helper object the compiler writes, and that helper has no enumerator to give
// -- see Binder.ArrayView. A `T[]` is looped over directly, so nothing is lost
// but the conversion.

/// `out T`, as .NET declares it: an enumerator only ever hands its element
/// OUT, so an enumerator of a derived type is one of the base.
interface IEnumerator<out T> {
    T Current { get; }
    bool MoveNext();
}

/// `out T`. Everything read from a sequence is a T, so a sequence of
/// FieldDecl IS a sequence of MemberDecl -- which is what lets
/// `decl.Members.AddRange(several.More)` be written at all.
interface IEnumerable<out T> {
    IEnumerator<T> GetEnumerator();
}

class SelectManySequence<T, R> : IEnumerable<R> {
    private IEnumerable<T> source;
    private Func<T, IEnumerable<R>> selector;
    public SelectManySequence(IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        this.source = source;
        this.selector = selector;
    }
    public IEnumerator<R> GetEnumerator() => new SelectManyEnumerator<T, R>(source, selector);
}

class SelectManyEnumerator<T, R> : IEnumerator<R>, IDisposable {
    private IEnumerable<T> source;
    private Func<T, IEnumerable<R>> selector;
    private IEnumerator<T>? outer;
    private IEnumerator<R>? inner;
    private bool ended;
    private R current;
    public SelectManyEnumerator(IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        this.source = source;
        this.selector = selector;
    }
    public R Current => current;
    public bool MoveNext() {
        if (ended) return false;
        try {
            if (outer == null) outer = source.GetEnumerator();
            while (true) {
                if (inner != null) {
                    if (inner.MoveNext()) { current = inner.Current; return true; }
                    if (inner is IDisposable disposable) disposable.Dispose();
                    inner = null;
                }
                if (!outer.MoveNext()) { Dispose(); return false; }
                inner = selector(outer.Current).GetEnumerator();
            }
        } catch { Dispose(); throw; }
    }
    public void Dispose() {
        ended = true;
        try {
            if (inner is IDisposable disposable) disposable.Dispose();
        } finally {
            inner = null;
            try {
                if (outer is IDisposable disposable) disposable.Dispose();
            } finally { outer = null; }
        }
    }
}

// ---- List -----------------------------------------------------------------
// A growable array. Doubling on growth keeps appending amortised constant
// rather than quadratic, which matters because scripts build lists in loops.

// .NET spells this List<T>.Enumerator. A type written inside another is hoisted
// out to the top level here, and a hoisted one cannot inherit the outer's type
// parameters -- so it takes its own and carries the outer's name instead.
class ListEnumerator<T> : IEnumerator<T> {
    private IReadOnlyList<T> over;
    private int at;

    public ListEnumerator(IReadOnlyList<T> list) {
        over = list;
        at = -1;
    }

    public T Current => over[at];

    public bool MoveNext() {
        at = at + 1;
        return at < over.Count;
    }
}

class List<T> : IReadOnlyList<T>, IEnumerable<T> {
    // An empty list owns no array. All element accesses are guarded by count;
    // only growth and an explicit request for Backing materialize storage.
    private T[] items = null!;
    private int count;

    public List() {
        count = 0;
    }

    public int Count => count;

    public void Add(T value) {
        if (items == null || count == items.Length) { Grow(); }
        items[count] = value;
        count = count + 1;
    }

    // AN INDEXER, because that is what a List has in C#. Get and Set were our
    // own spelling of it, and every one of those is a place the compiler's own
    // source would have to be rewritten to compile here.
    public T this[int index] {
        get {
            if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index"); }
            return items[index];
        }
        set {
            if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index"); }
            items[index] = value;
        }
    }

    // ORDER IS PRESERVED, which is also .NET's contract. It used to move the
    // last element into the hole -- constant time and a different function: a
    // caller that had sorted the list, or that was walking it, got a silent
    // reordering. Shifting is what List<T>.RemoveAt does and what anybody
    // reading the name expects.
    public void RemoveAt(int index) {
        if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index"); }
        for (int i = index; i < count - 1; i++) { items[i] = items[i + 1]; }
        count = count - 1;
        items[count] = default(T)!;
    }

    public void Insert(int index, T value) {
        if (index < 0 || index > count) { throw new ArgumentOutOfRangeException("index"); }
        if (items == null || count == items.Length) { Grow(); }
        for (int i = count; i > index; i--) { items[i] = items[i - 1]; }
        items[index] = value;
        count = count + 1;
    }

    public void InsertRange(int index, IEnumerable<T> more) {
        foreach (T one in more) {
            Insert(index, one);
            index = index + 1;
        }
    }

    public int IndexOf(T value) {
        for (int i = 0; i < count; i++) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.Word(items[i]) == Sys.Word(value))) { return i; }
        }
        return -1;
    }

    public bool Contains(T value) { return IndexOf(value) >= 0; }

    public IEnumerator<T> GetEnumerator() { return new ListEnumerator<T>(this); }

    // .NET's CopyTo, which writes the elements into something the caller owns
    // rather than allocating.
    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[i]; }
    }

    public void CopyTo(T[] into) {
        for (int i = 0; i < count; i++) { into[i] = items[i]; }
    }

    // .NET's third overload: where in the destination to start writing.
    public void CopyTo(T[] into, int at) {
        for (int i = 0; i < count; i++) { into[at + i] = items[i]; }
    }

    // A COPY, not a view: .NET's ToArray hands back an array of its own, so
    // writing to it does not write to the list.
    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[i]; }
        return made;
    }

    // .NET takes a Predicate<T> here and a Func<T,bool> in LINQ's
    // FirstOrDefault; they are the same shape and this machine has no delegate
    // types yet, so both are the one interface. Answers default(T) when nothing
    // matches, which is .NET's contract.
    public T? Find(Func<T, bool> match) {
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public int FindIndex(Func<T, bool> match) {
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    /// THE LIST'S OWN STORAGE, which CollectionsMarshal.AsSpan hands out.
    /// Not .NET's spelling -- .NET reaches the field through the runtime --
    /// but the same promise: writing through it writes the list, and a list
    /// that grows afterwards leaves the old array behind.
    internal T[] Backing() {
        if (items == null) { items = new T[0]; }
        return items;
    }

    public void AddRange(IEnumerable<T> more) {
        foreach (T one in more) { Add(one); }
    }

    public void AddRange(IReadOnlyList<T> more) {
        for (int i = 0; i < more.Count; i++) { Add(more[i]); }
    }

    public void AddRange(List<T> more) {
        for (int i = 0; i < more.Count; i++) { Add(more[i]); }
    }

    public void AddRange(T[] more) {
        for (int i = 0; i < more.Length; i++) { Add(more[i]); }
    }

    /// .NET 8's span overloads. Span<T> is written out beside ReadOnlySpan<T>
    /// because the implicit conversion between them that .NET relies on is a
    /// user-defined conversion operator, which this compiler does not have.
    public void AddRange(ReadOnlySpan<T> more) {
        for (int i = 0; i < more.Length; i++) { Add(more[i]); }
    }

    public void AddRange(Span<T> more) {
        for (int i = 0; i < more.Length; i++) { Add(more[i]); }
    }

    public void InsertRange(int index, List<T> more) {
        for (int i = 0; i < more.Count; i++) { Insert(index + i, more[i]); }
    }

    // True when it was there, which is .NET's contract for Remove.
    public bool Remove(T value) {
        int at = IndexOf(value);
        if (at < 0) { return false; }
        RemoveAt(at);
        return true;
    }

    public void Clear() {
        for (int i = 0; i < count; i++) { items[i] = default(T)!; }
        count = 0;
    }

    public void Reverse() {
        int left = 0;
        int right = count - 1;
        while (left < right) {
            T held = items[left];
            items[left] = items[right];
            items[right] = held;
            left = left + 1;
            right = right - 1;
        }
    }

    // System.Linq.OfType<TResult> is declared on non-generic IEnumerable in
    // .NET. This runtime's enumerable interface is generic, so List carries
    // the same operation directly and preserves the one explicit type argument
    // used by C# call sites.
    public List<R> OfType<R>() {
        List<R> made = new List<R>();
        for (int i = 0; i < count; i++) {
            if (items[i] is R value) { made.Add(value); }
        }
        return made;
    }

    public void RemoveRange(int index, int countToRemove) {
        if (index < 0) { throw new ArgumentOutOfRangeException("index"); }
        if (countToRemove < 0) { throw new ArgumentOutOfRangeException("count"); }
        if (index > count || countToRemove > count - index) { throw new ArgumentException("Invalid range."); }
        for (int i = index; i < count - countToRemove; i++) {
            items[i] = items[i + countToRemove];
        }
        for (int i = count - countToRemove; i < count; i++) { items[i] = default(T)!; }
        count = count - countToRemove;
    }

    // ---- the rest of what List<T> answers to in C# ---------------------

    /// .NET's constructor that says how much to expect, so a list built in a
    /// loop of known length grows no times at all.
    public List(int capacity) {
        if (capacity < 0) { throw new ArgumentOutOfRangeException("capacity"); }
        if (capacity > 0) { items = new T[capacity]; }
        count = 0;
    }

    public List(IEnumerable<T> source) : this() {
        foreach (T one in source) { Add(one); }
    }

    public List(IReadOnlyList<T> source) : this(source.Count) {
        for (int i = 0; i < source.Count; i++) { Add(source[i]); }
    }


    /// HOW MANY IT CAN HOLD before it grows again, which is not how many it
    /// holds. Setting it is .NET's way of reserving.
    public int Capacity {
        get { return items == null ? 0 : items.Length; }
        set {
            if (value < count) { throw new ArgumentOutOfRangeException("value"); }
            if (value == Capacity) { return; }
            if (value == 0) { items = null!; return; }

            T[] bigger = new T[value];
            for (int i = 0; i < count; i++) { bigger[i] = items[i]; }
            items = bigger;
        }
    }

    public int LastIndexOf(T value) {
        for (int i = count - 1; i >= 0; i--) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.Word(items[i]) == Sys.Word(value))) { return i; }
        }
        return -1;
    }

    public bool Exists(Func<T, bool> match) { return FindIndex(match) >= 0; }

    public bool TrueForAll(Func<T, bool> match) {
        for (int i = 0; i < count; i++) {
            if (!match(items[i])) { return false; }
        }
        return true;
    }

    public List<T> FindAll(Func<T, bool> match) {
        List<T> found = new List<T>();
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { found.Add(items[i]); }
        }
        return found;
    }

    public T? FindLast(Func<T, bool> match) {
        for (int i = count - 1; i >= 0; i--) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public int FindLastIndex(Func<T, bool> match) {
        for (int i = count - 1; i >= 0; i--) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    /// HOW MANY WERE REMOVED, which is .NET's answer and the useful one.
    ///
    /// ONE PASS, compacting in place: removing one at a time from the front
    /// would shift the tail once per removal and make clearing a list of n
    /// quadratic.
    public int RemoveAll(Func<T, bool> match) {
        int into = 0;

        for (int i = 0; i < count; i++) {
            if (match(items[i])) { continue; }
            items[into] = items[i];
            into = into + 1;
        }

        int removed = count - into;
        for (int i = into; i < count; i++) { items[i] = default(T)!; }
        count = into;
        return removed;
    }

    public List<T> GetRange(int index, int howMany) {
        List<T> made = new List<T>(howMany);
        for (int i = 0; i < howMany; i++) { made.Add(items[index + i]); }
        return made;
    }

    /// THE ELEMENTS IN ORDER. With no argument the order is Comparer<T>'s --
    /// text by its characters, numbers by their value, and anything else by
    /// its address, which is the limitation described there.
    public void Sort() { SortRange(0, count, new DefaultComparer<T>()); }

    public void Sort(IComparer<T> by) { SortRange(0, count, by); }

    public void Sort(Comparison<T> by) { SortRange(0, count, new ComparisonComparer<T>(by)); }

    public void Sort(int index, int howMany, IComparer<T> by) { SortRange(index, howMany, by); }

    /// THE MERGE SORT, WRITTEN HERE rather than called in Sorting, and not by
    /// preference: List<T> is compiled ONCE over the machine word, so its T is
    /// the canonical one, and handing that to a generic method that is
    /// compiled per type argument is a conversion the checker refuses --
    /// "cannot convert 'IComparer$__canon' to 'IComparer<object>'". Array's
    /// sort, whose methods are themselves per-argument, does call Sorting.
    ///
    /// MERGE RATHER THAN QUICK: it is STABLE, so equal elements keep the order
    /// they arrived in and sorting a table by one column and then another
    /// means what it looks like; and it has no worst case to be provoked into
    /// by data that came off a network.
    private void SortRange(int from, int howMany, IComparer<T> by) {
        if (howMany < 2) { return; }

        T[] scratch = new T[howMany];
        int width = 1;

        // BOTTOM UP, doubling the run length, so there is no recursion to run
        // out of stack on and no pivot to choose badly.
        while (width < howMany) {
            int at = 0;

            while (at < howMany) {
                int leftEnd = at + width;
                int rightEnd = at + width * 2;

                if (leftEnd > howMany) { leftEnd = howMany; }
                if (rightEnd > howMany) { rightEnd = howMany; }

                int i = at;
                int j = leftEnd;
                int into = at;

                while (i < leftEnd && j < rightEnd) {
                    // `<= 0` AND NOT `< 0` is what makes it stable: a tie goes
                    // to the left run, which is the earlier one.
                    if (by.Compare(items[from + i], items[from + j]) <= 0) {
                        scratch[into] = items[from + i];
                        i = i + 1;
                    } else {
                        scratch[into] = items[from + j];
                        j = j + 1;
                    }
                    into = into + 1;
                }

                while (i < leftEnd) {
                    scratch[into] = items[from + i];
                    i = i + 1;
                    into = into + 1;
                }
                while (j < rightEnd) {
                    scratch[into] = items[from + j];
                    j = j + 1;
                    into = into + 1;
                }

                at = at + width * 2;
            }

            for (int k = 0; k < howMany; k++) { items[from + k] = scratch[k]; }
            width = width * 2;
        }
    }

    /// WHERE IT IS, OR WHERE IT WOULD GO. .NET answers the complement of the
    /// insertion point when the value is absent -- a negative number that is
    /// never -0, which is why it is ~i and not -i.
    public int BinarySearch(T value, IComparer<T> by) {
        int low = 0;
        int high = count - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = by.Compare(items[middle], value);

            if (sign == 0) { return middle; }
            if (sign < 0) {
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        return ~low;
    }

    public int BinarySearch(T value) { return BinarySearch(value, new DefaultComparer<T>()); }

    private void Grow() {
        int size = items == null || items.Length == 0 ? 4 : items.Length * 2;
        T[] bigger = new T[size];
        for (int i = 0; i < count; i++) { bigger[i] = items[i]; }
        items = bigger;
    }
}

// A FIRST-IN, FIRST-OUT QUEUE, on a growable ring.
//
// A List with RemoveAt(0) would be a queue too, and a quadratic one: every
// Dequeue would shuffle everything left. A ring moves the HEAD instead, so both
// ends are constant time and the storage is reused as it goes round.
//
// The compiler's own Monomorphiser.cs keeps its worklist in one of these --
// specialising a generic discovers more generics to specialise, which is
// exactly the shape a queue is for.

/// .NET spells this Queue<T>.Enumerator. HEAD FIRST, which is the order the
/// queue hands things out in and not the order the ring stores them in.
class QueueEnumerator<T> : IEnumerator<T> {
    private Queue<T> over;
    private int at;

    public QueueEnumerator(Queue<T> queue) {
        over = queue;
        at = -1;
    }

    public T Current => over[at];

    public bool MoveNext() {
        at = at + 1;
        return at < over.Count;
    }
}

class Queue<T> : IEnumerable<T> {
    private T[] items;
    private int head;
    private int count;

    public Queue() {
        items = new T[8];
        head = 0;
        count = 0;
    }

    public int Count => count;

    public void Enqueue(T value) {
        if (count == items.Length) { Grow(); }

        // WRAPPING IS THE POINT: the free space may be in front of the head as
        // well as behind the tail, and a queue that only wrote forwards would
        // grow every time it went round.
        int at = head + count;

        if (at >= items.Length) { at = at - items.Length; }

        items[at] = value;
        count = count + 1;
    }

    public T Dequeue() {
        if (count == 0) { throw new InvalidOperationException("the queue is empty"); }

        T taken = items[head];
        items[head] = default(T)!;

        head = head + 1;

        if (head == items.Length) { head = 0; }

        count = count - 1;
        return taken;
    }

    public T Peek() {
        if (count == 0) { throw new InvalidOperationException("the queue is empty"); }
        return items[head];
    }

    public void Clear() {
        for (int i = 0; i < count; i++) { items[(head + i) % items.Length] = default(T)!; }
        head = 0;
        count = 0;
    }

    /// THE NON-THROWING PAIR, which is what a worker loop draining a queue
    /// writes: false at the end rather than an exception to catch.
    public bool TryDequeue(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = Dequeue();
        return true;
    }

    public bool TryPeek(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = items[head];
        return true;
    }

    public bool Contains(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;

        for (int i = 0; i < count; i++) {
            if (same.Equals(this[i], value)) { return true; }
        }
        return false;
    }

    /// IN QUEUE ORDER, head first, which is not the order the ring holds them
    /// in -- and is the order every caller means.
    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = this[i]; }
        return made;
    }

    public void CopyTo(T[] target, int at) {
        for (int i = 0; i < count; i++) { target[at + i] = this[i]; }
    }

    public IEnumerator<T> GetEnumerator() { return new QueueEnumerator<T>(this); }

    /// Not a .NET member: the i-th element in queue order, which the
    /// enumerator and the copies above need and the ring makes non-obvious.
    public T this[int index] {
        get {
            int at = head + index;

            if (at >= items.Length) { at = at - items.Length; }
            return items[at];
        }
    }

    // STRAIGHTENED OUT WHILE COPYING, so the new store starts at zero and the
    // wrap arithmetic above stays simple. Copying in queue order rather than
    // storage order is what makes that true.
    private void Grow() {
        T[] bigger = new T[items.Length * 2];

        for (int i = 0; i < count; i++) {
            int at = head + i;

            if (at >= items.Length) { at = at - items.Length; }

            bigger[i] = items[at];
        }

        items = bigger;
        head = 0;
    }
}

// ---- Dictionary -----------------------------------------------------------
// Open addressing with linear probing. Chaining would need an allocation per
// entry, and an arena that is freed wholesale at the end of a handler is
// exactly the wrong place to be allocating many small nodes.
//
// Keys are hashed by their machine word, which is a value for an integer and an
// identity for an object. That is honest about what the machine can see.

// ---- the interfaces a collection answers to --------------------------------
//
// Named as .NET names them, so a class that says `: IEquatable<Type>` compiles
// here and there alike. IEquatable is the one that matters most: it is how a
// type says its Equals is about VALUE rather than identity, and this
// compiler's own Type says exactly that.

interface IEquatable<T> {
    bool Equals(T other);
}

interface IDisposable {
    void Dispose();
}

// Dictionary's default comparer is already reference (machine-word) identity.
// Keeping the .NET singleton name lets the compiler request that policy
// explicitly without allocating a comparer object.
/// .NET's ReferenceEqualityComparer: two things are the same when they are the
/// same OBJECT, whatever their own Equals says. .NET declares it as an
/// `IEqualityComparer<object>` and it serves as an IEqualityComparer of
/// anything, which is what `in T` on the interface is for.
sealed class ReferenceEqualityComparer : IEqualityComparer<object> {
    private static ReferenceEqualityComparer? only;

    public static ReferenceEqualityComparer Instance {
        get {
            if (only == null) { only = new ReferenceEqualityComparer(); }
            return only;
        }
    }

    public bool Equals(object a, object b) { return Sys.Word(a) == Sys.Word(b); }

    public int GetHashCode(object value) { return (int)Sys.Word(value); }
}

/// A sequence that can be counted and indexed, and not written to.
///
/// This is what LINQ asks of a sequence, and why the operators below can be
/// declared over it rather than over List: counted and indexed is all they
/// need, and everything that is those two things gets them.
/// .NET's shape exactly: a collection knows how many it has, a list can be
/// indexed, and both are sequences. The hierarchy is what lets one set of
/// operators over IEnumerable<T> serve every one of them.
interface IReadOnlyCollection<out T> : IEnumerable<T> {
    int Count { get; }
}

interface IReadOnlyList<out T> : IReadOnlyCollection<T> {
    T this[int index] { get; }
}

/// A set, read only: what it holds and whether it holds a thing.
interface IReadOnlySet<T> : IReadOnlyCollection<T> {
    bool Contains(T item);
}

// EXTENSION METHODS, which is how C# spells LINQ.
//
// `this` on the first parameter of a static method, so `list.IsEmpty()` means
// `Enumerable.IsEmpty(list)` and reads the way every other member call reads.
// An extension is searched LAST, after every real member of the type, so it
// can never shadow one -- that is C#'s rule and it is what stops adding an
// extension from changing what existing code means.
//
// This is where LINQ lives, as it does in .NET. It could not until a generic
// method could be compiled per type argument: over one shared copy, `Where<T>`
// handed back a list of `object` and the element type died at the call, so the
// operators had to sit on List<T> where monomorphisation kept the types. They
// moved here the day that landed, and not one call site changed.
// ONE GROUP: a key and the elements that had it. .NET's IGrouping is an
// IEnumerable with a Key on it, which is what lets `foreach (var g in
// items.GroupBy(...))` walk the group itself and ask what it is at the same
// time.
interface IGrouping<K, T> : IEnumerable<T> {
    K Key { get; }
}

class Grouping<K, T> : IGrouping<K, T>, IReadOnlyList<T>, IEnumerable<T> {
    private K key;
    private List<T> items;

    public Grouping(K value) {
        key = value;
        items = new List<T>();
    }

    public K Key => key;
    public int Count => items.Count;
    public T this[int index] => items[index];

    /// Not a .NET member: GroupBy fills the group as it walks the source, and
    /// a group built from outside has no other way in.
    public void Add(T value) { items.Add(value); }

    public IEnumerator<T> GetEnumerator() { return new ListEnumerator<T>(items); }
}

/// THE WHOLE GROUPING, KEPT: a Lookup is what GroupBy produces, stored so it
/// can be asked about a key more than once. The difference from a Dictionary
/// is the one every program that has written `dict[key].Add(...)` wants: a key
/// that is not there answers an EMPTY sequence rather than throwing.
class Lookup<K, T> {
    private List<Grouping<K, T>> groups;
    private Dictionary<K, Grouping<K, T>> byKey;

    public Lookup() {
        groups = new List<Grouping<K, T>>();
        byKey = new Dictionary<K, Grouping<K, T>>();
    }

    public int Count => groups.Count;

    public IReadOnlyList<T> this[K key] {
        get {
            Grouping<K, T>? found = null;

            if (byKey.TryGetValue(key, out found) && found != null) { return found; }
            return new List<T>();
        }
    }

    public bool Contains(K key) { return byKey.ContainsKey(key); }

    /// Not a .NET member: ToLookup and GroupBy fill it, and nothing else can.
    public void Add(K key, T value) {
        Grouping<K, T>? found = null;

        if (!byKey.TryGetValue(key, out found) || found == null) {
            found = new Grouping<K, T>(key);
            byKey[key] = found;
            groups.Add(found);
        }
        found.Add(value);
    }

    /// The groups in the order their keys were first seen, which is the order
    /// .NET's GroupBy yields them in.
    public List<Grouping<K, T>> Groups => groups;
}

static class Enumerable {
    /// .NET's CollectionExtensions.GetValueOrDefault, over any read-only
    /// dictionary: the value, or the type's zero where the key is not there.
    public static V? GetValueOrDefault<K, V>(this IReadOnlyDictionary<K, V> source, K key) {
        V? found = default(V);

        return source.TryGetValue(key, out found) ? found : default(V);
    }

    public static V GetValueOrDefault<K, V>(this IReadOnlyDictionary<K, V> source, K key, V fallback) {
        V found = fallback;

        return source.TryGetValue(key, out found) ? found : fallback;
    }

    public static T[] Empty<T>() { return new T[0]; }

    /// THE SEQUENCE AS A LIST, without copying one that already is.
    ///
    /// The operators below take an IEnumerable<T>, which is what .NET's take
    /// and the reason a Dictionary, a HashSet and an array can all be asked.
    /// The ones that count or index need somewhere to count and index, and
    /// .NET does exactly this inside them -- it asks whether the sequence is
    /// already a collection before it walks one.
    private static IReadOnlyList<T> AsList<T>(IEnumerable<T> source) {
        if (source is IReadOnlyList<T> already) { return already; }

        List<T> made = new List<T>();

        foreach (T each in source) { made.Add(each); }
        return made;
    }

    // ---- grouping ---------------------------------------------------------

    /// THE ELEMENTS BY WHAT THEY HAVE IN COMMON. The groups come out in the
    /// order their keys were FIRST SEEN and each group's elements in source
    /// order, which is .NET's promise and the reason a grouped report reads
    /// the same way twice.
    public static List<Grouping<K, T>> GroupBy<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        IReadOnlyList<T> items = AsList(source);

        Lookup<K, T> made = new Lookup<K, T>();

        for (int i = 0; i < items.Count; i++) { made.Add(key(items[i]), items[i]); }
        return made.Groups;
    }

    /// The same, with the elements themselves replaced by something taken from
    /// them -- `people.GroupBy(p => p.Town, p => p.Name)`.
    public static List<Grouping<K, R>> GroupBy<T, K, R>(this IEnumerable<T> source, Func<T, K> key, Func<T, R> pick) {
        IReadOnlyList<T> items = AsList(source);

        Lookup<K, R> made = new Lookup<K, R>();

        for (int i = 0; i < items.Count; i++) { made.Add(key(items[i]), pick(items[i])); }
        return made.Groups;
    }

    public static Lookup<K, T> ToLookup<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        IReadOnlyList<T> items = AsList(source);

        Lookup<K, T> made = new Lookup<K, T>();

        for (int i = 0; i < items.Count; i++) { made.Add(key(items[i]), items[i]); }
        return made;
    }

    // ---- the rest ---------------------------------------------------------

    /// THE ELEMENT WITH THE SMALLEST KEY, not the smallest key -- which is the
    /// difference from Min, and the one that makes `people.MinBy(p => p.Age)`
    /// answer a person rather than a number.
    public static T MinBy<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }

        IComparer<T> by = new KeyComparer<T, K>(key, false);
        T best = items[0];

        for (int i = 1; i < items.Count; i++) {
            if (by.Compare(items[i], best) < 0) { best = items[i]; }
        }
        return best;
    }

    public static T MaxBy<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }

        IComparer<T> by = new KeyComparer<T, K>(key, false);
        T best = items[0];

        for (int i = 1; i < items.Count; i++) {
            if (by.Compare(items[i], best) > 0) { best = items[i]; }
        }
        return best;
    }

    /// A SEQUENCE THAT IS NEVER EMPTY: the one value, where there were none.
    /// It is what keeps an aggregate from throwing on an empty items.
    public static List<T> DefaultIfEmpty<T>(this IEnumerable<T> source, T value) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();

        if (items.Count == 0) {
            made.Add(value);
            return made;
        }
        for (int i = 0; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    public static List<T> TakeLast<T>(this IEnumerable<T> source, int count) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        int from = items.Count - count;

        if (from < 0) { from = 0; }
        for (int i = from; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    public static List<T> SkipLast<T>(this IEnumerable<T> source, int count) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        int end = items.Count - count;

        for (int i = 0; i < end; i++) { made.Add(items[i]); }
        return made;
    }

    public static long LongCount<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);
 return (long)items.Count; }

    public static List<R> Select<T, R>(this IEnumerable<T> source, Func<T, int, R> pick) {
        IReadOnlyList<T> items = AsList(source);

        List<R> made = new List<R>();

        for (int i = 0; i < items.Count; i++) { made.Add(pick(items[i], i)); }
        return made;
    }

    /// The pairs, joined by a function of the two -- .NET's other Zip, and the
    /// one that does not need a tuple to be written down.
    public static List<R> Zip<T, U, R>(this IEnumerable<T> first, IEnumerable<U> second, Func<T, U, R> join) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<U> right = AsList(second);

        List<R> made = new List<R>();
        int count = left.Count < right.Count ? left.Count : right.Count;

        for (int i = 0; i < count; i++) { made.Add(join(left[i], right[i])); }
        return made;
    }

    // The real-number aggregates. Sum over longs cannot stand in for these:
    // adding prices as whole numbers is how a total ends up a penny out.

    public static double Sum(this IEnumerable<double> source) {
        IReadOnlyList<double> items = AsList(source);

        double total = 0.0;

        for (int i = 0; i < items.Count; i++) { total = total + items[i]; }
        return total;
    }

    public static int Sum<T>(this IEnumerable<T> source, Func<T, int> value) {
        if (source == null) throw new ArgumentNullException("source");
        if (value == null) throw new ArgumentNullException("value");
        int total = 0;
        foreach (T item in source) total = checked(total + value(item));
        return total;
    }

    public static double Sum<T>(this IEnumerable<T> source, Func<T, double> value) {
        IReadOnlyList<T> items = AsList(source);

        double total = 0.0;

        for (int i = 0; i < items.Count; i++) { total = total + value(items[i]); }
        return total;
    }

    public static double Min(this IEnumerable<double> source) {
        IReadOnlyList<double> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }

        double least = items[0];

        for (int i = 1; i < items.Count; i++) {
            if (items[i] < least) { least = items[i]; }
        }
        return least;
    }

    public static double Max(this IEnumerable<double> source) {
        IReadOnlyList<double> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }

        double most = items[0];

        for (int i = 1; i < items.Count; i++) {
            if (items[i] > most) { most = items[i]; }
        }
        return most;
    }

    public static double Average(this IEnumerable<double> source) {
        IReadOnlyList<double> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }
        return items.Sum() / (double)items.Count;
    }

    public static double Average<T>(this IEnumerable<T> source, Func<T, double> value) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("Sequence contains no elements"); }
        return items.Sum(value) / (double)items.Count;
    }


    public static List<int> Range(int start, int count) {
        List<int> made = new List<int>();
        for (int i = 0; i < count; i++) { made.Add(start + i); }
        return made;
    }
    public static List<T> Where<T>(this IEnumerable<T> source, Func<T, bool> keep) {
        IReadOnlyList<T> items = AsList(source);

        List<T> kept = new List<T>();
        int i = 0;
        while (i < items.Count) {
            if (keep(items[i])) { kept.Add(items[i]); }
            i = i + 1;
        }
        return kept;
    }

    /// The overload that also passes the position, which C# has and which this
    /// compiler's own Types.cs uses to compare two argument lists.
    public static List<T> Where<T>(this IEnumerable<T> source, Func<T, int, bool> keep) {
        IReadOnlyList<T> items = AsList(source);

        List<T> kept = new List<T>();
        int i = 0;
        while (i < items.Count) {
            if (keep(items[i], i)) { kept.Add(items[i]); }
            i = i + 1;
        }
        return kept;
    }

    /// The one that needs a SECOND type parameter, and so could not exist at
    /// all until a generic method could be compiled per type argument.
    public static List<R> Select<T, R>(this IEnumerable<T> source, Func<T, R> pick) {
        IReadOnlyList<T> items = AsList(source);

        List<R> made = new List<R>();
        int i = 0;
        while (i < items.Count) {
            made.Add(pick(items[i]));
            i = i + 1;
        }
        return made;
    }

    public static bool Any<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);
 return items.Count > 0; }

    public static bool Any<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        int i = 0;
        while (i < items.Count) {
            if (test(items[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    public static bool All<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        int i = 0;
        while (i < items.Count) {
            if (!test(items[i])) { return false; }
            i = i + 1;
        }
        return true;
    }

    /// `Count` with a predicate, which lives here rather than on List because
    /// List already has a Count PROPERTY -- exactly as in .NET, where the two
    /// coexist because one of them is an extension.
    public static int Count<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        int n = 0;
        int i = 0;
        while (i < items.Count) {
            if (test(items[i])) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    public static int Count<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);
 return items.Count; }

    public static T First<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        int i = 0;
        while (i < items.Count) {
            if (test(items[i])) { return items[i]; }
            i = i + 1;
        }
        throw new InvalidOperationException("no element matched");
    }

    /// Null when nothing matches, which is what the name says and is why it is
    /// spelt differently from First.
    public static T? FirstOrDefault<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        int i = 0;
        while (i < items.Count) {
            if (test(items[i])) { return items[i]; }
            i = i + 1;
        }
        return null;
    }

    public static T? FirstOrDefault<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { return default(T); }
        return items[0];
    }

    public static long Sum<T>(this IEnumerable<T> source, Func<T, long> value) {
        IReadOnlyList<T> items = AsList(source);

        long total = 0;
        int i = 0;
        while (i < items.Count) {
            total = total + value(items[i]);
            i = i + 1;
        }
        return total;
    }

    public static List<T> ToList<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        List<T> copy = new List<T>();
        int i = 0;
        while (i < items.Count) {
            copy.Add(items[i]);
            i = i + 1;
        }
        return copy;
    }

    public static T[] ToArray<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        T[] copy = new T[items.Count];
        for (int i = 0; i < items.Count; i++) { copy[i] = items[i]; }
        return copy;
    }

    public static T? ElementAtOrDefault<T>(this IEnumerable<T> source, int index) {
        IReadOnlyList<T> items = AsList(source);

        if (index < 0 || index >= items.Count) { return default(T); }
        return items[index];
    }

    public static bool SequenceEqual<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<T> right = AsList(second);

        if (left.Count != right.Count) { return false; }
        for (int i = 0; i < left.Count; i++) {
            if (!(Sys.IsObject(left[i]) ? Sys.KeyEquals(left[i], right[i]) : Sys.Word(left[i]) == Sys.Word(right[i]))) { return false; }
        }
        return true;
    }

    public static List<T> Skip<T>(this IEnumerable<T> source, int count) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        for (int i = count; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    public static List<T> Take<T>(this IEnumerable<T> source, int count) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        int end = count < items.Count ? count : items.Count;
        for (int i = 0; i < end; i++) { made.Add(items[i]); }
        return made;
    }

    public static List<T> Distinct<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        HashSet<T> seen = new HashSet<T>();
        for (int i = 0; i < items.Count; i++) {
            if (seen.Add(items[i])) { made.Add(items[i]); }
        }
        return made;
    }

    /// THE PAIRS, AND .NET NAMES THEM. Its signature is
    /// `IEnumerable<(TFirst First, TSecond Second)>`, so `a.Zip(b).All(p =>
    /// p.First == p.Second)` is how the result is read -- the names are part
    /// of the type and a caller written against .NET uses them.
    public static List<(T First, U Second)> Zip<T, U>(this IEnumerable<T> first, IEnumerable<U> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<U> right = AsList(second);

        List<(T First, U Second)> made = new List<(T First, U Second)>();
        int count = left.Count < right.Count ? left.Count : right.Count;
        for (int i = 0; i < count; i++) { made.Add((left[i], right[i])); }
        return made;
    }

    public static List<R> OfType<R>(this IEnumerable<object> source) {
        IReadOnlyList<object> items = AsList(source);

        List<R> made = new List<R>();
        for (int i = 0; i < items.Count; i++) {
            if (items[i] is R value) { made.Add(value); }
        }
        return made;
    }

    public static bool IsEmpty<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);
 return items.Count == 0; }

    /// The same value, that many times. Not an extension -- it makes a
    /// sequence rather than reading one -- which is how .NET has it too.
    public static List<T> Repeat<T>(T value, int count) {
        List<T> made = new List<T>();
        int i = 0;
        while (i < count) {
            made.Add(value);
            i = i + 1;
        }
        return made;
    }

    // ---- the rest of LINQ to objects --------------------------------------
    //
    // Most operators here still materialize a List rather than a deferred
    // sequence. This differs from System.Linq in side-effect timing, allocation
    // and support for unbounded inputs. SelectMany below streams through an
    // explicit enumerator; arbitrary yield bodies still need state-machine
    // lowering instead of the compiler's eager list transformation.

    public static T Last<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }
        return items[items.Count - 1];
    }

    public static T Last<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        for (int i = items.Count - 1; i >= 0; i--) {
            if (test(items[i])) { return items[i]; }
        }
        throw new InvalidOperationException("no element matched");
    }

    public static T? LastOrDefault<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { return default(T); }
        return items[items.Count - 1];
    }

    public static T? LastOrDefault<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        for (int i = items.Count - 1; i >= 0; i--) {
            if (test(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public static T First<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }
        return items[0];
    }

    /// EXACTLY ONE, and it throws when there are two -- which is the whole
    /// difference from First and the reason to write it: it asserts that the
    /// thing being looked up is unique.
    public static T Single<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        T found = default(T)!;
        bool any = false;

        for (int i = 0; i < items.Count; i++) {
            if (!test(items[i])) { continue; }
            if (any) { throw new InvalidOperationException("more than one element matched"); }
            found = items[i];
            any = true;
        }

        if (!any) { throw new InvalidOperationException("no element matched"); }
        return found;
    }

    public static T Single<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count != 1) {
            throw new InvalidOperationException("the sequence does not hold exactly one element");
        }
        return items[0];
    }

    public static T? SingleOrDefault<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        T found = default(T)!;
        bool any = false;

        for (int i = 0; i < items.Count; i++) {
            if (!test(items[i])) { continue; }
            if (any) { throw new InvalidOperationException("more than one element matched"); }
            found = items[i];
            any = true;
        }
        return found;
    }

    public static T ElementAt<T>(this IEnumerable<T> source, int index) {
        IReadOnlyList<T> items = AsList(source);

        if (index < 0 || index >= items.Count) {
            throw new ArgumentOutOfRangeException("index");
        }
        return items[index];
    }

    public static bool Contains<T>(this IEnumerable<T> source, T value) {
        IReadOnlyList<T> items = AsList(source);

        for (int i = 0; i < items.Count; i++) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.Word(items[i]) == Sys.Word(value))) { return true; }
        }
        return false;
    }

    public static List<T> Reverse<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>(items.Count);
        for (int i = items.Count - 1; i >= 0; i--) { made.Add(items[i]); }
        return made;
    }

    public static List<T> Concat<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<T> right = AsList(second);

        List<T> made = new List<T>(left.Count + right.Count);
        for (int i = 0; i < left.Count; i++) { made.Add(left[i]); }
        for (int i = 0; i < right.Count; i++) { made.Add(right[i]); }
        return made;
    }

    public static List<T> Append<T>(this IEnumerable<T> source, T value) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>(items.Count + 1);
        for (int i = 0; i < items.Count; i++) { made.Add(items[i]); }
        made.Add(value);
        return made;
    }

    public static List<T> Prepend<T>(this IEnumerable<T> source, T value) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>(items.Count + 1);
        made.Add(value);
        for (int i = 0; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    /// STOPS AT THE FIRST ONE THAT FAILS, which is what makes it different
    /// from Where: a sorted list can be cut short without reading the tail.
    public static List<T> TakeWhile<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        for (int i = 0; i < items.Count; i++) {
            if (!test(items[i])) { break; }
            made.Add(items[i]);
        }
        return made;
    }

    public static List<T> SkipWhile<T>(this IEnumerable<T> source, Func<T, bool> test) {
        IReadOnlyList<T> items = AsList(source);

        List<T> made = new List<T>();
        int at = 0;

        while (at < items.Count && test(items[at])) { at = at + 1; }
        for (int i = at; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    public static IEnumerable<R> SelectMany<T, R>(this IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        if (source == null) throw new ArgumentNullException("source");
        if (selector == null) throw new ArgumentNullException("selector");
        return new SelectManySequence<T, R>(source, selector);
    }

    /// FOLD, under .NET's name for it. The seeded overload is the one that
    /// works on an empty sequence, which is why .NET has both.
    public static R Aggregate<T, R>(this IEnumerable<T> source, R seed, Func<R, T, R> fold) {
        IReadOnlyList<T> items = AsList(source);

        R total = seed;
        for (int i = 0; i < items.Count; i++) { total = fold(total, items[i]); }
        return total;
    }

    public static T Aggregate<T>(this IEnumerable<T> source, Func<T, T, T> fold) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }

        T total = items[0];
        for (int i = 1; i < items.Count; i++) { total = fold(total, items[i]); }
        return total;
    }

    // ---- ordering ---------------------------------------------------------

    /// The sorted array as a list. Not `new List<T>(array)`: an array offered
    /// where an IEnumerable is also accepted goes through the compiler's array
    /// view, which has no enumerator to give -- see the note above
    /// IEnumerator.
    private static List<T> Listed<T>(T[] items) {
        List<T> made = new List<T>(items.Length);
        for (int i = 0; i < items.Length; i++) { made.Add(items[i]); }
        return made;
    }

    public static List<T> OrderBy<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        T[] made = source.ToArray();
        Sorting.Sort<T>(made, 0, made.Length, new KeyComparer<T, K>(key, false));
        return Listed(made);
    }

    /// THE ORDER A COMPARER SAYS, which is .NET's second overload and the one
    /// a program reaches for when the key's own ordering is not the question:
    /// `names.OrderBy(n => n, StringComparer.Ordinal)`.
    public static List<T> OrderBy<T, K>(this IEnumerable<T> source, Func<T, K> key, IComparer<K> comparer) {
        T[] made = source.ToArray();
        Sorting.Sort<T>(made, 0, made.Length, new KeyComparer<T, K>(key, false, comparer));
        return Listed(made);
    }

    public static List<T> OrderByDescending<T, K>(this IEnumerable<T> source, Func<T, K> key, IComparer<K> comparer) {
        T[] made = source.ToArray();
        Sorting.Sort<T>(made, 0, made.Length, new KeyComparer<T, K>(key, true, comparer));
        return Listed(made);
    }

    public static List<T> OrderByDescending<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        T[] made = source.ToArray();
        Sorting.Sort<T>(made, 0, made.Length, new KeyComparer<T, K>(key, true));
        return Listed(made);
    }

    public static List<T> Order<T>(this IEnumerable<T> source) {
        T[] made = source.ToArray();
        Sorting.Sort<T>(made, 0, made.Length, new DefaultComparer<T>());
        return Listed(made);
    }

    // ---- the aggregates ---------------------------------------------------
    //
    // .NET declares one of each per numeric type. These are the two widths
    // this machine computes in, plus the selector forms, which is what call
    // sites actually use.

    public static long Min<T>(this IEnumerable<T> source, Func<T, long> value) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }

        long least = value(items[0]);
        for (int i = 1; i < items.Count; i++) {
            long one = value(items[i]);
            if (one < least) { least = one; }
        }
        return least;
    }

    public static long Max<T>(this IEnumerable<T> source, Func<T, long> value) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }

        long most = value(items[0]);
        for (int i = 1; i < items.Count; i++) {
            long one = value(items[i]);
            if (one > most) { most = one; }
        }
        return most;
    }

    public static double Average<T>(this IEnumerable<T> source, Func<T, long> value) {
        IReadOnlyList<T> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }
        return (double)Sum(items, value) / (double)items.Count;
    }

    public static long Sum(this IEnumerable<long> source) {
        IReadOnlyList<long> items = AsList(source);

        long total = 0;
        for (int i = 0; i < items.Count; i++) { total = total + items[i]; }
        return total;
    }

    public static int Sum(this IEnumerable<int> source) {
        IReadOnlyList<int> items = AsList(source);

        int total = 0;
        for (int i = 0; i < items.Count; i++) { total = total + items[i]; }
        return total;
    }

    public static int Min(this IEnumerable<int> source) {
        IReadOnlyList<int> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }

        int least = items[0];
        for (int i = 1; i < items.Count; i++) {
            if (items[i] < least) { least = items[i]; }
        }
        return least;
    }

    public static int Max(this IEnumerable<int> source) {
        IReadOnlyList<int> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }

        int most = items[0];
        for (int i = 1; i < items.Count; i++) {
            if (items[i] > most) { most = items[i]; }
        }
        return most;
    }

    public static double Average(this IEnumerable<int> source) {
        IReadOnlyList<int> items = AsList(source);

        if (items.Count == 0) { throw new InvalidOperationException("the sequence is empty"); }
        return (double)Sum(source) / (double)items.Count;
    }

    // ---- the set operations ------------------------------------------------

    public static List<T> Except<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<T> right = AsList(second);

        HashSet<T> drop = new HashSet<T>();
        for (int i = 0; i < right.Count; i++) { drop.Add(right[i]); }

        List<T> made = new List<T>();
        HashSet<T> seen = new HashSet<T>();

        for (int i = 0; i < left.Count; i++) {
            if (drop.Contains(left[i])) { continue; }
            if (seen.Add(left[i])) { made.Add(left[i]); }
        }
        return made;
    }

    public static List<T> Union<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<T> right = AsList(second);

        List<T> made = new List<T>();
        HashSet<T> seen = new HashSet<T>();

        for (int i = 0; i < left.Count; i++) {
            if (seen.Add(left[i])) { made.Add(left[i]); }
        }
        for (int i = 0; i < right.Count; i++) {
            if (seen.Add(right[i])) { made.Add(right[i]); }
        }
        return made;
    }

    public static List<T> Intersect<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        IReadOnlyList<T> left = AsList(first);
        IReadOnlyList<T> right = AsList(second);

        HashSet<T> keep = new HashSet<T>();
        for (int i = 0; i < right.Count; i++) { keep.Add(right[i]); }

        List<T> made = new List<T>();
        HashSet<T> seen = new HashSet<T>();

        for (int i = 0; i < left.Count; i++) {
            if (!keep.Contains(left[i])) { continue; }
            if (seen.Add(left[i])) { made.Add(left[i]); }
        }
        return made;
    }

    public static HashSet<T> ToHashSet<T>(this IEnumerable<T> source) {
        IReadOnlyList<T> items = AsList(source);

        HashSet<T> made = new HashSet<T>();
        for (int i = 0; i < items.Count; i++) { made.Add(items[i]); }
        return made;
    }

    public static Dictionary<K, T> ToDictionary<T, K>(this IEnumerable<T> source, Func<T, K> key) {
        IReadOnlyList<T> items = AsList(source);

        Dictionary<K, T> made = new Dictionary<K, T>(items.Count);
        for (int i = 0; i < items.Count; i++) { made[key(items[i])] = items[i]; }
        return made;
    }

    public static Dictionary<K, T> ToDictionary<T, K>(this IEnumerable<T> source,
                                                         Func<T, K> key, IEqualityComparer<K>? comparer) {
        if (source == null) throw new ArgumentNullException("source");
        if (key == null) throw new ArgumentNullException("key");
        Dictionary<K, T> made = comparer == null ? new Dictionary<K, T>() : new Dictionary<K, T>(comparer);
        foreach (T item in source) {
            K selected = key(item);
            if ((object)selected == null) throw new ArgumentNullException("key");
            if (!made.TryAdd(selected, item)) throw new ArgumentException("duplicate key");
        }
        return made;
    }

    public static Dictionary<K, V> ToDictionary<T, K, V>(this IEnumerable<T> source,
                                                         Func<T, K> key, Func<T, V> value) {
        IReadOnlyList<T> items = AsList(source);

        Dictionary<K, V> made = new Dictionary<K, V>(items.Count);
        for (int i = 0; i < items.Count; i++) { made[key(items[i])] = value(items[i]); }
        return made;
    }

    /// FIXED-SIZE PIECES, the last of which is whatever is left over. .NET's
    /// Chunk, which is how a batch job turns a list into requests.
    public static List<List<T>> Chunk<T>(this IEnumerable<T> source, int size) {
        IReadOnlyList<T> items = AsList(source);

        if (size < 1) { throw new ArgumentOutOfRangeException("size"); }

        List<List<T>> made = new List<List<T>>();
        int at = 0;

        while (at < items.Count) {
            List<T> piece = new List<T>(size);
            int end = at + size;

            if (end > items.Count) { end = items.Count; }
            for (int i = at; i < end; i++) { piece.Add(items[i]); }

            made.Add(piece);
            at = end;
        }
        return made;
    }
}

/// An order by something COMPUTED FROM the element -- OrderBy's key selector
/// -- rather than by the element itself.
///
/// The comparison is written out here rather than delegating to
/// DefaultComparer<K>, because a generic class instantiated with another
/// class's type parameter is the shape the binder refuses; see the note on
/// Comparer.
class KeyComparer<T, K> : IComparer<T> {
    private Func<T, K> of;
    private bool down;

    /// The ordering to use on the keys, when the caller named one. Null means
    /// the one below: a string by its text and anything else by its word.
    private IComparer<K>? by;

    public KeyComparer(Func<T, K> key, bool descending) {
        of = key;
        down = descending;
        by = null;
    }

    public KeyComparer(Func<T, K> key, bool descending, IComparer<K> comparer) {
        of = key;
        down = descending;
        by = comparer;
    }

    public int Compare(T a, T b) {
        K left = of(a);
        K right = of(b);
        int sign = 0;

        if (by != null) {
            sign = by.Compare(left, right);
        } else if (Sys.IsString(left)) {
            sign = String.Compare(Sys.AsString(left), Sys.AsString(right));
        } else {
            long x = Sys.Word(left);
            long y = Sys.Word(right);
            sign = x < y ? -1 : (x > y ? 1 : 0);
        }
        return down ? -sign : sign;
    }
}


/// WHAT `a[1..4]` COMPILES TO, under the name the C# compiler uses for it.
///
/// .NET's member takes a Range, which is a type this machine does not have
/// yet, so the range is passed as the two numbers it holds. The name and the
/// job are the real ones: a range applied to an array COPIES, unlike the same
/// syntax on a span, and code that slices an image header depends on the copy
/// being independent of the bytes it came from.
static class RuntimeHelpers {
    public static T[] GetSubArray<T>(T[] source, int start, int length) {
        if (start < 0 || length < 0 || start + length > source.Length) {
            throw new IndexOutOfRangeException("slice is outside its array");
        }

        T[] made = new T[length];

        for (int i = 0; i < length; i++) { made[i] = source[start + i]; }
        return made;
    }
}

/// THE ARRAY HELPERS, as .NET spells them.
static class Array {
    /// An array of no elements. .NET returns a shared singleton; this one
    /// allocates, because there is nowhere to cache it per type yet and a
    /// zero-length array costs one word.
    public static T[] Empty<T>() { return new T[0]; }

    /// A SHALLOW COPY, which is what .NET's Array.Clone answers: a new array
    /// with the same elements, and elements that are references still pointing
    /// at the same things.
    ///
    /// .NET declares it on System.Array and returns object, so every caller
    /// casts; here it is an extension over the array itself, typed, because a
    /// cast back from object would be the only difference and there is nothing
    /// for it to protect against.
    public static T[] Clone<T>(this T[] items) {
        T[] made = new T[items.Length];

        for (int i = 0; i < items.Length; i++) { made[i] = items[i]; }
        return made;
    }

    public static int IndexOf<T>(T[] items, T value) {
        for (int i = 0; i < items.Length; i++) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.Word(items[i]) == Sys.Word(value))) { return i; }
        }
        return 0 - 1;
    }

    public static bool Contains<T>(this T[] items, T value) {
        return IndexOf(items, value) >= 0;
    }

    /// Replace every element with one value. This overload is the primitive
    /// array form used by the compiler's ISA tables; wider and reference-array
    /// overloads can use the same loop as their source reaches self-hosting.
    public static void Fill(byte[] items, byte value) {
        int i = 0;
        while (i < items.Length) {
            items[i] = value;
            i = i + 1;
        }
    }

    public static void CopyTo<T>(this T[] items, T[] into) {
        for (int i = 0; i < items.Length; i++) { into[i] = items[i]; }
    }

    public static void CopyTo<T>(this T[] items, T[] into, int at) {
        for (int i = 0; i < items.Length; i++) { into[at + i] = items[i]; }
    }

    public static void CopyTo<T>(this T[] items, Span<T> into) {
        for (int i = 0; i < items.Length; i++) { into[i] = items[i]; }
    }

    // .NET's MemoryExtensions.AsSpan, which is how an array is handed to
    // something that takes a span without the conversion being implicit.
    public static Span<T> AsSpan<T>(this T[] items) { return new Span<T>(items); }

    public static Span<T> AsSpan<T>(this T[] items, int start) {
        return new Span<T>(items, start, items.Length - start);
    }

    public static Span<T> AsSpan<T>(this T[] items, int start, int length) {
        return new Span<T>(items, start, length);
    }

    public static int LastIndexOf<T>(T[] items, T value) {
        for (int i = items.Length - 1; i >= 0; i--) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.Word(items[i]) == Sys.Word(value))) { return i; }
        }
        return -1;
    }

    public static void Sort<T>(T[] items) {
        Sorting.Sort<T>(items, 0, items.Length, new DefaultComparer<T>());
    }

    public static void Sort<T>(T[] items, IComparer<T> by) {
        Sorting.Sort<T>(items, 0, items.Length, by);
    }

    public static void Sort<T>(T[] items, Comparison<T> by) {
        Sorting.Sort<T>(items, 0, items.Length, new ComparisonComparer<T>(by));
    }

    public static void Sort<T>(T[] items, int index, int howMany, IComparer<T> by) {
        Sorting.Sort<T>(items, index, howMany, by);
    }

    public static void Reverse<T>(T[] items) { Reverse(items, 0, items.Length); }

    public static void Reverse<T>(T[] items, int index, int howMany) {
        int left = index;
        int right = index + howMany - 1;

        while (left < right) {
            T held = items[left];
            items[left] = items[right];
            items[right] = held;
            left = left + 1;
            right = right - 1;
        }
    }

    /// .NET's Array.Copy, which is allowed to overlap -- so the direction is
    /// chosen from which way the block is moving rather than always forwards.
    public static void Copy<T>(T[] from, int fromAt, T[] into, int intoAt, int howMany) {
        if (intoAt > fromAt) {
            for (int i = howMany - 1; i >= 0; i--) { into[intoAt + i] = from[fromAt + i]; }
            return;
        }
        for (int i = 0; i < howMany; i++) { into[intoAt + i] = from[fromAt + i]; }
    }

    public static void Copy<T>(T[] from, T[] into, int howMany) {
        Copy(from, 0, into, 0, howMany);
    }

    /// A LONGER OR SHORTER COPY. .NET spells this `Array.Resize(ref items, n)`
    /// and assigns the new array to the caller's variable; a by-reference
    /// argument of type `T[]` cannot yet be passed an `int[]` here -- "a
    /// by-reference argument must match exactly" -- so this hands the array
    /// back instead and the caller assigns it. See
    /// build/repro-std-array-resize.cor.
    public static T[] Resized<T>(T[] items, int size) {
        T[] made = new T[size];
        int keep = items.Length < size ? items.Length : size;

        for (int i = 0; i < keep; i++) { made[i] = items[i]; }
        return made;
    }

    public static void Fill<T>(T[] items, T value) {
        for (int i = 0; i < items.Length; i++) { items[i] = value; }
    }

    public static void Fill<T>(T[] items, T value, int start, int howMany) {
        for (int i = 0; i < howMany; i++) { items[start + i] = value; }
    }

    /// Back to default(T), which is what .NET's Clear means: zero, false or
    /// null according to what the element is.
    public static void Clear<T>(T[] items) { Fill(items, default(T)!); }

    public static void Clear<T>(T[] items, int start, int howMany) {
        Fill(items, default(T)!, start, howMany);
    }

    // ---- searching by a test rather than by a value -----------------------
    //
    // The pattern-matching half of System.Array, which is older than LINQ and
    // still what a program with an array rather than a list reaches for. Each
    // takes a Predicate, which is .NET's name for a function to bool.

    public static bool Exists<T>(T[] items, Predicate<T> match) {
        return FindIndex(items, match) >= 0;
    }

    /// THE FIRST MATCH, or default(T) -- not an exception, which is the
    /// difference from LINQ's First and the reason this one needs no
    /// companion named FindOrDefault.
    public static T? Find<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public static T? FindLast<T>(T[] items, Predicate<T> match) {
        for (int i = items.Length - 1; i >= 0; i--) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public static int FindIndex<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public static int FindLastIndex<T>(T[] items, Predicate<T> match) {
        for (int i = items.Length - 1; i >= 0; i--) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public static T[] FindAll<T>(T[] items, Predicate<T> match) {
        List<T> kept = new List<T>();

        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { kept.Add(items[i]); }
        }
        return kept.ToArray();
    }

    public static bool TrueForAll<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (!match(items[i])) { return false; }
        }
        return true;
    }

    /// EVERY ELEMENT THROUGH A FUNCTION, into an array of the answers -- Select
    /// without the sequence, for code that has an array and wants one back.
    public static R[] ConvertAll<T, R>(T[] items, Func<T, R> convert) {
        R[] made = new R[items.Length];

        for (int i = 0; i < items.Length; i++) { made[i] = convert(items[i]); }
        return made;
    }

    /// A LONGER OR SHORTER ARRAY IN PLACE OF THE ONE PASSED, which is why the
    /// parameter is `ref`: an array cannot change its own length, so what
    /// really happens is a new one and an assignment over the caller's
    /// variable. .NET's signature says so and this one says the same.
    public static void Resize<T>(ref T[] items, int size) {
        T[] made = new T[size];
        int count = items.Length < size ? items.Length : size;

        for (int i = 0; i < count; i++) { made[i] = items[i]; }
        items = made;
    }

    public static int BinarySearch<T>(T[] items, T value, IComparer<T> by) {
        int low = 0;
        int high = items.Length - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = by.Compare(items[middle], value);

            if (sign == 0) { return middle; }
            if (sign < 0) {
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        return ~low;
    }

    public static int BinarySearch<T>(T[] items, T value) {
        return BinarySearch(items, value, new DefaultComparer<T>());
    }
}

/// A HASH BUILT FROM SEVERAL VALUES, spelt as .NET spells it since Core 2.1.
///
/// The mixing is FNV-1a's: a large odd multiplier and an exclusive-or per
/// value. It is not a cryptographic hash and does not claim to be -- what it
/// has to do is scatter, so that two objects differing in one field land in
/// different buckets, and a multiply-xor does that for a few pence.
///
/// The overloads take `object` because that is what C#'s take (generically),
/// and every value here is a machine word: an int, a reference, a bool. The
/// value IS the input.
static class HashCode {
    private const long Prime = 1099511628211;
    private const long Seed = -3750763034362895579;

    // WHAT THE VALUE IS, not where it is: a number handed over as an object is
    // in a box, and the box's address is different every time it is made.
    private static long Part(object value) {
        if (Sys.IsObject(value)) { return Sys.KeyHash(value); }
        return Sys.Word(value);
    }

    private static long Mix(long hash, long value) {
        return (hash ^ value) * Prime;
    }

    public static int Combine(object a, object b) {
        long h = Mix(Mix(Seed, Part(a)), Part(b));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c) {
        long h = Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c, object d) {
        long h = Mix(Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c)), Part(d));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c, object d, object e) {
        long h = Mix(Mix(Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c)),
                         Part(d)), Part(e));
        return (int)(h ^ (h >> 32));
    }
}

// HOW A TABLE DECIDES TWO KEYS ARE THE SAME: a hash and an equality that agree,
// which is .NET's IEqualityComparer<T> and is the same interface here.
//
// It matters most for strings. Hashing the machine word hashes a string's
// ADDRESS, so two strings with the same characters are two keys unless they are
// the same interned literal -- and a key that was computed, read or built is
// never that. StringComparer is what a table of strings is given instead.
/// `in T`, as .NET declares it: a comparer only ever takes its values IN, so
/// an IEqualityComparer of object can compare anything at all.
interface IEqualityComparer<in T> {
    bool Equals(T a, T b);
    int GetHashCode(T value);
}

// .NET's StringComparer is a class implementing IEqualityComparer<string> with
// a static for each way of comparing, and this is the same. There is one
// culture on this machine, so the invariant pair and the ordinal pair are the
// same comparison -- the NAMES are all four, because source says them.
class StringComparer : IEqualityComparer<string>, IComparer<string> {
    private bool fold;

    public StringComparer(bool ignoreCase) { fold = ignoreCase; }

    public static StringComparer Ordinal => new StringComparer(false);
    public static StringComparer OrdinalIgnoreCase => new StringComparer(true);
    public static StringComparer InvariantCulture => new StringComparer(false);
    public static StringComparer InvariantCultureIgnoreCase => new StringComparer(true);

    public bool Equals(string a, string b) {
        if (fold) { return String.Compare(String.ToLowerInvariant(a), String.ToLowerInvariant(b)) == 0; }
        return String.Compare(a, b) == 0;
    }

    /// .NET's StringComparer is an IComparer<string> as well as an equality
    /// comparer, which is what makes `names.OrderBy(n => n, StringComparer
    /// .Ordinal)` an ordinary line.
    public int Compare(string a, string b) {
        if (fold) { return String.Compare(String.ToLowerInvariant(a), String.ToLowerInvariant(b)); }
        return String.Compare(a, b);
    }

    // FNV-1a over the bytes, which is what makes a table of strings work at
    // all: the same characters hash the same wherever they came from.
    public int GetHashCode(string value) {
        if (!fold) {
            return (int)Sys.StringHash(value, 0, value.Length, 2166136261);
        }

        long h = 2166136261;

        for (int i = 0; i < value.Length; i++) {
            int c = Sys.GetByte(value, i);

            if (fold && c >= 65 && c <= 90) { c = c + 32; }

            h = (h ^ c) * 16777619;
        }
        return (int)h;
    }
}

// ONE ENTRY, which is what walking a dictionary hands back -- key and value
// together, because a hash table has no other order to give them in.
struct KeyValuePair<K, V> {
    private K key;
    private V value;

    public KeyValuePair(K k, V v) {
        key = k;
        value = v;
    }

    public K Key => key;
    public V Value => value;

    // WHAT MAKES `foreach ((var k, var v) in table)` WORK, and it is not a
    // special case in the compiler: deconstruction is defined as a call to a
    // method called Deconstruct with an out per name, so anything with one
    // comes apart the same way. .NET's KeyValuePair has exactly this.
    public void Deconstruct(out K k, out V v) {
        k = key;
        v = value;
    }
}

// .NET spells this Dictionary<K,V>.Enumerator. It walks the table itself
// rather than copying it out, which is why it reads the private arrays: in C#
// it is written inside the class and does exactly the same thing.
class DictionaryEnumerator<K, V> : IEnumerator<KeyValuePair<K, V>> {
    private Dictionary<K, V> over;
    private int at;
    private int slot;

    public DictionaryEnumerator(Dictionary<K, V> table) {
        over = table;
        at = -1;
    }

    public KeyValuePair<K, V> Current => new KeyValuePair<K, V>(over.keys[slot], over.values[slot]);

    public bool MoveNext() {
        at = at + 1;
        slot = over.SlotAt(at);
        while (slot == -1) {
            at = at + 1;
            slot = over.SlotAt(at);
        }
        return slot >= 0;
    }
}

// .NET's read-only view of a table, and Dictionary implements it. What it
// promises is that a caller cannot add to what it was handed.
interface IReadOnlyDictionary<K, V> : IEnumerable<KeyValuePair<K, V>> {
    int Count { get; }
    V this[K key] { get; }
    bool ContainsKey(K key);
    bool TryGetValue(K key, out V value);
}

class Dictionary<K, V> : IEnumerable<KeyValuePair<K, V>>, IReadOnlyDictionary<K, V> {
    private K[] keys;
    private V[] values;
    private int[] state;      // 0 empty, 1 used, 2 erased
    private int filled;       // used and erased together: what a probe walks past
    private int count;
    private int mask;

    // The comparer this table was given, or null for the machine word. .NET
    // spells the default Equalitynew DefaultComparer<T>() and picks it per element
    // type; a word-shaped instantiation here shares one compiled copy and
    // cannot, so a table of strings is given one -- see the task list.
    private IEqualityComparer<K>? by;

    // IN THE ORDER THINGS WENT IN, which is the order .NET's walks them in
    // while nothing has been removed, and what a program that fills a table
    // and then writes it out depends on without saying so -- this compiler's
    // own output among them. `order` lists the occupied slots oldest first,
    // with -1 where one was removed; `placeOf` is each slot's place in it.
    private int[]? order;
    private int[]? placeOf;
    private int ordered;

    private void Placed(int slot) {
        int[]? list = order;
        int[]? places = placeOf;

        if (list == null || places == null || ordered == list.Length || places.Length != mask + 1) {
            Tidy();
            list = order;
            places = placeOf;
        }

        if (list != null && places != null) {
            places[slot] = ordered;
            list[ordered] = slot;
            ordered = ordered + 1;
        }
    }

    private void Unplaced(int slot) {
        int[]? list = order;
        int[]? places = placeOf;

        if (list != null && places != null && places.Length == mask + 1) { list[places[slot]] = -1; }
    }

    // The removed ones squeezed out, and room for as many again as the table
    // can hold.
    private void Tidy() {
        int[]? old = order;
        int[] list = new int[(mask + 1) * 2];
        int[] places = new int[mask + 1];
        int kept = 0;

        if (old != null) {
            for (int n = 0; n < ordered; n++) {
                int slot = old[n];
                if (slot >= 0 && slot <= mask) {
                    places[slot] = kept;
                    list[kept] = slot;
                    kept = kept + 1;
                }
            }
        }

        order = list;
        placeOf = places;
        ordered = kept;
    }

    internal int SlotAt(int n) {
        int[]? list = order;
        if (list == null || n >= ordered) { return -2; }
        return list[n];
    }

    public Dictionary() {
        keys = new K[16];
        values = new V[16];
        state = new int[16];
        count = 0;
        mask = 15;
        by = null;
    }

    // `new Dictionary<string, Op>(StringComparer.OrdinalIgnoreCase)`, which is
    // how a table keyed by text is made to compare its keys by their text.
    /// The capacity constructor. A table that knows how many entries it will
    /// hold can be made large enough once instead of rehashing on the way up.
    /// ROUNDED UP TO A POWER OF TWO, because the probe uses a mask and not a
    /// remainder, and to three-quarters full, which is where Grow fires.
    public Dictionary(int capacity) : this() {
        int want = capacity * 4 / 3 + 1;
        int size = 16;

        while (size < want) { size = size * 2; }

        keys = new K[size];
        values = new V[size];
        state = new int[size];
        mask = size - 1;
    }

    public Dictionary(IEqualityComparer<K> comparer) {
        keys = new K[16];
        values = new V[16];
        state = new int[16];
        count = 0;
        mask = 15;
        by = comparer;
    }

    // The normal Dictionary copy constructor, including an explicit comparer.
    // The self-hosted assembler uses this to turn its relative code-label map
    // into the address-valued map for its second pass.  Starting from the
    // ordinary comparer constructor preserves the table invariants, then
    // reinserting each occupied entry makes the copy independent of the
    // source table's capacity and probe history.
    public Dictionary(Dictionary<K, V> source, IEqualityComparer<K> comparer)
        : this(comparer) {
        for (int n = 0; source.SlotAt(n) != -2; n++) {
            int i = source.SlotAt(n);
            if (i >= 0) { this[source.keys[i]] = source.values[i]; }
        }
    }

    /// A COPY OF ANOTHER TABLE, which is .NET's Dictionary(IDictionary<K,V>)
    /// and the shortest way to fork a map before changing one of the forks.
    public Dictionary(Dictionary<K, V> source) : this() {
        for (int n = 0; source.SlotAt(n) != -2; n++) {
            int i = source.SlotAt(n);
            if (i >= 0) { this[source.keys[i]] = source.values[i]; }
        }
    }

    /// The same from any sequence of pairs, which .NET added in Core 2.0 and
    /// is what a LINQ query hands back.
    public Dictionary(IEnumerable<KeyValuePair<K, V>> collection) : this() {
        foreach (KeyValuePair<K, V> pair in collection) { this[pair.Key] = pair.Value; }
    }

    public int Count => count;

    // Both of these ask the comparer when there is one, and they must agree: a
    // hash saying two keys may be equal and an equality saying they are not is
    // a table that grows duplicates.
    //
    // COPIED TO A LOCAL FIRST, which is what a C# programmer does when the
    // checker cannot see that a field is unchanged -- a field is not tracked
    // across a call, so testing one proves nothing about the read after it.
    private bool Same(K a, K b) {
        IEqualityComparer<K>? with = by;

        if (with != null) { return with.Equals(a, b); }

        // THE DEFAULT COMPARER KNOWS STRINGS, as .NET's does: a table keyed
        // by text compares the text, whoever built the keys. A word-shaped
        // instantiation cannot know its K at compile time, so it asks the
        // object -- one load of its descriptor -- and a value-typed K asks
        // nothing, because the compiler folds the question to false.
        // AN OBJECT IS ASKED, as .NET's default comparer asks it: text for a
        // string, its own Equals for anything that has one -- a tuple, a type
        // made of types. A number is the word it is.
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.Word(a) == Sys.Word(b);
    }

    private int Hash(K key) {
        IEqualityComparer<K>? with = by;

        if (with != null) {
            long mixed = with.GetHashCode(key);
            mixed = mixed ^ (mixed >> 33);
            mixed = mixed * 8127156113;
            mixed = mixed ^ (mixed >> 29);
            return (int)mixed & mask;
        }

        if (Sys.IsObject(key)) {
            long text = Sys.KeyHash(key);
            text = text ^ (text >> 33);
            text = text * 8127156113;
            text = text ^ (text >> 29);
            return (int)text & mask;
        }

        long h = Sys.Word(key);
        // A cheap avalanche. Without it, sequential integer keys collide in
        // runs and linear probing degrades to a linear scan.
        h = h ^ (h >> 33);
        h = h * 8127156113;
        h = h ^ (h >> 29);
        return (int)h & mask;
    }

    // THE INDEXER, which is how a Dictionary is read and written in C#. This
    // was Put and Get(key, fallback) -- our own spelling, and two more places
    // the compiler's own source could not compile here.
    //
    // Reading a key that is not there answers default(V) rather than throwing,
    // which is the one place this deliberately differs from .NET: there are no
    // exceptions to throw from a library this low, and a caller that cares uses
    // TryGetValue, which is what a caller that cares uses in C# anyway.
    public V this[K key] {
        get {
            int i = Hash(key);
            while (state[i] != 0) {
                if (state[i] == 1 && Same(keys[i], key)) { return values[i]; }
                i = (i + 1) & mask;
            }
            return default(V)!;
        }
        set {
            // Grow at three quarters: linear probing degrades sharply above.
            //
            // BY WHAT IS FILLED, NOT BY WHAT IS HELD: an erased slot ends no
            // probe, and a table with none empty is a search that never ends.
            if ((filled + 1) * 4 > (mask + 1) * 3) { Grow(); }

            int i = Hash(key);
            int free = -1;

            // THE WHOLE CHAIN, past the erased ones. Stopping at the first of
            // them wrote a second copy of a key that lives further along.
            while (state[i] != 0) {
                if (state[i] == 1 && Same(keys[i], key)) {
                    values[i] = value;
                    return;
                }
                if (state[i] == 2 && free < 0) { free = i; }
                i = (i + 1) & mask;
            }
            if (free >= 0) { i = free; } else { filled = filled + 1; }
            keys[i] = key;
            values[i] = value;
            state[i] = 1;
            count = count + 1;
            Placed(i);
        }
    }

    public void Add(K key, V value) { this[key] = value; }

    /// TRUE WHEN IT WENT IN, false when the key was already there and the
    /// value it had was LEFT ALONE. .NET's TryAdd, and the difference from Add
    /// is the whole of why it exists: a first-writer-wins table is one call.
    public bool TryAdd(K key, V value) {
        if (ContainsKey(key)) { return false; }
        this[key] = value;
        return true;
    }

    /// .NET's GetValueOrDefault, which says out loud what the indexer here
    /// does quietly -- and the overload with a fallback of the caller's
    /// choosing, which the indexer cannot do at all.
    public V? GetValueOrDefault(K key) {
        V found = default(V)!;
        TryGetValue(key, out found);
        return found;
    }

    public V GetValueOrDefault(K key, V fallback) {
        V found = default(V)!;
        if (TryGetValue(key, out found)) { return found; }
        return fallback;
    }

    /// A LINEAR SCAN, and it is meant to be: a hash table indexes its keys and
    /// knows nothing whatever about its values. .NET's is the same scan.
    public bool ContainsValue(V value) {
        for (int n = 0; n < ordered; n++) {
            int i = SlotAt(n);
            if (i >= 0 && (Sys.IsObject(values[i]) ? Sys.KeyEquals(values[i], value) : Sys.Word(values[i]) == Sys.Word(value))) { return true; }
        }
        return false;
    }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator() { return new DictionaryEnumerator<K, V>(this); }

    // .NET answers a KeyCollection and a ValueCollection, which are views onto
    // the table; these are lists, copied out. The difference shows only if the
    // dictionary is written to while one is being walked -- which .NET's view
    // refuses outright and this simply does not see.
    public List<K> Keys {
        get {
            List<K> found = new List<K>();
            for (int n = 0; n < ordered; n++) {
                int i = SlotAt(n);
                if (i >= 0) { found.Add(keys[i]); }
            }
            return found;
        }
    }

    public List<V> Values {
        get {
            List<V> found = new List<V>();
            for (int n = 0; n < ordered; n++) {
                int i = SlotAt(n);
                if (i >= 0) { found.Add(values[i]); }
            }
            return found;
        }
    }

    public bool ContainsKey(K key) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) { return true; }
            i = (i + 1) & mask;
        }
        return false;
    }

    // THE ONE THE COMPILER'S OWN SOURCE USES CONSTANTLY, and the reason `out`
    // had to exist before this could be written at all: one lookup answers both
    // whether the key was there and what was under it, where ContainsKey then
    // an index is two.
    public bool TryGetValue(K key, out V value) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) {
                value = values[i];
                return true;
            }
            i = (i + 1) & mask;
        }
        value = default(V)!;
        return false;
    }

    public bool Remove(K key) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) {
                // A tombstone, not an empty: erasing to empty would cut the
                // probe chain and hide everything after it.
                state[i] = 2;
                keys[i] = default(K)!;
                values[i] = default(V)!;
                count = count - 1;
                Unplaced(i);
                return true;
            }
            i = (i + 1) & mask;
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i <= mask; i++) {
            state[i] = 0;
            keys[i] = default(K)!;
            values[i] = default(V)!;
        }
        count = 0;
        filled = 0;
        ordered = 0;
    }

    private void Grow() {
        K[] oldKeys = keys;
        V[] oldValues = values;
        int[] oldState = state;
        int[]? oldOrder = order;
        int oldOrdered = ordered;
        int oldSize = mask + 1;

        // Twice the size only when it is the held ones that fill it.
        int size = (count + 1) * 2 > oldSize ? oldSize * 2 : oldSize;

        keys = new K[size];
        values = new V[size];
        state = new int[size];
        mask = size - 1;
        count = 0;
        filled = 0;
        order = null;
        placeOf = null;
        ordered = 0;

        // Put back in the order they went in, so growing changes nothing a
        // walk can see.
        for (int n = 0; oldOrder != null && n < oldOrdered; n++) {
            int i = oldOrder[n];
            if (i >= 0 && oldState[i] == 1) { this[oldKeys[i]] = oldValues[i]; }
        }
    }
}

// ---- Func and Action ------------------------------------------------------
// A function held in a variable.
//
// THERE ARE NO DELEGATE TYPES on this machine, and none are needed. A delegate
// is a thing with one method you can call, and that is an INTERFACE -- so Func
// and Action are interfaces with an Invoke, and the compiler treats `f(x)` as
// sugar for `f.Invoke(x)`. Virtual dispatch does the rest, which means a
// function value costs no machinery that classes and interfaces did not already
// need.
//
// The names and shapes are .NET's: Func answers something, Action answers
// nothing, and the last type argument of a Func is its return type. A lambda
// will be sugar for a class the compiler writes implementing one of these --
// which is exactly what C# does with a closure -- so anything written against
// them now keeps working when lambdas arrive.

// THE ZERO-ARGUMENT SHAPES, which a local function needs more often than a
// lambda does: `void Flush() { ... }` inside a method takes nothing and returns
// nothing, and that is the commonest local function there is.
//
// Not an arity of Func<A,R> with A left out -- C# spells the no-argument cases
// `Action` and `Func<R>`, and a language that spelled them anything else would
// not be C#.

interface Action {
    void Invoke();
}

interface Func<R> {
    R Invoke();
}

interface Func<A, R> {
    R Invoke(A a);
}

interface Func<A, B, R> {
    R Invoke(A a, B b);
}

interface Func<A, B, C, R> {
    R Invoke(A a, B b, C c);
}

interface Func<A, B, C, D, R> {
    R Invoke(A a, B b, C c, D d);
}

interface Func<A, B, C, D, E, R> {
    R Invoke(A a, B b, C c, D d, E e);
}

interface Func<A, B, C, D, E, F, R> {
    R Invoke(A a, B b, C c, D d, E e, F f);
}

interface Func<A, B, C, D, E, F, G, R> {
    R Invoke(A a, B b, C c, D d, E e, F f, G g);
}

interface Func<A, B, C, D, E, F, G, H, R> {
    R Invoke(A a, B b, C c, D d, E e, F f, G g, H h);
}

interface Action<A> {
    void Invoke(A a);
}

interface Action<A, B> {
    void Invoke(A a, B b);
}

interface Action<A, B, C> {
    void Invoke(A a, B b, C c);
}

interface Action<A, B, C, D> {
    void Invoke(A a, B b, C c, D d);
}

interface Action<A, B, C, D, E> {
    void Invoke(A a, B b, C c, D d, E e);
}

interface Action<A, B, C, D, E, F> {
    void Invoke(A a, B b, C c, D d, E e, F f);
}

interface Action<A, B, C, D, E, F, G> {
    void Invoke(A a, B b, C c, D d, E e, F f, G g);
}

interface Action<A, B, C, D, E, F, G, H> {
    void Invoke(A a, B b, C c, D d, E e, F f, G g, H h);
}

// A Func<A, bool> by another name, and the one a filter takes. .NET has both
// and so does this, because `Predicate<T>` says what it is for.
interface Predicate<A> {
    bool Invoke(A a);
}

// C# lock's monitor, stored in the synchronization word present in every
// object header. Acquire/release CAS makes writes inside the critical section
// visible across CSCs; Pause lets another execution context make progress
// while this one is contended.
static class Monitor {
    public static void Enter(object target) {
        long word = Sys.SyncWord(target);
        while (Sys.Cas(word, 0, 1) != 0) { Sys.Pause(); }
    }

    public static void Exit(object target) {
        Sys.AtomicSwap(Sys.SyncWord(target), 0);
    }
}

// ---- StringBuilder --------------------------------------------------------
// Text built a piece at a time, without building every intermediate string.
//
// WHY IT EXISTS AT ALL, since '+' already concatenates: a + b allocates a new
// string and copies BOTH sides into it, so building n pieces that way copies
// the whole accumulated text n times and allocates n strings on the way. This
// copies each piece once into a buffer that doubles. A compiler assembling
// diagnostics or an assembler emitting a listing does exactly that, in a loop.
//
// The API is .NET's, deliberately and to the letter -- Append, AppendLine,
// ToString, Length, Clear, and Append returning the builder so calls chain.
// Our own spelling would be a spelling every program has to be rewritten for.

// ---- Exception ------------------------------------------------------------
//
// THE BASE OF EVERYTHING THAT CAN BE THROWN, which C# has and this language did
// not: a throwable here was any class at all, so `catch (Failure f)` worked and
// `catch (Exception e)` -- the form every C# program in existence uses to mean
// "anything" -- had nothing to name.
//
// The surface is C#'s, because the rule is that ours changes to match rather
// than the other way about: Message, InnerException, and a ToString that reads
// like the real one.

class Exception
{
    string _message;
    Exception? _inner;

    /// THE CALLS THAT LED TO THE THROW, recorded by the runtime as the throw
    /// happens -- Runtime.Capture, which the compiler calls at every `throw`.
    /// Empty until then, and empty for an exception that was made but never
    /// thrown, which is what .NET answers too.
    string _trace = "";

    public Exception()
    {
        _message = "";
    }

    public Exception(string message)
    {
        _message = message;
    }

    public Exception(string message, Exception? inner)
    {
        _message = message;
        _inner = inner;
    }

    /// WHERE IT WAS THROWN: one line a frame, newest first, in .NET's own
    /// wording -- `   at Type.Method in file.cor:line N`.
    public string StackTrace => _trace;

    /// Written by the runtime at the throw and by nothing else. Named with the
    /// trailing '$' the compiler reserves, so no program can call it by
    /// accident and none can be written that does.
    public string Trace$
    {
        get { return _trace; }
        set { _trace = value; }
    }

    /// What went wrong, in words.
    ///
    /// C# invents one when the thrower did not -- "Exception of type 'X' was
    /// thrown" -- and so does this, from the actual type rather than from the
    /// one that declared the constructor. That is what GetType() is for, and it
    /// is why a derived exception says its own name here without writing any
    /// code at all.
    public string Message
    {
        get
        {
            if (_message.Length > 0)
            {
                return _message;
            }
            return String.Concat("Exception of type '",
                   String.Concat(this.GetType().Name, "' was thrown."));
        }
    }

    /// The exception this one was raised in response to, or null.
    public Exception? InnerException => _inner;

    /// THE NUMBER UNDERNEATH THE SENTENCE. .NET puts the operating system's
    /// error code here -- on Unix the errno of the call that failed -- so that
    /// a program which needs to say exactly what went wrong can ask
    /// Marshal.GetPInvokeErrorMessage for the words instead of guessing them
    /// from the type it caught. Zero when there was no such number.
    public int HResult;

    /// `Type: message`, which is C#'s shape, and then the inner one indented
    /// under it -- because an exception whose cause is not printed is half a
    /// report and the half that is missing is the half that says why.
    /// NOT `virtual`, AND IT SHOULD BE. In C# this overrides object.ToString
    /// and a derived exception replaces it.
    ///
    /// It cannot be yet: a virtual method on a class that lives in a SHARED
    /// LIBRARY faults the machine, and Exception is the first library class
    /// ever to have had one, so nothing had exercised that path. Measured --
    /// with `virtual` the machine takes a page fault in init before it reaches
    /// a login prompt; without it everything runs. See the task list.
    ///
    /// The behaviour is less costly than it looks, because the name comes from
    /// the DESCRIPTOR rather than from the declaration: this reads the actual
    /// type, so `Boom` says "Boom: ..." without overriding anything. What is
    /// missing is a derived class replacing the whole format.
    public string ToString()
    {
        string head = String.Concat(this.GetType().Name, String.Concat(": ", Message));

        // COPIED TO A LOCAL to be tested, because the checker narrows a local
        // and does not yet narrow a FIELD: `if (_inner == null) return;` proves
        // nothing to it about the line after. C# narrows both, so that is a
        // real difference and not a preference -- see the note in Binder.
        Exception? inner = _inner;

        if (inner == null)
        {
            return head;
        }
        return String.Concat(head, String.Concat("\n ---> ", inner.ToString()));
    }
}

/// THE BASE OF EVERY EXCEPTION THE RUNTIME ITSELF RAISES, and of almost every
/// one in this file. .NET's tree has it directly under Exception with the
/// framework's own failures beneath it, and only a program's own exceptions
/// (which derive from Exception, or historically from ApplicationException)
/// outside it. It carries nothing: what it is for is `catch (SystemException)`
/// and the shape of the tree.
class SystemException : Exception
{
    public SystemException() : base("System error.") { }
    public SystemException(string message) : base(message) { }
    public SystemException(string message, Exception? inner) : base(message, inner) { }
}

class TypeInitializationException : SystemException
{
    private string _typeName;
    public TypeInitializationException(string? fullTypeName, Exception? innerException)
        : base("The type initializer for '" + (fullTypeName ?? "") + "' threw an exception.", innerException)
    { _typeName = fullTypeName ?? ""; }
    public string TypeName => _typeName;
}

/// One of the arguments was not acceptable. C#'s, spelled C#'s way.
class ArgumentException : SystemException
{
    public ArgumentException() : base("Value does not fall within the expected range.") { }
    public ArgumentException(string message) : base(message) { }

    /// WHICH ARGUMENT, which .NET prints on its own line after the message and
    /// keeps in ParamName for whoever catches it.
    public ArgumentException(string message, string paramName)
        : base(String.Concat(message, String.Concat(" (Parameter '", String.Concat(paramName, "')"))))
    {
        ParamName = paramName;
    }

    public ArgumentException(string message, Exception inner) : base(message, inner) { }

    public string? ParamName { get; }
}

/// An argument's value was outside the range accepted by the method.
class ArgumentOutOfRangeException : ArgumentException
{
    public ArgumentOutOfRangeException(string name)
        : base(String.Concat("Argument out of range: ", name)) { }

    public ArgumentOutOfRangeException(string name, string message)
        : base(String.Concat(message, String.Concat(" (", String.Concat(name, ")")))) { }

    /// .NET's three-argument form, which is what a `default:` arm of a switch
    /// over an enum throws: the argument, the value it actually had, and why.
    public ArgumentOutOfRangeException(string name, object? actualValue, string? message)
        : base(String.Concat(message == null ? "Specified argument was out of the range of valid values." : message,
                             String.Concat(" (Parameter '",
                                           String.Concat(name,
                                                         String.Concat("') Actual value was ",
                                                                       String.Concat(actualValue == null ? "null" : actualValue.ToString(), "."))))))
    {
        ActualValue = actualValue;
    }

    public object? ActualValue { get; }
}

/// An argument was null and the method cannot work with that.
class ArgumentNullException : ArgumentException
{
    public ArgumentNullException(string name)
        : base(String.Concat("Value cannot be null: ", name)) { }

    /// THE GUARD AT THE TOP OF A METHOD, spelt the way .NET spells it since 6.
    ///
    /// `ArgumentNullException.ThrowIfNull(e);` rather than four lines of if.
    /// Static on the exception it throws, which reads oddly until you notice
    /// that it puts the check and the thing it raises in the same place.
    ///
    /// C# fills the name in from the caller's expression with
    /// [CallerArgumentExpression]; there is no attribute machinery here yet, so
    /// the name is passed or left out.
    public static void ThrowIfNull(object argument, string name)
    {
        if (argument == null) { throw new ArgumentNullException(name); }
    }

    public static void ThrowIfNull(object argument)
    {
        if (argument == null) { throw new ArgumentNullException("argument"); }
    }
}

/// An index was outside what the thing being indexed holds.
class IndexOutOfRangeException : SystemException
{
    public IndexOutOfRangeException(string message) : base(message) { }
}

/// The object is not in a state where that call makes sense.
class InvalidOperationException : SystemException
{
    public InvalidOperationException() : base("Operation is not valid due to the current state of the object.") { }
    public InvalidOperationException(string message) : base(message) { }
    public InvalidOperationException(string message, Exception inner) : base(message, inner) { }
}

class FormatException : SystemException
{
    public FormatException(string message) : base(message) { }
}

/// UNDER ArithmeticException, which is where .NET puts it -- with
/// DivideByZeroException and NotFiniteNumberException, its two siblings.
class OverflowException : ArithmeticException
{
    public OverflowException(string message) : base(message) { }
}

class FileNotFoundException : IOException
{
    public FileNotFoundException(string message) : base(message) { }
    public FileNotFoundException(string message, string fileName) : base(message) { }
}

/// System.UnauthorizedAccessException: the operating system refused, which on
/// Unix is EACCES, EPERM or a read-only filing system. .NET throws this rather
/// than IOException for those, and a caller that wants the exact reason reads
/// HResult.
class UnauthorizedAccessException : SystemException
{
    public UnauthorizedAccessException() : base("Access to the path is denied.") { }
    public UnauthorizedAccessException(string message) : base(message) { }
    public UnauthorizedAccessException(string message, Exception inner) : base(message, inner) { }
}

/// System.IO.DirectoryNotFoundException: a directory on the path is not
/// there. .NET throws this, not FileNotFoundException, when the directory
/// rather than the file is what is missing.
class DirectoryNotFoundException : IOException
{
    public DirectoryNotFoundException(string message) : base(message) { }
}

/// The rest of the exceptions a program catches by name. Every one of them is
/// a TYPE and nothing else -- what it carries is a message and a cause, which
/// Exception already holds -- and that is the whole point: `catch (IOException)`
/// has to name something, and a library that throws InvalidOperationException
/// where .NET throws NotSupportedException makes that catch miss.

/// The operation cannot be done on this object, ever. Distinct from
/// InvalidOperationException, which means "not just now".
class NotSupportedException : SystemException
{
    public NotSupportedException() : base("the operation is not supported") { }
    public NotSupportedException(string message) : base(message) { }
}

/// A method that exists so that something compiles and has not been written.
class NotImplementedException : SystemException
{
    public NotImplementedException() : base("the method is not implemented") { }
    public NotImplementedException(string message) : base(message) { }
}

/// The key is not in the table. .NET's indexer throws this where the one here
/// answers default(V); a caller that wants the throw writes it, and a caller
/// that wants the test uses TryGetValue.
class KeyNotFoundException : SystemException
{
    public KeyNotFoundException() : base("the given key was not present") { }
    public KeyNotFoundException(string message) : base(message) { }
}

/// Anything that went wrong at the filing system or a device, and the base of
/// every exception thrown for one: FileNotFoundException,
/// DirectoryNotFoundException, PathTooLongException, EndOfStreamException and
/// FileLoadException are all under it, as they are in .NET. That is what makes
/// `catch (IOException)` around an open catch a missing file -- the catch a
/// program actually writes, and the reason the tree is not flat.
class IOException : SystemException
{
    public IOException() : base("I/O error occurred.") { }
    public IOException(string message) : base(message) { }
    public IOException(string message, Exception inner) : base(message, inner) { }
}

/// The path, or a name in it, is longer than the filing system allows.
class PathTooLongException : IOException
{
    public PathTooLongException() : base("The specified file name or path is too long, or a component of the specified path is too long.") { }
    public PathTooLongException(string message) : base(message) { }
}

/// The file was found and could not be loaded.
class FileLoadException : IOException
{
    public FileLoadException() : base("Could not load the specified file.") { }
    public FileLoadException(string message) : base(message) { }
    public FileLoadException(string message, string fileName) : base(message) { }
}

class TimeoutException : SystemException
{
    public TimeoutException() : base("the operation timed out") { }
    public TimeoutException(string message) : base(message) { }
}

/// UNDER InvalidOperationException, which is .NET's placing and says what the
/// failure is: the call would have been fine a moment ago.
class ObjectDisposedException : InvalidOperationException
{
    string? _objectName;

    public ObjectDisposedException(string? objectName)
        : base(String.Concat("Cannot access a disposed object: ", objectName ?? "")) { _objectName = objectName; }

    public ObjectDisposedException(string? objectName, string? message)
        : base(message ?? String.Concat("Cannot access a disposed object: ", objectName ?? "")) { _objectName = objectName; }

    /// The name of the object that was used after it was disposed.
    public string ObjectName { get { return _objectName ?? ""; } }
}

class ArithmeticException : SystemException
{
    public ArithmeticException(string message) : base(message) { }
}

// ---- Random ---------------------------------------------------------------
//
// XORSHIFT, and SEEDED BY DEFAULT rather than by the clock: two runs of the
// same program with the same seed produce the same numbers, which is what
// makes a failing test reproducible. .NET's parameterless constructor picks a
// seed nobody can predict; this machine has no entropy to pick one from at the
// level this file sits at, so the default seed is a constant and a caller that
// wants unpredictability passes a clock reading in.
//
// Marsaglia's xorshift64, which is three shifts and three exclusive-ors, has a
// period of 2^64-1 and passes the tests that matter for shuffling a list or
// choosing a sample. It is NOT for keys or nonces -- see os/lib/crypto_random
// for those, and note that the difference is not a matter of degree.
class Random {
    // The .NET 5 SEEDED GENERATOR, kept digit for digit: Knuth's subtractive
    // method over a ring of 56 numbers. .NET's own Random(seed) is this, and
    // it is this rather than something better BECAUSE a seeded sequence is a
    // promise -- a test, a simulation or a game that replays from a seed must
    // get the same numbers from the same seed on any machine and any version.
    // So the constants, the 21-step scatter and the four warming passes are
    // not choices here; they are the format.
    private const int Big = 2147483647;      // int.MaxValue
    private const int Seeding = 161803398;   // Knuth's, near phi * 10^8

    private int[] ring;
    private int next;
    private int nextp;

    // The xoshiro state, for a Random nobody gave a seed.
    private ulong s0;
    private ulong s1;
    private ulong s2;
    private ulong s3;
    private bool seeded;

    private static ulong Different = 0;

    /// NO SEED MEANS UNPREDICTABLE in .NET, which takes its state from the
    /// operating system and runs xoshiro256** over it. The algorithm here is
    /// the same one; the entropy is NOT, because this file sits below anything
    /// that has any -- it is a fixed constant stirred by a counter, so two
    /// Randoms in a program differ from each other but a run does not differ
    /// from the run before. A program that needs unpredictability seeds from
    /// the clock, or asks RandomNumberGenerator, which has the real thing.
    public Random() {
        seeded = false;
        Different = Different + 1;

        ulong start = (ulong)0x9E3779B97F4A7C15 * (Different + 1);

        s0 = Mix(start + (ulong)0x9E3779B97F4A7C15);
        s1 = Mix(s0);
        s2 = Mix(s1);
        s3 = Mix(s2);
    }

    public Random(int seed) {
        seeded = true;
        ring = new int[56];

        // int.MinValue HAS NO POSITIVE, so it stands in for int.MaxValue --
        // .NET's own guard, and without it the seed would negate to itself.
        int subtraction = seed == -2147483648 ? Big : (seed < 0 ? -seed : seed);
        int mj = Seeding - subtraction;
        int mk = 1;

        ring[55] = mj;

        for (int i = 1; i < 55; i++) {
            // 21 AND 55 ARE COPRIME, so this visits every slot exactly once.
            int ii = (21 * i) % 55;

            ring[ii] = mk;
            mk = mj - mk;
            if (mk < 0) { mk = mk + Big; }
            mj = ring[ii];
        }

        for (int k = 1; k < 5; k++) {
            for (int i = 1; i < 56; i++) {
                int n = i + 30;

                if (n >= 55) { n = n - 55; }
                ring[i] = ring[i] - ring[1 + n];
                if (ring[i] < 0) { ring[i] = ring[i] + Big; }
            }
        }
        next = 0;
        nextp = 21;
    }

    private static ulong Mix(ulong z) {
        ulong x = z;

        x = (x ^ (x >> 30)) * (ulong)0xBF58476D1CE4E5B9;
        x = (x ^ (x >> 27)) * (ulong)0x94D049BB133111EB;
        return x ^ (x >> 31);
    }

    private static ulong Rotate(ulong x, int by) {
        return (x << by) | (x >> (64 - by));
    }

    /// xoshiro256**, the generator .NET uses when there is no seed: four words
    /// of state, a multiply-rotate-multiply for the output and a shift-xor for
    /// the state.
    private ulong NextState() {
        ulong result = Rotate(s1 * 5, 7) * 9;
        ulong t = s1 << 17;

        s2 = s2 ^ s0;
        s3 = s3 ^ s1;
        s1 = s1 ^ s2;
        s0 = s0 ^ s3;
        s2 = s2 ^ t;
        s3 = Rotate(s3, 45);
        return result;
    }

    /// One draw of the subtractive generator, in [0, int.MaxValue).
    private int InternalSample() {
        int locNext = next;
        int locNextp = nextp;

        locNext = locNext + 1;
        if (locNext >= 56) { locNext = 1; }

        locNextp = locNextp + 1;
        if (locNextp >= 56) { locNextp = 1; }

        int made = ring[locNext] - ring[locNextp];

        if (made == Big) { made = made - 1; }
        if (made < 0) { made = made + Big; }

        ring[locNext] = made;
        next = locNext;
        nextp = locNextp;
        return made;
    }

    /// A DOUBLE IN [0, 1), which every other member is defined in terms of --
    /// including Next(maxValue), which is why .NET's bounded numbers are what
    /// they are.
    private double Sample() {
        if (!seeded) { return (double)(NextState() >> 11) * (1.0 / 9007199254740992.0); }
        return (double)InternalSample() * (1.0 / (double)Big);
    }

    /// A NON-NEGATIVE int below int.MaxValue.
    public int Next() {
        if (!seeded) { return (int)(NextState() >> 33); }
        return InternalSample();
    }

    public int Next(int maxValue) {
        if (maxValue < 0) { throw new ArgumentOutOfRangeException("maxValue"); }
        return (int)(Sample() * (double)maxValue);
    }

    /// THE UPPER BOUND IS EXCLUSIVE and the lower is not, which is .NET's rule
    /// for every one of these and the commonest thing to get wrong.
    public int Next(int minValue, int maxValue) {
        if (minValue > maxValue) { throw new ArgumentOutOfRangeException("minValue"); }

        long range = (long)maxValue - (long)minValue;

        if (range <= (long)Big) { return (int)(Sample() * (double)range) + minValue; }
        return (int)((long)(LargeSample() * (double)range) + (long)minValue);
    }

    // A RANGE WIDER THAN AN INT needs more than one draw to fill evenly: one
    // for the magnitude and one for the sign, mapped onto [0, 1). .NET's
    // GetSampleForLargeRange, and the reason Next(int.MinValue, int.MaxValue)
    // is not simply Sample() scaled.
    private double LargeSample() {
        int result = InternalSample();
        bool negative = InternalSample() % 2 == 0;

        if (negative) { result = -result; }

        double d = (double)result;

        d = d + (double)(Big - 1);
        d = d / (2.0 * (double)Big - 1.0);
        return d;
    }

    public double NextDouble() { return Sample(); }

    public float NextSingle() { return (float)Sample(); }

    /// Sixty-three bits of a long, built from three draws because a draw is
    /// only thirty-one bits and the top one of those is never set.
    ///
    /// The three widths are .NET's, but note that this is the ONE member whose
    /// sequence has not been checked against .NET number for number: Next,
    /// Next(max), Next(min, max), NextDouble and NextBytes all reproduce it
    /// exactly from the same seed, and NextInt64 has not been confirmed.
    public long NextInt64() {
        while (true) {
            ulong made = NextUInt64() >> 1;

            if (made != (ulong)9223372036854775807) { return (long)made; }
        }
    }

    private ulong NextUInt64() {
        return ((ulong)(uint)Next(1 << 22) << 42)
             | ((ulong)(uint)Next(1 << 22) << 20)
             | (ulong)(uint)Next(1 << 20);
    }

    public void NextBytes(byte[] buffer) {
        if (buffer == null) { throw new ArgumentNullException("buffer"); }

        for (int i = 0; i < buffer.Length; i++) {
            buffer[i] = (byte)(Next() % 256);
        }
    }
}

class StringBuilder {
    private string buffer;
    private int used;

    public StringBuilder() {
        buffer = Sys.NewBytes(32);
        used = 0;
    }

    // The capacity overload is used by the assembler whenever it knows the
    // source slice it will rewrite.  It must establish the normal invariant
    // before Reserve runs; otherwise a missing constructor leaves `buffer`
    // null and the first append faults in Reserve.
    public StringBuilder(int capacity) : this() {
        if (capacity > 0) { Reserve(capacity); }
    }

    /// The text it starts with, which is .NET's commonest constructor and the
    /// one a formatter reaches for.
    public StringBuilder(string value) : this() {
        Append(value);
    }

    public StringBuilder(string value, int capacity) : this() {
        if (capacity > 0) { Reserve(capacity); }
        Append(value);
    }

    public int Length {
        get { return used; }
        set {
            if (value < 0) { throw new ArgumentOutOfRangeException("value"); }

            if (value > used) {
                Reserve(value);
                Sys.StringFill(buffer, used, 0, value - used);
            }
            used = value;
        }
    }

    public StringBuilder Append(string s) {
        int n = s.Length;
        Reserve(used + n);
        // buffer and s are distinct owned blocks. Restartable block copy
        // remains legal when the allocator supplies uncached RAM too.
        Sys.CopyNoOverlap(buffer, used, s, 0, n);
        used = used + n;
        return this;
    }

    // Format directly into the builder.  Apart from being cheaper than making
    // a temporary string, this matters to diagnostics and benchmarks whose
    // worker threads deliberately do not allocate while they hold or measure
    // machine resources.
    public StringBuilder Append(long value) {
        if (value == long.MinValue) { return Append("-9223372036854775808"); }

        if (value < 0) {
            Append('-');
            value = -value;
        }

        long scan = value;
        int digits = 1;
        while (scan >= 10) {
            scan = scan / 10;
            digits = digits + 1;
        }

        Reserve(used + digits);
        int at = used + digits - 1;
        do {
            Sys.SetByte(buffer, at, (int)(48 + value % 10));
            value = value / 10;
            at = at - 1;
        } while (value != 0);
        used = used + digits;
        return this;
    }

    public StringBuilder Append(bool value) { return Append(String.FromBool(value)); }

    // ONE CHARACTER, and it takes a char rather than an int on purpose.
    //
    // In .NET, Append(int) appends the DECIMAL TEXT of the number and
    // Append(char) appends the character -- so a char overload spelled `int`
    // silently steals every Append(5) and writes byte 5 instead of the digit.
    // That is exactly what happened here, and it is the shape of every bug this
    // library can have: our spelling differing from the one the caller expects.
    public StringBuilder Append(char c) {
        Reserve(used + 1);
        Sys.SetByte(buffer, used, (int)c);
        used = used + 1;
        return this;
    }

    public StringBuilder AppendLine(string s) { return Append(s).Append('\n'); }

    /// String.Format, appended -- which is the shape a report or a log line is
    /// built in, and saves the intermediate string.
    public StringBuilder AppendFormat(string format, params object[] args) {
        return Append(String.Format(format, args));
    }

    public StringBuilder AppendJoin(string separator, params object[] values) {
        for (int i = 0; i < values.Length; i++) {
            if (i > 0) { Append(separator); }
            Append("" + values[i]);
        }
        return this;
    }

    public StringBuilder AppendLine() { return Append('\n'); }

    // ---- the rest of what a StringBuilder does in C# ---------------------

    public StringBuilder Append(int value) { return Append((long)value); }
    public StringBuilder Append(uint value) { return Append((long)value); }
    public StringBuilder Append(short value) { return Append((long)value); }
    public StringBuilder Append(ushort value) { return Append((long)value); }
    public StringBuilder Append(sbyte value) { return Append((long)value); }
    public StringBuilder Append(byte value) { return Append((long)value); }

    public StringBuilder Append(ulong value) {
        return Append(NumberFormat.OfUnsigned(value, ""));
    }

    public StringBuilder Append(double value) { return Append(String.FromDouble(value)); }

    /// THE SAME CHARACTER, THAT MANY TIMES, which .NET has because building a
    /// rule of dashes or an indent is the commonest thing a builder does that
    /// is not appending text.
    public StringBuilder Append(char c, int count) {
        if (count <= 0) { return this; }

        Reserve(used + count);
        Sys.StringFill(buffer, used, (int)c, count);
        used = used + count;
        return this;
    }

    public StringBuilder Append(StringBuilder other) { return Append(other.ToString()); }

    /// ANYTHING AT ALL, which is .NET's Append(object?): what it says of
    /// itself, and nothing for a null. A machine word arrives boxed here, so
    /// the value's own ToString is what answers.
    public StringBuilder Append(object? value) {
        if (value == null) { return this; }

        // Joined rather than asked: a value arrives here BOXED, and joining a
        // box to a string is the one path that reads the box's descriptor and
        // renders what is inside it -- a number as a number, an enum as its
        // member's name. `value.ToString()` dispatches through the slot every
        // object shares and answers for the box.
        return Append("" + value);
    }

    /// PART of a string, which is what a scanner copying a token out of its
    /// input wants and which it should not have to allocate a Substring for.
    public StringBuilder Append(string s, int start, int count) {
        Reserve(used + count);
        Sys.CopyNoOverlap(buffer, used, s, start, count);
        used = used + count;
        return this;
    }

    /// READ AND WRITTEN BY POSITION, which is .NET's `this[int]` on a builder
    /// and the reason a builder is not just a list of strings: text already
    /// appended can be corrected without rebuilding what follows it.
    public char this[int index] {
        get {
            if (index < 0 || index >= used) {
                throw new IndexOutOfRangeException("index is outside the builder");
            }
            return (char)Sys.GetByte(buffer, index);
        }
        set {
            if (index < 0 || index >= used) {
                throw new IndexOutOfRangeException("index is outside the builder");
            }
            Sys.SetByte(buffer, index, (int)value);
        }
    }

    public StringBuilder Insert(int at, string s) {
        if (at < 0 || at > used) { throw new ArgumentOutOfRangeException("at"); }

        Reserve(used + s.Length);

        // BACKWARDS, because source and destination overlap: copying forwards
        // would smear the first character over everything it had yet to read.
        for (int i = used - 1; i >= at; i--) {
            Sys.SetByte(buffer, i + s.Length, Sys.GetByte(buffer, i));
        }
        for (int i = 0; i < s.Length; i++) {
            Sys.SetByte(buffer, at + i, Sys.GetByte(s, i));
        }
        used = used + s.Length;
        return this;
    }

    public StringBuilder Insert(int at, char c) { return Insert(at, String.FromByte((long)c)); }
    public StringBuilder Insert(int at, long value) { return Insert(at, String.FromInt(value)); }

    public StringBuilder Remove(int at, int count) {
        if (at < 0 || count < 0 || at + count > used) {
            throw new ArgumentOutOfRangeException("at");
        }

        for (int i = at + count; i < used; i++) {
            Sys.SetByte(buffer, i - count, Sys.GetByte(buffer, i));
        }
        used = used - count;
        return this;
    }

    /// EVERY OCCURRENCE, IN PLACE. Going through ToString and String.Replace
    /// would be one line and would also throw away the buffer, which is the
    /// one thing a builder exists to keep.
    public StringBuilder Replace(char what, char with) {
        for (int i = 0; i < used; i++) {
            if (Sys.GetByte(buffer, i) == (int)what) { Sys.SetByte(buffer, i, (int)with); }
        }
        return this;
    }

    public StringBuilder Replace(string what, string with) {
        string made = String.Replace(ToString(), what, with);
        used = 0;
        return Append(made);
    }

    public string ToString(int start, int count) {
        return String.Substring(buffer, start, count);
    }

    /// PART OF WHAT WAS BUILT, THROWN AWAY -- which is what assigning to
    /// Length means in .NET, and it can also grow: the new tail is nul bytes.
    public int Capacity => buffer.Length;

    // THE ONLY PLACE A STRING IS MADE. Everything above writes into the buffer,
    // and the buffer is longer than the text in it -- so this cannot hand the
    // buffer back, or the caller would get trailing rubbish and a string that
    // changes under it the next time anything is appended.
    public string ToString() { return String.Substring(buffer, 0, used); }

    /// .NET's Clear answers the builder so that it can be chained, and this
    /// one answered nothing -- `sb.Clear().Append(x)` did not compile.
    public StringBuilder Clear() {
        used = 0;
        return this;
    }

    // The .NET spelling, and useful whenever allocation must happen before a
    // timed or concurrent section rather than unpredictably inside it.
    public void EnsureCapacity(int capacity) {
        if (capacity > 0) { Reserve(capacity); }
    }

    // Doubling, so appending stays amortised constant rather than quadratic --
    // which is the entire reason to prefer this over '+' in a loop.
    private void Reserve(int want) {
        int size = buffer.Length;
        if (want <= size) { return; }

        while (size < want) { size = size * 2; }

        string bigger = Sys.NewBytes(size);
        Sys.CopyNoOverlap(bigger, 0, buffer, 0, used);
        buffer = bigger;
    }
}

// ---- HashSet --------------------------------------------------------------
// The keys of a Dictionary with no values attached, and the same open
// addressing with linear probing for the same reason: chaining needs an
// allocation per entry, and an arena freed wholesale at the end of a handler is
// the wrong place to be allocating many small nodes.
//
// A set rather than a Dictionary<T, bool> because the values array is real
// memory -- one word per slot, most of it empty -- and because Add answering
// "was it already there" is the operation that makes a set worth having: it is
// how a worklist stops going round in circles, in one lookup instead of two.
//
// .NET's API: Add returns whether it was new, Contains, Remove, Count, Clear.

// .NET spells this HashSet<T>.Enumerator; see ListEnumerator for why it is not
// written inside the class.
class HashSetEnumerator<T> : IEnumerator<T> {
    private HashSet<T> over;
    private int at;
    private int slot;

    public HashSetEnumerator(HashSet<T> set) {
        over = set;
        at = -1;
    }

    public T Current => over.items[slot];

    public bool MoveNext() {
        at = at + 1;
        slot = over.SlotAt(at);
        while (slot == -1) {
            at = at + 1;
            slot = over.SlotAt(at);
        }
        return slot >= 0;
    }
}

class HashSet<T> : IReadOnlySet<T>, IEnumerable<T> {
    private T[] items;
    private int[] state;      // 0 empty, 1 used, 2 erased
    private int count;
    private int filled;     // used and erased together: what a probe has to walk past
    private int mask;

    // IN THE ORDER THINGS WENT IN, which is the order .NET's walks them in
    // while nothing has been removed, and what a program that fills a table
    // and then writes it out depends on without saying so -- this compiler's
    // own output among them. `order` lists the occupied slots oldest first,
    // with -1 where one was removed; `placeOf` is each slot's place in it.
    private int[]? order;
    private int[]? placeOf;
    private int ordered;

    private void Placed(int slot) {
        int[]? list = order;
        int[]? places = placeOf;

        if (list == null || places == null || ordered == list.Length || places.Length != mask + 1) {
            Tidy();
            list = order;
            places = placeOf;
        }

        if (list != null && places != null) {
            places[slot] = ordered;
            list[ordered] = slot;
            ordered = ordered + 1;
        }
    }

    private void Unplaced(int slot) {
        int[]? list = order;
        int[]? places = placeOf;

        if (list != null && places != null && places.Length == mask + 1) { list[places[slot]] = -1; }
    }

    // The removed ones squeezed out, and room for as many again as the table
    // can hold.
    private void Tidy() {
        int[]? old = order;
        int[] list = new int[(mask + 1) * 2];
        int[] places = new int[mask + 1];
        int kept = 0;

        if (old != null) {
            for (int n = 0; n < ordered; n++) {
                int slot = old[n];
                if (slot >= 0 && slot <= mask) {
                    places[slot] = kept;
                    list[kept] = slot;
                    kept = kept + 1;
                }
            }
        }

        order = list;
        placeOf = places;
        ordered = kept;
    }

    internal int SlotAt(int n) {
        int[]? list = order;
        if (list == null || n >= ordered) { return -2; }
        return list[n];
    }

    public HashSet() {
        items = new T[16];
        state = new int[16];
        count = 0;
        filled = 0;
        mask = 15;
    }

    public HashSet(IEnumerable<T> source) : this() {
        foreach (T value in source) { Add(value); }
    }

    public HashSet(object comparer) : this() { }

    // The current table hashes words by identity already. Accepting the .NET
    // comparer-bearing constructor preserves the API and its intended policy;
    // richer comparer dispatch can replace Hash when value comparers arrive.
    public HashSet(IEnumerable<T> source, object comparer) : this(source) { }

    /// .NET's HashSet(IEnumerable<T>, IEqualityComparer<T>). There is one
    /// comparer here -- reference identity, which is what every set in this
    /// compiler wants -- so the comparer is taken and not consulted, as the
    /// two overloads above already do.
    public HashSet(IReadOnlyList<T> source, object comparer) : this() {
        for (int i = 0; i < source.Count; i++) { Add(source[i]); }
    }

    public int Count => count;

    private bool Same(T a, T b) {
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.Word(a) == Sys.Word(b);
    }

    // The same avalanche Dictionary uses. Without it, sequential integer keys
    // collide in runs and linear probing degrades to a linear scan.
    private int Hash(T value) {
        // The key's own hash when it is an object that has one, as .NET's
        // default comparer asks: a set of strings, or of tuples, holds equal
        // ones once.
        long h = Sys.IsObject(value) ? Sys.KeyHash(value) : Sys.Word(value);
        h = h ^ (h >> 33);
        h = h * 8127156113;
        h = h ^ (h >> 29);
        return (int)h & mask;
    }

    // TRUE WHEN IT WAS NOT THERE, which is .NET's contract and the useful half:
    // `if (!seen.Add(x)) { continue; }` is one lookup where Contains-then-Add
    // is two.
    public bool Add(T value) {
        // BY WHAT IS FILLED, NOT BY WHAT IS HELD. An erased slot ends no probe,
        // so a set that is added to and removed from for long enough has no
        // empty slot left while holding almost nothing -- and the search for
        // one never ends. The compiler's own scopes are exactly that set.
        if ((filled + 1) * 4 > (mask + 1) * 3) { Grow(); }

        int i = Hash(value);
        int free = -1;

        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) { return false; }
            // A tombstone is reusable, but only after the whole probe chain has
            // been searched -- taking it early would let the same value be
            // added twice with a copy further along the chain.
            if (state[i] == 2 && free < 0) { free = i; }
            i = (i + 1) & mask;
        }

        if (free >= 0) { i = free; } else { filled = filled + 1; }

        items[i] = value;
        state[i] = 1;
        count = count + 1;
        Placed(i);
        return true;
    }

    public bool Contains(T value) {
        int i = Hash(value);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) { return true; }
            i = (i + 1) & mask;
        }
        return false;
    }

    public IEnumerator<T> GetEnumerator() { return new HashSetEnumerator<T>(this); }

    public bool Remove(T value) {
        int i = Hash(value);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) {
                // A tombstone, not an empty: erasing to empty would cut the
                // probe chain and hide everything after it.
                state[i] = 2;
                items[i] = default(T)!;
                count = count - 1;
                Unplaced(i);
                return true;
            }
            i = (i + 1) & mask;
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i <= mask; i++) { state[i] = 0; items[i] = default(T)!; }
        count = 0;
        filled = 0;
        ordered = 0;
    }

    /// .NET's UnionWith takes an IEnumerable<T>; the HashSet overload below is
    /// the same work without the interface call per element.
    public void UnionWith(IEnumerable<T> other) {
        foreach (T each in other) { Add(each); }
    }

    public void ExceptWith(IEnumerable<T> other) {
        foreach (T each in other) { Remove(each); }
    }

    /// WHETHER THE TWO SHARE ANYTHING AT ALL, which is what .NET's Overlaps
    /// answers and is cheaper than intersecting to find out.
    public bool Overlaps(IEnumerable<T> other) {
        foreach (T each in other) {
            if (Contains(each)) { return true; }
        }
        return false;
    }

    public bool IsSubsetOf(IEnumerable<T> other) {
        HashSet<T> theirs = new HashSet<T>(other);

        foreach (T each in this) {
            if (!theirs.Contains(each)) { return false; }
        }
        return true;
    }

    public bool SetEquals(IEnumerable<T> other) {
        HashSet<T> theirs = new HashSet<T>(other);

        return Count == theirs.Count && IsSubsetOf(theirs);
    }

    public void UnionWith(HashSet<T> other) {
        foreach (T value in other) { Add(value); }
    }

    public void IntersectWith(HashSet<T> other) {
        List<T> remove = new List<T>();
        foreach (T value in this) {
            if (!other.Contains(value)) { remove.Add(value); }
        }
        foreach (T value in remove) { Remove(value); }
    }

    public void IntersectWith(IEnumerable<T> other) {
        HashSet<T> keep = new HashSet<T>(other);
        IntersectWith(keep);
    }

    public int RemoveWhere(Predicate<T> match) {
        List<T> remove = new List<T>();
        foreach (T value in this) {
            if (match(value)) { remove.Add(value); }
        }
        foreach (T value in remove) { Remove(value); }
        return remove.Count;
    }

    private void Grow() {
        T[] old = items;
        int[] oldState = state;
        int[]? oldOrder = order;
        int oldOrdered = ordered;
        int oldSize = mask + 1;

        // Twice the size only when it is the held ones that fill it; a table
        // of tombstones is rehashed where it stands.
        int size = (count + 1) * 2 > oldSize ? oldSize * 2 : oldSize;

        items = new T[size];
        state = new int[size];
        mask = size - 1;
        count = 0;
        filled = 0;

        order = null;
        placeOf = null;
        ordered = 0;

        // Tombstones do not survive a rehash, which is the other thing growth
        // is for; and what is kept goes back in the order it went in.
        for (int n = 0; oldOrder != null && n < oldOrdered; n++) {
            int i = oldOrder[n];
            if (i >= 0 && oldState[i] == 1) { Add(old[i]); }
        }
    }
}

// The ordered set surface used by the compiler's metadata writer. This small
// implementation favours a compact, deterministic iteration order over a tree:
// descriptor interface lists are short, and insertion-sort behaviour is both
// simpler and cheaper at their actual sizes.
class SortedSet<T> : IEnumerable<T> {
    private List<T> items;

    public SortedSet() { items = new List<T>(); }

    public int Count => items.Count;

    public bool Add(T value) {
        long word = Sys.Word(value);
        int at = 0;
        while (at < items.Count && Sys.Word(items[at]) < word) { at = at + 1; }
        if (at < items.Count && Sys.Word(items[at]) == word) { return false; }
        items.Insert(at, value);
        return true;
    }

    public bool Contains(T value) { return items.Contains(value); }
    public IEnumerator<T> GetEnumerator() { return new ListEnumerator<T>(items); }
}

// ---- ordering -------------------------------------------------------------
//
// THE THREE NAMES C# USES to say "which of these comes first", and they are
// three because they are asked in three places: a type says its own order with
// IComparable, a caller supplies one for somebody else's type with IComparer,
// and a sort takes a bare function with Comparison.

/// A type that knows its own order. `class Version : IComparable<Version>`.
interface IComparable<T> {
    int CompareTo(T other);
}

/// An order imposed from outside, for a type that has none or has the wrong
/// one. This is what List.Sort and Array.Sort are given.
/// `in T`, for the reason IEqualityComparer's is.
interface IComparer<in T> {
    int Compare(T a, T b);
}

/// A bare comparing function, which is .NET's `delegate int Comparison<in T>`
/// and is an interface here for the reason every delegate is -- see Func.
interface Comparison<T> {
    int Invoke(T a, T b);
}

/// THE ORDER A TYPE HAS WHEN NOBODY SUPPLIES ONE.
///
/// Text by its characters and everything else by its machine word, which is
/// the value for a number, a char or an enum and the ADDRESS for an object.
/// So sorting numbers and sorting strings do what .NET does, and sorting a
/// list of some class without a comparer sorts by where its elements happen to
/// live -- a stable answer, and not the one .NET gives.
///
/// .NET asks the element for its IComparable<T>, and this cannot yet: testing
/// `a is IComparable<T>` inside a generic faults the machine when T turns out
/// to be a value type, because the test is not folded away the way
/// Sys.IsString is. See build/repro-std-generic-is.cor. Until that lands, a
/// class with an order of its own is sorted by passing its CompareTo as the
/// comparison, which is one lambda at the call site.
class DefaultComparer<T> : IComparer<T> {
    public int Compare(T a, T b) {
        // AN OBJECT IS ASKED, through the slot every class keeps its CompareTo
        // at: text for strings, a tuple element by element, a class's own
        // order when it wrote one. Null sorts first, as .NET has it.
        if (Sys.IsObject(a) || Sys.IsObject(b)) {
            return Sys.KeyCompare(a, b);
        }

        long x = Sys.Word(a);
        long y = Sys.Word(b);

        if (x < y) { return -1; }
        if (x > y) { return 1; }
        return 0;
    }
}

/// .NET's Equalitynew DefaultComparer<T>() and new DefaultComparer<T>(), which are how
/// generic code asks for "the usual" without knowing what T is.
class Comparer<T> {
    public static IComparer<T> Default => new DefaultComparer<T>();
}

class DefaultEqualityComparer<T> : IEqualityComparer<T> {
    public bool Equals(T a, T b) {
        // AN OBJECT IS ASKED, as .NET's default comparer asks it: text for a
        // string, its own Equals for anything that has one -- a tuple, a type
        // made of types. A number is the word it is.
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.Word(a) == Sys.Word(b);
    }

    public int GetHashCode(T value) {
        if (Sys.IsObject(value)) { return Sys.KeyHash(value); }
        return (int)Sys.Word(value);
    }
}

class EqualityComparer<T> {
    public static IEqualityComparer<T> Default => new DefaultEqualityComparer<T>();
}

/// THE SORT ITSELF, in one place, over a plain array and a length.
///
/// MERGE RATHER THAN QUICK, and the reason is not speed: a merge sort is
/// STABLE, so equal elements keep the order they were given in, and a program
/// that sorts a table by one column and then another depends on that. It also
/// has no worst case to be provoked into, which matters when the thing being
/// sorted came off a network.
static class Sorting {
    public static void Sort<T>(T[] items, int from, int count, IComparer<T> by) {
        if (count < 2) { return; }

        T[] scratch = new T[count];
        Merge(items, scratch, from, count, by);
    }

    private static void Merge<T>(T[] items, T[] scratch, int from, int count, IComparer<T> by) {
        // BOTTOM UP, doubling the run length, so there is no recursion to run
        // out of stack on and no pivot to choose badly.
        int width = 1;

        while (width < count) {
            int at = 0;

            while (at < count) {
                int leftEnd = at + width;
                int rightEnd = at + width * 2;

                if (leftEnd > count) { leftEnd = count; }
                if (rightEnd > count) { rightEnd = count; }

                int i = at;
                int j = leftEnd;
                int into = at;

                while (i < leftEnd && j < rightEnd) {
                    // `<= 0` AND NOT `< 0` is what makes it stable: an element
                    // from the left run wins a tie, and the left run is the
                    // earlier one.
                    if (by.Compare(items[from + i], items[from + j]) <= 0) {
                        scratch[into] = items[from + i];
                        i = i + 1;
                    } else {
                        scratch[into] = items[from + j];
                        j = j + 1;
                    }
                    into = into + 1;
                }

                while (i < leftEnd) {
                    scratch[into] = items[from + i];
                    i = i + 1;
                    into = into + 1;
                }
                while (j < rightEnd) {
                    scratch[into] = items[from + j];
                    j = j + 1;
                    into = into + 1;
                }

                at = at + width * 2;
            }

            for (int k = 0; k < count; k++) { items[from + k] = scratch[k]; }
            width = width * 2;
        }
    }
}

/// An IComparer wrapping a bare comparing function, so Sort needs only one
/// implementation however the caller spelt the order.
class ComparisonComparer<T> : IComparer<T> {
    private Comparison<T> by;

    public ComparisonComparer(Comparison<T> comparison) { by = comparison; }

    public int Compare(T a, T b) { return by.Invoke(a, b); }
}


// ---- time, as an amount and as a moment -----------------------------------
//
// NO CLOCK IS READ HERE. DateTime.Now belongs to the system library, which is
// where the machine is; these two types are arithmetic on a number, and that
// arithmetic is the part every program does and nobody should write twice.
//
// THE UNIT IS .NET'S TICK: one ten-millionth of a second. It is not a natural
// unit for anything, and it is the right one here for exactly one reason --
// that a program moved between this machine and .NET keeps the same numbers.

/// The days of the week, numbered as .NET numbers them -- Sunday first,
/// because that is what `(int)DayOfWeek.Sunday == 0` means in every C# program
/// that indexes an array of names by it.
enum DayOfWeek {
    Sunday = 0,
    Monday = 1,
    Tuesday = 2,
    Wednesday = 3,
    Thursday = 4,
    Friday = 5,
    Saturday = 6,
}

/// AN AMOUNT OF TIME, which is not a moment: the difference between two
/// DateTimes, or how long to wait. Signed, because a difference can go either
/// way and refusing that would make subtraction an error half the time.
struct TimeSpan {
    private long ticks;

    public TimeSpan(long inTicks) { ticks = inTicks; }

    public TimeSpan(int hours, int minutes, int seconds) {
        ticks = ((long)hours * 3600 + (long)minutes * 60 + (long)seconds) * 10000000;
    }

    public TimeSpan(int days, int hours, int minutes, int seconds) {
        ticks = ((long)days * 86400 + (long)hours * 3600 + (long)minutes * 60 + (long)seconds)
              * 10000000;
    }

    public static long TicksPerMillisecond => 10000;
    public static long TicksPerSecond => 10000000;
    public static long TicksPerMinute => 600000000;
    public static long TicksPerHour => 36000000000;
    public static long TicksPerDay => 864000000000;

    public static TimeSpan Zero => new TimeSpan(0);

    public static TimeSpan FromTicks(long value) { return new TimeSpan(value); }
    public static TimeSpan FromMilliseconds(double value) {
        return new TimeSpan((long)(value * 10000.0));
    }
    public static TimeSpan FromSeconds(double value) {
        return new TimeSpan((long)(value * 10000000.0));
    }
    public static TimeSpan FromMinutes(double value) {
        return new TimeSpan((long)(value * 600000000.0));
    }
    public static TimeSpan FromHours(double value) {
        return new TimeSpan((long)(value * 36000000000.0));
    }
    public static TimeSpan FromDays(double value) {
        return new TimeSpan((long)(value * 864000000000.0));
    }

    public long Ticks => ticks;

    // THE WHOLE PART OF EACH FIELD, with the rest taken by the field below it,
    // which is what .NET's Days/Hours/Minutes mean -- an hour and a half is
    // Hours 1, Minutes 30, and TotalHours 1.5. The two are different questions
    // and this is the half people get wrong.
    public int Days => (int)(ticks / 864000000000);
    public int Hours => (int)(ticks / 36000000000 % 24);
    public int Minutes => (int)(ticks / 600000000 % 60);
    public int Seconds => (int)(ticks / 10000000 % 60);
    public int Milliseconds => (int)(ticks / 10000 % 1000);

    public double TotalDays => (double)ticks / 864000000000.0;
    public double TotalHours => (double)ticks / 36000000000.0;
    public double TotalMinutes => (double)ticks / 600000000.0;
    public double TotalSeconds => (double)ticks / 10000000.0;
    public double TotalMilliseconds => (double)ticks / 10000.0;

    public TimeSpan Add(TimeSpan other) { return new TimeSpan(ticks + other.Ticks); }
    public TimeSpan Subtract(TimeSpan other) { return new TimeSpan(ticks - other.Ticks); }
    public TimeSpan Negate() { return new TimeSpan(-ticks); }
    public TimeSpan Duration() { return new TimeSpan(ticks < 0 ? -ticks : ticks); }

    public int CompareTo(TimeSpan other) {
        if (ticks < other.Ticks) { return -1; }
        if (ticks > other.Ticks) { return 1; }
        return 0;
    }

    public bool Equals(TimeSpan other) { return ticks == other.Ticks; }

    // ---- the operators C# writes ----------------------------------------
    //
    // `a + b`, `a < b`, `a == b` on two of these, which is how every program
    // that measures time is written. Each is the static method .NET declares
    // for the operator; the compiler finds it by the name the operator has in
    // metadata, so this and a C# source file say the same thing.
    //
    // MULTIPLYING BY A NUMBER is .NET's `TimeSpan * double`, and DIVIDING one
    // span by another is a plain ratio -- "how many of these fit in that".

    public static TimeSpan operator +(TimeSpan a, TimeSpan b) { return new TimeSpan(a.Ticks + b.Ticks); }
    public static TimeSpan operator -(TimeSpan a, TimeSpan b) { return new TimeSpan(a.Ticks - b.Ticks); }
    public static TimeSpan operator *(TimeSpan a, double factor) { return new TimeSpan((long)((double)a.Ticks * factor)); }
    public static TimeSpan operator *(double factor, TimeSpan a) { return new TimeSpan((long)((double)a.Ticks * factor)); }
    public static TimeSpan operator /(TimeSpan a, double divisor) { return new TimeSpan((long)((double)a.Ticks / divisor)); }
    public static double operator /(TimeSpan a, TimeSpan b) { return (double)a.Ticks / (double)b.Ticks; }

    public static bool operator ==(TimeSpan a, TimeSpan b) { return a.Ticks == b.Ticks; }
    public static bool operator !=(TimeSpan a, TimeSpan b) { return a.Ticks != b.Ticks; }
    public static bool operator <(TimeSpan a, TimeSpan b) { return a.Ticks < b.Ticks; }
    public static bool operator >(TimeSpan a, TimeSpan b) { return a.Ticks > b.Ticks; }
    public static bool operator <=(TimeSpan a, TimeSpan b) { return a.Ticks <= b.Ticks; }
    public static bool operator >=(TimeSpan a, TimeSpan b) { return a.Ticks >= b.Ticks; }

    public static int Compare(TimeSpan a, TimeSpan b) { return a.CompareTo(b); }

    /// "[-][d.]hh:mm[:ss[.fffffff]]", which is the shape ToString writes: a
    /// span written down reads back as itself. The DAYS ARE SEPARATED BY A
    /// DOT, not a colon, which is .NET's spelling and the part that surprises.
    public static TimeSpan Parse(string text) {
        TimeSpan made = TimeSpan.Zero;

        if (!TryParse(text, out made)) {
            throw new FormatException(String.Concat("String '",
                String.Concat(text, "' was not recognized as a valid TimeSpan.")));
        }
        return made;
    }

    public static bool TryParse(string text, out TimeSpan value) {
        value = TimeSpan.Zero;
        if (text == null) { return false; }

        string rest = String.Trim(text);

        if (rest.Length == 0) { return false; }

        bool negative = Sys.GetByte(rest, 0) == (int)'-';

        if (negative || Sys.GetByte(rest, 0) == (int)'+') {
            rest = String.Substring(rest, 1, rest.Length - 1);
        }

        long days = 0;
        int colon = String.IndexOf(rest, ':');
        int dot = String.IndexOf(rest, '.');

        // A DOT BEFORE THE FIRST COLON separates the days; one after the last
        // is the fraction of a second.
        if (dot >= 0 && (colon < 0 || dot < colon)) {
            if (!Int64.TryParse(String.Substring(rest, 0, dot), out days)) { return false; }
            rest = String.Substring(rest, dot + 1, rest.Length - dot - 1);
            colon = String.IndexOf(rest, ':');
        }

        long ticks = 0;

        if (colon < 0) {
            // A bare number is a count of DAYS, which is the one shape that
            // does not look like a clock.
            long only = 0;

            if (!Int64.TryParse(rest, out only)) { return false; }
            ticks = only * 864000000000;
        } else {
            if (!DateParts.TryTime(rest, out ticks)) { return false; }
            ticks = ticks + days * 864000000000;
        }

        value = new TimeSpan(negative ? -ticks : ticks);
        return true;
    }

    /// `[-][d.]hh:mm:ss[.fffffff]`, which is .NET's constant ("c") format and
    /// its default: the day part appears only when there is one, and the
    /// fraction only when it is not zero.
    public string ToString() {
        long left = ticks < 0 ? -ticks : ticks;
        StringBuilder made = new StringBuilder();

        if (ticks < 0) { made.Append('-'); }

        long days = left / 864000000000;
        if (days != 0) {
            made.Append(days);
            made.Append('.');
        }

        made.Append(String.PadLeft(String.FromInt(left / 36000000000 % 24), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(left / 600000000 % 60), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(left / 10000000 % 60), 2, '0'));

        long fraction = left % 10000000;
        if (fraction != 0) {
            made.Append('.');
            made.Append(String.PadLeft(String.FromInt(fraction), 7, '0'));
        }
        return made.ToString();
    }
}

/// Whether a DateTime is UTC, the machine's local time, or not said --
/// .NET's three, with .NET's meanings: ToLocalTime treats Unspecified as
/// UTC, and ToUniversalTime treats it as local.
enum DateTimeKind {
    Unspecified = 0,
    Utc = 1,
    Local = 2,
}

/// A MOMENT, counted in ticks from the start of the first day of year 1 -- the
/// same epoch .NET uses, so a tick count means the same thing on both sides.
///
/// THE PROLEPTIC GREGORIAN CALENDAR throughout, which is also .NET's choice:
/// the rule about centuries is applied to years long before anybody agreed to
/// it, because a calendar that changes its rules partway is a calendar no
/// arithmetic can be done on.
partial struct DateTime {
    private long ticks;
    private DateTimeKind kind;

    public DateTime(long inTicks) { ticks = inTicks; }

    public DateTime(long inTicks, DateTimeKind inKind) { ticks = inTicks; kind = inKind; }

    public DateTime(int year, int month, int day, int hour, int minute, int second, DateTimeKind inKind) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000;
        kind = inKind;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second,
                    int millisecond, DateTimeKind inKind) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000
              + (long)millisecond * 10000;
        kind = inKind;
    }

    /// Whether this is UTC, local time, or not said.
    public DateTimeKind Kind => kind;

    /// The same reading, said to be of another kind -- no conversion.
    public static DateTime SpecifyKind(DateTime value, DateTimeKind inKind) {
        return new DateTime(value.Ticks, inKind);
    }

    public DateTime(int year, int month, int day) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second,
                    int millisecond) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000
              + (long)millisecond * 10000;
    }

    public static DateTime MinValue => new DateTime(0);

    /// The last tick of 9999-12-31, which is .NET's limit and is therefore
    /// where a program's overflow checks are expected to fire.
    public static DateTime MaxValue => new DateTime(3155378975999999999);

    /// The epoch every wire protocol counts from, expressed in this one.
    public static DateTime UnixEpoch => new DateTime(621355968000000000);

    public long Ticks => ticks;

    private long WholeDays => ticks / 864000000000;

    public int Year => DateParts.YearOf(WholeDays);
    public int Month => DateParts.MonthOf(WholeDays);
    public int Day => DateParts.DayOf(WholeDays);

    public int Hour => (int)(ticks / 36000000000 % 24);
    public int Minute => (int)(ticks / 600000000 % 60);
    public int Second => (int)(ticks / 10000000 % 60);
    public int Millisecond => (int)(ticks / 10000 % 1000);

    /// Day 0 was a Monday: 0001-01-01 in the proleptic Gregorian calendar.
    public DayOfWeek DayOfWeek => (DayOfWeek)(int)((WholeDays + 1) % 7);

    public int DayOfYear => (int)(WholeDays - DateParts.DaysFrom(Year, 1, 1) + 1);

    /// Midnight of the same day, which is what .NET's Date property answers.
    public DateTime Date => new DateTime(WholeDays * 864000000000, kind);

    public TimeSpan TimeOfDay => new TimeSpan(ticks % 864000000000);

    public DateTime AddTicks(long value) { return new DateTime(ticks + value, kind); }
    public DateTime AddMilliseconds(double value) { return AddTicks((long)(value * 10000.0)); }
    public DateTime AddSeconds(double value) { return AddTicks((long)(value * 10000000.0)); }
    public DateTime AddMinutes(double value) { return AddTicks((long)(value * 600000000.0)); }
    public DateTime AddHours(double value) { return AddTicks((long)(value * 36000000000.0)); }
    public DateTime AddDays(double value) { return AddTicks((long)(value * 864000000000.0)); }
    public DateTime Add(TimeSpan span) { return AddTicks(span.Ticks); }

    /// THE DAY IS CLAMPED TO THE MONTH IT LANDS IN, which is .NET's rule and
    /// the only one that does not produce the 31st of February: the 31st of
    /// January plus one month is the 28th or 29th.
    public DateTime AddMonths(int count) {
        int months = (Year * 12 + Month - 1) + count;
        int year = months / 12;
        int month = months % 12 + 1;
        int day = Day;
        int limit = DateTime.DaysInMonth(year, month);

        if (day > limit) { day = limit; }
        return new DateTime(year, month, day, Hour, Minute, Second, Millisecond, kind);
    }

    public DateTime AddYears(int count) { return AddMonths(count * 12); }

    public TimeSpan Subtract(DateTime other) { return new TimeSpan(ticks - other.Ticks); }
    public DateTime Subtract(TimeSpan span) { return AddTicks(-span.Ticks); }

    public int CompareTo(DateTime other) {
        if (ticks < other.Ticks) { return -1; }
        if (ticks > other.Ticks) { return 1; }
        return 0;
    }

    public bool Equals(DateTime other) { return ticks == other.Ticks; }

    // ---- the operators C# writes ----------------------------------------
    //
    // ONE DATE MINUS ANOTHER IS A LENGTH OF TIME, and a date plus a length is
    // another date: the two subtractions are different operations with
    // different result types, which is exactly why they are operators in .NET
    // rather than one Subtract.

    public static TimeSpan operator -(DateTime a, DateTime b) { return new TimeSpan(a.Ticks - b.Ticks); }
    public static DateTime operator +(DateTime a, TimeSpan span) { return new DateTime(a.Ticks + span.Ticks, a.Kind); }
    public static DateTime operator -(DateTime a, TimeSpan span) { return new DateTime(a.Ticks - span.Ticks, a.Kind); }

    public static bool operator ==(DateTime a, DateTime b) { return a.Ticks == b.Ticks; }
    public static bool operator !=(DateTime a, DateTime b) { return a.Ticks != b.Ticks; }
    public static bool operator <(DateTime a, DateTime b) { return a.Ticks < b.Ticks; }
    public static bool operator >(DateTime a, DateTime b) { return a.Ticks > b.Ticks; }
    public static bool operator <=(DateTime a, DateTime b) { return a.Ticks <= b.Ticks; }
    public static bool operator >=(DateTime a, DateTime b) { return a.Ticks >= b.Ticks; }

    public static int Compare(DateTime a, DateTime b) { return a.CompareTo(b); }

    // ---- text back into a moment -----------------------------------------
    //
    // WHAT IS ACCEPTED: the shapes this library WRITES, which is the contract
    // that matters -- a date written by ToString("o"), ToString("s"),
    // ToString("u") or ToString() reads back as the same moment. That is
    // "yyyy-MM-dd", with an optional time after a 'T' or a space, an optional
    // fraction, an optional trailing 'Z', and the invariant "MM/dd/yyyy" with
    // the same. .NET's Parse accepts a great deal more, all of it cultural.

    public static DateTime Parse(string text) {
        DateTime made = DateTime.MinValue;

        if (!TryParse(text, out made)) {
            throw new FormatException(String.Concat("The string '",
                String.Concat(text, "' was not recognized as a valid DateTime.")));
        }
        return made;
    }

    public static bool TryParse(string text, out DateTime value) {
        value = DateTime.MinValue;
        if (text == null) { return false; }

        string rest = String.Trim(text);

        if (rest.Length == 0) { return false; }

        if (Sys.GetByte(rest, rest.Length - 1) == (int)'Z') {
            rest = String.Substring(rest, 0, rest.Length - 1);
        }

        string datePart = rest;
        string timePart = "";
        int split = String.IndexOf(rest, 'T');

        if (split < 0) { split = String.IndexOf(rest, ' '); }
        if (split >= 0) {
            datePart = String.Substring(rest, 0, split);
            timePart = String.Substring(rest, split + 1, rest.Length - split - 1);
        }

        int year = 0;
        int month = 0;
        int day = 0;

        if (String.IndexOf(datePart, '-') >= 0) {
            string[] parts = String.Split(datePart, '-');

            if (parts.Length != 3) { return false; }
            if (!Int32.TryParse(parts[0], out year) || !Int32.TryParse(parts[1], out month)
                || !Int32.TryParse(parts[2], out day)) { return false; }
        } else if (String.IndexOf(datePart, '/') >= 0) {
            string[] parts = String.Split(datePart, '/');

            if (parts.Length != 3) { return false; }
            if (!Int32.TryParse(parts[0], out month) || !Int32.TryParse(parts[1], out day)
                || !Int32.TryParse(parts[2], out year)) { return false; }
        } else {
            return false;
        }

        if (month < 1 || month > 12 || day < 1 || day > DaysInMonth(year, month)) { return false; }

        long ticks = DateParts.DaysFrom(year, month, day) * 864000000000;

        if (timePart.Length > 0) {
            long inDay = 0;

            if (!DateParts.TryTime(timePart, out inDay)) { return false; }
            ticks = ticks + inDay;
        }
        value = new DateTime(ticks);
        return true;
    }

    public static bool IsLeapYear(int year) {
        return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    }

    public static int DaysInMonth(int year, int month) {
        if (month == 2) { return IsLeapYear(year) ? 29 : 28; }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    /// The INVARIANT default, which is "MM/dd/yyyy HH:mm:ss" -- .NET's own,
    /// and not a shape anybody would choose; it is here because that is what a
    /// program that prints a date without saying how gets there.
    public string ToString() { return ToString("MM/dd/yyyy HH:mm:ss"); }

    /// A CUSTOM PICTURE: yyyy, yy, MM, M, dd, d, HH, H, mm, m, ss, s, fff, and
    /// anything else copied through. .NET's standard single-letter formats
    /// ("d", "G", "o") are not here -- a single letter in a picture means the
    /// field, which is the ambiguity .NET resolves with a rule nobody
    /// remembers.
    /// A SINGLE LETTER IS A STANDARD FORMAT, not a one-letter picture, which is
    /// .NET's rule: "d" is the short date and not the day of the month. The
    /// pictures below need two characters or more, and every program that
    /// writes `ToString("yyyy-MM-dd")` is already writing one.
    ///
    /// The shapes are the INVARIANT culture's, which is the only culture this
    /// machine has.
    private static string Standard(char kind) {
        if (kind == 'd') { return "MM/dd/yyyy"; }
        if (kind == 'D') { return "dddd, dd MMMM yyyy"; }
        if (kind == 'f') { return "dddd, dd MMMM yyyy HH:mm"; }
        if (kind == 'F') { return "dddd, dd MMMM yyyy HH:mm:ss"; }
        if (kind == 'g') { return "MM/dd/yyyy HH:mm"; }
        if (kind == 'G') { return "MM/dd/yyyy HH:mm:ss"; }
        if (kind == 'm' || kind == 'M') { return "MMMM dd"; }
        if (kind == 'o' || kind == 'O') { return "yyyy-MM-ddTHH:mm:ss.fffffff"; }
        if (kind == 'r' || kind == 'R') { return "ddd, dd MMM yyyy HH:mm:ss 'GMT'"; }
        if (kind == 's') { return "yyyy-MM-ddTHH:mm:ss"; }
        if (kind == 't') { return "HH:mm"; }
        if (kind == 'T') { return "HH:mm:ss"; }
        // LOCAL TIME IS UTC on this machine, so "u" and "U" are the same
        // moment written two ways rather than two moments.
        if (kind == 'u') { return "yyyy-MM-dd HH:mm:ssZ"; }
        if (kind == 'U') { return "dddd, dd MMMM yyyy HH:mm:ss"; }
        if (kind == 'y' || kind == 'Y') { return "yyyy MMMM"; }
        throw new FormatException("Input string was not in a correct format.");
    }

    public string ToString(string format) {
        if (format.Length == 1) { return ToString(Standard((char)Sys.GetByte(format, 0))); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < format.Length) {
            char c = (char)Sys.GetByte(format, at);

            // QUOTED TEXT IS ITSELF, letters and all, which is how "GMT" gets
            // into the R format without its M becoming a month. .NET's escape,
            // and the single quote is the one that does it.
            if (c == '\'') {
                int close = String.IndexOf(format, '\'', at + 1);
                int end = close < 0 ? format.Length : close;

                made.Append(String.Substring(format, at + 1, end - at - 1));
                at = end + 1;
                continue;
            }

            if (c == '\\' && at + 1 < format.Length) {
                made.Append((char)Sys.GetByte(format, at + 1));
                at = at + 2;
                continue;
            }

            int run = 1;

            while (at + run < format.Length && Sys.GetByte(format, at + run) == (int)c) {
                run = run + 1;
            }

            if (c == 'y') { made.Append(Field(run >= 4 ? Year : Year % 100, run)); }
            else if (c == 'M' && run >= 4) { made.Append(DateParts.MonthName(Month)); }
            else if (c == 'M' && run == 3) { made.Append(String.Substring(DateParts.MonthName(Month), 0, 3)); }
            else if (c == 'M') { made.Append(Field(Month, run)); }
            else if (c == 'd' && run >= 4) { made.Append(DateParts.DayName((int)DayOfWeek)); }
            else if (c == 'd' && run == 3) { made.Append(String.Substring(DateParts.DayName((int)DayOfWeek), 0, 3)); }
            else if (c == 'd') { made.Append(Field(Day, run)); }
            else if (c == 'h') { made.Append(Field(Hour % 12 == 0 ? 12 : Hour % 12, run)); }
            else if (c == 't' && run >= 2) { made.Append(Hour < 12 ? "AM" : "PM"); }
            else if (c == 't') { made.Append(Hour < 12 ? "A" : "P"); }
            else if (c == 'H') { made.Append(Field(Hour, run)); }
            else if (c == 'm') { made.Append(Field(Minute, run)); }
            else if (c == 's') { made.Append(Field(Second, run)); }
            else if (c == 'f') {
                // A RUN OF f's IS A FRACTION OF A SECOND, as many digits as
                // there are letters: "fff" is milliseconds and "fffffff" is
                // the whole tick, which is what "o" prints.
                long fraction = ticks % 10000000;
                string digits = String.PadLeft(String.FromInt(fraction), 7, '0');

                made.Append(String.Substring(digits, 0, run > 7 ? 7 : run));
            }
            else { made.Append(c, run); }

            at = at + run;
        }
        return made.ToString();
    }

    private static string Field(int value, int width) {
        return String.PadLeft(String.FromInt(value), width, '0');
    }
}

/// THE CALENDAR ARITHMETIC, in one place, because converting a day number to a
/// year and back is the part that is easy to get subtly wrong and impossible
/// to notice: an off-by-one in a leap year shows up once every four years.
///
/// The algorithm is Howard Hinnant's days-from-civil and its inverse. It shifts
/// the year so that it begins in March, which puts the leap day at the END of
/// the year -- and that one change removes every special case from what is
/// otherwise a thicket of them.
/// A MOMENT AND THE OFFSET IT WAS WRITTEN IN. A DateTime says what the clock
/// read; a DateTimeOffset says that AND how far that clock was from UTC, which
/// is the difference between "half past one" and a point in time. Anything
/// that stores or transmits a timestamp wants this one.
///
/// Ticks is the LOCAL reading and UtcTicks is the moment: subtracting the
/// offset is what turns one into the other, and .NET's members are named so
/// that a caller has to say which they meant.
partial struct DateTimeOffset {
    private long ticks;    // the local reading
    private long offset;   // ticks east of UTC

    public DateTimeOffset(DateTime when, TimeSpan from) {
        ticks = when.Ticks;
        offset = from.Ticks;
    }

    public DateTimeOffset(long inTicks, TimeSpan from) {
        ticks = inTicks;
        offset = from.Ticks;
    }

    // UtcNow and Now ARE NOT HERE. They read a clock, and a clock is the
    // platform's: DateTime's are in lib/io.cor, next to the Os call they
    // make, and DateTimeOffset's are beside them for the same reason. A
    // freestanding build -- the kernel -- has this file and not that one.

    public static DateTimeOffset MinValue => new DateTimeOffset(DateTime.MinValue, TimeSpan.Zero);
    public static DateTimeOffset MaxValue => new DateTimeOffset(DateTime.MaxValue, TimeSpan.Zero);
    public static DateTimeOffset UnixEpoch => new DateTimeOffset(DateTime.UnixEpoch, TimeSpan.Zero);

    public TimeSpan Offset => new TimeSpan(offset);

    /// THE CLOCK READING, with no offset attached -- which is what .NET's
    /// DateTime property gives and why it is not the same instant as
    /// UtcDateTime unless the offset is zero.
    public DateTime DateTime => new DateTime(ticks);

    public DateTime UtcDateTime => new DateTime(ticks - offset, DateTimeKind.Utc);

    public long Ticks => ticks;
    public long UtcTicks => ticks - offset;

    public int Year => DateTime.Year;
    public int Month => DateTime.Month;
    public int Day => DateTime.Day;
    public int Hour => DateTime.Hour;
    public int Minute => DateTime.Minute;
    public int Second => DateTime.Second;
    public int Millisecond => DateTime.Millisecond;
    public DayOfWeek DayOfWeek => DateTime.DayOfWeek;
    public int DayOfYear => DateTime.DayOfYear;
    /// A DateTime, not a DateOnly -- .NET's DateTimeOffset.Date is midnight of
    /// the day as a DateTime, which is also what keeps this file free of
    /// anything declared outside it.
    public DateTime Date => DateTime.Date;
    public TimeSpan TimeOfDay => DateTime.TimeOfDay;

    /// SECONDS SINCE 1970, which is what every wire protocol counts in. The
    /// UTC moment, not the local reading -- the whole point of the type.
    public long ToUnixTimeSeconds() { return (UtcTicks - 621355968000000000) / 10000000; }
    public long ToUnixTimeMilliseconds() { return (UtcTicks - 621355968000000000) / 10000; }

    public static DateTimeOffset FromUnixTimeSeconds(long seconds) {
        return new DateTimeOffset(new DateTime(621355968000000000 + seconds * 10000000), TimeSpan.Zero);
    }

    public static DateTimeOffset FromUnixTimeMilliseconds(long milliseconds) {
        return new DateTimeOffset(new DateTime(621355968000000000 + milliseconds * 10000), TimeSpan.Zero);
    }

    public DateTimeOffset AddTicks(long value) { return new DateTimeOffset(ticks + value, Offset); }
    public DateTimeOffset Add(TimeSpan span) { return AddTicks(span.Ticks); }
    public DateTimeOffset AddSeconds(double value) { return AddTicks((long)(value * 10000000.0)); }
    public DateTimeOffset AddMinutes(double value) { return AddTicks((long)(value * 600000000.0)); }
    public DateTimeOffset AddHours(double value) { return AddTicks((long)(value * 36000000000.0)); }
    public DateTimeOffset AddDays(double value) { return AddTicks((long)(value * 864000000000.0)); }
    public DateTimeOffset AddMonths(int count) { return new DateTimeOffset(DateTime.AddMonths(count), Offset); }
    public DateTimeOffset AddYears(int count) { return new DateTimeOffset(DateTime.AddYears(count), Offset); }

    /// COMPARED AS INSTANTS, which is what makes two readings of different
    /// clocks comparable at all: the same moment written in two offsets is
    /// equal here and would not be as DateTimes.
    public int CompareTo(DateTimeOffset other) {
        if (UtcTicks < other.UtcTicks) { return -1; }
        if (UtcTicks > other.UtcTicks) { return 1; }
        return 0;
    }

    public bool Equals(DateTimeOffset other) { return UtcTicks == other.UtcTicks; }

    public static TimeSpan operator -(DateTimeOffset a, DateTimeOffset b) {
        return new TimeSpan(a.UtcTicks - b.UtcTicks);
    }

    public static DateTimeOffset operator +(DateTimeOffset a, TimeSpan span) { return a.Add(span); }
    public static DateTimeOffset operator -(DateTimeOffset a, TimeSpan span) { return a.AddTicks(-span.Ticks); }

    public static bool operator ==(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks == b.UtcTicks; }
    public static bool operator !=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks != b.UtcTicks; }
    public static bool operator <(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks < b.UtcTicks; }
    public static bool operator >(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks > b.UtcTicks; }
    public static bool operator <=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks <= b.UtcTicks; }
    public static bool operator >=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks >= b.UtcTicks; }

    /// "MM/dd/yyyy HH:mm:ss zzz", which is what .NET prints for one with no
    /// format asked for -- the offset is part of the value and so part of the
    /// text.
    public string ToString() { return String.Concat(DateTime.ToString("MM/dd/yyyy HH:mm:ss "), Zone()); }

    public string ToString(string format) {
        if (format.Length == 1 && ((char)Sys.GetByte(format, 0) == 'o' || (char)Sys.GetByte(format, 0) == 'O')) {
            return String.Concat(DateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffffff"), Zone());
        }
        return DateTime.ToString(format);
    }

    /// The offset as +hh:mm or -hh:mm, which is the "zzz" of a picture.
    private string Zone() {
        long size = offset < 0 ? -offset : offset;
        StringBuilder made = new StringBuilder();

        made.Append(offset < 0 ? '-' : '+');
        made.Append(String.PadLeft(String.FromInt(size / 36000000000), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(size / 600000000 % 60), 2, '0'));
        return made.ToString();
    }
}

static class DateParts {
    /// THE INVARIANT CULTURE'S NAMES, which are the English ones -- and the
    /// only ones this machine has. .NET spells them in DateTimeFormatInfo; a
    /// program asking a date to write itself as "dddd" arrives here.
    public static string MonthName(int month) {
        if (month == 1) { return "January"; }
        if (month == 2) { return "February"; }
        if (month == 3) { return "March"; }
        if (month == 4) { return "April"; }
        if (month == 5) { return "May"; }
        if (month == 6) { return "June"; }
        if (month == 7) { return "July"; }
        if (month == 8) { return "August"; }
        if (month == 9) { return "September"; }
        if (month == 10) { return "October"; }
        if (month == 11) { return "November"; }
        return "December";
    }

    /// "HH:mm", "HH:mm:ss" or "HH:mm:ss.fffffff", as ticks into the day.
    public static bool TryTime(string text, out long ticks) {
        ticks = 0;

        string rest = text;
        long fraction = 0;
        int dot = String.IndexOf(rest, '.');

        if (dot >= 0) {
            string digits = String.Substring(rest, dot + 1, rest.Length - dot - 1);

            rest = String.Substring(rest, 0, dot);

            if (digits.Length > 7) { digits = String.Substring(digits, 0, 7); }

            long scaled = 0;

            if (!Int64.TryParse(digits, out scaled)) { return false; }
            for (int i = digits.Length; i < 7; i++) { scaled = scaled * 10; }
            fraction = scaled;
        }

        string[] parts = String.Split(rest, ':');

        if (parts.Length < 2 || parts.Length > 3) { return false; }

        int hour = 0;
        int minute = 0;
        int second = 0;

        if (!Int32.TryParse(parts[0], out hour) || !Int32.TryParse(parts[1], out minute)) { return false; }
        if (parts.Length == 3 && !Int32.TryParse(parts[2], out second)) { return false; }
        if (hour > 23 || minute > 59 || second > 59) { return false; }

        ticks = ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000 + fraction;
        return true;
    }

    public static string DayName(int day) {
        if (day == 0) { return "Sunday"; }
        if (day == 1) { return "Monday"; }
        if (day == 2) { return "Tuesday"; }
        if (day == 3) { return "Wednesday"; }
        if (day == 4) { return "Thursday"; }
        if (day == 5) { return "Friday"; }
        return "Saturday";
    }

    /// Days from 0001-01-01, which is day 0.
    public static long DaysFrom(int year, int month, int day) {
        long y = year;
        long m = month;

        // March-based year: January and February belong to the year before.
        y = m <= 2 ? y - 1 : y;

        long era = (y >= 0 ? y : y - 399) / 400;
        long yearOfEra = y - era * 400;                       // [0, 399]
        long dayOfYear = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + day - 1;
        long dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;

        // 719162 days from 0001-01-01 to 1970-01-01, and 719468 from the
        // algorithm's own epoch of 0000-03-01 to it: the difference is the
        // offset from that epoch to this one.
        return era * 146097 + dayOfEra - 306;
    }

    private static long Civil(long days, out long month, out long day) {
        long z = days + 306;
        long era = (z >= 0 ? z : z - 146096) / 146097;
        long dayOfEra = z - era * 146097;                     // [0, 146096]
        long yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;
        long y = yearOfEra + era * 400;
        long dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
        long mp = (5 * dayOfYear + 2) / 153;                  // [0, 11], March is 0

        day = dayOfYear - (153 * mp + 2) / 5 + 1;
        month = mp + (mp < 10 ? 3 : -9);
        return month <= 2 ? y + 1 : y;
    }

    public static int YearOf(long days) {
        long month = 0;
        long day = 0;
        return (int)Civil(days, out month, out day);
    }

    public static int MonthOf(long days) {
        long month = 0;
        long day = 0;
        Civil(days, out month, out day);
        return (int)month;
    }

    public static int DayOf(long days) {
        long month = 0;
        long day = 0;
        Civil(days, out month, out day);
        return (int)day;
    }
}

// ---- Maths ----------------------------------------------------------------
// Sqrt, Abs, Floor, Ceil, Round, Trunc, Min, Max and Fma are instructions.
// Everything below is written HERE, in software, deliberately: a hardware
// transcendental differs between implementations, and two machines disagreeing
// about the cosine of the same angle is a bug nobody can find. These are the
// same on every machine because they are the same code.

/// WHICH WAY A HALF GOES. .NET's enum, with .NET's numbers, because a program
/// that says MidpointRounding.AwayFromZero is naming the value 1 and the two
/// sides have to agree on which that is.
enum MidpointRounding {
    ToEven = 0,
    AwayFromZero = 1,
    ToZero = 2,
    ToNegativeInfinity = 3,
    ToPositiveInfinity = 4,
}

static class Math {
    public static int Min(int a, int b) { if (a < b) { return a; } return b; }
    public static int Max(int a, int b) { if (a > b) { return a; } return b; }
    public static long Min(long a, long b) { if (a < b) { return a; } return b; }
    public static long Max(long a, long b) { if (a > b) { return a; } return b; }

    /// THE UNSIGNED PAIRS, which .NET has and which are not the signed ones
    /// with a cast: 0x80000000 is bigger than 1 as a uint and smaller as an
    /// int, so an alignment compared through the signed overload picks the
    /// wrong one.
    public static uint Min(uint a, uint b) { if (a < b) { return a; } return b; }
    public static uint Max(uint a, uint b) { if (a > b) { return a; } return b; }
    public static ulong Min(ulong a, ulong b) { if (a < b) { return a; } return b; }
    public static ulong Max(ulong a, ulong b) { if (a > b) { return a; } return b; }
    public static nint Min(nint a, nint b) { if (a < b) { return a; } return b; }
    public static nint Max(nint a, nint b) { if (a > b) { return a; } return b; }
    public static nuint Min(nuint a, nuint b) { if (a < b) { return a; } return b; }
    public static nuint Max(nuint a, nuint b) { if (a > b) { return a; } return b; }
    public static double Pi() { return 3.14159265358979323846; }
    public static double Tau() { return 6.28318530717958647692; }

    /// AN INT, not a double: .NET's Math.Sign answers -1, 0 or 1 whatever the
    /// argument's type, because what it reports is a direction and not a
    /// magnitude.
    public static int Sign(double x) {
        if (x > 0.0) { return 1; }
        if (x < 0.0) { return -1; }
        return 0;
    }

    public static int Sign(float x) { return Sign((double)x); }

    public static double Clamp(double x, double low, double high) {
        return Math.Min(Math.Max(x, low), high);
    }

    public static double Lerp(double a, double b, double t) {
        return Math.Fma(b - a, t, a);
    }

    // Wraps an angle into [-pi, pi], where the polynomials below are accurate.
    public static double WrapAngle(double x) {
        double turns = Math.Floor((x + Pi()) / Tau());
        return x - turns * Tau();
    }

    // Minimax-style polynomial on the reduced range. Seven terms of the Taylor
    // series is well past double precision for |x| <= pi.
    public static double Sin(double x) {
        double a = WrapAngle(x);
        double sq = a * a;
        double term = a;
        double sum = a;

        term = 0.0 - term * sq / 6.0;             sum = sum + term;
        term = 0.0 - term * sq / 20.0;            sum = sum + term;
        term = 0.0 - term * sq / 42.0;            sum = sum + term;
        term = 0.0 - term * sq / 72.0;            sum = sum + term;
        term = 0.0 - term * sq / 110.0;           sum = sum + term;
        term = 0.0 - term * sq / 156.0;           sum = sum + term;
        return sum;
    }

    public static double Cos(double x) { return Sin(x + Pi() / 2.0); }

    public static double Tan(double x) { return Sin(x) / Cos(x); }

    public static double Pow(double x, int n) {
        // Exponentiation by squaring: log(n) multiplies instead of n.
        double result = 1.0;
        double baseValue = x;
        int e = n;

        if (e < 0) { e = 0 - e; }

        while (e > 0) {
            if ((e & 1) == 1) { result = result * baseValue; }
            baseValue = baseValue * baseValue;
            e = e >> 1;
        }

        if (n < 0) { return 1.0 / result; }
        return result;
    }

    /// e TO A POWER, by splitting the exponent into a whole number of halvings
    /// and a remainder the series can reach.
    ///
    /// The series alone is only accurate near zero: seventeen terms of it are
    /// nothing like enough for exp(20), and the answer silently loses digits.
    /// Writing x as k*ln2 + r, with |r| below half a ln2, makes the series job
    /// easy and leaves a power of two to multiply by -- which is exact.
    public static double Exp(double x) {
        if (x != x) { return x; }

        double ln2 = 0.69314718055994530942;
        double k = Math.Round(x / ln2);
        double r = x - k * ln2;

        double sum = 1.0;
        double term = 1.0;

        for (int i = 1; i < 18; i++) {
            term = term * r / (double)i;
            sum = sum + term;
        }
        return sum * Pow(2.0, (int)k);
    }

    public static long AbsInt(long x) {
        if (x < 0) { return 0 - x; }
        return x;
    }

    public static long MinInt(long a, long b) { if (a < b) { return a; } return b; }
    public static long MaxInt(long a, long b) { if (a > b) { return a; } return b; }
    public static long ClampInt(long x, long low, long high) { return MinInt(MaxInt(x, low), high); }

    // ---- the names .NET uses --------------------------------------------
    //
    // The machine's rounding instructions are called Ceil and Trunc and the
    // library's absolute value for integers was called AbsInt, so a C# program
    // saying Math.Ceiling or Math.Abs found nothing. These are the same
    // operations under the names a caller writes.

    public static double Ceiling(double x) { return Math.Ceil(x); }
    public static double Truncate(double x) { return Math.Trunc(x); }

    public static int Abs(int x) { if (x < 0) { return -x; } return x; }
    public static long Abs(long x) { if (x < 0) { return -x; } return x; }

    public static int Sign(int x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Sign(long x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Clamp(int x, int low, int high) { return Min(Max(x, low), high); }
    public static long Clamp(long x, long low, long high) { return Min(Max(x, low), high); }

    // TO THE EVEN NEIGHBOUR AT A HALF, which is .NET's DEFAULT and the half
    // everybody gets wrong: Math.Round(2.5) is 2 and Math.Round(3.5) is 4. The
    // rule exists because always rounding a half upwards biases a long column
    // of figures upwards, and banking noticed. The other rules are asked for
    // by name, with MidpointRounding.
    public static double Round(double x, int digits) {
        return Round(x, digits, MidpointRounding.ToEven);
    }

    public static double Round(double x, MidpointRounding mode) {
        return Round(x, 0, mode);
    }

    public static double Round(double x, int digits, MidpointRounding mode) {
        double scale = 1.0;
        for (int i = 0; i < digits; i++) { scale = scale * 10.0; }

        double scaled = x * scale;
        double whole = 0.0;

        if (mode == MidpointRounding.AwayFromZero) {
            whole = scaled < 0.0 ? Math.Ceil(scaled - 0.5) : Math.Floor(scaled + 0.5);
        } else if (mode == MidpointRounding.ToZero) {
            whole = Math.Trunc(scaled);
        } else if (mode == MidpointRounding.ToNegativeInfinity) {
            whole = Math.Floor(scaled);
        } else if (mode == MidpointRounding.ToPositiveInfinity) {
            whole = Math.Ceil(scaled);
        } else {
            whole = Math.Round(scaled);
        }
        return whole / scale;
    }

    /// x to a real power, which the integer overload above cannot do: the
    /// squaring trick needs a whole number of multiplications.
    public static double Pow(double x, double y) {
        if (y == 0.0) { return 1.0; }
        if (x == 0.0) { return 0.0; }
        return Exp(y * Log(x));
    }

    /// THE NATURAL LOGARITHM, by the series that converges everywhere rather
    /// than the one that only converges near 1.
    ///
    /// The argument is first split into a power of two and a remainder in
    /// [1, 2), because the series in (x-1)/(x+1) converges quickly only on a
    /// narrow range and a number can be any size at all.
    public static double Log(double x) {
        if (x <= 0.0) { return 0.0 / 0.0; }

        int power = 0;
        double v = x;

        while (v >= 2.0) {
            v = v / 2.0;
            power = power + 1;
        }
        while (v < 1.0) {
            v = v * 2.0;
            power = power - 1;
        }

        // atanh's series: 2 * sum of z^(2k+1)/(2k+1), with z = (v-1)/(v+1),
        // which is at most 1/3 over [1, 2) and so needs few terms.
        double z = (v - 1.0) / (v + 1.0);
        double sq = z * z;
        double term = z;
        double sum = z;

        for (int k = 1; k < 20; k++) {
            term = term * sq;
            sum = sum + term / (double)(2 * k + 1);
        }
        return 2.0 * sum + (double)power * 0.69314718055994530942;
    }

    public static double Log10(double x) { return Log(x) / 2.30258509299404568402; }
    public static double Log2(double x) { return Log(x) / 0.69314718055994530942; }
    public static double Log(double x, double newBase) { return Log(x) / Log(newBase); }

    // ---- the rest of System.Math -----------------------------------------
    //
    // Software, because the 486 this targets may have no floating-point unit
    // at all and the ones it does have stop at square root. Each is the
    // identity a table of logarithms was built on, which is what makes them
    // short: the hard part is always the range reduction, never the series.

    /// THE WHOLE QUOTIENT AND WHAT IS LEFT, in one division. A processor
    /// computes both at once and .NET exposes that; two separate operations is
    /// twice the work for the same answer.
    public static int DivRem(int a, int b, out int remainder) {
        int whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    public static long DivRem(long a, long b, out long remainder) {
        long whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    /// The FULL product of two ints, which does not fit in an int: multiplying
    /// two numbers near a billion is the commonest overflow there is.
    public static long BigMul(int a, int b) { return (long)a * (long)b; }

    public static double Cbrt(double x) {
        if (x == 0.0) { return 0.0; }

        bool negative = x < 0.0;
        double size = negative ? -x : x;
        double guess = Exp(Log(size) / 3.0);

        // Two steps of Newton on g^3 = size, which cleans up whatever the
        // logarithm and the exponential lost between them.
        guess = guess - (guess * guess * guess - size) / (3.0 * guess * guess);
        guess = guess - (guess * guess * guess - size) / (3.0 * guess * guess);
        return negative ? -guess : guess;
    }

    /// ARCTANGENT, on a range the series can actually reach.
    ///
    /// The series in x converges everywhere below 1 and hopelessly slowly near
    /// it, so the argument is folded twice: anything above 1 by the reciprocal
    /// identity, and anything above tan(pi/8) by the half-angle one. What is
    /// left is under 0.415, where thirty terms is past double precision.
    public static double Atan(double x) {
        if (x != x) { return x; }

        bool negative = x < 0.0;
        double size = negative ? -x : x;
        double made = 0.0;

        if (size > 1.0) {
            made = Pi() / 2.0 - AtanSmall(1.0 / size);
        } else {
            made = AtanSmall(size);
        }
        return negative ? -made : made;
    }

    private static double AtanSmall(double x) {
        if (x > 0.41421356237309504880) {
            return Pi() / 4.0 + AtanSeries((x - 1.0) / (x + 1.0));
        }
        return AtanSeries(x);
    }

    private static double AtanSeries(double x) {
        double sq = x * x;
        double term = x;
        double sum = x;

        for (int k = 1; k < 30; k++) {
            term = -term * sq;
            sum = sum + term / (double)(2 * k + 1);
        }
        return sum;
    }

    /// THE ANGLE OF A POINT, quadrant and all, which is why it takes the two
    /// coordinates rather than their ratio: y/x has thrown away the difference
    /// between the first quadrant and the third. .NET's answer is in
    /// (-pi, pi].
    public static double Atan2(double y, double x) {
        if (x > 0.0) { return Atan(y / x); }
        if (x < 0.0) { return y >= 0.0 ? Atan(y / x) + Pi() : Atan(y / x) - Pi(); }
        if (y > 0.0) { return Pi() / 2.0; }
        if (y < 0.0) { return 0.0 - Pi() / 2.0; }
        return 0.0;
    }

    /// OUTSIDE [-1, 1] IS NOT AN ANGLE, and .NET answers NaN rather than
    /// throwing -- the caller's arithmetic went wrong, not the call.
    public static double Asin(double x) {
        if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
        if (x == 1.0) { return Pi() / 2.0; }
        if (x == -1.0) { return 0.0 - Pi() / 2.0; }
        return Atan(x / Sqrt(1.0 - x * x));
    }

    public static double Acos(double x) {
        if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
        return Pi() / 2.0 - Asin(x);
    }

    public static double Sinh(double x) {
        double up = Exp(x);

        return (up - 1.0 / up) / 2.0;
    }

    public static double Cosh(double x) {
        double up = Exp(x);

        return (up + 1.0 / up) / 2.0;
    }

    /// Through exp(2x) rather than as sinh over cosh: the two exponentials of
    /// the obvious form both overflow long before their ratio does.
    public static double Tanh(double x) {
        if (x > 20.0) { return 1.0; }
        if (x < -20.0) { return -1.0; }

        double both = Exp(2.0 * x);

        return (both - 1.0) / (both + 1.0);
    }

    /// THE IEEE REMAINDER, which is NOT the `%` operator: it takes the NEAREST
    /// multiple rather than the one towards zero, so its result can be
    /// negative where x is positive. Anything reducing an angle wants this one.
    public static double IEEERemainder(double x, double y) {
        double quotient = Math.Round(x / y);

        return x - y * quotient;
    }

    /// The magnitude of the first with the sign of the second, which is the
    /// only way to move a sign about that does not go wrong at zero.
    public static double CopySign(double x, double y) {
        double size = x < 0.0 ? -x : x;

        return y < 0.0 ? -size : size;
    }

    /// THE ONE FURTHER FROM ZERO, sign kept -- not the larger. MaxMagnitude(-5,
    /// 3) is -5, which is what makes it useful for scaling and surprising for
    /// everything else.
    public static double MaxMagnitude(double x, double y) {
        double a = x < 0.0 ? -x : x;
        double b = y < 0.0 ? -y : y;

        if (a > b) { return x; }
        if (b > a) { return y; }
        return x > y ? x : y;
    }

    public static double MinMagnitude(double x, double y) {
        double a = x < 0.0 ? -x : x;
        double b = y < 0.0 ? -y : y;

        if (a < b) { return x; }
        if (b < a) { return y; }
        return x < y ? x : y;
    }

    // .NET spells its two constants as fields. The methods above were the only
    // way to say them here, and `Math.PI` is what a program writes. There is no
    // `Tau` field because `Tau()` above is a method of that name already, and
    // renaming it would break what calls it.
    public static double PI => 3.14159265358979323846;
    public static double E => 2.71828182845904523536;
}
