        return true;
    }
    public static bool EndsWith<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> value) {
        int at = span.Length - value.Length;
        if (at < 0) { return false; }
        for (int i = 0; i < value.Length; i++) { if (!Same(span[at + i], value[i])) { return false; } }
        return true;
    }
    public static int IndexOf<T>(this ReadOnlySpan<T> span, T value) {
        for (int i = 0; i < span.Length; i++) { if (Same(span[i], value)) { return i; } }
        return -1;
    }
    public static int IndexOf<T>(this Span<T> span, T value) {
