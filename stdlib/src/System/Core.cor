// The CORSAC Script standard library.
//
// Written in the language itself rather than built into the compiler, which is
// the whole reason linking exists: this file is compiled alongside a program
// and type-checked against it, so the library and its user are held to the same
// rules. Anything here can be read, copied and replaced by whoever is using it.
//
//   corsac cc lib/std.cor myprogram.cor --run

// ---- String ---------------------------------------------------------------
// What '+', '==' and the ordering comparisons on strings actually call. The
// compiler lowers those operators into these methods rather than emitting code
// of its own, so the behaviour of the language's own operators is source you
// can read and, if you disagree with it, replace.
//
// A string here is a length word followed by that many bytes — the same shape
// as a byte array, which is why the five Sys primitives below are enough to
// build the whole type. Strings are treated as immutable: nothing outside this
// file writes bytes into one that already exists.

// HOW TWO STRINGS ARE TO BE COMPARED, with .NET's names and .NET's order.
//
// There is one culture on this machine, so the culture-sensitive members mean
// the same as the invariant ones -- but they exist, because source that says
// StringComparison.OrdinalIgnoreCase has to compile, and because the day a
// culture arrives the names are already the right ones.
enum StringComparison {
    CurrentCulture,
    CurrentCultureIgnoreCase,
    InvariantCulture,
    InvariantCultureIgnoreCase,
    Ordinal,
    OrdinalIgnoreCase,
}

// WHAT SPLIT DOES WITH THE PIECES IT MAKES. A FLAGS ENUM, as .NET has it since
// 5: the two options combine, and a caller that wants both writes the `|` it
// would write there.
enum StringSplitOptions {
    None = 0,
    RemoveEmptyEntries = 1,
    TrimEntries = 2,
}

static class String {
    // String.ToString: the string itself, as .NET answers it, whether or not
    // a format provider is given -- a string is already its own text.
    public static string ToString(string value) { return value; }
    public static string ToString(string value, IFormatProvider? provider) { return value; }

    // LINQ's Count(predicate) over a string. A string is a sequence of char in
    // C#; it is a primitive here, with no vtable to carry IEnumerable<char>, so
    // this instance-shaped static helper supplies the same source surface.
    public static int Count(string value, Func<char, bool> test) {
        int count = 0;
        for (int i = 0; i < value.Length; i++) {
            if (test(Sys.GetChar(value, i))) { count = count + 1; }
        }
        return count;
    }

    private static void CopyRange(string dst, int dstAt, string src, int srcAt, int count) {
        if (count <= 0) { return; }
        // Every caller owns dst and is copying from a distinct source block.
        // Non-overlap permits the bulk non-temporal path; the ordinary MCp
        // fallback also works on uncached/noncoherent RAM. Unit availability
        // alone would not make vector stores legal on that destination.
        Sys.CopyNoOverlap(dst, dstAt, src, srcAt, count);
    }

    // Called by: a + b
    public static string Concat(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        string result = Sys.NewChars(la + lb);
        CopyRange(result, 0, a, 0, la);
        CopyRange(result, la, b, 0, lb);
        return result;
    }

    // Called by: a == b, a != b, a < b, and the rest. Ordinal, and the shared
    // prefix decides before the lengths do, so a prefix sorts before what
    // extends it. Culture-aware collation needs tables nobody in this world has.
    /// Ordinal, by UTF-16 code unit, as .NET's String.CompareOrdinal: null
    /// before every string, and two nulls equal.
    public static int Compare(string? a, string? b) {
        if ((object?)a == (object?)b) { return 0; }
        if (a == null) { return 0 - 1; }
        if (b == null) { return 1; }
        int la = a.Length;
        int lb = b.Length;
        int n = la;
        if (lb < n) { n = lb; }

        int byBytes = Sys.StringCompare(a, 0, b, 0, n);
        if (byBytes != 0) { return byBytes; }

        if (la < lb) { return 0 - 1; }
        if (la > lb) { return 1; }
        return 0;
    }

    // NULL IS EQUAL TO NULL AND TO NOTHING ELSE, which is .NET's answer and is
    // what `==` on two strings calls: `a.Name == b.Name` must not fault, or say
    // that no name is the empty name.
    // The hash the tables use for a string key, reached by the routine that
    // hashes a key it knows only as a word.
    public static int KeyHash(string s) {
        return Runtime.StringHashCode(s);
    }

    public static bool Equals(string? a, string? b) {
        // THE SAME STRING is equal without a look: every literal is one object
        // (interned), and a table's key is very often the string it was given.
        if ((object?)a == (object?)b) { return true; }
        if (a == null || b == null) { return false; }
        if (a.Length != b.Length) { return false; }
        // Two strings whose hashes are both known (Runtime.StringHashCode) and
        // differ cannot be equal: two loads instead of reading every unit.
        if (Runtime.KnownHashesDiffer(a, b)) { return false; }
        return Sys.StringEqual(a, 0, b, 0, a.Length);
    }

    // Called by: "count: " + n
    //
    // Digits come out lowest-first, so they are built backwards into a scratch
    // block and reversed into an exactly-sized string. Two allocations, one
    // pass, and no over-long string left behind in the arena.
    public static string FromInt(long value) {
        string buffer = Sys.NewChars(20);
        int written = Sys.StringFormat(buffer, 0, value, 20);
        string exact = Sys.NewChars(written);
        CopyRange(exact, 0, buffer, 0, written);
        return exact;
    }

    // THE SAME, UNSIGNED. A ulong above long.MaxValue has its top bit set,
    // and the signed formatter reads that as a negative number: ulong.MaxValue
    // printed as -1 rather than as 18446744073709551615.
    //
    // One division takes the top digit off, after which what is left is below
    // long.MaxValue and the signed path is exact. Unsigned division is a
    // different instruction from signed division, which is the whole reason
    // this cannot simply call the other one.
    public static string FromUInt(ulong value) {
        if (value <= 9223372036854775807UL) { return FromInt((long)value); }

        ulong rest = value / 10;

        return Concat(FromInt((long)rest), FromInt((long)(value - rest * 10)));
    }

    // ONE CHARACTER, AS A STRING. C# spells it value.ToString() on a char and
    // this is that.
    //
    // It looks too small to be worth a method until something has to build
    // text a character at a time -- a line editor inserting a keystroke, a
    // program showing a control character as ^C -- at which point every caller
    // writes the same two lines and one of them gets the length wrong.
    public static string FromByte(long value) {
        string one = Sys.NewChars(1);

        Sys.SetChar(one, 0, (int)(value & 0xFFFF));
        return one;
    }

    // CAPITALISED, because that is what bool.ToString() answers in C# and this
    // is the same function. It used to be lower case, which reads better and is
    // wrong: a program that prints a flag and is then compiled by the .NET
    // build of this compiler would print something different, and a difference
    // that only shows up in output is the kind nobody notices until it is in a
    // file somebody is parsing.
    public static string FromBool(bool value) {
        if (value) { return "True"; }
        return "False";
    }

    // WHAT `"x = " + d` OUGHT TO CALL, and does not yet: the lowering that
    // picks FromInt for an integer and FromBool for a bool refuses a double
    // outright -- "'double' cannot be joined to a string". This is the answer
    // waiting for it, and what `d.ToString()` means once it is wired up.
    // See build/repro-std-double-join.cor.
    public static string FromDouble(double value) {
        return DoubleFormat.Shortest(value);
    }

    /// Type.Name: the last part of the name a type's descriptor holds --
    /// `Object` of `System.Object`, `Int32` of `System.Int32`, `State` of a
    /// nested `Parser+State`.
    /// A type's full name as Type.ToString writes it, which is what
    /// object.ToString answers: a generic's arguments by their own names
    /// alone -- List`1[System.Int32] -- where FullName qualifies each with
    /// its assembly. Anything without arguments is its full name.
    public static string TypeText(string full) {
        int open = full.IndexOf("[[");
        if (open < 0) { return full; }
        string text = full.Substring(0, open) + "[";
        int at = open + 1;
        bool first = true;
        while (at < full.Length && full[at] == '[') {
            int depth = 0;
            int end = at;
            int comma = -1;
            while (end < full.Length) {
                char c = full[end];
                if (c == '[') { depth++; }
                else if (c == ']') { depth--; if (depth == 0) { break; } }
                else if (c == ',' && depth == 1 && comma < 0) { comma = end; }
                end++;
            }
            string inner = full.Substring(at + 1, (comma >= 0 ? comma : end) - at - 1);
            text = text + (first ? "" : ",") + TypeText(inner);
            first = false;
            at = end + 1;
            if (at < full.Length && full[at] == ',') { at++; }
        }
        // The list's own close, then whatever follows it: an array's [].
        return text + "]" + (at + 1 <= full.Length ? full.Substring(at + 1) : "");
    }

    public static string TypeName(string full) {
        // A GENERIC TYPE'S ARGUMENTS ARE NOT ITS NAME: System.ValueTuple`2[[
        // System.Int32, ...]] is ValueTuple`2, as .NET's Type.Name, and an
        // array of one keeps its brackets after.
        int generic = full.IndexOf("[[");
        if (generic >= 0) {
            int depth = 0;
            int end = generic;
            while (end < full.Length) {
                char c = full[end];
                if (c == '[') { depth++; }
                else if (c == ']') { depth--; if (depth == 0) { end++; break; } }
                end++;
            }
            return TypeName(full.Substring(0, generic)) + full.Substring(end);
        }
        int dot = full.LastIndexOf('.');
        int plus = full.LastIndexOf('+');
        int cut = dot > plus ? dot : plus;
        return cut < 0 ? full : full.Substring(cut + 1);
    }

    /// `"x = " + f` for a float: the shortest digits that are that float.
    public static string FromSingle(float value) {
        return DoubleFormat.ShortestSingle(value);
    }

    public static int IndexOf(string s, int ch) {
        return Sys.StringFind(s, 0, ch, s.Length);
    }

    // EVERYTHING IN A SEQUENCE, SEPARATED. `string.Join(", ", args)`.
    //
    // Each element renders through its ToString, which is what joining one to
    // a string does -- and a class with none of its own answers with its type
    // name, the same as object.ToString() in C#.
    //
    // Compiled ONCE, over the canonical machine word, so `List<TypeRef>` and
    // `List<string>` and `List<Node>` all reach the same routine. A list of a
    // narrow value type -- `List<int>` -- strides by four where the canonical
    // copy strides by eight, and is refused rather than read wrongly.
    public static string Join<T>(string separator, IReadOnlyList<T> values) {
        string result = "";
        int i = 0;
        while (i < values.Count) {
            if (i > 0) { result = result + separator; }
            result = result + values[i];
            i = i + 1;
        }
        return result;
    }

    public static string Join<T>(string separator, T[] values) {
        string result = "";
        int i = 0;
        while (i < values.Length) {
            if (i > 0) { result = result + separator; }
            result = result + values[i];
            i = i + 1;
        }
        return result;
    }

    /// EVERYTHING IN A SEQUENCE, JOINED, with nothing between them. `Concat`
    /// is `Join("")` and .NET has both, because the reason you reach for one
    /// is not the reason you reach for the other.
    public static string Concat<T>(IReadOnlyList<T> values) {
        return Join("", values);
    }

    // ---- string.Format ----------------------------------------------------
    //
    // `{index[,alignment][:format]}`, which is the same grammar an
    // interpolated string is written in -- and NOT the same machinery: an
    // interpolation is taken apart by the compiler at the point it is written,
    // and this one is a format string chosen at RUN time, out of a resource
    // file or a configuration or a message table. That is what it is for.
    //
    // A doubled brace is one brace. An index past the arguments is a
    // FormatException, in .NET's words, rather than a blank -- a message with
    // a hole in it is worse than one that failed.

    public static string Format(string format, params object?[] args) {
        return Format((IFormatProvider?)null, format, args);
    }

    public static string Format(IFormatProvider? provider, string format, params object?[] args) {
        if (format == null) { throw new ArgumentNullException("format"); }
        if (args == null) { throw new ArgumentNullException("args"); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < format.Length) {
            char c = Sys.GetChar(format, at);

            if (c == '{' && at + 1 < format.Length && Sys.GetChar(format, at + 1) == (int)'{') {
                made.Append('{');
                at = at + 2;
                continue;
            }

            if (c == '}' && at + 1 < format.Length && Sys.GetChar(format, at + 1) == (int)'}') {
                made.Append('}');
                at = at + 2;
                continue;
            }

            if (c != '{') {
                made.Append(c);
                at = at + 1;
                continue;
            }

            int close = String.IndexOf(format, '}', at);

            if (close < 0) { throw new FormatException("Input string was not in a correct format."); }

            string hole = String.Substring(format, at + 1, close - at - 1);

            at = close + 1;

            string indexText = hole;
            string alignText = "";
            string formatText = "";
            int colon = String.IndexOf(hole, ':');

            if (colon >= 0) {
                formatText = String.Substring(hole, colon + 1, hole.Length - colon - 1);
                indexText = String.Substring(hole, 0, colon);
            }

            int comma = String.IndexOf(indexText, ',');

            if (comma >= 0) {
                alignText = String.Substring(indexText, comma + 1, indexText.Length - comma - 1);
                indexText = String.Substring(indexText, 0, comma);
            }

            int index = 0;

            if (!Int32.TryParse(String.Trim(indexText), out index) || index < 0 || index >= args.Length) {
                throw new FormatException("Index (zero based) must be greater than or equal to zero and less than the size of the argument list.");
            }

            int width = 0;

            if (alignText.Length > 0 && !Int32.TryParse(String.Trim(alignText), out width)) {
                throw new FormatException("Input string was not in a correct format.");
            }
            made.Append(Padded(Formatted(args[index], formatText, provider), width));
        }
        return made.ToString();
    }

    public static string Format(string format, object? arg0) {
        return Format((IFormatProvider?)null, format, new object?[] { arg0 });
    }

    public static string Format(string format, object? arg0, object? arg1) {
        return Format((IFormatProvider?)null, format, new object?[] { arg0, arg1 });
    }

    public static string Format(string format, object? arg0, object? arg1, object? arg2) {
        return Format((IFormatProvider?)null, format, new object?[] { arg0, arg1, arg2 });
    }

    public static string Format(IFormatProvider? provider, string format, object? arg0) {
        return Format(provider, format, new object?[] { arg0 });
    }

    public static string Format(IFormatProvider? provider, string format, object? arg0, object? arg1) {
        return Format(provider, format, new object?[] { arg0, arg1 });
    }

    public static string Format(IFormatProvider? provider, string format, object? arg0, object? arg1, object? arg2) {
        return Format(provider, format, new object?[] { arg0, arg1, arg2 });
    }

    /// ONE ARGUMENT, WRITTEN. The format string after the colon belongs to the
    /// VALUE's type -- "X4" to a number, "yyyy-MM-dd" to a date -- which is
    /// what IFormattable means in .NET; here the type is asked for directly,
    /// because a boxed value knows what it is and there is no interface
    /// dispatch to do it through.
    /// A null argument is nothing at all, as .NET writes it.
    private static string Formatted(object? value, string format, IFormatProvider? provider) {
        if (value == null) { return ""; }
        if (format.Length == 0) { return "" + value; }
        if (value is int i32) { return i32.ToString(format); }
        if (value is long i64) { return i64.ToString(format); }
        if (value is double f64) { return f64.ToString(format, provider); }
        if (value is float f32) { return f32.ToString(format, provider); }
        if (value is uint u32) { return u32.ToString(format); }
        if (value is ulong u64) { return u64.ToString(format); }
        if (value is short i16) { return i16.ToString(format); }
        if (value is ushort u16) { return u16.ToString(format); }
        if (value is byte u8) { return u8.ToString(format); }
        if (value is sbyte i8) { return i8.ToString(format); }
        if (value is DateTime date) { return date.ToString(format); }
        if (value is IFormattable formattable) { return formattable.ToString(format, provider); }
        return "" + value;
    }

    /// POSITIVE PADS ON THE LEFT and negative on the right, which is .NET's
    /// rule for an alignment and reads backwards until you think of it as
    /// "right-aligned in a field this wide".
    private static string Padded(string text, int width) {
        if (width == 0) { return text; }
        if (width > 0) { return PadLeft(text, width); }
        return PadRight(text, -width);
    }

    public static string Substring(string s, int start, int count) {
        // Sys.Copy is a block move: it knows how many bytes to shift and
        // nothing whatever about where this string ends, so an unchecked range
        // here would quietly copy whatever sits next to s in the arena. Every
        // other way of reading a string is checked by the machine; this one has
        // to ask for it.
        if (start < 0 || count < 0 || start + count > s.Length) {
            // One past the end, which traps IndexOutOfRange exactly as s[i]
            // would. It becomes a throw once exceptions land.
            count = Sys.GetChar(s, s.Length);
        }

        string result = Sys.NewChars(count);
        CopyRange(result, 0, s, start, count);
        return result;
    }

    // ---- case, and comparing without it ---------------------------------
    //
    // The Unicode simple case mappings (the runtime's UnicodeCase), which is
    // what .NET's Invariant versions apply: "not the current culture's rule",
    // and every script's letters, a surrogate pair's among them.
    // WHAT `new string(c, n)` MEANS. C# spells it as a constructor and a string
    // here is a primitive with no class to put one on, so the compiler turns
    // that construction into this call -- see Binder. The name is .NET's:
    // string.Repeat does not exist there, but this is the constructor's body
    // and nothing else calls it by name.
    public static string Repeat(char c, int count) {
        if (count <= 0) { return ""; }

        string made = Sys.NewChars(count);

        Sys.StringFill(made, 0, (int)c, count);
        return made;
    }

    // WHAT `new string(chars)` AND `new string(chars, start, length)` MEAN, for
    // the same reason Repeat exists: C# spells both as constructors and a
    // string here has no class to carry one, so the compiler turns the
    // construction into this call.
    //
    // The range form checks its own arguments, because a constructor in C#
    // throws rather than reading past the array -- and the caller that gets it
    // wrong is usually a decoder writing out however many characters it
    // produced into a buffer it sized once.
    /// One character as a string of one, which is what a char joined to text
    /// becomes.
    public static string FromChar(char c) {
        char[] one = new char[1];

        one[0] = c;
        return FromChars(one);
    }

    public static string FromChars(char[] chars) {
        if (chars == null) { return ""; }

        return FromChars(chars, 0, chars.Length);
    }

    /// `new string(span)`, .NET's string(ReadOnlySpan<char>): the chars copied.
    public static string FromChars(ReadOnlySpan<char> chars) {
        if (chars.Length == 0) { return ""; }
        string made = Sys.NewChars(chars.Length);
        for (int i = 0; i < chars.Length; i++) {
            Sys.SetChar(made, i, chars[i]);
        }
        return made;
    }

    /// The same from a Span, which .NET converts to ReadOnlySpan implicitly.
    public static string FromChars(Span<char> chars) {
        if (chars.Length == 0) { return ""; }
        string made = Sys.NewChars(chars.Length);
        for (int i = 0; i < chars.Length; i++) {
            Sys.SetChar(made, i, chars[i]);
        }
        return made;
    }

    public static string FromChars(char[] chars, int start, int length) {
        if (chars == null) { throw new ArgumentNullException("chars"); }
        if (start < 0 || length < 0 || start + length > chars.Length) {
            throw new ArgumentOutOfRangeException("start");
        }
        if (length == 0) { return ""; }

        string made = Sys.NewChars(length);

        for (int i = 0; i < length; i++) {
            Sys.SetChar(made, i, chars[start + i]);
        }
        return made;
    }

    public static string ToLowerInvariant(string s) {
        string made = Sys.NewChars(s.Length);
        CopyRange(made, 0, s, 0, s.Length);
        Sys.StringLower(made, 0, made.Length);
        return made;
    }

    public static string ToUpperInvariant(string s) {
        string made = Sys.NewChars(s.Length);
        CopyRange(made, 0, s, 0, s.Length);
        Sys.StringUpper(made, 0, made.Length);
        return made;
    }

    // .NET has these as the culture-sensitive pair; on a machine with one
    // culture they are the invariant ones.
    public static string ToLower(string s) { return ToLowerInvariant(s); }
    public static string ToUpper(string s) { return ToUpperInvariant(s); }

    public static bool Equals(string a, string b, StringComparison kind) {
        // IGNORING CASE IS COMPARING UPPER CASE, as .NET's OrdinalIgnoreCase
        // does it: the two differ for the few characters whose upper case is
        // shared and lower case is not (K and the Kelvin sign, s and long s).
        if (kind == StringComparison.OrdinalIgnoreCase
         || kind == StringComparison.InvariantCultureIgnoreCase
         || kind == StringComparison.CurrentCultureIgnoreCase) {
            return Compare(ToUpperInvariant(a), ToUpperInvariant(b)) == 0;
        }
        return Compare(a, b) == 0;
    }

    // A read-only character view: the string's own units, which are laid out
    // as a char[]'s (Sys.CharsOf), so indexing, slicing and every span
    // routine read the string in place and nothing is copied.
    public static ReadOnlySpan<char> AsSpan(string s, int start) {
        if (s == null) {
            if (start != 0) { throw new ArgumentOutOfRangeException("start"); }
            return default;
        }
        if ((uint)start > (uint)s.Length) { throw new ArgumentOutOfRangeException("start"); }
        return new ReadOnlySpan<char>(Sys.CharsOf(s), start, s.Length - start);
    }

    /// .NET's: a view of the string, not a copy -- a string and a char[] are
    /// laid out alike, so the span reads the string's own units.
    public static ReadOnlySpan<char> AsSpan(string s) {
        if (s == null) { return default; }
        return new ReadOnlySpan<char>(Sys.CharsOf(s), 0, s.Length);
    }

    /// .NET's third overload: a window, not a tail.
    public static ReadOnlySpan<char> AsSpan(string s, int start, int length) {
        if (s == null) {
            if (start != 0 || length != 0) { throw new ArgumentOutOfRangeException("start"); }
            return default;
        }
        if ((uint)start > (uint)s.Length || (uint)length > (uint)(s.Length - start)) { throw new ArgumentOutOfRangeException("start"); }
        return new ReadOnlySpan<char>(Sys.CharsOf(s), start, length);
    }

    // ---- the rest of the string surface --------------------------------
    //
    // .NET's names and .NET's answers, ordinal throughout.

    public static bool EndsWith(string s, string suffix) {
        if (suffix.Length > s.Length) { return false; }
        return Sys.StringEqual(s, s.Length - suffix.Length, suffix, 0, suffix.Length);
    }

    public static bool EndsWith(string s, char suffix) {
        return s.Length > 0 && Sys.GetChar(s, s.Length - 1) == (int)suffix;
    }

    public static bool StartsWith(string s, string prefix, StringComparison kind) {
        if (prefix.Length > s.Length) { return false; }
        if (kind == StringComparison.Ordinal) {
            return Sys.StringEqual(s, 0, prefix, 0, prefix.Length);
        }
        return Equals(Substring(s, 0, prefix.Length), prefix, kind);
    }

    public static bool EndsWith(string s, string suffix, StringComparison kind) {
        if (suffix.Length > s.Length) { return false; }
        if (kind == StringComparison.Ordinal) {
            return Sys.StringEqual(s, s.Length - suffix.Length, suffix, 0, suffix.Length);
        }
        return Equals(Substring(s, s.Length - suffix.Length, suffix.Length), suffix, kind);
    }

    public static int IndexOf(string s, string what) {
        if (what.Length == 0) { return 0; }

        if (what.Length > s.Length) { return 0 - 1; }
        return Sys.StringSearch(s, 0, what, 0, s.Length);
    }

    public static int IndexOfAny(string s, char[] any) {
        for (int i = 0; i < s.Length; i++) {
            int ch = Sys.GetChar(s, i);
            for (int j = 0; j < any.Length; j++) {
                if (ch == (int)any[j]) { return i; }
            }
        }
        return 0 - 1;
    }

    public static int LastIndexOf(string s, int ch) {
        if (s.Length == 0) { return 0 - 1; }
        return Sys.StringFindReverse(s, s.Length - 1, ch, s.Length);
    }

    public static bool Contains(string s, string what) { return IndexOf(s, what) >= 0; }
    public static bool Contains(string s, char ch) { return IndexOf(s, (int)ch) >= 0; }

    public static string Substring(string s, int start) { return Substring(s, start, s.Length - start); }

    /// A FALSE ANSWER PROVES THERE IS A STRING, which is what .NET's
    /// [NotNullWhen(false)] says and what makes `if (!IsNullOrEmpty(dir))
    /// { Use(dir); }` the ordinary way to write the check.
    public static bool IsNullOrEmpty([NotNullWhen(false)] string? s) { return s == null || s.Length == 0; }

    /// ONE COPY OF EACH TEXT, as .NET's intern pool: the first string of a
    /// given text handed here is the one every later equal text gets back.
    /// Held for the life of the process, as .NET holds it.
    static Dictionary<string, string>? _interned;
    static readonly object _internLock = new object();

    public static string Intern(string str)
    {
        if (str == null) throw new ArgumentNullException("str");
        lock (_internLock)
        {
            _interned ??= new Dictionary<string, string>();
            if (_interned.TryGetValue(str, out string? held)) return held;
            _interned[str] = str;
            return str;
        }
    }

    public static string? IsInterned(string str)
    {
        if (str == null) throw new ArgumentNullException("str");
        lock (_internLock)
        {
            return _interned is not null && _interned.TryGetValue(str, out string? held) ? held : null;
        }
    }

    public static bool IsNullOrWhiteSpace([NotNullWhen(false)] string? s) {
        if (s == null) { return true; }

        for (int i = 0; i < s.Length; i++) {
            if (!Char.IsWhiteSpace(Sys.GetChar(s, i))) { return false; }
        }
        return true;
    }

    public static string TrimStart(string s) {
        int at = 0;

        while (at < s.Length && Char.IsWhiteSpace(Sys.GetChar(s, at))) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s) {
        int end = s.Length;

        while (end > 0 && Char.IsWhiteSpace(Sys.GetChar(s, end - 1))) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s) { return TrimEnd(TrimStart(s)); }

    // ONE SEPARATOR, which is what a compiler splitting a line on spaces or a
    // path on slashes needs. .NET's overload taking several is not here yet and
    // will be the day something wants it.
    public static string[] Split(string s, char separator) {
        int parts = 1;

        for (int i = 0; i < s.Length; i++) {
            if (Sys.GetChar(s, i) == (int)separator) { parts = parts + 1; }
        }

        string[] made = new string[parts];
        int which = 0;
        int from = 0;

        for (int i = 0; i <= s.Length; i++) {
            if (i == s.Length || Sys.GetChar(s, i) == (int)separator) {
                made[which] = Substring(s, from, i - from);
                which = which + 1;
                from = i + 1;
            }
        }
        return made;
    }

    public static string PadLeft(string s, int width, char with) {
        if (s.Length >= width) { return s; }
        return Concat(Repeat(with, width - s.Length), s);
    }

    public static string PadRight(string s, int width, char with) {
        if (s.Length >= width) { return s; }
        return Concat(s, Repeat(with, width - s.Length));
    }

    public static string PadLeft(string s, int width) { return PadLeft(s, width, ' '); }
    public static string PadRight(string s, int width) { return PadRight(s, width, ' '); }

    // .NET's Replace, over whole strings. Ordinal, like everything else here.
    public static string Replace(string s, string what, string with) {
        if (what.Length == 0) { return s; }

        // COUNT FIRST, THEN ALLOCATE ONCE. The former implementation appended
        // one character at a time, and every append copied everything already
        // produced. Replacing CRLF in a source file was therefore quadratic:
        // stage1.asm happened to fit, while the 188 KiB BIOS consumed hundreds
        // of MiB before the assembler had parsed its first line.
        int matches = 0;
        int at = 0;

        while (at + what.Length <= s.Length) {
            if (at + what.Length <= s.Length
             && Sys.StringEqual(s, at, what, 0, what.Length)) {
                matches = matches + 1;
                at = at + what.Length;
            } else {
                at = at + 1;
            }
        }

        if (matches == 0) { return s; }

        long length = (long)s.Length
                    + (long)matches * (long)(with.Length - what.Length);
        if (length < 0 || length > 2147483647) {
            throw new OverflowException("replacement result is too large");
        }

        string made = Sys.NewChars((int)length);
        at = 0;
        int into = 0;

        while (at < s.Length) {
            if (at + what.Length <= s.Length
             && Sys.StringEqual(s, at, what, 0, what.Length)) {
                CopyRange(made, into, with, 0, with.Length);
                into = into + with.Length;
                at = at + what.Length;
            } else {
                Sys.SetChar(made, into, Sys.GetChar(s, at));
                into = into + 1;
                at = at + 1;
            }
        }
        return made;
    }

    /// `a.CompareTo(b)`, IComparable<string>'s: the order String.Compare
    /// gives, with every string after null.
    public static int CompareTo(string s, string? other) {
        return Compare(s, other);
    }

    public static int CompareTo(string s, object? other) {
        if (other == null) { return 1; }
        if (other is string text) { return Compare(s, text); }
        throw new ArgumentException("Object must be of type String.");
    }

    public static bool StartsWith(string s, string prefix) {
        if (prefix.Length > s.Length) { return false; }
        return Sys.StringEqual(s, 0, prefix, 0, prefix.Length);
    }

    public static bool StartsWith(string s, char prefix) {
        return s.Length > 0 && Sys.GetChar(s, 0) == (int)prefix;
    }

    // ---- the parts of the string surface a program reaches for next -------
    //
    // Everything below is .NET's name answering .NET's answer, ordinal
    // throughout for the reason stated at the top of this file: there is one
    // culture here and collation tables for another do not exist.

    // .NET's string.Empty. A literal would do as well and every program that
    // says `string.Empty` would still fail to compile, which is the point.
    public static string Empty => "";

    // .NET's Concat family: a null is nothing, and an object is what its
    // ToString says.
    // EACH IN ONE ALLOCATION: the lengths added, the result made once, and
    // each part copied into it once. `a + b + c + d` is one of these (the
    // compiler joins a chain into one call), so a name built from four parts
    // is one string, not three.
    public static string Concat(string? a, string? b, string? c) {
        string x = a ?? "", y = b ?? "", z = c ?? "";
        string result = Sys.NewChars(x.Length + y.Length + z.Length);
        CopyRange(result, 0, x, 0, x.Length);
        CopyRange(result, x.Length, y, 0, y.Length);
        CopyRange(result, x.Length + y.Length, z, 0, z.Length);
        return result;
    }

    public static string Concat(string? a, string? b, string? c, string? d) {
        string w = a ?? "", x = b ?? "", y = c ?? "", z = d ?? "";
        string result = Sys.NewChars(w.Length + x.Length + y.Length + z.Length);
        int at = 0;
        CopyRange(result, at, w, 0, w.Length); at += w.Length;
        CopyRange(result, at, x, 0, x.Length); at += x.Length;
        CopyRange(result, at, y, 0, y.Length); at += y.Length;
        CopyRange(result, at, z, 0, z.Length);
        return result;
    }

    public static string Concat(params string?[] values) {
        if (values == null) { throw new ArgumentNullException("values"); }
        long total = 0;
        for (int i = 0; i < values.Length; i++) { if (values[i] is string one) { total += one.Length; } }
        if (total > int.MaxValue) { throw new OutOfMemoryException(); }
        string result = Sys.NewChars((int)total);
        int at = 0;
        for (int i = 0; i < values.Length; i++)
        {
            if (values[i] is string one) { CopyRange(result, at, one, 0, one.Length); at += one.Length; }
        }
        return result;
    }

    public static string Concat(IEnumerable<string?> values) {
        if (values == null) { throw new ArgumentNullException("values"); }
        StringBuilder made = new StringBuilder();
        foreach (string? one in values) { made.Append(one); }
        return made.ToString();
    }

    public static string Concat<T>(IEnumerable<T> values) {
        if (values == null) { throw new ArgumentNullException("values"); }
        StringBuilder made = new StringBuilder();
        foreach (T one in values) { if (one != null) { made.Append(one.ToString()); } }
        return made.ToString();
    }

    public static string Concat(object? arg0) {
        return arg0 == null ? "" : "" + arg0;
    }

    public static string Concat(object? arg0, object? arg1) {
        return Concat(Concat(arg0), Concat(arg1));
    }

    public static string Concat(object? arg0, object? arg1, object? arg2) {
        return Concat(Concat(arg0), Concat(arg1), Concat(arg2));
    }

    public static string Concat(params object?[] args) {
        if (args == null) { throw new ArgumentNullException("args"); }
        StringBuilder made = new StringBuilder();
        for (int i = 0; i < args.Length; i++) { made.Append(Concat(args[i])); }
        return made.ToString();
    }

    public static string Concat(ReadOnlySpan<char> str0, ReadOnlySpan<char> str1) {
        return Concat(str0.ToString(), str1.ToString());
    }

    // WALKED RATHER THAN INDEXED, which is what .NET's Join over a sequence
    // does: an IEnumerable has no count and no index, only a way forward.
    /// THE SEPARATOR AS A CHARACTER, which .NET has beside every string form:
    /// `string.Join(':', paths)` is what a search path is built with.
    public static string Join<T>(char separator, IEnumerable<T> values) {
        return Join(String.FromChar(separator), values);
    }

    public static string Join<T>(char separator, T[] values) {
        return Join(String.FromChar(separator), values);
    }

    public static string Join<T>(string separator, IEnumerable<T> values) {
        StringBuilder made = new StringBuilder();
        bool first = true;

        foreach (T one in values) {
            if (!first) { made.Append(separator); }
            made.Append("" + one);
            first = false;
        }
        return made.ToString();
    }

    public static string Join(string separator, List<string> values) {
        return Join<string>(separator, (IReadOnlyList<string>)values);
    }

    /// `string.Join(", ", a, b, c)`: .NET's params forms. A null separator
    /// is nothing between them, and a null element is nothing.
    public static string Join(string? separator, params string?[] value) {
        if (value == null) { throw new ArgumentNullException(nameof(value)); }
        StringBuilder made = new StringBuilder();
        for (int i = 0; i < value.Length; i++) {
            if (i > 0 && separator != null) { made.Append(separator); }
            string? one = value[i];
            if (one != null) { made.Append(one); }
        }
        return made.ToString();
    }

    public static string Join(string? separator, params object?[] values) {
        if (values == null) { throw new ArgumentNullException(nameof(values)); }
        StringBuilder made = new StringBuilder();
        for (int i = 0; i < values.Length; i++) {
            if (i > 0 && separator != null) { made.Append(separator); }
            object? one = values[i];
            if (one != null) { made.Append(one.ToString()); }
        }
        return made.ToString();
    }

    public static string Join(char separator, params string?[] value) { return Join(String.FromChar(separator), value); }

    public static string Join(char separator, params object?[] values) { return Join(String.FromChar(separator), values); }

    // ---- searching, from somewhere other than the start -------------------

    public static int IndexOf(string s, char ch, int start) {
        for (int i = start < 0 ? 0 : start; i < s.Length; i++) {
            if (Sys.GetChar(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, char ch, int start, int count) {
        int end = start + count;
        if (end > s.Length) { end = s.Length; }
        for (int i = start < 0 ? 0 : start; i < end; i++) {
            if (Sys.GetChar(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, string what, int start) {
        if (start < 0) { start = 0; }
        if (what.Length == 0) { return start <= s.Length ? start : -1; }

        for (int i = start; i + what.Length <= s.Length; i++) {
            if (Sys.StringEqual(s, i, what, 0, what.Length)) { return i; }
        }
        return -1;
    }

    public static int IndexOf(string s, string what, StringComparison kind) {
        return IndexOf(s, what, 0, kind);
    }

    // CASE-FOLDING FOLDS BOTH SIDES ONCE, not once per position: the naive
    // form lowers a slice of the haystack inside the loop and turns a search
    // into an allocation per character.
    public static int IndexOf(string s, string what, int start, StringComparison kind) {
        if (kind == StringComparison.Ordinal || kind == StringComparison.InvariantCulture
         || kind == StringComparison.CurrentCulture) {
            return IndexOf(s, what, start);
        }
        return IndexOf(ToUpperInvariant(s), ToUpperInvariant(what), start);
    }

    public static int LastIndexOf(string s, string what) {
        if (what.Length == 0) { return s.Length; }

        for (int i = s.Length - what.Length; i >= 0; i--) {
            if (Sys.StringEqual(s, i, what, 0, what.Length)) { return i; }
        }
        return -1;
    }

    public static int LastIndexOf(string s, string what, StringComparison kind) {
        if (kind == StringComparison.Ordinal || kind == StringComparison.InvariantCulture
         || kind == StringComparison.CurrentCulture) {
            return LastIndexOf(s, what);
        }
        return LastIndexOf(ToUpperInvariant(s), ToUpperInvariant(what));
    }

    public static int LastIndexOf(string s, char ch, int start) {
        for (int i = start >= s.Length ? s.Length - 1 : start; i >= 0; i--) {
            if (Sys.GetChar(s, i) == (int)ch) { return i; }
        }
        return -1;
    }

    public static int LastIndexOfAny(string s, char[] any) {
        for (int i = s.Length - 1; i >= 0; i--) {
            int ch = Sys.GetChar(s, i);
            for (int j = 0; j < any.Length; j++) {
                if (ch == (int)any[j]) { return i; }
            }
        }
        return -1;
    }

    public static bool Contains(string s, string what, StringComparison kind) {
        return IndexOf(s, what, 0, kind) >= 0;
    }

    // ---- comparing, the overloads whose extra argument is the whole point --

    public static int Compare(string? a, string? b, bool ignoreCase) {
        if (a == null || b == null) { return Compare(a, b); }
        if (ignoreCase) { return Compare(ToUpperInvariant(a), ToUpperInvariant(b)); }
        return Compare(a, b);
    }

    public static int Compare(string? a, string? b, StringComparison kind) {
        if (a == null || b == null) { return Compare(a, b); }
        if (kind == StringComparison.OrdinalIgnoreCase
         || kind == StringComparison.InvariantCultureIgnoreCase
         || kind == StringComparison.CurrentCultureIgnoreCase) {
            return Compare(ToUpperInvariant(a), ToUpperInvariant(b));
        }
        return Compare(a, b);
    }

    public static int CompareOrdinal(string? a, string? b) { return Compare(a, b); }

    /// At most length characters of each, from those indices, compared by
    /// code unit; a shorter remainder sorts first, as .NET has it.
    public static int CompareOrdinal(string a, int indexA, string b, int indexB, int length) {
        if (length < 0 || indexA < 0 || indexB < 0) { throw new ArgumentOutOfRangeException("length"); }
        int left = Math.Min(length, a.Length - indexA);
        int right = Math.Min(length, b.Length - indexB);
        if (left < 0 || right < 0) { throw new ArgumentOutOfRangeException("indexA"); }
        int common = Math.Min(left, right);
        for (int i = 0; i < common; i++) {
            int difference = a[indexA + i] - b[indexB + i];
            if (difference != 0) { return difference; }
        }
        return left - right;
    }

    /// The same hash StringComparer.Ordinal gives, so a string and its
    /// comparer agree.
    public static int GetHashCode(string s) { return Runtime.StringHashCode(s); }

    // ---- cutting and splicing ---------------------------------------------

    public static string Remove(string s, int start) {
        return Substring(s, 0, start);
    }

    public static string Remove(string s, int start, int count) {
        return Concat(Substring(s, 0, start), Substring(s, start + count, s.Length - start - count));
    }

    public static string Insert(string s, int at, string value) {
        return Concat(Substring(s, 0, at), Concat(value, Substring(s, at, s.Length - at)));
    }

    /// ONE CHARACTER REPLACED BY ANOTHER, which is not the string overload
    /// with one-character strings: the length cannot change, so this writes a
    /// copy in place and allocates once whatever the text is.
    public static string Replace(string s, char what, char with) {
        string made = Sys.NewChars(s.Length);

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetChar(s, i);
            Sys.SetChar(made, i, c == (int)what ? (int)with : c);
        }
        return made;
    }

    public static char[] ToCharArray(string s) {
        char[] made = new char[s.Length];

        for (int i = 0; i < s.Length; i++) { made[i] = Sys.GetChar(s, i); }
        return made;
    }

    public static char[] ToCharArray(string s, int start, int count) {
        char[] made = new char[count];

        for (int i = 0; i < count; i++) { made[i] = Sys.GetChar(s, start + i); }
        return made;
    }

    // String.CopyTo(sourceIndex, destination, destinationIndex, count): the
    // characters from sourceIndex on into the array, as .NET copies them. A
    // range that is not wholly in the string and in the array is
    // ArgumentOutOfRangeException, before anything is copied.
    public static void CopyTo(string s, int sourceIndex, char[] destination, int destinationIndex, int count) {
        if (count < 0) { throw new ArgumentOutOfRangeException("count"); }
        if (sourceIndex < 0 || sourceIndex > s.Length - count) { throw new ArgumentOutOfRangeException("sourceIndex"); }
        if (destinationIndex < 0 || destinationIndex > destination.Length - count) { throw new ArgumentOutOfRangeException("destinationIndex"); }

        for (int i = 0; i < count; i++) { destination[destinationIndex + i] = Sys.GetChar(s, sourceIndex + i); }
    }

    // ---- trimming particular characters -----------------------------------
    //
    // .NET's Trim() with no argument trims white space; these trim exactly
    // what they are given, and trimming NOTHING is not the same as trimming
    // white space -- an empty set leaves the string alone.

    private static bool IsIn(char[] any, int ch) {
        for (int i = 0; i < any.Length; i++) {
            if ((int)any[i] == ch) { return true; }
        }
        return false;
    }

    // .NET's params forms: `s.TrimEnd('\r', '\n')`. No characters, or
    // null, trims white space, as String.TrimEnd(params char[]?) does.
    public static string TrimStart(string s, params char[]? any) {
        if (any == null || any.Length == 0) { return TrimStart(s); }
        int at = 0;
        while (at < s.Length && IsIn(any, Sys.GetChar(s, at))) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s, params char[]? any) {
        if (any == null || any.Length == 0) { return TrimEnd(s); }
        int end = s.Length;
        while (end > 0 && IsIn(any, Sys.GetChar(s, end - 1))) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s, params char[]? any) { return TrimEnd(TrimStart(s, any), any); }

    public static string TrimStart(string s, char one) {
        int at = 0;
        while (at < s.Length && Sys.GetChar(s, at) == (int)one) { at = at + 1; }
        return Substring(s, at, s.Length - at);
    }

    public static string TrimEnd(string s, char one) {
        int end = s.Length;
        while (end > 0 && Sys.GetChar(s, end - 1) == (int)one) { end = end - 1; }
        return Substring(s, 0, end);
    }

    public static string Trim(string s, char one) { return TrimEnd(TrimStart(s, one), one); }

    // ---- splitting --------------------------------------------------------
    //
    // BUILT INTO A LIST AND THEN COPIED OUT, rather than counted first and
    // filled second: options that drop or trim entries make the count depend
    // on the pieces themselves, so counting would mean splitting twice.

    private static string[] Finish(List<string> parts, StringSplitOptions options) {
        List<string> kept = new List<string>();

        for (int i = 0; i < parts.Count; i++) {
            string one = parts[i];
            if ((options & StringSplitOptions.TrimEntries) != StringSplitOptions.None) {
                one = Trim(one);
            }
            if ((options & StringSplitOptions.RemoveEmptyEntries) != StringSplitOptions.None
             && one.Length == 0) {
                continue;
            }
            kept.Add(one);
        }
        return kept.ToArray();
    }

    public static string[] Split(string s, char separator, StringSplitOptions options) {
        char[] one = new char[1];
        one[0] = separator;
        return Split(s, one, options);
    }

    public static string[] Split(string s, char[]? separators) {
        return Split(s, separators, StringSplitOptions.None);
    }

    public static string[] Split(string s, char[]? separators, StringSplitOptions options) {
        List<string> parts = new List<string>();
        int from = 0;
        // .NET's rule: no separators at all -- null or empty -- splits at
        // white space.
        bool white = separators == null || separators.Length == 0;

        for (int i = 0; i <= s.Length; i++) {
            if (i == s.Length || (white ? Char.IsWhiteSpace(Sys.GetChar(s, i)) : IsIn(separators!, Sys.GetChar(s, i)))) {
                parts.Add(Substring(s, from, i - from));
                from = i + 1;
            }
        }
        return Finish(parts, options);
    }

    public static string[] Split(string s, string separator) {
        return Split(s, separator, StringSplitOptions.None);
    }

    // A SEPARATOR OF NO CHARACTERS SPLITS NOTHING, which is .NET's answer:
    // the whole string comes back as the only piece. Anything else would be
    // an infinite loop dressed up as an empty-string rule.
    public static string[] Split(string s, string separator, StringSplitOptions options) {
        List<string> parts = new List<string>();

        if (separator.Length == 0) {
            parts.Add(s);
            return Finish(parts, options);
        }

        int from = 0;
        int at = 0;

        while (at + separator.Length <= s.Length) {
            if (Sys.StringEqual(s, at, separator, 0, separator.Length)) {
                parts.Add(Substring(s, from, at - from));
                at = at + separator.Length;
                from = at;
            } else {
                at = at + 1;
            }
        }
        parts.Add(Substring(s, from, s.Length - from));
        return Finish(parts, options);
    }

    public static string[] Split(string s, string[]? separators, StringSplitOptions options) {
        // No separators at all -- null or empty -- splits at white space, as
        // .NET's does; empty ones among them match nothing.
        if (separators == null || separators.Length == 0) return Split(s, (char[]?)null, options);
        List<string> parts = new List<string>();
        int from = 0;
        int at = 0;

        while (at < s.Length) {
            int hit = -1;

            for (int j = 0; j < separators.Length; j++) {
                string? sep = separators[j];
                if (sep != null && sep.Length > 0 && at + sep.Length <= s.Length
                 && Sys.StringEqual(s, at, sep, 0, sep.Length)) {
                    hit = j;
                    break;
                }
            }

            if (hit < 0) {
                at = at + 1;
                continue;
            }

            parts.Add(Substring(s, from, at - from));
            at = at + separators[hit].Length;
            from = at;
        }
        parts.Add(Substring(s, from, s.Length - from));
        return Finish(parts, options);
    }

    // THE TEXT REVERSED. .NET spells it `new string(s.Reverse().ToArray())`,
    // which is three allocations and a LINQ pipeline to turn a word round;
    // the name is String.Reverse in every other library on earth.
    public static string Reverse(string s) {
        string made = Sys.NewChars(s.Length);

        for (int i = 0; i < s.Length; i++) {
            Sys.SetChar(made, i, Sys.GetChar(s, s.Length - 1 - i));
        }
        return made;
    }
}

// ---- char, by the name C# gives its type -----------------------------------
//
// System.IO.Path, and it belongs in the standard library rather than behind
// CORSAC because it TOUCHES NOTHING. Every method here is string arithmetic on
// a name; none of them asks the filing system whether the thing exists, and
// that is true of the real System.IO.Path too. Path.Combine on a machine with
// no disc in it still answers.
//
// Separators are '/' only. This machine's filing system is MINIX and its shell
// is POSIX, so there is one separator and no drive letters; accepting '\\' as
// well would be inventing a convention rather than following one.

static partial class Path {
    public static char DirectorySeparatorChar = '/';

    /// Joins two paths. A SECOND PATH THAT IS ABSOLUTE WINS OUTRIGHT, which is
    /// the rule .NET uses and the one that makes `Combine(baseDir, userPath)`
    /// safe to write: a caller passing an absolute path meant it.
    public static string Combine(string path1, string path2) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path2.Length > 0 && path2[0] == '/') { return path2; }
        if (path1.Length == 0) { return path2; }
        if (path2.Length == 0) { return path1; }
        if (path1[path1.Length - 1] == '/') { return path1 + path2; }
        return path1 + "/" + path2;
    }

    /// Everything before the last separator, or null when there is none.
    ///
    /// NULL AND NOT EMPTY for a bare name, because those are different answers:
    /// "" is the current directory and null is "this name has no directory
    /// part". The assembler's include handling relies on the difference -- it
    /// falls back to the including file's directory when this says null.
    public static string? GetDirectoryName(string path) {
        long i = path.Length - 1;
        while (i >= 0 && path[(int)i] != '/') { i = i - 1; }
        if (i < 0) { return null; }
        if (i == 0) { return "/"; }
        return path.Substring(0, (int)i);
    }

    /// Everything after the last separator; the whole thing when there is none.
    public static string GetFileName(string path) {
        long i = path.Length - 1;
        while (i >= 0 && path[(int)i] != '/') { i = i - 1; }
        return path.Substring((int)(i + 1), (int)(path.Length - i - 1));
    }

    /// The extension INCLUDING its dot, or "" when there is none.
    ///
    /// A dot in a directory name does not count, and neither does a leading dot
    /// on the name itself: ".profile" has no extension, it is a hidden file.
    public static string GetExtension(string path) {
        string name = GetFileName(path);
        long i = name.Length - 1;
        while (i > 0 && name[(int)i] != '.') { i = i - 1; }
        if (i <= 0) { return ""; }
        return name.Substring((int)i, (int)(name.Length - i));
    }

    public static string GetFileNameWithoutExtension(string path) {
        string name = GetFileName(path);
        string ext = GetExtension(path);
        return name.Substring(0, (int)(name.Length - ext.Length));
    }

    /// The OTHER separator, which is the backslash even here: a program that
    /// splits a path on both of .NET's separators has to be able to name it,
    /// and Windows paths turn up in files this machine reads.
    public static char AltDirectorySeparatorChar = '\\';

    /// What separates one path from the next in a LIST of them -- PATH itself.
    /// A colon on Unix, where Windows uses a semicolon.
    public static char PathSeparator = ':';

    public static char VolumeSeparatorChar = ':';

    public static string Combine(string path1, string path2, string path3) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path3 == null) { throw new ArgumentNullException("path3"); }
        return Combine(Combine(path1, path2), path3);
    }

    public static string Combine(string path1, string path2, string path3, string path4) {
        if (path1 == null) { throw new ArgumentNullException("path1"); }
        if (path2 == null) { throw new ArgumentNullException("path2"); }
        if (path3 == null) { throw new ArgumentNullException("path3"); }
        if (path4 == null) { throw new ArgumentNullException("path4"); }
        return Combine(Combine(Combine(path1, path2), path3), path4);
    }

    /// Combines any number of path parts, validating every part even when a
    /// later absolute path discards it. Allocate only the final string.
    public static string Combine(params string[] paths) {
        if (paths == null) { throw new ArgumentNullException("paths"); }
        int start = 0;
        for (int i = 0; i < paths.Length; i++) {
            string part = paths[i];
            if (part == null) { throw new ArgumentNullException("paths"); }
            if (part.Length != 0 && part[0] == '/') { start = i; }
        }
        int length = 0;
        int pieces = 0;
        string last = "";
        for (int i = start; i < paths.Length; i++) {
            string part = paths[i];
            if (part.Length == 0) { continue; }
            checked {
                if (last.Length != 0 && last[last.Length - 1] != '/') { length++; }
                length += part.Length;
            }
            pieces++;
            last = part;
        }
        if (pieces < 2) { return last; }
        string result = Sys.NewChars(length);
        int at = 0;
        last = "";
        for (int i = start; i < paths.Length; i++) {
            string part = paths[i];
            if (part.Length == 0) { continue; }
            if (last.Length != 0 && last[last.Length - 1] != '/') {
                Sys.SetChar(result, at, 47);
                at++;
            }
            Sys.CopyNoOverlap(result, at, part, 0, part.Length);
            at += part.Length;
            last = part;
        }
        return result;
    }

    /// LIKE Combine, EXCEPT THAT A ROOTED SECOND PART DOES NOT WIN. Combine
    /// throws away everything before an absolute path -- Combine("a", "/b") is
    /// "/b" -- because it is joining a directory to a path that may be either.
    /// Join simply puts one separator between them, which is what a caller
    /// building a path out of parts meant all along.
    public static string Join(string a, string b) {
        if (a.Length == 0) { return b; }
        if (b.Length == 0) { return a; }

        bool ends = Sys.GetChar(a, a.Length - 1) == (int)'/';
        bool starts = Sys.GetChar(b, 0) == (int)'/';

        if (ends && starts) { return String.Concat(a, String.Substring(b, 1, b.Length - 1)); }
        if (ends || starts) { return String.Concat(a, b); }
        return String.Concat(a, String.Concat("/", b));
    }

    public static string Join(string a, string b, string c) { return Join(Join(a, b), c); }

    /// A NEW EXTENSION IN PLACE OF THE OLD ONE, or none at all when the new one
    /// is null -- which is how .NET spells "take the extension off".
    ///
    /// The result is null exactly where the path was, which is what .NET's
    /// [return: NotNullIfNotNull(nameof(path))] says: a caller who passed a
    /// string is handed one.
    [return: NotNullIfNotNull(nameof(path))]
    public static string? ChangeExtension(string? path, string? extension) {
        if (path == null) { return null; }

        int dot = -1;

        for (int i = path.Length - 1; i >= 0; i--) {
            int c = Sys.GetChar(path, i);

            if (c == (int)'/') { break; }
            if (c == (int)'.') { dot = i; break; }
        }

        string stem = dot < 0 ? path : String.Substring(path, 0, dot);

        if (extension == null) { return stem; }
        if (extension.Length == 0) { return stem; }
        if (Sys.GetChar(extension, 0) == (int)'.') { return String.Concat(stem, extension); }
        return String.Concat(stem, String.Concat(".", extension));
    }

    public static bool HasExtension(string path) { return GetExtension(path).Length > 0; }

    /// "/" for an absolute path and the empty string for a relative one, which
    /// is all a machine with one filing system has to say.
    public static string GetPathRoot(string path) {
        return IsPathRooted(path) ? "/" : "";
    }

    public static bool EndsInDirectorySeparator(string path) {
        return path.Length > 0 && Sys.GetChar(path, path.Length - 1) == (int)'/';
    }

    /// THE ROOT KEEPS ITS SLASH: "/" trimmed is still "/", because a path that
    /// is nothing but a separator has nothing left to be.
    public static string TrimEndingDirectorySeparator(string path) {
        if (path.Length <= 1 || !EndsInDirectorySeparator(path)) { return path; }
        return String.Substring(path, 0, path.Length - 1);
    }

    public static bool IsPathRooted(string path) {
        return path.Length > 0 && path[0] == '/';
    }
}

// `char.IsDigit(c)` reaches this the same way `int.TryParse` reaches Int32:
// the keyword is an alias for the type and the checker resolves it. ASCII,
// which is what this machine's console and filing system are.

static class Char {
    // Equals and GetHashCode as Char overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(char value, char other) { return value == other; }
    public static bool Equals(char value, object? other) { return other is char same && Equals(value, same); }
    public static int GetHashCode(char value) { return (int)value | ((int)value << 16); }
    // ---- Unicode, as .NET's char answers it ------------------------------
    //
    // A char is a UTF-16 code unit, and every question about one is answered
    // from the Unicode Character Database (the runtime's UnicodeCategories,
    // UnicodeCase and UnicodeNumerics tables) -- the same answers .NET gives,
    // for Greek and CJK and the rest as much as for ASCII. A surrogate half is
    // a code unit with no character of its own: category Surrogate, no case.

    /// A code point as the one or two UTF-16 units that spell it.
    public static string ConvertFromUtf32(int utf32) {
        if (utf32 < 0 || utf32 > 0x10FFFF || (utf32 >= 0xD800 && utf32 <= 0xDFFF)) {
            throw new ArgumentOutOfRangeException("utf32", "A valid UTF32 value is between 0x000000 and 0x10ffff, inclusive, and should not include surrogate codepoint values (0x00d800 ~ 0x00dfff).");
        }
        if (utf32 < 0x10000) { return new string((char)utf32, 1); }
        int v = utf32 - 0x10000;
        return new string(new char[] { (char)(0xD800 + (v >> 10)), (char)(0xDC00 + (v & 0x3FF)) });
    }

    /// The code point a surrogate pair spells.
    public static int ConvertToUtf32(char highSurrogate, char lowSurrogate) {
        if (!IsHighSurrogate(highSurrogate)) { throw new ArgumentOutOfRangeException("highSurrogate", "A valid high surrogate character is between 0xd800 and 0xdbff, inclusive."); }
        if (!IsLowSurrogate(lowSurrogate)) { throw new ArgumentOutOfRangeException("lowSurrogate", "A valid low surrogate character is between 0xdc00 and 0xdfff, inclusive."); }
        return 0x10000 + ((highSurrogate - 0xD800) << 10) + (lowSurrogate - 0xDC00);
    }

    /// The code point at s[index]: the unit itself, or the pair starting there.
    public static int ConvertToUtf32(string s, int index) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (index < 0 || index >= s.Length) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection."); }
        char c = s[index];
        if (!IsSurrogate(c)) { return c; }
        if (IsHighSurrogate(c) && index + 1 < s.Length && IsLowSurrogate(s[index + 1])) {
            return ConvertToUtf32(c, s[index + 1]);
        }
        throw new ArgumentException("Found a" + (IsHighSurrogate(c) ? " high" : " low") + " surrogate char without a following low surrogate at index: " + index + ". The input may not be in this encoding, or may not contain valid Unicode (UTF-16) characters.", "s");
    }

    public static int CompareTo(char value, char other) { return value - other; }
    public static int CompareTo(char value, object? other) {
        if (other == null) return 1;
        if (other is char number) return CompareTo(value, number);
        throw new ArgumentException("Object must be of type Char.");
    }

    public static UnicodeCategory GetUnicodeCategory(char c) { return (UnicodeCategory)UnicodeCategories.Of(c); }
    public static UnicodeCategory GetUnicodeCategory(string s, int index) {
        CheckIndex(s, index);
        return (UnicodeCategory)UnicodeCategories.Of(CodePointAt(s, index));
    }

    /// The value Unicode gives a numeric character -- a digit's, a fraction's,
    /// a Roman numeral's -- or -1.
    public static double GetNumericValue(char c) { return UnicodeNumerics.Of(c); }
    public static double GetNumericValue(string s, int index) {
        CheckIndex(s, index);
        return UnicodeNumerics.Of(CodePointAt(s, index));
    }

    public static bool IsDigit(char c) { return c <= 0x7F ? c >= '0' && c <= '9' : Category(c) == 8; }
    public static bool IsLetter(char c) {
        if (c <= 0x7F) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
        return Category(c) <= 4;
    }
    public static bool IsLetterOrDigit(char c) { return IsLetter(c) || IsDigit(c); }
    public static bool IsNumber(char c) { int k = Category(c); return k >= 8 && k <= 10; }
    public static bool IsUpper(char c) { return c <= 0x7F ? c >= 'A' && c <= 'Z' : Category(c) == 0; }
    public static bool IsLower(char c) { return c <= 0x7F ? c >= 'a' && c <= 'z' : Category(c) == 1; }
    public static bool IsControl(char c) { return Category(c) == 14; }
    public static bool IsSeparator(char c) { int k = Category(c); return k >= 11 && k <= 13; }
    public static bool IsPunctuation(char c) { int k = Category(c); return k >= 18 && k <= 24; }
    public static bool IsSymbol(char c) { int k = Category(c); return k >= 25 && k <= 28; }

    /// White space as .NET defines it: the separators, and the C0 and C1
    /// characters U+0009 to U+000D and U+0085, which Unicode files as controls.
    public static bool IsWhiteSpace(char c) {
        if (c == ' ' || (c >= '\t' && c <= '\r') || c == (char)0x85 || c == (char)0xA0) { return true; }
        if (c < 0x100) { return false; }
        return IsSeparator(c);
    }

    public static bool IsSurrogate(char c) { return c >= 0xD800 && c <= 0xDFFF; }
    public static bool IsHighSurrogate(char c) { return c >= 0xD800 && c <= 0xDBFF; }
    public static bool IsLowSurrogate(char c) { return c >= 0xDC00 && c <= 0xDFFF; }
    public static bool IsSurrogatePair(char highSurrogate, char lowSurrogate) {
        return IsHighSurrogate(highSurrogate) && IsLowSurrogate(lowSurrogate);
    }

    // The same questions of the character at s[index], which for a surrogate
    // pair is the pair's character.
    public static bool IsDigit(string s, int index) { return CategoryAt(s, index) == 8; }
    public static bool IsLetter(string s, int index) { return CategoryAt(s, index) <= 4; }
    public static bool IsLetterOrDigit(string s, int index) { int k = CategoryAt(s, index); return k <= 4 || k == 8; }
    public static bool IsNumber(string s, int index) { int k = CategoryAt(s, index); return k >= 8 && k <= 10; }
    public static bool IsUpper(string s, int index) { return CategoryAt(s, index) == 0; }
    public static bool IsLower(string s, int index) { return CategoryAt(s, index) == 1; }
    public static bool IsControl(string s, int index) { return CategoryAt(s, index) == 14; }
    public static bool IsSeparator(string s, int index) { int k = CategoryAt(s, index); return k >= 11 && k <= 13; }
    public static bool IsPunctuation(string s, int index) { int k = CategoryAt(s, index); return k >= 18 && k <= 24; }
    public static bool IsSymbol(string s, int index) { int k = CategoryAt(s, index); return k >= 25 && k <= 28; }
    public static bool IsWhiteSpace(string s, int index) { CheckIndex(s, index); return IsWhiteSpace(s[index]); }
    public static bool IsSurrogate(string s, int index) { CheckIndex(s, index); return IsSurrogate(s[index]); }
    public static bool IsHighSurrogate(string s, int index) { CheckIndex(s, index); return IsHighSurrogate(s[index]); }
    public static bool IsLowSurrogate(string s, int index) { CheckIndex(s, index); return IsLowSurrogate(s[index]); }
    public static bool IsSurrogatePair(string s, int index) {
        CheckIndex(s, index);
        return index + 1 < s.Length && IsSurrogatePair(s[index], s[index + 1]);
    }

    // Case: the invariant simple mappings. With one culture on this machine,
    // the culture-sensitive pair is the invariant one.
    public static char ToUpper(char c) { return (char)UnicodeCase.Upper(c); }
    public static char ToLower(char c) { return (char)UnicodeCase.Lower(c); }
    public static char ToUpper(char c, CultureInfo culture) { return ToUpper(c); }
    public static char ToLower(char c, CultureInfo culture) { return ToLower(c); }
    public static char ToUpperInvariant(char c) { return ToUpper(c); }
    public static char ToLowerInvariant(char c) { return ToLower(c); }

    // .NET's explicitly-ASCII predicates: code that means ASCII says so.
    public static bool IsAscii(char c) { return c <= (char)127; }
    public static bool IsAsciiDigit(char c) { return c >= '0' && c <= '9'; }
    public static bool IsAsciiLetter(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
    public static bool IsAsciiLetterOrDigit(char c) { return IsAsciiLetter(c) || IsAsciiDigit(c); }
    public static bool IsAsciiLetterUpper(char c) { return c >= 'A' && c <= 'Z'; }
    public static bool IsAsciiLetterLower(char c) { return c >= 'a' && c <= 'z'; }
    public static bool IsAsciiHexDigit(char c) {
        return IsAsciiDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }
    public static bool IsAsciiHexDigitUpper(char c) { return IsAsciiDigit(c) || (c >= 'A' && c <= 'F'); }
    public static bool IsAsciiHexDigitLower(char c) { return IsAsciiDigit(c) || (c >= 'a' && c <= 'f'); }
    public static bool IsBetween(char c, char minInclusive, char maxInclusive) {
        return (uint)(c - minInclusive) <= (uint)(maxInclusive - minInclusive);
    }

    public static char Parse(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (s.Length != 1) { throw new FormatException("String must be exactly one character long."); }
        return s[0];
    }
    public static bool TryParse(string? s, out char result) {
        if (s == null || s.Length != 1) { result = (char)0; return false; }
        result = s[0];
        return true;
    }

    /// `c.ToString()`: the string of one character.
    public static string ToString(this char c) { return String.FromByte((long)c); }

    private static int Category(char c) { return UnicodeCategories.Of(c); }
    private static int CategoryAt(string s, int index) { CheckIndex(s, index); return UnicodeCategories.Of(CodePointAt(s, index)); }

    /// The pair's code point where s[index] begins one, else the unit.
    private static int CodePointAt(string s, int index) {
        char c = s[index];
        if (IsHighSurrogate(c) && index + 1 < s.Length && IsLowSurrogate(s[index + 1])) {
            return ConvertToUtf32(c, s[index + 1]);
        }
        return c;
    }

    private static void CheckIndex(string s, int index) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (index < 0 || index >= s.Length) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection."); }
    }
}

// .NET puts IsHexDigit on Uri, of all places, and this compiler's own lexer
// calls it there. The name is the part that has to match.
/// WHAT A URI MAY BE: a whole one, or a piece to be resolved against another.
enum UriKind {
    RelativeOrAbsolute = 0,
    Absolute = 1,
    Relative = 2,
}

/// A URI, TAKEN APART. scheme://user@host:port/path?query#fragment, each piece
/// named as .NET names it -- which is not as RFC 3986 names them: .NET's Query
/// KEEPS its '?' and its Fragment keeps its '#', so that joining the pieces
/// back up is concatenation and not a reconstruction.
///
/// The path is NORMALISED as .NET normalises it: "/a/../b" is "/b", because a
/// caller comparing two URIs for equality means the same resource and not the
/// same spelling.
class Uri {
    private string scheme;
    private string userInfo;
    private string host;
    private int port;
    private string path;
    private string query;
    private string fragment;
    private bool absolute;

    public Uri(string text) {
        if (text == null) { throw new ArgumentNullException("uriString"); }

        scheme = "";
        userInfo = "";
        host = "";
        port = -1;
        path = "";
        query = "";
        fragment = "";
        absolute = false;
        Parse(text);

        if (!absolute) {
            throw new UriFormatException("Invalid URI: The format of the URI could not be determined.");
        }
    }

    private Uri() {
        scheme = "";
        userInfo = "";
        host = "";
        port = -1;
        path = "";
        query = "";
        fragment = "";
    }

    public string Scheme => scheme;
    public string Host => host;
    public string UserInfo => userInfo;
    public bool IsAbsoluteUri => absolute;
    public string AbsolutePath => path;

    /// THE PATH AS A FILE NAME, which on this machine is the path itself: a
    /// Windows .NET turns file:///C:/x into C:\x, and here there is nothing to
    /// turn.
    public string LocalPath => path;

    public string Query => query;
    public string Fragment => fragment;

    /// THE PORT THE SCHEME MEANS when none was written: 80 for http, 443 for
    /// https, 21 for ftp. .NET reports the default rather than -1, which is
    /// what makes `new Uri("http://x").Port` 80.
    public int Port => port >= 0 ? port : DefaultPort(scheme);

    public bool IsDefaultPort => port < 0 || port == DefaultPort(scheme);

    public string Authority {
        get {
            if (port < 0 || port == DefaultPort(scheme)) { return host; }
            return String.Concat(host, String.Concat(":", String.FromInt(port)));
        }
    }

    public string PathAndQuery => String.Concat(path, query);

    /// THE PATH, CUT AFTER EACH SLASH, each piece keeping the slash that ended
    /// it -- "/a/b/c.html" is "/", "a/", "b/", "c.html". An odd shape until you
    /// notice that concatenating them gives the path back.
    public string[] Segments {
        get {
            List<string> made = new List<string>();
            int at = 0;

            while (at < path.Length) {
                int slash = String.IndexOf(path, '/', at);

                if (slash < 0) {
                    made.Add(String.Substring(path, at, path.Length - at));
                    break;
                }
                made.Add(String.Substring(path, at, slash - at + 1));
                at = slash + 1;
            }
            return made.ToArray();
        }
    }

    public string AbsoluteUri {
        get {
            StringBuilder made = new StringBuilder();

            made.Append(scheme);
            made.Append("://");
            if (userInfo.Length > 0) {
                made.Append(userInfo);
                made.Append('@');
            }
            made.Append(host);
            if (port >= 0 && port != DefaultPort(scheme)) {
                made.Append(':');
                made.Append(port);
            }
            made.Append(path.Length == 0 ? "/" : path);
            made.Append(query);
            made.Append(fragment);
            return made.ToString();
        }
    }

    public string ToString() { return AbsoluteUri; }

    public static bool TryCreate(string text, UriKind kind, out Uri? result) {
        result = null;

        if (text == null) { return false; }

        Uri made = new Uri();

        made.Parse(text);

        if (kind == UriKind.Absolute && !made.IsAbsoluteUri) { return false; }
        if (kind == UriKind.Relative && made.IsAbsoluteUri) { return false; }

        result = made;
        return true;
    }

    // ---- the pieces -------------------------------------------------------

    private void Parse(string text) {
        string rest = text;
        int mark = String.IndexOf(rest, '#');

        if (mark >= 0) {
            fragment = String.Substring(rest, mark, rest.Length - mark);
            rest = String.Substring(rest, 0, mark);
        }

        int ask = String.IndexOf(rest, '?');

        if (ask >= 0) {
            query = String.Substring(rest, ask, rest.Length - ask);
            rest = String.Substring(rest, 0, ask);
        }

        int colon = String.IndexOf(rest, ':');

        if (colon > 0 && colon + 2 < rest.Length
            && Sys.GetChar(rest, colon + 1) == (int)'/' && Sys.GetChar(rest, colon + 2) == (int)'/') {
            scheme = String.ToLowerInvariant(String.Substring(rest, 0, colon));
            absolute = true;
            rest = String.Substring(rest, colon + 3, rest.Length - colon - 3);

            int slash = String.IndexOf(rest, '/');
            string authority = slash < 0 ? rest : String.Substring(rest, 0, slash);

            path = slash < 0 ? "/" : String.Substring(rest, slash, rest.Length - slash);

            int at = String.IndexOf(authority, '@');

            if (at >= 0) {
                userInfo = String.Substring(authority, 0, at);
                authority = String.Substring(authority, at + 1, authority.Length - at - 1);
            }

            int portAt = String.IndexOf(authority, ':');

            if (portAt >= 0) {
                host = String.Substring(authority, 0, portAt);
                port = Int32.Parse(String.Substring(authority, portAt + 1, authority.Length - portAt - 1));
            } else {
                host = authority;
            }
        } else {
            path = rest;
        }
        path = Normalise(path);
    }

    /// "." AND ".." RESOLVED, because two URIs that name the same resource
    /// must compare equal and a path with a ".." in it names something else's
    /// spelling of the same place.
    private static string Normalise(string value) {
        if (String.IndexOf(value, '.') < 0) { return value; }

        bool rooted = value.Length > 0 && Sys.GetChar(value, 0) == (int)'/';
        bool trailing = value.Length > 1 && Sys.GetChar(value, value.Length - 1) == (int)'/';
        string[] parts = String.Split(value, '/');
        List<string> kept = new List<string>();

        for (int i = 0; i < parts.Length; i++) {
            string one = parts[i];

            if (one.Length == 0 || String.Compare(one, ".") == 0) { continue; }
            if (String.Compare(one, "..") == 0) {
                if (kept.Count > 0) { kept.RemoveAt(kept.Count - 1); }
                continue;
            }
            kept.Add(one);
        }

        StringBuilder made = new StringBuilder();

        if (rooted) { made.Append('/'); }
        for (int i = 0; i < kept.Count; i++) {
            if (i > 0) { made.Append('/'); }
            made.Append(kept[i]);
        }
        if (trailing && kept.Count > 0) { made.Append('/'); }
        return made.ToString();
    }

    private static int DefaultPort(string forScheme) {
        if (String.Compare(forScheme, "http") == 0) { return 80; }
        if (String.Compare(forScheme, "https") == 0) { return 443; }
        if (String.Compare(forScheme, "ftp") == 0) { return 21; }
        if (String.Compare(forScheme, "ssh") == 0) { return 22; }
        if (String.Compare(forScheme, "telnet") == 0) { return 23; }
        if (String.Compare(forScheme, "smtp") == 0) { return 25; }
        return -1;
    }

    // ---- escaping ---------------------------------------------------------

    /// PERCENT-ESCAPES EVERYTHING that is not unreserved -- letters, digits and
    /// `-._~` -- which is what a value going INTO a query string needs: a '&'
    /// or a '/' left alone there would be read as structure. A character
    /// outside ASCII is escaped as its UTF-8 bytes, one %XX each, as RFC 3986
    /// and .NET have it.
    public static string EscapeDataString(string value) {
        if (value == null) { throw new ArgumentNullException("stringToEscape"); }

        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();
        byte[] bytes = Utf8Transcoder.Encode(value, 0, value.Length);

        for (int i = 0; i < bytes.Length; i++) {
            int c = bytes[i];

            if ((c >= (int)'a' && c <= (int)'z') || (c >= (int)'A' && c <= (int)'Z')
                || (c >= (int)'0' && c <= (int)'9')
                || c == (int)'-' || c == (int)'.' || c == (int)'_' || c == (int)'~') {
                made.Append((char)c);
                continue;
            }
            made.Append('%');
            made.Append(alphabet[c >> 4]);
            made.Append(alphabet[c & 15]);
        }
        return made.ToString();
    }

    /// Every %XX back to its byte, and each run of such bytes decoded as
    /// UTF-8. A byte that begins no well-formed sequence is left as the %XX
    /// it was written as, which is what .NET does with one.
    public static string UnescapeDataString(string value) {
        if (value == null) { throw new ArgumentNullException("stringToUnescape"); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < value.Length) {
            if (!EscapeAt(value, at)) {
                made.Append(value[at]);
                at = at + 1;
                continue;
            }

            // The whole run of escapes, as bytes.
            int runStart = at;
            List<byte> run = new List<byte>();
            while (EscapeAt(value, at)) {
                run.Add((byte)(NumberParse.DigitOf(value[at + 1]) * 16 + NumberParse.DigitOf(value[at + 2])));
                at = at + 3;
            }

            byte[] bytes = run.ToArray();
            int i = 0;
            while (i < bytes.Length) {
                Rune rune;
                int used;
                System.Buffers.OperationStatus status = Rune.DecodeFromUtf8(new ReadOnlySpan<byte>(bytes, i, bytes.Length - i), out rune, out used);
                if (status == System.Buffers.OperationStatus.Done) {
                    made.Append(rune.ToString());
                    i = i + used;
                    continue;
                }
                made.Append(value, runStart + i * 3, 3);
                i = i + 1;
            }
        }
        return made.ToString();
    }

    private static bool EscapeAt(string value, int at) {
        return at + 2 < value.Length && value[at] == '%' && IsHexDigit(value[at + 1]) && IsHexDigit(value[at + 2]);
    }

    public static bool IsHexDigit(char c) {
        return Char.IsDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    public static bool IsWellFormedUriString(string text, UriKind kind) {
        Uri? made = null;

        return TryCreate(text, kind, out made);
    }
}

/// The URI could not be read. .NET derives it from FormatException, and a
/// program catching that catches this.
class UriFormatException : FormatException {
    public UriFormatException() : base("Invalid URI: The format of the URI could not be determined.") { }
    public UriFormatException(string message) : base(message) { }
}

// .NET's Convert, with the two members this machine has any use for: text in
// some base to a number, and a number to text in some base. A lexer reading
// `\u0041` calls the first with sixteen.
static class Convert {
    public static int ToInt32(string s, int fromBase) {
        int value = 0;

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetChar(s, i);
            int digit = 0 - 1;

            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 122) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 90) { digit = c - 65 + 10; }

            if (digit < 0 || digit >= fromBase) { return value; }

            value = value * fromBase + digit;
        }
        return value;
    }

    public static ulong ToUInt64(string s, int fromBase) {
        ulong value = 0;

        for (int i = 0; i < s.Length; i++) {
            int c = Sys.GetChar(s, i);
            int digit = -1;

            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 122) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 90) { digit = c - 65 + 10; }
            if (digit < 0 || digit >= fromBase) { throw new FormatException("invalid digit"); }

            ulong next = value * (ulong)fromBase + (ulong)digit;
            if (next < value) { throw new OverflowException("integer is too large"); }
            value = next;
        }
        return value;
    }

    // ---- the conversions a program actually writes ------------------------
    //
    // .NET's Convert is a wall of overloads, one per pair of types, and the
    // reason it exists at all rather than everybody writing casts is that a
    // cast TRUNCATES and Convert ROUNDS -- to the even neighbour, like
    // Math.Round -- and that a value too large for the destination is an
    // OverflowException here and silent nonsense there.

    public static int ToInt32(string value) { return Int32.Parse(value); }
    /// Any object, as .NET's IConvertible path takes it: null is 0, a number
    /// is converted with its range checked, a bool is 1 or 0, a char its code,
    /// a string parsed; anything else is no number at all.
    public static int ToInt32(object? value) {
        if (value == null) { return 0; }
        if (value is int i) { return i; }
        if (value is string s) { return Int32.Parse(s); }
        if (value is bool b) { return b ? 1 : 0; }
        if (value is char c) { return c; }
        if (value is double d) { return ToInt32(d); }
        if (value is float f) { return ToInt32((double)f); }
        return checked((int)ObjectInteger(value));
    }
    public static long ToInt64(object? value) {
        if (value == null) { return 0; }
        if (value is long l) { return l; }
        if (value is string s) { return Int64.Parse(s); }
        if (value is bool b) { return b ? 1 : 0; }
        if (value is char c) { return c; }
        if (value is double d) { return ToInt64(d); }
        if (value is float f) { return ToInt64((double)f); }
        return ObjectInteger(value);
    }
    /// A boxed integer of any width as a long; ulong past long's range and
    /// anything not an integer are refused as .NET refuses them.
    static long ObjectInteger(object value) {
        if (value is int i) { return i; }
        if (value is long l) { return l; }
        if (value is short sh) { return sh; }
        if (value is sbyte sb) { return sb; }
        if (value is byte by) { return by; }
        if (value is ushort us) { return us; }
        if (value is uint ui) { return ui; }
        if (value is ulong ul) { if (ul > (ulong)long.MaxValue) { throw new OverflowException("Value was either too large or too small for an Int64."); } return (long)ul; }
        throw new InvalidCastException("Unable to cast object of type '" + String.TypeText(value.GetType().FullName) + "' to type 'System.IConvertible'.");
    }
    public static long ToInt64(string value) { return Int64.Parse(value); }
    public static long ToInt64(string value, int fromBase) { return (long)ToUInt64(value, fromBase); }

    // The other widths in a base, as .NET has them: the digits read whole,
    // and too many for the width an OverflowException. In base 2, 8 and 16
    // .NET reads a signed type's top bit as its sign ("FF" is -1 as an
    // sbyte), and so do these.
    public static byte ToByte(string value, int fromBase) { return (byte)Within(value, fromBase, 0xFF, "an unsigned byte"); }
    public static ushort ToUInt16(string value, int fromBase) { return (ushort)Within(value, fromBase, 0xFFFF, "a UInt16"); }
    public static uint ToUInt32(string value, int fromBase) { return (uint)Within(value, fromBase, 0xFFFFFFFF, "a UInt32"); }
    public static sbyte ToSByte(string value, int fromBase) { return (sbyte)(byte)Within(value, fromBase, 0xFF, "a signed byte"); }
    public static short ToInt16(string value, int fromBase) { return (short)(ushort)Within(value, fromBase, 0xFFFF, "an Int16"); }

    static ulong Within(string value, int fromBase, ulong most, string what) {
        if (fromBase != 2 && fromBase != 8 && fromBase != 10 && fromBase != 16) { throw new ArgumentException("Invalid Base.", "fromBase"); }
        if (value.Length == 0) { throw new FormatException("Could not find any recognizable digits."); }
        string digits = fromBase == 16 && value.Length > 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X') ? value.Substring(2) : value;
        ulong got = ToUInt64(digits, fromBase);
        if (got > most) { throw new OverflowException("Value was either too large or too small for " + what + "."); }
        return got;
    }
    public static double ToDouble(string value) { return Double.Parse(value); }

    public static int ToInt32(double value) { return (int)Checked(Math.Round(value), -2147483648.0, 2147483647.0, "Int32"); }
    public static long ToInt64(double value) { return (long)Checked(Math.Round(value), -9223372036854775808.0, 9223372036854775807.0, "Int64"); }
    public static int ToInt32(long value) { return (int)Checked((double)value, -2147483648.0, 2147483647.0, "Int32"); }
    public static short ToInt16(long value) { return (short)Checked((double)value, -32768.0, 32767.0, "Int16"); }
    public static byte ToByte(long value) { return (byte)Checked((double)value, 0.0, 255.0, "unsigned byte"); }
    public static sbyte ToSByte(long value) { return (sbyte)Checked((double)value, -128.0, 127.0, "signed byte"); }

    public static int ToInt32(bool value) { return value ? 1 : 0; }
    public static double ToDouble(long value) { return (double)value; }

    /// "True" and "False" in any case, which is the only text .NET's
    /// ToBoolean(string) accepts -- "1" and "yes" are a FormatException.
    public static bool ToBoolean(string value) {
        if (value == null) { throw new ArgumentNullException("value"); }

        string folded = String.ToLowerInvariant(value);

        if (String.Compare(folded, "true") == 0) { return true; }
        if (String.Compare(folded, "false") == 0) { return false; }
        throw new FormatException("String was not recognized as a valid Boolean.");
    }

    public static string ToString(long value) { return String.FromInt(value); }
    public static string ToString(bool value) { return value ? "True" : "False"; }

    // A range check that says what .NET says, over doubles because that is the
    // one type every integral value fits in exactly up to 2^53 -- which is
    // where these conversions stop being interesting anyway.
    private static double Checked(double value, double low, double high, string what) {
        if (value < low || value > high) {
            throw new OverflowException(String.Concat("Value was either too large or too small for an ",
                                                      String.Concat(what, ".")));
        }
        return value;
    }

    // ---- base 64 ----------------------------------------------------------
    //
    // THREE BYTES BECOME FOUR CHARACTERS, six bits at a time, and the tail is
    // padded with '=' to keep the length a multiple of four. It is how binary
    // travels through anything that expects text -- a certificate, a mail
    // attachment, a JSON document -- and the alphabet is fixed by RFC 4648, so
    // this and .NET produce the same string byte for byte.
    public static string ToBase64String(byte[] bytes) {
        return ToBase64String(bytes, 0, bytes.Length);
    }

    public static string ToBase64String(byte[] bytes, int offset, int length) {
        string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder made = new StringBuilder();
        int at = offset;
        int end = offset + length;

        while (at < end) {
            int first = bytes[at] & 255;
            int second = at + 1 < end ? bytes[at + 1] & 255 : 0;
            int third = at + 2 < end ? bytes[at + 2] & 255 : 0;
            int block = (first << 16) | (second << 8) | third;

            made.Append(Sys.GetChar(alphabet, (block >> 18) & 63));
            made.Append(Sys.GetChar(alphabet, (block >> 12) & 63));
            made.Append(at + 1 < end ? Sys.GetChar(alphabet, (block >> 6) & 63) : '=');
            made.Append(at + 2 < end ? Sys.GetChar(alphabet, block & 63) : '=');
            at = at + 3;
        }
        return made.ToString();
    }

    public static byte[] FromBase64String(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }

        int[] values = new int[text.Length];
        int count = 0;

        for (int i = 0; i < text.Length; i++) {
            char c = Sys.GetChar(text, i);
            int value = Base64Value(c);

            // WHITESPACE IS IGNORED and padding ends the data, both of which
            // .NET's decoder does: base 64 arrives wrapped at 76 columns more
            // often than not.
            if (c == ' ' || c == '\n' || c == '\r' || c == '\t') { continue; }
            if (c == '=') { break; }
            if (value < 0) { throw new FormatException("The input is not a valid Base-64 string."); }

            values[count] = value;
            count = count + 1;
        }

        int whole = count / 4;
        int leftover = count % 4;
        int size = whole * 3 + (leftover == 0 ? 0 : leftover - 1);
        byte[] made = new byte[size];
        int written = 0;
        int at = 0;

        while (at + 3 < count) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6) | values[at + 3];

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
            made[written + 2] = (byte)(block & 255);
            written = written + 3;
            at = at + 4;
        }

        if (leftover == 2) {
            made[written] = (byte)(((values[at] << 18) | (values[at + 1] << 12)) >> 16);
        } else if (leftover == 3) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6);

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
        } else if (leftover == 1) {
            throw new FormatException("The input is not a valid Base-64 string.");
        }
        return made;
    }

    private static int Base64Value(char c) {
        if (c >= 'A' && c <= 'Z') { return c - 'A'; }
        if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
        if (c >= '0' && c <= '9') { return c - '0' + 52; }
        if (c == '+') { return 62; }
        if (c == '/') { return 63; }
        return -1;
    }

    /// UPPER CASE AND NO SEPARATORS, which is where .NET 5's ToHexString
    /// differs from BitConverter.ToString: the same bytes, without the dashes.
    public static string ToHexString(byte[] bytes) {
        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < bytes.Length; i++) {
            int value = bytes[i] & 255;

            made.Append(Sys.GetChar(alphabet, value >> 4));
            made.Append(Sys.GetChar(alphabet, value & 15));
        }
        return made.ToString();
    }

    public static byte[] FromHexString(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }
        if (text.Length % 2 != 0) {
            throw new FormatException("The input is not a valid hex string as its length is not a multiple of 2.");
        }

        byte[] made = new byte[text.Length / 2];

        for (int i = 0; i < made.Length; i++) {
            int high = NumberParse.DigitOf(Sys.GetChar(text, i * 2));
            int low = NumberParse.DigitOf(Sys.GetChar(text, i * 2 + 1));

            if (high < 0 || high > 15 || low < 0 || low > 15) {
                throw new FormatException("The input is not a valid hex string as it contains a non-hex character.");
            }
            made[i] = (byte)(high * 16 + low);
        }
        return made;
    }

    public static string ToString(long value, int toBase) {
        if (value == 0) { return "0"; }

        string digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        string made = "";
        long left = value;

        while (left > 0) {
            made = String.Concat(String.Substring(digits, (int)(left % toBase), 1), made);
            left = left / toBase;
        }
        return made;
    }
}

// .NET's BitConverter, with the four members that reinterpret a number's BITS
// rather than convert its value -- which is what a compiler does to put a
// double in an image and take it out again.
static class BitConverter {
    public static long DoubleToInt64Bits(double value) { return Sys.Bits(value); }
    public static double Int64BitsToDouble(long value) { return Sys.FromBits(value); }
    public static int SingleToInt32Bits(float value) { return Sys.SingleBits(value); }
    public static float Int32BitsToSingle(int value) { return Sys.FromSingleBits(value); }

    /// TRUE, and it is a fact about the processor rather than a choice: every
    /// machine this compiler targets stores the little end first. A program
    /// writing a format that is big-endian on the wire reads this and swaps.
    public static bool IsLittleEndian => true;

    // ---- a number as its bytes -------------------------------------------
    //
    // LITTLE END FIRST, which is what the machine holds them as, so what comes
    // back is the number's storage and not a rendering of it. This is the pair
    // a file format and a network protocol are written with.

    // ---- into a span the caller has ------------------------------------------
    //
    // .NET's TryWriteBytes: the value's bytes, little end first, written into
    // the start of `destination` when it holds that many, and false with
    // nothing written when it does not. No array is made.

    static bool Put(Span<byte> destination, long value, int count) {
        if (destination.Length < count) { return false; }
        for (int i = 0; i < count; i++) { destination[i] = (byte)(value >> (8 * i)); }
        return true;
    }

    public static bool TryWriteBytes(Span<byte> destination, bool value) { return Put(destination, value ? 1 : 0, 1); }
    public static bool TryWriteBytes(Span<byte> destination, char value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, short value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, ushort value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, int value) { return Put(destination, (long)value, 4); }
    public static bool TryWriteBytes(Span<byte> destination, uint value) { return Put(destination, (long)value, 4); }
    public static bool TryWriteBytes(Span<byte> destination, long value) { return Put(destination, value, 8); }
    public static bool TryWriteBytes(Span<byte> destination, ulong value) { return Put(destination, (long)value, 8); }
    public static bool TryWriteBytes(Span<byte> destination, float value) { return Put(destination, (long)SingleToInt32Bits(value), 4); }
    public static bool TryWriteBytes(Span<byte> destination, double value) { return Put(destination, Sys.Bits(value), 8); }

    public static byte[] GetBytes(bool value) {
        byte[] made = new byte[1];

        made[0] = (byte)(value ? 1 : 0);
        return made;
    }

    public static byte[] GetBytes(char value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(short value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(ushort value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(int value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(uint value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(long value) { return Spread(value, 8); }
    public static byte[] GetBytes(ulong value) { return Spread((long)value, 8); }
    public static byte[] GetBytes(double value) { return Spread(Sys.Bits(value), 8); }
    public static byte[] GetBytes(float value) { return Spread((long)SingleToInt32Bits(value), 4); }

    public static bool ToBoolean(byte[] bytes, int at) { return bytes[at] != 0; }
    public static char ToChar(byte[] bytes, int at) { return (char)Gather(bytes, at, 2, false); }
    public static short ToInt16(byte[] bytes, int at) { return (short)Gather(bytes, at, 2, true); }
    public static ushort ToUInt16(byte[] bytes, int at) { return (ushort)Gather(bytes, at, 2, false); }
    public static int ToInt32(byte[] bytes, int at) { return (int)Gather(bytes, at, 4, true); }
    public static uint ToUInt32(byte[] bytes, int at) { return (uint)Gather(bytes, at, 4, false); }
    public static long ToInt64(byte[] bytes, int at) { return Gather(bytes, at, 8, true); }
    public static ulong ToUInt64(byte[] bytes, int at) { return (ulong)Gather(bytes, at, 8, true); }
    public static double ToDouble(byte[] bytes, int at) { return Sys.FromBits(Gather(bytes, at, 8, true)); }
    public static float ToSingle(byte[] bytes, int at) { return Int32BitsToSingle((int)Gather(bytes, at, 4, true)); }

    /// THE BYTES IN CAPITALS, SEPARATED BY DASHES -- "00-11-FF". An odd shape
    /// for a ToString until you have read a dump written by one, which is what
    /// it is for; Convert.ToHexString is the same bytes without the dashes.
    public static string ToString(byte[] bytes) { return ToString(bytes, 0, bytes.Length); }

    public static string ToString(byte[] bytes, int at) { return ToString(bytes, at, bytes.Length - at); }

    public static string ToString(byte[] bytes, int at, int count) {
        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < count; i++) {
            int value = bytes[at + i] & 255;

            if (i > 0) { made.Append('-'); }
            made.Append(Sys.GetChar(alphabet, value >> 4));
            made.Append(Sys.GetChar(alphabet, value & 15));
        }
        return made.ToString();
    }

    private static byte[] Spread(long value, int width) {
        byte[] made = new byte[width];

        for (int i = 0; i < width; i++) { made[i] = (byte)((value >> (i * 8)) & 255); }
        return made;
    }

    private static long Gather(byte[] bytes, int at, int width, bool signed) {
        long value = 0;

        for (int i = 0; i < width; i++) { value = value | ((long)(bytes[at + i] & 255) << (i * 8)); }

        if (signed && width < 8) {
            int spare = 64 - width * 8;

            value = (value << spare) >> spare;
        }
        return value;
    }
}

// ---- the numbers, by the names C# gives their types ------------------------
//
// `int.TryParse(text, out n)` reaches this because `int` is an ALIAS for Int32
// and the checker resolves the keyword to the class. That is C#'s own
// arrangement rather than a trick: every one of these is a real type there,
// with these members on it, and writing `Int64.Parse` compiles in both.

// ---- numbers as text, and text as numbers ---------------------------------
//
// WHAT A FORMAT STRING MEANS. `n.ToString("X8")`, `count.ToString("N0")`,
// `bytes.ToString("D5")` -- a letter saying which shape and an optional number
// saying how many, which is .NET's standard numeric format string in full for
// the integral types. The custom pictures ("#,##0.00") are a different grammar
// and are not here.
//
// It lives in a class of its own because every integral type needs it and each
// of them differs only in how wide its two's complement is -- which is the one
// thing the hexadecimal and binary shapes have to know, since (-1).ToString("X")
// is eight F's for an int and sixteen for a long.
static class NumberFormat {
    private static string Lower = "0123456789abcdef";
    private static string Upper = "0123456789ABCDEF";

    private static string Digits(ulong value, int radix, string alphabet) {
        if (value == 0) { return "0"; }

        string made = "";
        ulong left = value;

        while (left > 0) {
            made = String.Concat(String.Substring(alphabet, (int)(left % (ulong)radix), 1), made);
            left = left / (ulong)radix;
        }
        return made;
    }

    /// The digit count after the letter, or -1 when there is none. ".NET reads
    /// at most two"; anything longer is not a standard format string at all.
    private static int Width(string format) {
        if (format.Length < 2) { return -1; }

        int made = 0;
        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit(Sys.GetChar(format, i))) { throw new FormatException("Format specifier was invalid."); }
            made = made * 10 + (Sys.GetChar(format, i) - 48);
        }
        return made;
    }

    /// THOUSANDS SEPARATED BY COMMAS, counting from the right -- which is what
    /// "N" means on an invariant culture, and this machine has only that one.
    private static string Group(string digits) {
        StringBuilder made = new StringBuilder();
        int n = digits.Length;

        for (int i = 0; i < n; i++) {
            if (i > 0 && (n - i) % 3 == 0) { made.Append(','); }
            made.Append(Sys.GetChar(digits, i));
        }
        return made.ToString();
    }

    /// `value`, as `format` says, where `bits` is how wide the type is: it
    /// decides what a negative number looks like in hexadecimal and binary,
    /// where .NET shows the two's complement rather than a minus sign.
    public static string Of(long value, int bits, string format) {
        if (format.Length == 0) { return String.FromInt(value); }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = Width(format);
        ulong whole = (ulong)value;
        ulong bitsOf = bits == 64 ? whole : whole & (((ulong)1 << bits) - (ulong)1);
        bool negative = value < 0;
        string plain = String.FromInt(negative ? -value : value);

        if (kind == 'x') { return Pad(Digits(bitsOf, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(bitsOf, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(bitsOf, 2, Lower), width); }

        if (kind == 'd' || kind == 'D') {
            return negative ? String.Concat("-", Pad(plain, width)) : Pad(plain, width);
        }

        if (kind == 'n' || kind == 'N') {
            string body = Group(plain);
            int places = width < 0 ? 2 : width;
            if (places > 0) { body = String.Concat(body, String.Concat(".", String.Repeat('0', places))); }
            return negative ? String.Concat("-", body) : body;
        }

        if (kind == 'f' || kind == 'F') {
            int places = width < 0 ? 2 : width;
            string body = places > 0
                        ? String.Concat(plain, String.Concat(".", String.Repeat('0', places)))
                        : plain;
            return negative ? String.Concat("-", body) : body;
        }

        if (kind == 'g' || kind == 'G') { return String.FromInt(value); }

        throw new FormatException("Format specifier was invalid.");
    }

    /// The UNSIGNED form, which cannot simply widen to long: a ulong above
    /// long.MaxValue would come out negative and print a minus sign.
    public static string OfUnsigned(ulong value, string format) {
        if (format.Length == 0) { return Digits(value, 10, Lower); }
        if (PictureFormat.Is(format)) { return PictureFormat.OfUnsigned(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = Width(format);

        if (kind == 'x') { return Pad(Digits(value, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(value, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(value, 2, Lower), width); }
        if (kind == 'd' || kind == 'D' || kind == 'g' || kind == 'G') {
            return Pad(Digits(value, 10, Lower), width);
        }
        if (kind == 'n' || kind == 'N') {
            string body = Group(Digits(value, 10, Lower));
            int places = width < 0 ? 2 : width;
            if (places > 0) { body = String.Concat(body, String.Concat(".", String.Repeat('0', places))); }
            return body;
        }
        throw new FormatException("Format specifier was invalid.");
    }

    private static string Pad(string s, int width) {
        if (width <= s.Length) { return s; }
        return String.Concat(String.Repeat('0', width - s.Length), s);
    }
}

// A REAL NUMBER AS TEXT, which this library could not do at all: a double
// could be computed, stored and compared, and the only way to look at one was
// to scale it to a long and print that. Every test of the maths above does
// exactly that, and every one of them is checking a number it cannot read.
//
// WHAT IS HERE AND WHAT IS NOT. "F", "E", "G" and the default, which is what
// numeric output is written in. The default takes fifteen significant digits
// and trims what they do not need; .NET takes the SHORTEST run of digits that
// reads back as the same double, which needs an exact big-decimal conversion
// (Ryu, Grisu) that nothing here has yet. The two agree on every number whose
// value needs fifteen digits or fewer -- which is every number a program
// writes down -- and differ on the sixteenth-digit tail of a computed one.
static class DoubleFormat {
    /// NOT A NUMBER IS NOT EQUAL TO ITSELF, which is the only test for it that
    /// does not need a bit pattern.
    public static bool IsNaN(double x) { return x != x; }

    public static bool IsInfinity(double x) {
        return x > 1.7976931348623157e308 || x < -1.7976931348623157e308;
    }

    /// The sign bit, which -0.0 has and .NET prints: "-0".
    static bool Negative(double x) { return BitConverter.DoubleToInt64Bits(x) < 0; }

    private static string? Special(double x) {
        if (IsNaN(x)) { return "NaN"; }
        if (x > 0.0 && IsInfinity(x)) { return "Infinity"; }
        if (x < 0.0 && IsInfinity(x)) { return "-Infinity"; }
        return null;
    }

    /// `places` digits after the point, from the value's exact decimal
    /// expansion, an exact tie rounded to even -- and the sign is kept even
    /// when every digit rounds to nought, because that is what .NET prints.
    public static string Fixed(double value, int places) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = Negative(value);
        string digits = "";
        int point = 0;
        if (value != 0.0) {
            int lead;
            FloatDecimal.Digits(value, 1, false, out lead);
            int wanted = lead + places;
            if (wanted > 0) {
                digits = FloatDecimal.Digits(value, wanted, true, out point);
            } else if (wanted == 0) {
                // Below the last place: it rounds to one unit of it or none.
                digits = FloatDecimal.Digits(value, 0, true, out point);
            }
        }

        return Compose(digits, point, negative, places);
    }

    /// What a CUSTOM format ("0.0", "#,##0") rounds, which is not the exact
    /// value: .NET takes its fifteen significant digits and rounds those half
    /// away from zero at the last place asked for -- 1.25 to "0.0" is 1.3,
    /// where "F1" says 1.2.
    public static string FixedCustom(double value, int places) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = Negative(value);
        if (value == 0.0) { return Compose("", 0, negative, places); }
        int point;
        string fifteen = FloatDecimal.Digits(value, 15, true, out point);
        int wanted = point + places;
        if (wanted >= 15) { return Compose(fifteen, point, negative, places); }
        if (wanted < 0) { return Compose("", 0, negative, places); }

        char[] kept = new char[wanted];
        for (int i = 0; i < wanted; i++) { kept[i] = Sys.GetChar(fifteen, i); }
        if (Sys.GetChar(fifteen, wanted) >= 53) {
            int at = wanted - 1;
            while (at >= 0) {
                if (kept[at] != '9') {
                    kept[at] = (char)(kept[at] + 1);
                    break;
                }
                kept[at] = '0';
                at = at - 1;
            }
            if (at < 0) { return Compose(String.Concat("1", new string(kept)), point + 1, negative, places); }
        }
        return Compose(new string(kept), point, negative, places);
    }

    /// 0.DIGITS x 10^point written with `places` after the point, what the
    /// digits do not reach being zeros.
    static string Compose(string digits, int point, bool negative, int places) {
        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }
        if (point <= 0) {
            made.Append('0');
        } else {
            for (int i = 0; i < point; i++) { made.Append(i < digits.Length ? Sys.GetChar(digits, i) : '0'); }
        }
        if (places > 0) {
            made.Append('.');
            for (int i = 0; i < places; i++) {
                int at = point + i;
                made.Append(at >= 0 && at < digits.Length ? Sys.GetChar(digits, at) : '0');
            }
        }
        return made.ToString();
    }

    /// `count` significant digits of |x|, exactly rounded, and its decimal
    /// exponent: x = d.ddd x 10^exponent.
    private static string Significant(double x, int count, out int exponent) {
        if (x == 0.0) {
            exponent = 0;
            return String.Repeat('0', count);
        }
        int point;
        string digits = FloatDecimal.Digits(x, count, true, out point);
        exponent = point - 1;
        return digits;
    }

    private static string TrimZeros(string s) {
        int end = s.Length;
        while (end > 1 && Sys.GetChar(s, end - 1) == 48) { end = end - 1; }
        return String.Substring(s, 0, end);
    }

    /// `d.dddE+eee`, with .NET's three-digit exponent and its default of six
    /// places after the point.
    public static string Scientific(double value, int places, char letter) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = Negative(value);
        int exponent = 0;
        string digits = Significant(value, places + 1, out exponent);

        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }
        made.Append(Sys.GetChar(digits, 0));
        if (places > 0) {
            made.Append('.');
            made.Append(String.Substring(digits, 1, places));
        }
        made.Append(letter);
        made.Append(exponent < 0 ? '-' : '+');

        string power = String.FromInt(exponent < 0 ? -exponent : exponent);
        made.Append(String.PadLeft(power, 3, '0'));
        return made.ToString();
    }

    /// .NET's "G" with a precision: that many significant digits, exactly
    /// rounded, trailing zeros dropped.
    public static string General(double value, int significant) {
        string? special = Special(value);
        if (special != null) { return special; }
        if (value == 0.0) { return Negative(value) ? "-0" : "0"; }

        int exponent = 0;
        string digits = TrimZeros(Significant(value, significant, out exponent));
        return Layout(digits, exponent + 1, Negative(value), significant);
    }

    /// What ToString(), "G" and "R" answer since .NET Core 3.0: the shortest
    /// digits that read back as the same double, written plainly unless the
    /// point is further out than 17 digits (or the digits' own count).
    public static string Shortest(double value) {
        string? special = Special(value);
        if (special != null) { return special; }
        if (value == 0.0) { return Negative(value) ? "-0" : "0"; }
        int point;
        string digits = FloatDecimal.Shortest(value, out point);
        return Layout(digits, point, Negative(value), digits.Length > 17 ? digits.Length : 17);
    }

    /// The same for a float, whose round trip is to a float: nine digits.
    public static string ShortestSingle(float value) {
        double wide = (double)value;
        string? special = Special(wide);
        if (special != null) { return special; }
        if (wide == 0.0) { return Negative(wide) ? "-0" : "0"; }
        int point;
        string digits = FloatDecimal.ShortestSingle(value, out point);
        return Layout(digits, point, Negative(wide), digits.Length > 9 ? digits.Length : 9);
    }

    /// 0.DIGITS x 10^point in .NET's general shape: plain digits while the
    /// point is within `most` digits and not four places below the units,
    /// d.dddE+xx otherwise.
    static string Layout(string digits, int point, bool negative, int most) {
        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }

        if (point > most || point < -3) {
            int exponent = point - 1;
            made.Append(Sys.GetChar(digits, 0));
            if (digits.Length > 1) {
                made.Append('.');
                made.Append(String.Substring(digits, 1, digits.Length - 1));
            }
            made.Append('E');
            made.Append(exponent < 0 ? '-' : '+');
            made.Append(String.PadLeft(String.FromInt(exponent < 0 ? -exponent : exponent), 2, '0'));
            return made.ToString();
        }

        if (point <= 0) {
            made.Append("0.");
            made.Append(String.Repeat('0', -point));
            made.Append(digits);
            return made.ToString();
        }

        if (digits.Length <= point) {
            made.Append(digits);
            made.Append(String.Repeat('0', point - digits.Length));
            return made.ToString();
        }

        made.Append(String.Substring(digits, 0, point));
        made.Append('.');
        made.Append(String.Substring(digits, point, digits.Length - point));
        return made.ToString();
    }

    /// A float's standard format: the shortest float digits for "", "G",
    /// "G0" and "R", and the double's exact answer -- the same value -- for
    /// the rest.
    public static string OfSingle(float value, string format) {
        if (format.Length == 0 || format == "G" || format == "g" || format == "G0" || format == "g0"
            || format == "R" || format == "r") {
            return ShortestSingle(value);
        }
        return Of((double)value, format);
    }

    public static string Of(double value, string format) {
        if (format.Length == 0) { return Shortest(value); }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = -1;

        if (format.Length > 1) {
            width = 0;
            for (int i = 1; i < format.Length; i++) {
                if (!Char.IsDigit(Sys.GetChar(format, i))) { throw new FormatException("Format specifier was invalid."); }
                width = width * 10 + (Sys.GetChar(format, i) - 48);
            }
        }

        if (kind == 'f' || kind == 'F') { return Fixed(value, width < 0 ? 2 : width); }
        if (kind == 'e') { return Scientific(value, width < 0 ? 6 : width, 'e'); }
        if (kind == 'E') { return Scientific(value, width < 0 ? 6 : width, 'E'); }
        if (kind == 'g' || kind == 'G') { return width <= 0 ? Shortest(value) : General(value, width); }
        if (kind == 'r' || kind == 'R') { return Shortest(value); }
        if (kind == 'n' || kind == 'N') {
            string body = Fixed(value, width < 0 ? 2 : width);
            bool negative = Sys.GetChar(body, 0) == 45;
            if (negative) { body = String.Substring(body, 1, body.Length - 1); }

            int point = String.IndexOf(body, '.');
            string head = point < 0 ? body : String.Substring(body, 0, point);
            string tail = point < 0 ? "" : String.Substring(body, point, body.Length - point);

            StringBuilder grouped = new StringBuilder();
            if (negative) { grouped.Append('-'); }
            for (int i = 0; i < head.Length; i++) {
                if (i > 0 && (head.Length - i) % 3 == 0) { grouped.Append(','); }
                grouped.Append(Sys.GetChar(head, i));
            }
            grouped.Append(tail);
            return grouped.ToString();
        }
        throw new FormatException("Format specifier was invalid.");
    }
}

// ---- binary floating point to decimal and back, exactly -------------------
//
// .NET Core 3.0 made double and float formatting and parsing IEEE-correct:
// ToString() answers the SHORTEST digits that read back to the same value,
// "G17", "F2" and "E6" round the value's exact decimal expansion, and Parse
// rounds what it reads to the nearest value, ties to even. Both directions
// are done here with exact integer arithmetic, an exact tie always going to
// the even digit, on the value as f x 2^e:
// Burger and Dybvig's free-format algorithm for the shortest digits, the
// same scaling with a fixed count for the rest, and a quotient of two exact
// integers rounded once for parsing.

/// A nonnegative integer of any size: 32-bit limbs, least significant
/// first, `count` of them in use. Only what FloatDecimal needs.
sealed class FloatBig {
    long[] limbs;
    int count;

    public FloatBig(long value) {
        limbs = new long[8];
        count = 0;
        while (value != 0) {
            Push(value & 0xFFFFFFFFL);
            value = value >> 32;
        }
    }

    FloatBig(long[] with, int used) {
        limbs = with;
        count = used;
    }

    public FloatBig Copy() {
        long[] made = new long[limbs.Length];
        for (int i = 0; i < count; i++) { made[i] = limbs[i]; }
        return new FloatBig(made, count);
    }

    public bool IsZero => count == 0;

    void Push(long limb) {
        if (count == limbs.Length) {
            long[] grown = new long[limbs.Length * 2];
            for (int i = 0; i < count; i++) { grown[i] = limbs[i]; }
            limbs = grown;
        }
        limbs[count] = limb;
        count = count + 1;
    }

    void Trim() {
        while (count > 0 && limbs[count - 1] == 0) { count = count - 1; }
    }

    /// this *= m, for 0 <= m < 2^31.
    public void MulSmall(long m) {
        long carry = 0;
        for (int i = 0; i < count; i++) {
            long t = limbs[i] * m + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
        }
        if (carry != 0) { Push(carry); }
        if (m == 0) { count = 0; }
    }

    /// this += a, for 0 <= a < 2^31.
    public void AddSmall(long a) {
        long carry = a;
        for (int i = 0; i < count && carry != 0; i++) {
            long t = limbs[i] + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
        }
        if (carry != 0) { Push(carry); }
    }

    public void MulPow10(int n) {
        while (n >= 9) {
            MulSmall(1000000000);
            n = n - 9;
        }
        long p = 1;
        while (n > 0) {
            p = p * 10;
            n = n - 1;
        }
        if (p != 1) { MulSmall(p); }
    }

    public void ShiftLeft(int bits) {
        if (count == 0 || bits == 0) { return; }
        int whole = bits / 32;
        int part = bits % 32;
        long[] made = new long[count + whole + 2];
        for (int i = 0; i < count; i++) {
            long v = limbs[i] << part;
            made[i + whole] = made[i + whole] | (v & 0xFFFFFFFFL);
            made[i + whole + 1] = made[i + whole + 1] | ((v >> 32) & 0xFFFFFFFFL);
        }
        limbs = made;
        count = count + whole + 2;
        Trim();
    }

    public int BitLength() {
        if (count == 0) { return 0; }
        long top = limbs[count - 1];
        int bits = 0;
        while (top != 0) {
            bits = bits + 1;
            top = top >> 1;
        }
        return (count - 1) * 32 + bits;
    }

    public bool Bit(int n) {
        if (n < 0) { return false; }
        int word = n / 32;
        if (word >= count) { return false; }
        return ((limbs[word] >> (n % 32)) & 1) != 0;
    }

    /// Whether any of bits [0, n) is set.
    public bool AnyBelow(int n) {
        int words = n / 32;
        for (int i = 0; i < words && i < count; i++) {
            if (limbs[i] != 0) { return true; }
        }
        if (words < count && n % 32 != 0) {
            return (limbs[words] & ((1L << (n % 32)) - 1)) != 0;
        }
        return false;
    }

    /// Bits [from, from + take) as a number, take <= 62.
    public long Bits(int from, int take) {
        long made = 0;
        for (int b = take - 1; b >= 0; b--) {
            made = (made << 1) | (Bit(from + b) ? 1L : 0L);
        }
        return made;
    }

    public static int Compare(FloatBig a, FloatBig b) {
        if (a.count != b.count) { return a.count < b.count ? -1 : 1; }
        for (int i = a.count - 1; i >= 0; i--) {
            if (a.limbs[i] != b.limbs[i]) { return a.limbs[i] < b.limbs[i] ? -1 : 1; }
        }
        return 0;
    }

    /// this += b.
    public void Add(FloatBig b) {
        long carry = 0;
        int i = 0;
        while (i < b.count || carry != 0) {
            if (i == count) { Push(0); }
            long t = limbs[i] + (i < b.count ? b.limbs[i] : 0) + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
            i = i + 1;
        }
    }

    /// this -= b, for b <= this.
    public void Subtract(FloatBig b) {
        long borrow = 0;
        for (int i = 0; i < count; i++) {
            long t = limbs[i] - (i < b.count ? b.limbs[i] : 0) - borrow;
            borrow = t < 0 ? 1 : 0;
            limbs[i] = t & 0xFFFFFFFFL;
        }
        Trim();
    }

    public static FloatBig Sum(FloatBig a, FloatBig b) {
        FloatBig made = a.Copy();
        made.Add(b);
        return made;
    }

    /// this = this * 10 mod s, answering the quotient, which is below 10
    /// while this is below s.
    public int NextDigit(FloatBig s) {
        MulSmall(10);
        int d = 0;
        while (Compare(this, s) >= 0) {
            Subtract(s);
            d = d + 1;
        }
        return d;
    }
}

static class FloatDecimal {
    /// A double as f x 2^e, and whether the gap below it is half the gap
    /// above (the smallest mantissa of an exponent that is not the least).
    static long Parts(double value, out int e, out bool unequal) {
        long bits = BitConverter.DoubleToInt64Bits(value) & 0x7FFFFFFFFFFFFFFFL;
        int biased = (int)(bits >> 52);
        long fraction = bits & 0xFFFFFFFFFFFFFL;
        unequal = fraction == 0 && biased > 1;
        if (biased == 0) {
            e = -1074;
            return fraction;
        }
        e = biased - 1075;
        return fraction | 0x10000000000000L;
    }

    static long SingleParts(float value, out int e, out bool unequal) {
        int bits = BitConverter.SingleToInt32Bits(value) & 0x7FFFFFFF;
        int biased = bits >> 23;
        long fraction = bits & 0x7FFFFF;
        unequal = fraction == 0 && biased > 1;
        if (biased == 0) {
            e = -149;
            return fraction;
        }
        e = biased - 150;
        return fraction | 0x800000L;
    }

    static FloatBig Pow2(int n) {
        FloatBig made = new FloatBig(1);
        made.ShiftLeft(n);
        return made;
    }

    /// k with 10^(k-1) <= f x 2^e < 10^k, give or take one: the scaling loops
    /// settle it exactly.
    static int Estimate(long f, int e) {
        int bits = 0;
        long top = f;
        while (top != 0) {
            bits = bits + 1;
            top = top >> 1;
        }
        double log = (double)(e + bits - 1) * 0.30102999566398114;
        int k = (int)log;
        if ((double)k < log) { k = k + 1; }
        return k;
    }

    /// The shortest digits that read back as |value|, and `point`, the power
    /// of ten they are the fraction of: value = 0.DIGITS x 10^point.
    public static string Shortest(double value, out int point) {
        int e;
        bool unequal;
        long f = Parts(value, out e, out unequal);
        return Free(f, e, unequal, out point);
    }

    public static string ShortestSingle(float value, out int point) {
        int e;
        bool unequal;
        long f = SingleParts(value, out e, out unequal);
        return Free(f, e, unequal, out point);
    }

    static string Free(long f, int e, bool unequal, out int point) {
        bool even = (f & 1) == 0;
        FloatBig r, s, up, down;
        if (e >= 0) {
            FloatBig be = Pow2(e);
            if (!unequal) {
                r = new FloatBig(f);
                r.ShiftLeft(e + 1);
                s = new FloatBig(2);
                up = be;
                down = be.Copy();
            } else {
                r = new FloatBig(f);
                r.ShiftLeft(e + 2);
                s = new FloatBig(4);
                up = Pow2(e + 1);
                down = be;
            }
        } else {
            if (!unequal) {
                r = new FloatBig(f);
                r.ShiftLeft(1);
                s = Pow2(1 - e);
                up = new FloatBig(1);
                down = new FloatBig(1);
            } else {
                r = new FloatBig(f);
                r.ShiftLeft(2);
                s = Pow2(2 - e);
                up = new FloatBig(2);
                down = new FloatBig(1);
            }
        }

        int k = Estimate(f, e);
        if (k >= 0) {
            s.MulPow10(k);
        } else {
            r.MulPow10(-k);
            up.MulPow10(-k);
            down.MulPow10(-k);
        }

        // Settle k: the high end of the interval must be below 1 (or at
        // it, exclusive), and at least a tenth.
        while (true) {
            int c = FloatBig.Compare(FloatBig.Sum(r, up), s);
            if (even ? c >= 0 : c > 0) {
                s.MulSmall(10);
                k = k + 1;
                continue;
            }
            FloatBig tenth = FloatBig.Sum(r, up);
            tenth.MulSmall(10);
            int t = FloatBig.Compare(tenth, s);
            if (even ? t < 0 : t <= 0) {
                r.MulSmall(10);
                up.MulSmall(10);
                down.MulSmall(10);
                k = k - 1;
                continue;
            }
            break;
        }

        StringBuilder digits = new StringBuilder();
        while (true) {
            int d = r.NextDigit(s);
            up.MulSmall(10);
            down.MulSmall(10);
            int low = FloatBig.Compare(r, down);
            int high = FloatBig.Compare(FloatBig.Sum(r, up), s);
            bool tc1 = even ? low <= 0 : low < 0;
            bool tc2 = even ? high >= 0 : high > 0;
            if (!tc1 && !tc2) {
                digits.Append((char)(48 + d));
                continue;
            }
            if (tc1 && tc2) {
                // Both digits read back: the nearer, and on a tie the even.
                FloatBig twice = r.Copy();
                twice.MulSmall(2);
                int c = FloatBig.Compare(twice, s);
                if (c > 0 || (c == 0 && (d & 1) != 0)) { d = d + 1; }
            } else if (tc2) {
                d = d + 1;
            }
            digits.Append((char)(48 + d));
            break;
        }
        point = k;
        return digits.ToString();
    }

    /// |value|'s exact decimal expansion rounded to `count` significant
    /// digits, an exact tie to the even digit as .NET does, and its point: value = 0.DIGITS x 10^point.
    /// With `round` false, the first `count` digits as they are.
    public static string Digits(double value, int count, bool round, out int point) {
        int e;
        bool unequal;
        long f = Parts(value, out e, out unequal);
        FloatBig r = new FloatBig(f);
        FloatBig s = new FloatBig(1);
        if (e >= 0) { r.ShiftLeft(e); } else { s.ShiftLeft(-e); }

        int k = Estimate(f, e);
        if (k >= 0) { s.MulPow10(k); } else { r.MulPow10(-k); }
        while (FloatBig.Compare(r, s) >= 0) {
            s.MulSmall(10);
            k = k + 1;
        }
        while (true) {
            FloatBig tenfold = r.Copy();
            tenfold.MulSmall(10);
            if (FloatBig.Compare(tenfold, s) >= 0) { break; }
            r = tenfold;
            k = k - 1;
        }

        char[] made = new char[count];
        for (int i = 0; i < count; i++) { made[i] = (char)(48 + r.NextDigit(s)); }

        if (round) {
            FloatBig twice = r.Copy();
            twice.MulSmall(2);
            int c = FloatBig.Compare(twice, s);
            // No digits asked for: it is one unit of the next place or none.
            if (count == 0) {
                point = k + 1;
                return c > 0 ? "1" : "";
            }
            if (c > 0 || (c == 0 && ((made[count - 1] - '0') & 1) != 0)) {
                int at = count - 1;
                while (at >= 0) {
                    if (made[at] != '9') {
                        made[at] = (char)(made[at] + 1);
                        break;
                    }
                    made[at] = '0';
                    at = at - 1;
                }
                if (at < 0) {
                    made[0] = '1';
                    k = k + 1;
                }
            }
        }
        point = k;
        return new string(made);
    }

    /// The nearest double to DIGITS x 10^exponent (DIGITS an integer), ties to
    /// even; infinity past the largest.
    public static double ToDouble(FloatBig digits, int exponent) {
        return BitConverter.Int64BitsToDouble(Nearest(digits, exponent, 53, -1022, 1023));
    }

    public static float ToSingle(FloatBig digits, int exponent) {
        return BitConverter.Int32BitsToSingle((int)Nearest(digits, exponent, 24, -126, 127));
    }

    /// The bits of the nearest value of a binary format with `precision`
    /// mantissa bits (the hidden one included) and exponents [minExp, maxExp].
    static long Nearest(FloatBig digits, int exponent, int precision, int minExp, int maxExp) {
        long infinity = (long)(maxExp + maxExp + 1) << (precision - 1);
        if (digits.IsZero) { return 0; }
        int length = digits.BitLength();
        // Far outside the range, in either direction, before any big power
        // of ten is made.
        int decimalDigits = (int)((double)length * 0.30102999566398114) + 1;
        if (exponent + decimalDigits > 330 + precision / 8) { return infinity; }
        if (exponent + decimalDigits < -360) { return 0; }

        FloatBig m;
        int e2;
        bool sticky = false;
        if (exponent >= 0) {
            m = digits.Copy();
            m.MulPow10(exponent);
            e2 = 0;
        } else {
            // m = digits / 10^-exponent, with enough bits that one rounding
            // is exact: the remainder only says whether anything is left.
            FloatBig divisor = new FloatBig(1);
            divisor.MulPow10(-exponent);
            // Enough bits in the quotient for one exact rounding, and no more
            // than a long holds: the dividend is shifted up, or the divisor
            // is, whichever makes the quotient about precision + 3 bits.
            int shift = precision + 3 + divisor.BitLength() - length;
            FloatBig rest = digits.Copy();
            if (shift >= 0) { rest.ShiftLeft(shift); } else { divisor.ShiftLeft(-shift); }
            int qbits = rest.BitLength() - divisor.BitLength() + 1;
            long q = 0;
            for (int i = qbits; i >= 0; i--) {
                FloatBig part = divisor.Copy();
                part.ShiftLeft(i);
                if (FloatBig.Compare(part, rest) <= 0) {
                    rest.Subtract(part);
                    q = q | (1L << i);
                }
            }
            sticky = !rest.IsZero;
            m = new FloatBig(q);
            e2 = -shift;
        }

        length = m.BitLength();
        int top = length - 1 + e2;
        if (top > maxExp) { return infinity; }
        int keep = precision;
        if (top < minExp) { keep = precision - (minExp - top); }
        int drop = length - keep;
        long mantissa;
        if (drop <= 0) {
            mantissa = m.Bits(0, length) << (-drop);
        } else {
            mantissa = keep > 0 ? m.Bits(drop, keep) : 0;
            bool half = m.Bit(drop - 1);
            bool below = sticky || m.AnyBelow(drop - 1);
            if (half && (below || (mantissa & 1) != 0)) { mantissa = mantissa + 1; }
        }
        int scale = e2 + drop;
        if (mantissa == (1L << precision)) {
            mantissa = mantissa >> 1;
            scale = scale + 1;
        }
        if (mantissa >= (1L << (precision - 1))) {
            long biased = scale + (precision - 1) + maxExp;
            if (biased >= maxExp + maxExp + 1) { return infinity; }
            return (biased << (precision - 1)) | (mantissa & ((1L << (precision - 1)) - 1));
        }
        return mantissa;
    }

    /// Reads a real number as .NET's Float style does: white space around it,
    /// a sign, digits with an optional point, an optional exponent, or
    /// Infinity, -Infinity, the infinity sign and NaN. False if it is none.
    public static bool TryRead(string s, out FloatBig digits, out int exponent, out bool negative, out int special) {
        digits = new FloatBig(0);
        exponent = 0;
        negative = false;
        special = 0;
        int at = 0;
        int end = s.Length;
        while (at < end && Char.IsWhiteSpace(s[at])) { at = at + 1; }
        while (end > at && Char.IsWhiteSpace(s[end - 1])) { end = end - 1; }
        if (at < end && (s[at] == '-' || s[at] == '+')) {
            negative = s[at] == '-';
            at = at + 1;
        }
        string rest = s.Substring(at, end - at);
        if (rest == "Infinity" || rest == "∞") {
            special = 1;
            return true;
        }
        if (rest == "NaN") {
            special = 2;
            return true;
        }

        bool any = false;
        // The integer part may carry group separators, as .NET's default
        // style for Parse (Float | AllowThousands) allows.
        while (at < end && ((s[at] >= '0' && s[at] <= '9') || (any && s[at] == ','))) {
            if (s[at] != ',') {
                digits.MulSmall(10);
                digits.AddSmall(s[at] - '0');
                any = true;
            }
            at = at + 1;
        }
        if (at < end && s[at] == '.') {
            at = at + 1;
            while (at < end && s[at] >= '0' && s[at] <= '9') {
                digits.MulSmall(10);
                digits.AddSmall(s[at] - '0');
                exponent = exponent - 1;
                at = at + 1;
                any = true;
            }
        }
        if (!any) { return false; }
        if (at < end && (s[at] == 'e' || s[at] == 'E')) {
            at = at + 1;
            bool down = false;
            if (at < end && (s[at] == '-' || s[at] == '+')) {
                down = s[at] == '-';
                at = at + 1;
            }
            if (at >= end || s[at] < '0' || s[at] > '9') { return false; }
            long power = 0;
            while (at < end && s[at] >= '0' && s[at] <= '9') {
                if (power < 100000000) { power = power * 10 + (s[at] - '0'); }
                at = at + 1;
            }
            exponent = exponent + (int)(down ? -power : power);
        }
        return at == end;
    }
}

// ---- a picture of a number ------------------------------------------------
//
// `n.ToString("0.00")`, `total.ToString("#,##0")`, `part.ToString("0%")` --
// .NET's CUSTOM numeric format strings, which are a different grammar from the
// standard ones above: instead of a letter naming a shape, the format IS the
// shape, a digit at a time.
//
// The two placeholders are the whole of it. `0` is a digit that is always
// printed, so it pads with zeros; `#` is a digit that is printed only if the
// number has one, so it trims. Everything else in the picture is itself --
// which is what makes `0;(0);zero` print accounts' negatives in brackets and
// `0%` multiply by a hundred and write the sign.
//
// The sections are split on `;`: positive, negative and zero, in that order.
// A number that falls in a section is formatted by it WITHOUT its sign, which
// is why the negative section has to write its own minus if it wants one.
static class PictureFormat {
    /// WHETHER A FORMAT IS A PICTURE at all, which is what decides between
    /// this file's two grammars. A standard format is a single letter and an
    /// optional number after it; everything else is a picture, including "000"
    /// and "#" and ".00".
    public static bool Is(string format) {
        if (format.Length == 0) { return false; }

        char kind = Sys.GetChar(format, 0);

        if (!Char.IsLetter(kind)) { return true; }

        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit(Sys.GetChar(format, i))) { return true; }
        }
        return false;
    }

    public static string Of(double value, string format) {
        string picture = Section(format, value > 0.0 ? 1 : (value < 0.0 ? -1 : 0));
        bool signed = value < 0.0 && Sections(format) < 2;
        double size = value < 0.0 ? 0.0 - value : value;

        if (Has(picture, '%')) { size = size * 100.0; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = size / 1000.0; }

        int places = Decimals(picture);
        string body = DoubleFormat.FixedCustom(size, places);
        int point = String.IndexOf(body, '.');

        string whole = point < 0 ? body : String.Substring(body, 0, point);
        string fraction = point < 0 ? "" : String.Substring(body, point + 1, body.Length - point - 1);

        return Render(picture, signed, whole, fraction);
    }

    /// The same for a whole number, which must not go through a double: a long
    /// above 2^53 would lose its last digits on the way.
    public static string Of(long value, string format) {
        string picture = Section(format, value > 0 ? 1 : (value < 0 ? -1 : 0));
        bool signed = value < 0 && Sections(format) < 2;
        long size = value < 0 ? -value : value;

        if (Has(picture, '%')) { size = size * 100; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = (size + 500) / 1000; }

        return Render(picture, signed, String.FromInt(size),
                      String.Repeat('0', Decimals(picture)));
    }

    public static string OfUnsigned(ulong value, string format) {
        string picture = Section(format, value > 0 ? 1 : 0);
        ulong size = value;

        if (Has(picture, '%')) { size = size * 100; }

        int scale = Thousands(picture);
        for (int i = 0; i < scale; i++) { size = (size + 500) / 1000; }

        return Render(picture, false, Decimal(size), String.Repeat('0', Decimals(picture)));
    }

    /// An unsigned number's digits, which String.FromInt cannot give: a ulong
    /// above long.MaxValue would come back negative.
    private static string Decimal(ulong value) {
        if (value == 0) { return "0"; }

        StringBuilder made = new StringBuilder();
        ulong left = value;

        while (left > 0) {
            made.Append((char)(48 + (int)(left % 10)));
            left = left / 10;
        }
        return String.Reverse(made.ToString());
    }

    // ---- the picture, read ------------------------------------------------

    /// How many sections the format has: positive, negative, zero.
    private static int Sections(string format) {
        int count = 1;

        for (int i = 0; i < format.Length; i++) {
            if (Sys.GetChar(format, i) == (int)';') { count = count + 1; }
        }
        return count;
    }

    /// The section a number of this sign is written by. A missing negative
    /// section means the positive one with a minus in front, and a missing zero
    /// section means the positive one -- .NET's rules, and the reason the sign
    /// is handled here rather than in the renderer.
    private static string Section(string format, int sign) {
        string[] parts = String.Split(format, ';');

        if (sign < 0 && parts.Length >= 2) { return parts[1]; }
        if (sign == 0 && parts.Length >= 3) { return parts[2]; }
        return parts[0];
    }

    private static bool Has(string picture, char c) {
        return String.IndexOf(picture, c) >= 0;
    }

    /// The digits after the point the picture asks for, which is how many the
    /// number is rounded to.
    private static int Decimals(string picture) {
        int point = String.IndexOf(picture, '.');

        if (point < 0) { return 0; }

        int count = 0;

        for (int i = point + 1; i < picture.Length; i++) {
            int c = Sys.GetChar(picture, i);

            if (c == (int)'0' || c == (int)'#') { count = count + 1; }
        }
        return count;
    }

    /// A COMMA WITH NOTHING BUT THE POINT AFTER IT DIVIDES BY A THOUSAND, and
    /// two commas by a million. It is the one part of the grammar nobody
    /// guesses, and it is how a report prints bytes as kilobytes.
    private static int Thousands(string picture) {
        int point = String.IndexOf(picture, '.');
        int end = point < 0 ? picture.Length : point;
        int count = 0;
        int at = end - 1;

        while (at >= 0 && Sys.GetChar(picture, at) == (int)',') {
            count = count + 1;
            at = at - 1;
        }
        return count;
    }

    /// A comma BETWEEN two digit placeholders asks for the thousands to be
    /// separated -- which is a different job from the comma above, told apart
    /// only by what surrounds it.
    private static bool Grouped(string picture) {
        int point = String.IndexOf(picture, '.');
        int end = point < 0 ? picture.Length : point;

        for (int i = 1; i < end - 1; i++) {
            if (Sys.GetChar(picture, i) != (int)',') { continue; }
            if (IsSlot(picture, i - 1) && IsSlot(picture, i + 1)) { return true; }
        }
        return false;
    }

    /// Whether the picture has any digit placeholder at all. One that has none
    /// is pure literal text, and the number is not printed.
    private static bool AnySlot(string picture) {
        for (int i = 0; i < picture.Length; i++) {
            if (IsSlot(picture, i)) { return true; }
        }
        return false;
    }

    private static bool IsSlot(string picture, int at) {
        int c = Sys.GetChar(picture, at);

        return c == (int)'0' || c == (int)'#';
    }

    // ---- the picture, written ---------------------------------------------

    private static string Render(string picture, bool signed, string whole, string fraction) {
        bool group = Grouped(picture);
        int point = String.IndexOf(picture, '.');
        string head = point < 0 ? picture : String.Substring(picture, 0, point);
        string tail = point < 0 ? "" : String.Substring(picture, point + 1, picture.Length - point - 1);

        StringBuilder made = new StringBuilder();

        if (signed) { made.Append('-'); }
        made.Append(Whole(head, whole, group, AnySlot(picture)));

        string after = Fraction(tail, fraction);

        if (after.Length > 0) {
            made.Append('.');
            made.Append(after);
        }
        return made.ToString();
    }

    /// The integer side, right to left: each placeholder takes the next digit
    /// from the right, a `0` with nothing left to take writes a zero and a `#`
    /// writes nothing, and anything that is not a placeholder is itself.
    /// Digits the picture has no room for are not lost -- they go in front,
    /// which is why "00" can still print a thousand.
    private static string Whole(string head, string digits, bool group, bool anywhere) {
        // A NUMBER WHOSE WHOLE PART IS NOUGHT DISAPPEARS when the picture asks
        // for it with '#' alone: .NET prints "" for 0 through "#" and ".5" for
        // a half through "#.##".
        string left = digits;

        if (String.Compare(left, "0") == 0 && String.IndexOf(head, '0') < 0) { left = ""; }

        StringBuilder reversed = new StringBuilder();
        int at = left.Length - 1;
        int written = 0;
        int leftmost = -1;

        for (int i = 0; i < head.Length; i++) {
            if (IsSlot(head, i)) { leftmost = i; break; }
        }

        for (int i = head.Length - 1; i >= 0; i--) {
            char c = Sys.GetChar(head, i);

            if (c == ',') { continue; }

            if (c == '0' || c == '#') {
                if (at >= 0) {
                    if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                    reversed.Append(Sys.GetChar(left, at));
                    written = written + 1;
                    at = at - 1;
                } else if (c == '0') {
                    if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                    reversed.Append('0');
                    written = written + 1;
                }

                // MORE DIGITS THAN THE PICTURE HAS ROOM FOR go at the LEFTMOST
                // placeholder, not at the front of the whole thing: "(0)" on a
                // thousand is "(1234)" and not "123(4)". The picture says where
                // the number sits among the literals, not how long it may be.
                if (i == leftmost) {
                    while (at >= 0) {
                        if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                        reversed.Append(Sys.GetChar(left, at));
                        written = written + 1;
                        at = at - 1;
                    }
                }
                continue;
            }
            reversed.Append(c);
        }

        // A PICTURE THAT PLACES ONLY THE FRACTION still prints the whole part:
        // ".00" on one and a quarter is "1.25", because the placeholders after
        // the point are what make it a number rather than a literal.
        if (leftmost < 0 && anywhere) {
            while (at >= 0) {
                if (group && written > 0 && written % 3 == 0) { reversed.Append(','); }
                reversed.Append(Sys.GetChar(left, at));
                written = written + 1;
                at = at - 1;
            }
        }
        return String.Reverse(reversed.ToString());
    }

    /// The fraction, left to right, with the trailing digits the picture asked
    /// for with '#' dropped when they are zeros -- which is the whole
    /// difference between "0.00" and "0.##".
    private static string Fraction(string tail, string digits) {
        int keep = digits.Length;
        int slot = 0;

        // Where each placeholder is, so that a trailing zero can be dropped
        // only if the placeholder above it was a '#'.
        for (int i = tail.Length - 1; i >= 0; i--) {
            char c = Sys.GetChar(tail, i);

            if (c != '0' && c != '#') { continue; }

            slot = Slots(tail, i);
            if (c == '0') { break; }
            if (slot <= keep && slot > 0 && Sys.GetChar(digits, slot - 1) == (int)'0') {
                keep = slot - 1;
            } else {
                break;
            }
        }

        StringBuilder made = new StringBuilder();
        int taken = 0;

        for (int i = 0; i < tail.Length; i++) {
            char c = Sys.GetChar(tail, i);

            if (c == '0' || c == '#') {
                if (taken >= keep) { break; }
                made.Append(Sys.GetChar(digits, taken));
                taken = taken + 1;
                continue;
            }
            made.Append(c);
        }
        return made.ToString();
    }

    /// How many placeholders there are up to and including this one.
    private static int Slots(string tail, int at) {
        int count = 0;

        for (int i = 0; i <= at; i++) {
            int c = Sys.GetChar(tail, i);

            if (c == (int)'0' || c == (int)'#') { count = count + 1; }
        }
        return count;
    }
}

// TEXT IN SOME BASE, ONCE, for every integral type to share. Each of them had
// its own copy of this loop or, more often, did not have one at all: hex was
// reachable through Convert.ToInt32(s, 16) and nowhere else, so
// `int.TryParse(s, NumberStyles.HexNumber, null, out n)` -- the form a program
// that reads a configuration file writes -- did not compile.
static class NumberParse {
    /// WHAT .NET SAYS WHEN TEXT IS NOT A NUMBER, quoting the text: a message
    /// that names the offending string is the difference between a bug report
    /// and a guess. Parse throws it; TryParse is the same work with the throw
    /// turned into a false.
    public static FormatException Bad(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return new FormatException(String.Concat("The input string '",
                                   String.Concat(s, "' was not in a correct format.")));
    }

    /// The other refusal: the digits were digits and there were too many of
    /// them for the type asked for.
    public static OverflowException TooBig(string what) {
        return new OverflowException(String.Concat("Value was either too large or too small for an ",
                                     String.Concat(what, ".")));
    }

    /// A DIGIT'S VALUE IN ANY BASE UP TO 36, or -1. Letters count from ten in
    /// either case, which is what every base above ten means by them.
    public static int DigitOf(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 122) { return c - 97 + 10; }
        if (c >= 65 && c <= 90) { return c - 65 + 10; }
        return -1;
    }

    /// FALSE ON OVERFLOW AS WELL AS ON RUBBISH, which is .NET's contract for
    /// TryParse and the reason the running value is checked rather than the
    /// result: once it has wrapped there is nothing left to notice.
    public static bool TryUnsigned(string s, int radix, out ulong value) {
        value = 0;
        if (s.Length == 0) { return false; }

        ulong made = 0;
        for (int i = 0; i < s.Length; i++) {
            int digit = DigitOf(Sys.GetChar(s, i));
            if (digit < 0 || digit >= radix) { return false; }

            ulong next = made * (ulong)radix + (ulong)digit;
            if (next < made) { return false; }
            made = next;
        }
        value = made;
        return true;
    }

    /// A SIGN IS DECIMAL ONLY: .NET's HexNumber style rejects one outright,
    /// because a hexadecimal literal already says its sign in its top bit.
    ///
    /// `bits` is the width of the type being parsed into, which decides both
    /// the range a decimal number may occupy and -- for hexadecimal -- where
    /// the sign bit is.
    public static bool TrySigned(string s, int radix, int bits, out long value) {
        value = 0;
        if (s.Length == 0) { return false; }

        bool negative = false;
        int at = 0;

        if (radix == 10 && (s[0] == '-' || s[0] == '+')) {
            negative = s[0] == '-';
            at = 1;
        }
        if (at >= s.Length) { return false; }

        ulong made = 0;
        if (!TryUnsigned(String.Substring(s, at, s.Length - at), radix, out made)) { return false; }

        // HEXADECIMAL IS A BIT PATTERN, not a magnitude: "FFFFFFFF" parsed as
        // an int is -1 in .NET, so the digits are read as the two's complement
        // of the type's width rather than rejected as a number too large.
        if (radix != 10) {
            if (bits == 64) {
                value = (long)made;
                return true;
            }

            ulong span = (ulong)1 << bits;
            if (made >= span) { return false; }

            ulong sign = (ulong)1 << (bits - 1);
            value = made >= sign ? (long)made - (long)span : (long)made;
            return true;
        }

        long high = bits == 64 ? long.MaxValue : ((long)1 << (bits - 1)) - 1;
        long low = -high - 1;

        if (negative) {
            // The most negative value of every width has no positive twin, so
            // it is recognised by its magnitude before the negation that would
            // overflow.
            if (made == (ulong)high + (ulong)1) {
                value = low;
                return true;
            }
            if (made > (ulong)high) { return false; }
            value = -(long)made;
            return true;
        }

        if (made > (ulong)high) { return false; }
        value = (long)made;
        return true;
    }
}

// ---- the narrow integral types, by the names C# gives them -----------------
//
// Each is a thin naming of the two routines above. They exist because
// `byte.TryParse(field, out b)` is what a program that reads a byte writes,
// and because the range check belongs to the TYPE rather than to the caller.

static class SByte {
    // Equals and GetHashCode as SByte overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(sbyte value, sbyte other) { return value == other; }
    public static bool Equals(sbyte value, object? other) { return other is sbyte same && Equals(value, same); }
    public static int GetHashCode(sbyte value) { return value; }
    public static int CompareTo(sbyte value, sbyte other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(sbyte value, object? other) {
        if (other == null) return 1;
        if (other is sbyte number) return CompareTo(value, number);
        throw new ArgumentException("object must be an SByte");
    }
    public static sbyte MaxValue => sbyte.MaxValue;
    public static sbyte MinValue => sbyte.MinValue;

    public static bool TryParse(string? s, out sbyte value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, 10, 8, out wide);
        value = (sbyte)wide;
        return ok;
    }

    public static sbyte Parse(string s) {
        sbyte value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this sbyte value, string format) {
        return NumberFormat.Of(value, 8, format);
    }
}

static class Int16 {

    // UTF-8 TEXT, as .NET 8's short parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out short result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this short value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as Int16 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(short value, short other) { return value == other; }
    public static bool Equals(short value, object? other) { return other is short same && Equals(value, same); }
    public static int GetHashCode(short value) { return value; }
    public static int CompareTo(short value, short other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(short value, object? other) {
        if (other == null) return 1;
        if (other is short number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Int16");
    }
    public static short MaxValue => short.MaxValue;
    public static short MinValue => short.MinValue;

    public static bool TryParse(string? s, out short value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, 10, 16, out wide);
        value = (short)wide;
        return ok;
    }

    public static short Parse(string s) {
        short value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this short value, string format) {
        return NumberFormat.Of(value, 16, format);
    }
}

