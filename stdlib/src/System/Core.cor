    public static ushort MinValue => 0;

    public static bool TryParse(string? s, out ushort value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 65535;
        value = (ushort)wide;
        return ok;
    }

    public static ushort Parse(string s) {
        ushort value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this ushort value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }
}

static class UInt32 {

    // UTF-8 TEXT, as .NET 8's uint parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out uint result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this uint value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as UInt32 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(uint value, uint other) { return value == other; }
    public static bool Equals(uint value, object? other) { return other is uint same && Equals(value, same); }
    public static int GetHashCode(uint value) { return (int)value; }
    public static int CompareTo(uint value, uint other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(uint value, object? other) {
        if (other == null) return 1;
        if (other is uint number) return CompareTo(value, number);
        throw new ArgumentException("object must be an UInt32");
    }
    public static uint MaxValue => uint.MaxValue;
    public static uint MinValue => 0;

    public static bool TryParse(string? s, out uint value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 4294967295;
        value = (uint)wide;
        return ok;
    }

    public static bool TryParse(string? s, NumberStyles style, IFormatProvider? provider, out uint value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, (style & NumberStyles.AllowHexSpecifier) != 0 ? 16 : 10, out wide)
               && wide <= 4294967295;
        value = (uint)wide;
        return ok;
    }

    public static uint Parse(string s) {
        uint value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static uint Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static uint Parse(string s, NumberStyles style) {
        return Parse(s, style, CultureInfo.InvariantCulture);
    }

    public static uint Parse(string s, NumberStyles style, IFormatProvider? provider) {
        uint value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static uint Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static string ToString(this uint value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }
}

static class Int64 {

    // UTF-8 TEXT, as .NET 8's long parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out long result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this long value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as Int64 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(long value, long other) { return value == other; }
    public static bool Equals(long value, object? other) { return other is long same && Equals(value, same); }
    public static int GetHashCode(long value) { return (int)value ^ (int)(value >> 32); }
    public static int CompareTo(long value, long other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(long value, object? other) {
        if (other == null) return 1;
        if (other is long number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Int64");
    }
    // THE LIMITS, UNDER THE TYPE'S OWN NAME. `long.MaxValue` is answered by the
    // compiler, which knows the keyword; `Int64.MaxValue` is the same constant
    // written the other way C# allows, and nothing answered it.
    public static long MaxValue => long.MaxValue;
    public static long MinValue => long.MinValue;

    // TRUE WHEN IT PARSED, and the value is only meaningful then -- .NET's
    // contract, and the reason this exists beside Parse: a number that might
    // not be one is ordinary input, not an exceptional case.
    public static bool TryParse(string? s, out long value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        value = 0;

        if (s.Length == 0) { return false; }

        bool negative = s[0] == '-';
        int at = negative || s[0] == '+' ? 1 : 0;

        if (at >= s.Length) { return false; }

        long made = 0;

        while (at < s.Length) {
            int c = Sys.GetChar(s, at);

            if (c < 48 || c > 57) {
                value = 0;
                return false;
            }

            made = made * 10 + (c - 48);
            at = at + 1;
        }

        value = negative ? -made : made;
        return true;
    }

    // .NET throws FormatException here. There is nothing to throw from a
    // library this low yet, so a number that is not one answers zero -- and
    // TryParse is what a caller that cares uses in .NET anyway.
    public static long Parse(string s) {
        long value = 0;

        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static string ToString(this long value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this long value, string format) {
        return NumberFormat.Of(value, 64, format);
    }

    public static bool TryParse(string? s, NumberStyles style, IFormatProvider? provider, out long value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        return NumberParse.TrySigned(s, (style & NumberStyles.AllowHexSpecifier) != 0 ? 16 : 10, 64, out value);
    }

    public static long Parse(string s, NumberStyles style) {
        long value = 0;
        if (!TryParse(s, style, CultureInfo.InvariantCulture, out value)) {
            throw new FormatException(s);
        }
        return value;
    }

    /// The rest of .NET's set: a culture, a style and a culture, and a span.
    public static long Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static long Parse(string s, NumberStyles style, IFormatProvider? provider) {
        long value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static long Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static long Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s.ToString()); }

    public static bool TryParse(ReadOnlySpan<char> s, out long value) {
        return TryParse(s.ToString(), out value);
    }
}

static class Int32 {

    // UTF-8 TEXT, as .NET 8's int parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out int result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this int value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as Int32 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(int value, int other) { return value == other; }
    public static bool Equals(int value, object? other) { return other is int same && Equals(value, same); }
    public static int GetHashCode(int value) { return value; }
    public static int CompareTo(int value, int other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(int value, object? other) {
        if (other == null) return 1;
        if (other is int number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Int32");
    }
    public static int MaxValue => int.MaxValue;
    public static int MinValue => int.MinValue;

    public static bool TryParse(string? s, out int value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        long wide = 0;
        bool ok = Int64.TryParse(s, out wide);

        value = (int)wide;
        return ok && wide >= -2147483648 && wide <= 2147483647;
    }

    /// A NUMBER OR AN EXCEPTION, which is .NET's contract and was not this
    /// one's: text that is not a number answered zero, so a configuration
    /// file's typo became a silent default. Out of range is an
    /// OverflowException and unreadable text is a FormatException, because a
    /// caller can do something about the first and not about the second.
    public static int Parse(string s) {
        long wide = 0;

        if (!Int64.TryParse(s, out wide)) { throw NumberParse.Bad(s); }
        if (wide < -2147483648 || wide > 2147483647) { throw NumberParse.TooBig("Int32"); }
        return (int)wide;
    }

    public static bool TryParse(ReadOnlySpan<char> s, out int value) {
        return TryParse(s.ToString(), out value);
    }

    public static int Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static int Parse(string s, NumberStyles style, IFormatProvider? provider) {
        int value = 0;

        if (!TryParse(s, style, provider, out value)) { throw new FormatException(s); }
        return value;
    }

    public static int Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static int Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s.ToString()); }

    public static string ToString(this int value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this int value, string format) {
        return NumberFormat.Of(value, 32, format);
    }

    public static bool TryParse(ReadOnlySpan<char> s, NumberStyles style, IFormatProvider? provider, out int value) {
        return TryParse(s.ToString(), style, provider, out value);
    }

    public static bool TryParse(string? s, NumberStyles style, IFormatProvider? provider, out int value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        long wide = 0;
        bool ok = NumberParse.TrySigned(s, (style & NumberStyles.AllowHexSpecifier) != 0 ? 16 : 10, 32, out wide);
        value = (int)wide;
        return ok;
    }

    public static int Parse(string s, NumberStyles style) {
        int value = 0;
        if (!TryParse(s, style, CultureInfo.InvariantCulture, out value)) {
            throw new FormatException(s);
        }
        return value;
    }
}

/// The number forms a parser accepts, .NET's flags and their values.
[Flags]
enum NumberStyles {
    None = 0,
    AllowLeadingWhite = 1,
    AllowTrailingWhite = 2,
    AllowLeadingSign = 4,
    AllowTrailingSign = 8,
    AllowParentheses = 16,
    AllowDecimalPoint = 32,
    AllowThousands = 64,
    AllowExponent = 128,
    AllowCurrencySymbol = 256,
    AllowHexSpecifier = 512,
    Integer = 7,
    HexNumber = 515,
    Number = 111,
    Float = 167,
    Currency = 383,
    Any = 511,
}

/// What a formatter or a parser is told to use. .NET's every Parse, TryParse
/// and ToString that takes a culture takes this, and a null means "the current
/// one" -- which on a machine with one culture is the invariant one either way.
interface IFormatProvider {
    object? GetFormat(Type? formatType);
}

class CultureInfo : IFormatProvider {
    public static CultureInfo InvariantCulture => new CultureInfo();
    public static CultureInfo CurrentCulture => new CultureInfo();

    /// LOCALE_INVARIANT: what every culture of this machine formats as.
    const int Invariant = 0x7F;
    readonly int _lcid;

    public CultureInfo() { _lcid = Invariant; }

    /// A culture by its Windows locale id (an input language's, as
    /// InputLanguage.Culture makes it). Its formatting is the invariant
    /// culture's: this machine formats with one.
    public CultureInfo(int culture) { _lcid = culture & 0xFFFF; }

    public int LCID => _lcid;

    /// Its name, as .NET's: the languages Windows 2000 has keyboard layouts
    /// for, "" for the invariant culture, and for another the id in hex.
    public string Name
    {
        get
        {
            if (_lcid == Invariant) return "";
            for (int i = 0; i + 1 < Names.Length; i += 2)
                if (int.Parse(Names[i], NumberStyles.HexNumber) == _lcid) return Names[i + 1];
            return "x-" + _lcid.ToString("x4");
        }
    }

    static readonly string[] Names = new string[]
    {
        "0401", "ar-SA", "0402", "bg-BG", "0404", "zh-TW", "0405", "cs-CZ", "0406", "da-DK", "0407", "de-DE",
        "0408", "el-GR", "0409", "en-US", "040a", "es-ES_tradnl", "040b", "fi-FI", "040c", "fr-FR", "040d", "he-IL",
        "040e", "hu-HU", "040f", "is-IS", "0410", "it-IT", "0411", "ja-JP", "0412", "ko-KR", "0413", "nl-NL",
        "0414", "nb-NO", "0415", "pl-PL", "0416", "pt-BR", "0418", "ro-RO", "0419", "ru-RU", "041a", "hr-HR",
        "041b", "sk-SK", "041c", "sq-AL", "041d", "sv-SE", "041e", "th-TH", "041f", "tr-TR", "0422", "uk-UA",
        "0423", "be-BY", "0424", "sl-SI", "0425", "et-EE", "0426", "lv-LV", "0427", "lt-LT", "0429", "fa-IR",
        "042a", "vi-VN", "042b", "hy-AM", "042c", "az-Latn-AZ", "042f", "mk-MK", "0437", "ka-GE", "0438", "fo-FO",
        "0439", "hi-IN", "043f", "kk-KZ", "0444", "tt-RU", "0449", "ta-IN", "044e", "mr-IN", "0804", "zh-CN",
        "0807", "de-CH", "0809", "en-GB", "080a", "es-MX", "080c", "fr-BE", "0813", "nl-BE", "0816", "pt-PT",
        "081a", "sr-Latn-CS", "082c", "az-Cyrl-AZ", "0843", "uz-Cyrl-UZ", "0c0a", "es-ES", "0c0c", "fr-CA",
        "0c1a", "sr-Cyrl-CS", "1009", "en-CA", "100c", "fr-CH", "1809", "en-IE",
    };

    public override string ToString() { return Name; }
    public override bool Equals(object? other) { return other is CultureInfo c && c._lcid == _lcid; }
    public override int GetHashCode() { return _lcid; }

    public object? GetFormat(Type? formatType) { return null; }
}

/// System.IntPtr's statics: `nint` is IntPtr (C# 11), one machine word.
static class IntPtr {
    public static int Size => (int)WordSize.Bytes;
    public static nint Zero => 0;
    public static nint MaxValue => nint.MaxValue;
    public static nint MinValue => nint.MinValue;
    public static nint Add(nint pointer, int offset) { return pointer + offset; }
    public static nint Subtract(nint pointer, int offset) { return pointer - offset; }
}

/// System.UIntPtr's statics: `nuint` is UIntPtr (C# 11).
static class UIntPtr {
    public static int Size => (int)WordSize.Bytes;
    public static nuint Zero => 0;
    public static nuint MaxValue => nuint.MaxValue;
    public static nuint MinValue => 0;
    public static nuint Add(nuint pointer, int offset) { return pointer + (nuint)offset; }
    public static nuint Subtract(nuint pointer, int offset) { return pointer - (nuint)offset; }
}

static class UInt64 {

    // UTF-8 TEXT, as .NET 8's ulong parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out ulong result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this ulong value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as UInt64 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(ulong value, ulong other) { return value == other; }
    public static bool Equals(ulong value, object? other) { return other is ulong same && Equals(value, same); }
    public static int GetHashCode(ulong value) { return (int)value ^ (int)(value >> 32); }
    public static int CompareTo(ulong value, ulong other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(ulong value, object? other) {
        if (other == null) return 1;
        if (other is ulong number) return CompareTo(value, number);
        throw new ArgumentException("object must be a UInt64");
    }
    public static ulong MaxValue => ulong.MaxValue;
    public static ulong MinValue => 0;

    public static bool TryParse(string? s, out ulong value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        return TryParse(s.AsSpan(), NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    public static bool TryParse(ReadOnlySpan<char> s, NumberStyles style,
                                IFormatProvider? provider, out ulong value) {
        value = 0;
        if (s.Length == 0) { return false; }

        int radix = (style & NumberStyles.AllowHexSpecifier) != 0 ? 16 : 10;
        for (int i = 0; i < s.Length; i++) {
            int c = (int)s[i];
            int digit = -1;
            if (c >= 48 && c <= 57) { digit = c - 48; }
            if (c >= 97 && c <= 102) { digit = c - 97 + 10; }
            if (c >= 65 && c <= 70) { digit = c - 65 + 10; }
            if (digit < 0 || digit >= radix) { value = 0; return false; }

            ulong next = value * (ulong)radix + (ulong)digit;
            if (next < value) { value = 0; return false; }
            value = next;
        }
        return true;
    }

    public static ulong Parse(string s) {
        ulong value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    /// The three .NET spells beside the plain one: a culture, a style, and
    /// both. There is one culture on this machine, so the provider says
    /// nothing; the style says which radix.
    public static ulong Parse(string s, IFormatProvider? provider) { return Parse(s); }

    public static ulong Parse(string s, NumberStyles style) {
        return Parse(s, style, CultureInfo.InvariantCulture);
    }

    public static ulong Parse(string s, NumberStyles style, IFormatProvider? provider) {
        ulong value = 0;

        if (!TryParse(s.AsSpan(), style, provider, out value)) { throw NumberParse.Bad(s); }
        return value;
    }

    public static ulong Parse(ReadOnlySpan<char> s) { return Parse(s.ToString()); }

    public static string ToString(this ulong value, string format) {
        return NumberFormat.OfUnsigned(value, format);
    }
}

static class Byte {

    // UTF-8 TEXT, as .NET 8's byte parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out byte result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this byte value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as Byte overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(byte value, byte other) { return value == other; }
    public static bool Equals(byte value, object? other) { return other is byte same && Equals(value, same); }
    public static int GetHashCode(byte value) { return value; }
    public static int CompareTo(byte value, byte other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(byte value, object? other) {
        if (other == null) return 1;
        if (other is byte number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Byte");
    }
    public static byte MaxValue => byte.MaxValue;
    public static byte MinValue => 0;

    public static string ToString(this byte value, IFormatProvider? provider) {
        return String.FromInt(value);
    }

    public static string ToString(this byte value, string format) {
        return NumberFormat.OfUnsigned((ulong)value, format);
    }

    public static bool TryParse(string? s, out byte value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, 10, out wide) && wide <= 255;
        value = (byte)wide;
        return ok;
    }

    public static bool TryParse(string? s, NumberStyles style, IFormatProvider? provider, out byte value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        ulong wide = 0;
        bool ok = NumberParse.TryUnsigned(s, (style & NumberStyles.AllowHexSpecifier) != 0 ? 16 : 10, out wide)
               && wide <= 255;
        value = (byte)wide;
        return ok;
    }

    public static byte Parse(string s) {
        byte value = 0;
        if (!TryParse(s, out value)) { throw NumberParse.Bad(s); }
        return value;
    }
}

static class Double {
    // Equals and GetHashCode as Double overrides them: NaN equals NaN, and
    // every NaN and both zeros hash alike, since they are Equal.
    public static bool Equals(double value, double other) { return value == other || (IsNaN(value) && IsNaN(other)); }
    public static bool Equals(double value, object? other) { return other is double same && Equals(value, same); }
    public static int GetHashCode(double value) {
        long bits = BitConverter.DoubleToInt64Bits(value);
        if (((bits - 1) & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) bits &= 0x7FF0000000000000;
        return (int)bits ^ (int)(bits >> 32);
    }
    public const double NaN = (double)0.0 / (double)0.0;
    public const double PositiveInfinity = (double)1.0 / (double)0.0;
    public const double NegativeInfinity = (double)(-1.0) / (double)0.0;
    public const double Epsilon = 4.9406564584124654E-324;
    public const double MaxValue = 1.7976931348623157E+308;
    public const double MinValue = -1.7976931348623157E+308;
    /// NaN is below every number and equal to itself, as .NET orders it.
    public static int CompareTo(double value, double other) {
        if (value < other) return -1;
        if (value > other) return 1;
        if (value == other) return 0;
        bool a = value != value, b = other != other;
        return a ? (b ? 0 : -1) : 1;
    }
    public static int CompareTo(double value, object? other) {
        if (other == null) return 1;
        if (other is double number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Double");
    }
    /// The nearest double to what `s` says, ties to even, as .NET reads it
    /// (FloatDecimal.TryRead): past the largest is infinity, below the
    /// smallest is zero.
    public static double Parse(string s, IFormatProvider? provider) {
        if (s == null) { throw new ArgumentNullException(nameof(s)); }
        double value;
        if (!Read(s, out value)) { throw new FormatException("The input string '" + s + "' was not in a correct format."); }
        return value;
    }

    static bool Read(string s, out double value) {
        FloatBig digits;
        int exponent, special;
        bool negative;
        value = 0.0;
        if (!FloatDecimal.TryRead(s, out digits, out exponent, out negative, out special)) { return false; }
        double magnitude = special == 1 ? 1.0 / 0.0 : special == 2 ? 0.0 / 0.0 : FloatDecimal.ToDouble(digits, exponent);
        value = negative ? -magnitude : magnitude;
        return true;
    }

    public static double Parse(string s) { return Parse(s, CultureInfo.InvariantCulture); }

    // .NET's contract: false rather than a throw, and the value is only
    // meaningful when it answered true. The parse above reports its refusals
    // by throwing, so this is where that becomes an answer.
    public static bool TryParse(string? s, out double value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        if (s == null) {
            value = 0.0;
            return false;
        }
        return Read(s, out value);
    }

    public static bool TryParse(string? s, NumberStyles style, IFormatProvider? provider, out double value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        return TryParse(s, out value);
    }

    /// What `d.ToString()` answers: the general format, as string
    /// concatenation gives it.
    public static string ToString(this double value) {
        return String.FromDouble(value);
    }

    public static string ToString(this double value, IFormatProvider? provider) {
        return String.FromDouble(value);
    }

    public static string ToString(this double value, string format) {
        return DoubleFormat.Of(value, format);
    }

    public static string ToString(this double value, string format, IFormatProvider? provider) {
        return DoubleFormat.Of(value, format);
    }

    public static bool IsNaN(double value) { return DoubleFormat.IsNaN(value); }
    public static bool IsInfinity(double value) { return DoubleFormat.IsInfinity(value); }

    public static bool IsFinite(double value) {
        return !DoubleFormat.IsNaN(value) && !DoubleFormat.IsInfinity(value);
    }

    public static bool IsPositiveInfinity(double value) { return Sys.Bits(value) == 0x7FF0000000000000; }
    public static bool IsNegativeInfinity(double value) { return Sys.Bits(value) == unchecked((long)0xFFF0000000000000); }

    /// The sign bit, as .NET reads it: true for -0.0 and a negative NaN too.
    public static bool IsNegative(double value) { return Sys.Bits(value) < 0; }

    /// Neither zero, subnormal, infinite nor NaN.
    public static bool IsNormal(double value) {
        long exponent = (Sys.Bits(value) >> 52) & 0x7FF;
        return exponent != 0 && exponent != 0x7FF;
    }

    public static bool IsSubnormal(double value) {
        long bits = Sys.Bits(value);
        return ((bits >> 52) & 0x7FF) == 0 && (bits & 0x000FFFFFFFFFFFFF) != 0;
    }

    public static bool IsRealNumber(double value) { return value == value; }
}

/// System.Single: float's statics, through double, which holds every float
/// exactly. Its general format is seven significant digits, as .NET
/// Framework's float.ToString() was, so 0.1f prints 0.1 and not the double
/// it widens to.
static class Single {
    // Equals and GetHashCode as Single overrides them: NaN equals NaN, and
    // every NaN and both zeros hash alike, since they are Equal.
    public static bool Equals(float value, float other) { return value == other || (IsNaN(value) && IsNaN(other)); }
    public static bool Equals(float value, object? other) { return other is float same && Equals(value, same); }
    public static int GetHashCode(float value) {
        int bits = BitConverter.SingleToInt32Bits(value);
        if (((bits - 1) & 0x7FFFFFFF) >= 0x7F800000) bits &= 0x7F800000;
        return bits;
    }
    public const float NaN = (float)0.0 / (float)0.0;
    public const float PositiveInfinity = (float)1.0 / (float)0.0;
    public const float NegativeInfinity = (float)(-1.0) / (float)0.0;
    public const float Epsilon = 1.401298E-45F;
    public const float MaxValue = 3.40282347E+38F;
    public const float MinValue = -3.40282347E+38F;
    /// NaN is below every number and equal to itself, as .NET orders it.
    public static int CompareTo(float value, float other) {
        if (value < other) return -1;
        if (value > other) return 1;
        if (value == other) return 0;
        bool a = value != value, b = other != other;
        return a ? (b ? 0 : -1) : 1;
    }
    public static int CompareTo(float value, object? other) {
        if (other == null) return 1;
        if (other is float number) return CompareTo(value, number);
        throw new ArgumentException("object must be an Single");
    }
    public static float Parse(string s) { return Parse(s, null); }

    /// The nearest float to what `s` says, rounded once -- not through a
    /// double, which would round twice.
    public static float Parse(string s, IFormatProvider? provider) {
        if (s == null) { throw new ArgumentNullException(nameof(s)); }
        float value;
        if (!Read(s, out value)) { throw new FormatException("The input string '" + s + "' was not in a correct format."); }
        return value;
    }

    public static bool TryParse(string? s, out float value) {
        // .NET's answer for no string at all: false, and the default.
        if (s is null) { value = default; return false; }
        if (s == null) {
            value = 0.0F;
            return false;
        }
        return Read(s, out value);
    }

    static bool Read(string s, out float value) {
        FloatBig digits;
        int exponent, special;
        bool negative;
        value = 0.0F;
        if (!FloatDecimal.TryRead(s, out digits, out exponent, out negative, out special)) { return false; }
        float magnitude = special == 1 ? PositiveInfinity : special == 2 ? NaN : FloatDecimal.ToSingle(digits, exponent);
        value = negative ? -magnitude : magnitude;
        return true;
    }

    public static string ToString(this float value) { return DoubleFormat.ShortestSingle(value); }
    public static string ToString(this float value, IFormatProvider? provider) { return DoubleFormat.ShortestSingle(value); }
    public static string ToString(this float value, string format) { return DoubleFormat.OfSingle(value, format); }
    public static string ToString(this float value, string format, IFormatProvider? provider) { return DoubleFormat.OfSingle(value, format); }

    public static bool IsNaN(float value) { return value != value; }
    public static bool IsInfinity(float value) { return DoubleFormat.IsInfinity(value); }
    public static bool IsFinite(float value) { return !IsNaN(value) && !IsInfinity(value); }

    // A float widened to double keeps its sign, its class and its value, so
    // each is asked of the double.
    public static bool IsPositiveInfinity(float value) { return Double.IsPositiveInfinity(value); }
    public static bool IsNegativeInfinity(float value) { return Double.IsNegativeInfinity(value); }
    public static bool IsNegative(float value) { return Double.IsNegative(value); }

    public static bool IsNormal(float value) {
        float magnitude = value < 0.0F ? -value : value;
        return magnitude >= 1.17549435E-38F && magnitude <= MaxValue;
    }

    public static bool IsSubnormal(float value) {
        float magnitude = value < 0.0F ? -value : value;
        return magnitude > 0.0F && magnitude < 1.17549435E-38F;
    }

    public static bool IsRealNumber(float value) { return value == value; }
}

/// System.Boolean's statics: the text a bool is written as, and reading it
/// back -- "True" or "False" in any case, with white space around it and null
/// characters after it ignored, as .NET's parser has it.
static class Boolean {
    public static int CompareTo(bool value, object? other) {
        if (other == null) return 1;
        if (other is bool flag) return CompareTo(value, flag);
        throw new ArgumentException("Object must be of type Boolean.");
    }
    // Equals and GetHashCode as Boolean overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(bool value, bool other) { return value == other; }
    public static bool Equals(bool value, object? other) { return other is bool same && Equals(value, same); }
    public static int GetHashCode(bool value) { return value ? 1 : 0; }
    public static readonly string TrueString = "True";
    public static readonly string FalseString = "False";

    public static bool Parse(string value) {
        if (value == null) { throw new ArgumentNullException("value"); }
        if (TryParse(value, out bool result)) { return result; }
        throw new FormatException("String '" + value + "' was not recognized as a valid Boolean.");
    }

    public static bool Parse(ReadOnlySpan<char> value) { return Parse(value.ToString()); }

    public static bool TryParse(string? value, out bool result) {
        result = false;
        if (value == null) { return false; }
        string text = value.Trim().TrimEnd('\0').Trim();
        if (string.Equals(text, TrueString, StringComparison.OrdinalIgnoreCase)) {
            result = true;
            return true;
        }
        return string.Equals(text, FalseString, StringComparison.OrdinalIgnoreCase);
    }

    public static bool TryParse(ReadOnlySpan<char> value, out bool result) { return TryParse(value.ToString(), out result); }

    /// False sorts before true.
    public static int CompareTo(this bool value, bool other) { return value == other ? 0 : value ? 1 : -1; }
}

// ---- text as bytes ---------------------------------------------------------
//
// A string is UTF-16 code units, as C#'s is, and an encoding is how it becomes
// bytes and how bytes become one again. UTF-8's conversion is the runtime's
// (Utf8Transcoder), because printing makes it too; the rest are here.
//
// What an encoder does with text it cannot represent, and a decoder with bytes
// it cannot read, is .NET's replacement fallback unless told otherwise: an
// unpaired surrogate becomes U+FFFD (or '?' in a single-byte encoding), and each
// maximal ill-formed run of bytes one U+FFFD.

class UTF8Encoding : Encoding {
    public override int CodePage => 65001;
    public override string WebName => "utf-8";
    public override string EncodingName => "Unicode (UTF-8)";

    // Whether a file written in it starts with the byte-order mark (the
    // preamble), and whether text it cannot represent and bytes it cannot read
    // throw rather than being replaced: .NET's two options.
    private bool emitIdentifier;
    private bool throwOnInvalid;

    public UTF8Encoding() { }
    public UTF8Encoding(bool encoderShouldEmitUTF8Identifier) { emitIdentifier = encoderShouldEmitUTF8Identifier; }
    public UTF8Encoding(bool encoderShouldEmitUTF8Identifier, bool throwOnInvalidBytes) {
        emitIdentifier = encoderShouldEmitUTF8Identifier;
        throwOnInvalid = throwOnInvalidBytes;
    }

    public override byte[] GetPreamble() { return emitIdentifier ? new byte[] { 0xEF, 0xBB, 0xBF } : new byte[0]; }

    public override int GetByteCount(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (throwOnInvalid) { RefuseLoneSurrogates(s); }
        return Utf8Transcoder.ByteCount(s, 0, s.Length);
    }

    public override byte[] GetBytes(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (throwOnInvalid) { RefuseLoneSurrogates(s); }
        return Utf8Transcoder.Encode(s, 0, s.Length);
    }

    public override string GetString(byte[] bytes, int index, int count) {
        CheckRange(bytes, index, count);
        if (throwOnInvalid) {
            int bad = Utf8Transcoder.FirstInvalid(bytes, index, count);
            if (bad >= 0) {
                byte[] unknown = new byte[Utf8Transcoder.InvalidLength(bytes, bad, index + count)];
                Array.Copy(bytes, bad, unknown, 0, unknown.Length);
                throw new System.Text.DecoderFallbackException(unknown, bad - index);
            }
        }
        return Utf8Transcoder.Decode(bytes, index, count);
    }

    public override int GetCharCount(byte[] bytes, int index, int count) {
        CheckRange(bytes, index, count);
        return Utf8Transcoder.CharCount(bytes, index, count);
    }

    public override int GetMaxByteCount(int charCount) { return (charCount + 1) * 3; }
    public override int GetMaxCharCount(int byteCount) { return byteCount + 1; }
}

// .NET's ASCIIEncoding: seven bits, and everything above them is a question
// mark in both directions -- one question mark per character, so a surrogate
// pair (one character) becomes one. A four-character section tag read as
// ASCII must be four characters whatever the image holds, or a corrupt tag
// reads back as a valid one.
class ASCIIEncoding : Encoding {
    public override int CodePage => 20127;
    public override string WebName => "us-ascii";
    public override string EncodingName => "US-ASCII";
    public override bool IsSingleByte => true;

    private const int Substitute = 63;              // '?'

    public override int GetByteCount(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return CountCharacters(s);
    }

    public override byte[] GetBytes(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        byte[] made = new byte[CountCharacters(s)];
        int n = 0;
        int at = 0;

        while (at < s.Length) {
            int c = s[at];
            at = at + (Char.IsSurrogatePair(s, at) ? 2 : 1);
            made[n] = (byte)(c > 127 ? Substitute : c);
            n = n + 1;
        }
        return made;
    }

    public override string GetString(byte[] bytes, int at, int count) {
        CheckRange(bytes, at, count);
        string made = Sys.NewChars(count);

        for (int i = 0; i < count; i++) {
            int c = bytes[at + i];

            Sys.SetChar(made, i, c > 127 ? Substitute : c);
        }
        return made;
    }

    public override int GetCharCount(byte[] bytes, int index, int count) { CheckRange(bytes, index, count); return count; }
    public override int GetMaxByteCount(int charCount) { return charCount + 1; }
    public override int GetMaxCharCount(int byteCount) { return byteCount; }
}

/// A UNICODE SCALAR VALUE: U+0000 to U+10FFFF, minus the surrogate range,
/// which is exactly what a `char` cannot always hold -- an emoji is two chars
/// in UTF-16 and one Rune. .NET added the type so that "a character" could
/// stop meaning "a UTF-16 code unit".
struct Rune {
    private int value;

    public Rune(char ch) {
        if ((int)ch >= 0xD800 && (int)ch <= 0xDFFF) {
            throw new ArgumentOutOfRangeException("ch");
        }
        value = (int)ch;
    }

    public Rune(int value) {
        if (!IsValid(value)) { throw new ArgumentOutOfRangeException("value"); }
        this.value = value;
    }

    public Rune(uint value) {
        if (value > 0x10FFFF || !IsValid((int)value)) { throw new ArgumentOutOfRangeException("value"); }
        this.value = (int)value;
    }

    /// A SURROGATE PAIR, the two halves a UTF-16 stream splits a big character
    /// into.
    public Rune(char highSurrogate, char lowSurrogate) {
        int h = (int)highSurrogate;
        int l = (int)lowSurrogate;

        if (h < 0xD800 || h > 0xDBFF) { throw new ArgumentOutOfRangeException("highSurrogate"); }
        if (l < 0xDC00 || l > 0xDFFF) { throw new ArgumentOutOfRangeException("lowSurrogate"); }
        value = 0x10000 + ((h - 0xD800) << 10) + (l - 0xDC00);
    }

    public static explicit operator Rune(char ch) { return new Rune(ch); }
    public static explicit operator Rune(int value) { return new Rune(value); }
    public static explicit operator Rune(uint value) { return new Rune(value); }

    /// U+FFFD, which is what a decoder puts in place of what it cannot read.
    public static Rune ReplacementChar => new Rune(0xFFFD);

    public int Value => value;

    public bool IsAscii => value < 128;

    /// IN THE BASIC MULTILINGUAL PLANE -- that is, expressible as a single
    /// UTF-16 char. Everything above needs a surrogate pair.
    public bool IsBmp => value <= 0xFFFF;

    public int Plane => value >> 16;

    public int Utf8SequenceLength {
        get {
            if (value < 0x80) { return 1; }
            if (value < 0x800) { return 2; }
            if (value < 0x10000) { return 3; }
            return 4;
        }
    }

    public int Utf16SequenceLength => value <= 0xFFFF ? 1 : 2;

    public static bool IsValid(int value) {
        if (value < 0 || value > 0x10FFFF) { return false; }
        return value < 0xD800 || value > 0xDFFF;
    }

    public static bool IsValid(uint value) { return value <= 0x10FFFF && IsValid((int)value); }

    public static bool TryCreate(int value, out Rune result) {
        if (!IsValid(value)) { result = new Rune(0); return false; }
        result = new Rune(value);
        return true;
    }

    public static bool TryCreate(char ch, out Rune result) {
        return TryCreate((int)ch, out result);
    }

    public static bool TryCreate(char highSurrogate, char lowSurrogate, out Rune result) {
        if (!Char.IsSurrogatePair(highSurrogate, lowSurrogate)) { result = new Rune(0); return false; }
        result = new Rune(highSurrogate, lowSurrogate);
        return true;
    }

    /// THE RUNE AT A UTF-16 INDEX: the unit there, or the surrogate pair that
    /// begins there. False for an unpaired surrogate, which is no scalar value.
    public static bool TryGetRuneAt(string input, int index, out Rune value) {
        if (input == null) { throw new ArgumentNullException("input"); }
        if (index < 0 || index >= input.Length) { throw new ArgumentOutOfRangeException("index"); }
        char c = input[index];
        if (!Char.IsSurrogate(c)) { value = new Rune((int)c); return true; }
        if (Char.IsHighSurrogate(c) && index + 1 < input.Length && Char.IsLowSurrogate(input[index + 1])) {
            value = new Rune(c, input[index + 1]);
            return true;
        }
        value = new Rune(0);
        return false;
    }

    public static Rune GetRuneAt(string input, int index) {
        Rune found;
        if (!TryGetRuneAt(input, index, out found)) {
            throw new ArgumentException("Cannot extract a Unicode scalar value from the specified index in the input.", "index");
        }
        return found;
    }

    /// The first scalar value in UTF-16 and how many units it took. An
    /// unpaired surrogate is InvalidData, with the replacement character and
    /// one unit consumed; a high surrogate at the end is NeedMoreData.
    public static System.Buffers.OperationStatus DecodeFromUtf16(ReadOnlySpan<char> source, out Rune result, out int charsConsumed) {
        if (source.Length == 0) {
            result = ReplacementChar;
            charsConsumed = 0;
            return System.Buffers.OperationStatus.NeedMoreData;
        }
        char c = source[0];
        if (!Char.IsSurrogate(c)) {
            result = new Rune((int)c);
            charsConsumed = 1;
            return System.Buffers.OperationStatus.Done;
        }
        if (Char.IsHighSurrogate(c)) {
            if (source.Length < 2) {
                result = ReplacementChar;
                charsConsumed = 1;
                return System.Buffers.OperationStatus.NeedMoreData;
            }
            if (Char.IsLowSurrogate(source[1])) {
                result = new Rune(c, source[1]);
                charsConsumed = 2;
                return System.Buffers.OperationStatus.Done;
            }
        }
        result = ReplacementChar;
        charsConsumed = 1;
        return System.Buffers.OperationStatus.InvalidData;
    }

    /// The first scalar value in UTF-8 and how many bytes it took. Ill-formed
    /// input is InvalidData with its maximal ill-formed subpart consumed; a
    /// well-formed start cut off by the end is NeedMoreData.
    public static System.Buffers.OperationStatus DecodeFromUtf8(ReadOnlySpan<byte> source, out Rune result, out int bytesConsumed) {
        result = ReplacementChar;
        bytesConsumed = 0;
        if (source.Length == 0) { return System.Buffers.OperationStatus.NeedMoreData; }

        int lead = source[0];
        if (lead < 0x80) { result = new Rune(lead); bytesConsumed = 1; return System.Buffers.OperationStatus.Done; }

        int need;
        int low = 0x80, high = 0xBF;
        int scalar;
        if (lead >= 0xC2 && lead <= 0xDF) { need = 1; scalar = lead & 0x1F; }
        else if (lead >= 0xE0 && lead <= 0xEF) {
            need = 2; scalar = lead & 0x0F;
            if (lead == 0xE0) { low = 0xA0; } else if (lead == 0xED) { high = 0x9F; }
        }
        else if (lead >= 0xF0 && lead <= 0xF4) {
            need = 3; scalar = lead & 0x07;
            if (lead == 0xF0) { low = 0x90; } else if (lead == 0xF4) { high = 0x8F; }
        }
        else { bytesConsumed = 1; return System.Buffers.OperationStatus.InvalidData; }

        for (int i = 1; i <= need; i++) {
            if (i >= source.Length) { bytesConsumed = i; return System.Buffers.OperationStatus.NeedMoreData; }
            int b = source[i];
            int lo = i == 1 ? low : 0x80;
            int hi = i == 1 ? high : 0xBF;
            if (b < lo || b > hi) { bytesConsumed = i; return System.Buffers.OperationStatus.InvalidData; }
            scalar = (scalar << 6) | (b & 0x3F);
        }
        result = new Rune(scalar);
        bytesConsumed = need + 1;
        return System.Buffers.OperationStatus.Done;
    }

    /// The scalar value as UTF-16 into `destination`; how many units.
    public bool TryEncodeToUtf16(Span<char> destination, out int charsWritten) {
        if (destination.Length < Utf16SequenceLength) { charsWritten = 0; return false; }
        if (IsBmp) {
            destination[0] = (char)value;
            charsWritten = 1;
            return true;
        }
        destination[0] = (char)(0xD800 + ((value - 0x10000) >> 10));
        destination[1] = (char)(0xDC00 + ((value - 0x10000) & 0x3FF));
        charsWritten = 2;
        return true;
    }

    public int EncodeToUtf16(Span<char> destination) {
        int written;
        if (!TryEncodeToUtf16(destination, out written)) { throw new ArgumentException("Destination is too short.", "destination"); }
        return written;
    }

    /// The scalar value as UTF-8 into `destination`; how many bytes.
    public bool TryEncodeToUtf8(Span<byte> destination, out int bytesWritten) {
        int length = Utf8SequenceLength;
        if (destination.Length < length) { bytesWritten = 0; return false; }
        if (length == 1) {
            destination[0] = (byte)value;
        } else if (length == 2) {
            destination[0] = (byte)(0xC0 | (value >> 6));
            destination[1] = (byte)(0x80 | (value & 0x3F));
        } else if (length == 3) {
            destination[0] = (byte)(0xE0 | (value >> 12));
            destination[1] = (byte)(0x80 | ((value >> 6) & 0x3F));
            destination[2] = (byte)(0x80 | (value & 0x3F));
        } else {
            destination[0] = (byte)(0xF0 | (value >> 18));
            destination[1] = (byte)(0x80 | ((value >> 12) & 0x3F));
            destination[2] = (byte)(0x80 | ((value >> 6) & 0x3F));
            destination[3] = (byte)(0x80 | (value & 0x3F));
        }
        bytesWritten = length;
        return true;
    }

    public int EncodeToUtf8(Span<byte> destination) {
        int written;
        if (!TryEncodeToUtf8(destination, out written)) { throw new ArgumentException("Destination is too short.", "destination"); }
        return written;
    }

    /// THE CHARACTER AS TEXT: its one or two UTF-16 units.
    public string ToString() {
        if (IsBmp) { return String.FromByte((long)value); }
        string made = Sys.NewChars(2);
        Sys.SetChar(made, 0, 0xD800 + ((value - 0x10000) >> 10));
        Sys.SetChar(made, 1, 0xDC00 + ((value - 0x10000) & 0x3FF));
        return made;
    }

    public int CompareTo(Rune other) { return value - other.Value; }
    public bool Equals(Rune other) { return value == other.Value; }
    public int GetHashCode() { return value; }

    public static bool operator ==(Rune left, Rune right) { return left.Value == right.Value; }
    public static bool operator !=(Rune left, Rune right) { return left.Value != right.Value; }
    public static bool operator <(Rune left, Rune right) { return left.Value < right.Value; }
    public static bool operator >(Rune left, Rune right) { return left.Value > right.Value; }
    public static bool operator <=(Rune left, Rune right) { return left.Value <= right.Value; }
    public static bool operator >=(Rune left, Rune right) { return left.Value >= right.Value; }

    // ---- the character classes, from the Unicode tables ------------------

    private static int Category(Rune r) { return UnicodeCategories.Of(r.Value); }

    public static System.Globalization.UnicodeCategory GetUnicodeCategory(Rune value) {
        return (System.Globalization.UnicodeCategory)Category(value);
    }
    public static double GetNumericValue(Rune value) { return UnicodeNumerics.Of(value.Value); }

    public static bool IsDigit(Rune value) { return Category(value) == 8; }
    public static bool IsLetter(Rune value) { return Category(value) <= 4; }
    public static bool IsLetterOrDigit(Rune value) { int k = Category(value); return k <= 4 || k == 8; }
    public static bool IsNumber(Rune value) { int k = Category(value); return k >= 8 && k <= 10; }
    public static bool IsUpper(Rune value) { return Category(value) == 0; }
    public static bool IsLower(Rune value) { return Category(value) == 1; }
    public static bool IsControl(Rune value) { return Category(value) == 14; }
    public static bool IsSeparator(Rune value) { int k = Category(value); return k >= 11 && k <= 13; }
    public static bool IsPunctuation(Rune value) { int k = Category(value); return k >= 18 && k <= 24; }
    public static bool IsSymbol(Rune value) { int k = Category(value); return k >= 25 && k <= 28; }
    public static bool IsWhiteSpace(Rune value) { return value.IsBmp && Char.IsWhiteSpace((char)value.Value); }

    public static Rune ToUpperInvariant(Rune value) { return new Rune(UnicodeCase.Upper(value.Value)); }
    public static Rune ToLowerInvariant(Rune value) { return new Rune(UnicodeCase.Lower(value.Value)); }
    public static Rune ToUpper(Rune value, CultureInfo culture) { return ToUpperInvariant(value); }
    public static Rune ToLower(Rune value, CultureInfo culture) { return ToLowerInvariant(value); }
}

/// UTF-16, which is what .NET's Encoding.Unicode is: two bytes per code unit,
/// little end first unless told otherwise. A string is UTF-16 already, so
/// encoding is putting its units down in the byte order asked for.
class UnicodeEncoding : Encoding {
    public override int CodePage => big ? 1201 : 1200;
    public override string WebName => big ? "utf-16BE" : "utf-16";
    public override string EncodingName => big ? "Unicode (Big-Endian)" : "Unicode";

    private bool big;
    private bool mark;
    private bool throwOnInvalid;

    public UnicodeEncoding() {
        big = false;
        mark = true;
    }

    public UnicodeEncoding(bool bigEndian, bool byteOrderMark) {
        big = bigEndian;
        mark = byteOrderMark;
    }

    public UnicodeEncoding(bool bigEndian, bool byteOrderMark, bool throwOnInvalidBytes) {
        big = bigEndian;
        mark = byteOrderMark;
        throwOnInvalid = throwOnInvalidBytes;
    }

    /// U+FEFF, in this encoding's byte order, or nothing when the encoding was
    /// not asked to emit one. .NET's GetPreamble.
    public override byte[] GetPreamble() {
        if (!mark) { return new byte[0]; }

        byte[] made = new byte[2];

        if (big) { made[0] = 0xFE; made[1] = 0xFF; } else { made[0] = 0xFF; made[1] = 0xFE; }
        return made;
    }

    public override int GetByteCount(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (throwOnInvalid) { RefuseLoneSurrogates(s); }
        return s.Length * 2;
    }

    /// Unit by unit, an unpaired surrogate becoming U+FFFD.
    public override byte[] GetBytes(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        if (throwOnInvalid) { RefuseLoneSurrogates(s); }
        byte[] made = new byte[s.Length * 2];

        for (int at = 0; at < s.Length; at++) {
            int unit = s[at];
            if (Char.IsHighSurrogate((char)unit) && at + 1 < s.Length && Char.IsLowSurrogate(s[at + 1])) {
                Put(made, at * 2, unit);
                Put(made, at * 2 + 2, s[at + 1]);
                at = at + 1;
                continue;
            }
            Put(made, at * 2, Char.IsSurrogate((char)unit) ? 0xFFFD : unit);
        }
        return made;
    }

    /// Pairs of bytes to units: an unpaired surrogate, and an odd byte left at
    /// the end, each become U+FFFD.
    public override string GetString(byte[] bytes, int index, int count) {
        CheckRange(bytes, index, count);
        int units = (count + 1) / 2;
        string made = Sys.NewChars(units);
        int end = index + count;
        int o = 0;

        for (int at = index; at < end; at = at + 2) {
            if (at + 1 >= end) {
                Refuse(bytes, at, 1, index);
                Sys.SetChar(made, o, 0xFFFD);
                o = o + 1;
                break;
            }
            int unit = Unit(bytes, at);
            if (Char.IsHighSurrogate((char)unit) && at + 3 < end && Char.IsLowSurrogate((char)Unit(bytes, at + 2))) {
                Sys.SetChar(made, o, unit);
                Sys.SetChar(made, o + 1, Unit(bytes, at + 2));
                o = o + 2;
                at = at + 2;
                continue;
            }
            if (Char.IsSurrogate((char)unit)) {
                Refuse(bytes, at, 2, index);
                unit = 0xFFFD;
            }
            Sys.SetChar(made, o, unit);
            o = o + 1;
        }
        return o == units ? made : String.Substring(made, 0, o);
    }

    public override int GetCharCount(byte[] bytes, int index, int count) { CheckRange(bytes, index, count); return (count + 1) / 2; }
    public override int GetMaxByteCount(int charCount) { return (charCount + 1) * 2; }
    public override int GetMaxCharCount(int byteCount) { return byteCount / 2 + 2; }

    private void Refuse(byte[] bytes, int at, int length, int index) {
        if (!throwOnInvalid) { return; }
        byte[] unknown = new byte[length];
        Array.Copy(bytes, at, unknown, 0, length);
        throw new System.Text.DecoderFallbackException(unknown, at - index);
    }

    private int Unit(byte[] bytes, int at) {
        int first = bytes[at];
        int second = bytes[at + 1];

        return big ? (first << 8) | second : (second << 8) | first;
    }

    private void Put(byte[] into, int at, int unit) {
        if (big) {
            into[at] = (byte)(unit >> 8);
            into[at + 1] = (byte)(unit & 255);
        } else {
            into[at] = (byte)(unit & 255);
            into[at + 1] = (byte)(unit >> 8);
        }
    }
}

/// UTF-32: four bytes for every character, whatever it is. Nobody sends text
/// in it and plenty of things hold text in it, because indexing is then what
/// indexing looks like -- the nth character is at the nth position, which is
/// true in neither of the other two.
class UTF32Encoding : Encoding {
    public override int CodePage => big ? 12001 : 12000;
    public override string WebName => big ? "utf-32BE" : "utf-32";
    public override string EncodingName => big ? "Unicode (UTF-32 Big-Endian)" : "Unicode (UTF-32)";

    private bool big;
    private bool mark;

    public UTF32Encoding() { big = false; mark = true; }

    public UTF32Encoding(bool bigEndian, bool byteOrderMark) { big = bigEndian; mark = byteOrderMark; }

    public override byte[] GetPreamble() {
        if (!mark) { return new byte[0]; }
        byte[] made = new byte[4];
        Put(made, 0, 0xFEFF);
        return made;
    }

    public override int GetByteCount(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return CountCharacters(s) * 4;
    }

    public override byte[] GetBytes(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        byte[] made = new byte[CountCharacters(s) * 4];
        int written = 0;
        int at = 0;

        while (at < s.Length) {
            int value = s[at];
            if (Char.IsSurrogatePair(s, at)) {
                value = Char.ConvertToUtf32(s[at], s[at + 1]);
                at = at + 2;
            } else {
                if (Char.IsSurrogate((char)value)) { value = 0xFFFD; }
                at = at + 1;
            }
            Put(made, written, value);
            written = written + 4;
        }
        return made;
    }

    /// Four bytes to a character: one that is no scalar value, and a part
    /// value left at the end, each become U+FFFD.
    public override string GetString(byte[] bytes, int index, int count) {
        CheckRange(bytes, index, count);
        StringBuilder made = new StringBuilder();
        int end = index + count;
        int at = index;

        for (; at + 3 < end; at = at + 4) {
            int value = 0;

            for (int i = 0; i < 4; i++) {
                int shift = big ? (24 - i * 8) : (i * 8);

                value = value | (bytes[at + i] << shift);
            }

            if (!Rune.IsValid(value)) { value = 0xFFFD; }
            made.Append(Char.ConvertFromUtf32(value));
        }
        if (at < end) { made.Append((char)0xFFFD); }
        return made.ToString();
    }

    public override int GetMaxByteCount(int charCount) { return (charCount + 1) * 4; }
    public override int GetMaxCharCount(int byteCount) { return byteCount / 2 + 2; }

    private void Put(byte[] into, int at, int value) {
        for (int i = 0; i < 4; i++) {
            int shift = big ? (24 - i * 8) : (i * 8);

            into[at + i] = (byte)((value >> shift) & 255);
        }
    }
}

/// A single-byte code page: Latin-1 (28591), Windows' ANSI Western page
/// (1252), and the IBM PC's OEM page (437), each byte from 0x80 up a table's
/// character -- NT's c_1252.nls and c_437.nls, 1252's five undefined bytes
/// mapping to themselves as they do there. A character the page has not
/// becomes '?', .NET's replacement fallback, once per character.
class CodePageEncoding : Encoding {
    private const int Substitute = 63;              // '?'
    private int page;
    private int[] high;
    private Dictionary<int, int>? back;

    static readonly int[] Ansi = new int[] {
        0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
        0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178,
        0x00A0, 0x00A1, 0x00A2, 0x00A3, 0x00A4, 0x00A5, 0x00A6, 0x00A7, 0x00A8, 0x00A9, 0x00AA, 0x00AB, 0x00AC, 0x00AD, 0x00AE, 0x00AF,
        0x00B0, 0x00B1, 0x00B2, 0x00B3, 0x00B4, 0x00B5, 0x00B6, 0x00B7, 0x00B8, 0x00B9, 0x00BA, 0x00BB, 0x00BC, 0x00BD, 0x00BE, 0x00BF,
        0x00C0, 0x00C1, 0x00C2, 0x00C3, 0x00C4, 0x00C5, 0x00C6, 0x00C7, 0x00C8, 0x00C9, 0x00CA, 0x00CB, 0x00CC, 0x00CD, 0x00CE, 0x00CF,
        0x00D0, 0x00D1, 0x00D2, 0x00D3, 0x00D4, 0x00D5, 0x00D6, 0x00D7, 0x00D8, 0x00D9, 0x00DA, 0x00DB, 0x00DC, 0x00DD, 0x00DE, 0x00DF,
        0x00E0, 0x00E1, 0x00E2, 0x00E3, 0x00E4, 0x00E5, 0x00E6, 0x00E7, 0x00E8, 0x00E9, 0x00EA, 0x00EB, 0x00EC, 0x00ED, 0x00EE, 0x00EF,
        0x00F0, 0x00F1, 0x00F2, 0x00F3, 0x00F4, 0x00F5, 0x00F6, 0x00F7, 0x00F8, 0x00F9, 0x00FA, 0x00FB, 0x00FC, 0x00FD, 0x00FE, 0x00FF,
    };

    static readonly int[] Oem = new int[] {
        0x00C7, 0x00FC, 0x00E9, 0x00E2, 0x00E4, 0x00E0, 0x00E5, 0x00E7, 0x00EA, 0x00EB, 0x00E8, 0x00EF, 0x00EE, 0x00EC, 0x00C4, 0x00C5,
        0x00C9, 0x00E6, 0x00C6, 0x00F4, 0x00F6, 0x00F2, 0x00FB, 0x00F9, 0x00FF, 0x00D6, 0x00DC, 0x00A2, 0x00A3, 0x00A5, 0x20A7, 0x0192,
        0x00E1, 0x00ED, 0x00F3, 0x00FA, 0x00F1, 0x00D1, 0x00AA, 0x00BA, 0x00BF, 0x2310, 0x00AC, 0x00BD, 0x00BC, 0x00A1, 0x00AB, 0x00BB,
        0x2591, 0x2592, 0x2593, 0x2502, 0x2524, 0x2561, 0x2562, 0x2556, 0x2555, 0x2563, 0x2551, 0x2557, 0x255D, 0x255C, 0x255B, 0x2510,
        0x2514, 0x2534, 0x252C, 0x251C, 0x2500, 0x253C, 0x255E, 0x255F, 0x255A, 0x2554, 0x2569, 0x2566, 0x2560, 0x2550, 0x256C, 0x2567,
        0x2568, 0x2564, 0x2565, 0x2559, 0x2558, 0x2552, 0x2553, 0x256B, 0x256A, 0x2518, 0x250C, 0x2588, 0x2584, 0x258C, 0x2590, 0x2580,
        0x03B1, 0x00DF, 0x0393, 0x03C0, 0x03A3, 0x03C3, 0x00B5, 0x03C4, 0x03A6, 0x0398, 0x03A9, 0x03B4, 0x221E, 0x03C6, 0x03B5, 0x2229,
        0x2261, 0x00B1, 0x2265, 0x2264, 0x2320, 0x2321, 0x00F7, 0x2248, 0x00B0, 0x2219, 0x00B7, 0x221A, 0x207F, 0x00B2, 0x25A0, 0x00A0,
    };

    public CodePageEncoding(int codepage) {
        page = codepage;
        high = new int[128];
        for (int i = 0; i < 128; i++) { high[i] = codepage == 1252 ? Ansi[i] : codepage == 437 ? Oem[i] : 0x80 + i; }
    }

    public override int CodePage => page;
    public override string WebName => page == 1252 ? "windows-1252" : page == 437 ? "IBM437" : "iso-8859-1";
    public override string EncodingName => page == 1252 ? "Western European (Windows)" : page == 437 ? "OEM United States" : "Western European (ISO)";
    public override bool IsSingleByte => true;

    /// The byte a character is on this page, or -1.
    int ByteOf(int character) {
        if (character < 0x80) { return character; }
        if (back == null) {
            Dictionary<int, int> made = new Dictionary<int, int>();
            for (int i = 0; i < 128; i++) { if (!made.ContainsKey(high[i])) { made[high[i]] = 0x80 + i; } }
            back = made;
        }
        int b;
        return back.TryGetValue(character, out b) ? b : -1;
    }

    /// The character a byte is on this page.
    public int CharacterOf(int b) { b = b & 255; return b < 0x80 ? b : high[b - 0x80]; }

    public override int GetByteCount(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return CountCharacters(s);
    }

    public override byte[] GetBytes(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        byte[] made = new byte[CountCharacters(s)];
        int at = 0;
        int n = 0;

        while (at < s.Length) {
            bool pair = Char.IsSurrogatePair(s, at);
            int b = pair ? -1 : ByteOf(s[at]);
            made[n] = (byte)(b < 0 ? Substitute : b);
            n = n + 1;
            at = at + (pair ? 2 : 1);
        }
        return made;
    }

    public override string GetString(byte[] bytes, int index, int count) {
        CheckRange(bytes, index, count);
        string made = Sys.NewChars(count);

        for (int i = 0; i < count; i++) {
            Sys.SetChar(made, i, CharacterOf(bytes[index + i]));
        }
        return made;
    }

    public override int GetCharCount(byte[] bytes, int index, int count) { CheckRange(bytes, index, count); return count; }
    public override int GetMaxByteCount(int charCount) { return charCount + 1; }
    public override int GetMaxCharCount(int byteCount) { return byteCount; }
}

/// .NET's Encoding: the abstract base every encoding derives from, and the
/// static properties naming the common ones, typed Encoding as .NET types
/// them. What a derived encoding must say is how text becomes bytes and bytes
/// text; everything else is said once, here, in terms of those.
abstract class Encoding {
    public static Encoding UTF8 => new UTF8Encoding(true);
    public static Encoding ASCII => new ASCIIEncoding();

    /// UTF-16, little end first, which is what .NET means by "Unicode" -- the
    /// name is a historical accident and the encoding is one of several.
    public static Encoding Unicode => new UnicodeEncoding();
    public static Encoding BigEndianUnicode => new UnicodeEncoding(true, true);
    public static Encoding UTF32 => new UTF32Encoding();

    /// ISO 8859-1, each byte the character of the same number (.NET 5's
    /// Encoding.Latin1).
    public static Encoding Latin1 => new CodePageEncoding(28591);

    /// What .NET Core answers for the system's default: UTF-8 without a mark.
    static readonly Encoding _default = new UTF8Encoding(false);
    public static Encoding Default => _default;

    /// The encoding a code page number names -- the Unicode forms, ASCII,
    /// Latin-1, and the Windows code pages this system carries tables for:
    /// 1252, the ANSI one, and 437, the OEM one. Any other is
    /// NotSupportedException, as .NET answers a page it has no provider for.
    public static Encoding GetEncoding(int codepage)
    {
        switch (codepage)
        {
            case 65001: return new UTF8Encoding(true);
            case 20127: return new ASCIIEncoding();
            case 1200: return new UnicodeEncoding();
            case 1201: return new UnicodeEncoding(true, true);
            case 12000: return new UTF32Encoding();
            case 12001: return new UTF32Encoding(true, true);
            case 28591: case 1252: case 437: return new CodePageEncoding(codepage);
        }
        throw new NotSupportedException("No data is available for encoding " + codepage + ".");
    }

    /// The encoding a web name names, as GetEncoding(int) does, case aside.
    public static Encoding GetEncoding(string name)
    {
        switch (name.ToLowerInvariant())
        {
            case "utf-8": return GetEncoding(65001);
            case "us-ascii": case "ascii": return GetEncoding(20127);
            case "utf-16": case "unicode": case "utf-16le": return GetEncoding(1200);
            case "utf-16be": case "unicodefffe": return GetEncoding(1201);
            case "utf-32": case "utf-32le": return GetEncoding(12000);
            case "utf-32be": return GetEncoding(12001);
            case "iso-8859-1": case "latin1": return GetEncoding(28591);
            case "windows-1252": return GetEncoding(1252);
            case "ibm437": case "cp437": return GetEncoding(437);
        }
        throw new ArgumentException("'" + name + "' is not a supported encoding name.", "name");
    }

    /// Its code page number, name for the web, and name for people.
    public virtual int CodePage => 0;
    public virtual string WebName => "";
    public virtual string EncodingName => "";
    public virtual string BodyName => WebName;
    public virtual string HeaderName => WebName;

    /// Whether every character is one byte.
    public virtual bool IsSingleByte => false;

    public abstract byte[] GetBytes(string s);
    public abstract int GetByteCount(string s);
    public abstract string GetString(byte[] bytes, int index, int count);

    public virtual byte[] GetBytes(char[] chars) { return GetBytes(new string(chars)); }
    public virtual byte[] GetBytes(char[] chars, int index, int count) { return GetBytes(new string(chars, index, count)); }
    public byte[] GetBytes(string s, int index, int count) { return GetBytes(s.Substring(index, count)); }

    /// Into a byte array the caller owns; answers how many bytes were written.
    public virtual int GetBytes(string s, int charIndex, int charCount, byte[] bytes, int byteIndex) {
        byte[] made = GetBytes(s.Substring(charIndex, charCount));
        if (byteIndex < 0 || byteIndex > bytes.Length - made.Length) {
            throw new ArgumentException("The output byte buffer is too small to contain the encoded data.", "bytes");
        }
        Array.Copy(made, 0, bytes, byteIndex, made.Length);
        return made.Length;
    }
    public virtual int GetBytes(char[] chars, int charIndex, int charCount, byte[] bytes, int byteIndex) {
        return GetBytes(new string(chars, charIndex, charCount), 0, charCount, bytes, byteIndex);
    }

    public virtual int GetByteCount(char[] chars) { return GetByteCount(new string(chars)); }
    public virtual int GetByteCount(char[] chars, int index, int count) { return GetByteCount(new string(chars, index, count)); }

    public virtual string GetString(byte[] bytes) {
        if (bytes == null) { throw new ArgumentNullException("bytes"); }
        return GetString(bytes, 0, bytes.Length);
    }
    public virtual string GetString(ReadOnlySpan<byte> bytes) { byte[] copy = bytes.ToArray(); return GetString(copy, 0, copy.Length); }

    /// The UTF-16 code units the bytes decode to.
    public virtual char[] GetChars(byte[] bytes) { return GetChars(bytes, 0, bytes.Length); }
    public virtual char[] GetChars(byte[] bytes, int index, int count) { return GetString(bytes, index, count).ToCharArray(); }

    /// Into a char array the caller owns; answers how many chars were written.
    public virtual int GetChars(byte[] bytes, int byteIndex, int byteCount, char[] chars, int charIndex) {
        string text = GetString(bytes, byteIndex, byteCount);
        if (charIndex < 0 || charIndex > chars.Length - text.Length) {
            throw new ArgumentException("The output char buffer is too small to contain the decoded characters.", "chars");
        }
        for (int i = 0; i < text.Length; i++) { chars[charIndex + i] = text[i]; }
        return text.Length;
    }

    public virtual int GetCharCount(byte[] bytes) { return GetCharCount(bytes, 0, bytes.Length); }
    public virtual int GetCharCount(byte[] bytes, int index, int count) { return GetString(bytes, index, count).Length; }

    public virtual int GetMaxByteCount(int charCount) { return (charCount + 1) * 4; }
    public virtual int GetMaxCharCount(int byteCount) { return byteCount + 1; }

    /// The byte-order mark a file in this encoding may begin with; none by default.
    public virtual byte[] GetPreamble() { return new byte[0]; }

    // ---- what the encodings share ---------------------------------------

    protected static void CheckRange(byte[] bytes, int index, int count) {
        if (bytes == null) { throw new ArgumentNullException("bytes"); }
        if (index < 0 || count < 0) { throw new ArgumentOutOfRangeException(index < 0 ? "index" : "count", "Non-negative number required."); }
        if (index > bytes.Length - count) { throw new ArgumentOutOfRangeException("bytes", "Index and count must refer to a location within the buffer."); }
    }

    /// Characters, not code units: a surrogate pair is one, and so is an
    /// unpaired surrogate, which an encoder replaces with one character.
    protected static int CountCharacters(string s) {
        int count = 0;
        int at = 0;

        while (at < s.Length) {
            at = at + (Char.IsSurrogatePair(s, at) ? 2 : 1);
            count = count + 1;
        }
        return count;
    }

    /// What an encoder that throws does with an unpaired surrogate.
    protected static void RefuseLoneSurrogates(string s) {
        for (int at = 0; at < s.Length; at++) {
            char c = s[at];
            if (!Char.IsSurrogate(c)) { continue; }
            if (Char.IsSurrogatePair(s, at)) { at = at + 1; continue; }
            throw new System.Text.EncoderFallbackException("Unable to translate Unicode character \\u"
                + ((int)c).ToString("X4") + " at index " + at + " to specified code page.");
        }
    }
}

// ---- a view of part of an array --------------------------------------------
//
// .NET's Span<T> and ReadOnlySpan<T>, with the members that mean anything on
// this machine: a length, an index, a slice and a copy out. They are `ref
// struct`s there -- a rule about where one may be STORED, which exists because
// a span can point at the stack, and which nothing here can point at.
//
// An array converts to one implicitly, as it does in C#; the compiler makes
// that conversion, since C# spells it as an operator on the type and this has
// no user-defined conversions yet.

/// THE THROWS OF THE HOT MEMBERS, out of line, as .NET's ThrowHelper: a
/// member with a throw in it is never inlined (an unwind cannot be), so the
/// indexer of every list was a call. Each is a call that does not return.
static class ThrowHelper {
    public static void IndexOutOfRange() {
        throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection.");
    }

    public static void CollectionModified() {
        throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");
    }

    public static void KeyNotFound(object? key) {
        throw new KeyNotFoundException($"The given key '{key}' was not present in the dictionary.");
    }

    public static void DuplicateKey(object? key) {
        throw new ArgumentException($"An item with the same key has already been added. Key: {key}");
    }
}

/// A WINDOW ON AN ARRAY, as .NET's ArraySegment<T>: the array, where the
/// window begins and how long it is, read and written through as a list. It
/// copies nothing -- a sorted array's run handed out as an ArraySegment is
/// the run itself.
struct ArraySegment<T> : IList<T>, IReadOnlyList<T>, IEnumerable<T> {
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private readonly T[]? array;
    private readonly int offset;
    private readonly int count;

    public ArraySegment(T[] array) {
        ArgumentNullException.ThrowIfNull(array);
        this.array = array;
        offset = 0;
        count = array.Length;
    }

    public ArraySegment(T[] array, int offset, int count) {
        ArgumentNullException.ThrowIfNull(array);
        if (offset < 0 || count < 0 || array.Length - offset < count) {
            throw new ArgumentOutOfRangeException(offset < 0 ? "offset" : "count");
        }
        this.array = array;
        this.offset = offset;
        this.count = count;
    }

    public static ArraySegment<T> Empty => new ArraySegment<T>(new T[0]);

    public T[]? Array => array;
    public int Offset => offset;
    public int Count => count;

    public T this[int index] {
        get {
            if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index"); }
            return array![offset + index];
        }
        set {
            if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index"); }
            array![offset + index] = value;
        }
    }

    public ArraySegment<T> Slice(int index) { return Slice(index, count - index); }

    public ArraySegment<T> Slice(int index, int length) {
        if (index < 0 || length < 0 || count - index < length) { throw new ArgumentOutOfRangeException("index"); }
        return new ArraySegment<T>(array!, offset + index, length);
    }

    public T[] ToArray() {
        T[] made = new T[count];
        for (int i = 0; i < count; i++) { made[i] = array![offset + i]; }
        return made;
    }

    public IEnumerator<T> GetEnumerator() {
        for (int i = 0; i < count; i++) { yield return array![offset + i]; }
    }

    public int IndexOf(T item) {
        for (int i = 0; i < count; i++) {
            if (EqualityComparer<T>.Default.Equals(array![offset + i], item)) { return i; }
        }
        return -1;
    }

    public bool Contains(T item) { return IndexOf(item) >= 0; }

    public void CopyTo(T[] destination, int index) {
        for (int i = 0; i < count; i++) { destination[index + i] = array![offset + i]; }
    }

    bool ICollection<T>.IsReadOnly => true;
    void ICollection<T>.Add(T item) { throw new NotSupportedException(); }
    void ICollection<T>.Clear() { throw new NotSupportedException(); }
    bool ICollection<T>.Remove(T item) { throw new NotSupportedException(); }
    void IList<T>.Insert(int index, T item) { throw new NotSupportedException(); }
    void IList<T>.RemoveAt(int index) { throw new NotSupportedException(); }
}

struct ReadOnlySpan<T> {
    private T[] items;
    private int from;
    private int count;

    public ReadOnlySpan(T[] source) {
        items = source;
        from = 0;
        count = source.Length;
    }

    public ReadOnlySpan(T[] source, int start, int length) {
        items = source;
        from = start;
        count = length;
    }

    public int Length => count;

    /// What the span reads, for the library's own code that must hand the
    /// memory itself on (Runtime.Print of bytes), as MemoryMarshal does in .NET.
    internal T[] Items => items;
    internal int Start => from;

    public T this[int index] {
        get { return items[from + index]; }
    }

    /// THE ORDER OF TWO SEQUENCES, element by element and then by length:
    /// .NET's MemoryExtensions.SequenceCompareTo.
    public int SequenceCompareTo(ReadOnlySpan<T> other) {
        IComparer<T> by = Comparer<T>.Default;
        int common = count < other.Length ? count : other.Length;
        for (int i = 0; i < common; i++) {
            int order = by.Compare(items[from + i], other[i]);
            if (order != 0) { return order; }
        }
        return count.CompareTo(other.Length);
    }

    public ReadOnlySpan<T> Slice(int start) {
        return new ReadOnlySpan<T>(items, from + start, count - start);
    }

    public ReadOnlySpan<T> Slice(int start, int length) {
        return new ReadOnlySpan<T>(items, from + start, length);
    }

    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[from + i]; }
        return made;
    }

    public string ToString() {
        string made = Sys.NewChars(count);
        for (int i = 0; i < count; i++) {
            Sys.SetChar(made, i, (int)Sys.Word(items[from + i]));
        }
        return made;
    }

    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[from + i]; }
    }

    /// A span over nothing, which is what a section with no bytes in the file
    /// hands back. Not null: a span is a value and there is no such thing.
    /// Over the one empty array of its type: nothing is allocated to say so.
    public static ReadOnlySpan<T> Empty => new ReadOnlySpan<T>(EmptyArray<T>.Value);

    // SequenceEqual, IndexOf, Contains and the rest are MemoryExtensions',
    // as in .NET: an instance member here would be chosen over every
    // extension, and the byte forms there -- a word at a time -- never.
}

/// .NET's Memory<T>: a window onto an array that, unlike a span, may be kept
/// in a field or handed to an asynchronous method. Span is how it is read.
readonly struct Memory<T> {
    private readonly T[]? items;
    private readonly int from;
    private readonly int count;

    public Memory(T[]? array) {
        items = array;
        from = 0;
        count = array == null ? 0 : array.Length;
    }

    public Memory(T[]? array, int start, int length) {
        if (array == null) {
            if (start != 0 || length != 0) { throw new ArgumentOutOfRangeException("start"); }
        }
        else if (start < 0 || length < 0 || start > array.Length - length) {
            throw new ArgumentOutOfRangeException("start");
        }
        items = array;
        from = start;
        count = length;
    }

    public static Memory<T> Empty => default;

    public int Length => count;
    public bool IsEmpty => count == 0;

    public Span<T> Span => items == null ? new Span<T>(new T[0]) : new Span<T>(items, from, count);

    public Memory<T> Slice(int start) {
        if (start < 0 || start > count) { throw new ArgumentOutOfRangeException("start"); }
        return new Memory<T>(items, from + start, count - start);
    }

    public Memory<T> Slice(int start, int length) {
        if (start < 0 || length < 0 || start > count - length) { throw new ArgumentOutOfRangeException("start"); }
        return new Memory<T>(items, from + start, length);
    }

    public T[] ToArray() { return Span.ToArray(); }

    /// The array, start and length, for a reader that works in those.
    internal T[]? Array => items;
    internal int Start => from;

    public static implicit operator Memory<T>(T[]? array) => new Memory<T>(array);

    public static implicit operator ReadOnlyMemory<T>(Memory<T> memory) => new ReadOnlyMemory<T>(memory.items, memory.from, memory.count);
}

/// .NET's ReadOnlyMemory<T>: a Memory the holder promises not to write.
readonly struct ReadOnlyMemory<T> {
    private readonly T[]? items;
    private readonly int from;
    private readonly int count;

    public ReadOnlyMemory(T[]? array) {
        items = array;
        from = 0;
        count = array == null ? 0 : array.Length;
    }

    public ReadOnlyMemory(T[]? array, int start, int length) {
        if (array == null) {
            if (start != 0 || length != 0) { throw new ArgumentOutOfRangeException("start"); }
        }
        else if (start < 0 || length < 0 || start > array.Length - length) {
            throw new ArgumentOutOfRangeException("start");
        }
        items = array;
        from = start;
        count = length;
    }

    public static ReadOnlyMemory<T> Empty => default;

    public int Length => count;
    public bool IsEmpty => count == 0;

    public ReadOnlySpan<T> Span => items == null ? new ReadOnlySpan<T>(new T[0]) : new ReadOnlySpan<T>(items, from, count);

    public ReadOnlyMemory<T> Slice(int start) {
        if (start < 0 || start > count) { throw new ArgumentOutOfRangeException("start"); }
        return new ReadOnlyMemory<T>(items, from + start, count - start);
    }

    public ReadOnlyMemory<T> Slice(int start, int length) {
        if (start < 0 || length < 0 || start > count - length) { throw new ArgumentOutOfRangeException("start"); }
        return new ReadOnlyMemory<T>(items, from + start, length);
    }

    public T[] ToArray() { return Span.ToArray(); }

    internal T[]? Array => items;
    internal int Start => from;

    public static implicit operator ReadOnlyMemory<T>(T[]? array) => new ReadOnlyMemory<T>(array);
}

struct Span<T> {
    private T[] items;
    private int from;
    private int count;

    public Span(T[] source) {
        items = source;
        from = 0;
        count = source.Length;
    }

    public Span(T[] source, int start, int length) {
        items = source;
        from = start;
        count = length;
    }

    public int Length => count;

    internal T[] Array => items;
    internal int Start => from;

    public T this[int index] {
        get { return items[from + index]; }
        set { items[from + index] = value; }
    }

    /// THE ORDER OF TWO SEQUENCES, element by element and then by length:
    /// .NET's MemoryExtensions.SequenceCompareTo.
    public int SequenceCompareTo(ReadOnlySpan<T> other) {
        IComparer<T> by = Comparer<T>.Default;
        int common = count < other.Length ? count : other.Length;
        for (int i = 0; i < common; i++) {
            int order = by.Compare(items[from + i], other[i]);
            if (order != 0) { return order; }
        }
        return count.CompareTo(other.Length);
    }

    public Span<T> Slice(int start) {
        return new Span<T>(items, from + start, count - start);
    }

    public Span<T> Slice(int start, int length) {
        return new Span<T>(items, from + start, length);
    }

    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[from + i]; }
        return made;
    }

    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[from + i]; }
    }

    // SequenceEqual and the rest are MemoryExtensions', as in .NET.

    /// This span as read-only, over the same memory: .NET's implicit
    /// conversion, written out while the compiler has no user-defined ones.
    public ReadOnlySpan<T> AsReadOnly() { return new ReadOnlySpan<T>(items, from, count); }
}

/// The one empty array of each element type, as .NET's Array.Empty<T>()
/// answers it: an empty array made at every ask was garbage every time.
class EmptyArray<T> {
    internal static readonly T[] Value = new T[0];
}

/// .NET'S MemoryExtensions: searching and comparing spans. Every member
/// allocates nothing. The byte forms work on memory a word at a time (a byte
/// found by the has-a-zero-byte test on the word XORed with it repeated) and
/// are chosen over the generic forms, as a non-generic overload is in C#;
/// the generic forms compare element by element as SequenceEqual promises:
/// an object's Equals, a value's bits. Each is written against the span's
/// memory through Data, the one place that knows how a span holds it.
public static class MemoryExtensions {
    // .NET's AsSpan over a string is this extension, on `string?`: a null
    // string is an empty span. String.AsSpan answers the same for a string
    // known not to be null; both view the string's units, copying nothing.
    public static ReadOnlySpan<char> AsSpan(this string? text) { return String.AsSpan(text!); }
    public static ReadOnlySpan<char> AsSpan(this string? text, int start) { return String.AsSpan(text!, start); }
    public static ReadOnlySpan<char> AsSpan(this string? text, int start, int length) { return String.AsSpan(text!, start, length); }

    // ---- trimming, comparing and splitting spans, as .NET's MemoryExtensions
    // has them: over any element type that compares itself, allocating nothing.
    // Text held as UTF-8 bytes is trimmed and split here byte by byte, which
    // is right for all of Unicode: no byte of a multi-byte character is ASCII.

    public static ReadOnlySpan<T> Trim<T>(this ReadOnlySpan<T> span, T trimElement) where T : IEquatable<T> {
        return span.TrimStart(trimElement).TrimEnd(trimElement);
    }
    public static ReadOnlySpan<T> TrimStart<T>(this ReadOnlySpan<T> span, T trimElement) where T : IEquatable<T> {
        int start = 0;
        while (start < span.Length && span[start].Equals(trimElement)) { start++; }
        return span.Slice(start);
    }
    public static ReadOnlySpan<T> TrimEnd<T>(this ReadOnlySpan<T> span, T trimElement) where T : IEquatable<T> {
        int end = span.Length;
        while (end > 0 && span[end - 1].Equals(trimElement)) { end--; }
        return span.Slice(0, end);
    }
    public static ReadOnlySpan<T> Trim<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> trimElements) where T : IEquatable<T> {
        return span.TrimStart(trimElements).TrimEnd(trimElements);
    }
    public static ReadOnlySpan<T> TrimStart<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> trimElements) where T : IEquatable<T> {
        int start = 0;
        while (start < span.Length && trimElements.IndexOf(span[start]) >= 0) { start++; }
        return span.Slice(start);
    }
    public static ReadOnlySpan<T> TrimEnd<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> trimElements) where T : IEquatable<T> {
        int end = span.Length;
        while (end > 0 && trimElements.IndexOf(span[end - 1]) >= 0) { end--; }
        return span.Slice(0, end);
    }

    /// The first element equal to any of `values`, or -1.
    public static int IndexOfAny<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> values) where T : IEquatable<T> {
        for (int i = 0; i < span.Length; i++) { if (values.IndexOf(span[i]) >= 0) { return i; } }
        return -1;
    }

    /// The first element equal to none of `values`, or -1.
    public static int IndexOfAnyExcept<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> values) where T : IEquatable<T> {
        for (int i = 0; i < span.Length; i++) { if (values.IndexOf(span[i]) < 0) { return i; } }
        return -1;
    }

    /// How many elements equal `value`.
    public static int Count<T>(this ReadOnlySpan<T> span, T value) where T : IEquatable<T> {
        int n = 0;
        for (int i = 0; i < span.Length; i++) { if (span[i].Equals(value)) { n++; } }
        return n;
    }

    /// The two compared element by element, then by length, as .NET orders them.
    public static int SequenceCompareTo<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> other) where T : IComparable<T> {
        int shorter = span.Length < other.Length ? span.Length : other.Length;
        for (int i = 0; i < shorter; i++) {
            int c = span[i].CompareTo(other[i]);
            if (c != 0) { return c; }
        }
        return span.Length.CompareTo(other.Length);
    }

    /// .NET 9's Split: the ranges between each `separator`, walked with foreach.
    public static SpanSplitEnumerator<T> Split<T>(this ReadOnlySpan<T> source, T separator) where T : IEquatable<T> {
        return new SpanSplitEnumerator<T>(source, separator);
    }

    /// The same, split at every whole occurrence of `separator`.
    public static SpanSplitEnumerator<T> Split<T>(this ReadOnlySpan<T> source, ReadOnlySpan<T> separator) where T : IEquatable<T> {
        return new SpanSplitEnumerator<T>(source, separator, false);
    }

    /// The same, split at any one of `separators`.
    public static SpanSplitEnumerator<T> SplitAny<T>(this ReadOnlySpan<T> source, ReadOnlySpan<T> separators) where T : IEquatable<T> {
        return new SpanSplitEnumerator<T>(source, separators, true);
    }
    const long Ones = 0x01010101, Highs = 0x80808080;

    static long Data(ReadOnlySpan<byte> s) { return s.Length == 0 ? 0 : Sys.ArrayData(s.Items) + s.Start; }
    static long Data(Span<byte> s) { return s.Length == 0 ? 0 : Sys.ArrayData(s.Array) + s.Start; }

    /// Whether `n` bytes at `a` and `b` are the same: a machine word at a time.
    static bool Same(long a, long b, int n) {
        int i = 0;
        for (; i + WordSize.Bytes <= n; i += (int)WordSize.Bytes) {
            if (Sys.Peek(a + i) != Sys.Peek(b + i)) { return false; }
        }
        for (; i < n; i++) {
            if (Sys.PeekByte(a + i) != Sys.PeekByte(b + i)) { return false; }
        }
        return true;
    }

    /// Where byte `b` first is in `n` bytes at `p`, or -1.
    static int Find(long p, int n, int b) {
        long pattern = (b & 0xFF) * Ones;
        int i = 0;
        for (; i + 4 <= n; i += 4) {
            long v = (Sys.PeekWord(p + i) & 0xFFFFFFFF) ^ pattern;
            if ((((v - Ones) & ~v) & Highs) != 0) { break; }
        }
        for (; i < n; i++) {
            if ((Sys.PeekByte(p + i) & 0xFF) == (b & 0xFF)) { return i; }
        }
        return -1;
    }

    /// Where byte `b` last is in `n` bytes at `p`, or -1.
    static int FindLast(long p, int n, int b) {
        long pattern = (b & 0xFF) * Ones;
        int i = n;
        for (; i >= 4; i -= 4) {
            long v = (Sys.PeekWord(p + i - 4) & 0xFFFFFFFF) ^ pattern;
            if ((((v - Ones) & ~v) & Highs) != 0) { break; }
        }
        for (i = i - 1; i >= 0; i--) {
            if ((Sys.PeekByte(p + i) & 0xFF) == (b & 0xFF)) { return i; }
        }
        return -1;
    }

    /// Where either byte first is, or -1.
    static int FindAny(long p, int n, int b0, int b1) {
        long p0 = (b0 & 0xFF) * Ones, p1 = (b1 & 0xFF) * Ones;
        int i = 0;
        for (; i + 4 <= n; i += 4) {
            long w = Sys.PeekWord(p + i) & 0xFFFFFFFF;
            long v0 = w ^ p0, v1 = w ^ p1;
            if (((((v0 - Ones) & ~v0) | ((v1 - Ones) & ~v1)) & Highs) != 0) { break; }
        }
        for (; i < n; i++) {
            int c = (int)Sys.PeekByte(p + i) & 0xFF;
            if (c == (b0 & 0xFF) || c == (b1 & 0xFF)) { return i; }
        }
        return -1;
    }

    static int FindAny(long p, int n, int b0, int b1, int b2) {
        long p0 = (b0 & 0xFF) * Ones, p1 = (b1 & 0xFF) * Ones, p2 = (b2 & 0xFF) * Ones;
        int i = 0;
        for (; i + 4 <= n; i += 4) {
            long w = Sys.PeekWord(p + i) & 0xFFFFFFFF;
            long v0 = w ^ p0, v1 = w ^ p1, v2 = w ^ p2;
            if (((((v0 - Ones) & ~v0) | ((v1 - Ones) & ~v1) | ((v2 - Ones) & ~v2)) & Highs) != 0) { break; }
        }
        for (; i < n; i++) {
            int c = (int)Sys.PeekByte(p + i) & 0xFF;
            if (c == (b0 & 0xFF) || c == (b1 & 0xFF) || c == (b2 & 0xFF)) { return i; }
        }
        return -1;
    }

    /// Where `m` bytes at `q` first appear in `n` bytes at `p`, or -1.
    static int FindRun(long p, int n, long q, int m) {
        if (m == 0) { return 0; }
        int first = (int)Sys.PeekByte(q) & 0xFF;
        int at = 0;
        while (at <= n - m) {
            int k = Find(p + at, n - m - at + 1, first);
            if (k < 0) { return -1; }
            at = at + k;
            if (Same(p + at + 1, q + 1, m - 1)) { return at; }
            at = at + 1;
        }
        return -1;
    }

    /// `n` bytes from `from` to `to`, overlapping or not (memmove): forward
    /// unless the destination starts inside the source.
    static void Move(long to, long from, int n) {
        if (n <= 0 || to == from) { return; }
        if (to < from || to >= from + n) { Sys.MemoryCopy(to, from, n); return; }
        int i = n;
        for (; i >= WordSize.Bytes; i -= (int)WordSize.Bytes) {
            Sys.Poke(to + i - WordSize.Bytes, Sys.Peek(from + i - WordSize.Bytes));
        }
        for (i = i - 1; i >= 0; i--) { Sys.PokeByte(to + i, Sys.PeekByte(from + i)); }
    }

    // ---- bytes -----------------------------------------------------------
    public static bool SequenceEqual(this ReadOnlySpan<byte> span, ReadOnlySpan<byte> other) {
        return span.Length == other.Length && Same(Data(span), Data(other), span.Length);
    }
    public static bool SequenceEqual(this Span<byte> span, ReadOnlySpan<byte> other) {
        return span.Length == other.Length && Same(Data(span), Data(other), span.Length);
    }
    public static bool SequenceEqual(this ReadOnlySpan<byte> span, Span<byte> other) {
        return span.Length == other.Length && Same(Data(span), Data(other), span.Length);
    }
    public static bool SequenceEqual(this Span<byte> span, Span<byte> other) {
        return span.Length == other.Length && Same(Data(span), Data(other), span.Length);
