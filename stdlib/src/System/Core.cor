        result = (long)bits;
        return ok;
    }

    public static bool TryParse(ReadOnlySpan<char> s, out long result) { return TryParse(s, NumberStyles.Integer, null, out result); }
    public static bool TryParse(ReadOnlySpan<char> s, IFormatProvider? provider, out long result) { return TryParse(s, NumberStyles.Integer, provider, out result); }

    public static bool TryParse(ReadOnlySpan<char> s, NumberStyles style, IFormatProvider? provider, out long result) {
        NumberRead.CheckInteger(style);
        bool ok = NumberRead.TryInteger(s.ToString(), style, 64, true, out ulong bits);
        result = (long)bits;
        return ok;
    }
}

static class Int32 {

    // UTF-8 TEXT, as .NET 8's int parses and formats it (IUtf8SpanParsable,
    // IUtf8SpanFormattable): whitespace around the number allowed on the way in.
    public static bool TryParse(ReadOnlySpan<byte> utf8Text, out int result) {
        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
