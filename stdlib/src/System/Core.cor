    /// .NET's CopyTo: the destination at least as long, overlap allowed.
    public static void CopyTo(this ReadOnlySpan<byte> span, Span<byte> destination) {
        if (span.Length > destination.Length) { throw new ArgumentException("Destination is too short.", nameof(destination)); }
        Move(Data(destination), Data(span), span.Length);
    }
    public static bool TryCopyTo(this ReadOnlySpan<byte> span, Span<byte> destination) {
        if (span.Length > destination.Length) { return false; }
        Move(Data(destination), Data(span), span.Length);
        return true;
    }

    // ---- any element type ------------------------------------------------
    static bool Same<T>(T a, T b) {
        return Sys.IsObject(a) ? Sys.KeyEquals(a, b) : Sys.EqualValues(a, b);
    }

    public static bool SequenceEqual<T>(this ReadOnlySpan<T> span, ReadOnlySpan<T> other) {
        if (span.Length != other.Length) { return false; }
        for (int i = 0; i < span.Length; i++) { if (!Same(span[i], other[i])) { return false; } }
        return true;
    }
