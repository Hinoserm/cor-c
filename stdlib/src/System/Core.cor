        Range inner = System.Text.Ascii.Trim(utf8Text);
        ReadOnlySpan<byte> digits = utf8Text[inner];
        if (System.Buffers.Text.Utf8Parser.TryParse(digits, out result, out int used) && used == digits.Length) { return true; }
        result = default;
        return false;
    }

    public static bool TryFormat(this ushort value, Span<byte> utf8Destination, out int bytesWritten) {
        return System.Buffers.Text.Utf8Formatter.TryFormat(value, utf8Destination, out bytesWritten);
    }
    // Equals and GetHashCode as UInt16 overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(ushort value, ushort other) { return value == other; }
    public static bool Equals(ushort value, object? other) { return other is ushort same && Equals(value, same); }
    public static int GetHashCode(ushort value) { return value; }
    public static int CompareTo(ushort value, ushort other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(ushort value, object? other) {
        if (other == null) return 1;
        if (other is ushort number) return CompareTo(value, number);
        throw new ArgumentException("object must be an UInt16");
    }
