    public static int LastIndexOf<T>(this ReadOnlySpan<T> span, T value) {
        for (int i = span.Length - 1; i >= 0; i--) { if (Same(span[i], value)) { return i; } }
        return -1;
    }
    public static int IndexOfAny<T>(this ReadOnlySpan<T> span, T value0, T value1) {
        for (int i = 0; i < span.Length; i++) { if (Same(span[i], value0) || Same(span[i], value1)) { return i; } }
        return -1;
    }
    public static bool Contains<T>(this ReadOnlySpan<T> span, T value) { return IndexOf(span, value) >= 0; }
    public static bool Contains<T>(this Span<T> span, T value) { return IndexOf(span, value) >= 0; }
}

// ---- numbers in a block of bytes -------------------------------------------
//
// .NET's System.Buffers.Binary.BinaryPrimitives, with the twelve members an
// image format needs. LITTLE-ENDIAN, which is this machine's order and is
// stated in the name of every one of them so that a reader of the source knows
// which end is which without being told twice.

static class BinaryPrimitives {
    public static void WriteUInt16LittleEndian(Span<byte> into, ushort value) {
        into[0] = (byte)(value & 255);
        into[1] = (byte)((value >> 8) & 255);
    }

    public static void WriteInt16LittleEndian(Span<byte> into, short value) {
        WriteUInt16LittleEndian(into, (ushort)value);
    }

    public static void WriteUInt32LittleEndian(Span<byte> into, uint value) {
        for (int i = 0; i < 4; i++) { into[i] = (byte)((value >> (i * 8)) & 255); }
    }

    public static void WriteInt32LittleEndian(Span<byte> into, int value) {
        WriteUInt32LittleEndian(into, (uint)value);
    }

    public static void WriteUInt64LittleEndian(Span<byte> into, ulong value) {
        for (int i = 0; i < 8; i++) { into[i] = (byte)((value >> (i * 8)) & (ulong)255); }
    }

    public static void WriteInt64LittleEndian(Span<byte> into, long value) {
        WriteUInt64LittleEndian(into, (ulong)value);
    }

    public static ushort ReadUInt16LittleEndian(ReadOnlySpan<byte> from) {
        return (ushort)(from[0] | (from[1] << 8));
    }

    public static short ReadInt16LittleEndian(ReadOnlySpan<byte> from) {
        return (short)ReadUInt16LittleEndian(from);
    }

    public static uint ReadUInt32LittleEndian(ReadOnlySpan<byte> from) {
        uint value = 0;

        for (int i = 0; i < 4; i++) { value = value | ((uint)from[i] << (i * 8)); }
        return value;
    }

    public static int ReadInt32LittleEndian(ReadOnlySpan<byte> from) {
        return (int)ReadUInt32LittleEndian(from);
    }

    public static ulong ReadUInt64LittleEndian(ReadOnlySpan<byte> from) {
        ulong value = 0;

        for (int i = 0; i < 8; i++) { value = value | ((ulong)from[i] << (i * 8)); }
        return value;
    }

    public static long ReadInt64LittleEndian(ReadOnlySpan<byte> from) {
        return (long)ReadUInt64LittleEndian(from);
    }
}

// ---- blocks of bytes ------------------------------------------------------
//
// Safe standard-library names for the restartable memory engine. Sys exposes
// raw addresses because a kernel needs them; ordinary code should not have to
// manufacture one or risk running past the array it belongs to.

static class Memory {
    private static long At(byte[] bytes, int start, int count) {
        if (start < 0 || count < 0 || start > bytes.Length - count) {
            throw new IndexOutOfRangeException("byte block is outside its array");
        }
        return Sys.ArrayData(bytes) + start;
    }

    public static void Swap(byte[] first, int firstAt, byte[] second, int secondAt, int count) {
        long a = At(first, firstAt, count);
        long b = At(second, secondAt, count);
        if (count > 0) { Sys.SwapBytes(a, b, count); }
    }

    public static void Reverse(byte[] bytes, int start, int count) {
        long low = At(bytes, start, count);
        if (count > 1) { Sys.ReverseBytes(low, low + count - 1, count / 2); }
    }

    public static long FirstSet(byte[] bytes, int start, int count) {
        long at = At(bytes, start, count);
        return count == 0 ? -1 : Sys.FirstSet(at, count * 8);
    }

    public static long PopCount(byte[] bytes, int start, int count) {
        long at = At(bytes, start, count);
        return count == 0 ? 0 : Sys.PopCountBlock(at, count * 8);
    }

    public static long Sum(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 0, 0);
    }

    public static long InternetChecksum(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 1, 0);
    }

    public static long Crc32C(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 2, 0);
    }

    public static long Adler32(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 3, 0);
    }

    public static long Crc32(byte[] bytes, int start, int count) {
        return Sys.Checksum(At(bytes, start, count), count, 4, 0);
    }
}

// ---- enumeration ----------------------------------------------------------
//
// WHAT `foreach` ACTUALLY LOOKS FOR, in C# and here, is a GetEnumerator -- the
// pattern, not the interface. A type with one is walked with it whatever it
// says it implements, which is why List<T>.Enumerator being a plain type costs
// no dispatch.
//
// The interfaces exist because signatures say IEnumerable<T>, and because
// something holding only the interface still has to be able to walk what it
// was handed. The one difference from .NET is that IReadOnlyList<T> does NOT
// extend IEnumerable<T> here: an array satisfies IReadOnlyList<T> through a
// helper object the compiler writes, and that helper has no enumerator to give
// -- see Binder.ArrayView. A `T[]` is looped over directly, so nothing is lost
// but the conversion.

/// `out T`, as .NET declares it: an enumerator only ever hands its element
/// OUT, so an enumerator of a derived type is one of the base.
/// .NET's non-generic IEnumerator (System.Collections): what IEnumerator<T>
/// also is, its Current an object.
interface IEnumerator {
    object? Current { get; }
    bool MoveNext();
    void Reset();
}

/// .NET's non-generic IEnumerable (System.Collections): what IEnumerable<T>
/// also is.
interface IEnumerable {
    IEnumerator GetEnumerator();
}

/// .NET's IEnumerator<T>, which is an IDisposable and an IEnumerator: a
/// foreach disposes the enumerator it walked, however the loop ended.
interface IEnumerator<out T> : IDisposable, IEnumerator {
    T Current { get; }
}

/// `out T`. Everything read from a sequence is a T, so a sequence of
/// FieldDecl IS a sequence of MemberDecl -- which is what lets
/// `decl.Members.AddRange(several.More)` be written at all.
interface IEnumerable<out T> : IEnumerable {
    IEnumerator<T> GetEnumerator();
}

class SelectManySequence<T, R> : IEnumerable<R> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private IEnumerable<T> source;
    private Func<T, IEnumerable<R>> selector;
    public SelectManySequence(IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        this.source = source;
        this.selector = selector;
    }
    public IEnumerator<R> GetEnumerator() => new SelectManyEnumerator<T, R>(source, selector);
}

class SelectManyEnumerator<T, R> : IEnumerator<R>, IDisposable {
    // The non-generic IEnumerator's members, as .NET's enumerators have them.
    object? IEnumerator.Current => Current;
    public void Reset() { throw new NotSupportedException("Specified method is not supported."); }

    private IEnumerable<T> source;
    private Func<T, IEnumerable<R>> selector;
    private IEnumerator<T>? outer;
    private IEnumerator<R>? inner;
    private bool ended;
    private R current;
    public SelectManyEnumerator(IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        this.source = source;
        this.selector = selector;
    }
    public R Current => current;
    public bool MoveNext() {
        if (ended) return false;
        try {
            if (outer == null) outer = source.GetEnumerator();
            while (true) {
                if (inner != null) {
                    if (inner.MoveNext()) { current = inner.Current; return true; }
                    if (inner is IDisposable disposable) disposable.Dispose();
                    inner = null;
                }
                if (!outer.MoveNext()) { Dispose(); return false; }
                inner = selector(outer.Current).GetEnumerator();
            }
        } catch { Dispose(); throw; }
    }
    public void Dispose() {
        ended = true;
        try {
            if (inner is IDisposable disposable) disposable.Dispose();
        } finally {
            inner = null;
            try {
                if (outer is IDisposable disposable) disposable.Dispose();
            } finally { outer = null; }
        }
    }
}

// ---- List -----------------------------------------------------------------
// A growable array. Doubling on growth keeps appending amortised constant
// rather than quadratic, which matters because scripts build lists in loops.

// .NET spells this List<T>.Enumerator. A type written inside another is hoisted
// out to the top level here, and a hoisted one cannot inherit the outer's type
// parameters -- so it takes its own and carries the outer's name instead.
class ListEnumerator<T> : IEnumerator<T> {
    // The non-generic IEnumerator's members, as .NET's enumerators have them.
    object? IEnumerator.Current => Current;
    public void Reset() { at = -1; }

    // IEnumerator<T> is an IDisposable; walking holds nothing to let go of.
    public void Dispose() { }

    private IReadOnlyList<T> over;
    private int at;

    public ListEnumerator(IReadOnlyList<T> list) {
        over = list;
        at = -1;
    }

    public T Current => over[at];

    public bool MoveNext() {
        at = at + 1;
        return at < over.Count;
    }
}

/// What a collection expression with a spread becomes. `[a, ..rest, b]` is
/// written by the compiler as a chain of these over the collection being
/// built -- a List (Gather, Add, AddRange) for an array or an interface
/// target, the target itself (Element, Spread) for a class with an Add -- one
/// link per element, in the order written, as C# evaluates them.
static class CollectionExpressionBuilder {
    public static List<T> Gather<T>() {
        return new List<T>();
    }

    public static List<T> Add<T>(List<T> into, T item) {
        into.Add(item);
        return into;
    }

    public static List<T> AddRange<T>(List<T> into, IEnumerable<T> items) {
        foreach (T item in items) {
            into.Add(item);
        }
        return into;
    }

    public static C Element<C, T>(C into, T item) {
        into.Add(item);
        return into;
    }

    public static C Spread<C, T>(C into, IEnumerable<T> items) {
        foreach (T item in items) {
            into.Add(item);
        }
        return into;
    }
}

// STORAGE A COLLECTION HAS OUTGROWN, given back by the collection itself.
// Its arrays are its own: nothing outside it holds one (List's Backing,
// which hands one out, is the exception and says so), so the array a Grow
// replaces is garbage the moment the new one is in place. Left to the
// collector, every growing table's old arrays were a quarter of everything
// the compiler allocated.
// GENERIC so that each collection's copy is made in the unit that uses it,
// as the collection's own code is: a call into the library's unit was an
// unknown call there, the freed array an escape, and the field dirty.
// THE ELEMENTS OF A COLLECTION THE COMPILER PROVED OWNS THEM: freed one by
// one when it dies (Opt.OwnedElements). A value type has nothing to free.
static class OwnedElements {
    internal static void Release<E>(E element) {
        // A collection given back takes its storage with it (Runtime.Free).
        if (Sys.IsObject(element) && Sys.Word(element) != 0) { Runtime.Free((nint)Sys.Word(element)); }
    }

    // EACH ELEMENT GIVEN BACK ONCE, however often the list holds it: an
    // element read from a list and put back into it (Opt.OwnedElements, put
    // back) may be there twice. The array dies with the list, so it is
    // sorted by address where it is -- a heap sort, nothing allocated while
    // memory is being given back; the collector moves nothing -- and each
    // run of one object released once.
    internal static void ReleaseDistinct<E>(E[] items, int count) {
        for (int start = count / 2 - 1; start >= 0; start--) { SiftDown(items, start, count); }
        for (int end = count - 1; end > 0; end--) {
            E top = items[0];
            items[0] = items[end];
            items[end] = top;
            SiftDown(items, 0, end);
        }
        long last = 0;
        for (int i = 0; i < count; i++) {
            E element = items[i];
            items[i] = default(E)!;
            long word = Sys.Word(element);
            if (word == last) { continue; }
            last = word;
            Release(element);
        }
    }

    private static void SiftDown<E>(E[] items, int root, int end) {
        while (true) {
            int child = 2 * root + 1;
            if (child >= end) { return; }
            if (child + 1 < end && (ulong)Sys.Word(items[child + 1]) > (ulong)Sys.Word(items[child])) { child++; }
            if ((ulong)Sys.Word(items[child]) <= (ulong)Sys.Word(items[root])) { return; }
            E swap = items[root];
            items[root] = items[child];
            items[child] = swap;
            root = child;
        }
    }
}

static class OutgrownStorage {
    internal static void Release<E>(E[]? old) {
        if (old != null) { Runtime.Free((nint)Sys.Word(old)); }
    }
}

class List<T> : IList<T>, IReadOnlyList<T>, IEnumerable<T>, IOwnsElements {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }


    bool ICollection<T>.IsReadOnly => false;

    // An empty list owns no array. All element accesses are guarded by count;
    // only growth and an explicit request for Backing materialize storage.
    private T[] items = null!;
    private int count;
    // WHETHER THE ARRAY HAS BEEN HANDED OUT (Backing, for CollectionsMarshal
    // and LINQ's span paths): one that has may be read after the list grows,
    // as .NET promises, so it is left to the collector rather than freed.
    private bool lent;
    // WHETHER ITS ELEMENTS GO WITH ITS STORAGE (OwnElements), set by the
    // compiler's call alone.
    private bool ownsElements;
    // WHAT CHANGED IT LAST, counted: every change moves it on, and an
    // enumerator that finds it moved throws, as .NET's does.
    internal int version;

    public List() {
        count = 0;
    }

    public int Count => count;

    public void Add(T value) {
        version = version + 1;
        if (items == null || count == items.Length) { Grow(); }
        items[count] = value;
        count = count + 1;
    }

    // AN INDEXER, because that is what a List has in C#. Get and Set were our
    // own spelling of it, and every one of those is a place the compiler's own
    // source would have to be rewritten to compile here.
    // THE THROW IS A CALL (ThrowHelper), as .NET's is: a member that throws
    // is never inlined, and every list[i] in a program was a call.
    public T this[int index] {
        get {
            if ((uint)index >= (uint)count) { ThrowHelper.IndexOutOfRange(); }
            return items[index];
        }
        set {
            if ((uint)index >= (uint)count) { ThrowHelper.IndexOutOfRange(); }
            items[index] = value;
            version = version + 1;
        }
    }

    // ORDER IS PRESERVED, which is also .NET's contract. It used to move the
    // last element into the hole -- constant time and a different function: a
    // caller that had sorted the list, or that was walking it, got a silent
    // reordering. Shifting is what List<T>.RemoveAt does and what anybody
    // reading the name expects.
    public void RemoveAt(int index) {
        if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection."); }
        version = version + 1;
        for (int i = index; i < count - 1; i++) { items[i] = items[i + 1]; }
        count = count - 1;
        items[count] = default(T)!;
    }

    public void Insert(int index, T value) {
        if (index < 0 || index > count) { throw new ArgumentOutOfRangeException("index", "Index must be within the bounds of the List."); }
        version = version + 1;
        if (items == null || count == items.Length) { Grow(); }
        for (int i = count; i > index; i--) { items[i] = items[i - 1]; }
        items[index] = value;
        count = count + 1;
    }

    public void InsertRange(int index, IEnumerable<T> more) {
        if (more == null) { throw new ArgumentNullException("collection"); }
        if ((uint)index > (uint)count) { throw new ArgumentOutOfRangeException("index", "Index must be within the bounds of the List."); }
        // A COLLECTION GOES IN AT ONCE, as .NET's does: the tail moved once
        // and the elements copied in, not each inserted with the tail moved
        // for every one.
        T[] adding = (object)more == (object)this ? ToArray() : (more is ICollection<T> ? null! : new List<T>(more).ToArray());
        if (adding == null) {
            ICollection<T> collection = (ICollection<T>)more;
            adding = new T[collection.Count];
            collection.CopyTo(adding, 0);
        }
        int n = adding.Length;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        if (index < count) { Array.Copy(items, index, items, index + n, count - index); }
        Array.Copy(adding, 0, items, index, n);
        count = count + n;
    }

    public int IndexOf(T value) {
        for (int i = 0; i < count; i++) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.EqualValues(items[i], value))) { return i; }
        }
        return -1;
    }

    public bool Contains(T value) { return IndexOf(value) >= 0; }

    /// .NET's List<T>.Enumerator: a struct, so that walking a list with
    /// foreach allocates nothing, moved on in place (foreach keeps one copy).
    /// As .NET's: Current is the element taken by the last MoveNext, and a
    /// list changed since the walk began is an InvalidOperationException.
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly List<T> list;
        private int index;
        private readonly int version;
        private T current;
        internal Enumerator(List<T> list) { this.list = list; index = 0; version = list.version; current = default(T)!; }
        public T Current => current;
        public bool MoveNext() {
            if (version == list.version && index < list.count) {
                current = list.items[index];
                index = index + 1;
                return true;
            }
            if (version != list.version) {
                ThrowHelper.CollectionModified();
            }
            index = list.count + 1;
            current = default(T)!;
            return false;
        }
        public void Dispose() { }
        object? IEnumerator.Current => current;
        public void Reset() {
            if (version != list.version) {
                throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");
            }
            index = 0;
            current = default(T)!;
        }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }

    // Through the interface, as .NET's explicit implementation: an object,
    // since an interface's enumerator is one.
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { return GetEnumerator(); }

    // .NET's CopyTo, which writes the elements into something the caller owns
    // rather than allocating.
    public void CopyTo(Span<T> into) {
        for (int i = 0; i < count; i++) { into[i] = items[i]; }
    }

    public void CopyTo(T[] into) {
        for (int i = 0; i < count; i++) { into[i] = items[i]; }
    }

    // .NET's third overload: where in the destination to start writing.
    public void CopyTo(T[] into, int at) {
        for (int i = 0; i < count; i++) { into[at + i] = items[i]; }
    }

    // A COPY, not a view: .NET's ToArray hands back an array of its own, so
    // writing to it does not write to the list.
    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = items[i]; }
        return made;
    }

    // .NET takes a Predicate<T> here and a Func<T,bool> in LINQ's
    // FirstOrDefault; they are the same shape and this machine has no delegate
    // types yet, so both are the one interface. Answers default(T) when nothing
    // matches, which is .NET's contract.
    public T? Find(Predicate<T> match) {
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public int FindIndex(Predicate<T> match) {
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    /// THE LIST'S OWN STORAGE, which CollectionsMarshal.AsSpan hands out.
    /// Not .NET's spelling -- .NET reaches the field through the runtime --
    /// but the same promise: writing through it writes the list, and a list
    /// that grows afterwards leaves the old array behind.
    internal T[] Backing() {
        if (items == null) { items = new T[0]; }
        lent = true;
        return items;
    }

    // ROOM ONCE, THEN THE ELEMENTS, as .NET's AddRange does: the list grows
    // to what it needs (or double, if that is more) and the range is copied
    // in. Added one at a time, a list filled from a span -- every section a
    // link reads -- grew by doubling and ended with up to twice its bytes.
    public void AddRange(IEnumerable<T> more) {
        if (more == null) { throw new ArgumentNullException("collection"); }
        // ITSELF IS COPIED FIRST, as .NET copies a collection: walking the
        // list while adding to it is a change under the walk.
        if ((object)more == (object)this) { AddRange(ToArray()); return; }
        if (more is ICollection<T> collection) {
            int n = collection.Count;
            if (n == 0) { return; }
            version = version + 1;
            EnsureCapacity(count + n);
            collection.CopyTo(items, count);
            count = count + n;
            return;
        }
        foreach (T one in more) { Add(one); }
    }

    public void AddRange(IReadOnlyList<T> more) {
        int n = more.Count;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        for (int i = 0; i < n; i++) { items[count + i] = more[i]; }
        count = count + n;
    }

    public void AddRange(List<T> more) {
        int n = more.Count;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        // Read after the room is made: `list.AddRange(list)` reads the array
        // the elements were just moved to.
        Array.Copy(more.items, 0, items, count, n);
        count = count + n;
    }

    public void AddRange(T[] more) {
        int n = more.Length;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        Array.Copy(more, 0, items, count, n);
        count = count + n;
    }

    /// .NET 8's span overloads. Span<T> is written out beside ReadOnlySpan<T>
    /// because the implicit conversion between them that .NET relies on is a
    /// user-defined conversion operator, which this compiler does not have.
    public void AddRange(ReadOnlySpan<T> more) {
        int n = more.Length;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        for (int i = 0; i < n; i++) { items[count + i] = more[i]; }
        count = count + n;
    }

    public void AddRange(Span<T> more) {
        int n = more.Length;
        if (n == 0) { return; }
        version = version + 1;
        EnsureCapacity(count + n);
        for (int i = 0; i < n; i++) { items[count + i] = more[i]; }
        count = count + n;
    }

    public void InsertRange(int index, List<T> more) {
        InsertRange(index, (IEnumerable<T>)more);
    }

    // True when it was there, which is .NET's contract for Remove.
    public bool Remove(T value) {
        int at = IndexOf(value);
        if (at < 0) { return false; }
        RemoveAt(at);
        return true;
    }

    public void Clear() {
        version = version + 1;
        for (int i = 0; i < count; i++) { items[i] = default(T)!; }
        count = 0;
    }

    public void Reverse() {
        version = version + 1;
        int left = 0;
        int right = count - 1;
        while (left < right) {
            T held = items[left];
            items[left] = items[right];
            items[right] = held;
            left = left + 1;
            right = right - 1;
        }
    }

    public void RemoveRange(int index, int countToRemove) {
        if (index < 0) { throw new ArgumentOutOfRangeException("index"); }
        if (countToRemove < 0) { throw new ArgumentOutOfRangeException("count"); }
        if (index > count || countToRemove > count - index) { throw new ArgumentException("Invalid range."); }
        for (int i = index; i < count - countToRemove; i++) {
            items[i] = items[i + countToRemove];
        }
        for (int i = count - countToRemove; i < count; i++) { items[i] = default(T)!; }
        count = count - countToRemove;
        if (countToRemove > 0) { version = version + 1; }
    }

    // ---- the rest of what List<T> answers to in C# ---------------------

    /// .NET's constructor that says how much to expect, so a list built in a
    /// loop of known length grows no times at all.
    public List(int capacity) {
        if (capacity < 0) { throw new ArgumentOutOfRangeException("capacity"); }
        if (capacity > 0) { items = new T[capacity]; }
        count = 0;
    }

    /// A collection is copied whole into an array its own size, as .NET
    /// copies one (ICollection.CopyTo); anything else is walked and added.
    public List(IEnumerable<T> source) : this() {
        if (source is ICollection<T> collection) {
            int n = collection.Count;
            if (n > 0) {
                items = new T[n];
                collection.CopyTo(items, 0);
                count = n;
            }
            return;
        }
        foreach (T one in source) { Add(one); }
    }

    public List(IReadOnlyList<T> source) : this(source.Count) {
        for (int i = 0; i < source.Count; i++) { Add(source[i]); }
    }


    /// HOW MANY IT CAN HOLD before it grows again, which is not how many it
    /// holds. Setting it is .NET's way of reserving.
    public int Capacity {
        get { return items == null ? 0 : items.Length; }
        set {
            if (value < count) { throw new ArgumentOutOfRangeException("value"); }
            if (value == Capacity) { return; }
            T[] old = items;
            if (value == 0) { items = null!; Outgrown(old); return; }

            T[] bigger = new T[value];
            for (int i = 0; i < count; i++) { bigger[i] = old[i]; }
            items = bigger;
            Outgrown(old);
        }
    }

    public int LastIndexOf(T value) {
        for (int i = count - 1; i >= 0; i--) {
            if ((Sys.IsObject(items[i]) ? Sys.KeyEquals(items[i], value) : Sys.EqualValues(items[i], value))) { return i; }
        }
        return -1;
    }

    public bool Exists(Predicate<T> match) { return FindIndex(match) >= 0; }

    public bool TrueForAll(Predicate<T> match) {
        for (int i = 0; i < count; i++) {
            if (!match(items[i])) { return false; }
        }
        return true;
    }

    public List<T> FindAll(Predicate<T> match) {
        List<T> found = new List<T>();
        for (int i = 0; i < count; i++) {
            if (match(items[i])) { found.Add(items[i]); }
        }
        return found;
    }

    public T? FindLast(Predicate<T> match) {
        for (int i = count - 1; i >= 0; i--) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public int FindLastIndex(Predicate<T> match) {
        for (int i = count - 1; i >= 0; i--) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    /// HOW MANY WERE REMOVED, which is .NET's answer and the useful one.
    ///
    /// ONE PASS, compacting in place: removing one at a time from the front
    /// would shift the tail once per removal and make clearing a list of n
    /// quadratic.
    public int RemoveAll(Predicate<T> match) {
        int into = 0;

        for (int i = 0; i < count; i++) {
            if (match(items[i])) { continue; }
            items[into] = items[i];
            into = into + 1;
        }

        int removed = count - into;
        for (int i = into; i < count; i++) { items[i] = default(T)!; }
        count = into;
        if (removed > 0) { version = version + 1; }
        return removed;
    }

    /// A read-only view of this list, which sees later changes to it.
    public System.Collections.ObjectModel.ReadOnlyCollection<T> AsReadOnly() {
        return new System.Collections.ObjectModel.ReadOnlyCollection<T>(this);
    }

    public List<T> GetRange(int index, int howMany) {
        List<T> made = new List<T>(howMany);
        for (int i = 0; i < howMany; i++) { made.Add(items[index + i]); }
        return made;
    }

    /// THE ELEMENTS IN ORDER. With no argument the order is Comparer<T>'s --
    /// text by its characters, numbers by their value, and anything else by
    /// its address, which is the limitation described there.
    public void Sort() { SortRange(0, count, Comparer<T>.Default); }

    public void Sort(IComparer<T> by) { SortRange(0, count, by); }

    public void Sort(Comparison<T> by) { SortRange(0, count, new ComparisonComparer<T>(by)); }

    public void Sort(int index, int howMany, IComparer<T> by) { SortRange(index, howMany, by); }

    /// .NET'S INTROSPECTIVE SORT, WRITTEN HERE rather than called in Sorting,
    /// and not by preference: List<T> is compiled ONCE over the machine word,
    /// so its T is the canonical one, and handing that to a generic method
    /// that is compiled per type argument is a conversion the checker refuses
    /// -- "cannot convert 'IComparer$__canon' to 'IComparer<object>'". Array's
    /// sort, whose methods are themselves per-argument, calls
    /// Sorting.Introspective, and this is the same algorithm step for step:
    /// not stable, as .NET's is not, so equal elements come out where .NET
    /// puts them.
    private void SortRange(int from, int howMany, IComparer<T> by) {
        version = version + 1;
        if (howMany > 1) {
            int log = 0;
            for (int n = howMany; n > 1; n = n >> 1) { log = log + 1; }
            IntroSortRange(from, howMany, 2 * (log + 1), by);
        }
    }

    private void IntroSortRange(int lo, int size, int depthLimit, IComparer<T> by) {
        int partitionSize = size;
        while (partitionSize > 1) {
            if (partitionSize <= 16) {
                if (partitionSize == 2) {
                    SwapIfGreater(lo, lo + 1, by);
                    return;
                }
                if (partitionSize == 3) {
                    SwapIfGreater(lo, lo + 1, by);
                    SwapIfGreater(lo, lo + 2, by);
                    SwapIfGreater(lo + 1, lo + 2, by);
                    return;
                }
                InsertionSortRange(lo, partitionSize, by);
                return;
            }
            if (depthLimit == 0) {
                HeapSortRange(lo, partitionSize, by);
                return;
            }
            depthLimit = depthLimit - 1;
            int p = PivotAndPartition(lo, partitionSize, by);
            IntroSortRange(lo + p + 1, partitionSize - (p + 1), depthLimit, by);
            partitionSize = p;
        }
    }

    private void SwapIfGreater(int i, int j, IComparer<T> by) {
        if (by.Compare(items[i], items[j]) > 0) {
            T key = items[i];
            items[i] = items[j];
            items[j] = key;
        }
    }

    private void SwapAt(int i, int j) {
        T t = items[i];
        items[i] = items[j];
        items[j] = t;
    }

    private int PivotAndPartition(int lo, int size, IComparer<T> by) {
        int hi = size - 1;
        int middle = hi >> 1;
        SwapIfGreater(lo, lo + middle, by);
        SwapIfGreater(lo, lo + hi, by);
        SwapIfGreater(lo + middle, lo + hi, by);
        T pivot = items[lo + middle];
        SwapAt(lo + middle, lo + hi - 1);
        int left = 0;
        int right = hi - 1;
        while (left < right) {
            left = left + 1;
            while (by.Compare(items[lo + left], pivot) < 0) { left = left + 1; }
            right = right - 1;
            while (by.Compare(pivot, items[lo + right]) < 0) { right = right - 1; }
            if (left >= right) { break; }
            SwapAt(lo + left, lo + right);
        }
        if (left != hi - 1) {
            SwapAt(lo + left, lo + hi - 1);
        }
        return left;
    }

    private void HeapSortRange(int lo, int n, IComparer<T> by) {
        for (int i = n >> 1; i >= 1; i--) {
            DownHeapRange(lo, i, n, by);
        }
        for (int i = n; i > 1; i--) {
            SwapAt(lo, lo + i - 1);
            DownHeapRange(lo, 1, i - 1, by);
        }
    }

    private void DownHeapRange(int lo, int i, int n, IComparer<T> by) {
        T d = items[lo + i - 1];
        while (i <= n >> 1) {
            int child = 2 * i;
            if (child < n && by.Compare(items[lo + child - 1], items[lo + child]) < 0) {
                child = child + 1;
            }
            if (!(by.Compare(d, items[lo + child - 1]) < 0)) { break; }
            items[lo + i - 1] = items[lo + child - 1];
            i = child;
        }
        items[lo + i - 1] = d;
    }

    private void InsertionSortRange(int lo, int size, IComparer<T> by) {
        for (int i = 0; i < size - 1; i++) {
            T t = items[lo + i + 1];
            int j = i;
            while (j >= 0 && by.Compare(t, items[lo + j]) < 0) {
                items[lo + j + 1] = items[lo + j];
                j = j - 1;
            }
            items[lo + j + 1] = t;
        }
    }

    /// WHERE IT IS, OR WHERE IT WOULD GO. .NET answers the complement of the
    /// insertion point when the value is absent -- a negative number that is
    /// never -0, which is why it is ~i and not -i.
    public int BinarySearch(T value, IComparer<T> by) {
        int low = 0;
        int high = count - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = by.Compare(items[middle], value);

            if (sign == 0) { return middle; }
            if (sign < 0) {
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        return ~low;
    }

    public int BinarySearch(T value) { return BinarySearch(value, Comparer<T>.Default); }

    private void Grow() {
        int size = items == null || items.Length == 0 ? 4 : items.Length * 2;
        T[] bigger = new T[size];
        T[] old = items;
        for (int i = 0; i < count; i++) { bigger[i] = old[i]; }
        items = bigger;
        Outgrown(old);
    }

    private void Outgrown(T[]? old) {
        if (!lent) { OutgrownStorage.Release(old); }
        lent = false;
    }

    // THE ELEMENTS GIVEN BACK, by the compiler's call alone (OwnedElements):
    // it proved every element this list holds was made for it, is held by
    // nothing else, and is dead. Each is freed and its place cleared.
    public void FreeOwnedElements() {
        if (items == null) { return; }
        for (int i = 0; i < count; i++) {
            OwnedElements.Release(items[i]);
            items[i] = default(T)!;
        }
        count = 0;
    }

    // ITS ELEMENTS GIVEN BACK WITH ITS STORAGE, by the compiler's call alone
    // (OwnedElements, through a field): it proved every element is made for
    // this list and dead whenever the list is freed, however that comes.
    public void OwnElements() { ownsElements = true; }

    public void FreeStorage() {
        // Marked through a field, its elements may have been put back into
        // it: each given back once.
        if (ownsElements) {
            ownsElements = false;
            if (items != null) { OwnedElements.ReleaseDistinct(items, count); }
            count = 0;
        }
        if (!lent) { OutgrownStorage.Release(items); }
        items = null!;
        count = 0;
    }
    // ---- the rest of .NET's List<T> ---------------------------------------

    private static bool Matches(T a, T b) {
        return Sys.IsObject(a) ? Sys.KeyEquals(a, b) : Sys.EqualValues(a, b);
    }

    private void CheckRange(int index, int howMany) {
        if (index < 0) { throw new ArgumentOutOfRangeException("index", "Non-negative number required."); }
        if (howMany < 0) { throw new ArgumentOutOfRangeException("count", "Non-negative number required."); }
        if (count - index < howMany) { throw new ArgumentException("Offset and length were out of bounds for the array or count is greater than the number of elements from index to the end of the source collection."); }
    }

    public List<TOutput> ConvertAll<TOutput>(Converter<T, TOutput> converter) {
        if (converter == null) { throw new ArgumentNullException("converter"); }
        List<TOutput> made = new List<TOutput>(count);
        for (int i = 0; i < count; i++) { made.Add(converter(items[i])); }
        return made;
    }

    /// At least that much room, growing as Add grows (double, or four from
    /// nothing, or the amount asked if that is more). The capacity after.
    public int EnsureCapacity(int capacity) {
        if (capacity < 0) { throw new ArgumentOutOfRangeException("capacity", "Non-negative number required."); }
        if (Capacity < capacity) {
            int grown = Capacity == 0 ? 4 : Capacity * 2;
            if (grown > 0x7FFFFFC7) { grown = 0x7FFFFFC7; }
            if (grown < capacity) { grown = capacity; }
            Capacity = grown;
        }
        return Capacity;
    }

    public void ForEach(Action<T> action) {
        if (action == null) { throw new ArgumentNullException("action"); }
        int was = version;
        for (int i = 0; i < count; i++) {
            if (was != version) { break; }
            action(items[i]);
        }
        if (was != version) { throw new InvalidOperationException("Collection was modified; enumeration operation may not execute."); }
    }

    public List<T> Slice(int start, int length) { return GetRange(start, length); }

    /// Down to the count when less than nine tenths of the room is in use.
    public void TrimExcess() {
        int threshold = (int)(Capacity * 0.9);
        if (count < threshold) { Capacity = count; }
    }

    public int FindIndex(int startIndex, Predicate<T> match) { return FindIndex(startIndex, count - startIndex, match); }

    public int FindIndex(int startIndex, int howMany, Predicate<T> match) {
        if ((uint)startIndex > (uint)count) { throw new ArgumentOutOfRangeException("startIndex", "Index was out of range. Must be non-negative and less than or equal to the size of the collection."); }
        if (howMany < 0 || startIndex > count - howMany) { throw new ArgumentOutOfRangeException("count", "Count must be positive and count must refer to a location within the string/array/collection."); }
        if (match == null) { throw new ArgumentNullException("match"); }
        for (int i = startIndex; i < startIndex + howMany; i++) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public int FindLastIndex(int startIndex, Predicate<T> match) { return FindLastIndex(startIndex, startIndex + 1, match); }

    public int FindLastIndex(int startIndex, int howMany, Predicate<T> match) {
        if (match == null) { throw new ArgumentNullException("match"); }
        if (count == 0) {
            if (startIndex != -1) { throw new ArgumentOutOfRangeException("startIndex", "Index was out of range. Must be non-negative and less than the size of the collection."); }
        } else if ((uint)startIndex >= (uint)count) {
            throw new ArgumentOutOfRangeException("startIndex", "Index was out of range. Must be non-negative and less than the size of the collection.");
        }
        if (howMany < 0 || startIndex - howMany + 1 < 0) { throw new ArgumentOutOfRangeException("count", "Count must be positive and count must refer to a location within the string/array/collection."); }
        for (int i = startIndex; i > startIndex - howMany; i--) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public int IndexOf(T value, int index) { return IndexOf(value, index, count - index); }

    public int IndexOf(T value, int index, int howMany) {
        if ((uint)index > (uint)count) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than or equal to the size of the collection."); }
        if (howMany < 0 || index > count - howMany) { throw new ArgumentOutOfRangeException("count", "Count must be positive and count must refer to a location within the string/array/collection."); }
        for (int i = index; i < index + howMany; i++) {
            if (Matches(items[i], value)) { return i; }
        }
        return -1;
    }

    public int LastIndexOf(T value, int index) { return LastIndexOf(value, index, index + 1); }

    public int LastIndexOf(T value, int index, int howMany) {
        if (count == 0) { return -1; }
        if (index < 0 || index >= count) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection."); }
        if (howMany < 0 || index - howMany + 1 < 0) { throw new ArgumentOutOfRangeException("count", "Count must be positive and count must refer to a location within the string/array/collection."); }
        for (int i = index; i > index - howMany; i--) {
            if (Matches(items[i], value)) { return i; }
        }
        return -1;
    }

    public void Reverse(int index, int howMany) {
        CheckRange(index, howMany);
        int left = index;
        int right = index + howMany - 1;
        while (left < right) {
            T held = items[left];
            items[left] = items[right];
            items[right] = held;
            left = left + 1;
            right = right - 1;
        }
        version = version + 1;
    }

    public int BinarySearch(int index, int howMany, T item, IComparer<T>? comparer) {
        CheckRange(index, howMany);
        IComparer<T> by = comparer ?? Comparer<T>.Default;
        int lo = index;
        int hi = index + howMany - 1;
        while (lo <= hi) {
            int mid = lo + ((hi - lo) >> 1);
            int order = by.Compare(items[mid], item);
            if (order == 0) { return mid; }
            if (order < 0) { lo = mid + 1; } else { hi = mid - 1; }
        }
        return ~lo;
    }
}

// A FIRST-IN, FIRST-OUT QUEUE, on a growable ring.
//
// A List with RemoveAt(0) would be a queue too, and a quadratic one: every
// Dequeue would shuffle everything left. A ring moves the HEAD instead, so both
// ends are constant time and the storage is reused as it goes round.
//
// The compiler's own Monomorphiser.cs keeps its worklist in one of these --
// specialising a generic discovers more generics to specialise, which is
// exactly the shape a queue is for.

/// .NET spells this Queue<T>.Enumerator. HEAD FIRST, which is the order the
/// queue hands things out in and not the order the ring stores them in.
class QueueEnumerator<T> : IEnumerator<T> {
    // The non-generic IEnumerator's members, as .NET's enumerators have them.
    object? IEnumerator.Current => Current;
    public void Reset() { at = -1; }

    // IEnumerator<T> is an IDisposable; walking holds nothing to let go of.
    public void Dispose() { }

    private Queue<T> over;
    private int at;

    public QueueEnumerator(Queue<T> queue) {
        over = queue;
        at = -1;
    }

    public T Current => over[at];

    public bool MoveNext() {
        at = at + 1;
        return at < over.Count;
    }
}

class Queue<T> : IReadOnlyCollection<T>, IEnumerable<T> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private T[] items;
    private int head;
    private int count;

    public Queue() {
        items = new T[8];
        head = 0;
        count = 0;
    }

    public Queue(IEnumerable<T> collection) : this() {
        foreach (T item in collection) { Enqueue(item); }
    }

    public int Count => count;

    public void Enqueue(T value) {
        if (count == items.Length) { Grow(); }

        // WRAPPING IS THE POINT: the free space may be in front of the head as
        // well as behind the tail, and a queue that only wrote forwards would
        // grow every time it went round.
        int at = head + count;

        if (at >= items.Length) { at = at - items.Length; }

        items[at] = value;
        count = count + 1;
    }

    public T Dequeue() {
        if (count == 0) { throw new InvalidOperationException("the queue is empty"); }

        T taken = items[head];
        items[head] = default(T)!;

        head = head + 1;

        if (head == items.Length) { head = 0; }

        count = count - 1;
        return taken;
    }

    public T Peek() {
        if (count == 0) { throw new InvalidOperationException("the queue is empty"); }
        return items[head];
    }

    public void Clear() {
        for (int i = 0; i < count; i++) { items[(head + i) % items.Length] = default(T)!; }
        head = 0;
        count = 0;
    }

    /// THE NON-THROWING PAIR, which is what a worker loop draining a queue
    /// writes: false at the end rather than an exception to catch.
    public bool TryDequeue(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = Dequeue();
        return true;
    }

    public bool TryPeek(out T value) {
        if (count == 0) { value = default(T); return false; }
        value = items[head];
        return true;
    }

    public bool Contains(T value) {
        IEqualityComparer<T> same = EqualityComparer<T>.Default;

        for (int i = 0; i < count; i++) {
            if (same.Equals(this[i], value)) { return true; }
        }
        return false;
    }

    /// IN QUEUE ORDER, head first, which is not the order the ring holds them
    /// in -- and is the order every caller means.
    public T[] ToArray() {
        T[] made = new T[count];

        for (int i = 0; i < count; i++) { made[i] = this[i]; }
        return made;
    }

    public void CopyTo(T[] target, int at) {
        for (int i = 0; i < count; i++) { target[at + i] = this[i]; }
    }

    /// .NET's own: a struct, so a foreach over one allocates nothing and does
    /// not hand the collection to an object on the heap (which the lifetime
    /// rules take for its escape).
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly Queue<T> over;
        private int at;
        internal Enumerator(Queue<T> walked) { over = walked; at = -1; }
        public T Current => over[at];
        object? IEnumerator.Current => Current;
        public bool MoveNext() { at = at + 1; return at < over.Count; }
        public void Reset() { at = -1; }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { return new QueueEnumerator<T>(this); }

    /// Not a .NET member: the i-th element in queue order, which the
    /// enumerator and the copies above need and the ring makes non-obvious.
    public T this[int index] {
        get {
            int at = head + index;

            if (at >= items.Length) { at = at - items.Length; }
            return items[at];
        }
    }

    // STRAIGHTENED OUT WHILE COPYING, so the new store starts at zero and the
    // wrap arithmetic above stays simple. Copying in queue order rather than
    // storage order is what makes that true.
    private void Grow() {
        T[] bigger = new T[items.Length * 2];

        for (int i = 0; i < count; i++) {
            int at = head + i;

            if (at >= items.Length) { at = at - items.Length; }

            bigger[i] = items[at];
        }

        T[] old = items;
        items = bigger;
        head = 0;
        OutgrownStorage.Release(old);
    }
}

// ---- Dictionary -----------------------------------------------------------
// Open addressing with linear probing. Chaining would need an allocation per
// entry, and an arena that is freed wholesale at the end of a handler is
// exactly the wrong place to be allocating many small nodes.
//
// Keys are hashed by their machine word, which is a value for an integer and an
// identity for an object. That is honest about what the machine can see.

// ---- the interfaces a collection answers to --------------------------------
//
// Named as .NET names them, so a class that says `: IEquatable<Type>` compiles
// here and there alike. IEquatable is the one that matters most: it is how a
// type says its Equals is about VALUE rather than identity, and this
// compiler's own Type says exactly that.

interface IEquatable<T> {
    bool Equals(T other);
}

interface IDisposable {
    void Dispose();
}

// Dictionary's default comparer is already reference (machine-word) identity.
// Keeping the .NET singleton name lets the compiler request that policy
// explicitly without allocating a comparer object.
/// .NET's ReferenceEqualityComparer: two things are the same when they are the
/// same OBJECT, whatever their own Equals says. .NET declares it as an
/// `IEqualityComparer<object>` and it serves as an IEqualityComparer of
/// anything, which is what `in T` on the interface is for.
sealed class ReferenceEqualityComparer : IEqualityComparer<object> {
    private static ReferenceEqualityComparer? only;

    public static ReferenceEqualityComparer Instance {
        get {
            if (only == null) { only = new ReferenceEqualityComparer(); }
            return only;
        }
    }

    public bool Equals(object a, object b) { return Sys.EqualValues(a, b); }

    public int GetHashCode(object value) { return (int)Sys.HashValue(value); }
}

/// A sequence that can be counted and indexed, and not written to.
///
/// This is what LINQ asks of a sequence, and why the operators below can be
/// declared over it rather than over List: counted and indexed is all they
/// need, and everything that is those two things gets them.
/// .NET's shape exactly: a collection knows how many it has, a list can be
/// indexed, and both are sequences. The hierarchy is what lets one set of
/// operators over IEnumerable<T> serve every one of them.
interface IReadOnlyCollection<out T> : IEnumerable<T> {
    int Count { get; }
}

interface IReadOnlyList<out T> : IReadOnlyCollection<T> {
    T this[int index] { get; }
}

/// A set, read only: what it holds and whether it holds a thing.
interface IReadOnlySet<T> : IReadOnlyCollection<T> {
    bool Contains(T item);
    bool IsProperSubsetOf(IEnumerable<T> other);
    bool IsProperSupersetOf(IEnumerable<T> other);
    bool IsSubsetOf(IEnumerable<T> other);
    bool IsSupersetOf(IEnumerable<T> other);
    bool Overlaps(IEnumerable<T> other);
    bool SetEquals(IEnumerable<T> other);
}

// THE MUTABLE COLLECTION INTERFACES, as .NET has them (System.Collections.
// Generic): what a method taking "any list", "any dictionary" or "any set"
// is written against, and what List, Dictionary, HashSet and the rest say
// they are. A read-only one answers IsReadOnly and refuses the mutators with
// NotSupportedException, as ReadOnlyCollection does.
interface ICollection<T> : IEnumerable<T> {
    int Count { get; }
    bool IsReadOnly { get; }
    void Add(T item);
    void Clear();
    bool Contains(T item);
    void CopyTo(T[] array, int arrayIndex);
    bool Remove(T item);
}

interface IList<T> : ICollection<T> {
    T this[int index] { get; set; }
    int IndexOf(T item);
    void Insert(int index, T item);
    void RemoveAt(int index);
}

/// WHAT AN ARRAY IS AS AN IList<T> OR AN ICollection<T>: .NET's own name
/// for the helper that answers those interfaces for a T[], and the same
/// answers. The indexer reads and writes the array itself; Count is its
/// length; IsReadOnly is true, and the mutators that would change its size
/// refuse with NotSupportedException -- an array's size is fixed. The
/// checker makes one of these where a T[] is converted to either interface
/// (through SZArrayHelper.Of); IEnumerable<T> and the read-only ones are
/// answered by the views it writes itself.
sealed class SZArrayHelper<T> : IList<T>, IReadOnlyList<T> {
    readonly T[] items;

    public SZArrayHelper(T[] items) { this.items = items; }

    public T this[int index] {
        get { return items[index]; }
        set { items[index] = value; }
    }

    public int Count => items.Length;

    public bool IsReadOnly => true;

    public int IndexOf(T item) { return Array.IndexOf(items, item); }

    public bool Contains(T item) { return Array.IndexOf(items, item) >= 0; }

    public void CopyTo(T[] array, int arrayIndex) {
        ArgumentNullException.ThrowIfNull(array);
        if (arrayIndex < 0 || arrayIndex > array.Length - items.Length) {
            throw new ArgumentException("Destination array was not long enough. Check the destination index, length, and the array's lower bounds.");
        }
        Array.Copy(items, 0, array, arrayIndex, items.Length);
    }

    public void Add(T item) { throw FixedSize(); }
    public void Clear() { throw FixedSize(); }
    public void Insert(int index, T item) { throw FixedSize(); }
    public bool Remove(T item) { throw FixedSize(); }
    public void RemoveAt(int index) { throw FixedSize(); }

    static NotSupportedException FixedSize() { return new NotSupportedException("Collection was of a fixed size."); }

    public IEnumerator<T> GetEnumerator() {
        for (int i = 0; i < items.Length; i++) {
            yield return items[i];
        }
    }

    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
}

/// What the checker calls to make one (SZArrayHelper<T>), as .NET's
/// SZArrayHelper is a class of generic methods: a generic method is what a
/// conversion found while checking can still have specialised, where a
/// generic class has to be named in the source before checking begins.
static class SZArrayHelper {
    public static IList<T> Of<T>(T[] items) { return new SZArrayHelper<T>(items); }
}

interface ISet<T> : ICollection<T> {
    new bool Add(T item);
    void UnionWith(IEnumerable<T> other);
    void IntersectWith(IEnumerable<T> other);
    void ExceptWith(IEnumerable<T> other);
    void SymmetricExceptWith(IEnumerable<T> other);
    bool IsSubsetOf(IEnumerable<T> other);
    bool IsSupersetOf(IEnumerable<T> other);
    bool IsProperSupersetOf(IEnumerable<T> other);
    bool IsProperSubsetOf(IEnumerable<T> other);
    bool Overlaps(IEnumerable<T> other);
    bool SetEquals(IEnumerable<T> other);
}

interface IDictionary<K, V> : ICollection<KeyValuePair<K, V>> {
    V this[K key] { get; set; }
    ICollection<K> Keys { get; }
    ICollection<V> Values { get; }
    void Add(K key, V value);
    bool ContainsKey(K key);
    bool Remove(K key);
    bool TryGetValue(K key, out V value);
}

// EXTENSION METHODS, which is how C# spells LINQ.
//
// `this` on the first parameter of a static method, so `list.IsEmpty()` means
// `Enumerable.IsEmpty(list)` and reads the way every other member call reads.
// An extension is searched LAST, after every real member of the type, so it
// can never shadow one -- that is C#'s rule and it is what stops adding an
// extension from changing what existing code means.
//
// This is where LINQ lives, as it does in .NET. It could not until a generic
// method could be compiled per type argument: over one shared copy, `Where<T>`
// handed back a list of `object` and the element type died at the call, so the
// operators had to sit on List<T> where monomorphisation kept the types. They
// moved here the day that landed, and not one call site changed.
// ONE GROUP: a key and the elements that had it. .NET's IGrouping is an
// ---- System.Linq ------------------------------------------------------------
//
// LINQ TO OBJECTS, AS .NET'S IS: an operator that produces a sequence is
// DEFERRED -- it checks its arguments at once and runs nothing until the
// sequence is walked, a step at a time, so `Naturals().Where(odd).Take(3)`
// ends and a source's side effects interleave with the consumer's. An
// operator that produces a value (Count, First, Sum, ToList) runs at once.
// The deferred ones are iterators (Lowering.Iterator), each split as .NET
// splits them: the public method checks, a private iterator walks. The
// messages are .NET's.

// IEnumerable with a Key on it, which is what lets `foreach (var g in
// items.GroupBy(...))` walk the group itself and ask what it is at the same
// time.
interface IGrouping<K, T> : IEnumerable<T> {
    K Key { get; }
}

/// .NET's ILookup: groups by key, each asked for by its key -- an empty
/// sequence for a key that is not there, where a Dictionary would throw.
interface ILookup<K, T> : IEnumerable<IGrouping<K, T>> {
    int Count { get; }
    IEnumerable<T> this[K key] { get; }
    bool Contains(K key);
}

/// .NET's IOrderedEnumerable: a sorted sequence that a ThenBy sorts further.
interface IOrderedEnumerable<T> : IEnumerable<T> {
    IOrderedEnumerable<T> CreateOrderedEnumerable<K>(Func<T, K> keySelector, IComparer<K>? comparer, bool descending);
}

class Grouping<K, T> : IGrouping<K, T>, IReadOnlyList<T>, IEnumerable<T> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private K key;
    private List<T> items;

    public Grouping(K value) {
        key = value;
        items = new List<T>();
    }

    public K Key => key;
    public int Count => items.Count;
    public T this[int index] => items[index];

    internal void Add(T value) { items.Add(value); }

    public IEnumerator<T> GetEnumerator() { return new ListEnumerator<T>(items); }
}

/// THE WHOLE GROUPING, KEPT: what ToLookup makes, and what GroupBy walks.
/// The groups in the order their keys were first seen, each group's elements
/// in source order, which is .NET's promise.
class Lookup<K, T> : ILookup<K, T>, IEnumerable<IGrouping<K, T>> {
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private List<Grouping<K, T>> groups;
    private Dictionary<K, Grouping<K, T>> byKey;

    internal Lookup(IEqualityComparer<K>? comparer) {
        groups = new List<Grouping<K, T>>();
        byKey = comparer == null ? new Dictionary<K, Grouping<K, T>>() : new Dictionary<K, Grouping<K, T>>(comparer);
    }

    public int Count => groups.Count;

    public IEnumerable<T> this[K key] {
        get {
            if (byKey.TryGetValue(key, out Grouping<K, T>? found) && found != null) { return found; }
            return Array.Empty<T>();
        }
    }

    public bool Contains(K key) { return byKey.ContainsKey(key); }

    internal void Add(K key, T value) {
        if (!byKey.TryGetValue(key, out Grouping<K, T>? found) || found == null) {
            found = new Grouping<K, T>(key);
            byKey.Add(key, found);
            groups.Add(found);
        }
        found.Add(value);
    }

    public IEnumerator<IGrouping<K, T>> GetEnumerator() {
        for (int i = 0; i < groups.Count; i++) { yield return groups[i]; }
    }

    /// Each group made into one result, as GroupBy with a result selector.
    public IEnumerable<R> ApplyResultSelector<R>(Func<K, IEnumerable<T>, R> resultSelector) {
        for (int i = 0; i < groups.Count; i++) { yield return resultSelector(groups[i].Key, groups[i]); }
    }
}

/// A SORT NOT YET DONE: the source and the keys it sorts by, the sort run
/// when the sequence is walked. Stable, as .NET's OrderBy is, so ThenBy
/// orders what its predecessors left equal and equal elements keep their
/// source order.
class OrderedSequence<T> : IOrderedEnumerable<T>, IEnumerable<T> {
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private IEnumerable<T> source;
    private IComparer<T> order;

    internal OrderedSequence(IEnumerable<T> source, IComparer<T> order) {
        this.source = source;
        this.order = order;
    }

    public IOrderedEnumerable<T> CreateOrderedEnumerable<K>(Func<T, K> keySelector, IComparer<K>? comparer, bool descending) {
        if (keySelector == null) { throw new ArgumentNullException("keySelector"); }
        return new OrderedSequence<T>(source, new ThenComparer<T>(order, new KeyComparer<T, K>(keySelector, descending, comparer)));
    }

    public IEnumerator<T> GetEnumerator() {
        T[] items = Enumerable.ToArray(source);
        Sorting.Sort<T>(items, 0, items.Length, order);
        for (int i = 0; i < items.Length; i++) { yield return items[i]; }
    }
}

class ThenComparer<T> : IComparer<T> {
    private IComparer<T> first;
    private IComparer<T> second;

    public ThenComparer(IComparer<T> first, IComparer<T> second) {
        this.first = first;
        this.second = second;
    }

    public int Compare(T a, T b) {
        int sign = first.Compare(a, b);
        return sign != 0 ? sign : second.Compare(a, b);
    }
}

/// Two elements in the order of what `of` takes from them, by the comparer
/// named or the key's own order (Comparer<K>.Default), reversed when
/// descending.
class KeyComparer<T, K> : IComparer<T> {
    private Func<T, K> of;
    private bool down;
    private IComparer<K> by;

    public KeyComparer(Func<T, K> key, bool descending, IComparer<K>? comparer) {
        of = key;
        down = descending;
        by = comparer ?? Comparer<K>.Default;
    }

    public int Compare(T a, T b) {
        int sign = by.Compare(of(a), of(b));
        return down ? 0 - sign : sign;
    }
}

static class Enumerable {
    // ---- the checks every operator starts with ---------------------------

    // GENERIC, so each copy is compiled in the unit that calls it, as the
    // LINQ method calling it is: a call into the library's unit was one a
    // separately compiled unit cannot see into, and every source and every
    // lambda handed to LINQ escaped through its argument check.
    private static void NotNull<T>(T? argument, string name) {
        if (argument == null) { throw new ArgumentNullException(name); }
    }

    private static InvalidOperationException NoElements() {
        return new InvalidOperationException("Sequence contains no elements");
    }

    private static InvalidOperationException NoMatch() {
        return new InvalidOperationException("Sequence contains no matching element");
    }

    private static InvalidOperationException MoreThanOne() {
        return new InvalidOperationException("Sequence contains more than one element");
    }

    private static InvalidOperationException MoreThanOneMatch() {
        return new InvalidOperationException("Sequence contains more than one matching element");
    }

    // ---- CollectionExtensions, which lived here -------------------------

    /// .NET's CollectionExtensions.GetValueOrDefault, over any read-only
    /// dictionary: the value, or the type's zero where the key is not there.
    public static V? GetValueOrDefault<K, V>(this IReadOnlyDictionary<K, V> source, K key) {
        return source.TryGetValue(key, out V? found) ? found : default(V);
    }

    public static V GetValueOrDefault<K, V>(this IReadOnlyDictionary<K, V> source, K key, V fallback) {
        return source.TryGetValue(key, out V? found) ? found! : fallback;
    }

    /// .NET's CollectionExtensions.TryAdd, over any dictionary (a
    /// SortedDictionary, say): adds the pair and answers true, or answers false
    /// and leaves the dictionary alone when the key is already there.
    public static bool TryAdd<K, V>(this IDictionary<K, V> dictionary, K key, V value) {
        if (dictionary == null) throw new ArgumentNullException("dictionary");
        if (dictionary.ContainsKey(key)) return false;
        dictionary.Add(key, value);
        return true;
    }

    // ---- making sequences --------------------------------------------------

    public static IEnumerable<T> Empty<T>() { return Array.Empty<T>(); }

    public static IEnumerable<int> Range(int start, int count) {
        if (count < 0 || (long)start + count - 1 > int.MaxValue) { throw new ArgumentOutOfRangeException("count"); }
        return RangeIterator(start, count);
    }

    private static IEnumerable<int> RangeIterator(int start, int count) {
        for (int i = 0; i < count; i++) { yield return start + i; }
    }

    public static IEnumerable<T> Repeat<T>(T element, int count) {
        if (count < 0) { throw new ArgumentOutOfRangeException("count"); }
        return RepeatIterator(element, count);
    }

    private static IEnumerable<T> RepeatIterator<T>(T element, int count) {
        for (int i = 0; i < count; i++) { yield return element; }
    }

    public static IEnumerable<T> AsEnumerable<T>(this IEnumerable<T> source) { return source; }

    // ---- filtering and projecting (deferred) ----------------------------

    public static IEnumerable<T> Where<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return WhereIterator(source, predicate);
    }

    private static IEnumerable<T> WhereIterator<T>(IEnumerable<T> source, Func<T, bool> predicate) {
        // AN ARRAY OR A LIST IS WALKED AS ITSELF, as .NET's ArrayWhereIterator
        // and ListWhereIterator do: by index, or with the list's own struct
        // enumerator, not with an enumerator boxed for the interface. Asked
        // with `is`, as .NET asks, so a List's subclass is walked as a List.
        if (source is T[] array) { return WhereArray(array, predicate); }
        if (source is List<T> list) { return WhereList(list, predicate); }
        return WhereAny(source, predicate);
    }

    private static IEnumerable<T> WhereAny<T>(IEnumerable<T> source, Func<T, bool> predicate) {
        foreach (T item in source) { if (predicate(item)) { yield return item; } }
    }

    private static IEnumerable<T> WhereArray<T>(T[] source, Func<T, bool> predicate) {
        for (int i = 0; i < source.Length; i++) { T item = source[i]; if (predicate(item)) { yield return item; } }
    }

    private static IEnumerable<T> WhereList<T>(List<T> source, Func<T, bool> predicate) {
        foreach (T item in source) { if (predicate(item)) { yield return item; } }
    }

    public static IEnumerable<T> Where<T>(this IEnumerable<T> source, Func<T, int, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return WhereIndexed(source, predicate);
    }

    private static IEnumerable<T> WhereIndexed<T>(IEnumerable<T> source, Func<T, int, bool> predicate) {
        int index = -1;
        foreach (T item in source) {
            index = checked(index + 1);
            if (predicate(item, index)) { yield return item; }
        }
    }

    public static IEnumerable<R> Select<T, R>(this IEnumerable<T> source, Func<T, R> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return SelectIterator(source, selector);
    }

    private static IEnumerable<R> SelectIterator<T, R>(IEnumerable<T> source, Func<T, R> selector) {
        // As Where's: .NET's ArraySelectIterator and ListSelectIterator.
        if (source is T[] array) { return SelectArray(array, selector); }
        if (source is List<T> list) { return SelectList(list, selector); }
        return SelectAny(source, selector);
    }

    private static IEnumerable<R> SelectAny<T, R>(IEnumerable<T> source, Func<T, R> selector) {
        foreach (T item in source) { yield return selector(item); }
    }

    private static IEnumerable<R> SelectArray<T, R>(T[] source, Func<T, R> selector) {
        for (int i = 0; i < source.Length; i++) { yield return selector(source[i]); }
    }

    private static IEnumerable<R> SelectList<T, R>(List<T> source, Func<T, R> selector) {
        foreach (T item in source) { yield return selector(item); }
    }

    public static IEnumerable<R> Select<T, R>(this IEnumerable<T> source, Func<T, int, R> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return SelectIndexed(source, selector);
    }

    private static IEnumerable<R> SelectIndexed<T, R>(IEnumerable<T> source, Func<T, int, R> selector) {
        int index = -1;
        foreach (T item in source) {
            index = checked(index + 1);
            yield return selector(item, index);
        }
    }

    public static IEnumerable<R> SelectMany<T, R>(this IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return SelectManyIterator(source, selector);
    }

    private static IEnumerable<R> SelectManyIterator<T, R>(IEnumerable<T> source, Func<T, IEnumerable<R>> selector) {
        foreach (T item in source) { foreach (R each in selector(item)) { yield return each; } }
    }

    public static IEnumerable<R> SelectMany<T, R>(this IEnumerable<T> source, Func<T, int, IEnumerable<R>> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return SelectManyIndexed(source, selector);
    }

    private static IEnumerable<R> SelectManyIndexed<T, R>(IEnumerable<T> source, Func<T, int, IEnumerable<R>> selector) {
        int index = -1;
        foreach (T item in source) {
            index = checked(index + 1);
            foreach (R each in selector(item, index)) { yield return each; }
        }
    }

    public static IEnumerable<R> SelectMany<T, C, R>(this IEnumerable<T> source, Func<T, IEnumerable<C>> collectionSelector, Func<T, C, R> resultSelector) {
        NotNull(source, "source"); NotNull(collectionSelector, "collectionSelector"); NotNull(resultSelector, "resultSelector");
        return SelectManyResults(source, collectionSelector, resultSelector);
    }

    private static IEnumerable<R> SelectManyResults<T, C, R>(IEnumerable<T> source, Func<T, IEnumerable<C>> collectionSelector, Func<T, C, R> resultSelector) {
        foreach (T item in source) { foreach (C each in collectionSelector(item)) { yield return resultSelector(item, each); } }
    }

    public static IEnumerable<R> OfType<R>(this IEnumerable source) {
        NotNull(source, "source");
        return OfTypeIterator<R>(source);
    }

    private static IEnumerable<R> OfTypeIterator<R>(IEnumerable source) {
        foreach (object? item in source) { if (item is R typed) { yield return typed; } }
    }

    public static IEnumerable<R> Cast<R>(this IEnumerable source) {
        NotNull(source, "source");
        if (source is IEnumerable<R> already) { return already; }
        return CastIterator<R>(source);
    }

    private static IEnumerable<R> CastIterator<R>(IEnumerable source) {
        foreach (object? item in source) { yield return (R)item!; }
    }

    // ---- partitioning (deferred) --------------------------------------------

    public static IEnumerable<T> Take<T>(this IEnumerable<T> source, int count) {
        NotNull(source, "source");
        return count <= 0 ? Empty<T>() : TakeIterator(source, count);
    }

    private static IEnumerable<T> TakeIterator<T>(IEnumerable<T> source, int count) {
        foreach (T item in source) {
            yield return item;
            count = count - 1;
            if (count == 0) { yield break; }
        }
    }

    public static IEnumerable<T> Skip<T>(this IEnumerable<T> source, int count) {
        NotNull(source, "source");
        return SkipIterator(source, count);
    }

    private static IEnumerable<T> SkipIterator<T>(IEnumerable<T> source, int count) {
        foreach (T item in source) {
            if (count > 0) { count = count - 1; continue; }
            yield return item;
        }
    }

    public static IEnumerable<T> TakeWhile<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return TakeWhileIterator(source, predicate);
    }

    private static IEnumerable<T> TakeWhileIterator<T>(IEnumerable<T> source, Func<T, bool> predicate) {
        foreach (T item in source) {
            if (!predicate(item)) { yield break; }
            yield return item;
        }
    }

    public static IEnumerable<T> TakeWhile<T>(this IEnumerable<T> source, Func<T, int, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return TakeWhileIndexed(source, predicate);
    }

    private static IEnumerable<T> TakeWhileIndexed<T>(IEnumerable<T> source, Func<T, int, bool> predicate) {
        int index = -1;
        foreach (T item in source) {
            index = checked(index + 1);
            if (!predicate(item, index)) { yield break; }
            yield return item;
        }
    }

    public static IEnumerable<T> SkipWhile<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return SkipWhileIterator(source, predicate);
    }

    private static IEnumerable<T> SkipWhileIterator<T>(IEnumerable<T> source, Func<T, bool> predicate) {
        bool yielding = false;
        foreach (T item in source) {
            if (!yielding && !predicate(item)) { yielding = true; }
            if (yielding) { yield return item; }
        }
    }

    public static IEnumerable<T> SkipWhile<T>(this IEnumerable<T> source, Func<T, int, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        return SkipWhileIndexed(source, predicate);
    }

    private static IEnumerable<T> SkipWhileIndexed<T>(IEnumerable<T> source, Func<T, int, bool> predicate) {
        int index = -1;
        bool yielding = false;
        foreach (T item in source) {
            index = checked(index + 1);
            if (!yielding && !predicate(item, index)) { yielding = true; }
            if (yielding) { yield return item; }
        }
    }

    public static IEnumerable<T> TakeLast<T>(this IEnumerable<T> source, int count) {
        NotNull(source, "source");
        return count <= 0 ? Empty<T>() : TakeLastIterator(source, count);
    }

    private static IEnumerable<T> TakeLastIterator<T>(IEnumerable<T> source, int count) {
        Queue<T> kept = new Queue<T>();
        foreach (T item in source) {
            if (kept.Count == count) { kept.Dequeue(); }
            kept.Enqueue(item);
        }
        while (kept.Count > 0) { yield return kept.Dequeue(); }
    }

    public static IEnumerable<T> SkipLast<T>(this IEnumerable<T> source, int count) {
        NotNull(source, "source");
        return count <= 0 ? source.Skip(0) : SkipLastIterator(source, count);
    }

    private static IEnumerable<T> SkipLastIterator<T>(IEnumerable<T> source, int count) {
        Queue<T> held = new Queue<T>();
        foreach (T item in source) {
            if (held.Count == count) { yield return held.Dequeue(); }
            held.Enqueue(item);
        }
    }

    public static IEnumerable<T[]> Chunk<T>(this IEnumerable<T> source, int size) {
        NotNull(source, "source");
        if (size < 1) { throw new ArgumentOutOfRangeException("size"); }
        return ChunkIterator(source, size);
    }

    private static IEnumerable<T[]> ChunkIterator<T>(IEnumerable<T> source, int size) {
        List<T> chunk = new List<T>(size);
        foreach (T item in source) {
            chunk.Add(item);
            if (chunk.Count == size) {
                yield return chunk.ToArray();
                chunk = new List<T>(size);
            }
        }
        if (chunk.Count > 0) { yield return chunk.ToArray(); }
    }

    // ---- joining sequences (deferred) --------------------------------------

    public static IEnumerable<T> Concat<T>(this IEnumerable<T> first, IEnumerable<T> second) {
        NotNull(first, "first"); NotNull(second, "second");
        return ConcatIterator(first, second);
    }

    private static IEnumerable<T> ConcatIterator<T>(IEnumerable<T> first, IEnumerable<T> second) {
        foreach (T item in first) { yield return item; }
        foreach (T item in second) { yield return item; }
    }

    public static IEnumerable<T> Append<T>(this IEnumerable<T> source, T element) {
        NotNull(source, "source");
        return AppendIterator(source, element);
    }

    private static IEnumerable<T> AppendIterator<T>(IEnumerable<T> source, T element) {
        foreach (T item in source) { yield return item; }
        yield return element;
    }

    public static IEnumerable<T> Prepend<T>(this IEnumerable<T> source, T element) {
        NotNull(source, "source");
        return PrependIterator(source, element);
    }

    private static IEnumerable<T> PrependIterator<T>(IEnumerable<T> source, T element) {
        yield return element;
        foreach (T item in source) { yield return item; }
    }

    public static IEnumerable<(T First, U Second)> Zip<T, U>(this IEnumerable<T> first, IEnumerable<U> second) {
        NotNull(first, "first"); NotNull(second, "second");
        return ZipPairs(first, second);
    }

    private static IEnumerable<(T First, U Second)> ZipPairs<T, U>(IEnumerable<T> first, IEnumerable<U> second) {
        using (IEnumerator<T> left = first.GetEnumerator())
        using (IEnumerator<U> right = second.GetEnumerator()) {
            while (left.MoveNext() && right.MoveNext()) { yield return (left.Current, right.Current); }
        }
    }

    public static IEnumerable<R> Zip<T, U, R>(this IEnumerable<T> first, IEnumerable<U> second, Func<T, U, R> resultSelector) {
        NotNull(first, "first"); NotNull(second, "second"); NotNull(resultSelector, "resultSelector");
        return ZipResults(first, second, resultSelector);
    }

    private static IEnumerable<R> ZipResults<T, U, R>(IEnumerable<T> first, IEnumerable<U> second, Func<T, U, R> resultSelector) {
        using (IEnumerator<T> left = first.GetEnumerator())
        using (IEnumerator<U> right = second.GetEnumerator()) {
            while (left.MoveNext() && right.MoveNext()) { yield return resultSelector(left.Current, right.Current); }
        }
    }

    public static IEnumerable<T> DefaultIfEmpty<T>(this IEnumerable<T> source) {
        return DefaultIfEmpty(source, default(T)!);
    }

    public static IEnumerable<T> DefaultIfEmpty<T>(this IEnumerable<T> source, T defaultValue) {
        NotNull(source, "source");
        return DefaultIfEmptyIterator(source, defaultValue);
    }

    private static IEnumerable<T> DefaultIfEmptyIterator<T>(IEnumerable<T> source, T defaultValue) {
        bool any = false;
        foreach (T item in source) {
            any = true;
            yield return item;
        }
        if (!any) { yield return defaultValue; }
    }

    public static IEnumerable<T> Reverse<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        return ReverseIterator(source);
    }

    private static IEnumerable<T> ReverseIterator<T>(IEnumerable<T> source) {
        T[] items = source.ToArray();
        for (int i = items.Length - 1; i >= 0; i--) { yield return items[i]; }
    }

    // ---- sets (deferred) ----------------------------------------------------

    public static IEnumerable<T> Distinct<T>(this IEnumerable<T> source) { return Distinct(source, null); }

    public static IEnumerable<T> Distinct<T>(this IEnumerable<T> source, IEqualityComparer<T>? comparer) {
        NotNull(source, "source");
        return DistinctIterator(source, comparer);
    }

    private static IEnumerable<T> DistinctIterator<T>(IEnumerable<T> source, IEqualityComparer<T>? comparer) {
        HashSet<T> seen = comparer == null ? new HashSet<T>() : new HashSet<T>(comparer);
        foreach (T item in source) { if (seen.Add(item)) { yield return item; } }
    }

    public static IEnumerable<T> DistinctBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return DistinctBy(source, keySelector, null); }

    public static IEnumerable<T> DistinctBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        return DistinctByIterator(source, keySelector, comparer);
    }

    private static IEnumerable<T> DistinctByIterator<T, K>(IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        HashSet<K> seen = comparer == null ? new HashSet<K>() : new HashSet<K>(comparer);
        foreach (T item in source) { if (seen.Add(keySelector(item))) { yield return item; } }
    }

    public static IEnumerable<T> Union<T>(this IEnumerable<T> first, IEnumerable<T> second) { return Union(first, second, null); }

    public static IEnumerable<T> Union<T>(this IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        NotNull(first, "first"); NotNull(second, "second");
        return UnionIterator(first, second, comparer);
    }

    private static IEnumerable<T> UnionIterator<T>(IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        HashSet<T> seen = comparer == null ? new HashSet<T>() : new HashSet<T>(comparer);
        foreach (T item in first) { if (seen.Add(item)) { yield return item; } }
        foreach (T item in second) { if (seen.Add(item)) { yield return item; } }
    }

    public static IEnumerable<T> Intersect<T>(this IEnumerable<T> first, IEnumerable<T> second) { return Intersect(first, second, null); }

    public static IEnumerable<T> Intersect<T>(this IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        NotNull(first, "first"); NotNull(second, "second");
        return IntersectIterator(first, second, comparer);
    }

    private static IEnumerable<T> IntersectIterator<T>(IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        HashSet<T> other = comparer == null ? new HashSet<T>(second) : new HashSet<T>(second, comparer);
        foreach (T item in first) { if (other.Remove(item)) { yield return item; } }
    }

    public static IEnumerable<T> Except<T>(this IEnumerable<T> first, IEnumerable<T> second) { return Except(first, second, null); }

    public static IEnumerable<T> Except<T>(this IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        NotNull(first, "first"); NotNull(second, "second");
        return ExceptIterator(first, second, comparer);
    }

    private static IEnumerable<T> ExceptIterator<T>(IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        HashSet<T> seen = comparer == null ? new HashSet<T>(second) : new HashSet<T>(second, comparer);
        foreach (T item in first) { if (seen.Add(item)) { yield return item; } }
    }

    // ---- ordering (deferred) ------------------------------------------------

    public static IOrderedEnumerable<T> OrderBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return OrderBy(source, keySelector, null); }

    public static IOrderedEnumerable<T> OrderBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        return new OrderedSequence<T>(source, new KeyComparer<T, K>(keySelector, false, comparer));
    }

    public static IOrderedEnumerable<T> OrderByDescending<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return OrderByDescending(source, keySelector, null); }

    public static IOrderedEnumerable<T> OrderByDescending<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        return new OrderedSequence<T>(source, new KeyComparer<T, K>(keySelector, true, comparer));
    }

    public static IOrderedEnumerable<T> Order<T>(this IEnumerable<T> source) { return Order(source, null); }

    public static IOrderedEnumerable<T> Order<T>(this IEnumerable<T> source, IComparer<T>? comparer) {
        NotNull(source, "source");
        return new OrderedSequence<T>(source, comparer ?? Comparer<T>.Default);
    }

    public static IOrderedEnumerable<T> OrderDescending<T>(this IEnumerable<T> source) { return OrderDescending(source, null); }

    public static IOrderedEnumerable<T> OrderDescending<T>(this IEnumerable<T> source, IComparer<T>? comparer) {
        NotNull(source, "source");
        return new OrderedSequence<T>(source, new KeyComparer<T, T>(x => x, true, comparer));
    }

    public static IOrderedEnumerable<T> ThenBy<T, K>(this IOrderedEnumerable<T> source, Func<T, K> keySelector) { return ThenBy(source, keySelector, null); }

    public static IOrderedEnumerable<T> ThenBy<T, K>(this IOrderedEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source");
        return source.CreateOrderedEnumerable(keySelector, comparer, false);
    }

    public static IOrderedEnumerable<T> ThenByDescending<T, K>(this IOrderedEnumerable<T> source, Func<T, K> keySelector) { return ThenByDescending(source, keySelector, null); }

    public static IOrderedEnumerable<T> ThenByDescending<T, K>(this IOrderedEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source");
        return source.CreateOrderedEnumerable(keySelector, comparer, true);
    }

    // ---- grouping and joining -----------------------------------------------

    public static IEnumerable<IGrouping<K, T>> GroupBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return GroupBy(source, keySelector, (IEqualityComparer<K>?)null); }

    public static IEnumerable<IGrouping<K, T>> GroupBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        return GroupByIterator(source, keySelector, comparer);
    }

    private static IEnumerable<IGrouping<K, T>> GroupByIterator<T, K>(IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        foreach (IGrouping<K, T> group in ToLookup(source, keySelector, comparer)) { yield return group; }
    }

    public static IEnumerable<IGrouping<K, E>> GroupBy<T, K, E>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, E> elementSelector) { return GroupBy(source, keySelector, elementSelector, (IEqualityComparer<K>?)null); }

    public static IEnumerable<IGrouping<K, E>> GroupBy<T, K, E>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, E> elementSelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector"); NotNull(elementSelector, "elementSelector");
        return GroupByElements(source, keySelector, elementSelector, comparer);
    }

    private static IEnumerable<IGrouping<K, E>> GroupByElements<T, K, E>(IEnumerable<T> source, Func<T, K> keySelector, Func<T, E> elementSelector, IEqualityComparer<K>? comparer) {
        foreach (IGrouping<K, E> group in ToLookup(source, keySelector, elementSelector, comparer)) { yield return group; }
    }

    public static IEnumerable<R> GroupBy<T, K, R>(this IEnumerable<T> source, Func<T, K> keySelector, Func<K, IEnumerable<T>, R> resultSelector) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector"); NotNull(resultSelector, "resultSelector");
        return GroupByResults(source, keySelector, resultSelector);
    }

    private static IEnumerable<R> GroupByResults<T, K, R>(IEnumerable<T> source, Func<T, K> keySelector, Func<K, IEnumerable<T>, R> resultSelector) {
        foreach (R result in ((Lookup<K, T>)ToLookup(source, keySelector, null)).ApplyResultSelector(resultSelector)) { yield return result; }
    }

    public static ILookup<K, T> ToLookup<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return ToLookup(source, keySelector, (IEqualityComparer<K>?)null); }

    public static ILookup<K, T> ToLookup<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        Lookup<K, T> made = new Lookup<K, T>(comparer);
        foreach (T item in source) { made.Add(keySelector(item), item); }
        return made;
    }

    public static ILookup<K, E> ToLookup<T, K, E>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, E> elementSelector) { return ToLookup(source, keySelector, elementSelector, null); }

    public static ILookup<K, E> ToLookup<T, K, E>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, E> elementSelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector"); NotNull(elementSelector, "elementSelector");
        Lookup<K, E> made = new Lookup<K, E>(comparer);
        foreach (T item in source) { made.Add(keySelector(item), elementSelector(item)); }
        return made;
    }

    public static IEnumerable<R> Join<T, U, K, R>(this IEnumerable<T> outer, IEnumerable<U> inner, Func<T, K> outerKeySelector, Func<U, K> innerKeySelector, Func<T, U, R> resultSelector) {
        NotNull(outer, "outer"); NotNull(inner, "inner"); NotNull(outerKeySelector, "outerKeySelector");
        NotNull(innerKeySelector, "innerKeySelector"); NotNull(resultSelector, "resultSelector");
        return JoinIterator(outer, inner, outerKeySelector, innerKeySelector, resultSelector);
    }

    private static IEnumerable<R> JoinIterator<T, U, K, R>(IEnumerable<T> outer, IEnumerable<U> inner, Func<T, K> outerKeySelector, Func<U, K> innerKeySelector, Func<T, U, R> resultSelector) {
        ILookup<K, U> matches = ToLookup(inner, innerKeySelector, (IEqualityComparer<K>?)null);
        foreach (T item in outer) {
            foreach (U match in matches[outerKeySelector(item)]) { yield return resultSelector(item, match); }
        }
    }

    public static IEnumerable<R> GroupJoin<T, U, K, R>(this IEnumerable<T> outer, IEnumerable<U> inner, Func<T, K> outerKeySelector, Func<U, K> innerKeySelector, Func<T, IEnumerable<U>, R> resultSelector) {
        NotNull(outer, "outer"); NotNull(inner, "inner"); NotNull(outerKeySelector, "outerKeySelector");
        NotNull(innerKeySelector, "innerKeySelector"); NotNull(resultSelector, "resultSelector");
        return GroupJoinIterator(outer, inner, outerKeySelector, innerKeySelector, resultSelector);
    }

    private static IEnumerable<R> GroupJoinIterator<T, U, K, R>(IEnumerable<T> outer, IEnumerable<U> inner, Func<T, K> outerKeySelector, Func<U, K> innerKeySelector, Func<T, IEnumerable<U>, R> resultSelector) {
        ILookup<K, U> matches = ToLookup(inner, innerKeySelector, (IEqualityComparer<K>?)null);
        foreach (T item in outer) { yield return resultSelector(item, matches[outerKeySelector(item)]); }
    }

    // ---- conversions (immediate) -------------------------------------------

    public static List<T> ToList<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        return new List<T>(source);
    }

    public static T[] ToArray<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        // A collection straight into an array its size, as .NET's does.
        if (source is ICollection<T> collection) {
            T[] copied = new T[collection.Count];
            if (copied.Length > 0) { collection.CopyTo(copied, 0); }
            return copied;
        }
        List<T> made = new List<T>(source);
        return made.ToArray();
    }

    public static HashSet<T> ToHashSet<T>(this IEnumerable<T> source) { return ToHashSet(source, null); }

    public static HashSet<T> ToHashSet<T>(this IEnumerable<T> source, IEqualityComparer<T>? comparer) {
        NotNull(source, "source");
        return comparer == null ? new HashSet<T>(source) : new HashSet<T>(source, comparer);
    }

    public static Dictionary<K, T> ToDictionary<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return ToDictionary(source, keySelector, (IEqualityComparer<K>?)null); }

    public static Dictionary<K, T> ToDictionary<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        Dictionary<K, T> made = comparer == null ? new Dictionary<K, T>() : new Dictionary<K, T>(comparer);
        foreach (T item in source) { made.Add(keySelector(item), item); }
        return made;
    }

    public static Dictionary<K, V> ToDictionary<T, K, V>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, V> elementSelector) { return ToDictionary(source, keySelector, elementSelector, null); }

    public static Dictionary<K, V> ToDictionary<T, K, V>(this IEnumerable<T> source, Func<T, K> keySelector, Func<T, V> elementSelector, IEqualityComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector"); NotNull(elementSelector, "elementSelector");
        Dictionary<K, V> made = comparer == null ? new Dictionary<K, V>() : new Dictionary<K, V>(comparer);
        foreach (T item in source) { made.Add(keySelector(item), elementSelector(item)); }
        return made;
    }

    public static Dictionary<K, V> ToDictionary<K, V>(this IEnumerable<KeyValuePair<K, V>> source) {
        NotNull(source, "source");
        Dictionary<K, V> made = new Dictionary<K, V>();
        foreach (KeyValuePair<K, V> pair in source) { made.Add(pair.Key, pair.Value); }
        return made;
    }

    // ---- elements (immediate) -----------------------------------------------

    /// .NET's TryGetSpan: the elements of an array or of a List -- exactly
    /// one, not a subclass, which may enumerate itself otherwise -- as an
    /// array and how many of it count, or null. What the questions below ask
    /// is then asked by index, with no enumerator made to ask it.
    // A NULL TEST, NOT A TYPE TEST, ON WHAT THIS ANSWERS: a List's array
    // made by the code all lists of references share holds those references
    // under the shared element type, and `is T[]` turned every Any, First
    // and Count over a List away from its array and onto a boxed enumerator.
    private static T[]? Items<T>(IEnumerable<T> source, out int count) {
        if (source.GetType() == typeof(T[])) { T[] array = (T[])source; count = array.Length; return array; }
        if (source.GetType() == typeof(List<T>)) { List<T> list = (List<T>)source; count = list.Count; return list.Backing(); }
        count = 0;
        return null;
    }

    public static T First<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        // A list is asked for its first, as .NET asks any IList.
        if (source is IList<T> list) { if (list.Count > 0) { return list[0]; } throw NoElements(); }
        foreach (T item in source) { return item; }
        throw NoElements();
    }

    public static T First<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        if (Items(source, out int count) is { } items) {
            for (int i = 0; i < count; i++) { if (predicate(items[i])) { return items[i]; } }
            throw NoMatch();
        }
        foreach (T item in source) { if (predicate(item)) { return item; } }
        throw NoMatch();
    }

    public static T? FirstOrDefault<T>(this IEnumerable<T> source) { return FirstOrDefault(source, default(T)!); }

    public static T FirstOrDefault<T>(this IEnumerable<T> source, T defaultValue) {
        NotNull(source, "source");
        if (source is IList<T> list) { return list.Count > 0 ? list[0] : defaultValue; }
        foreach (T item in source) { return item; }
        return defaultValue;
    }

    public static T? FirstOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate) { return FirstOrDefault(source, predicate, default(T)!); }

    public static T FirstOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate, T defaultValue) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        if (Items(source, out int count) is { } items) {
            for (int i = 0; i < count; i++) { if (predicate(items[i])) { return items[i]; } }
            return defaultValue;
        }
        foreach (T item in source) { if (predicate(item)) { return item; } }
        return defaultValue;
    }

    public static T Last<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        bool found = false;
        T last = default(T)!;
        foreach (T item in source) { found = true; last = item; }
        if (!found) { throw NoElements(); }
        return last;
    }

    public static T Last<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        bool found = false;
        T last = default(T)!;
        foreach (T item in source) { if (predicate(item)) { found = true; last = item; } }
        if (!found) { throw NoMatch(); }
        return last;
    }

    public static T? LastOrDefault<T>(this IEnumerable<T> source) { return LastOrDefault(source, default(T)!); }

    public static T LastOrDefault<T>(this IEnumerable<T> source, T defaultValue) {
        NotNull(source, "source");
        T last = defaultValue;
        foreach (T item in source) { last = item; }
        return last;
    }

    public static T? LastOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate) { return LastOrDefault(source, predicate, default(T)!); }

    public static T LastOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate, T defaultValue) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        T last = defaultValue;
        foreach (T item in source) { if (predicate(item)) { last = item; } }
        return last;
    }

    public static T Single<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        using (IEnumerator<T> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            T only = walk.Current;
            if (walk.MoveNext()) { throw MoreThanOne(); }
            return only;
        }
    }

    public static T Single<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        bool found = false;
        T only = default(T)!;
        foreach (T item in source) {
            if (!predicate(item)) { continue; }
            if (found) { throw MoreThanOneMatch(); }
            found = true;
            only = item;
        }
        if (!found) { throw NoMatch(); }
        return only;
    }

    public static T? SingleOrDefault<T>(this IEnumerable<T> source) { return SingleOrDefault(source, default(T)!); }

    public static T SingleOrDefault<T>(this IEnumerable<T> source, T defaultValue) {
        NotNull(source, "source");
        using (IEnumerator<T> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { return defaultValue; }
            T only = walk.Current;
            if (walk.MoveNext()) { throw MoreThanOne(); }
            return only;
        }
    }

    public static T? SingleOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate) { return SingleOrDefault(source, predicate, default(T)!); }

    public static T SingleOrDefault<T>(this IEnumerable<T> source, Func<T, bool> predicate, T defaultValue) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        bool found = false;
        T only = defaultValue;
        foreach (T item in source) {
            if (!predicate(item)) { continue; }
            if (found) { throw MoreThanOneMatch(); }
            found = true;
            only = item;
        }
        return only;
    }

    public static T ElementAt<T>(this IEnumerable<T> source, int index) {
        NotNull(source, "source");
        if (source is IReadOnlyList<T> list) {
            if (index < 0 || index >= list.Count) { throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection."); }
            return list[index];
        }
        if (index >= 0) {
            foreach (T item in source) {
                if (index == 0) { return item; }
                index = index - 1;
            }
        }
        throw new ArgumentOutOfRangeException("index", "Index was out of range. Must be non-negative and less than the size of the collection.");
    }

    public static T? ElementAtOrDefault<T>(this IEnumerable<T> source, int index) {
        NotNull(source, "source");
        if (index < 0) { return default(T); }
        if (source is IReadOnlyList<T> list) { return index < list.Count ? list[index] : default(T); }
        foreach (T item in source) {
            if (index == 0) { return item; }
            index = index - 1;
        }
        return default(T);
    }

    // ---- questions (immediate) ----------------------------------------------

    public static bool Any<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        if (source is IReadOnlyCollection<T> collection) { return collection.Count != 0; }
        using (IEnumerator<T> walk = source.GetEnumerator()) { return walk.MoveNext(); }
    }

    public static bool Any<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        if (Items(source, out int count) is { } items) {
            for (int i = 0; i < count; i++) { if (predicate(items[i])) { return true; } }
            return false;
        }
        foreach (T item in source) { if (predicate(item)) { return true; } }
        return false;
    }

    public static bool All<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        if (Items(source, out int count) is { } items) {
            for (int i = 0; i < count; i++) { if (!predicate(items[i])) { return false; } }
            return true;
        }
        foreach (T item in source) { if (!predicate(item)) { return false; } }
        return true;
    }

    /// A collection is asked itself, as .NET asks it: its own Contains, with
    /// its own comparer -- a set's, a list's search.
    public static bool Contains<T>(this IEnumerable<T> source, T value) {
        NotNull(source, "source");
        if (source is ICollection<T> collection) { return collection.Contains(value); }
        return Contains(source, value, null);
    }

    public static bool Contains<T>(this IEnumerable<T> source, T value, IEqualityComparer<T>? comparer) {
        NotNull(source, "source");
        IEqualityComparer<T> same = comparer ?? EqualityComparer<T>.Default;
        foreach (T item in source) { if (same.Equals(item, value)) { return true; } }
        return false;
    }

    public static bool SequenceEqual<T>(this IEnumerable<T> first, IEnumerable<T> second) { return SequenceEqual(first, second, null); }

    public static bool SequenceEqual<T>(this IEnumerable<T> first, IEnumerable<T> second, IEqualityComparer<T>? comparer) {
        NotNull(first, "first"); NotNull(second, "second");
        IEqualityComparer<T> same = comparer ?? EqualityComparer<T>.Default;
        using (IEnumerator<T> left = first.GetEnumerator())
        using (IEnumerator<T> right = second.GetEnumerator()) {
            while (left.MoveNext()) {
                if (!right.MoveNext() || !same.Equals(left.Current, right.Current)) { return false; }
            }
            return !right.MoveNext();
        }
    }

    public static int Count<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        if (source is IReadOnlyCollection<T> collection) { return collection.Count; }
        int count = 0;
        using (IEnumerator<T> walk = source.GetEnumerator()) { while (walk.MoveNext()) { count = checked(count + 1); } }
        return count;
    }

    public static int Count<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        int count = 0;
        if (Items(source, out int length) is { } items) {
            for (int i = 0; i < length; i++) { if (predicate(items[i])) { count = count + 1; } }
            return count;
        }
        foreach (T item in source) { if (predicate(item)) { count = checked(count + 1); } }
        return count;
    }

    public static long LongCount<T>(this IEnumerable<T> source) {
        NotNull(source, "source");
        long count = 0;
        using (IEnumerator<T> walk = source.GetEnumerator()) { while (walk.MoveNext()) { count = checked(count + 1); } }
        return count;
    }

    public static long LongCount<T>(this IEnumerable<T> source, Func<T, bool> predicate) {
        NotNull(source, "source"); NotNull(predicate, "predicate");
        long count = 0;
        foreach (T item in source) { if (predicate(item)) { count = checked(count + 1); } }
        return count;
    }

    public static bool TryGetNonEnumeratedCount<T>(this IEnumerable<T> source, out int count) {
        NotNull(source, "source");
        if (source is IReadOnlyCollection<T> collection) { count = collection.Count; return true; }
        count = 0;
        return false;
    }

    // ---- aggregates (immediate) --------------------------------------------

    public static T Aggregate<T>(this IEnumerable<T> source, Func<T, T, T> func) {
        NotNull(source, "source"); NotNull(func, "func");
        using (IEnumerator<T> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            T result = walk.Current;
            while (walk.MoveNext()) { result = func(result, walk.Current); }
            return result;
        }
    }

    public static A Aggregate<T, A>(this IEnumerable<T> source, A seed, Func<A, T, A> func) {
        NotNull(source, "source"); NotNull(func, "func");
        A result = seed;
        foreach (T item in source) { result = func(result, item); }
        return result;
    }

    public static R Aggregate<T, A, R>(this IEnumerable<T> source, A seed, Func<A, T, A> func, Func<A, R> resultSelector) {
        NotNull(source, "source"); NotNull(func, "func"); NotNull(resultSelector, "resultSelector");
        A result = seed;
        foreach (T item in source) { result = func(result, item); }
        return resultSelector(result);
    }

    public static int Sum(this IEnumerable<int> source) {
        NotNull(source, "source");
        int total = 0;
        foreach (int item in source) { total = checked(total + item); }
        return total;
    }

    public static long Sum(this IEnumerable<long> source) {
        NotNull(source, "source");
        long total = 0;
        foreach (long item in source) { total = checked(total + item); }
        return total;
    }

    public static float Sum(this IEnumerable<float> source) {
        NotNull(source, "source");
        double total = 0;
        foreach (float item in source) { total = total + item; }
        return (float)total;
    }

    public static double Sum(this IEnumerable<double> source) {
        NotNull(source, "source");
        double total = 0;
        foreach (double item in source) { total = total + item; }
        return total;
    }

    public static int Sum<T>(this IEnumerable<T> source, Func<T, int> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        int total = 0;
        foreach (T item in source) { total = checked(total + selector(item)); }
        return total;
    }

    public static long Sum<T>(this IEnumerable<T> source, Func<T, long> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        long total = 0;
        foreach (T item in source) { total = checked(total + selector(item)); }
        return total;
    }

    public static float Sum<T>(this IEnumerable<T> source, Func<T, float> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        double total = 0;
        foreach (T item in source) { total = total + selector(item); }
        return (float)total;
    }

    public static double Sum<T>(this IEnumerable<T> source, Func<T, double> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        double total = 0;
        foreach (T item in source) { total = total + selector(item); }
        return total;
    }

    /// The values there are, added: nulls are skipped, and none at all is 0 -- never null, as .NET's.
    public static int? Sum(this IEnumerable<int?> source) {
        NotNull(source, "source");
        int total = 0;
        foreach (int? item in source) { if (item.HasValue) { total = checked(total + item.Value); } }
        return total;
    }

    public static int? Sum<T>(this IEnumerable<T> source, Func<T, int?> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        int total = 0;
        foreach (T item in source) { int? value = selector(item); if (value.HasValue) { total = checked(total + value.Value); } }
        return total;
    }

    /// The mean of the values there are, nulls skipped; null when there are none.
    public static double? Average(this IEnumerable<int?> source) {
        NotNull(source, "source");
        long total = 0;
        long count = 0;
        foreach (int? item in source) { if (item.HasValue) { total = checked(total + item.Value); count = count + 1; } }
        if (count == 0) { return null; }
        return (double)((double)total / count);
    }

    /// The least and greatest of the values there are, nulls skipped; null when there are none.
    public static int? Min(this IEnumerable<int?> source) {
        NotNull(source, "source");
        int? best = null;
        foreach (int? item in source) { if (item.HasValue && (!best.HasValue || item.Value < best.Value)) { best = item; } }
        return best;
    }

    public static int? Max(this IEnumerable<int?> source) {
        NotNull(source, "source");
        int? best = null;
        foreach (int? item in source) { if (item.HasValue && (!best.HasValue || item.Value > best.Value)) { best = item; } }
        return best;
    }

    /// The values there are, added: nulls are skipped, and none at all is 0 -- never null, as .NET's.
    public static long? Sum(this IEnumerable<long?> source) {
        NotNull(source, "source");
        long total = 0;
        foreach (long? item in source) { if (item.HasValue) { total = checked(total + item.Value); } }
        return total;
    }

    public static long? Sum<T>(this IEnumerable<T> source, Func<T, long?> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        long total = 0;
        foreach (T item in source) { long? value = selector(item); if (value.HasValue) { total = checked(total + value.Value); } }
        return total;
    }

    /// The mean of the values there are, nulls skipped; null when there are none.
    public static double? Average(this IEnumerable<long?> source) {
        NotNull(source, "source");
        long total = 0;
        long count = 0;
        foreach (long? item in source) { if (item.HasValue) { total = checked(total + item.Value); count = count + 1; } }
        if (count == 0) { return null; }
        return (double)((double)total / count);
    }

    /// The least and greatest of the values there are, nulls skipped; null when there are none.
    public static long? Min(this IEnumerable<long?> source) {
        NotNull(source, "source");
        long? best = null;
        foreach (long? item in source) { if (item.HasValue && (!best.HasValue || item.Value < best.Value)) { best = item; } }
        return best;
    }

    public static long? Max(this IEnumerable<long?> source) {
        NotNull(source, "source");
        long? best = null;
        foreach (long? item in source) { if (item.HasValue && (!best.HasValue || item.Value > best.Value)) { best = item; } }
        return best;
    }

    /// The values there are, added: nulls are skipped, and none at all is 0 -- never null, as .NET's.
    public static float? Sum(this IEnumerable<float?> source) {
        NotNull(source, "source");
        double total = 0;
        foreach (float? item in source) { if (item.HasValue) { total = total + item.Value; } }
        return (float)total;
    }

    public static float? Sum<T>(this IEnumerable<T> source, Func<T, float?> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        double total = 0;
        foreach (T item in source) { float? value = selector(item); if (value.HasValue) { total = total + value.Value; } }
        return (float)total;
    }

    /// The mean of the values there are, nulls skipped; null when there are none.
    public static float? Average(this IEnumerable<float?> source) {
        NotNull(source, "source");
        double total = 0;
        long count = 0;
        foreach (float? item in source) { if (item.HasValue) { total = total + item.Value; count = count + 1; } }
        if (count == 0) { return null; }
        return (float)((double)total / count);
    }

    /// The least and greatest of the values there are, nulls skipped; null when there are none.
    public static float? Min(this IEnumerable<float?> source) {
        NotNull(source, "source");
        float? best = null;
        foreach (float? item in source) { if (item.HasValue && (!best.HasValue || item.Value < best.Value || float.IsNaN(item.Value))) { best = item; } }
        return best;
    }

    public static float? Max(this IEnumerable<float?> source) {
        NotNull(source, "source");
        float? best = null;
        foreach (float? item in source) { if (item.HasValue && (!best.HasValue || item.Value > best.Value || float.IsNaN(best.Value))) { best = item; } }
        return best;
    }

    /// The values there are, added: nulls are skipped, and none at all is 0 -- never null, as .NET's.
    public static double? Sum(this IEnumerable<double?> source) {
        NotNull(source, "source");
        double total = 0;
        foreach (double? item in source) { if (item.HasValue) { total = total + item.Value; } }
        return total;
    }

    public static double? Sum<T>(this IEnumerable<T> source, Func<T, double?> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        double total = 0;
        foreach (T item in source) { double? value = selector(item); if (value.HasValue) { total = total + value.Value; } }
        return total;
    }

    /// The mean of the values there are, nulls skipped; null when there are none.
    public static double? Average(this IEnumerable<double?> source) {
        NotNull(source, "source");
        double total = 0;
        long count = 0;
        foreach (double? item in source) { if (item.HasValue) { total = total + item.Value; count = count + 1; } }
        if (count == 0) { return null; }
        return (double)((double)total / count);
    }

    /// The least and greatest of the values there are, nulls skipped; null when there are none.
    public static double? Min(this IEnumerable<double?> source) {
        NotNull(source, "source");
        double? best = null;
        foreach (double? item in source) { if (item.HasValue && (!best.HasValue || item.Value < best.Value || double.IsNaN(item.Value))) { best = item; } }
        return best;
    }

    public static double? Max(this IEnumerable<double?> source) {
        NotNull(source, "source");
        double? best = null;
        foreach (double? item in source) { if (item.HasValue && (!best.HasValue || item.Value > best.Value || double.IsNaN(best.Value))) { best = item; } }
        return best;
    }

    public static double Average(this IEnumerable<int> source) {
        NotNull(source, "source");
        long total = 0;
        long count = 0;
        foreach (int item in source) { total = checked(total + item); count = count + 1; }
        if (count == 0) { throw NoElements(); }
        return (double)total / count;
    }

    public static double Average(this IEnumerable<long> source) {
        NotNull(source, "source");
        long total = 0;
        long count = 0;
        foreach (long item in source) { total = checked(total + item); count = count + 1; }
        if (count == 0) { throw NoElements(); }
        return (double)total / count;
    }

    public static float Average(this IEnumerable<float> source) {
        NotNull(source, "source");
        double total = 0;
        long count = 0;
        foreach (float item in source) { total = total + item; count = count + 1; }
        if (count == 0) { throw NoElements(); }
        return (float)(total / count);
    }

    public static double Average(this IEnumerable<double> source) {
        NotNull(source, "source");
        double total = 0;
        long count = 0;
        foreach (double item in source) { total = total + item; count = count + 1; }
        if (count == 0) { throw NoElements(); }
        return total / count;
    }

    public static double Average<T>(this IEnumerable<T> source, Func<T, int> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return Average(Select(source, selector));
    }

    public static double Average<T>(this IEnumerable<T> source, Func<T, long> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return Average(Select(source, selector));
    }

    public static float Average<T>(this IEnumerable<T> source, Func<T, float> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return Average(Select(source, selector));
    }

    public static double Average<T>(this IEnumerable<T> source, Func<T, double> selector) {
        NotNull(source, "source"); NotNull(selector, "selector");
        return Average(Select(source, selector));
    }

    public static int Min(this IEnumerable<int> source) {
        NotNull(source, "source");
        using (IEnumerator<int> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            int least = walk.Current;
            while (walk.MoveNext()) { if (walk.Current < least) { least = walk.Current; } }
            return least;
        }
    }

    public static long Min(this IEnumerable<long> source) {
        NotNull(source, "source");
        using (IEnumerator<long> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            long least = walk.Current;
            while (walk.MoveNext()) { if (walk.Current < least) { least = walk.Current; } }
            return least;
        }
    }

    /// NaN is less than every number, as .NET's Min takes it: a NaN anywhere
    /// is the answer.
    public static double Min(this IEnumerable<double> source) {
        NotNull(source, "source");
        using (IEnumerator<double> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            double least = walk.Current;
            if (double.IsNaN(least)) { return least; }
            while (walk.MoveNext()) {
                double item = walk.Current;
                if (double.IsNaN(item)) { return item; }
                if (item < least) { least = item; }
            }
            return least;
        }
    }

    public static int Max(this IEnumerable<int> source) {
        NotNull(source, "source");
        using (IEnumerator<int> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            int most = walk.Current;
            while (walk.MoveNext()) { if (walk.Current > most) { most = walk.Current; } }
            return most;
        }
    }

    public static long Max(this IEnumerable<long> source) {
        NotNull(source, "source");
        using (IEnumerator<long> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            long most = walk.Current;
            while (walk.MoveNext()) { if (walk.Current > most) { most = walk.Current; } }
            return most;
        }
    }

    /// NaN is less than every number, as .NET's Max takes it: one only if
    /// every element is NaN.
    public static double Max(this IEnumerable<double> source) {
        NotNull(source, "source");
        using (IEnumerator<double> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) { throw NoElements(); }
            double most = walk.Current;
            while (double.IsNaN(most)) {
                if (!walk.MoveNext()) { return most; }
                most = walk.Current;
            }
            while (walk.MoveNext()) { if (walk.Current > most) { most = walk.Current; } }
            return most;
        }
    }

    public static int Min<T>(this IEnumerable<T> source, Func<T, int> selector) { NotNull(selector, "selector"); return Min(Select(source, selector)); }
    public static long Min<T>(this IEnumerable<T> source, Func<T, long> selector) { NotNull(selector, "selector"); return Min(Select(source, selector)); }
    public static double Min<T>(this IEnumerable<T> source, Func<T, double> selector) { NotNull(selector, "selector"); return Min(Select(source, selector)); }
    public static int Max<T>(this IEnumerable<T> source, Func<T, int> selector) { NotNull(selector, "selector"); return Max(Select(source, selector)); }
    public static long Max<T>(this IEnumerable<T> source, Func<T, long> selector) { NotNull(selector, "selector"); return Max(Select(source, selector)); }
    public static double Max<T>(this IEnumerable<T> source, Func<T, double> selector) { NotNull(selector, "selector"); return Max(Select(source, selector)); }

    /// By the elements' own order. A null is no candidate, and a sequence of
    /// nothing but nulls answers null, as .NET's generic Min does; an empty
    /// one throws only when null is no answer the type has.
    public static T? Min<T>(this IEnumerable<T> source) { return Min(source, (IComparer<T>?)null); }

    public static T? Min<T>(this IEnumerable<T> source, IComparer<T>? comparer) {
        NotNull(source, "source");
        IComparer<T> by = comparer ?? Comparer<T>.Default;
        bool found = false;
        T least = default(T)!;
        foreach (T item in source) {
            if (item == null) { continue; }
            if (!found || by.Compare(item, least) < 0) { least = item; found = true; }
        }
        if (!found && default(T) != null) { throw NoElements(); }
        return least;
    }

    public static T? Max<T>(this IEnumerable<T> source) { return Max(source, (IComparer<T>?)null); }

    public static T? Max<T>(this IEnumerable<T> source, IComparer<T>? comparer) {
        NotNull(source, "source");
        IComparer<T> by = comparer ?? Comparer<T>.Default;
        bool found = false;
        T most = default(T)!;
        foreach (T item in source) {
            if (item == null) { continue; }
            if (!found || by.Compare(item, most) > 0) { most = item; found = true; }
        }
        if (!found && default(T) != null) { throw NoElements(); }
        return most;
    }

    public static R? Min<T, R>(this IEnumerable<T> source, Func<T, R> selector) { NotNull(selector, "selector"); return Min(Select(source, selector)); }
    public static R? Max<T, R>(this IEnumerable<T> source, Func<T, R> selector) { NotNull(selector, "selector"); return Max(Select(source, selector)); }

    public static T? MinBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return MinBy(source, keySelector, null); }

    public static T? MinBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        IComparer<K> by = comparer ?? Comparer<K>.Default;
        using (IEnumerator<T> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) {
                if (default(T) == null) { return default(T); }
                throw NoElements();
            }
            T best = walk.Current;
            K bestKey = keySelector(best);
            while (walk.MoveNext()) {
                K key = keySelector(walk.Current);
                if (by.Compare(key, bestKey) < 0) { best = walk.Current; bestKey = key; }
            }
            return best;
        }
    }

    public static T? MaxBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector) { return MaxBy(source, keySelector, null); }

    public static T? MaxBy<T, K>(this IEnumerable<T> source, Func<T, K> keySelector, IComparer<K>? comparer) {
        NotNull(source, "source"); NotNull(keySelector, "keySelector");
        IComparer<K> by = comparer ?? Comparer<K>.Default;
        using (IEnumerator<T> walk = source.GetEnumerator()) {
            if (!walk.MoveNext()) {
                if (default(T) == null) { return default(T); }
                throw NoElements();
            }
            T best = walk.Current;
            K bestKey = keySelector(best);
            while (walk.MoveNext()) {
                K key = keySelector(walk.Current);
                if (by.Compare(key, bestKey) > 0) { best = walk.Current; bestKey = key; }
            }
            return best;
        }
    }
}


/// A 128-BIT UNSIGNED INTEGER, .NET's System.UInt128: two 64-bit halves,
/// every operator C# gives the built-in integers, wrapping modulo 2^128, and
/// a shift count taken modulo 128 as .NET takes it.
readonly struct UInt128 : IComparable<UInt128>, IEquatable<UInt128> {
    readonly ulong _upper;
    readonly ulong _lower;

    public UInt128(ulong upper, ulong lower) { _upper = upper; _lower = lower; }

    public static UInt128 Zero => new UInt128(0, 0);
    public static UInt128 One => new UInt128(0, 1);
    public static UInt128 MinValue => new UInt128(0, 0);
    public static UInt128 MaxValue => new UInt128(ulong.MaxValue, ulong.MaxValue);

    internal ulong Upper => _upper;
    internal ulong Lower => _lower;

    // ---- conversions ------------------------------------------------------

    public static implicit operator UInt128(byte value) { return new UInt128(0, value); }
    public static implicit operator UInt128(char value) { return new UInt128(0, value); }
    public static implicit operator UInt128(ushort value) { return new UInt128(0, value); }
    public static implicit operator UInt128(uint value) { return new UInt128(0, value); }
    public static implicit operator UInt128(ulong value) { return new UInt128(0, value); }

    /// A signed value as its two's complement, sign bits and all, as .NET
    /// converts one unchecked.
    public static explicit operator UInt128(int value) { long wide = value; return new UInt128(wide < 0 ? ulong.MaxValue : 0, (ulong)wide); }
    public static explicit operator UInt128(long value) { return new UInt128(value < 0 ? ulong.MaxValue : 0, (ulong)value); }

    public static explicit operator ulong(UInt128 value) { return value._lower; }
    public static explicit operator long(UInt128 value) { return (long)value._lower; }
    public static explicit operator uint(UInt128 value) { return (uint)value._lower; }
    public static explicit operator int(UInt128 value) { return (int)value._lower; }
    public static explicit operator double(UInt128 value) { return (double)value._upper * 18446744073709551616.0 + (double)value._lower; }

    // ---- arithmetic -------------------------------------------------------

    public static UInt128 operator +(UInt128 left, UInt128 right) {
        ulong lower = left._lower + right._lower;
        ulong carry = lower < left._lower ? 1UL : 0UL;
        return new UInt128(left._upper + right._upper + carry, lower);
    }

    public static UInt128 operator -(UInt128 left, UInt128 right) {
        ulong lower = left._lower - right._lower;
        ulong borrow = left._lower < right._lower ? 1UL : 0UL;
        return new UInt128(left._upper - right._upper - borrow, lower);
    }

    public static UInt128 operator *(UInt128 left, UInt128 right) {
        ulong low;
        ulong high = BigMul(left._lower, right._lower, out low);
        high = high + left._upper * right._lower + left._lower * right._upper;
        return new UInt128(high, low);
    }

    public static UInt128 operator /(UInt128 left, UInt128 right) {
        UInt128 quotient;
        UInt128 remainder;
        DivRem(left, right, out quotient, out remainder);
        return quotient;
    }

    public static UInt128 operator %(UInt128 left, UInt128 right) {
        UInt128 quotient;
        UInt128 remainder;
        DivRem(left, right, out quotient, out remainder);
        return remainder;
    }

    public static UInt128 operator ++(UInt128 value) { return value + One; }
    public static UInt128 operator --(UInt128 value) { return value - One; }
    public static UInt128 operator +(UInt128 value) { return value; }
    public static UInt128 operator -(UInt128 value) { return Zero - value; }

    public static UInt128 operator &(UInt128 left, UInt128 right) { return new UInt128(left._upper & right._upper, left._lower & right._lower); }
    public static UInt128 operator |(UInt128 left, UInt128 right) { return new UInt128(left._upper | right._upper, left._lower | right._lower); }
    public static UInt128 operator ^(UInt128 left, UInt128 right) { return new UInt128(left._upper ^ right._upper, left._lower ^ right._lower); }
    public static UInt128 operator ~(UInt128 value) { return new UInt128(~value._upper, ~value._lower); }

    public static UInt128 operator <<(UInt128 value, int shiftAmount) {
        int shift = shiftAmount & 127;
        if (shift == 0) { return value; }
        if (shift >= 64) { return new UInt128(value._lower << (shift - 64), 0); }
        return new UInt128((value._upper << shift) | (value._lower >> (64 - shift)), value._lower << shift);
    }

    public static UInt128 operator >>(UInt128 value, int shiftAmount) {
        int shift = shiftAmount & 127;
        if (shift == 0) { return value; }
        if (shift >= 64) { return new UInt128(0, value._upper >> (shift - 64)); }
        return new UInt128(value._upper >> shift, (value._lower >> shift) | (value._upper << (64 - shift)));
    }

    public static UInt128 operator >>>(UInt128 value, int shiftAmount) { return value >> shiftAmount; }

    // ---- comparison -------------------------------------------------------

    public static bool operator ==(UInt128 left, UInt128 right) { return left._upper == right._upper && left._lower == right._lower; }
    public static bool operator !=(UInt128 left, UInt128 right) { return !(left == right); }
    public static bool operator <(UInt128 left, UInt128 right) { return left._upper < right._upper || left._upper == right._upper && left._lower < right._lower; }
    public static bool operator >(UInt128 left, UInt128 right) { return right < left; }
    public static bool operator <=(UInt128 left, UInt128 right) { return !(right < left); }
    public static bool operator >=(UInt128 left, UInt128 right) { return !(left < right); }

    public int CompareTo(UInt128 value) { return this < value ? -1 : this > value ? 1 : 0; }
    public int CompareTo(object? value) {
        if (value == null) { return 1; }
        if (value is UInt128 other) { return CompareTo(other); }
        throw new ArgumentException("Object must be of type UInt128.");
    }
    public bool Equals(UInt128 other) { return this == other; }
    public override bool Equals(object? obj) { return obj is UInt128 other && this == other; }
    public override int GetHashCode() { return HashCode.Combine(_lower, _upper); }

    public static UInt128 Max(UInt128 x, UInt128 y) { return x < y ? y : x; }
    public static UInt128 Min(UInt128 x, UInt128 y) { return x < y ? x : y; }

    public static int LeadingZeroCount(UInt128 value) {
        if (value._upper != 0) { return Zeros(value._upper); }
        return 64 + Zeros(value._lower);
    }

    static int Zeros(ulong value) {
        if (value == 0) { return 64; }
        int count = 0;
        while ((value & 0x8000000000000000UL) == 0) { value = value << 1; count++; }
        return count;
    }

    /// The whole of a 64-by-64-bit product: the high half answered, the low
    /// half out, from 32-bit pieces so no step overflows.
    static ulong BigMul(ulong a, ulong b, out ulong low) {
        ulong aLow = a & 0xFFFFFFFFUL, aHigh = a >> 32;
        ulong bLow = b & 0xFFFFFFFFUL, bHigh = b >> 32;
        ulong ll = aLow * bLow;
        ulong lh = aLow * bHigh;
        ulong hl = aHigh * bLow;
        ulong hh = aHigh * bHigh;
        ulong middle = (ll >> 32) + (lh & 0xFFFFFFFFUL) + (hl & 0xFFFFFFFFUL);
        low = (middle << 32) | (ll & 0xFFFFFFFFUL);
        return hh + (lh >> 32) + (hl >> 32) + (middle >> 32);
    }

    /// Quotient and remainder, a bit at a time from the top: the divisor
    /// shifted under the dividend and subtracted wherever it fits.
    public static (UInt128 Quotient, UInt128 Remainder) DivRem(UInt128 left, UInt128 right) {
        UInt128 quotient;
        UInt128 remainder;
        DivRem(left, right, out quotient, out remainder);
        return (quotient, remainder);
    }

    static void DivRem(UInt128 left, UInt128 right, out UInt128 quotient, out UInt128 remainder) {
        if (right._upper == 0 && right._lower == 0) { throw new DivideByZeroException(); }
        if (left._upper == 0 && right._upper == 0) {
            quotient = new UInt128(0, left._lower / right._lower);
            remainder = new UInt128(0, left._lower % right._lower);
            return;
        }
        if (left < right) {
            quotient = Zero;
            remainder = left;
            return;
        }
        int shift = LeadingZeroCount(right) - LeadingZeroCount(left);
        UInt128 divisor = right << shift;
        UInt128 rest = left;
        UInt128 made = Zero;
        for (int i = 0; i <= shift; i++) {
            made = made << 1;
            if (rest >= divisor) {
                rest = rest - divisor;
                made = made | One;
            }
            divisor = divisor >> 1;
        }
        quotient = made;
        remainder = rest;
    }

    /// Decimal digits, nineteen at a time: 10^19 is the largest power of ten
    /// a ulong holds.
    public override string ToString() {
        if (_upper == 0) { return _lower.ToString(); }
        UInt128 chunk = new UInt128(0, 10000000000000000000UL);
        UInt128 rest = this;
        string text = "";
        while (rest._upper != 0) {
            UInt128 quotient;
            UInt128 remainder;
            DivRem(rest, chunk, out quotient, out remainder);
            text = remainder._lower.ToString().PadLeft(19, '0') + text;
            rest = quotient;
        }
        return rest._lower.ToString() + text;
    }
}

/// A POSITION IN A SEQUENCE, counted from its start or from its end: `3`,
/// `^1`. What C#'s `^` makes, and what an index of a countable type may be.
/// Held as .NET holds it: one int, complemented when counted from the end.
readonly struct Index : IEquatable<Index> {
    readonly int _value;

    public Index(int value, bool fromEnd = false) {
        if (value < 0) { throw new ArgumentOutOfRangeException("value", "Non-negative number required."); }
        _value = fromEnd ? ~value : value;
    }

    public static Index Start => new Index(0);
    public static Index End => new Index(0, true);

    public static Index FromStart(int value) { return new Index(value); }
    public static Index FromEnd(int value) { return new Index(value, true); }

    public int Value => _value < 0 ? ~_value : _value;
    public bool IsFromEnd => _value < 0;

    /// Where this is in a sequence of that length, counted from its start.
    public int GetOffset(int length) {
        int offset = _value;
        if (IsFromEnd) { offset += length + 1; }
        return offset;
    }

    public override bool Equals(object? value) { return value is Index other && _value == other._value; }
    public bool Equals(Index other) { return _value == other._value; }
    public override int GetHashCode() { return _value; }

    public static implicit operator Index(int value) { return FromStart(value); }

    public override string ToString() { return IsFromEnd ? "^" + Value.ToString() : Value.ToString(); }
}

/// A SLICE OF A SEQUENCE: where it starts and where it stops, each an Index.
/// What C#'s `..` makes.
readonly struct Range : IEquatable<Range> {
    public Index Start { get; }
    public Index End { get; }

    public Range(Index start, Index end) { Start = start; End = end; }

    public static Range StartAt(Index start) { return new Range(start, Index.End); }
    public static Range EndAt(Index end) { return new Range(Index.Start, end); }
    public static Range All => new Range(Index.Start, Index.End);

    /// Where the slice starts and how long it is, in a sequence of that length.
    public (int Offset, int Length) GetOffsetAndLength(int length) {
        int start = Start.GetOffset(length);
        int end = End.GetOffset(length);
        if ((uint)end > (uint)length || (uint)start > (uint)end) {
            throw new ArgumentOutOfRangeException("length");
        }
        return (start, end - start);
    }

    public override bool Equals(object? value) { return value is Range other && Start.Equals(other.Start) && End.Equals(other.End); }
    public bool Equals(Range other) { return Start.Equals(other.Start) && End.Equals(other.End); }
    public override int GetHashCode() { return HashCode.Combine(Start.GetHashCode(), End.GetHashCode()); }

    public override string ToString() { return Start.ToString() + ".." + End.ToString(); }
}

/// WHAT `a[1..4]` COMPILES TO, under the name the C# compiler uses for it.
///
/// A range applied to an array COPIES, unlike the same syntax on a span, and
/// code that slices an image header depends on the copy being independent of
/// the bytes it came from. The two-number form is what the compiler calls for
/// a range written in the brackets, where the numbers are at hand.
static class RuntimeHelpers {
    public static T[] GetSubArray<T>(T[] array, Range range) {
        (int offset, int length) = range.GetOffsetAndLength(array.Length);
        return GetSubArray(array, offset, length);
    }

    public static T[] GetSubArray<T>(T[] source, int start, int length) {
        if (start < 0 || length < 0 || start + length > source.Length) {
            throw new ArgumentOutOfRangeException("length");
        }

        T[] made = new T[length];

        for (int i = 0; i < length; i++) { made[i] = source[start + i]; }
        return made;
    }
}

/// THE ARRAY HELPERS, as .NET spells them.
static class Array {
    /// An array of no elements. .NET returns a shared singleton; this one
    /// allocates, because there is nowhere to cache it per type yet and a
    /// zero-length array costs one word.
    public static T[] Empty<T>() { return EmptyArray<T>.Value; }

    /// A SHALLOW COPY, which is what .NET's Array.Clone answers: a new array
    /// with the same elements, and elements that are references still pointing
    /// at the same things.
    ///
    /// .NET declares it on System.Array and returns object, so every caller
    /// casts; here it is an extension over the array itself, typed, because a
    /// cast back from object would be the only difference and there is nothing
    /// for it to protect against.
    public static T[] Clone<T>(this T[] items) {
        T[] made = new T[items.Length];

        for (int i = 0; i < items.Length; i++) { made[i] = items[i]; }
        return made;
    }

    public static int IndexOf<T>(T[] items, T value) {
        return IndexOf(items, value, 0, items.Length);
    }

    /// From `startIndex` to the end.
    public static int IndexOf<T>(T[] items, T value, int startIndex) {
        if (items == null) throw new ArgumentNullException("array");
        if (startIndex < 0 || startIndex > items.Length) throw new ArgumentOutOfRangeException("startIndex");
        return IndexOf(items, value, startIndex, items.Length - startIndex);
    }

    /// The first of `count` elements from `startIndex` that equals `value`,
    /// or -1: .NET's range rules, the start anywhere up to the end and the
    /// range inside the array.
    public static int IndexOf<T>(T[] items, T value, int startIndex, int count) {
        if (items == null) throw new ArgumentNullException("array");
        if (startIndex < 0 || startIndex > items.Length) throw new ArgumentOutOfRangeException("startIndex");
        if (count < 0 || count > items.Length - startIndex) throw new ArgumentOutOfRangeException("count");
        for (int i = startIndex; i < startIndex + count; i++) {
            if (Same(items[i], value)) { return i; }
        }
        return -1;
    }

    /// Element equality as IndexOf and LastIndexOf use it: an object's
    /// Equals, a value's bits.
    static bool Same<T>(T a, T b) {
        return Sys.IsObject(a) ? Sys.KeyEquals(a, b) : Sys.EqualValues(a, b);
    }

    public static bool Contains<T>(this T[] items, T value) {
        return IndexOf(items, value) >= 0;
    }

    /// Replace every element with one value. This overload is the primitive
    /// array form used by the compiler's ISA tables; wider and reference-array
    /// overloads can use the same loop as their source reaches self-hosting.
    public static void Fill(byte[] items, byte value) {
        int i = 0;
        while (i < items.Length) {
            items[i] = value;
            i = i + 1;
        }
    }

    public static void CopyTo<T>(this T[] items, T[] into) {
        for (int i = 0; i < items.Length; i++) { into[i] = items[i]; }
    }

    public static void CopyTo<T>(this T[] items, T[] into, int at) {
        for (int i = 0; i < items.Length; i++) { into[at + i] = items[i]; }
    }

    public static void CopyTo<T>(this T[] items, Span<T> into) {
        for (int i = 0; i < items.Length; i++) { into[i] = items[i]; }
    }

    // .NET's MemoryExtensions.AsMemory: an array's window as a Memory.
    public static Memory<T> AsMemory<T>(this T[]? items) { return new Memory<T>(items); }

    public static Memory<T> AsMemory<T>(this T[]? items, int start) {
        return new Memory<T>(items, start, (items == null ? 0 : items.Length) - start);
    }

    public static Memory<T> AsMemory<T>(this T[]? items, int start, int length) {
        return new Memory<T>(items, start, length);
    }

    // .NET's MemoryExtensions.AsSpan, which is how an array is handed to
    // something that takes a span without the conversion being implicit.
    public static Span<T> AsSpan<T>(this T[] items) { return new Span<T>(items); }

    public static Span<T> AsSpan<T>(this T[] items, int start) {
        return new Span<T>(items, start, items.Length - start);
    }

    public static Span<T> AsSpan<T>(this T[] items, int start, int length) {
        return new Span<T>(items, start, length);
    }

    public static int LastIndexOf<T>(T[] items, T value) {
        if (items == null) throw new ArgumentNullException("array");
        return LastIndexOf(items, value, items.Length - 1, items.Length);
    }

    /// Backwards from `startIndex` to the beginning.
    public static int LastIndexOf<T>(T[] items, T value, int startIndex) {
        if (items == null) throw new ArgumentNullException("array");
        return LastIndexOf(items, value, startIndex, items.Length == 0 ? 0 : startIndex + 1);
    }

    /// The last of `count` elements ending at `startIndex` that equals
    /// `value`, or -1. .NET's rules: an empty array takes a start of -1 or
    /// 0 and a count of 0; otherwise the start is an element and the range
    /// does not run off the front.
    public static int LastIndexOf<T>(T[] items, T value, int startIndex, int count) {
        if (items == null) throw new ArgumentNullException("array");
        if (items.Length == 0) {
            if (startIndex != -1 && startIndex != 0) throw new ArgumentOutOfRangeException("startIndex");
            if (count != 0) throw new ArgumentOutOfRangeException("count");
            return -1;
        }
        if (startIndex < 0 || startIndex >= items.Length) throw new ArgumentOutOfRangeException("startIndex");
        if (count < 0 || startIndex - count + 1 < 0) throw new ArgumentOutOfRangeException("count");
        for (int i = startIndex; i > startIndex - count; i--) {
            if (Same(items[i], value)) { return i; }
        }
        return -1;
    }

    public static void Sort<T>(T[] items) {
        Sorting.Introspective<T>(items, 0, items.Length, Comparer<T>.Default);
    }

    public static void Sort<T>(T[] items, IComparer<T> by) {
        Sorting.Introspective<T>(items, 0, items.Length, by);
    }

    public static void Sort<T>(T[] items, Comparison<T> by) {
        Sorting.Introspective<T>(items, 0, items.Length, new ComparisonComparer<T>(by));
    }

    public static void Sort<T>(T[] items, int index, int howMany, IComparer<T> by) {
        Sorting.Introspective<T>(items, index, howMany, by);
    }

    public static void Reverse<T>(T[] items) { Reverse(items, 0, items.Length); }

    public static void Reverse<T>(T[] items, int index, int howMany) {
        int left = index;
        int right = index + howMany - 1;

        while (left < right) {
            T held = items[left];
            items[left] = items[right];
            items[right] = held;
            left = left + 1;
            right = right - 1;
        }
    }

    /// .NET's Array.Copy, which is allowed to overlap -- so the direction is
    /// chosen from which way the block is moving rather than always forwards.
    public static void Copy<T>(T[] from, int fromAt, T[] into, int intoAt, int howMany) {
        if (intoAt > fromAt) {
            for (int i = howMany - 1; i >= 0; i--) { into[intoAt + i] = from[fromAt + i]; }
            return;
        }
        for (int i = 0; i < howMany; i++) { into[intoAt + i] = from[fromAt + i]; }
    }

    public static void Copy<T>(T[] from, T[] into, int howMany) {
        Copy(from, 0, into, 0, howMany);
    }

    /// The 64-bit forms .NET has beside them: the same copy, positions and
    /// length as longs, each of which has to be a position an array has.
    public static void Copy<T>(T[] from, long fromAt, T[] into, long intoAt, long howMany) {
        if (fromAt < 0 || fromAt > int.MaxValue) { throw new ArgumentOutOfRangeException("sourceIndex", "Arrays larger than 2GB are not supported."); }
        if (intoAt < 0 || intoAt > int.MaxValue) { throw new ArgumentOutOfRangeException("destinationIndex", "Arrays larger than 2GB are not supported."); }
        if (howMany < 0 || howMany > int.MaxValue) { throw new ArgumentOutOfRangeException("length", "Arrays larger than 2GB are not supported."); }
        Copy(from, (int)fromAt, into, (int)intoAt, (int)howMany);
    }

    public static void Copy<T>(T[] from, T[] into, long howMany) {
        Copy(from, 0L, into, 0L, howMany);
    }

    /// A LONGER OR SHORTER COPY. .NET spells this `Array.Resize(ref items, n)`
    /// and assigns the new array to the caller's variable; a by-reference
    /// argument of type `T[]` cannot yet be passed an `int[]` here -- "a
    /// by-reference argument must match exactly" -- so this hands the array
    /// back instead and the caller assigns it. See
    /// build/repro-std-array-resize.cor.
    public static T[] Resized<T>(T[] items, int size) {
        T[] made = new T[size];
        int keep = items.Length < size ? items.Length : size;

        for (int i = 0; i < keep; i++) { made[i] = items[i]; }
        return made;
    }

    public static void Fill<T>(T[] items, T value) {
        for (int i = 0; i < items.Length; i++) { items[i] = value; }
    }

    public static void Fill<T>(T[] items, T value, int start, int howMany) {
        for (int i = 0; i < howMany; i++) { items[start + i] = value; }
    }

    /// Back to default(T), which is what .NET's Clear means: zero, false or
    /// null according to what the element is.
    public static void Clear<T>(T[] items) { Fill(items, default(T)!); }

    public static void Clear<T>(T[] items, int start, int howMany) {
        Fill(items, default(T)!, start, howMany);
    }

    // ---- searching by a test rather than by a value -----------------------
    //
    // The pattern-matching half of System.Array, which is older than LINQ and
    // still what a program with an array rather than a list reaches for. Each
    // takes a Predicate, which is .NET's name for a function to bool.

    public static bool Exists<T>(T[] items, Predicate<T> match) {
        return FindIndex(items, match) >= 0;
    }

    /// THE FIRST MATCH, or default(T) -- not an exception, which is the
    /// difference from LINQ's First and the reason this one needs no
    /// companion named FindOrDefault.
    public static T? Find<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public static T? FindLast<T>(T[] items, Predicate<T> match) {
        for (int i = items.Length - 1; i >= 0; i--) {
            if (match(items[i])) { return items[i]; }
        }
        return default(T);
    }

    public static int FindIndex<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public static int FindLastIndex<T>(T[] items, Predicate<T> match) {
        for (int i = items.Length - 1; i >= 0; i--) {
            if (match(items[i])) { return i; }
        }
        return -1;
    }

    public static T[] FindAll<T>(T[] items, Predicate<T> match) {
        List<T> kept = new List<T>();

        for (int i = 0; i < items.Length; i++) {
            if (match(items[i])) { kept.Add(items[i]); }
        }
        return kept.ToArray();
    }

    public static bool TrueForAll<T>(T[] items, Predicate<T> match) {
        for (int i = 0; i < items.Length; i++) {
            if (!match(items[i])) { return false; }
        }
        return true;
    }

    /// EVERY ELEMENT THROUGH A FUNCTION, into an array of the answers -- Select
    /// without the sequence, for code that has an array and wants one back.
    public static R[] ConvertAll<T, R>(T[] items, Func<T, R> convert) {
        R[] made = new R[items.Length];

        for (int i = 0; i < items.Length; i++) { made[i] = convert(items[i]); }
        return made;
    }

    /// A LONGER OR SHORTER ARRAY IN PLACE OF THE ONE PASSED, which is why the
    /// parameter is `ref`: an array cannot change its own length, so what
    /// really happens is a new one and an assignment over the caller's
    /// variable. .NET's signature says so and this one says the same.
    public static void Resize<T>(ref T[]? items, int size) {
        if (size < 0) { throw new ArgumentOutOfRangeException("newSize"); }
        // NO ARRAY YET is an empty one, as .NET has it: one of the size asked.
        if (items is null) { items = new T[size]; return; }
        T[] made = new T[size];
        int count = items.Length < size ? items.Length : size;

        for (int i = 0; i < count; i++) { made[i] = items[i]; }
        items = made;
    }

    public static int BinarySearch<T>(T[] items, T value, IComparer<T> by) {
        int low = 0;
        int high = items.Length - 1;

        while (low <= high) {
            int middle = low + (high - low) / 2;
            int sign = by.Compare(items[middle], value);

            if (sign == 0) { return middle; }
            if (sign < 0) {
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        return ~low;
    }

    public static int BinarySearch<T>(T[] items, T value) {
        return BinarySearch(items, value, Comparer<T>.Default);
    }
}

/// A HASH BUILT FROM SEVERAL VALUES, spelt as .NET spells it since Core 2.1.
///
/// The mixing is FNV-1a's: a large odd multiplier and an exclusive-or per
/// value. It is not a cryptographic hash and does not claim to be -- what it
/// has to do is scatter, so that two objects differing in one field land in
/// different buckets, and a multiply-xor does that for a few pence.
///
/// The overloads take `object` because that is what C#'s take (generically),
/// and every value here is a machine word: an int, a reference, a bool. The
/// value IS the input.
/// .NET's HashCode: the static Combine, and a value that is added to a part
/// at a time and asked for ToHashCode at the end.
struct HashCode {
    private long _hash;
    private int _parts;

    public void Add<T>(T value) {
        long part = Sys.IsObject(value) ? Sys.KeyHash(value) : Sys.HashValue(value);
        _hash = Mix(_parts == 0 ? Seed : _hash, part);
        _parts = _parts + 1;
    }

    public void Add<T>(T value, IEqualityComparer<T>? comparer) {
        if (comparer == null) { Add(value); return; }
        _hash = Mix(_parts == 0 ? Seed : _hash, comparer.GetHashCode(value));
        _parts = _parts + 1;
    }

    /// .NET's AddBytes: every byte of the span mixed in, in order.
    public void AddBytes(ReadOnlySpan<byte> value) {
        long h = _parts == 0 ? Seed : _hash;
        for (int i = 0; i < value.Length; i++) { h = Mix(h, value[i]); }
        _hash = h;
        _parts = _parts + 1;
    }

    public int ToHashCode() {
        long h = _parts == 0 ? Seed : _hash;
        return (int)(h ^ (h >> 32));
    }

    private const long Prime = 1099511628211;
    private const long Seed = -3750763034362895579;

    // WHAT THE VALUE IS, not where it is: a number handed over as an object is
    // in a box, and the box's address is different every time it is made.
    private static long Part(object value) {
        if (Sys.IsObject(value)) { return Sys.KeyHash(value); }
        return Sys.HashValue(value);
    }

    private static long Mix(long hash, long value) {
        return (hash ^ value) * Prime;
    }

    public static int Combine(object a, object b) {
        long h = Mix(Mix(Seed, Part(a)), Part(b));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c) {
        long h = Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c, object d) {
        long h = Mix(Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c)), Part(d));
        return (int)(h ^ (h >> 32));
    }

    public static int Combine(object a, object b, object c, object d, object e) {
        long h = Mix(Mix(Mix(Mix(Mix(Seed, Part(a)), Part(b)), Part(c)),
                         Part(d)), Part(e));
        return (int)(h ^ (h >> 32));
    }
}

// HOW A TABLE DECIDES TWO KEYS ARE THE SAME: a hash and an equality that agree,
// which is .NET's IEqualityComparer<T> and is the same interface here.
//
// It matters most for strings. Hashing the machine word hashes a string's
// ADDRESS, so two strings with the same characters are two keys unless they are
// the same interned literal -- and a key that was computed, read or built is
// never that. StringComparer is what a table of strings is given instead.
/// `in T`, as .NET declares it: a comparer only ever takes its values IN, so
/// an IEqualityComparer of object can compare anything at all.
interface IEqualityComparer<in T> {
    bool Equals(T a, T b);
    int GetHashCode(T value);
}

// .NET's StringComparer is a class implementing IEqualityComparer<string> with
// a static for each way of comparing, and this is the same. There is one
// culture on this machine, so the invariant pair and the ordinal pair are the
// same comparison -- the NAMES are all four, because source says them.
class StringComparer : IEqualityComparer<string>, IComparer<string> {
    private bool fold;

    public StringComparer(bool ignoreCase) { fold = ignoreCase; }

    // ONE OF EACH, as .NET has: the property answers the same comparer every
    // time. A new one each time was six hundred thousand comparers made and
    // dropped in one self-hosted compile of a single source file -- every
    // `new Dictionary<string, T>(StringComparer.Ordinal)` -- and two tables
    // built with "the same" comparer did not hold equal ones.
    private static StringComparer? exact;
    private static StringComparer? folding;

    public static StringComparer Ordinal {
        get {
            if (exact == null) { exact = new StringComparer(false); }
            return exact;
        }
    }

    public static StringComparer OrdinalIgnoreCase {
        get {
            if (folding == null) { folding = new StringComparer(true); }
            return folding;
        }
    }

    public static StringComparer InvariantCulture => Ordinal;
    public static StringComparer InvariantCultureIgnoreCase => OrdinalIgnoreCase;

    // IGNORING CASE IS COMPARING UPPER CASE, which is .NET's OrdinalIgnoreCase:
    // Equals, Compare and GetHashCode all fold the same way, or a table keyed
    // by this comparer finds a key its Equals says is there under another hash.
    // EQUALITY IS NOT ORDER: String.Equals stops at the same object, at two
    // lengths, at two known hashes that differ, where Compare read the units
    // first -- and every Dictionary<string, T>(StringComparer.Ordinal) probe
    // came here (2.3% of a native self-compile). Folding keeps the length,
    // unit for unit, so two lengths settle it before anything is made.
    public bool Equals(string? a, string? b) {
        if (a == null || b == null) { return (object?)a == (object?)b; }
        if (!fold) { return String.Equals(a, b); }
        if (a.Length != b.Length) { return false; }
        if ((object)a == (object)b) { return true; }
        return String.Compare(String.ToUpperInvariant(a), String.ToUpperInvariant(b)) == 0;
    }

    /// .NET's StringComparer is an IComparer<string> as well as an equality
    /// comparer, which is what makes `names.OrderBy(n => n, StringComparer
    /// .Ordinal)` an ordinary line.
    /// Null before every string, as .NET's comparers put it.
    public int Compare(string? a, string? b) {
        if (a == null || b == null) { return String.Compare(a, b); }
        if (fold) { return String.Compare(String.ToUpperInvariant(a), String.ToUpperInvariant(b)); }
        return String.Compare(a, b);
    }

    // FNV-1a over the code units, which is what makes a table of strings work
    // at all: the same characters hash the same wherever they came from.
    public int GetHashCode(string value) {
        if (value == null) { throw new ArgumentNullException("obj"); }
        // The folded copy is a new string whose hash is kept on it for nothing;
        // the ordinal one is the string's own, worked out once (Runtime).
        return Runtime.StringHashCode(fold ? String.ToUpperInvariant(value) : value);
    }
}

// ONE ENTRY, which is what walking a dictionary hands back -- key and value
// together, because a hash table has no other order to give them in.
struct KeyValuePair<K, V> {
    private K key;
    private V value;

    public KeyValuePair(K k, V v) {
        key = k;
        value = v;
    }

    public K Key => key;
    public V Value => value;

    /// "[key, value]", as .NET writes a pair: each part by its own ToString,
    /// an absent one as nothing.
    public override string ToString() {
        return "[" + key + ", " + value + "]";
    }

    // WHAT MAKES `foreach ((var k, var v) in table)` WORK, and it is not a
    // special case in the compiler: deconstruction is defined as a call to a
    // method called Deconstruct with an out per name, so anything with one
    // comes apart the same way. .NET's KeyValuePair has exactly this.
    public void Deconstruct(out K k, out V v) {
        k = key;
        v = value;
    }
}

// .NET spells this Dictionary<K,V>.Enumerator. It walks the table itself
// rather than copying it out, which is why it reads the private arrays: in C#
// it is written inside the class and does exactly the same thing.
// .NET's read-only view of a table, and Dictionary implements it. What it
// promises is that a caller cannot add to what it was handed.
interface IReadOnlyDictionary<K, V> : IEnumerable<KeyValuePair<K, V>> {
    int Count { get; }
    V this[K key] { get; }
    IEnumerable<K> Keys { get; }
    IEnumerable<V> Values { get; }
    bool ContainsKey(K key);
    bool TryGetValue(K key, out V value);
}

class Dictionary<K, V> : IDictionary<K, V>, IReadOnlyDictionary<K, V>, IEnumerable<KeyValuePair<K, V>>, IOwnsElements {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }


    private K[] keys;
    private V[] values;
    private int[] state;      // 0 empty, 1 used, 2 erased
    // EACH USED SLOT'S KEY'S HASH, as .NET's entries keep theirs: growing
    // places every key by it and asks no comparer, which is what lets the
    // table own its arrays -- a comparer called while the old ones were held
    // could be anything, and made every one of them the collector's.
    private int[] hashes;
    private int filled;       // used and erased together: what a probe walks past
    private int count;
    private int mask;

    // The comparer this table was given, or null for the machine word. .NET
    // spells the default EqualityComparer<T>.Default and picks it per element
    // type; a word-shaped instantiation here shares one compiled copy and
    // cannot, so a table of strings is given one -- see the task list.
    private IEqualityComparer<K>? by;

    // IN THE ORDER THINGS WENT IN, which is the order .NET's walks them in
    // while nothing has been removed, and what a program that fills a table
    // and then writes it out depends on without saying so -- this compiler's
    // own output among them. `order` lists the occupied slots oldest first,
    // with -1 where one was removed; `placeOf` is each slot's place in it.
    private int[]? order;
    private int[]? placeOf;
    private int ordered;

    // AND A REMOVED ONE'S PLACE IS THE NEXT ADDED ONE'S, most recently freed
    // first, as .NET's free list gives an entry back: add a, b, c, remove b,
    // add d, and the walk is a, d, c there and here.
    private int[]? vacant;
    private int vacancies;
    // WHETHER ITS VALUES GO WITH ITS STORAGE (OwnElements).
    private bool ownsElements;

    private void Placed(int slot) {
        if (vacancies > 0 && order != null && placeOf != null) {
            vacancies = vacancies - 1;
            int place = vacant![vacancies];
            order[place] = slot;
            placeOf[slot] = place;
            return;
        }
        // Each field read once, after Tidy has made it what it will be: a
        // local given the field twice is a join, and a join of two loads is
        // a read the owned-field rules cannot follow.
        if (order == null || placeOf == null || ordered == order.Length || placeOf.Length != mask + 1) {
            Tidy();
        }
        int[]? list = order;
        int[]? places = placeOf;

        if (list != null && places != null) {
            places[slot] = ordered;
            list[ordered] = slot;
            ordered = ordered + 1;
        }
    }

    private void Unplaced(int slot) {
        int[]? list = order;
        int[]? places = placeOf;
        if (list != null && places != null && places.Length == mask + 1) {
            int place = places[slot];
            list[place] = -1;
            if (vacant == null || vacancies == vacant.Length) {
                int[]? was = vacant;
                int[] more = new int[vacant == null ? 8 : vacant.Length * 2];
                for (int n = 0; n < vacancies; n++) { more[n] = was![n]; }
                vacant = more;
                OutgrownStorage.Release(was);
            }
            vacant[vacancies] = place;
            vacancies = vacancies + 1;
        }
    }

    // The removed ones squeezed out, and room for as many again as the table
    // can hold.
    private void Tidy() {
        int[]? old = order;
        int[]? oldPlaces = placeOf;
        int[] list = new int[(mask + 1) * 2];
        int[] places = new int[mask + 1];
        int kept = 0;

        if (old != null) {
            for (int n = 0; n < ordered; n++) {
                int slot = old[n];
                if (slot >= 0 && slot <= mask) {
                    places[slot] = kept;
                    list[kept] = slot;
                    kept = kept + 1;
                }
            }
        }

        order = list;
        placeOf = places;
        ordered = kept;
        OutgrownStorage.Release(old);
        OutgrownStorage.Release(oldPlaces);
    }

    internal int SlotAt(int n) {
        int[]? list = order;
        if (list == null || n >= ordered) { return -2; }
        return list[n];
    }

    public Dictionary() {
        keys = new K[16];
        values = new V[16];
        state = new int[16];
        hashes = new int[16];
        count = 0;
        mask = 15;
        by = null;
    }

    // `new Dictionary<string, Op>(StringComparer.OrdinalIgnoreCase)`, which is
    // how a table keyed by text is made to compare its keys by their text.
    /// The capacity constructor. A table that knows how many entries it will
    /// hold can be made large enough once instead of rehashing on the way up.
    /// ROUNDED UP TO A POWER OF TWO, because the probe uses a mask and not a
    /// remainder, and to three-quarters full, which is where Grow fires.
    public Dictionary(int capacity) : this() {
        int want = capacity * 4 / 3 + 1;
        int size = 16;

        while (size < want) { size = size * 2; }

        keys = new K[size];
        values = new V[size];
        state = new int[size];
        hashes = new int[size];
        mask = size - 1;
    }

    public Dictionary(IEqualityComparer<K> comparer) {
        keys = new K[16];
        values = new V[16];
        state = new int[16];
        hashes = new int[16];
        count = 0;
        mask = 15;
        by = comparer;
    }

    /// Both: sized once, keys compared the comparer's way.
    public Dictionary(int capacity, IEqualityComparer<K>? comparer) : this(capacity) {
        by = comparer;
    }

    // The normal Dictionary copy constructor, including an explicit comparer.
    // The self-hosted assembler uses this to turn its relative code-label map
    // into the address-valued map for its second pass.  Starting from the
    // ordinary comparer constructor preserves the table invariants, then
    // reinserting each occupied entry makes the copy independent of the
    // source table's capacity and probe history.
    public Dictionary(Dictionary<K, V> source, IEqualityComparer<K> comparer)
        : this(comparer) {
        for (int n = 0; source.SlotAt(n) != -2; n++) {
            int i = source.SlotAt(n);
            if (i >= 0) { this[source.keys[i]] = source.values[i]; }
        }
    }

    /// A COPY OF ANOTHER TABLE, which is .NET's Dictionary(IDictionary<K,V>)
    /// and the shortest way to fork a map before changing one of the forks.
    public Dictionary(Dictionary<K, V> source) : this() {
        for (int n = 0; source.SlotAt(n) != -2; n++) {
            int i = source.SlotAt(n);
            if (i >= 0) { this[source.keys[i]] = source.values[i]; }
        }
    }

    /// The same from any sequence of pairs, which .NET added in Core 2.0 and
    /// is what a LINQ query hands back.
    public Dictionary(IEnumerable<KeyValuePair<K, V>> collection) : this() {
        foreach (KeyValuePair<K, V> pair in collection) { this[pair.Key] = pair.Value; }
    }

    public int Count => count;

    // Both of these ask the comparer when there is one, and they must agree: a
    // hash saying two keys may be equal and an equality saying they are not is
    // a table that grows duplicates.
    //
    // COPIED TO A LOCAL FIRST, which is what a C# programmer does when the
    // checker cannot see that a field is unchanged -- a field is not tracked
    // across a call, so testing one proves nothing about the read after it.
    private bool Same(K a, K b) {
        IEqualityComparer<K>? with = by;

        if (with != null) { return with.Equals(a, b); }

        // THE DEFAULT COMPARER KNOWS STRINGS, as .NET's does: a table keyed
        // by text compares the text, whoever built the keys. A word-shaped
        // instantiation cannot know its K at compile time, so it asks the
        // object -- one load of its descriptor -- and a value-typed K asks
        // nothing, because the compiler folds the question to false.
        // AN OBJECT IS ASKED, as .NET's default comparer asks it: text for a
        // string, its own Equals for anything that has one -- a tuple, a type
        // made of types. A number is the word it is.
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.EqualValues(a, b);
    }

    private int Hash(K key) { return FullHash(key) & mask; }

    /// The key's hash before it is cut to the table: what `hashes` keeps.
    private int FullHash(K key) {
        IEqualityComparer<K>? with = by;
        if (with != null) { return Mixed(with.GetHashCode(key)); }
        if (Sys.IsObject(key)) { return Mixed(Sys.KeyHash(key)); }
        return Mixed(Sys.HashValue(key));
    }

    /// A cheap avalanche over the hash. Without it, sequential integer keys
    /// collide in runs and linear probing degrades to a linear scan. Each step
    /// its own value: a word of a key reassigned was a register written twice,
    /// which the lifetime rules cannot follow, and every key asked about --
    /// the string a lookup had just made -- was kept for the collector.
    private static int Mixed(long h) {
        long spread = h ^ (h >> 33);
        long multiplied = spread * 8127156113;
        return (int)(multiplied ^ (multiplied >> 29));
    }

    // THE INDEXER, which is how a Dictionary is read and written in C#. This
    // was Put and Get(key, fallback) -- our own spelling, and two more places
    // the compiler's own source could not compile here.
    //
    // Reading a key that is not there answers default(V) rather than throwing,
    // which is the one place this deliberately differs from .NET: there are no
    // exceptions to throw from a library this low, and a caller that cares uses
    // TryGetValue, which is what a caller that cares uses in C# anyway.
    public V this[K key] {
        get {
            int i = Hash(key);
            while (state[i] != 0) {
                if (state[i] == 1 && Same(keys[i], key)) { return values[i]; }
                i = (i + 1) & mask;
            }
            ThrowHelper.KeyNotFound(key);
            return default(V)!;
        }
        set {
            // Grow at three quarters: linear probing degrades sharply above.
            //
            // BY WHAT IS FILLED, NOT BY WHAT IS HELD: an erased slot ends no
            // probe, and a table with none empty is a search that never ends.
            if ((filled + 1) * 4 > (mask + 1) * 3) { Grow(); }

            int full = FullHash(key);
            int i = full & mask;
            int free = -1;

            // THE WHOLE CHAIN, past the erased ones. Stopping at the first of
            // them wrote a second copy of a key that lives further along.
            while (state[i] != 0) {
                if (state[i] == 1 && Same(keys[i], key)) {
                    values[i] = value;
                    return;
                }
                if (state[i] == 2 && free < 0) { free = i; }
                i = (i + 1) & mask;
            }
            if (free >= 0) { i = free; } else { filled = filled + 1; }
            keys[i] = key;
            values[i] = value;
            state[i] = 1;
            hashes[i] = full;
            count = count + 1;
            Placed(i);
        }
    }

    /// A key already there is an error, as in .NET: the indexer is how a value
    /// is replaced.
    public void Add(K key, V value) {
        if (ContainsKey(key)) ThrowHelper.DuplicateKey(key);
        this[key] = value;
    }

    /// TRUE WHEN IT WENT IN, false when the key was already there and the
    /// value it had was LEFT ALONE. .NET's TryAdd, and the difference from Add
    /// is the whole of why it exists: a first-writer-wins table is one call.
    public bool TryAdd(K key, V value) {
        if (ContainsKey(key)) { return false; }
        this[key] = value;
        return true;
    }

    /// .NET's GetValueOrDefault, which says out loud what the indexer here
    /// does quietly -- and the overload with a fallback of the caller's
    /// choosing, which the indexer cannot do at all.
    public V? GetValueOrDefault(K key) {
        V found = default(V)!;
        TryGetValue(key, out found);
        return found;
    }

    public V GetValueOrDefault(K key, V fallback) {
        V found = default(V)!;
        if (TryGetValue(key, out found)) { return found; }
        return fallback;
    }

    /// A LINEAR SCAN, and it is meant to be: a hash table indexes its keys and
    /// knows nothing whatever about its values. .NET's is the same scan.
    public bool ContainsValue(V value) {
        for (int n = 0; n < ordered; n++) {
            int i = SlotAt(n);
            if (i >= 0 && (Sys.IsObject(values[i]) ? Sys.KeyEquals(values[i], value) : Sys.EqualValues(values[i], value))) { return true; }
        }
        return false;
    }

    /// .NET's Dictionary<TKey, TValue>.Enumerator: a struct, so that walking a
    /// table with foreach allocates nothing, in the order things went in.
    public struct Enumerator : IEnumerator<KeyValuePair<K, V>>, IDisposable {
        private readonly Dictionary<K, V> over;
        private int at;
        private int slot;
        internal Enumerator(Dictionary<K, V> table) { over = table; at = -1; slot = -1; }
        public KeyValuePair<K, V> Current => new KeyValuePair<K, V>(over.keys[slot], over.values[slot]);
        object? IEnumerator.Current => Current;
        public bool MoveNext() {
            at = at + 1;
            slot = over.SlotAt(at);
            while (slot == -1) {
                at = at + 1;
                slot = over.SlotAt(at);
            }
            return slot >= 0;
        }
        public void Reset() { at = -1; slot = -1; }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }

    // Through the interface, as .NET's explicit implementation: an object,
    // since an interface's enumerator is one.
    IEnumerator<KeyValuePair<K, V>> IEnumerable<KeyValuePair<K, V>>.GetEnumerator() { return GetEnumerator(); }

    // VIEWS ONTO THE TABLE, as .NET's KeyCollection and ValueCollection: a
    // foreach over one walks the table itself with a struct enumerator. They
    // were lists copied out -- every `foreach (var v in map.Values)` made the
    // whole table again for the collector, and a loop asking for them in
    // its body did it on every turn.
    public KeyCollection Keys => new KeyCollection(this);

    public sealed class KeyCollection : ICollection<K>, IReadOnlyCollection<K> {
        private readonly Dictionary<K, V> over;
        public KeyCollection(Dictionary<K, V> dictionary) { over = dictionary; }
        public int Count => over.Count;
        public bool IsReadOnly => true;
        public KeyEnumerator GetEnumerator() { return new KeyEnumerator(over); }
        IEnumerator<K> IEnumerable<K>.GetEnumerator() { return GetEnumerator(); }
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
        public bool Contains(K item) => over.ContainsKey(item);
        public void CopyTo(K[] array, int arrayIndex) {
            foreach (K key in this) { array[arrayIndex] = key; arrayIndex = arrayIndex + 1; }
        }
        public void Add(K item) { throw new NotSupportedException("a dictionary's keys are read-only"); }
        public void Clear() { throw new NotSupportedException("a dictionary's keys are read-only"); }
        public bool Remove(K item) { throw new NotSupportedException("a dictionary's keys are read-only"); }
    }

    public struct KeyEnumerator : IEnumerator<K>, IDisposable {
        private readonly Dictionary<K, V> over;
        private int at;
        private int slot;
        internal KeyEnumerator(Dictionary<K, V> table) { over = table; at = -1; slot = -1; }
        public K Current => over.keys[slot];
        object? IEnumerator.Current => Current;
        public bool MoveNext() {
            at = at + 1;
            slot = over.SlotAt(at);
            while (slot == -1) {
                at = at + 1;
                slot = over.SlotAt(at);
            }
            return slot >= 0;
        }
        public void Reset() { at = -1; slot = -1; }
        public void Dispose() { }
    }

    public ValueCollection Values => new ValueCollection(this);

    public sealed class ValueCollection : ICollection<V>, IReadOnlyCollection<V> {
        private readonly Dictionary<K, V> over;
        public ValueCollection(Dictionary<K, V> dictionary) { over = dictionary; }
        public int Count => over.Count;
        public bool IsReadOnly => true;
        public ValueEnumerator GetEnumerator() { return new ValueEnumerator(over); }
        IEnumerator<V> IEnumerable<V>.GetEnumerator() { return GetEnumerator(); }
        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
        public bool Contains(V item) => over.ContainsValue(item);
        public void CopyTo(V[] array, int arrayIndex) {
            foreach (V value in this) { array[arrayIndex] = value; arrayIndex = arrayIndex + 1; }
        }
        public void Add(V item) { throw new NotSupportedException("a dictionary's values are read-only"); }
        public void Clear() { throw new NotSupportedException("a dictionary's values are read-only"); }
        public bool Remove(V item) { throw new NotSupportedException("a dictionary's values are read-only"); }
    }

    public struct ValueEnumerator : IEnumerator<V>, IDisposable {
        private readonly Dictionary<K, V> over;
        private int at;
        private int slot;
        internal ValueEnumerator(Dictionary<K, V> table) { over = table; at = -1; slot = -1; }
        public V Current => over.values[slot];
        object? IEnumerator.Current => Current;
        public bool MoveNext() {
            at = at + 1;
            slot = over.SlotAt(at);
            while (slot == -1) {
                at = at + 1;
                slot = over.SlotAt(at);
            }
            return slot >= 0;
        }
        public void Reset() { at = -1; slot = -1; }
        public void Dispose() { }
    }

    IEnumerable<K> IReadOnlyDictionary<K, V>.Keys => Keys;
    IEnumerable<V> IReadOnlyDictionary<K, V>.Values => Values;

    // AS IDictionary: the keys and values as read-only collections, which is
    // what .NET's KeyCollection and ValueCollection are to a caller holding
    // the interface -- adding to one throws, it does not add to a copy.
    ICollection<K> IDictionary<K, V>.Keys => Keys;
    ICollection<V> IDictionary<K, V>.Values => Values;
    bool ICollection<KeyValuePair<K, V>>.IsReadOnly => false;

    void ICollection<KeyValuePair<K, V>>.Add(KeyValuePair<K, V> item) {
        Add(item.Key, item.Value);
    }

    /// The pair, which is the key AND its value, the value compared by
    /// the default comparer as .NET's does.
    bool ICollection<KeyValuePair<K, V>>.Contains(KeyValuePair<K, V> item) {
        return TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value);
    }

    void ICollection<KeyValuePair<K, V>>.CopyTo(KeyValuePair<K, V>[] array, int arrayIndex) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (arrayIndex < 0 || arrayIndex > array.Length) { throw new ArgumentOutOfRangeException("arrayIndex"); }
        if (array.Length - arrayIndex < Count) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        foreach (KeyValuePair<K, V> pair in this) {
            array[arrayIndex] = pair;
            arrayIndex = arrayIndex + 1;
        }
    }

    bool ICollection<KeyValuePair<K, V>>.Remove(KeyValuePair<K, V> item) {
        if (TryGetValue(item.Key, out V found) && EqualityComparer<V>.Default.Equals(found, item.Value)) {
            return Remove(item.Key);
        }
        return false;
    }

    /// Removes the key, handing back the value it had.
    public bool Remove(K key, out V value) {
        if (TryGetValue(key, out value)) {
            Remove(key);
            return true;
        }
        value = default!;
        return false;
    }

    public bool ContainsKey(K key) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) { return true; }
            i = (i + 1) & mask;
        }
        return false;
    }

    // THE ONE THE COMPILER'S OWN SOURCE USES CONSTANTLY, and the reason `out`
    // had to exist before this could be written at all: one lookup answers both
    // whether the key was there and what was under it, where ContainsKey then
    // an index is two.
    public bool TryGetValue(K key, out V value) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) {
                value = values[i];
                return true;
            }
            i = (i + 1) & mask;
        }
        value = default(V)!;
        return false;
    }

    public bool Remove(K key) {
        int i = Hash(key);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(keys[i], key)) {
                // A tombstone, not an empty: erasing to empty would cut the
                // probe chain and hide everything after it.
                state[i] = 2;
                keys[i] = default(K)!;
                values[i] = default(V)!;
                count = count - 1;
                Unplaced(i);
                return true;
            }
            i = (i + 1) & mask;
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i <= mask; i++) {
            state[i] = 0;
            keys[i] = default(K)!;
            values[i] = default(V)!;
        }
        count = 0;
        filled = 0;
        ordered = 0;
        vacancies = 0;
    }

    // THE VALUES GIVEN BACK, by the compiler's call alone (OwnedElements):
    // every value this table holds was proved made for it, held by nothing
    // else, and dead. Each is freed and its place cleared.
    public void FreeOwnedElements() {
        if (state == null) { return; }
        for (int i = 0; i < state.Length; i++) {
            if (state[i] == 1) {
                OwnedElements.Release(values[i]);
                values[i] = default(V)!;
            }
        }
    }

    // ITS VALUES GIVEN BACK WITH ITS STORAGE, as List's (OwnElements).
    public void OwnElements() { ownsElements = true; }

    public void FreeStorage() {
        if (ownsElements) { ownsElements = false; FreeOwnedElements(); }
        OutgrownStorage.Release(keys);
        OutgrownStorage.Release(values);
        OutgrownStorage.Release(state);
        OutgrownStorage.Release(hashes);
        OutgrownStorage.Release(order);
        OutgrownStorage.Release(placeOf);
        OutgrownStorage.Release(vacant);
        keys = null!; values = null!; state = null!; hashes = null!;
        order = null; placeOf = null; vacant = null;
        count = 0; filled = 0;
    }

    private void Grow() {
        K[] oldKeys = keys;
        V[] oldValues = values;
        int[] oldState = state;
        int[] oldHashes = hashes;
        int[]? oldOrder = order;
        int[]? oldPlaces = placeOf;
        int oldOrdered = ordered;
        int oldSize = mask + 1;

        // Twice the size only when it is the held ones that fill it.
        int size = (count + 1) * 2 > oldSize ? oldSize * 2 : oldSize;

        // THE NEW ARRAYS FILLED IN LOCALS, and stored only once the old ones
        // are done with: a store that replaces an owned field frees what it
        // held, so no old array may be read after its field is written. Read
        // after, as this was, the fields were not owned, and every array a
        // growing table left behind was the collector's.
        K[] newKeys = new K[size];
        V[] newValues = new V[size];
        int[] newState = new int[size];
        int[] newHashes = new int[size];
        mask = size - 1;
        int held = 0;

        // EVERY ONE IN THE PLACE IT HAD, and the freed places still free, as
        // .NET's resize copies its entries: growing changes nothing a walk,
        // or the next add, can see.
        int[] list = new int[oldOrder != null && oldOrder.Length > size * 2 ? oldOrder.Length : size * 2];
        int[] places = new int[size];
        for (int n = 0; n < oldOrdered; n++) {
            int i = oldOrder![n];
            if (i < 0 || oldState[i] != 1) { list[n] = -1; continue; }
            int j = oldHashes[i] & mask;
            while (newState[j] != 0) { j = (j + 1) & mask; }
            newKeys[j] = oldKeys[i];
            newValues[j] = oldValues[i];
            newState[j] = 1;
            newHashes[j] = oldHashes[i];
            held = held + 1;
            list[n] = j;
            places[j] = n;
        }
        keys = newKeys;
        values = newValues;
        state = newState;
        hashes = newHashes;
        count = held;
        filled = held;
        order = list;
        placeOf = places;
        ordered = oldOrdered;
        OutgrownStorage.Release(oldKeys);
        OutgrownStorage.Release(oldValues);
        OutgrownStorage.Release(oldState);
        OutgrownStorage.Release(oldHashes);
        OutgrownStorage.Release(oldOrder);
        OutgrownStorage.Release(oldPlaces);
    }
}

// ---- Func and Action ------------------------------------------------------
// A function held in a variable.
//
// THERE ARE NO DELEGATE TYPES on this machine, and none are needed. A delegate
// is a thing with one method you can call, and that is an INTERFACE -- so Func
// and Action are interfaces with an Invoke, and the compiler treats `f(x)` as
// sugar for `f.Invoke(x)`. Virtual dispatch does the rest, which means a
// function value costs no machinery that classes and interfaces did not already
// need.
//
// The names and shapes are .NET's: Func answers something, Action answers
// nothing, and the last type argument of a Func is its return type. A lambda
// will be sugar for a class the compiler writes implementing one of these --
// which is exactly what C# does with a closure -- so anything written against
// them now keeps working when lambdas arrive.

// THE ZERO-ARGUMENT SHAPES, which a local function needs more often than a
// lambda does: `void Flush() { ... }` inside a method takes nothing and returns
// nothing, and that is the commonest local function there is.
//
// Not an arity of Func<A,R> with A left out -- C# spells the no-argument cases
// `Action` and `Func<R>`, and a language that spelled them anything else would
// not be C#.

interface Action {
    void Invoke();
}

interface Func<R> {
    R Invoke();
}

interface Func<A, R> {
    R Invoke(A a);
}

interface Func<A, B, R> {
    R Invoke(A a, B b);
}

interface Func<A, B, C, R> {
    R Invoke(A a, B b, C c);
}

interface Func<A, B, C, D, R> {
    R Invoke(A a, B b, C c, D d);
}

interface Func<A, B, C, D, E, R> {
    R Invoke(A a, B b, C c, D d, E e);
}

interface Func<A, B, C, D, E, F, R> {
    R Invoke(A a, B b, C c, D d, E e, F f);
}

interface Func<A, B, C, D, E, F, G, R> {
    R Invoke(A a, B b, C c, D d, E e, F f, G g);
}

interface Func<A, B, C, D, E, F, G, H, R> {
    R Invoke(A a, B b, C c, D d, E e, F f, G g, H h);
}

interface Action<A> {
    void Invoke(A a);
}

interface Action<A, B> {
    void Invoke(A a, B b);
}

interface Action<A, B, C> {
    void Invoke(A a, B b, C c);
}

interface Action<A, B, C, D> {
    void Invoke(A a, B b, C c, D d);
}

interface Action<A, B, C, D, E> {
    void Invoke(A a, B b, C c, D d, E e);
}

interface Action<A, B, C, D, E, F> {
    void Invoke(A a, B b, C c, D d, E e, F f);
}

interface Action<A, B, C, D, E, F, G> {
    void Invoke(A a, B b, C c, D d, E e, F f, G g);
}

interface Action<A, B, C, D, E, F, G, H> {
    void Invoke(A a, B b, C c, D d, E e, F f, G g, H h);
}

// A Func<A, bool> by another name, and the one a filter takes. .NET has both
// and so does this, because `Predicate<T>` says what it is for.
interface Predicate<A> {
    bool Invoke(A a);
}

/// .NET's Converter<TInput, TOutput>: what List<T>.ConvertAll and
/// Array.ConvertAll turn each element into.
interface Converter<TInput, TOutput> {
    TOutput Invoke(TInput input);
}

// C# lock's monitor, stored in the synchronization word present in every
// object header. Acquire/release CAS makes writes inside the critical section
// visible across CSCs; Pause lets another execution context make progress
// while this one is contended.
// System.Threading.Monitor, which `lock` expands to, is in the runtime's
// threading.cor: whose it is and how a waiter sleeps are the platform's.

class SynchronizationLockException : SystemException {
    public SynchronizationLockException() : base("Object synchronization method was called from an unsynchronized block of code.") { }
    public SynchronizationLockException(string? message) : base(message) { }
    public SynchronizationLockException(string? message, Exception? inner) : base(message, inner) { }
}

// ---- StringBuilder --------------------------------------------------------
// Text built a piece at a time, without building every intermediate string.
//
// WHY IT EXISTS AT ALL, since '+' already concatenates: a + b allocates a new
// string and copies BOTH sides into it, so building n pieces that way copies
// the whole accumulated text n times and allocates n strings on the way. This
// copies each piece once into a buffer that doubles. A compiler assembling
// diagnostics or an assembler emitting a listing does exactly that, in a loop.
//
// The API is .NET's, deliberately and to the letter -- Append, AppendLine,
// ToString, Length, Clear, and Append returning the builder so calls chain.
// Our own spelling would be a spelling every program has to be rewritten for.

// ---- Exception ------------------------------------------------------------
//
// THE BASE OF EVERYTHING THAT CAN BE THROWN, which C# has and this language did
// not: a throwable here was any class at all, so `catch (Failure f)` worked and
// `catch (Exception e)` -- the form every C# program in existence uses to mean
// "anything" -- had nothing to name.
//
// The surface is C#'s, because the rule is that ours changes to match rather
// than the other way about: Message, InnerException, and a ToString that reads
// like the real one.

class Exception
{
    string _message;
    Exception? _inner;

    /// THE CALLS THAT LED TO THE THROW, recorded by the runtime as the throw
    /// happens -- Runtime.Capture, which the compiler calls at every `throw`.
    /// Empty until then, and empty for an exception that was made but never
    /// thrown, which is what .NET answers too.
    string _trace = "";

    public Exception()
    {
        _message = "";
    }

    public Exception(string? message)
    {
        _message = message ?? "";
    }

    public Exception(string? message, Exception? inner)
    {
        _message = message ?? "";
        _inner = inner;
    }

    /// WHERE IT WAS THROWN: one line a frame, newest first, in .NET's own
    /// wording -- `   at Type.Method in file.cor:line N`.
    public string StackTrace => Named();

    /// Written by the runtime at the throw and by nothing else. Named with the
    /// trailing '$' the compiler reserves, so no program can call it by
    /// accident and none can be written that does.
    public string Trace$
    {
        get { return Named(); }
        set
        {
            _trace = value;
            _site = null;
            _frames = null;
        }
    }

    // THE THROW RECORDS ADDRESSES; READING NAMES THEM, as .NET's does. A
    // compiler that throws and catches to back out of a guess never reads the
    // trace, and naming it at every throw was a search of the image's
    // function table for each of up to 32 frames.
    string? _site;
    long[]? _frames;

    bool _placed;

    /// At the throw: the site's own line and the return addresses above it.
    /// Not when the trace was already placed (Placed$): the throw that
    /// follows is the runtime's, and the place is the program's.
    public void Thrown$(string site, long[] frames)
    {
        if (_placed)
        {
            _placed = false;
            return;
        }
        _trace = "";
        _site = site;
        _frames = frames;
    }

    /// A trace given before the throw, which the throw then keeps: a null
    /// dereference is thrown by the runtime (Runtime.NullFault) on behalf of
    /// the instruction that faulted, and the trace is that instruction's.
    public void Placed$(string site, long[] frames)
    {
        Thrown$(site, frames);
        _placed = true;
    }

    // Each read of _frames ends where it is made, so the exception owns its
    // frames and they go back with it (Escape's owned fields). THE TEXT IS
    // MADE WHEN IT IS ASKED FOR AND KEPT BY NOBODY, as .NET makes its
    // StackTrace: cached here, the one store of the site's string into
    // _trace -- a value read from another field -- refused _trace its owner,
    // and every exception thrown and caught was the collector's.
    string Named()
    {
        if (_site != null && _frames != null)
        {
            string callers = Runtime.TraceOf(_frames);
            return callers.Length == 0 ? String.Concat(_site, "") : String.Concat(_site, String.Concat("\n", callers));
        }
        return _trace;
    }

    /// What went wrong, in words.
    ///
    /// C# invents one when the thrower did not -- "Exception of type 'X' was
    /// thrown" -- and so does this, from the actual type rather than from the
    /// one that declared the constructor. That is what GetType() is for, and it
    /// is why a derived exception says its own name here without writing any
    /// code at all.
    public virtual string Message
    {
        get
        {
            if (_message.Length > 0)
            {
                return _message;
            }
            return String.Concat("Exception of type '",
                   String.Concat(this.GetType().FullName, "' was thrown."));
        }
    }

    /// The exception this one was raised in response to, or null.
    public Exception? InnerException => _inner;

    /// THE NUMBER UNDERNEATH THE SENTENCE. .NET puts the operating system's
    /// error code here -- on Unix the errno of the call that failed -- so that
    /// a program which needs to say exactly what went wrong can ask
    /// Marshal.GetPInvokeErrorMessage for the words instead of guessing them
    /// from the type it caught. Zero when there was no such number.
    public int HResult;

    /// WHAT AN EXCEPTION SAYS OF ITSELF, overriding object.ToString as in
    /// .NET, so a derived exception can replace it and one held as object
    /// still says it. The full type name, ": " and the message when there is
    /// one; the inner exception after " ---> " on the next line, closed by
    /// "--- End of inner exception stack trace ---"; then the stack trace.
    /// Lines end in "\n", Environment.NewLine on this platform, written out
    /// because Environment is a library above this one.
    public override string ToString()
    {
        string text = this.GetType().FullName;
        string message = Message;
        if (message.Length > 0) text = String.Concat(text, String.Concat(": ", message));

        Exception? inner = _inner;
        if (inner != null)
        {
            text = String.Concat(text, String.Concat("\n", String.Concat(" ---> ", inner.ToString())));
            text = String.Concat(text, String.Concat("\n", "   --- End of inner exception stack trace ---"));
        }
        string trace = Named();
        if (trace.Length > 0) text = String.Concat(text, String.Concat("\n", trace));
        return text;
    }
}

/// THE BASE OF EVERY EXCEPTION THE RUNTIME ITSELF RAISES, and of almost every
/// one in this file. .NET's tree has it directly under Exception with the
/// framework's own failures beneath it, and only a program's own exceptions
/// (which derive from Exception, or historically from ApplicationException)
/// outside it. It carries nothing: what it is for is `catch (SystemException)`
/// and the shape of the tree.
class SystemException : Exception
{
    public SystemException() : base("System error.") { }
    public SystemException(string? message) : base(message) { }
    public SystemException(string? message, Exception? inner) : base(message, inner) { }
}

/// System.Runtime.InteropServices' ExternalException: a failure outside the
/// runtime, with the error code it came with (an HRESULT, E_FAIL unless
/// said) -- what Clipboard throws when another program holds it open.
class ExternalException : SystemException
{
    private int _code;
    public ExternalException() : base("External component has thrown an exception.") { _code = unchecked((int)0x80004005); }
    public ExternalException(string? message) : base(message) { _code = unchecked((int)0x80004005); }
    public ExternalException(string? message, Exception? inner) : base(message, inner) { _code = unchecked((int)0x80004005); }
    public ExternalException(string message, int errorCode) : base(message) { _code = errorCode; }
    public virtual int ErrorCode => _code;
}

/// System.ComponentModel's Win32Exception: a Windows error by its number.
class Win32Exception : ExternalException
{
    private int _native;
    public Win32Exception() : base("The operation completed with an error.") { _native = 0; }
    public Win32Exception(int error) : base("Win32 error " + error + ".") { _native = error; }
    public Win32Exception(int error, string message) : base(message) { _native = error; }
    public Win32Exception(string message) : base(message) { _native = 0; }
    public int NativeErrorCode => _native;
}

class TypeInitializationException : SystemException
{
    private string _typeName;
    public TypeInitializationException(string? fullTypeName, Exception? innerException)
        : base("The type initializer for '" + (fullTypeName ?? "") + "' threw an exception.", innerException)
    { _typeName = fullTypeName ?? ""; }
    public string TypeName => _typeName;
}

/// A value that formats itself by a format string, .NET's IFormattable: what
/// `{value:format}` calls, and what string.Format hands a format to.
interface IFormattable
{
    string ToString(string? format, IFormatProvider? formatProvider);
}

/// One of the arguments was not acceptable. C#'s, spelled C#'s way.
class ArgumentException : SystemException
{
    // THE MESSAGE AND THE PARAMETER ARE KEPT APART, as .NET keeps them:
    // Message is the message and then " (Parameter 'name')" when a name was
    // given, and a derived exception adds its own line after that.
    readonly string? _paramName;

    public ArgumentException() : base("Value does not fall within the expected range.") { }
    public ArgumentException(string? message) : base(message ?? "Value does not fall within the expected range.") { }
    public ArgumentException(string? message, Exception? innerException) : base(message ?? "Value does not fall within the expected range.", innerException) { }

    /// WHICH ARGUMENT, which .NET prints after the message and keeps in
    /// ParamName for whoever catches it.
    public ArgumentException(string? message, string? paramName)
        : base(message ?? "Value does not fall within the expected range.") { _paramName = paramName; }

    public ArgumentException(string? message, string? paramName, Exception? innerException)
        : base(message ?? "Value does not fall within the expected range.", innerException) { _paramName = paramName; }

    public virtual string? ParamName => _paramName;

    public override string Message
    {
        get
        {
            string message = base.Message;
            return string.IsNullOrEmpty(_paramName) ? message : String.Concat(message, String.Concat(" (Parameter '", String.Concat(_paramName, "')")));
        }
    }

    /// Throws when the string is null (ArgumentNullException) or empty.
    public static void ThrowIfNullOrEmpty([NotNull] string? argument, [CallerArgumentExpression("argument")] string? paramName = null)
    {
        if (argument == null) throw new ArgumentNullException(paramName);
        if (argument.Length == 0) throw new ArgumentException("The value cannot be an empty string.", paramName);
    }

    /// Throws when the string is null (ArgumentNullException), empty or only white space.
    public static void ThrowIfNullOrWhiteSpace([NotNull] string? argument, [CallerArgumentExpression("argument")] string? paramName = null)
    {
        if (argument == null) throw new ArgumentNullException(paramName);
        if (string.IsNullOrWhiteSpace(argument)) throw new ArgumentException("The value cannot be an empty string or composed entirely of whitespace.", paramName);
    }
}

/// An argument's value was outside the range accepted by the method.
class ArgumentOutOfRangeException : ArgumentException
{
    readonly object? _actualValue;
    readonly bool _hasActualValue;

    public ArgumentOutOfRangeException() : base("Specified argument was out of the range of valid values.") { }
    public ArgumentOutOfRangeException(string? paramName) : base("Specified argument was out of the range of valid values.", paramName) { }
    public ArgumentOutOfRangeException(string? paramName, string? message) : base(message ?? "Specified argument was out of the range of valid values.", paramName) { }
    public ArgumentOutOfRangeException(string? message, Exception? innerException) : base(message, innerException) { }

    /// .NET's three-argument form: the argument, the value it actually had,
    /// and why -- which Message ends with, on a line of its own.
    public ArgumentOutOfRangeException(string? paramName, object? actualValue, string? message)
        : base(message ?? "Specified argument was out of the range of valid values.", paramName)
    {
        _actualValue = actualValue;
        _hasActualValue = true;
    }

    public virtual object? ActualValue => _actualValue;

    public override string Message
    {
        get
        {
            string message = base.Message;
            if (!_hasActualValue || _actualValue == null) return message;
            return String.Concat(message, String.Concat("\n", String.Concat("Actual value was ", String.Concat(_actualValue.ToString(), "."))));
        }
    }

    // THE GUARDS .NET 8 PUTS ON THE EXCEPTION, over the numbers a range is
    // checked on. .NET writes each once over INumberBase<T>; these are its
    // overloads for the types that have them here, with its messages.
    public static void ThrowIfNegative(int value, [CallerArgumentExpression("value")] string? paramName = null) { if (value < 0) Negative(value, paramName); }
    public static void ThrowIfNegative(long value, [CallerArgumentExpression("value")] string? paramName = null) { if (value < 0) Negative(value, paramName); }
    public static void ThrowIfNegative(double value, [CallerArgumentExpression("value")] string? paramName = null) { if (value < 0) Negative(value, paramName); }
    public static void ThrowIfNegative(float value, [CallerArgumentExpression("value")] string? paramName = null) { if (value < 0) Negative(value, paramName); }

    public static void ThrowIfZero(int value, [CallerArgumentExpression("value")] string? paramName = null) { if (value == 0) Zero(value, paramName); }
    public static void ThrowIfZero(long value, [CallerArgumentExpression("value")] string? paramName = null) { if (value == 0) Zero(value, paramName); }
    public static void ThrowIfZero(uint value, [CallerArgumentExpression("value")] string? paramName = null) { if (value == 0) Zero(value, paramName); }
    public static void ThrowIfZero(ulong value, [CallerArgumentExpression("value")] string? paramName = null) { if (value == 0) Zero(value, paramName); }
    public static void ThrowIfZero(double value, [CallerArgumentExpression("value")] string? paramName = null) { if (value == 0) Zero(value, paramName); }

    public static void ThrowIfNegativeOrZero(int value, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= 0) NegativeOrZero(value, paramName); }
    public static void ThrowIfNegativeOrZero(long value, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= 0) NegativeOrZero(value, paramName); }
    public static void ThrowIfNegativeOrZero(double value, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= 0) NegativeOrZero(value, paramName); }

    public static void ThrowIfGreaterThan(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value > other) Compared(value, other, paramName, "must be less than or equal to"); }
    public static void ThrowIfGreaterThan(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value > other) Compared(value, other, paramName, "must be less than or equal to"); }
    public static void ThrowIfGreaterThan(double value, double other, [CallerArgumentExpression("value")] string? paramName = null) { if (value > other) Compared(value, other, paramName, "must be less than or equal to"); }
    public static void ThrowIfGreaterThanOrEqual(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value >= other) Compared(value, other, paramName, "must be less than"); }
    public static void ThrowIfGreaterThanOrEqual(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value >= other) Compared(value, other, paramName, "must be less than"); }
    public static void ThrowIfGreaterThanOrEqual(double value, double other, [CallerArgumentExpression("value")] string? paramName = null) { if (value >= other) Compared(value, other, paramName, "must be less than"); }
    public static void ThrowIfLessThan(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value < other) Compared(value, other, paramName, "must be greater than or equal to"); }
    public static void ThrowIfLessThan(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value < other) Compared(value, other, paramName, "must be greater than or equal to"); }
    public static void ThrowIfLessThan(double value, double other, [CallerArgumentExpression("value")] string? paramName = null) { if (value < other) Compared(value, other, paramName, "must be greater than or equal to"); }
    public static void ThrowIfLessThanOrEqual(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= other) Compared(value, other, paramName, "must be greater than"); }
    public static void ThrowIfLessThanOrEqual(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= other) Compared(value, other, paramName, "must be greater than"); }
    public static void ThrowIfLessThanOrEqual(double value, double other, [CallerArgumentExpression("value")] string? paramName = null) { if (value <= other) Compared(value, other, paramName, "must be greater than"); }
    public static void ThrowIfEqual(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value == other) Compared(value, other, paramName, "must not be equal to"); }
    public static void ThrowIfEqual(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value == other) Compared(value, other, paramName, "must not be equal to"); }
    public static void ThrowIfNotEqual(int value, int other, [CallerArgumentExpression("value")] string? paramName = null) { if (value != other) Compared(value, other, paramName, "must be equal to"); }
    public static void ThrowIfNotEqual(long value, long other, [CallerArgumentExpression("value")] string? paramName = null) { if (value != other) Compared(value, other, paramName, "must be equal to"); }

    static void Negative(object value, string? paramName)
        => throw new ArgumentOutOfRangeException(paramName, value, $"{paramName} ('{value}') must be a non-negative value.");

    static void Zero(object value, string? paramName)
        => throw new ArgumentOutOfRangeException(paramName, value, $"{paramName} ('{value}') must be a non-zero value.");

    static void NegativeOrZero(object value, string? paramName)
        => throw new ArgumentOutOfRangeException(paramName, value, $"{paramName} ('{value}') must be a non-negative and non-zero value.");

    static void Compared(object value, object other, string? paramName, string rule)
        => throw new ArgumentOutOfRangeException(paramName, value, $"{paramName} ('{value}') {rule} '{other}'.");
}

/// An argument was null and the method cannot work with that.
class ArgumentNullException : ArgumentException
{
    public ArgumentNullException() : base("Value cannot be null.") { }
    public ArgumentNullException(string? paramName) : base("Value cannot be null.", paramName) { }
    public ArgumentNullException(string? paramName, string? message) : base(message ?? "Value cannot be null.", paramName) { }
    public ArgumentNullException(string? message, Exception? innerException) : base(message ?? "Value cannot be null.", innerException) { }

    /// THE GUARD AT THE TOP OF A METHOD, as .NET spells it since 6: the name
    /// is the text of the argument the caller wrote, which the compiler
    /// passes for [CallerArgumentExpression].
    public static void ThrowIfNull([NotNull] object? argument, [CallerArgumentExpression("argument")] string? paramName = null)
    {
        if (argument == null) { throw new ArgumentNullException(paramName); }
    }
}

/// An index was outside what the thing being indexed holds.
/// A value stored into an array whose elements cannot hold it: a Cat into a
/// Dog[] held as an Animal[], as C#'s array covariance allows at compile time
/// and refuses at run time (Runtime.ArrayStoreCheck).
class ArrayTypeMismatchException : SystemException
{
    public ArrayTypeMismatchException() : base("Attempted to access an element as a type incompatible with the array.") { }
    public ArrayTypeMismatchException(string? message) : base(message) { }
    public ArrayTypeMismatchException(string? message, Exception? innerException) : base(message, innerException) { }
}

class IndexOutOfRangeException : SystemException
{
    public IndexOutOfRangeException(string? message) : base(message) { }
    public IndexOutOfRangeException() : base("Index was outside the bounds of the array.") { }
    public IndexOutOfRangeException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// There is not enough memory for what was asked: an array larger than any
/// allocation can be, as .NET throws it.
class OutOfMemoryException : SystemException
{
    public OutOfMemoryException() : base("Insufficient memory to continue the execution of the program.") { }
    public OutOfMemoryException(string? message) : base(message) { }
    public OutOfMemoryException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// The object is not in a state where that call makes sense.
class InvalidOperationException : SystemException
{
    public InvalidOperationException() : base("Operation is not valid due to the current state of the object.") { }
    public InvalidOperationException(string? message) : base(message) { }
    public InvalidOperationException(string? message, Exception? inner) : base(message, inner) { }
}

class FormatException : SystemException
{
    public FormatException(string? message) : base(message) { }
    public FormatException() : base("One of the identified items was in an invalid format.") { }
    public FormatException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// UNDER ArithmeticException, which is where .NET puts it -- with
/// DivideByZeroException and NotFiniteNumberException, its two siblings.
class OverflowException : ArithmeticException
{
    public OverflowException(string? message) : base(message) { }
    public OverflowException() : base("Arithmetic operation resulted in an overflow.") { }
    public OverflowException(string? message, Exception? innerException) : base(message, innerException) { }
}

namespace System.IO
{
class FileNotFoundException : IOException
{
    public FileNotFoundException(string message) : base(message) { }
    public FileNotFoundException(string message, string fileName) : base(message) { }
}
}

/// System.UnauthorizedAccessException: the operating system refused, which on
/// Unix is EACCES, EPERM or a read-only filing system. .NET throws this rather
/// than IOException for those, and a caller that wants the exact reason reads
/// HResult.
class UnauthorizedAccessException : SystemException
{
    public UnauthorizedAccessException() : base("Attempted to perform an unauthorized operation.") { }
    public UnauthorizedAccessException(string? message) : base(message) { }
    public UnauthorizedAccessException(string? message, Exception? inner) : base(message, inner) { }
}

/// System.IO.DirectoryNotFoundException: a directory on the path is not
/// there. .NET throws this, not FileNotFoundException, when the directory
/// rather than the file is what is missing.
namespace System.IO
{
class DirectoryNotFoundException : IOException
{
    public DirectoryNotFoundException(string? message) : base(message) { }
    public DirectoryNotFoundException() : base("Attempted to access a path that is not on the disk.") { }
    public DirectoryNotFoundException(string? message, Exception? innerException) : base(message, innerException) { }
}
}

/// The rest of the exceptions a program catches by name. Every one of them is
/// a TYPE and nothing else -- what it carries is a message and a cause, which
/// Exception already holds -- and that is the whole point: `catch (IOException)`
/// has to name something, and a library that throws InvalidOperationException
/// where .NET throws NotSupportedException makes that catch miss.

/// The operation cannot be done on this object, ever. Distinct from
/// InvalidOperationException, which means "not just now".
class NotSupportedException : SystemException
{
    public NotSupportedException() : base("Specified method is not supported.") { }
    public NotSupportedException(string? message) : base(message) { }
    public NotSupportedException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// Not on this platform: the operation exists, and what the program runs on
/// cannot do it.
class PlatformNotSupportedException : NotSupportedException
{
    public PlatformNotSupportedException() : base("Operation is not supported on this platform.") { }
    public PlatformNotSupportedException(string? message) : base(message) { }
    public PlatformNotSupportedException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// A method that exists so that something compiles and has not been written.
class NotImplementedException : SystemException
{
    public NotImplementedException() : base("The method or operation is not implemented.") { }
    public NotImplementedException(string? message) : base(message) { }
    public NotImplementedException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// The key is not in the table. .NET's indexer throws this where the one here
/// answers default(V); a caller that wants the throw writes it, and a caller
/// that wants the test uses TryGetValue.
class KeyNotFoundException : SystemException
{
    public KeyNotFoundException() : base("The given key was not present in the dictionary.") { }
    public KeyNotFoundException(string? message) : base(message) { }
    public KeyNotFoundException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// Anything that went wrong at the filing system or a device, and the base of
/// every exception thrown for one: FileNotFoundException,
/// DirectoryNotFoundException, PathTooLongException, EndOfStreamException and
/// FileLoadException are all under it, as they are in .NET. That is what makes
/// `catch (IOException)` around an open catch a missing file -- the catch a
/// program actually writes, and the reason the tree is not flat.
namespace System.IO
{
class IOException : SystemException
{
    public IOException() : base("I/O error occurred.") { }
    public IOException(string? message) : base(message) { }
    public IOException(string? message, Exception? inner) : base(message, inner) { }
}
}

/// The path, or a name in it, is longer than the filing system allows.
namespace System.IO
{
class PathTooLongException : IOException
{
    public PathTooLongException() : base("The specified file name or path is too long, or a component of the specified path is too long.") { }
    public PathTooLongException(string? message) : base(message) { }
    public PathTooLongException(string? message, Exception? innerException) : base(message, innerException) { }
}
}

/// The file was found and could not be loaded.
namespace System.IO
{
class FileLoadException : IOException
{
    public FileLoadException() : base("Could not load the specified file.") { }
    public FileLoadException(string message) : base(message) { }
    public FileLoadException(string message, string fileName) : base(message) { }
}
}

class TimeoutException : SystemException
{
    public TimeoutException() : base("The operation has timed out.") { }
    public TimeoutException(string? message) : base(message) { }
    public TimeoutException(string? message, Exception? innerException) : base(message, innerException) { }
}

/// UNDER InvalidOperationException, which is .NET's placing and says what the
/// failure is: the call would have been fine a moment ago.
class ObjectDisposedException : InvalidOperationException
{
    readonly string? _objectName;

    public ObjectDisposedException(string? objectName) : base("Cannot access a disposed object.") { _objectName = objectName; }
    public ObjectDisposedException(string? objectName, string? message) : base(message ?? "Cannot access a disposed object.") { _objectName = objectName; }
    public ObjectDisposedException(string? message, Exception? innerException) : base(message ?? "Cannot access a disposed object.", innerException) { }

    /// The name of the object that was used after it was disposed.
    public string ObjectName => _objectName ?? "";

    /// The message, and the object's name on a line of its own, as .NET says it.
    public override string Message
    {
        get
        {
            string message = base.Message;
            return string.IsNullOrEmpty(_objectName) ? message
                : String.Concat(message, String.Concat("\n", String.Concat("Object name: '", String.Concat(_objectName, "'."))));
        }
    }

    /// Throws when <paramref name="condition"/> holds, naming the instance's type.
    public static void ThrowIf([DoesNotReturnIf(true)] bool condition, object instance)
    {
        if (condition) throw new ObjectDisposedException(instance?.GetType().FullName);
    }
}



/// What a switch expression throws when no arm matched its value (C# 12.11).
/// System.Runtime.CompilerServices in .NET.
sealed class SwitchExpressionException : InvalidOperationException
{
    readonly object? _unmatched;

    public SwitchExpressionException() : base("Non-exhaustive switch expression failed to match its input.") { }
    public SwitchExpressionException(Exception? innerException) : base("Non-exhaustive switch expression failed to match its input.", innerException) { }
    public SwitchExpressionException(object? unmatchedValue) : base("Non-exhaustive switch expression failed to match its input.") { _unmatched = unmatchedValue; }
    public SwitchExpressionException(string? message) : base(message) { }
    public SwitchExpressionException(string? message, Exception? innerException) : base(message, innerException) { }

    /// The value no arm matched.
    public object? UnmatchedValue => _unmatched;

    /// The message, and the unmatched value on a line of its own, as .NET says it.
    public override string Message
    {
        get
        {
            string message = base.Message;
            return _unmatched is null ? message
                : String.Concat(message, String.Concat("\n", String.Concat("Unmatched value was ", String.Concat(_unmatched.ToString(), "."))));
        }
    }
}

class ArithmeticException : SystemException
{
    public ArithmeticException(string? message) : base(message) { }
    public ArithmeticException() : base("Overflow or underflow in the arithmetic operation.") { }
    public ArithmeticException(string? message, Exception? innerException) : base(message, innerException) { }
}

// ---- Random ---------------------------------------------------------------
//
// XORSHIFT, and SEEDED BY DEFAULT rather than by the clock: two runs of the
// same program with the same seed produce the same numbers, which is what
// makes a failing test reproducible. .NET's parameterless constructor picks a
// seed nobody can predict; this machine has no entropy to pick one from at the
// level this file sits at, so the default seed is a constant and a caller that
// wants unpredictability passes a clock reading in.
//
// Marsaglia's xorshift64, which is three shifts and three exclusive-ors, has a
// period of 2^64-1 and passes the tests that matter for shuffling a list or
// choosing a sample. It is NOT for keys or nonces -- see os/lib/crypto_random
// for those, and note that the difference is not a matter of degree.
class Random {
    // The .NET 5 SEEDED GENERATOR, kept digit for digit: Knuth's subtractive
    // method over a ring of 56 numbers. .NET's own Random(seed) is this, and
    // it is this rather than something better BECAUSE a seeded sequence is a
    // promise -- a test, a simulation or a game that replays from a seed must
    // get the same numbers from the same seed on any machine and any version.
    // So the constants, the 21-step scatter and the four warming passes are
    // not choices here; they are the format.
    private const int Big = 2147483647;      // int.MaxValue
    private const int Seeding = 161803398;   // Knuth's, near phi * 10^8

    private int[] ring;
    private int next;
    private int nextp;

    // The xoshiro state, for a Random nobody gave a seed.
    private ulong s0;
    private ulong s1;
    private ulong s2;
    private ulong s3;
    private bool seeded;

    private static ulong Different = 0;

    /// NO SEED MEANS UNPREDICTABLE in .NET, which takes its state from the
    /// operating system and runs xoshiro256** over it. The algorithm here is
    /// the same one; the entropy is NOT, because this file sits below anything
    /// that has any -- it is a fixed constant stirred by a counter, so two
    /// Randoms in a program differ from each other but a run does not differ
    /// from the run before. A program that needs unpredictability seeds from
    /// the clock, or asks RandomNumberGenerator, which has the real thing.
    public Random() {
        seeded = false;
        Different = Different + 1;

        ulong start = (ulong)0x9E3779B97F4A7C15 * (Different + 1);

        s0 = Mix(start + (ulong)0x9E3779B97F4A7C15);
        s1 = Mix(s0);
        s2 = Mix(s1);
        s3 = Mix(s2);
    }

    public Random(int seed) {
        seeded = true;
        ring = new int[56];

        // int.MinValue HAS NO POSITIVE, so it stands in for int.MaxValue --
        // .NET's own guard, and without it the seed would negate to itself.
        int subtraction = seed == -2147483648 ? Big : (seed < 0 ? -seed : seed);
        int mj = Seeding - subtraction;
        int mk = 1;

        ring[55] = mj;

        for (int i = 1; i < 55; i++) {
            // 21 AND 55 ARE COPRIME, so this visits every slot exactly once.
            int ii = (21 * i) % 55;

            ring[ii] = mk;
            mk = mj - mk;
            if (mk < 0) { mk = mk + Big; }
            mj = ring[ii];
        }

        for (int k = 1; k < 5; k++) {
            for (int i = 1; i < 56; i++) {
                int n = i + 30;

                if (n >= 55) { n = n - 55; }
                ring[i] = ring[i] - ring[1 + n];
                if (ring[i] < 0) { ring[i] = ring[i] + Big; }
            }
        }
        next = 0;
        nextp = 21;
    }

    private static ulong Mix(ulong z) {
        ulong x = z;

        x = (x ^ (x >> 30)) * (ulong)0xBF58476D1CE4E5B9;
        x = (x ^ (x >> 27)) * (ulong)0x94D049BB133111EB;
        return x ^ (x >> 31);
    }

    private static ulong Rotate(ulong x, int by) {
        return (x << by) | (x >> (64 - by));
    }

    /// xoshiro256**, the generator .NET uses when there is no seed: four words
    /// of state, a multiply-rotate-multiply for the output and a shift-xor for
    /// the state.
    private ulong NextState() {
        ulong result = Rotate(s1 * 5, 7) * 9;
        ulong t = s1 << 17;

        s2 = s2 ^ s0;
        s3 = s3 ^ s1;
        s1 = s1 ^ s2;
        s0 = s0 ^ s3;
        s2 = s2 ^ t;
        s3 = Rotate(s3, 45);
        return result;
    }

    /// One draw of the subtractive generator, in [0, int.MaxValue).
    private int InternalSample() {
        int locNext = next;
        int locNextp = nextp;

        locNext = locNext + 1;
        if (locNext >= 56) { locNext = 1; }

        locNextp = locNextp + 1;
        if (locNextp >= 56) { locNextp = 1; }

        int made = ring[locNext] - ring[locNextp];

        if (made == Big) { made = made - 1; }
        if (made < 0) { made = made + Big; }

        ring[locNext] = made;
        next = locNext;
        nextp = locNextp;
        return made;
    }

    /// A DOUBLE IN [0, 1), which every other member is defined in terms of --
    /// including Next(maxValue), which is why .NET's bounded numbers are what
    /// they are.
    private double Sample() {
        if (!seeded) { return (double)(NextState() >> 11) * (1.0 / 9007199254740992.0); }
        return (double)InternalSample() * (1.0 / (double)Big);
    }

    /// A NON-NEGATIVE int below int.MaxValue.
    public int Next() {
        if (!seeded) { return (int)(NextState() >> 33); }
        return InternalSample();
    }

    public int Next(int maxValue) {
        if (maxValue < 0) { throw new ArgumentOutOfRangeException("maxValue"); }
        return (int)(Sample() * (double)maxValue);
    }

    /// THE UPPER BOUND IS EXCLUSIVE and the lower is not, which is .NET's rule
    /// for every one of these and the commonest thing to get wrong.
    public int Next(int minValue, int maxValue) {
        if (minValue > maxValue) { throw new ArgumentOutOfRangeException("minValue"); }

        long range = (long)maxValue - (long)minValue;

        if (range <= (long)Big) { return (int)(Sample() * (double)range) + minValue; }
        return (int)((long)(LargeSample() * (double)range) + (long)minValue);
    }

    // A RANGE WIDER THAN AN INT needs more than one draw to fill evenly: one
    // for the magnitude and one for the sign, mapped onto [0, 1). .NET's
    // GetSampleForLargeRange, and the reason Next(int.MinValue, int.MaxValue)
    // is not simply Sample() scaled.
    private double LargeSample() {
        int result = InternalSample();
        bool negative = InternalSample() % 2 == 0;

        if (negative) { result = -result; }

        double d = (double)result;

        d = d + (double)(Big - 1);
        d = d / (2.0 * (double)Big - 1.0);
        return d;
    }

    public double NextDouble() { return Sample(); }

    public float NextSingle() { return (float)Sample(); }

    /// Sixty-three bits of a long, built from three draws because a draw is
    /// only thirty-one bits and the top one of those is never set.
    ///
    /// The three widths are .NET's, but note that this is the ONE member whose
    /// sequence has not been checked against .NET number for number: Next,
    /// Next(max), Next(min, max), NextDouble and NextBytes all reproduce it
    /// exactly from the same seed, and NextInt64 has not been confirmed.
    public long NextInt64() {
        while (true) {
            ulong made = NextUInt64() >> 1;

            if (made != (ulong)9223372036854775807) { return (long)made; }
        }
    }

    private ulong NextUInt64() {
        return ((ulong)(uint)Next(1 << 22) << 42)
             | ((ulong)(uint)Next(1 << 22) << 20)
             | (ulong)(uint)Next(1 << 20);
    }

    public void NextBytes(byte[] buffer) {
        if (buffer == null) { throw new ArgumentNullException("buffer"); }

        for (int i = 0; i < buffer.Length; i++) {
            buffer[i] = (byte)(Next() % 256);
        }
    }
}

class StringBuilder : IOwnsStorage {
    private string buffer;
    private int used;

    // THE BUFFER GIVEN BACK with a builder proved dead (Runtime.Free): it is
    // never handed out -- ToString copies out of it.
    public void FreeStorage() {
        if (buffer != null) { Runtime.Free((nint)Sys.Word(buffer)); }
        buffer = null!;
        used = 0;
    }

    public StringBuilder() {
        buffer = Sys.NewChars(32);
        used = 0;
    }

    // The capacity overload is used by the assembler whenever it knows the
    // source slice it will rewrite.  It must establish the normal invariant
    // before Reserve runs; otherwise a missing constructor leaves `buffer`
    // null and the first append faults in Reserve.
    public StringBuilder(int capacity) : this() {
        if (capacity > 0) { Reserve(capacity); }
    }

    /// The text it starts with, which is .NET's commonest constructor and the
    /// one a formatter reaches for.
    public StringBuilder(string value) : this() {
        Append(value);
    }

    public StringBuilder(string value, int capacity) : this() {
        if (capacity > 0) { Reserve(capacity); }
        Append(value);
    }

    public int Length {
        get { return used; }
        set {
            if (value < 0) { throw new ArgumentOutOfRangeException("value"); }

            if (value > used) {
                Reserve(value);
                Sys.StringFill(buffer, used, 0, value - used);
            }
            used = value;
        }
    }

    /// Nothing for null, as .NET's Append(string?).
    public StringBuilder Append(string? s) {
        if (s == null) { return this; }
        int n = s.Length;
        Reserve(used + n);
        // buffer and s are distinct owned blocks. Restartable block copy
        // remains legal when the allocator supplies uncached RAM too.
        Sys.CopyNoOverlap(buffer, used, s, 0, n);
        used = used + n;
        return this;
    }

    // Format directly into the builder.  Apart from being cheaper than making
    // a temporary string, this matters to diagnostics and benchmarks whose
    // worker threads deliberately do not allocate while they hold or measure
    // machine resources.
    public StringBuilder Append(long value) {
        if (value == long.MinValue) { return Append("-9223372036854775808"); }

        if (value < 0) {
            Append('-');
            value = -value;
        }

        long scan = value;
        int digits = 1;
        while (scan >= 10) {
            scan = scan / 10;
            digits = digits + 1;
        }

        Reserve(used + digits);
        int at = used + digits - 1;
        do {
            Sys.SetChar(buffer, at, (int)(48 + value % 10));
            value = value / 10;
            at = at - 1;
        } while (value != 0);
        used = used + digits;
        return this;
    }

    public StringBuilder Append(bool value) { return Append(String.FromBool(value)); }

    // ONE CHARACTER, and it takes a char rather than an int on purpose.
    //
    // In .NET, Append(int) appends the DECIMAL TEXT of the number and
    // Append(char) appends the character -- so a char overload spelled `int`
    // silently steals every Append(5) and writes byte 5 instead of the digit.
    // That is exactly what happened here, and it is the shape of every bug this
    // library can have: our spelling differing from the one the caller expects.
    public StringBuilder Append(char c) {
        Reserve(used + 1);
        Sys.SetChar(buffer, used, (int)c);
        used = used + 1;
        return this;
    }

    public StringBuilder AppendLine(string s) { return Append(s).Append('\n'); }

    /// String.Format, appended -- which is the shape a report or a log line is
    /// built in, and saves the intermediate string.
    public StringBuilder AppendFormat(string format, params object[] args) {
        return Append(String.Format(format, args));
    }

    public StringBuilder AppendJoin(string separator, params object[] values) {
        for (int i = 0; i < values.Length; i++) {
            if (i > 0) { Append(separator); }
            Append("" + values[i]);
        }
        return this;
    }

    public StringBuilder AppendLine() { return Append('\n'); }

    // ---- the rest of what a StringBuilder does in C# ---------------------

    public StringBuilder Append(int value) { return Append((long)value); }
    public StringBuilder Append(uint value) { return Append((long)value); }
    public StringBuilder Append(short value) { return Append((long)value); }
    public StringBuilder Append(ushort value) { return Append((long)value); }
    public StringBuilder Append(sbyte value) { return Append((long)value); }
    public StringBuilder Append(byte value) { return Append((long)value); }

    public StringBuilder Append(ulong value) {
        return Append(NumberFormat.OfUnsigned(value, ""));
    }

    public StringBuilder Append(double value) { return Append(String.FromDouble(value)); }

    /// THE SAME CHARACTER, THAT MANY TIMES, which .NET has because building a
    /// rule of dashes or an indent is the commonest thing a builder does that
    /// is not appending text.
    public StringBuilder Append(char c, int count) {
        if (count <= 0) { return this; }

        Reserve(used + count);
        Sys.StringFill(buffer, used, (int)c, count);
        used = used + count;
        return this;
    }

    public StringBuilder Append(StringBuilder other) { return Append(other.ToString()); }

    /// ANYTHING AT ALL, which is .NET's Append(object?): what it says of
    /// itself, and nothing for a null. A machine word arrives boxed here, so
    /// the value's own ToString is what answers.
    public StringBuilder Append(object? value) {
        if (value == null) { return this; }

        // Joined rather than asked: a value arrives here BOXED, and joining a
        // box to a string is the one path that reads the box's descriptor and
        // renders what is inside it -- a number as a number, an enum as its
        // member's name. `value.ToString()` dispatches through the slot every
        // object shares and answers for the box.
        return Append("" + value);
    }

    /// PART of a string, which is what a scanner copying a token out of its
    /// input wants and which it should not have to allocate a Substring for.
    public StringBuilder Append(string s, int start, int count) {
        Reserve(used + count);
        Sys.CopyNoOverlap(buffer, used, s, start, count);
        used = used + count;
        return this;
    }

    /// READ AND WRITTEN BY POSITION, which is .NET's `this[int]` on a builder
    /// and the reason a builder is not just a list of strings: text already
    /// appended can be corrected without rebuilding what follows it.
    public char this[int index] {
        get {
            if (index < 0 || index >= used) {
                throw new IndexOutOfRangeException("index is outside the builder");
            }
            return Sys.GetChar(buffer, index);
        }
        set {
            if (index < 0 || index >= used) {
                throw new IndexOutOfRangeException("index is outside the builder");
            }
            Sys.SetChar(buffer, index, (int)value);
        }
    }

    public StringBuilder Insert(int at, string s) {
        if (at < 0 || at > used) { throw new ArgumentOutOfRangeException("at"); }

        Reserve(used + s.Length);

        // BACKWARDS, because source and destination overlap: copying forwards
        // would smear the first character over everything it had yet to read.
        for (int i = used - 1; i >= at; i--) {
            Sys.SetChar(buffer, i + s.Length, Sys.GetChar(buffer, i));
        }
        for (int i = 0; i < s.Length; i++) {
            Sys.SetChar(buffer, at + i, Sys.GetChar(s, i));
        }
        used = used + s.Length;
        return this;
    }

    public StringBuilder Insert(int at, char c) { return Insert(at, String.FromByte((long)c)); }
    public StringBuilder Insert(int at, long value) { return Insert(at, String.FromInt(value)); }

    public StringBuilder Remove(int at, int count) {
        if (at < 0 || count < 0 || at + count > used) {
            throw new ArgumentOutOfRangeException("at");
        }

        for (int i = at + count; i < used; i++) {
            Sys.SetChar(buffer, i - count, Sys.GetChar(buffer, i));
        }
        used = used - count;
        return this;
    }

    /// EVERY OCCURRENCE, IN PLACE. Going through ToString and String.Replace
    /// would be one line and would also throw away the buffer, which is the
    /// one thing a builder exists to keep.
    public StringBuilder Replace(char what, char with) {
        for (int i = 0; i < used; i++) {
            if (Sys.GetChar(buffer, i) == (int)what) { Sys.SetChar(buffer, i, (int)with); }
        }
        return this;
    }

    public StringBuilder Replace(string what, string with) {
        string made = String.Replace(ToString(), what, with);
        used = 0;
        return Append(made);
    }

    public string ToString(int start, int count) {
        return String.Substring(buffer, start, count);
    }

    /// PART OF WHAT WAS BUILT, THROWN AWAY -- which is what assigning to
    /// Length means in .NET, and it can also grow: the new tail is nul bytes.
    public int Capacity => buffer.Length;

    // THE ONLY PLACE A STRING IS MADE. Everything above writes into the buffer,
    // and the buffer is longer than the text in it -- so this cannot hand the
    // buffer back, or the caller would get trailing rubbish and a string that
    // changes under it the next time anything is appended.
    public string ToString() { return String.Substring(buffer, 0, used); }

    /// .NET's Clear answers the builder so that it can be chained, and this
    /// one answered nothing -- `sb.Clear().Append(x)` did not compile.
    public StringBuilder Clear() {
        used = 0;
        return this;
    }

    // The .NET spelling, and useful whenever allocation must happen before a
    // timed or concurrent section rather than unpredictably inside it.
    public void EnsureCapacity(int capacity) {
        if (capacity > 0) { Reserve(capacity); }
    }

    // Doubling, so appending stays amortised constant rather than quadratic --
    // which is the entire reason to prefer this over '+' in a loop.
    private void Reserve(int want) {
        int size = buffer.Length;
        if (want <= size) { return; }

        while (size < want) { size = size * 2; }

        string bigger = Sys.NewChars(size);
        Sys.CopyNoOverlap(bigger, 0, buffer, 0, used);
        buffer = bigger;
    }
}

// ---- HashSet --------------------------------------------------------------
// The keys of a Dictionary with no values attached, and the same open
// addressing with linear probing for the same reason: chaining needs an
// allocation per entry, and an arena freed wholesale at the end of a handler is
// the wrong place to be allocating many small nodes.
//
// A set rather than a Dictionary<T, bool> because the values array is real
// memory -- one word per slot, most of it empty -- and because Add answering
// "was it already there" is the operation that makes a set worth having: it is
// how a worklist stops going round in circles, in one lookup instead of two.
//
// .NET's API: Add returns whether it was new, Contains, Remove, Count, Clear.

// .NET spells this HashSet<T>.Enumerator; see ListEnumerator for why it is not
// written inside the class.
class HashSetEnumerator<T> : IEnumerator<T> {
    // The non-generic IEnumerator's members, as .NET's enumerators have them.
    object? IEnumerator.Current => Current;
    public void Reset() { at = -1; }

    // IEnumerator<T> is an IDisposable; walking holds nothing to let go of.
    public void Dispose() { }

    private HashSet<T> over;
    private int at;
    private int slot;

    public HashSetEnumerator(HashSet<T> set) {
        over = set;
        at = -1;
    }

    public T Current => over.items[slot];

    public bool MoveNext() {
        at = at + 1;
        slot = over.SlotAt(at);
        while (slot == -1) {
            at = at + 1;
            slot = over.SlotAt(at);
        }
        return slot >= 0;
    }
}

class HashSet<T> : ISet<T>, IReadOnlySet<T>, IEnumerable<T>, IOwnsStorage {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    // The comparer this set was given, or null for the default: an object's
    // own Equals and hash, a number's word -- as Dictionary's.
    private IEqualityComparer<T>? by;
    private T[] items;
    private int[] state;      // 0 empty, 1 used, 2 erased
    // Each used slot's hash, as Dictionary keeps them: growing asks no comparer.
    private int[] hashes;
    private int count;
    private int filled;     // used and erased together: what a probe has to walk past
    private int mask;

    // IN THE ORDER THINGS WENT IN, which is the order .NET's walks them in
    // while nothing has been removed, and what a program that fills a table
    // and then writes it out depends on without saying so -- this compiler's
    // own output among them. `order` lists the occupied slots oldest first,
    // with -1 where one was removed; `placeOf` is each slot's place in it.
    private int[]? order;
    private int[]? placeOf;
    private int ordered;

    // A removed one's place is the next added one's, most recently freed
    // first, as .NET's free list gives an entry back (see Dictionary).
    private int[]? vacant;
    private int vacancies;

    private void Placed(int slot) {
        if (vacancies > 0 && order != null && placeOf != null) {
            vacancies = vacancies - 1;
            int place = vacant![vacancies];
            order[place] = slot;
            placeOf[slot] = place;
            return;
        }
        // Each field read once, after Tidy has made it what it will be: a
        // local given the field twice is a join, and a join of two loads is
        // a read the owned-field rules cannot follow.
        if (order == null || placeOf == null || ordered == order.Length || placeOf.Length != mask + 1) {
            Tidy();
        }
        int[]? list = order;
        int[]? places = placeOf;

        if (list != null && places != null) {
            places[slot] = ordered;
            list[ordered] = slot;
            ordered = ordered + 1;
        }
    }

    private void Unplaced(int slot) {
        int[]? list = order;
        int[]? places = placeOf;

        if (list != null && places != null && places.Length == mask + 1) {
            int place = places[slot];
            list[place] = -1;
            if (vacant == null || vacancies == vacant.Length) {
                int[]? was = vacant;
                int[] more = new int[vacant == null ? 8 : vacant.Length * 2];
                for (int n = 0; n < vacancies; n++) { more[n] = was![n]; }
                vacant = more;
                OutgrownStorage.Release(was);
            }
            vacant[vacancies] = place;
            vacancies = vacancies + 1;
        }
    }

    // The removed ones squeezed out, and room for as many again as the table
    // can hold.
    private void Tidy() {
        int[]? old = order;
        int[]? oldPlaces = placeOf;
        int[] list = new int[(mask + 1) * 2];
        int[] places = new int[mask + 1];
        int kept = 0;

        if (old != null) {
            for (int n = 0; n < ordered; n++) {
                int slot = old[n];
                if (slot >= 0 && slot <= mask) {
                    places[slot] = kept;
                    list[kept] = slot;
                    kept = kept + 1;
                }
            }
        }

        order = list;
        placeOf = places;
        ordered = kept;
        OutgrownStorage.Release(old);
        OutgrownStorage.Release(oldPlaces);
    }

    internal int SlotAt(int n) {
        int[]? list = order;
        if (list == null || n >= ordered) { return -2; }
        return list[n];
    }

    public HashSet() {
        items = new T[16];
        state = new int[16];
        hashes = new int[16];
        count = 0;
        filled = 0;
        mask = 15;
    }

    public HashSet(IEnumerable<T> source) : this() {
        foreach (T value in source) { Add(value); }
    }

    /// Equality by `comparer` -- StringComparer.OrdinalIgnoreCase,
    /// ReferenceEqualityComparer -- or, given null, the default.
    public HashSet(IEqualityComparer<T>? comparer) : this() { by = comparer; }

    public HashSet(IEnumerable<T> source, IEqualityComparer<T>? comparer) : this() {
        by = comparer;
        foreach (T value in source) { Add(value); }
    }

    public int Count => count;

    /// The comparer the set compares by: the one it was given, or the default.
    public IEqualityComparer<T> Comparer => by ?? EqualityComparer<T>.Default;

    private bool Same(T a, T b) {
        IEqualityComparer<T>? with = by;
        if (with != null) { return with.Equals(a, b); }
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.EqualValues(a, b);
    }

    // The same avalanche Dictionary uses. Without it, sequential integer keys
    // collide in runs and linear probing degrades to a linear scan.
    private int Hash(T value) { return FullHash(value) & mask; }

    private int FullHash(T value) {
        // The comparer's hash, or the key's own when it is an object that has
        // one, as .NET's default comparer asks: a set of strings, or of
        // tuples, holds equal ones once. Mixed as Dictionary mixes its keys.
        IEqualityComparer<T>? with = by;
        if (with != null) { return Mixed(with.GetHashCode(value)); }
        if (Sys.IsObject(value)) { return Mixed(Sys.KeyHash(value)); }
        return Mixed(Sys.HashValue(value));
    }

    private static int Mixed(long h) {
        long spread = h ^ (h >> 33);
        long multiplied = spread * 8127156113;
        return (int)(multiplied ^ (multiplied >> 29));
    }

    // TRUE WHEN IT WAS NOT THERE, which is .NET's contract and the useful half:
    // `if (!seen.Add(x)) { continue; }` is one lookup where Contains-then-Add
    // is two.
    public bool Add(T value) {
        // BY WHAT IS FILLED, NOT BY WHAT IS HELD. An erased slot ends no probe,
        // so a set that is added to and removed from for long enough has no
        // empty slot left while holding almost nothing -- and the search for
        // one never ends. The compiler's own scopes are exactly that set.
        if ((filled + 1) * 4 > (mask + 1) * 3) { Grow(); }

        int full = FullHash(value);
        int i = full & mask;
        int free = -1;

        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) { return false; }
            // A tombstone is reusable, but only after the whole probe chain has
            // been searched -- taking it early would let the same value be
            // added twice with a copy further along the chain.
            if (state[i] == 2 && free < 0) { free = i; }
            i = (i + 1) & mask;
        }

        if (free >= 0) { i = free; } else { filled = filled + 1; }

        items[i] = value;
        state[i] = 1;
        hashes[i] = full;
        count = count + 1;
        Placed(i);
        return true;
    }

    public bool Contains(T value) {
        int i = Hash(value);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) { return true; }
            i = (i + 1) & mask;
        }
        return false;
    }

    /// .NET's HashSet<T>.Enumerator: a struct, so a foreach over a set
    /// allocates nothing -- and the set it walks is not handed to an object
    /// on the heap, which the lifetime rules took for the set escaping: every
    /// snapshot set that was walked once went to the collector.
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly HashSet<T> over;
        private int at;
        private int slot;
        internal Enumerator(HashSet<T> set) { over = set; at = -1; slot = -1; }
        public T Current => over.items[slot];
        object? IEnumerator.Current => Current;
        public bool MoveNext() {
            at = at + 1;
            slot = over.SlotAt(at);
            while (slot == -1) {
                at = at + 1;
                slot = over.SlotAt(at);
            }
            return slot >= 0;
        }
        public void Reset() { at = -1; slot = -1; }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { return new Enumerator(this); }

    // Through the interface: an object, since an interface's enumerator is one.
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { return new HashSetEnumerator<T>(this); }

    public bool Remove(T value) {
        int i = Hash(value);
        while (state[i] != 0) {
            if (state[i] == 1 && Same(items[i], value)) {
                // A tombstone, not an empty: erasing to empty would cut the
                // probe chain and hide everything after it.
                state[i] = 2;
                items[i] = default(T)!;
                count = count - 1;
                Unplaced(i);
                return true;
            }
            i = (i + 1) & mask;
        }
        return false;
    }

    public void Clear() {
        for (int i = 0; i <= mask; i++) { state[i] = 0; items[i] = default(T)!; }
        count = 0;
        filled = 0;
        ordered = 0;
        vacancies = 0;
    }

    // THE STORAGE GIVEN BACK with a set proved dead (Runtime.Free): no array
    // of it ever leaves the set.
    public void FreeStorage() {
        OutgrownStorage.Release(items);
        OutgrownStorage.Release(state);
        OutgrownStorage.Release(hashes);
        OutgrownStorage.Release(order);
        OutgrownStorage.Release(placeOf);
        OutgrownStorage.Release(vacant);
        items = null!; state = null!; hashes = null!;
        order = null; placeOf = null; vacant = null;
        count = 0; filled = 0;
    }

    /// .NET's UnionWith takes an IEnumerable<T>; the HashSet overload below is
    /// the same work without the interface call per element.
    public void UnionWith(IEnumerable<T> other) {
        foreach (T each in other) { Add(each); }
    }

    public void ExceptWith(IEnumerable<T> other) {
        foreach (T each in other) { Remove(each); }
    }

    /// WHETHER THE TWO SHARE ANYTHING AT ALL, which is what .NET's Overlaps
    /// answers and is cheaper than intersecting to find out.
    public bool Overlaps(IEnumerable<T> other) {
        foreach (T each in other) {
            if (Contains(each)) { return true; }
        }
        return false;
    }

    public bool IsSubsetOf(IEnumerable<T> other) {
        HashSet<T> theirs = new HashSet<T>(other, by);

        foreach (T each in this) {
            if (!theirs.Contains(each)) { return false; }
        }
        return true;
    }

    public bool SetEquals(IEnumerable<T> other) {
        HashSet<T> theirs = new HashSet<T>(other, by);

        return Count == theirs.Count && IsSubsetOf(theirs);
    }

    public void UnionWith(HashSet<T> other) {
        foreach (T value in other) { Add(value); }
    }

    public void IntersectWith(HashSet<T> other) {
        List<T> remove = new List<T>();
        foreach (T value in this) {
            if (!other.Contains(value)) { remove.Add(value); }
        }
        foreach (T value in remove) { Remove(value); }
    }

    public void IntersectWith(IEnumerable<T> other) {
        HashSet<T> keep = new HashSet<T>(other, by);
        IntersectWith(keep);
    }

    bool ICollection<T>.IsReadOnly => false;

    void ICollection<T>.Add(T item) { Add(item); }

    /// What is in one of the two and not both, left here.
    public void SymmetricExceptWith(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        HashSet<T> theirs = new HashSet<T>(other, by);
        foreach (T value in theirs) {
            if (!Remove(value)) { Add(value); }
        }
    }

    public bool IsSupersetOf(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        foreach (T value in other) {
            if (!Contains(value)) { return false; }
        }
        return true;
    }

    /// A subset with something of the other's left over.
    public bool IsProperSubsetOf(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        HashSet<T> theirs = new HashSet<T>(other, by);
        return theirs.Count > Count && IsSubsetOf(theirs);
    }

    public bool IsProperSupersetOf(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        HashSet<T> theirs = new HashSet<T>(other, by);
        return Count > theirs.Count && IsSupersetOf(theirs);
    }

    /// The member equal to `equalValue`, which may not be the same object.
    public bool TryGetValue(T equalValue, out T actualValue) {
        foreach (T value in this) {
            if (Comparer.Equals(value, equalValue)) {
                actualValue = value;
                return true;
            }
        }
        actualValue = default!;
        return false;
    }

    public void CopyTo(T[] array) { CopyTo(array, 0, Count); }

    public void CopyTo(T[] array, int arrayIndex) { CopyTo(array, arrayIndex, Count); }

    public void CopyTo(T[] array, int arrayIndex, int count) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (arrayIndex < 0) { throw new ArgumentOutOfRangeException("arrayIndex"); }
        if (count < 0) { throw new ArgumentOutOfRangeException("count"); }
        if (arrayIndex > array.Length || count > array.Length - arrayIndex) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        int copied = 0;
        foreach (T value in this) {
            if (copied == count) { break; }
            array[arrayIndex + copied] = value;
            copied = copied + 1;
        }
    }

    public int RemoveWhere(Predicate<T> match) {
        List<T> remove = new List<T>();
        foreach (T value in this) {
            if (match(value)) { remove.Add(value); }
        }
        foreach (T value in remove) { Remove(value); }
        return remove.Count;
    }

    private void Grow() {
        T[] old = items;
        int[] oldState = state;
        int[] oldHashes = hashes;
        int[]? oldOrder = order;
        int[]? oldPlaces = placeOf;
        int oldOrdered = ordered;
        int oldSize = mask + 1;

        // Twice the size only when it is the held ones that fill it; a table
        // of tombstones is rehashed where it stands.
        int size = (count + 1) * 2 > oldSize ? oldSize * 2 : oldSize;

        // Filled in locals and stored once the old arrays are done with, as
        // Dictionary's Grow: an owned field's store frees what it replaces.
        T[] newItems = new T[size];
        int[] newState = new int[size];
        int[] newHashes = new int[size];
        mask = size - 1;
        int held = 0;

        // Tombstones do not survive a rehash, which is the other thing growth
        // is for; every element keeps its place, and the freed places stay
        // free, as .NET's resize copies its entries.
        int[] list = new int[oldOrder != null && oldOrder.Length > size * 2 ? oldOrder.Length : size * 2];
        int[] places = new int[size];
        for (int n = 0; n < oldOrdered; n++) {
            int i = oldOrder![n];
            if (i < 0 || oldState[i] != 1) { list[n] = -1; continue; }
            int j = oldHashes[i] & mask;
            while (newState[j] != 0) { j = (j + 1) & mask; }
            newItems[j] = old[i];
            newState[j] = 1;
            newHashes[j] = oldHashes[i];
            held = held + 1;
            list[n] = j;
            places[j] = n;
        }
        items = newItems;
        state = newState;
        hashes = newHashes;
        count = held;
        filled = held;
        order = list;
        placeOf = places;
        ordered = oldOrdered;
        OutgrownStorage.Release(old);
        OutgrownStorage.Release(oldState);
        OutgrownStorage.Release(oldHashes);
        OutgrownStorage.Release(oldOrder);
        OutgrownStorage.Release(oldPlaces);
    }
}

// The ordered set surface used by the compiler's metadata writer. This small
// implementation favours a compact, deterministic iteration order over a tree:
// descriptor interface lists are short, and insertion-sort behaviour is both
// simpler and cheaper at their actual sizes.
/// A set kept in order, .NET's SortedSet<T>: by the comparer it was given, or
/// the element type's own order (text by its characters, a number by value).
/// A sorted array searched by halving, rather than .NET's red-black tree: the
/// same answers and the same order of enumeration.
class SortedSet<T> : ISet<T>, IReadOnlySet<T>, IEnumerable<T> {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    private List<T> items;
    // AN EMPTY SET HOLDS NO LIST OF ITS OWN: every one shares this until its
    // first Add. A link's lifetime hints made sets by the million, most of
    // them never added to, and each was a list too.
    static readonly List<T> NoItems = new List<T>();
    private IComparer<T> by;

    // A VIEW (GetViewBetween) is a set over a range of another: it holds no
    // members of its own, reads the parent's that fall between its bounds as
    // they are now, and writes go to the parent -- .NET's live view.
    private SortedSet<T>? parent;
    private T lowerBound;
    private T upperBound;

    private bool InRange(T value) => by.Compare(value, lowerBound) >= 0 && by.Compare(value, upperBound) <= 0;

    /// A view's members, read again from its parent; a set's own, as they are.
    private void Sync() {
        if (parent == null) { return; }
        parent.Sync();
        List<T> now = new List<T>();
        foreach (T value in parent.items) { if (InRange(value)) { now.Add(value); } }
        items = now;
    }

    /// The members between two values, both included, as a set that stays
    /// this one's: what is added to it or removed from it is added to or
    /// removed from this, and what this gains or loses in the range it sees.
    public SortedSet<T> GetViewBetween(T lowerValue, T upperValue) {
        if (by.Compare(lowerValue, upperValue) > 0) { throw new ArgumentException("lowerBound is greater than upperBound"); }
        if (parent != null && (!InRange(lowerValue) || !InRange(upperValue))) { throw new ArgumentOutOfRangeException("lowerValue"); }
        SortedSet<T> view = new SortedSet<T>(by);
        view.parent = this;
        view.lowerBound = lowerValue;
        view.upperBound = upperValue;
        return view;
    }

    public SortedSet() { items = NoItems; by = Comparer<T>.Default; }

    public SortedSet(IComparer<T>? comparer) {
        items = NoItems;
        by = comparer ?? Comparer<T>.Default;
    }

    public SortedSet(IEnumerable<T> collection) : this(collection, null) { }

    public SortedSet(IEnumerable<T> collection, IComparer<T>? comparer) : this(comparer) {
        foreach (T item in collection) { Add(item); }
    }

    public IComparer<T> Comparer => by;

    public int Count { get { Sync(); return items.Count; } }

    public T Min {
        get { Sync(); return items.Count == 0 ? default(T)! : items[0]; }
    }

    public T Max {
        get { Sync(); return items.Count == 0 ? default(T)! : items[items.Count - 1]; }
    }

    /// Where value is, or the complement of where it would go.
    private int Find(T value) {
        Sync();
        int low = 0;
        int high = items.Count - 1;
        while (low <= high) {
            int middle = low + ((high - low) >> 1);
            int order = by.Compare(items[middle], value);
            if (order == 0) { return middle; }
            if (order < 0) { low = middle + 1; } else { high = middle - 1; }
        }
        return ~low;
    }

    public bool Add(T value) {
        if (parent != null) {
            if (!InRange(value)) { throw new ArgumentOutOfRangeException("item"); }
            return parent.Add(value);
        }
        int at = Find(value);
        if (at >= 0) { return false; }
        if (ReferenceEquals(items, NoItems)) { items = new List<T>(); }
        items.Insert(~at, value);
        return true;
    }

    public bool Remove(T value) {
        if (parent != null) { return InRange(value) && parent.Remove(value); }
        int at = Find(value);
        if (at < 0) { return false; }
        items.RemoveAt(at);
        return true;
    }

    public bool Contains(T value) { return Find(value) >= 0; }

    public void Clear() {
        if (parent != null) {
            Sync();
            foreach (T value in items) { parent.Remove(value); }
            return;
        }
        if (!ReferenceEquals(items, NoItems)) { items.Clear(); }
    }

    public void UnionWith(IEnumerable<T> other) {
        foreach (T item in other) { Add(item); }
    }

    public void ExceptWith(IEnumerable<T> other) {
        foreach (T item in other) { Remove(item); }
    }

    public void IntersectWith(IEnumerable<T> other) {
        SortedSet<T> keep = new SortedSet<T>(by);
        foreach (T item in other) {
            if (Contains(item)) { keep.Add(item); }
        }
        if (parent != null) {
            Sync();
            foreach (T value in items) { if (!keep.Contains(value)) { parent.Remove(value); } }
            return;
        }
        items = keep.items;
    }

    public bool SetEquals(IEnumerable<T> other) {
        SortedSet<T> them = new SortedSet<T>(other, by);
        if (them.Count != Count) { return false; }
        Sync();
        for (int i = 0; i < items.Count; i++) {
            if (by.Compare(items[i], them.items[i]) != 0) { return false; }
        }
        return true;
    }

    public bool IsSubsetOf(IEnumerable<T> other) {
        SortedSet<T> them = new SortedSet<T>(other, by);
        Sync();
        for (int i = 0; i < items.Count; i++) {
            if (!them.Contains(items[i])) { return false; }
        }
        return true;
    }

    public bool IsSupersetOf(IEnumerable<T> other) {
        foreach (T item in other) {
            if (!Contains(item)) { return false; }
        }
        return true;
    }

    public bool Overlaps(IEnumerable<T> other) {
        foreach (T item in other) {
            if (Contains(item)) { return true; }
        }
        return false;
    }

    bool ICollection<T>.IsReadOnly => false;

    void ICollection<T>.Add(T item) { Add(item); }

    public void SymmetricExceptWith(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        SortedSet<T> theirs = new SortedSet<T>(other, by);
        foreach (T value in theirs) {
            if (!Remove(value)) { Add(value); }
        }
    }

    public bool IsProperSubsetOf(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        SortedSet<T> theirs = new SortedSet<T>(other, by);
        return theirs.Count > Count && IsSubsetOf(theirs);
    }

    public bool IsProperSupersetOf(IEnumerable<T> other) {
        if (other == null) { throw new ArgumentNullException("other"); }
        SortedSet<T> theirs = new SortedSet<T>(other, by);
        return Count > theirs.Count && IsSupersetOf(theirs);
    }

    /// The member equal to `equalValue` by the set's comparer.
    public bool TryGetValue(T equalValue, out T actualValue) {
        foreach (T value in this) {
            if (by.Compare(value, equalValue) == 0) {
                actualValue = value;
                return true;
            }
        }
        actualValue = default!;
        return false;
    }

    public void CopyTo(T[] array, int index, int count) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0) { throw new ArgumentOutOfRangeException("index"); }
        if (count < 0) { throw new ArgumentOutOfRangeException("count"); }
        if (index > array.Length || count > array.Length - index) { throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length."); }
        int copied = 0;
        foreach (T value in this) {
            if (copied == count) { break; }
            array[index + copied] = value;
            copied = copied + 1;
        }
    }

    public int RemoveWhere(Predicate<T> match) {
        if (parent != null) {
            Sync();
            int removed = 0;
            foreach (T value in items) { if (match(value) && parent.Remove(value)) { removed = removed + 1; } }
            return removed;
        }
        if (ReferenceEquals(items, NoItems)) { return 0; }
        return items.RemoveAll(item => match(item));
    }

    public void CopyTo(T[] array) { CopyTo(array, 0); }

    public void CopyTo(T[] array, int index) {
        Sync();
        for (int i = 0; i < items.Count; i++) { array[index + i] = items[i]; }
    }

    public IEnumerable<T> Reverse() {
        List<T> backwards = new List<T>();
        Sync();
        for (int i = items.Count - 1; i >= 0; i--) { backwards.Add(items[i]); }
        return backwards;
    }

    /// .NET's own: a struct, so a foreach over one allocates nothing and does
    /// not hand the collection to an object on the heap (which the lifetime
    /// rules take for its escape).
    public struct Enumerator : IEnumerator<T>, IDisposable {
        private readonly List<T> over;
        private int at;
        internal Enumerator(List<T> walked) { over = walked; at = -1; }
        public T Current => over[at];
        object? IEnumerator.Current => Current;
        public bool MoveNext() { at = at + 1; return at < over.Count; }
        public void Reset() { at = -1; }
        public void Dispose() { }
    }

    public Enumerator GetEnumerator() { Sync(); return new Enumerator(items); }
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { Sync(); return new ListEnumerator<T>(items); }
}

// ---- ordering -------------------------------------------------------------
//
// THE THREE NAMES C# USES to say "which of these comes first", and they are
// three because they are asked in three places: a type says its own order with
// IComparable, a caller supplies one for somebody else's type with IComparer,
// and a sort takes a bare function with Comparison.

/// A type that knows its own order. `class Version : IComparable<Version>`.
interface IComparable<T> {
    int CompareTo(T other);
}

/// The same asked of anything: .NET's non-generic IComparable, which a sort
/// over objects and every boxed number and tuple answers. Less than zero
/// when this comes first, zero when neither does, more when `obj` does; a
/// null `obj` comes first.
interface IComparable {
    int CompareTo(object? obj);
}

/// An order imposed from outside, for a type that has none or has the wrong
/// one. This is what List.Sort and Array.Sort are given.
/// `in T`, for the reason IEqualityComparer's is.
interface IComparer<in T> {
    int Compare(T a, T b);
}

/// A bare comparing function, which is .NET's `delegate int Comparison<in T>`
/// and is an interface here for the reason every delegate is -- see Func.
interface Comparison<T> {
    int Invoke(T a, T b);
}

/// THE ORDER A TYPE HAS WHEN NOBODY SUPPLIES ONE.
///
/// Text by its characters and everything else by its machine word, which is
/// the value for a number, a char or an enum and the ADDRESS for an object.
/// So sorting numbers and sorting strings do what .NET does, and sorting a
/// list of some class without a comparer sorts by where its elements happen to
/// live -- a stable answer, and not the one .NET gives.
///
/// .NET asks the element for its IComparable<T>, and this cannot yet: testing
/// `a is IComparable<T>` inside a generic faults the machine when T turns out
/// to be a value type, because the test is not folded away the way
/// Sys.IsString is. See build/repro-std-generic-is.cor. Until that lands, a
/// class with an order of its own is sorted by passing its CompareTo as the
/// comparison, which is one lambda at the call site.
class DefaultComparer<T> : IComparer<T> {
    // A COPY FOR EVERY T, which a static of its own gives it (Monomorphiser.
    // HasStaticState): shared by every word-sized argument, an int was
    // compared as the reference copy compares words -- unsigned, -1 above 0
    // -- and a float's bits as an integer's, so sorts and OrderBy over
    // negative numbers came out in the wrong order.
    static readonly bool OneForEachType = true;

    public int Compare(T a, T b) {
        // AN OBJECT IS ASKED, through the slot every class keeps its CompareTo
        // at: text for strings, a tuple element by element, a class's own
        // order when it wrote one. Null sorts first, as .NET has it.
        if (Sys.IsObject(a) || Sys.IsObject(b)) {
            return Sys.KeyCompare(a, b);
        }
        // A number as its own type orders it (Sys.CompareValues).
        return Sys.CompareValues(a, b);
    }
}

/// .NET's EqualityComparer<T>.Default and Comparer<T>.Default, which are how
/// generic code asks for "the usual" without knowing what T is.
abstract class Comparer<T> : IComparer<T> {
    // ONE, as .NET has one: made at every use, a record's CompareTo and every
    // sort paid an allocation for each comparison.
    static readonly IComparer<T> _default = new DefaultComparer<T>();
    public static IComparer<T> Default => _default;

    public abstract int Compare(T x, T y);

    /// .NET's Comparer<T>.Create: a comparer that asks the function given.
    public static Comparer<T> Create(Comparison<T> comparison) {
        if (comparison == null) { throw new ArgumentNullException(nameof(comparison)); }
        return new CreatedComparer<T>(comparison);
    }
}

/// What Comparer<T>.Create makes: a Comparer, as .NET's is, asking the function.
sealed class CreatedComparer<T> : Comparer<T> {
    private readonly Comparison<T> comparison;
    public CreatedComparer(Comparison<T> comparison) { this.comparison = comparison; }
    public override int Compare(T x, T y) { return comparison.Invoke(x, y); }
}

class DefaultEqualityComparer<T> : IEqualityComparer<T> {
    public bool Equals(T a, T b) {
        // AN OBJECT IS ASKED, as .NET's default comparer asks it: text for a
        // string, its own Equals for anything that has one -- a tuple, a type
        // made of types. A number is the word it is.
        if (Sys.IsObject(a)) { return Sys.KeyEquals(a, b); }
        return Sys.EqualValues(a, b);
    }

    public int GetHashCode(T value) {
        if (Sys.IsObject(value)) { return Sys.KeyHash(value); }
        return (int)Sys.HashValue(value);
    }
}

class EqualityComparer<T> {
    // ONE, as .NET has one: made at every use, a record's synthesised
    // GetHashCode allocated a comparer for each field it hashed.
    static readonly IEqualityComparer<T> _default = new DefaultEqualityComparer<T>();
    public static IEqualityComparer<T> Default => _default;
}

/// THE SORT ITSELF, in one place, over a plain array and a length.
///
/// MERGE RATHER THAN QUICK, and the reason is not speed: a merge sort is
/// STABLE, so equal elements keep the order they were given in, and a program
/// that sorts a table by one column and then another depends on that. It also
/// has no worst case to be provoked into, which matters when the thing being
/// sorted came off a network.
static class Sorting {
    // ---- Array.Sort and List.Sort: .NET's introspective sort ----------------
    //
    // THE SAME ALGORITHM .NET'S ArraySortHelper RUNS, step for step: insertion
    // sort below sixteen, a median-of-three pivot above, heapsort once the
    // depth limit is spent. It is not stable, and neither is .NET's -- which
    // is why it has to be this one: equal elements come out in the order
    // .NET's leaves them in, and a program that sorts ties and writes them
    // out (this compiler, sorting its output) writes what it writes on .NET.
    public static void Introspective<T>(T[] items, int from, int count, IComparer<T> by) {
        if (count > 1) {
            IntroSort(items, from, count, 2 * (Log2(count) + 1), by);
        }
    }

    private static int Log2(int n) {
        int log = 0;
        while (n > 1) { n = n >> 1; log = log + 1; }
        return log;
    }

    private static void IntroSort<T>(T[] keys, int lo, int size, int depthLimit, IComparer<T> by) {
        int partitionSize = size;
        while (partitionSize > 1) {
            if (partitionSize <= 16) {
                if (partitionSize == 2) {
                    SwapIfGreater(keys, lo, lo + 1, by);
                    return;
                }
                if (partitionSize == 3) {
                    SwapIfGreater(keys, lo, lo + 1, by);
                    SwapIfGreater(keys, lo, lo + 2, by);
                    SwapIfGreater(keys, lo + 1, lo + 2, by);
                    return;
                }
                InsertionSort(keys, lo, partitionSize, by);
                return;
            }
            if (depthLimit == 0) {
                HeapSort(keys, lo, partitionSize, by);
                return;
            }
            depthLimit = depthLimit - 1;
            int p = PickPivotAndPartition(keys, lo, partitionSize, by);
            IntroSort(keys, lo + p + 1, partitionSize - (p + 1), depthLimit, by);
            partitionSize = p;
        }
    }

    private static void SwapIfGreater<T>(T[] keys, int i, int j, IComparer<T> by) {
        if (by.Compare(keys[i], keys[j]) > 0) {
            T key = keys[i];
            keys[i] = keys[j];
            keys[j] = key;
        }
    }

    private static void Swap<T>(T[] keys, int i, int j) {
        T t = keys[i];
        keys[i] = keys[j];
        keys[j] = t;
    }

    private static int PickPivotAndPartition<T>(T[] keys, int lo, int size, IComparer<T> by) {
        int hi = size - 1;
        int middle = hi >> 1;
        SwapIfGreater(keys, lo, lo + middle, by);
        SwapIfGreater(keys, lo, lo + hi, by);
        SwapIfGreater(keys, lo + middle, lo + hi, by);
        T pivot = keys[lo + middle];
        Swap(keys, lo + middle, lo + hi - 1);
        int left = 0;
        int right = hi - 1;
        while (left < right) {
            left = left + 1;
            while (by.Compare(keys[lo + left], pivot) < 0) { left = left + 1; }
            right = right - 1;
            while (by.Compare(pivot, keys[lo + right]) < 0) { right = right - 1; }
            if (left >= right) { break; }
            Swap(keys, lo + left, lo + right);
        }
        if (left != hi - 1) {
            Swap(keys, lo + left, lo + hi - 1);
        }
        return left;
    }

    private static void HeapSort<T>(T[] keys, int lo, int n, IComparer<T> by) {
        for (int i = n >> 1; i >= 1; i--) {
            DownHeap(keys, lo, i, n, by);
        }
        for (int i = n; i > 1; i--) {
            Swap(keys, lo, lo + i - 1);
            DownHeap(keys, lo, 1, i - 1, by);
        }
    }

    private static void DownHeap<T>(T[] keys, int lo, int i, int n, IComparer<T> by) {
        T d = keys[lo + i - 1];
        while (i <= n >> 1) {
            int child = 2 * i;
            if (child < n && by.Compare(keys[lo + child - 1], keys[lo + child]) < 0) {
                child = child + 1;
            }
            if (!(by.Compare(d, keys[lo + child - 1]) < 0)) { break; }
            keys[lo + i - 1] = keys[lo + child - 1];
            i = child;
        }
        keys[lo + i - 1] = d;
    }

    private static void InsertionSort<T>(T[] keys, int lo, int size, IComparer<T> by) {
        for (int i = 0; i < size - 1; i++) {
            T t = keys[lo + i + 1];
            int j = i;
            while (j >= 0 && by.Compare(t, keys[lo + j]) < 0) {
                keys[lo + j + 1] = keys[lo + j];
                j = j - 1;
            }
            keys[lo + j + 1] = t;
        }
    }

    // ---- OrderBy: stable, as .NET's is ---------------------------------------
    public static void Sort<T>(T[] items, int from, int count, IComparer<T> by) {
        if (count < 2) { return; }

        T[] scratch = new T[count];
        Merge(items, scratch, from, count, by);
    }

    private static void Merge<T>(T[] items, T[] scratch, int from, int count, IComparer<T> by) {
        // BOTTOM UP, doubling the run length, so there is no recursion to run
        // out of stack on and no pivot to choose badly.
        int width = 1;

        while (width < count) {
            int at = 0;

            while (at < count) {
                int leftEnd = at + width;
                int rightEnd = at + width * 2;

                if (leftEnd > count) { leftEnd = count; }
                if (rightEnd > count) { rightEnd = count; }

                int i = at;
                int j = leftEnd;
                int into = at;

                while (i < leftEnd && j < rightEnd) {
                    // `<= 0` AND NOT `< 0` is what makes it stable: an element
                    // from the left run wins a tie, and the left run is the
                    // earlier one.
                    if (by.Compare(items[from + i], items[from + j]) <= 0) {
                        scratch[into] = items[from + i];
                        i = i + 1;
                    } else {
                        scratch[into] = items[from + j];
                        j = j + 1;
                    }
                    into = into + 1;
                }

                while (i < leftEnd) {
                    scratch[into] = items[from + i];
                    i = i + 1;
                    into = into + 1;
                }
                while (j < rightEnd) {
                    scratch[into] = items[from + j];
                    j = j + 1;
                    into = into + 1;
                }

                at = at + width * 2;
            }

            for (int k = 0; k < count; k++) { items[from + k] = scratch[k]; }
            width = width * 2;
        }
    }
}

/// An IComparer wrapping a bare comparing function, so Sort needs only one
/// implementation however the caller spelt the order.
class ComparisonComparer<T> : IComparer<T> {
    private Comparison<T> by;

    public ComparisonComparer(Comparison<T> comparison) { by = comparison; }

    public int Compare(T a, T b) { return by.Invoke(a, b); }
}


// ---- time, as an amount and as a moment -----------------------------------
//
// NO CLOCK IS READ HERE. DateTime.Now belongs to the system library, which is
// where the machine is; these two types are arithmetic on a number, and that
// arithmetic is the part every program does and nobody should write twice.
//
// THE UNIT IS .NET'S TICK: one ten-millionth of a second. It is not a natural
// unit for anything, and it is the right one here for exactly one reason --
// that a program moved between this machine and .NET keeps the same numbers.

/// The days of the week, numbered as .NET numbers them -- Sunday first,
/// because that is what `(int)DayOfWeek.Sunday == 0` means in every C# program
/// that indexes an array of names by it.
enum DayOfWeek {
    Sunday = 0,
    Monday = 1,
    Tuesday = 2,
    Wednesday = 3,
    Thursday = 4,
    Friday = 5,
    Saturday = 6,
}

/// AN AMOUNT OF TIME, which is not a moment: the difference between two
/// DateTimes, or how long to wait. Signed, because a difference can go either
/// way and refusing that would make subtraction an error half the time.
struct TimeSpan {
    private long ticks;

    public TimeSpan(long inTicks) { ticks = inTicks; }

    public TimeSpan(int hours, int minutes, int seconds) {
        ticks = ((long)hours * 3600 + (long)minutes * 60 + (long)seconds) * 10000000;
    }

    public TimeSpan(int days, int hours, int minutes, int seconds) {
        ticks = ((long)days * 86400 + (long)hours * 3600 + (long)minutes * 60 + (long)seconds)
              * 10000000;
    }

    public static long TicksPerMillisecond => 10000;
    public static long TicksPerSecond => 10000000;
    public static long TicksPerMinute => 600000000;
    public static long TicksPerHour => 36000000000;
    public static long TicksPerDay => 864000000000;

    public static TimeSpan Zero => new TimeSpan(0);

    public static TimeSpan FromTicks(long value) { return new TimeSpan(value); }
    public static TimeSpan FromMilliseconds(double value) {
        return new TimeSpan((long)(value * 10000.0));
    }
    public static TimeSpan FromSeconds(double value) {
        return new TimeSpan((long)(value * 10000000.0));
    }
    public static TimeSpan FromMinutes(double value) {
        return new TimeSpan((long)(value * 600000000.0));
    }
    public static TimeSpan FromHours(double value) {
        return new TimeSpan((long)(value * 36000000000.0));
    }
    public static TimeSpan FromDays(double value) {
        return new TimeSpan((long)(value * 864000000000.0));
    }

    public long Ticks => ticks;

    // THE WHOLE PART OF EACH FIELD, with the rest taken by the field below it,
    // which is what .NET's Days/Hours/Minutes mean -- an hour and a half is
    // Hours 1, Minutes 30, and TotalHours 1.5. The two are different questions
    // and this is the half people get wrong.
    public int Days => (int)(ticks / 864000000000);
    public int Hours => (int)(ticks / 36000000000 % 24);
    public int Minutes => (int)(ticks / 600000000 % 60);
    public int Seconds => (int)(ticks / 10000000 % 60);
    public int Milliseconds => (int)(ticks / 10000 % 1000);

    public double TotalDays => (double)ticks / 864000000000.0;
    public double TotalHours => (double)ticks / 36000000000.0;
    public double TotalMinutes => (double)ticks / 600000000.0;
    public double TotalSeconds => (double)ticks / 10000000.0;
    public double TotalMilliseconds => (double)ticks / 10000.0;

    public TimeSpan Add(TimeSpan other) { return new TimeSpan(ticks + other.Ticks); }
    public TimeSpan Subtract(TimeSpan other) { return new TimeSpan(ticks - other.Ticks); }
    public TimeSpan Negate() { return new TimeSpan(-ticks); }
    public TimeSpan Duration() { return new TimeSpan(ticks < 0 ? -ticks : ticks); }

    public int CompareTo(TimeSpan other) {
        if (ticks < other.Ticks) { return -1; }
        if (ticks > other.Ticks) { return 1; }
        return 0;
    }

    public bool Equals(TimeSpan other) { return ticks == other.Ticks; }

    // ---- the operators C# writes ----------------------------------------
    //
    // `a + b`, `a < b`, `a == b` on two of these, which is how every program
    // that measures time is written. Each is the static method .NET declares
    // for the operator; the compiler finds it by the name the operator has in
    // metadata, so this and a C# source file say the same thing.
    //
    // MULTIPLYING BY A NUMBER is .NET's `TimeSpan * double`, and DIVIDING one
    // span by another is a plain ratio -- "how many of these fit in that".

    public static TimeSpan operator +(TimeSpan a, TimeSpan b) { return new TimeSpan(a.Ticks + b.Ticks); }
    public static TimeSpan operator -(TimeSpan a, TimeSpan b) { return new TimeSpan(a.Ticks - b.Ticks); }
    public static TimeSpan operator *(TimeSpan a, double factor) { return new TimeSpan((long)((double)a.Ticks * factor)); }
    public static TimeSpan operator *(double factor, TimeSpan a) { return new TimeSpan((long)((double)a.Ticks * factor)); }
    public static TimeSpan operator /(TimeSpan a, double divisor) { return new TimeSpan((long)((double)a.Ticks / divisor)); }
    public static double operator /(TimeSpan a, TimeSpan b) { return (double)a.Ticks / (double)b.Ticks; }

    public static bool operator ==(TimeSpan a, TimeSpan b) { return a.Ticks == b.Ticks; }
    public static bool operator !=(TimeSpan a, TimeSpan b) { return a.Ticks != b.Ticks; }
    public static bool operator <(TimeSpan a, TimeSpan b) { return a.Ticks < b.Ticks; }
    public static bool operator >(TimeSpan a, TimeSpan b) { return a.Ticks > b.Ticks; }
    public static bool operator <=(TimeSpan a, TimeSpan b) { return a.Ticks <= b.Ticks; }
    public static bool operator >=(TimeSpan a, TimeSpan b) { return a.Ticks >= b.Ticks; }

    public static int Compare(TimeSpan a, TimeSpan b) { return a.CompareTo(b); }

    /// "[-][d.]hh:mm[:ss[.fffffff]]", which is the shape ToString writes: a
    /// span written down reads back as itself. The DAYS ARE SEPARATED BY A
    /// DOT, not a colon, which is .NET's spelling and the part that surprises.
    public static TimeSpan Parse(string text) {
        TimeSpan made = TimeSpan.Zero;

        if (!TryParse(text, out made)) {
            throw new FormatException(String.Concat("String '",
                String.Concat(text, "' was not recognized as a valid TimeSpan.")));
        }
        return made;
    }

    /// The invariant format is the only one TimeSpan is written in here, so
    /// the provider changes nothing.
    public static TimeSpan Parse(string input, IFormatProvider? formatProvider) { return Parse(input); }

    public static bool TryParse(string? input, IFormatProvider? formatProvider, out TimeSpan result) {
        if (input == null) { result = TimeSpan.Zero; return false; }
        return TryParse(input, out result);
    }

    public static bool TryParse(string? text, out TimeSpan value) {
        // .NET's answer for no string at all: false, and the default.
        if (text is null) { value = default; return false; }
        value = TimeSpan.Zero;
        if (text == null) { return false; }

        string rest = String.Trim(text);

        if (rest.Length == 0) { return false; }

        bool negative = Sys.GetChar(rest, 0) == (int)'-';

        if (negative || Sys.GetChar(rest, 0) == (int)'+') {
            rest = String.Substring(rest, 1, rest.Length - 1);
        }

        long days = 0;
        int colon = String.IndexOf(rest, ':');
        int dot = String.IndexOf(rest, '.');

        // A DOT BEFORE THE FIRST COLON separates the days; one after the last
        // is the fraction of a second.
        if (dot >= 0 && (colon < 0 || dot < colon)) {
            if (!Int64.TryParse(String.Substring(rest, 0, dot), out days)) { return false; }
            rest = String.Substring(rest, dot + 1, rest.Length - dot - 1);
            colon = String.IndexOf(rest, ':');
        }

        long ticks = 0;

        if (colon < 0) {
            // A bare number is a count of DAYS, which is the one shape that
            // does not look like a clock.
            long only = 0;

            if (!Int64.TryParse(rest, out only)) { return false; }
            ticks = only * 864000000000;
        } else {
            if (!DateParts.TryTime(rest, out ticks)) { return false; }
            ticks = ticks + days * 864000000000;
        }

        value = new TimeSpan(negative ? -ticks : ticks);
        return true;
    }

    /// `[-][d.]hh:mm:ss[.fffffff]`, which is .NET's constant ("c") format and
    /// its default: the day part appears only when there is one, and the
    /// fraction only when it is not zero.
    public string ToString() {
        long left = ticks < 0 ? -ticks : ticks;
        StringBuilder made = new StringBuilder();

        if (ticks < 0) { made.Append('-'); }

        long days = left / 864000000000;
        if (days != 0) {
            made.Append(days);
            made.Append('.');
        }

        made.Append(String.PadLeft(String.FromInt(left / 36000000000 % 24), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(left / 600000000 % 60), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(left / 10000000 % 60), 2, '0'));

        long fraction = left % 10000000;
        if (fraction != 0) {
            made.Append('.');
            made.Append(String.PadLeft(String.FromInt(fraction), 7, '0'));
        }
        return made.ToString();
    }
}

/// Whether a DateTime is UTC, the machine's local time, or not said --
/// .NET's three, with .NET's meanings: ToLocalTime treats Unspecified as
/// UTC, and ToUniversalTime treats it as local.
enum DateTimeKind {
    Unspecified = 0,
    Utc = 1,
    Local = 2,
}

/// A MOMENT, counted in ticks from the start of the first day of year 1 -- the
/// same epoch .NET uses, so a tick count means the same thing on both sides.
///
/// THE PROLEPTIC GREGORIAN CALENDAR throughout, which is also .NET's choice:
/// the rule about centuries is applied to years long before anybody agreed to
/// it, because a calendar that changes its rules partway is a calendar no
/// arithmetic can be done on.
partial struct DateTime {
    private long ticks;
    private DateTimeKind kind;

    public DateTime(long inTicks) { ticks = inTicks; }

    public DateTime(long inTicks, DateTimeKind inKind) { ticks = inTicks; kind = inKind; }

    public DateTime(int year, int month, int day, int hour, int minute, int second, DateTimeKind inKind) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000;
        kind = inKind;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second,
                    int millisecond, DateTimeKind inKind) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000
              + (long)millisecond * 10000;
        kind = inKind;
    }

    /// Whether this is UTC, local time, or not said.
    public DateTimeKind Kind => kind;

    /// The same reading, said to be of another kind -- no conversion.
    public static DateTime SpecifyKind(DateTime value, DateTimeKind inKind) {
        return new DateTime(value.Ticks, inKind);
    }

    public DateTime(int year, int month, int day) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000;
    }

    public DateTime(int year, int month, int day, int hour, int minute, int second,
                    int millisecond) {
        ticks = DateParts.DaysFrom(year, month, day) * 864000000000
              + ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000
              + (long)millisecond * 10000;
    }

    public static DateTime MinValue => new DateTime(0);

    /// The last tick of 9999-12-31, which is .NET's limit and is therefore
    /// where a program's overflow checks are expected to fire.
    public static DateTime MaxValue => new DateTime(3155378975999999999);

    /// The epoch every wire protocol counts from, expressed in this one.
    public static DateTime UnixEpoch => new DateTime(621355968000000000);

    /// Windows' file time: hundreds of nanoseconds since 1601-01-01 UTC,
    /// which is this type's ticks less the ticks up to 1601.
    const long FileTimeOffset = 504911232000000000;

    public long ToFileTimeUtc() {
        if (ticks < FileTimeOffset) { throw new ArgumentOutOfRangeException("this", "the date is before 1601"); }
        return ticks - FileTimeOffset;
    }

    public static DateTime FromFileTimeUtc(long fileTime) {
        if (fileTime < 0 || fileTime > 3155378975999999999 - FileTimeOffset) { throw new ArgumentOutOfRangeException("fileTime"); }
        return new DateTime(fileTime + FileTimeOffset, DateTimeKind.Utc);
    }

    public long Ticks => ticks;

    private long WholeDays => ticks / 864000000000;

    public int Year => DateParts.YearOf(WholeDays);
    public int Month => DateParts.MonthOf(WholeDays);
    public int Day => DateParts.DayOf(WholeDays);

    public int Hour => (int)(ticks / 36000000000 % 24);
    public int Minute => (int)(ticks / 600000000 % 60);
    public int Second => (int)(ticks / 10000000 % 60);
    public int Millisecond => (int)(ticks / 10000 % 1000);

    /// Day 0 was a Monday: 0001-01-01 in the proleptic Gregorian calendar.
    public DayOfWeek DayOfWeek => (DayOfWeek)(int)((WholeDays + 1) % 7);

    public int DayOfYear => (int)(WholeDays - DateParts.DaysFrom(Year, 1, 1) + 1);

    /// Midnight of the same day, which is what .NET's Date property answers.
    public DateTime Date => new DateTime(WholeDays * 864000000000, kind);

    public TimeSpan TimeOfDay => new TimeSpan(ticks % 864000000000);

    public DateTime AddTicks(long value) { return new DateTime(ticks + value, kind); }
    public DateTime AddMilliseconds(double value) { return AddTicks((long)(value * 10000.0)); }
    public DateTime AddSeconds(double value) { return AddTicks((long)(value * 10000000.0)); }
    public DateTime AddMinutes(double value) { return AddTicks((long)(value * 600000000.0)); }
    public DateTime AddHours(double value) { return AddTicks((long)(value * 36000000000.0)); }
    public DateTime AddDays(double value) { return AddTicks((long)(value * 864000000000.0)); }
    public DateTime Add(TimeSpan span) { return AddTicks(span.Ticks); }

    /// THE DAY IS CLAMPED TO THE MONTH IT LANDS IN, which is .NET's rule and
    /// the only one that does not produce the 31st of February: the 31st of
    /// January plus one month is the 28th or 29th.
    public DateTime AddMonths(int count) {
        int months = (Year * 12 + Month - 1) + count;
        int year = months / 12;
        int month = months % 12 + 1;
        int day = Day;
        int limit = DateTime.DaysInMonth(year, month);

        if (day > limit) { day = limit; }
        return new DateTime(year, month, day, Hour, Minute, Second, Millisecond, kind);
    }

    public DateTime AddYears(int count) { return AddMonths(count * 12); }

    public TimeSpan Subtract(DateTime other) { return new TimeSpan(ticks - other.Ticks); }
    public DateTime Subtract(TimeSpan span) { return AddTicks(-span.Ticks); }

    public int CompareTo(DateTime other) {
        if (ticks < other.Ticks) { return -1; }
        if (ticks > other.Ticks) { return 1; }
        return 0;
    }

    public bool Equals(DateTime other) { return ticks == other.Ticks; }

    // ---- the operators C# writes ----------------------------------------
    //
    // ONE DATE MINUS ANOTHER IS A LENGTH OF TIME, and a date plus a length is
    // another date: the two subtractions are different operations with
    // different result types, which is exactly why they are operators in .NET
    // rather than one Subtract.

    public static TimeSpan operator -(DateTime a, DateTime b) { return new TimeSpan(a.Ticks - b.Ticks); }
    public static DateTime operator +(DateTime a, TimeSpan span) { return new DateTime(a.Ticks + span.Ticks, a.Kind); }
    public static DateTime operator -(DateTime a, TimeSpan span) { return new DateTime(a.Ticks - span.Ticks, a.Kind); }

    public static bool operator ==(DateTime a, DateTime b) { return a.Ticks == b.Ticks; }
    public static bool operator !=(DateTime a, DateTime b) { return a.Ticks != b.Ticks; }
    public static bool operator <(DateTime a, DateTime b) { return a.Ticks < b.Ticks; }
    public static bool operator >(DateTime a, DateTime b) { return a.Ticks > b.Ticks; }
    public static bool operator <=(DateTime a, DateTime b) { return a.Ticks <= b.Ticks; }
    public static bool operator >=(DateTime a, DateTime b) { return a.Ticks >= b.Ticks; }

    public static int Compare(DateTime a, DateTime b) { return a.CompareTo(b); }

    // ---- text back into a moment -----------------------------------------
    //
    // WHAT IS ACCEPTED: the shapes this library WRITES, which is the contract
    // that matters -- a date written by ToString("o"), ToString("s"),
    // ToString("u") or ToString() reads back as the same moment. That is
    // "yyyy-MM-dd", with an optional time after a 'T' or a space, an optional
    // fraction, an optional trailing 'Z', and the invariant "MM/dd/yyyy" with
    // the same. .NET's Parse accepts a great deal more, all of it cultural.

    public static DateTime Parse(string text) {
        DateTime made = DateTime.MinValue;

        if (!TryParse(text, out made)) {
            throw new FormatException(String.Concat("The string '",
                String.Concat(text, "' was not recognized as a valid DateTime.")));
        }
        return made;
    }

    public static bool TryParse(string? text, out DateTime value) {
        // .NET's answer for no string at all: false, and the default.
        if (text is null) { value = default; return false; }
        value = DateTime.MinValue;
        if (text == null) { return false; }

        string rest = String.Trim(text);

        if (rest.Length == 0) { return false; }

        if (Sys.GetChar(rest, rest.Length - 1) == (int)'Z') {
            rest = String.Substring(rest, 0, rest.Length - 1);
        }

        string datePart = rest;
        string timePart = "";
        int split = String.IndexOf(rest, 'T');

        if (split < 0) { split = String.IndexOf(rest, ' '); }
        if (split >= 0) {
            datePart = String.Substring(rest, 0, split);
            timePart = String.Substring(rest, split + 1, rest.Length - split - 1);
        }

        int year = 0;
        int month = 0;
        int day = 0;

        if (String.IndexOf(datePart, '-') >= 0) {
            string[] parts = String.Split(datePart, '-');

            if (parts.Length != 3) { return false; }
            if (!Int32.TryParse(parts[0], out year) || !Int32.TryParse(parts[1], out month)
                || !Int32.TryParse(parts[2], out day)) { return false; }
        } else if (String.IndexOf(datePart, '/') >= 0) {
            string[] parts = String.Split(datePart, '/');

            if (parts.Length != 3) { return false; }
            if (!Int32.TryParse(parts[0], out month) || !Int32.TryParse(parts[1], out day)
                || !Int32.TryParse(parts[2], out year)) { return false; }
        } else {
            return false;
        }

        if (month < 1 || month > 12 || day < 1 || day > DaysInMonth(year, month)) { return false; }

        long ticks = DateParts.DaysFrom(year, month, day) * 864000000000;

        if (timePart.Length > 0) {
            long inDay = 0;

            if (!DateParts.TryTime(timePart, out inDay)) { return false; }
            ticks = ticks + inDay;
        }
        value = new DateTime(ticks);
        return true;
    }

    public static bool IsLeapYear(int year) {
        return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    }

    public static int DaysInMonth(int year, int month) {
        if (month == 2) { return IsLeapYear(year) ? 29 : 28; }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    /// The INVARIANT default, which is "MM/dd/yyyy HH:mm:ss" -- .NET's own,
    /// and not a shape anybody would choose; it is here because that is what a
    /// program that prints a date without saying how gets there.
    public string ToString() { return ToString("MM/dd/yyyy HH:mm:ss"); }

    /// A CUSTOM PICTURE: yyyy, yy, MM, M, dd, d, HH, H, mm, m, ss, s, fff, and
    /// anything else copied through. .NET's standard single-letter formats
    /// ("d", "G", "o") are not here -- a single letter in a picture means the
    /// field, which is the ambiguity .NET resolves with a rule nobody
    /// remembers.
    /// A SINGLE LETTER IS A STANDARD FORMAT, not a one-letter picture, which is
    /// .NET's rule: "d" is the short date and not the day of the month. The
    /// pictures below need two characters or more, and every program that
    /// writes `ToString("yyyy-MM-dd")` is already writing one.
    ///
    /// The shapes are the INVARIANT culture's, which is the only culture this
    /// machine has.
    private static string Standard(char kind) {
        if (kind == 'd') { return "MM/dd/yyyy"; }
        if (kind == 'D') { return "dddd, dd MMMM yyyy"; }
        if (kind == 'f') { return "dddd, dd MMMM yyyy HH:mm"; }
        if (kind == 'F') { return "dddd, dd MMMM yyyy HH:mm:ss"; }
        if (kind == 'g') { return "MM/dd/yyyy HH:mm"; }
        if (kind == 'G') { return "MM/dd/yyyy HH:mm:ss"; }
        if (kind == 'm' || kind == 'M') { return "MMMM dd"; }
        if (kind == 'o' || kind == 'O') { return "yyyy-MM-ddTHH:mm:ss.fffffff"; }
        if (kind == 'r' || kind == 'R') { return "ddd, dd MMM yyyy HH:mm:ss 'GMT'"; }
        if (kind == 's') { return "yyyy-MM-ddTHH:mm:ss"; }
        if (kind == 't') { return "HH:mm"; }
        if (kind == 'T') { return "HH:mm:ss"; }
        // LOCAL TIME IS UTC on this machine, so "u" and "U" are the same
        // moment written two ways rather than two moments.
        if (kind == 'u') { return "yyyy-MM-dd HH:mm:ssZ"; }
        if (kind == 'U') { return "dddd, dd MMMM yyyy HH:mm:ss"; }
        if (kind == 'y' || kind == 'Y') { return "yyyy MMMM"; }
        throw new FormatException("Input string was not in a correct format.");
    }

    public string ToString(string format) {
        if (format.Length == 1) { return ToString(Standard(Sys.GetChar(format, 0))); }

        StringBuilder made = new StringBuilder();
        int at = 0;

        while (at < format.Length) {
            char c = Sys.GetChar(format, at);

            // QUOTED TEXT IS ITSELF, letters and all, which is how "GMT" gets
            // into the R format without its M becoming a month. .NET's escape,
            // and the single quote is the one that does it.
            if (c == '\'') {
                int close = String.IndexOf(format, '\'', at + 1);
                int end = close < 0 ? format.Length : close;

                made.Append(String.Substring(format, at + 1, end - at - 1));
                at = end + 1;
                continue;
            }

            if (c == '\\' && at + 1 < format.Length) {
                made.Append(Sys.GetChar(format, at + 1));
                at = at + 2;
                continue;
            }

            int run = 1;

            while (at + run < format.Length && Sys.GetChar(format, at + run) == (int)c) {
                run = run + 1;
            }

            if (c == 'y') { made.Append(Field(run >= 4 ? Year : Year % 100, run)); }
            else if (c == 'M' && run >= 4) { made.Append(DateParts.MonthName(Month)); }
            else if (c == 'M' && run == 3) { made.Append(String.Substring(DateParts.MonthName(Month), 0, 3)); }
            else if (c == 'M') { made.Append(Field(Month, run)); }
            else if (c == 'd' && run >= 4) { made.Append(DateParts.DayName((int)DayOfWeek)); }
            else if (c == 'd' && run == 3) { made.Append(String.Substring(DateParts.DayName((int)DayOfWeek), 0, 3)); }
            else if (c == 'd') { made.Append(Field(Day, run)); }
            else if (c == 'h') { made.Append(Field(Hour % 12 == 0 ? 12 : Hour % 12, run)); }
            else if (c == 't' && run >= 2) { made.Append(Hour < 12 ? "AM" : "PM"); }
            else if (c == 't') { made.Append(Hour < 12 ? "A" : "P"); }
            else if (c == 'H') { made.Append(Field(Hour, run)); }
            else if (c == 'm') { made.Append(Field(Minute, run)); }
            else if (c == 's') { made.Append(Field(Second, run)); }
            else if (c == 'f') {
                // A RUN OF f's IS A FRACTION OF A SECOND, as many digits as
                // there are letters: "fff" is milliseconds and "fffffff" is
                // the whole tick, which is what "o" prints.
                long fraction = ticks % 10000000;
                string digits = String.PadLeft(String.FromInt(fraction), 7, '0');

                made.Append(String.Substring(digits, 0, run > 7 ? 7 : run));
            }
            else { made.Append(c, run); }

            at = at + run;
        }
        return made.ToString();
    }

    private static string Field(int value, int width) {
        return String.PadLeft(String.FromInt(value), width, '0');
    }
}

/// THE CALENDAR ARITHMETIC, in one place, because converting a day number to a
/// year and back is the part that is easy to get subtly wrong and impossible
/// to notice: an off-by-one in a leap year shows up once every four years.
///
/// The algorithm is Howard Hinnant's days-from-civil and its inverse. It shifts
/// the year so that it begins in March, which puts the leap day at the END of
/// the year -- and that one change removes every special case from what is
/// otherwise a thicket of them.
/// A MOMENT AND THE OFFSET IT WAS WRITTEN IN. A DateTime says what the clock
/// read; a DateTimeOffset says that AND how far that clock was from UTC, which
/// is the difference between "half past one" and a point in time. Anything
/// that stores or transmits a timestamp wants this one.
///
/// Ticks is the LOCAL reading and UtcTicks is the moment: subtracting the
/// offset is what turns one into the other, and .NET's members are named so
/// that a caller has to say which they meant.
partial struct DateTimeOffset {
    private long ticks;    // the local reading
    private long offset;   // ticks east of UTC

    public DateTimeOffset(DateTime when, TimeSpan from) {
        ticks = when.Ticks;
        offset = from.Ticks;
    }

    public DateTimeOffset(long inTicks, TimeSpan from) {
        ticks = inTicks;
        offset = from.Ticks;
    }

    // UtcNow and Now ARE NOT HERE. They read a clock, and a clock is the
    // platform's: DateTime's are in lib/io.cor, next to the Os call they
    // make, and DateTimeOffset's are beside them for the same reason. A
    // freestanding build -- the kernel -- has this file and not that one.

    public static DateTimeOffset MinValue => new DateTimeOffset(DateTime.MinValue, TimeSpan.Zero);
    public static DateTimeOffset MaxValue => new DateTimeOffset(DateTime.MaxValue, TimeSpan.Zero);
    public static DateTimeOffset UnixEpoch => new DateTimeOffset(DateTime.UnixEpoch, TimeSpan.Zero);

    public TimeSpan Offset => new TimeSpan(offset);

    /// THE CLOCK READING, with no offset attached -- which is what .NET's
    /// DateTime property gives and why it is not the same instant as
    /// UtcDateTime unless the offset is zero.
    public DateTime DateTime => new DateTime(ticks);

    public DateTime UtcDateTime => new DateTime(ticks - offset, DateTimeKind.Utc);

    public long Ticks => ticks;
    public long UtcTicks => ticks - offset;

    public int Year => DateTime.Year;
    public int Month => DateTime.Month;
    public int Day => DateTime.Day;
    public int Hour => DateTime.Hour;
    public int Minute => DateTime.Minute;
    public int Second => DateTime.Second;
    public int Millisecond => DateTime.Millisecond;
    public DayOfWeek DayOfWeek => DateTime.DayOfWeek;
    public int DayOfYear => DateTime.DayOfYear;
    /// A DateTime, not a DateOnly -- .NET's DateTimeOffset.Date is midnight of
    /// the day as a DateTime, which is also what keeps this file free of
    /// anything declared outside it.
    public DateTime Date => DateTime.Date;
    public TimeSpan TimeOfDay => DateTime.TimeOfDay;

    /// SECONDS SINCE 1970, which is what every wire protocol counts in. The
    /// UTC moment, not the local reading -- the whole point of the type.
    public long ToUnixTimeSeconds() { return (UtcTicks - 621355968000000000) / 10000000; }
    public long ToUnixTimeMilliseconds() { return (UtcTicks - 621355968000000000) / 10000; }

    public static DateTimeOffset FromUnixTimeSeconds(long seconds) {
        return new DateTimeOffset(new DateTime(621355968000000000 + seconds * 10000000), TimeSpan.Zero);
    }

    public static DateTimeOffset FromUnixTimeMilliseconds(long milliseconds) {
        return new DateTimeOffset(new DateTime(621355968000000000 + milliseconds * 10000), TimeSpan.Zero);
    }

    public DateTimeOffset AddTicks(long value) { return new DateTimeOffset(ticks + value, Offset); }
    public DateTimeOffset Add(TimeSpan span) { return AddTicks(span.Ticks); }
    public DateTimeOffset AddSeconds(double value) { return AddTicks((long)(value * 10000000.0)); }
    public DateTimeOffset AddMinutes(double value) { return AddTicks((long)(value * 600000000.0)); }
    public DateTimeOffset AddHours(double value) { return AddTicks((long)(value * 36000000000.0)); }
    public DateTimeOffset AddDays(double value) { return AddTicks((long)(value * 864000000000.0)); }
    public DateTimeOffset AddMonths(int count) { return new DateTimeOffset(DateTime.AddMonths(count), Offset); }
    public DateTimeOffset AddYears(int count) { return new DateTimeOffset(DateTime.AddYears(count), Offset); }

    /// COMPARED AS INSTANTS, which is what makes two readings of different
    /// clocks comparable at all: the same moment written in two offsets is
    /// equal here and would not be as DateTimes.
    public int CompareTo(DateTimeOffset other) {
        if (UtcTicks < other.UtcTicks) { return -1; }
        if (UtcTicks > other.UtcTicks) { return 1; }
        return 0;
    }

    public bool Equals(DateTimeOffset other) { return UtcTicks == other.UtcTicks; }

    public static TimeSpan operator -(DateTimeOffset a, DateTimeOffset b) {
        return new TimeSpan(a.UtcTicks - b.UtcTicks);
    }

    public static DateTimeOffset operator +(DateTimeOffset a, TimeSpan span) { return a.Add(span); }
    public static DateTimeOffset operator -(DateTimeOffset a, TimeSpan span) { return a.AddTicks(-span.Ticks); }

    public static bool operator ==(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks == b.UtcTicks; }
    public static bool operator !=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks != b.UtcTicks; }
    public static bool operator <(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks < b.UtcTicks; }
    public static bool operator >(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks > b.UtcTicks; }
    public static bool operator <=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks <= b.UtcTicks; }
    public static bool operator >=(DateTimeOffset a, DateTimeOffset b) { return a.UtcTicks >= b.UtcTicks; }

    /// "MM/dd/yyyy HH:mm:ss zzz", which is what .NET prints for one with no
    /// format asked for -- the offset is part of the value and so part of the
    /// text.
    public string ToString() { return String.Concat(DateTime.ToString("MM/dd/yyyy HH:mm:ss "), Zone()); }

    public string ToString(string format) {
        if (format.Length == 1 && (Sys.GetChar(format, 0) == 'o' || Sys.GetChar(format, 0) == 'O')) {
            return String.Concat(DateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffffff"), Zone());
        }
        return DateTime.ToString(format);
    }

    /// The offset as +hh:mm or -hh:mm, which is the "zzz" of a picture.
    private string Zone() {
        long size = offset < 0 ? -offset : offset;
        StringBuilder made = new StringBuilder();

        made.Append(offset < 0 ? '-' : '+');
        made.Append(String.PadLeft(String.FromInt(size / 36000000000), 2, '0'));
        made.Append(':');
        made.Append(String.PadLeft(String.FromInt(size / 600000000 % 60), 2, '0'));
        return made.ToString();
    }
}

static class DateParts {
    /// THE INVARIANT CULTURE'S NAMES, which are the English ones -- and the
    /// only ones this machine has. .NET spells them in DateTimeFormatInfo; a
    /// program asking a date to write itself as "dddd" arrives here.
    public static string MonthName(int month) {
        if (month == 1) { return "January"; }
        if (month == 2) { return "February"; }
        if (month == 3) { return "March"; }
        if (month == 4) { return "April"; }
        if (month == 5) { return "May"; }
        if (month == 6) { return "June"; }
        if (month == 7) { return "July"; }
        if (month == 8) { return "August"; }
        if (month == 9) { return "September"; }
        if (month == 10) { return "October"; }
        if (month == 11) { return "November"; }
        return "December";
    }

    /// "HH:mm", "HH:mm:ss" or "HH:mm:ss.fffffff", as ticks into the day.
    public static bool TryTime(string text, out long ticks) {
        ticks = 0;

        string rest = text;
        long fraction = 0;
        int dot = String.IndexOf(rest, '.');

        if (dot >= 0) {
            string digits = String.Substring(rest, dot + 1, rest.Length - dot - 1);

            rest = String.Substring(rest, 0, dot);

            if (digits.Length > 7) { digits = String.Substring(digits, 0, 7); }

            long scaled = 0;

            if (!Int64.TryParse(digits, out scaled)) { return false; }
            for (int i = digits.Length; i < 7; i++) { scaled = scaled * 10; }
            fraction = scaled;
        }

        string[] parts = String.Split(rest, ':');

        if (parts.Length < 2 || parts.Length > 3) { return false; }

        int hour = 0;
        int minute = 0;
        int second = 0;

        if (!Int32.TryParse(parts[0], out hour) || !Int32.TryParse(parts[1], out minute)) { return false; }
        if (parts.Length == 3 && !Int32.TryParse(parts[2], out second)) { return false; }
        if (hour > 23 || minute > 59 || second > 59) { return false; }

        ticks = ((long)hour * 3600 + (long)minute * 60 + (long)second) * 10000000 + fraction;
        return true;
    }

    public static string DayName(int day) {
        if (day == 0) { return "Sunday"; }
        if (day == 1) { return "Monday"; }
        if (day == 2) { return "Tuesday"; }
        if (day == 3) { return "Wednesday"; }
        if (day == 4) { return "Thursday"; }
        if (day == 5) { return "Friday"; }
        return "Saturday";
    }

    /// Days from 0001-01-01, which is day 0.
    public static long DaysFrom(int year, int month, int day) {
        long y = year;
        long m = month;

        // March-based year: January and February belong to the year before.
        y = m <= 2 ? y - 1 : y;

        long era = (y >= 0 ? y : y - 399) / 400;
        long yearOfEra = y - era * 400;                       // [0, 399]
        long dayOfYear = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + day - 1;
        long dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;

        // 719162 days from 0001-01-01 to 1970-01-01, and 719468 from the
        // algorithm's own epoch of 0000-03-01 to it: the difference is the
        // offset from that epoch to this one.
        return era * 146097 + dayOfEra - 306;
    }

    private static long Civil(long days, out long month, out long day) {
        long z = days + 306;
        long era = (z >= 0 ? z : z - 146096) / 146097;
        long dayOfEra = z - era * 146097;                     // [0, 146096]
        long yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;
        long y = yearOfEra + era * 400;
        long dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
        long mp = (5 * dayOfYear + 2) / 153;                  // [0, 11], March is 0

        day = dayOfYear - (153 * mp + 2) / 5 + 1;
        month = mp + (mp < 10 ? 3 : -9);
        return month <= 2 ? y + 1 : y;
    }

    public static int YearOf(long days) {
        long month = 0;
        long day = 0;
        return (int)Civil(days, out month, out day);
    }

    public static int MonthOf(long days) {
        long month = 0;
        long day = 0;
        Civil(days, out month, out day);
        return (int)month;
    }

    public static int DayOf(long days) {
        long month = 0;
        long day = 0;
        Civil(days, out month, out day);
        return (int)day;
    }
}

// ---- Maths ----------------------------------------------------------------
// Sqrt, Abs, Floor, Ceil, Round, Trunc, Min, Max and Fma are instructions.
// Everything below is written HERE, in software, deliberately: a hardware
// transcendental differs between implementations, and two machines disagreeing
// about the cosine of the same angle is a bug nobody can find. These are the
// same on every machine because they are the same code.

/// WHICH WAY A HALF GOES. .NET's enum, with .NET's numbers, because a program
/// that says MidpointRounding.AwayFromZero is naming the value 1 and the two
/// sides have to agree on which that is.
enum MidpointRounding {
    ToEven = 0,
    AwayFromZero = 1,
    ToZero = 2,
    ToNegativeInfinity = 3,
    ToPositiveInfinity = 4,
}

static class Math {
    public static int Min(int a, int b) { if (a < b) { return a; } return b; }
    public static int Max(int a, int b) { if (a > b) { return a; } return b; }
    public static long Min(long a, long b) { if (a < b) { return a; } return b; }
    public static long Max(long a, long b) { if (a > b) { return a; } return b; }

    /// THE UNSIGNED PAIRS, which .NET has and which are not the signed ones
    /// with a cast: 0x80000000 is bigger than 1 as a uint and smaller as an
    /// int, so an alignment compared through the signed overload picks the
    /// wrong one.
    public static uint Min(uint a, uint b) { if (a < b) { return a; } return b; }
    public static uint Max(uint a, uint b) { if (a > b) { return a; } return b; }
    public static ulong Min(ulong a, ulong b) { if (a < b) { return a; } return b; }
    public static ulong Max(ulong a, ulong b) { if (a > b) { return a; } return b; }
    public static nint Min(nint a, nint b) { if (a < b) { return a; } return b; }
    public static nint Max(nint a, nint b) { if (a > b) { return a; } return b; }
    public static nuint Min(nuint a, nuint b) { if (a < b) { return a; } return b; }
    public static nuint Max(nuint a, nuint b) { if (a > b) { return a; } return b; }
    public static double Pi() { return 3.14159265358979323846; }
    public static double Tau() { return 6.28318530717958647692; }

    /// AN INT, not a double: .NET's Math.Sign answers -1, 0 or 1 whatever the
    /// argument's type, because what it reports is a direction and not a
    /// magnitude.
    public static int Sign(double x) {
        if (x > 0.0) { return 1; }
        if (x < 0.0) { return -1; }
        return 0;
    }

    public static int Sign(float x) { return Sign((double)x); }

    public static double Clamp(double x, double low, double high) {
        return Math.Min(Math.Max(x, low), high);
    }

    public static double Lerp(double a, double b, double t) {
        return Math.Fma(b - a, t, a);
    }

    // Wraps an angle into [-pi, pi], where the polynomials below are accurate.
    public static double WrapAngle(double x) {
        double turns = Math.Floor((x + Pi()) / Tau());
        return x - turns * Tau();
    }

    // Minimax-style polynomial on the reduced range. Seven terms of the Taylor
    // series is well past double precision for |x| <= pi.
    public static double Sin(double x) {
        double a = WrapAngle(x);
        double sq = a * a;
        double term = a;
        double sum = a;

        term = 0.0 - term * sq / 6.0;             sum = sum + term;
        term = 0.0 - term * sq / 20.0;            sum = sum + term;
        term = 0.0 - term * sq / 42.0;            sum = sum + term;
        term = 0.0 - term * sq / 72.0;            sum = sum + term;
        term = 0.0 - term * sq / 110.0;           sum = sum + term;
        term = 0.0 - term * sq / 156.0;           sum = sum + term;
        return sum;
    }

    public static double Cos(double x) { return Sin(x + Pi() / 2.0); }

    public static double Tan(double x) { return Sin(x) / Cos(x); }

    public static double Pow(double x, int n) {
        // Exponentiation by squaring: log(n) multiplies instead of n.
        double result = 1.0;
        double baseValue = x;
        int e = n;

        if (e < 0) { e = 0 - e; }

        while (e > 0) {
            if ((e & 1) == 1) { result = result * baseValue; }
            baseValue = baseValue * baseValue;
            e = e >> 1;
        }

        if (n < 0) { return 1.0 / result; }
        return result;
    }

    /// e TO A POWER, by splitting the exponent into a whole number of halvings
    /// and a remainder the series can reach.
    ///
    /// The series alone is only accurate near zero: seventeen terms of it are
    /// nothing like enough for exp(20), and the answer silently loses digits.
    /// Writing x as k*ln2 + r, with |r| below half a ln2, makes the series job
    /// easy and leaves a power of two to multiply by -- which is exact.
    public static double Exp(double x) {
        if (x != x) { return x; }

        double ln2 = 0.69314718055994530942;
        double k = Math.Round(x / ln2);
        double r = x - k * ln2;

        double sum = 1.0;
        double term = 1.0;

        for (int i = 1; i < 18; i++) {
            term = term * r / (double)i;
            sum = sum + term;
        }
        return sum * Pow(2.0, (int)k);
    }

    public static long AbsInt(long x) {
        if (x < 0) { return 0 - x; }
        return x;
    }

    public static long MinInt(long a, long b) { if (a < b) { return a; } return b; }
    public static long MaxInt(long a, long b) { if (a > b) { return a; } return b; }
    public static long ClampInt(long x, long low, long high) { return MinInt(MaxInt(x, low), high); }

    // ---- the names .NET uses --------------------------------------------
    //
    // The machine's rounding instructions are called Ceil and Trunc and the
    // library's absolute value for integers was called AbsInt, so a C# program
    // saying Math.Ceiling or Math.Abs found nothing. These are the same
    // operations under the names a caller writes.

    public static double Ceiling(double x) { return Math.Ceil(x); }
    public static double Truncate(double x) { return Math.Trunc(x); }

    public static int Abs(int x) { if (x < 0) { return -x; } return x; }
    public static long Abs(long x) { if (x < 0) { return -x; } return x; }

    public static int Sign(int x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Sign(long x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Clamp(int x, int low, int high) { return Min(Max(x, low), high); }
    public static long Clamp(long x, long low, long high) { return Min(Max(x, low), high); }

    // TO THE EVEN NEIGHBOUR AT A HALF, which is .NET's DEFAULT and the half
    // everybody gets wrong: Math.Round(2.5) is 2 and Math.Round(3.5) is 4. The
    // rule exists because always rounding a half upwards biases a long column
    // of figures upwards, and banking noticed. The other rules are asked for
    // by name, with MidpointRounding.
    public static double Round(double x, int digits) {
        return Round(x, digits, MidpointRounding.ToEven);
    }

    public static double Round(double x, MidpointRounding mode) {
        return Round(x, 0, mode);
    }

    public static double Round(double x, int digits, MidpointRounding mode) {
        double scale = 1.0;
        for (int i = 0; i < digits; i++) { scale = scale * 10.0; }

        double scaled = x * scale;
        double whole = 0.0;

        if (mode == MidpointRounding.AwayFromZero) {
            whole = scaled < 0.0 ? Math.Ceil(scaled - 0.5) : Math.Floor(scaled + 0.5);
        } else if (mode == MidpointRounding.ToZero) {
            whole = Math.Trunc(scaled);
        } else if (mode == MidpointRounding.ToNegativeInfinity) {
            whole = Math.Floor(scaled);
        } else if (mode == MidpointRounding.ToPositiveInfinity) {
            whole = Math.Ceil(scaled);
        } else {
            whole = Math.Round(scaled);
        }
        return whole / scale;
    }

    /// x to a real power, which the integer overload above cannot do: the
    /// squaring trick needs a whole number of multiplications.
    public static double Pow(double x, double y) {
        if (y == 0.0) { return 1.0; }
        if (x == 0.0) { return 0.0; }
        return Exp(y * Log(x));
    }

    /// THE NATURAL LOGARITHM, by the series that converges everywhere rather
    /// than the one that only converges near 1.
    ///
    /// The argument is first split into a power of two and a remainder in
    /// [1, 2), because the series in (x-1)/(x+1) converges quickly only on a
    /// narrow range and a number can be any size at all.
    public static double Log(double x) {
        if (x <= 0.0) { return 0.0 / 0.0; }

        int power = 0;
        double v = x;

        while (v >= 2.0) {
            v = v / 2.0;
            power = power + 1;
        }
        while (v < 1.0) {
            v = v * 2.0;
            power = power - 1;
        }

        // atanh's series: 2 * sum of z^(2k+1)/(2k+1), with z = (v-1)/(v+1),
        // which is at most 1/3 over [1, 2) and so needs few terms.
        double z = (v - 1.0) / (v + 1.0);
        double sq = z * z;
        double term = z;
        double sum = z;

        for (int k = 1; k < 20; k++) {
            term = term * sq;
            sum = sum + term / (double)(2 * k + 1);
        }
        return 2.0 * sum + (double)power * 0.69314718055994530942;
    }

    public static double Log10(double x) { return Log(x) / 2.30258509299404568402; }
    public static double Log2(double x) { return Log(x) / 0.69314718055994530942; }
    public static double Log(double x, double newBase) { return Log(x) / Log(newBase); }

    // ---- the rest of System.Math -----------------------------------------
    //
    // Software, because the 486 this targets may have no floating-point unit
    // at all and the ones it does have stop at square root. Each is the
    // identity a table of logarithms was built on, which is what makes them
    // short: the hard part is always the range reduction, never the series.

    /// THE WHOLE QUOTIENT AND WHAT IS LEFT, in one division. A processor
    /// computes both at once and .NET exposes that; two separate operations is
    /// twice the work for the same answer.
    public static int DivRem(int a, int b, out int remainder) {
        int whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    public static long DivRem(long a, long b, out long remainder) {
        long whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    /// The FULL product of two ints, which does not fit in an int: multiplying
    /// two numbers near a billion is the commonest overflow there is.
    public static long BigMul(int a, int b) { return (long)a * (long)b; }

    public static double Cbrt(double x) {
        if (x == 0.0) { return 0.0; }

        bool negative = x < 0.0;
        double size = negative ? -x : x;
        double guess = Exp(Log(size) / 3.0);

        // Two steps of Newton on g^3 = size, which cleans up whatever the
        // logarithm and the exponential lost between them.
        guess = guess - (guess * guess * guess - size) / (3.0 * guess * guess);
        guess = guess - (guess * guess * guess - size) / (3.0 * guess * guess);
        return negative ? -guess : guess;
    }

    /// ARCTANGENT, on a range the series can actually reach.
    ///
    /// The series in x converges everywhere below 1 and hopelessly slowly near
    /// it, so the argument is folded twice: anything above 1 by the reciprocal
    /// identity, and anything above tan(pi/8) by the half-angle one. What is
    /// left is under 0.415, where thirty terms is past double precision.
    public static double Atan(double x) {
        if (x != x) { return x; }

        bool negative = x < 0.0;
        double size = negative ? -x : x;
        double made = 0.0;

        if (size > 1.0) {
            made = Pi() / 2.0 - AtanSmall(1.0 / size);
        } else {
            made = AtanSmall(size);
        }
        return negative ? -made : made;
    }

    private static double AtanSmall(double x) {
        if (x > 0.41421356237309504880) {
            return Pi() / 4.0 + AtanSeries((x - 1.0) / (x + 1.0));
        }
        return AtanSeries(x);
    }

    private static double AtanSeries(double x) {
        double sq = x * x;
        double term = x;
        double sum = x;

        for (int k = 1; k < 30; k++) {
            term = -term * sq;
            sum = sum + term / (double)(2 * k + 1);
        }
        return sum;
    }

    /// THE ANGLE OF A POINT, quadrant and all, which is why it takes the two
    /// coordinates rather than their ratio: y/x has thrown away the difference
    /// between the first quadrant and the third. .NET's answer is in
    /// (-pi, pi].
    public static double Atan2(double y, double x) {
        if (x > 0.0) { return Atan(y / x); }
        if (x < 0.0) { return y >= 0.0 ? Atan(y / x) + Pi() : Atan(y / x) - Pi(); }
        if (y > 0.0) { return Pi() / 2.0; }
        if (y < 0.0) { return 0.0 - Pi() / 2.0; }
        return 0.0;
    }

    /// OUTSIDE [-1, 1] IS NOT AN ANGLE, and .NET answers NaN rather than
    /// throwing -- the caller's arithmetic went wrong, not the call.
    public static double Asin(double x) {
        if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
        if (x == 1.0) { return Pi() / 2.0; }
        if (x == -1.0) { return 0.0 - Pi() / 2.0; }
        return Atan(x / Sqrt(1.0 - x * x));
    }

    public static double Acos(double x) {
        if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
        return Pi() / 2.0 - Asin(x);
    }

    public static double Sinh(double x) {
        double up = Exp(x);

        return (up - 1.0 / up) / 2.0;
    }

    public static double Cosh(double x) {
        double up = Exp(x);

        return (up + 1.0 / up) / 2.0;
    }

    /// Through exp(2x) rather than as sinh over cosh: the two exponentials of
    /// the obvious form both overflow long before their ratio does.
    public static double Tanh(double x) {
        if (x > 20.0) { return 1.0; }
        if (x < -20.0) { return -1.0; }

        double both = Exp(2.0 * x);

        return (both - 1.0) / (both + 1.0);
    }

    /// THE IEEE REMAINDER, which is NOT the `%` operator: it takes the NEAREST
    /// multiple rather than the one towards zero, so its result can be
    /// negative where x is positive. Anything reducing an angle wants this one.
    public static double IEEERemainder(double x, double y) {
        double quotient = Math.Round(x / y);

        return x - y * quotient;
    }

    /// The magnitude of the first with the sign of the second, which is the
    /// only way to move a sign about that does not go wrong at zero.
    public static double CopySign(double x, double y) {
        double size = x < 0.0 ? -x : x;

        return y < 0.0 ? -size : size;
    }

    /// THE ONE FURTHER FROM ZERO, sign kept -- not the larger. MaxMagnitude(-5,
    /// 3) is -5, which is what makes it useful for scaling and surprising for
    /// everything else.
    public static double MaxMagnitude(double x, double y) {
        double a = x < 0.0 ? -x : x;
        double b = y < 0.0 ? -y : y;

        if (a > b) { return x; }
        if (b > a) { return y; }
        return x > y ? x : y;
    }

    public static double MinMagnitude(double x, double y) {
        double a = x < 0.0 ? -x : x;
        double b = y < 0.0 ? -y : y;

        if (a < b) { return x; }
        if (b < a) { return y; }
        return x < y ? x : y;
    }

    // .NET spells its two constants as fields. The methods above were the only
    // way to say them here, and `Math.PI` is what a program writes. There is no
    // `Tau` field because `Tau()` above is a method of that name already, and
    // renaming it would break what calls it.
    public static double PI => 3.14159265358979323846;
    public static double E => 2.71828182845904523536;
}

namespace System.Collections.ObjectModel
{
    /// .NET's read-only wrapper: a view onto a list that cannot change it. It
    /// reads through, so what the list gains afterwards is seen here; as an
    /// IList it answers IsReadOnly and refuses every change with
    /// NotSupportedException.
    public class ReadOnlyCollection<T> : IList<T>, IReadOnlyList<T>, IEnumerable<T>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        private readonly IList<T> list;

        public ReadOnlyCollection(IList<T> list)
        {
            ArgumentNullException.ThrowIfNull(list);
            this.list = list;
        }

        static readonly ReadOnlyCollection<T> _empty = new ReadOnlyCollection<T>(new List<T>());
        public static ReadOnlyCollection<T> Empty => _empty;

        public int Count => list.Count;

        public T this[int index] => list[index];

        /// The list it wraps.
        protected IList<T> Items => list;

        public bool Contains(T value) { return list.Contains(value); }

        public int IndexOf(T value) { return list.IndexOf(value); }

        public void CopyTo(T[] array, int index) { list.CopyTo(array, index); }

        public IEnumerator<T> GetEnumerator() { return list.GetEnumerator(); }

        bool ICollection<T>.IsReadOnly => true;

        T IList<T>.this[int index]
        {
            get { return list[index]; }
            set { throw ReadOnly(); }
        }

        void ICollection<T>.Add(T item) { throw ReadOnly(); }
        void ICollection<T>.Clear() { throw ReadOnly(); }
        bool ICollection<T>.Remove(T item) { throw ReadOnly(); }
        void IList<T>.Insert(int index, T item) { throw ReadOnly(); }
        void IList<T>.RemoveAt(int index) { throw ReadOnly(); }

        static NotSupportedException ReadOnly() { return new NotSupportedException("Collection is read-only."); }
    }
}

namespace System.Globalization
{
    /// The Unicode general category of a character, numbered as .NET numbers
    /// it -- the runtime's UnicodeCategories table answers in these numbers.
    public enum UnicodeCategory
    {
        UppercaseLetter = 0,
        LowercaseLetter = 1,
        TitlecaseLetter = 2,
        ModifierLetter = 3,
        OtherLetter = 4,
        NonSpacingMark = 5,
        SpacingCombiningMark = 6,
        EnclosingMark = 7,
        DecimalDigitNumber = 8,
        LetterNumber = 9,
        OtherNumber = 10,
        SpaceSeparator = 11,
        LineSeparator = 12,
        ParagraphSeparator = 13,
        Control = 14,
        Format = 15,
        Surrogate = 16,
        PrivateUse = 17,
        ConnectorPunctuation = 18,
        DashPunctuation = 19,
        OpenPunctuation = 20,
        ClosePunctuation = 21,
        InitialQuotePunctuation = 22,
        FinalQuotePunctuation = 23,
        OtherPunctuation = 24,
        MathSymbol = 25,
        CurrencySymbol = 26,
        ModifierSymbol = 27,
        OtherSymbol = 28,
        OtherNotAssigned = 29,
    }
}

namespace System.Buffers
{
    /// How a span-to-span transcoding or parse ended.
    public enum OperationStatus
    {
        Done = 0,
        DestinationTooSmall = 1,
        NeedMoreData = 2,
        InvalidData = 3,
    }
}

namespace System.Text
{
    /// A decoder met bytes it could not turn into text, and was told to throw
    /// rather than put in a replacement character.
    public class DecoderFallbackException : ArgumentException
    {
        readonly byte[]? _bytesUnknown;
        readonly int _index;

        public DecoderFallbackException() : base("Value does not fall within the expected range.") { _index = -1; }

        public DecoderFallbackException(string? message) : base(message ?? "Value does not fall within the expected range.") { _index = -1; }

        public DecoderFallbackException(string? message, Exception? innerException)
            : base(message ?? "Value does not fall within the expected range.", innerException!) { _index = -1; }

        public DecoderFallbackException(string? message, byte[]? bytesUnknown, int index)
            : base(message ?? "Value does not fall within the expected range.")
        {
            _bytesUnknown = bytesUnknown;
            _index = index;
        }

        /// .NET's wording: the bytes in hex, in brackets, and where they were.
        public DecoderFallbackException(byte[] bytesUnknown, int index)
            : this(Describe(bytesUnknown, index), bytesUnknown, index)
        {
        }

        public byte[]? BytesUnknown => _bytesUnknown;

        public int Index => _index;

        static string Describe(byte[] bytes, int index)
        {
            string hex = "";
            for (int i = 0; i < bytes.Length; i++)
            {
                hex = hex + "[" + bytes[i].ToString("X2") + "]";
            }
            return "Unable to translate bytes " + hex + " at index " + index + " from specified code page to Unicode.";
        }
    }

    /// An encoder met a character it could not write, and was told to throw.
    public class EncoderFallbackException : ArgumentException
    {
        public EncoderFallbackException() : base("Value does not fall within the expected range.") { }

        public EncoderFallbackException(string? message) : base(message ?? "Value does not fall within the expected range.") { }

        public EncoderFallbackException(string? message, Exception? innerException)
            : base(message ?? "Value does not fall within the expected range.", innerException!) { }
    }
}

namespace System
{
    /// .NET 9's MemoryExtensions.SpanSplitEnumerator: the ranges of a span
    /// between its separators, one at a time, as `foreach (Range r in
    /// span.Split((byte)'/'))` walks them. An empty span gives one empty range,
    /// and each separator ends one, as .NET's does.
    public struct SpanSplitEnumerator<T> where T : IEquatable<T>
    {
        readonly ReadOnlySpan<T> _source;
        readonly ReadOnlySpan<T> _separators;
        readonly T _separator;
        readonly int _mode;          // 0 one element, 1 a whole sequence, 2 any of several
        int _start;
        int _end;
        bool _done;

        internal SpanSplitEnumerator(ReadOnlySpan<T> source, T separator)
        {
            _source = source; _separator = separator; _separators = default; _mode = 0;
            _start = 0; _end = -1; _done = false;
        }

        internal SpanSplitEnumerator(ReadOnlySpan<T> source, ReadOnlySpan<T> separators, bool any)
        {
            _source = source; _separator = default!; _separators = separators; _mode = any ? 2 : 1;
            _start = 0; _end = -1; _done = false;
        }

        public ReadOnlySpan<T> Source => _source;
        public Range Current => new Range(_start, _end);
        public SpanSplitEnumerator<T> GetEnumerator() { return this; }

        public bool MoveNext()
        {
            if (_done) { return false; }
            int from = _end < 0 ? 0 : _end + (_mode == 1 && _separators.Length > 0 ? _separators.Length : 1);
            if (_end < 0) { from = 0; }
            ReadOnlySpan<T> rest = _source.Slice(from);
            int at;
            if (_mode == 0) { at = rest.IndexOf(_separator); }
            else if (_mode == 2) { at = rest.IndexOfAny(_separators); }
            else { at = _separators.Length == 0 ? -1 : IndexOfSequence(rest, _separators); }
            _start = from;
            if (at < 0) { _end = _source.Length; _done = true; }
            else { _end = from + at; }
            return true;
        }

        static int IndexOfSequence(ReadOnlySpan<T> span, ReadOnlySpan<T> value)
        {
            for (int i = 0; i + value.Length <= span.Length; i++)
            {
                int k = 0;
                while (k < value.Length && span[i + k].Equals(value[k])) { k++; }
                if (k == value.Length) { return i; }
            }
            return -1;
        }
    }
}

namespace System.Text
{
    /// .NET 8's Ascii: ASCII text as bytes or chars, compared, cased, trimmed
    /// and converted without a string in between. Anything outside ASCII
    /// answers as .NET's does -- not equal, not valid, InvalidData -- so this is
    /// for protocol text (keywords, header names, configuration keys); names a
    /// person gave, in UTF-8, are compared as bytes with SequenceEqual.
    public static class Ascii
    {
        public static bool IsValid(byte value) { return value <= 0x7F; }
        public static bool IsValid(char value) { return value <= 0x7F; }

        public static bool IsValid(ReadOnlySpan<byte> value)
        {
            for (int i = 0; i < value.Length; i++) { if (value[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool IsValid(ReadOnlySpan<char> value)
        {
            for (int i = 0; i < value.Length; i++) { if (value[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<byte> left, ReadOnlySpan<byte> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<byte> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<char> left, ReadOnlySpan<byte> right) { return Equals(right, left); }

        public static bool Equals(ReadOnlySpan<char> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<byte> left, ReadOnlySpan<byte> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<byte> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<char> left, ReadOnlySpan<byte> right) { return EqualsIgnoreCase(right, left); }

        public static bool EqualsIgnoreCase(ReadOnlySpan<char> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        static int Lower(int c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
        static int Upper(int c) { return c >= 'a' && c <= 'z' ? c - 32 : c; }

        public static OperationStatus ToLower(ReadOnlySpan<byte> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, false, out bytesWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<byte> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, true, out bytesWritten); }

        static OperationStatus Change(ReadOnlySpan<byte> source, Span<byte> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus ToLower(ReadOnlySpan<char> source, Span<char> destination, out int charsWritten) { return Change(source, destination, false, out charsWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<char> source, Span<char> destination, out int charsWritten) { return Change(source, destination, true, out charsWritten); }

        static OperationStatus Change(ReadOnlySpan<char> source, Span<char> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (char)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        // Between the two: ASCII bytes cased into chars, and ASCII chars into bytes.
        public static OperationStatus ToLower(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten) { return Change(source, destination, false, out charsWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten) { return Change(source, destination, true, out charsWritten); }
        public static OperationStatus ToLower(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, false, out bytesWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, true, out bytesWritten); }

        static OperationStatus Change(ReadOnlySpan<byte> source, Span<char> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (char)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        static OperationStatus Change(ReadOnlySpan<char> source, Span<byte> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus ToLowerInPlace(Span<byte> value, out int bytesWritten) { return Change(value, value, false, out bytesWritten); }
        public static OperationStatus ToUpperInPlace(Span<byte> value, out int bytesWritten) { return Change(value, value, true, out bytesWritten); }
        public static OperationStatus ToLowerInPlace(Span<char> value, out int charsWritten) { return Change(value, value, false, out charsWritten); }
        public static OperationStatus ToUpperInPlace(Span<char> value, out int charsWritten) { return Change(value, value, true, out charsWritten); }

        // .NET's Ascii whitespace: tab, line feed, vertical tab, form feed,
        // carriage return and space.
        static bool White(int c) { return c == ' ' || (c >= 0x09 && c <= 0x0D); }

        public static Range Trim(ReadOnlySpan<byte> value)
        {
            int start = 0, end = value.Length;
            while (start < end && White(value[start])) { start++; }
            while (end > start && White(value[end - 1])) { end--; }
            return new Range(start, end);
        }

        public static Range TrimStart(ReadOnlySpan<byte> value)
        {
            int start = 0;
            while (start < value.Length && White(value[start])) { start++; }
            return new Range(start, value.Length);
        }

        public static Range TrimEnd(ReadOnlySpan<byte> value)
        {
            int end = value.Length;
            while (end > 0 && White(value[end - 1])) { end--; }
            return new Range(0, end);
        }

        public static Range Trim(ReadOnlySpan<char> value)
        {
            int start = 0, end = value.Length;
            while (start < end && White(value[start])) { start++; }
            while (end > start && White(value[end - 1])) { end--; }
            return new Range(start, end);
        }

        public static Range TrimStart(ReadOnlySpan<char> value)
        {
            int start = 0;
            while (start < value.Length && White(value[start])) { start++; }
            return new Range(start, value.Length);
        }

        public static Range TrimEnd(ReadOnlySpan<char> value)
        {
            int end = value.Length;
            while (end > 0 && White(value[end - 1])) { end--; }
            return new Range(0, end);
        }

        public static OperationStatus ToUtf16(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                if (source[i] > 0x7F) { charsWritten = i; return OperationStatus.InvalidData; }
                destination[i] = (char)source[i];
            }
            charsWritten = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus FromUtf16(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                if (source[i] > 0x7F) { bytesWritten = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)source[i];
            }
            bytesWritten = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }
    }
}

namespace System.Buffers
{
    /// .NET's StandardFormat: a format letter and a precision, as Utf8Formatter
    /// and Utf8Parser take them. `default` is the type's general format.
    public readonly struct StandardFormat : IEquatable<StandardFormat>
    {
        public const byte NoPrecision = 255;
        public const byte MaxPrecision = 99;

        readonly byte _symbol;
        readonly byte _precision;

        public StandardFormat(char symbol, byte precision = NoPrecision)
        {
            if (precision != NoPrecision && precision > MaxPrecision) throw new ArgumentOutOfRangeException("precision");
            if (symbol > 0xFF) throw new ArgumentOutOfRangeException("symbol");
            _symbol = (byte)symbol;
            _precision = precision;
        }

        public char Symbol => (char)_symbol;
        public byte Precision => _precision;
        public bool HasPrecision => _precision != NoPrecision;
        public bool IsDefault => _symbol == 0 && _precision == 0;

        public bool Equals(StandardFormat other) { return _symbol == other._symbol && _precision == other._precision; }
        public override bool Equals(object? obj) { return obj is StandardFormat f && Equals(f); }
        public override int GetHashCode() { return _symbol | (_precision << 8); }
        public override string ToString() { return _symbol == 0 ? "" : _precision == NoPrecision || _precision == 0 && IsDefault ? Symbol.ToString() : Symbol.ToString() + (int)_precision; }
    }
}

namespace System.Buffers.Text
{
    /// .NET's Utf8Formatter: numbers and booleans written as UTF-8 digits
    /// straight into a span. Formats 'G' and 'D' (decimal, a precision is a
    /// minimum digit count), 'N' is not taken, and 'X'/'x' (hexadecimal).
    public static class Utf8Formatter
    {
        public static bool TryFormat(bool value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            bool lower = format.Symbol == 'l';
            ReadOnlySpan<byte> text = value ? (lower ? "true"u8 : "True"u8) : (lower ? "false"u8 : "False"u8);
            if (text.Length > destination.Length) { bytesWritten = 0; return false; }
            for (int i = 0; i < text.Length; i++) { destination[i] = text[i]; }
            bytesWritten = text.Length;
            return true;
        }

        public static bool TryFormat(int value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Signed(value, 32, destination, out bytesWritten, format); }
        public static bool TryFormat(long value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Signed(value, 64, destination, out bytesWritten, format); }
        public static bool TryFormat(short value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Signed(value, 16, destination, out bytesWritten, format); }
        public static bool TryFormat(sbyte value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Signed(value, 8, destination, out bytesWritten, format); }
        public static bool TryFormat(uint value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Unsigned(value, destination, out bytesWritten, format); }
        public static bool TryFormat(ulong value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Unsigned(value, destination, out bytesWritten, format); }
        public static bool TryFormat(ushort value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Unsigned(value, destination, out bytesWritten, format); }
        public static bool TryFormat(byte value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Unsigned(value, destination, out bytesWritten, format); }

        // Hexadecimal of a signed value is its two's complement at its width, as .NET's.
        static bool Signed(long value, int bits, Span<byte> destination, out int written, StandardFormat format)
        {
            char f = format.Symbol;
            if (f == 'X' || f == 'x')
            {
                ulong bitsOf = bits == 64 ? (ulong)value : (ulong)value & ((1UL << bits) - 1);
                return Unsigned(bitsOf, destination, out written, format);
            }
            if (value >= 0) { return Unsigned((ulong)value, destination, out written, format); }
            if (destination.Length < 1) { written = 0; return false; }
            destination[0] = (byte)'-';
            ulong magnitude = (ulong)(0 - value);
            if (!Unsigned(magnitude, destination.Slice(1), out int digits, format)) { written = 0; return false; }
            written = digits + 1;
            return true;
        }

        static bool Unsigned(ulong value, Span<byte> destination, out int written, StandardFormat format)
        {
            char f = format.Symbol;
            bool hex = f == 'X' || f == 'x';
            if (!(f == '\0' || f == 'G' || f == 'g' || f == 'D' || f == 'd' || hex)) throw new FormatException("Format specifier was invalid.");
            int least = format.HasPrecision ? format.Precision : 1;
            // The digits least first, then written forwards.
            int count = 0;
            ulong v = value;
            ulong radix = hex ? 16UL : 10UL;
            do { count++; v = v / radix; } while (v != 0);
            int total = count > least ? count : least;
            if (total > destination.Length) { written = 0; return false; }
            v = value;
            for (int i = total - 1; i >= 0; i--)
            {
                int d = (int)(v % radix);
                v = v / radix;
                destination[i] = (byte)(d < 10 ? '0' + d : (f == 'x' ? 'a' : 'A') + d - 10);
            }
            written = total;
            return true;
        }
    }

    /// .NET's Utf8Parser: a number or a boolean read off the front of UTF-8
    /// text, saying how many bytes it took. No whitespace; a leading '-' or
    /// '+' for the signed types; 'X' reads hexadecimal digits.
    public static class Utf8Parser
    {
        public static bool TryParse(ReadOnlySpan<byte> source, out bool value, out int bytesConsumed, char standardFormat = '\0')
        {
            if (source.Length >= 4 && Ascii.EqualsIgnoreCase(source.Slice(0, 4), "true"u8)) { value = true; bytesConsumed = 4; return true; }
            if (source.Length >= 5 && Ascii.EqualsIgnoreCase(source.Slice(0, 5), "false"u8)) { value = false; bytesConsumed = 5; return true; }
            value = false; bytesConsumed = 0; return false;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out int value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, int.MinValue, int.MaxValue, 32, out long wide, out bytesConsumed);
            value = ok ? (int)wide : 0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out long value, out int bytesConsumed, char standardFormat = '\0')
        {
            return Signed(source, standardFormat, long.MinValue, long.MaxValue, 64, out value, out bytesConsumed);
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out short value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, short.MinValue, short.MaxValue, 16, out long wide, out bytesConsumed);
            value = ok ? (short)wide : (short)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out sbyte value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, sbyte.MinValue, sbyte.MaxValue, 8, out long wide, out bytesConsumed);
            value = ok ? (sbyte)wide : (sbyte)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out uint value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, uint.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (uint)wide : 0U; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out ulong value, out int bytesConsumed, char standardFormat = '\0')
        {
            return Unsigned(source, standardFormat, ulong.MaxValue, out value, out bytesConsumed);
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out ushort value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, ushort.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (ushort)wide : (ushort)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out byte value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, byte.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (byte)wide : (byte)0; return ok;
        }

        static int Digit(int c, bool hex)
        {
            if (c >= '0' && c <= '9') return c - '0';
            if (hex && c >= 'a' && c <= 'f') return c - 'a' + 10;
            if (hex && c >= 'A' && c <= 'F') return c - 'A' + 10;
            return -1;
        }

        static bool Unsigned(ReadOnlySpan<byte> source, char format, ulong max, out ulong value, out int consumed)
        {
            bool hex = format == 'X' || format == 'x';
            ulong radix = hex ? 16UL : 10UL;
            int i = 0;
            if (!hex && i < source.Length && source[i] == '+') i++;
            int first = i;
            ulong v = 0;
            while (i < source.Length)
            {
                int d = Digit(source[i], hex);
                if (d < 0) break;
                // Past the type's range: the whole parse fails, as .NET's does.
                if (v > (max - (ulong)d) / radix) { value = 0; consumed = 0; return false; }
                v = v * radix + (ulong)d;
                i++;
            }
            if (i == first) { value = 0; consumed = 0; return false; }
            value = v; consumed = i;
            return true;
        }

        static bool Signed(ReadOnlySpan<byte> source, char format, long min, long max, int bits, out long value, out int consumed)
        {
            bool hex = format == 'X' || format == 'x';
            if (hex)
            {
                ulong mask = bits == 64 ? ulong.MaxValue : (1UL << bits) - 1;
                if (!Unsigned(source, format, mask, out ulong raw, out consumed)) { value = 0; return false; }
                // The digits are the value's two's complement at its width.
                long signed = bits == 64 ? (long)raw : ((raw >> (bits - 1)) & 1) != 0 ? (long)raw - (1L << bits) : (long)raw;
                value = signed;
                return true;
            }
            bool negative = source.Length > 0 && source[0] == '-';
            int skip = source.Length > 0 && (source[0] == '-' || source[0] == '+') ? 1 : 0;
            ulong limit = negative ? (ulong)max + 1UL : (ulong)max;
            if (!Unsigned(source.Slice(skip), format, limit, out ulong magnitude, out int used)) { value = 0; consumed = 0; return false; }
            value = negative ? (long)(0UL - magnitude) : (long)magnitude;
            consumed = used + skip;
            return true;
        }
    }
}

namespace System.Text.Unicode
{
    /// .NET's Utf8: UTF-16 and UTF-8 converted into a caller's buffer, no
    /// string made -- the one conversion at the boundary between text held as
    /// .NET holds it and a system call that takes bytes. Invalid input is each
    /// maximal ill-formed subsequence become one U+FFFD when replacing, and
    /// InvalidData where it begins when not; input cut off at its end is
    /// NeedMoreData unless this is the final block; a destination without
    /// room stops at a whole character, DestinationTooSmall.
    public static class Utf8
    {
        public static OperationStatus FromUtf16(ReadOnlySpan<char> source, Span<byte> destination, out int charsRead, out int bytesWritten, bool replaceInvalidSequences = true, bool isFinalBlock = true)
        {
            int i = 0, o = 0;
            OperationStatus status = OperationStatus.Done;
            while (i < source.Length)
            {
                int c = source[i];
                int take = 1;
                int cp = c;
                if (c >= 0xD800 && c <= 0xDBFF)
                {
                    if (i + 1 >= source.Length)
                    {
                        if (!isFinalBlock) { status = OperationStatus.NeedMoreData; break; }
                        cp = -1;
                    }
                    else if (source[i + 1] >= 0xDC00 && source[i + 1] <= 0xDFFF)
                    {
                        cp = 0x10000 + ((c - 0xD800) << 10) + (source[i + 1] - 0xDC00);
                        take = 2;
                    }
                    else cp = -1;
                }
                else if (c >= 0xDC00 && c <= 0xDFFF) cp = -1;
                if (cp < 0)
                {
                    if (!replaceInvalidSequences) { status = OperationStatus.InvalidData; break; }
                    cp = 0xFFFD;
                }
                int need = cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
                if (o + need > destination.Length) { status = OperationStatus.DestinationTooSmall; break; }
                if (need == 1) destination[o] = (byte)cp;
                else if (need == 2) { destination[o] = (byte)(0xC0 | (cp >> 6)); destination[o + 1] = (byte)(0x80 | (cp & 0x3F)); }
                else if (need == 3) { destination[o] = (byte)(0xE0 | (cp >> 12)); destination[o + 1] = (byte)(0x80 | ((cp >> 6) & 0x3F)); destination[o + 2] = (byte)(0x80 | (cp & 0x3F)); }
                else { destination[o] = (byte)(0xF0 | (cp >> 18)); destination[o + 1] = (byte)(0x80 | ((cp >> 12) & 0x3F)); destination[o + 2] = (byte)(0x80 | ((cp >> 6) & 0x3F)); destination[o + 3] = (byte)(0x80 | (cp & 0x3F)); }
                o += need;
                i += take;
            }
            charsRead = i;
            bytesWritten = o;
            return status;
        }

        public static OperationStatus ToUtf16(ReadOnlySpan<byte> source, Span<char> destination, out int bytesRead, out int charsWritten, bool replaceInvalidSequences = true, bool isFinalBlock = true)
        {
            int i = 0, o = 0;
            OperationStatus status = OperationStatus.Done;
            while (i < source.Length)
            {
                int b0 = source[i];
                int cp;
                int take;
                if (b0 < 0x80) { cp = b0; take = 1; }
                else
                {
                    // How many continuation bytes, and the range the first may take.
                    int more, low = 0x80, high = 0xBF;
                    if (b0 >= 0xC2 && b0 <= 0xDF) { more = 1; cp = b0 & 0x1F; }
                    else if (b0 >= 0xE0 && b0 <= 0xEF) { more = 2; cp = b0 & 0x0F; if (b0 == 0xE0) low = 0xA0; if (b0 == 0xED) high = 0x9F; }
                    else if (b0 >= 0xF0 && b0 <= 0xF4) { more = 3; cp = b0 & 0x07; if (b0 == 0xF0) low = 0x90; if (b0 == 0xF4) high = 0x8F; }
                    else { more = -1; cp = 0; }
                    take = 1;
                    bool bad = more < 0;
                    bool cut = false;
                    for (int k = 0; k < more && !bad; k++)
                    {
                        if (i + take >= source.Length) { cut = true; break; }
                        int b = source[i + take];
                        if (b < low || b > high) { bad = true; break; }
                        cp = (cp << 6) | (b & 0x3F);
                        take++;
                        low = 0x80; high = 0xBF;
                    }
                    if (cut)
                    {
                        if (!isFinalBlock) { status = OperationStatus.NeedMoreData; break; }
                        bad = true;
                    }
                    if (bad)
                    {
                        if (!replaceInvalidSequences) { status = OperationStatus.InvalidData; break; }
                        cp = 0xFFFD;
                    }
                }
                int need = cp >= 0x10000 ? 2 : 1;
                if (o + need > destination.Length) { status = OperationStatus.DestinationTooSmall; break; }
                if (need == 1) destination[o] = (char)cp;
                else { destination[o] = (char)(0xD800 + ((cp - 0x10000) >> 10)); destination[o + 1] = (char)(0xDC00 + ((cp - 0x10000) & 0x3FF)); }
                o += need;
                i += take;
            }
            bytesRead = i;
            charsWritten = o;
            return status;
        }
    }
}

namespace System.Runtime.CompilerServices
{
    /// What every ValueTuple answers, boxed or not: how many items it has,
    /// and each one as an object, from 0.
    public interface ITuple
    {
        int Length { get; }
        object? this[int index] { get; }
    }
}

namespace Microsoft.CSharp.RuntimeBinder
{
    /// What a dynamic operation that cannot be bound throws (System.DynamicRuntime,
    /// in Microsoft.CSharp; here because the members the compiler writes for
    /// a dynamic receiver convert their arguments with DynamicValues).
    public class RuntimeBinderException : Exception
    {
        public RuntimeBinderException() : base("An error occurred while binding a dynamic operation.") { }
        public RuntimeBinderException(string message) : base(message) { }
        public RuntimeBinderException(string message, Exception inner) : base(message, inner) { }
    }

    public class RuntimeBinderInternalCompilerException : Exception
    {
        public RuntimeBinderInternalCompilerException() : base("An unexpected exception occurred while binding a dynamic operation.") { }
        public RuntimeBinderInternalCompilerException(string message) : base(message) { }
    }
}

namespace System.Dynamic
{
    // ---- what a late-bound call carries, and what answers it -------------------------------
    //
    // Every member a dynamic receiver can reach is answered by code the
    // compiler wrote for it: a program's providers (ILateMembers, one for each
    // unit that writes `dynamic`, over every class it can reach) and a
    // struct's own members (IDynamicMembers, so a write reaches the box).
    // Each answers one of these:

    /// What a member the compiler wrote for a dynamic receiver answers.
    public static class LateStatus
    {
        public const int Done = 0;             // done; `result` holds the value
        public const int NoMember = 1;         // nothing of that name: ask the next
        public const int NoFit = 2;            // the member, but nothing that takes these arguments
        public const int MethodGroup = 3;      // a method, where a value was asked for
        public const int ReadOnly = 4;         // a member that cannot be written
        public const int Static = 5;           // a static member, reached through an instance
        public const int Ambiguous = 6;        // more than one, none better (C# 12.6.4.3)
        public const int NotEvent = 7;         // not an event: += and -= are the operator's
    }

    /// <summary>
    /// The arguments of a late-bound call as the compiler hands them over:
    /// each argument, its name where it was given one (`f(x: 1)`), how it was
    /// passed (0 by value, 1 ref, 2 out, 3 in) and the type arguments written
    /// (`d.M&lt;int&gt;(..)`). A candidate's own parameters are matched against
    /// them by Map, as C# matches a call's arguments to a member's
    /// parameters (12.6.2): positional first, then by name, an optional
    /// parameter left out marked with DynamicValues.Missing; and a ref or out
    /// argument's new value written back by Back.
    /// </summary>
    public sealed class LateCall
    {
        public readonly object?[] Args;
        public readonly string?[]? Names;
        public readonly int[]? Kinds;
        public readonly Type[]? TypeArgs;
        /// Each argument's own type where the compiler knew it (not dynamic),
        /// for C#'s "exactly matches" (12.6.4.5): a static argument is
        /// compared by the type it was written as, not by what it holds.
        public readonly Type?[]? Declared;
        /// The method group asked, once a member says NoFit or Ambiguous: what the error names.
        public LateGroup? Group;
        /// What the member is called, for the error.
        public string Member = "";

        public LateCall(object?[] args, string?[]? names, int[]? kinds, Type[]? typeArgs, Type?[]? declared)
        {
            Args = args; Names = names; Kinds = kinds; TypeArgs = typeArgs; Declared = declared;
        }

        public LateCall(object?[] args, string?[]? names, int[]? kinds, Type[]? typeArgs) : this(args, names, kinds, typeArgs, null) { }

        public LateCall(object?[] args) : this(args, null, null, null, null) { }

        /// Whether argument `i` is exactly of a type: its written type when it had one, else what it holds.
        public bool ExactlyOf(int i, Type type)
        {
            Type? written = Declared == null ? null : Declared[i];
            if (written != null) return written == type;
            return DynamicValues.Exact(Args[i], type);
        }

        public int Count { get { return Args.Length; } }

        int KindOf(int argument) { return Kinds == null ? 0 : Kinds[argument]; }
        string? NameOf(int argument) { return Names == null ? null : Names[argument]; }

        /// <summary>
        /// Each parameter's argument (its index, or -1 for an optional one
        /// left out), or null when the arguments do not match the parameters:
        /// too many, a name no parameter has or one given twice, a positional
        /// argument after a named one out of its place, a required parameter
        /// with nothing, or an argument passed otherwise than its parameter is
        /// taken (`ref` for ref, `out` for out, by value or `in` for in).
        /// `parameterKinds` as Kinds; `required` how many lead without a default.
        /// </summary>
        public int[]? Map(string[] parameters, int[] parameterKinds, int required)
        {
            int n = parameters.Length;
            if (Args.Length > n) return null;
            int[] map = new int[n];
            for (int p = 0; p < n; p++) map[p] = -1;
            for (int i = 0; i < Args.Length; i++)
            {
                string? named = NameOf(i);
                int p = i;
                if (named != null)
                {
                    p = -1;
                    for (int k = 0; k < n; k++) if (parameters[k] == named) { p = k; break; }
                    if (p < 0) return null;
                }
                else
                {
                    // A positional argument after a named one stands in the
                    // named one's own place, or nowhere (C# 7.2's rule).
                    if (map[p] != -1) return null;
                }
                if (map[p] != -1) return null;
                map[p] = i;
            }
            for (int p = 0; p < n; p++)
            {
                if (map[p] == -1)
                {
                    if (p < required) return null;
                    continue;
                }
                int passed = KindOf(map[p]), taken = parameterKinds[p];
                if (taken == 3 ? passed == 1 || passed == 2 : passed != taken) return null;
            }
            return map;
        }

        /// <summary>
        /// The expanded form of a `params` call (C# 12.6.4.2): the fixed
        /// parameters as Map has them, every argument past them an element of
        /// the array -- each by value and none named. Null when it does not
        /// match.
        /// </summary>
        public int[]? MapExpanded(string[] fixedParameters, int[] parameterKinds, int required)
        {
            int n = fixedParameters.Length;
            if (Args.Length < n) return null;
            for (int i = n; i < Args.Length; i++) if (NameOf(i) != null || KindOf(i) != 0) return null;
            int[] map = new int[n + 1];
            for (int p = 0; p < n; p++)
            {
                if (NameOf(p) != null && NameOf(p) != fixedParameters[p]) return null;
                int passed = KindOf(p), taken = parameterKinds[p];
                if (taken == 3 ? passed == 1 || passed == 2 : passed != taken) return null;
                map[p] = p;
            }
            map[n] = -2;                                                       // the rest
            return map;
        }

        /// A parameter's argument, or DynamicValues.Missing for one left out.
        public object? At(int[] map, int parameter) { return map[parameter] < 0 ? DynamicValues.Missing : Args[map[parameter]]; }

        /// The arguments an expanded `params` array takes: every one from `from` on.
        public object?[] Rest(int from)
        {
            object?[] rest = new object?[Args.Length - from];
            for (int i = 0; i < rest.Length; i++) rest[i] = Args[from + i];
            return rest;
        }

        /// A ref or out parameter's value back where its argument was.
        public void Back(int[] map, int parameter, object? value)
        {
            if (map[parameter] >= 0) Args[map[parameter]] = value;
        }

        /// The element of the arguments, for a ref or out argument's new value (the compiler's write-back).
        public object? Value(int argument) { return Args[argument]; }

        /// Whether the type arguments are these.
        public bool TypeArgumentsAre(Type[] types)
        {
            if (TypeArgs == null || TypeArgs.Length != types.Length) return false;
            for (int i = 0; i < types.Length; i++) if (TypeArgs[i] != types[i]) return false;
            return true;
        }
    }

    /// <summary>
    /// A method group's overloads as the compiler saw them, for the choice
    /// among the applicable ones (DynamicValues.Choose): the parameter types
    /// they have, as indices into Types; which of them is a better conversion
    /// target than which (C# 12.6.4.7, worked out where the compiler had the
    /// types: Better[a * Types.Length + b] is 1 when Types[a] is better than
    /// Types[b]); each candidate's expanded-form element type (-1: not
    /// expanded), whether it is a generic method's instantiation, and how C#
    /// writes it, for the errors.
    /// </summary>
    public sealed class LateGroup
    {
        public readonly Type[] Types;
        public readonly int[][] Parameters;
        public readonly int[] Element;
        public readonly bool[] Generic;
        public readonly byte[] Better;
        public readonly string[] Display;

        public LateGroup(Type[] types, int[][] parameters, int[] element, bool[] generic, byte[] better, string[] display)
        {
            Types = types; Parameters = parameters; Element = element; Generic = generic; Better = better; Display = display;
        }

        public bool BetterTarget(int a, int b) { return a != b && Better[a * Types.Length + b] != 0; }
    }

    /// <summary>
    /// A program's answers for every class a dynamic receiver of it can reach
    /// (compiler/src/metadata/DynamicProvider.cs): one for each unit that
    /// writes `dynamic`, registered when its image is loaded
    /// (DynamicRuntime.Register).
    /// </summary>
    public interface ILateMembers
    {
        int Get(object target, string name, out object? result);
        int Set(object target, string name, object? value);
        int Call(object target, string name, LateCall call, out object? result);
        int GetIndex(object target, LateCall keys, out object? result);
        int SetIndex(object target, LateCall keys, object? value);
        int Operator(int op, object? left, object? right, out object? result);
        int Convert(object value, Type target, bool explicitly, out object? result);
        int Event(object target, string name, bool add, object? handler);
        /// A static member of the target's class of that name, as C# writes it (`Counter.Make(int)`), or null: CS0176's text.
        string? Static(object target, string name);
    }

    /// <summary>
    /// The same answers written into a struct itself, so that a write
    /// through a dynamic value reaches the box it holds rather than a copy
    /// (DynamicDeclarations).
    /// </summary>
    public interface IDynamicMembers
    {
        int __DynGet(string name, out object? result);
        int __DynSet(string name, object? value);
        int __DynCall(string name, LateCall call, out object? result);
        int __DynGetIndex(LateCall keys, out object? result);
        int __DynSetIndex(LateCall keys, object? value);
        int __DynOperator(int op, object? left, object? right, out object? result);
        int __DynConvert(Type target, bool explicitly, out object? result);
        int __DynEvent(string name, bool add, object? handler);
    }

    /// <summary>
    /// A delegate called by a dynamic binder: every delegate type is one,
    /// its Invoke reached with the call's arguments matched to its own
    /// parameters (each delegate's own default implementation, the library's
    /// written here and a program's by the compiler), so the delegate made
    /// dynamic is the delegate itself.
    /// </summary>
    public interface ILateInvocable
    {
        object? __LateInvoke(LateCall call);
    }
}

namespace System
{
    /// <summary>
    /// The conversions C#'s run-time binder makes, and its choice among a
    /// method group's applicable members (Microsoft.CSharp's DynamicRuntime
    /// and the members the compiler writes for a dynamic receiver both use
    /// them).
    /// </summary>
    public static class DynamicValues
    {
        const int Done = 0;

        /// An optional parameter that was given nothing (LateCall.At).
        public static readonly object Missing = new object();

        public static string TypeName(object? o)
        {
            if (o == null) return "<null>";
            if (o is string) return "string";
            if (o is int) return "int";
            if (o is long) return "long";
            if (o is double) return "double";
            if (o is bool) return "bool";
            if (o is char) return "char";
            if (o is float) return "float";
            if (o is uint) return "uint";
            if (o is ulong) return "ulong";
            if (o is short) return "short";
            if (o is ushort) return "ushort";
            if (o is byte) return "byte";
            if (o is sbyte) return "sbyte";
            return o.GetType().FullName;
        }

        static long AsLong(object? v)
        {
            if (v is int i) return i;
            if (v is long l) return l;
            if (v is short s) return s;
            if (v is sbyte sb) return sb;
            if (v is byte b) return b;
            if (v is ushort us) return us;
            if (v is char c) return c;
            if (v is uint ui) return ui;
            if (v is ulong ul) return (long)ul;
            if (v is float f) return (long)f;
            if (v is double d) return (long)d;
            throw new InvalidCastException();
        }

        static double AsDouble(object? v)
        {
            if (v is double d) return d;
            if (v is float f) return f;
            if (v is ulong ul) return (double)ul;
            return AsLong(v);
        }

        /// <summary>
        /// A delegate's parameter from its argument (ILateInvocable): what it
        /// is, or what the binder's implicit conversion makes it.
        /// </summary>
        public static T Argument<T>(object? value)
        {
            if (value is T same) return same;
            return (T)Convert(value, typeof(T), false);
        }

        /// Whether an argument converts implicitly to a delegate's parameter type.
        public static bool Accepts<T>(object? value) { return value is T || Fits(value, typeof(T)); }

        /// Whether every element of a list fits a test (an expanded `params` array).
        public static bool All(object?[] items, Func<object?, bool> test)
        {
            for (int i = 0; i < items.Length; i++) if (!test(items[i])) return false;
            return true;
        }

        /// <summary>
        /// Whether a value converts implicitly to a type (an overload's
        /// parameter): null to a reference or a Nullable; a number to itself
        /// or a wider number (C# 10.2.3); anything else to its own run-time
        /// type (a reference to a base or an interface is the `is` test the
        /// compiler writes beside this).
        /// </summary>
        public static bool Fits(object? value, Type type)
        {
            if (type == typeof(object)) return true;
            if (value == null) return !type.IsValueType || IsNullable(type);
            if (value == Missing) return false;
            Type held = value.GetType();
            if (held == type) return true;
            int target = NumberKind(type);
            if (target != 0) return Widens(value, target);
            return false;
        }

        /// Whether a value is exactly of a type (C# 12.6.4.5's "exactly matches").
        public static bool Exact(object? value, Type type) { return value != null && value != Missing && value.GetType() == type; }

        static bool IsNullable(Type t) { return t.Name.StartsWith("Nullable", StringComparison.Ordinal); }

        /// A type as C# writes it in a message: its keyword for a number, a bool, a char, a string or object.
        public static string TypeText(Type t)
        {
            if (t == typeof(int)) return "int";
            if (t == typeof(long)) return "long";
            if (t == typeof(double)) return "double";
            if (t == typeof(bool)) return "bool";
            if (t == typeof(char)) return "char";
            if (t == typeof(string)) return "string";
            if (t == typeof(object)) return "object";
            if (t == typeof(float)) return "float";
            if (t == typeof(uint)) return "uint";
            if (t == typeof(ulong)) return "ulong";
            if (t == typeof(short)) return "short";
            if (t == typeof(ushort)) return "ushort";
            if (t == typeof(byte)) return "byte";
            if (t == typeof(sbyte)) return "sbyte";
            return t.FullName;
        }

        // A number type's kind: 1 sbyte, 2 byte, 3 short, 4 ushort, 5 int, 6 uint, 7 long, 8 ulong, 9 char, 10 float, 11 double.
        static int NumberKind(Type t)
        {
            if (t == typeof(sbyte)) return 1;
            if (t == typeof(byte)) return 2;
            if (t == typeof(short)) return 3;
            if (t == typeof(ushort)) return 4;
            if (t == typeof(int)) return 5;
            if (t == typeof(uint)) return 6;
            if (t == typeof(long)) return 7;
            if (t == typeof(ulong)) return 8;
            if (t == typeof(char)) return 9;
            if (t == typeof(float)) return 10;
            if (t == typeof(double)) return 11;
            return 0;
        }

        static int ValueKind(object v)
        {
            if (v is sbyte) return 1;
            if (v is byte) return 2;
            if (v is short) return 3;
            if (v is ushort) return 4;
            if (v is int) return 5;
            if (v is uint) return 6;
            if (v is long) return 7;
            if (v is ulong) return 8;
            if (v is char) return 9;
            if (v is float) return 10;
            if (v is double) return 11;
            return 0;
        }

        /// C#'s implicit numeric conversions (10.2.3), from a value's kind to a target kind.
        static bool Widens(object value, int to)
        {
            int from = ValueKind(value);
            if (from == 0) return false;
            if (from == to) return true;
            switch (from)
            {
                case 1: return to == 3 || to == 5 || to == 7 || to == 10 || to == 11;
                case 2: return to == 3 || to == 4 || to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 3: return to == 5 || to == 7 || to == 10 || to == 11;
                case 4: return to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 5: return to == 7 || to == 10 || to == 11;
                case 6: return to == 7 || to == 8 || to == 10 || to == 11;
                case 7: return to == 10 || to == 11;
                case 8: return to == 10 || to == 11;
                case 9: return to == 4 || to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 10: return to == 11;
            }
            return false;
        }

        /// <summary>
        /// A value made a type (the compiler casts what this answers to it):
        /// implicitly, what Fits allows; explicitly, any number to any other
        /// (unchecked, as C# casts outside `checked`) and an object to what it
        /// is. A struct's own conversion operators are asked first; a class's
        /// by DynamicRuntime, through the providers, before this.
        /// </summary>
        public static object Convert(object? value, Type type, bool explicitly)
        {
            if (type == typeof(object)) return value!;
            object? result;
            if (value == null)
            {
                if (!type.IsValueType || IsNullable(type)) return null!;
                throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot convert null to '" + TypeText(type) + "' because it is a non-nullable value type");
            }
            if (value.GetType() == type) return value;
            if (value is System.Dynamic.IDynamicMembers m && m.__DynConvert(type, explicitly, out result) == Done) return result!;
            int target = NumberKind(type);
            if (target != 0 && ValueKind(value) != 0)
            {
                if (!explicitly && !Widens(value, target))
                    throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot implicitly convert type '" + TypeName(value) + "' to '" + TypeText(type) + "'. An explicit conversion exists (are you missing a cast?)");
                return Number(value, target);
            }
            if (IsNullable(type) && ValueKind(value) != 0) return value;
            // A REFERENCE: the cast the compiler writes after this checks it,
            // with InvalidCastException; asked here only to say it C#'s way.
            if (type.IsValueType && !type.IsEnum)
                throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot " + (explicitly ? "" : "implicitly ") + "convert type '" + TypeName(value) + "' to '" + TypeText(type) + "'");
            return value;
        }

        static object Number(object v, int to)
        {
            if (v is double || v is float)
            {
                double d = AsDouble(v);
                switch (to)
                {
                    case 10: return (float)d;
                    case 11: return d;
                }
                long whole = unchecked((long)d);
                return Integer(whole, to);
            }
            if (v is ulong ul && to == 10) return (float)ul;
            if (v is ulong ul2 && to == 11) return (double)ul2;
            long n = AsLong(v);
            if (to == 10) return (float)n;
            if (to == 11) return (double)n;
            return Integer(n, to);
        }

        static object Integer(long n, int to)
        {
            switch (to)
            {
                case 1: return unchecked((sbyte)n);
                case 2: return unchecked((byte)n);
                case 3: return unchecked((short)n);
                case 4: return unchecked((ushort)n);
                case 5: return unchecked((int)n);
                case 6: return unchecked((uint)n);
                case 7: return n;
                case 8: return unchecked((ulong)n);
                case 9: return unchecked((char)n);
            }
            throw new InvalidCastException();
        }

        // ---- the better function member (C# 12.6.4.3) ---------------------------------------

        /// <summary>
        /// Of a method group's candidates -- `maps` each one's parameters'
        /// arguments (LateCall.Map, MapExpanded), `applicable` which take
        /// them -- the one better than every other, as C# chooses (12.6.4.3):
        /// for each argument, the conversion to its parameter's type better
        /// (12.6.4.5: an argument whose run-time type is exactly one
        /// parameter's type and not the other's, else the better conversion
        /// target, 12.6.4.7, which the group carries); with no difference in
        /// the parameter types, a non-generic method over a generic one's
        /// instantiation, the normal form over the expanded, and a candidate
        /// with no default argument filled in over one with. The index of the
        /// best; -1 when none applies, -2 when no one is better than all the
        /// others (ambiguous).
        /// </summary>
        public static int Choose(System.Dynamic.LateCall call, System.Dynamic.LateGroup group, int[]?[] maps, bool[] applicable)
        {
            int best = -1;
            int count = 0;
            for (int i = 0; i < applicable.Length; i++) if (applicable[i]) { count++; best = i; }
            if (count <= 1) return best;
            for (int i = 0; i < applicable.Length; i++)
            {
                if (!applicable[i]) continue;
                bool wins = true;
                for (int j = 0; j < applicable.Length && wins; j++)
                {
                    if (j == i || !applicable[j]) continue;
                    if (Compare(call, group, maps, i, j) <= 0) wins = false;
                }
                if (wins) return i;
            }
            return -2;
        }

        /// The parameter type (an index into the group's Types) argument `argument` meets in candidate `c`; -1 for none.
        static int TypeFor(System.Dynamic.LateGroup group, int[]?[] maps, int c, int argument)
        {
            int[] map = maps[c]!;
            int[] types = group.Parameters[c];
            for (int p = 0; p < map.Length; p++)
            {
                if (map[p] == argument) return types[p];
                if (map[p] == -2) return argument >= p ? group.Element[c] : -1;     // the expanded rest
            }
            return -1;
        }

        static int Defaults(int[] map)
        {
            int n = 0;
            for (int p = 0; p < map.Length; p++) if (map[p] == -1) n++;
            return n;
        }

        /// 1 when candidate a is better than b for this call, -1 when b is, 0 when neither.
        static int Compare(System.Dynamic.LateCall call, System.Dynamic.LateGroup group, int[]?[] maps, int a, int b)
        {
            bool aBetter = false, bBetter = false, same = true;
            for (int i = 0; i < call.Args.Length; i++)
            {
                int ta = TypeFor(group, maps, a, i), tb = TypeFor(group, maps, b, i);
                // One type however it was annotated: `string?` and `string`
                // are one parameter type to C# (an annotation, not a type).
                if (ta < 0 || tb < 0 || ta == tb || group.Types[ta] == group.Types[tb]) continue;
                same = false;
                bool exactA = call.ExactlyOf(i, group.Types[ta]), exactB = call.ExactlyOf(i, group.Types[tb]);
                int said = exactA && !exactB ? 1 : exactB && !exactA ? -1
                         : group.BetterTarget(ta, tb) && !group.BetterTarget(tb, ta) ? 1
                         : group.BetterTarget(tb, ta) && !group.BetterTarget(ta, tb) ? -1 : 0;
                if (said > 0) aBetter = true;
                if (said < 0) bBetter = true;
            }
            if (aBetter && !bBetter) return 1;
            if (bBetter && !aBetter) return -1;
            if (aBetter && bBetter) return 0;
            if (!same) return 0;
            // THE TIE-BREAKS, the parameter types being the same.
            if (!group.Generic[a] && group.Generic[b]) return 1;
            if (group.Generic[a] && !group.Generic[b]) return -1;
            bool expandedA = group.Element[a] >= 0, expandedB = group.Element[b] >= 0;
            if (!expandedA && expandedB) return 1;
            if (expandedA && !expandedB) return -1;
            int da = Defaults(maps[a]!), db = Defaults(maps[b]!);
            if (da == 0 && db > 0) return 1;
            if (db == 0 && da > 0) return -1;
            return 0;
        }
    }
}
