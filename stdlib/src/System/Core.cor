        + "\u3FEF\u8646\u14F5\uA129\u3C74\uB604\u603A\u88D3\u3FEF\u902E\uE78B\u3FF6\u3C83\uC5EC\u519D\u7271\u3FEF\u9A51\uFBC7\u4C83"
        + "\uBC8F\uF712\u8FD3\u91F0\u3FEF\uA4AF\uA2A4\u90DA\uBC8D\uAE98\uE223\u747D\u3FEF\uAF48\u2D8E\u67F1\u3C8E\uC3BC\u41AA\u2008"
        + "\u3FEF\uBA1B\uEE61\u5A27\u3C84\u2B94\uC3A9\uEB32\u3FEF\uC52B\u376B\uBA97\u3C8A\u64A9\u31D1\u85EE\u3FEF\uD076\u5B6E\u4540"
        + "\uBC8E\u37BA\uE43B\uE3ED\u3FEF\uDBFD\uAD9C\uBE14\u3C77\u893B\u4D91\uCD9D\u3FEF\uE7C1\u819E\u90D8\u3C53\u05C1\u4160\uCC89"
        + "\u3FEF\uF3C2\u2B8F\u71F1";
    // For c = 1 + j/128, j from -38 to 53: 1/c rounded, and -log of that rounded inverse in two parts.
    const string LogTable =
          "\u3FF6\uC16C\u16C1\u6C17\uBFD6\u8AC8\u3E9C\u6A15\u3C6A\uCD8A\u9145\uFF44\u3FF6\u8168\u1681\u6817\uBFD5\uD5BD\uDF59\u5F31"
        + "\uBC4D\u5F75\uB9A2\u3AE4\u3FF6\u42C8\u590B\u2164\uBFD5\u22AE\u0738\uA3D7\uBC73\u840B\u263A\uCB43\u3FF6\u0581\u6058\u1606"
        + "\uBFD4\u718D\uC271\uC41C\uBC7D\u8FB4\uC14C\u56EE\u3FF5\uC988\u2B93\u1057\uBFD3\uC252\u7733\u3183\uBC71\u52D8\u1AF5\u713A"
        + "\u3FF5\u8ED2\u3081\u58ED\uBFD3\u14F1\uE1D3\u5CE3\uBC72\u2966\uF61A\u3C23\u3FF5\u5555\u5555\u5555\uBFD2\u6962\u1134\uDB91"
        + "\uBC7E\u0EFA\uDD9D\uB02A\u3FF5\u1D07\uEAE2\uF815\uBFD1\uBF99\u635A\u6B95\u3C7E\u9575\uC212\u4912\u3FF4\uE5E0\uA72F\u0539"
        + "\uBFD1\u178E\u8227\uE47A\uBC7B\u8CE2\uD07F\u1CB7\u3FF4\uAFD6\uA052\uBF5B\uBFD0\u7138\u604D\u5864\u3C32\u4E91\u2B16\uEC8B"
        + "\u3FF4\u7AE1\u47AE\u147B\uBFCF\u991C\u6CB3\uB37A\uBC5E\uCCA0\uCDF3\u0143\u3FF4\u46F8\u6562\uD9FB\uBFCE\u530E\uFFE7\u1013"
        + "\u3C6F\u7627\uEF82\uF3F0\u3FF4\u1414\u1414\u1414\uBFCD\u1037\uF265\u5E7B\u3C53\uF3AD\uB7B7\u1CBC\u3FF3\uE22C\uBCE4\uA902"
        + "\uBFCB\uD087\u383B\uD8AA\u3C41\u1655\u04AD\u749E\u3FF3\uB13B\u13B1\u3B14\uBFCA\u93ED\u3C8A\uD9E5\uBC6B\uCAFA\u9DE9\u7202"
        + "\u3FF3\u8138\u1381\u3814\uBFC9\u5A5A\uDCF7\u0182\uBC68\uA162\u83FD\uBD1C\u3FF3\u521C\uFB2B\u78C1\uBFC8\u23C1\u6551\uA3C0"
        + "\uBC66\uDCD3\u18F4\u187E\u3FF3\u23E3\u4A2B\u10BF\uBFC6\uF012\u8B75\u6AB9\u3C43\u7967\u0878\u59B9\u3FF2\uF684\uBDA1\u2F68"
        + "\uBFC5\uBF40\u6B54\u3DB0\u3C21\uF5B4\u4C0D\uF7F7\u3FF2\uC9FB\u4D81\u2CA0\uBFC4\u913D\u8333\uB563\u3C50\uD560\u4930\uF137"
        + "\u3FF2\u9E41\u29E4\u129E\uBFC3\u65FC\uB015\u9014\uBC6B\uEA08\uD2DC\uA256\u3FF2\u7350\uB881\u2735\uBFC2\u3D71\u2A49\uC201"
        + "\uBC65\u1C7E\u9EFA\uE297\u3FF2\u4924\u9249\u2492\uBFC1\u178E\u8227\uE47A\u3C50\uE63A\u5F01\uC693\u3FF2\u1FB7\u8121\uFB78"
        + "\uBFBF\uE891\u39DB\uD565\u3C5A\uC9F4\u215F\u9394\u3FF1\uF704\u7DC1\u1F70\uBFBD\uA727\u6384\u469E\uBC54\u01FA\u7173\u3017"
        + "\u3FF1\uCF06\uADA2\u811D\uBFBB\u6AC8\u8DAD\u5B1D\u3C50\u02BF\u768E\u52D0\u3FF1\uA7B9\u611A\u7B96\uBFB9\u335E\u5D59\u4988"
        + "\u3C54\u78A8\u5704\uCCB7\u3FF1\u8118\u1181\u1812\uBFB7\u00D3\u0AEA\uC0E8\uBC4A\u36A6\u77B4\uC8B2\u3FF1\u5B1E\u5F75\u270D"
        + "\uBFB4\uD311\u5D20\u7EAC\uBC3D\uA7D0\uB1E1\u0B2F\u3FF1\u35C8\u1135\uC811\uBFB2\uAA04\uA447\u17A1\uBC5A\uEA2C\u72D0\u5C08"
        + "\u3FF1\u1111\u1111\u1111\uBFB0\u8598\uB59E\u3A06\u3C5D\uD700\u9902\uBF32\u3FF0\uECF5\u6BE6\u9C90\uBFAC\uCB73\uCDDD\uB2D0"
        + "\u3C4E\u48FB\u0500\uEFD5\u3FF0\uC971\u4FBC\uDA3B\uBFA8\u94AA\u149F\uB34B\u3C42\uBA0B\u44CF\uAEE5\u3FF0\uA681\u0A68\u10A7"
        + "\uBFA4\u66AE\uD42D\uE3F9\u3C39\uBADE\uFE94\u2718\u3FF0\u8421\u0842\u1084\uBFA0\u415D\u89E7\u4440\uBC4C\u05CF\u1D75\u3621"
        + "\u3FF0\u624D\uD2F1\uA9FC\uBF98\u4925\u28C8\uCAC5\u3C3D\u192D\u0619\uFA68\u3FF0\u4104\u1041\u0410\uBF90\u2056\u5893\u5837"
        + "\uBC32\u7C8E\u8416\uE717\u3FF0\u2040\u8102\u0408\uBF80\u1015\u7588\uDE69\uBC14\u6662\uD417\uCECE\u3FF0\u0000\u0000\u0000"
        + "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u3FEF\uC07F\u01FC\u07F0\u3F7F\uE02A\u6B10\u6799\uBBCE\u44B7\uE371\u1E7F"
        + "\u3FEF\u81F8\u1F81\uF820\u3F8F\uC0A8\uB0FC\u03C4\uBC18\u3092\uC596\u4281\u3FEF\u4465\u9E4A\u4271\u3F97\uB91B\u07D5\uB126"
        + "\uBC16\uD80A\uB38E\u9430\u3FEF\u07C1\uF07C\u1F08\u3F9F\u829B\u0E78\u32F8\u3C33\u3E3F\u04F1\uEF25\u3FEE\uCC07\uB301\uECC0"
        + "\u3FA3\u9E87\uB9FE\uBD68\uBC45\uBFA9\u37F5\u51B7\u3FEE\u9131\uABF0\uB767\u3FA7\u7458\uF632\uDCFF\u3C08\uD3CA\u87B9\u2968"
        + "\u3FEE\u573A\uC901\uE574\u3FAB\u42DD\u7119\u71B9\u3C40\uA345\u31F6\u7DB5\u3FEE\u1E1E\u1E1E\u1E1E\u3FAF\u0A30\uC011\u62A8"
        + "\u3C48\u5F32\u5C5B\uBACD\u3FED\uE5D6\uE3F8\u868A\u3FB1\u6536\uEEA3\u7AE3\u3C52\u1897\u05CF\u74CA\u3FED\uAE60\u76B9\u81DB"
        + "\u3FB3\u41D7\u961B\uD1D0\uBC53\u599F\u227B\uECBB\u3FED\u77B6\u54B8\u2C34\u3FB5\u1B07\u3F06\u183C\uBC55\uB61C\u65E5\u741A"
        + "\u3FED\u41D4\u1D41\uD41D\u3FB6\uF0D2\u8AE5\u6B4E\uBC42\u0DB3\u2309\u7324\u3FED\u0CB5\u8F6E\uC074\u3FB8\uC345\uD631\u9B23"
        + "\uBC52\u94D2\uF566\u8495\u3FEC\uD856\u8903\u9B0B\u3FBA\u926D\u3A4A\uD562\uBC4D\u7A16\uEAB1\uE2AD\u3FEC\uA4B3\u055E\uE191"
        + "\u3FBC\u5E54\u8F5B\uC743\u3C42\uEB0B\uF7C0\uB0D9\u3FEC\u71C7\u1C71\uC71C\u3FBE\u2707\u6E2A\uF2EA\uBC36\u1578\u001E\u015A"
        + "\u3FEC\u3F8F\u01C3\uF8F0\u3FBF\uEC91\u31DB\uEABC\uBC55\u746B\u9981\uB36C\u3FEC\u0E07\u0381\uC0E0\u3FC0\uD77E\u7CD0\u8E5B"
        + "\u3C69\uA5DC\u5E90\u30AD\u3FEB\uDD2B\u8994\u06F7\u3FC1\uB72A\uD52F\u67A2\uBC6F\uBE7E\uE5C6\u9946\u3FEB\uACF9\u14C1\uBAD0"
        + "\u3FC2\u9552\uF81F\uF521\u3C63\u0177\u1C40\u7DC0\u3FEB\u7D6C\u3DDA\u338B\u3FC3\u71FC\u201E\u8F75\u3C1E\u6CB6\u2AF1\u8A02"
        + "\u3FEB\u4E81\uB4E8\u1B4F\u3FC4\u4D2B\u6CCB\u7D1C\u3C47\uD3D9\u50F8\u7E23\u3FEB\u2036\u406C\u80D9\u3FC5\u26E5\uE3A1\uB438"
        + "\uBC65\u46FF\u8A47\u0D3A\u3FEA\uF286\uBCA1\uAF28\u3FC5\uFF30\u70A7\u93D6\uBC5B\uC60E\uFAFC\u6F6C\u3FEA\uC570\u1AC5\u701B"
        + "\u3FC6\uD60F\uE719\uD21B\u3C6D\u551D\u9713\u2E87\u3FEA\u98EF\u606A\u63BE\u3FC7\uAB89\u0210\uD907\uBC61\u0725\u34A5\u7E7D"
        + "\u3FEA\u6D01\uA6D0\u1A6D\u3FC8\u7FA0\u6520\uC911\uBC69\uF7FD\uBFA0\u8D9A\u3FEA\u41A4\u1A41\uA41A\u3FC9\u525A\u9CF4\u56B6"
        + "\uBC62\u6FB3\uE2B1\uD1DA\u3FEA\u16D3\uF97A\u4B02\u3FCA\u23BC\u1FE2\uB561\u3C62\u4DC4\u6C1E\uA664\u3FE9\uEC8E\u9510\u33D9"
        + "\u3FCA\uF3C9\u4E80\uBFF3\u3C6A\u3398\u064D\uF33E\u3FE9\uC2D1\u4EE4\uA102\u3FCB\uC286\u742D\u8CD4\u3C5C\uFCE7\u4487\u0F57"
        + "\u3FE9\u9999\u9999\u999A\u3FCC\u8FF7\uC79A\u9A20\uBC64\uF689\uF843\u4011\u3FE9\u70E4\uF80C\uB872\u3FCD\u5C21\u6B4F\uBB94"
        + "\uBC5A\u3779\u4D03\u657D\u3FE9\u48B0\uFCD6\uE9E0\u3FCE\u2707\u6E2A\uF2E8\uBC46\u1578\u001E\u015E\u3FE9\u20FB\u49D0\uE229"
        + "\u3FCE\uF0AD\uCBDC\u5935\u3C6E\u8637\u950D\uC20D\u3FE8\uF9C1\u8F9C\u18FA\u3FCF\uB918\u6D5E\u3E29\u3C63\u5551\u9B0D\uE535"
        + "\u3FE8\uD301\u8D30\u18D3\u3FD0\u4025\u94B4\uD041\uBC60\u8EC2\u17A5\u022D\u3FE8\uACB9\u0F6B\uF3AA\u3FD0\uA324\uE273\u90E2"
        + "\u3C7B\uDCFD\uE806\u1C03\u3FE8\u86E5\uF0AB\uB04A\u3FD1\u058B\uF9AE\u4AD4\u3C03\uF415\u6996\u63EC\u3FE8\u6186\u1861\u8618"
        + "\u3FD1\u675C\uABAB\uA60F\u3C2C\uE63E\uAB88\u3727\u3FE8\u3C97\u7AB2\uBEDD\u3FD1\uC898\uC169\u99FB\u3C79\uF1A3\u9D50\u0E3C"
        + "\u3FE8\u1818\u1818\u1818\u3FD2\u2941\uFBCF\u7966\uBC5D\uBD7A\uC258\uA2BD\u3FE7\uF405\uFD01\u7F40\u3FD2\u895A\u13DE\u86A4"
        + "\u3C77\uAD24\uC13F\u040F\u3FE7\uD05F\u417D\u05F4\u3FD2\uE8E2\uBAE1\u1D31\uBC61\uE99B\u72BD\u7BF2\u3FE7\uAD22\u08E0\uECC3"
        + "\u3FD3\u47DD\u9A98\u7D56\uBC71\u6EA6\u2C04\u8CFB\u3FE7\u8A4C\u8178\uA4C8\u3FD3\uA64C\u5569\u45EA\u3C3C\uBCD7\u35D0\u3424"
        + "\u3FE7\u67DC\uE434\uA9B1\u3FD4\u0430\u8686\uA7E4\uBC6F\u79F6\uC105\u9CDB\u3FE7\u45D1\u745D\u1746\u3FD4\u618B\uC21C\u5EC2"
        + "\uBC27\uA426\u4266\u1C62\u3FE7\u2428\u7F46\uDEBC\u3FD4\uBE5F\u9577\u78A1\uBC54\uB366\uB609\u027A\u3FE7\u02E0\u5C0B\u8170"
        + "\u3FD5\u1AAD\u872D\uF82E\uBC7D\u8DB0\uA7CC\u1543\u3FE6\uE1F7\u6B43\u37C7\u3FD5\u7677\u1745\u5A6C\uBC6F\uB2A4\u9AF9\u33E8"
        + "\u3FE6\uC16C\u16C1\u6C17\u3FD5\uD1BD\uBF58\u09CA\uBC77\uDC9C\u7C23\u801F\u3FE6\uA13C\uD153\u7290\u3FD6\u2C82\uF2B9\uC796"
        + "\uBC50\u90A0\uDD59\uFE35";
    // atan(j/32), j from 0 to 32, in two parts.
    const string AtanTable =
          "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u3F9F\uFD55\uBBA9\u7625\uBC35\uEC43\u1444\u912C\u3FAF\uF55B\uB72C\uFDEA"
        + "\uBC3C\u934D\u86D2\u3F1D\u3FB7\uEE18\u2602\uF10F\uBC5C\uFB65\u4C0C\u3D98\u3FBF\uD5BA\u9AAC\u2F6E\uBC4C\uD376\u8676\u0C17"
        + "\u3FC3\uD6EE\uE8C6\u626C\u3C66\u1A3B\u0CE9\u281B\u3FC7\uB97B\u4BCE\u5B02\u3C53\u47B0\uB4F8\u81CA\u3FCB\u90D7\u5292\u60A2"
        + "\u3C21\u7B10\uD2E0\uE5AB\u3FCF\u5B75\uF92C\u80DD\u3C68\uAB6E\u3CF7\uAFBD\u3FD1\u8BF5\uA30B\uF178\u3C63\u0CA4\u748B\u1BF9"
        + "\u3FD3\u6277\u3707\uEBCC\uBC69\u63A5\u44B6\u72D8\u3FD5\u30AD\u9951\uCD4A\uBC62\u5664\u8088\u4082\u3FD6\uF619\u41E4\uDEF1"
        + "\uBC7C\u63AA\uE6F6\uE918\u3FD8\uB24D\u394A\u1B25\u3C7B\u6D0B\uA374\u8FA8\u3FDA\u64EE\uC3CC\u23FD\uBC72\u4DEC\u1B50\uB7FF"
        + "\u3FDC\u0DB4\uC94E\uC9F0\uBC7C\uC1CE\u7093\u4C34\u3FDD\uAC67\u0561\uBB4F\u3C7A\u2B7F\u222F\u65E2\u3FDF\u40DD\u0B54\u1418"
        + "\uBC6A\u3992\uDC38\u2A23\u3FE0\u657E\u94DB\u30D0\uBC7D\u5B49\u5F63\u49E6\u3FE1\u255D\u9BFB\uD2A9\uBC52\uBDAE\uE1C0\uEE35"
        + "\u3FE1\uE00B\uABDE\uFEB4\uBC59\u28DF\u287A\u668F\u3FE2\u958E\u5930\u8E31\uBC70\u9E73\uB0C6\uC087\u3FE3\u45F0\u1CCE\u37BB"
        + "\u3C81\u0211\u37C7\u1102\u3FE3\uF13F\uB89E\u96F4\u3C7E\uCF8B\u4926\u44F0\u3FE4\u978F\uA326\u9EE1\u3C72\u419A\u87F2\uA458"
        + "\u3FE5\u38F5\u7B89\u061F\uBC81\uBB74\uABDA\u520C\u3FE5\uD589\u8716\u9B18\u3C60\u028E\u4BC5\uE7CA\u3FE6\u6D66\u3923\uE087"
        + "\uBC76\uEA6F\uEBE8\uBBBA\u3FE7\u00A7\uC578\u4634\uBC78\uC34D\u25AA\uDEF6\u3FE7\u8F6B\uBD5D\u315E\u3C84\u06A0\u8980\u3740"
        + "\u3FE8\u19D0\uB715\u8A4D\uBC7B\uF762\u29D3\uB917\u3FE8\u9FF5\uFF57\uF1F8\uBC85\u5B9A\u5E17\u7A1B\u3FE9\u21FB\u5444\u2D18"
        + "\u3C81\uA626\u3314\u5C07";
    // 2/pi, 24 bits at a time from its first fraction bit, as two units each: the bits a huge angle is reduced by.
    const string TwoOverPiBits =
          "\u00A2\uF983\u006E\u4E44\u0015\u29FC\u0027\u57D1\u00F5\u34DD\u00C0\uDB62\u0095\u993C\u0043\u9041\u00FE\u5163\u00AB\uDEBB"
        + "\u00C5\u61B7\u0024\u6E3A\u0042\u4DD2\u00E0\u0649\u002E\uEA09\u00D1\u921C\u00FE\u1DEB\u001C\uB129\u00A7\u3EE8\u0082\u35F5"
        + "\u002E\uBB44\u0084\uE99C\u0070\u26B4\u005F\u7E41\u0039\u91D6\u0039\u8353\u0039\uF49C\u0084\u5F8B\u00BD\uF928\u003B\u1FF8"
        + "\u0097\uFFDE\u0005\u980F\u00EF\u2F11\u008B\u5A0A\u006D\u1F6D\u0036\u7ECF\u0027\uCB09\u00B7\u4F46\u003F\u669E\u005F\uEA2D"
        + "\u0075\u27BA\u00C7\uEBE5\u00F1\u7B3D\u0007\u39F7\u008A\u5292\u00EA\u6BFB\u005F\uB11F\u008D\u5D08\u0056\u0330\u0046\uFC7B"
        + "\u006B\uABF0\u00CF\uBC20\u009A\uF436\u001D\uA9E3\u0091\u615E\u00E6\u1B08\u0065\u9985\u005F\u14A0\u0068\u408D\u00FF\uD880"
        + "\u004D\u7327\u0031\u0606\u0015\u56CA\u0073\uA8C9\u0060\uE27B\u00C0\u8C6B\u0047\uC400";

    // ---- e to a power: glibc's exp, operation for operation ----------------
    //
    // x = k ln2/128 + r with |r| <= ln2/256, and e^x = 2^(k/128) e^r: the
    // power of two from the table (a scale and the tail it lost), e^r from a
    // polynomial of degree five. The five fused multiply-adds are the ones
    // glibc's x86-64 build makes, which is what gives its last bit.
    const double ExpInvLn2N = 184.6649652337873;
    const double ExpShift = 6755399441055744.0;
    const double ExpNegLn2HiN = -0.005415212348111709;
    const double ExpNegLn2LoN = -1.2864023111638346e-14;
    const double ExpC2 = 0.49999999999996786;
    const double ExpC3 = 0.16666666666665886;
    const double ExpC4 = 0.0416666808410674;
    const double ExpC5 = 0.008333335853059549;

    public static double Exp(double x) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        int abstop = (int)((bits >> 52) & 0x7FF);
        // 0x3C9 is the top of 2^-54, 0x408 of 512 (glibc's top12).
        if ((uint)(abstop - 0x3C9) >= (uint)(0x408 - 0x3C9)) {
            if (abstop - 0x3C9 < 0) {
                // Tiny or zero: 1 + x, which is 1 rounded the right way.
                return 1.0 + x;
            }
            if (abstop >= 0x409) {
                if (bits == unchecked((long)0xFFF0000000000000)) { return 0.0; }
                if (abstop >= 0x7FF) { return 1.0 + x; }
                return bits < 0 ? 0.0 : double.PositiveInfinity;
            }
            // Large: the scale may overflow or underflow, which ExpSpecial
            // takes care of.
            abstop = 0;
        }
        double z = ExpInvLn2N * x;
        double kd = z + ExpShift;
        ulong ki = (ulong)BitConverter.DoubleToInt64Bits(kd);
        kd = kd - ExpShift;
        double r = Runtime.FusedMultiplyAdd(kd, ExpNegLn2LoN, Runtime.FusedMultiplyAdd(kd, ExpNegLn2HiN, x));
        int idx = 2 * (int)(ki & 127);
        ulong top = ki << 45;
        double tail = BitConverter.Int64BitsToDouble(TableBits(ExpTable, idx));
        ulong sbits = (ulong)TableBits(ExpTable, idx + 1) + top;
        double r2 = r * r;
        double tmp = Runtime.FusedMultiplyAdd(r2 * r2, Runtime.FusedMultiplyAdd(r, ExpC5, ExpC4), Runtime.FusedMultiplyAdd(r2, Runtime.FusedMultiplyAdd(r, ExpC3, ExpC2), tail + r));
        if (abstop == 0) { return ExpSpecial(tmp, sbits, ki); }
        double scale = BitConverter.Int64BitsToDouble((long)sbits);
        return Runtime.FusedMultiplyAdd(scale, tmp, scale);
    }

    // The scale out of range: up by 2^1009 after, or into the subnormals
    // rounded once, through 1 + y, rather than twice. Below, scale times tmp
    // is used twice and glibc's build fuses neither use.
    static double ExpSpecial(double tmp, ulong sbits, ulong ki) {
        if ((ki & 0x80000000) == 0) {
            double big = BitConverter.Int64BitsToDouble((long)(sbits - ((ulong)1009 << 52)));
            return TwoTo(1009) * Runtime.FusedMultiplyAdd(big, tmp, big);
        }
        double scale = BitConverter.Int64BitsToDouble((long)(sbits + ((ulong)1022 << 52)));
        double scaled = scale * tmp;
        double y = scale + scaled;
        if (y < 1.0) {
            double lo = scale - y + scaled;
            double hi = 1.0 + y;
            lo = 1.0 - hi + y + lo;
            y = (hi + lo) - 1.0;
            if (y == 0.0) { y = 0.0; }
        }
        return TwoTo(-1022) * y;
    }

    // ---- the trigonometric functions, correctly rounded ---------------------
    //
    // THE ANGLE LESS THE NEAREST MULTIPLE OF pi/2, exactly enough: below
    // 2^20 pi/2 in six parts of pi/2 (the first four with 33 bits, so their
    // products with n are exact), and otherwise -- or when what is left is
    // small enough that those parts are not enough -- by 2/pi's own bits
    // (Payne and Hanek), the angle's 53-bit mantissa times the 2/pi bits
    // around its exponent in integers, of which only the fraction and the
    // quadrant are wanted. Then a series in double-double on [-pi/4, pi/4].

    // The remainder as a pair, and the quadrant (n mod 4).
    static double QuarterTurns(double x, out double lo, out int quadrant) {
        if (Abs(x) < 1647099.0) {
            double n = Math.Floor(x * 0.6366197723675814 + 0.5);
            double rh = x - n * 1.5707963267341256;
            double rl = 0.0;
            double e;
            rh = TwoSum(rh, -n * 6.077100506303966e-11, out e);
            rl = rl + e;
            rh = QuickTwoSum(rh, rl, out rl);
            rh = TwoSum(rh, -n * 2.0222662487111665e-21, out e);
            rl = rl + e;
            rh = QuickTwoSum(rh, rl, out rl);
            rh = TwoSum(rh, -n * 8.478427660348229e-32, out e);
            rl = rl + e;
            rh = QuickTwoSum(rh, rl, out rl);
            rh = TwoSum(rh, -n * 2.0670321098263988e-43, out e);
            rl = rl + e;
            rh = QuickTwoSum(rh, rl, out rl);
            rl = rl - n * 2.5463057961157e-60;
            rh = QuickTwoSum(rh, rl, out rl);
            if (Abs(rh) > TwoTo(-20)) {
                quadrant = (int)n & 3;
                lo = rl;
                return rh;
            }
        }
        return HugeQuarterTurns(x, out lo, out quadrant);
    }

    // x 2/pi mod 4 in integers: x = M 2^E, and 2/pi = sum of c_k 2^(-24(k+1)),
    // so x 2/pi is the sum of M c_k 2^(E - 24k - 24). The terms whose power
    // is 4 or more are multiples of 4 and are left out; those far enough
    // below the point are too small to matter. What is left is summed in
    // 24-bit limbs, least significant first.
    static double HugeQuarterTurns(double x, out double lo, out int quadrant) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        int exponent = (int)((bits >> 52) & 0x7FF) - 1075;
        long mantissa = (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
        int first = exponent >= 25 ? (exponent - 25 + 23) / 24 : 0;
        int last = (183 + exponent) / 24 + 2;

        // The product M (three 24-bit limbs) by c_first..c_last, as limbs:
        // limb j is worth 2^(24j) times the last chunk's place.
        int count = last - first + 4;
        long[] limbs = new long[count];
        long m0 = mantissa & 0xFFFFFF;
        long m1 = (mantissa >> 24) & 0xFFFFFF;
        long m2 = mantissa >> 48;
        for (int k = first; k <= last; k++) {
            long chunk = ((long)Sys.GetChar(TwoOverPiBits, 2 * k) << 16) | (long)Sys.GetChar(TwoOverPiBits, 2 * k + 1);
            int j = last - k;
            limbs[j] = limbs[j] + m0 * chunk;
            limbs[j + 1] = limbs[j + 1] + m1 * chunk;
            limbs[j + 2] = limbs[j + 2] + m2 * chunk;
        }
        for (int j = 0; j < count - 1; j++) {
            limbs[j + 1] = limbs[j + 1] + (limbs[j] >> 24);
            limbs[j] = limbs[j] & 0xFFFFFF;
        }

        // The value is the limbs times 2^(E - 24 last - 24): its fraction has
        // `point` bits, and the two above it are the quadrant.
        int point = 24 * (last + 1) - exponent;
        int q = (int)((Bit(limbs, point + 1) << 1) | Bit(limbs, point));
        bool half = Bit(limbs, point - 1) != 0;

        // The fraction alone, and at or past a half its complement 2^point
        // less it: the remainder below the next quadrant, taken negative.
        int fractionLimbs = (point + 23) / 24;
        long topMask = ((long)1 << (point - 24 * (fractionLimbs - 1))) - 1;
        limbs[fractionLimbs - 1] = limbs[fractionLimbs - 1] & topMask;
        if (half) {
            q = q + 1;
            long carry = 1;
            for (int j = 0; j < fractionLimbs; j++) {
                long v = (~limbs[j] & 0xFFFFFF) + carry;
                carry = v >> 24;
                limbs[j] = v & 0xFFFFFF;
            }
            limbs[fractionLimbs - 1] = limbs[fractionLimbs - 1] & topMask;
        }

        // Its leading 106 bits, from its first one, as two doubles of 53;
        // bit p of the fraction is worth 2^(p - point).
        int lead = point - 1;
        while (lead >= 0 && Bit(limbs, lead) == 0) { lead = lead - 1; }
        double fh = 0.0;
        double fl = 0.0;
        if (lead >= 0) {
            long a = 0;
            long b = 0;
            for (int i = 0; i < 53; i++) {
                a = (a << 1) | (lead - i >= 0 ? Bit(limbs, lead - i) : 0L);
            }
            for (int i = 53; i < 106; i++) {
                b = (b << 1) | (lead - i >= 0 ? Bit(limbs, lead - i) : 0L);
            }
            fh = ScaleB((double)a, lead - point - 52);
            fl = ScaleB((double)b, lead - point - 105);
            fh = QuickTwoSum(fh, fl, out fl);
        }
        double rl;
        double rh = PairMul(fh, fl, 1.5707963267948966, 6.123233995736766e-17, out rl);
        if (half) {
            rh = -rh;
            rl = -rl;
        }
        if (x < 0.0) {
            rh = -rh;
            rl = -rl;
            q = -q;
        }
        quadrant = q & 3;
        lo = rl;
        return rh;
    }

    // Bit i of a number held as 24-bit limbs.
    static long Bit(long[] limbs, int i) { return (limbs[i / 24] >> (i % 24)) & 1; }

    // sin(r) or cos(r), |r| <= pi/4, as a pair: the series in r^2, its first
    // six terms in double-double and the rest, below 2^-37, in double.
    static double SinOrCos(double rh, double rl, bool cosine, out double lo) {
        double zl;
        double zh = PairMul(rh, rl, rh, rl, out zl);
        double z = zh;
        double t;
        double pl = 0.0;
        double ph;
        if (cosine) {
            t = (((((((3.279889237069838e-30 * z - 2.4795962632247976e-27) * z + 1.6117375710961184e-24) * z
                - 8.896791392450574e-22) * z + 4.110317623312165e-19) * z - 1.5619206968586225e-16) * z
                + 4.779477332387385e-14) * z - 1.1470745597729725e-11) * z + 2.08767569878681e-09;
            ph = PairMul(t, 0.0, zh, zl, out pl);
            ph = PairAdd(ph, pl, -2.755731922398589e-07, -2.3767714622250297e-23, out pl);
            ph = PairMul(ph, pl, zh, zl, out pl);
            ph = PairAdd(ph, pl, 2.48015873015873e-05, 2.1511947866775882e-23, out pl);
            ph = PairMul(ph, pl, zh, zl, out pl);
            ph = PairAdd(ph, pl, -0.001388888888888889, 5.300543954373577e-20, out pl);
            ph = PairMul(ph, pl, zh, zl, out pl);
            ph = PairAdd(ph, pl, 0.041666666666666664, 2.3129646346357427e-18, out pl);
            ph = PairMul(ph, pl, zh, zl, out pl);
            ph = PairAdd(ph, pl, -0.5, 0.0, out pl);
            ph = PairMul(ph, pl, zh, zl, out pl);
            return PairAdd(ph, pl, 1.0, 0.0, out lo);
        }
        t = (((((((1.1309962886447716e-31 * z - 9.183689863795546e-29) * z + 6.446950284384474e-26) * z
            - 3.868170170630684e-23) * z + 1.9572941063391263e-20) * z - 8.22063524662433e-18) * z
            + 2.8114572543455206e-15) * z - 7.647163731819816e-13) * z + 1.6059043836821613e-10;
        ph = PairMul(t, 0.0, zh, zl, out pl);
        ph = PairAdd(ph, pl, -2.505210838544172e-08, 1.448814070935912e-24, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, 2.7557319223985893e-06, -1.858393274046472e-22, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, -0.0001984126984126984, -1.7209558293420705e-22, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, 0.008333333333333333, 1.1564823173178714e-19, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, -0.16666666666666666, -9.25185853854297e-18, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, 1.0, 0.0, out pl);
        return PairMul(ph, pl, rh, rl, out lo);
    }

    /// A NaN COMES BACK AS ITSELF, payload and sign, as glibc's x / x
    /// returns it; an infinity is no angle, and the NaN an invalid operation
    /// makes.
    public static double Sin(double x) {
        if (x != x) { return x; }
        if (x - x != 0.0) { return double.NaN; }
        if (x == 0.0) { return x; }
        int quadrant = 0;
        double rl = 0.0;
        double rh = x;
        if (Abs(x) > 0.7853981633974483) { rh = QuarterTurns(x, out rl, out quadrant); }
        double l;
        double h = SinOrCos(rh, rl, (quadrant & 1) != 0, out l);
        double made = h + l;
        return (quadrant & 2) != 0 ? -made : made;
    }

    public static double Cos(double x) {
        if (x != x) { return x; }
        if (x - x != 0.0) { return double.NaN; }
        int quadrant = 0;
        double rl = 0.0;
        double rh = x;
        if (Abs(x) > 0.7853981633974483) { rh = QuarterTurns(x, out rl, out quadrant); }
        double l;
        double h = SinOrCos(rh, rl, (quadrant & 1) == 0, out l);
        double made = h + l;
        return ((quadrant + 1) & 2) != 0 ? -made : made;
    }

    /// Sine over cosine, both as pairs; past an odd quadrant, minus the
    /// cosine over the sine.
    public static double Tan(double x) {
        if (x != x) { return x; }
        if (x - x != 0.0) { return double.NaN; }
        if (x == 0.0) { return x; }
        int quadrant = 0;
        double rl = 0.0;
        double rh = x;
        if (Abs(x) > 0.7853981633974483) { rh = QuarterTurns(x, out rl, out quadrant); }
        double sl;
        double sh = SinOrCos(rh, rl, false, out sl);
        double cl;
        double ch = SinOrCos(rh, rl, true, out cl);
        double l;
        double h = (quadrant & 1) != 0 ? PairDiv(-ch, -cl, sh, sl, out l) : PairDiv(sh, sl, ch, cl, out l);
        return h + l;
    }

    /// The most negative value has no positive twin, and .NET refuses it.
    public static int Abs(int x) {
        if (x < 0) {
            if (x == int.MinValue) { throw NegatedMinimum(); }
            return -x;
        }
        return x;
    }

    public static long Abs(long x) {
        if (x < 0) {
            if (x == long.MinValue) { throw NegatedMinimum(); }
            return -x;
        }
        return x;
    }

    public static sbyte Abs(sbyte x) {
        if (x < 0) {
            if (x == sbyte.MinValue) { throw NegatedMinimum(); }
            return (sbyte)(-x);
        }
        return x;
    }

    public static short Abs(short x) {
        if (x < 0) {
            if (x == short.MinValue) { throw NegatedMinimum(); }
            return (short)(-x);
        }
        return x;
    }

    public static nint Abs(nint x) {
        if (x < 0) {
            if (x == nint.MinValue) { throw NegatedMinimum(); }
            return -x;
        }
        return x;
    }

    /// THE SIGN BIT CLEARED, and nothing else changed: -0 becomes 0 and a NaN
    /// stays the NaN it was, which a test against zero gets wrong for both.
    public static float Abs(float x) {
        return BitConverter.Int32BitsToSingle(BitConverter.SingleToInt32Bits(x) & 0x7FFFFFFF);
    }

    private static OverflowException NegatedMinimum() {
        return new OverflowException("Negating the minimum value of a twos complement number is invalid.");
    }

    public static int Sign(int x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Sign(long x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    public static int Sign(sbyte x) { return Sign((int)x); }
    public static int Sign(short x) { return Sign((int)x); }

    public static int Sign(nint x) {
        if (x > 0) { return 1; }
        if (x < 0) { return -1; }
        return 0;
    }

    /// One Clamp for every type .NET has one for, and each refuses a range
    /// whose ends are the wrong way round before it looks at the value.
    public static int Clamp(int x, int low, int high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static long Clamp(long x, long low, long high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static byte Clamp(byte x, byte low, byte high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static sbyte Clamp(sbyte x, sbyte low, sbyte high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static short Clamp(short x, short low, short high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static ushort Clamp(ushort x, ushort low, ushort high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static uint Clamp(uint x, uint low, uint high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static ulong Clamp(ulong x, ulong low, ulong high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static nint Clamp(nint x, nint low, nint high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    public static nuint Clamp(nuint x, nuint low, nuint high) {
        if (low > high) { throw MinMax(low, high); }
        return Min(Max(x, low), high);
    }

    /// As the double one: a NaN passes through.
    public static float Clamp(float x, float low, float high) {
        if (low > high) { throw MinMax(low, high); }
        if (x < low) { return low; }
        if (x > high) { return high; }
        return x;
    }

    // TO THE EVEN NEIGHBOUR AT A HALF, which is .NET's DEFAULT and the half
    // everybody gets wrong: Math.Round(2.5) is 2 and Math.Round(3.5) is 4. The
    // rule exists because always rounding a half upwards biases a long column
    // of figures upwards, and banking noticed. The other rules are asked for
    // by name, with MidpointRounding.
    public static double Round(double x, int digits) {
        return Round(x, digits, MidpointRounding.ToEven);
    }

    public static double Round(double x, MidpointRounding mode) {
        return Round(x, 0, mode);
    }

    /// FIFTEEN PLACES AT MOST, AND ONLY BELOW 1e16, as .NET has it: a double
    /// has no sixteenth digit to round, and a number that large is whole
    /// already. Away from zero adds the double just below a half, not the
    /// half: 0.49999999999999994 plus 0.5 rounds up to 1, and a number below
    /// the half went up with it.
    public static double Round(double x, int digits, MidpointRounding mode) {
        if ((uint)digits > 15) { throw new ArgumentOutOfRangeException("digits", "Rounding digits must be between 0 and 15, inclusive."); }
        if (mode < MidpointRounding.ToEven || mode > MidpointRounding.ToPositiveInfinity) { throw BadRounding(mode); }
        if (Abs(x) < 1e16) {
            double scale = 1.0;
            for (int i = 0; i < digits; i++) { scale = scale * 10.0; }

            double scaled = x * scale;
            double whole = 0.0;

            if (mode == MidpointRounding.AwayFromZero) {
                whole = Math.Truncate(scaled + CopySign(BitDecrement(0.5), scaled));
            } else if (mode == MidpointRounding.ToZero) {
                whole = Math.Truncate(scaled);
            } else if (mode == MidpointRounding.ToNegativeInfinity) {
                whole = Math.Floor(scaled);
            } else if (mode == MidpointRounding.ToPositiveInfinity) {
                whole = Math.Ceiling(scaled);
            } else {
                whole = Math.Round(scaled);
            }
            x = whole / scale;
        }
        return x;
    }

    // .NET's refusal of a mode that is none of the five, which MathF's Round
    // shares.
    internal static ArgumentException BadRounding(MidpointRounding mode) {
        return new ArgumentException("The value '" + (int)mode + "' is not valid for this usage of the type MidpointRounding.", "mode");
    }

    // Whether y is a whole number, and whether an odd one. Every double from
    // 2^53 up is even, and its half is whole too, so the halving needs no
    // limit of its own.
    static bool IsInteger(double y) { return y - y == 0.0 && Math.Floor(y) == y; }
    static bool IsOddInteger(double y) { return IsInteger(y) && Math.Floor(y * 0.5) != y * 0.5; }

    // ---- e^x - 1 and log(1 + x): glibc's (fdlibm's), as it builds them -----
    //
    // Not .NET members, but what Sinh, Cosh, Tanh, Asinh, Acosh and Atanh are
    // made of, as glibc makes them, so that those answer as glibc's do. The
    // multiply-adds marked Fma are the ones its build fuses.

    static int HighWord(double x) { return (int)(BitConverter.DoubleToInt64Bits(x) >> 32); }
    static uint LowWord(double x) { return (uint)BitConverter.DoubleToInt64Bits(x); }

    static double WithHighWord(double x, int high) {
        return BitConverter.Int64BitsToDouble(((long)high << 32) | (long)LowWord(x));
    }

    const double Ln2Hi = 6.93147180369123816490e-01;
    const double Ln2Lo = 1.90821492927058770002e-10;

    static double Expm1(double x) {
        int hx = HighWord(x);
        bool negative = hx < 0;
        hx = hx & 0x7fffffff;

        if (hx >= 0x4043687A) {
            if (hx >= 0x40862E42) {
                if (hx >= 0x7ff00000) {
                    if (((hx & 0xfffff) | (int)LowWord(x)) != 0) { return x + x; }
                    return negative ? -1.0 : x;
                }
                if (x > 7.09782712893383973096e+02) { return double.PositiveInfinity; }
            }
            if (negative) { return -1.0; }
        }

        double c = 0.0;
        int k;
        if (hx > 0x3fd62e42) {
            double hi;
            double lo;
            if (hx < 0x3FF0A2B2) {
                if (!negative) {
                    hi = x - Ln2Hi;
                    lo = Ln2Lo;
                    k = 1;
                } else {
                    hi = x + Ln2Hi;
                    lo = -Ln2Lo;
                    k = -1;
                }
            } else {
                k = (int)Runtime.FusedMultiplyAdd(1.44269504088896338700e+00, x, negative ? -0.5 : 0.5);
                double t = k;
                hi = Runtime.FusedMultiplyAdd(-t, Ln2Hi, x);
                lo = t * Ln2Lo;
            }
            x = hi - lo;
            c = (hi - x) - lo;
        } else if (hx < 0x3c900000) {
            return x;
        } else {
            k = 0;
        }

        double hfx = 0.5 * x;
        double hxs = x * hfx;
        double r1 = Runtime.FusedMultiplyAdd(hxs, -3.33333333333331316428e-02, 1.0);
        double h2 = hxs * hxs;
        double r2 = Runtime.FusedMultiplyAdd(hxs, -7.93650757867487942473e-05, 1.58730158725481460165e-03);
        double h4 = h2 * h2;
        double r3 = Runtime.FusedMultiplyAdd(hxs, -2.01099218183624371326e-07, 4.00821782732936239552e-06);
        r1 = Runtime.FusedMultiplyAdd(h4, r3, Runtime.FusedMultiplyAdd(h2, r2, r1));
        double tt = Runtime.FusedMultiplyAdd(-r1, hfx, 3.0);
        double e = hxs * ((r1 - tt) / Runtime.FusedMultiplyAdd(-x, tt, 6.0));
        if (k == 0) { return x - Runtime.FusedMultiplyAdd(x, e, -hxs); }

        e = Runtime.FusedMultiplyAdd(x, e - c, -c);
        e = e - hxs;
        if (k == -1) { return Runtime.FusedMultiplyAdd(0.5, x - e, -0.5); }
        if (k == 1) {
            if (x < -0.25) { return -2.0 * (e - (x + 0.5)); }
            return Runtime.FusedMultiplyAdd(2.0, x - e, 1.0);
        }
        double y;
        if (k <= -2 || k > 56) {
            y = 1.0 - (e - x);
            if (k == 1024) {
                y = y * 2.0 * TwoTo(1023);
            } else {
                y = WithHighWord(y, HighWord(y) + (k << 20));
            }
            return y - 1.0;
        }
        if (k < 20) {
            double t = BitConverter.Int64BitsToDouble((long)(0x3ff00000 - (0x200000 >> k)) << 32);
            y = t - (e - x);
            y = WithHighWord(y, HighWord(y) + (k << 20));
        } else {
            double t = BitConverter.Int64BitsToDouble((long)((0x3ff - k) << 20) << 32);
            y = x - (e + t);
            y = y + 1.0;
            y = WithHighWord(y, HighWord(y) + (k << 20));
        }
        return y;
    }

    static double Log1p(double x) {
        int hx = HighWord(x);
        int ax = hx & 0x7fffffff;
        int k = 1;
        int hu = 0;
        double f = 0.0;

        if (hx < 0x3FDA827A) {
            if (ax >= 0x3ff00000) {
                if (x == -1.0) { return double.NegativeInfinity; }
                return double.NaN;
            }
            if (ax < 0x3e200000) {
                if (ax < 0x3c900000) { return x; }
                return x - x * x * 0.5;
            }
            if (hx > 0 || hx <= unchecked((int)0xbfd2bec4)) {
                k = 0;
                f = x;
                hu = 1;
            }
        } else if (hx >= 0x7ff00000) {
            return x + x;
        }

        double c = 0.0;
        if (k != 0) {
            double u;
            if (hx < 0x43400000) {
                u = 1.0 + x;
                hu = HighWord(u);
                k = (hu >> 20) - 1023;
                c = k > 0 ? 1.0 - (u - x) : x - (u - 1.0);
                c = c / u;
            } else {
                u = x;
                hu = HighWord(u);
                k = (hu >> 20) - 1023;
                c = 0.0;
            }
            hu = hu & 0x000fffff;
            if (hu < 0x6a09e) {
                u = WithHighWord(u, hu | 0x3ff00000);
            } else {
                k = k + 1;
                u = WithHighWord(u, hu | 0x3fe00000);
                hu = (0x00100000 - hu) >> 2;
            }
            f = u - 1.0;
        }

        double hfsq = 0.5 * f * f;
        if (hu == 0) {
            if (f == 0.0) {
                if (k == 0) { return 0.0; }
                c = c + k * Ln2Lo;
                return k * Ln2Hi + c;
            }
            double rr = hfsq * (1.0 - 0.66666666666666666 * f);
            if (k == 0) { return f - rr; }
            return k * Ln2Hi - ((rr - (k * Ln2Lo + c)) - f);
        }
        double s = f / (2.0 + f);
        double z = s * s;
        double z2 = z * z;
        double z4 = z2 * z2;
        double z6 = z4 * z2;
        double r2 = 3.999999999940941908e-01 + z * 2.857142874366239149e-01;
        double r3 = 2.222219843214978396e-01 + z * 1.818357216161805012e-01;
        double r4 = 1.531383769920937332e-01 + z * 1.479819860511658591e-01;
        double r = Runtime.FusedMultiplyAdd(z6, r4, Runtime.FusedMultiplyAdd(z4, r3, Runtime.FusedMultiplyAdd(z, 6.666666666666735130e-01, z2 * r2)));
        if (k == 0) { return f - (hfsq - s * (hfsq + r)); }
        return k * Ln2Hi - ((hfsq - (s * (hfsq + r) + (k * Ln2Lo + c))) - f);
    }

    // ---- logarithms, correctly rounded -------------------------------------
    //
    // x = 2^k m with m in [sqrt(1/2), sqrt(2)); m near c = 1 + j/128, so
    // m/c = 1 + r with |r| below 2^-7.5, r exact as m times the table's
    // rounded 1/c less one. log x = k ln2 - log(1/c) + log(1 + r), the series
    // for the last carried in double-double as far as it matters.
    const double Ln2PairHi = 0.6931471805599453;
    const double Ln2PairLo = 2.3190468138462996e-17;

    // log(m) for x's m, as a pair, and x's k. x is positive and finite.
    static double LogParts(double x, out double lo, out int k) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        int e = (int)((bits >> 52) & 0x7FF);
        if (e == 0) {
            bits = BitConverter.DoubleToInt64Bits(x * TwoTo(54));
            e = (int)((bits >> 52) & 0x7FF) - 54;
        }
        k = e - 1023;
        double m = BitConverter.Int64BitsToDouble((bits & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000);
        if (m > 1.4142135623730951) {
            m = m * 0.5;
            k = k + 1;
        }
        int j = (int)Math.Floor((m - 1.0) * 128.0 + 0.5) + 38;
        double invc = TableEntry(LogTable, 3 * j);
        double pl;
        double ph = TwoProduct(m, invc, out pl);
        double rl;
        double rh = QuickTwoSum(ph - 1.0, pl, out rl);

        // log(1 + r) = r - r^2/2 + r^3/3 - r^4 (1/4 - r/5 + ...)
        double r2l;
        double r2h = PairMul(rh, rl, rh, rl, out r2l);
        double r3l;
        double r3h = PairMul(r2h, r2l, rh, rl, out r3l);
        double t3l;
        double t3h = PairDiv(r3h, r3l, 3.0, 0.0, out t3l);
        double r = rh;
        double tail = r2h * r2h * (-0.25 + r * (0.2 + r * (-0.16666666666666666 + r * (0.14285714285714285 + r * (-0.125
                    + r * (0.1111111111111111 + r * (-0.1 + r * (0.09090909090909091 + r * -0.08333333333333333))))))));
        double sl;
        double sh = PairAdd(rh, rl, -0.5 * r2h, -0.5 * r2l, out sl);
        sh = PairAdd(sh, sl, t3h, t3l, out sl);
        sh = PairAddDouble(sh, sl, tail, out sl);
        return PairAdd(TableEntry(LogTable, 3 * j + 1), TableEntry(LogTable, 3 * j + 2), sh, sl, out lo);
    }

    // log x as a pair, x positive and finite.
    static double LogPair(double x, out double lo) {
        int k;
        double l;
        double h = LogParts(x, out l, out k);
        double kl;
        double kh = TwoProduct(k, Ln2PairHi, out kl);
        kl = kl + k * Ln2PairLo;
        return PairAdd(kh, kl, h, l, out lo);
    }

    public static double Log(double x) {
        if (x != x) { return x; }
        if (x < 0.0) { return double.NaN; }
        if (x == 0.0) { return double.NegativeInfinity; }
        if (double.IsPositiveInfinity(x)) { return x; }
        if (x == 1.0) { return 0.0; }
        double lo;
        return LogPair(x, out lo);
    }

    public static double Log2(double x) {
        if (x != x) { return x; }
        if (x < 0.0) { return double.NaN; }
        if (x == 0.0) { return double.NegativeInfinity; }
        if (double.IsPositiveInfinity(x)) { return x; }
        int k;
        double l;
        double h = LogParts(x, out l, out k);
        h = PairMul(h, l, 1.4426950408889634, 2.0355273740931033e-17, out l);
        h = PairAddDouble(h, l, k, out l);
        return h + l;
    }

    /// glibc's: log10(2) in two parts times the exponent, and the rest as
    /// the natural logarithm of x's mantissa over ln 10, which is the answer
    /// .NET gives to the bit, rounding and all.
    public static double Log10(double x) {
        int hx = HighWord(x);
        uint lx = LowWord(x);
        int k = 0;
        if (hx < 0x00100000) {
            if (((hx & 0x7fffffff) | (int)lx) == 0) { return double.NegativeInfinity; }
            if (hx < 0) { return x != x ? x : PositiveNaN(); }
            k = k - 54;
            x = x * TwoTo(54);
            hx = HighWord(x);
        }
        if (hx >= 0x7ff00000) { return x + x; }
        k = k + ((hx >> 20) - 1023);
        int i = (int)(((uint)k & 0x80000000) >> 31);
        hx = (hx & 0x000fffff) | ((0x3ff - i) << 20);
        double y = k + i;
        x = WithHighWord(x, hx);
        double z = y * 3.69423907715893078616e-13 + 4.34294481903251816668e-01 * Log(x);
        return z + y * 3.01029995663611771306e-01;
    }

    /// x TO A REAL POWER, as e^(y log x) in double-double and rounded once.
    ///
    /// THE SPECIAL CASES FIRST, as .NET answers them (C99's Annex F), because
    /// through the logarithm every one of them is wrong: a negative base has
    /// none, though (-2)^3 is -8; a zero's is minus infinity, though 0^-1 is
    /// infinity with the zero's sign when the power is odd; and 1^NaN is 1,
    /// as x^0 is for every x.
    public static double Pow(double x, double y) {
        if (y == 0.0 || x == 1.0) { return 1.0; }
        if (x != x || y != y) { return x + y; }
        if (x == 0.0) {
            // A zero keeps its sign only through an odd power, and below
            // zero the power divides by it: 1/-0 is minus infinity.
            if (y < 0.0) { return IsOddInteger(y) ? 1.0 / x : double.PositiveInfinity; }
            return IsOddInteger(y) ? x : 0.0;
        }
        if (double.IsInfinity(y)) {
            double size = Abs(x);
            if (size == 1.0) { return 1.0; }
            return (size < 1.0) == (y < 0.0) ? double.PositiveInfinity : 0.0;
        }
        if (double.IsInfinity(x)) {
            // Minus infinity to the y is -0 to the -y, and 1/x is that -0.
            if (x < 0.0) { return Pow(1.0 / x, -y); }
            return y < 0.0 ? 0.0 : x;
        }
        bool negative = false;
        if (x < 0.0) {
            if (!IsInteger(y)) { return double.NaN; }
            negative = IsOddInteger(y);
            x = -x;
            if (x == 1.0) { return negative ? -1.0 : 1.0; }
        }
        double ll;
        double lh = LogPair(x, out ll);
        // PAST WHAT A DOUBLE HOLDS the answer is known, and y is then too
        // large for the exact product's split.
        double z = lh * y;
        double made;
        if (z > 709.8) {
            made = double.PositiveInfinity;
        } else if (z < -745.2) {
            made = 0.0;
        } else {
            double zl;
            double zh = PairMulDouble(lh, ll, y, out zl);
            made = ExpPair(zh, zl);
        }
        return negative ? -made : made;
    }

    // e^(h + l) rounded once, |h| below 746: k ln2/128 taken off in three
    // parts (the first two exact in a product with k), e^r - 1 as a series,
    // and the same power-of-two table Exp reads.
    static double ExpPair(double h, double l) {
        int k = (int)Math.Floor(h * 184.6649652337873 + 0.5);
        double kf = k;
        double rh = h - kf * 0.005415212348452769;
        double rl;
        rh = TwoSum(rh, -kf * -3.281964900695705e-13, out rl);
        rl = rl + (l - kf * 1.636073772867244e-23);
        rh = QuickTwoSum(rh, rl, out rl);

        double r2l;
        double r2h = PairMul(rh, rl, rh, rl, out r2l);
        double r = rh;
        double tail = r2h * r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333
                    + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * 2.7557319223985893e-06))))));
        double pl;
        double ph = PairAdd(rh, rl, 0.5 * r2h, 0.5 * r2l, out pl);
        ph = PairAddDouble(ph, pl, tail, out pl);

        int i = k & 127;
        int e = (k - i) >> 7;
        // 2^(i/128) (1 + p) = H (1 + T)(1 + p) = H + H (T + p + T p)
        double t = BitConverter.Int64BitsToDouble(TableBits(ExpTable, 2 * i));
        double scale = BitConverter.Int64BitsToDouble(TableBits(ExpTable, 2 * i + 1) + ((long)i << 45));
        double ul;
        double uh = PairAddDouble(ph, pl, t, out ul);
        uh = QuickTwoSum(uh, ul + t * ph, out ul);
        double vl;
        double vh = PairMulDouble(uh, ul, scale, out vl);
        double sl;
        double sh = PairAddDouble(vh, vl, scale, out sl);
        return ScalePair(sh, sl, e);
    }

    // (h + l) 2^e rounded once, h near 1: into the subnormals through 1 + A,
    // which rounds at their last place, rather than rounding h and then
    // scaling it.
    static double ScalePair(double h, double l, int e) {
        if (e > -1022) { return ScaleB(h + l, e); }
        double ah = ScaleB(h, e + 1022);
        double al = ScaleB(l, e + 1022);
        double err;
        double t = TwoSum(1.0, ah, out err);
        t = t + (err + al);
        return TwoTo(-1022) * (t - 1.0);
    }

    /// A LOGARITHM TO ANY BASE, by the ratio of two natural ones, with .NET's
    /// answers where the ratio has none of its own: no base is 1, and 0 and
    /// infinity are bases only of 1, whose logarithm is 0 in every base.
    public static double Log(double x, double newBase) {
        if (x != x) { return x; }
        if (newBase != newBase) { return newBase; }
        if (newBase == 1.0) { return double.NaN; }
        if (x != 1.0 && (newBase == 0.0 || double.IsPositiveInfinity(newBase))) { return double.NaN; }
        return Log(x) / Log(newBase);
    }

    // ---- the rest of System.Math -----------------------------------------
    //
    // Software, because the 486 this targets may have no floating-point unit
    // at all and the ones it does have stop at square root. Each is the
    // identity a table of logarithms was built on, which is what makes them
    // short: the hard part is always the range reduction, never the series.

    /// THE WHOLE QUOTIENT AND WHAT IS LEFT, in one division. A processor
    /// computes both at once and .NET exposes that; two separate operations is
    /// twice the work for the same answer.
    public static int DivRem(int a, int b, out int remainder) {
        int whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    public static long DivRem(long a, long b, out long remainder) {
        long whole = a / b;

        remainder = a - whole * b;
        return whole;
    }

    /// THE PAIR AS A TUPLE, .NET's newer form, for every integer type: the
    /// quotient towards zero, and the remainder with the dividend's sign.
    public static (sbyte Quotient, sbyte Remainder) DivRem(sbyte left, sbyte right) {
        sbyte quotient = (sbyte)(left / right);
        return (quotient, (sbyte)(left - quotient * right));
    }

    public static (byte Quotient, byte Remainder) DivRem(byte left, byte right) {
        byte quotient = (byte)(left / right);
        return (quotient, (byte)(left - quotient * right));
    }

    public static (short Quotient, short Remainder) DivRem(short left, short right) {
        short quotient = (short)(left / right);
        return (quotient, (short)(left - quotient * right));
    }

    public static (ushort Quotient, ushort Remainder) DivRem(ushort left, ushort right) {
        ushort quotient = (ushort)(left / right);
        return (quotient, (ushort)(left - quotient * right));
    }

    public static (int Quotient, int Remainder) DivRem(int left, int right) {
        int quotient = left / right;
        return (quotient, left - quotient * right);
    }

    public static (uint Quotient, uint Remainder) DivRem(uint left, uint right) {
        uint quotient = left / right;
        return (quotient, left - quotient * right);
    }

    public static (long Quotient, long Remainder) DivRem(long left, long right) {
        long quotient = left / right;
        return (quotient, left - quotient * right);
    }

    public static (ulong Quotient, ulong Remainder) DivRem(ulong left, ulong right) {
        ulong quotient = left / right;
        return (quotient, left - quotient * right);
    }

    public static (nint Quotient, nint Remainder) DivRem(nint left, nint right) {
        nint quotient = left / right;
        return (quotient, left - quotient * right);
    }

    public static (nuint Quotient, nuint Remainder) DivRem(nuint left, nuint right) {
        nuint quotient = left / right;
        return (quotient, left - quotient * right);
    }

    /// The FULL product of two ints, which does not fit in an int: multiplying
    /// two numbers near a billion is the commonest overflow there is.
    public static long BigMul(int a, int b) { return (long)a * (long)b; }

    public static ulong BigMul(uint a, uint b) { return (ulong)a * (ulong)b; }

    /// THE HIGH HALF OF A 128-BIT PRODUCT, and the low half out. Four products
    /// of 32-bit halves, each of which fits in a ulong with room for a carry:
    /// the low halves' product, the two cross products, which straddle the
    /// middle, and the high halves', which the carries out of the middle join.
    public static ulong BigMul(ulong a, ulong b, out ulong low) {
        ulong aLow = (uint)a;
        ulong aHigh = a >> 32;
        ulong bLow = (uint)b;
        ulong bHigh = b >> 32;

        ulong lowest = aLow * bLow;
        ulong middle = aHigh * bLow + (lowest >> 32);
        ulong cross = aLow * bHigh + (uint)middle;

        low = (cross << 32) | (uint)lowest;
        return aHigh * bHigh + (middle >> 32) + (cross >> 32);
    }

    public static UInt128 BigMul(ulong a, ulong b) {
        ulong low;
        ulong high = BigMul(a, b, out low);

        return new UInt128(high, low);
    }

    /// THE SIGNED ONE FROM THE UNSIGNED: a negative factor read as unsigned is
    /// 2^64 too big, which adds the other factor once too often to the high
    /// half, and that is taken back off. The low half is the same bits either
    /// way.
    public static long BigMul(long a, long b, out long low) {
        ulong unsignedLow;
        ulong high = BigMul((ulong)a, (ulong)b, out unsignedLow);

        low = (long)unsignedLow;
        return (long)high - ((a >> 63) & b) - ((b >> 63) & a);
    }

    // ---- the inverse trigonometric functions, correctly rounded -------------
    //
    // atan t = atan c + atan((t - c)/(1 + c t)) with c = j/32 the nearest,
    // atan c from the table and the rest a series on |t| <= 1/64. Every
    // angle is an atan of a ratio of two pairs, taken the way round that
    // keeps the ratio at most 1: atan(y/x), or pi/2 less atan(x/y).

    // atan t, |t| <= 1/64, as a pair.
    static double AtanSmall(double th, double tl, out double lo) {
        double zl;
        double zh = PairMul(th, tl, th, tl, out zl);
        double z = zh;
        double s = (((((-0.05263157894736842 * z + 0.058823529411764705) * z - 0.06666666666666667) * z
            + 0.07692307692307693) * z - 0.09090909090909091) * z + 0.1111111111111111) * z - 0.14285714285714285;
        double pl;
        double ph = PairMul(s, 0.0, zh, zl, out pl);
        ph = PairAdd(ph, pl, 0.2, -1.1102230246251566e-17, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairAdd(ph, pl, -0.3333333333333333, -1.850371707708594e-17, out pl);
        ph = PairMul(ph, pl, zh, zl, out pl);
        ph = PairMul(ph, pl, th, tl, out pl);
        return PairAdd(th, tl, ph, pl, out lo);
    }

    // atan t, 0 <= t <= 1, as a pair.
    static double AtanUnit(double th, double tl, out double lo) {
        int j = (int)(th * 32.0 + 0.5);
        double c = j / 32.0;
        double nl;
        double nh = PairAddDouble(th, tl, -c, out nl);
        double dl;
        double dh = PairMulDouble(th, tl, c, out dl);
        dh = PairAddDouble(dh, dl, 1.0, out dl);
        double ul;
        double uh = PairDiv(nh, nl, dh, dl, out ul);
        double al;
        double ah = AtanSmall(uh, ul, out al);
        return PairAdd(TableEntry(AtanTable, 2 * j), TableEntry(AtanTable, 2 * j + 1), ah, al, out lo);
    }

    // atan(y/x), y >= 0 and x > 0 as pairs, as a pair; never the ratio of
    // the larger to the smaller, which may not be a double.
    static double AtanRatio(double yh, double yl, double xh, double xl, out double lo) {
        // Both well inside the doubles, so that no product the division
        // makes overflows its split or underflows into the subnormals: the
        // ratio is the same.
        double larger = yh > xh ? yh : xh;
        double by = larger > TwoTo(900) ? TwoTo(-200) : larger < TwoTo(-900) ? TwoTo(200) : 1.0;
        yh = yh * by;
        yl = yl * by;
        xh = xh * by;
        xl = xl * by;
        bool flipped = yh > xh;
        double nh = flipped ? xh : yh;
        double nl = flipped ? xl : yl;
        double dh = flipped ? yh : xh;
        double dl = flipped ? yl : xl;
        double tl;
        double th = PairDiv(nh, nl, dh, dl, out tl);
        double al;
        double ah;
        if (th < 2.0 * TwoTo(-1001)) {
            // Below every series term's reach: the ratio is the angle.
            ah = th;
            al = 0.0;
        } else if (nh < dh * TwoTo(-30)) {
            ah = AtanSmall(th, tl, out al);
        } else {
            ah = AtanUnit(th, tl, out al);
        }
        if (!flipped) {
            lo = al;
            return ah;
        }
        return PairAdd(1.5707963267948966, 6.123233995736766e-17, -ah, -al, out lo);
    }

    public static double Atan(double x) {
        if (x != x || x == 0.0) { return x; }
        if (double.IsInfinity(x)) { return x > 0.0 ? 1.5707963267948966 : -1.5707963267948966; }
        double l;
        double h = AtanRatio(Abs(x), 0.0, 1.0, 0.0, out l);
        double made = h + l;
        return x < 0.0 ? -made : made;
    }

    /// THE ANGLE OF A POINT, quadrant and all, which is why it takes the two
    /// coordinates rather than their ratio: y/x has thrown away the difference
    /// between the first quadrant and the third. .NET's answer is in
    /// [-pi, pi].
    ///
    /// ON AN AXIS AND AT INFINITY THE SIGNS DECIDE, as C99 and .NET have it:
    /// a zero y is above the axis or below it by its sign, so (-0, -1) is at
    /// -pi and (+0, -1) at pi, and a zero x is to the left when it is -0.
    /// Two infinities are at a diagonal.
    public static double Atan2(double y, double x) {
        if (x != x || y != y) { return x + y; }
        if (y == 0.0) {
            if (x > 0.0 || (x == 0.0 && !double.IsNegative(x))) { return y; }
            return double.IsNegative(y) ? -PI : PI;
        }
        if (x == 0.0) { return y < 0.0 ? -1.5707963267948966 : 1.5707963267948966; }
        double angle;
        if (double.IsInfinity(x)) {
            if (double.IsInfinity(y)) {
                angle = x > 0.0 ? 0.7853981633974483 : 2.356194490192345;
            } else {
                angle = x > 0.0 ? 0.0 : PI;
            }
            return y < 0.0 ? -angle : angle;
        }
        if (double.IsInfinity(y)) { return y < 0.0 ? -1.5707963267948966 : 1.5707963267948966; }
        double l;
        double h = AtanRatio(Abs(y), 0.0, Abs(x), 0.0, out l);
        if (x < 0.0) { h = PairAdd(PI, 1.2246467991473532e-16, -h, -l, out l); }
        angle = h + l;
        return y < 0.0 ? -angle : angle;
    }

    // sqrt(1 - a^2) = sqrt((1 - a)(1 + a)) as a pair, 0 <= a <= 1.
    // The NaN with the sign bit clear: what glibc's asin, acos and log10
    // answer out of their domains, where every other function answers the
    // invalid operation's (double.NaN).
    static double PositiveNaN() { return BitConverter.Int64BitsToDouble(0x7FF8000000000000); }

    static double RootOneLessSquare(double a, out double lo) {
        double ol;
        double oh = TwoSum(1.0, -a, out ol);
        double pl;
        double ph = TwoSum(1.0, a, out pl);
        double ql;
        double qh = PairMul(oh, ol, ph, pl, out ql);
        return PairSqrt(qh, ql, out lo);
    }

    /// OUTSIDE [-1, 1] IS NOT AN ANGLE, and .NET answers NaN rather than
    /// throwing -- the caller's arithmetic went wrong, not the call. That NaN
    /// is glibc's for these two, the sign bit clear.
    public static double Asin(double x) {
        if (x != x || x == 0.0) { return x; }
        if (x > 1.0 || x < -1.0) { return PositiveNaN(); }
        double a = Abs(x);
        double cl;
        double ch = RootOneLessSquare(a, out cl);
        double l;
        double h = ch == 0.0 ? QuickTwoSum(1.5707963267948966, 6.123233995736766e-17, out l) : AtanRatio(a, 0.0, ch, cl, out l);
        double made = h + l;
        return x < 0.0 ? -made : made;
    }

    public static double Acos(double x) {
        if (x != x) { return x; }
        if (x > 1.0 || x < -1.0) { return PositiveNaN(); }
        double a = Abs(x);
        double cl;
        double ch = RootOneLessSquare(a, out cl);
        double l;
        double h = a == 0.0 ? QuickTwoSum(1.5707963267948966, 6.123233995736766e-17, out l) : AtanRatio(ch, cl, a, 0.0, out l);
        if (x < 0.0) { h = PairAdd(PI, 1.2246467991473532e-16, -h, -l, out l); }
        return h + l;
    }

    // ---- the cube root and the hyperbolic functions: glibc's ---------------

    /// glibc's cube root, by its polynomial and one rational step: not the
    /// correctly rounded one, and not exact for a cube -- 27's is
    /// 3.0000000000000004 -- which is .NET's answer too.
    public static double Cbrt(double x) {
        if (x == 0.0 || x - x != 0.0) { return x + x; }
        int e;
        double xm = Frexp(Abs(x), out e);
        double u = 0.354895765043919860 + (1.50819193781584896 + (-2.11499494167371287 + (2.44693122563534430
                 + (-1.83469277483613086 + (0.784932344976639262 - 0.145263899385486377 * xm) * xm) * xm) * xm) * xm) * xm;
        double t2 = u * u * u;
        int rest = e % 3;
        double factor = rest == -2 ? 0.6299605249474365 : rest == -1 ? 0.7937005259840997
                      : rest == 0 ? 1.0 : rest == 1 ? 1.2599210498948731648 : 1.5874010519681994748;
        double ym = u * (t2 + 2.0 * xm) / (2.0 * t2 + xm) * factor;
        return ScaleB(x > 0.0 ? ym : -ym, e / 3);
    }

    // |x| = m 2^e with m in [0.5, 1), subnormals included.
    static double Frexp(double x, out int e) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        int biased = (int)((bits >> 52) & 0x7FF);
        if (biased == 0) {
            bits = BitConverter.DoubleToInt64Bits(x * TwoTo(54));
            biased = (int)((bits >> 52) & 0x7FF) - 54;
        }
        e = biased - 1022;
        return BitConverter.Int64BitsToDouble((bits & unchecked((long)0x800FFFFFFFFFFFFF)) | 0x3FE0000000000000);
    }

    public static double Sinh(double x) {
        int jx = HighWord(x);
        int ix = jx & 0x7fffffff;
        if (ix >= 0x7ff00000) { return x + x; }
        double h = jx < 0 ? -0.5 : 0.5;
        if (ix < 0x40360000) {
            if (ix < 0x3e300000) { return x; }
            double t = Expm1(Abs(x));
            if (ix < 0x3ff00000) { return h * (2.0 * t - t * t / (t + 1.0)); }
            return h * (t + t / (t + 1.0));
        }
        if (ix < 0x40862e42) { return h * Exp(Abs(x)); }
        uint lx = LowWord(x);
        if (ix < 0x408633ce || (ix == 0x408633ce && lx <= 0x8fb9f87d)) {
            double w = Exp(0.5 * Abs(x));
            double t = h * w;
            return t * w;
        }
        return x * 1.0e307;
    }

    public static double Cosh(double x) {
        int ix = HighWord(x) & 0x7fffffff;
        if (ix < 0x40360000) {
            if (ix < 0x3fd62e43) {
                if (ix < 0x3c800000) { return 1.0; }
                double t = Expm1(Abs(x));
                double w = 1.0 + t;
                return 1.0 + (t * t) / (w + w);
            }
            double e = Exp(Abs(x));
            return 0.5 * e + 0.5 / e;
        }
        if (ix < 0x40862e42) { return 0.5 * Exp(Abs(x)); }
        uint lx = LowWord(x);
        if (ix < 0x408633ce || (ix == 0x408633ce && lx <= 0x8fb9f87d)) {
            double w = Exp(0.5 * Abs(x));
            double t = 0.5 * w;
            return t * w;
        }
        if (ix >= 0x7ff00000) { return x * x; }
        return double.PositiveInfinity;
    }

    public static double Tanh(double x) {
        int jx = HighWord(x);
        int ix = jx & 0x7fffffff;
        if (ix >= 0x7ff00000) { return jx >= 0 ? 1.0 / x + 1.0 : 1.0 / x - 1.0; }
        double z;
        if (ix < 0x40360000) {
            if ((ix | (int)LowWord(x)) == 0) { return x; }
            if (ix < 0x3c800000) { return x * (1.0 + x); }
            if (ix >= 0x3ff00000) {
                double t = Expm1(2.0 * Abs(x));
                z = 1.0 - 2.0 / (t + 2.0);
            } else {
                double t = Expm1(-2.0 * Abs(x));
                z = -t / (t + 2.0);
            }
        } else {
            z = 1.0;
        }
        return jx >= 0 ? z : -z;
    }

    public static double Asinh(double x) {
        int ix = HighWord(x) & 0x7fffffff;
        if (ix < 0x3e300000) { return x; }
        double w;
        if (ix > 0x41b00000) {
            if (ix >= 0x7ff00000) { return x + x; }
            w = Log(Abs(x)) + 6.93147180559945286227e-01;
        } else {
            double a = Abs(x);
            if (ix > 0x40000000) {
                w = Log(2.0 * a + 1.0 / (Sqrt(a * a + 1.0) + a));
            } else {
                double t = a * a;
                w = Log1p(a + t / (1.0 + Sqrt(1.0 + t)));
            }
        }
        return CopySign(w, x);
    }

    /// Below 1 there is none, and every negative number is below it by its
    /// high word, which is signed; a NaN comes back as itself, either sign.
    public static double Acosh(double x) {
        int hx = HighWord(x);
        if (hx < 0x3ff00000) { return x != x ? x : double.NaN; }
        if (hx >= 0x41b00000) {
            if (hx >= 0x7ff00000) { return x + x; }
            return Log(x) + 6.93147180559945286227e-01;
        }
        if (x == 1.0) { return 0.0; }
        if (hx > 0x40000000) {
            double t = x * x;
            return Log(2.0 * x - 1.0 / (x + Sqrt(t - 1.0)));
        }
        double s = x - 1.0;
        return Log1p(s + Sqrt(2.0 * s + s * s));
    }

    /// Defined on (-1, 1), infinite at its ends with their signs, and NaN
    /// past them.
    public static double Atanh(double x) {
        double a = Abs(x);
        double t;
        if (a < 0.5) {
            if (a < 3.7252902984619140625e-09) { return x; }
            t = a + a;
            t = 0.5 * Log1p(t + t * a / (1.0 - a));
        } else if (a < 1.0) {
            t = 0.5 * Log1p((a + a) / (1.0 - a));
        } else {
            if (a != a) { return x; }
            if (a > 1.0) { return double.NaN; }
            return x / 0.0;
        }
        return CopySign(t, x);
    }

    /// THE IEEE REMAINDER, which is NOT the `%` operator: it takes the NEAREST
    /// multiple rather than the one towards zero, so its result can be
    /// negative where x is positive. Anything reducing an angle wants this one.
    ///
    /// FROM THE `%` REMAINDER, WHICH IS EXACT, as .NET makes it: that one, or
    /// the one a multiple of y further on, whichever is nearer zero, and at a
    /// tie the one whose quotient is even. A zero has x's sign, and a finite x
    /// over an infinite y is x. Rounding x/y, as this did, is out by whole
    /// multiples once the quotient has more digits than a double holds.
    public static double IEEERemainder(double x, double y) {
        if (x != x) { return x; }
        if (y != y) { return y; }

        double regular = x % y;
        if (regular != regular) { return double.NaN; }
        if (regular == 0.0 && double.IsNegative(x)) { return -0.0; }

        double other = regular - Abs(y) * Sign(x);
        if (Abs(other) == Abs(regular)) {
            double quotient = x / y;
            if (Abs(Math.Round(quotient)) > Abs(quotient)) { return other; }
            return regular;
        }
        return Abs(other) < Abs(regular) ? other : regular;
    }

    /// THE MAGNITUDE OF THE FIRST WITH THE SIGN OF THE SECOND, sign bit to sign
    /// bit: a comparison with zero cannot see the sign of -0 or of a NaN.
    public static double CopySign(double x, double y) {
        long size = BitConverter.DoubleToInt64Bits(x) & 0x7FFFFFFFFFFFFFFF;
        long sign = BitConverter.DoubleToInt64Bits(y) & long.MinValue;

        return BitConverter.Int64BitsToDouble(size | sign);
    }

    /// THE ONE FURTHER FROM ZERO, sign kept -- not the larger. MaxMagnitude(-5,
    /// 3) is -5, which is what makes it useful for scaling and surprising for
    /// everything else. A NaN is the answer, and of two magnitudes alike the
    /// positive one is the larger (IEEE 754-2019's maximumMagnitude).
    public static double MaxMagnitude(double x, double y) {
        double a = Abs(x);
        double b = Abs(y);

        if (a > b || a != a) { return x; }
        if (a == b) { return double.IsNegative(x) ? y : x; }
        return y;
    }

    public static double MinMagnitude(double x, double y) {
        double a = Abs(x);
        double b = Abs(y);

        if (a < b || a != a) { return x; }
        if (a == b) { return double.IsNegative(x) ? x : y; }
        return y;
    }

    /// THE NEXT DOUBLE UP, by its bits: the doubles of one sign are in the
    /// order of their bit patterns, so a step of one is a step to the
    /// neighbour -- away from zero for a positive number, towards it for a
    /// negative one. -0 goes up to the smallest positive double, minus
    /// infinity to the most negative finite one, and a NaN and infinity stay.
    public static double BitIncrement(double x) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
            return bits == unchecked((long)0xFFF0000000000000) ? double.MinValue : x;
        }
        if (bits == long.MinValue) { return double.Epsilon; }
        return BitConverter.Int64BitsToDouble(bits < 0 ? bits - 1 : bits + 1);
    }

    public static double BitDecrement(double x) {
        long bits = BitConverter.DoubleToInt64Bits(x);
        if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
            return bits == 0x7FF0000000000000 ? double.MaxValue : x;
        }
        if (bits == 0) { return -double.Epsilon; }
        return BitConverter.Int64BitsToDouble(bits < 0 ? bits + 1 : bits - 1);
    }

    /// x TIMES 2 TO THE n, WITHOUT 2^n ITSELF, which past 1023 or below -1022
    /// is no double though the product may be. The power is taken in steps
    /// that each are one (musl's scalbn, which .NET's is). Going down, the
    /// first step stops 53 places above the subnormals, so that only the last
    /// one rounds; a power past three steps can only overflow or underflow,
    /// and the last step's limit gives the same infinity or zero.
    public static double ScaleB(double x, int n) {
        double y = x;
        if (n > 1023) {
            y = y * TwoTo(1023);
            n = n - 1023;
            if (n > 1023) {
                y = y * TwoTo(1023);
                n = n - 1023;
                if (n > 1023) { n = 1023; }
            }
        } else if (n < -1022) {
            y = y * TwoTo(-969);
            n = n + 969;
            if (n < -1022) {
                y = y * TwoTo(-969);
                n = n + 969;
                if (n < -1022) { n = -1022; }
            }
        }
        return y * TwoTo(n);
    }

    // 2 to the n, for an n a normal double's exponent can hold (-1022 to
    // 1023), made from its bits.
    static double TwoTo(int n) { return BitConverter.Int64BitsToDouble((long)(0x3ff + n) << 52); }

    /// THE EXPONENT, UNBIASED: the n with 2^n <= |x| < 2^(n+1). A subnormal's
    /// is below the smallest normal one, counted down to its leading bit.
    /// Zero has none and is int.MinValue; a NaN and infinity are int.MaxValue.
    public static int ILogB(double x) {
        if (x != x) { return int.MaxValue; }

        long bits = BitConverter.DoubleToInt64Bits(x) & 0x7FFFFFFFFFFFFFFF;
        int exponent = (int)(bits >> 52);

        if (exponent == 0x7FF) { return int.MaxValue; }
        if (exponent != 0) { return exponent - 1023; }
        if (bits == 0) { return int.MinValue; }

        exponent = -1074;
        while (bits > 1) {
            bits = bits >> 1;
            exponent = exponent + 1;
        }
        return exponent;
    }

    public static (double Sin, double Cos) SinCos(double x) { return (Sin(x), Cos(x)); }

    /// .NET's portable answers, which are exact: an estimate may be anything
    /// near, and on a machine with no estimating instruction it is this.
    public static double ReciprocalEstimate(double x) { return 1.0 / x; }
    public static double ReciprocalSqrtEstimate(double x) { return 1.0 / Sqrt(x); }
}

/// MATH IN FLOATS, .NET's MathF: a program written in floats stays in
/// floats, `float s = MathF.Sin(a)` with no cast back. Each member is the
/// double one rounded to a float once. A float's 24 bits are well inside the
/// double's 53, so that is exact for Sqrt and the correctly rounded answer
/// for the rest outside rare ties. Rounding to places, the remainder and the
/// logarithm to a base are .NET's own float arithmetic instead, step by
/// step, because the same steps in doubles round differently: MathF.Round(
/// 2.675f, 2) is 2.68, since 2.675f times 100 is 267.5 as a float.
static class MathF {
    public const float PI = 3.14159265f, E = 2.71828183f, Tau = 6.28318531f;

    public static float Abs(float x) { return Math.Abs(x); }
    public static float Acos(float x) { return (float)Math.Acos(x); }
    public static float Acosh(float x) { return (float)Math.Acosh(x); }
    public static float Asin(float x) { return (float)Math.Asin(x); }
    public static float Asinh(float x) { return (float)Math.Asinh(x); }
    public static float Atan(float x) { return (float)Math.Atan(x); }
    public static float Atan2(float y, float x) { return (float)Math.Atan2(y, x); }
    public static float Atanh(float x) { return (float)Math.Atanh(x); }
    public static float Cbrt(float x) { return (float)Math.Cbrt(x); }
    public static float Ceiling(float x) { return (float)Math.Ceiling(x); }
    public static float Cosh(float x) { return (float)Math.Cosh(x); }
    public static float Floor(float x) { return (float)Math.Floor(x); }
    /// x * y + z ROUNDED ONCE, to a float. The product of two floats is exact
    /// in a double and the sum exact as a pair; the pair is rounded to the
    /// double of odd last bit on its side, from which the rounding to a float
    /// is the one the exact sum has. Rounded to the nearest double first, a
    /// sum just past a float's midpoint landed on it and went to even.
    public static float FusedMultiplyAdd(float x, float y, float z) {
        double error;
        double sum = Math.TwoSum((double)x * (double)y, z, out error);
        if (error != 0.0 && sum - sum == 0.0 && (BitConverter.DoubleToInt64Bits(sum) & 1) == 0) {
            sum = error > 0.0 ? Math.BitIncrement(sum) : Math.BitDecrement(sum);
        }
        return (float)sum;
    }
    public static int ILogB(float x) { return Math.ILogB(x); }
    public static float Log(float x) { return (float)Math.Log(x); }
    public static float Log10(float x) { return (float)Math.Log10(x); }
    public static float Log2(float x) { return (float)Math.Log2(x); }
    public static float Max(float x, float y) { return Math.Max(x, y); }
    public static float MaxMagnitude(float x, float y) { return (float)Math.MaxMagnitude(x, y); }
    public static float Min(float x, float y) { return Math.Min(x, y); }
    public static float MinMagnitude(float x, float y) { return (float)Math.MinMagnitude(x, y); }
    public static float Pow(float x, float y) { return (float)Math.Pow(x, y); }
    public static float ReciprocalEstimate(float x) { return 1.0f / x; }
    public static float ReciprocalSqrtEstimate(float x) { return 1.0f / Sqrt(x); }
    public static float ScaleB(float x, int n) { return (float)Math.ScaleB(x, n); }
    public static int Sign(float x) { return Math.Sign(x); }
    // ---- sine, cosine and e^x: glibc's float functions -----------------------
    //
    // .NET's MathF calls the C library's float functions, and for these three
    // glibc's are not the correctly rounded float of the double answer: they
    // are computed in doubles by their own polynomials, and followed here
    // step for step. The rest are the double functions rounded once.

    public static float Sin(float y) {
        double x = y;
        int top = (BitConverter.SingleToInt32Bits(y) >> 20) & 0x7ff;
        if (top < 0x3f4) {
            // Below pi/4; below 2^-12 the sine is the angle.
            if (top < 0x398) { return y; }
            return SinCosPolynomial(x, x * x, false, 0);
        }
        int n;
        double sign;
        bool negate;
        if (top < 0x42f) {
            x = ReduceFast(x, out n);
            sign = (n & 3) == 1 || (n & 3) == 2 ? -1.0 : 1.0;
            negate = (n & 2) != 0;
        } else if (top < 0x7f8) {
            uint bits = (uint)BitConverter.SingleToInt32Bits(y);
            int s = (int)(bits >> 31);
            x = ReduceLarge(bits, out n);
            sign = ((n + s) & 3) == 1 || ((n + s) & 3) == 2 ? -1.0 : 1.0;
            negate = ((n + s) & 2) != 0;
        } else {
            return y != y ? y : float.NaN;
        }
        return SinCosPolynomial(x * sign, x * x, negate, n);
    }

    public static float Cos(float y) {
        double x = y;
        int top = (BitConverter.SingleToInt32Bits(y) >> 20) & 0x7ff;
        if (top < 0x3f4) {
            if (top < 0x398) { return 1.0f; }
            return SinCosPolynomial(x, x * x, false, 1);
        }
        int n;
        double sign;
        bool negate;
        if (top < 0x42f) {
            x = ReduceFast(x, out n);
            sign = (n & 3) == 1 || (n & 3) == 2 ? -1.0 : 1.0;
            negate = (n & 2) != 0;
        } else if (top < 0x7f8) {
            uint bits = (uint)BitConverter.SingleToInt32Bits(y);
            int s = (int)(bits >> 31);
            x = ReduceLarge(bits, out n);
            sign = ((n + s) & 3) == 1 || ((n + s) & 3) == 2 ? -1.0 : 1.0;
            negate = ((n + s) & 2) != 0;
        } else {
            return y != y ? y : float.NaN;
        }
        return SinCosPolynomial(x * sign, x * x, negate, n ^ 1);
    }

    // The sine's polynomial for an even n, the cosine's for an odd one;
    // `negate` is glibc's second table, every cosine coefficient negated.
    static float SinCosPolynomial(double x, double x2, bool negate, int n) {
        if ((n & 1) == 0) {
            double x3 = x * x2;
            double s1 = 0.008332178146138854 + x2 * -0.00019517298981385725;
            double x7 = x3 * x2;
            double s = x + x3 * -0.16666654943701084;
            return (float)(s + x7 * s1);
        }
        double m = negate ? -1.0 : 1.0;
        double x4 = x2 * x2;
        double c2 = m * -0.001388676379437604 + x2 * (m * 2.4390450703564542e-05);
        double c1 = m + x2 * (m * -0.49999999725108224);
        double x6 = x4 * x2;
        double c = c1 + x4 * (m * 0.041666623324344516);
        return (float)(c + x6 * c2);
    }

    // |x| below 120: the nearest multiple of pi/2 off in one step, its count
    // from x times 2^24 2/pi rounded through the top byte.
    static double ReduceFast(double x, out int n) {
        double r = x * 10680707.430881744;
        n = ((int)r + 0x800000) >> 24;
        return x - n * 1.5707963267948966;
    }

    // 4/pi's bits in 32-bit windows a byte apart: what a large float is
    // multiplied by in integers, its fraction kept in 62 bits.
    const string InvPiOver4 = "\u0000\u00A2\u0000\uA2F9\u00A2\uF983\uA2F9\u836E\uF983\u6E4E\u836E\u4E44\u6E4E\u4415\u4E44\u1529\u4415\u29FC\u1529\uFC27\u29FC\u2757\uFC27\u57D1\u2757\uD1F5\u57D1\uF534\uD1F5\u34DD\uF534\uDDC0\u34DD\uC0DB\uDDC0\uDB62\uC0DB\u6295\uDB62\u9599\u6295\u993C\u9599\u3C43\u993C\u4390\u3C43\u9041";

    static uint InvPiOver4At(int i) {
        return ((uint)Sys.GetChar(InvPiOver4, 2 * i) << 16) | (uint)Sys.GetChar(InvPiOver4, 2 * i + 1);
    }

    static double ReduceLarge(uint xi, out int n) {
        int at = (int)((xi >> 26) & 15);
        int shift = (int)((xi >> 23) & 7);
        xi = ((xi & 0xffffff) | 0x800000) << shift;
        ulong res0 = (ulong)(xi * InvPiOver4At(at));
        ulong res1 = (ulong)xi * InvPiOver4At(at + 4);
        ulong res2 = (ulong)xi * InvPiOver4At(at + 8);
        res0 = (res2 >> 32) | (res0 << 32);
        res0 = res0 + res1;
        ulong whole = (res0 + ((ulong)1 << 61)) >> 62;
        res0 = res0 - (whole << 62);
        n = (int)whole;
        return (double)(long)res0 * 3.4061215800865545e-19;
    }

    // 2^(i/32) less i << 47, as each double's bits.
    const string Exp2Table =
          "\u3FF0\u0000\u0000\u0000\u3FEF\uD9B0\uD315\u8574\u3FEF\uB558\u6CF9\u890F\u3FEF\u9301\uD012\u5B51\u3FEF\u72B8\u3C7D\u517B"
        + "\u3FEF\u5487\u3168\uB9AA\u3FEF\u387A\u6E75\u6238\u3FEF\u1E9D\uF51F\uDEE1\u3FEF\u06FE\u0A31\uB715\u3FEE\uF1A7\u373A\uA9CB"
        + "\u3FEE\uDEA6\u4C12\u3422\u3FEE\uCE08\u6061\u892D\u3FEE\uBFDA\uD536\u2A27\u3FEE\uB42B\u569D\u4F82\u3FEE\uAB07\uDD48\u5429"
        + "\u3FEE\uA47E\uB03A\u5585\u3FEE\uA09E\u667F\u3BCD\u3FEE\u9F75\uE8EC\u5F74\u3FEE\uA114\u73EB\u0187\u3FEE\uA589\u994C\uCE13"
        + "\u3FEE\uACE5\u422A\uA0DB\u3FEE\uB737\uB0CD\uC5E5\u3FEE\uC491\u82A3\uF090\u3FEE\uD503\uB23E\u255D\u3FEE\uE89F\u995A\uD3AD"
        + "\u3FEE\uFF76\uF2FB\u5E47\u3FEF\u199B\uDD85\u529C\u3FEF\u3720\uDCEF\u9069\u3FEF\u5818\uDCFB\uA487\u3FEF\u7C97\u337B\u9B5F"
        + "\u3FEF\uA4AF\uA2A4\u90DA\u3FEF\uD076\u5B6E\u4540";

    public static float Exp(float x) {
        double xd = x;
        int abstop = (BitConverter.SingleToInt32Bits(x) >> 20) & 0x7ff;
        if (abstop >= 0x42b) {
            if (x == float.NegativeInfinity) { return 0.0f; }
            if (abstop >= 0x7f8) { return x + x; }
            if (x > 88.72283172607422f) { return float.PositiveInfinity; }
            if (x < -103.97207641601562f) { return 0.0f; }
        }
        double z = 46.16624130844683 * xd;
        double kd = z + 6755399441055744.0;
        ulong ki = (ulong)BitConverter.DoubleToInt64Bits(kd);
        kd = kd - 6755399441055744.0;
        double r = z - kd;
        int i = (int)(ki & 31);
        ulong t = ((ulong)Sys.GetChar(Exp2Table, 4 * i) << 48) | ((ulong)Sys.GetChar(Exp2Table, 4 * i + 1) << 32)
                | ((ulong)Sys.GetChar(Exp2Table, 4 * i + 2) << 16) | (ulong)Sys.GetChar(Exp2Table, 4 * i + 3);
        t = t + (ki << 47);
        double s = BitConverter.Int64BitsToDouble((long)t);
        double zz = 1.6938359250920212e-06 * r + 0.00023459809789509004;
        double r2 = r * r;
        double y = 0.021660849396613134 * r + 1.0;
        y = zz * r2 + y;
        return (float)(y * s);
    }

    public static (float Sin, float Cos) SinCos(float x) { return (Sin(x), Cos(x)); }
    public static float Sinh(float x) { return (float)Math.Sinh(x); }
    public static float Sqrt(float x) { return (float)Math.Sqrt(x); }
    public static float Tan(float x) { return (float)Math.Tan(x); }
    public static float Tanh(float x) { return (float)Math.Tanh(x); }
    public static float Truncate(float x) { return (float)Math.Truncate(x); }

    public static float CopySign(float x, float y) {
        int size = BitConverter.SingleToInt32Bits(x) & 0x7FFFFFFF;
        int sign = BitConverter.SingleToInt32Bits(y) & int.MinValue;

        return BitConverter.Int32BitsToSingle(size | sign);
    }

    /// The next float up and down, by its bits, as Math's are for doubles.
    public static float BitIncrement(float x) {
        int bits = BitConverter.SingleToInt32Bits(x);
        if ((bits & 0x7F800000) == 0x7F800000) {
            return bits == unchecked((int)0xFF800000) ? float.MinValue : x;
        }
        if (bits == int.MinValue) { return float.Epsilon; }
        return BitConverter.Int32BitsToSingle(bits < 0 ? bits - 1 : bits + 1);
    }

    public static float BitDecrement(float x) {
        int bits = BitConverter.SingleToInt32Bits(x);
        if ((bits & 0x7F800000) == 0x7F800000) {
            return bits == 0x7F800000 ? float.MaxValue : x;
        }
        if (bits == 0) { return -float.Epsilon; }
        return BitConverter.Int32BitsToSingle(bits < 0 ? bits + 1 : bits - 1);
    }

    /// Math's IEEE remainder, from the float `%`.
    public static float IEEERemainder(float x, float y) {
        if (x != x) { return x; }
        if (y != y) { return y; }

        float regular = x % y;
        if (regular != regular) { return float.NaN; }
        if (regular == 0.0f && float.IsNegative(x)) { return -0.0f; }

        float other = regular - Abs(y) * Sign(x);
        if (Abs(other) == Abs(regular)) {
            float quotient = x / y;
            if (Abs(Round(quotient)) > Abs(quotient)) { return other; }
            return regular;
        }
        return Abs(other) < Abs(regular) ? other : regular;
    }

    /// The ratio of two float logarithms, each rounded, as .NET's is.
    public static float Log(float x, float newBase) {
        if (x != x) { return x; }
        if (newBase != newBase) { return newBase; }
        if (newBase == 1.0f) { return float.NaN; }
        if (x != 1.0f && (newBase == 0.0f || float.IsPositiveInfinity(newBase))) { return float.NaN; }
        return Log(x) / Log(newBase);
    }

    public static float Round(float x) { return (float)Math.Round(x); }
    public static float Round(float x, int digits) { return Round(x, digits, MidpointRounding.ToEven); }
    public static float Round(float x, MidpointRounding mode) { return Round(x, 0, mode); }

    /// SIX PLACES AT MOST, AND ONLY BELOW 1e8, Math's rule for a float's
    /// seven digits, and in float arithmetic throughout.
    public static float Round(float x, int digits, MidpointRounding mode) {
        if ((uint)digits > 6) { throw new ArgumentOutOfRangeException("digits", "Rounding digits must be between 0 and 6, inclusive."); }
        if (mode < MidpointRounding.ToEven || mode > MidpointRounding.ToPositiveInfinity) { throw Math.BadRounding(mode); }
        if (Abs(x) < 1e8f) {
            float scale = 1.0f;
            for (int i = 0; i < digits; i++) { scale = scale * 10.0f; }

            float scaled = x * scale;
            float whole = 0.0f;

            if (mode == MidpointRounding.AwayFromZero) {
                whole = Truncate(scaled + CopySign(BitDecrement(0.5f), scaled));
            } else if (mode == MidpointRounding.ToZero) {
                whole = Truncate(scaled);
            } else if (mode == MidpointRounding.ToNegativeInfinity) {
                whole = Floor(scaled);
            } else if (mode == MidpointRounding.ToPositiveInfinity) {
                whole = Ceiling(scaled);
            } else {
                whole = Round(scaled);
            }
            x = whole / scale;
        }
        return x;
    }
}

namespace System.Collections.ObjectModel
{
    /// .NET's read-only wrapper: a view onto a list that cannot change it. It
    /// reads through, so what the list gains afterwards is seen here; as an
    /// IList it answers IsReadOnly and refuses every change with
    /// NotSupportedException.
    public class ReadOnlyCollection<T> : IList<T>, IReadOnlyList<T>, IEnumerable<T>
    {
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

        private readonly IList<T> list;

        public ReadOnlyCollection(IList<T> list)
        {
            ArgumentNullException.ThrowIfNull(list);
            this.list = list;
        }

        static readonly ReadOnlyCollection<T> _empty = new ReadOnlyCollection<T>(new List<T>());
        public static ReadOnlyCollection<T> Empty => _empty;

        public int Count => list.Count;

        public T this[int index] => list[index];

        /// The list it wraps.
        protected IList<T> Items => list;

        public bool Contains(T value) { return list.Contains(value); }

        public int IndexOf(T value) { return list.IndexOf(value); }

        public void CopyTo(T[] array, int index) { list.CopyTo(array, index); }

        public IEnumerator<T> GetEnumerator() { return list.GetEnumerator(); }

        bool ICollection<T>.IsReadOnly => true;

        T IList<T>.this[int index]
        {
            get { return list[index]; }
            set { throw ReadOnly(); }
        }

        void ICollection<T>.Add(T item) { throw ReadOnly(); }
        void ICollection<T>.Clear() { throw ReadOnly(); }
        bool ICollection<T>.Remove(T item) { throw ReadOnly(); }
        void IList<T>.Insert(int index, T item) { throw ReadOnly(); }
        void IList<T>.RemoveAt(int index) { throw ReadOnly(); }

        static NotSupportedException ReadOnly() { return new NotSupportedException("Collection is read-only."); }
    }
}

namespace System.Globalization
{
    /// HOW A CULTURE COMPARES TWO STRINGS, .NET's flags with .NET's values.
    /// The Ignore- flags and StringSort combine; Ordinal and OrdinalIgnoreCase
    /// stand alone.
    [Flags]
    public enum CompareOptions
    {
        None = 0,
        IgnoreCase = 1,
        IgnoreNonSpace = 2,
        IgnoreSymbols = 4,
        IgnoreKanaType = 8,
        IgnoreWidth = 16,
        OrdinalIgnoreCase = 0x10000000,
        StringSort = 0x20000000,
        Ordinal = 0x40000000,
    }

    /// How TimeSpan.ParseExact takes a span its format has no sign for: as
    /// written, or negated. .NET's flags and their values.
    [Flags]
    public enum TimeSpanStyles
    {
        None = 0,
        AssumeNegative = 1,
    }

    /// HOW A DATE IS READ, .NET's flags with .NET's values: where white space
    /// may be, what a date the text leaves out becomes, and what becomes of a
    /// zone the text gives or does not.
    [Flags]
    public enum DateTimeStyles
    {
        None = 0,
        AllowLeadingWhite = 1,
        AllowTrailingWhite = 2,
        AllowInnerWhite = 4,
        AllowWhiteSpaces = 7,
        NoCurrentDateDefault = 8,
        AdjustToUniversal = 16,
        AssumeLocal = 32,
        AssumeUniversal = 64,
        RoundtripKind = 128,
    }

    /// The Unicode general category of a character, numbered as .NET numbers
    /// it -- the runtime's UnicodeCategories table answers in these numbers.
    public enum UnicodeCategory
    {
        UppercaseLetter = 0,
        LowercaseLetter = 1,
        TitlecaseLetter = 2,
        ModifierLetter = 3,
        OtherLetter = 4,
        NonSpacingMark = 5,
        SpacingCombiningMark = 6,
        EnclosingMark = 7,
        DecimalDigitNumber = 8,
        LetterNumber = 9,
        OtherNumber = 10,
        SpaceSeparator = 11,
        LineSeparator = 12,
        ParagraphSeparator = 13,
        Control = 14,
        Format = 15,
        Surrogate = 16,
        PrivateUse = 17,
        ConnectorPunctuation = 18,
        DashPunctuation = 19,
        OpenPunctuation = 20,
        ClosePunctuation = 21,
        InitialQuotePunctuation = 22,
        FinalQuotePunctuation = 23,
        OtherPunctuation = 24,
        MathSymbol = 25,
        CurrencySymbol = 26,
        ModifierSymbol = 27,
        OtherSymbol = 28,
        OtherNotAssigned = 29,
    }
}

namespace System.Buffers
{
    /// What String.Create hands the new string's characters to, with the
    /// state it was given: .NET's delegate, for any span a method fills.
    public delegate void SpanAction<T, in TArg>(Span<T> span, TArg arg);

    /// How a span-to-span transcoding or parse ended.
    public enum OperationStatus
    {
        Done = 0,
        DestinationTooSmall = 1,
        NeedMoreData = 2,
        InvalidData = 3,
    }
}

namespace System.Text
{
    /// A decoder met bytes it could not turn into text, and was told to throw
    /// rather than put in a replacement character.
    public class DecoderFallbackException : ArgumentException
    {
        readonly byte[]? _bytesUnknown;
        readonly int _index;

        public DecoderFallbackException() : base("Value does not fall within the expected range.") { _index = -1; }

        public DecoderFallbackException(string? message) : base(message ?? "Value does not fall within the expected range.") { _index = -1; }

        public DecoderFallbackException(string? message, Exception? innerException)
            : base(message ?? "Value does not fall within the expected range.", innerException!) { _index = -1; }

        public DecoderFallbackException(string? message, byte[]? bytesUnknown, int index)
            : base(message ?? "Value does not fall within the expected range.")
        {
            _bytesUnknown = bytesUnknown;
            _index = index;
        }

        /// .NET's wording: the bytes in hex, in brackets, and where they were.
        public DecoderFallbackException(byte[] bytesUnknown, int index)
            : this(Describe(bytesUnknown, index), bytesUnknown, index)
        {
        }

        public byte[]? BytesUnknown => _bytesUnknown;

        public int Index => _index;

        static string Describe(byte[] bytes, int index)
        {
            string hex = "";
            for (int i = 0; i < bytes.Length; i++)
            {
                hex = hex + "[" + bytes[i].ToString("X2") + "]";
            }
            return "Unable to translate bytes " + hex + " at index " + index + " from specified code page to Unicode.";
        }
    }

    /// An encoder met a character it could not write, and was told to throw.
    public class EncoderFallbackException : ArgumentException
    {
        public EncoderFallbackException() : base("Value does not fall within the expected range.") { }

        public EncoderFallbackException(string? message) : base(message ?? "Value does not fall within the expected range.") { }

        public EncoderFallbackException(string? message, Exception? innerException)
            : base(message ?? "Value does not fall within the expected range.", innerException!) { }
    }
}

namespace System
{
    /// .NET 9's MemoryExtensions.SpanSplitEnumerator: the ranges of a span
    /// between its separators, one at a time, as `foreach (Range r in
    /// span.Split((byte)'/'))` walks them. An empty span gives one empty range,
    /// and each separator ends one, as .NET's does.
    public struct SpanSplitEnumerator<T> where T : IEquatable<T>
    {
        readonly ReadOnlySpan<T> _source;
        readonly ReadOnlySpan<T> _separators;
        readonly T _separator;
        readonly int _mode;          // 0 one element, 1 a whole sequence, 2 any of several
        int _start;
        int _end;
        bool _done;

        internal SpanSplitEnumerator(ReadOnlySpan<T> source, T separator)
        {
            _source = source; _separator = separator; _separators = default; _mode = 0;
            _start = 0; _end = -1; _done = false;
        }

        internal SpanSplitEnumerator(ReadOnlySpan<T> source, ReadOnlySpan<T> separators, bool any)
        {
            _source = source; _separator = default!; _separators = separators; _mode = any ? 2 : 1;
            _start = 0; _end = -1; _done = false;
        }

        public ReadOnlySpan<T> Source => _source;
        public Range Current => new Range(_start, _end);
        public SpanSplitEnumerator<T> GetEnumerator() { return this; }

        public bool MoveNext()
        {
            if (_done) { return false; }
            int from = _end < 0 ? 0 : _end + (_mode == 1 && _separators.Length > 0 ? _separators.Length : 1);
            if (_end < 0) { from = 0; }
            ReadOnlySpan<T> rest = _source.Slice(from);
            int at;
            if (_mode == 0) { at = rest.IndexOf(_separator); }
            else if (_mode == 2) { at = rest.IndexOfAny(_separators); }
            else { at = _separators.Length == 0 ? -1 : IndexOfSequence(rest, _separators); }
            _start = from;
            if (at < 0) { _end = _source.Length; _done = true; }
            else { _end = from + at; }
            return true;
        }

        static int IndexOfSequence(ReadOnlySpan<T> span, ReadOnlySpan<T> value)
        {
            for (int i = 0; i + value.Length <= span.Length; i++)
            {
                int k = 0;
                while (k < value.Length && span[i + k].Equals(value[k])) { k++; }
                if (k == value.Length) { return i; }
            }
            return -1;
        }
    }
}

namespace System.Text
{
    /// .NET 8's Ascii: ASCII text as bytes or chars, compared, cased, trimmed
    /// and converted without a string in between. Anything outside ASCII
    /// answers as .NET's does -- not equal, not valid, InvalidData -- so this is
    /// for protocol text (keywords, header names, configuration keys); names a
    /// person gave, in UTF-8, are compared as bytes with SequenceEqual.
    public static class Ascii
    {
        public static bool IsValid(byte value) { return value <= 0x7F; }
        public static bool IsValid(char value) { return value <= 0x7F; }

        public static bool IsValid(ReadOnlySpan<byte> value)
        {
            for (int i = 0; i < value.Length; i++) { if (value[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool IsValid(ReadOnlySpan<char> value)
        {
            for (int i = 0; i < value.Length; i++) { if (value[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<byte> left, ReadOnlySpan<byte> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<byte> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool Equals(ReadOnlySpan<char> left, ReadOnlySpan<byte> right) { return Equals(right, left); }

        public static bool Equals(ReadOnlySpan<char> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++) { if (left[i] != right[i] || left[i] > 0x7F) { return false; } }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<byte> left, ReadOnlySpan<byte> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<byte> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        public static bool EqualsIgnoreCase(ReadOnlySpan<char> left, ReadOnlySpan<byte> right) { return EqualsIgnoreCase(right, left); }

        public static bool EqualsIgnoreCase(ReadOnlySpan<char> left, ReadOnlySpan<char> right)
        {
            if (left.Length != right.Length) { return false; }
            for (int i = 0; i < left.Length; i++)
            {
                int a = left[i], b = right[i];
                if (a > 0x7F || b > 0x7F || Lower(a) != Lower(b)) { return false; }
            }
            return true;
        }

        static int Lower(int c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
        static int Upper(int c) { return c >= 'a' && c <= 'z' ? c - 32 : c; }

        public static OperationStatus ToLower(ReadOnlySpan<byte> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, false, out bytesWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<byte> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, true, out bytesWritten); }

        static OperationStatus Change(ReadOnlySpan<byte> source, Span<byte> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus ToLower(ReadOnlySpan<char> source, Span<char> destination, out int charsWritten) { return Change(source, destination, false, out charsWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<char> source, Span<char> destination, out int charsWritten) { return Change(source, destination, true, out charsWritten); }

        static OperationStatus Change(ReadOnlySpan<char> source, Span<char> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (char)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        // Between the two: ASCII bytes cased into chars, and ASCII chars into bytes.
        public static OperationStatus ToLower(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten) { return Change(source, destination, false, out charsWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten) { return Change(source, destination, true, out charsWritten); }
        public static OperationStatus ToLower(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, false, out bytesWritten); }
        public static OperationStatus ToUpper(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten) { return Change(source, destination, true, out bytesWritten); }

        static OperationStatus Change(ReadOnlySpan<byte> source, Span<char> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (char)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        static OperationStatus Change(ReadOnlySpan<char> source, Span<byte> destination, bool upper, out int written)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                int c = source[i];
                if (c > 0x7F) { written = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)(upper ? Upper(c) : Lower(c));
            }
            written = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus ToLowerInPlace(Span<byte> value, out int bytesWritten) { return Change(value, value, false, out bytesWritten); }
        public static OperationStatus ToUpperInPlace(Span<byte> value, out int bytesWritten) { return Change(value, value, true, out bytesWritten); }
        public static OperationStatus ToLowerInPlace(Span<char> value, out int charsWritten) { return Change(value, value, false, out charsWritten); }
        public static OperationStatus ToUpperInPlace(Span<char> value, out int charsWritten) { return Change(value, value, true, out charsWritten); }

        // .NET's Ascii whitespace: tab, line feed, vertical tab, form feed,
        // carriage return and space.
        static bool White(int c) { return c == ' ' || (c >= 0x09 && c <= 0x0D); }

        public static Range Trim(ReadOnlySpan<byte> value)
        {
            int start = 0, end = value.Length;
            while (start < end && White(value[start])) { start++; }
            while (end > start && White(value[end - 1])) { end--; }
            return new Range(start, end);
        }

        public static Range TrimStart(ReadOnlySpan<byte> value)
        {
            int start = 0;
            while (start < value.Length && White(value[start])) { start++; }
            return new Range(start, value.Length);
        }

        public static Range TrimEnd(ReadOnlySpan<byte> value)
        {
            int end = value.Length;
            while (end > 0 && White(value[end - 1])) { end--; }
            return new Range(0, end);
        }

        public static Range Trim(ReadOnlySpan<char> value)
        {
            int start = 0, end = value.Length;
            while (start < end && White(value[start])) { start++; }
            while (end > start && White(value[end - 1])) { end--; }
            return new Range(start, end);
        }

        public static Range TrimStart(ReadOnlySpan<char> value)
        {
            int start = 0;
            while (start < value.Length && White(value[start])) { start++; }
            return new Range(start, value.Length);
        }

        public static Range TrimEnd(ReadOnlySpan<char> value)
        {
            int end = value.Length;
            while (end > 0 && White(value[end - 1])) { end--; }
            return new Range(0, end);
        }

        public static OperationStatus ToUtf16(ReadOnlySpan<byte> source, Span<char> destination, out int charsWritten)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                if (source[i] > 0x7F) { charsWritten = i; return OperationStatus.InvalidData; }
                destination[i] = (char)source[i];
            }
            charsWritten = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }

        public static OperationStatus FromUtf16(ReadOnlySpan<char> source, Span<byte> destination, out int bytesWritten)
        {
            int n = source.Length < destination.Length ? source.Length : destination.Length;
            for (int i = 0; i < n; i++)
            {
                if (source[i] > 0x7F) { bytesWritten = i; return OperationStatus.InvalidData; }
                destination[i] = (byte)source[i];
            }
            bytesWritten = n;
            return n < source.Length ? OperationStatus.DestinationTooSmall : OperationStatus.Done;
        }
    }
}

namespace System.Buffers
{
    /// .NET's StandardFormat: a format letter and a precision, as Utf8Formatter
    /// and Utf8Parser take them. `default` is the type's general format.
    public readonly struct StandardFormat : IEquatable<StandardFormat>
    {
        public const byte NoPrecision = 255;
        public const byte MaxPrecision = 99;

        readonly byte _symbol;
        readonly byte _precision;

        public StandardFormat(char symbol, byte precision = NoPrecision)
        {
            if (precision != NoPrecision && precision > MaxPrecision) throw new ArgumentOutOfRangeException("precision");
            if (symbol > 0xFF) throw new ArgumentOutOfRangeException("symbol");
            _symbol = (byte)symbol;
            _precision = precision;
        }

        public char Symbol => (char)_symbol;
        public byte Precision => _precision;
        public bool HasPrecision => _precision != NoPrecision;
        public bool IsDefault => _symbol == 0 && _precision == 0;

        public bool Equals(StandardFormat other) { return _symbol == other._symbol && _precision == other._precision; }
        public override bool Equals(object? obj) { return obj is StandardFormat f && Equals(f); }
        public override int GetHashCode() { return _symbol | (_precision << 8); }
        public override string ToString() { return _symbol == 0 ? "" : _precision == NoPrecision || _precision == 0 && IsDefault ? Symbol.ToString() : Symbol.ToString() + (int)_precision; }
    }
}

namespace System.Buffers.Text
{
    /// .NET's Utf8Formatter: a value as .NET's invariant text of it, in UTF-8,
    /// straight into a span -- false, and nothing written, when it does not
    /// fit. An integer takes G and R (neither with a precision, which .NET
    /// refuses as NotSupportedException), D, N and X; a float and a double G,
    /// E, F, N, P, C and R; a Guid D (its default), N, B and P; a TimeSpan c
    /// (its default), t, T, G and g; a date G (its default), O, R and l, R in
    /// lower case; a boolean G and l. Anything else is .NET's FormatException.
    public static class Utf8Formatter
    {
        public static bool TryFormat(bool value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            char f = format.Symbol;
            if (!(format.IsDefault || f == 'G' || f == 'l')) { throw BadFormat(); }
            return Text(value ? (f == 'l' ? "true" : "True") : (f == 'l' ? "false" : "False"), destination, out bytesWritten);
        }

        public static bool TryFormat(int value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(long value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(short value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(sbyte value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(uint value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(ulong value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(ushort value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(byte value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(IntegerFormat(format)), destination, out bytesWritten); }
        public static bool TryFormat(double value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(FloatFormat(format), CultureInfo.InvariantCulture), destination, out bytesWritten); }
        public static bool TryFormat(float value, Span<byte> destination, out int bytesWritten, StandardFormat format = default) { return Text(value.ToString(FloatFormat(format), CultureInfo.InvariantCulture), destination, out bytesWritten); }

        public static bool TryFormat(Guid value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            char f = format.Symbol;
            if (!(format.IsDefault || f == 'D' || f == 'N' || f == 'B' || f == 'P')) { throw BadFormat(); }
            return Text(value.ToString(format.IsDefault ? "D" : f.ToString()), destination, out bytesWritten);
        }

        public static bool TryFormat(TimeSpan value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            char f = format.Symbol;
            string text;
            if (format.IsDefault || f == 'c' || f == 't' || f == 'T') { text = Span(value, 'c'); }
            else if (f == 'G' || f == 'g') { text = Span(value, f); }
            else { throw BadFormat(); }
            return Text(text, destination, out bytesWritten);
        }

        // A TimeSpan in .NET's three standard forms, invariant: c is
        // [-][d.]hh:mm:ss[.fffffff], g [-][d:]h:mm:ss[.FFFFFFF] and G
        // [-]d:hh:mm:ss.fffffff.
        static string Span(TimeSpan value, char form)
        {
            long ticks = value.Ticks;
            StringBuilder made = new StringBuilder();
            ulong rest = ticks < 0 ? (ulong)(-(ticks + 1)) + 1 : (ulong)ticks;
            if (ticks < 0) { made.Append('-'); }
            ulong fraction = rest % 10000000;
            ulong seconds = rest / 10000000;
            ulong days = seconds / 86400;
            ulong hours = seconds / 3600 % 24;
            ulong minutes = seconds / 60 % 60;
            ulong secs = seconds % 60;
            if (form == 'c') {
                if (days != 0) { made.Append(days).Append('.'); }
                made.Append(hours.ToString("00")).Append(':').Append(minutes.ToString("00")).Append(':').Append(secs.ToString("00"));
                if (fraction != 0) { made.Append('.').Append(fraction.ToString("0000000")); }
            } else if (form == 'g') {
                if (days != 0) { made.Append(days).Append(':'); }
                made.Append(hours).Append(':').Append(minutes.ToString("00")).Append(':').Append(secs.ToString("00"));
                if (fraction != 0) { made.Append('.').Append(fraction.ToString("0000000").TrimEnd('0')); }
            } else {
                made.Append(days).Append(':').Append(hours.ToString("00")).Append(':').Append(minutes.ToString("00")).Append(':').Append(secs.ToString("00"));
                made.Append('.').Append(fraction.ToString("0000000"));
            }
            return made.ToString();
        }

        public static bool TryFormat(DateTime value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            char f = format.Symbol;
            string text;
            if (format.IsDefault || f == 'G') { text = value.ToString("MM/dd/yyyy HH:mm:ss"); }
            else if (f == 'O') { text = value.ToString("O"); }
            else if (f == 'R') { text = value.ToString("R"); }
            else if (f == 'l') { text = value.ToString("R").ToLowerInvariant(); }
            else { throw BadFormat(); }
            return Text(text, destination, out bytesWritten);
        }

        /// A DateTimeOffset's default is G with its offset after it; asked
        /// for G by name, the offset is left off, as .NET leaves it.
        public static bool TryFormat(DateTimeOffset value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
        {
            char f = format.Symbol;
            string text;
            if (format.IsDefault) { text = value.ToString(); }
            else if (f == 'G') { text = value.DateTime.ToString("MM/dd/yyyy HH:mm:ss"); }
            else if (f == 'O') { text = value.ToString("O"); }
            else if (f == 'R') { text = value.UtcDateTime.ToString("R"); }
            else if (f == 'l') { text = value.UtcDateTime.ToString("R").ToLowerInvariant(); }
            else { throw BadFormat(); }
            return Text(text, destination, out bytesWritten);
        }

        // A StandardFormat as the format string the value's own ToString takes:
        // the letter and its precision, or nothing for the default.
        static string FormatText(StandardFormat format)
        {
            if (format.IsDefault) { return ""; }
            return format.HasPrecision ? format.Symbol.ToString() + (int)format.Precision : format.Symbol.ToString();
        }

        static string IntegerFormat(StandardFormat format)
        {
            if (format.IsDefault) { return ""; }
            char f = format.Symbol;
            if (f == 'G' || f == 'g' || f == 'R' || f == 'r')
            {
                if (format.HasPrecision) { throw new NotSupportedException("The 'G' format combined with a precision is not supported."); }
                return "";
            }
            if (f == 'D' || f == 'd' || f == 'N' || f == 'n' || f == 'X' || f == 'x') { return FormatText(format); }
            throw BadFormat();
        }

        static string FloatFormat(StandardFormat format)
        {
            if (format.IsDefault) { return ""; }
            char f = (char)(format.Symbol | (char)0x20);
            if (f == 'g' || f == 'e' || f == 'f' || f == 'n' || f == 'p' || f == 'c' || f == 'r') { return FormatText(format); }
            throw BadFormat();
        }

        static FormatException BadFormat() { return new FormatException("Format specifier was invalid."); }

        // The text as its UTF-8 bytes: the currency sign of the invariant
        // culture, U+00A4, is two of them.
        static bool Text(string text, Span<byte> destination, out int written)
        {
            byte[] bytes = Encoding.UTF8.GetBytes(text);
            if (bytes.Length > destination.Length) { written = 0; return false; }
            for (int i = 0; i < bytes.Length; i++) { destination[i] = bytes[i]; }
            written = bytes.Length;
            return true;
        }
    }

    /// .NET's Utf8Parser: a number or a boolean read off the front of UTF-8
    /// text, saying how many bytes it took. No whitespace; a leading '-' or
    /// '+' for the signed types; 'X' reads hexadecimal digits.
    public static class Utf8Parser
    {
        public static bool TryParse(ReadOnlySpan<byte> source, out bool value, out int bytesConsumed, char standardFormat = '\0')
        {
            if (source.Length >= 4 && Ascii.EqualsIgnoreCase(source.Slice(0, 4), "true"u8)) { value = true; bytesConsumed = 4; return true; }
            if (source.Length >= 5 && Ascii.EqualsIgnoreCase(source.Slice(0, 5), "false"u8)) { value = false; bytesConsumed = 5; return true; }
            value = false; bytesConsumed = 0; return false;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out int value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, int.MinValue, int.MaxValue, 32, out long wide, out bytesConsumed);
            value = ok ? (int)wide : 0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out long value, out int bytesConsumed, char standardFormat = '\0')
        {
            return Signed(source, standardFormat, long.MinValue, long.MaxValue, 64, out value, out bytesConsumed);
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out short value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, short.MinValue, short.MaxValue, 16, out long wide, out bytesConsumed);
            value = ok ? (short)wide : (short)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out sbyte value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Signed(source, standardFormat, sbyte.MinValue, sbyte.MaxValue, 8, out long wide, out bytesConsumed);
            value = ok ? (sbyte)wide : (sbyte)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out uint value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, uint.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (uint)wide : 0U; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out ulong value, out int bytesConsumed, char standardFormat = '\0')
        {
            return Unsigned(source, standardFormat, ulong.MaxValue, out value, out bytesConsumed);
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out ushort value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, ushort.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (ushort)wide : (ushort)0; return ok;
        }

        public static bool TryParse(ReadOnlySpan<byte> source, out byte value, out int bytesConsumed, char standardFormat = '\0')
        {
            bool ok = Unsigned(source, standardFormat, byte.MaxValue, out ulong wide, out bytesConsumed);
            value = ok ? (byte)wide : (byte)0; return ok;
        }

        static int Digit(int c, bool hex)
        {
            if (c >= '0' && c <= '9') return c - '0';
            if (hex && c >= 'a' && c <= 'f') return c - 'a' + 10;
            if (hex && c >= 'A' && c <= 'F') return c - 'A' + 10;
            return -1;
        }

        static bool Unsigned(ReadOnlySpan<byte> source, char format, ulong max, out ulong value, out int consumed)
        {
            bool hex = format == 'X' || format == 'x';
            ulong radix = hex ? 16UL : 10UL;
            int i = 0;
            if (!hex && i < source.Length && source[i] == '+') i++;
            int first = i;
            ulong v = 0;
            while (i < source.Length)
            {
                int d = Digit(source[i], hex);
                if (d < 0) break;
                // Past the type's range: the whole parse fails, as .NET's does.
                if (v > (max - (ulong)d) / radix) { value = 0; consumed = 0; return false; }
                v = v * radix + (ulong)d;
                i++;
            }
            if (i == first) { value = 0; consumed = 0; return false; }
            value = v; consumed = i;
            return true;
        }

        static bool Signed(ReadOnlySpan<byte> source, char format, long min, long max, int bits, out long value, out int consumed)
        {
            bool hex = format == 'X' || format == 'x';
            if (hex)
            {
                ulong mask = bits == 64 ? ulong.MaxValue : (1UL << bits) - 1;
                if (!Unsigned(source, format, mask, out ulong raw, out consumed)) { value = 0; return false; }
                // The digits are the value's two's complement at its width.
                long signed = bits == 64 ? (long)raw : ((raw >> (bits - 1)) & 1) != 0 ? (long)raw - (1L << bits) : (long)raw;
                value = signed;
                return true;
            }
            bool negative = source.Length > 0 && source[0] == '-';
            int skip = source.Length > 0 && (source[0] == '-' || source[0] == '+') ? 1 : 0;
            ulong limit = negative ? (ulong)max + 1UL : (ulong)max;
            if (!Unsigned(source.Slice(skip), format, limit, out ulong magnitude, out int used)) { value = 0; consumed = 0; return false; }
            value = negative ? (long)(0UL - magnitude) : (long)magnitude;
            consumed = used + skip;
            return true;
        }
    }
}

namespace System.Text.Unicode
{
    /// .NET's Utf8: UTF-16 and UTF-8 converted into a caller's buffer, no
    /// string made -- the one conversion at the boundary between text held as
    /// .NET holds it and a system call that takes bytes. Invalid input is each
    /// maximal ill-formed subsequence become one U+FFFD when replacing, and
    /// InvalidData where it begins when not; input cut off at its end is
    /// NeedMoreData unless this is the final block; a destination without
    /// room stops at a whole character, DestinationTooSmall.
    public static class Utf8
    {
        public static OperationStatus FromUtf16(ReadOnlySpan<char> source, Span<byte> destination, out int charsRead, out int bytesWritten, bool replaceInvalidSequences = true, bool isFinalBlock = true)
        {
            int i = 0, o = 0;
            OperationStatus status = OperationStatus.Done;
            while (i < source.Length)
            {
                int c = source[i];
                int take = 1;
                int cp = c;
                if (c >= 0xD800 && c <= 0xDBFF)
                {
                    if (i + 1 >= source.Length)
                    {
                        if (!isFinalBlock) { status = OperationStatus.NeedMoreData; break; }
                        cp = -1;
                    }
                    else if (source[i + 1] >= 0xDC00 && source[i + 1] <= 0xDFFF)
                    {
                        cp = 0x10000 + ((c - 0xD800) << 10) + (source[i + 1] - 0xDC00);
                        take = 2;
                    }
                    else cp = -1;
                }
                else if (c >= 0xDC00 && c <= 0xDFFF) cp = -1;
                if (cp < 0)
                {
                    if (!replaceInvalidSequences) { status = OperationStatus.InvalidData; break; }
                    cp = 0xFFFD;
                }
                int need = cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
                if (o + need > destination.Length) { status = OperationStatus.DestinationTooSmall; break; }
                if (need == 1) destination[o] = (byte)cp;
                else if (need == 2) { destination[o] = (byte)(0xC0 | (cp >> 6)); destination[o + 1] = (byte)(0x80 | (cp & 0x3F)); }
                else if (need == 3) { destination[o] = (byte)(0xE0 | (cp >> 12)); destination[o + 1] = (byte)(0x80 | ((cp >> 6) & 0x3F)); destination[o + 2] = (byte)(0x80 | (cp & 0x3F)); }
                else { destination[o] = (byte)(0xF0 | (cp >> 18)); destination[o + 1] = (byte)(0x80 | ((cp >> 12) & 0x3F)); destination[o + 2] = (byte)(0x80 | ((cp >> 6) & 0x3F)); destination[o + 3] = (byte)(0x80 | (cp & 0x3F)); }
                o += need;
                i += take;
            }
            charsRead = i;
            bytesWritten = o;
            return status;
        }

        public static OperationStatus ToUtf16(ReadOnlySpan<byte> source, Span<char> destination, out int bytesRead, out int charsWritten, bool replaceInvalidSequences = true, bool isFinalBlock = true)
        {
            int i = 0, o = 0;
            OperationStatus status = OperationStatus.Done;
            while (i < source.Length)
            {
                int b0 = source[i];
                int cp;
                int take;
                if (b0 < 0x80) { cp = b0; take = 1; }
                else
                {
                    // How many continuation bytes, and the range the first may take.
                    int more, low = 0x80, high = 0xBF;
                    if (b0 >= 0xC2 && b0 <= 0xDF) { more = 1; cp = b0 & 0x1F; }
                    else if (b0 >= 0xE0 && b0 <= 0xEF) { more = 2; cp = b0 & 0x0F; if (b0 == 0xE0) low = 0xA0; if (b0 == 0xED) high = 0x9F; }
                    else if (b0 >= 0xF0 && b0 <= 0xF4) { more = 3; cp = b0 & 0x07; if (b0 == 0xF0) low = 0x90; if (b0 == 0xF4) high = 0x8F; }
                    else { more = -1; cp = 0; }
                    take = 1;
                    bool bad = more < 0;
                    bool cut = false;
                    for (int k = 0; k < more && !bad; k++)
                    {
                        if (i + take >= source.Length) { cut = true; break; }
                        int b = source[i + take];
                        if (b < low || b > high) { bad = true; break; }
                        cp = (cp << 6) | (b & 0x3F);
                        take++;
                        low = 0x80; high = 0xBF;
                    }
                    if (cut)
                    {
                        if (!isFinalBlock) { status = OperationStatus.NeedMoreData; break; }
                        bad = true;
                    }
                    if (bad)
                    {
                        if (!replaceInvalidSequences) { status = OperationStatus.InvalidData; break; }
                        cp = 0xFFFD;
                    }
                }
                int need = cp >= 0x10000 ? 2 : 1;
                if (o + need > destination.Length) { status = OperationStatus.DestinationTooSmall; break; }
                if (need == 1) destination[o] = (char)cp;
                else { destination[o] = (char)(0xD800 + ((cp - 0x10000) >> 10)); destination[o + 1] = (char)(0xDC00 + ((cp - 0x10000) & 0x3FF)); }
                o += need;
                i += take;
            }
            bytesRead = i;
            charsWritten = o;
            return status;
        }
    }
}

namespace System.Runtime.CompilerServices
{
    /// What every ValueTuple answers, boxed or not: how many items it has,
    /// and each one as an object, from 0.
    public interface ITuple
    {
        int Length { get; }
        object? this[int index] { get; }
    }

    /// A VALUE KEPT FOR AN OBJECT, by the object's identity, as .NET's
    /// ConditionalWeakTable: Add, AddOrUpdate, TryAdd, TryGetValue, GetValue
    /// with a maker, Remove, Clear, and a walk over what it holds.
    ///
    /// HELD STRONGLY. .NET's lets an entry go when nothing else holds its
    /// key; this runtime's collector has no weak references, so an entry
    /// here lives until it is removed or the table itself is dropped. A
    /// table that only ever grows over keys that come and go keeps them
    /// all: such a cache belongs on the key itself, or a table that is
    /// replaced when its keys are.
    ///
    /// One departure, for what this compiler cannot yet express: GetValue
    /// takes a Func<TKey, TValue> where .NET takes its nested
    /// CreateValueCallback delegate -- a lambda or a method group binds to
    /// either alike.
    public sealed class ConditionalWeakTable<TKey, TValue> : IEnumerable<KeyValuePair<TKey, TValue>> where TKey : class where TValue : class?
    {
        private readonly Dictionary<object, TValue> _held = new Dictionary<object, TValue>(ReferenceEqualityComparer.Instance);

        public ConditionalWeakTable() { }

        /// A key held already is refused (ArgumentException), as .NET's.
        public void Add(TKey key, TValue value)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (_held.ContainsKey(key)) { throw new ArgumentException("An entry with the same key already exists."); }
            _held[key] = value;
        }

        public bool TryAdd(TKey key, TValue value)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (_held.ContainsKey(key)) { return false; }
            _held[key] = value;
            return true;
        }

        public void AddOrUpdate(TKey key, TValue value)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            _held[key] = value;
        }

        public bool TryGetValue(TKey key, out TValue value)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (_held.TryGetValue(key, out TValue? found)) { value = found!; return true; }
            value = default!;
            return false;
        }

        /// What the table holds for `key`, or what `createValueCallback`
        /// makes for it, kept.
        public TValue GetValue(TKey key, Func<TKey, TValue> createValueCallback)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (createValueCallback == null) { throw new ArgumentNullException("createValueCallback"); }
            if (_held.TryGetValue(key, out TValue? known)) { return known!; }
            TValue made = createValueCallback(key);
            _held[key] = made;
            return made;
        }

        /// The value held for the key, or a new TValue by its public
        /// parameterless constructor, held from now on (Activator).
        public TValue GetOrCreateValue(TKey key)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            if (_held.TryGetValue(key, out TValue? known)) { return known!; }
            TValue made = Activator.CreateInstance<TValue>();
            _held[key] = made;
            return made;
        }

        public bool Remove(TKey key)
        {
            if (key == null) { throw new ArgumentNullException("key"); }
            return _held.Remove(key);
        }

        public void Clear() { _held.Clear(); }

        public IEnumerator<KeyValuePair<TKey, TValue>> GetEnumerator()
        {
            foreach (KeyValuePair<object, TValue> entry in _held)
            {
                yield return new KeyValuePair<TKey, TValue>((TKey)entry.Key, entry.Value);
            }
        }

        IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }
    }
}

namespace System.Runtime
{
    /// How the collector is asked to treat the large object heap at its next
    /// full collection, as .NET's.
    public enum GCLargeObjectHeapCompactionMode
    {
        Default = 1,
        CompactOnce = 2,
    }

    /// How intrusive collections may be, as .NET's.
    public enum GCLatencyMode
    {
        Batch = 0,
        Interactive = 1,
        LowLatency = 2,
        SustainedLowLatency = 3,
        NoGCRegion = 4,
    }

    /// THE COLLECTOR'S SETTINGS, as .NET's GCSettings answers them. This
    /// collector has no large object heap and no server mode, and does not
    /// change how it collects for a latency mode: each setting is kept and
    /// answered back, and changes nothing. The large object heap's mode goes
    /// back to Default at the next full collection in .NET; here it stays
    /// what it was set to, there being no compaction for it to have asked.
    public static class GCSettings
    {
        private static GCLargeObjectHeapCompactionMode _largeObjects = GCLargeObjectHeapCompactionMode.Default;
        private static GCLatencyMode _latency = GCLatencyMode.Interactive;

        public static bool IsServerGC { get { return false; } }

        public static GCLargeObjectHeapCompactionMode LargeObjectHeapCompactionMode
        {
            get { return _largeObjects; }
            set
            {
                if (value != GCLargeObjectHeapCompactionMode.Default && value != GCLargeObjectHeapCompactionMode.CompactOnce)
                {
                    throw new ArgumentOutOfRangeException("value");
                }
                _largeObjects = value;
            }
        }

        /// NoGCRegion is entered by GC.TryStartNoGCRegion, never set; .NET
        /// refuses it here, and so does this.
        public static GCLatencyMode LatencyMode
        {
            get { return _latency; }
            set
            {
                if (value < GCLatencyMode.Batch || value > GCLatencyMode.SustainedLowLatency)
                {
                    throw new ArgumentOutOfRangeException("value");
                }
                _latency = value;
            }
        }
    }
}

namespace Microsoft.CSharp.RuntimeBinder
{
    /// What a dynamic operation that cannot be bound throws (System.DynamicRuntime,
    /// in Microsoft.CSharp; here because the members the compiler writes for
    /// a dynamic receiver convert their arguments with DynamicValues).
    public class RuntimeBinderException : Exception
    {
        public RuntimeBinderException() : base("An error occurred while binding a dynamic operation.") { }
        public RuntimeBinderException(string message) : base(message) { }
        public RuntimeBinderException(string message, Exception inner) : base(message, inner) { }
    }

    public class RuntimeBinderInternalCompilerException : Exception
    {
        public RuntimeBinderInternalCompilerException() : base("An unexpected exception occurred while binding a dynamic operation.") { }
        public RuntimeBinderInternalCompilerException(string message) : base(message) { }
    }
}

namespace System.Dynamic
{
    // ---- what a late-bound call carries, and what answers it -------------------------------
    //
    // Every member a dynamic receiver can reach is answered by code the
    // compiler wrote for it: a program's providers (ILateMembers, one for each
    // unit that writes `dynamic`, over every class it can reach) and a
    // struct's own members (IDynamicMembers, so a write reaches the box).
    // Each answers one of these:

    /// What a member the compiler wrote for a dynamic receiver answers.
    public static class LateStatus
    {
        public const int Done = 0;             // done; `result` holds the value
        public const int NoMember = 1;         // nothing of that name: ask the next
        public const int NoFit = 2;            // the member, but nothing that takes these arguments
        public const int MethodGroup = 3;      // a method, where a value was asked for
        public const int ReadOnly = 4;         // a member that cannot be written
        public const int Static = 5;           // a static member, reached through an instance
        public const int Ambiguous = 6;        // more than one, none better (C# 12.6.4.3)
        public const int NotEvent = 7;         // not an event: += and -= are the operator's
    }

    /// <summary>
    /// The arguments of a late-bound call as the compiler hands them over:
    /// each argument, its name where it was given one (`f(x: 1)`), how it was
    /// passed (0 by value, 1 ref, 2 out, 3 in) and the type arguments written
    /// (`d.M&lt;int&gt;(..)`). A candidate's own parameters are matched against
    /// them by Map, as C# matches a call's arguments to a member's
    /// parameters (12.6.2): positional first, then by name, an optional
    /// parameter left out marked with DynamicValues.Missing; and a ref or out
    /// argument's new value written back by Back.
    /// </summary>
    public sealed class LateCall
    {
        public readonly object?[] Args;
        public readonly string?[]? Names;
        public readonly int[]? Kinds;
        public readonly Type[]? TypeArgs;
        /// Each argument's own type where the compiler knew it (not dynamic),
        /// for C#'s "exactly matches" (12.6.4.5): a static argument is
        /// compared by the type it was written as, not by what it holds.
        public readonly Type?[]? Declared;
        /// The method group asked, once a member says NoFit or Ambiguous: what the error names.
        public LateGroup? Group;
        /// What the member is called, for the error.
        public string Member = "";

        public LateCall(object?[] args, string?[]? names, int[]? kinds, Type[]? typeArgs, Type?[]? declared)
        {
            Args = args; Names = names; Kinds = kinds; TypeArgs = typeArgs; Declared = declared;
        }

        public LateCall(object?[] args, string?[]? names, int[]? kinds, Type[]? typeArgs) : this(args, names, kinds, typeArgs, null) { }

        public LateCall(object?[] args) : this(args, null, null, null, null) { }

        /// Whether argument `i` is exactly of a type: its written type when it had one, else what it holds.
        public bool ExactlyOf(int i, Type type)
        {
            Type? written = Declared == null ? null : Declared[i];
            if (written != null) return written == type;
            return DynamicValues.Exact(Args[i], type);
        }

        public int Count { get { return Args.Length; } }

        int KindOf(int argument) { return Kinds == null ? 0 : Kinds[argument]; }
        string? NameOf(int argument) { return Names == null ? null : Names[argument]; }

        /// <summary>
        /// Each parameter's argument (its index, or -1 for an optional one
        /// left out), or null when the arguments do not match the parameters:
        /// too many, a name no parameter has or one given twice, a positional
        /// argument after a named one out of its place, a required parameter
        /// with nothing, or an argument passed otherwise than its parameter is
        /// taken (`ref` for ref, `out` for out, by value or `in` for in).
        /// `parameterKinds` as Kinds; `required` how many lead without a default.
        /// </summary>
        public int[]? Map(string[] parameters, int[] parameterKinds, int required)
        {
            int n = parameters.Length;
            if (Args.Length > n) return null;
            int[] map = new int[n];
            for (int p = 0; p < n; p++) map[p] = -1;
            for (int i = 0; i < Args.Length; i++)
            {
                string? named = NameOf(i);
                int p = i;
                if (named != null)
                {
                    p = -1;
                    for (int k = 0; k < n; k++) if (parameters[k] == named) { p = k; break; }
                    if (p < 0) return null;
                }
                else
                {
                    // A positional argument after a named one stands in the
                    // named one's own place, or nowhere (C# 7.2's rule).
                    if (map[p] != -1) return null;
                }
                if (map[p] != -1) return null;
                map[p] = i;
            }
            for (int p = 0; p < n; p++)
            {
                if (map[p] == -1)
                {
                    if (p < required) return null;
                    continue;
                }
                int passed = KindOf(map[p]), taken = parameterKinds[p];
                if (taken == 3 ? passed == 1 || passed == 2 : passed != taken) return null;
            }
            return map;
        }

        /// <summary>
        /// The expanded form of a `params` call (C# 12.6.4.2): the fixed
        /// parameters as Map has them, every argument past them an element of
        /// the array -- each by value and none named. Null when it does not
        /// match.
        /// </summary>
        public int[]? MapExpanded(string[] fixedParameters, int[] parameterKinds, int required)
        {
            int n = fixedParameters.Length;
            if (Args.Length < n) return null;
            for (int i = n; i < Args.Length; i++) if (NameOf(i) != null || KindOf(i) != 0) return null;
            int[] map = new int[n + 1];
            for (int p = 0; p < n; p++)
            {
                if (NameOf(p) != null && NameOf(p) != fixedParameters[p]) return null;
                int passed = KindOf(p), taken = parameterKinds[p];
                if (taken == 3 ? passed == 1 || passed == 2 : passed != taken) return null;
                map[p] = p;
            }
            map[n] = -2;                                                       // the rest
            return map;
        }

        /// A parameter's argument, or DynamicValues.Missing for one left out.
        public object? At(int[] map, int parameter) { return map[parameter] < 0 ? DynamicValues.Missing : Args[map[parameter]]; }

        /// The arguments an expanded `params` array takes: every one from `from` on.
        public object?[] Rest(int from)
        {
            object?[] rest = new object?[Args.Length - from];
            for (int i = 0; i < rest.Length; i++) rest[i] = Args[from + i];
            return rest;
        }

        /// A ref or out parameter's value back where its argument was.
        public void Back(int[] map, int parameter, object? value)
        {
            if (map[parameter] >= 0) Args[map[parameter]] = value;
        }

        /// The element of the arguments, for a ref or out argument's new value (the compiler's write-back).
        public object? Value(int argument) { return Args[argument]; }

        /// Whether the type arguments are these.
        public bool TypeArgumentsAre(Type[] types)
        {
            if (TypeArgs == null || TypeArgs.Length != types.Length) return false;
            for (int i = 0; i < types.Length; i++) if (TypeArgs[i] != types[i]) return false;
            return true;
        }
    }

    /// <summary>
    /// A method group's overloads as the compiler saw them, for the choice
    /// among the applicable ones (DynamicValues.Choose): the parameter types
    /// they have, as indices into Types; which of them is a better conversion
    /// target than which (C# 12.6.4.7, worked out where the compiler had the
    /// types: Better[a * Types.Length + b] is 1 when Types[a] is better than
    /// Types[b]); each candidate's expanded-form element type (-1: not
    /// expanded), whether it is a generic method's instantiation, and how C#
    /// writes it, for the errors.
    /// </summary>
    public sealed class LateGroup
    {
        public readonly Type[] Types;
        public readonly int[][] Parameters;
        public readonly int[] Element;
        public readonly bool[] Generic;
        public readonly byte[] Better;
        public readonly string[] Display;

        public LateGroup(Type[] types, int[][] parameters, int[] element, bool[] generic, byte[] better, string[] display)
        {
            Types = types; Parameters = parameters; Element = element; Generic = generic; Better = better; Display = display;
        }

        public bool BetterTarget(int a, int b) { return a != b && Better[a * Types.Length + b] != 0; }
    }

    /// <summary>
    /// A program's answers for every class a dynamic receiver of it can reach
    /// (compiler/src/metadata/DynamicProvider.cs): one for each unit that
    /// writes `dynamic`, registered when its image is loaded
    /// (DynamicRuntime.Register).
    /// </summary>
    public interface ILateMembers
    {
        int Get(object target, string name, out object? result);
        int Set(object target, string name, object? value);
        int Call(object target, string name, LateCall call, out object? result);
        int GetIndex(object target, LateCall keys, out object? result);
        int SetIndex(object target, LateCall keys, object? value);
        int Operator(int op, object? left, object? right, out object? result);
        int Convert(object value, Type target, bool explicitly, out object? result);
        int Event(object target, string name, bool add, object? handler);
        /// A static member of the target's class of that name, as C# writes it (`Counter.Make(int)`), or null: CS0176's text.
        string? Static(object target, string name);
    }

    /// <summary>
    /// The same answers written into a struct itself, so that a write
    /// through a dynamic value reaches the box it holds rather than a copy
    /// (DynamicDeclarations).
    /// </summary>
    public interface IDynamicMembers
    {
        int __DynGet(string name, out object? result);
        int __DynSet(string name, object? value);
        int __DynCall(string name, LateCall call, out object? result);
        int __DynGetIndex(LateCall keys, out object? result);
        int __DynSetIndex(LateCall keys, object? value);
        int __DynOperator(int op, object? left, object? right, out object? result);
        int __DynConvert(Type target, bool explicitly, out object? result);
        int __DynEvent(string name, bool add, object? handler);
    }

    /// <summary>
    /// A delegate called by a dynamic binder: every delegate type is one,
    /// its Invoke reached with the call's arguments matched to its own
    /// parameters (each delegate's own default implementation, the library's
    /// written here and a program's by the compiler), so the delegate made
    /// dynamic is the delegate itself.
    /// </summary>
    public interface ILateInvocable
    {
        object? __LateInvoke(LateCall call);
    }
}

namespace System
{
    /// <summary>
    /// The conversions C#'s run-time binder makes, and its choice among a
    /// method group's applicable members (Microsoft.CSharp's DynamicRuntime
    /// and the members the compiler writes for a dynamic receiver both use
    /// them).
    /// </summary>
    public static class DynamicValues
    {
        const int Done = 0;

        /// An optional parameter that was given nothing (LateCall.At).
        public static readonly object Missing = new object();

        public static string TypeName(object? o)
        {
            if (o == null) return "<null>";
            if (o is string) return "string";
            if (o is int) return "int";
            if (o is long) return "long";
            if (o is double) return "double";
            if (o is bool) return "bool";
            if (o is char) return "char";
            if (o is float) return "float";
            if (o is uint) return "uint";
            if (o is ulong) return "ulong";
            if (o is short) return "short";
            if (o is ushort) return "ushort";
            if (o is byte) return "byte";
            if (o is sbyte) return "sbyte";
            return o.GetType().FullName;
        }

        static long AsLong(object? v)
        {
            if (v is int i) return i;
            if (v is long l) return l;
            if (v is short s) return s;
            if (v is sbyte sb) return sb;
            if (v is byte b) return b;
            if (v is ushort us) return us;
            if (v is char c) return c;
            if (v is uint ui) return ui;
            if (v is ulong ul) return (long)ul;
            if (v is float f) return (long)f;
            if (v is double d) return (long)d;
            throw new InvalidCastException();
        }

        static double AsDouble(object? v)
        {
            if (v is double d) return d;
            if (v is float f) return f;
            if (v is ulong ul) return (double)ul;
            return AsLong(v);
        }

        /// <summary>
        /// A delegate's parameter from its argument (ILateInvocable): what it
        /// is, or what the binder's implicit conversion makes it.
        /// </summary>
        public static T Argument<T>(object? value)
        {
            if (value is T same) return same;
            return (T)Convert(value, typeof(T), false);
        }

        /// Whether an argument converts implicitly to a delegate's parameter type.
        public static bool Accepts<T>(object? value) { return value is T || Fits(value, typeof(T)); }

        /// Whether every element of a list fits a test (an expanded `params` array).
        public static bool All(object?[] items, Func<object?, bool> test)
        {
            for (int i = 0; i < items.Length; i++) if (!test(items[i])) return false;
            return true;
        }

        /// <summary>
        /// Whether a value converts implicitly to a type (an overload's
        /// parameter): null to a reference or a Nullable; a number to itself
        /// or a wider number (C# 10.2.3); anything else to its own run-time
        /// type (a reference to a base or an interface is the `is` test the
        /// compiler writes beside this).
        /// </summary>
        public static bool Fits(object? value, Type type)
        {
            if (type == typeof(object)) return true;
            if (value == null) return !type.IsValueType || IsNullable(type);
            if (value == Missing) return false;
            Type held = value.GetType();
            if (held == type) return true;
            int target = NumberKind(type);
            if (target != 0) return Widens(value, target);
            return false;
        }

        /// Whether a value is exactly of a type (C# 12.6.4.5's "exactly matches").
        public static bool Exact(object? value, Type type) { return value != null && value != Missing && value.GetType() == type; }

        static bool IsNullable(Type t) { return t.Name.StartsWith("Nullable", StringComparison.Ordinal); }

        /// A type as C# writes it in a message: its keyword for a number, a bool, a char, a string or object.
        public static string TypeText(Type t)
        {
            if (t == typeof(int)) return "int";
            if (t == typeof(long)) return "long";
            if (t == typeof(double)) return "double";
            if (t == typeof(bool)) return "bool";
            if (t == typeof(char)) return "char";
            if (t == typeof(string)) return "string";
            if (t == typeof(object)) return "object";
            if (t == typeof(float)) return "float";
            if (t == typeof(uint)) return "uint";
            if (t == typeof(ulong)) return "ulong";
            if (t == typeof(short)) return "short";
            if (t == typeof(ushort)) return "ushort";
            if (t == typeof(byte)) return "byte";
            if (t == typeof(sbyte)) return "sbyte";
            return t.FullName;
        }

        // A number type's kind: 1 sbyte, 2 byte, 3 short, 4 ushort, 5 int, 6 uint, 7 long, 8 ulong, 9 char, 10 float, 11 double.
        static int NumberKind(Type t)
        {
            if (t == typeof(sbyte)) return 1;
            if (t == typeof(byte)) return 2;
            if (t == typeof(short)) return 3;
            if (t == typeof(ushort)) return 4;
            if (t == typeof(int)) return 5;
            if (t == typeof(uint)) return 6;
            if (t == typeof(long)) return 7;
            if (t == typeof(ulong)) return 8;
            if (t == typeof(char)) return 9;
            if (t == typeof(float)) return 10;
            if (t == typeof(double)) return 11;
            return 0;
        }

        static int ValueKind(object v)
        {
            if (v is sbyte) return 1;
            if (v is byte) return 2;
            if (v is short) return 3;
            if (v is ushort) return 4;
            if (v is int) return 5;
            if (v is uint) return 6;
            if (v is long) return 7;
            if (v is ulong) return 8;
            if (v is char) return 9;
            if (v is float) return 10;
            if (v is double) return 11;
            return 0;
        }

        /// C#'s implicit numeric conversions (10.2.3), from a value's kind to a target kind.
        static bool Widens(object value, int to)
        {
            int from = ValueKind(value);
            if (from == 0) return false;
            if (from == to) return true;
            switch (from)
            {
                case 1: return to == 3 || to == 5 || to == 7 || to == 10 || to == 11;
                case 2: return to == 3 || to == 4 || to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 3: return to == 5 || to == 7 || to == 10 || to == 11;
                case 4: return to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 5: return to == 7 || to == 10 || to == 11;
                case 6: return to == 7 || to == 8 || to == 10 || to == 11;
                case 7: return to == 10 || to == 11;
                case 8: return to == 10 || to == 11;
                case 9: return to == 4 || to == 5 || to == 6 || to == 7 || to == 8 || to == 10 || to == 11;
                case 10: return to == 11;
            }
            return false;
        }

        /// <summary>
        /// A value made a type (the compiler casts what this answers to it):
        /// implicitly, what Fits allows; explicitly, any number to any other
        /// (unchecked, as C# casts outside `checked`) and an object to what it
        /// is. A struct's own conversion operators are asked first; a class's
        /// by DynamicRuntime, through the providers, before this.
        /// </summary>
        public static object Convert(object? value, Type type, bool explicitly)
        {
            if (type == typeof(object)) return value!;
            object? result;
            if (value == null)
            {
                if (!type.IsValueType || IsNullable(type)) return null!;
                throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot convert null to '" + TypeText(type) + "' because it is a non-nullable value type");
            }
            if (value.GetType() == type) return value;
            if (value is System.Dynamic.IDynamicMembers m && m.__DynConvert(type, explicitly, out result) == Done) return result!;
            int target = NumberKind(type);
            if (target != 0 && ValueKind(value) != 0)
            {
                if (!explicitly && !Widens(value, target))
                    throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot implicitly convert type '" + TypeName(value) + "' to '" + TypeText(type) + "'. An explicit conversion exists (are you missing a cast?)");
                return Number(value, target);
            }
            if (IsNullable(type) && ValueKind(value) != 0) return value;
            // A REFERENCE: the cast the compiler writes after this checks it,
            // with InvalidCastException; asked here only to say it C#'s way.
            if (type.IsValueType && !type.IsEnum)
                throw new Microsoft.CSharp.RuntimeBinder.RuntimeBinderException("Cannot " + (explicitly ? "" : "implicitly ") + "convert type '" + TypeName(value) + "' to '" + TypeText(type) + "'");
            return value;
        }

        static object Number(object v, int to)
        {
            if (v is double || v is float)
            {
                double d = AsDouble(v);
                switch (to)
                {
                    case 10: return (float)d;
                    case 11: return d;
                }
                long whole = unchecked((long)d);
                return Integer(whole, to);
            }
            if (v is ulong ul && to == 10) return (float)ul;
            if (v is ulong ul2 && to == 11) return (double)ul2;
            long n = AsLong(v);
            if (to == 10) return (float)n;
            if (to == 11) return (double)n;
            return Integer(n, to);
        }

        static object Integer(long n, int to)
        {
            switch (to)
            {
                case 1: return unchecked((sbyte)n);
                case 2: return unchecked((byte)n);
                case 3: return unchecked((short)n);
                case 4: return unchecked((ushort)n);
                case 5: return unchecked((int)n);
                case 6: return unchecked((uint)n);
                case 7: return n;
                case 8: return unchecked((ulong)n);
                case 9: return unchecked((char)n);
            }
            throw new InvalidCastException();
        }

        // ---- the better function member (C# 12.6.4.3) ---------------------------------------

        /// <summary>
        /// Of a method group's candidates -- `maps` each one's parameters'
        /// arguments (LateCall.Map, MapExpanded), `applicable` which take
        /// them -- the one better than every other, as C# chooses (12.6.4.3):
        /// for each argument, the conversion to its parameter's type better
        /// (12.6.4.5: an argument whose run-time type is exactly one
        /// parameter's type and not the other's, else the better conversion
        /// target, 12.6.4.7, which the group carries); with no difference in
        /// the parameter types, a non-generic method over a generic one's
        /// instantiation, the normal form over the expanded, and a candidate
        /// with no default argument filled in over one with. The index of the
        /// best; -1 when none applies, -2 when no one is better than all the
        /// others (ambiguous).
        /// </summary>
        public static int Choose(System.Dynamic.LateCall call, System.Dynamic.LateGroup group, int[]?[] maps, bool[] applicable)
        {
            int best = -1;
            int count = 0;
            for (int i = 0; i < applicable.Length; i++) if (applicable[i]) { count++; best = i; }
            if (count <= 1) return best;
            for (int i = 0; i < applicable.Length; i++)
            {
                if (!applicable[i]) continue;
                bool wins = true;
                for (int j = 0; j < applicable.Length && wins; j++)
                {
                    if (j == i || !applicable[j]) continue;
                    if (Compare(call, group, maps, i, j) <= 0) wins = false;
                }
                if (wins) return i;
            }
            return -2;
        }

        /// The parameter type (an index into the group's Types) argument `argument` meets in candidate `c`; -1 for none.
        static int TypeFor(System.Dynamic.LateGroup group, int[]?[] maps, int c, int argument)
        {
            int[] map = maps[c]!;
            int[] types = group.Parameters[c];
            for (int p = 0; p < map.Length; p++)
            {
                if (map[p] == argument) return types[p];
                if (map[p] == -2) return argument >= p ? group.Element[c] : -1;     // the expanded rest
            }
            return -1;
        }

        static int Defaults(int[] map)
        {
            int n = 0;
            for (int p = 0; p < map.Length; p++) if (map[p] == -1) n++;
            return n;
        }

        /// 1 when candidate a is better than b for this call, -1 when b is, 0 when neither.
        static int Compare(System.Dynamic.LateCall call, System.Dynamic.LateGroup group, int[]?[] maps, int a, int b)
        {
            bool aBetter = false, bBetter = false, same = true;
            for (int i = 0; i < call.Args.Length; i++)
            {
                int ta = TypeFor(group, maps, a, i), tb = TypeFor(group, maps, b, i);
                // One type however it was annotated: `string?` and `string`
                // are one parameter type to C# (an annotation, not a type).
                if (ta < 0 || tb < 0 || ta == tb || group.Types[ta] == group.Types[tb]) continue;
                same = false;
                bool exactA = call.ExactlyOf(i, group.Types[ta]), exactB = call.ExactlyOf(i, group.Types[tb]);
                int said = exactA && !exactB ? 1 : exactB && !exactA ? -1
                         : group.BetterTarget(ta, tb) && !group.BetterTarget(tb, ta) ? 1
                         : group.BetterTarget(tb, ta) && !group.BetterTarget(ta, tb) ? -1 : 0;
                if (said > 0) aBetter = true;
                if (said < 0) bBetter = true;
            }
            if (aBetter && !bBetter) return 1;
            if (bBetter && !aBetter) return -1;
            if (aBetter && bBetter) return 0;
            if (!same) return 0;
            // THE TIE-BREAKS, the parameter types being the same.
            if (!group.Generic[a] && group.Generic[b]) return 1;
            if (group.Generic[a] && !group.Generic[b]) return -1;
            bool expandedA = group.Element[a] >= 0, expandedB = group.Element[b] >= 0;
            if (!expandedA && expandedB) return 1;
            if (expandedA && !expandedB) return -1;
            int da = Defaults(maps[a]!), db = Defaults(maps[b]!);
            if (da == 0 && db > 0) return 1;
            if (db == 0 && da > 0) return -1;
            return 0;
        }
    }
}
