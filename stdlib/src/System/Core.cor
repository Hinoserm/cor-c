    // ---- to DateTime ------------------------------------------------------------
    //
    // Only a date or text is one; a null string is the first moment there is.

    public static DateTime ToDateTime(DateTime value) { return value; }
    public static DateTime ToDateTime(string? value) { return value == null ? DateTime.MinValue : DateTime.Parse(value); }
    public static DateTime ToDateTime(string? value, IFormatProvider? provider) { return ToDateTime(value); }
    public static DateTime ToDateTime(bool value) { throw Cast("Boolean", "DateTime"); }
    public static DateTime ToDateTime(char value) { throw Cast("Char", "DateTime"); }
    public static DateTime ToDateTime(sbyte value) { throw Cast("SByte", "DateTime"); }
    public static DateTime ToDateTime(byte value) { throw Cast("Byte", "DateTime"); }
    public static DateTime ToDateTime(short value) { throw Cast("Int16", "DateTime"); }
    public static DateTime ToDateTime(ushort value) { throw Cast("UInt16", "DateTime"); }
    public static DateTime ToDateTime(int value) { throw Cast("Int32", "DateTime"); }
    public static DateTime ToDateTime(uint value) { throw Cast("UInt32", "DateTime"); }
    public static DateTime ToDateTime(long value) { throw Cast("Int64", "DateTime"); }
    public static DateTime ToDateTime(ulong value) { throw Cast("UInt64", "DateTime"); }
    public static DateTime ToDateTime(float value) { throw Cast("Single", "DateTime"); }
    public static DateTime ToDateTime(double value) { throw Cast("Double", "DateTime"); }
    public static DateTime ToDateTime(object? value) {
        if (value == null) { return DateTime.MinValue; }
        if (value is DateTime date) { return date; }
        if (value is string text) { return ToDateTime(text); }
        if (value is bool) { throw Cast("Boolean", "DateTime"); }
        if (value is char) { throw Cast("Char", "DateTime"); }
        if (value is sbyte) { throw Cast("SByte", "DateTime"); }
        if (value is byte) { throw Cast("Byte", "DateTime"); }
        if (value is short) { throw Cast("Int16", "DateTime"); }
        if (value is ushort) { throw Cast("UInt16", "DateTime"); }
        if (value is int) { throw Cast("Int32", "DateTime"); }
        if (value is uint) { throw Cast("UInt32", "DateTime"); }
        if (value is long) { throw Cast("Int64", "DateTime"); }
        if (value is ulong) { throw Cast("UInt64", "DateTime"); }
        if (value is float) { throw Cast("Single", "DateTime"); }
        if (value is double) { throw Cast("Double", "DateTime"); }
        throw NotConvertible(value);
    }
    public static DateTime ToDateTime(object? value, IFormatProvider? provider) { return ToDateTime(value); }

    // ---- integers in base 2, 8, 10 or 16 ---------------------------------------
    //
    // .NET's ParseNumbers, as Convert calls it: no white space at either end,
    // a minus sign in base 10 only (and never for an unsigned type), "0x" or
    // "0X" allowed before base-16 digits, then digits to the very end. In
    // bases other than 10 the digits are a bit pattern: "FF" is -1 as an
    // sbyte. The order of the refusals is .NET's -- too many digits is an
    // overflow even with junk after them, since the digits are read first.

    private const int Tight = 0x1000, AsUnsigned = 0x200, AsI1 = 0x40, AsI2 = 0x80;

    private static void CheckBase(int fromBase) {
        if (fromBase != 2 && fromBase != 8 && fromBase != 10 && fromBase != 16) { throw new ArgumentException("Invalid Base."); }
    }

    private static bool DigitIn(char c, int radix, out int value) {
        if (c >= '0' && c <= '9') { value = c - '0'; }
        else if (c >= 'A' && c <= 'Z') { value = c - 'A' + 10; }
        else if (c >= 'a' && c <= 'z') { value = c - 'a' + 10; }
        else { value = -1; return false; }
        return value < radix;
    }

    // Where the digits start, past the sign and a "0x"; `sign` is -1 for a
    // minus. The checks that come before any digit is read.
    private static int Lead(string s, int r, int flags, out int sign) {
        if (s.Length == 0) { throw new ArgumentOutOfRangeException("Index was out of range. Must be non-negative and less than the size of the collection."); }
        int i = 0;
        sign = 1;
        if (s[i] == '-') {
            if (r != 10) { throw new ArgumentException("String cannot contain a minus sign if the base is not 10."); }
            if ((flags & AsUnsigned) != 0) { throw new OverflowException("The string was being parsed as an unsigned number and could not have a negative sign."); }
            sign = -1;
            i++;
        }
        else if (s[i] == '+') { i++; }
        if (r == 16 && i + 1 < s.Length && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) { i += 2; }
        return i;
    }

    // What follows the digits: nothing, or one of .NET's two refusals.
    private static void Trail(string s, int start, int i) {
        if (i == start) { throw new FormatException("Could not find any recognizable digits."); }
        if (i < s.Length) { throw new FormatException("Additional non-parsable characters are at the end of the string."); }
    }

    private static int StringToInt(string s, int r, int flags) {
        int i = Lead(s, r, flags, out int sign);
        int start = i;
        uint result = 0;
        if (r == 10 && (flags & AsUnsigned) == 0) {
            uint most = (uint)0x7FFFFFFF / (uint)10;
            while (i < s.Length && DigitIn(s[i], r, out int digit)) {
                if (result > most || (int)result < 0) { throw Over("an Int32"); }
                result = result * (uint)r + (uint)digit;
                i++;
            }
            if ((int)result < 0 && result != (uint)0x80000000) { throw Over("an Int32"); }
        }
        else {
            uint most = (uint)0xFFFFFFFF / (uint)r;
            while (i < s.Length && DigitIn(s[i], r, out int digit)) {
                if (result > most) { throw Over("a UInt32"); }
                uint next = result * (uint)r + (uint)digit;
                if (next < result) { throw Over("a UInt32"); }
                result = next;
                i++;
            }
        }
        Trail(s, start, i);
        if ((flags & AsI1) != 0) {
            if (result > (uint)0xFF) { throw Over("a signed byte"); }
        }
        else if ((flags & AsI2) != 0) {
            if (result > (uint)0xFFFF) { throw Over("an Int16"); }
        }
        else if (result == (uint)0x80000000 && sign == 1 && r == 10 && (flags & AsUnsigned) == 0) {
            throw Over("an Int32");
        }
        int signed = (int)result;
        return r == 10 ? signed * sign : signed;
    }

    private static long StringToLong(string s, int r, int flags) {
        int i = Lead(s, r, flags, out int sign);
        int start = i;
        ulong result = 0;
        if (r == 10 && (flags & AsUnsigned) == 0) {
            ulong most = (ulong)0x7FFFFFFFFFFFFFFF / (ulong)10;
            while (i < s.Length && DigitIn(s[i], r, out int digit)) {
                if (result > most || (long)result < 0) { throw Over("an Int64"); }
                result = result * (ulong)r + (ulong)digit;
                i++;
            }
            if ((long)result < 0 && result != (ulong)0x8000000000000000) { throw Over("an Int64"); }
        }
        else {
            ulong most = ulong.MaxValue / (ulong)r;
            while (i < s.Length && DigitIn(s[i], r, out int digit)) {
                if (result > most) { throw Over("a UInt64"); }
                ulong next = result * (ulong)r + (ulong)digit;
                if (next < result) { throw Over("a UInt64"); }
                result = next;
                i++;
            }
        }
        Trail(s, start, i);
        if (result == (ulong)0x8000000000000000 && sign == 1 && r == 10 && (flags & AsUnsigned) == 0) { throw Over("an Int64"); }
        long signed = (long)result;
        return r == 10 ? signed * sign : signed;
    }

    public static byte ToByte(string? value, int fromBase) {
        CheckBase(fromBase);
        if (value == null) { return 0; }
        int r = StringToInt(value, fromBase, Tight | AsUnsigned);
        if ((uint)r > (uint)255) { throw Over("an unsigned byte"); }
        return (byte)r;
    }

    public static sbyte ToSByte(string? value, int fromBase) {
        CheckBase(fromBase);
        if (value == null) { return 0; }
        int r = StringToInt(value, fromBase, Tight | AsI1);
        if (fromBase != 10 && r <= 255) { return (sbyte)(byte)r; }
        if (r < -128 || r > 127) { throw Over("a signed byte"); }
        return (sbyte)r;
    }

    public static short ToInt16(string? value, int fromBase) {
        CheckBase(fromBase);
        if (value == null) { return 0; }
        int r = StringToInt(value, fromBase, Tight | AsI2);
        if (fromBase != 10 && r <= 65535) { return (short)(ushort)r; }
        if (r < -32768 || r > 32767) { throw Over("an Int16"); }
        return (short)r;
    }

    public static ushort ToUInt16(string? value, int fromBase) {
        CheckBase(fromBase);
        if (value == null) { return 0; }
        int r = StringToInt(value, fromBase, Tight | AsUnsigned);
        if ((uint)r > (uint)65535) { throw Over("a UInt16"); }
        return (ushort)r;
    }

    public static int ToInt32(string? value, int fromBase) {
        CheckBase(fromBase);
        return value == null ? 0 : StringToInt(value, fromBase, Tight);
    }

    public static uint ToUInt32(string? value, int fromBase) {
        CheckBase(fromBase);
        return value == null ? (uint)0 : (uint)StringToInt(value, fromBase, Tight | AsUnsigned);
    }

    public static long ToInt64(string? value, int fromBase) {
        CheckBase(fromBase);
        return value == null ? (long)0 : StringToLong(value, fromBase, Tight);
    }

    public static ulong ToUInt64(string? value, int fromBase) {
        CheckBase(fromBase);
        return value == null ? (ulong)0 : (ulong)StringToLong(value, fromBase, Tight | AsUnsigned);
    }

    // ---- integers as text in base 2, 8, 10 or 16 -----------------------------
    //
    // Base 10 is the number as it prints. The other bases print the BIT
    // PATTERN of the type's width -- (-1, 16) is "ffffffff" for an int and
    // "ffff" for a short -- in lower case, as .NET's ParseNumbers writes it.

    private static string Pattern(ulong bits, int toBase) {
        if (bits == 0) { return "0"; }
        string digits = "0123456789abcdef";
        char[] made = new char[64];
        int at = 64;
        while (bits != 0) {
            at--;
            made[at] = digits[(int)(bits % (ulong)toBase)];
            bits = bits / (ulong)toBase;
        }
        return new string(made, at, 64 - at);
    }

    public static string ToString(byte value, int toBase) {
        CheckBase(toBase);
        return toBase == 10 ? value.ToString() : Pattern((ulong)value, toBase);
    }

    public static string ToString(short value, int toBase) {
        CheckBase(toBase);
        return toBase == 10 ? value.ToString() : Pattern((ulong)(ushort)value, toBase);
    }

    public static string ToString(int value, int toBase) {
        CheckBase(toBase);
        return toBase == 10 ? value.ToString() : Pattern((ulong)(uint)value, toBase);
    }

    public static string ToString(long value, int toBase) {
        CheckBase(toBase);
        return toBase == 10 ? value.ToString() : Pattern((ulong)value, toBase);
    }

    // ---- base 64 ----------------------------------------------------------
    //
    // THREE BYTES BECOME FOUR CHARACTERS, six bits at a time, and the tail is
    // padded with '=' to keep the length a multiple of four. It is how binary
    // travels through anything that expects text -- a certificate, a mail
    // attachment, a JSON document -- and the alphabet is fixed by RFC 4648, so
    // this and .NET produce the same string byte for byte.
    public static string ToBase64String(byte[] inArray) {
        if (inArray == null) { throw new ArgumentNullException("inArray"); }
        return ToBase64String(inArray, 0, inArray.Length, Base64FormattingOptions.None);
    }

    public static string ToBase64String(byte[] inArray, Base64FormattingOptions options) {
        if (inArray == null) { throw new ArgumentNullException("inArray"); }
        return ToBase64String(inArray, 0, inArray.Length, options);
    }

    public static string ToBase64String(byte[] inArray, int offset, int length) {
        return ToBase64String(inArray, offset, length, Base64FormattingOptions.None);
    }

    public static string ToBase64String(ReadOnlySpan<byte> bytes, Base64FormattingOptions options = Base64FormattingOptions.None) {
        return ToBase64String(bytes.ToArray(), 0, bytes.Length, options);
    }

    /// .NET's checks, in its order, and its line breaks: with InsertLineBreaks
    /// a CR LF after every 76 characters, none after the last.
    public static string ToBase64String(byte[] inArray, int offset, int length, Base64FormattingOptions options) {
        if (inArray == null) { throw new ArgumentNullException("inArray"); }
        ArgumentOutOfRangeException.ThrowIfNegative(length);
        ArgumentOutOfRangeException.ThrowIfNegative(offset);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(offset, inArray.Length - length);
        if ((uint)options > (uint)Base64FormattingOptions.InsertLineBreaks) {
            throw new ArgumentException("Illegal enum value: " + (int)options + ".", "options");
        }
        string text = Base64Of(inArray, offset, length);
        if (options != Base64FormattingOptions.InsertLineBreaks || text.Length <= 76) { return text; }
        StringBuilder lines = new StringBuilder();
        for (int at = 0; at < text.Length; at = at + 76) {
            if (at > 0) { lines.Append("\r\n"); }
            lines.Append(text, at, Math.Min(76, text.Length - at));
        }
        return lines.ToString();
    }

    /// The base 64 of the bytes into an array, as ToBase64String writes it,
    /// and how many characters that was.
    public static int ToBase64CharArray(byte[] inArray, int offsetIn, int length, char[] outArray, int offsetOut) {
        return ToBase64CharArray(inArray, offsetIn, length, outArray, offsetOut, Base64FormattingOptions.None);
    }

    public static int ToBase64CharArray(byte[] inArray, int offsetIn, int length, char[] outArray, int offsetOut, Base64FormattingOptions options) {
        if (inArray == null) { throw new ArgumentNullException("inArray"); }
        if (outArray == null) { throw new ArgumentNullException("outArray"); }
        ArgumentOutOfRangeException.ThrowIfNegative(length);
        ArgumentOutOfRangeException.ThrowIfNegative(offsetIn);
        ArgumentOutOfRangeException.ThrowIfNegative(offsetOut);
        if ((uint)options > (uint)Base64FormattingOptions.InsertLineBreaks) {
            throw new ArgumentException("Illegal enum value: " + (int)options + ".", "options");
        }
        if (offsetIn > inArray.Length - length) {
            throw new ArgumentOutOfRangeException("offsetIn", "Offset and length must refer to a position in the string.");
        }
        string text = ToBase64String(inArray, offsetIn, length, options);
        if (offsetOut > outArray.Length - text.Length) {
            throw new ArgumentOutOfRangeException("offsetOut", "Either offset did not refer to a position in the string, or there is an insufficient length of destination character array.");
        }
        for (int i = 0; i < text.Length; i++) { outArray[offsetOut + i] = text[i]; }
        return text.Length;
    }

    public static bool TryToBase64Chars(ReadOnlySpan<byte> bytes, Span<char> chars, out int charsWritten, Base64FormattingOptions options = Base64FormattingOptions.None) {
        if ((uint)options > (uint)Base64FormattingOptions.InsertLineBreaks) {
            throw new ArgumentException("Illegal enum value: " + (int)options + ".", "options");
        }
        string text = ToBase64String(bytes, options);
        if (text.Length > chars.Length) {
            charsWritten = 0;
            return false;
        }
        for (int i = 0; i < text.Length; i++) { chars[i] = text[i]; }
        charsWritten = text.Length;
        return true;
    }

    private static string Base64Of(byte[] bytes, int offset, int length) {
        string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder made = new StringBuilder();
        int at = offset;
        int end = offset + length;

        while (at < end) {
            int first = bytes[at] & 255;
            int second = at + 1 < end ? bytes[at + 1] & 255 : 0;
            int third = at + 2 < end ? bytes[at + 2] & 255 : 0;
            int block = (first << 16) | (second << 8) | third;

            made.Append(Sys.GetChar(alphabet, (block >> 18) & 63));
            made.Append(Sys.GetChar(alphabet, (block >> 12) & 63));
            made.Append(at + 1 < end ? Sys.GetChar(alphabet, (block >> 6) & 63) : '=');
            made.Append(at + 2 < end ? Sys.GetChar(alphabet, block & 63) : '=');
            at = at + 3;
        }
        return made.ToString();
    }

    public static byte[] FromBase64String(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }

        int[] values = new int[text.Length];
        int count = 0;

        for (int i = 0; i < text.Length; i++) {
            char c = Sys.GetChar(text, i);
            int value = Base64Value(c);

            // WHITESPACE IS IGNORED and padding ends the data, both of which
            // .NET's decoder does: base 64 arrives wrapped at 76 columns more
            // often than not.
            if (c == ' ' || c == '\n' || c == '\r' || c == '\t') { continue; }
            if (c == '=') { break; }
            if (value < 0) { throw new FormatException("The input is not a valid Base-64 string."); }

            values[count] = value;
            count = count + 1;
        }

        int whole = count / 4;
        int leftover = count % 4;
        int size = whole * 3 + (leftover == 0 ? 0 : leftover - 1);
        byte[] made = new byte[size];
        int written = 0;
        int at = 0;

        while (at + 3 < count) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6) | values[at + 3];

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
            made[written + 2] = (byte)(block & 255);
            written = written + 3;
            at = at + 4;
        }

        if (leftover == 2) {
            made[written] = (byte)(((values[at] << 18) | (values[at + 1] << 12)) >> 16);
        } else if (leftover == 3) {
            int block = (values[at] << 18) | (values[at + 1] << 12) | (values[at + 2] << 6);

            made[written] = (byte)((block >> 16) & 255);
            made[written + 1] = (byte)((block >> 8) & 255);
        } else if (leftover == 1) {
            throw new FormatException("The input is not a valid Base-64 string.");
        }
        return made;
    }

    private static int Base64Value(char c) {
        if (c >= 'A' && c <= 'Z') { return c - 'A'; }
        if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
        if (c >= '0' && c <= '9') { return c - '0' + 52; }
        if (c == '+') { return 62; }
        if (c == '/') { return 63; }
        return -1;
    }

    /// UPPER CASE AND NO SEPARATORS, which is where .NET 5's ToHexString
    /// differs from BitConverter.ToString: the same bytes, without the dashes.
    /// ToHexStringLower is .NET 9's, the same in lower case.
    public static string ToHexString(byte[] bytes) {
        if (bytes == null) { throw new ArgumentNullException("inArray"); }
        return Hex(new ReadOnlySpan<byte>(bytes), "0123456789ABCDEF");
    }

    public static string ToHexString(byte[] bytes, int offset, int length) {
        return Hex(HexRange(bytes, offset, length), "0123456789ABCDEF");
    }

    public static string ToHexString(ReadOnlySpan<byte> bytes) { return Hex(bytes, "0123456789ABCDEF"); }

    public static string ToHexStringLower(byte[] bytes) {
        if (bytes == null) { throw new ArgumentNullException("inArray"); }
        return Hex(new ReadOnlySpan<byte>(bytes), "0123456789abcdef");
    }

    public static string ToHexStringLower(byte[] bytes, int offset, int length) {
        return Hex(HexRange(bytes, offset, length), "0123456789abcdef");
    }

    public static string ToHexStringLower(ReadOnlySpan<byte> bytes) { return Hex(bytes, "0123456789abcdef"); }

    // The window .NET's range overloads take, refused as .NET refuses it.
    private static ReadOnlySpan<byte> HexRange(byte[] bytes, int offset, int length) {
        if (bytes == null) { throw new ArgumentNullException("inArray"); }
        if (length < 0) { throw new ArgumentOutOfRangeException("length", "Value must be positive."); }
        if (offset < 0) { throw new ArgumentOutOfRangeException("offset", "Value must be positive."); }
        if (offset > bytes.Length - length) { throw new ArgumentOutOfRangeException("offset", "Offset and length must refer to a position in the string."); }
        return new ReadOnlySpan<byte>(bytes, offset, length);
    }

    private static string Hex(ReadOnlySpan<byte> bytes, string alphabet) {
        string made = Sys.NewChars(bytes.Length * 2);
        for (int i = 0; i < bytes.Length; i++) {
            int value = bytes[i] & 255;
            Sys.SetChar(made, i * 2, Sys.GetChar(alphabet, value >> 4));
            Sys.SetChar(made, i * 2 + 1, Sys.GetChar(alphabet, value & 15));
        }
        return made;
    }

    public static byte[] FromHexString(string text) {
        if (text == null) { throw new ArgumentNullException("s"); }
        if (text.Length % 2 != 0) {
            throw new FormatException("The input is not a valid hex string as its length is not a multiple of 2.");
        }

        byte[] made = new byte[text.Length / 2];

        for (int i = 0; i < made.Length; i++) {
            int high = NumberParse.DigitOf(Sys.GetChar(text, i * 2));
            int low = NumberParse.DigitOf(Sys.GetChar(text, i * 2 + 1));

            if (high < 0 || high > 15 || low < 0 || low > 15) {
                throw new FormatException("The input is not a valid hex string as it contains a non-hex character.");
            }
            made[i] = (byte)(high * 16 + low);
        }
        return made;
    }
}

// .NET's BitConverter, with the four members that reinterpret a number's BITS
// rather than convert its value -- which is what a compiler does to put a
// double in an image and take it out again.
static class BitConverter {
    public static long DoubleToInt64Bits(double value) { return Sys.Bits(value); }
    public static double Int64BitsToDouble(long value) { return Sys.FromBits(value); }
    public static int SingleToInt32Bits(float value) { return Sys.SingleBits(value); }
    public static float Int32BitsToSingle(int value) { return Sys.FromSingleBits(value); }
    public static ulong DoubleToUInt64Bits(double value) { return (ulong)Sys.Bits(value); }
    public static double UInt64BitsToDouble(ulong value) { return Sys.FromBits((long)value); }
    public static uint SingleToUInt32Bits(float value) { return (uint)Sys.SingleBits(value); }
    public static float UInt32BitsToSingle(uint value) { return Sys.FromSingleBits((int)value); }

    // ---- a number from the start of a span ----------------------------------
    //
    // .NET's: the bytes at the start of the span, little end first; a span
    // too short for the width is refused by the parameter's name.

    private static long Take(ReadOnlySpan<byte> value, int width, bool signed) {
        if (value.Length < width) { throw new ArgumentOutOfRangeException("value"); }
        long made = 0;
        for (int i = 0; i < width; i++) { made = made | ((long)value[i] << (i * 8)); }
        if (signed && width < 8) {
            int spare = 64 - width * 8;
            made = (made << spare) >> spare;
        }
        return made;
    }

    public static bool ToBoolean(ReadOnlySpan<byte> value) { return Take(value, 1, false) != 0; }
    public static char ToChar(ReadOnlySpan<byte> value) { return (char)Take(value, 2, false); }
    public static short ToInt16(ReadOnlySpan<byte> value) { return (short)Take(value, 2, true); }
    public static ushort ToUInt16(ReadOnlySpan<byte> value) { return (ushort)Take(value, 2, false); }
    public static int ToInt32(ReadOnlySpan<byte> value) { return (int)Take(value, 4, true); }
    public static uint ToUInt32(ReadOnlySpan<byte> value) { return (uint)Take(value, 4, false); }
    public static long ToInt64(ReadOnlySpan<byte> value) { return Take(value, 8, true); }
    public static ulong ToUInt64(ReadOnlySpan<byte> value) { return (ulong)Take(value, 8, true); }
    public static float ToSingle(ReadOnlySpan<byte> value) { return Int32BitsToSingle((int)Take(value, 4, true)); }
    public static double ToDouble(ReadOnlySpan<byte> value) { return Sys.FromBits(Take(value, 8, true)); }

    /// TRUE, and it is a fact about the processor rather than a choice: every
    /// machine this compiler targets stores the little end first. A program
    /// writing a format that is big-endian on the wire reads this and swaps.
    public static bool IsLittleEndian => true;

    // ---- a number as its bytes -------------------------------------------
    //
    // LITTLE END FIRST, which is what the machine holds them as, so what comes
    // back is the number's storage and not a rendering of it. This is the pair
    // a file format and a network protocol are written with.

    // ---- into a span the caller has ------------------------------------------
    //
    // .NET's TryWriteBytes: the value's bytes, little end first, written into
    // the start of `destination` when it holds that many, and false with
    // nothing written when it does not. No array is made.

    static bool Put(Span<byte> destination, long value, int count) {
        if (destination.Length < count) { return false; }
        for (int i = 0; i < count; i++) { destination[i] = (byte)(value >> (8 * i)); }
        return true;
    }

    public static bool TryWriteBytes(Span<byte> destination, bool value) { return Put(destination, value ? 1 : 0, 1); }
    public static bool TryWriteBytes(Span<byte> destination, char value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, short value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, ushort value) { return Put(destination, (long)value, 2); }
    public static bool TryWriteBytes(Span<byte> destination, int value) { return Put(destination, (long)value, 4); }
    public static bool TryWriteBytes(Span<byte> destination, uint value) { return Put(destination, (long)value, 4); }
    public static bool TryWriteBytes(Span<byte> destination, long value) { return Put(destination, value, 8); }
    public static bool TryWriteBytes(Span<byte> destination, ulong value) { return Put(destination, (long)value, 8); }
    public static bool TryWriteBytes(Span<byte> destination, float value) { return Put(destination, (long)SingleToInt32Bits(value), 4); }
    public static bool TryWriteBytes(Span<byte> destination, double value) { return Put(destination, Sys.Bits(value), 8); }

    public static byte[] GetBytes(bool value) {
        byte[] made = new byte[1];

        made[0] = (byte)(value ? 1 : 0);
        return made;
    }

    public static byte[] GetBytes(char value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(short value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(ushort value) { return Spread((long)value, 2); }
    public static byte[] GetBytes(int value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(uint value) { return Spread((long)value, 4); }
    public static byte[] GetBytes(long value) { return Spread(value, 8); }
    public static byte[] GetBytes(ulong value) { return Spread((long)value, 8); }
    public static byte[] GetBytes(double value) { return Spread(Sys.Bits(value), 8); }
    public static byte[] GetBytes(float value) { return Spread((long)SingleToInt32Bits(value), 4); }

    public static bool ToBoolean(byte[] bytes, int at) { Within(bytes, at, 1); return bytes[at] != 0; }
    public static char ToChar(byte[] bytes, int at) { return (char)Gather(bytes, at, 2, false); }
    public static short ToInt16(byte[] bytes, int at) { return (short)Gather(bytes, at, 2, true); }
    public static ushort ToUInt16(byte[] bytes, int at) { return (ushort)Gather(bytes, at, 2, false); }
    public static int ToInt32(byte[] bytes, int at) { return (int)Gather(bytes, at, 4, true); }
    public static uint ToUInt32(byte[] bytes, int at) { return (uint)Gather(bytes, at, 4, false); }
    public static long ToInt64(byte[] bytes, int at) { return Gather(bytes, at, 8, true); }
    public static ulong ToUInt64(byte[] bytes, int at) { return (ulong)Gather(bytes, at, 8, true); }
    public static double ToDouble(byte[] bytes, int at) { return Sys.FromBits(Gather(bytes, at, 8, true)); }
    public static float ToSingle(byte[] bytes, int at) { return Int32BitsToSingle((int)Gather(bytes, at, 4, true)); }

    /// THE BYTES IN CAPITALS, SEPARATED BY DASHES -- "00-11-FF". An odd shape
    /// for a ToString until you have read a dump written by one, which is what
    /// it is for; Convert.ToHexString is the same bytes without the dashes.
    public static string ToString(byte[] bytes) { return ToString(bytes, 0, bytes.Length); }

    public static string ToString(byte[] bytes, int at) { return ToString(bytes, at, bytes.Length - at); }

    public static string ToString(byte[] bytes, int at, int count) {
        string alphabet = "0123456789ABCDEF";
        StringBuilder made = new StringBuilder();

        for (int i = 0; i < count; i++) {
            int value = bytes[at + i] & 255;

            if (i > 0) { made.Append('-'); }
            made.Append(Sys.GetChar(alphabet, value >> 4));
            made.Append(Sys.GetChar(alphabet, value & 15));
        }
        return made.ToString();
    }

    private static byte[] Spread(long value, int width) {
        byte[] made = new byte[width];

        for (int i = 0; i < width; i++) { made[i] = (byte)((value >> (i * 8)) & 255); }
        return made;
    }

    // .NET's three refusals, in its order: no array, a start that is not an
    // element of it, and an element too near the end for the width.
    private static void Within(byte[] bytes, int at, int width) {
        if (bytes == null) { throw new ArgumentNullException("value"); }
        if ((uint)at >= (uint)bytes.Length) {
            throw new ArgumentOutOfRangeException("startIndex", "Index was out of range. Must be non-negative and less than the size of the collection.");
        }
        if (at > bytes.Length - width) {
            throw new ArgumentException("Destination array is not long enough to copy all the items in the collection. Check array index and length.", "value");
        }
    }

    private static long Gather(byte[] bytes, int at, int width, bool signed) {
        Within(bytes, at, width);
        long value = 0;

        for (int i = 0; i < width; i++) { value = value | ((long)(bytes[at + i] & 255) << (i * 8)); }

        if (signed && width < 8) {
            int spare = 64 - width * 8;

            value = (value << spare) >> spare;
        }
        return value;
    }
}

// ---- the numbers, by the names C# gives their types ------------------------
//
// `int.TryParse(text, out n)` reaches this because `int` is an ALIAS for Int32
// and the checker resolves the keyword to the class. That is C#'s own
// arrangement rather than a trick: every one of these is a real type there,
// with these members on it, and writing `Int64.Parse` compiles in both.

// ---- numbers as text, and text as numbers ---------------------------------
//
// WHAT A FORMAT STRING MEANS. `n.ToString("X8")`, `count.ToString("N0")`,
// `bytes.ToString("D5")` -- a letter saying which shape and an optional number
// saying how many, which is .NET's standard numeric format string in full for
// the integral types. The custom pictures ("#,##0.00") are a different grammar
// and are not here.
//
// It lives in a class of its own because every integral type needs it and each
// of them differs only in how wide its two's complement is -- which is the one
// thing the hexadecimal and binary shapes have to know, since (-1).ToString("X")
// is eight F's for an int and sixteen for a long.
static class NumberFormat {
    private static string Lower = "0123456789abcdef";
    private static string Upper = "0123456789ABCDEF";

    private static string Digits(ulong value, int radix, string alphabet) {
        if (value == 0) { return "0"; }

        string made = "";
        ulong left = value;

        while (left > 0) {
            made = String.Concat(String.Substring(alphabet, (int)(left % (ulong)radix), 1), made);
            left = left / (ulong)radix;
        }
        return made;
    }

    /// The digit count after the letter, or -1 when there is none. ".NET reads
    /// at most two"; anything longer is not a standard format string at all.
    private static int Width(string format) {
        if (format.Length < 2) { return -1; }

        int made = 0;
        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit(Sys.GetChar(format, i))) { throw new FormatException("Format specifier was invalid."); }
            made = made * 10 + (Sys.GetChar(format, i) - 48);
        }
        return made;
    }

    /// THOUSANDS SEPARATED BY COMMAS, counting from the right -- which is what
    /// "N" means on an invariant culture, and this machine has only that one.
    private static string Group(string digits) {
        StringBuilder made = new StringBuilder();
        int n = digits.Length;

        for (int i = 0; i < n; i++) {
            if (i > 0 && (n - i) % 3 == 0) { made.Append(','); }
            made.Append(Sys.GetChar(digits, i));
        }
        return made.ToString();
    }

    /// `value`, as `format` says, where `bits` is how wide the type is: it
    /// decides what a negative number looks like in hexadecimal and binary,
    /// where .NET shows the two's complement rather than a minus sign.
    public static string Of(long value, int bits, string format) {
        if (format.Length == 0) { return String.FromInt(value); }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = Width(format);
        ulong whole = (ulong)value;
        ulong bitsOf = bits == 64 ? whole : whole & (((ulong)1 << bits) - (ulong)1);
        bool negative = value < 0;

        if (kind == 'x') { return Pad(Digits(bitsOf, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(bitsOf, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(bitsOf, 2, Lower), width); }

        // The size as an unsigned number, which long.MinValue has and its
        // own negation does not.
        ulong size = negative ? (ulong)0 - whole : whole;
        return Standard(kind, width, negative, String.FromUInt(size));
    }

    /// The UNSIGNED form, which cannot simply widen to long: a ulong above
    /// long.MaxValue would come out negative and print a minus sign.
    public static string OfUnsigned(ulong value, string format) {
        if (format.Length == 0) { return Digits(value, 10, Lower); }
        if (PictureFormat.Is(format)) { return PictureFormat.OfUnsigned(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = Width(format);

        if (kind == 'x') { return Pad(Digits(value, 16, Lower), width); }
        if (kind == 'X') { return Pad(Digits(value, 16, Upper), width); }
        if (kind == 'b' || kind == 'B') { return Pad(Digits(value, 2, Lower), width); }
        return Standard(kind, width, false, String.FromUInt(value));
    }

    /// THE DECIMAL SHAPES OF A WHOLE NUMBER, signed or not: `plain` is its
    /// size in digits and `negative` its sign. "D" pads with zeros to the
    /// width; "F", "N", "C" and "P" have a fraction of noughts to write and
    /// nothing to round, since a whole number times a hundred is still one;
    /// "E", and "G" and "R" with a precision, round the digits themselves --
    /// never a double made of them, which would lose a long's last three --
    /// half away from zero, as .NET rounds the digits of every integer.
    static string Standard(char kind, int width, bool negative, string plain) {
        // "G" and "R" without a precision are "D" without one: every digit.
        bool general = kind == 'g' || kind == 'G' || kind == 'r' || kind == 'R';
        if (kind == 'd' || kind == 'D' || (general && width < 1)) {
            return negative ? String.Concat("-", Pad(plain, width)) : Pad(plain, width);
        }

        if (kind == 'f' || kind == 'F' || kind == 'n' || kind == 'N' || kind == 'c' || kind == 'C') {
            return Dress(kind, negative, plain, String.Repeat('0', width < 0 ? 2 : width));
        }

        if (kind == 'p' || kind == 'P') {
            string hundreds = plain == "0" ? plain : String.Concat(plain, "00");
            return Dress(kind, negative, hundreds, String.Repeat('0', width < 0 ? 2 : width));
        }

        // Nought has no digits at all, as .NET keeps it: its exponent is 0
        // and every place it is asked for is a zero.
        string digits = plain == "0" ? "" : plain;
        int point = digits.Length;

        if (kind == 'e' || kind == 'E') {
            int places = width < 0 ? 6 : width;
            digits = Round(digits, places + 1, ref point);
            return Scientific(negative, digits, digits.Length == 0 ? 0 : point - 1, places, kind);
        }

        if (general) {
            if (digits.Length == 0) { return "0"; }
            digits = Round(digits, width, ref point);
            return DoubleFormat.Layout(digits, point, negative, width, kind == 'g' || kind == 'r' ? 'e' : 'E');
        }

        throw new FormatException("Format specifier was invalid.");
    }

    /// .NET'S RoundNumber, ON THE DIGITS THEMSELVES: DIGITS are 0.DIGITS x
    /// 10^point, and the first `count` of them are kept, the next one
    /// rounding them half away from zero -- a carry out of the first digit
    /// moves the point up one. Trailing zeros are dropped from what is
    /// kept, so a caller pads to the places it writes, and when nothing is
    /// left the number is nought and its point is 0. A count below nought
    /// keeps nothing, and a count of nought keeps one unit of the next place
    /// up when the first digit is five or more.
    public static string Round(string digits, int count, ref int point) {
        string made;
        if (count >= 0 && count < digits.Length && Sys.GetChar(digits, count) >= (int)'5') {
            int at = count - 1;
            while (at >= 0 && Sys.GetChar(digits, at) == (int)'9') { at = at - 1; }
            if (at < 0) {
                made = "1";
                point = point + 1;
            } else {
                char up = (char)(Sys.GetChar(digits, at) + 1);
                made = String.Concat(String.Substring(digits, 0, at), String.FromChar(up));
            }
        } else {
            int end = count < 0 ? 0 : (count < digits.Length ? count : digits.Length);
            while (end > 0 && Sys.GetChar(digits, end - 1) == (int)'0') { end = end - 1; }
            made = String.Substring(digits, 0, end);
        }
        if (made.Length == 0) { point = 0; }
        return made;
    }

    /// A FIXED-POINT NUMBER IN THE DRESS ITS LETTER GIVES IT, on the
    /// invariant culture: "F" plain, "N" with its thousands grouped, "C" with
    /// the currency sign and a negative in parentheses -- (¤7.00) -- and "P"
    /// with a space and the percent sign after it. `units` and `fraction`
    /// are the digits either side of the point, the sign already taken off.
    public static string Dress(char kind, bool negative, string units, string fraction) {
        bool plain = kind == 'f' || kind == 'F';
        StringBuilder made = new StringBuilder();

        bool currency = kind == 'c' || kind == 'C';
        if (negative) { made.Append(currency ? '(' : '-'); }
        if (currency) { made.Append('¤'); }
        made.Append(plain ? units : Group(units));
        if (fraction.Length > 0) {
            made.Append('.');
            made.Append(fraction);
        }
        if (kind == 'p' || kind == 'P') { made.Append(" %"); }
        if (currency && negative) { made.Append(')'); }
        return made.ToString();
    }

    /// `d.ddd` and the exponent, which is "E" in full: `places` digits after
    /// the point (none and no point at all for "E0"), the digits padded with
    /// zeros past their end, and an exponent with its sign always written and
    /// at least three digits -- 4.20E+001.
    public static string Scientific(bool negative, string digits, int exponent, int places, char letter) {
        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }
        made.Append(digits.Length > 0 ? Sys.GetChar(digits, 0) : '0');
        if (places > 0) {
            made.Append('.');
            for (int i = 1; i <= places; i++) { made.Append(i < digits.Length ? Sys.GetChar(digits, i) : '0'); }
        }
        Exponent(made, letter, exponent, 3, true);
        return made.ToString();
    }

    /// AN EXPONENT AS .NET WRITES ONE, in every shape that has one: the
    /// letter, a minus when it is negative and a plus only when `plus` asks
    /// for it, and at least `least` digits.
    public static void Exponent(StringBuilder made, char letter, int exponent, int least, bool plus) {
        made.Append(letter);
        if (exponent < 0) {
            made.Append('-');
        } else if (plus) {
            made.Append('+');
        }
        made.Append(String.PadLeft(String.FromInt(exponent < 0 ? -exponent : exponent), least, '0'));
    }

    private static string Pad(string s, int width) {
        if (width <= s.Length) { return s; }
        return String.Concat(String.Repeat('0', width - s.Length), s);
    }
}

// A REAL NUMBER AS TEXT, which this library could not do at all: a double
// could be computed, stored and compared, and the only way to look at one was
// to scale it to a long and print that. Every test of the maths above does
// exactly that, and every one of them is checking a number it cannot read.
//
// WHAT IS HERE. Every standard letter a double has on the invariant culture:
// "F", "N", "C" and "P" round the exact decimal expansion at a place, "E" and
// "G" with a precision at a count of significant digits, and "R", "G" and the
// default write the SHORTEST digits that read back as the same double, which
// is what .NET has answered since Core 3.0 (FloatDecimal, below).
static class DoubleFormat {
    /// NOT A NUMBER IS NOT EQUAL TO ITSELF, which is the only test for it that
    /// does not need a bit pattern.
    public static bool IsNaN(double x) { return x != x; }

    public static bool IsInfinity(double x) {
        return x > 1.7976931348623157e308 || x < -1.7976931348623157e308;
    }

    /// The sign bit, which -0.0 has and .NET prints: "-0".
    static bool Negative(double x) { return BitConverter.DoubleToInt64Bits(x) < 0; }

    private static string? Special(double x) {
        if (IsNaN(x)) { return "NaN"; }
        if (x > 0.0 && IsInfinity(x)) { return "Infinity"; }
        if (x < 0.0 && IsInfinity(x)) { return "-Infinity"; }
        return null;
    }

    /// `places` digits after the point, from the value's exact decimal
    /// expansion, an exact tie rounded to even -- and the sign is kept even
    /// when every digit rounds to nought, because that is what .NET prints.
    public static string Fixed(double value, int places) {
        string? special = Special(value);
        if (special != null) { return special; }

        bool negative = Negative(value);
        string digits = "";
        int point = 0;
        if (value != 0.0) {
            int lead;
            FloatDecimal.Digits(value, 1, false, out lead);
            int wanted = lead + places;
            if (wanted > 0) {
                digits = FloatDecimal.Digits(value, wanted, true, out point);
            } else if (wanted == 0) {
                // Below the last place: it rounds to one unit of it or none.
                digits = FloatDecimal.Digits(value, 0, true, out point);
            }
        }

        return Compose(digits, point, negative, places);
    }

    /// 0.DIGITS x 10^point written with `places` after the point, what the
    /// digits do not reach being zeros.
    public static string Compose(string digits, int point, bool negative, int places) {
        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }
        if (point <= 0) {
            made.Append('0');
        } else {
            for (int i = 0; i < point; i++) { made.Append(i < digits.Length ? Sys.GetChar(digits, i) : '0'); }
        }
        if (places > 0) {
            made.Append('.');
            for (int i = 0; i < places; i++) {
                int at = point + i;
                made.Append(at >= 0 && at < digits.Length ? Sys.GetChar(digits, at) : '0');
            }
        }
        return made.ToString();
    }

    /// `count` significant digits of |x|, exactly rounded, and its decimal
    /// exponent: x = d.ddd x 10^exponent.
    private static string Significant(double x, int count, out int exponent) {
        if (x == 0.0) {
            exponent = 0;
            return String.Repeat('0', count);
        }
        int point;
        string digits = FloatDecimal.Digits(x, count, true, out point);
        exponent = point - 1;
        return digits;
    }

    private static string TrimZeros(string s) {
        int end = s.Length;
        while (end > 1 && Sys.GetChar(s, end - 1) == 48) { end = end - 1; }
        return String.Substring(s, 0, end);
    }

    /// `d.dddE+eee`, with .NET's three-digit exponent and its default of six
    /// places after the point.
    public static string Scientific(double value, int places, char letter) {
        string? special = Special(value);
        if (special != null) { return special; }

        int exponent = 0;
        string digits = Significant(value, places + 1, out exponent);
        return NumberFormat.Scientific(Negative(value), digits, exponent, places, letter);
    }

    /// .NET's "G" with a precision: that many significant digits, exactly
    /// rounded, trailing zeros dropped.
    public static string General(double value, int significant, char letter) {
        string? special = Special(value);
        if (special != null) { return special; }
        if (value == 0.0) { return Negative(value) ? "-0" : "0"; }

        int exponent = 0;
        string digits = TrimZeros(Significant(value, significant, out exponent));
        return Layout(digits, exponent + 1, Negative(value), significant, letter);
    }

    /// What ToString(), "G" and "R" answer since .NET Core 3.0: the shortest
    /// digits that read back as the same double, written plainly unless the
    /// point is further out than 17 digits (or the digits' own count).
    public static string Shortest(double value) { return Shortest(value, 'E'); }

    public static string Shortest(double value, char letter) {
        string? special = Special(value);
        if (special != null) { return special; }
        if (value == 0.0) { return Negative(value) ? "-0" : "0"; }
        int point;
        string digits = FloatDecimal.Shortest(value, out point);
        return Layout(digits, point, Negative(value), digits.Length > 17 ? digits.Length : 17, letter);
    }

    /// The same for a float, whose round trip is to a float: nine digits.
    public static string ShortestSingle(float value) { return ShortestSingle(value, 'E'); }

    public static string ShortestSingle(float value, char letter) {
        double wide = (double)value;
        string? special = Special(wide);
        if (special != null) { return special; }
        if (wide == 0.0) { return Negative(wide) ? "-0" : "0"; }
        int point;
        string digits = FloatDecimal.ShortestSingle(value, out point);
        return Layout(digits, point, Negative(wide), digits.Length > 9 ? digits.Length : 9, letter);
    }

    /// 0.DIGITS x 10^point in .NET's general shape: plain digits while the
    /// point is within `most` digits and not four places below the units,
    /// d.dddE+xx otherwise -- d.ddde+xx for a "g" or "r", whose case the
    /// exponent's letter takes.
    public static string Layout(string digits, int point, bool negative, int most, char letter) {
        StringBuilder made = new StringBuilder();
        if (negative) { made.Append('-'); }

        if (point > most || point < -3) {
            int exponent = point - 1;
            made.Append(Sys.GetChar(digits, 0));
            if (digits.Length > 1) {
                made.Append('.');
                made.Append(String.Substring(digits, 1, digits.Length - 1));
            }
            NumberFormat.Exponent(made, letter, exponent, 2, true);
            return made.ToString();
        }

        if (point <= 0) {
            made.Append("0.");
            made.Append(String.Repeat('0', -point));
            made.Append(digits);
            return made.ToString();
        }

        if (digits.Length <= point) {
            made.Append(digits);
            made.Append(String.Repeat('0', point - digits.Length));
            return made.ToString();
        }

        made.Append(String.Substring(digits, 0, point));
        made.Append('.');
        made.Append(String.Substring(digits, point, digits.Length - point));
        return made.ToString();
    }

    /// A float's standard format: the shortest float digits for "", "G",
    /// "G0" and "R" -- whatever precision an "R" names, which .NET ignores,
    /// so 1.1f in "R5" is 1.1 -- and the double's exact answer, the same
    /// value, for the rest. A picture reads a float to seven digits, not a
    /// double's fifteen, so 16777216f in "0.00" is 16777220.00 as .NET
    /// writes it.
    public static string OfSingle(float value, string format) {
        if (format.Length == 0) { return ShortestSingle(value, 'E'); }
        if (PictureFormat.Is(format)) {
            return Special((double)value) == null ? PictureFormat.OfSingle(value, format) : Of((double)value, format);
        }

        char kind = Sys.GetChar(format, 0);
        bool shortest = kind == 'r' || kind == 'R';
        if (kind == 'g' || kind == 'G') {
            shortest = true;
            for (int i = 1; i < format.Length; i++) {
                if (Sys.GetChar(format, i) != (int)'0') { shortest = false; }
            }
        }
        if (shortest) { return ShortestSingle(value, kind == 'g' || kind == 'r' ? 'e' : 'E'); }
        return Of((double)value, format);
    }

    public static string Of(double value, string format) {
        if (format.Length == 0) { return Shortest(value); }

        // NOT A NUMBER AND THE INFINITIES ARE WORDS whatever the format says:
        // .NET answers them before it reads the format at all, so even "X",
        // which no double may have, gives "NaN".
        string? special = Special(value);
        if (special != null) { return special; }
        if (PictureFormat.Is(format)) { return PictureFormat.Of(value, format); }

        char kind = Sys.GetChar(format, 0);
        int width = -1;

        if (format.Length > 1) {
            width = 0;
            for (int i = 1; i < format.Length; i++) {
                if (!Char.IsDigit(Sys.GetChar(format, i))) { throw new FormatException("Format specifier was invalid."); }
                width = width * 10 + (Sys.GetChar(format, i) - 48);
            }
        }

        if (kind == 'f' || kind == 'F') { return Fixed(value, width < 0 ? 2 : width); }
        if (kind == 'e') { return Scientific(value, width < 0 ? 6 : width, 'e'); }
        if (kind == 'E') { return Scientific(value, width < 0 ? 6 : width, 'E'); }
        // The exponent of "g" and "r" is written "e+", of "G" and "R" "E+".
        char letter = kind == 'g' || kind == 'r' ? 'e' : 'E';
        if (kind == 'g' || kind == 'G') { return width <= 0 ? Shortest(value, letter) : General(value, width, letter); }
        if (kind == 'r' || kind == 'R') { return Shortest(value, letter); }
        if (kind == 'n' || kind == 'N' || kind == 'c' || kind == 'C') {
            return Dressed(kind, Fixed(value, width < 0 ? 2 : width), 0);
        }
        if (kind == 'p' || kind == 'P') {
            return Dressed(kind, Fixed(value, (width < 0 ? 2 : width) + 2), 2);
        }
        throw new FormatException("Format specifier was invalid.");
    }

    /// "N", "C" AND "P" ARE "F" IN OTHER CLOTHES: `body` is what Fixed wrote,
    /// and `shift` moves its point that many places to the right. That is
    /// how "P" multiplies by a hundred: Fixed took the exact digits two
    /// places further out, and moving the point is exact where a product of
    /// doubles rounds once more -- 0.005 is a little above it, so "P0" is
    /// 1 %, but 0.005 * 100.0 is exactly 0.5 and would round to 0 %.
    /// The sign stays even when every digit rounded to nought, as .NET keeps
    /// it: -0.256 in "C0" is (¤0).
    static string Dressed(char kind, string body, int shift) {
        bool negative = Sys.GetChar(body, 0) == (int)'-';
        if (negative) { body = String.Substring(body, 1, body.Length - 1); }

        int point = String.IndexOf(body, '.');
        string digits = point < 0 ? body : String.Concat(String.Substring(body, 0, point),
                                                          String.Substring(body, point + 1, body.Length - point - 1));
        int at = (point < 0 ? body.Length : point) + shift;

        // The noughts the shift brought in front, all but the units.
        int first = 0;
        while (first < at - 1 && Sys.GetChar(digits, first) == (int)'0') { first = first + 1; }
        return NumberFormat.Dress(kind, negative, String.Substring(digits, first, at - first),
                                  String.Substring(digits, at, digits.Length - at));
    }
}

// ---- binary floating point to decimal and back, exactly -------------------
//
// .NET Core 3.0 made double and float formatting and parsing IEEE-correct:
// ToString() answers the SHORTEST digits that read back to the same value,
// "G17", "F2" and "E6" round the value's exact decimal expansion, and Parse
// rounds what it reads to the nearest value, ties to even. Both directions
// are done here with exact integer arithmetic, an exact tie always going to
// the even digit, on the value as f x 2^e:
// Burger and Dybvig's free-format algorithm for the shortest digits, the
// same scaling with a fixed count for the rest, and a quotient of two exact
// integers rounded once for parsing.

/// A nonnegative integer of any size: 32-bit limbs, least significant
/// first, `count` of them in use. Only what FloatDecimal needs.
sealed class FloatBig {
    long[] limbs;
    int count;

    public FloatBig(long value) {
        limbs = new long[8];
        count = 0;
        while (value != 0) {
            Push(value & 0xFFFFFFFFL);
            value = value >> 32;
        }
    }

    FloatBig(long[] with, int used) {
        limbs = with;
        count = used;
    }

    public FloatBig Copy() {
        long[] made = new long[limbs.Length];
        for (int i = 0; i < count; i++) { made[i] = limbs[i]; }
        return new FloatBig(made, count);
    }

    public bool IsZero => count == 0;

    // THE LIMBS ARE THIS NUMBER'S ALONE -- Copy makes new ones, and nothing
    // hands the array out -- so the array they outgrow is given back after
    // the store that replaces it (OutgrownStorage, the self-replacing free).
    void Push(long limb) {
        if (count == limbs.Length) {
            long[] grown = new long[limbs.Length * 2];
            for (int i = 0; i < count; i++) { grown[i] = limbs[i]; }
            long[] outgrown = limbs;
            limbs = grown;
            OutgrownStorage.Release(outgrown);
        }
        limbs[count] = limb;
        count = count + 1;
    }

    void Trim() {
        while (count > 0 && limbs[count - 1] == 0) { count = count - 1; }
    }

    /// this *= m, for 0 <= m < 2^31.
    public void MulSmall(long m) {
        long carry = 0;
        for (int i = 0; i < count; i++) {
            long t = limbs[i] * m + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
        }
        if (carry != 0) { Push(carry); }
        if (m == 0) { count = 0; }
    }

    /// this += a, for 0 <= a < 2^31.
    public void AddSmall(long a) {
        long carry = a;
        for (int i = 0; i < count && carry != 0; i++) {
            long t = limbs[i] + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
        }
        if (carry != 0) { Push(carry); }
    }

    public void MulPow10(int n) {
        while (n >= 9) {
            MulSmall(1000000000);
            n = n - 9;
        }
        long p = 1;
        while (n > 0) {
            p = p * 10;
            n = n - 1;
        }
        if (p != 1) { MulSmall(p); }
    }

    public void ShiftLeft(int bits) {
        if (count == 0 || bits == 0) { return; }
        int whole = bits / 32;
        int part = bits % 32;
        long[] made = new long[count + whole + 2];
        for (int i = 0; i < count; i++) {
            long v = limbs[i] << part;
            made[i + whole] = made[i + whole] | (v & 0xFFFFFFFFL);
            made[i + whole + 1] = made[i + whole + 1] | ((v >> 32) & 0xFFFFFFFFL);
        }
        long[] outgrown = limbs;
        limbs = made;
        OutgrownStorage.Release(outgrown);
        count = count + whole + 2;
        Trim();
    }

    public int BitLength() {
        if (count == 0) { return 0; }
        long top = limbs[count - 1];
        int bits = 0;
        while (top != 0) {
            bits = bits + 1;
            top = top >> 1;
        }
        return (count - 1) * 32 + bits;
    }

    public bool Bit(int n) {
        if (n < 0) { return false; }
        int word = n / 32;
        if (word >= count) { return false; }
        return ((limbs[word] >> (n % 32)) & 1) != 0;
    }

    /// Whether any of bits [0, n) is set.
    public bool AnyBelow(int n) {
        int words = n / 32;
        for (int i = 0; i < words && i < count; i++) {
            if (limbs[i] != 0) { return true; }
        }
        if (words < count && n % 32 != 0) {
            return (limbs[words] & ((1L << (n % 32)) - 1)) != 0;
        }
        return false;
    }

    /// Bits [from, from + take) as a number, take <= 62.
    public long Bits(int from, int take) {
        long made = 0;
        for (int b = take - 1; b >= 0; b--) {
            made = (made << 1) | (Bit(from + b) ? 1L : 0L);
        }
        return made;
    }

    public static int Compare(FloatBig a, FloatBig b) {
        if (a.count != b.count) { return a.count < b.count ? -1 : 1; }
        for (int i = a.count - 1; i >= 0; i--) {
            if (a.limbs[i] != b.limbs[i]) { return a.limbs[i] < b.limbs[i] ? -1 : 1; }
        }
        return 0;
    }

    /// this += b.
    public void Add(FloatBig b) {
        long carry = 0;
        int i = 0;
        while (i < b.count || carry != 0) {
            if (i == count) { Push(0); }
            long t = limbs[i] + (i < b.count ? b.limbs[i] : 0) + carry;
            limbs[i] = t & 0xFFFFFFFFL;
            carry = t >> 32;
            i = i + 1;
        }
    }

    /// this -= b, for b <= this.
    public void Subtract(FloatBig b) {
        long borrow = 0;
        for (int i = 0; i < count; i++) {
            long t = limbs[i] - (i < b.count ? b.limbs[i] : 0) - borrow;
            borrow = t < 0 ? 1 : 0;
            limbs[i] = t & 0xFFFFFFFFL;
        }
        Trim();
    }

    public static FloatBig Sum(FloatBig a, FloatBig b) {
        FloatBig made = a.Copy();
        made.Add(b);
        return made;
    }

    /// this = this * 10 mod s, answering the quotient, which is below 10
    /// while this is below s.
    public int NextDigit(FloatBig s) {
        MulSmall(10);
        int d = 0;
        while (Compare(this, s) >= 0) {
            Subtract(s);
            d = d + 1;
        }
        return d;
    }
}

static class FloatDecimal {
    /// A double as f x 2^e, and whether the gap below it is half the gap
    /// above (the smallest mantissa of an exponent that is not the least).
    static long Parts(double value, out int e, out bool unequal) {
        long bits = BitConverter.DoubleToInt64Bits(value) & 0x7FFFFFFFFFFFFFFFL;
        int biased = (int)(bits >> 52);
        long fraction = bits & 0xFFFFFFFFFFFFFL;
        unequal = fraction == 0 && biased > 1;
        if (biased == 0) {
            e = -1074;
            return fraction;
        }
        e = biased - 1075;
        return fraction | 0x10000000000000L;
    }

    static long SingleParts(float value, out int e, out bool unequal) {
        int bits = BitConverter.SingleToInt32Bits(value) & 0x7FFFFFFF;
        int biased = bits >> 23;
        long fraction = bits & 0x7FFFFF;
        unequal = fraction == 0 && biased > 1;
        if (biased == 0) {
            e = -149;
            return fraction;
        }
        e = biased - 150;
        return fraction | 0x800000L;
    }

    static FloatBig Pow2(int n) {
        FloatBig made = new FloatBig(1);
        made.ShiftLeft(n);
        return made;
    }

    /// k with 10^(k-1) <= f x 2^e < 10^k, give or take one: the scaling loops
    /// settle it exactly.
    static int Estimate(long f, int e) {
        int bits = 0;
        long top = f;
        while (top != 0) {
            bits = bits + 1;
            top = top >> 1;
        }
        double log = (double)(e + bits - 1) * 0.30102999566398114;
        int k = (int)log;
        if ((double)k < log) { k = k + 1; }
        return k;
    }

    /// The shortest digits that read back as |value|, and `point`, the power
    /// of ten they are the fraction of: value = 0.DIGITS x 10^point.
    public static string Shortest(double value, out int point) {
        int e;
        bool unequal;
        long f = Parts(value, out e, out unequal);
        return Free(f, e, unequal, out point);
    }

    public static string ShortestSingle(float value, out int point) {
        int e;
        bool unequal;
        long f = SingleParts(value, out e, out unequal);
        return Free(f, e, unequal, out point);
    }

    static string Free(long f, int e, bool unequal, out int point) {
        bool even = (f & 1) == 0;
        FloatBig r, s, up, down;
        if (e >= 0) {
            FloatBig be = Pow2(e);
            if (!unequal) {
                r = new FloatBig(f);
                r.ShiftLeft(e + 1);
                s = new FloatBig(2);
                up = be;
                down = be.Copy();
            } else {
                r = new FloatBig(f);
                r.ShiftLeft(e + 2);
                s = new FloatBig(4);
                up = Pow2(e + 1);
                down = be;
            }
        } else {
            if (!unequal) {
                r = new FloatBig(f);
                r.ShiftLeft(1);
                s = Pow2(1 - e);
                up = new FloatBig(1);
                down = new FloatBig(1);
            } else {
                r = new FloatBig(f);
                r.ShiftLeft(2);
                s = Pow2(2 - e);
                up = new FloatBig(2);
                down = new FloatBig(1);
            }
        }

        int k = Estimate(f, e);
        if (k >= 0) {
            s.MulPow10(k);
        } else {
            r.MulPow10(-k);
            up.MulPow10(-k);
            down.MulPow10(-k);
        }

        // Settle k: the high end of the interval must be below 1 (or at
        // it, exclusive), and at least a tenth.
        while (true) {
            int c = FloatBig.Compare(FloatBig.Sum(r, up), s);
            if (even ? c >= 0 : c > 0) {
                s.MulSmall(10);
                k = k + 1;
                continue;
            }
            FloatBig tenth = FloatBig.Sum(r, up);
            tenth.MulSmall(10);
            int t = FloatBig.Compare(tenth, s);
            if (even ? t < 0 : t <= 0) {
                r.MulSmall(10);
                up.MulSmall(10);
                down.MulSmall(10);
                k = k - 1;
                continue;
            }
            break;
        }

        StringBuilder digits = new StringBuilder();
        while (true) {
            int d = r.NextDigit(s);
            up.MulSmall(10);
            down.MulSmall(10);
            int low = FloatBig.Compare(r, down);
            int high = FloatBig.Compare(FloatBig.Sum(r, up), s);
            bool tc1 = even ? low <= 0 : low < 0;
            bool tc2 = even ? high >= 0 : high > 0;
            if (!tc1 && !tc2) {
                digits.Append((char)(48 + d));
                continue;
            }
            if (tc1 && tc2) {
                // Both digits read back: the nearer, and on a tie the even.
                FloatBig twice = r.Copy();
                twice.MulSmall(2);
                int c = FloatBig.Compare(twice, s);
                if (c > 0 || (c == 0 && (d & 1) != 0)) { d = d + 1; }
            } else if (tc2) {
                d = d + 1;
            }
            digits.Append((char)(48 + d));
            break;
        }
        point = k;
        return digits.ToString();
    }

    /// |value|'s exact decimal expansion rounded to `count` significant
    /// digits, an exact tie to the even digit as .NET does, and its point: value = 0.DIGITS x 10^point.
    /// With `round` false, the first `count` digits as they are.
    public static string Digits(double value, int count, bool round, out int point) {
        int e;
        bool unequal;
        long f = Parts(value, out e, out unequal);
        FloatBig r = new FloatBig(f);
        FloatBig s = new FloatBig(1);
        if (e >= 0) { r.ShiftLeft(e); } else { s.ShiftLeft(-e); }

        int k = Estimate(f, e);
        if (k >= 0) { s.MulPow10(k); } else { r.MulPow10(-k); }
        while (FloatBig.Compare(r, s) >= 0) {
            s.MulSmall(10);
            k = k + 1;
        }
        while (true) {
            FloatBig tenfold = r.Copy();
            tenfold.MulSmall(10);
            if (FloatBig.Compare(tenfold, s) >= 0) { break; }
            r = tenfold;
            k = k - 1;
        }

        char[] made = new char[count];
        for (int i = 0; i < count; i++) { made[i] = (char)(48 + r.NextDigit(s)); }

        if (round) {
            FloatBig twice = r.Copy();
            twice.MulSmall(2);
            int c = FloatBig.Compare(twice, s);
            // No digits asked for: it is one unit of the next place or none.
            if (count == 0) {
                point = k + 1;
                return c > 0 ? "1" : "";
            }
            if (c > 0 || (c == 0 && ((made[count - 1] - '0') & 1) != 0)) {
                int at = count - 1;
                while (at >= 0) {
                    if (made[at] != '9') {
                        made[at] = (char)(made[at] + 1);
                        break;
                    }
                    made[at] = '0';
                    at = at - 1;
                }
                if (at < 0) {
                    made[0] = '1';
                    k = k + 1;
                }
            }
        }
        point = k;
        return new string(made);
    }

    /// The nearest double to DIGITS x 10^exponent (DIGITS an integer), ties to
    /// even; infinity past the largest.
    public static double ToDouble(FloatBig digits, int exponent) {
        return BitConverter.Int64BitsToDouble(Nearest(digits, exponent, 53, -1022, 1023));
    }

    public static float ToSingle(FloatBig digits, int exponent) {
        return BitConverter.Int32BitsToSingle((int)Nearest(digits, exponent, 24, -126, 127));
    }

    /// The bits of the nearest value of a binary format with `precision`
    /// mantissa bits (the hidden one included) and exponents [minExp, maxExp].
    static long Nearest(FloatBig digits, int exponent, int precision, int minExp, int maxExp) {
        long infinity = (long)(maxExp + maxExp + 1) << (precision - 1);
        if (digits.IsZero) { return 0; }
        int length = digits.BitLength();
        // Far outside the range, in either direction, before any big power
        // of ten is made.
        int decimalDigits = (int)((double)length * 0.30102999566398114) + 1;
        if (exponent + decimalDigits > 330 + precision / 8) { return infinity; }
        if (exponent + decimalDigits < -360) { return 0; }

        FloatBig m;
        int e2;
        bool sticky = false;
        if (exponent >= 0) {
            m = digits.Copy();
            m.MulPow10(exponent);
            e2 = 0;
        } else {
            // m = digits / 10^-exponent, with enough bits that one rounding
            // is exact: the remainder only says whether anything is left.
            FloatBig divisor = new FloatBig(1);
            divisor.MulPow10(-exponent);
            // Enough bits in the quotient for one exact rounding, and no more
            // than a long holds: the dividend is shifted up, or the divisor
            // is, whichever makes the quotient about precision + 3 bits.
            int shift = precision + 3 + divisor.BitLength() - length;
            FloatBig rest = digits.Copy();
            if (shift >= 0) { rest.ShiftLeft(shift); } else { divisor.ShiftLeft(-shift); }
            int qbits = rest.BitLength() - divisor.BitLength() + 1;
            long q = 0;
            for (int i = qbits; i >= 0; i--) {
                FloatBig part = divisor.Copy();
                part.ShiftLeft(i);
                if (FloatBig.Compare(part, rest) <= 0) {
                    rest.Subtract(part);
                    q = q | (1L << i);
                }
            }
            sticky = !rest.IsZero;
            m = new FloatBig(q);
            e2 = -shift;
        }

        length = m.BitLength();
        int top = length - 1 + e2;
        if (top > maxExp) { return infinity; }
        int keep = precision;
        if (top < minExp) { keep = precision - (minExp - top); }
        int drop = length - keep;
        long mantissa;
        if (drop <= 0) {
            mantissa = m.Bits(0, length) << (-drop);
        } else {
            mantissa = keep > 0 ? m.Bits(drop, keep) : 0;
            bool half = m.Bit(drop - 1);
            bool below = sticky || m.AnyBelow(drop - 1);
            if (half && (below || (mantissa & 1) != 0)) { mantissa = mantissa + 1; }
        }
        int scale = e2 + drop;
        if (mantissa == (1L << precision)) {
            mantissa = mantissa >> 1;
            scale = scale + 1;
        }
        if (mantissa >= (1L << (precision - 1))) {
            long biased = scale + (precision - 1) + maxExp;
            if (biased >= maxExp + maxExp + 1) { return infinity; }
            return (biased << (precision - 1)) | (mantissa & ((1L << (precision - 1)) - 1));
        }
        return mantissa;
    }
}

// ---- a picture of a number ------------------------------------------------
//
// `n.ToString("0.00")`, `total.ToString("#,##0")`, `part.ToString("0%")` --
// .NET's CUSTOM numeric format strings, which are a different grammar from the
// standard ones above: instead of a letter naming a shape, the format IS the
// shape, a digit at a time.
//
// The two placeholders are the whole of it. `0` is a digit that is always
// printed, so it pads with zeros; `#` is a digit that is printed only if the
// number has one, so it trims. Everything else in the picture is itself --
// which is what makes `0;(0);zero` print accounts' negatives in brackets and
// `0%` multiply by a hundred and write the sign.
//
// The sections are split on `;`: positive, negative and zero, in that order.
// A number that falls in a section is formatted by it WITHOUT its sign, which
// is why the negative section has to write its own minus if it wants one; one
// that rounds to nought there is written by the zero section instead. Text in
// quotes or after a backslash is text, a ';' or a '0' in it included.
static class PictureFormat {
    /// WHETHER A FORMAT IS A PICTURE at all, which is what decides between
    /// this file's two grammars. A standard format is a single letter and an
    /// optional number after it; everything else is a picture, including "000"
    /// and "#" and ".00".
    public static bool Is(string format) {
        if (format.Length == 0) { return false; }

        char kind = Sys.GetChar(format, 0);

        if (!Char.IsLetter(kind)) { return true; }

        for (int i = 1; i < format.Length; i++) {
            if (!Char.IsDigit(Sys.GetChar(format, i))) { return true; }
        }
        return false;
    }

    /// A DOUBLE IS READ TO FIFTEEN SIGNIFICANT DIGITS for a picture, and a
    /// float to seven, which is not its exact value: those digits are what is
    /// rounded, half away from zero at the last place asked for -- 1.25 to
    /// "0.0" is 1.3, where "F1" says 1.2. Minus nought keeps its sign, as
    /// .NET keeps it: (-0.0).ToString("0.00") is -0.00.
    public static string Of(double value, string format) { return Real(value, format, 15); }

    public static string OfSingle(float value, string format) { return Real((double)value, format, 7); }

    private static string Real(double value, string format, int precision) {
        double size = value < 0.0 ? 0.0 - value : value;
        int point = 0;
        string digits = size == 0.0 ? "" : FloatDecimal.Digits(size, precision, true, out point);

        return Written(format, BitConverter.DoubleToInt64Bits(value) < 0, true, digits, point);
    }

    /// The same for a whole number, which must not go through a double: a long
    /// above 2^53 would lose its last digits on the way. Its digits are all
    /// of it, and long.MinValue's size is taken unsigned, the one place its
    /// negation fits.
    public static string Of(long value, string format) {
        ulong size = value < 0 ? (ulong)0 - (ulong)value : (ulong)value;
        string digits = value == 0 ? "" : Decimal(size);

        return Written(format, value < 0, false, digits, digits.Length);
    }

    public static string OfUnsigned(ulong value, string format) {
        string digits = value == 0 ? "" : Decimal(value);

        return Written(format, false, false, digits, digits.Length);
    }

    /// The same for a whole number given as its decimal digits, which is all
    /// a BigInteger can give: no machine word holds one.
    public static string OfDigits(bool negative, string digits, string format) {
        bool zero = String.Compare(digits, "0") == 0;

        return Written(format, negative && !zero, false, zero ? "" : digits, zero ? 0 : digits.Length);
    }

    /// An unsigned number's digits, which String.FromInt cannot give: a ulong
    /// above long.MaxValue would come back negative.
    private static string Decimal(ulong value) {
        if (value == 0) { return "0"; }

        StringBuilder made = new StringBuilder();
        ulong left = value;

        while (left > 0) {
            made.Append((char)(48 + (int)(left % 10)));
            left = left / 10;
        }
        return Reversed(made.ToString());
    }

    /// DIGITS GATHERED LOWEST FIRST, turned the right way round: both
    /// writers here produce a number's digits from its low end.
    private static string Reversed(string s) {
        string made = Sys.NewChars(s.Length);

        for (int i = 0; i < s.Length; i++) {
            Sys.SetChar(made, i, Sys.GetChar(s, s.Length - 1 - i));
        }
        return made;
    }

    // ---- the picture, read and written ----------------------------------
    //
    // .NET's NumberToStringFormat, step for step, on the invariant culture:
    // one pass reads the section to learn its shape, the number is rounded
    // to it, and a second pass writes the section a character at a time.

    /// WHERE SECTION `which` STARTS -- 0 positive, 1 negative, 2 zero -- or
    /// 0, the first, when the format has no such section or it is empty. A
    /// ';' inside quotes or after a backslash divides nothing, and a NUL
    /// ends the format, as .NET reads it.
    private static int FindSection(string format, int which) {
        if (which == 0) { return 0; }
        int src = 0;

        while (src < format.Length) {
            char ch = Sys.GetChar(format, src);
            src = src + 1;

            if (ch == '\'' || ch == '"') {
                while (src < format.Length && Sys.GetChar(format, src) != 0) {
                    char was = Sys.GetChar(format, src);
                    src = src + 1;
                    if (was == ch) { break; }
                }
            } else if (ch == '\\') {
                if (src < format.Length && Sys.GetChar(format, src) != 0) { src = src + 1; }
            } else if (ch == ';') {
                which = which - 1;
                if (which != 0) { continue; }
                if (src < format.Length && Sys.GetChar(format, src) != 0 && Sys.GetChar(format, src) != ';') { return src; }
                return 0;
            } else if (ch == 0) {
                return 0;
            }
        }
        return 0;
    }

    /// THE PICTURE FILLED IN, from any number's digits: 0.DIGITS x 10^scale,
    /// the sign apart, nought having no digits at all. `real` says the number
    /// was a double, whose sign survives a rounding to nought (-0.4 in "0" is
    /// -0) where a whole number's does not (-4 in "0," is 0), because .NET has
    /// a minus nought for doubles only. A number that rounds to nought in its
    /// own section is written by the zero section, when there is one.
    private static string Written(string format, bool negative, bool real, string digits, int scale) {
        int section = FindSection(format, digits.Length == 0 ? 2 : negative ? 1 : 0);
        int digitCount;
        int decimalPos;
        int firstDigit;
        int lastDigit;
        int thousandPos;
        int thousandCount = 0;
        bool scientific;
        bool thousandSeps;

        while (true) {
            digitCount = 0;
            decimalPos = -1;
            firstDigit = int.MaxValue;
            lastDigit = 0;
            scientific = false;
            thousandPos = -1;
            thousandSeps = false;
            int scaleAdjust = 0;
            int src = section;

            while (src < format.Length) {
                char ch = Sys.GetChar(format, src);
                src = src + 1;
                if (ch == 0 || ch == ';') { break; }

                if (ch == '#') {
                    digitCount = digitCount + 1;
                } else if (ch == '0') {
                    if (firstDigit == int.MaxValue) { firstDigit = digitCount; }
                    digitCount = digitCount + 1;
                    lastDigit = digitCount;
                } else if (ch == '.') {
                    if (decimalPos < 0) { decimalPos = digitCount; }
                } else if (ch == ',') {
                    // A COMMA RIGHT AFTER A PLACEHOLDER, before the point: a
                    // run of them at the point scales by a thousand each, one
                    // anywhere else groups the thousands.
                    if (digitCount > 0 && decimalPos < 0) {
                        if (thousandPos >= 0) {
                            if (thousandPos == digitCount) {
                                thousandCount = thousandCount + 1;
                                continue;
                            }
                            thousandSeps = true;
                        }
                        thousandPos = digitCount;
                        thousandCount = 1;
                    }
                } else if (ch == '%') {
                    scaleAdjust = scaleAdjust + 2;
                } else if (ch == '\u2030') {
                    scaleAdjust = scaleAdjust + 3;
                } else if (ch == '\'' || ch == '"') {
                    while (src < format.Length && Sys.GetChar(format, src) != 0) {
                        char was = Sys.GetChar(format, src);
                        src = src + 1;
                        if (was == ch) { break; }
                    }
                } else if (ch == '\\') {
                    if (src < format.Length && Sys.GetChar(format, src) != 0) { src = src + 1; }
                } else if (ch == 'E' || ch == 'e') {
                    if (ExponentFollows(format, src)) {
                        src = src + 1;
                        while (src < format.Length && Sys.GetChar(format, src) == '0') { src = src + 1; }
                        scientific = true;
                    }
                }
            }

            if (decimalPos < 0) { decimalPos = digitCount; }
            if (thousandPos >= 0) {
                if (thousandPos == decimalPos) {
                    scaleAdjust = scaleAdjust - thousandCount * 3;
                } else {
                    thousandSeps = true;
                }
            }

            if (digits.Length > 0) {
                // SCALING MOVES THE POINT, which is exact where multiplying
                // is not and cannot overflow a long.
                scale = scale + scaleAdjust;
                digits = NumberFormat.Round(digits, scientific ? digitCount : scale + digitCount - decimalPos, ref scale);
                if (digits.Length == 0) {
                    if (!real) { negative = false; }
                    int zero = FindSection(format, 2);
                    if (zero != section) {
                        section = zero;
                        continue;
                    }
                }
            } else {
                if (!real) { negative = false; }
                scale = 0;
            }
            break;
        }

        firstDigit = firstDigit < decimalPos ? decimalPos - firstDigit : 0;
        lastDigit = lastDigit > decimalPos ? decimalPos - lastDigit : 0;
        int digPos;
        int adjust;
        if (scientific) {
            digPos = decimalPos;
            adjust = 0;
        } else {
            digPos = scale > decimalPos ? scale : decimalPos;
            adjust = scale - decimalPos;
        }

        // WHERE THE GROUP SEPARATORS GO, counted in digits from the point:
        // every third, as far as the whole part reaches.
        int separators = 0;
        if (thousandSeps) {
            int totalDigits = digPos + (adjust < 0 ? adjust : 0);
            int numDigits = firstDigit > totalDigits ? firstDigit : totalDigits;
            if (numDigits > 3) { separators = (numDigits - 1) / 3; }
        }

        StringBuilder made = new StringBuilder();
        if (negative && section == 0 && scale != 0) { made.Append('-'); }

        bool decimalWritten = false;
        int cur = 0;
        int at = section;

        while (at < format.Length) {
            char ch = Sys.GetChar(format, at);
            at = at + 1;
            if (ch == 0 || ch == ';') { break; }

            // DIGITS THE PICTURE HAS NO PLACE FOR go in front of its first
            // placeholder, or its point: "00" still prints a thousand.
            if (adjust > 0 && (ch == '#' || ch == '0' || ch == '.')) {
                while (adjust > 0) {
                    made.Append(cur < digits.Length ? Sys.GetChar(digits, cur) : '0');
                    if (cur < digits.Length) { cur = cur + 1; }
                    separators = Separate(made, thousandSeps, digPos, separators);
                    digPos = digPos - 1;
                    adjust = adjust - 1;
                }
            }

            if (ch == '#' || ch == '0') {
                int c;
                if (adjust < 0) {
                    adjust = adjust + 1;
                    c = digPos <= firstDigit ? '0' : 0;
                } else if (cur < digits.Length) {
                    c = Sys.GetChar(digits, cur);
                    cur = cur + 1;
                } else {
                    c = digPos > lastDigit ? '0' : 0;
                }
                if (c != 0) {
                    made.Append((char)c);
                    separators = Separate(made, thousandSeps, digPos, separators);
                }
                digPos = digPos - 1;
            } else if (ch == '.') {
                // One point at most, and only where a digit follows it or the
                // picture asks for one with a '0'.
                if (digPos != 0 || decimalWritten) { continue; }
                if (lastDigit < 0 || (decimalPos < digitCount && cur < digits.Length)) {
                    made.Append('.');
                    decimalWritten = true;
                }
            } else if (ch == '\u2030' || ch == '%') {
                made.Append(ch);
            } else if (ch == ',') {
                continue;
            } else if (ch == '\'' || ch == '"') {
                while (at < format.Length && Sys.GetChar(format, at) != 0 && Sys.GetChar(format, at) != ch) {
                    made.Append(Sys.GetChar(format, at));
                    at = at + 1;
                }
                if (at < format.Length && Sys.GetChar(format, at) != 0) { at = at + 1; }
            } else if (ch == '\\') {
                if (at < format.Length && Sys.GetChar(format, at) != 0) {
                    made.Append(Sys.GetChar(format, at));
                    at = at + 1;
                }
            } else if (ch == 'E' || ch == 'e') {
                // THE FIRST EXPONENT IS THE NUMBER'S: a '+' writes its sign
                // always, a '-' or nothing only when it is negative, and the
                // zeros are its fewest digits, ten at most. Any later one, or
                // one with no zero after it, is text.
                if (scientific) {
                    if (!ExponentFollows(format, at)) {
                        made.Append(ch);
                        continue;
                    }
                    char mark = Sys.GetChar(format, at);
                    int least = mark == '0' ? 1 : 0;
                    at = at + 1;
                    while (at < format.Length && Sys.GetChar(format, at) == '0') {
                        least = least + 1;
                        at = at + 1;
                    }
                    NumberFormat.Exponent(made, ch, digits.Length == 0 ? 0 : scale - decimalPos, least > 10 ? 10 : least, mark == '+');
                    scientific = false;
                } else {
                    made.Append(ch);
                    if (at < format.Length && (Sys.GetChar(format, at) == '+' || Sys.GetChar(format, at) == '-')) {
                        made.Append(Sys.GetChar(format, at));
                        at = at + 1;
                    }
                    while (at < format.Length && Sys.GetChar(format, at) == '0') {
                        made.Append('0');
                        at = at + 1;
                    }
                }
            } else {
                made.Append(ch);
            }
        }

        // A MINUS ONLY IN FRONT OF SOMETHING when the number is below one:
        // -0.2 in "#" is nothing at all, not a lone sign, where in "0" it
        // is -0.
        if (negative && section == 0 && scale == 0 && made.Length > 0) { made.Insert(0, '-'); }
        return made.ToString();
    }

    /// Whether an 'E' or 'e' whose next character is at `at` starts an
    /// exponent: a '0' next, or a '+' or '-' and then a '0'.
    private static bool ExponentFollows(string format, int at) {
        if (at < format.Length && Sys.GetChar(format, at) == '0') { return true; }
        return at + 1 < format.Length && (Sys.GetChar(format, at) == '+' || Sys.GetChar(format, at) == '-')
            && Sys.GetChar(format, at + 1) == '0';
    }

    /// A GROUP SEPARATOR AFTER THE DIGIT JUST WRITTEN when the digits left
    /// to the point are a whole number of groups: `left` separators remain,
    /// the next one after digit 3 x left + 1 counting down to the point.
    /// Answers how many remain.
    private static int Separate(StringBuilder made, bool grouping, int digPos, int left) {
        if (grouping && digPos > 1 && left > 0 && digPos == 3 * left + 1) {
            made.Append(',');
            return left - 1;
        }
        return left;
    }
}

// TEXT IN SOME BASE, ONCE, for every integral type to share. Each of them had
// its own copy of this loop or, more often, did not have one at all: hex was
// reachable through Convert.ToInt32(s, 16) and nowhere else, so
// `int.TryParse(s, NumberStyles.HexNumber, null, out n)` -- the form a program
// that reads a configuration file writes -- did not compile.
static class NumberParse {
    /// WHAT .NET SAYS WHEN TEXT IS NOT A NUMBER, quoting the text: a message
    /// that names the offending string is the difference between a bug report
    /// and a guess. Parse throws it; TryParse is the same work with the throw
    /// turned into a false.
    public static FormatException Bad(string s) {
        if (s == null) { throw new ArgumentNullException("s"); }
        return new FormatException(String.Concat("The input string '",
                                   String.Concat(s, "' was not in a correct format.")));
    }

    /// The other refusal: the digits were digits and there were too many of
    /// them for the type asked for.
    public static OverflowException TooBig(string what) {
        return new OverflowException(String.Concat("Value was either too large or too small for an ",
                                     String.Concat(what, ".")));
    }

    /// A DIGIT'S VALUE IN ANY BASE UP TO 36, or -1. Letters count from ten in
    /// either case, which is what every base above ten means by them.
    public static int DigitOf(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 122) { return c - 97 + 10; }
        if (c >= 65 && c <= 90) { return c - 65 + 10; }
        return -1;
    }

    /// FALSE ON OVERFLOW AS WELL AS ON RUBBISH, which is .NET's contract for
    /// TryParse and the reason the running value is checked rather than the
    /// result: once it has wrapped there is nothing left to notice.
    public static bool TryUnsigned(string s, int radix, out ulong value) {
        value = 0;
        if (s.Length == 0) { return false; }

        ulong made = 0;
        for (int i = 0; i < s.Length; i++) {
            int digit = DigitOf(Sys.GetChar(s, i));
            if (digit < 0 || digit >= radix) { return false; }

            ulong next = made * (ulong)radix + (ulong)digit;
            if (next < made) { return false; }
            made = next;
        }
        value = made;
        return true;
    }

    /// A SIGN IS DECIMAL ONLY: .NET's HexNumber style rejects one outright,
    /// because a hexadecimal literal already says its sign in its top bit.
    ///
    /// `bits` is the width of the type being parsed into, which decides both
    /// the range a decimal number may occupy and -- for hexadecimal -- where
    /// the sign bit is.
    public static bool TrySigned(string s, int radix, int bits, out long value) {
        value = 0;
        if (s.Length == 0) { return false; }

        bool negative = false;
        int at = 0;

        if (radix == 10 && (s[0] == '-' || s[0] == '+')) {
            negative = s[0] == '-';
            at = 1;
        }
        if (at >= s.Length) { return false; }

        ulong made = 0;
        if (!TryUnsigned(String.Substring(s, at, s.Length - at), radix, out made)) { return false; }

        // HEXADECIMAL IS A BIT PATTERN, not a magnitude: "FFFFFFFF" parsed as
        // an int is -1 in .NET, so the digits are read as the two's complement
        // of the type's width rather than rejected as a number too large.
        if (radix != 10) {
            if (bits == 64) {
                value = (long)made;
                return true;
            }

            ulong span = (ulong)1 << bits;
            if (made >= span) { return false; }

            ulong sign = (ulong)1 << (bits - 1);
            value = made >= sign ? (long)made - (long)span : (long)made;
            return true;
        }

        long high = bits == 64 ? long.MaxValue : ((long)1 << (bits - 1)) - 1;
        long low = -high - 1;

        if (negative) {
            // The most negative value of every width has no positive twin, so
            // it is recognised by its magnitude before the negation that would
            // overflow.
            if (made == (ulong)high + (ulong)1) {
                value = low;
                return true;
            }
            if (made > (ulong)high) { return false; }
            value = -(long)made;
            return true;
        }

        if (made > (ulong)high) { return false; }
        value = (long)made;
        return true;
    }
}

// ---- reading a number, as .NET reads one ------------------------------------
//
// EVERY Parse AND TryParse OF A NUMBER COMES HERE: the eight integers, float
// and double, and Convert's text overloads through them. What it accepts and
// how it refuses are .NET's System.Number under the invariant culture, step
// for step, because a program's input is whatever its users typed and the
// answer has to be the one the same program gives on .NET.
//
// THE STYLE SAYS WHAT MAY SURROUND THE DIGITS. NumberStyles.Integer is white
// space either side and a leading sign; Float adds a decimal point and an
// exponent; AllowThousands lets ',' separate groups before the point;
// AllowParentheses makes "(5)" negative; AllowTrailingSign takes "5-";
// AllowCurrencySymbol takes the invariant culture's '¤'. White space is the
// ASCII kind: space, tab, line feed, vertical tab, form feed and carriage
// return. NUL characters after everything else are ignored, as .NET ignores
// them. A sign may not be followed by white space.
//
// THREE ROADS, as .NET has them, and each is kept because each answers some
// text differently:
//
//   - a style within Integer is read digit by digit, the overflow noted and
//     reported only once the whole text has been found well formed -- a
//     malformed number is a FormatException however many digits it has;
//   - AllowHexSpecifier and AllowBinarySpecifier read a bit pattern with no
//     sign and no "0x": "FF" is -1 as an sbyte, and more significant digits
//     than the type has bits for is an overflow;
//   - any other style collects the digits into a buffer the type's longest
//     number wide, with where the point falls, and converts that. An integer
//     read this way may carry a point or an exponent, and a fraction that is
//     not zero is an OVERFLOW, not a format error -- int.Parse("1.5",
//     NumberStyles.Float) throws OverflowException on .NET too.
//
// A FLOATING-POINT VALUE IS CORRECTLY ROUNDED, ties to even, from as many as
// 768 significant digits (113 for a float); any digit past those only says
// the value is above what was kept, which is all the rounding needs. Too
// large is infinity and too small is zero -- .NET throws no OverflowException
// for a double. "Infinity", "-Infinity" and "NaN" are read in any case, with
// white space around them, and "+Infinity", "+NaN" and "-NaN" too. The
// infinity sign is not: it is no symbol of the invariant culture.
//
// The culture asked for is not consulted: there is one on this machine, the
// invariant one, whatever the provider passed.
static class NumberRead {
    public const int Ok = 0;
    public const int Format = 1;
    public const int Overflow = 2;

    // The NumberStyles bits, as numbers: the styles are checked and read as
    // an int, which the flags enum's own operators are not needed for.
    const int LeadingWhite = 1, TrailingWhite = 2, LeadingSign = 4, TrailingSign = 8, Parentheses = 16;
    const int DecimalPoint = 32, Thousands = 64, Exponent = 128, Currency = 256, Hex = 512, Binary = 1024;
    const int Defined = 2047;

    // ---- the styles, refused as .NET refuses them -----------------------------

    /// An undefined bit, or a hex or binary specifier with anything but white
    /// space beside it, is an ArgumentException naming `style`.
    public static void CheckInteger(NumberStyles style) {
        int s = (int)style;
        if ((s & (~Defined | Hex | Binary)) != 0 && (s & ~(Hex | LeadingWhite | TrailingWhite)) != 0
            && (s & ~(Binary | LeadingWhite | TrailingWhite)) != 0) {
            if ((s & ~Defined) != 0) { throw new ArgumentException("An undefined NumberStyles value is being used.", "style"); }
            throw new ArgumentException("With the AllowHexSpecifier or AllowBinarySpecifier bit set in the enum bit field, the only other valid bits that can be combined into the enum value must be AllowLeadingWhite and AllowTrailingWhite.", "style");
        }
    }

    /// A floating-point type takes no hex or binary specifier at all.
    public static void CheckFloat(NumberStyles style) {
        int s = (int)style;
        if ((s & (~Defined | Hex | Binary)) != 0) {
            if ((s & ~Defined) != 0) { throw new ArgumentException("An undefined NumberStyles value is being used.", "style"); }
            throw new ArgumentException("The number styles AllowHexSpecifier and AllowBinarySpecifier are not supported on floating point data types.", "style");
        }
    }

    /// .NET's refusal of text that is no number, quoting it.
    public static FormatException Bad(string s) {
        return new FormatException("The input string '" + s + "' was not in a correct format.");
    }

    /// .NET's refusal of a number too large or too small, `what` in its
    /// words: "an Int32", "a UInt64", "a signed byte".
    public static OverflowException TooBig(string what) {
        return new OverflowException("Value was either too large or too small for " + what + ".");
    }

    static bool White(char c) { return c == ' ' || (c >= (char)9 && c <= (char)13); }
    static bool Digit(char c) { return c >= '0' && c <= '9'; }

    // Whether everything from `at` on is NUL.
    static bool TrailingZeros(string s, int at) {
        for (int i = at; i < s.Length; i++) { if (s[i] != (char)0) { return false; } }
        return true;
    }

    // ---- integers --------------------------------------------------------------

    /// The integer `s` says, or the exception .NET throws: `bits` wide, signed
    /// or not, the answer as its two's-complement bits (a caller casts them to
    /// its type). The style has been checked already.
    public static ulong Integer(string s, NumberStyles style, int bits, bool signed, string what) {
        int status = ReadInteger(s, (int)style, bits, signed, out ulong value);
        if (status == Format) { throw Bad(s); }
        if (status == Overflow) { throw TooBig(what); }
        return value;
    }

    /// The same, false where Integer would throw.
    public static bool TryInteger(string s, NumberStyles style, int bits, bool signed, out ulong value) {
        if (ReadInteger(s, (int)style, bits, signed, out value) == Ok) { return true; }
        value = 0;
        return false;
    }

    static int ReadInteger(string s, int style, int bits, bool signed, out ulong value) {
        if ((style & ~(LeadingWhite | TrailingWhite | LeadingSign)) == 0) { return IntegerStyle(s, style, bits, signed, out value); }
        if ((style & Hex) != 0) { return Pattern(s, style, bits, 4, out value); }
        if ((style & Binary) != 0) { return Pattern(s, style, bits, 1, out value); }
        return IntegerNumber(s, style, bits, signed, out value);
    }

    // The largest magnitude of the type: one more below zero when signed.
    static ulong Most(int bits, bool signed, bool negative) {
        if (!signed) { return bits == 64 ? ulong.MaxValue : ((ulong)1 << bits) - (ulong)1; }
        ulong top = (ulong)1 << (bits - 1);
        return negative ? top : top - (ulong)1;
    }

    // A magnitude within the type, as its bits.
    static int Within(ulong magnitude, bool negative, int bits, bool signed, out ulong value) {
        value = 0;
        if (!signed && negative && magnitude != 0) { return Overflow; }
        if (magnitude > Most(bits, signed, negative)) { return Overflow; }
        value = negative ? (ulong)(-(long)magnitude) : magnitude;
        return Ok;
    }

    // White space, a sign, digits, white space: the whole text read before
    // an overflow is reported, so text that is malformed after its digits is
    // a format error however many of them there were.
    static int IntegerStyle(string s, int style, int bits, bool signed, out ulong value) {
        value = 0;
        int n = s.Length;
        int i = 0;
        if (n == 0) { return Format; }
        if ((style & LeadingWhite) != 0) {
            while (i < n && White(s[i])) { i++; }
            if (i == n) { return Format; }
        }
        bool negative = false;
        if ((style & LeadingSign) != 0 && (s[i] == '-' || s[i] == '+')) {
            negative = s[i] == '-';
            i++;
            if (i == n) { return Format; }
        }
        if (!Digit(s[i])) { return Format; }
        ulong magnitude = 0;
        bool over = false;
        while (i < n && Digit(s[i])) {
            ulong d = (ulong)(s[i] - '0');
            if (magnitude > (ulong.MaxValue - d) / (ulong)10) { over = true; } else { magnitude = magnitude * (ulong)10 + d; }
            i++;
        }
        if (i < n) {
            if (White(s[i])) {
                if ((style & TrailingWhite) == 0) { return Format; }
                while (i < n && White(s[i])) { i++; }
            }
            if (!TrailingZeros(s, i)) { return Format; }
        }
        if (over) { return Overflow; }
        return Within(magnitude, negative, bits, signed, out value);
    }

    // Hex or binary digits as a bit pattern of `bits` bits, `per` bits a
    // digit; leading zeros are free, and a significant digit past the width
    // is an overflow once the rest has been found well formed.
    static int Pattern(string s, int style, int bits, int per, out ulong value) {
        value = 0;
        int n = s.Length;
        int i = 0;
        if (n == 0) { return Format; }
        if ((style & LeadingWhite) != 0) {
            while (i < n && White(s[i])) { i++; }
            if (i == n) { return Format; }
        }
        if (PatternDigit(s[i], per) < 0) { return Format; }
        int most = bits / per;
        int significant = 0;
        ulong answer = 0;
        while (i < n) {
            int d = PatternDigit(s[i], per);
            if (d < 0) { break; }
            if (significant > 0 || d != 0) {
                significant++;
                if (significant <= most) { answer = (answer << per) | (ulong)d; }
            }
            i++;
        }
        if (i < n) {
            if (White(s[i])) {
                if ((style & TrailingWhite) == 0) { return Format; }
                while (i < n && White(s[i])) { i++; }
            }
            if (!TrailingZeros(s, i)) { return Format; }
        }
        if (significant > most) { return Overflow; }
        value = answer;
        return Ok;
    }

    static int PatternDigit(char c, int per) {
        if (per == 1) { return c == '0' ? 0 : c == '1' ? 1 : -1; }
        if (c >= '0' && c <= '9') { return c - '0'; }
        if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
        if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
        return -1;
    }

    // Through the digit buffer, as .NET reads every style beyond Integer: the
    // buffer holds as many digits as the type's longest number, and the
    // number is whole digits up to the point and nothing after it but zeros.
    static int IntegerNumber(string s, int style, int bits, bool signed, out ulong value) {
        value = 0;
        int width = bits == 8 ? 3 : bits == 16 ? 5 : bits == 32 ? 10 : signed ? 19 : 20;
        char[] digits = new char[width];
        if (!Scan(s, style, true, digits, out int count, out int scale, out bool negative, out bool tail)) { return Format; }
        if (scale > width || scale < count || (!signed && negative)) { return Overflow; }
        ulong magnitude = 0;
        for (int i = 0; i < scale; i++) {
            ulong d = i < count ? (ulong)(digits[i] - '0') : (ulong)0;
            if (magnitude > (ulong.MaxValue - d) / (ulong)10) { return Overflow; }
            magnitude = magnitude * (ulong)10 + d;
        }
        return Within(magnitude, negative, bits, signed, out value);
    }

    // ---- the digit buffer ------------------------------------------------------
    //
    // .NET's TryParseNumber, under the invariant culture: '+' and '-' the
    // signs, '.' the point, ',' the group separator, '¤' the currency symbol.
    // `digits` takes the significant digits, as many as it holds; `count` is
    // how many of them count (an integer's trailing zeros do not, a float's
    // fraction's trailing zeros are trimmed), `scale` where the point falls
    // -- the number is 0.DIGITS x 10^scale -- and `tail` whether a digit past
    // the buffer was not zero. BigInteger reads through it too, with a buffer
    // as long as the text so that no digit is ever past it.
    const int StateSign = 1, StateParens = 2, StateDigits = 4, StateNonZero = 8, StateDecimal = 16, StateCurrency = 32;

    internal static bool Scan(string s, int style, bool integer, char[] digits, out int count, out int scale, out bool negative, out bool tail) {
        count = 0;
        scale = 0;
        negative = false;
        tail = false;
        int most = digits.Length;
        bool currency = (style & Currency) != 0;
        int state = 0;
        int end = s.Length;
        int p = 0;
        char ch = p < end ? s[p] : (char)0;

        // Before the digits: white space, a sign or an opening parenthesis,
        // the currency symbol, in any order. White space after a sign is not
        // taken, unless the currency symbol came first.
        while (true) {
            if (!White(ch) || (style & LeadingWhite) == 0 || ((state & StateSign) != 0 && (state & StateCurrency) == 0)) {
                if ((style & LeadingSign) != 0 && (state & StateSign) == 0 && (ch == '+' || ch == '-')) {
                    if (ch == '-') { negative = true; }
                    state |= StateSign;
                } else if (ch == '(' && (style & Parentheses) != 0 && (state & StateSign) == 0) {
                    state |= StateSign | StateParens;
                    negative = true;
                } else if (currency && ch == '¤') {
                    state |= StateCurrency;
                    currency = false;
                } else {
                    break;
                }
            }
            p++;
            ch = p < end ? s[p] : (char)0;
        }

        // The digits, a point and the group separators among them.
        int digCount = 0, digEnd = 0, trailingZeros = 0;
        while (true) {
            if (Digit(ch)) {
                state |= StateDigits;
                if (ch != '0' || (state & StateNonZero) != 0) {
                    if (digCount < most) {
                        digits[digCount] = ch;
                        if (ch != '0' || !integer) { digEnd = digCount + 1; }
                    } else if (ch != '0') {
                        tail = true;
                    }
                    if ((state & StateDecimal) == 0) { scale++; }
                    if (digCount < most) { trailingZeros = ch == '0' ? trailingZeros + 1 : 0; }
                    digCount++;
                    state |= StateNonZero;
                } else if ((state & StateDecimal) != 0) {
                    scale--;
                }
            } else if ((style & DecimalPoint) != 0 && (state & StateDecimal) == 0 && ch == '.') {
                state |= StateDecimal;
            } else if ((style & Thousands) != 0 && (state & StateDigits) != 0 && (state & StateDecimal) == 0 && ch == ',') {
                // A group separator, between digits before the point.
            } else {
                break;
            }
            p++;
            ch = p < end ? s[p] : (char)0;
        }

        count = digEnd;
        if ((state & StateDigits) == 0) { return false; }

        // An exponent, if one is allowed and is whole: "1e" leaves the 'e'
        // for what follows to refuse.
        if ((ch == 'E' || ch == 'e') && (style & Exponent) != 0) {
            int back = p;
            bool down = false;
            p++;
            ch = p < end ? s[p] : (char)0;
            if (ch == '+') {
                p++;
                ch = p < end ? s[p] : (char)0;
            } else if (ch == '-') {
                p++;
                ch = p < end ? s[p] : (char)0;
                down = true;
            }
            if (Digit(ch)) {
                int exp = 0;
                do {
                    // PAST NINE DIGITS the exponent is beyond every type: it
                    // is held as int.MaxValue with the scale set aside, and
                    // the rest of its digits are passed over -- with the
                    // character in hand left as it was, as .NET leaves it, so
                    // nothing after them is taken but NULs.
                    if (exp >= 100000000) {
                        exp = int.MaxValue;
                        scale = 0;
                        while (p < end && Digit(s[p])) { p++; }
                        break;
                    }
                    exp = exp * 10 + (ch - '0');
                    p++;
                    ch = p < end ? s[p] : (char)0;
                } while (Digit(ch));
                scale += down ? -exp : exp;
            } else {
                p = back;
                ch = p < end ? s[p] : (char)0;
            }
        }

        // A float's fraction keeps no trailing zeros.
        if (!integer && !tail) {
            int fraction = digEnd - scale;
            if (fraction > 0) {
                if (trailingZeros > fraction) { trailingZeros = fraction; }
                count = digEnd - trailingZeros;
            }
        }

        // After the digits: white space, a trailing sign, the closing
        // parenthesis, the currency symbol not yet seen.
        while (true) {
            if (!White(ch) || (style & TrailingWhite) == 0) {
                if ((style & TrailingSign) != 0 && (state & StateSign) == 0 && (ch == '+' || ch == '-')) {
                    if (ch == '-') { negative = true; }
                    state |= StateSign;
                } else if (ch == ')' && (state & StateParens) != 0) {
                    state &= ~StateParens;
                } else if (currency && ch == '¤') {
                    currency = false;
                } else {
                    break;
                }
            }
            p++;
            ch = p < end ? s[p] : (char)0;
        }

        if ((state & StateParens) != 0) { return false; }

        // Nothing but zeros is zero, at no scale; an integer's "-0" is not
        // negative, but "-0.0" still is.
        if ((state & StateNonZero) == 0) {
            scale = 0;
            if (integer && (state & StateDecimal) == 0) { negative = false; }
        }
        return TrailingZeros(s, p);
    }

    // ---- floating point --------------------------------------------------------

    /// The double `s` says, correctly rounded, or false where it is no number.
    public static bool TryDouble(string s, NumberStyles style, out double value) {
        int width = s.Length < 768 ? s.Length : 768;
        char[] digits = new char[width == 0 ? 1 : width];
        if (Scan(s, (int)style, false, digits, out int count, out int scale, out bool negative, out bool tail)) {
            double magnitude = 0.0;
            if (count > 0) {
                int exponent;
                FloatBig whole = Whole(digits, count, scale, tail, out exponent);
                magnitude = FloatDecimal.ToDouble(whole, exponent);
            }
            // THE SIGN AS A BIT, so that "-0" is -0.0: a negation written as
            // a subtraction from zero would answer +0.0.
            value = negative ? BitConverter.Int64BitsToDouble(BitConverter.DoubleToInt64Bits(magnitude) | long.MinValue) : magnitude;
            return true;
        }
        int special = Special(s);
        value = special == 1 ? Double.PositiveInfinity : special == 2 ? Double.NegativeInfinity : special == 3 ? Double.NaN : 0.0;
        return special != 0;
    }

    /// The float `s` says, rounded once from the decimal and not through a
    /// double, which would round twice.
    public static bool TrySingle(string s, NumberStyles style, out float value) {
        int width = s.Length < 113 ? s.Length : 113;
        char[] digits = new char[width == 0 ? 1 : width];
        if (Scan(s, (int)style, false, digits, out int count, out int scale, out bool negative, out bool tail)) {
            float magnitude = 0.0F;
            if (count > 0) {
                int exponent;
                FloatBig whole = Whole(digits, count, scale, tail, out exponent);
                magnitude = FloatDecimal.ToSingle(whole, exponent);
            }
            value = negative ? BitConverter.Int32BitsToSingle(BitConverter.SingleToInt32Bits(magnitude) | int.MinValue) : magnitude;
            return true;
        }
        int special = Special(s);
        value = special == 1 ? Single.PositiveInfinity : special == 2 ? Single.NegativeInfinity : special == 3 ? Single.NaN : 0.0F;
        return special != 0;
    }

    // The kept digits as a whole number and the power of ten it is to be
    // scaled by. A non-zero digit past the kept ones becomes a final 1: the
    // value is then above the kept digits and below the next, as the true
    // one is, which is all a correct rounding asks of it. A scale far past
    // either end of every format is held near it, where the conversion
    // already answers infinity or zero.
    static FloatBig Whole(char[] digits, int count, int scale, bool tail, out int exponent) {
        FloatBig whole = new FloatBig(0);
        for (int i = 0; i < count; i++) {
            whole.MulSmall(10);
            whole.AddSmall(digits[i] - '0');
        }
        if (scale > 100000) { scale = 100000; }
        if (scale < -100000) { scale = -100000; }
        exponent = scale - count;
        if (tail) {
            whole.MulSmall(10);
            whole.AddSmall(1);
            exponent = exponent - 1;
        }
        return whole;
    }

    // The words .NET reads where the digits failed: 1 infinity, 2 negative
    // infinity, 3 NaN, 0 none. White space either side, any case.
    static int Special(string s) {
        int at = 0;
        int end = s.Length;
        while (at < end && Char.IsWhiteSpace(s[at])) { at++; }
        while (end > at && Char.IsWhiteSpace(s[end - 1])) { end--; }
        string t = s.Substring(at, end - at);
        if (Same(t, "Infinity")) { return 1; }
        if (Same(t, "-Infinity")) { return 2; }
        if (Same(t, "NaN")) { return 3; }
        if (t.Length > 0 && t[0] == '+') {
            string rest = t.Substring(1);
            if (Same(rest, "Infinity")) { return 1; }
            if (Same(rest, "NaN")) { return 3; }
            return 0;
        }
        if (t.Length > 0 && t[0] == '-' && Same(t.Substring(1), "NaN")) { return 3; }
        return 0;
    }

    static bool Same(string a, string b) { return string.Equals(a, b, StringComparison.OrdinalIgnoreCase); }
}

// ---- the narrow integral types, by the names C# gives them -----------------
//
// Each is a thin naming of the two routines above. They exist because
// `byte.TryParse(field, out b)` is what a program that reads a byte writes,
// and because the range check belongs to the TYPE rather than to the caller.

static class SByte {
    // Equals and GetHashCode as SByte overrides them: equal to its own
    // type's value only, and hashed as .NET hashes it.
    public static bool Equals(sbyte value, sbyte other) { return value == other; }
    public static bool Equals(sbyte value, object? other) { return other is sbyte same && Equals(value, same); }
    public static int GetHashCode(sbyte value) { return value; }
    public static int CompareTo(sbyte value, sbyte other) { return value < other ? -1 : value > other ? 1 : 0; }
    public static int CompareTo(sbyte value, object? other) {
        if (other == null) return 1;
        if (other is sbyte number) return CompareTo(value, number);
        throw new ArgumentException("object must be an SByte");
    }
    public static sbyte MaxValue => sbyte.MaxValue;
    public static sbyte MinValue => sbyte.MinValue;

    public static string ToString(this sbyte value, string format) {
        return NumberFormat.Of(value, 8, format);
    }

    // ---- reading one, as .NET reads it (NumberRead) ----------------------
    //
    // NumberStyles.Integer unless a style is given; the provider is the
    // invariant culture whatever it is. Parse throws ArgumentNullException,
    // FormatException or OverflowException with .NET's messages; TryParse
    // answers false where Parse would throw, but a style .NET refuses is
    // refused by both.

    public static sbyte Parse(string s) { return Parse(s, NumberStyles.Integer, null); }
    public static sbyte Parse(string s, NumberStyles style) { return Parse(s, style, null); }
    public static sbyte Parse(string s, IFormatProvider? provider) { return Parse(s, NumberStyles.Integer, provider); }

    public static sbyte Parse(string s, NumberStyles style, IFormatProvider? provider) {
        NumberRead.CheckInteger(style);
        if (s == null) { throw new ArgumentNullException("s"); }
        return (sbyte)NumberRead.Integer(s, style, 8, true, "a signed byte");
    }

    public static sbyte Parse(ReadOnlySpan<char> s) { return Parse(s, NumberStyles.Integer, null); }
    public static sbyte Parse(ReadOnlySpan<char> s, NumberStyles style) { return Parse(s, style, null); }
    public static sbyte Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s, NumberStyles.Integer, provider); }

    public static sbyte Parse(ReadOnlySpan<char> s, NumberStyles style, IFormatProvider? provider) {
        NumberRead.CheckInteger(style);
        return (sbyte)NumberRead.Integer(s.ToString(), style, 8, true, "a signed byte");
    }

    public static bool TryParse([NotNullWhen(true)] string? s, out sbyte result) { return TryParse(s, NumberStyles.Integer, null, out result); }
    public static bool TryParse([NotNullWhen(true)] string? s, IFormatProvider? provider, out sbyte result) { return TryParse(s, NumberStyles.Integer, provider, out result); }

    public static bool TryParse([NotNullWhen(true)] string? s, NumberStyles style, IFormatProvider? provider, out sbyte result) {
        NumberRead.CheckInteger(style);
        if (s == null) { result = 0; return false; }
        bool ok = NumberRead.TryInteger(s, style, 8, true, out ulong bits);
        result = (sbyte)bits;
        return ok;
    }

    public static bool TryParse(ReadOnlySpan<char> s, out sbyte result) { return TryParse(s, NumberStyles.Integer, null, out result); }
    public static bool TryParse(ReadOnlySpan<char> s, IFormatProvider? provider, out sbyte result) { return TryParse(s, NumberStyles.Integer, provider, out result); }

    public static bool TryParse(ReadOnlySpan<char> s, NumberStyles style, IFormatProvider? provider, out sbyte result) {
        NumberRead.CheckInteger(style);
        bool ok = NumberRead.TryInteger(s.ToString(), style, 8, true, out ulong bits);
        result = (sbyte)bits;
        return ok;
    }
}

