    public static int Parse(ReadOnlySpan<char> s, NumberStyles style) { return Parse(s, style, null); }
    public static int Parse(ReadOnlySpan<char> s, IFormatProvider? provider) { return Parse(s, NumberStyles.Integer, provider); }

