// System.Diagnostics.Process, the parts a program uses to run another:
// Start with a file name and arguments, optional redirection of the
// standard streams through pipes, WaitForExit, ExitCode.
class ProcessStartInfo
{
    public string FileName = "";
    public List<string> ArgumentList = new List<string>();
    public string Arguments = "";
    public bool RedirectStandardOutput;
    public bool RedirectStandardInput;
    public bool RedirectStandardError;
    public string WorkingDirectory = "";

    public ProcessStartInfo()
    {
    }

    public ProcessStartInfo(string fileName)
    {
        FileName = fileName;
    }

    public ProcessStartInfo(string fileName, string arguments)
    {
        FileName = fileName;
        Arguments = arguments;
    }
}

class Process : IDisposable
{
    int _pid;
    int _exitCode;
    bool _exited;
    StreamReader? _stdout;
    StreamReader? _stderr;
    StreamWriter? _stdin;
    public ProcessStartInfo StartInfo = new ProcessStartInfo();

    public static Process Start(string fileName, string arguments)
    {
        Process p = new Process();
        p.StartInfo = new ProcessStartInfo(fileName, arguments);
        p.Start();
        return p;
    }

    public static Process Start(string fileName)
    {
        return Start(fileName, "");
    }

    public static Process Start(ProcessStartInfo info)
    {
        Process p = new Process();
        p.StartInfo = info;
        p.Start();
        return p;
    }

    public int Id
    {
        get { return _pid; }
    }

    public bool HasExited
    {
        get
        {
            if (!_exited)
            {
                Reap(true);
            }
            return _exited;
        }
    }

    public int ExitCode
    {
        get { return _exitCode; }
    }

    public StreamReader StandardOutput
    {
        get { return _stdout!; }
    }

    public StreamReader StandardError
    {
        get { return _stderr!; }
    }

    public StreamWriter StandardInput
    {
        get { return _stdin!; }
    }

    /// The program is found on PATH when its name has no slash, as .NET's
    /// UseShellExecute=false does.
    static string Resolve(string name)
    {
        if (name.IndexOf('/') >= 0)
        {
            return name;
        }
        return UnixProcess.Find(name);
    }

    /// Arguments as a string are split on spaces, with double quotes
    /// grouping, as .NET's parser does for the common cases.
    static List<string> Split(string arguments)
    {
        List<string> words = new List<string>();
        StringBuilder word = new StringBuilder();
        bool quoted = false;
        bool any = false;
        for (int i = 0; i < arguments.Length; i++)
        {
            char c = arguments[i];
            if (c == '"')
            {
                quoted = !quoted;
                any = true;
            }
            else if (c == ' ' && !quoted)
            {
                if (any)
                {
                    words.Add(word.ToString());
                    word.Clear();
                    any = false;
                }
            }
            else
            {
                word.Append(c);
                any = true;
            }
        }
        if (any)
        {
            words.Add(word.ToString());
        }
        return words;
    }

    public bool Start()
    {
        List<string> args = new List<string>();
        args.Add(StartInfo.FileName);
        for (int i = 0; i < StartInfo.ArgumentList.Count; i++)
        {
            args.Add(StartInfo.ArgumentList[i]);
        }
        List<string> fromString = Split(StartInfo.Arguments);
        for (int i = 0; i < fromString.Count; i++)
        {
            args.Add(fromString[i]);
        }
        string program = Resolve(StartInfo.FileName);
        int[] outPipe = new int[2];
        int[] errPipe = new int[2];
        int[] inPipe = new int[2];
        if (StartInfo.RedirectStandardOutput && UnixProcess.Pipe(outPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        if (StartInfo.RedirectStandardError && UnixProcess.Pipe(errPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        if (StartInfo.RedirectStandardInput && UnixProcess.Pipe(inPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        int pid = UnixProcess.Fork();
        if (pid < 0)
        {
            throw new IOException("fork failed");
        }
        if (pid == 0)
        {
            if (StartInfo.RedirectStandardOutput)
            {
                UnixProcess.Dup2(outPipe[1], 1);
                UnixProcess.Close(outPipe[0]);
                UnixProcess.Close(outPipe[1]);
            }
            if (StartInfo.RedirectStandardError)
            {
                UnixProcess.Dup2(errPipe[1], 2);
                UnixProcess.Close(errPipe[0]);
                UnixProcess.Close(errPipe[1]);
            }
            if (StartInfo.RedirectStandardInput)
            {
                UnixProcess.Dup2(inPipe[0], 0);
                UnixProcess.Close(inPipe[0]);
                UnixProcess.Close(inPipe[1]);
            }
            if (StartInfo.WorkingDirectory.Length > 0)
            {
                UnixProcess.ChangeDirectory(StartInfo.WorkingDirectory);
            }
            UnixProcess.Exec(program, args.ToArray(), Environment.EnvironmentBlock());
            Environment.Exit(127);
        }
        _pid = pid;
        if (StartInfo.RedirectStandardOutput)
        {
            UnixProcess.Close(outPipe[1]);
            _stdout = new StreamReader(new FileStream(outPipe[0], FileAccess.Read, true));
        }
        if (StartInfo.RedirectStandardError)
        {
            UnixProcess.Close(errPipe[1]);
            _stderr = new StreamReader(new FileStream(errPipe[0], FileAccess.Read, true));
        }
        if (StartInfo.RedirectStandardInput)
        {
            UnixProcess.Close(inPipe[0]);
            _stdin = new StreamWriter(new FileStream(inPipe[1], FileAccess.Write, true));
        }
        return true;
    }

    void Reap(bool noHang)
    {
        int status = 0;
        int got;
        while (true)
        {
            got = UnixProcess.WaitPid(_pid, out status,
                                      noHang ? WaitOptions.NoHang : WaitOptions.None);
            if (got != -Err.Intr)
            {
                break;
            }
        }
        if (got == _pid)
        {
            _exited = true;
            _exitCode = UnixProcess.Result(status);
        }
    }

    public void WaitForExit()
    {
        if (_stdin != null)
        {
            _stdin.Dispose();
            _stdin = null;
        }
        if (!_exited)
        {
            Reap(false);
        }
    }

    public void Kill()
    {
        UnixProcess.Kill(_pid, 9);
    }

    // ---- processes this one did not start ---------------------------------------
    //
    // Process.GetProcesses and GetProcessById, read from /proc as ps reads it:
    // /proc/<pid>/stat is `pid (comm) state ppid ...`, proc(5)'s fields.

    string _name = "";
    long _rss, _cpuTicks;
    int _threads = 1;
    bool _listed;

    /// The program's name, as /proc/<pid>/stat has it (comm).
    public string ProcessName { get { return _listed ? _name : Refresh1(); } }

    /// The memory it has in use, in bytes: its resident set.
    public long WorkingSet64 { get { return _rss; } }

    /// Its time on the processors, user and system together.
    public TimeSpan TotalProcessorTime { get { return new TimeSpan(_cpuTicks * 100000); } }     // USER_HZ 100: a tick is 10 ms

    /// How many threads it has (.NET's Threads.Count).
    public int ThreadCount { get { return _threads; } }

    string Refresh1() { Read(); return _name; }

    /// Every process there is, in pid order.
    public static Process[] GetProcesses()
    {
        List<Process> all = new List<Process>();
        string[] dirs;
        try { dirs = Directory.GetDirectories("/proc"); }
        catch (IOException) { return new Process[0]; }
        List<int> pids = new List<int>();
        foreach (string d in dirs)
        {
            string name = Path.GetFileName(d);
            int pid;
            if (name.Length > 0 && char.IsDigit(name[0]) && int.TryParse(name, out pid)) pids.Add(pid);
        }
        pids.Sort();
        foreach (int pid in pids)
        {
            Process p = new Process();
            p._pid = pid;
            if (p.Read()) all.Add(p);
        }
        return all.ToArray();
    }

    /// The process with this id; ArgumentException when there is none.
    public static Process GetProcessById(int processId)
    {
        Process p = new Process();
        p._pid = processId;
        if (!p.Read()) throw new ArgumentException("Process with an Id of " + processId + " is not running.");
        return p;
    }

    /// Its /proc/<pid>/stat read; false when it is gone.
    bool Read()
    {
        string text;
        try { text = File.ReadAllText("/proc/" + _pid + "/stat"); }
        catch (IOException) { return false; }
        int open = text.IndexOf('('), close = text.LastIndexOf(')');
        if (open < 0 || close < open) return false;
        _name = text.Substring(open + 1, close - open - 1);
        string[] f = text.Substring(close + 1).Trim().Split(' ');
        // After the name: state 0, ppid 1 ... utime 11, stime 12,
        // num_threads 17, rss 21 (pages).
        long utime = 0, stime = 0, rss = 0;
        int threads = 1;
        if (f.Length > 21)
        {
            long.TryParse(f[11], out utime);
            long.TryParse(f[12], out stime);
            int.TryParse(f[17], out threads);
            long.TryParse(f[21], out rss);
        }
        _cpuTicks = utime + stime;
        _threads = threads;
        _rss = rss * 4096;
        _listed = true;
        return true;
    }

    public void Dispose()
    {
    }
}
