// System.Diagnostics.Process, the parts a program uses to run another:
// Start with a file name and arguments, optional redirection of the
// standard streams through pipes, WaitForExit, ExitCode.
class ProcessStartInfo
{
    public string FileName = "";
    public List<string> ArgumentList = new List<string>();
    public string Arguments = "";
    public bool RedirectStandardOutput;
    public bool RedirectStandardInput;
    public bool RedirectStandardError;
    public string WorkingDirectory = "";

    /// Whether the system opens the file, as a shell would, rather than it
    /// being run: false by default, as .NET Core has it. On Unix an
    /// executable is run either way; anything else is handed to xdg-open.
    public bool UseShellExecute;

    /// No window: nothing to do on Unix, where a child shares the terminal.
    public bool CreateNoWindow;

    Dictionary<string, string?>? _environment;

    /// The child's environment: this process's, until changed. What is in
    /// it when the process starts is exactly what the child gets.
    public IDictionary<string, string?> Environment
    {
        get
        {
            if (_environment == null)
            {
                Dictionary<string, string?> made = new Dictionary<string, string?>();
                foreach (string entry in System.Environment.EnvironmentBlock())
                {
                    int equals = entry.IndexOf('=');
                    if (equals > 0) made[entry.Substring(0, equals)] = entry.Substring(equals + 1);
                }
                _environment = made;
            }
            return _environment;
        }
    }

    /// The block the child is started with: the Environment dictionary as
    /// it now stands when it was ever asked for, this process's otherwise.
    public string[] EnvironmentBlock()
    {
        if (_environment == null)
        {
            return System.Environment.EnvironmentBlock();
        }
        List<string> block = new List<string>();
        foreach (KeyValuePair<string, string?> pair in _environment)
        {
            if (pair.Value != null) block.Add(pair.Key + "=" + pair.Value);
        }
        return block.ToArray();
    }

    public ProcessStartInfo()
    {
    }

    public ProcessStartInfo(string fileName)
    {
        FileName = fileName;
    }

    public ProcessStartInfo(string fileName, string arguments)
    {
        FileName = fileName;
        Arguments = arguments;
    }
}

class Process : IDisposable
{
    int _pid;
    int _exitCode;
    bool _exited;
    StreamReader? _stdout;
    StreamReader? _stderr;
    StreamWriter? _stdin;
    public ProcessStartInfo StartInfo = new ProcessStartInfo();

    public static Process Start(string fileName, string arguments)
    {
        Process p = new Process();
        p.StartInfo = new ProcessStartInfo(fileName, arguments);
        p.Start();
        return p;
    }

    public static Process Start(string fileName)
    {
        return Start(fileName, "");
    }

    public static Process Start(ProcessStartInfo info)
    {
        Process p = new Process();
        p.StartInfo = info;
        p.Start();
        return p;
    }

    public int Id
    {
        get { return _pid; }
    }

    public bool HasExited
    {
        get
        {
            if (!_exited)
            {
                Reap(true);
            }
            return _exited;
        }
    }

    public int ExitCode
    {
        get { return _exitCode; }
    }

    public StreamReader StandardOutput
    {
        get { return _stdout!; }
    }

    public StreamReader StandardError
    {
        get { return _stderr!; }
    }

    public StreamWriter StandardInput
    {
        get { return _stdin!; }
    }

    /// The program is found on PATH when its name has no slash, as .NET's
    /// UseShellExecute=false does.
    static string Resolve(string name)
    {
        if (name.IndexOf('/') >= 0)
        {
            return name;
        }
        return UnixProcess.Find(name);
    }

    /// Arguments as a string are split on spaces, with double quotes
    /// grouping, as .NET's parser does for the common cases.
    static List<string> Split(string arguments)
    {
        List<string> words = new List<string>();
        StringBuilder word = new StringBuilder();
        bool quoted = false;
        bool any = false;
        for (int i = 0; i < arguments.Length; i++)
        {
            char c = arguments[i];
            if (c == '"')
            {
                quoted = !quoted;
                any = true;
            }
            else if (c == ' ' && !quoted)
            {
                if (any)
                {
                    words.Add(word.ToString());
                    word.Clear();
                    any = false;
                }
            }
            else
            {
                word.Append(c);
                any = true;
            }
        }
        if (any)
        {
            words.Add(word.ToString());
        }
        return words;
    }

    public bool Start()
    {
        if (StartInfo.UseShellExecute && (StartInfo.RedirectStandardOutput || StartInfo.RedirectStandardInput || StartInfo.RedirectStandardError))
        {
            throw new InvalidOperationException("The Process object must have the UseShellExecute property set to false in order to redirect IO streams.");
        }
        if (StartInfo.FileName.Length == 0)
        {
            throw new InvalidOperationException("Cannot start process because a file name has not been provided.");
        }
        List<string> args = new List<string>();
        args.Add(StartInfo.FileName);
        for (int i = 0; i < StartInfo.ArgumentList.Count; i++)
        {
            args.Add(StartInfo.ArgumentList[i]);
        }
        List<string> fromString = Split(StartInfo.Arguments);
        for (int i = 0; i < fromString.Count; i++)
        {
            args.Add(fromString[i]);
        }
        string program = Resolve(StartInfo.FileName);
        // AS A SHELL WOULD OPEN IT: a file that is not a program is opened
        // by the desktop's opener, as .NET Core does on Unix.
        if (StartInfo.UseShellExecute && !UnixProcess.IsExecutable(program))
        {
            args.Insert(0, "xdg-open");
            program = Resolve("xdg-open");
        }
        int[] outPipe = new int[2];
        int[] errPipe = new int[2];
        int[] inPipe = new int[2];
        if (StartInfo.RedirectStandardOutput && UnixProcess.Pipe(outPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        if (StartInfo.RedirectStandardError && UnixProcess.Pipe(errPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        if (StartInfo.RedirectStandardInput && UnixProcess.Pipe(inPipe) < 0)
        {
            throw new IOException("pipe failed");
        }
        // MADE BEFORE THE FORK, and the child only makes system calls on it:
        // it may not allocate (Os.PrepareExec).
        ExecPlan plan = UnixProcess.PrepareExec(program, args.ToArray(), StartInfo.EnvironmentBlock(), StartInfo.WorkingDirectory);
        int pid = UnixProcess.Fork();
        if (pid < 0)
        {
            throw new IOException("fork failed");
        }
        if (pid == 0)
        {
            if (StartInfo.RedirectStandardOutput)
            {
                UnixProcess.Dup2(outPipe[1], 1);
                UnixProcess.Close(outPipe[0]);
                UnixProcess.Close(outPipe[1]);
            }
            if (StartInfo.RedirectStandardError)
            {
                UnixProcess.Dup2(errPipe[1], 2);
                UnixProcess.Close(errPipe[0]);
                UnixProcess.Close(errPipe[1]);
            }
            if (StartInfo.RedirectStandardInput)
            {
                UnixProcess.Dup2(inPipe[0], 0);
                UnixProcess.Close(inPipe[0]);
                UnixProcess.Close(inPipe[1]);
            }
            UnixProcess.ChangeDirectory(plan);
            UnixProcess.Exec(plan);
            UnixProcess.ExitNow(127);
        }
        GC.KeepAlive(plan);
        _pid = pid;
        if (StartInfo.RedirectStandardOutput)
        {
            UnixProcess.Close(outPipe[1]);
            _stdout = new StreamReader(new FileStream(outPipe[0], FileAccess.Read, true));
        }
        if (StartInfo.RedirectStandardError)
        {
            UnixProcess.Close(errPipe[1]);
            _stderr = new StreamReader(new FileStream(errPipe[0], FileAccess.Read, true));
        }
        if (StartInfo.RedirectStandardInput)
        {
            UnixProcess.Close(inPipe[0]);
            _stdin = new StreamWriter(new FileStream(inPipe[1], FileAccess.Write, true));
        }
        return true;
    }

    void Reap(bool noHang)
    {
        int status = 0;
        int got;
        while (true)
        {
            got = UnixProcess.WaitPid(_pid, out status,
                                      noHang ? WaitOptions.NoHang : WaitOptions.None);
            if (got != -Err.Intr)
            {
                break;
            }
        }
        if (got == _pid)
        {
            _exited = true;
            _exitCode = UnixProcess.Result(status);
        }
    }

    public void WaitForExit()
    {
        if (_stdin != null)
        {
            _stdin.Dispose();
            _stdin = null;
        }
        if (!_exited)
        {
            Reap(false);
        }
    }

    /// Waits up to `milliseconds` (-1 for as long as it takes) for it to
    /// end; whether it did.
    public bool WaitForExit(int milliseconds)
    {
        if (milliseconds < -1)
        {
            throw new ArgumentOutOfRangeException(nameof(milliseconds));
        }
        if (milliseconds == -1)
        {
            WaitForExit();
            return true;
        }
        long deadline = Environment.TickCount64 + milliseconds;
        int pause = 1;
        while (!HasExited)
        {
            long left = deadline - Environment.TickCount64;
            if (left <= 0)
            {
                return false;
            }
            Thread.Sleep((int)Math.Min(left, pause));
            pause = Math.Min(pause * 2, 50);
        }
        return true;
    }

    public bool WaitForExit(TimeSpan timeout)
    {
        long ms = (long)timeout.TotalMilliseconds;
        if (ms < -1 || ms > int.MaxValue)
        {
            throw new ArgumentOutOfRangeException(nameof(timeout));
        }
        return WaitForExit((int)ms);
    }

    /// A task that completes when the process has ended, or is canceled
    /// with the token -- the process going on regardless, as .NET's does.
    public async Task WaitForExitAsync(CancellationToken cancellationToken = default)
    {
        int pause = 1;
        while (!HasExited)
        {
            cancellationToken.ThrowIfCancellationRequested();
            await Task.Delay(pause, cancellationToken);
            pause = Math.Min(pause * 2, 50);
        }
    }

    public void Kill()
    {
        if (_exited)
        {
            return;
        }
        UnixProcess.Kill(_pid, 9);
    }

    /// Kills it, and with entireProcessTree every process descended from it,
    /// found through /proc as they stand now.
    public void Kill(bool entireProcessTree)
    {
        if (!entireProcessTree)
        {
            Kill();
            return;
        }
        if (_exited)
        {
            return;
        }
        List<int> tree = new List<int>();
        tree.Add(_pid);
        Dictionary<int, List<int>> children = ChildrenByParent();
        for (int i = 0; i < tree.Count; i++)
        {
            if (children.TryGetValue(tree[i], out List<int>? under))
            {
                foreach (int child in under) tree.Add(child);
            }
        }
        for (int i = 0; i < tree.Count; i++)
        {
            UnixProcess.Kill(tree[i], 9);
        }
    }

    /// Every process's children, by its parent's id: the ppid field of
    /// /proc/<pid>/stat.
    static Dictionary<int, List<int>> ChildrenByParent()
    {
        Dictionary<int, List<int>> children = new Dictionary<int, List<int>>();
        string[] dirs;
        try { dirs = Directory.GetDirectories("/proc"); }
        catch (IOException) { return children; }
        foreach (string dir in dirs)
        {
            string name = Path.GetFileName(dir);
            if (name.Length == 0 || !char.IsDigit(name[0]) || !int.TryParse(name, out int pid)) continue;
            string text;
            try { text = File.ReadAllText(dir + "/stat"); }
            catch (IOException) { continue; }
            int close = text.LastIndexOf(')');
            if (close < 0) continue;
            string[] fields = text.Substring(close + 2).Split(' ');
            if (fields.Length > 1 && int.TryParse(fields[1], out int parent))
            {
                if (!children.TryGetValue(parent, out List<int>? list))
                {
                    list = new List<int>();
                    children[parent] = list;
                }
                list.Add(pid);
            }
        }
        return children;
    }

    // ---- processes this one did not start ---------------------------------------
    //
    // Process.GetProcesses and GetProcessById, read from /proc as ps reads it:
    // /proc/<pid>/stat is `pid (comm) state ppid ...`, proc(5)'s fields.

    string _name = "";
    long _rss, _cpuTicks;
    int _threads = 1;
    bool _listed;

    /// The program's name, as /proc/<pid>/stat has it (comm).
    public string ProcessName { get { return _listed ? _name : Refresh1(); } }

    /// The memory it has in use, in bytes: its resident set.
    public long WorkingSet64 { get { return _rss; } }

    /// Its time on the processors, user and system together.
    public TimeSpan TotalProcessorTime { get { return new TimeSpan(_cpuTicks * 100000); } }     // USER_HZ 100: a tick is 10 ms

    /// How many threads it has (.NET's Threads.Count).
    public int ThreadCount { get { return _threads; } }

    string Refresh1() { Read(); return _name; }

    /// Every process there is, in pid order.
    public static Process[] GetProcesses()
    {
        List<Process> all = new List<Process>();
        string[] dirs;
        try { dirs = Directory.GetDirectories("/proc"); }
        catch (IOException) { return new Process[0]; }
        List<int> pids = new List<int>();
        foreach (string d in dirs)
        {
            string name = Path.GetFileName(d);
            int pid;
            if (name.Length > 0 && char.IsDigit(name[0]) && int.TryParse(name, out pid)) pids.Add(pid);
        }
        pids.Sort();
        foreach (int pid in pids)
        {
            Process p = new Process();
            p._pid = pid;
            if (p.Read()) all.Add(p);
        }
        return all.ToArray();
    }

    /// The process with this id; ArgumentException when there is none.
    public static Process GetProcessById(int processId)
    {
        Process p = new Process();
        p._pid = processId;
        if (!p.Read()) throw new ArgumentException("Process with an Id of " + processId + " is not running.");
        return p;
    }

    /// Its /proc/<pid>/stat read; false when it is gone.
    bool Read()
    {
        string text;
        try { text = File.ReadAllText("/proc/" + _pid + "/stat"); }
        catch (IOException) { return false; }
        int open = text.IndexOf('('), close = text.LastIndexOf(')');
        if (open < 0 || close < open) return false;
        _name = text.Substring(open + 1, close - open - 1);
        string[] f = text.Substring(close + 1).Trim().Split(' ');
        // After the name: state 0, ppid 1 ... utime 11, stime 12,
        // num_threads 17, rss 21 (pages).
        long utime = 0, stime = 0, rss = 0;
        int threads = 1;
        if (f.Length > 21)
        {
            long.TryParse(f[11], out utime);
            long.TryParse(f[12], out stime);
            int.TryParse(f[17], out threads);
            long.TryParse(f[21], out rss);
        }
        _cpuTicks = utime + stime;
        _threads = threads;
        _rss = rss * 4096;
        _listed = true;
        return true;
    }

    public void Dispose()
    {
    }
}
