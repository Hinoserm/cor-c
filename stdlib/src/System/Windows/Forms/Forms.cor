    CtrlF12 = 0x2011B,
    CtrlShiftF1 = 0x30110,
    CtrlShiftF2 = 0x30111,
    CtrlShiftF3 = 0x30112,
    CtrlShiftF4 = 0x30113,
    CtrlShiftF5 = 0x30114,
    CtrlShiftF6 = 0x30115,
    CtrlShiftF7 = 0x30116,
    CtrlShiftF8 = 0x30117,
    CtrlShiftF9 = 0x30118,
    CtrlShiftF10 = 0x30119,
    CtrlShiftF11 = 0x3011A,
    CtrlShiftF12 = 0x3011B,
    CtrlA = 0x20041,
    CtrlB = 0x20042,
    CtrlC = 0x20043,
    CtrlD = 0x20044,
    CtrlE = 0x20045,
    CtrlF = 0x20046,
    CtrlG = 0x20047,
    CtrlH = 0x20048,
    CtrlI = 0x20049,
    CtrlJ = 0x2004A,
    CtrlK = 0x2004B,
    CtrlL = 0x2004C,
    CtrlM = 0x2004D,
