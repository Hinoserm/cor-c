// System.Windows.Forms: the Windows programming model, as .NET spells it.
//
// A Form is a window. Controls are child windows. A program attaches handlers
// to events and calls Application.Run once; the loop inside it blocks for the
// next message and dispatches it, and nobody polls. See docs/software/GUI-KERNEL.md
// in the OS repository, "The programming model".
//
// WHO OWNS WHAT, TODAY. The system owns top-level windows: a Form is a window
// the seat created, with a handle, a position and a place in the z-order,
// and the system decides which window a click lands in and sends paint
// messages when overlap changes. Child controls are this library's: it
// hit-tests within a form and paints them, which is also how Windows does
// it for the controls that are not windows of their own. Nothing in the
// contract below says which side owns what, so moving control routing into
// the system later changes nothing a program sees.
//
// THE CONTRACT WITH THE SEAT, all integers and byte records, nothing of this
// library's own on the wire (a C program can speak it):
//
//   writes   drawing batches, 32-bit little-endian words, opcode first:
//              1 Fill x y w h colour
//              2 Copy sx sy dx dy w h
//              3 Line x0 y0 x1 y1 colour
//              4 DefineGlyph id w h bytes, then the packed bits padded to 4
//              5 Glyph id x y fg bg flags(1 = transparent)
//              6 Clip x y w h
//              7 DefineBitmap id w h format bytes, then the pixels padded to 4
//              8 Blit id sx sy dx dy w h
//              9 Pointer x y
//             10 ShowPointer flag
//             11 DefinePointer w h hotx hoty bytes, AND mask then XOR mask
//             12 Window handle           -- everything after is relative to it
//            Colours are 0x00RRGGBB.
//   reads    16-byte events: kind, window, a, b
//              1 Key        a = key code, b = modifiers
//              3 Move       a = x, b = y, relative to the window
//              4 Down       a = action (1 MAIN 2 ALT 3 MIDDLE 4 BACK 5 FORWARD)
//                           | physical button << 8, b = x | y << 16
//              5 Up         same
//              6 Wheel      a = delta in 120ths, positive away from the user,
//                           b = the source's kind | phase << 8
//              7 HWheel     the same, positive to the right
//              8 Paint      a = x | y << 16, b = w | h << 16, relative to the window
//              9 Focus      a = 1 gained, 0 lost
//             10 Close      the system asks the window to close
//   ioctls   0x47550001 width, 0x47550002 height, 0x47550003 format,
//            0x47550004 events waiting for this process
//            0x47550010 create window at x | y << 16, returns the handle and
//                       selects it; 0x47550020 select a window by handle; then
//                       on the selected window: 0x47550011 size w | h << 16,
//                       0x47550012 show, 0x47550013 hide, 0x47550014 raise,
//                       0x47550015 move x | y << 16, 0x47550016 destroy,
//                       0x47550017 focus. Selection is per process.

using System;
using System.IO;
using System.Drawing;
using Corsac.GUI;

namespace System.Windows.Forms;

public delegate void EventHandler(object sender, EventArgs e);
public delegate void PaintEventHandler(object sender, PaintEventArgs e);
public delegate void MouseEventHandler(object sender, MouseEventArgs e);
public delegate void KeyPressEventHandler(object sender, KeyPressEventArgs e);
public delegate void KeyEventHandler(object sender, KeyEventArgs e);
public delegate void FormClosingEventHandler(object sender, FormClosingEventArgs e);

public class EventArgs
{
    public static EventArgs Empty = new EventArgs();
}

public class PaintEventArgs : EventArgs
{
    public Graphics Graphics;
    public Rectangle ClipRectangle;
    public PaintEventArgs(Graphics g, Rectangle clip) { Graphics = g; ClipRectangle = clip; }
}

/// .NET's values. The seat sends what a button DOES (MAIN, ALT, MIDDLE, BACK,
/// FORWARD) and this is how Windows Forms has always spelled those, so a
/// left-handed person's primary button is Left here, as it is on Windows.
public enum MouseButtons { None = 0, Left = 0x100000, Right = 0x200000, Middle = 0x400000, XButton1 = 0x800000, XButton2 = 0x1000000 }

public class MouseEventArgs : EventArgs
{
    public MouseButtons Button;
    public int Clicks;
    public int X;
    public int Y;
    public int Delta;
    public Point Location { get { return new Point(X, Y); } }
    public MouseEventArgs(MouseButtons button, int clicks, int x, int y, int delta) { Button = button; Clicks = clicks; X = x; Y = y; Delta = delta; }
}

public class KeyPressEventArgs : EventArgs
{
    public char KeyChar;
    public bool Handled;
    public KeyPressEventArgs(char c) { KeyChar = c; }
}

/// The key codes a program sees. The values below 256 are characters; the
/// named ones are the seat's codes for keys with no character, which are
/// the kernel keyboard driver's and are stable.
public enum Keys
{
    None = 0, Back = 8, Tab = 9, Enter = 13, Escape = 27, Space = 32,
    Home = 0x101, End = 0x102, PageUp = 0x103, PageDown = 0x104, Insert = 0x105, Delete = 0x106,
    Up = 0x107, Down = 0x108, Left = 0x109, Right = 0x10A,
    F1 = 0x110, F2 = 0x111, F3 = 0x112, F4 = 0x113, F5 = 0x114, F6 = 0x115,
    F7 = 0x116, F8 = 0x117, F9 = 0x118, F10 = 0x119, F11 = 0x11A, F12 = 0x11B,
    Shift = 0x10000, Control = 0x20000, Alt = 0x40000,
}

public class KeyEventArgs : EventArgs
{
    public Keys KeyCode;
    public int Modifiers;
    public bool Handled;
    public bool Shift { get { return (Modifiers & 1) != 0; } }
    public bool Control { get { return (Modifiers & 2) != 0; } }
    public bool Alt { get { return (Modifiers & 4) != 0; } }
    public KeyEventArgs(Keys code, int modifiers) { KeyCode = code; Modifiers = modifiers; }
}

public class FormClosingEventArgs : EventArgs
{
    public bool Cancel;
}

/// A message, as WndProc sees one. The four words of the seat's event.
public struct Message
{
    public int Kind;
    public int Window;
    public int A;
    public int B;
    public bool Handled;
}

// ---------------------------------------------------------------------------
// Controls
// ---------------------------------------------------------------------------

public enum Border3DStyle { Raised, Sunken, RaisedOuter, SunkenOuter, RaisedInner, SunkenInner, Flat, Etched, Bump }

/// Which way a small arrow points: the glyph on a scroll bar's button, a
/// combo box's drop button and a spin button's two halves.
public enum ArrowDirection { Up, Down, Left, Right }

/// <summary>
/// What WinForms' ControlPaint draws: the bevels, arrows, ticks and focus
/// rectangles that every control is assembled from.
///
/// The bevel is Windows 98's, to the pixel. A raised edge is white on the
/// outside of the top and left with #DFDFDF just inside it, black on the
/// outside of the bottom and right with #808080 just inside; a sunken edge
/// is that reversed. Everything in the system -- a button, a field, a
/// group frame, a status panel -- is one of those two, which is exactly
/// why a screen of them reads as a single machine rather than a collection
/// of widgets.
/// </summary>
public static class ControlPaint
{
    public static void DrawBorder3D(Graphics g, Rectangle r, Border3DStyle style) { DrawBorder3D(g, r.X, r.Y, r.Width, r.Height, style); }

    /// One line of colour down the top and left, another down the bottom
    /// and right: the half of a bevel that every style below is built from.
    static void Corner(Graphics g, int x, int y, int w, int h, Color topLeft, Color bottomRight)
    {
        Pen tl = new Pen(topLeft), br = new Pen(bottomRight);
        g.DrawLine(tl, x, y, x + w - 2, y);
        g.DrawLine(tl, x, y, x, y + h - 2);
        g.DrawLine(br, x + w - 1, y, x + w - 1, y + h - 1);
        g.DrawLine(br, x, y + h - 1, x + w - 1, y + h - 1);
    }

    public static void DrawBorder3D(Graphics g, int x, int y, int w, int h, Border3DStyle style)
    {
        if (w <= 0 || h <= 0) { return; }

        Color face = SystemColors.Control;
        Color light = SystemColors.ControlLight;             // #DFDFDF
        Color lighter = SystemColors.ControlLightLight;      // white
        Color dark = SystemColors.ControlDark;               // #808080
        Color darker = SystemColors.ControlDarkDark;         // black

        if (style == Border3DStyle.Raised)
        {
            Corner(g, x, y, w, h, lighter, darker);
            Corner(g, x + 1, y + 1, w - 2, h - 2, light, dark);
        }
        else if (style == Border3DStyle.Sunken)
        {
            Corner(g, x, y, w, h, dark, lighter);
            Corner(g, x + 1, y + 1, w - 2, h - 2, darker, light);
        }
        else if (style == Border3DStyle.RaisedOuter) { Corner(g, x, y, w, h, lighter, darker); }
        else if (style == Border3DStyle.SunkenOuter) { Corner(g, x, y, w, h, dark, lighter); }
        else if (style == Border3DStyle.RaisedInner) { Corner(g, x, y, w, h, light, dark); }
        else if (style == Border3DStyle.SunkenInner) { Corner(g, x, y, w, h, darker, light); }
        else if (style == Border3DStyle.Etched)
        {
            // A GROOVE: shadow outside, highlight just inside, which is the
            // frame a group box and a menu separator have always worn.
            Corner(g, x, y, w, h, dark, lighter);
            Corner(g, x + 1, y + 1, w - 2, h - 2, face, face);
            Pen hi = new Pen(lighter);
            g.DrawLine(hi, x + 1, y + 1, x + w - 2, y + 1);
            g.DrawLine(hi, x + 1, y + 1, x + 1, y + h - 2);
            Pen sh = new Pen(dark);
            g.DrawLine(sh, x + w - 2, y + 1, x + w - 2, y + h - 2);
            g.DrawLine(sh, x + 1, y + h - 2, x + w - 2, y + h - 2);
        }
        else if (style == Border3DStyle.Bump)
        {
            Corner(g, x, y, w, h, lighter, dark);
            Corner(g, x + 1, y + 1, w - 2, h - 2, dark, lighter);
        }
        else { g.DrawRectangle(new Pen(dark), x, y, w, h); }
    }

    /// <summary>
    /// A raised button face, or a pressed one: the two-line bevel plus the
    /// single black rim a default button wears, all of it sized so that the
    /// caller can simply put the text in the middle.
    /// </summary>
    public static void DrawButtonFace(Graphics g, int x, int y, int w, int h, bool pressed, bool isDefault, Color face)
    {
        if (isDefault)
        {
            // THE DEFAULT BUTTON IS RINGED IN BLACK, and the button proper
            // is drawn one pixel inside that ring. This is the only visual
            // difference Windows gives it, and it is the thing that tells
            // a person which button Enter will press.
            g.DrawRectangle(new Pen(SystemColors.WindowFrame), x, y, w, h);
            x++; y++; w -= 2; h -= 2;
        }
        g.FillRectangle(new SolidBrush(face), x, y, w, h);
        if (pressed)
        {
            // Held in: no highlight at all, one shadow line and the dark
            // rim outside it. Windows draws no white on a pressed button.
            Corner(g, x, y, w, h, SystemColors.ControlDark, SystemColors.ControlLight);
            Corner(g, x + 1, y + 1, w - 2, h - 2, SystemColors.ControlDarkDark, SystemColors.Control);
        }
        else { DrawBorder3D(g, x, y, w, h, Border3DStyle.Raised); }
    }

    /// <summary>
    /// The dotted rectangle that says where the keyboard is. Every other
    /// pixel, on a grid that starts at an even coordinate so neighbouring
    /// rectangles line up instead of shimmering against each other.
    /// </summary>
    public static void DrawFocusRectangle(Graphics g, Rectangle r) { DrawFocusRectangle(g, r.X, r.Y, r.Width, r.Height); }

    public static void DrawFocusRectangle(Graphics g, int x, int y, int w, int h)
    {
        if (w <= 0 || h <= 0) { return; }

        Brush ink = new SolidBrush(SystemColors.ControlText);
        int right = x + w - 1, bottom = y + h - 1;

        for (int i = x; i <= right; i++)
        {
            if (((i + y) & 1) == 0) { g.FillRectangle(ink, i, y, 1, 1); }
            if (((i + bottom) & 1) == 0) { g.FillRectangle(ink, i, bottom, 1, 1); }
        }
        for (int i = y + 1; i < bottom; i++)
        {
            if (((x + i) & 1) == 0) { g.FillRectangle(ink, x, i, 1, 1); }
            if (((right + i) & 1) == 0) { g.FillRectangle(ink, right, i, 1, 1); }
        }
    }

    /// <summary>
    /// The solid triangle on a scroll arrow, a drop button or a spinner.
    /// `size` is the triangle's height in pixels; four is what Windows
    /// uses everywhere, and the shape is drawn row by row so that it is
    /// the same triangle at every position rather than a scaled one.
    /// </summary>
    public static void DrawArrow(Graphics g, ArrowDirection direction, int x, int y, int size, Color colour)
    {
        Brush ink = new SolidBrush(colour);

        if (direction == ArrowDirection.Down || direction == ArrowDirection.Up)
        {
            int widest = size * 2 - 1;
            for (int row = 0; row < size; row++)
            {
                int width = direction == ArrowDirection.Down ? widest - row * 2 : row * 2 + 1;
                g.FillRectangle(ink, x + (widest - width) / 2, y + row, width, 1);
            }
        }
        else
        {
            int tallest = size * 2 - 1;
            for (int column = 0; column < size; column++)
            {
                int height = direction == ArrowDirection.Right ? tallest - column * 2 : column * 2 + 1;
                g.FillRectangle(ink, x + column, y + (tallest - height) / 2, 1, height);
            }
        }
    }

    /// The tick in a check box: three strokes, drawn rather than written,
    /// because no font on this machine has a check mark in it.
    public static void DrawCheckMark(Graphics g, int x, int y, Color colour)
    {
        Pen ink = new Pen(colour);
        g.DrawLine(ink, x + 0, y + 3, x + 2, y + 5);
        g.DrawLine(ink, x + 0, y + 4, x + 2, y + 6);
        g.DrawLine(ink, x + 2, y + 5, x + 6, y + 1);
        g.DrawLine(ink, x + 2, y + 6, x + 6, y + 2);
    }

    /// <summary>
    /// Text with its mnemonic underlined. `&amp;F` means "F is the letter that
    /// picks this", drawn as F with a line under it; `&amp;&amp;` is a literal
    /// ampersand. When `underline` is false the marker is simply removed,
    /// which is what Windows does until the first Alt is pressed.
    /// </summary>
    public static void DrawStringMnemonic(Graphics g, string text, Font font, Brush brush, int x, int y, bool underline)
    {
        string shown = StripMnemonic(text);
        g.DrawString(shown, font, brush, x, y);

        if (!underline) { return; }

        Underline(g, text, font, brush, x, y);
    }

    /// <summary>
    /// The same, antialiased against `background` -- the colour the
    /// caller just painted behind the text, which every control here
    /// already knows at the point it draws its own label.
    /// </summary>
    public static void DrawStringMnemonic(Graphics g, string text, Font font, Brush brush, Color background, int x, int y, bool underline)
    {
        string shown = StripMnemonic(text);
        g.DrawString(shown, font, brush, background, x, y);

        if (!underline) { return; }

        Underline(g, text, font, brush, x, y);
    }

    static void Underline(Graphics g, string text, Font font, Brush brush, int x, int y)
    {

        int at = MnemonicIndex(text);

        if (at < 0) { return; }

        SolidBrush? solid = brush as SolidBrush;
        Color ink = solid == null ? SystemColors.ControlText : solid.Color;

        // Under the letter itself, wherever the letters before it put it
        // and however wide it is: nothing here is a fixed number of pixels
        // once the face is proportional.
        string shown = StripMnemonic(text);
        int before = font.TextWidth(shown, 0, at);
        int wide = at < shown.Length ? font.TextWidth(shown, at, 1) : 0;

        g.FillRectangle(new SolidBrush(ink), x + before, y + font.Ascent + 1, wide, 1);
    }

    /// `text` without its mnemonic markers.
    public static string StripMnemonic(string text)
    {
        if (text.IndexOf('&') < 0) { return text; }

        string built = "";

        for (int i = 0; i < text.Length; i++)
        {
            if (text[i] == '&' && i + 1 < text.Length) { built = built + text[i + 1]; i++; }
            else if (text[i] != '&') { built = built + text[i]; }
        }
        return built;
    }

    /// Where in the STRIPPED text the underlined letter sits, or -1.
    public static int MnemonicIndex(string text)
    {
        int shown = 0;

        for (int i = 0; i < text.Length; i++)
        {
            if (text[i] == '&' && i + 1 < text.Length)
            {
                if (text[i + 1] == '&') { shown++; i++; continue; }
                return shown;
            }
            if (text[i] != '&') { shown++; }
        }
        return -1;
    }

    /// The letter `text` answers to, in lower case, or nought for none.
    public static char MnemonicOf(string text)
    {
        int at = MnemonicIndex(text);

        if (at < 0) { return '\0'; }

        string shown = StripMnemonic(text);
        char c = shown[at];

        return c >= 'A' && c <= 'Z' ? (char)(c + 32) : c;
    }
}

/// Fires Tick on the message loop every Interval milliseconds while Enabled.
public class Timer
{
    public int Interval = 100;
    public event EventHandler? Tick;
    long _due;
    bool _enabled;
    public bool Enabled { get { return _enabled; } set { if (value) Start(); else Stop(); } }
    public void Start() { if (!_enabled) { _enabled = true; _due = Application.Now() + Interval; Application.AddTimer(this); } }
    public void Stop() { if (_enabled) { _enabled = false; Application.RemoveTimer(this); } }
    internal long Due { get { return _due; } }
    internal void Fire() { _due = Application.Now() + Interval; if (Tick != null) Tick(this, EventArgs.Empty); }
}

public class ControlCollection
{
    List<Control> _items = new List<Control>();
    Control _owner;
    public ControlCollection(Control owner) { _owner = owner; }
    public int Count { get { return _items.Count; } }
    public Control this[int i] { get { return _items[i]; } }
    /// Added controls take their tab order from the order they were added
    /// in, which is what a form built in code expects and what .NET does
    /// when nothing sets TabIndex. Setting it afterwards still wins.
    public void Add(Control c) { c.Parent = _owner; if (c.TabIndex < 0) c.TabIndex = _items.Count; _items.Add(c); c.Invalidate(); }
    public void Insert(int at, Control c) { c.Parent = _owner; if (c.TabIndex < 0) c.TabIndex = at; _items.Insert(at, c); c.Invalidate(); }
    public bool Contains(Control c) { return _items.Contains(c); }
    public int IndexOf(Control c) { return _items.IndexOf(c); }
    public void Clear() { while (_items.Count > 0) Remove(_items[0]); }
    public void Remove(Control c) { _items.Remove(c); c.Parent = null; _owner.Invalidate(); }
    public void AddRange(Control[] cs) { for (int i = 0; i < cs.Length; i++) Add(cs[i]); }
}

public class Control
{
    int _x, _y, _width = 100, _height = 23;
    string _text = "";
    Color _back = SystemColors.Control;
    Color _fore = SystemColors.ControlText;
    Font _font = SystemFonts.DefaultFont;
    bool _visible = true;
    bool _enabled = true;
    Control? _parent;
    ControlCollection? _controls;
    Rectangle _invalid;
    bool _anyInvalid;

    public event EventHandler? Click;
    public event PaintEventHandler? Paint;
    public event MouseEventHandler? MouseDown;
    public event MouseEventHandler? MouseUp;
    public event MouseEventHandler? MouseMove;
    public event EventHandler? MouseEnter;
    public event EventHandler? MouseLeave;
    public event MouseEventHandler? MouseWheel;
    public event EventHandler? DoubleClick;
    public event MouseEventHandler? MouseClick;
    public event MouseEventHandler? MouseDoubleClick;
    public event KeyPressEventHandler? KeyPress;
    public event KeyEventHandler? KeyDown;
    public event EventHandler? GotFocus;
    public event EventHandler? LostFocus;
    public event EventHandler? TextChanged;

    public Control? Parent { get { return _parent; } set { _parent = value; } }
    public ControlCollection Controls { get { if (_controls == null) _controls = new ControlCollection(this); return _controls; } }
    public string Name = "";
    public object? Tag;
    public bool TabStop = true;

    /// Where this control sits in the form's keyboard order. Negative
    /// means "not set": ControlCollection.Add fills it in with the order
    /// things were added, so a form written top to bottom tabs top to
    /// bottom without anybody saying so.
    public int TabIndex = -1;

    /// Whether the keyboard can land here at all. A label, a panel and a
    /// group box say no however TabStop is set; everything a person types
    /// into or presses says yes.
    public virtual bool CanSelect { get { return TabStop && Reachable && !(this is Label) && !(this is Panel) && !(this is GroupBox) && !(this is Form); } }

    /// Shown and enabled ALL THE WAY UP. A control's own flags say nothing
    /// about the page it sits on: everything on a tab page that is not the
    /// one in front is still "visible" by its own account, and the Tab key
    /// walked the focus off into controls nobody could see. The same for a
    /// mnemonic, which otherwise fires a button on a hidden page.
    internal bool Reachable
    {
        get
        {
            for (Control? c = this; c != null; c = c._parent) { if (!c._visible || !c._enabled) return false; }
            return true;
        }
    }

    /// <summary>
    /// Alt was held and `key` was pressed: is that letter mine? A control
    /// whose Text carries `&amp;X` answers to x by doing whatever a click
    /// would do. A label hands it on to the control after it, which is how
    /// "&amp;Name:" in front of a text box puts the caret in the box.
    /// </summary>
    internal virtual bool ProcessMnemonic(char key)
    {
        if (ControlPaint.MnemonicOf(Text) != key) { return false; }

        if (CanSelect) { Focus(); PerformClick(); return true; }

        // A CONTAINER HANDS IT INWARD. "&Colors" on a group box means the
        // thing inside the box, which is the first of its own children
        // the keyboard can land on -- not whatever happens to follow the
        // box on the form.
        if (_controls != null && _controls.Count > 0)
        {
            Control? inside = FirstSelectable(this);
            if (inside != null) { inside.Focus(); return true; }
        }

        // A LABEL PASSES IT ON to the next control that can take it, in
        // tab order, which is the whole reason a label has a mnemonic.
        Control? owner = Parent;

        if (owner == null) { return false; }

        Control? best = null;

        for (int i = 0; i < owner.Controls.Count; i++)
        {
            Control other = owner.Controls[i];

            if (other == this || !other.CanSelect || other.TabIndex < TabIndex) { continue; }
            if (best == null || other.TabIndex < best.TabIndex) { best = other; }
        }

        if (best == null) { return false; }
        best.Focus();
        return true;
    }

    static Control? FirstSelectable(Control root)
    {
        Control? best = null;

        for (int i = 0; i < root.Controls.Count; i++)
        {
            Control child = root.Controls[i];
            Control? found = child.CanSelect ? child : FirstSelectable(child);

            if (found != null && (best == null || child.TabIndex < best.TabIndex)) { best = found; }
        }
        return best;
    }

    /// <summary>
    /// A key the form would otherwise act on -- Enter, Escape, Tab, an
    /// arrow -- offered to the control first. True means the control took
    /// it and the form must not. .NET spells this ProcessDialogKey and so
    /// does this.
    /// </summary>
    internal virtual bool ProcessDialogKey(Keys key, int modifiers) { return false; }

    public virtual string Text { get { return _text; } set { _text = value; OnTextChanged(EventArgs.Empty); Invalidate(); } }
    public Color BackColor { get { return _back; } set { _back = value; Invalidate(); } }

    /// What is really behind this control's own drawing: its own
    /// BackColor, or its parent's when this one is transparent -- the
    /// same lookup every OnPaintBackground here already does, factored
    /// out so text drawing can tell antialiasing what to blend against.
    internal Color EffectiveBackColor { get { return _back == Color.Transparent ? (_parent == null ? SystemColors.Control : _parent.BackColor) : _back; } }
    public Color ForeColor { get { return _fore; } set { _fore = value; Invalidate(); } }
    public Font Font { get { return _font; } set { _font = value; Invalidate(); } }
    public bool Visible { get { return _visible; } set { _visible = value; if (_parent != null) _parent.Invalidate(Bounds); else Invalidate(); } }
    public bool Enabled { get { return _enabled; } set { _enabled = value; Invalidate(); } }
    public int Left { get { return _x; } set { SetBounds(value, _y, _width, _height); } }
    public int Top { get { return _y; } set { SetBounds(_x, value, _width, _height); } }
    public int Width { get { return _width; } set { SetBounds(_x, _y, value, _height); } }
    public int Height { get { return _height; } set { SetBounds(_x, _y, _width, value); } }
    public int Right { get { return _x + _width; } }
    public int Bottom { get { return _y + _height; } }
    public Point Location { get { return new Point(_x, _y); } set { SetBounds(value.X, value.Y, _width, _height); } }
    public Size Size { get { return new Size(_width, _height); } set { SetBounds(_x, _y, value.Width, value.Height); } }
    public Rectangle Bounds { get { return new Rectangle(_x, _y, _width, _height); } set { SetBounds(value.X, value.Y, value.Width, value.Height); } }
    public virtual Rectangle ClientRectangle { get { return new Rectangle(0, 0, _width, _height); } }
    public Size ClientSize { get { return new Size(ClientRectangle.Width, ClientRectangle.Height); } set { SetBounds(_x, _y, value.Width + (_width - ClientRectangle.Width), value.Height + (_height - ClientRectangle.Height)); } }
    public bool Focused { get { return Application.FocusedControl == this; } }

    public event EventHandler? Resize;
    protected virtual void OnResize(EventArgs e) { if (Resize != null) Resize(this, e); }

    public virtual void SetBounds(int x, int y, int w, int h)
    {
        Rectangle old = Bounds;
        bool resized = w != _width || h != _height;
        _x = x; _y = y; _width = w; _height = h;
        if (_parent != null) { _parent.Invalidate(old); _parent.Invalidate(Bounds); }
        Invalidate();
        if (resized) OnResize(EventArgs.Empty);
    }

    /// A new place and nothing else: no repaint. A top-level window that
    /// moves does not change by a pixel -- the seat keeps its picture and
    /// puts it up where it now is -- and repainting every control in it on
    /// every move, which SetBounds does because a CHILD that moves needs
    /// the parent to paint over where it was, is what made a drag crawl on
    /// a machine Windows drags on comfortably.
    internal void Place(int x, int y) { _x = x; _y = y; }

    /// The form this control lives on, which is the window the seat knows.
    public Form? FindForm()
    {
        Control? c = this;
        while (c != null) { if (c is Form f) return f; c = c._parent; }
        return null;
    }

    /// Where this control's origin is, in the form's client coordinates.
    public Point ClientOrigin()
    {
        int x = 0, y = 0;
        Control? c = this;
        while (c != null && !(c is Form)) { x += c._x; y += c._y; c = c._parent; }
        return new Point(x, y);
    }

    public Point PointToScreen(Point p) { Form? f = FindForm(); Point o = ClientOrigin(); return new Point(p.X + o.X + (f == null ? 0 : f.Left), p.Y + o.Y + (f == null ? 0 : f.Top)); }

    public void Invalidate() { Invalidate(ClientRectangle); }
    public void Invalidate(Rectangle r)
    {
        if (!_anyInvalid) { _invalid = r; _anyInvalid = true; }
        else _invalid = Rectangle.Union(_invalid, r);
        Application.NeedsPaint(this);
    }
    public void Refresh() { Invalidate(); Application.PaintNow(); }
    public void Update() { Application.PaintNow(); }
    public void Focus() { Application.SetFocus(this); }
    public void PerformClick() { OnClick(EventArgs.Empty); }
    public void Show() { Visible = true; }
    public void Hide() { Visible = false; }

    public Graphics CreateGraphics()
    {
        Form? f = FindForm(); Point o = ClientOrigin();
        Seat seat = Seat.Current;
        if (f != null) seat.Target(f.Handle);
        Point co = f == null ? new Point(0, 0) : f.ClientOffset();
        return new Graphics(seat, o.X + co.X, o.Y + co.Y, new Rectangle(o.X + co.X, o.Y + co.Y, _width, _height));
    }

    // --- painting --------------------------------------------------------

    /// Paint this control and its children into the form's window, clipped
    /// to what is stale. The background first, then Paint, then children.
    // A line per control painted, when CORSAC_GUI_TRACE is set in the
    // environment. A window that comes up blank on one machine and right on
    // another is not a thing to reason about from the outside.
    static int _trace = -1;

    /// Turn the trace on from the program itself: a shell that cannot put a
    /// variable in front of a command can still pass an argument.
    public static void TracePainting(bool on) { _trace = on ? 1 : 0; }

    internal static bool Tracing
    {
        get
        {
            if (_trace < 0) _trace = (Environment.GetEnvironmentVariable("CORSAC_GUI_TRACE") ?? "") == "" ? 0 : 1;
            return _trace == 1;
        }
    }

    internal void PaintTree(Seat seat, Point origin, Rectangle clip, bool force)
    {
        if (!_visible)
        {
            if (Tracing) Console.WriteLine("paint: " + ClassName + " \"" + Text + "\" skipped: not visible");
            return;
        }
        Rectangle mine = new Rectangle(origin.X, origin.Y, _width, _height);
        Rectangle area = Rectangle.Intersect(mine, clip);
        if (Tracing)
            Console.WriteLine("paint: " + ClassName + " \"" + Text + "\" at " + origin.X + "," + origin.Y
                              + " size " + _width + "x" + _height
                              + " clip " + clip.X + "," + clip.Y + " " + clip.Width + "x" + clip.Height
                              + (area.IsEmpty ? " -- NOTHING LEFT AFTER THE CLIP" : "")
                              + (force ? " forced" : (_anyInvalid ? " invalid" : " clean")));
        if (area.IsEmpty) return;
        bool paintMe = force || _anyInvalid;
        if (paintMe)
        {
            Rectangle local = force ? ClientRectangle : _invalid;
            Rectangle localScreen = new Rectangle(local.X + origin.X, local.Y + origin.Y, local.Width, local.Height);
            Rectangle c = Rectangle.Intersect(area, localScreen);
            if (!c.IsEmpty)
            {
                Graphics g = new Graphics(seat, origin.X, origin.Y, c);
                PaintEventArgs e = new PaintEventArgs(g, new Rectangle(c.X - origin.X, c.Y - origin.Y, c.Width, c.Height));
                OnPaintBackground(e);
                OnPaint(e);
            }
            _anyInvalid = false;
        }
        if (_controls != null)
        {
            for (int i = 0; i < _controls.Count; i++)
            {
                Control child = _controls[i];
                child.PaintTree(seat, new Point(origin.X + child._x, origin.Y + child._y), area, paintMe || force);
            }
        }
    }

    internal bool HasInvalid()
    {
        if (_anyInvalid) return true;
        if (_controls != null) for (int i = 0; i < _controls.Count; i++) if (_controls[i].HasInvalid()) return true;
        return false;
    }

    protected virtual void OnPaintBackground(PaintEventArgs e) { e.Graphics.FillRectangle(new SolidBrush(_back), e.ClipRectangle); }
    protected virtual void OnPaint(PaintEventArgs e) { if (Paint != null) Paint(this, e); }

    // --- input -----------------------------------------------------------

    /// The deepest visible control under a point given in this control's
    /// coordinates. This is the hit test, and it is how a click finds its
    /// handler without anybody polling.
    internal Control HitTest(int x, int y)
    {
        if (_controls != null)
        {
            for (int i = _controls.Count - 1; i >= 0; i--)
            {
                Control c = _controls[i];
                if (c._visible && c.Bounds.Contains(x, y)) return c.HitTest(x - c._x, y - c._y);
            }
        }
        return this;
    }

    /// What a spy tool calls this kind of control.
    internal virtual string ClassName { get { return "Control"; } }

    /// One line about this control, for a spy tool: kind, text, bounds in
    /// the parent, and state.
    internal virtual string Describe()
    {
        string s = ClassName + " \"" + Text + "\" at (" + Left + "," + Top + ") " + Width + "x" + Height;
        if (!Enabled) s = s + " disabled";
        if (!Visible) s = s + " hidden";
        if (Focused) s = s + " focused";
        if (TabStop) s = s + " tabstop";
        return s;
    }

    protected virtual void OnClick(EventArgs e) { if (Click != null) Click(this, e); }
    protected virtual void OnMouseDown(MouseEventArgs e) { if (MouseDown != null) MouseDown(this, e); }
    protected virtual void OnMouseUp(MouseEventArgs e) { if (MouseUp != null) MouseUp(this, e); }
    protected virtual void OnMouseMove(MouseEventArgs e) { if (MouseMove != null) MouseMove(this, e); }
    protected virtual void OnMouseEnter(EventArgs e) { EventHandler? h = MouseEnter; if (h != null) h(this, e); }
    protected virtual void OnMouseLeave(EventArgs e) { EventHandler? h = MouseLeave; if (h != null) h(this, e); }
    /// The wheel. Delta is in Windows' units: 120 per notch, positive for
    /// the wheel rolled away from the hand, which scrolls up.
    protected virtual void OnMouseWheel(MouseEventArgs e) { if (MouseWheel != null) MouseWheel(this, e); }
    protected virtual void OnKeyPress(KeyPressEventArgs e) { if (KeyPress != null) KeyPress(this, e); }
    protected virtual void OnKeyDown(KeyEventArgs e) { if (KeyDown != null) KeyDown(this, e); }
    protected virtual void OnGotFocus(EventArgs e) { if (GotFocus != null) GotFocus(this, e); Invalidate(); }
    protected virtual void OnLostFocus(EventArgs e) { if (LostFocus != null) LostFocus(this, e); Invalidate(); }
    protected virtual void OnTextChanged(EventArgs e) { if (TextChanged != null) TextChanged(this, e); }

    internal void RaiseMouseDown(MouseEventArgs e) { OnMouseDown(e); }
    /// A click is a press and a release on the same control: releasing
    /// outside it, after a change of mind, is not one.
    protected virtual void OnDoubleClick(EventArgs e) { if (DoubleClick != null) DoubleClick(this, e); }
    protected virtual void OnMouseClick(MouseEventArgs e) { if (MouseClick != null) MouseClick(this, e); }
    protected virtual void OnMouseDoubleClick(MouseEventArgs e) { if (MouseDoubleClick != null) MouseDoubleClick(this, e); }

    // A PRESS THAT ENDS ON THE CONTROL IS A CLICK, and the second press of a
    // double-click makes it a double-click instead (e.Clicks == 2), as
    // Windows Forms raises them: DoubleClick and MouseDoubleClick in place of
    // Click and MouseClick. Click is the primary button's; MouseClick and the
    // double-clicks are any button's.
    internal void RaiseMouseUp(MouseEventArgs e)
    {
        OnMouseUp(e);
        if (!Enabled || e.X < 0 || e.Y < 0 || e.X >= Width || e.Y >= Height) return;
        if (e.Clicks >= 2) { OnDoubleClick(e); OnMouseDoubleClick(e); return; }
        if (e.Button == MouseButtons.Left) OnClick(EventArgs.Empty);
        OnMouseClick(e);
    }
    internal void RaiseMouseMove(MouseEventArgs e) { OnMouseMove(e); }
    internal void RaiseMouseEnter() { OnMouseEnter(EventArgs.Empty); }
    internal void RaiseMouseLeave() { OnMouseLeave(EventArgs.Empty); }
    internal void RaiseMouseWheel(MouseEventArgs e) { OnMouseWheel(e); }

    // PIECES OF A NOTCH ARE KEPT. A high-resolution wheel sends a notch in
    // several deltas smaller than 120, and what the WM_MOUSEWHEEL
    // documentation tells every Windows program to do is add them up and act
    // on whole amounts. So a control scrolls by these, never by Delta / 120.
    int _wheelRest, _hwheelRest;

    /// Whole notches in `delta`, the rest kept for the next one.
    internal int WheelNotches(int delta, bool horizontal)
    {
        int total = (horizontal ? _hwheelRest : _wheelRest) + delta;
        int notches = total / 120;
        if (horizontal) _hwheelRest = total - notches * 120; else _wheelRest = total - notches * 120;
        return notches;
    }

    /// Lines to scroll for `delta`, positive up: the user's lines a notch
    /// (SystemInformation.MouseWheelScrollLines), or `page` lines a notch
    /// when that is Windows' WHEEL_PAGESCROLL. Pieces of a line are kept.
    internal int WheelLines(int delta, int page, bool horizontal)
    {
        int each = horizontal ? SystemInformation.MouseWheelScrollChars : SystemInformation.MouseWheelScrollLines;
        if (each < 0) each = page > 0 ? page : 1;
        if (each == 0) return 0;
        int total = (horizontal ? _hwheelRest : _wheelRest) + delta * each;
        int lines = total / 120;
        if (horizontal) _hwheelRest = total - lines * 120; else _wheelRest = total - lines * 120;
        return lines;
    }

    /// The horizontal wheel: WM_MOUSEHWHEEL, 120 a notch, positive to the
    /// right. Windows Forms has no public event for it; ScrollableControl
    /// handles the message itself, and controls that scroll sideways
    /// override this.
    protected virtual void OnMouseHWheel(MouseEventArgs e) { }
    internal void RaiseMouseHWheel(MouseEventArgs e) { OnMouseHWheel(e); }
    internal void RaiseKeyPress(KeyPressEventArgs e) { OnKeyPress(e); }
    internal void RaiseKeyDown(KeyEventArgs e) { OnKeyDown(e); }
    internal void RaiseGotFocus() { OnGotFocus(EventArgs.Empty); }
    internal void RaiseLostFocus() { OnLostFocus(EventArgs.Empty); }

    /// The window procedure. Everything above is what it does by default;
    /// a program that wants the raw message overrides this.
    protected virtual void WndProc(ref Message m) { }
    internal void DispatchRaw(ref Message m) { WndProc(ref m); }
}

public enum FormBorderStyle { None = 0, FixedSingle = 1, Sizable = 4, FixedDialog = 3 }

public enum DialogResult { None = 0, OK = 1, Cancel = 2, Abort = 3, Retry = 4, Ignore = 5, Yes = 6, No = 7 }
public enum MessageBoxButtons { OK = 0, OKCancel = 1, AbortRetryIgnore = 2, YesNoCancel = 3, YesNo = 4, RetryCancel = 5 }
public enum MessageBoxIcon { None = 0, Error = 16, Hand = 16, Stop = 16, Question = 32, Exclamation = 48, Warning = 48, Asterisk = 64, Information = 64 }
public enum FormWindowState { Normal = 0, Minimized = 1, Maximized = 2 }
public enum FormStartPosition { Manual = 0, CenterScreen = 1, WindowsDefaultLocation = 2 }

/// A top-level window the seat knows by handle. The frame, meaning the
/// title bar and the border, is painted here for now; it is the seat's job
/// once the window tree lives in the system, and the client area contract
/// does not change when it moves.
public class Form : Control
{
    int _handle;
    bool _shown;
    bool _closed;
    FormBorderStyle _border = FormBorderStyle.Sizable;
    FormWindowState _state = FormWindowState.Normal;
    public FormStartPosition StartPosition = FormStartPosition.WindowsDefaultLocation;
    public const int CaptionHeight = 22;      // the bar under the top border, title and close button
    public const int BorderWidth = 4;         // two bevel pixels and two of face on every side

    public event EventHandler? Load;

    /// <summary>
    /// The display changed size. A form that was filling the screen is the
    /// one that has to care: a desktop, or a bar along the bottom.
    /// </summary>
    public event EventHandler? ScreenChanged;

    internal void RaiseScreenChanged()
    {
        EventHandler? h = ScreenChanged;
        if (h != null) { h(this, EventArgs.Empty); }
    }
    public event FormClosingEventHandler? FormClosing;
    public event EventHandler? FormClosed;
    public event EventHandler? Activated;
    public event EventHandler? Deactivate;

    public Form() { Width = 320; Height = 240; BackColor = SystemColors.Control; }

    public int Handle { get { return _handle; } }
    internal override string ClassName { get { return "Form"; } }
    public FormBorderStyle FormBorderStyle { get { return _border; } set { _border = value; Invalidate(); } }
    public FormWindowState WindowState { get { return _state; } set { _state = value; if (value == FormWindowState.Maximized) SetBounds(0, 0, Seat.Current.Width, Seat.Current.Height); } }
    public bool IsClosed { get { return _closed; } }
    /// What a dialog answered: set by the button that closed it (see
    /// Button.DialogResult) and read back by whoever called ShowDialog.
    public DialogResult DialogResult = DialogResult.None;

    /// <summary>
    /// The button Enter presses and the button Escape presses. The accept
    /// button also wears the black ring that says so. A dialog that sets
    /// these two needs no key handling of its own, which is the point.
    /// </summary>
    public Button? AcceptButton
    {
        get { return _accept; }
        set { if (_accept != null) _accept.NotDefault(); _accept = value; if (value != null) value.MakeDefault(); Invalidate(); }
    }
    Button? _accept;
    public Button? CancelButton;

    /// Shows the form and runs the message loop until it closes; what
    /// it returns is the form's DialogResult. Other windows keep taking
    /// input meanwhile -- the loop is the same loop -- which is enough for
    /// a message box and will grow a proper modal state when a dialog
    /// needs to shut its owner out.
    public DialogResult ShowDialog() { return Application.RunModal(this); }
    /// The desktop is a surface of its own kind: it sits under every other
    /// window and a click on it never raises it. Corsac.GUI.Shell.MakeDesktop
    /// sets it, before Show.
    internal bool DesktopSurface;
    /// Above every ordinary window, like a taskbar. Set before Show.
    bool _topMost;
    public bool TopMost
    {
        get { return _topMost; }
        set { _topMost = value; if (_handle != 0) Seat.Current.TopMostWindow(_handle, value); }
    }
    /// Listed on the taskbar. TRUE, AND LEAVE IT: the taskbar is the
    /// system's, and every window a person opened belongs on it. The
    /// library's own transient windows (a menu) set this false; a program
    /// that does so hides itself from the person using it, which is nearly
    /// always wrong. Live, like every property: flipped on a shown window,
    /// the button appears or goes at once.
    bool _showInTaskbar = true;
    public bool ShowInTaskbar
    {
        get { return _showInTaskbar; }
        set { _showInTaskbar = value; if (_handle != 0) Seat.Current.ListOnTaskbar(_handle, value); }
    }
    public bool HasFrame { get { return _border != FormBorderStyle.None; } }

    public override Rectangle ClientRectangle
    {
        get
        {
            if (!HasFrame) return new Rectangle(0, 0, Width, Height);
            return new Rectangle(0, 0, Width - 2 * BorderWidth, Height - CaptionHeight - 2 * BorderWidth);
        }
    }

    /// Where the client area starts inside the window.
    public Point ClientOffset() { return HasFrame ? new Point(BorderWidth, CaptionHeight + BorderWidth) : new Point(0, 0); }

    /// The close button, in window coordinates.
    /// Whether the caption carries the close box at all. A window that the
    /// person is not meant to dismiss -- a login screen, say -- has none,
    /// and there is then nothing to press and nothing to draw.
    public bool ControlBox = true;

    /// The picture at the left of the caption, and the one the taskbar
    /// shows for this window.
    public Icon? Icon { get { return _icon; } set { _icon = value; FrameChanged(); } }
    Icon? _icon;

    Rectangle CloseBox()
    {
        if (!ControlBox) return Rectangle.Empty;
        return new Rectangle(Width - BorderWidth - 18, BorderWidth + 2, 16, CaptionHeight - 6);
    }

    public override void SetBounds(int x, int y, int w, int h)
    {
        bool moved = x != Left || y != Top, resized = w != Width || h != Height;
        if (resized) base.SetBounds(x, y, w, h);          // a new size is a new picture: repaint
        else if (moved) Place(x, y);                     // a new place is the same picture: no repaint
        if (_handle != 0 && resized) Seat.Current.ResizeWindow(_handle, w, h);
        if (_handle != 0 && moved) Seat.Current.MoveWindow(_handle, x, y);
    }

    /// The edges a press on a sizable frame takes hold of: 1 left, 2 right,
    /// 4 top, 8 bottom; a corner is two of them. The band is the border
    /// plus a couple of pixels, which is what a hand finds.
    int ResizeEdges(int x, int y)
    {
        if (FormBorderStyle != FormBorderStyle.Sizable) return 0;
        const int Band = BorderWidth + 2;
        int edges = 0;
        if (x < Band) edges |= 1; else if (x >= Width - Band) edges |= 2;
        if (y < Band) edges |= 4; else if (y >= Height - Band) edges |= 8;
        return edges;
    }
    public const int MinimumWidth = 120, MinimumHeight = 60;

    /// The shape that says what those edges will move.
    internal static int CursorFor(int edges)
    {
        if (edges == (1 | 4) || edges == (2 | 8)) return Cursors.SizeNWSE;
        if (edges == (2 | 4) || edges == (1 | 8)) return Cursors.SizeNESW;
        if ((edges & 3) != 0) return Cursors.SizeWE;
        if ((edges & 12) != 0) return Cursors.SizeNS;
        return Cursors.Arrow;
    }

    public new void Show()
    {
        if (_shown) return;
        Invalidate();
        Seat seat = Seat.Current;
        if (StartPosition == FormStartPosition.CenterScreen)
            base.SetBounds((seat.Width - Width) / 2, (seat.Height - Height) / 2, Width, Height);
        else if (StartPosition == FormStartPosition.WindowsDefaultLocation && _state != FormWindowState.Maximized)
        {
            // A maximized form has its place already: the whole screen. The
            // cascade once moved the desktop a step down and right, and put
            // its bar below the bottom edge.
            Point at = Application.NextCascade(Width, Height, seat.Width, seat.WorkAreaHeight());
            base.SetBounds(at.X, at.Y, Width, Height);
        }
        _handle = seat.CreateWindow(Left, Top, Width, Height);
        seat.SetTitle(_handle, Text);
        if (DesktopSurface) seat.DesktopWindow(_handle);
        if (TopMost) seat.TopMostWindow(_handle, true);
        if (!ShowInTaskbar) seat.ListOnTaskbar(_handle, false);
        _shown = true;

        // A WINDOW THAT MERELY APPEARS. A tooltip is a form like any
        // other as far as the seat knows, and shown like any other it
        // took the activation, the keyboard and the focus -- so the
        // dialog under it went inactive and a drag in progress died the
        // moment its own tip came up. WinForms' name for the way out is
        // ShowWithoutActivation, and it means what it says.
        if (ShowWithoutActivation)
        {
            Application.RegisterQuietly(this);
            OnLoad(EventArgs.Empty);
            seat.ShowWindow(_handle);
            Invalidate();
            return;
        }

        Application.Register(this);
        OnLoad(EventArgs.Empty);
        seat.ShowWindow(_handle);
        Invalidate();
        Application.SetFocus(FirstFocusable(this) ?? this);
        seat.FocusWindow(_handle);
    }

    /// True for a window that is shown without being made the active one:
    /// it takes no focus, no keyboard and no activation from whatever had
    /// them. Overridden by the few that want it.
    protected virtual bool ShowWithoutActivation { get { return false; } }
    internal bool StaysInactive { get { return ShowWithoutActivation; } }

    static Control? FirstFocusable(Control c)
    {
        for (int i = 0; i < c.Controls.Count; i++)
        {
            Control k = c.Controls[i];
            if (k.Visible && k.Enabled && k.TabStop && !(k is Label) && !(k is Panel)) return k;
            Control? deeper = FirstFocusable(k);
            if (deeper != null) return deeper;
        }
        return null;
    }

    public void Close()
    {
        if (_closed) return;
        FormClosingEventArgs e = new FormClosingEventArgs();
        OnFormClosing(e);
        if (e.Cancel) return;
        _closed = true;
        Application.Unregister(this);
        if (_handle != 0) Seat.Current.DestroyWindow(_handle);
        _handle = 0;
        OnFormClosed(EventArgs.Empty);
    }

    public void Activate() { if (_handle != 0) { Seat.Current.RaiseWindow(_handle); Seat.Current.FocusWindow(_handle); } }

    protected virtual void OnLoad(EventArgs e) { if (Load != null) Load(this, e); }
    protected virtual void OnFormClosing(FormClosingEventArgs e) { if (FormClosing != null) FormClosing(this, e); }
    protected virtual void OnFormClosed(EventArgs e) { if (FormClosed != null) FormClosed(this, e); }
    protected virtual void OnActivated(EventArgs e) { if (Activated != null) Activated(this, e); }
    // Gaining or losing the focus changes the caption and nothing else, so
    // only the frame is asked for. Invalidating the form invalidated its
    // whole client area, and a terminal repainting its black background and
    // every cell on each focus change is the flash that came of it.
    internal void RaiseActivated() { FrameChanged(); OnActivated(EventArgs.Empty); }
    protected virtual void OnDeactivate(EventArgs e) { if (Deactivate != null) Deactivate(this, e); }
    internal void RaiseDeactivate() { FrameChanged(); OnDeactivate(EventArgs.Empty); }

    void FrameChanged() { _frameDirty = true; Application.NeedsPaint(this); }

    // The caption changes colour when the window gains or loses the focus,
    // and its text when Text is set; an ordinary repaint of the client tree
    // would not touch the frame, so those mark it and the next paint draws it.
    bool _frameDirty;

    /// The title, kept by the seat too once the window exists.
    public override string Text { get { return base.Text; } set { base.Text = value; if (_handle != 0) Seat.Current.SetTitle(_handle, value); FrameChanged(); } }

    /// Paint the whole window: the frame, then the client tree.
    internal void PaintWindow(Rectangle clip, bool force)
    {
        if (_handle == 0) return;
        Seat seat = Seat.Current;
        seat.Target(_handle);
        if (HasFrame && (force || _frameDirty))
        {
            _frameDirty = false;
            // Within the clip, like everything else (see Compose in the seat).
            Graphics g = new Graphics(seat, 0, 0, Rectangle.Intersect(clip, new Rectangle(0, 0, Width, Height)));
            bool active = Application.ActiveForm == this;
            Color face = SystemColors.Control;
            int w = Width, h = Height;
            // THE FRAME ONLY, never over the client. Filling the whole window
            // here washed the program's own painting away and left it grey
            // until something forced a full repaint -- on every focus change,
            // which is the flash that was in the terminal, and an empty
            // window until it was dragged.
            Point frameCo = ClientOffset();
            int clientW = ClientRectangle.Width, clientH = ClientRectangle.Height;
            SolidBrush faceBrush = new SolidBrush(face);
            g.FillRectangle(faceBrush, 0, 0, w, frameCo.Y);                                  // caption and the top border
            g.FillRectangle(faceBrush, 0, frameCo.Y + clientH, w, h - frameCo.Y - clientH);  // the bottom border
            g.FillRectangle(faceBrush, 0, frameCo.Y, frameCo.X, clientH);                    // the left border
            g.FillRectangle(faceBrush, frameCo.X + clientW, frameCo.Y, w - frameCo.X - clientW, clientH);
            // THE FRAME IS TWO BEVELS, not one: a thin raised rim around
            // the outside and a second one just inside it. That is what
            // gives a window of this era its depth, and it is why the
            // border is four pixels rather than two.
            ControlPaint.DrawBorder3D(g, 0, 0, w, h, Border3DStyle.RaisedOuter);
            ControlPaint.DrawBorder3D(g, 1, 1, w - 2, h - 2, Border3DStyle.RaisedInner);

            int cx = BorderWidth, cy = BorderWidth, cw = w - 2 * BorderWidth, ch = CaptionHeight - 2;

            // THE CAPTION IS A GRADIENT ONLY WHERE THERE ARE COLOURS FOR
            // ONE. Windows 98 shipped the gradient on and turned it off on
            // a 256-colour display, and it was right to: this palette has
            // six levels per channel, so a ramp across it comes out as
            // five hard steps, which looks worse than the flat navy the
            // era used before it. Flat below 256 colours, gradient above.
            Color from = active ? SystemColors.ActiveCaption : SystemColors.InactiveCaption;
            Color to = active ? SystemColors.GradientActiveCaption : SystemColors.GradientInactiveCaption;

            if (Seat.Current.Colours <= 256) { g.FillRectangle(new SolidBrush(from), cx, cy, cw, ch); }
            else
            {
                // Bands of four pixels: at this width the banding is
                // invisible and it is a few hundred operations instead of
                // a few thousand.
                const int Band = 4;

                for (int at = 0; at < cw; at += Band)
                {
                    int width = at + Band > cw ? cw - at : Band;
                    g.FillRectangle(new SolidBrush(ColorBlend.Mix(from, to, cw <= 1 ? 0 : at * 256 / cw)), cx + at, cy, width, ch);
                }
            }

            Color title = active ? SystemColors.ActiveCaptionText : SystemColors.InactiveCaptionText;
            int titleX = cx + 4;

            // The window's own icon sits at the left of its caption.
            if (_icon != null) { _icon.Draw(g, titleX, cy + (ch - 16) / 2, 16); titleX += 18; }

            // The caption font is the interface face's own bold. The colour
            // behind it is the caption's left-hand colour, which under a
            // gradient is very nearly what is behind a title that starts at
            // the left -- near enough that the blended rim does not show.
            Font captionFont = SystemFonts.CaptionFont;
            g.DrawString(Text, captionFont, new SolidBrush(title), from, titleX, cy + (ch - captionFont.Height) / 2);

            Rectangle close = CloseBox();
            if (!close.IsEmpty)
            {
                bool held = _closeDown && _closeHot;
                ControlPaint.DrawButtonFace(g, close.X, close.Y, close.Width, close.Height, held, false, face);

                // THE CROSS IS SIX BY SIX, drawn as two strokes a pixel
                // thick each way, which at this size is the shape Windows
                // drew and is legible where a thinner one is not.
                Pen ink = new Pen(SystemColors.ControlText);
                int press = held ? 1 : 0;
                int lx = close.X + (close.Width - 7) / 2 + press, ly = close.Y + (close.Height - 7) / 2 + press;
                g.DrawLine(ink, lx, ly, lx + 6, ly + 6); g.DrawLine(ink, lx + 1, ly, lx + 7, ly + 6);
                g.DrawLine(ink, lx, ly + 6, lx + 6, ly); g.DrawLine(ink, lx + 1, ly + 6, lx + 7, ly);
            }
        }
        Point co = ClientOffset();
        Rectangle client = new Rectangle(co.X, co.Y, ClientRectangle.Width, ClientRectangle.Height);
        PaintTree(seat, co, force ? client : Rectangle.Intersect(client, new Rectangle(0, 0, Width, Height)), force);
    }

    // The close box is held down, waiting to see where the button comes up.
    bool _closeDown;

    /// The close box, and the caption a drag starts on. Nothing acts on the
    /// press: a button pressed and released is a decision, a button pressed
    /// and dragged away is a change of mind, which is how every other button
    /// on the screen behaves and how Windows behaves.
    void FrameMouse(int kind, int button, int x, int y, Point co)
    {
        Rectangle box = CloseBox();
        bool over = !box.IsEmpty && box.Contains(x, y);
        if (kind == 4 && button == 1 && over) { _closeDown = true; _closeHot = true; FrameChanged(); return; }
        if (kind == 3 && _closeDown) { if (over != _closeHot) { _closeHot = over; FrameChanged(); } return; }
        if (kind == 5 && _closeDown)
        {
            _closeDown = false; FrameChanged();
            if (over) Close();
            return;
        }
        if (kind == 4 && button == 1 && y < co.Y) Application.BeginDrag(this, x, y);
    }
    bool _closeHot;

    /// A press in the window: the close box, the caption, or the client.
    internal void WindowMouse(int kind, int button, int x, int y)
    {
        Point co = ClientOffset();
        // A control holding the button gets everything until it comes up,
        // even where the pointer has left the window altogether.
        if (kind != 4 && Application.Captured != null) { ClientMouse(kind, button, x, y, co); return; }
        if (HasFrame && kind == 4 && button == 1)
        {
            int edges = ResizeEdges(x, y);
            if (edges != 0) { Application.BeginResize(this, edges, x, y); return; }
        }
        if (HasFrame && (y < co.Y || x < co.X || x >= co.X + ClientRectangle.Width || y >= co.Y + ClientRectangle.Height))
        {
            // Over the frame with no button held: the pointer says what the
            // edge under it would do, the way Windows does.
            if (kind == 3 && Application.Captured == null && !_closeDown) Seat.Current.SetCursor(CursorFor(ResizeEdges(x, y)));
            FrameMouse(kind, button, x, y, co);
            return;
        }
        if (_closeDown) { FrameMouse(kind, button, x, y, co); if (kind != 5) return; }
        if (kind == 3 && HasFrame && Application.Captured == null) Seat.Current.SetCursor(Cursors.Arrow);
        ClientMouse(kind, button, x, y, co);
    }

    /// The press, move or release, in the client's own coordinates.
    void ClientMouse(int kind, int button, int x, int y, Point co)
    {
        int cx = x - co.X, cy = y - co.Y;
        Control target = HitTest(cx, cy);
        // While a button is held the control that took the press gets every
        // event, in ITS coordinates, wherever the pointer has gone since.
        Control to = kind == 4 ? target : (Application.Captured ?? target);
        Point origin = to.ClientOrigin();
        MouseButtons b = Application.ButtonOf(button);
        int clicks = kind == 4 ? Application.CountClick(target, b, x, y) : kind == 5 ? Application.LastClicks : 0;
        MouseEventArgs e = new MouseEventArgs(b, clicks, cx - origin.X, cy - origin.Y, 0);
        if (kind == 4)
        {
            if (target is TextBox box) box.FocusByClick();
            if (target.CanSelect) Application.SetFocus(target);
            target.RaiseMouseDown(e);
            Application.Captured = target;
        }
        else if (kind == 5) { Application.Captured = null; to.RaiseMouseUp(e); }
        else { Application.Hover(to); to.RaiseMouseMove(e); }
    }
}

/// The message box: a caption, a line or several of text, an icon if
/// asked for, and the buttons the question needs, centred on the screen
/// and answered by whichever button was pressed. Windows' API, so a
/// program written for it needs no changes; drawn with what is here.
/// <summary>
/// The display, as .NET describes it: Screen.PrimaryScreen.Bounds is the
/// whole of it and WorkingArea is what is left once a taskbar has taken
/// its rows.
/// </summary>
public class Screen
{
    Screen() { }

    static readonly Screen _primary = new Screen();

    public static Screen PrimaryScreen { get { return _primary; } }

    public static Screen[] AllScreens { get { return new Screen[] { _primary }; } }

    public Rectangle Bounds { get { return new Rectangle(0, 0, Seat.Current.Width, Seat.Current.Height); } }

    public Rectangle WorkingArea { get { return new Rectangle(0, 0, Seat.Current.Width, Seat.Current.WorkAreaHeight()); } }

    public string DeviceName { get { return "seat0"; } }

    public bool Primary { get { return true; } }

    /// <summary>The mode changed. .NET raises SystemEvents.DisplaySettingsChanged
    /// for this; the name here says which display it was.</summary>
    public static event EventHandler? DisplaySettingsChanged;

    internal static void RaiseChanged()
    {
        EventHandler? h = DisplaySettingsChanged;
        if (h != null) { h(_primary, EventArgs.Empty); }
    }
}

/// <summary>The sizes a program lays itself out against, and the system's
/// settings a program reads, as .NET names them. The mouse's come from the
/// seat, which reads them per user under Windows' value names
/// (GetSystemMetrics and SystemParametersInfo underneath, with Windows'
/// indices); without a seat, Windows' own defaults.</summary>
public static class SystemInformation
{
    // An error from a kernel that does not know the question is below -1
    // (-1 itself is an answer: WHEEL_PAGESCROLL), and a program with no seat
    // gets Windows' defaults too.
    static int Metric(int index, int fallback)
    {
        try { int got = Seat.Current.SystemMetric(index); return got < -1 ? fallback : got; }
        catch (IOException) { return fallback; }
    }

    static int Parameter(int action, int fallback)
    {
        try { int got = Seat.Current.ParameterInfo(action); return got < -1 ? fallback : got; }
        catch (IOException) { return fallback; }
    }

    /// Milliseconds two presses may be apart and still be a double-click.
    public static int DoubleClickTime { get { return Parameter(0x10001, 500); } }
    /// How far apart they may be.
    public static Size DoubleClickSize { get { return new Size(Metric(36, 4), Metric(37, 4)); } }
    /// How far a press must move before it is a drag.
    public static Size DragSize { get { return new Size(Metric(68, 4), Metric(69, 4)); } }
    public static bool MousePresent { get { return Metric(19, 1) != 0; } }
    public static bool MouseButtonsSwapped { get { return Metric(23, 0) != 0; } }
    public static int MouseButtons { get { return Metric(43, 3); } }
    public static bool MouseWheelPresent { get { return Metric(75, 1) != 0; } }
    /// Lines a notch; -1 is a screen a notch, Windows' WHEEL_PAGESCROLL.
    public static int MouseWheelScrollLines { get { return Parameter(0x68, 3); } }
    /// Columns a notch of the tilt wheel (SPI_GETWHEELSCROLLCHARS).
    public static int MouseWheelScrollChars { get { return Parameter(0x6C, 3); } }
    /// A notch: WHEEL_DELTA.
    public static int MouseWheelScrollDelta { get { return 120; } }
    /// The speed slider, 1 to 20.
    public static int MouseSpeed { get { return Parameter(0x70, 10); } }
    public static bool IsListBoxSmoothScrollingEnabled { get { return Parameter(0x1006, 1) != 0; } }
    public static int MouseHoverTime { get { return 400; } }
    public static Size MouseHoverSize { get { return new Size(4, 4); } }

    // CORSAC's own, which Windows had no name for.
    /// Middle-button autoscroll, as IE and Office did it (on by default).
    internal static bool MiddleButtonAutoScroll { get { return Parameter(0x10003, 1) != 0; } }
    /// Grab-and-drag on linear views instead of speed by distance (off).
    internal static bool AutoScrollGrab { get { return Parameter(0x10004, 0) != 0; } }

    public static Size PrimaryMonitorSize { get { return new Size(Seat.Current.Width, Seat.Current.Height); } }

    public static Rectangle WorkingArea { get { return Screen.PrimaryScreen.WorkingArea; } }

    public static Rectangle VirtualScreen { get { return Screen.PrimaryScreen.Bounds; } }

    internal static void Rescreen() { }
}

public static class MessageBox
{
    public static DialogResult Show(string text) { return Show(text, "", MessageBoxButtons.OK, MessageBoxIcon.None); }
    public static DialogResult Show(string text, string caption) { return Show(text, caption, MessageBoxButtons.OK, MessageBoxIcon.None); }
    public static DialogResult Show(string text, string caption, MessageBoxButtons buttons) { return Show(text, caption, buttons, MessageBoxIcon.None); }
    public static DialogResult Show(string text, string caption, MessageBoxButtons buttons, MessageBoxIcon icon)
    {
        Form box = Build(text, caption, buttons, icon);
        return box.ShowDialog();
    }
    public static DialogResult Show(IWin32Window? owner, string text, string caption) { return Show(text, caption); }
    public static DialogResult Show(IWin32Window? owner, string text, string caption, MessageBoxButtons buttons, MessageBoxIcon icon) { return Show(text, caption, buttons, icon); }

    const int Margin = 12, IconSize = 32, ButtonW = 75, ButtonH = 23, Gap = 8;

    /// The box as a form, laid out and not yet shown.
    internal static Form Build(string text, string caption, MessageBoxButtons buttons, MessageBoxIcon icon)
    {
        Form box = new Form();
        box.Text = caption;
        box.FormBorderStyle = FormBorderStyle.FixedDialog;
        box.StartPosition = FormStartPosition.CenterScreen;
        Font font = box.Font;

        // The text's extent: the longest line and the number of lines.
        int lines = 1, longest = 0, run = 0;
        for (int i = 0; i < text.Length; i++)
        {
            if (text[i] == '\n') { if (run > longest) longest = run; run = 0; lines++; }
            else run++;
        }
        if (run > longest) longest = run;
        int textW = TextRenderer.MeasureText(text, font).Width, textH = lines * font.Height;

        string[] names = Names(buttons);
        int buttonsW = names.Length * ButtonW + (names.Length - 1) * Gap;
        int iconW = icon == MessageBoxIcon.None ? 0 : IconSize + Margin;
        int clientW = Margin + iconW + textW + Margin;
        if (clientW < buttonsW + 2 * Margin) clientW = buttonsW + 2 * Margin;
        if (clientW < 200) clientW = 200;
        int limit = Seat.Current.Width - 40;
        if (clientW > limit) clientW = limit;
        int bodyH = textH > IconSize ? textH : IconSize;
        int clientH = Margin + bodyH + Margin + ButtonH + Margin;
        box.ClientSize = new Size(clientW, clientH);

        if (icon != MessageBoxIcon.None)
        {
            MessageIcon picture = new MessageIcon(icon);
            picture.SetBounds(Margin, Margin, IconSize, IconSize);
            box.Controls.Add(picture);
        }
        Label body = new Label();
        body.AutoSize = false;
        body.Text = text;
        body.SetBounds(Margin + iconW, Margin, clientW - Margin - iconW - Margin, bodyH);
        box.Controls.Add(body);

        int x = (clientW - buttonsW) / 2, y = clientH - Margin - ButtonH;
        for (int i = 0; i < names.Length; i++)
        {
            Button b = new Button();
            b.Text = names[i];
            b.DialogResult = ResultOf(names[i]);
            b.SetBounds(x, y, ButtonW, ButtonH);
            box.Controls.Add(b);
            // THE FIRST BUTTON IS THE DEFAULT and a Cancel, where there is
            // one, is what Escape presses. A message box then answers to
            // Enter and Escape without anybody wiring it up.
            if (i == 0) { box.AcceptButton = b; b.Focus(); }
            if (b.DialogResult == DialogResult.Cancel) box.CancelButton = b;
            x += ButtonW + Gap;
        }
        // No Cancel on it: Escape still shuts it, as Windows lets it.
        if (box.CancelButton == null && names.Length == 1) box.CancelButton = (Button)box.Controls[box.Controls.Count - 1];
        // Closing the box by its corner is a Cancel where there is one,
        // and otherwise the answer of its only or last button.
        box.FormClosed += (sender, e) =>
        {
            if (box.DialogResult == DialogResult.None)
                box.DialogResult = HasCancel(buttons) ? DialogResult.Cancel : ResultOf(names[names.Length - 1]);
        };
        return box;
    }

    static string[] Names(MessageBoxButtons buttons)
    {
        if (buttons == MessageBoxButtons.OKCancel) return new string[] { "OK", "Cancel" };
        if (buttons == MessageBoxButtons.AbortRetryIgnore) return new string[] { "Abort", "Retry", "Ignore" };
        if (buttons == MessageBoxButtons.YesNoCancel) return new string[] { "Yes", "No", "Cancel" };
        if (buttons == MessageBoxButtons.YesNo) return new string[] { "Yes", "No" };
        if (buttons == MessageBoxButtons.RetryCancel) return new string[] { "Retry", "Cancel" };
        return new string[] { "OK" };
    }
    static bool HasCancel(MessageBoxButtons buttons)
    {
        return buttons == MessageBoxButtons.OKCancel || buttons == MessageBoxButtons.YesNoCancel || buttons == MessageBoxButtons.RetryCancel;
    }
    static DialogResult ResultOf(string name)
    {
        if (name == "OK") return DialogResult.OK;
        if (name == "Cancel") return DialogResult.Cancel;
        if (name == "Abort") return DialogResult.Abort;
        if (name == "Retry") return DialogResult.Retry;
        if (name == "Ignore") return DialogResult.Ignore;
        if (name == "Yes") return DialogResult.Yes;
        return DialogResult.No;
    }
}

/// <summary>
/// .NET's TextRenderer, the measuring half: how big a piece of text comes
/// out in a font, without needing a Graphics to ask.
/// </summary>
public static class TextRenderer
{
    public static Size MeasureText(string text, Font font)
    {
        int widest = 0, lines = 1, start = 0;

        for (int i = 0; i <= text.Length; i++)
        {
            if (i < text.Length && text[i] != '\n') { continue; }

            int wide = font.TextWidth(text, start, i - start);
            if (wide > widest) { widest = wide; }
            if (i < text.Length) { lines++; }
            start = i + 1;
        }
        return new Size(widest, lines * font.Height);
    }
}

/// A window handle, as .NET names an owner. Nothing here needs one; the
/// overloads that take it exist so a call written for Windows compiles.
public interface IWin32Window { }

/// The four pictures a message box can carry, drawn: a red disc with a
/// cross, a blue disc with a question mark, a yellow triangle with a
/// bang, a blue disc with an i. Thirty-two pixels, as Windows draws them.
class MessageIcon : Control
{
    readonly MessageBoxIcon _kind;
    public MessageIcon(MessageBoxIcon kind) { _kind = kind; TabStop = false; BackColor = SystemColors.Control; }
    internal override string ClassName { get { return "MessageIcon"; } }
    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int w = Width, h = Height;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, w, h);
        if (_kind == MessageBoxIcon.Warning)
        {
            // A triangle, filled by rows.
            SolidBrush yellow = new SolidBrush(Color.FromArgb(255, 255, 0));
            for (int y = 2; y < h - 2; y++)
            {
                int half = (y - 2) * (w / 2 - 2) / (h - 4);
                g.FillRectangle(yellow, w / 2 - half, y, half * 2 + 1, 1);
            }
            Pen edge = new Pen(Color.Black);
            g.DrawLine(edge, w / 2, 2, 2, h - 3); g.DrawLine(edge, w / 2, 2, w - 3, h - 3); g.DrawLine(edge, 2, h - 3, w - 3, h - 3);
            g.FillRectangle(new SolidBrush(Color.Black), w / 2 - 1, 10, 3, 12);
            g.FillRectangle(new SolidBrush(Color.Black), w / 2 - 1, 24, 3, 3);
            return;
        }
        // A disc, filled by rows.
        Color fill = _kind == MessageBoxIcon.Error ? Color.FromArgb(200, 0, 0) : Color.FromArgb(0, 0, 180);
        SolidBrush disc = new SolidBrush(fill);
        int r = w / 2 - 1, cx = w / 2, cy = h / 2;
        for (int y = -r; y <= r; y++)
        {
            int dx = 0;
            while ((dx + 1) * (dx + 1) + y * y <= r * r) dx++;
            g.FillRectangle(disc, cx - dx, cy + y, dx * 2 + 1, 1);
        }
        Pen white = new Pen(Color.White);
        SolidBrush ink = new SolidBrush(Color.White);
        if (_kind == MessageBoxIcon.Error)
        {
            for (int i = -1; i <= 1; i++)
            {
                g.DrawLine(white, cx - 7 + i, cy - 7, cx + 7 + i, cy + 7);
                g.DrawLine(white, cx + 7 + i, cy - 7, cx - 7 + i, cy + 7);
            }
        }
        else if (_kind == MessageBoxIcon.Question)
        {
            g.DrawString("?", new Font("System", 9), ink, cx - 4, cy - 8);
            g.DrawString("?", new Font("System", 9), ink, cx - 3, cy - 8);
        }
        else
        {
            g.FillRectangle(ink, cx - 1, cy - 9, 3, 3);
            g.FillRectangle(ink, cx - 1, cy - 4, 3, 12);
        }
        base.OnPaint(e);
    }
}

public class Label : Control
{
    internal override string ClassName { get { return "Label"; } }
    public Label() { TabStop = false; BackColor = Color.Transparent; }
    public bool AutoSize = true;

    /// Where the text sits in the label's box. A label put beside a
    /// control that is taller than one line wants to be middle-left, which
    /// is why this is here and why AutoSize is off when it is used.
    public ContentAlignment TextAlign = ContentAlignment.TopLeft;

    public override string Text
    {
        get { return base.Text; }
        set
        {
            base.Text = value;
            if (!AutoSize) { return; }
            // MEASURED WITHOUT THE MARKER: "&File" is five characters on
            // the wire and four on the screen, and a label sized to five
            // pushes everything after it a character to the right.
            string shown = ControlPaint.StripMnemonic(value);
            Width = shown.Length == 0 ? 0 : TextRenderer.MeasureText(shown, Font).Width;
            Height = Lines(shown) * Font.Height;
        }
    }

    static int Longest(string s)
    {
        int longest = 0, run = 0;
        for (int i = 0; i < s.Length; i++) { if (s[i] == '\n') { if (run > longest) longest = run; run = 0; } else run++; }
        return run > longest ? run : longest;
    }

    static int Lines(string s)
    {
        int lines = 1;
        for (int i = 0; i < s.Length; i++) if (s[i] == '\n') lines++;
        return lines;
    }

    protected override void OnPaintBackground(PaintEventArgs e)
    {
        if (BackColor == Color.Transparent) { Control? p = Parent; e.Graphics.FillRectangle(new SolidBrush(p == null ? SystemColors.Control : p.BackColor), e.ClipRectangle); }
        else base.OnPaintBackground(e);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        string shown = ControlPaint.StripMnemonic(Text);
        int high = Lines(shown) * Font.Height, wide = TextRenderer.MeasureText(shown, Font).Width;
        int y = TextAlign == ContentAlignment.MiddleLeft || TextAlign == ContentAlignment.MiddleCenter || TextAlign == ContentAlignment.MiddleRight ? (Height - high) / 2
              : TextAlign == ContentAlignment.BottomLeft || TextAlign == ContentAlignment.BottomCenter || TextAlign == ContentAlignment.BottomRight ? Height - high : 0;
        int x = TextAlign == ContentAlignment.TopCenter || TextAlign == ContentAlignment.MiddleCenter || TextAlign == ContentAlignment.BottomCenter ? (Width - wide) / 2
              : TextAlign == ContentAlignment.TopRight || TextAlign == ContentAlignment.MiddleRight || TextAlign == ContentAlignment.BottomRight ? Width - wide : 0;

        if (!Enabled)
        {
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.ControlLightLight), x + 1, y + 1, true);
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.GrayText), x, y, true);
        }
        else ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(ForeColor), EffectiveBackColor, x, y, true);
        base.OnPaint(e);
    }
}

public enum ContentAlignment
{
    TopLeft = 1, TopCenter = 2, TopRight = 4,
    MiddleLeft = 16, MiddleCenter = 32, MiddleRight = 64,
    BottomLeft = 256, BottomCenter = 512, BottomRight = 1024,
}

public class Panel : Control
{
    internal override string ClassName { get { return "Panel"; } }
    public Panel() { TabStop = false; }
}

public class Button : Control
{
    internal override string ClassName { get { return "Button"; } }
    bool _down;
    bool _default;
    public Button() { Width = 75; Height = 23; }

    /// Set by Form.AcceptButton. A default button is ringed in black and
    /// is what Enter presses from anywhere on the form.
    public bool IsDefault { get { return _default; } }
    internal void MakeDefault() { _default = true; Invalidate(); }
    internal void NotDefault() { _default = false; Invalidate(); }

    /// The picture on the button, left of the text when there is text and
    /// centred when there is not.
    public Icon? Image;
    public int ImageSize = 16;

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int w = Width, h = Height;

        ControlPaint.DrawButtonFace(g, 0, 0, w, h, _down, _default, BackColor);

        string shown = ControlPaint.StripMnemonic(Text);
        SizeF size = g.MeasureString(shown, Font);
        int picture = Image == null ? 0 : ImageSize + (shown.Length > 0 ? 4 : 0);
        int span = picture + (int)size.Width;
        int x = (w - span) / 2 + (_down ? 1 : 0);
        int y = (h - (int)size.Height) / 2 + (_down ? 1 : 0);

        if (Image != null) Image.Draw(g, x, (h - ImageSize) / 2 + (_down ? 1 : 0), ImageSize);

        if (!Enabled)
        {
            // GREYED OUT IS TWO PASSES, not one grey one: the text in
            // white one pixel down and right, then in shadow on top. That
            // embossed look is how Windows has said "not now" since 3.0.
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.ControlLightLight), x + picture + 1, y + 1, true);
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.GrayText), x + picture, y, true);
        }
        else ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(ForeColor), EffectiveBackColor, x + picture, y, true);

        if (Focused && Enabled)
        {
            int inset = _default ? 4 : 3;
            ControlPaint.DrawFocusRectangle(g, inset, inset, w - inset * 2, h - inset * 2);
        }
        base.OnPaint(e);
    }
    protected override void OnMouseDown(MouseEventArgs e) { _down = true; Focus(); Invalidate(); base.OnMouseDown(e); }
    protected override void OnMouseUp(MouseEventArgs e) { _down = false; Invalidate(); base.OnMouseUp(e); }

    /// The answer this button gives a dialog. A click with one set hands it
    /// to the form and closes the form, which is how OK and Cancel work
    /// everywhere without a handler on each.
    public DialogResult DialogResult = DialogResult.None;
    protected override void OnClick(EventArgs e)
    {
        base.OnClick(e);
        if (DialogResult != DialogResult.None)
        {
            Form? f = FindForm();
            if (f != null) { f.DialogResult = DialogResult; f.Close(); }
        }
    }

    /// Held and dragged off the button: it pops out and stays out until the
    /// pointer comes back, so a release outside is plainly not a click.
    protected override void OnMouseMove(MouseEventArgs e)
    {
        if (Application.Captured == this)
        {
            bool over = e.X >= 0 && e.Y >= 0 && e.X < Width && e.Y < Height;
            if (over != _down) { _down = over; Invalidate(); }
        }
        base.OnMouseMove(e);
    }

    /// Space presses the focused button, and Enter presses it whether or
    /// not it is the form's default -- both the way Windows does it. The
    /// button goes down while the key is held so it looks pressed.
    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Space || e.KeyCode == Keys.Enter)
        {
            if (!_down) { _down = true; Invalidate(); }
            e.Handled = true;
            _down = false;
            Invalidate();
            PerformClick();
        }
        base.OnKeyDown(e);
    }
}

/// <summary>
/// A button that looks like part of a toolbar: no bevel until the pointer
/// is over it, and held-in while pressed. What the era put along the top
/// of a folder window.
/// </summary>
public class ToolBarButton : Button
{
    internal override string ClassName { get { return "ToolBarButton"; } }
    bool _hot, _held;
    public ToolBarButton() { Width = 24; Height = 23; TabStop = false; }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, Width, Height);
        if (_held) ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.SunkenOuter);
        else if (_hot && Enabled) ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.RaisedOuter);
        string shown = ControlPaint.StripMnemonic(Text);
        int offset = _held ? 1 : 0;
        if (Image != null) Image.Draw(g, (Width - ImageSize) / 2 + offset, (Height - ImageSize) / 2 + offset, ImageSize);
        else
        {
            SizeF size = g.MeasureString(shown, Font);
            g.DrawString(shown, Font, new SolidBrush(Enabled ? ForeColor : SystemColors.GrayText), BackColor,
                (Width - (int)size.Width) / 2 + offset, (Height - (int)size.Height) / 2 + offset);
        }
    }

    protected override void OnMouseDown(MouseEventArgs e) { _held = true; Invalidate(); }
    protected override void OnMouseUp(MouseEventArgs e) { _held = false; Invalidate(); }
    protected override void OnMouseMove(MouseEventArgs e)
    {
        bool over = e.X >= 0 && e.Y >= 0 && e.X < Width && e.Y < Height;
        if (over != _hot) { _hot = over; if (!over) _held = false; Invalidate(); }
    }
    protected override void OnMouseLeave(EventArgs e) { if (_hot || _held) { _hot = false; _held = false; Invalidate(); } base.OnMouseLeave(e); }
}

/// <summary>
/// A box with a tick in it. .NET's shape: Checked, CheckState, and a
/// CheckedChanged that fires when the value changes however it changed.
/// </summary>
public class CheckBox : Control
{
    internal override string ClassName { get { return "CheckBox"; } }

    /// The box itself, which is thirteen pixels square in every Windows
    /// since 95 and is drawn that size here whatever the control is.
    const int BoxSize = 13;

    bool _checked;
    bool _down;
    CheckState _state = CheckState.Unchecked;

    public CheckBox() { Width = 104; Height = 17; BackColor = Color.Transparent; }

    public event EventHandler? CheckedChanged;
    public event EventHandler? CheckStateChanged;

    /// Whether a click changes the value. False leaves it to the program,
    /// which is what a check box driven by something else wants.
    public bool AutoCheck = true;

    /// Three states rather than two, cycled by clicking: what a setting
    /// that is on for some of a selection and off for the rest shows.
    public bool ThreeState = false;

    public bool Checked
    {
        get { return _state != CheckState.Unchecked; }
        set { CheckState = value ? CheckState.Checked : CheckState.Unchecked; }
    }

    public CheckState CheckState
    {
        get { return _state; }
        set
        {
            if (_state == value) { return; }
            bool was = Checked;
            _state = value;
            Invalidate();
            OnCheckStateChanged(EventArgs.Empty);
            if (was != Checked) { OnCheckedChanged(EventArgs.Empty); }
        }
    }

    protected virtual void OnCheckedChanged(EventArgs e) { EventHandler? h = CheckedChanged; if (h != null) h(this, e); }
    protected virtual void OnCheckStateChanged(EventArgs e) { EventHandler? h = CheckStateChanged; if (h != null) h(this, e); }

    protected override void OnPaintBackground(PaintEventArgs e)
    {
        if (BackColor == Color.Transparent)
        {
            Control? p = Parent;
            e.Graphics.FillRectangle(new SolidBrush(p == null ? SystemColors.Control : p.BackColor), e.ClipRectangle);
        }
        else { base.OnPaintBackground(e); }
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int top = (Height - BoxSize) / 2;

        // THE WELL IS WHITE AND SUNK, or face-coloured when the control is
        // off or held in: the same well a text box has, thirteen pixels of
        // it, drawn with the same two-line bevel.
        Color well = !Enabled || _down || _state == CheckState.Indeterminate ? SystemColors.Control : SystemColors.Window;
        g.FillRectangle(new SolidBrush(well), 0, top, BoxSize, BoxSize);
        ControlPaint.DrawBorder3D(g, 0, top, BoxSize, BoxSize, Border3DStyle.Sunken);

        if (_state != CheckState.Unchecked)
        {
            Color ink = Enabled && _state == CheckState.Checked ? ForeColor : SystemColors.GrayText;
            ControlPaint.DrawCheckMark(g, 3, top + 3, ink);
        }

        string shown = ControlPaint.StripMnemonic(Text);
        SizeF size = g.MeasureString(shown, Font);
        int tx = BoxSize + 5;
        int ty = (Height - (int)size.Height) / 2;

        if (!Enabled)
        {
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.ControlLightLight), tx + 1, ty + 1, true);
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.GrayText), tx, ty, true);
        }
        else ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(ForeColor), EffectiveBackColor, tx, ty, true);

        if (Focused && Enabled) ControlPaint.DrawFocusRectangle(g, tx - 2, ty - 1, (int)size.Width + 4, (int)size.Height + 2);
        base.OnPaint(e);
    }

    protected override void OnMouseDown(MouseEventArgs e) { _down = true; Focus(); Invalidate(); base.OnMouseDown(e); }
    protected override void OnMouseUp(MouseEventArgs e) { _down = false; Invalidate(); base.OnMouseUp(e); }

    protected override void OnClick(EventArgs e)
    {
        if (AutoCheck)
        {
            if (!ThreeState) { Checked = !Checked; }
            else { CheckState = _state == CheckState.Unchecked ? CheckState.Checked : _state == CheckState.Checked ? CheckState.Indeterminate : CheckState.Unchecked; }
        }
        base.OnClick(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Space) { PerformClick(); e.Handled = true; }
        base.OnKeyDown(e);
    }
}

public enum CheckState { Unchecked = 0, Checked = 1, Indeterminate = 2 }

/// <summary>
/// One of a set, and only one. Checking it clears every other radio button
/// with the same parent, which is what makes it a set: .NET groups them by
/// container and so does this.
/// </summary>
public class RadioButton : Control
{
    internal override string ClassName { get { return "RadioButton"; } }

    const int DotSize = 12;

    bool _checked;
    bool _down;

    public RadioButton() { Width = 104; Height = 17; BackColor = Color.Transparent; }

    public event EventHandler? CheckedChanged;

    public bool AutoCheck = true;

    public bool Checked
    {
        get { return _checked; }
        set
        {
            if (_checked == value) { return; }
            _checked = value;
            Invalidate();
            if (value) { ClearSiblings(); }
            OnCheckedChanged(EventArgs.Empty);
        }
    }

    void ClearSiblings()
    {
        Control? parent = Parent;

        if (parent == null) { return; }

        for (int i = 0; i < parent.Controls.Count; i++)
        {
            Control other = parent.Controls[i];

            if (other != this && other is RadioButton sibling) { sibling.Checked = false; }
        }
    }

    protected virtual void OnCheckedChanged(EventArgs e)
    {
        EventHandler? h = CheckedChanged;
        if (h != null) { h(this, e); }
    }

    protected override void OnPaintBackground(PaintEventArgs e)
    {
        if (BackColor == Color.Transparent)
        {
            Control? p = Parent;
            e.Graphics.FillRectangle(new SolidBrush(p == null ? SystemColors.Control : p.BackColor), e.ClipRectangle);
        }
        else { base.OnPaintBackground(e); }
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int top = (Height - DotSize) / 2;

        // THE CIRCLE IS BEVELLED LIKE EVERYTHING ELSE: a white well, a
        // shadow arc across the top left and a highlight across the bottom
        // right. Drawn as two half-circles because there is no arc in the
        // seat, and at twelve pixels two halves are exactly right.
        Dial(g, 0, top, !Enabled || _down ? SystemColors.Control : SystemColors.Window);

        if (_checked)
        {
            g.FillEllipse(new SolidBrush(Enabled ? ForeColor : SystemColors.GrayText), 4, top + 4, 4, 4);
        }

        string shown = ControlPaint.StripMnemonic(Text);
        SizeF size = g.MeasureString(shown, Font);
        int tx = DotSize + 5;
        int ty = (Height - (int)size.Height) / 2;

        if (!Enabled)
        {
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.ControlLightLight), tx + 1, ty + 1, true);
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(SystemColors.GrayText), tx, ty, true);
        }
        else ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(ForeColor), EffectiveBackColor, tx, ty, true);

        if (Focused && Enabled) ControlPaint.DrawFocusRectangle(g, tx - 2, ty - 1, (int)size.Width + 4, (int)size.Height + 2);
        base.OnPaint(e);
    }

    /// <summary>
    /// The twelve-pixel dial, drawn a pixel at a time: a well, a shadowed
    /// ring around its upper left and a highlighted one around its lower
    /// right -- the same bevel every other control wears, bent into a
    /// circle. Each pixel is placed by comparing four times its squared
    /// distance from the centre against the ring radii, so there is no
    /// floating point and no arc to approximate; the circle closes.
    /// </summary>
    static void Dial(Graphics g, int x, int y, Color well)
    {
        Brush inside = new SolidBrush(well);
        Brush outerUp = new SolidBrush(SystemColors.ControlDark);
        Brush outerDown = new SolidBrush(SystemColors.ControlLightLight);
        Brush innerUp = new SolidBrush(SystemColors.ControlDarkDark);
        Brush innerDown = new SolidBrush(SystemColors.ControlLight);

        for (int row = 0; row < DotSize; row++)
        {
            for (int column = 0; column < DotSize; column++)
            {
                int dx = 2 * column - (DotSize - 1), dy = 2 * row - (DotSize - 1);
                int distance = dx * dx + dy * dy;

                if (distance > 144) { continue; }

                bool upper = dx + dy <= 0;
                Brush ink = distance > 100 ? (upper ? outerUp : outerDown)
                          : distance > 64 ? (upper ? innerUp : innerDown)
                          : inside;

                g.FillRectangle(ink, x + column, y + row, 1, 1);
            }
        }
    }

    protected override void OnMouseDown(MouseEventArgs e) { _down = true; Focus(); Invalidate(); base.OnMouseDown(e); }
    protected override void OnMouseUp(MouseEventArgs e) { _down = false; Invalidate(); base.OnMouseUp(e); }

    protected override void OnClick(EventArgs e)
    {
        if (AutoCheck) { Checked = true; }
        base.OnClick(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Space) { PerformClick(); e.Handled = true; }
        base.OnKeyDown(e);
    }
}

/// <summary>
/// A frame with a caption, holding other controls. It draws an etched
/// rectangle with the caption laid over the top edge, which is what every
/// dialog of the era groups its options with.
/// </summary>
public class GroupBox : Control
{
    internal override string ClassName { get { return "GroupBox"; } }

    public GroupBox() { TabStop = false; Width = 200; Height = 100; }

    /// Inside the frame: where a control put at 0,0 in this box lands.
    public override Rectangle ClientRectangle { get { return new Rectangle(0, 0, Width, Height); } }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        string shown = ControlPaint.StripMnemonic(Text);
        SizeF size = g.MeasureString(shown, Font);
        int top = shown.Length == 0 ? 0 : (int)size.Height / 2;

        // THE CAPTION SITS IN THE LINE, so the frame is drawn first and the
        // stretch behind the text painted out afterwards.
        ControlPaint.DrawBorder3D(g, 0, top, Width, Height - top, Border3DStyle.Etched);

        if (shown.Length > 0)
        {
            g.FillRectangle(new SolidBrush(BackColor), 8, 0, (int)size.Width + 5, (int)size.Height);
            ControlPaint.DrawStringMnemonic(g, Text, Font, new SolidBrush(Enabled ? ForeColor : SystemColors.GrayText), BackColor, 10, 0, true);
        }
        base.OnPaint(e);
    }
}

/// <summary>
/// A list of things, one of which is chosen. .NET's shape: an Items
/// collection, SelectedIndex, SelectedItem and SelectedIndexChanged.
/// </summary>
public class ListBox : Control
{
    internal override string ClassName { get { return "ListBox"; } }

    readonly ObjectCollection _items;
    readonly VScrollBar _bar;
    int _selected = -1;
    int _top;
    bool _syncing;

    public ListBox()
    {
        _items = new ObjectCollection(this);
        Width = 120;
        Height = 95;
        BackColor = SystemColors.Window;

        // THE BAR IS A CHILD OF THE LIST, not something the program has to
        // put beside it: a list that overflows grows one and a list that
        // does not has none, which is what every list in Windows does.
        _bar = new VScrollBar();
        _bar.TabStop = false;
        _bar.Visible = false;
        _bar.ValueChanged += BarMoved;
        Controls.Add(_bar);
        Layout();
    }

    void BarMoved(object sender, EventArgs e) { if (!_syncing) TopIndex = _bar.Value; }

    /// The bar appears exactly when the rows do not all fit, and is sized
    /// to what is showing.
    void Layout()
    {
        int rows = (Height - 4) / ItemHeight;
        bool wanted = _items.Count > rows && rows > 0;

        _bar.Visible = wanted;
        if (!wanted) { return; }

        _syncing = true;
        _bar.SetBounds(Width - 2 - ScrollWidth, 2, ScrollWidth, Height - 4);
        _bar.Minimum = 0;
        _bar.Maximum = _items.Count - 1;
        _bar.LargeChange = rows;
        _bar.SmallChange = 1;
        if (_bar.Value != _top) _bar.Value = _top > _bar.Maximum ? _bar.Maximum : _top;
        _syncing = false;
    }

    const int ScrollWidth = 16;

    /// How wide the rows are: the whole box, less the bar when it is there.
    int RowWidth { get { return Width - 4 - (_bar.Visible ? ScrollWidth : 0); } }

    public override void SetBounds(int x, int y, int w, int h) { base.SetBounds(x, y, w, h); Layout(); }

    public event EventHandler? SelectedIndexChanged;

    public ObjectCollection Items { get { return _items; } }

    /// The height of one row. Fixed, which is what a list of text is.
    public int ItemHeight = 13;

    public int SelectedIndex
    {
        get { return _selected; }
        set
        {
            int want = value < -1 || value >= _items.Count ? -1 : value;

            if (_selected == want) { return; }
            _selected = want;
            ScrollIntoView();
            Invalidate();
            OnSelectedIndexChanged(EventArgs.Empty);
        }
    }

    public object? SelectedItem
    {
        get { return _selected < 0 ? null : _items[_selected]; }
        set { SelectedIndex = _items.IndexOf(value); }
    }

    /// The first row shown, which is how far the list has been scrolled.
    public int TopIndex
    {
        get { return _top; }
        set
        {
            int want = value < 0 ? 0 : value;
            int most = _items.Count - Rows();

            if (want > most) { want = most < 0 ? 0 : most; }
            if (_top == want) { return; }
            _top = want;
            _syncing = true;
            if (_bar.Visible && want <= _bar.Maximum) _bar.Value = want;
            _syncing = false;
            Invalidate();
        }
    }

    protected virtual void OnSelectedIndexChanged(EventArgs e)
    {
        EventHandler? h = SelectedIndexChanged;
        if (h != null) { h(this, e); }
    }

    int Rows() { return (Height - 4) / ItemHeight; }

    void ScrollIntoView()
    {
        if (_selected < 0) { return; }
        if (_selected < _top) { TopIndex = _selected; }
        else if (_selected >= _top + Rows()) { TopIndex = _selected - Rows() + 1; }
    }

    internal void ItemsChanged()
    {
        if (_selected >= _items.Count) { _selected = _items.Count - 1; }
        Layout();
        TopIndex = _top;
        Invalidate();
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;

        g.FillRectangle(new SolidBrush(Enabled ? BackColor : SystemColors.Control), 0, 0, Width, Height);
        ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.Sunken);

        int rows = Rows();

        for (int row = 0; row < rows; row++)
        {
            int index = _top + row;

            if (index >= _items.Count) { break; }

            string text = _items.TextAt(index);
            int y = 2 + row * ItemHeight;
            bool picked = index == _selected;

            if (picked)
            {
                g.FillRectangle(new SolidBrush(SystemColors.Highlight), 2, y, RowWidth, ItemHeight);
                if (Focused) ControlPaint.DrawFocusRectangle(g, 2, y, RowWidth, ItemHeight);
            }

            g.DrawString(text, Font,
                new SolidBrush(!Enabled ? SystemColors.GrayText
                              : picked ? SystemColors.HighlightText : ForeColor),
                picked ? SystemColors.Highlight : (Enabled ? BackColor : SystemColors.Control),
                3, y);
        }
        base.OnPaint(e);
    }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        if (e.Y >= 2)
        {
            int index = _top + (e.Y - 2) / ItemHeight;

            if (index >= 0 && index < _items.Count) { SelectedIndex = index; }
        }
        Focus();
        base.OnMouseDown(e);
    }

    protected override void OnMouseWheel(MouseEventArgs e)
    {
        int lines = WheelLines(e.Delta, ((Height - 4) / ItemHeight > 1 ? (Height - 4) / ItemHeight : 1), false);
        if (lines != 0) TopIndex = _top - lines;
        base.OnMouseWheel(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Down && _selected + 1 < _items.Count) { SelectedIndex = _selected + 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Up && _selected > 0) { SelectedIndex = _selected - 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Home && _items.Count > 0) { SelectedIndex = 0; e.Handled = true; }
        else if (e.KeyCode == Keys.End && _items.Count > 0) { SelectedIndex = _items.Count - 1; e.Handled = true; }
        else if (e.KeyCode == Keys.PageDown && _items.Count > 0) { int to = _selected + Rows(); SelectedIndex = to >= _items.Count ? _items.Count - 1 : to; e.Handled = true; }
        else if (e.KeyCode == Keys.PageUp && _items.Count > 0) { int to = _selected - Rows(); SelectedIndex = to < 0 ? 0 : to; e.Handled = true; }
        base.OnKeyDown(e);
    }

    /// <summary>The things in the list. .NET calls it ListBox.ObjectCollection.</summary>
    public class ObjectCollection
    {
        readonly ListBox _owner;
        readonly List<object?> _held = new List<object?>();

        public ObjectCollection(ListBox owner) { _owner = owner; }

        public int Count { get { return _held.Count; } }

        public object? this[int index] { get { return _held[index]; } set { _held[index] = value; _owner.ItemsChanged(); } }

        public int Add(object? item) { _held.Add(item); _owner.ItemsChanged(); return _held.Count - 1; }

        public void Clear() { _held.Clear(); _owner.SelectedIndex = -1; _owner.ItemsChanged(); }

        public void RemoveAt(int index) { _held.RemoveAt(index); _owner.ItemsChanged(); }

        public int IndexOf(object? item)
        {
            for (int i = 0; i < _held.Count; i++)
            {
                if (Equals(_held[i], item)) { return i; }
            }
            return -1;
        }

        internal string TextAt(int index)
        {
            object? held = _held[index];
            return held == null ? "" : held.ToString()!;
        }
    }
}

public enum ScrollOrientation { HorizontalScroll = 0, VerticalScroll = 1 }

public enum ScrollEventType
{
    SmallDecrement = 0, SmallIncrement = 1, LargeDecrement = 2, LargeIncrement = 3,
    ThumbPosition = 4, ThumbTrack = 5, First = 6, Last = 7, EndScroll = 8,
}

public class ScrollEventArgs : EventArgs
{
    public ScrollEventType Type;
    public int NewValue;
    public int OldValue;
    public ScrollOrientation ScrollOrientation;
    public ScrollEventArgs(ScrollEventType type, int oldValue, int newValue, ScrollOrientation orientation)
    { Type = type; OldValue = oldValue; NewValue = newValue; ScrollOrientation = orientation; }
    public ScrollEventArgs(ScrollEventType type, int newValue) { Type = type; NewValue = newValue; OldValue = -1; }
}

public delegate void ScrollEventHandler(object? sender, ScrollEventArgs e);

/// A scroll bar, as Windows draws it: an arrow button at each end, a track
/// between, and a raised thumb whose length says how much of the whole is
/// in view. The .NET contract: Value runs from Minimum to
/// Maximum - LargeChange + 1, so a bar over N lines showing R of them has
/// Maximum = N - 1 and LargeChange = R; Scroll fires for what the user
/// does, with the kind of move, and ValueChanged for any change at all.
public abstract class ScrollBar : Control
{
    int _min, _max = 100, _value, _small = 1, _large = 10;
    int _grab = -1;                  // where along the thumb the drag took hold, or -1
    public event ScrollEventHandler? Scroll;
    public event EventHandler? ValueChanged;

    protected ScrollBar() { TabStop = false; }
    protected abstract bool Vertical { get; }
    ScrollOrientation Orientation { get { return Vertical ? ScrollOrientation.VerticalScroll : ScrollOrientation.HorizontalScroll; } }

    public int Minimum
    {
        get { return _min; }
        set { if (value > _max) _max = value; _min = value; Clamp(); Invalidate(); }
    }
    public int Maximum
    {
        get { return _max; }
        set { if (value < _min) _min = value; _max = value; Clamp(); Invalidate(); }
    }
    public int SmallChange { get { return _small; } set { if (value < 0) throw new ArgumentOutOfRangeException("SmallChange"); _small = value; } }
    public int LargeChange
    {
        get { return _large > _max - _min + 1 ? _max - _min + 1 : _large; }
        set { if (value < 0) throw new ArgumentOutOfRangeException("LargeChange"); _large = value; Clamp(); Invalidate(); }
    }
    public int Value
    {
        get { return _value; }
        set
        {
            if (value < _min || value > _max) throw new ArgumentOutOfRangeException("Value");
            SetValue(value);
        }
    }
    protected virtual void OnValueChanged(EventArgs e) { if (ValueChanged != null) ValueChanged(this, e); }
    protected virtual void OnScroll(ScrollEventArgs e) { if (Scroll != null) Scroll(this, e); }

    /// The largest Value the thumb can reach, as .NET defines it.
    int Last_ { get { int top = _max - LargeChange + 1; return top < _min ? _min : top; } }
    void Clamp() { if (_value > Last_) _value = Last_; if (_value < _min) _value = _min; }
    void SetValue(int v)
    {
        int was = _value; _value = v; Clamp();
        if (_value != was) { Invalidate(); OnValueChanged(EventArgs.Empty); }
    }
    /// A move by the user: Scroll says what kind, then ValueChanged says it changed.
    void UserScroll(ScrollEventType type, int v)
    {
        int was = _value;
        if (v > Last_) v = Last_;
        if (v < _min) v = _min;
        ScrollEventArgs e = new ScrollEventArgs(type, was, v, Orientation);
        OnScroll(e);
        SetValue(e.NewValue);
    }

    // The geometry along the bar's length: buttons as long as the bar is
    // thick, the thumb sized to the part in view and never shorter than a
    // button.
    int Length { get { return Vertical ? Height : Width; } }
    int Thickness { get { return Vertical ? Width : Height; } }
    int ButtonL { get { return Thickness < Length / 2 ? Thickness : Length / 2; } }
    int TrackL { get { return Length - 2 * ButtonL; } }
    int Range { get { return _max - _min + 1; } }
    bool Scrollable { get { return Enabled && Range > 0 && LargeChange < Range; } }
    int ThumbL
    {
        get
        {
            if (!Scrollable) return TrackL;
            int l = (int)((long)TrackL * LargeChange / Range);
            return l < ButtonL ? (ButtonL < TrackL ? ButtonL : TrackL) : l;
        }
    }
    int ThumbAt
    {
        get
        {
            int room = TrackL - ThumbL, span = Last_ - _min;
            if (room <= 0 || span <= 0) return ButtonL;
            return ButtonL + (int)((long)room * (_value - _min) / span);
        }
    }
    int ValueAt(int along)
    {
        int room = TrackL - ThumbL, span = Last_ - _min;
        if (room <= 0 || span <= 0) return _min;
        return _min + (int)(((long)(along - ButtonL) * span + room / 2) / room);
    }
    void Box(int along, int length, out int x, out int y, out int w, out int h)
    {
        if (Vertical) { x = 0; y = along; w = Width; h = length; }
        else { x = along; y = 0; w = length; h = Height; }
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int x, y, w, h;
        // THE TRACK IS THE PALE GREY the era's dither of face and white
        // averages to. Windows drew the dither itself; a pixel at a time
        // over the wire is thousands of operations for one scroll bar, and
        // the flat colour is indistinguishable at this size.
        g.FillRectangle(new SolidBrush(Color.FromArgb(223, 223, 223)), 0, 0, Width, Height);
        Box(0, ButtonL, out x, out y, out w, out h); Arrow(g, x, y, w, h, true);
        Box(Length - ButtonL, ButtonL, out x, out y, out w, out h); Arrow(g, x, y, w, h, false);
        if (Scrollable)
        {
            Box(ThumbAt, ThumbL, out x, out y, out w, out h);
            g.FillRectangle(new SolidBrush(SystemColors.Control), x, y, w, h);
            ControlPaint.DrawBorder3D(g, x, y, w, h, Border3DStyle.Raised);
        }
        base.OnPaint(e);
    }

    void Arrow(Graphics g, int x, int y, int w, int h, bool first)
    {
        ControlPaint.DrawButtonFace(g, x, y, w, h, false, false, SystemColors.Control);
        Color ink = Scrollable ? SystemColors.ControlText : SystemColors.GrayText;
        ArrowDirection way = Vertical ? (first ? ArrowDirection.Up : ArrowDirection.Down)
                                      : (first ? ArrowDirection.Left : ArrowDirection.Right);
        if (Vertical) ControlPaint.DrawArrow(g, way, x + w / 2 - 3, y + h / 2 - 2, 4, ink);
        else ControlPaint.DrawArrow(g, way, x + w / 2 - 2, y + h / 2 - 3, 4, ink);
    }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        if (e.Button == MouseButtons.Left && Scrollable)
        {
            int along = Vertical ? e.Y : e.X, bl = ButtonL;
            if (along < bl) UserScroll(ScrollEventType.SmallDecrement, _value - _small);
            else if (along >= Length - bl) UserScroll(ScrollEventType.SmallIncrement, _value + _small);
            else if (along < ThumbAt) UserScroll(ScrollEventType.LargeDecrement, _value - LargeChange);
            else if (along >= ThumbAt + ThumbL) UserScroll(ScrollEventType.LargeIncrement, _value + LargeChange);
            else _grab = along - ThumbAt;
        }
        base.OnMouseDown(e);
    }
    protected override void OnMouseMove(MouseEventArgs e)
    {
        if (_grab >= 0) UserScroll(ScrollEventType.ThumbTrack, ValueAt((Vertical ? e.Y : e.X) - _grab));
        base.OnMouseMove(e);
    }
    protected override void OnMouseUp(MouseEventArgs e)
    {
        if (_grab >= 0)
        {
            _grab = -1;
            UserScroll(ScrollEventType.ThumbPosition, _value);
            OnScroll(new ScrollEventArgs(ScrollEventType.EndScroll, _value, _value, Orientation));
        }
        base.OnMouseUp(e);
    }
    protected override void OnMouseWheel(MouseEventArgs e)
    {
        int lines = WheelLines(e.Delta, _large > 0 ? _large / (_small > 1 ? _small : 1) : 1, false);
        if (lines != 0) UserScroll(lines > 0 ? ScrollEventType.SmallDecrement : ScrollEventType.SmallIncrement, _value - lines * _small);
        base.OnMouseWheel(e);
    }

    /// The tilt wheel, on a scroll bar that runs sideways: right is toward
    /// the maximum.
    protected override void OnMouseHWheel(MouseEventArgs e)
    {
        int columns = WheelLines(e.Delta, _large > 0 ? _large / (_small > 1 ? _small : 1) : 1, true);
        if (columns != 0) UserScroll(columns > 0 ? ScrollEventType.SmallIncrement : ScrollEventType.SmallDecrement, _value + columns * _small);
        base.OnMouseHWheel(e);
    }
}

public class VScrollBar : ScrollBar
{
    internal override string ClassName { get { return "VScrollBar"; } }
    protected override bool Vertical { get { return true; } }
    public VScrollBar() { Width = 16; Height = 100; }
}

public class HScrollBar : ScrollBar
{
    internal override string ClassName { get { return "HScrollBar"; } }
    protected override bool Vertical { get { return false; } }
    public HScrollBar() { Width = 100; Height = 16; }
}

public class TextBox : Control
{
    internal override string ClassName { get { return "TextBox"; } }
    // The caret and the selection: `_caret` is where typing goes, `_anchor`
    // is the other end of the selection, equal to the caret when nothing is
    // selected. What a Windows text box does: a typed character replaces the
    // selection, Shift with a movement key extends it, Tab into the box
    // selects everything, a click puts the caret and a drag selects.
    int _caret;
    int _anchor;
    bool _dragging;
    public char PasswordChar = '\0';
    public bool ReadOnly = false;
    public bool UseSystemPasswordChar { get { return PasswordChar == '*'; } set { PasswordChar = value ? '*' : '\0'; } }
    public TextBox() { BackColor = SystemColors.Window; ForeColor = SystemColors.WindowText; Width = 100; Height = 20; }
    public int SelectionStart { get { return _caret < _anchor ? _caret : _anchor; } set { _caret = _anchor = Clamp(value); Invalidate(); } }
    public int SelectionLength
    {
        get { return _caret < _anchor ? _anchor - _caret : _caret - _anchor; }
        set { _caret = Clamp(SelectionStart + (value < 0 ? 0 : value)); Invalidate(); }
    }
    public string SelectedText { get { return Text.Substring(SelectionStart, SelectionLength); } }
    public void SelectAll() { _anchor = 0; _caret = Text.Length; Invalidate(); }
    public void Select(int start, int length) { _anchor = Clamp(start); _caret = Clamp(start + length); Invalidate(); }
    int Clamp(int at) { return at < 0 ? 0 : at > Text.Length ? Text.Length : at; }
    string Shown() { if (PasswordChar == '\0') return Text; string s = ""; for (int i = 0; i < Text.Length; i++) s = s + PasswordChar; return s; }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int w = Width, h = Height;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, w, h);
        ControlPaint.DrawBorder3D(g, 0, 0, w, h, Border3DStyle.Sunken);
        string shown = Shown();
        int left = 4, top = (h - Font.Height) / 2;
        int from = SelectionStart, count = SelectionLength;
        if (count > 0 && Focused)
        {
            g.DrawString(shown.Substring(0, from), Font, new SolidBrush(ForeColor), BackColor, left, top);
            g.DrawStringOpaque(shown.Substring(from, count), Font, SystemColors.HighlightText, SystemColors.Highlight, left + Font.TextWidth(shown, 0, from), top);
            g.DrawString(shown.Substring(from + count), Font, new SolidBrush(ForeColor), BackColor, left + Font.TextWidth(shown, 0, from + count), top);
        }
        else
        {
            g.DrawString(shown, Font, new SolidBrush(ForeColor), BackColor, left, top);
        }
        if (Focused) g.FillRectangle(new SolidBrush(ForeColor), left + Font.TextWidth(shown, 0, _caret > shown.Length ? shown.Length : _caret), top, 1, Font.Height);
        base.OnPaint(e);
    }

    /// Remove the selection from the text, leaving the caret where it was.
    /// True when there was one.
    bool DeleteSelection()
    {
        int from = SelectionStart, count = SelectionLength;
        if (count == 0) return false;
        Text = Text.Substring(0, from) + Text.Substring(from + count);
        _caret = _anchor = from;
        return true;
    }

    protected override void OnKeyPress(KeyPressEventArgs e)
    {
        base.OnKeyPress(e);
        if (e.Handled || ReadOnly) return;
        char c = e.KeyChar;
        if (c == '\b')
        {
            // The caret moves BEFORE the text changes: setting Text clamps the
            // caret to the new length, and a decrement after that took it one
            // place too far, so the next letter landed inside the word.
            if (!DeleteSelection() && _caret > 0) { int at = _caret - 1; Text = Text.Substring(0, at) + Text.Substring(_caret); _caret = _anchor = at; }
            e.Handled = true;
        }
        else if (c == (char)1) { SelectAll(); e.Handled = true; }             // Ctrl+A
        else if (c >= ' ' && c < (char)127)
        {
            DeleteSelection();
            int after = _caret + 1;
            Text = Text.Substring(0, _caret) + c + Text.Substring(_caret); _caret = _anchor = after;
            e.Handled = true;
        }
        Invalidate();
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        int was = _caret;
        if (e.KeyCode == Keys.Left) { if (!e.Shift && SelectionLength > 0) _caret = SelectionStart; else if (_caret > 0) _caret--; }
        else if (e.KeyCode == Keys.Right) { if (!e.Shift && SelectionLength > 0) _caret = SelectionStart + SelectionLength; else if (_caret < Text.Length) _caret++; }
        else if (e.KeyCode == Keys.Home) _caret = 0;
        else if (e.KeyCode == Keys.End) _caret = Text.Length;
        else if (e.KeyCode == Keys.Delete)
        {
            if (!ReadOnly && !DeleteSelection() && _caret < Text.Length) Text = Text.Substring(0, _caret) + Text.Substring(_caret + 1);
            Invalidate();
            return;
        }
        else return;
        if (!e.Shift) _anchor = _caret;              // a plain move collapses the selection
        if (_caret != was || !e.Shift) Invalidate();
    }
    protected override void OnTextChanged(EventArgs e) { _caret = Clamp(_caret); _anchor = Clamp(_anchor); base.OnTextChanged(e); }

    int ColumnAt(int x)
    {
        // The boundary nearest the click: walk the text until the next
        // letter's middle is past the pointer.
        string shown = Shown();
        int at = 0, edge = 4;

        while (at < shown.Length)
        {
            int wide = Font.TextWidth(shown, at, 1);
            if (x < edge + (wide + 1) / 2) { break; }
            edge += wide;
            at++;
        }
        return Clamp(at);
    }

    /// A click puts the caret where it landed, rounded to the nearest
    /// character boundary; holding the button and moving selects.
    protected override void OnMouseDown(MouseEventArgs e)
    {
        _caret = ColumnAt(e.X);
        _anchor = _caret;
        _dragging = true;
        Invalidate();
        base.OnMouseDown(e);
    }
    protected override void OnMouseMove(MouseEventArgs e)
    {
        if (_dragging) { int at = ColumnAt(e.X); if (at != _caret) { _caret = at; Invalidate(); } }
        base.OnMouseMove(e);
    }
    protected override void OnMouseUp(MouseEventArgs e) { _dragging = false; base.OnMouseUp(e); }

    /// Focus arriving by keyboard selects everything, ready to be replaced
    /// or typed after; focus by click leaves the caret where the click put it.
    protected override void OnGotFocus(EventArgs e)
    {
        if (!_clickFocus) { _anchor = 0; _caret = Text.Length; }
        _clickFocus = false;
        base.OnGotFocus(e);
    }
    protected override void OnLostFocus(EventArgs e) { _dragging = false; base.OnLostFocus(e); }
    bool _clickFocus;
    internal void FocusByClick() { _clickFocus = true; }
}

// ---------------------------------------------------------------------------
// The rest of the widget set: the controls a dialog of this era is built
// from. Every one of them is keyboard-complete -- there is nothing below
// that needs a mouse -- and every one wears the same five-grey bevel, which
// is what makes a screen of them look like one machine.
// ---------------------------------------------------------------------------

/// <summary>
/// A picture. SizeMode says what happens when the picture and the box are
/// different sizes; Normal draws it at its own size in the corner, and
/// CenterImage puts it in the middle, which is what an icon in a dialog
/// wants.
/// </summary>
public enum PictureBoxSizeMode { Normal = 0, StretchImage = 1, AutoSize = 2, CenterImage = 3 }

public enum BorderStyle { None = 0, FixedSingle = 1, Fixed3D = 2 }

public class PictureBox : Control
{
    internal override string ClassName { get { return "PictureBox"; } }

    Icon? _image;
    int _size = 32;

    public PictureBox() { TabStop = false; Width = 32; Height = 32; BackColor = Color.Transparent; }

    public Icon? Image { get { return _image; } set { _image = value; Invalidate(); } }

    /// The pixel size the icon is drawn at. An icon is a set of drawings,
    /// not one picture, so this picks which of them is used.
    public int ImageSize { get { return _size; } set { _size = value; Invalidate(); } }

    public PictureBoxSizeMode SizeMode = PictureBoxSizeMode.CenterImage;
    public BorderStyle BorderStyle = BorderStyle.None;

    protected override void OnPaintBackground(PaintEventArgs e)
    {
        if (BackColor == Color.Transparent) { Control? p = Parent; e.Graphics.FillRectangle(new SolidBrush(p == null ? SystemColors.Control : p.BackColor), e.ClipRectangle); }
        else base.OnPaintBackground(e);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;

        if (BorderStyle == BorderStyle.Fixed3D) ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.Sunken);
        else if (BorderStyle == BorderStyle.FixedSingle) g.DrawRectangle(new Pen(SystemColors.WindowFrame), 0, 0, Width, Height);

        if (_image != null)
        {
            int x = SizeMode == PictureBoxSizeMode.Normal ? 0 : (Width - _size) / 2;
            int y = SizeMode == PictureBoxSizeMode.Normal ? 0 : (Height - _size) / 2;
            _image.Draw(g, x, y, _size);
        }
        base.OnPaint(e);
    }
}

/// <summary>
/// A bar that fills up. Windows 98 draws it as separate blocks with a gap
/// between them rather than one solid stretch, and that is what is drawn
/// here: the blocks are what make it read as progress rather than as a
/// coloured rectangle.
/// </summary>
public class ProgressBar : Control
{
    internal override string ClassName { get { return "ProgressBar"; } }

    int _min, _max = 100, _value;

    public ProgressBar() { TabStop = false; Width = 200; Height = 20; BackColor = SystemColors.Control; }

    public int Minimum { get { return _min; } set { _min = value; if (_max < _min) _max = _min; Clamp(); Invalidate(); } }
    public int Maximum { get { return _max; } set { _max = value; if (_max < _min) _min = _max; Clamp(); Invalidate(); } }
    public int Value { get { return _value; } set { _value = value; Clamp(); Invalidate(); } }

    /// How far PerformStep moves it, which is how a loop reports itself
    /// without doing arithmetic at every turn.
    public int Step = 10;
    public void PerformStep() { Value = _value + Step; }
    public void Increment(int by) { Value = _value + by; }

    void Clamp() { if (_value < _min) _value = _min; if (_value > _max) _value = _max; }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;

        g.FillRectangle(new SolidBrush(SystemColors.Control), 0, 0, Width, Height);
        ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.Sunken);

        int span = _max - _min;
        int inside = Width - 4;

        if (span <= 0 || inside <= 0) { base.OnPaint(e); return; }

        // ONE BLOCK EVERY SEVEN PIXELS: six of colour and one of gap, which
        // is the spacing Windows uses and the reason the bar looks like it
        // is counting rather than sliding.
        const int Block = 6, Gap = 1;
        int blocks = (inside + Gap) / (Block + Gap);
        int filled = (int)(((long)(_value - _min) * blocks + span / 2) / span);

        for (int i = 0; i < filled; i++)
            g.FillRectangle(new SolidBrush(SystemColors.Highlight), 2 + i * (Block + Gap), 2, Block, Height - 4);

        base.OnPaint(e);
    }
}

/// <summary>
/// A slider. .NET's TrackBar: Minimum, Maximum, Value, TickFrequency and a
/// Scroll event, worked with the arrows, Page keys and Home and End as well
/// as the pointer.
/// </summary>
public enum Orientation { Horizontal = 0, Vertical = 1 }

public enum TickStyle { None = 0, TopLeft = 1, BottomRight = 2, Both = 3 }

public class TrackBar : Control
{
    internal override string ClassName { get { return "TrackBar"; } }

    int _min, _max = 10, _value;
    bool _held;

    public TrackBar() { Width = 150; Height = 45; BackColor = SystemColors.Control; }

    public event EventHandler? ValueChanged;
    public event EventHandler? Scroll;

    public Orientation Orientation = Orientation.Horizontal;
    public TickStyle TickStyle = TickStyle.BottomRight;
    public int TickFrequency = 1;
    public int SmallChange = 1;
    public int LargeChange = 5;

    public int Minimum { get { return _min; } set { _min = value; if (_max < _min) _max = _min; Value = _value; Invalidate(); } }
    public int Maximum { get { return _max; } set { _max = value; if (_max < _min) _min = _max; Value = _value; Invalidate(); } }

    public int Value
    {
        get { return _value; }
        set
        {
            int want = value < _min ? _min : value > _max ? _max : value;
            if (want == _value) { return; }
            _value = want;
            Invalidate();
            EventHandler? h = ValueChanged;
            if (h != null) h(this, EventArgs.Empty);
        }
    }

    void Moved(int to)
    {
        int was = _value;
        Value = to;
        if (_value == was) { return; }
        EventHandler? h = Scroll;
        if (h != null) h(this, EventArgs.Empty);
    }

    // The geometry. The thumb is Windows' size -- eleven by twenty-one for
    // a horizontal bar -- and the groove it runs in is four pixels deep,
    // sunk, and as long as the control less one thumb's width.
    const int ThumbShort = 11, ThumbLong = 21;
    bool Across { get { return Orientation == Orientation.Horizontal; } }
    int Span { get { return Across ? Width : Height; } }
    int Depth { get { return Across ? Height : Width; } }
    int Room { get { int r = Span - ThumbShort; return r < 1 ? 1 : r; } }
    int Offset { get { int range = _max - _min; return range <= 0 ? 0 : (int)((long)Room * (_value - _min) / range); } }

    int ValueAt(int along)
    {
        int range = _max - _min;
        if (range <= 0) { return _min; }
        int at = along - ThumbShort / 2;
        if (at < 0) at = 0;
        if (at > Room) at = Room;
        return _min + (int)(((long)at * range + Room / 2) / Room);
    }

    /// Where the groove sits across the control: a little above centre when
    /// the ticks are below it, which is how Windows lays it out.
    int Line
    {
        get
        {
            if (TickStyle == TickStyle.None || TickStyle == TickStyle.Both) return (Depth - ThumbLong) / 2;
            return TickStyle == TickStyle.BottomRight ? (Depth - ThumbLong) / 2 - 3 : (Depth - ThumbLong) / 2 + 3;
        }
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, Width, Height);

        int top = Line;
        int groove = top + ThumbLong / 2 - 2;

        if (Across) { g.FillRectangle(new SolidBrush(SystemColors.ControlDark), 1, groove, Width - 2, 4); ControlPaint.DrawBorder3D(g, 1, groove, Width - 2, 4, Border3DStyle.Sunken); }
        else { g.FillRectangle(new SolidBrush(SystemColors.ControlDark), groove, 1, 4, Height - 2); ControlPaint.DrawBorder3D(g, groove, 1, 4, Height - 2, Border3DStyle.Sunken); }

        Ticks(g, top);
        Thumb(g, Offset, top);

        if (Focused && Enabled) ControlPaint.DrawFocusRectangle(g, 0, 0, Width, Height);
        base.OnPaint(e);
    }

    void Ticks(Graphics g, int top)
    {
        if (TickStyle == TickStyle.None || TickFrequency < 1) { return; }

        int range = _max - _min;
        if (range <= 0) { return; }

        Pen ink = new Pen(Enabled ? SystemColors.ControlDarkDark : SystemColors.GrayText);
        bool before = TickStyle == TickStyle.TopLeft || TickStyle == TickStyle.Both;
        bool after = TickStyle == TickStyle.BottomRight || TickStyle == TickStyle.Both;

        for (int at = _min; at <= _max; at += TickFrequency)
        {
            int along = ThumbShort / 2 + (int)((long)Room * (at - _min) / range);

            if (Across)
            {
                if (before) g.DrawLine(ink, along, top - 5, along, top - 2);
                if (after) g.DrawLine(ink, along, top + ThumbLong + 2, along, top + ThumbLong + 5);
            }
            else
            {
                if (before) g.DrawLine(ink, top - 5, along, top - 2, along);
                if (after) g.DrawLine(ink, top + ThumbLong + 2, along, top + ThumbLong + 5, along);
            }
        }
    }

    /// <summary>
    /// The pointer-shaped thumb: a rectangle with a triangular nose that
    /// points at the ticks. Drawn as a body and a nose so the two bevels
    /// meet, which is what gives it the moulded look rather than the look
    /// of a rectangle with a corner cut off.
    /// </summary>
    /// <summary>
    /// ONE SHAPE, SHADED FROM ITS OWN OUTLINE. The thumb used to be a
    /// complete raised box with a triangle stuck on the end, and a complete
    /// box has a bottom edge: a dark line straight across the middle of the
    /// thumb, where the box stopped and the nose began. It is now a mask --
    /// which pixels are thumb -- and each pixel takes its colour from which
    /// of its neighbours are not: lit where the outside is above or to the
    /// left, dark where it is below or to the right, with the second ring
    /// inside each as every other raised thing here has. The diagonal sides
    /// of the nose come out right by the same rule, with no case for them.
    /// </summary>
    void Thumb(Graphics g, int along, int top)
    {
        bool nosed = TickStyle == TickStyle.TopLeft || TickStyle == TickStyle.BottomRight;
        bool pointFirst = TickStyle == TickStyle.TopLeft;
        int nose = nosed ? ThumbShort / 2 : 0;
        int w = Across ? ThumbShort : ThumbLong, h = Across ? ThumbLong : ThumbShort;
        int x = Across ? along : top, y = Across ? top : along;

        // Two spare pixels all round, so a pixel may ask about its
        // neighbour's neighbour without asking where the edge is.
        bool[] inside = new bool[(w + 4) * (h + 4)];
        int stride = w + 4;

        for (int v = 0; v < h; v++)
        {
            for (int u = 0; u < w; u++)
            {
                // Along the short side, and how far into the long one from
                // the blunt end: the nose narrows a column a row.
                int across = Across ? u : v;
                int deep = Across ? v : u;
                if (pointFirst) deep = ThumbLong - 1 - deep;

                int intoNose = deep - (ThumbLong - 1 - nose);
                int middle = ThumbShort / 2;
                bool on = intoNose <= 0 || (across >= middle - (nose - intoNose) && across <= middle + (nose - intoNose));

                inside[(v + 2) * stride + (u + 2)] = on;
            }
        }

        Color face = SystemColors.Control, lit = SystemColors.ControlLightLight, soft = SystemColors.ControlLight;
        Color dark = SystemColors.ControlDark, black = SystemColors.ControlDarkDark;

        for (int v = 0; v < h; v++)
        {
            int runFrom = 0;
            Color runColour = face;
            bool running = false;

            for (int u = 0; u <= w; u++)
            {
                Color colour = face;
                bool on = u < w && inside[(v + 2) * stride + (u + 2)];

                if (on)
                {
                    int at = (v + 2) * stride + (u + 2);
                    bool openLeft = !inside[at - 1], openUp = !inside[at - stride];
                    bool openRight = !inside[at + 1], openDown = !inside[at + stride];

                    if (openRight || openDown) colour = black;
                    else if (openLeft || openUp) colour = lit;
                    else
                    {
                        bool nearDark = !inside[at + 2] || !inside[at + stride * 2] || !inside[at + stride + 1];
                        bool nearLit = !inside[at - 2] || !inside[at - stride * 2] || !inside[at - stride - 1];
                        colour = nearDark ? dark : nearLit ? soft : face;
                    }
                }

                if (running && (!on || colour != runColour))
                {
                    g.FillRectangle(new SolidBrush(runColour), x + runFrom, y + v, u - runFrom, 1);
                    running = false;
                }
                if (on && !running) { running = true; runFrom = u; runColour = colour; }
            }
        }
    }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        Focus();
        int along = Across ? e.X : e.Y;
        int at = Offset;

        // On the thumb: drag it. Beside it: a page toward the pointer,
        // which is what a click on a track does everywhere.
        if (along >= at && along < at + ThumbShort) { _held = true; }
        else Moved(along < at ? _value - LargeChange : _value + LargeChange);
        base.OnMouseDown(e);
    }

    protected override void OnMouseMove(MouseEventArgs e)
    {
        if (_held) Moved(ValueAt(Across ? e.X : e.Y));
        base.OnMouseMove(e);
    }

    protected override void OnMouseUp(MouseEventArgs e) { _held = false; base.OnMouseUp(e); }

    protected override void OnMouseWheel(MouseEventArgs e)
    {
        int notches = WheelNotches(e.Delta, false);
        if (notches != 0) Moved(_value + notches * SmallChange);
        base.OnMouseWheel(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Left || e.KeyCode == Keys.Down) { Moved(_value - SmallChange); e.Handled = true; }
        else if (e.KeyCode == Keys.Right || e.KeyCode == Keys.Up) { Moved(_value + SmallChange); e.Handled = true; }
        else if (e.KeyCode == Keys.PageDown) { Moved(_value - LargeChange); e.Handled = true; }
        else if (e.KeyCode == Keys.PageUp) { Moved(_value + LargeChange); e.Handled = true; }
        else if (e.KeyCode == Keys.Home) { Moved(_min); e.Handled = true; }
        else if (e.KeyCode == Keys.End) { Moved(_max); e.Handled = true; }
        base.OnKeyDown(e);
    }
}

/// <summary>
/// A box with a value in it and a list behind it. DropDownList is the one
/// a settings page wants: the text cannot be typed into, only chosen, and
/// the whole face is a button that opens the list.
/// </summary>
public enum ComboBoxStyle { Simple = 0, DropDown = 1, DropDownList = 2 }

public class ComboBox : Control
{
    internal override string ClassName { get { return "ComboBox"; } }

    readonly ObjectCollection _items;
    int _selected = -1;
    bool _down;
    ComboPopup? _open;

    /// The drop button, which is the height of the box less its bevel and
    /// as wide as a scroll bar's button. Windows' is seventeen wide.
    const int ButtonWidth = 17;

    public ComboBox()
    {
        _items = new ObjectCollection(this);
        Width = 121;
        Height = 21;
        BackColor = SystemColors.Window;
        ForeColor = SystemColors.WindowText;
    }

    public event EventHandler? SelectedIndexChanged;
    public event EventHandler? DropDown;
    public event EventHandler? DropDownClosed;

    public ComboBoxStyle DropDownStyle = ComboBoxStyle.DropDownList;
    public ObjectCollection Items { get { return _items; } }
    public int ItemHeight = 13;

    /// How many rows the list shows before it needs a scroll bar. Windows'
    /// default is eight and so is this.
    public int MaxDropDownItems = 8;

    public int SelectedIndex
    {
        get { return _selected; }
        set
        {
            int want = value < -1 || value >= _items.Count ? -1 : value;
            if (_selected == want) { return; }
            _selected = want;
            base.Text = want < 0 ? "" : _items.TextAt(want);
            Invalidate();
            EventHandler? h = SelectedIndexChanged;
            if (h != null) h(this, EventArgs.Empty);
        }
    }

    public object? SelectedItem
    {
        get { return _selected < 0 ? null : _items[_selected]; }
        set { SelectedIndex = _items.IndexOf(value); }
    }

    public override string Text
    {
        get { return base.Text; }
        set
        {
            int at = _items.IndexOfText(value);
            if (at >= 0) { SelectedIndex = at; return; }
            base.Text = value;
        }
    }

    public bool DroppedDown { get { return _open != null; } set { if (value) Open(); else Shut(); } }

    internal void ItemsChanged()
    {
        if (_selected >= _items.Count) { _selected = _items.Count - 1; base.Text = _selected < 0 ? "" : _items.TextAt(_selected); }
        Invalidate();
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int w = Width, h = Height;
        bool live = Enabled;

        // THE WHOLE FACE IS SUNK, like a text box, and the button sits
        // inside the sunken well -- not beside it. That inset is the
        // difference between a combo box and a text box with a button
        // stuck on the end.
        g.FillRectangle(new SolidBrush(live ? SystemColors.Window : SystemColors.Control), 0, 0, w, h);
        ControlPaint.DrawBorder3D(g, 0, 0, w, h, Border3DStyle.Sunken);

        int bx = w - ButtonWidth - 2, by = 2, bh = h - 4;
        ControlPaint.DrawButtonFace(g, bx, by, ButtonWidth, bh, _down, false, SystemColors.Control);
        ControlPaint.DrawArrow(g, ArrowDirection.Down, bx + ButtonWidth / 2 - 3 + (_down ? 1 : 0), by + bh / 2 - 2 + (_down ? 1 : 0), 4,
            live ? SystemColors.ControlText : SystemColors.GrayText);

        string shown = base.Text;
        int room = bx - 6;
        while (shown.Length > 1 && Font.TextWidth(shown) > room) { shown = shown.Substring(0, shown.Length - 1); }

        int ty = (h - Font.Height) / 2;

        // THE CHOSEN ROW IS HIGHLIGHTED WHEN THE BOX HAS THE FOCUS, which
        // is how a drop-down list says the keyboard will change it.
        if (Focused && live && DropDownStyle == ComboBoxStyle.DropDownList)
        {
            g.FillRectangle(new SolidBrush(SystemColors.Highlight), 3, 3, bx - 5, h - 6);
            g.DrawString(shown, Font, new SolidBrush(SystemColors.HighlightText), SystemColors.Highlight, 4, ty);
            ControlPaint.DrawFocusRectangle(g, 3, 3, bx - 5, h - 6);
        }
        else g.DrawString(shown, Font, new SolidBrush(live ? ForeColor : SystemColors.GrayText), live ? SystemColors.Window : SystemColors.Control, 4, ty);

        base.OnPaint(e);
    }

    /// The list, as a window of its own below the box -- or above it when
    /// there is no room below, which is what the screen's bottom edge
    /// makes necessary and what Windows does.
    public void Open()
    {
        if (_open != null || _items.Count == 0 || !Enabled) { return; }

        int rows = _items.Count < MaxDropDownItems ? _items.Count : MaxDropDownItems;
        Point at = PointToScreen(new Point(0, Height));
        ComboPopup popup = new ComboPopup(this, rows);

        int high = popup.Height;
        int y = at.Y;
        if (y + high > Seat.Current.Height) { y = at.Y - Height - high; }
        if (y < 0) { y = 0; }

        popup.SetBounds(at.X, y, Width, high);
        _open = popup;
        _down = true;
        Invalidate();
        popup.Show();
        popup.Activate();

        EventHandler? h = DropDown;
        if (h != null) h(this, EventArgs.Empty);
    }

    public void Shut()
    {
        ComboPopup? popup = _open;
        if (popup == null) { return; }
        _open = null;
        _down = false;
        Invalidate();
        if (!popup.IsClosed) popup.Close();

        EventHandler? h = DropDownClosed;
        if (h != null) h(this, EventArgs.Empty);
    }

    internal void Chose(int index) { SelectedIndex = index; Shut(); Focus(); }
    internal void Dismissed() { _open = null; _down = false; Invalidate(); }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        Focus();
        if (_open != null) Shut();
        else if (DropDownStyle == ComboBoxStyle.DropDownList || e.X >= Width - ButtonWidth - 2) Open();
        base.OnMouseDown(e);
    }

    protected override void OnMouseWheel(MouseEventArgs e)
    {
        if (_open != null) { base.OnMouseWheel(e); return; }
        int notches = WheelNotches(e.Delta, false);
        if (notches != 0 && _items.Count > 0)
        {
            int want = _selected - notches;
            if (want < 0) want = 0;
            if (want >= _items.Count) want = _items.Count - 1;
            SelectedIndex = want;
        }
        base.OnMouseWheel(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        // F4 AND ALT+DOWN OPEN IT, the arrows change the value without
        // opening it, and Escape shuts it: Windows' keyboard, exactly.
        if (e.KeyCode == Keys.F4 || (e.KeyCode == Keys.Down && e.Alt))
        {
            if (_open == null) Open(); else Shut();
            e.Handled = true;
        }
        else if (e.KeyCode == Keys.Escape && _open != null) { Shut(); e.Handled = true; }
        else if (e.KeyCode == Keys.Down && _selected + 1 < _items.Count) { SelectedIndex = _selected + 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Up && _selected > 0) { SelectedIndex = _selected - 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Home && _items.Count > 0) { SelectedIndex = 0; e.Handled = true; }
        else if (e.KeyCode == Keys.End && _items.Count > 0) { SelectedIndex = _items.Count - 1; e.Handled = true; }
        base.OnKeyDown(e);
    }

    protected override void OnKeyPress(KeyPressEventArgs e)
    {
        // A LETTER JUMPS TO THE NEXT ITEM STARTING WITH IT, wrapping, so a
        // long list of modes is reachable by typing rather than arrowing.
        char c = e.KeyChar;
        if (c > ' ' && c < (char)127 && DropDownStyle == ComboBoxStyle.DropDownList)
        {
            int at = _items.NextStartingWith(c, _selected);
            if (at >= 0) { SelectedIndex = at; e.Handled = true; }
        }
        base.OnKeyPress(e);
    }

    protected override void OnLostFocus(EventArgs e) { Invalidate(); base.OnLostFocus(e); }
    protected override void OnGotFocus(EventArgs e) { Invalidate(); base.OnGotFocus(e); }

    /// <summary>The things in the list. .NET calls it ComboBox.ObjectCollection.</summary>
    public class ObjectCollection
    {
        readonly ComboBox _owner;
        readonly List<object?> _held = new List<object?>();

        public ObjectCollection(ComboBox owner) { _owner = owner; }

        public int Count { get { return _held.Count; } }
        public object? this[int index] { get { return _held[index]; } set { _held[index] = value; _owner.ItemsChanged(); } }
        public int Add(object? item) { _held.Add(item); _owner.ItemsChanged(); return _held.Count - 1; }
        public void AddRange(object?[] more) { for (int i = 0; i < more.Length; i++) _held.Add(more[i]); _owner.ItemsChanged(); }
        public void Clear() { _held.Clear(); _owner.SelectedIndex = -1; _owner.ItemsChanged(); }
        public void RemoveAt(int index) { _held.RemoveAt(index); _owner.ItemsChanged(); }

        public int IndexOf(object? item)
        {
            for (int i = 0; i < _held.Count; i++) if (Equals(_held[i], item)) return i;
            return -1;
        }

        internal int IndexOfText(string text)
        {
            for (int i = 0; i < _held.Count; i++) if (TextAt(i) == text) return i;
            return -1;
        }

        internal int NextStartingWith(char c, int after)
        {
            char want = c >= 'A' && c <= 'Z' ? (char)(c + 32) : c;
            for (int step = 1; step <= _held.Count; step++)
            {
                int i = (after + step + _held.Count) % _held.Count;
                string text = TextAt(i);
                if (text.Length == 0) continue;
                char first = text[0];
                if (first >= 'A' && first <= 'Z') first = (char)(first + 32);
                if (first == want) return i;
            }
            return -1;
        }

        internal string TextAt(int index) { object? held = _held[index]; return held == null ? "" : held.ToString()!; }
    }
}

/// <summary>
/// The list a combo box drops: its own window, above everything, gone as
/// soon as something is chosen, Escape is pressed or the focus moves.
/// </summary>
internal class ComboPopup : Form
{
    internal override string ClassName { get { return "ComboPopup"; } }

    readonly ComboBox _owner;
    readonly int _rows;
    int _hot;
    int _top;

    internal ComboPopup(ComboBox owner, int rows)
    {
        _owner = owner;
        _rows = rows;
        _hot = owner.SelectedIndex < 0 ? 0 : owner.SelectedIndex;
        FormBorderStyle = FormBorderStyle.None;
        StartPosition = FormStartPosition.Manual;
        TopMost = true;
        ShowInTaskbar = false;
        BackColor = SystemColors.Window;
        Height = rows * owner.ItemHeight + 2;
        Scroll();
    }

    int Height_ { get { return _owner.ItemHeight; } }

    void Scroll()
    {
        if (_hot < _top) _top = _hot;
        else if (_hot >= _top + _rows) _top = _hot - _rows + 1;
        int most = _owner.Items.Count - _rows;
        if (_top > most) _top = most < 0 ? 0 : most;
        if (_top < 0) _top = 0;
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(SystemColors.Window), 0, 0, Width, Height);
        g.DrawRectangle(new Pen(SystemColors.WindowFrame), 0, 0, Width, Height);

        for (int row = 0; row < _rows; row++)
        {
            int index = _top + row;
            if (index >= _owner.Items.Count) break;

            int y = 1 + row * Height_;
            bool picked = index == _hot;

            if (picked) g.FillRectangle(new SolidBrush(SystemColors.Highlight), 1, y, Width - 2, Height_);
            g.DrawString(_owner.Items.TextAt(index), Font,
                new SolidBrush(picked ? SystemColors.HighlightText : SystemColors.WindowText),
                picked ? SystemColors.Highlight : SystemColors.Window, 3, y);
        }
        base.OnPaint(e);
    }

    int At(int y) { int i = _top + (y - 1) / Height_; return i >= 0 && i < _owner.Items.Count ? i : -1; }

    protected override void OnMouseMove(MouseEventArgs e)
    {
        int at = At(e.Y);
        if (at >= 0 && at != _hot) { _hot = at; Invalidate(); }
        base.OnMouseMove(e);
    }

    protected override void OnMouseUp(MouseEventArgs e)
    {
        int at = At(e.Y);
        base.OnMouseUp(e);
        if (at >= 0) _owner.Chose(at);
        else _owner.Shut();
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Down && _hot + 1 < _owner.Items.Count) { _hot++; Scroll(); Invalidate(); e.Handled = true; }
        else if (e.KeyCode == Keys.Up && _hot > 0) { _hot--; Scroll(); Invalidate(); e.Handled = true; }
        else if (e.KeyCode == Keys.Home) { _hot = 0; Scroll(); Invalidate(); e.Handled = true; }
        else if (e.KeyCode == Keys.End) { _hot = _owner.Items.Count - 1; Scroll(); Invalidate(); e.Handled = true; }
        else if (e.KeyCode == Keys.Enter || e.KeyCode == Keys.Space) { _owner.Chose(_hot); e.Handled = true; }
        else if (e.KeyCode == Keys.Escape || e.KeyCode == Keys.F4) { _owner.Shut(); _owner.Focus(); e.Handled = true; }
        base.OnKeyDown(e);
    }

    protected override void OnDeactivate(EventArgs e) { base.OnDeactivate(e); _owner.Dismissed(); if (!IsClosed) Close(); }
}

/// <summary>
/// A number with two small buttons beside it. .NET's NumericUpDown: the
/// value can be typed as well as spun, and the arrows, Page keys, Home
/// and End all move it.
/// </summary>
public class NumericUpDown : Control
{
    internal override string ClassName { get { return "NumericUpDown"; } }

    const int ButtonWidth = 17;

    int _value;
    int _min;
    int _max = 100;
    string _typed = "0";
    int _held;                    // 1 while the up button is in, 2 for down

    public NumericUpDown()
    {
        Width = 120;
        Height = 21;
        BackColor = SystemColors.Window;
        ForeColor = SystemColors.WindowText;
    }

    public event EventHandler? ValueChanged;

    public int Increment = 1;
    public int Minimum { get { return _min; } set { _min = value; if (_max < _min) _max = _min; Value = _value; } }
    public int Maximum { get { return _max; } set { _max = value; if (_max < _min) _min = _max; Value = _value; } }

    public int Value
    {
        get { return _value; }
        set
        {
            int want = value < _min ? _min : value > _max ? _max : value;
            if (want == _value && _typed == want.ToString()) { return; }
            _value = want;
            _typed = want.ToString();
            Invalidate();
            EventHandler? h = ValueChanged;
            if (h != null) h(this, EventArgs.Empty);
        }
    }

    public void UpButton() { Value = _value + Increment; }
    public void DownButton() { Value = _value - Increment; }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        int w = Width, h = Height;
        bool live = Enabled;

        g.FillRectangle(new SolidBrush(live ? SystemColors.Window : SystemColors.Control), 0, 0, w, h);
        ControlPaint.DrawBorder3D(g, 0, 0, w, h, Border3DStyle.Sunken);

        int bx = w - ButtonWidth - 2, by = 2, bh = h - 4;
        int upper = bh / 2, lower = bh - upper;

        ControlPaint.DrawButtonFace(g, bx, by, ButtonWidth, upper, _held == 1, false, SystemColors.Control);
        ControlPaint.DrawArrow(g, ArrowDirection.Up, bx + ButtonWidth / 2 - 2 + (_held == 1 ? 1 : 0), by + upper / 2 - 1 + (_held == 1 ? 1 : 0), 3,
            live ? SystemColors.ControlText : SystemColors.GrayText);

        ControlPaint.DrawButtonFace(g, bx, by + upper, ButtonWidth, lower, _held == 2, false, SystemColors.Control);
        ControlPaint.DrawArrow(g, ArrowDirection.Down, bx + ButtonWidth / 2 - 2 + (_held == 2 ? 1 : 0), by + upper + lower / 2 - 1 + (_held == 2 ? 1 : 0), 3,
            live ? SystemColors.ControlText : SystemColors.GrayText);

        int ty = (h - Font.Height) / 2;
        g.DrawString(_typed, Font, new SolidBrush(live ? ForeColor : SystemColors.GrayText), live ? SystemColors.Window : SystemColors.Control, 4, ty);

        if (Focused && live) g.FillRectangle(new SolidBrush(ForeColor), 4 + Font.TextWidth(_typed), ty, 1, Font.Height);
        base.OnPaint(e);
    }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        Focus();
        if (e.X >= Width - ButtonWidth - 2)
        {
            bool up = e.Y < Height / 2;
            _held = up ? 1 : 2;
            if (up) UpButton(); else DownButton();
            Invalidate();
        }
        base.OnMouseDown(e);
    }

    protected override void OnMouseUp(MouseEventArgs e) { if (_held != 0) { _held = 0; Invalidate(); } base.OnMouseUp(e); }

    protected override void OnMouseWheel(MouseEventArgs e)
    {
        int notches = WheelNotches(e.Delta, false);
        if (notches != 0) Value = _value + notches * Increment;
        base.OnMouseWheel(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Up) { UpButton(); e.Handled = true; }
        else if (e.KeyCode == Keys.Down) { DownButton(); e.Handled = true; }
        else if (e.KeyCode == Keys.PageUp) { Value = _value + Increment * 10; e.Handled = true; }
        else if (e.KeyCode == Keys.PageDown) { Value = _value - Increment * 10; e.Handled = true; }
        else if (e.KeyCode == Keys.Home) { Value = _min; e.Handled = true; }
        else if (e.KeyCode == Keys.End) { Value = _max; e.Handled = true; }
        base.OnKeyDown(e);
    }

    protected override void OnKeyPress(KeyPressEventArgs e)
    {
        char c = e.KeyChar;

        if (c >= '0' && c <= '9')
        {
            // TYPED DIGITS ARE ACCUMULATED and only become the value when
            // they are inside the range, so a box that goes to 1600 can be
            // typed into without the first "1" snapping to the minimum.
            string next = _typed == "0" ? "" + c : _typed + c;
            if (next.Length <= 9)
            {
                int parsed = int.Parse(next);
                _typed = next;
                if (parsed >= _min && parsed <= _max) { _value = parsed; EventHandler? h = ValueChanged; if (h != null) h(this, EventArgs.Empty); }
                Invalidate();
            }
            e.Handled = true;
        }
        else if (c == '\b')
        {
            _typed = _typed.Length > 1 ? _typed.Substring(0, _typed.Length - 1) : "0";
            int parsed = int.Parse(_typed);
            if (parsed >= _min && parsed <= _max) _value = parsed;
            Invalidate();
            e.Handled = true;
        }
        else if (c == '\r') { Value = _value; e.Handled = true; }
        base.OnKeyPress(e);
    }

    /// Leaving the box settles whatever was typed into a real value.
    protected override void OnLostFocus(EventArgs e) { int parsed = int.Parse(_typed); _value = parsed; Value = parsed; Invalidate(); base.OnLostFocus(e); }
    protected override void OnGotFocus(EventArgs e) { Invalidate(); base.OnGotFocus(e); }
}

/// <summary>
/// One page of a tab control: a container with a caption on its tab. It is
/// an ordinary control, so anything can be put on it at coordinates of its
/// own, and the tab control moves and shows it.
/// </summary>
public class TabPage : Control
{
    internal override string ClassName { get { return "TabPage"; } }

    public TabPage() { TabStop = false; BackColor = SystemColors.Control; }
    public TabPage(string text) : this() { Text = text; }
}

/// <summary>
/// Pages behind tabs. The tabs are drawn as Windows 98 drew them: the
/// selected one is a pixel taller, two wider, and joins the page below it
/// with no line between, which is the whole trick that makes the front tab
/// look like it is in front.
/// </summary>
public class TabControl : Control
{
    internal override string ClassName { get { return "TabControl"; } }

    readonly TabPageCollection _pages;
    int _selected = -1;
    int _hot = -1;

    /// The height of the tab strip, and how far a selected tab grows.
    public const int TabHeight = 21;
    const int Grow = 2;

    public TabControl()
    {
        _pages = new TabPageCollection(this);
        Width = 300;
        Height = 200;
        BackColor = SystemColors.Control;
    }

    public event EventHandler? SelectedIndexChanged;

    public TabPageCollection TabPages { get { return _pages; } }

    public int SelectedIndex
    {
        get { return _selected; }
        set
        {
            int want = value < 0 || value >= _pages.Count ? -1 : value;
            if (want == _selected) { return; }
            _selected = want;
            Arrange();
            Invalidate();
            EventHandler? h = SelectedIndexChanged;
            if (h != null) h(this, EventArgs.Empty);
        }
    }

    public TabPage? SelectedTab
    {
        get { return _selected < 0 ? null : _pages[_selected]; }
        set { SelectedIndex = value == null ? -1 : _pages.IndexOf(value); }
    }

    /// Where a page sits: inside the frame, below the tabs.
    public Rectangle DisplayRectangle { get { return new Rectangle(3, TabHeight + 2, Width - 6, Height - TabHeight - 5); } }

    internal void Arrange()
    {
        Rectangle area = DisplayRectangle;

        for (int i = 0; i < _pages.Count; i++)
        {
            TabPage page = _pages[i];
            page.SetBounds(area.X, area.Y, area.Width, area.Height);
            page.Visible = i == _selected;
        }
        if (_selected < 0 && _pages.Count > 0) { SelectedIndex = 0; }
    }

    public override void SetBounds(int x, int y, int w, int h) { base.SetBounds(x, y, w, h); Arrange(); }

    int TabWidth(int index) { return Font.TextWidth(ControlPaint.StripMnemonic(_pages[index].Text)) + 18; }

    int TabLeft(int index)
    {
        int x = 2;
        for (int i = 0; i < index; i++) x += TabWidth(i);
        return x;
    }

    int TabAt(int x, int y)
    {
        if (y >= TabHeight + Grow) { return -1; }
        int at = 2;
        for (int i = 0; i < _pages.Count; i++)
        {
            int w = TabWidth(i);
            if (x >= at && x < at + w) { return i; }
            at += w;
        }
        return -1;
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;

        g.FillRectangle(new SolidBrush(BackColor), 0, 0, Width, Height);

        // THE PAGE FRAME FIRST, tabs on top of it: the selected tab has to
        // paint out the frame's top edge where it meets it, and the only
        // way to do that is to draw it afterwards.
        int frame = TabHeight;
        ControlPaint.DrawBorder3D(g, 0, frame, Width, Height - frame, Border3DStyle.RaisedOuter);
        ControlPaint.DrawBorder3D(g, 1, frame + 1, Width - 2, Height - frame - 2, Border3DStyle.RaisedInner);

        for (int i = 0; i < _pages.Count; i++) if (i != _selected) Tab(g, i, false);
        if (_selected >= 0) Tab(g, _selected, true);

        base.OnPaint(e);
    }

    void Tab(Graphics g, int index, bool front)
    {
        int x = TabLeft(index), w = TabWidth(index);
        int y = front ? 0 : Grow;
        int h = TabHeight - y + (front ? Grow + 2 : 0);

        if (front) { x -= Grow; w += Grow * 2; }

        Pen lit = new Pen(SystemColors.ControlLightLight);
        Pen shade = new Pen(SystemColors.ControlDarkDark);

        g.FillRectangle(new SolidBrush(SystemColors.Control), x, y, w, h);

        // A TAB IS A BOX WITH NO BOTTOM: highlight up the left and along
        // the top, shadow down the right, and nothing at all across the
        // foot, which is what joins it to the page.
        g.DrawLine(lit, x, y + 2, x, y + h - 1);
        g.DrawLine(lit, x + 2, y, x + w - 3, y);
        g.DrawLine(lit, x + 1, y + 1, x + 1, y + 1);
        g.DrawLine(shade, x + w - 1, y + 2, x + w - 1, y + h - 1);
        g.DrawLine(new Pen(SystemColors.ControlDark), x + w - 2, y + 2, x + w - 2, y + h - 1);
        g.DrawLine(new Pen(SystemColors.ControlDark), x + w - 2, y + 1, x + w - 2, y + 1);

        string shown = ControlPaint.StripMnemonic(_pages[index].Text);
        int ty = y + (TabHeight - Font.Height) / 2 + (front ? 1 : 0);
        int tx = x + (w - Font.TextWidth(shown)) / 2;

        ControlPaint.DrawStringMnemonic(g, _pages[index].Text, Font, new SolidBrush(Enabled ? ForeColor : SystemColors.GrayText), SystemColors.Control, tx, ty, true);

        if (front && Focused && Enabled)
            ControlPaint.DrawFocusRectangle(g, tx - 3, ty - 2, Font.TextWidth(shown) + 6, Font.Height + 4);
    }

    protected override void OnMouseDown(MouseEventArgs e)
    {
        int at = TabAt(e.X, e.Y);
        if (at >= 0) { Focus(); SelectedIndex = at; }
        base.OnMouseDown(e);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        // Left and right walk the tabs when the strip has the focus;
        // Ctrl+Tab walks them from anywhere on the page, as in Windows.
        if (e.KeyCode == Keys.Left && _selected > 0) { SelectedIndex = _selected - 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Right && _selected + 1 < _pages.Count) { SelectedIndex = _selected + 1; e.Handled = true; }
        else if (e.KeyCode == Keys.Tab && e.Control && _pages.Count > 0)
        {
            SelectedIndex = (_selected + (e.Shift ? _pages.Count - 1 : 1)) % _pages.Count;
            e.Handled = true;
        }
        base.OnKeyDown(e);
    }

    public class TabPageCollection
    {
        readonly TabControl _owner;
        readonly List<TabPage> _held = new List<TabPage>();

        public TabPageCollection(TabControl owner) { _owner = owner; }

        public int Count { get { return _held.Count; } }
        public TabPage this[int index] { get { return _held[index]; } }
        public int IndexOf(TabPage page) { return _held.IndexOf(page); }

        public void Add(TabPage page)
        {
            _held.Add(page);
            _owner.Controls.Add(page);
            page.TabStop = false;
            if (_owner.SelectedIndex < 0) _owner.SelectedIndex = 0;
            _owner.Arrange();
            _owner.Invalidate();
        }

        public TabPage Add(string text) { TabPage page = new TabPage(text); Add(page); return page; }
    }
}

/// <summary>
/// The strip along the bottom of a window: sunken panels with text in
/// them, and a grip in the corner of a window that can be resized.
/// </summary>
public class StatusBarPanel
{
    public string Text = "";
    public int Width = 100;

    /// A panel with this set takes whatever room is left over, which is
    /// what the first panel of a status bar usually does.
    public bool Spring;

    internal StatusBar? Owner;

    public StatusBarPanel() { }
    public StatusBarPanel(string text) { Text = text; }
}

public class StatusBar : Control
{
    internal override string ClassName { get { return "StatusBar"; } }

    readonly List<StatusBarPanel> _panels = new List<StatusBarPanel>();

    public StatusBar() { TabStop = false; Height = 20; BackColor = SystemColors.Control; }

    /// Whether the corner shows the diagonal ribs that say a window can be
    /// dragged bigger.
    public bool SizingGrip = true;

    public int Count { get { return _panels.Count; } }
    public StatusBarPanel this[int index] { get { return _panels[index]; } }

    public StatusBarPanel AddPanel(string text) { StatusBarPanel panel = new StatusBarPanel(text); panel.Owner = this; _panels.Add(panel); Invalidate(); return panel; }

    /// The whole bar as one panel, which is the common case.
    public override string Text
    {
        get { return _panels.Count > 0 ? _panels[0].Text : base.Text; }
        set
        {
            if (_panels.Count == 0) { StatusBarPanel only = AddPanel(value); only.Spring = true; }
            else _panels[0].Text = value;
            Invalidate();
        }
    }

    public void SetPanel(int index, string text) { if (index >= 0 && index < _panels.Count) { _panels[index].Text = text; Invalidate(); } }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, Width, Height);

        int grip = SizingGrip ? 16 : 0;
        int fixedWidth = 0, springing = 0;

        for (int i = 0; i < _panels.Count; i++) { if (_panels[i].Spring) springing++; else fixedWidth += _panels[i].Width; }

        int spare = Width - grip - fixedWidth - (_panels.Count + 1) * 2;
        int each = springing > 0 && spare > 0 ? spare / springing : 0;
        int x = 2;

        for (int i = 0; i < _panels.Count; i++)
        {
            int w = _panels[i].Spring ? each : _panels[i].Width;
            if (w < 0) w = 0;

            ControlPaint.DrawBorder3D(g, x, 2, w, Height - 4, Border3DStyle.SunkenOuter);
            g.DrawString(_panels[i].Text, Font, new SolidBrush(ForeColor), BackColor, x + 4, (Height - Font.Height) / 2);
            x += w + 2;
        }

        if (SizingGrip)
        {
            // THREE RIBS IN THE CORNER, each a light line with a shadow
            // beside it: the same grip every window of the era wore.
            Pen lit = new Pen(SystemColors.ControlLightLight), shade = new Pen(SystemColors.ControlDark);

            for (int rib = 0; rib < 3; rib++)
            {
                int at = Width - 3 - rib * 4;
                g.DrawLine(shade, at, Height - 3, Width - 3, at - (Width - Height));
                g.DrawLine(lit, at - 1, Height - 3, Width - 3, at - 1 - (Width - Height));
            }
        }
        base.OnPaint(e);
    }
}

/// <summary>
/// Text that is a link: blue, underlined, and a hand over it. .NET's
/// LinkLabel, less the multiple-link machinery nothing here needs.
/// </summary>
public class LinkLabel : Label
{
    internal override string ClassName { get { return "LinkLabel"; } }

    public LinkLabel() { ForeColor = Color.FromArgb(0, 0, 238); TabStop = true; }

    public event EventHandler? LinkClicked;
    public Color ActiveLinkColor = Color.FromArgb(255, 0, 0);
    public Color VisitedLinkColor = Color.FromArgb(128, 0, 128);
    public bool LinkVisited;

    public override bool CanSelect { get { return TabStop && Visible && Enabled; } }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        string shown = ControlPaint.StripMnemonic(Text);
        Color ink = !Enabled ? SystemColors.GrayText : LinkVisited ? VisitedLinkColor : ForeColor;

        g.DrawString(shown, Font, new SolidBrush(ink), EffectiveBackColor, 0, 0);
        g.FillRectangle(new SolidBrush(ink), 0, Font.Ascent + 1, Font.TextWidth(shown), 1);

        if (Focused && Enabled) ControlPaint.DrawFocusRectangle(g, -1, -1, Font.TextWidth(shown) + 2, Font.Height + 2);
    }

    protected override void OnClick(EventArgs e)
    {
        LinkVisited = true;
        Invalidate();
        EventHandler? h = LinkClicked;
        if (h != null) h(this, EventArgs.Empty);
        base.OnClick(e);
    }

    protected override void OnMouseDown(MouseEventArgs e) { Focus(); base.OnMouseDown(e); }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Enter || e.KeyCode == Keys.Space) { PerformClick(); e.Handled = true; }
        base.OnKeyDown(e);
    }
}

/// <summary>
/// The little yellow box that appears when the pointer rests on something.
/// One of these serves a whole form: SetToolTip says what each control's
/// text is, and the rest happens on the message loop's timer.
/// </summary>
public class ToolTip
{
    static ToolTipWindow? _shown;
    static Control? _over;
    static long _since;
    static readonly List<Control> _owners = new List<Control>();
    static readonly List<string> _texts = new List<string>();
    static Timer? _clock;

    /// How long the pointer must rest before the tip appears, and how long
    /// the tip stays up. Windows' numbers.
    public int InitialDelay = 500;
    public int AutoPopDelay = 5000;
    public bool Active = true;

    public ToolTip() { }

    public void SetToolTip(Control c, string text)
    {
        int at = _owners.IndexOf(c);

        if (text.Length == 0) { if (at >= 0) { _owners.RemoveAt(at); _texts.RemoveAt(at); } return; }
        if (at >= 0) { _texts[at] = text; return; }

        _owners.Add(c);
        _texts.Add(text);
        Start();
    }

    public string GetToolTip(Control c) { int at = _owners.IndexOf(c); return at < 0 ? "" : _texts[at]; }

    /// The timer is one for the whole system, and IT RUNS ONLY WHILE THE
    /// POINTER IS RESTING ON SOMETHING THAT HAS A TIP. It used to be started
    /// by the first control ever given a tip and never stopped, so any
    /// program with one tooltip anywhere woke ten times a second for the rest
    /// of its life -- a timer fired, a frame presented, the seat polled --
    /// to find, every time, that the pointer was not over anything. A
    /// program that is not being touched has no business waking at all.
    static void Start()
    {
        if (_clock != null) { return; }
        _clock = new Timer();
        _clock.Interval = 100;
        _clock.Tick += Tick;
    }

    /// The pointer has moved on to `c`, or off everything.
    internal static void Hover(Control? c)
    {
        if (_over == c) { return; }
        _over = c;
        _since = Application.Now();
        Hide();
        Timer? clock = _clock;
        if (clock == null) { return; }
        if (c != null && _owners.IndexOf(c) >= 0) clock.Start();
        else clock.Stop();
    }

    static void Tick(object sender, EventArgs e)
    {
        Control? over = _over;

        if (over == null) { Hide(); StopClock(); return; }

        int at = _owners.IndexOf(over);

        if (at < 0) { Hide(); StopClock(); return; }

        // Never over a drag: a tip that comes up under a held button is
        // in the way of the very thing being done.
        if (Application.ButtonHeld) { _since = Application.Now(); Hide(); return; }

        long waited = Application.Now() - _since;

        // Shown and timed out: nothing more to wait for until the pointer
        // moves on, and Hover starts the clock again when it does.
        if (_shown != null) { if (waited > 5500) { Hide(); StopClock(); } return; }
        if (waited < 500) { return; }

        Point where = over.PointToScreen(new Point(0, over.Height + 2));
        ToolTipWindow window = new ToolTipWindow(_texts[at]);
        int x = where.X, y = where.Y;

        if (x + window.Width > Seat.Current.Width) x = Seat.Current.Width - window.Width;
        if (y + window.Height > Seat.Current.Height) y = where.Y - over.Height - window.Height - 4;
        if (x < 0) x = 0;
        if (y < 0) y = 0;

        window.SetBounds(x, y, window.Width, window.Height);
        _shown = window;
        window.Show();
    }

    static void StopClock() { Timer? clock = _clock; if (clock != null) clock.Stop(); }

    static void Hide()
    {
        ToolTipWindow? window = _shown;
        _shown = null;
        if (window != null && !window.IsClosed) window.Close();
    }

    public void Hide(Control c) { Hide(); }
    public void RemoveAll() { _owners.Clear(); _texts.Clear(); Hide(); }
}

/// The tip's window: no frame, never in the taskbar, and it never takes
/// the focus, so whatever the person was doing keeps it.
internal class ToolTipWindow : Form
{
    internal override string ClassName { get { return "ToolTip"; } }
    protected override bool ShowWithoutActivation { get { return true; } }

    readonly string _text;

    internal ToolTipWindow(string text)
    {
        _text = text;
        FormBorderStyle = FormBorderStyle.None;
        StartPosition = FormStartPosition.Manual;
        TopMost = true;
        ShowInTaskbar = false;
        BackColor = SystemColors.Info;
        ForeColor = SystemColors.InfoText;
        Width = Font.TextWidth(text) + 8;
        Height = Font.Height + 6;
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(SystemColors.Info), 0, 0, Width, Height);
        g.DrawRectangle(new Pen(SystemColors.WindowFrame), 0, 0, Width, Height);
        g.DrawString(_text, Font, new SolidBrush(SystemColors.InfoText), SystemColors.Info, 4, 3);
    }
}

public class ToolStripItem
{
    public string Text = "";
    public Icon? Image;                // drawn in the gutter the text is already indented past
    public event EventHandler? Click;
    internal ContextMenuStrip? Owner;

    /// A greyed-out command: still listed, still says what it is, and does
    /// nothing. Leaving it out instead would make the menu change shape.
    public bool Enabled = true;

    /// A tick to the left of the name, for a command that is a setting.
    public bool Checked;

    /// What to put in the right-hand column: "Ctrl+S", "F5". Not acted on
    /// here -- the program's own key handling does that -- but a menu that
    /// does not say so leaves the keys undiscoverable.
    public string ShortcutText = "";

    public ToolStripItem() { }
    public ToolStripItem(string text) { Text = text; }
    public void PerformClick() { if (Enabled && Click != null) Click(this, EventArgs.Empty); }
}

public class ToolStripMenuItem : ToolStripItem
{
    public ToolStripMenuItem() { }
    public ToolStripMenuItem(string text) : base(text) { }
}

public class ToolStripSeparator : ToolStripItem
{
    public ToolStripSeparator() : base("-") { Enabled = false; }
}

public class ToolStripItemCollection
{
    List<ToolStripItem> _items = new List<ToolStripItem>();
    ContextMenuStrip _owner;
    public ToolStripItemCollection(ContextMenuStrip owner) { _owner = owner; }
    public int Count { get { return _items.Count; } }
    public ToolStripItem this[int i] { get { return _items[i]; } }
    // One body, no overload: an earlier Add(string) that called Add(item)
    // landed in the list twice, so every named item appeared twice on the
    // menu. Both entry points go through the same private step now.
    public ToolStripMenuItem Add(string text) { ToolStripMenuItem item = new ToolStripMenuItem(text); Append(item); return item; }
    public void Add(ToolStripItem item) { Append(item); }
    void Append(ToolStripItem item) { item.Owner = _owner; _items.Add(item); }
}

/// <summary>
/// A popup list of commands at a screen position: a right-click menu, a
/// start menu. Its own top-level window above everything; it goes away
/// when a command is chosen, when Escape is pressed, or when a click
/// anywhere else takes the focus from it.
///
/// It is worked with the keyboard as well as the pointer: the arrows move
/// the highlight, Enter chooses, Escape shuts it, and a letter chooses the
/// command whose name carries that letter after an ampersand.
/// </summary>
public class ContextMenuStrip : Form
{
    internal override string ClassName { get { return "ContextMenuStrip"; } }
    public ToolStripItemCollection Items;
    int _hot = -1;
    public const int ItemHeight = 19;
    public const int SeparatorHeight = 9;

    /// The band down the left that icons sit in. The text starts after it,
    /// which is what lines every name in a menu up whether or not the
    /// command beside it has a picture.
    const int Gutter = 22;
    const int Pad = 3;

    public ContextMenuStrip()
    {
        Items = new ToolStripItemCollection(this);
        FormBorderStyle = FormBorderStyle.None;
        StartPosition = FormStartPosition.Manual;
        TopMost = true;
        ShowInTaskbar = false;
        BackColor = SystemColors.Menu;
    }

    public void Show(Point screen) { Show(screen.X, screen.Y); }

    public void Show(int screenX, int screenY)
    {
        int widest = 0, shortcut = 0;

        for (int i = 0; i < Items.Count; i++)
        {
            int length = Font.TextWidth(ControlPaint.StripMnemonic(Items[i].Text));
            if (length > widest) widest = length;
            int keys = Font.TextWidth(Items[i].ShortcutText);
            if (keys > shortcut) shortcut = keys;
        }

        int w = Gutter + widest + (shortcut > 0 ? shortcut + 16 : 0) + 24;
        int h = Depth(Items.Count) + Pad * 2;
        Seat seat = Seat.Current;

        if (screenX + w > seat.Width) screenX = seat.Width - w;
        if (screenY + h > seat.WorkAreaHeight()) screenY = screenY - h;
        if (screenY < 0) screenY = 0;
        if (screenX < 0) screenX = 0;

        SetBounds(screenX, screenY, w, h);
        _hot = -1;
        Show();
        Activate();
    }

    /// How far down the menu the item at `index` starts, counting the
    /// separators, which are shorter than commands.
    int Depth(int index)
    {
        int at = 0;
        for (int i = 0; i < index && i < Items.Count; i++) at += Items[i] is ToolStripSeparator ? SeparatorHeight : ItemHeight;
        return at;
    }

    int ItemAt(int y)
    {
        int at = Pad;
        for (int i = 0; i < Items.Count; i++)
        {
            int high = Items[i] is ToolStripSeparator ? SeparatorHeight : ItemHeight;
            if (y >= at && y < at + high) return i;
            at += high;
        }
        return -1;
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        Graphics g = e.Graphics;
        g.FillRectangle(new SolidBrush(BackColor), 0, 0, Width, Height);
        ControlPaint.DrawBorder3D(g, 0, 0, Width, Height, Border3DStyle.Raised);

        for (int i = 0; i < Items.Count; i++)
        {
            ToolStripItem item = Items[i];
            int y = Pad + Depth(i);

            if (item is ToolStripSeparator)
            {
                // THE GROOVE, not a line: shadow with highlight under it,
                // the same edge a group box wears.
                int at = y + SeparatorHeight / 2 - 1;
                g.DrawLine(new Pen(SystemColors.ControlDark), 3, at, Width - 4, at);
                g.DrawLine(new Pen(SystemColors.ControlLightLight), 3, at + 1, Width - 4, at + 1);
                continue;
            }

            bool hot = i == _hot && item.Enabled;

            if (hot) g.FillRectangle(new SolidBrush(SystemColors.Highlight), 3, y, Width - 6, ItemHeight);

            if (item.Checked) ControlPaint.DrawCheckMark(g, 7, y + (ItemHeight - 8) / 2, hot ? SystemColors.HighlightText : SystemColors.MenuText);
            else if (item.Image != null) item.Image.Draw(g, 4, y + (ItemHeight - 16) / 2, 16);

            int ty = y + (ItemHeight - Font.Height) / 2;
            Color ink = !item.Enabled ? SystemColors.GrayText : hot ? SystemColors.HighlightText : SystemColors.MenuText;

            if (!item.Enabled)
                ControlPaint.DrawStringMnemonic(g, item.Text, Font, new SolidBrush(SystemColors.ControlLightLight), Gutter + 1, ty + 1, true);

            ControlPaint.DrawStringMnemonic(g, item.Text, Font, new SolidBrush(ink), hot ? SystemColors.Highlight : BackColor, Gutter, ty, true);

            if (item.ShortcutText.Length > 0)
                g.DrawString(item.ShortcutText, Font, new SolidBrush(ink), hot ? SystemColors.Highlight : BackColor, Width - 8 - Font.TextWidth(item.ShortcutText), ty);
        }
        base.OnPaint(e);
    }

    protected override void OnMouseMove(MouseEventArgs e)
    {
        int at = ItemAt(e.Y);
        if (at != _hot) { _hot = at; Invalidate(); }
        base.OnMouseMove(e);
    }

    protected override void OnMouseUp(MouseEventArgs e)
    {
        int at = ItemAt(e.Y);
        base.OnMouseUp(e);
        if (at < 0 || !Items[at].Enabled) return;
        Choose(at);
    }

    void Choose(int index)
    {
        ToolStripItem item = Items[index];
        Close();
        item.PerformClick();
    }

    /// The next command in `step`'s direction, skipping separators and
    /// anything greyed out, wrapping at the ends.
    void Step(int step)
    {
        if (Items.Count == 0) { return; }

        int at = _hot;
        for (int tried = 0; tried < Items.Count; tried++)
        {
            at = (at + step + Items.Count) % Items.Count;
            if (Items[at].Enabled && !(Items[at] is ToolStripSeparator)) { _hot = at; Invalidate(); return; }
        }
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Down) { Step(1); e.Handled = true; }
        else if (e.KeyCode == Keys.Up) { Step(-1); e.Handled = true; }
        else if (e.KeyCode == Keys.Escape) { e.Handled = true; Close(); }
        else if ((e.KeyCode == Keys.Enter || e.KeyCode == Keys.Space) && _hot >= 0 && Items[_hot].Enabled) { e.Handled = true; Choose(_hot); }
        base.OnKeyDown(e);
    }

    protected override void OnKeyPress(KeyPressEventArgs e)
    {
        if (e.KeyChar == (char)27) { e.Handled = true; Close(); return; }

        // A LETTER PICKS THE COMMAND CARRYING IT. One match runs straight
        // away; that is what a menu's underlined letters are for.
        char key = e.KeyChar >= 'A' && e.KeyChar <= 'Z' ? (char)(e.KeyChar + 32) : e.KeyChar;

        if (key > ' ' && key < (char)127)
        {
            for (int i = 0; i < Items.Count; i++)
            {
                if (!Items[i].Enabled || ControlPaint.MnemonicOf(Items[i].Text) != key) continue;
                e.Handled = true;
                Choose(i);
                return;
            }
        }
        base.OnKeyPress(e);
    }

    protected override void OnDeactivate(EventArgs e) { base.OnDeactivate(e); Close(); }
}

// ---------------------------------------------------------------------------
// The application: the message loop and the things it owns.
// ---------------------------------------------------------------------------

public delegate void WatchHandler(int fd);

public static class Application
{
    // THE DOUBLE-CLICK: a second press of the same button on the same
    // control, within SystemInformation.DoubleClickTime and inside the
    // DoubleClickSize box centred on the first. A third press starts again,
    // as on Windows.
    static Control? _clickTarget;
    static MouseButtons _clickButton;
    static int _clickAt, _clickX, _clickY;
    internal static int LastClicks;

    internal static int CountClick(Control target, MouseButtons button, int x, int y)
    {
        int now = Environment.TickCount;
        Size box = SystemInformation.DoubleClickSize;
        bool second = LastClicks == 1 && target == _clickTarget && button == _clickButton
            && now - _clickAt <= SystemInformation.DoubleClickTime
            && (x > _clickX ? x - _clickX : _clickX - x) <= box.Width / 2 && (y > _clickY ? y - _clickY : _clickY - y) <= box.Height / 2;
        LastClicks = second ? 2 : 1;
        _clickTarget = target; _clickButton = button; _clickAt = now; _clickX = x; _clickY = y;
        return LastClicks;
    }

    /// The seat's action numbers as Windows Forms spells them.
    internal static MouseButtons ButtonOf(int action)
    {
        return action == 1 ? MouseButtons.Left : action == 2 ? MouseButtons.Right : action == 3 ? MouseButtons.Middle
             : action == 4 ? MouseButtons.XButton1 : action == 5 ? MouseButtons.XButton2 : MouseButtons.None;
    }

    static List<Form> _forms = new List<Form>();


    static List<Timer> _timers = new List<Timer>();
    internal static void AddTimer(Timer t) { if (!_timers.Contains(t)) _timers.Add(t); }
    internal static void RemoveTimer(Timer t) { _timers.Remove(t); }
    /// Milliseconds on a clock that only goes forward.
    public static long Now() { return DateTime.UtcNow.Ticks / 10000; }
    /// How long the loop may wait before a timer is due: -1 for ever.
    static int TimerWait()
    {
        if (_timers.Count == 0) return -1;
        long now = Now(), soonest = -1;
        for (int i = 0; i < _timers.Count; i++) { long left = _timers[i].Due - now; if (left < 0) left = 0; if (soonest < 0 || left < soonest) soonest = left; }
        return soonest > 1000000 ? 1000000 : (int)soonest;
    }
    static void FireTimers()
    {
        long now = Now();
        for (int i = 0; i < _timers.Count; i++) if (_timers[i].Due <= now) _timers[i].Fire();
    }
    /// Where the next window with no position of its own goes: down and
    /// right of the windows already on the seat, a caption's height per
    /// window, back to the corner when it would run off the screen. Asked of
    /// the SEAT, not counted here: two terminals are two processes, and a
    /// count kept in each would put both in the same place. Two opened one
    /// after the other are then both visible, which is what Windows does and
    /// what a person opening a second one expects.
    internal static Point NextCascade(int width, int height, int screenWidth, int screenHeight)
    {
        const int Step = Form.CaptionHeight + Form.BorderWidth;
        const int Margin = 24;
        int shown = Seat.Current.ShownWindows();
        int x = Margin + shown * Step, y = Margin + shown * Step;
        if (x + width > screenWidth || y + height > screenHeight) { x = Margin; y = Margin; }
        return new Point(x, y);
    }
    static bool _running;
    static int _exitCode;
    static Control? _focus;
    static Form? _active;
    static Form? _dragging;
    static int _dragX, _dragY;
    static bool _dragPending;
    static int _dragToX, _dragToY;
    static int _resizeEdges;                // 0 while dragging; edges while resizing (see Form.ResizeEdges)
    static Rectangle _resizeFrom;           // the window's bounds at the press
    static int _resizeSX, _resizeSY;        // where on the screen the press was
    static int _dragToW, _dragToH;

    /// A press on a sizable edge: the bounds follow the pointer, applied
    /// on release only, since every size is a new surface in the seat.
    internal static void BeginResize(Form f, int edges, int x, int y)
    {
        _dragging = f; _resizeEdges = edges; _resizeFrom = f.Bounds;
        _resizeSX = f.Left + x; _resizeSY = f.Top + y;
        // The window itself does not move until the button comes up: every
        // intermediate size would be a new surface, a full repaint and a
        // composition, which is what made a resize crawl. The seat draws an
        // outline instead, and the last one is the size that is applied.
        Seat.Current.SetCursor(Form.CursorFor(edges));
        Seat.Current.SetBand(f.Left, f.Top, f.Width, f.Height);
    }

    static void ResizeTo(int sx, int sy)
    {
        if (_dragging == null) return;
        int dx = sx - _resizeSX, dy = sy - _resizeSY;
        int x = _resizeFrom.X, y = _resizeFrom.Y, w = _resizeFrom.Width, h = _resizeFrom.Height;
        if ((_resizeEdges & 1) != 0) { x += dx; w -= dx; }
        if ((_resizeEdges & 2) != 0) { w += dx; }
        if ((_resizeEdges & 4) != 0) { y += dy; h -= dy; }
        if ((_resizeEdges & 8) != 0) { h += dy; }
        if (w < Form.MinimumWidth) { if ((_resizeEdges & 1) != 0) x -= Form.MinimumWidth - w; w = Form.MinimumWidth; }
        if (h < Form.MinimumHeight) { if ((_resizeEdges & 4) != 0) y -= Form.MinimumHeight - h; h = Form.MinimumHeight; }
        _dragToX = x; _dragToY = y; _dragToW = w; _dragToH = h; _dragPending = true;
        Seat.Current.SetBand(x, y, w, h);
    }
    static int _sinceDrag;                  // messages since the window last moved: bounded, or a busy tablet never lets it

    /// The drag's latest position is applied once the queue is quiet, not
    /// once per Move: a tablet sends hundreds a second and each move is a
    /// window move and a repaint, so applying every one made the window
    /// crawl behind the pointer.
    static void SettleDrag()
    {
        if (!_dragPending || _dragging == null) { _dragPending = false; return; }
        _dragPending = false;
        _sinceDrag = 0;
        if (_resizeEdges != 0) { Seat.Current.ClearBand(); Seat.Current.SetCursor(Cursors.Arrow); _dragging.SetBounds(_dragToX, _dragToY, _dragToW, _dragToH); }
        else _dragging.SetBounds(_dragToX, _dragToY, _dragging.Width, _dragging.Height);
    }
    static bool _paintPending;
    static List<int> _watchFds = new List<int>();
    static List<WatchHandler> _watchHandlers = new List<WatchHandler>();

    public static event EventHandler? Idle;

    public static Control? FocusedControl { get { return _focus; } }
    public static Form? ActiveForm { get { return _active; } }
    internal static Control? Captured;

    /// A mouse button is down somewhere: nothing pops up over a drag.
    internal static bool ButtonHeld;
    internal static void RegisterQuietly(Form f) { if (!_forms.Contains(f)) _forms.Add(f); }
    internal static void Register(Form f) { if (!_forms.Contains(f)) _forms.Add(f); CancelDrag(f); _active = f; f.RaiseActivated(); }

    /// A drag ends when activation moves away from the window being
    /// dragged: a dialog that opens mid-drag would otherwise be the thing
    /// dragged, since the pointer's moves keep coming and the drag would
    /// still be live. The outline, if one was up, comes off.
    static void CancelDrag(Form? nowActive)
    {
        if (_dragging == null || _dragging == nowActive) return;
        if (_resizeEdges != 0) { Seat.Current.ClearBand(); Seat.Current.SetCursor(Cursors.Arrow); }
        _dragging = null; _dragPending = false; _resizeEdges = 0; _sinceDrag = 0;
    }
    internal static void Unregister(Form f) { _forms.Remove(f); if (_active == f) _active = _forms.Count > 0 ? _forms[_forms.Count - 1] : null; if (_focus != null && _focus.FindForm() == f) _focus = null; }
    internal static void NeedsPaint(Control c) { _paintPending = true; }
    /// x, y: where in the window the press was. The drag keeps that point
    /// under the pointer using the pointer's SCREEN position from each Move,
    /// never a delta against the window's last known place: moves queued
    /// before the window moved were against the old place, and applying
    /// their deltas again sent the window off the screen.
    internal static void BeginDrag(Form f, int x, int y) { _dragging = f; _dragX = x; _dragY = y; }

    static Control? _hot;

    /// <summary>
    /// The pointer is over `c`. Whatever it was over before is told it has
    /// left and `c` is told it has been entered, which is what a toolbar
    /// button's hot bevel and a tooltip's timer both wait for.
    /// </summary>
    internal static void Hover(Control? c)
    {
        if (_hot == c) { return; }
        Control? was = _hot;
        _hot = c;
        if (was != null) was.RaiseMouseLeave();
        if (c != null) c.RaiseMouseEnter();
        ToolTip.Hover(c);
    }

    internal static void Forget(Control c) { if (_hot == c) _hot = null; }

    internal static void SetFocus(Control? c)
    {
        if (_focus == c) return;
        Control? old = _focus;
        _focus = c;
        if (old != null) old.RaiseLostFocus();
        if (c != null) c.RaiseGotFocus();
    }

    /// Watch another descriptor from the message loop: a terminal watches its
    /// pseudo-terminal. CORSAC-only, and the one thing here .NET does not have.
    public static void Watch(int fd, WatchHandler handler) { _watchFds.Add(fd); _watchHandlers.Add(handler); }
    public static void Unwatch(int fd) { int i = _watchFds.IndexOf(fd); if (i >= 0) { _watchFds.RemoveAt(i); _watchHandlers.RemoveAt(i); } }

    static Form? FormOf(int handle) { for (int i = 0; i < _forms.Count; i++) if (_forms[i].Handle == handle) return _forms[i]; return null; }

    internal static void PaintNow()
    {
        // A program that has crashed paints nothing but its error box: the
        // paint that threw would throw again.
        for (int i = 0; i < _forms.Count; i++)
            if (!_crashing || _forms[i] == _crashBox)
                _forms[i].PaintWindow(new Rectangle(0, 0, _forms[i].Width, _forms[i].Height), false);
        _paintPending = false;
        // The frame is finished: the seat puts it up in one piece.
        Seat.Current.Present();
    }

    public static void DoEvents()
    {
        while (Seat.Current.Poll(0))
        {
            Message m;
            if (!Seat.Current.Next(out m)) break;
            Dispatch(ref m);
        }
        SettleDrag();
        if (_paintPending) PaintNow();
    }

    public static void Run(Form main)
    {
        main.Show();
        Run();
    }

    /// The loop. Block for a message, dispatch it, paint what became stale,
    /// repeat until the last form closes or Exit is called. Nothing here
    /// polls: Next blocks in the kernel until there is a message.
    public static void Run()
    {
        _running = true;
        Seat seat = Seat.Current;
        while (_running && _forms.Count > 0)
        {
            // WHAT NOBODY CAUGHT IS SHOWN, NOT SWALLOWED. An exception out of
            // a handler or a paint used to end the program with its trace
            // on a stream nobody was watching -- the window simply went.
            // Here it becomes a message box saying what and where, and the
            // program ends when the box is dismissed, as Windows has done
            // since it had message boxes.
            try { if (!Iterate(seat)) break; }
            catch (Exception failure) { Crash(failure); return; }
        }
        _running = false;
    }

    /// Runs the loop until `dialog` closes, and answers what it said.
    internal static DialogResult RunModal(Form dialog)
    {
        dialog.Show();
        dialog.Activate();
        Seat seat = Seat.Current;
        bool was = _running;
        _running = true;
        while (_running && !dialog.IsClosed)
        {
            if (!Iterate(seat)) break;
        }
        _running = was;
        return dialog.DialogResult;
    }

    static bool _crashing;
    static Form? _crashBox;

    static void Crash(Exception failure)
    {
        if (_crashing) { Environment.Exit(134); return; }
        _crashing = true;
        string trace = failure.StackTrace;
        // The first dozen frames say where; the rest is the loop.
        int lines = 0, cut = trace.Length;
        for (int i = 0; i < trace.Length; i++) if (trace[i] == '\n') { lines++; if (lines == 12) { cut = i; break; } }
        string text = failure.GetType().Name + ": " + failure.Message + "\n\n" + trace.Substring(0, cut);
        try
        {
            _crashBox = MessageBox.Build(text, "Program error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            RunModal(_crashBox);
        }
        catch (Exception) { }
        Environment.Exit(134);
    }

    /// One turn of the loop: settle a drag, paint, wait for something,
    /// act on it. False when the seat is gone.
    static bool Iterate(Seat seat)
    {
        {
            if (_dragPending && _resizeEdges == 0 && (!seat.Poll(0) || _sinceDrag >= 3)) SettleDrag();
            if (_paintPending) PaintNow();
            if (Idle != null) Idle(null!, EventArgs.Empty);
            int wait = TimerWait();
            if (_watchFds.Count > 0)
            {
                // Several descriptors: one wait on all of them in the
                // kernel, bounded by the next timer. A watcher that is
                // ready gets its turn; then the seat is asked whether it
                // has anything before blocking in Next, so a burst on the
                // descriptor cannot starve painting.
                int[] fds = new int[_watchFds.Count];
                for (int i = 0; i < fds.Length; i++) fds[i] = _watchFds[i];
                int which = seat.WaitAny(fds, fds.Length, wait);
                // A descriptor that is always ready -- a shell pouring out
                // a listing -- must not stop the clock: a timer that is due
                // fires between two reads, or a terminal that paints on a
                // timer while output flows never paints until it stops.
                if (which >= 0 && which < _watchHandlers.Count)
                {
                    // THE PERSON COMES FIRST. Whatever the seat holds -- a
                    // press, a drag, a key -- is taken and acted on BEFORE
                    // the descriptor is read, and a due timer fires; only
                    // then the shell's next four kilobytes. Output can wait
                    // a millisecond; a hand on the mouse cannot.
                    while (seat.Poll(0))
                    {
                        Message pending;
                        if (!seat.Next(out pending)) break;
                        Dispatch(ref pending);
                    }
                    if (_dragPending && _resizeEdges == 0) SettleDrag();
                    if (_paintPending) PaintNow();
                    if (wait == 0) FireTimers();
                    _watchHandlers[which](fds[which]);
                    return true;
                }
                else if (!seat.Poll(0)) { FireTimers(); return true; }
            }
            else if (wait >= 0)
            {
                if (!seat.Poll(wait)) { FireTimers(); return true; }
            }
            Message m;
            if (!seat.Next(out m)) return false;
            Dispatch(ref m);
        }
        return true;
    }

    public static void Exit() { _running = false; }
    public static void Exit(int code) { _exitCode = code; _running = false; }
    public static int ExitCode { get { return _exitCode; } }

    static void Dispatch(ref Message m)
    {
        Form? f = FormOf(m.Window);
        if (_crashing && f != null && f != _crashBox) return;
        // THE EVENTS THAT BELONG TO NO WINDOW: a key for whatever has focus,
        // the window list changing, an inspection, the pointer moving, and
        // the screen changing size. Everything else names a window and is
        // dropped when that window has gone.
        if (f == null && m.Kind != 1 && m.Kind != 11 && m.Kind != 12 && m.Kind != 13
            && m.Kind != 14 && m.Kind != 15 && m.Kind != 16) return;
        switch (m.Kind)
        {
            case 1:
            {
                Control? target = _focus ?? _active;
                if (target == null) return;
                int key = m.A & 0x1FF;
                int mods = m.B;
                if ((m.A & 0x200) != 0) mods = mods | 4;

                // THE RETURN KEY IS ONE KEY TO A FORM AND ANOTHER TO A
                // TERMINAL. The keyboard driver sends a line feed for it;
                // .NET has one Keys.Enter, which is 13, so that is what
                // KeyDown and the dialog keys are told. KeyPress still
                // carries the character the driver sent, because what a
                // terminal writes down its pseudo-terminal is that byte
                // and not one this layer picked.
                int code = key == 10 ? 13 : key;
                Form? form = target.FindForm();
                if (form == null) form = _active;

                // THE ORDER WINDOWS USES, and the reason a dialog feels
                // right: the control sees the key first, as a KeyDown and
                // then -- if it is a character and nobody took it -- as a
                // KeyPress. Only what is left over becomes a dialog key,
                // so a text box keeps its arrows and its Enter, and a form
                // still gets Tab, Escape and Alt from everywhere else.
                KeyEventArgs down = new KeyEventArgs((Keys)code, mods);
                target.RaiseKeyDown(down);
                bool handled = down.Handled;

                if (!handled) handled = target.ProcessDialogKey((Keys)code, mods);

                // ALT AND A LETTER NEVER BECOMES TYPING. It is a mnemonic,
                // and if nothing answers to it the key is simply dropped.
                if (!handled && (mods & 4) != 0 && key > 32 && key < 256)
                {
                    if (form != null) handled = Mnemonic(form, Lower((char)key));
                    else handled = true;
                    if (!handled) handled = true;
                }

                if (!handled && key < 256)
                {
                    KeyPressEventArgs press = new KeyPressEventArgs((char)key);
                    target.RaiseKeyPress(press);
                    handled = press.Handled;
                }

                if (!handled && form != null) handled = DialogKey(form, target, (Keys)code, mods);

                Message raw = m; target.DispatchRaw(ref raw);
                break;
            }
            case 3:
            {
                int wx = Seat.LowSigned(m.A), wy = Seat.HighSigned(m.A);
                int sx = Seat.LowSigned(m.B), sy = Seat.HighSigned(m.B);
                if (_dragging != null && _resizeEdges != 0) { ResizeTo(sx, sy); break; }     // applied on release
                if (_dragging != null) { _dragToX = sx - _dragX; _dragToY = sy - _dragY; _dragPending = true; _sinceDrag++; break; }
                f!.WindowMouse(3, 0, wx, wy); break;
            }
            case 4:
                ButtonHeld = true;
                if (_active != f && !f!.StaysInactive) { _active = f; f!.RaiseActivated(); }
                f!.WindowMouse(4, m.A & 0xFF, Seat.LowSigned(m.B), Seat.HighSigned(m.B)); break;
            case 6:
            case 7:
            {
                // The seat sends the wheel to the window under the pointer;
                // inside it, the control with the focus gets it, or the form.
                // Already in Windows' units and sense: 120 a notch, up and
                // right positive.
                Control target = (_focus != null && _focus.FindForm() == f) ? _focus : f!;
                MouseEventArgs turned = new MouseEventArgs(MouseButtons.None, 0, 0, 0, m.A);
                if (m.Kind == 6) target.RaiseMouseWheel(turned); else target.RaiseMouseHWheel(turned);
                break;
            }
            case 5:
                ButtonHeld = false;
                SettleDrag();
                // A press on an edge that never moved still put an outline
                // on the screen: it goes when the button does, either way.
                if (_resizeEdges != 0) { Seat.Current.ClearBand(); }
                _dragging = null; _resizeEdges = 0;
                // Signed: a release left of or above the window it was pressed
                // in reports negative coordinates, and reading them unsigned
                // put it out in the frame, where the control holding the
                // button never saw the release and stayed pressed in.
                f!.WindowMouse(5, m.A & 0xFF, Seat.LowSigned(m.B), Seat.HighSigned(m.B)); break;
            case 8:
            {
                int x = m.A & 0xFFFF, y = (m.A >> 16) & 0xFFFF, w = m.B & 0xFFFF, h = (m.B >> 16) & 0xFFFF;
                f!.PaintWindow(new Rectangle(x, y, w, h), true);
                Seat.Current.Present();
                break;
            }
            case 9:
                if (m.A != 0) { CancelDrag(f); _active = f; f!.RaiseActivated(); }
                else { if (_dragging == f) CancelDrag(null); if (_active == f) _active = null; f!.RaiseDeactivate(); }
                break;
            case 11:
                Shell.RaiseWindowsChanged();
                break;
            case 16:
                if (m.A == 1) Shell.RaiseStartRequested();
                break;

            // THE SCREEN IS A DIFFERENT SIZE NOW. The seat has thrown away
            // every window's pixels to do it, so there is nothing to keep:
            // the size is taken again, whoever cares is told, and every
            // form repaints. A form that filled the screen is made to fill
            // the new one, which is what a desktop and a taskbar are.
            case 15:
            {
                Seat.Current.Rescreen(m.A & 0xFFFF, (m.A >> 16) & 0xFFFF);
                SystemInformation.Rescreen();
                Screen.RaiseChanged();

                int screenWidth = Seat.Current.Width, screenHeight = Seat.Current.Height;

                for (int i = 0; i < _forms.Count; i++)
                {
                    Form other = _forms[i];

                    // A FORM THAT FILLED THE SCREEN FILLS THE NEW ONE. Any
                    // other keeps its size; the seat has already brought it
                    // inside the screen if it no longer fitted.
                    if (other.WindowState == FormWindowState.Maximized)
                    {
                        other.SetBounds(0, 0, screenWidth, screenHeight);
                    }

                    other.RaiseScreenChanged();
                }

                for (int i = 0; i < _forms.Count; i++)
                {
                    Form other = _forms[i];

                    other.PaintWindow(new Rectangle(0, 0, other.Width, other.Height), true);
                }
                Seat.Current.Present();
                break;
            }
            case 12:
            {
                // Somebody asks what is at a point of one of our windows.
                if (f == null) { Seat.Current.InspectReply(""); break; }
                int ix = Seat.LowSigned(m.A), iy = Seat.HighSigned(m.A);
                Point co = f.ClientOffset();
                string answer;
                if (iy < co.Y && f.HasFrame) answer = "Form \"" + f.Text + "\" caption";
                else
                {
                    Control target = f.HitTest(ix - co.X, iy - co.Y);
                    answer = target.Describe();
                    Control? parent = target.Parent;
                    if (parent != null && parent != f) answer = answer + " in " + parent.ClassName + " \"" + parent.Text + "\"";
                }
                Seat.Current.InspectReply(answer);
                break;
            }
            case 13:
                Shell.RaiseInspected();
                break;
            case 14:
                Shell.RaisePointerMoved(new MouseEventArgs(MouseButtons.None, 0, Seat.LowSigned(m.A), Seat.HighSigned(m.A), 0));
                break;
            case 10:
                f!.Close(); break;
        }
    }

    static char Lower(char c) { return c >= 'A' && c <= 'Z' ? (char)(c + 32) : c; }

    /// <summary>
    /// The keys a form acts on when no control wanted them: Tab and
    /// Shift+Tab to move the focus, Enter to press the default button,
    /// Escape to press the cancel button, and the arrows to move within a
    /// set of radio buttons. True when the key was used.
    /// </summary>
    static bool DialogKey(Form f, Control target, Keys key, int mods)
    {
        if (key == Keys.Tab)
        {
            Control? next = Step(f, target, (mods & 1) != 0 ? -1 : 1);
            if (next != null) SetFocus(next);
            return true;
        }

        if (key == Keys.Enter)
        {
            Button? accept = f.AcceptButton;
            if (accept != null && accept.Visible && accept.Enabled) { accept.PerformClick(); return true; }
            return false;
        }

        if (key == Keys.Escape)
        {
            Button? cancel = f.CancelButton;
            if (cancel != null && cancel.Visible && cancel.Enabled) { cancel.PerformClick(); return true; }
            return false;
        }

        // A SET OF RADIO BUTTONS IS ONE STOP on the tab order, and the
        // arrows move within it -- picking as they go, which is what
        // Windows does and what makes a set usable without the mouse.
        if (target is RadioButton picked && (key == Keys.Up || key == Keys.Down || key == Keys.Left || key == Keys.Right))
        {
            Control? owner = picked.Parent;
            if (owner == null) return false;
            List<Control> group = new List<Control>();
            Order(owner, group);
            List<Control> radios = new List<Control>();
            for (int i = 0; i < group.Count; i++) if (group[i] is RadioButton r && r.Parent == owner && r.Enabled && r.Visible) radios.Add(group[i]);
            int at = radios.IndexOf(picked);
            if (at < 0 || radios.Count < 2) return false;
            int step = (key == Keys.Up || key == Keys.Left) ? -1 : 1;
            Control moved = radios[(at + step + radios.Count) % radios.Count];
            SetFocus(moved);
            ((RadioButton)moved).Checked = true;
            return true;
        }
        return false;
    }

    /// Alt and a letter: whichever control on this form answers to it.
    static bool Mnemonic(Form f, char key)
    {
        List<Control> all = new List<Control>();
        Order(f, all);
        for (int i = 0; i < all.Count; i++) if (all[i].Reachable && all[i].ProcessMnemonic(key)) return true;
        return false;
    }

    /// The control `step` places along the tab order from `from`, wrapping.
    static Control? Step(Form f, Control from, int step)
    {
        List<Control> all = new List<Control>();
        Order(f, all);
        List<Control> stops = new List<Control>();
        for (int i = 0; i < all.Count; i++) if (all[i].CanSelect && !Skipped(all[i])) stops.Add(all[i]);
        if (stops.Count == 0) return null;
        int at = stops.IndexOf(from);
        if (at < 0) return stops[step > 0 ? 0 : stops.Count - 1];
        return stops[(at + step + stops.Count) % stops.Count];
    }

    /// A radio button that is not the checked one of its set is stepped
    /// over: Windows gives the whole set a single stop, at whichever
    /// button is on, and the arrows move inside it.
    static bool Skipped(Control c)
    {
        if (!(c is RadioButton radio) || radio.Checked) return false;
        Control? owner = radio.Parent;
        if (owner == null) return false;
        for (int i = 0; i < owner.Controls.Count; i++)
            if (owner.Controls[i] is RadioButton other && other.Checked && other.Visible && other.Enabled) return true;
        return false;
    }

    /// <summary>
    /// Every control under `root`, in keyboard order: each container's
    /// children sorted by TabIndex, each one followed immediately by its
    /// own children. That is what makes a group box a place on the order
    /// rather than a hole in it.
    /// </summary>
    static void Order(Control root, List<Control> into)
    {
        int count = root.Controls.Count;
        List<Control> level = new List<Control>();
        for (int i = 0; i < count; i++) level.Add(root.Controls[i]);

        // A short insertion sort: a form has tens of controls, not
        // thousands, and this keeps controls with equal TabIndex in the
        // order they were added.
        for (int i = 1; i < level.Count; i++)
        {
            Control moving = level[i];
            int j = i - 1;
            while (j >= 0 && level[j].TabIndex > moving.TabIndex) { level[j + 1] = level[j]; j--; }
            level[j + 1] = moving;
        }

        for (int i = 0; i < level.Count; i++) { into.Add(level[i]); Order(level[i], into); }
    }

    internal static Control? NextInOrder(Form f, Control from, int step) { return Step(f, from, step); }
}
