/// A tree of menu items the seat runs (one per MainMenu, ContextMenu or
/// ContextMenuStrip): numbered, written as the seat takes it, and told what
/// the seat did with it.
internal abstract class MenuSource
{
    internal int RootId;
    internal bool Sent;                    // the seat has it: a change is sent again at once
    internal bool Writing;                 // being written: a change made meanwhile is in what is written

    internal abstract void Write(MenuWriter w);
    internal abstract void Chosen(int id);
    internal virtual void Closed() { }
    /// WM_INITMENUPOPUP: the menu `id` of this tree is about to open.
    internal virtual void PopupOf(int id) { }

    /// The tree to the seat again, if it has it.
    internal void Changed() { if (Sent && !Writing) SystemMenus.Send(this); }
}

/// A menu tree in the layout the seat's MenuSet reads: its length, the
/// root's id, how many menus; then each menu's id and item count, and each
/// item's type, state, id, submenu id, whether a picture follows, its text
/// in UTF-16 padded to a word, and the picture (256 COLORREFs).
internal class MenuWriter
{
    readonly List<byte> _bytes = new List<byte>();
    int _menus;
    int _menuCountAt;

    internal MenuWriter(int root)
    {
        Word(0); Word(root); _menuCountAt = _bytes.Count; Word(0);
    }

    internal void Menu(int id, int items) { Word(id); Word(items); _menus++; }

    internal void Item(int type, int state, int id, int sub, string text, int[]? picture)
    {
        Word(type); Word(state); Word(id); Word(sub); Word(picture != null ? 1 : 0); Word(text.Length);
        foreach (char c in text) { _bytes.Add((byte)c); _bytes.Add((byte)(c >> 8)); }
        while (_bytes.Count % 4 != 0) _bytes.Add(0);
        if (picture != null) foreach (int v in picture) Word(v);
    }

    void Word(int v) { _bytes.Add((byte)v); _bytes.Add((byte)(v >> 8)); _bytes.Add((byte)(v >> 16)); _bytes.Add((byte)(v >> 24)); }

    internal byte[] Done()
    {
        byte[] b = _bytes.ToArray();
        Put(b, 0, b.Length);
        Put(b, _menuCountAt, _menus);
        return b;
    }

    static void Put(byte[] b, int at, int v) { b[at] = (byte)v; b[at + 1] = (byte)(v >> 8); b[at + 2] = (byte)(v >> 16); b[at + 3] = (byte)(v >> 24); }
}

/// The program's menu trees, by the ids the seat knows them by.
internal static class SystemMenus
{
    const int MftSeparator = 0x800, MftRadioCheck = 0x200, MfsGrayed = 0x3, MfsChecked = 0x8, MfsDefault = 0x1000;
    internal const int Separator = MftSeparator, RadioCheck = MftRadioCheck, Grayed = MfsGrayed, Checked = MfsChecked, Default = MfsDefault;

    static int _next = 1;
    static readonly Dictionary<int, MenuSource> _roots = new Dictionary<int, MenuSource>();

    /// A new id: a tree's, or an item's (which is its submenu's too).
    internal static int NewId() { return _next++; }

    internal static void Register(MenuSource m) { if (m.RootId == 0) m.RootId = NewId(); _roots[m.RootId] = m; }

    internal static void Send(MenuSource m)
    {
        Register(m);
        MenuWriter w = new MenuWriter(m.RootId);
        m.Writing = true;
        try { m.Write(w); }
        finally { m.Writing = false; }
        Seat.Current.SetMenu(w.Done());
        m.Sent = true;
    }

    /// The seat's Command: the item `id` of tree `root` chosen.
    internal static void Command(int id, int root)
    {
        MenuSource? m;
        if (_roots.TryGetValue(root, out m)) m.Chosen(id);
    }

    internal static void Closed(int root)
    {
        MenuSource? m;
        if (_roots.TryGetValue(root, out m)) m.Closed();
    }

    /// The seat's MenuPopup: the program's Popup handlers run, and the tree
    /// as they left it is the answer the popup opens with.
    internal static void Popup(int id, int root)
    {
        MenuSource? m;
        if (!_roots.TryGetValue(root, out m)) { Seat.Current.MenuReady(); return; }
        m.PopupOf(id);
        Send(m);
    }

    /// A popup of `m` at (x, y) on the screen, for `owner`'s window.
    internal static void Track(MenuSource m, Form owner, int x, int y)
    {
        if (owner.Handle == 0) return;
        Send(m);
        Seat.Current.TrackMenu(owner.Handle, m.RootId, x, y);
    }
}

/// A menu (.NET's Menu): items, some with menus of their own.
public abstract class Menu : MenuSource
{
    public MenuItemCollection MenuItems;
    protected Menu() { MenuItems = new MenuItemCollection(this); }

    /// The tree this menu is in: its root's source.
    internal abstract MenuSource Root { get; }

    internal void WriteItems(MenuWriter w, int id)
    {
        int shown = 0;
        foreach (MenuItem item in MenuItems) if (item.Visible) shown++;
        w.Menu(id, shown);
        foreach (MenuItem item in MenuItems)
        {
            if (!item.Visible) continue;
            int type = item.IsSeparator ? SystemMenus.Separator : 0;
            if (item.RadioCheck) type |= SystemMenus.RadioCheck;
            int state = (item.Enabled ? 0 : SystemMenus.Grayed) | (item.Checked ? SystemMenus.Checked : 0) | (item.DefaultItem ? SystemMenus.Default : 0);
            string text = item.Text;
            if (item.ShowShortcut && item.Shortcut != Shortcut.None) text = text + "\t" + MenuItem.ShortcutText(item.Shortcut);
            w.Item(type, state, item.Id, item.MenuItems.Count > 0 ? item.Id : 0, text, null);
        }
        foreach (MenuItem item in MenuItems) if (item.Visible && item.MenuItems.Count > 0) item.WriteItems(w, item.Id);
    }

    internal MenuItem? Find(int id)
    {
        foreach (MenuItem item in MenuItems)
        {
            if (item.Id == id) return item;
            MenuItem? deeper = item.Find(id);
            if (deeper != null) return deeper;
        }
        return null;
    }

    internal override void Write(MenuWriter w) { WriteItems(w, RootId); }

    internal override void Chosen(int id) { MenuItem? item = Find(id); if (item != null) item.PerformClick(); }

    internal override void PopupOf(int id)
    {
        if (id == RootId) { RootPopup(); return; }
        MenuItem? item = Find(id);
        if (item != null) item.RaisePopup();
    }

    /// The tree's own popup opening: a ContextMenu's Popup.
    internal virtual void RootPopup() { }

    /// The item a shortcut belongs to, among this menu's and theirs.
    internal MenuItem? ForShortcut(Shortcut key)
    {
        foreach (MenuItem item in MenuItems)
        {
            if (item.Enabled && item.Visible && item.Shortcut == key && item.MenuItems.Count == 0) return item;
            MenuItem? deeper = item.Enabled ? item.ForShortcut(key) : null;
            if (deeper != null) return deeper;
        }
        return null;
    }
}

/// The items of a menu (.NET's Menu.MenuItemCollection).
public class MenuItemCollection
{
    readonly Menu _owner;
    readonly List<MenuItem> _items = new List<MenuItem>();
    internal MenuItemCollection(Menu owner) { _owner = owner; }
    public int Count { get { return _items.Count; } }
    public MenuItem this[int index] { get { return _items[index]; } }
    public MenuItem Add(string caption) { MenuItem item = new MenuItem(caption); Add(item); return item; }
    public MenuItem Add(string caption, EventHandler onClick) { MenuItem item = new MenuItem(caption, onClick); Add(item); return item; }
    public int Add(MenuItem item) { item.Parent = _owner; _items.Add(item); _owner.Root.Changed(); return _items.Count - 1; }
    public void AddRange(MenuItem[] items) { foreach (MenuItem item in items) { item.Parent = _owner; _items.Add(item); } _owner.Root.Changed(); }
    public void Remove(MenuItem item) { if (_items.Remove(item)) { item.Parent = null; _owner.Root.Changed(); } }
    public void RemoveAt(int index) { _items[index].Parent = null; _items.RemoveAt(index); _owner.Root.Changed(); }
    public void Clear() { foreach (MenuItem item in _items) item.Parent = null; _items.Clear(); _owner.Root.Changed(); }
    public int IndexOf(MenuItem item) { return _items.IndexOf(item); }
    public List<MenuItem>.Enumerator GetEnumerator() { return _items.GetEnumerator(); }
}

/// An item of a menu (.NET's MenuItem): "-" for a separator, '&' before
/// its mnemonic. Its Click when chosen, from the menu or its Shortcut.
public class MenuItem : Menu
{
    internal readonly int Id = SystemMenus.NewId();
    internal Menu? Parent;
    string _text = "";
    bool _checked, _enabled = true, _radio, _default, _visible = true, _showShortcut = true;
    Shortcut _shortcut = Shortcut.None;

    public event EventHandler? Click;
    public event EventHandler? Popup;

    public MenuItem() { }
    public MenuItem(string text) { _text = text; }
    public MenuItem(string text, EventHandler onClick) { _text = text; Click += onClick; }
    public MenuItem(string text, EventHandler onClick, Shortcut shortcut) { _text = text; Click += onClick; _shortcut = shortcut; }
    public MenuItem(string text, MenuItem[] items) { _text = text; MenuItems.AddRange(items); }

    internal override MenuSource Root { get { return Parent != null ? Parent.Root : this; } }

    public string Text { get { return _text; } set { _text = value; Root.Changed(); } }
    public bool Checked { get { return _checked; } set { _checked = value; Root.Changed(); } }
    public bool Enabled { get { return _enabled; } set { _enabled = value; Root.Changed(); } }
    public bool RadioCheck { get { return _radio; } set { _radio = value; Root.Changed(); } }
    public bool DefaultItem { get { return _default; } set { _default = value; Root.Changed(); } }
    public bool Visible { get { return _visible; } set { _visible = value; Root.Changed(); } }
    public Shortcut Shortcut { get { return _shortcut; } set { _shortcut = value; Root.Changed(); } }
    public bool ShowShortcut { get { return _showShortcut; } set { _showShortcut = value; Root.Changed(); } }
    public bool IsParent { get { return MenuItems.Count > 0; } }
    public int Index { get { return Parent != null ? Parent.MenuItems.IndexOf(this) : -1; } }
    internal bool IsSeparator { get { return _text == "-"; } }

    public void PerformClick() { if (_enabled && Click != null) Click(this, EventArgs.Empty); }
    public void PerformSelect() { }
    internal void RaisePopup() { if (Popup != null) Popup(this, EventArgs.Empty); }

    /// What the menu shows for a shortcut in its right-hand column.
    internal static string ShortcutText(Shortcut s)
    {
        int v = (int)s;
        string text = "";
        if ((v & 0x20000) != 0) text = text + "Ctrl+";
        if ((v & 0x10000) != 0) text = text + "Shift+";
        if ((v & 0x40000) != 0) text = text + "Alt+";
        int key = v & 0xFFFF;
        if (key >= 0x110 && key <= 0x11B) return text + "F" + (key - 0x10F);
        if (key == 0x105) return text + "Ins";
        if (key == 0x106) return text + "Del";
        if (key == 8) return text + "Bksp";
        return text + (char)key;
    }
}

/// A form's menu bar (.NET's MainMenu), drawn in its frame by the seat.
public class MainMenu : Menu
{
    internal Form? Owner;
    public MainMenu() { }
    public MainMenu(MenuItem[] items) { MenuItems.AddRange(items); }
    internal override MenuSource Root { get { return this; } }
    public Form? GetForm() { return Owner; }

}

/// A menu opened where the pointer is (.NET's ContextMenu): a control's
/// right click opens its ContextMenu, or its parent's.
public class ContextMenu : Menu
{
    public event EventHandler? Popup;
    public event EventHandler? Collapse;
    public Control? SourceControl;

    public ContextMenu() { }
    public ContextMenu(MenuItem[] items) { MenuItems.AddRange(items); }
    internal override MenuSource Root { get { return this; } }

    /// Opened at `pos` in `control`'s coordinates.
    public void Show(Control control, Point pos)
    {
        SourceControl = control;
        Form? owner = control.FindForm();
        if (owner == null) return;
        Point at = control.PointToScreen(pos);
        SystemMenus.Track(this, owner, at.X, at.Y);
    }

    internal override void Closed() { if (Collapse != null) Collapse(this, EventArgs.Empty); }
    internal override void RootPopup() { if (Popup != null) Popup(this, EventArgs.Empty); }
}

/// An item of a ContextMenuStrip (.NET's ToolStripItem): its text, a
/// picture, a check, a greyed state and the keys to show.
public class ToolStripItem
{
    internal readonly int Id = SystemMenus.NewId();
    string _text = "";
    Icon? _image;
    bool _enabled = true, _checked;
    string _shortcutText = "";
    public event EventHandler? Click;
    internal ContextMenuStrip? Owner;

    public ToolStripItem() { }
    public ToolStripItem(string text) { _text = text; }

    public string Text { get { return _text; } set { _text = value; Changed(); } }
    /// The picture beside it, in the menu's check column.
    public Icon? Image { get { return _image; } set { _image = value; _pixels = null; Changed(); } }
    /// A greyed-out command: still listed, still says what it is, and does
    /// nothing. Leaving it out instead would make the menu change shape.
    public bool Enabled { get { return _enabled; } set { _enabled = value; Changed(); } }
    /// A tick to the left of the name, for a command that is a setting.
    public bool Checked { get { return _checked; } set { _checked = value; Changed(); } }
    /// What to put in the right-hand column: "Ctrl+S", "F5".
    public string ShortcutText { get { return _shortcutText; } set { _shortcutText = value; Changed(); } }

    int[]? _pixels;
    internal int[]? Pixels() { if (_pixels == null && _image != null) _pixels = _image.SmallPixels(); return _pixels; }

    void Changed() { if (Owner != null) Owner.Changed(); }
    public void PerformClick() { if (_enabled && Click != null) Click(this, EventArgs.Empty); }
}

public class ToolStripMenuItem : ToolStripItem
{
    public ToolStripMenuItem() { }
    public ToolStripMenuItem(string text) : base(text) { }
}

public class ToolStripSeparator : ToolStripItem
{
    public ToolStripSeparator() : base("-") { Enabled = false; }
}

public class ToolStripItemCollection
{
    List<ToolStripItem> _items = new List<ToolStripItem>();
    ContextMenuStrip _owner;
    public ToolStripItemCollection(ContextMenuStrip owner) { _owner = owner; }
    public int Count { get { return _items.Count; } }
    public ToolStripItem this[int i] { get { return _items[i]; } }
    // One body, no overload: an earlier Add(string) that called Add(item)
    // landed in the list twice, so every named item appeared twice on the
    // menu. Both entry points go through the same private step now.
    public ToolStripMenuItem Add(string text) { ToolStripMenuItem item = new ToolStripMenuItem(text); Append(item); return item; }
    public void Add(ToolStripItem item) { Append(item); }
    void Append(ToolStripItem item) { item.Owner = _owner; _items.Add(item); _owner.Changed(); }
    public void Clear() { _items.Clear(); _owner.Changed(); }
}

/// <summary>
/// A popup list of commands at a screen position: a right-click menu, a
/// start menu -- a system menu the seat runs, with a picture beside each
/// command. It goes away when a command is chosen, when Escape is pressed,
/// or on a click anywhere else; the arrows, Enter and the letters after an
/// ampersand work it from the keyboard, as every menu is worked.
/// </summary>
public class ContextMenuStrip : MenuSource
{
    public ToolStripItemCollection Items;
    public ContextMenuStrip() { Items = new ToolStripItemCollection(this); }

    public void Show(Point screen) { Show(screen.X, screen.Y); }

    /// Opened at (x, y) on the screen, for the program's active form (or
    /// its first, if none is active).
    public void Show(int screenX, int screenY)
    {
        Form? owner = Application.ActiveForm ?? Application.AnyForm();
        if (owner == null) return;
        SystemMenus.Track(this, owner, screenX, screenY);
    }

    internal override void Write(MenuWriter w)
    {
        w.Menu(RootId, Items.Count);
        for (int i = 0; i < Items.Count; i++)
        {
            ToolStripItem item = Items[i];
            bool separator = item is ToolStripSeparator;
            int state = (item.Enabled || separator ? 0 : SystemMenus.Grayed) | (item.Checked ? SystemMenus.Checked : 0);
            string text = item.ShortcutText.Length > 0 ? item.Text + "\t" + item.ShortcutText : item.Text;
            w.Item(separator ? SystemMenus.Separator : 0, state, item.Id, 0, text, separator ? null : item.Pixels());
        }
    }

    internal override void Chosen(int id)
    {
        for (int i = 0; i < Items.Count; i++) if (Items[i].Id == id) { Items[i].PerformClick(); return; }
    }

    internal override void Closed() { }
}

// ---------------------------------------------------------------------------
// The application: the message loop and the things it owns.
// ---------------------------------------------------------------------------

public delegate void WatchHandler(int fd);

// ---------------------------------------------------------------------------
// Middle-button autoscroll (docs/software/MOUSE-AND-SCROLL.md, section 3)
// ---------------------------------------------------------------------------

/// As Internet Explorer and Office did it on Windows XP with an IntelliMouse.
///
/// A MIDDLE press on a view that scrolls (Control.AutoScrollDirections)
/// puts an origin marker under the pointer. Released without moving, the
/// autoscroll stays -- sticky -- until the next press of any button, a key,
/// or the window losing the focus; held and moved, it lasts until the
/// button comes up. The view moves toward the pointer, faster the further
/// the pointer is from the marker, nothing inside a small dead zone around
/// it; the pointer shows which way. A view that scrolls one way only is
/// scrolled that way only, by the same rule -- IE did -- unless the user
/// asked for grab-and-drag, where the content follows the pointer instead.
static class AutoScroll
{
    internal static bool Active;
    internal static bool SwallowRelease;

    static Form? _form;
    static Control? _view;
    static ScrollBars _ways;
    static int _originX, _originY;          // window coordinates
    static int _x, _y;                      // the pointer, window coordinates
    static bool _held;                      // the button is still down
    static bool _moved;                     // it has moved past the drag size since the press
    static bool _grab;
    static int _restX, _restY;              // thousandths of a pixel, carried between ticks
    static Timer? _timer;
    static int _shape = -1;

    const int Dead = 12;                    // pixels around the marker that do nothing
    const int PixelsPerSecondPerPixel = 8;  // speed for each pixel past the dead zone
    const int TickMilliseconds = 20;
    const int MarkerSize = 32;
    // The markers' bitmap ids, one per set of ways (ScrollBars' value),
    // handed out when they are defined: a bitmap id is below 256.
    static int[] _markers = new int[4];

    /// A middle press: starts autoscroll if it lands on a view that scrolls
    /// and not on a control with its own use for the button.
    internal static bool TryBegin(Form form, Control hit, int x, int y)
    {
        if (!SystemInformation.MiddleButtonAutoScroll || hit.TakesMiddle) return false;
        Control? view = hit;
        while (view != null && view.AutoScrollWays == ScrollBars.None) view = view.Parent;
        if (view == null) return false;
        _form = form; _view = view; _ways = view.AutoScrollWays;
        _originX = x; _originY = y; _x = x; _y = y;
        _held = true; _moved = false; _restX = 0; _restY = 0;
        _grab = SystemInformation.AutoScrollGrab && _ways != ScrollBars.Both;
        Active = true;
        DefineShapes();
        Shape();
        if (_timer == null)
        {
            _timer = new Timer();
            _timer.Interval = TickMilliseconds;
            _timer.Tick += Tick;
        }
        if (!_grab) _timer.Start();
        form.PaintWindow(new Rectangle(_originX - MarkerSize / 2, _originY - MarkerSize / 2, MarkerSize, MarkerSize), false);
        Seat.Current.Present();
        return true;
    }

    internal static void Mouse(Form form, int kind, int button, int x, int y)
    {
        if (form != _form) { End(); return; }
        if (kind == 3)
        {
            if (_grab && _held && _view != null)
            {
                // Grab-and-drag: the content follows the pointer.
                _view.AutoScrollStep(_ways == ScrollBars.Horizontal ? _x - x : 0, _ways == ScrollBars.Vertical ? _y - y : 0);
                _form!.PaintWindow(new Rectangle(0, 0, _form.Width, _form.Height), false);
                Seat.Current.Present();
            }
            _x = x; _y = y;
            Size drag = SystemInformation.DragSize;
            if (Math2.Abs(x - _originX) > drag.Width / 2 || Math2.Abs(y - _originY) > drag.Height / 2) _moved = true;
            Shape();
            return;
        }
        if (kind == 5 && button == 3)
        {
            _held = false;
            // Held and moved: this release is the end. Released where it was
            // pressed: sticky, until the next press.
            if (_moved || _grab) End();
            return;
        }
        if (kind == 4)
        {
            // Any press ends it and is not passed on -- nor is its release,
            // which would otherwise arrive at a control that never saw the
            // press and be taken for a click.
            End();
            SwallowRelease = true;
        }
    }

    static void Tick(object sender, EventArgs e)
    {
        if (!Active || _view == null || _form == null) return;
        int dx = (_ways & ScrollBars.Horizontal) != 0 ? Step(_x - _originX, ref _restX) : 0;
        int dy = (_ways & ScrollBars.Vertical) != 0 ? Step(_y - _originY, ref _restY) : 0;
        if (dx == 0 && dy == 0) return;
        _view.AutoScrollStep(dx, dy);
        _form.PaintWindow(new Rectangle(0, 0, _form.Width, _form.Height), false);
        Seat.Current.Present();
    }

    /// Pixels to move this tick for an offset from the marker: nothing inside
    /// the dead zone, then a speed that grows with the distance past it.
    static int Step(int offset, ref int rest)
    {
        int past = Math2.Abs(offset) - Dead;
        if (past <= 0) { rest = 0; return 0; }
        int thousandths = rest + past * PixelsPerSecondPerPixel * TickMilliseconds;
        int pixels = thousandths / 1000;
        rest = thousandths - pixels * 1000;
        return offset < 0 ? -pixels : pixels;
    }

    internal static void End()
    {
        if (!Active) return;
        Active = false;
        if (_timer != null) _timer.Stop();
        Cursor.Wear(Cursor.Current ?? Cursors.Default);           // what the pointer wore before it started
        _shape = -1;
        Form? form = _form;
        _form = null; _view = null;
        if (form != null)
        {
            // What the marker covered, painted again from underneath.
            form.PaintWindow(new Rectangle(_originX - MarkerSize / 2, _originY - MarkerSize / 2, MarkerSize, MarkerSize), true);
            Seat.Current.Present();
        }
    }

    /// The marker, over whatever was just painted in the window it is in.
    internal static void Overlay(Form form, Seat seat)
    {
        if (!Active || form != _form || _grab) return;
        Graphics g = new Graphics(seat, 0, 0, new Rectangle(0, 0, form.Width, form.Height));
        g.DrawBitmap(_markers[(int)_ways], _originX - MarkerSize / 2, _originY - MarkerSize / 2, MarkerSize, MarkerSize);
    }

    /// The pointer: the marker's own shape near it, else the direction.
    static void Shape()
    {
        int dx = (_ways & ScrollBars.Horizontal) != 0 ? _x - _originX : 0;
        int dy = (_ways & ScrollBars.Vertical) != 0 ? _y - _originY : 0;
        bool east = dx > Dead, west = dx < -Dead, south = dy > Dead, north = dy < -Dead;
        int shape = _grab ? (_ways == ScrollBars.Horizontal ? CursorShapes.NoMoveHoriz : CursorShapes.NoMoveVert)
                  : north && east ? CursorShapes.PanNE : north && west ? CursorShapes.PanNW
                  : south && east ? CursorShapes.PanSE : south && west ? CursorShapes.PanSW
                  : north ? CursorShapes.PanNorth : south ? CursorShapes.PanSouth : east ? CursorShapes.PanEast : west ? CursorShapes.PanWest
                  : _ways == ScrollBars.Vertical ? CursorShapes.NoMoveVert : _ways == ScrollBars.Horizontal ? CursorShapes.NoMoveHoriz
                  : CursorShapes.NoMove2D;
        if (shape == _shape) return;
        _shape = shape;
        Cursor.WearShape(shape);
    }

    // ---- the pictures -------------------------------------------------------
    //
    // Drawn here rather than shipped: a white disc ringed in black with a dot
    // in the middle, and black arrowheads round it for the ways the view can
    // go, which is what IE's marker and its cursors look like. The seat
    // reduces a cursor to two colours and a hole, and these are drawn in
    // exactly those.

    static bool _defined;

    /// Cursors.NoMove2D and the Pan shapes are these: defined the first
    /// time autoscroll starts, or a program asks for one of them.
    internal static void DefineShapes()
    {
        if (_defined) return;
        _defined = true;
        Seat seat = Seat.Current;
        // The markers, as bitmaps, one per set of ways (ScrollBars' value).
        _markers[(int)ScrollBars.Vertical] = Seat.NextBitmapId();
        _markers[(int)ScrollBars.Horizontal] = Seat.NextBitmapId();
        _markers[(int)ScrollBars.Both] = Seat.NextBitmapId();
        seat.DefineBitmap(_markers[(int)ScrollBars.Vertical], MarkerSize, MarkerSize, Marker(false, true, false, true));
        seat.DefineBitmap(_markers[(int)ScrollBars.Horizontal], MarkerSize, MarkerSize, Marker(true, false, true, false));
        seat.DefineBitmap(_markers[(int)ScrollBars.Both], MarkerSize, MarkerSize, Marker(true, true, true, true));
        // The cursors, hot spot in the middle.
        DefineShape(CursorShapes.NoMove2D, Marker(true, true, true, true));
        DefineShape(CursorShapes.NoMoveVert, Marker(false, true, false, true));
        DefineShape(CursorShapes.NoMoveHoriz, Marker(true, false, true, false));
        DefineShape(CursorShapes.PanNorth, Pan(0, -1));
        DefineShape(CursorShapes.PanSouth, Pan(0, 1));
        DefineShape(CursorShapes.PanEast, Pan(1, 0));
        DefineShape(CursorShapes.PanWest, Pan(-1, 0));
        DefineShape(CursorShapes.PanNE, Pan(1, -1));
        DefineShape(CursorShapes.PanNW, Pan(-1, -1));
        DefineShape(CursorShapes.PanSE, Pan(1, 1));
        DefineShape(CursorShapes.PanSW, Pan(-1, 1));
    }

    static void DefineShape(int shape, byte[] argb)
    {
        Seat.Current.DefineCursor(shape - CursorShapes.Base, MarkerSize, MarkerSize, MarkerSize / 2, MarkerSize / 2, argb);
    }

    static void Put(byte[] argb, int x, int y, bool black)
    {
        if (x < 0 || y < 0 || x >= MarkerSize || y >= MarkerSize) return;
        int at = (y * MarkerSize + x) * 4;
        byte v = (byte)(black ? 0 : 255);
        argb[at] = v; argb[at + 1] = v; argb[at + 2] = v; argb[at + 3] = 255;   // B, G, R, A
    }

    /// The disc and dot, and arrowheads east, north, west, south as asked.
    static byte[] Marker(bool east, bool north, bool west, bool south)
    {
        byte[] argb = new byte[MarkerSize * MarkerSize * 4];
        int c = MarkerSize / 2;
        for (int y = 0; y < MarkerSize; y++)
            for (int x = 0; x < MarkerSize; x++)
            {
                int d = (x - c) * (x - c) + (y - c) * (y - c);
                if (d <= 81) Put(argb, x, y, d > 64);            // a disc of radius 9, its rim black
            }
        for (int y = c - 1; y <= c; y++) for (int x = c - 1; x <= c; x++) Put(argb, x, y, true);
        if (east) Arrow(argb, 1, 0);
        if (west) Arrow(argb, -1, 0);
        if (north) Arrow(argb, 0, -1);
        if (south) Arrow(argb, 0, 1);
        return argb;
    }

    /// The dot, and one arrowhead the way the view is going.
    static byte[] Pan(int dx, int dy)
    {
        byte[] argb = new byte[MarkerSize * MarkerSize * 4];
        int c = MarkerSize / 2;
        for (int y = c - 2; y <= c + 1; y++) for (int x = c - 2; x <= c + 1; x++) Put(argb, x, y, !(y > c - 2 && y < c + 1 && x > c - 2 && x < c + 1));
        Arrow(argb, dx, dy);
        return argb;
    }

    /// A filled black arrowhead with a white edge, pointing (dx, dy) out
    /// from the middle: its tip 14 pixels out, its base 8.
    static void Arrow(byte[] argb, int dx, int dy)
    {
        int c = MarkerSize / 2;
        for (int y = 0; y < MarkerSize; y++)
            for (int x = 0; x < MarkerSize; x++)
            {
                // Along the arrow's axis and across it, in a frame where the
                // axis is (dx, dy); a diagonal is scaled so its reach matches.
                int px = x - c, py = y - c;
                int along = px * dx + py * dy, across = px * dy - py * dx;
                if (dx != 0 && dy != 0) { along = along * 7 / 10; across = across * 7 / 10; }
                if (along < 8 || along > 14) continue;
                int half = 14 - along;                           // narrower toward the tip
                int width = across < 0 ? -across : across;
                if (width <= half) Put(argb, x, y, width < half);  // the edge white, the inside black
            }
    }
}

/// The two integer helpers autoscroll needs, here because Math is the core
/// library's own and not exported to this one.
static class Math2
{
    internal static int Abs(int x) { return x < 0 ? -x : x; }
}

public static class Application
{
    // THE DOUBLE-CLICK: a second press of the same button on the same
    // control, within SystemInformation.DoubleClickTime and inside the
    // DoubleClickSize box centred on the first. A third press starts again,
    // as on Windows.
    static Control? _clickTarget;
    static MouseButtons _clickButton;
    static int _clickAt, _clickX, _clickY;
    internal static int LastClicks;

    internal static int CountClick(Control target, MouseButtons button, int x, int y)
    {
        int now = Environment.TickCount;
        Size box = SystemInformation.DoubleClickSize;
        bool second = LastClicks == 1 && target == _clickTarget && button == _clickButton
            && now - _clickAt <= SystemInformation.DoubleClickTime
            && (x > _clickX ? x - _clickX : _clickX - x) <= box.Width / 2 && (y > _clickY ? y - _clickY : _clickY - y) <= box.Height / 2;
        LastClicks = second ? 2 : 1;
        _clickTarget = target; _clickButton = button; _clickAt = now; _clickX = x; _clickY = y;
        return LastClicks;
    }

    /// The seat's action numbers as Windows Forms spells them.
    internal static MouseButtons ButtonOf(int action)
    {
        return action == 1 ? MouseButtons.Left : action == 2 ? MouseButtons.Right : action == 3 ? MouseButtons.Middle
             : action == 4 ? MouseButtons.XButton1 : action == 5 ? MouseButtons.XButton2 : MouseButtons.None;
    }

    static List<Form> _forms = new List<Form>();


    static List<Timer> _timers = new List<Timer>();
    internal static void AddTimer(Timer t) { if (!_timers.Contains(t)) _timers.Add(t); }
    internal static void RemoveTimer(Timer t) { _timers.Remove(t); }
    /// Milliseconds on a clock that only goes forward.
    public static long Now() { return DateTime.UtcNow.Ticks / 10000; }
    /// How long the loop may wait before a timer is due: -1 for ever.
    static int TimerWait()
    {
        if (_timers.Count == 0) return -1;
        long now = Now(), soonest = -1;
        for (int i = 0; i < _timers.Count; i++) { long left = _timers[i].Due - now; if (left < 0) left = 0; if (soonest < 0 || left < soonest) soonest = left; }
        return soonest > 1000000 ? 1000000 : (int)soonest;
    }
    static void FireTimers()
    {
        long now = Now();
        for (int i = 0; i < _timers.Count; i++) if (_timers[i].Due <= now) _timers[i].Fire();
    }
    /// Where the next window with no position of its own goes: down and
    /// right of the windows already on the seat, a caption's height per
    /// window, back to the corner when it would run off the screen. Asked of
    /// the SEAT, not counted here: two terminals are two processes, and a
    /// count kept in each would put both in the same place. Two opened one
    /// after the other are then both visible, which is what Windows does and
    /// what a person opening a second one expects.
    internal static Point NextCascade(int width, int height, int screenWidth, int screenHeight)
    {
        const int Step = Form.CascadeStep;
        const int Margin = 24;
        int shown = Seat.Current.ShownWindows();
        int x = Margin + shown * Step, y = Margin + shown * Step;
        if (x + width > screenWidth || y + height > screenHeight) { x = Margin; y = Margin; }
        return new Point(x, y);
    }
    static bool _running;
    static int _exitCode;
    static Control? _focus;
    static Form? _active;
    static bool _paintPending;
    static List<int> _watchFds = new List<int>();
    static List<WatchHandler> _watchHandlers = new List<WatchHandler>();

    public static event EventHandler? Idle;

    public static Control? FocusedControl { get { return _focus; } }
    public static Form? ActiveForm { get { return _active; } }
    /// Any shown form of the program: what a menu with no control to come
    /// from (a ContextMenuStrip shown at a point) is for.
    internal static Form? AnyForm() { foreach (Form f in _forms) if (f.Handle != 0) return f; return null; }
    internal static Control? Captured;

    /// A mouse button is down somewhere: nothing pops up over a drag.
    internal static bool ButtonHeld;
    internal static void RegisterQuietly(Form f) { if (!_forms.Contains(f)) _forms.Add(f); }
    internal static void Register(Form f) { if (!_forms.Contains(f)) _forms.Add(f); _active = f; f.RaiseActivated(); }

    internal static void Unregister(Form f) { _forms.Remove(f); if (_active == f) _active = _forms.Count > 0 ? _forms[_forms.Count - 1] : null; if (_focus != null && _focus.FindForm() == f) _focus = null; }
    internal static void NeedsPaint(Control c) { _paintPending = true; }
    static Control? _hot;

    /// <summary>
    /// The pointer is over `c`. Whatever it was over before is told it has
    /// left and `c` is told it has been entered, which is what a toolbar
    /// button's hot bevel and a tooltip's timer both wait for.
    /// </summary>
    /// The control the pointer is over, as Hover last heard.
    internal static Control? HotControl { get { return _hot; } }

    /// <summary>The hourglass over every form of this program (Control.UseWaitCursor on each).</summary>
    public static bool UseWaitCursor
    {
        get { return _useWaitCursor; }
        set
        {
            _useWaitCursor = value;
            for (int i = 0; i < _forms.Count; i++) _forms[i].UseWaitCursor = value;
        }
    }
    static bool _useWaitCursor;

    internal static void Hover(Control? c)
    {
        if (_hot == c) { return; }
        Control? was = _hot;
        _hot = c;
        if (was != null) was.RaiseMouseLeave();
        if (c != null) c.RaiseMouseEnter();
        ToolTip.Hover(c);
    }

    internal static void Forget(Control c) { if (_hot == c) _hot = null; }

    internal static void SetFocus(Control? c)
    {
        if (_focus == c) return;
        Control? old = _focus;
        _focus = c;
        if (old != null) old.RaiseLostFocus();
        if (c != null) c.RaiseGotFocus();
    }

    /// Watch another descriptor from the message loop: a terminal watches its
    /// pseudo-terminal. CORSAC-only, and the one thing here .NET does not have.
    public static void Watch(int fd, WatchHandler handler) { _watchFds.Add(fd); _watchHandlers.Add(handler); }
    public static void Unwatch(int fd) { int i = _watchFds.IndexOf(fd); if (i >= 0) { _watchFds.RemoveAt(i); _watchHandlers.RemoveAt(i); } }

    static Form? FormOf(int handle) { for (int i = 0; i < _forms.Count; i++) if (_forms[i].Handle == handle) return _forms[i]; return null; }

    internal static void PaintNow()
    {
        // A program that has crashed paints nothing but its error box: the
        // paint that threw would throw again.
        for (int i = 0; i < _forms.Count; i++)
            if (!_crashing || _forms[i] == _crashBox)
                _forms[i].PaintWindow(new Rectangle(0, 0, _forms[i].Width, _forms[i].Height), false);
        _paintPending = false;
        // The frame is finished: the seat puts it up in one piece.
        Seat.Current.Present();
    }

    public static void DoEvents()
    {
        while (Seat.Current.Poll(0))
        {
            Message m;
            if (!Seat.Current.Next(out m)) break;
            Dispatch(ref m);
        }
        if (_paintPending) PaintNow();
    }

    public static void Run(Form main)
    {
        main.Show();
        Run();
    }

    /// The loop. Block for a message, dispatch it, paint what became stale,
    /// repeat until the last form closes or Exit is called. Nothing here
    /// polls: Next blocks in the kernel until there is a message.
    public static void Run()
    {
        _running = true;
        Seat seat = Seat.Current;
        while (_running && _forms.Count > 0)
        {
            // WHAT NOBODY CAUGHT IS SHOWN, NOT SWALLOWED. An exception out of
            // a handler or a paint used to end the program with its trace
            // on a stream nobody was watching -- the window simply went.
            // Here it becomes a message box saying what and where, and the
            // program ends when the box is dismissed, as Windows has done
            // since it had message boxes.
            try { if (!Iterate(seat)) break; }
            catch (Exception failure) { Crash(failure); return; }
        }
        _running = false;
    }

    /// Runs the loop until `dialog` closes, and answers what it said.
    internal static DialogResult RunModal(Form dialog)
    {
        dialog.Show();
        dialog.Activate();
        // SNAP TO: the pointer onto the dialog's default button, as Windows'
        // dialog manager puts it there when the user has asked for that.
        Button? accept = dialog.AcceptButton;
        if (accept != null && accept.Visible && SystemInformation.IsSnapToDefaultEnabled)
            Cursor.Position = accept.PointToScreen(new Point(accept.Width / 2, accept.Height / 2));
        Seat seat = Seat.Current;
        bool was = _running;
        _running = true;
        while (_running && !dialog.IsClosed)
        {
            if (!Iterate(seat)) break;
        }
        _running = was;
        return dialog.DialogResult;
    }

    static bool _crashing;
    static Form? _crashBox;

    static void Crash(Exception failure)
    {
        if (_crashing) { Environment.Exit(134); return; }
        _crashing = true;
        string trace = failure.StackTrace;
        // The first dozen frames say where; the rest is the loop.
        int lines = 0, cut = trace.Length;
        for (int i = 0; i < trace.Length; i++) if (trace[i] == '\n') { lines++; if (lines == 12) { cut = i; break; } }
        string text = failure.GetType().Name + ": " + failure.Message + "\n\n" + trace.Substring(0, cut);
        try
        {
            _crashBox = MessageBox.Build(text, "Program error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            RunModal(_crashBox);
        }
        catch (Exception) { }
        Environment.Exit(134);
    }

    /// One turn of the loop: settle a drag, paint, wait for something,
    /// act on it. False when the seat is gone.
    static bool Iterate(Seat seat)
    {
        {
            if (_paintPending) PaintNow();
            if (Idle != null) Idle(null!, EventArgs.Empty);
            int wait = TimerWait();
            if (_watchFds.Count > 0)
            {
                // Several descriptors: one wait on all of them in the
                // kernel, bounded by the next timer. A watcher that is
                // ready gets its turn; then the seat is asked whether it
                // has anything before blocking in Next, so a burst on the
                // descriptor cannot starve painting.
                int[] fds = new int[_watchFds.Count];
                for (int i = 0; i < fds.Length; i++) fds[i] = _watchFds[i];
                int which = seat.WaitAny(fds, fds.Length, wait);
                // A descriptor that is always ready -- a shell pouring out
                // a listing -- must not stop the clock: a timer that is due
                // fires between two reads, or a terminal that paints on a
                // timer while output flows never paints until it stops.
                if (which >= 0 && which < _watchHandlers.Count)
                {
                    // THE PERSON COMES FIRST. Whatever the seat holds -- a
                    // press, a drag, a key -- is taken and acted on BEFORE
                    // the descriptor is read, and a due timer fires; only
                    // then the shell's next four kilobytes. Output can wait
                    // a millisecond; a hand on the mouse cannot.
                    while (seat.Poll(0))
                    {
                        Message pending;
                        if (!seat.Next(out pending)) break;
                        Dispatch(ref pending);
                    }
                    if (_paintPending) PaintNow();
                    if (wait == 0) FireTimers();
                    _watchHandlers[which](fds[which]);
                    return true;
                }
                else if (!seat.Poll(0)) { FireTimers(); return true; }
            }
            else if (wait >= 0)
            {
                if (!seat.Poll(wait)) { FireTimers(); return true; }
            }
            Message m;
            if (!seat.Next(out m)) return false;
            Dispatch(ref m);
        }
        return true;
    }

    public static void Exit() { _running = false; }
    public static void Exit(int code) { _exitCode = code; _running = false; }
    public static int ExitCode { get { return _exitCode; } }

    static void Dispatch(ref Message m)
    {
        Form? f = FormOf(m.Window);
        if (_crashing && f != null && f != _crashBox) return;
        // THE EVENTS THAT BELONG TO NO WINDOW: a key for whatever has focus,
        // the window list changing, an inspection, the pointer moving, and
        // the screen changing size. Everything else names a window and is
        // dropped when that window has gone.
        if (f == null && m.Kind != 1 && m.Kind != 11 && m.Kind != 12 && m.Kind != 13
            && m.Kind != 14 && m.Kind != 15 && m.Kind != 16 && m.Kind != 17
            && m.Kind != 23 && m.Kind != 24 && m.Kind != 25) return;
        switch (m.Kind)
        {
            case 1:
            {
                // A key ends autoscroll and goes nowhere else, as in IE.
                if (AutoScroll.Active) { AutoScroll.End(); return; }
                Control? target = _focus ?? _active;
                if (target == null) return;
                int key = m.A & 0x1FF;
                int mods = m.B;
                if ((m.A & 0x200) != 0) mods = mods | 4;

                // THE RETURN KEY IS ONE KEY TO A FORM AND ANOTHER TO A
                // TERMINAL. The keyboard driver sends a line feed for it;
                // .NET has one Keys.Enter, which is 13, so that is what
                // KeyDown and the dialog keys are told. KeyPress still
                // carries the character the driver sent, because what a
                // terminal writes down its pseudo-terminal is that byte
                // and not one this layer picked.
                int code = key == 10 ? 13 : key;
                Form? form = target.FindForm();
                if (form == null) form = _active;

                // THE ORDER WINDOWS USES, and the reason a dialog feels
                // right: the control sees the key first, as a KeyDown and
                // then -- if it is a character and nobody took it -- as a
                // KeyPress. Only what is left over becomes a dialog key,
                // so a text box keeps its arrows and its Enter, and a form
                // still gets Tab, Escape and Alt from everywhere else.
                // A MENU'S SHORTCUT COMES FIRST, as ProcessCmdKey gives the
                // form's menu the key before any control sees it. Ctrl and a
                // letter arrives as the control character; it is the letter.
                if (form != null && form.Menu != null)
                {
                    int letter = (mods & 2) != 0 && code >= 1 && code <= 26 ? 'A' + code - 1 : code >= 'a' && code <= 'z' ? code - 32 : code;
                    int shortcut = letter | ((mods & 1) != 0 ? 0x10000 : 0) | ((mods & 2) != 0 ? 0x20000 : 0) | ((mods & 4) != 0 ? 0x40000 : 0);
                    MenuItem? chosen = (mods & 7) != 0 || letter >= 0x100 ? form.Menu.ForShortcut((Shortcut)shortcut) : null;
                    if (chosen != null) { chosen.PerformClick(); return; }
                }
                KeyEventArgs down = new KeyEventArgs((Keys)code, mods);
                target.RaiseKeyDown(down);
                bool handled = down.Handled;

                if (!handled) handled = target.ProcessDialogKey((Keys)code, mods);

                // ALT AND A LETTER NEVER BECOMES TYPING. It is a mnemonic,
                // and if nothing answers to it the key is simply dropped.
                if (!handled && (mods & 4) != 0 && key > 32 && key < 256)
                {
                    if (form != null) handled = Mnemonic(form, Lower((char)key));
                    else handled = true;
                    if (!handled) handled = true;
                }

                if (!handled && key < 256)
                {
                    KeyPressEventArgs press = new KeyPressEventArgs((char)key);
                    target.RaiseKeyPress(press);
                    handled = press.Handled;
                }

                if (!handled && form != null) handled = DialogKey(form, target, (Keys)code, mods);

                Message raw = m; target.DispatchRaw(ref raw);
                break;
            }
            case 3:
            {
                int wx = Seat.LowSigned(m.A), wy = Seat.HighSigned(m.A);
                int sx = Seat.LowSigned(m.B), sy = Seat.HighSigned(m.B);
                f!.WindowMouse(3, 0, wx, wy); break;
            }
            case 4:
                ButtonHeld = true;
                if (_active != f && !f!.StaysInactive) { _active = f; f!.RaiseActivated(); }
                f!.WindowMouse(4, m.A & 0xFF, Seat.LowSigned(m.B), Seat.HighSigned(m.B)); break;
            case 6:
            case 7:
            {
                // The seat sends the wheel to the window under the pointer;
                // inside it, the control with the focus gets it, or the form.
                // Already in Windows' units and sense: 120 a notch, up and
                // right positive.
                Control target = (_focus != null && _focus.FindForm() == f) ? _focus : f!;
                MouseEventArgs turned = new MouseEventArgs(MouseButtons.None, 0, 0, 0, m.A);
                if (m.Kind == 6) target.RaiseMouseWheel(turned); else target.RaiseMouseHWheel(turned);
                break;
            }
            case 5:
                ButtonHeld = false;
                // Signed: a release left of or above the window it was pressed
                // in reports negative coordinates, and reading them unsigned
                // put it out in the frame, where the control holding the
                // button never saw the release and stayed pressed in.
                f!.WindowMouse(5, m.A & 0xFF, Seat.LowSigned(m.B), Seat.HighSigned(m.B)); break;
            case 8:
            {
                int x = m.A & 0xFFFF, y = (m.A >> 16) & 0xFFFF, w = m.B & 0xFFFF, h = (m.B >> 16) & 0xFFFF;
                f!.PaintWindow(new Rectangle(x, y, w, h), true);
                Seat.Current.Present();
                break;
            }
            case 9:
                if (m.A == 0 && AutoScroll.Active) AutoScroll.End();
                if (m.A != 0) { _active = f; f!.RaiseActivated(); }
                else { if (_active == f) _active = null; f!.RaiseDeactivate(); }
                break;
            case 11:
                Shell.RaiseWindowsChanged();
                break;
            case 16:
                if (m.A == 1) Shell.RaiseStartRequested();
                break;
            case 17:
                // WM_SETTINGCHANGE: every setting SystemInformation answers
                // is asked of the seat again, and whoever cares is told.
                SystemEvents.RaiseUserPreferenceChanged((UserPreferenceCategory)m.A);
                break;
            case 18:
                // Its taskbar button: back from the taskbar, as it was.
                if (f != null) f.RestoreFromTaskbar();
                break;
            case 19:
                // Its taskbar button, pressed while it was the active window.
                if (f != null && f.MinimizeBox) f.WindowState = FormWindowState.Minimized;
                break;
            case 22:
                // WM_SYSCOMMAND: a caption button, or the caption double-clicked.
                if (f != null) f.SysCommand(m.A);
                break;
            case 23:
                // WM_COMMAND from a menu the seat ran: the item chosen.
                SystemMenus.Command(m.A, m.B);
                break;
            case 24:
                // The menu is gone, chosen from or not.
                SystemMenus.Closed(m.A);
                break;
            case 25:
                // WM_INITMENUPOPUP: a popup about to open; its items set now.
                SystemMenus.Popup(m.A, m.B);
                break;
            case 20:
                // WM_MOVE after the seat's move loop: the window is there
                // already, and the form only learns where. The loop had the
                // button's release: it is up.
                ButtonHeld = false;
                if (f != null) f.MovedBySeat(Seat.LowSigned(m.A), Seat.HighSigned(m.A));
                break;
            case 21:
                // WM_SIZE after the seat's size loop: the outline is gone,
                // and the window takes the size, a new surface painted.
                ButtonHeld = false;
                Cursor.Wear(Cursors.Default);
                if (f != null) f.SetBounds(Seat.LowSigned(m.A), Seat.HighSigned(m.A), m.B & 0xFFFF, (m.B >> 16) & 0xFFFF);
                break;

            // THE SCREEN IS A DIFFERENT SIZE NOW. The seat has thrown away
            // every window's pixels to do it, so there is nothing to keep:
            // the size is taken again, whoever cares is told, and every
            // form repaints. A form that filled the screen is made to fill
            // the new one, which is what a desktop and a taskbar are.
            case 15:
            {
                Seat.Current.Rescreen(m.A & 0xFFFF, (m.A >> 16) & 0xFFFF);
                SystemInformation.Rescreen();
                Screen.RaiseChanged();

                int screenWidth = Seat.Current.Width, screenHeight = Seat.Current.Height;

                for (int i = 0; i < _forms.Count; i++)
                {
                    Form other = _forms[i];

                    // A FORM THAT FILLED THE SCREEN FILLS THE NEW ONE. Any
                    // other keeps its size; the seat has already brought it
                    // inside the screen if it no longer fitted.
                    if (other.WindowState == FormWindowState.Maximized)
                    {
                        other.SetBounds(0, 0, screenWidth, screenHeight);
                    }

                    other.RaiseScreenChanged();
                }

                for (int i = 0; i < _forms.Count; i++)
                {
                    Form other = _forms[i];

                    other.PaintWindow(new Rectangle(0, 0, other.Width, other.Height), true);
                }
                Seat.Current.Present();
                break;
            }
            case 12:
            {
                // Somebody asks what is at a point of one of our windows.
                if (f == null) { Seat.Current.InspectReply(""); break; }
                int ix = Seat.LowSigned(m.A), iy = Seat.HighSigned(m.A);
                Point co = f.ClientOffset();
                string answer;
                if (iy < co.Y && f.HasFrame) answer = "Form \"" + f.Text + "\" caption";
                else
                {
                    Control target = f.HitTest(ix - co.X, iy - co.Y);
                    answer = target.Describe();
                    Control? parent = target.Parent;
                    if (parent != null && parent != f) answer = answer + " in " + parent.ClassName + " \"" + parent.Text + "\"";
                }
                Seat.Current.InspectReply(answer);
                break;
            }
            case 13:
                Shell.RaiseInspected();
                break;
            case 14:
                Shell.RaisePointerMoved(new MouseEventArgs(MouseButtons.None, 0, Seat.LowSigned(m.A), Seat.HighSigned(m.A), 0));
                break;
            case 10:
                f!.Close(); break;
        }
    }

    static char Lower(char c) { return c >= 'A' && c <= 'Z' ? (char)(c + 32) : c; }

    /// <summary>
    /// The keys a form acts on when no control wanted them: Tab and
    /// Shift+Tab to move the focus, Enter to press the default button,
    /// Escape to press the cancel button, and the arrows to move within a
    /// set of radio buttons. True when the key was used.
    /// </summary>
    static bool DialogKey(Form f, Control target, Keys key, int mods)
    {
        if (key == Keys.Tab)
        {
            Control? next = Step(f, target, (mods & 1) != 0 ? -1 : 1);
            if (next != null) SetFocus(next);
            return true;
        }

        if (key == Keys.Enter)
        {
            Button? accept = f.AcceptButton;
            if (accept != null && accept.Visible && accept.Enabled) { accept.PerformClick(); return true; }
            return false;
        }

        if (key == Keys.Escape)
        {
            Button? cancel = f.CancelButton;
            if (cancel != null && cancel.Visible && cancel.Enabled) { cancel.PerformClick(); return true; }
            return false;
        }

        // A SET OF RADIO BUTTONS IS ONE STOP on the tab order, and the
        // arrows move within it -- picking as they go, which is what
        // Windows does and what makes a set usable without the mouse.
        if (target is RadioButton picked && (key == Keys.Up || key == Keys.Down || key == Keys.Left || key == Keys.Right))
        {
            Control? owner = picked.Parent;
            if (owner == null) return false;
            List<Control> group = new List<Control>();
            Order(owner, group);
            List<Control> radios = new List<Control>();
            for (int i = 0; i < group.Count; i++) if (group[i] is RadioButton r && r.Parent == owner && r.Enabled && r.Visible) radios.Add(group[i]);
            int at = radios.IndexOf(picked);
            if (at < 0 || radios.Count < 2) return false;
            int step = (key == Keys.Up || key == Keys.Left) ? -1 : 1;
            Control moved = radios[(at + step + radios.Count) % radios.Count];
            SetFocus(moved);
            ((RadioButton)moved).Checked = true;
            return true;
        }
        return false;
    }

    /// Alt and a letter: whichever control on this form answers to it.
    static bool Mnemonic(Form f, char key)
    {
        List<Control> all = new List<Control>();
        Order(f, all);
        for (int i = 0; i < all.Count; i++) if (all[i].Reachable && all[i].ProcessMnemonic(key)) return true;
        return false;
    }

    /// The control `step` places along the tab order from `from`, wrapping.
    static Control? Step(Form f, Control from, int step)
    {
        List<Control> all = new List<Control>();
        Order(f, all);
        List<Control> stops = new List<Control>();
        for (int i = 0; i < all.Count; i++) if (all[i].CanSelect && !Skipped(all[i])) stops.Add(all[i]);
        if (stops.Count == 0) return null;
        int at = stops.IndexOf(from);
        if (at < 0) return stops[step > 0 ? 0 : stops.Count - 1];
        return stops[(at + step + stops.Count) % stops.Count];
    }

    /// A radio button that is not the checked one of its set is stepped
    /// over: Windows gives the whole set a single stop, at whichever
    /// button is on, and the arrows move inside it.
    static bool Skipped(Control c)
    {
        if (!(c is RadioButton radio) || radio.Checked) return false;
        Control? owner = radio.Parent;
        if (owner == null) return false;
        for (int i = 0; i < owner.Controls.Count; i++)
            if (owner.Controls[i] is RadioButton other && other.Checked && other.Visible && other.Enabled) return true;
        return false;
    }

    /// <summary>
    /// Every control under `root`, in keyboard order: each container's
    /// children sorted by TabIndex, each one followed immediately by its
    /// own children. That is what makes a group box a place on the order
    /// rather than a hole in it.
    /// </summary>
    static void Order(Control root, List<Control> into)
    {
        int count = root.Controls.Count;
        List<Control> level = new List<Control>();
        for (int i = 0; i < count; i++) level.Add(root.Controls[i]);

        // A short insertion sort: a form has tens of controls, not
        // thousands, and this keeps controls with equal TabIndex in the
        // order they were added.
        for (int i = 1; i < level.Count; i++)
        {
            Control moving = level[i];
            int j = i - 1;
            while (j >= 0 && level[j].TabIndex > moving.TabIndex) { level[j + 1] = level[j]; j--; }
            level[j + 1] = moving;
        }

        for (int i = 0; i < level.Count; i++) { into.Add(level[i]); Order(level[i], into); }
    }

    internal static Control? NextInOrder(Form f, Control from, int step) { return Step(f, from, step); }
}
