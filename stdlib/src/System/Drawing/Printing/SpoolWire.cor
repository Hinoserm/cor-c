// THE PRINT SPOOLER, as a program reaches it: CORSAC/GUI's spooler is a
// service of the GUI kernel (os/gui/spooler.cor in the system's
// repository), on the service manager's socket (System.ServiceProcess's
// WireClient: one message each way, the request's number and the user it
// is for, then its fields; the answer a Win32 error, then its fields). A
// job's requests all go on the connection its SpoolStartDoc was asked on,
// which the spooler cancels the job with when it closes unended. The
// requests and their fields:
//
// Word is an unsigned 32-bit field, Int a signed one.
//
//   SpoolPrinters ()                         Int(count), each a PrinterRecord
//   SpoolPrinter (Text name: "" the default) a PrinterRecord
//   SpoolStartDoc (Text printer, Text document, Text datatype ("RAW", or
//       "PAGES" for pages the seat hands over), Text output file ("" the
//       printer's port), Word copies)         Word(job)
//   SpoolWrite (Word job, Bytes data)         Int(bytes taken)
//   SpoolStartPage (Word job), SpoolEndPage (Word job): a RAW job's pages
//   SpoolEndDoc (Word job), SpoolAbortDoc (Word job)
//   SpoolJobs (Text printer: "" every one)   Int(count), each a JobRecord
//   SpoolJob (Word job)                       a JobRecord
//   SpoolJobControl (Word job, Word SpoolControl)
//   SpoolPrinterControl (Text printer, Word SpoolControl)
//   SpoolWatch (Text printer: "" every one): SpoolEvent messages from then
//       on -- Word(SpoolEvent), Word(kind), Text(printer), Word(job),
//       Word(status)
//   SpoolSetPrinter (PrinterRecord), SpoolDeletePrinter (Text name)
//
// KEEP IN STEP with os/gui/spoolwire.cor in the system's repository:
// nothing checks the two agree.

using System;
using System.Collections.Generic;
using System.IO;
using System.ServiceProcess;
using System.Threading;

namespace Corsac.Printing
{
    /// A job's state (winspool.h JOB_STATUS_*): DWORD bits.
    public static class SpoolJobStatus
    {
        public const uint Paused = 0x1, Error = 0x2, Deleting = 0x4, Spooling = 0x8, Printing = 0x10, Offline = 0x20;
        public const uint PaperOut = 0x40, Printed = 0x80, Deleted = 0x100, BlockedDeviceQueue = 0x200, UserIntervention = 0x400;
        public const uint Restart = 0x800, Complete = 0x1000;
    }

    /// A printer's state (winspool.h PRINTER_STATUS_*): DWORD bits.
    public static class SpoolPrinterStatus
    {
        public const uint Paused = 0x1, Error = 0x2, PendingDeletion = 0x4, PaperJam = 0x8, PaperOut = 0x10, ManualFeed = 0x20;
        public const uint PaperProblem = 0x40, Offline = 0x80, IoActive = 0x100, Busy = 0x200, Printing = 0x400, NotAvailable = 0x1000;
        public const uint Waiting = 0x2000, Processing = 0x4000;
    }

    /// What a job or printer control does (JOB_CONTROL_*, PRINTER_CONTROL_*).
    public static class SpoolControl
    {
        public const uint Pause = 1, Resume = 2, Cancel = 3, Restart = 4, Purge = 3;
    }

    /// What a SpoolEvent says changed.
    public static class SpoolEventKind
    {
        public const uint JobAdded = 1, JobChanged = 2, JobGone = 3, PrinterChanged = 4, PrinterAdded = 5, PrinterGone = 6;
    }

    /// A printer's flags in its record.
    public static class SpoolPrinterFlag
    {
        public const uint Default = 1, Colour = 2;
    }

    /// A printer, as the spooler describes it: its name, its driver
    /// ("postscript", "pcl", "pdf"), its port ("file:/path", "lpt:/dev/lp0",
    /// "socket:10.0.0.5:9100", "lpr:10.0.0.5/queue"), a comment and a
    /// location, the dots an inch it prints at, its paper in hundredths of an
    /// inch, its flags, its status and how many jobs it has.
    public class PrinterRecord
    {
        public string Name = "", Driver = "", Port = "", Comment = "", Location = "";
        public int Dpi = 150, PaperWidth = 850, PaperHeight = 1100;
        public uint Flags, Status;
        public int Jobs;

        public bool IsDefault { get { return (Flags & SpoolPrinterFlag.Default) != 0; } }
        public bool Colour { get { return (Flags & SpoolPrinterFlag.Colour) != 0; } }

        /// The page in pixels, as the spooler sizes a PAGES job's.
        public int PixelWidth { get { return PaperWidth * Dpi / 100; } }
        public int PixelHeight { get { return PaperHeight * Dpi / 100; } }

        public void Write(WireWriter w)
        {
            w.Text(Name); w.Text(Driver); w.Text(Port); w.Text(Comment); w.Text(Location);
            w.Int(Dpi); w.Int(PaperWidth); w.Int(PaperHeight); w.Word(Flags); w.Word(Status); w.Int(Jobs);
        }

        public static PrinterRecord Read(WireReader r)
        {
            PrinterRecord p = new PrinterRecord();
            p.Name = r.Text(); p.Driver = r.Text(); p.Port = r.Text(); p.Comment = r.Text(); p.Location = r.Text();
            p.Dpi = r.Int(); p.PaperWidth = r.Int(); p.PaperHeight = r.Int(); p.Flags = r.Word(); p.Status = r.Word(); p.Jobs = r.Int();
            return p;
        }
    }

    /// A job, as the spooler describes it.
    public class JobRecord
    {
        /// Its job id (JOB_INFO's JobId, a DWORD).
        public uint Id;
        public string Printer = "", Document = "", User = "", Datatype = "";
        /// SpoolJobStatus bits; pages printed and in all; bytes in all and
        /// printed (JOB_INFO's DWORDs); its place in its printer's queue (1
        /// the first); when it was submitted, milliseconds since 1970.
        public uint Status;
        public int PagesPrinted, Pages;
        public uint Size, BytesPrinted;
        public int Position;
        public ulong Submitted;

        public void Write(WireWriter w)
        {
            w.Word(Id); w.Text(Printer); w.Text(Document); w.Text(User); w.Text(Datatype);
            w.Word(Status); w.Int(PagesPrinted); w.Int(Pages); w.Word(Size); w.Word(BytesPrinted); w.Int(Position); w.Quad(Submitted);
        }

        public static JobRecord Read(WireReader r)
        {
            JobRecord j = new JobRecord();
            j.Id = r.Word(); j.Printer = r.Text(); j.Document = r.Text(); j.User = r.Text(); j.Datatype = r.Text();
            j.Status = r.Word(); j.PagesPrinted = r.Int(); j.Pages = r.Int(); j.Size = r.Word(); j.BytesPrinted = r.Word(); j.Position = r.Int(); j.Submitted = r.Quad();
            return j;
        }
    }

    /// The spooler refused, with Windows' error for it.
    public class SpoolerException : IOException
    {
        public uint Error;
        public SpoolerException(string what, uint error) : base(what + " (error " + error + ")") { Error = error; }
    }

    /// THE SPOOLER'S CALLS: printers, jobs and their queues. Every call is
    /// one request; a refusal throws a SpoolerException.
    public static class PrintSpooler
    {
        static WireReader Ask(uint op, WireWriter fields, string what)
        {
            uint error;
            WireReader? r = WireClient.Ask(op, fields, out error);
            if (r == null || error != 0) throw new SpoolerException(what, error);
            return r;
        }

        static void Do(uint op, WireWriter fields, string what) { Ask(op, fields, what); }

        /// THE CONNECTION EACH JOB THIS PROCESS BEGAN WAS BEGUN ON, held
        /// until the job ends. The spooler ties a job to the connection that
        /// began it and cancels it when that connection goes, as Windows
        /// aborts an unfinished job at ClosePrinter or when its process
        /// dies. Begun on a connection of the request's own, which Ask closes
        /// as it returns, a job was cancelled as StartDoc returned: the seat
        /// made it no page, and AbortDoc found no job to cancel. Every
        /// request of the job goes over it, one at a time; EndDoc and
        /// AbortDoc close it, and so does the process's end.
        sealed class Held
        {
            public readonly int Fd;
            public Held(int fd) { Fd = fd; }
        }

        static readonly Dictionary<uint, Held> _held = new Dictionary<uint, Held>();

        static Held? HeldFor(uint job)
        {
            lock (_held)
            {
                Held? held;
                return _held.TryGetValue(job, out held) ? held : null;
            }
        }

        /// A request of one job's: on the connection that began it when this
        /// process began it, on one of its own otherwise.
        static WireReader JobAsk(uint job, uint op, WireWriter fields, string what)
        {
            Held? held = HeldFor(job);
            if (held == null) return Ask(op, fields, what);
            uint error;
            WireReader? r;
            lock (held) r = WireClient.AskOn(held.Fd, op, fields, out error);
            if (r == null || error != 0) throw new SpoolerException(what, error);
            return r;
        }

        /// A job's last request, and its connection let go after it, said or
        /// refused: a job not ended by then the spooler cancels as the
        /// connection closes.
        static void Finish(uint job, uint op, string what)
        {
            try { JobAsk(job, op, JobFields(job), what); }
            finally
            {
                Held? held;
                lock (_held)
                {
                    if (_held.TryGetValue(job, out held)) _held.Remove(job);
                }
                if (held != null) lock (held) Os.Close(held.Fd);
            }
        }

        /// Every printer, the default one marked.
        public static List<PrinterRecord> Printers()
        {
            List<PrinterRecord> all = new List<PrinterRecord>();
            uint error;
            WireReader? r = WireClient.Ask(ServiceRequest.SpoolPrinters, new WireWriter(), out error);
            if (r == null || error != 0) return all;
            int n = r.Int();
            for (int i = 0; i < n && !r.Short; i++) all.Add(PrinterRecord.Read(r));
            return all;
        }

        /// The printer of that name ("" the default), or null.
        public static PrinterRecord? Printer(string name)
        {
            WireWriter w = new WireWriter();
            w.Text(name);
            uint error;
            WireReader? r = WireClient.Ask(ServiceRequest.SpoolPrinter, w, out error);
            if (r == null || error != 0) return null;
            return PrinterRecord.Read(r);
        }

        /// A job begun: "RAW" for bytes written (Write), "PAGES" for pages
        /// the seat hands in (Corsac.GUI's Seat.CreatePage). Its id. Begun on
        /// a connection of its own, held until EndDoc or AbortDoc (Held).
        public static uint StartDoc(string printer, string document, string datatype, string outputFile, uint copies)
        {
            WireWriter w = new WireWriter();
            w.Text(printer); w.Text(document); w.Text(datatype); w.Text(outputFile); w.Word(copies);
            int fd = WireClient.Connect();
            if (fd < 0) throw new SpoolerException("the spooler began no job", WireError.Unavailable);
            uint error;
            WireReader? r = WireClient.AskOn(fd, ServiceRequest.SpoolStartDoc, w, out error);
            if (r == null || error != 0)
            {
                Os.Close(fd);
                throw new SpoolerException("the spooler began no job", error);
            }
            uint job = r.Word();
            lock (_held) _held[job] = new Held(fd);
            return job;
        }

        /// A RAW job's bytes, as the printer takes them, in pieces the wire
        /// carries.
        public static void Write(uint job, byte[] data, int offset, int count)
        {
            while (count > 0)
            {
                int piece = Math.Min(count, 60 * 1024);
                byte[] part = new byte[piece];
                Array.Copy(data, offset, part, 0, piece);
                WireWriter w = new WireWriter();
                w.Word(job); w.Bytes(part);
                JobAsk(job, ServiceRequest.SpoolWrite, w, "the spooler took no data");
                offset += piece; count -= piece;
            }
        }

        static WireWriter JobFields(uint job) { WireWriter w = new WireWriter(); w.Word(job); return w; }

        public static void StartPage(uint job) { JobAsk(job, ServiceRequest.SpoolStartPage, JobFields(job), "no page begun"); }
        public static void EndPage(uint job) { JobAsk(job, ServiceRequest.SpoolEndPage, JobFields(job), "no page ended"); }
        public static void EndDoc(uint job) { Finish(job, ServiceRequest.SpoolEndDoc, "the job was not ended"); }
        public static void AbortDoc(uint job) { Finish(job, ServiceRequest.SpoolAbortDoc, "the job was not cancelled"); }

        /// A printer's jobs ("" every printer's), in queue order.
        public static List<JobRecord> Jobs(string printer)
        {
            WireWriter w = new WireWriter();
            w.Text(printer);
            WireReader r = Ask(ServiceRequest.SpoolJobs, w, "no jobs");
            List<JobRecord> all = new List<JobRecord>();
            int n = r.Int();
            for (int i = 0; i < n && !r.Short; i++) all.Add(JobRecord.Read(r));
            return all;
        }

        /// One job, or null when it is gone.
        public static JobRecord? Job(uint job)
        {
            uint error;
            WireReader? r = WireClient.Ask(ServiceRequest.SpoolJob, JobFields(job), out error);
            if (r == null || error != 0) return null;
            return JobRecord.Read(r);
        }

        /// Pause, resume, cancel or restart a job (the user's own, or any for
        /// the system).
        public static void ControlJob(uint job, uint control)
        {
            WireWriter w = JobFields(job);
            w.Word(control);
            Do(ServiceRequest.SpoolJobControl, w, "the job was not changed");
        }

        /// Pause, resume or purge a printer (the system only).
        public static void ControlPrinter(string printer, uint control)
        {
            WireWriter w = new WireWriter();
            w.Text(printer); w.Word(control);
            Do(ServiceRequest.SpoolPrinterControl, w, "the printer was not changed");
        }

        /// A printer made or changed in the machine's registry (the system
        /// only); IsDefault makes it the default.
        public static void SetPrinter(PrinterRecord printer)
        {
            WireWriter w = new WireWriter();
            printer.Write(w);
            Do(ServiceRequest.SpoolSetPrinter, w, "the printer was not set");
        }

        public static void DeletePrinter(string name)
        {
            WireWriter w = new WireWriter();
            w.Text(name);
            Do(ServiceRequest.SpoolDeletePrinter, w, "the printer was not deleted");
        }
    }

    /// One change the spooler told: what, the printer, the job (0 for the
    /// printer's own) and its status bits.
    public class SpoolEventArgs : EventArgs
    {
        /// What changed (SpoolEventKind).
        public uint Kind;
        public string Printer = "";
        public uint Job, Status;
    }

    /// A printer's queue watched ("" every printer's): Changed is raised on a
    /// thread of its own at every change, until Dispose -- which waits for
    /// that thread, so is never called from Changed itself.
    public class SpoolWatcher : IDisposable
    {
        int _fd = -1;
        Thread? _reader;
        bool _stopping;

        public event EventHandler<SpoolEventArgs>? Changed;

        public SpoolWatcher(string printer)
        {
            int fd = WireClient.Connect();
            if (fd < 0) throw new SpoolerException("no spooler to watch", WireError.Unavailable);
            WireWriter w = new WireWriter();
            w.Text(printer);
            byte[]? answer = WireClient.Send(fd, WireClient.Message(ServiceRequest.SpoolWatch, w)) ? WireClient.Receive(fd) : null;
            uint error = answer == null || answer.Length < 4 ? WireError.Unavailable : new WireReader(answer, answer.Length).Word();
            if (error != 0) { Os.Close(fd); throw new SpoolerException("the spooler would not be watched", error); }
            _fd = fd;
            _reader = new Thread(ReadLoop);
            _reader.IsBackground = true;
            _reader.Start();
        }

        void ReadLoop()
        {
            while (!_stopping)
            {
                byte[]? m = WireClient.Receive(_fd);
                if (m == null) return;
                WireReader r = new WireReader(m, m.Length);
                if (r.Word() != ServiceRequest.SpoolEvent) continue;
                SpoolEventArgs e = new SpoolEventArgs();
                e.Kind = r.Word(); e.Printer = r.Text(); e.Job = r.Word(); e.Status = r.Word();
                if (r.Short) continue;
                EventHandler<SpoolEventArgs>? h = Changed;
                if (h != null) h(this, e);
            }
        }

        public void Dispose()
        {
            if (_fd < 0) return;
            _stopping = true;
            Os.Shutdown(_fd, 2);
            Thread? reader = _reader;
            if (reader != null) reader.Join();
            Os.Close(_fd);
            _fd = -1;
            _reader = null;
        }
    }
}
