// System.Drawing: the part of it Windows Forms paints with.
//
// Everything here is the .NET surface: Color, Point, Size, Rectangle, Pen,
// Brush, Font, Graphics. Underneath, a Graphics does not touch pixels. It
// appends operations to the seat's drawing batch (docs/software/GUI-KERNEL.md
// in the OS repository, "What a seat descriptor carries"), and the kernel,
// later the GUI kernel, executes them against the engine. Colours are
// logical RGB all the way down; the target resolves them to its depth.
//
// Text is drawn one of two ways. The bitmap system font's 256 glyphs are
// defined by the kernel when the seat is opened, with ids equal to their
// character codes, and DrawString sends a Glyph operation per character.
// A Font naming a FontFamily built from a TrueType file (Text.cor,
// TrueType.cor) draws proportionally instead: each glyph is grid-fitted
// and cached by System.Drawing.TrueTypeSize, then plotted here as spans
// of Fill, one run of set pixels per row -- ordinary drawing operations,
// so a scalable face needs nothing from the seat that a filled rectangle
// does not already have.

namespace System.Drawing;

public struct Color
{
    public byte R;
    public byte G;
    public byte B;
    public byte A;

    public static Color FromArgb(int r, int g, int b) { Color c = new Color(); c.A = 255; c.R = (byte)r; c.G = (byte)g; c.B = (byte)b; return c; }
    public static Color FromArgb(int a, int r, int g, int b) { Color c = new Color(); c.A = (byte)a; c.R = (byte)r; c.G = (byte)g; c.B = (byte)b; return c; }
    public int ToArgb() { return (A << 24) | (R << 16) | (G << 8) | B; }
    public bool IsEmpty { get { return A == 0 && R == 0 && G == 0 && B == 0; } }

    public static Color Empty { get { Color c = new Color(); c.A = 0; c.R = 0; c.G = 0; c.B = 0; return c; } }
    public static Color Black { get { return FromArgb(0, 0, 0); } }
    public static Color White { get { return FromArgb(255, 255, 255); } }
    public static Color Red { get { return FromArgb(255, 0, 0); } }
    public static Color Green { get { return FromArgb(0, 128, 0); } }
    public static Color Blue { get { return FromArgb(0, 0, 255); } }
    public static Color Navy { get { return FromArgb(0, 0, 128); } }
    public static Color Gray { get { return FromArgb(128, 128, 128); } }
    public static Color DarkGray { get { return FromArgb(169, 169, 169); } }
    public static Color LightGray { get { return FromArgb(211, 211, 211); } }
    public static Color Silver { get { return FromArgb(192, 192, 192); } }
    public static Color Teal { get { return FromArgb(0, 128, 128); } }
    public static Color Yellow { get { return FromArgb(255, 255, 0); } }
    public static Color Transparent { get { return FromArgb(0, 255, 255, 255); } }

    public static bool operator ==(Color a, Color b) { return a.ToArgb() == b.ToArgb(); }
    public static bool operator !=(Color a, Color b) { return a.ToArgb() != b.ToArgb(); }
    public override bool Equals(object? o) { return o is Color c && c == this; }
    public override int GetHashCode() { return ToArgb(); }
}

/// The colours a Windows desktop is made of. Same names, same defaults.
public static class SystemColors
{
    // THE WINDOWS 98 THREE-DIMENSIONAL SCHEME, to the byte. These are not
    // approximations of it: #C0C0C0 face, #DFDFDF light, #808080 shadow,
    // #FFFFFF highlight and black dark-shadow are the five values every
    // bevel in the system is built from, and a control drawn with anything
    // else reads as belonging to a different machine. The caption's two
    // blues and the teal desktop are the defaults of the era.
    public static Color Control { get { return Color.FromArgb(192, 192, 192); } }
    public static Color ControlText { get { return Color.Black; } }
    public static Color ControlLight { get { return Color.FromArgb(223, 223, 223); } }
    public static Color ControlLightLight { get { return Color.White; } }
    public static Color ControlDark { get { return Color.FromArgb(128, 128, 128); } }
    public static Color ControlDarkDark { get { return Color.Black; } }

    /// .NET's names for the same five, which is what most code reaches for.
    public static Color ButtonFace { get { return Control; } }
    public static Color ButtonHighlight { get { return ControlLightLight; } }
    public static Color ButtonShadow { get { return ControlDark; } }

    public static Color Window { get { return Color.White; } }
    public static Color WindowText { get { return Color.Black; } }
    public static Color WindowFrame { get { return Color.Black; } }
    public static Color Desktop { get { return Color.FromArgb(0, 128, 128); } }
    public static Color AppWorkspace { get { return Color.FromArgb(128, 128, 128); } }

    public static Color ActiveCaption { get { return Color.FromArgb(0, 0, 128); } }
    public static Color GradientActiveCaption { get { return Color.FromArgb(16, 132, 208); } }
    public static Color ActiveCaptionText { get { return Color.White; } }
    public static Color InactiveCaption { get { return Color.FromArgb(128, 128, 128); } }
    public static Color GradientInactiveCaption { get { return Color.FromArgb(181, 181, 181); } }
    public static Color InactiveCaptionText { get { return Color.FromArgb(192, 192, 192); } }
    public static Color ActiveBorder { get { return Control; } }
    public static Color InactiveBorder { get { return Control; } }

    public static Color Highlight { get { return Color.FromArgb(0, 0, 128); } }
    public static Color HighlightText { get { return Color.White; } }
    public static Color HotTrack { get { return Color.FromArgb(0, 0, 255); } }
    public static Color GrayText { get { return Color.FromArgb(128, 128, 128); } }
    public static Color ScrollBar { get { return Color.FromArgb(192, 192, 192); } }

    public static Color Menu { get { return Control; } }
    public static Color MenuText { get { return Color.Black; } }
    public static Color MenuBar { get { return Control; } }
    public static Color MenuHighlight { get { return Highlight; } }

    /// The tooltip's pale yellow, which Windows calls the info colours.
    public static Color Info { get { return Color.FromArgb(255, 255, 225); } }
    public static Color InfoText { get { return Color.Black; } }
}

public static class ColorBlend
{
    /// `a` toward `b` by t in 0..256.
    public static Color Mix(Color a, Color b, int t)
    {
        return Color.FromArgb(a.R + (b.R - a.R) * t / 256, a.G + (b.G - a.G) * t / 256, a.B + (b.B - a.B) * t / 256);
    }
}

public struct Point
{
    public int X;
    public int Y;
    public Point(int x, int y) { X = x; Y = y; }
    public static Point Empty { get { return new Point(0, 0); } }
    public bool IsEmpty { get { return X == 0 && Y == 0; } }
    public void Offset(int dx, int dy) { X += dx; Y += dy; }
    public static bool operator ==(Point a, Point b) { return a.X == b.X && a.Y == b.Y; }
    public static bool operator !=(Point a, Point b) { return !(a == b); }
    public override bool Equals(object? o) { return o is Point p && p == this; }
    public override int GetHashCode() { return X ^ (Y << 16); }
    public override string ToString() { return "{X=" + X + ",Y=" + Y + "}"; }
}

public struct Size
{
    public int Width;
    public int Height;
    public Size(int w, int h) { Width = w; Height = h; }
    public static Size Empty { get { return new Size(0, 0); } }
    public bool IsEmpty { get { return Width == 0 && Height == 0; } }
    public static bool operator ==(Size a, Size b) { return a.Width == b.Width && a.Height == b.Height; }
    public static bool operator !=(Size a, Size b) { return !(a == b); }
    public override bool Equals(object? o) { return o is Size s && s == this; }
    public override int GetHashCode() { return Width ^ (Height << 16); }
    public override string ToString() { return "{Width=" + Width + ",Height=" + Height + "}"; }
}

public struct Rectangle
{
    public int X;
    public int Y;
    public int Width;
    public int Height;
    public Rectangle(int x, int y, int w, int h) { X = x; Y = y; Width = w; Height = h; }
    public Rectangle(Point p, Size s) { X = p.X; Y = p.Y; Width = s.Width; Height = s.Height; }
    public static Rectangle Empty { get { return new Rectangle(0, 0, 0, 0); } }
    public int Left { get { return X; } }
    public int Top { get { return Y; } }
    public int Right { get { return X + Width; } }
    public int Bottom { get { return Y + Height; } }
    public bool IsEmpty { get { return Width <= 0 || Height <= 0; } }
    public Point Location { get { return new Point(X, Y); } set { X = value.X; Y = value.Y; } }
    public Size Size { get { return new Size(Width, Height); } set { Width = value.Width; Height = value.Height; } }
    public bool Contains(int x, int y) { return x >= X && y >= Y && x < X + Width && y < Y + Height; }
    public bool Contains(Point p) { return Contains(p.X, p.Y); }
    public bool IntersectsWith(Rectangle r) { return r.X < Right && X < r.Right && r.Y < Bottom && Y < r.Bottom; }
    public void Offset(int dx, int dy) { X += dx; Y += dy; }
    public void Inflate(int dx, int dy) { X -= dx; Y -= dy; Width += 2 * dx; Height += 2 * dy; }
    public static Rectangle Intersect(Rectangle a, Rectangle b)
    {
        int x0 = a.X > b.X ? a.X : b.X, y0 = a.Y > b.Y ? a.Y : b.Y;
        int x1 = a.Right < b.Right ? a.Right : b.Right, y1 = a.Bottom < b.Bottom ? a.Bottom : b.Bottom;
        if (x1 <= x0 || y1 <= y0) return Empty;
        return new Rectangle(x0, y0, x1 - x0, y1 - y0);
    }
    public static Rectangle Union(Rectangle a, Rectangle b)
    {
        if (a.IsEmpty) return b;
        if (b.IsEmpty) return a;
        int x0 = a.X < b.X ? a.X : b.X, y0 = a.Y < b.Y ? a.Y : b.Y;
        int x1 = a.Right > b.Right ? a.Right : b.Right, y1 = a.Bottom > b.Bottom ? a.Bottom : b.Bottom;
        return new Rectangle(x0, y0, x1 - x0, y1 - y0);
    }
    public static bool operator ==(Rectangle a, Rectangle b) { return a.X == b.X && a.Y == b.Y && a.Width == b.Width && a.Height == b.Height; }
    public static bool operator !=(Rectangle a, Rectangle b) { return !(a == b); }
    public override bool Equals(object? o) { return o is Rectangle r && r == this; }
    public override int GetHashCode() { return X ^ (Y << 8) ^ (Width << 16) ^ (Height << 24); }
    public override string ToString() { return "{X=" + X + ",Y=" + Y + ",Width=" + Width + ",Height=" + Height + "}"; }
}

public class Pen : IDisposable
{
    public Color Color;
    public float Width;
    public Pen(Color color) { Color = color; Width = 1; }
    public Pen(Color color, float width) { Color = color; Width = width; }
    public void Dispose() { }
}

public abstract class Brush : IDisposable
{
    public void Dispose() { }
}

public class SolidBrush : Brush
{
    public Color Color;
    public SolidBrush(Color color) { Color = color; }
}

public static class Brushes
{
    public static Brush Black { get { return new SolidBrush(Color.Black); } }
    public static Brush White { get { return new SolidBrush(Color.White); } }
}

public static class Pens
{
    public static Pen Black { get { return new Pen(Color.Black); } }
    public static Pen White { get { return new Pen(Color.White); } }
}

public enum FontStyle { Regular = 0, Bold = 1, Italic = 2, Underline = 4, Strikeout = 8 }

/// <summary>
/// A face and a size to draw it at. The default is the kernel's bitmap
/// system font, eight by sixteen and drawn a byte at a time; naming a
/// FontFamily that wraps a TrueType face instead makes this a scalable
/// font, grid-fitted and drawn proportionally by Graphics.DrawString.
///
/// Size is in pixels here, not points: there is one physical pixel size
/// to a screen with no notion of DPI, so the distinction .NET makes
/// between a Font's Size and its SizeInPoints does not apply and the two
/// are the same number.
/// </summary>
public class Font : IDisposable
{
    public string Name;
    public float Size;
    public FontStyle Style;
    public FontFamily FontFamily { get; private set; }

    // The face fitted to Size, made once and kept: a TrueTypeSize already
    // caches every glyph it has drawn, so the cost of a Font is paid once
    // regardless of how many strings are drawn with it.
    TrueTypeSize? _scaled;
    bool _scaleTried;

    public Font(string name, float size) : this(name, size, FontStyle.Regular) { }

    public Font(string name, float size, FontStyle style)
    {
        // A NAME NOBODY KNOWS IS NOT AN ERROR HERE: GDI+ itself falls
        // back to a generic face rather than fail a program over a font
        // that turned out not to be installed, and that is worth keeping
        // even though our fallback is one face rather than a choice.
        FontFamily? found = FontFamily.Find(name);
        FontFamily = found ?? FontFamily.SystemFamily;
        Name = FontFamily.Name;
        Size = size;
        Style = style;
    }

    public Font(FontFamily family, float size) : this(family, size, FontStyle.Regular) { }

    public Font(FontFamily family, float size, FontStyle style)
    {
        FontFamily = family;
        Name = family.Name;
        Size = size;
        Style = style;
    }

    /// The face fitted to Size, or null for the bitmap system font. Bold
    /// takes the family's bold design where it has one.
    internal TrueTypeSize? Scaled
    {
        get
        {
            if (!_scaleTried)
            {
                _scaleTried = true;

                bool wantBold = (Style & FontStyle.Bold) != 0;
                TrueTypeFace? face = wantBold && FontFamily.BoldFace != null ? FontFamily.BoldFace : FontFamily.Face;

                if (face != null)
                {
                    int px = (int)(Size + 0.5f);
                    if (px < 1) { px = 1; }
                    _scaled = TrueTypeSize.For(face, px);
                    _realBold = wantBold && FontFamily.BoldFace != null;
                }
            }
            return _scaled;
        }
    }

    bool _realBold;

    /// The style still to be faked when drawing: bold only when the
    /// family had no bold face of its own, italic always.
    internal FontStyle Synthetic
    {
        get { TrueTypeSize? s = Scaled; return _realBold ? (Style & ~FontStyle.Bold) : Style; }
    }

    /// <summary>
    /// How wide one line of text comes out in this font, in pixels: the
    /// one measurement everything that lays text out needs, and the only
    /// honest one once letters are not all the same width.
    /// </summary>
    public int TextWidth(string text) { return TextWidth(text, 0, text.Length); }

    public int TextWidth(string text, int start, int count)
    {
        TrueTypeSize? scaled = Scaled;
        if (count <= 0) { return 0; }
        if (scaled == null) { return count * 8; }

        int extra = (Synthetic & FontStyle.Bold) != 0 ? 1 : 0;
        int width = 0, previous = -1, end = start + count;

        for (int i = start; i < end; )
        {
            Rune rune;
            int taken;

            if (!Rune.TryDecodeFromUtf8(text, i, out rune, out taken)) { taken = 1; rune = new Rune('?'); }
            i += taken;

            int glyph = scaled.Face.GlyphIndex(rune.Value);
            width += Graphics.Kern(scaled, previous, glyph) + scaled.Advance(glyph) + extra;
            previous = glyph;
        }
        return width;
    }

    /// From the top of a line down to its baseline: thirteen rows of the
    /// bitmap font's sixteen, the face's own ascent otherwise.
    public int Ascent { get { TrueTypeSize? s = Scaled; return s == null ? 13 : s.Ascent; } }

    public bool Bold { get { return (Style & FontStyle.Bold) != 0; } }
    public bool Italic { get { return (Style & FontStyle.Italic) != 0; } }
    public float SizeInPoints { get { return Size; } }

    /// The line's height: the bitmap font's fixed sixteen, or a scalable
    /// face's own ascent and descent at this size.
    public int Height { get { TrueTypeSize? s = Scaled; return s == null ? 16 : s.LineSpacing; } }

    /// <summary>
    /// Meaningful only for the bitmap font, which is fixed-width: every
    /// glyph is this many pixels wide, and that is the whole of how the
    /// widget set lays out text today. A scalable font has no single
    /// glyph width -- ask Graphics.MeasureString instead -- so this
    /// answers the width of its capital M, which is at least the right
    /// order of size for code that has not been taught proportional
    /// layout yet.
    /// </summary>
    public int GlyphWidth
    {
        get
        {
            TrueTypeSize? s = Scaled;
            if (s == null) { return 8; }
            return s.Advance(s.Face.GlyphIndex('M'));
        }
    }

    public void Dispose() { }
}

public static class SystemFonts
{
    /// What the interface is set in, in pixels. Eleven is what eight
    /// points came to on the screens of the era.
    public const int DefaultSize = 11;

    static Font? _default, _caption;

    /// <summary>
    /// The interface font: the installed sans where there is one, the
    /// kernel's bitmap face where there is not. ONE OBJECT, shared, since
    /// every control asks for it and a font carries its fitted face.
    /// </summary>
    public static Font DefaultFont
    {
        get
        {
            if (_default == null) { _default = new Font(FontFamily.GenericSansSerif, DefaultSize); }
            return _default;
        }
    }

    public static Font MessageBoxFont { get { return DefaultFont; } }
    public static Font MenuFont { get { return DefaultFont; } }
    public static Font StatusFont { get { return DefaultFont; } }
    public static Font DialogFont { get { return DefaultFont; } }

    /// A window's title: the same face, bold.
    public static Font CaptionFont
    {
        get
        {
            if (_caption == null) { _caption = new Font(FontFamily.GenericSansSerif, DefaultSize, FontStyle.Bold); }
            return _caption;
        }
    }
}

public class SizeF
{
    public float Width;
    public float Height;
    public SizeF(float w, float h) { Width = w; Height = h; }
}

/// The batch a Graphics appends to. Owned by the seat connection in
/// System.Windows.Forms; here is only what a Graphics needs of it.
public interface IDrawingTarget
{
    void Fill(int x, int y, int w, int h, Color colour);
    void Copy(int sx, int sy, int dx, int dy, int w, int h);
    void Line(int x0, int y0, int x1, int y1, Color colour);
    void Glyph(int id, int x, int y, Color foreground, Color background, bool transparent);

    /// A rectangle of a picture the target is keeping, by the id it was
    /// given: how an icon is drawn once it has been handed over.
    void Blit(int id, int sx, int sy, int x, int y, int w, int h);
    void Clip(int x, int y, int w, int h);

    /// How many colours the target can actually show: what decides
    /// whether antialiased text is worth drawing at all, since blending
    /// two colours into a third needs a palette with room for the third
    /// one. Asked of the target and not of Corsac.GUI's Seat directly,
    /// because System.Drawing is built before System.Windows.Forms (which
    /// is where Seat lives) and must not need it -- and because it is
    /// what makes a Graphics over a test double answerable without a
    /// running seat at all.
    int Colours { get; }
}

/// A drawing surface. Every call becomes an operation in the seat's batch,
/// translated by the origin and clipped to the rectangle this Graphics was
/// made for. The batch is flushed by the message loop, by an explicit Flush,
/// or when the program is about to wait, never here.
public class Graphics : IDisposable
{
    IDrawingTarget _target;
    int _originX, _originY;
    Rectangle _clip;

    public Graphics(IDrawingTarget target, int originX, int originY, Rectangle clip)
    {
        _target = target; _originX = originX; _originY = originY; _clip = clip;
        _target.Clip(clip.X, clip.Y, clip.Width, clip.Height);
    }

    public Rectangle ClipBounds { get { return new Rectangle(_clip.X - _originX, _clip.Y - _originY, _clip.Width, _clip.Height); } }

    public void Clear(Color colour) { _target.Fill(_clip.X, _clip.Y, _clip.Width, _clip.Height, colour); }

    public void FillRectangle(Brush brush, int x, int y, int w, int h)
    {
        SolidBrush? solid = brush as SolidBrush;
        if (solid == null || w <= 0 || h <= 0) return;
        _target.Fill(x + _originX, y + _originY, w, h, solid.Color);
    }
    public void FillRectangle(Brush brush, Rectangle r) { FillRectangle(brush, r.X, r.Y, r.Width, r.Height); }

    public void DrawRectangle(Pen pen, int x, int y, int w, int h)
    {
        if (w <= 0 || h <= 0) return;
        int t = (int)pen.Width; if (t < 1) t = 1;
        _target.Fill(x + _originX, y + _originY, w, t, pen.Color);
        _target.Fill(x + _originX, y + _originY + h - t, w, t, pen.Color);
        _target.Fill(x + _originX, y + _originY, t, h, pen.Color);
        _target.Fill(x + _originX + w - t, y + _originY, t, h, pen.Color);
    }
    public void DrawRectangle(Pen pen, Rectangle r) { DrawRectangle(pen, r.X, r.Y, r.Width, r.Height); }

    /// <summary>
    /// The outline of an ellipse inside this rectangle.
    ///
    /// The seat draws spans and lines and nothing curved, so the curve is
    /// worked out here: a midpoint sweep over one quadrant, mirrored into
    /// the other three. Integer arithmetic only, which is what makes it
    /// exact rather than nearly right at the ends of the axes.
    /// </summary>
    public void DrawEllipse(Pen pen, int x, int y, int w, int h)
    {
        if (w <= 0 || h <= 0) { return; }

        int a = w / 2, b = h / 2;
        int cx = x + a, cy = y + b;

        for (int i = 0; i < 4; i++)
        {
            // Each quadrant's extreme points, plotted so a circle of any
            // size closes rather than leaving gaps at the axes.
            FillRectangle(new SolidBrush(pen.Color), cx + (i == 0 ? a : i == 1 ? -a : 0), cy + (i == 2 ? b : i == 3 ? -b : 0), 1, 1);
        }

        long aa = (long)a * a, bb = (long)b * b;
        int px = 0, py = b;
        long fx = 0, fy = 2 * aa * b;
        long d = bb - aa * b + aa / 4;

        while (fx < fy)
        {
            px++;
            fx += 2 * bb;
            if (d < 0) { d += bb + fx; }
            else { py--; fy -= 2 * aa; d += bb + fx - fy; }
            Quadrants(pen, cx, cy, px, py);
        }

        d = (long)(bb * (px + 0.5) * (px + 0.5) + aa * (py - 1) * (py - 1) - aa * bb);

        while (py > 0)
        {
            py--;
            fy -= 2 * aa;
            if (d > 0) { d += aa - fy; }
            else { px++; fx += 2 * bb; d += aa - fy + fx; }
            Quadrants(pen, cx, cy, px, py);
        }
    }

    void Quadrants(Pen pen, int cx, int cy, int px, int py)
    {
        Brush ink = new SolidBrush(pen.Color);

        FillRectangle(ink, cx + px, cy + py, 1, 1);
        FillRectangle(ink, cx - px, cy + py, 1, 1);
        FillRectangle(ink, cx + px, cy - py, 1, 1);
        FillRectangle(ink, cx - px, cy - py, 1, 1);
    }

    public void DrawEllipse(Pen pen, Rectangle r) { DrawEllipse(pen, r.X, r.Y, r.Width, r.Height); }

    /// <summary>The same, filled: one span per row rather than an outline.</summary>
    public void FillEllipse(Brush brush, int x, int y, int w, int h)
    {
        if (w <= 0 || h <= 0) { return; }

        int a = w / 2, b = h / 2;
        int cx = x + a, cy = y + b;
        long aa = (long)a * a, bb = (long)b * b;

        for (int dy = -b; dy <= b; dy++)
        {
            // The half-width at this row, which is what makes each row one
            // span rather than a run of single pixels.
            long room = aa * (bb - (long)dy * dy);
            int dx = 0;

            while ((long)(dx + 1) * (dx + 1) * bb <= room) { dx++; }

            FillRectangle(brush, cx - dx, cy + dy, dx * 2 + 1, 1);
        }
    }

    public void FillEllipse(Brush brush, Rectangle r) { FillEllipse(brush, r.X, r.Y, r.Width, r.Height); }

    public void DrawLine(Pen pen, int x0, int y0, int x1, int y1)
    {
        if (y0 == y1) { int l = x0 < x1 ? x0 : x1; _target.Fill(l + _originX, y0 + _originY, (x0 < x1 ? x1 - x0 : x0 - x1) + 1, 1, pen.Color); return; }
        if (x0 == x1) { int t = y0 < y1 ? y0 : y1; _target.Fill(x0 + _originX, t + _originY, 1, (y0 < y1 ? y1 - y0 : y0 - y1) + 1, pen.Color); return; }
        _target.Line(x0 + _originX, y0 + _originY, x1 + _originX, y1 + _originY, pen.Color);
    }
    public void DrawLine(Pen pen, Point a, Point b) { DrawLine(pen, a.X, a.Y, b.X, b.Y); }

    public void DrawString(string s, Font font, Brush brush, int x, int y)
    {
        SolidBrush? solid = brush as SolidBrush;
        if (solid == null) { return; }

        TrueTypeSize? scaled = font.Scaled;

        // NO KNOWN BACKGROUND: nothing here is antialiased, because
        // blending needs a colour to blend against and the seat cannot
        // hand one back by reading the pixel underneath. A caller that
        // knows what it just painted -- almost every control does --
        // wants the overload below instead.
        if (scaled != null) { DrawScalableString(s, scaled, font.Height, font.Synthetic, solid.Color, false, Color.Transparent, Color.Transparent, true, x, y); return; }

        int cx = x + _originX, cy = y + _originY;
        for (int i = 0; i < s.Length; i++)
        {
            int c = (int)s[i];
            if (c == '\n') { cx = x + _originX; cy += font.Height; continue; }
            if (c > 255) c = '?';
            _target.Glyph(c, cx, cy, solid.Color, Color.Transparent, true);
            cx += font.GlyphWidth;
        }
    }

    /// <summary>
    /// The same, antialiased against `background` -- the colour already
    /// there, which the caller knows because it just painted it (a
    /// control's OnPaintBackground runs before OnPaint every time). Text
    /// still shows through anything drawn under it exactly as the plain
    /// overload does; only the edges of each letter are blended, which is
    /// what makes this correct rather than a guess: the caller is not
    /// claiming there is nothing under the text, only saying what colour
    /// it is.
    ///
    /// CORSAC-only. GDI+'s antialiasing reads its own bitmap back to find
    /// out what is underneath; this seat has no such read-back, so the
    /// caller supplies the one fact that stands in for it. Below 256
    /// colours, or for the bitmap system font, this draws exactly as the
    /// plain overload -- there is nothing here for either to blend with.
    /// </summary>
    public void DrawString(string s, Font font, Brush brush, Color background, int x, int y)
    {
        SolidBrush? solid = brush as SolidBrush;
        if (solid == null) { return; }

        TrueTypeSize? scaled = font.Scaled;

        if (scaled != null) { DrawScalableString(s, scaled, font.Height, font.Synthetic, solid.Color, true, background, Color.Transparent, true, x, y); return; }

        DrawString(s, font, brush, x, y);
    }

    /// <summary>
    /// The kerning adjustment between two glyphs, scaled from the face's
    /// font units to pixels at this size. Nought for a face with no kern
    /// table, or a pair it says nothing about, which is the common case
    /// and costs one table lookup to learn.
    /// </summary>
    internal static int Kern(TrueTypeSize scaled, int leftGlyph, int rightGlyph)
    {
        if (leftGlyph < 0) { return 0; }

        int units = scaled.Face.Kerning(leftGlyph, rightGlyph);
        if (units == 0) { return 0; }

        long value = (long)units * scaled.PixelsPerEm;
        int upem = scaled.Face.UnitsPerEm;
        return (int)((value >= 0 ? value + upem / 2 : value - upem / 2) / upem);
    }

    /// <summary>
    /// A run of text set in a scalable face: each rune's bitmap plotted a
    /// row of spans at a time, advanced by its own fitted width rather
    /// than a fixed one. `transparent` false also fills the space behind
    /// each glyph -- the cell width is its advance, which is what makes
    /// an opaque proportional string look like a filled bar rather than
    /// letter-shaped holes in one.
    ///
    /// `blend`, when not null, is the colour already behind the text --
    /// what the caller's own OnPaintBackground just painted there -- and
    /// switches this to the antialiased path: each glyph is rasterised as
    /// coverage rather than one bit, and every partially-covered pixel is
    /// blended between `blend` and the foreground rather than drawn flat.
    /// The seat has no way to read a pixel back to find out what is
    /// really behind the text, which is what GDI+ itself does to
    /// antialias; the caller already knows, since it just painted it, so
    /// that is what stands in for a framebuffer read here. Antialiasing
    /// is skipped below 256 colours regardless -- a palette that thin
    /// cannot blend two colours into a third worth looking at, and
    /// Windows 98 itself shipped with smoothing off for exactly that
    /// reason -- and for the bitmap system font, which has no coverage
    /// to blend from.
    /// </summary>
    void DrawScalableString(string s, TrueTypeSize scaled, int lineHeight, FontStyle style, Color foreground, bool hasBlend, Color blend, Color background, bool transparent, int x, int y)
    {
        bool antialiased = hasBlend && _target.Colours > 256;

        if (antialiased) { DrawScalableStringAA(s, scaled, lineHeight, style, foreground, blend, background, transparent, x, y); return; }
        bool bold = (style & FontStyle.Bold) != 0;
        bool italic = (style & FontStyle.Italic) != 0;

        // SYNTHETIC STYLES: this face has one outline, not four, so bold
        // and italic are made rather than chosen -- exactly what GDI
        // itself falls back to when a family has no separate bold or
        // italic design. Bold is the classic trick of filling a shape
        // twice, a pixel apart, which thickens every stroke by one pixel
        // regardless of its direction; italic is a shear, each row
        // pushed right in proportion to how far above the baseline it
        // sits, which is the same slant an oblique face applies to an
        // upright one.
        int boldExtra = bold ? 1 : 0;

        int penX = x, lineTop = y;
        int previousGlyph = -1;

        for (int i = 0; i < s.Length; )
        {
            Rune rune;
            int taken;

            if (!Rune.TryDecodeFromUtf8(s, i, out rune, out taken)) { taken = 1; rune = new Rune('?'); }
            i += taken;

            if (rune.Value == '\n') { penX = x; lineTop += lineHeight; previousGlyph = -1; continue; }

            int glyphIndex = scaled.Face.GlyphIndex(rune.Value);
            TrueTypeBitmap? bitmap = scaled.Glyph(glyphIndex);

            if (bitmap == null) { previousGlyph = glyphIndex; continue; }

            penX += Kern(scaled, previousGlyph, glyphIndex);
            previousGlyph = glyphIndex;

            int advance = bitmap.Advance + boldExtra;

            if (!transparent)
            {
                int cellWidth = advance + (italic ? bitmap.Height / 2 : 0);
                _target.Fill(penX + _originX, lineTop + _originY, cellWidth, lineHeight, background);
            }

            int baseline = lineTop + scaled.Ascent;
            int glyphX = penX + bitmap.Left + _originX;
            int glyphTop = baseline - bitmap.Top + _originY;

            for (int row = 0; row < bitmap.Height; row++)
            {
                // The higher above the baseline, the further right: a
                // shear about the baseline, not about the glyph's own
                // top, which is what keeps a whole line's slanted
                // letters leaning the same way instead of fanning out.
                int shear = italic ? (bitmap.Height - row) / 3 : 0;
                int run = -1;

                for (int col = 0; col <= bitmap.Width; col++)
                {
                    bool set = col < bitmap.Width && bitmap.At(col, row);

                    if (set && run < 0) { run = col; }
                    else if (!set && run >= 0)
                    {
                        int spanX = glyphX + run + shear;
                        int spanW = col - run + boldExtra;
                        _target.Fill(spanX, glyphTop + row, spanW, 1, foreground);
                        run = -1;
                    }
                }
            }

            penX += advance;
        }
    }

    /// <summary>
    /// A straight linear blend of black text against a light background
    /// reads thin and grey, not black: half the light a pixel reflects
    /// is still most of what the eye sees, so a coverage of "half" looks
    /// far lighter than half black. Every real text renderer -- ClearType,
    /// FreeType, DirectWrite -- corrects for this with a gamma curve that
    /// pushes the middle of the range darker before blending, which is
    /// what keeps antialiased text looking as bold as the crisp version
    /// rather than washed out. Built once, looked up per pixel: cheap.
    /// </summary>
    static byte[]? _gammaTable;

    static byte[] GammaTable()
    {
        if (_gammaTable != null) { return _gammaTable; }

        byte[] table = new byte[256];

        for (int i = 0; i < 256; i++)
        {
            // (coverage/255)^0.5 * 255 == sqrt(255 * coverage): a gamma
            // of two, done in exact integer arithmetic by the same
            // Newton's-method square root the rasteriser already uses,
            // rather than a real floating point pow -- this whole engine
            // avoids floating point on purpose, and a lookup table built
            // once from integers is no less correct for it.
            long target = 255L * i;
            long root = target <= 0 ? 0 : 1;

            while (root * root < target) { root = root << 1; }
            while (root > 0)
            {
                long next = (root + target / root) >> 1;
                if (next >= root) { break; }
                root = next;
            }

            // HALFWAY TO IT, NOT ALL THE WAY. The full square root is
            // what the arithmetic of light asks for, and on a small face
            // it is too much: a quarter-covered edge pixel comes out half
            // black, every stem gains most of a pixel, and eight-pixel
            // text closes up into a smudge. The mean of the straight line
            // and the curve -- a gamma of about 1.4 -- keeps text from
            // washing out without thickening it.
            int curved = root > 255 ? 255 : (int)root;
            table[i] = (byte)((i + curved + 1) / 2);
        }

        _gammaTable = table;
        return table;
    }

    /// <summary>
    /// DrawScalableString's antialiased twin: the same loop, kerning and
    /// synthetic styles, but each glyph comes from GlyphAA as coverage
    /// rather than one bit, and is drawn a run of EQUAL coverage at a
    /// time rather than a run of lit pixels. Interior pixels are all 255
    /// and coalesce into the same wide, cheap fills the crisp path uses;
    /// only the antialiased rim -- a pixel or two around the letter's
    /// edge -- costs an extra blend and its own small fill, which is what
    /// keeps this affordable on text-sized glyphs at ordinary sizes.
    /// </summary>
    void DrawScalableStringAA(string s, TrueTypeSize scaled, int lineHeight, FontStyle style, Color foreground, Color blend, Color background, bool transparent, int x, int y)
    {
        byte[] gamma = GammaTable();
        bool bold = (style & FontStyle.Bold) != 0;
        bool italic = (style & FontStyle.Italic) != 0;
        int boldExtra = bold ? 1 : 0;

        int penX = x, lineTop = y;
        int previousGlyph = -1;

        for (int i = 0; i < s.Length; )
        {
            Rune rune;
            int taken;

            if (!Rune.TryDecodeFromUtf8(s, i, out rune, out taken)) { taken = 1; rune = new Rune('?'); }
            i += taken;

            if (rune.Value == '\n') { penX = x; lineTop += lineHeight; previousGlyph = -1; continue; }

            int glyphIndex = scaled.Face.GlyphIndex(rune.Value);
            TrueTypeCoverageBitmap? bitmap = scaled.GlyphAA(glyphIndex);

            if (bitmap == null) { previousGlyph = glyphIndex; continue; }

            penX += Kern(scaled, previousGlyph, glyphIndex);
            previousGlyph = glyphIndex;

            int advance = bitmap.Advance + boldExtra;

            if (!transparent)
            {
                int cellWidth = advance + (italic ? bitmap.Height / 2 : 0);
                _target.Fill(penX + _originX, lineTop + _originY, cellWidth, lineHeight, background);
            }

            int baseline = lineTop + scaled.Ascent;
            int glyphX = penX + bitmap.Left + _originX;
            int glyphTop = baseline - bitmap.Top + _originY;

            for (int pass = 0; pass <= boldExtra; pass++)
            {
                // Bold's second pass is the same coverage, one pixel to
                // the right: two overlapping antialiased shapes read as
                // one heavier one, the same trick the crisp path uses.
                for (int row = 0; row < bitmap.Height; row++)
                {
                    int shear = italic ? (bitmap.Height - row) / 3 : 0;
                    int col = 0;

                    while (col < bitmap.Width)
                    {
                        int coverage = bitmap.At(col, row);

                        if (coverage == 0) { col++; continue; }

                        int start = col;
                        while (col < bitmap.Width && bitmap.At(col, row) == coverage) { col++; }

                        Color drawColor = coverage >= 255 ? foreground : ColorBlend.Mix(blend, foreground, gamma[coverage]);
                        _target.Fill(glyphX + start + shear + pass, glyphTop + row, col - start, 1, drawColor);
                    }
                }
            }

            penX += advance;
        }
    }

    public void DrawString(string s, Font font, Brush brush, Point p) { DrawString(s, font, brush, p.X, p.Y); }

    /// Part of what this surface already shows, moved: what a scrolling
    /// terminal does with the rows that only moved, one copy on the card
    /// instead of drawing every cell of them again. CORSAC-only; .NET's
    /// Graphics has no such thing because its windows are not retained.
    public void CopyArea(int sx, int sy, int dx, int dy, int w, int h)
    {
        _target.Copy(sx + _originX, sy + _originY, dx + _originX, dy + _originY, w, h);
    }
    public void DrawString(string s, Font font, Brush brush, float x, float y) { DrawString(s, font, brush, (int)x, (int)y); }

    /// Opaque text: background painted with the glyph, which on the
    /// hardware is one operation and on a 486 is the difference between a
    /// terminal that keeps up and one that does not.
    /// A glyph the program defined itself (Seat.DefineGlyph): an icon, a logo.
    public void DrawGlyph(int id, int x, int y, Color foreground, Color background, bool transparent)
    {
        _target.Glyph(id, x + _originX, y + _originY, foreground, background, transparent);
    }

    /// A picture the seat is keeping for us, by the id it was given.
    public void DrawBitmap(int id, int x, int y, int width, int height)
    {
        _target.Blit(id, 0, 0, x + _originX, y + _originY, width, height);
    }

    public void DrawStringOpaque(string s, Font font, Color foreground, Color background, int x, int y)
    {
        TrueTypeSize? scaled = font.Scaled;

        // Opaque already knows its own background -- it is about to
        // paint the whole cell with it -- so that same colour is what
        // antialiasing blends the letter's edges against too.
        if (scaled != null) { DrawScalableString(s, scaled, font.Height, font.Synthetic, foreground, true, background, background, false, x, y); return; }

        int cx = x + _originX, cy = y + _originY;
        for (int i = 0; i < s.Length; i++)
        {
            int c = (int)s[i]; if (c > 255) c = '?';
            _target.Glyph(c, cx, cy, foreground, background, false);
            cx += font.GlyphWidth;
        }
    }

    public SizeF MeasureString(string s, Font font)
    {
        TrueTypeSize? scaled = font.Scaled;

        if (scaled != null) { return MeasureScalableString(s, scaled, font.Height, font.Synthetic); }

        int longest = 0, lines = 1, run = 0;
        for (int i = 0; i < s.Length; i++)
        {
            if (s[i] == '\n') { lines++; if (run > longest) longest = run; run = 0; }
            else run++;
        }
        if (run > longest) longest = run;
        return new SizeF(longest * font.GlyphWidth, lines * font.Height);
    }

    /// The same measurement for a scalable face: runes decoded, each
    /// one's own fitted advance summed rather than a fixed width, which
    /// is the entire difference proportional text makes to this method.
    static SizeF MeasureScalableString(string s, TrueTypeSize scaled, int lineHeight, FontStyle style)
    {
        int boldExtra = (style & FontStyle.Bold) != 0 ? 1 : 0;
        int widest = 0, run = 0, lines = 1;
        int previousGlyph = -1;

        for (int i = 0; i < s.Length; )
        {
            Rune rune;
            int taken;

            if (!Rune.TryDecodeFromUtf8(s, i, out rune, out taken)) { taken = 1; rune = new Rune('?'); }
            i += taken;

            if (rune.Value == '\n') { lines++; if (run > widest) { widest = run; } run = 0; previousGlyph = -1; continue; }

            int glyphIndex = scaled.Face.GlyphIndex(rune.Value);

            run += Kern(scaled, previousGlyph, glyphIndex) + scaled.Advance(glyphIndex) + boldExtra;
            previousGlyph = glyphIndex;
        }
        if (run > widest) { widest = run; }
        return new SizeF(widest, lines * lineHeight);
    }

    public void Dispose() { }
}
