// THE GUI SERVICE MANAGER'S WIRE, as System.ServiceProcess and
// ProtectedData speak it: the manager is CORSAC/GUI's own, in the GUI
// kernel (os/gui/servicemanager.cor in the system's repository), on the
// abstract AF_UNIX SOCK_SEQPACKET name "gui-services". One message each way:
// a request's number, the user it is for (0xFFFFFFFF: the asker's own),
// its fields; the answer a Win32 error and its fields. A field is a 32-bit
// number, or a count and that many UTF-16 units or bytes, or a count and
// that many strings, little-endian.
//
// KEEP IN STEP with os/gui/servicewire.cor: the system's image build
// compares ServiceRequest (CheckEnumCopy), and nothing else -- WireError,
// WireState and the other sets are kept in step by hand. They carry Wire in
// their names here, .NET's own ServiceType and the rest being this
// namespace's.

namespace System.ServiceProcess
{
    public static class ServiceRequest
    {
        // The service manager.
        public const uint List = 1;
        public const uint Query = 2;
        public const uint Start = 3;
        public const uint Control = 4;
        public const uint Change = 5;
        public const uint Create = 6;
        public const uint Delete = 7;
        public const uint Register = 8;
        public const uint SetStatus = 9;
        public const uint ControlDone = 10;

        // The secret store.
        public const uint Protect = 20;
        public const uint Unprotect = 21;
        public const uint ItemWrite = 22;
        public const uint ItemRead = 23;
        public const uint ItemDelete = 24;
        public const uint ItemList = 25;
        public const uint TypeCreate = 26;
        public const uint TypeDelete = 27;
        public const uint TypeList = 28;
        public const uint TypeInfo = 29;
        public const uint SubtypeCreate = 30;
        public const uint SubtypeDelete = 31;
        public const uint SubtypeList = 32;
        public const uint SubtypeInfo = 33;

        // From the manager to a registered service.
        public const uint ControlMessage = 100;

        // COM's object broker: processes, IDs and object exporters.
        public const uint ComConnect = 200;
        public const uint ComProcessGone = 201;
        public const uint ComReserveIds = 202;
        public const uint ComThreadId = 203;
        public const uint ComOxidRegister = 204;
        public const uint ComOxidResolve = 205;
        public const uint ComOxidFree = 206;

        // Class objects, activation and the class registry.
        public const uint ComClassRegister = 210;
        public const uint ComClassRevoke = 211;
        public const uint ComActivate = 212;
        public const uint ComClassInfo = 213;

        // The running object table.
        public const uint RotRegister = 220;
        public const uint RotRevoke = 221;
        public const uint RotIsRunning = 222;
        public const uint RotGetObject = 223;
        public const uint RotNoteChangeTime = 224;
        public const uint RotGetTimeOfLastChange = 225;
        public const uint RotEnumRunning = 226;

        // Interfaces kept for windows (OLE drag and drop's drop targets).
        public const uint WindowPropRegister = 230;
        public const uint WindowPropGet = 231;

        // The endpoint mapper.
        public const uint EpInsert = 240;
        public const uint EpDelete = 241;
        public const uint EpLookup = 242;
        public const uint EpMap = 243;

        // The print spooler (System.Drawing.Printing's SpoolWire.cor says
        // each one's fields).
        public const uint SpoolPrinters = 300;
        public const uint SpoolPrinter = 301;
        public const uint SpoolStartDoc = 302;
        public const uint SpoolWrite = 303;
        public const uint SpoolStartPage = 304;
        public const uint SpoolEndPage = 305;
        public const uint SpoolEndDoc = 306;
        public const uint SpoolAbortDoc = 307;
        public const uint SpoolJobs = 308;
        public const uint SpoolJob = 309;
        public const uint SpoolJobControl = 310;
        public const uint SpoolPrinterControl = 311;
        public const uint SpoolWatch = 312;
        public const uint SpoolEvent = 313;
        public const uint SpoolSetPrinter = 314;
        public const uint SpoolDeletePrinter = 315;
    }

    /// When a service starts (winsvc.h's SERVICE_*_START, the same numbers).
    public static class WireStartType
    {
        public const uint Boot = 0;
        public const uint System = 1;
        public const uint Automatic = 2;
        public const uint Manual = 3;
        public const uint Disabled = 4;
    }

    /// A service's state (SERVICE_STOPPED .. SERVICE_PAUSED).
    public static class WireState
    {
        public const uint Stopped = 1;
        public const uint StartPending = 2;
        public const uint StopPending = 3;
        public const uint Running = 4;
        public const uint ContinuePending = 5;
        public const uint PausePending = 6;
        public const uint Paused = 7;
    }

    /// What a service is (winsvc.h's SERVICE_* type bits, which Windows' own
    /// services carry in their keys); Native marks one of CORSAC's own programs.
    public static class WireType
    {
        public const uint KernelDriver = 0x1;
        public const uint FileSystemDriver = 0x2;
        public const uint OwnProcess = 0x10;
        public const uint ShareProcess = 0x20;
        public const uint Interactive = 0x100;
        public const uint Native = 0x10000;
    }

    /// The controls (SERVICE_CONTROL_*); 128 to 255 are the service's own.
    public static class WireControl
    {
        public const uint Stop = 1;
        public const uint Pause = 2;
        public const uint Continue = 3;
        public const uint Interrogate = 4;
        public const uint Shutdown = 5;
        public const uint ParamChange = 6;
    }

    /// What a protected blob may be read by (DataProtectionScope's numbers).
    public static class WireScope
    {
        public const uint CurrentUser = 0;
        public const uint LocalMachine = 1;
    }

    /// Win32 errors the wire carries (winerror.h).
    public static class WireError
    {
        public const uint Success = 0, AccessDenied = 5, InvalidHandle = 6, InvalidData = 13, InvalidParameter = 87;
        public const uint InsufficientBuffer = 122, NotSupported = 50, AlreadyExists = 183, NoMoreItems = 259;
        public const uint DependentServicesRunning = 1051, InvalidServiceControl = 1052, RequestTimeout = 1053;
        public const uint NoServiceThread = 1054, ServiceAlreadyRunning = 1056, InvalidServiceAccount = 1057;
        public const uint ServiceDisabled = 1058, ServiceDoesNotExist = 1060, CannotAcceptControl = 1061;
        public const uint ServiceNotActive = 1062, ServiceSpecificError = 1066, ProcessAborted = 1067;
        public const uint DependencyFailed = 1068, ServiceMarkedForDelete = 1072, ServiceExists = 1073;
        public const uint NeverStarted = 1077, NotFound = 1168, PathNotFound = 3, FileNotFound = 2;
        public const uint DecryptionFailed = 6000, Unavailable = 1722;
    }

    /// One service, as the manager tells it.
    public class WireService
    {
        public string Name = "", Display = "", Description = "", Image = "", Account = "", Group = "";
        public uint Type, Start = WireStartType.Manual, ErrorControl = 1, Tag;
        public List<string> DependsOn = new List<string>(), DependsOnGroup = new List<string>();
        public uint State = WireState.Stopped, Controls, ExitCode, SpecificExitCode, CheckPoint, WaitHint;
        public int ProcessId;

        public bool Native { get { return (Type & WireType.Native) != 0; } }

        public void Write(WireWriter w)
        {
            w.Text(Name); w.Text(Display); w.Text(Description); w.Text(Image); w.Text(Account); w.Text(Group);
            w.Word(Type); w.Word(Start); w.Word(ErrorControl); w.Word(Tag);
            w.Texts(DependsOn); w.Texts(DependsOnGroup);
            w.Word(State); w.Word(Controls); w.Word(ExitCode); w.Word(SpecificExitCode); w.Word(CheckPoint); w.Word(WaitHint); w.Int(ProcessId);
        }

        public static WireService Read(WireReader r)
        {
            WireService s = new WireService();
            s.Name = r.Text(); s.Display = r.Text(); s.Description = r.Text(); s.Image = r.Text(); s.Account = r.Text(); s.Group = r.Text();
            s.Type = r.Word(); s.Start = r.Word(); s.ErrorControl = r.Word(); s.Tag = r.Word();
            s.DependsOn = r.Texts(); s.DependsOnGroup = r.Texts();
            s.State = r.Word(); s.Controls = r.Word(); s.ExitCode = r.Word(); s.SpecificExitCode = r.Word(); s.CheckPoint = r.Word(); s.WaitHint = r.Word(); s.ProcessId = r.Int();
            return s;
        }
    }

    /// A message being made.
    public class WireWriter
    {
        byte[] _b = new byte[256];
        int _n;

        public int Length { get { return _n; } }

        void Room(int more)
        {
            if (_n + more <= _b.Length) return;
            int size = _b.Length * 2;
            while (size < _n + more) size *= 2;
            byte[] bigger = new byte[size];
            Array.Copy(_b, 0, bigger, 0, _n);
            _b = bigger;
        }

        /// A DWORD: an error, a state, a control, a request's number.
        public void Word(uint v)
        {
            Room(4);
            _b[_n] = (byte)v; _b[_n + 1] = (byte)(v >> 8); _b[_n + 2] = (byte)(v >> 16); _b[_n + 3] = (byte)(v >> 24);
            _n += 4;
        }

        /// A signed 32-bit number -- a pid, a count, a handle -- as its bits.
        public void Int(int v) { Word(unchecked((uint)v)); }

        public void Text(string? s)
        {
            string t = s ?? "";
            Int(t.Length);
            Room(t.Length * 2);
            for (int i = 0; i < t.Length; i++) { _b[_n] = (byte)t[i]; _b[_n + 1] = (byte)(t[i] >> 8); _n += 2; }
        }

        public void Bytes(byte[]? b)
        {
            int count = b == null ? 0 : b.Length;
            Int(count);
            Room(count);
            if (count > 0) Array.Copy(b!, 0, _b, _n, count);
            _n += count;
        }

        public void Texts(List<string>? list)
        {
            Int(list == null ? 0 : list.Count);
            if (list != null) foreach (string s in list) Text(s);
        }

        /// A 64-bit number (an OXID, an OID, a FILETIME): its low word, then
        /// its high one -- the halves of the number, each its own field.
        public void Quad(ulong v) { Word(unchecked((uint)v)); Word((uint)(v >> 32)); }

        public byte[] ToArray()
        {
            byte[] made = new byte[_n];
            Array.Copy(_b, 0, made, 0, _n);
            return made;
        }
    }

    /// A message being read. A field past the end reads as 0 or empty, and
    /// says so (Short): a short message is the asker's mistake, answered as an
    /// invalid parameter, never a fault of the reader.
    public class WireReader
    {
        readonly byte[] _b;
        readonly int _end;
        int _at;
        public bool Short;

        public WireReader(byte[] b, int count) { _b = b; _end = Math.Min(count, b.Length); }

        /// A DWORD.
        public uint Word()
        {
            if (_at + 4 > _end) { Short = true; _at = _end; return 0; }
            uint v = unchecked((uint)(_b[_at] | (_b[_at + 1] << 8) | (_b[_at + 2] << 16) | (_b[_at + 3] << 24)));
            _at += 4;
            return v;
        }

        /// A signed 32-bit number -- a pid, a count, a handle: the word's bits.
        /// A count past 2^31 reads negative, which its reader refuses.
        public int Int() { return unchecked((int)Word()); }

        public string Text()
        {
            int n = Int();
            if (n < 0 || n > (_end - _at) / 2) { Short = true; _at = _end; return ""; }
            char[] c = new char[n];
            for (int i = 0; i < n; i++) c[i] = (char)(_b[_at + i * 2] | (_b[_at + i * 2 + 1] << 8));
            _at += n * 2;
            return new string(c);
        }

        public byte[] Bytes()
        {
            int n = Int();
            if (n < 0 || n > _end - _at) { Short = true; _at = _end; return new byte[0]; }
            byte[] made = new byte[n];
            Array.Copy(_b, _at, made, 0, n);
            _at += n;
            return made;
        }

        public List<string> Texts()
        {
            int n = Int();
            List<string> list = new List<string>();
            for (int i = 0; i < n && !Short; i++) list.Add(Text());
            return list;
        }

        public ulong Quad() { ulong low = Word(); ulong high = Word(); return low | high << 32; }
    }

    /// One request on its own connection, or on one held open (AskOn), and
    /// its answer: the reader past the answer's error, which is in `error`;
    /// null when there is no manager to ask (ERROR_SERVICE_NOT_ACTIVE's
    /// sibling, RPC_S_SERVER_UNAVAILABLE, 1722).
    public static class WireClient
    {
        const int AfUnix = 1, SeqPacket = 5, CloseOnExec = 0x80000, NoSignal = 0x4000;
        const string Name = "gui-services";

        static byte[] Address()
        {
            byte[] a = new byte[3 + Name.Length];
            a[0] = AfUnix;
            for (int i = 0; i < Name.Length; i++) a[3 + i] = (byte)Name[i];
            return a;
        }

        /// A connection to the manager, or -1.
        public static int Connect()
        {
            int fd = Os.Socket(AfUnix, SeqPacket | CloseOnExec, 0);
            if (fd < 0) return -1;
            if (Os.Connect(fd, Address()) < 0) { Os.Close(fd); return -1; }
            return fd;
        }

        public static byte[] Message(uint op, WireWriter fields)
        {
            WireWriter w = new WireWriter();
            w.Word(op);
            w.Word(0xFFFFFFFF);
            byte[] head = w.ToArray(), body = fields.ToArray();
            byte[] all = new byte[head.Length + body.Length];
            Array.Copy(head, 0, all, 0, head.Length);
            Array.Copy(body, 0, all, head.Length, body.Length);
            return all;
        }

        public static bool Send(int fd, byte[] message) { return Os.Send(fd, message, 0, message.Length, NoSignal) == message.Length; }

        /// One message in, or null when the connection has ended.
        public static byte[]? Receive(int fd)
        {
            byte[] b = new byte[65536 + 4096];
            int got = Os.Recv(fd, b, 0, b.Length, 0);
            if (got <= 0) return null;
            byte[] made = new byte[got];
            Array.Copy(b, 0, made, 0, got);
            return made;
        }

        public static WireReader? Ask(uint op, WireWriter fields, out uint error)
        {
            error = WireError.Unavailable;
            int fd = Connect();
            if (fd < 0) return null;
            try { return AskOn(fd, op, fields, out error); }
            finally { Os.Close(fd); }
        }

        /// One request on a connection held open (Connect), and its answer,
        /// as Ask: the manager answers any number of requests on one
        /// connection, one at a time, so the caller asks one at a time.
        public static WireReader? AskOn(int fd, uint op, WireWriter fields, out uint error)
        {
            error = WireError.Unavailable;
            if (!Send(fd, Message(op, fields))) return null;
            byte[]? answer = Receive(fd);
            if (answer == null || answer.Length < 4) return null;
            WireReader r = new WireReader(answer, answer.Length);
            error = r.Word();
            return r;
        }
    }
}
