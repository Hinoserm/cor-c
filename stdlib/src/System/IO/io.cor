// System.IO, as .NET spells it: Stream and the streams over descriptors
// and memory, the text readers and writers, Directory. One-to-one with
// .NET's names and behaviour where .NET has them; the platform's Os calls
// underneath (lib/sys/linux.cor), so a program written for .NET compiles
// here unchanged.

enum FileMode
{
    CreateNew = 1,
    Create = 2,
    Open = 3,
    OpenOrCreate = 4,
    Truncate = 5,
    Append = 6
}

enum FileAccess
{
    Read = 1,
    Write = 2,
    ReadWrite = 3
}

/// What other openers of the same file may do while this stream has it.
/// On Unix, as .NET does it there: an advisory flock(2) taken at the open --
/// exclusive for None, shared otherwise -- and a sharing violation
/// (IOException) when another stream's lock is in the way. The other bits
/// are .NET's and are accepted.
[Flags]
enum FileShare
{
    None = 0,
    Read = 1,
    Write = 2,
    ReadWrite = 3,
    Delete = 4,
    Inheritable = 16
}

/// How a file is opened beyond its mode and access, as .NET names it. Accepted;
/// none changes what a read or a write does here.
[Flags]
enum FileOptions
{
    WriteThrough = unchecked((int)0x80000000),
    None = 0,
    Encrypted = 0x4000,
    DeleteOnClose = 0x4000000,
    SequentialScan = 0x8000000,
    RandomAccess = 0x10000000,
    Asynchronous = 0x40000000
}

enum SeekOrigin
{
    Begin = 0,
    Current = 1,
    End = 2
}

/// The .NET Stream: what every source and sink of bytes looks like.
/// ReadAsync/WriteAsync complete synchronously here -- the scheduler is
/// single-threaded and the descriptors block -- which is legal for a
/// Stream and what .NET's base class does for a stream that does not
/// override them.
abstract class Stream : IDisposable, IAsyncDisposable
{
    public abstract bool CanRead { get; }
    public abstract bool CanWrite { get; }
    public abstract bool CanSeek { get; }
    public abstract int Read(byte[] buffer, int offset, int count);
    public abstract void Write(byte[] buffer, int offset, int count);

    public virtual long Length
    {
        get { throw new NotSupportedException("this stream has no length"); }
    }

    public virtual long Position
    {
        get { throw new NotSupportedException("this stream has no position"); }
        set { throw new NotSupportedException("this stream has no position"); }
    }

    public virtual long Seek(long offset, SeekOrigin origin)
    {
        throw new NotSupportedException("this stream cannot seek");
    }

    public virtual void Flush()
    {
    }

    public virtual void SetLength(long value)
    {
        throw new NotSupportedException("this stream cannot be resized");
    }

    // ONE BYTE AT A TIME THROUGH THE ARRAY METHODS, with an array the
    // stream keeps for it rather than one made each time -- .NET's default
    // rents one from the shared pool. A stream that writes a byte at a time
    // (a BinaryWriter's bool, a hash being fed) made one per byte.
    byte[]? _one;

    public virtual int ReadByte()
    {
        byte[] one = _one ??= new byte[1];
        return Read(one, 0, 1) == 1 ? one[0] & 255 : -1;
    }

    public virtual void WriteByte(byte value)
    {
        byte[] one = _one ??= new byte[1];
        one[0] = value;
        Write(one, 0, 1);
    }

    public int Read(byte[] buffer)
    {
        return Read(buffer, 0, buffer.Length);
    }

    /// Into a span, through an array as .NET's default does; a stream over
    /// memory of its own does better by overriding it.
    public virtual int Read(Span<byte> buffer)
    {
        byte[] through = new byte[buffer.Length];
        int got = Read(through, 0, through.Length);
        new ReadOnlySpan<byte>(through, 0, got).CopyTo(buffer);
        return got;
    }

    public virtual void Write(ReadOnlySpan<byte> buffer)
    {
        byte[] through = buffer.ToArray();
        Write(through, 0, through.Length);
    }

    /// Exactly `count` bytes, or EndOfStreamException: Read may hand back
    /// fewer than asked, and this reads until it has them all.
    public void ReadExactly(byte[] buffer, int offset, int count)
    {
        if (buffer == null)
        {
            throw new ArgumentNullException(nameof(buffer));
        }
        if (offset < 0 || count < 0 || offset > buffer.Length - count)
        {
            throw new ArgumentOutOfRangeException(nameof(offset));
        }
        int done = 0;
        while (done < count)
        {
            int got = Read(buffer, offset + done, count - done);
            if (got <= 0)
            {
                throw new EndOfStreamException("Unable to read beyond the end of the stream.");
            }
            done = done + got;
        }
    }

    public void ReadExactly(Span<byte> buffer)
    {
        ReadAtLeast(buffer, buffer.Length, true);
    }

    /// At least `minimumBytes`, and as many more as fit and are there;
    /// fewer only at the end of the stream, and then EndOfStreamException
    /// unless told not to.
    public int ReadAtLeast(Span<byte> buffer, int minimumBytes, bool throwOnEndOfStream = true)
    {
        if (minimumBytes < 0 || minimumBytes > buffer.Length)
        {
            throw new ArgumentOutOfRangeException(nameof(minimumBytes));
        }
        int done = 0;
        while (done < minimumBytes)
        {
            int got = Read(buffer.Slice(done));
            if (got <= 0)
            {
                if (throwOnEndOfStream)
                {
                    throw new EndOfStreamException("Unable to read beyond the end of the stream.");
                }
                break;
            }
            done = done + got;
        }
        return done;
    }

    public void Write(byte[] buffer)
    {
        Write(buffer, 0, buffer.Length);
    }

    public virtual Task<int> ReadAsync(byte[] buffer, int offset, int count)
    {
        return Task.FromResult(Read(buffer, offset, count));
    }

    public virtual Task WriteAsync(byte[] buffer, int offset, int count)
    {
        Write(buffer, offset, count);
        return Task.CompletedTask;
    }

    /// Into a window of memory, as many bytes as are ready; 0 at the end.
    public virtual System.Threading.Tasks.ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        byte[] into = new byte[buffer.Length];
        int n = Read(into, 0, into.Length);
        for (int i = 0; i < n; i++) buffer.Span[i] = into[i];
        return new System.Threading.Tasks.ValueTask<int>(n);
    }

    public virtual System.Threading.Tasks.ValueTask WriteAsync(ReadOnlyMemory<byte> buffer, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        byte[] bytes = buffer.ToArray();
        Write(bytes, 0, bytes.Length);
        return default;
    }

    public Task CopyToAsync(Stream destination) => CopyToAsync(destination, 81920, CancellationToken.None);

    public Task CopyToAsync(Stream destination, CancellationToken cancellationToken) => CopyToAsync(destination, 81920, cancellationToken);

    /// Copied on a worker, so a caller awaiting two of them (a child's two
    /// pipes) drains both at once rather than one after the other.
    public virtual Task CopyToAsync(Stream destination, int bufferSize, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(destination);
        return Task.Run(() =>
        {
            byte[] chunk = new byte[bufferSize];
            while (true)
            {
                cancellationToken.ThrowIfCancellationRequested();
                int n = Read(chunk, 0, chunk.Length);
                if (n <= 0) return;
                destination.Write(chunk, 0, n);
            }
        });
    }

    public virtual Task FlushAsync() => FlushAsync(CancellationToken.None);

    public virtual Task FlushAsync(CancellationToken cancellationToken)
    {
        Flush();
        return Task.CompletedTask;
    }

    /// A stream that holds nothing and swallows everything: .NET's Stream.Null.
    public static readonly Stream Null = new NullStream();

    public void CopyTo(Stream destination)
    {
        byte[] chunk = new byte[8192];
        while (true)
        {
            int n = Read(chunk, 0, chunk.Length);
            if (n <= 0)
            {
                return;
            }
            destination.Write(chunk, 0, n);
        }
    }

    public virtual void Close()
    {
        Dispose();
    }

    public virtual void Dispose()
    {
        Dispose(true);
    }

    /// .NET's: disposes synchronously and hands back a completed ValueTask
    /// (what `await using` over a stream awaits).
    public virtual System.Threading.Tasks.ValueTask DisposeAsync()
    {
        Dispose();
        return default;
    }

    protected virtual void Dispose(bool disposing)
    {
    }
}

/// A stream over a descriptor: a file opened by path, or a handle the
/// program already holds (standard input, a pipe end).
class FileStream : Stream
{
    int _fd;
    bool _canRead;
    bool _canWrite;
    bool _owns;
    string _name;

    // BUFFERED, AS .NET'S IS: 4096 bytes unless the constructor says
    // otherwise, and 0 or 1 turns it off. Without it every ReadByte was a
    // read system call -- a BinaryReader over a megabyte file made a million
    // of them. One buffer serves both directions: bytes read ahead
    // (_readPos.._readLen) or bytes written and not yet sent (_writePos),
    // never both at once.
    //
    // A stream over a descriptor the program already has is not buffered.
    // Those are the console's and a child process's pipes, which .NET serves
    // with unbuffered streams (ConsoleStream) or flushes after every write;
    // bytes held here would reach a terminal or a child late.
    const int DefaultBufferSize = 4096;
    int _bufferSize = DefaultBufferSize;
    byte[]? _buffer;
    int _readPos;
    int _readLen;
    int _writePos;
    // WHERE THE DESCRIPTOR IS, kept here as .NET keeps _filePosition, so
    // that asking the position is not a system call and a seek that lands
    // in the bytes already read ahead keeps them. -1 while unknown: before
    // the first ask and after the descriptor is handed out (Handle).
    long _at = -1;

    public FileStream(string path, FileMode mode) : this(path, mode, mode == FileMode.Open ? FileAccess.Read : FileAccess.ReadWrite)
    {
    }

    public FileStream(string path, FileMode mode, FileAccess access)
    {
        _name = path;
        int flags = access == FileAccess.Read ? O.Read : access == FileAccess.Write ? O.Write : O.ReadWrite;
        if (mode == FileMode.CreateNew)
        {
            flags = flags | O.Create | O.Exclusive;
        }
        else if (mode == FileMode.Create)
        {
            flags = flags | O.Create | O.Truncate;
        }
        else if (mode == FileMode.OpenOrCreate)
        {
            flags = flags | O.Create;
        }
        else if (mode == FileMode.Truncate)
        {
            flags = flags | O.Truncate;
        }
        else if (mode == FileMode.Append)
        {
            flags = flags | O.Create | O.Append;
        }
        // O_LARGEFILE ALWAYS, as .NET does on Linux: without it a 32-bit
        // kernel refuses to open anything 2 GiB or larger at all.
        _fd = Os.Open(path, flags | O.LargeFile, 420);
        if (_fd < 0)
        {
            throw Interop.GetExceptionForIoErrno(_fd, path);
        }
        _canRead = access != FileAccess.Write;
        _canWrite = access != FileAccess.Read;
        _owns = true;
        // AN APPEND STREAM STARTS AT THE END, as .NET's does: its Position
        // is the file's length from the first moment, not 0.
        _at = mode == FileMode.Append ? Os.Lseek(_fd, 0, (int)SeekOrigin.End) : 0;
    }

    /// The same with what others may do meanwhile (FileShare). .NET on Unix
    /// takes flock(LOCK_EX | LOCK_NB) for None and flock(LOCK_SH | LOCK_NB)
    /// otherwise -- the shared one only when this stream does not write --
    /// and turns EWOULDBLOCK into a sharing violation; any other failure
    /// (a file system with no locks, a kernel without flock) opens anyway.
    public FileStream(string path, FileMode mode, FileAccess access, FileShare share) : this(path, mode, access)
    {
        bool exclusive = share == FileShare.None;
        if (!exclusive && access != FileAccess.Read) return;
        int result = Os.Flock(_fd, (exclusive ? 2 : 1) | 4);
        if (result == -(int)Err.Again)
        {
            Os.Close(_fd);
            _fd = -1;
            throw new IOException("The process cannot access the file '" + path + "' because it is being used by another process.");
        }
    }

    public FileStream(string path, FileMode mode, FileAccess access, FileShare share, int bufferSize) : this(path, mode, access, share)
    {
        if (bufferSize == -1) bufferSize = DefaultBufferSize;
        if (bufferSize < 0) throw new ArgumentOutOfRangeException("bufferSize", "Positive number required.");
        _bufferSize = bufferSize > 1 ? bufferSize : 0;
    }

    /// Over a descriptor the program already has. Closing the stream closes
    /// it too unless `ownsHandle` says otherwise.
    public FileStream(int handle, FileAccess access, bool ownsHandle)
    {
        _fd = handle;
        _bufferSize = 0;
        _name = "fd " + handle;
        _canRead = access != FileAccess.Write;
        _canWrite = access != FileAccess.Read;
        _owns = ownsHandle;
    }

    /// The descriptor, with nothing held back from it: whoever asks for it
    /// is about to use it directly, so what is buffered is written out and
    /// what was read ahead is given back first, as .NET does when its
    /// SafeFileHandle is taken.
    public int Handle
    {
        get
        {
            FlushWrite();
            FlushRead();
            _at = -1;
            return _fd;
        }
    }

    public string Name
    {
        get { return _name; }
    }

    public override bool CanRead { get { return _canRead; } }
    public override bool CanWrite { get { return _canWrite; } }
    /// Whether the descriptor takes lseek: a file or a block device does,
    /// a pipe, a terminal or a socket does not.
    public override bool CanSeek
    {
        get { return _fd >= 0 && Os.Lseek(_fd, 0, 1) >= 0; }
    }

    int RawRead(byte[] buffer, int offset, int count)
    {
        while (true)
        {
            int n = Os.Read(_fd, buffer, offset, count);
            if (n == -Err.Intr)
            {
                continue;
            }
            if (n < 0)
            {
                throw Interop.GetExceptionForIoErrno(n, _name);
            }
            if (_at >= 0) _at = _at + n;
            return n;
        }
    }

    void RawWrite(byte[] buffer, int offset, int count)
    {
        int done = 0;
        while (done < count)
        {
            int n = Os.Write(_fd, buffer, offset + done, count - done);
            if (n == -Err.Intr)
            {
                continue;
            }
            if (n < 0)
            {
                throw Interop.GetExceptionForIoErrno(n, _name);
            }
            done = done + n;
        }
        if (_at >= 0) _at = _at + count;
    }

    /// What was written into the buffer, out to the file.
    void FlushWrite()
    {
        if (_writePos == 0) return;
        int n = _writePos;
        _writePos = 0;
        RawWrite(_buffer!, 0, n);
    }

    /// What was read ahead and not yet consumed, given back: the descriptor's
    /// offset moves back to where the reader is. Only a seekable descriptor
    /// can; from a pipe the bytes are simply dropped, as .NET drops them.
    void FlushRead()
    {
        int ahead = _readLen - _readPos;
        _readPos = 0;
        _readLen = 0;
        if (ahead != 0 && _fd >= 0)
        {
            long at = Os.Lseek(_fd, -ahead, (int)SeekOrigin.Current);
            _at = at >= 0 ? at : -1;
        }
    }

    public override int Read(byte[] buffer, int offset, int count)
    {
        if (_bufferSize == 0) return RawRead(buffer, offset, count);
        FlushWrite();
        int held = _readLen - _readPos;
        if (held == 0)
        {
            // A read as big as the buffer goes straight into the caller's
            // array; copying it through the buffer would only cost a copy.
            if (count >= _bufferSize) return RawRead(buffer, offset, count);
            if (_buffer == null) _buffer = new byte[_bufferSize];
            _readPos = 0;
            _readLen = RawRead(_buffer, 0, _bufferSize);
            held = _readLen;
            if (held == 0) return 0;
        }
        int n = held < count ? held : count;
        Array.Copy(_buffer!, _readPos, buffer, offset, n);
        _readPos = _readPos + n;
        return n;
    }

    public override int ReadByte()
    {
        if (_readPos < _readLen)
        {
            int b = _buffer![_readPos] & 255;
            _readPos = _readPos + 1;
            return b;
        }
        if (_bufferSize == 0) return base.ReadByte();
        FlushWrite();
        if (_buffer == null) _buffer = new byte[_bufferSize];
        _readPos = 0;
        _readLen = RawRead(_buffer, 0, _bufferSize);
        if (_readLen == 0) return -1;
        _readPos = 1;
        return _buffer[0] & 255;
    }

    public override void Flush()
    {
        FlushWrite();
        FlushRead();
    }

    /// Flush, and with flushToDisk the file's bytes onto the device (fsync),
    /// as .NET's FileStream.Flush(bool) does.
    public virtual void Flush(bool flushToDisk)
    {
        Flush();
        if (flushToDisk && _fd >= 0)
        {
            int result = Os.Fsync(_fd);
            if (result < 0) throw Interop.GetExceptionForIoErrno(result, "");
        }
    }

    public override void SetLength(long value)
    {
        if (value < 0) throw new ArgumentOutOfRangeException("value");
        if (!_canWrite) throw new NotSupportedException("Stream does not support writing.");
        FlushWrite();
        FlushRead();
        int result = Os.Ftruncate(_fd, value);
        if (result < 0) throw Interop.GetExceptionForIoErrno(result, "");
        // Cut short beneath the position, the position moves to the new end.
        if (Os.Lseek(_fd, 0, (int)SeekOrigin.Current) > value) Os.Lseek(_fd, value, (int)SeekOrigin.Begin);
        _at = -1;
    }

    public override void Write(byte[] buffer, int offset, int count)
    {
        if (_bufferSize == 0)
        {
            RawWrite(buffer, offset, count);
            return;
        }
        if (_readLen != 0) FlushRead();
        if (_writePos + count <= _bufferSize)
        {
            if (_buffer == null) _buffer = new byte[_bufferSize];
            Array.Copy(buffer, offset, _buffer, _writePos, count);
            _writePos = _writePos + count;
            return;
        }
        FlushWrite();
        if (count >= _bufferSize)
        {
            RawWrite(buffer, offset, count);
            return;
        }
        if (_buffer == null) _buffer = new byte[_bufferSize];
        Array.Copy(buffer, offset, _buffer, 0, count);
        _writePos = count;
    }

    public override void WriteByte(byte value)
    {
        if (_bufferSize == 0)
        {
            base.WriteByte(value);
            return;
        }
        if (_readLen != 0) FlushRead();
        if (_writePos == _bufferSize) FlushWrite();
        if (_buffer == null) _buffer = new byte[_bufferSize];
        _buffer[_writePos] = value;
        _writePos = _writePos + 1;
    }

    public override long Length
    {
        get
        {
            FlushWrite();
            return Os.SizeOf(_fd);
        }
    }

    /// Where the reader or writer is, which is not where the descriptor is
    /// while bytes are read ahead or held back.
    public override long Position
    {
        get { return Where() - (_readLen - _readPos) + _writePos; }
        set { Seek(value, SeekOrigin.Begin); }
    }

    /// The descriptor's offset, from _at when it is known.
    long Where()
    {
        if (_at >= 0 && _bufferSize != 0) return _at;
        long at = Os.Lseek(_fd, 0, (int)SeekOrigin.Current);
        if (_bufferSize != 0 && at >= 0) _at = at;
        return at;
    }

    public override long Seek(long offset, SeekOrigin origin)
    {
        FlushWrite();
        // INSIDE WHAT WAS READ AHEAD, the buffer is kept and only the reader
        // moves, as .NET's BufferedFileStreamStrategy does: a reader that
        // hops about a small region costs no system call per hop.
        if (_readLen != 0 && _at >= 0 && origin != SeekOrigin.End)
        {
            long target = origin == SeekOrigin.Begin ? offset : _at - (_readLen - _readPos) + offset;
            long low = _at - _readLen;
            if (target >= low && target <= _at)
            {
                _readPos = (int)(target - low);
                return target;
            }
        }
        // Relative to the reader, not to the descriptor, which is ahead.
        if (origin == SeekOrigin.Current) offset = offset - (_readLen - _readPos);
        _readPos = 0;
        _readLen = 0;
        long at = Os.Lseek(_fd, offset, (int)origin);
        if (at < 0)
        {
            throw Interop.GetExceptionForIoErrno((int)at, _name);
        }
        _at = at;
        return at;
    }

    public override void Dispose()
    {
        try
        {
            if (_fd >= 0) FlushWrite();
        }
        finally
        {
            if (_owns && _fd >= 0)
            {
                Os.Close(_fd);
            }
            _fd = -1;
            _readPos = 0;
            _readLen = 0;
        }
    }
}

/// A stream over a growable byte array.
sealed class NullStream : Stream
{
    public override bool CanRead => true;
    public override bool CanWrite => true;
    public override bool CanSeek => true;
    public override long Length => 0;
    public override long Position { get { return 0; } set { } }
    public override long Seek(long offset, SeekOrigin origin) => 0;
    public override int Read(byte[] buffer, int offset, int count) => 0;
    public override void Write(byte[] buffer, int offset, int count) { }
}

class MemoryStream : Stream, IOwnsStorage
{
    byte[] _bytes;
    /// Whether GetBuffer handed the array out: it is then the caller's too,
    /// and neither growing nor dying gives it back.
    bool _lent;

    /// THE ARRAY GIVEN BACK with a stream proved dead (Runtime.Free), when
    /// the stream made it and never lent it.
    public void FreeStorage()
    {
        if (_expandable && !_lent && _bytes != null) Runtime.FreeOwnedReplaced((nint)Sys.Word(_bytes), 0);
        _bytes = null!;
    }
    /// Where the stream's first byte is in _bytes, and how much of it the
    /// stream may use: all of an array it made, a window of one it was
    /// given. Positions and lengths are the stream's, from _origin.
    int _origin;
    int _capacity;
    int _length;
    int _position;
    /// Only a stream that made its own array grows it; one over a caller's
    /// array is that array's size for good, as .NET's is.
    bool _expandable;
    /// Whether GetBuffer may hand the array out: not for a window of
    /// someone else's (.NET's publiclyVisible).
    bool _visible;

    public MemoryStream()
    {
        _bytes = new byte[256];
        _capacity = _bytes.Length;
        _expandable = true;
        _visible = true;
    }

    /// Over all of `buffer`, which it reads and writes in place and never
    /// grows.
    public MemoryStream(byte[] buffer) : this(buffer, 0, buffer.Length) { _visible = true; }

    /// Over all of `buffer`, read-only when writable is false.
    public MemoryStream(byte[] buffer, bool writable) : this(buffer) { _readOnly = !writable; }

    bool _readOnly;

    /// The length set outright: cut short, or grown with zeroes.
    public override void SetLength(long value)
    {
        if (_readOnly) throw new NotSupportedException("Stream does not support writing.");
        if (value < 0 || value > int.MaxValue) throw new ArgumentOutOfRangeException("value");
        int length = (int)value;
        if (length > _capacity)
        {
            if (!_expandable) throw new NotSupportedException("memory stream is not expandable");
            byte[] bigger = new byte[length];
            Array.Copy(_bytes, _origin, bigger, 0, _length);
            byte[] outgrown = _bytes;
            _bytes = bigger;
            _origin = 0;
            _capacity = length;
            if (!_lent) Runtime.FreeOwnedReplaced((nint)Sys.Word(outgrown), 0);
        }
        if (length > _length) Array.Clear(_bytes, _origin + _length, length - _length);
        _length = length;
        if (_position > length) _position = length;
    }

    /// Over `count` bytes of `buffer` from `index`: position 0 is
    /// buffer[index], and the stream ends after `count` bytes.
    public MemoryStream(byte[] buffer, int index, int count)
    {
        if (buffer == null) throw new ArgumentNullException("buffer");
        if (index < 0) throw new ArgumentOutOfRangeException("index");
        if (count < 0) throw new ArgumentOutOfRangeException("count");
        if (buffer.Length - index < count) throw new ArgumentException("the offset and length are outside the buffer");
        _bytes = buffer;
        _origin = index;
        _capacity = count;
        _length = count;
    }

    public override bool CanRead { get { return true; } }
    public override bool CanWrite { get { return !_readOnly; } }
    public override bool CanSeek { get { return true; } }

    public override long Length { get { return _length; } }

    public override long Position
    {
        get { return _position; }
        set
        {
            if (value < 0) throw new ArgumentOutOfRangeException("value");
            _position = (int)value;
        }
    }

    public override long Seek(long offset, SeekOrigin origin)
    {
        long at = origin == SeekOrigin.Begin ? offset : origin == SeekOrigin.Current ? _position + offset : _length + offset;
        if (at < 0) throw new IOException("an attempt was made to move the position before the beginning of the stream");
        _position = (int)at;
        return at;
    }

    public override int Read(byte[] buffer, int offset, int count)
    {
        int n = _length - _position;
        if (n > count)
        {
            n = count;
        }
        if (n <= 0)
        {
            return 0;
        }
        Array.Copy(_bytes, _origin + _position, buffer, offset, n);
        _position = _position + n;
        return n;
    }

    // A byte at a time without the one-byte array Stream's own versions make
    // for every call, as .NET's MemoryStream overrides them too.
    public override int ReadByte()
    {
        if (_position >= _length) return -1;
        int b = _bytes[_origin + _position] & 255;
        _position = _position + 1;
        return b;
    }

    public override void WriteByte(byte value)
    {
        if (_readOnly || _position >= _capacity || _position > _length)
        {
            base.WriteByte(value);
            return;
        }
        _bytes[_origin + _position] = value;
        _position = _position + 1;
        if (_position > _length) _length = _position;
    }

    public override void Write(byte[] buffer, int offset, int count)
    {
        if (_readOnly) throw new NotSupportedException("Stream does not support writing.");
        if (_position + count > _capacity)
        {
            if (!_expandable) throw new NotSupportedException("memory stream is not expandable");
            int size = _capacity * 2;
            while (size < _position + count)
            {
                size = size * 2;
            }
            byte[] bigger = new byte[size];
            Array.Copy(_bytes, 0, bigger, 0, _length);
            byte[] outgrown = _bytes;
            _bytes = bigger;
            _capacity = size;
            // Outgrown: given back unless GetBuffer lent it out.
            if (!_lent) Runtime.FreeOwnedReplaced((nint)Sys.Word(outgrown), 0);
        }
        // Bytes between the old end and a position seeked past it are zero.
        if (_position > _length) Array.Clear(_bytes, _origin + _length, _position - _length);
        Array.Copy(buffer, offset, _bytes, _origin + _position, count);
        _position = _position + count;
        if (_position > _length)
        {
            _length = _position;
        }
    }

    public byte[] ToArray()
    {
        byte[] copy = new byte[_length];
        Array.Copy(_bytes, _origin, copy, 0, _length);
        return copy;
    }

    /// The array itself. A stream over a window of someone else's array
    /// will not hand it out (UnauthorizedAccessException, as .NET's).
    public byte[] GetBuffer()
    {
        if (!_visible) throw new UnauthorizedAccessException("the MemoryStream's internal buffer cannot be accessed");
        _lent = true;
        return _bytes;
    }
}

/// .NET's TextWriter: characters out, in whatever encoding the writer
/// underneath uses. A line ends with NewLine, "\n" on this system as on
/// every Unix .NET runs on.
abstract class TextWriter : IDisposable
{
    string _newLine = "\n";

    /// The line end WriteLine writes.
    public virtual string NewLine
    {
        get { return _newLine; }
        set { _newLine = value ?? "\n"; }
    }

    /// The encoding the text is written in; UTF-8 unless a writer says.
    public virtual Encoding Encoding => new UTF8Encoding(false);

    public virtual void Close()
    {
        Dispose();
    }

    /// The provider numbers and dates are written with.
    public virtual IFormatProvider FormatProvider => CultureInfo.CurrentCulture;

    /// A writer that keeps nothing: what .NET's TextWriter.Null is.
    public static readonly TextWriter Null = new NullTextWriter();

    public abstract void Write(char value);

    public virtual void Write(char[]? buffer)
    {
        if (buffer == null) return;
        Write(buffer, 0, buffer.Length);
    }

    public virtual void Write(char[] buffer, int index, int count)
    {
        if (buffer == null) throw new ArgumentNullException("buffer", "Buffer cannot be null.");
        if (index < 0) throw new ArgumentOutOfRangeException("index", "Non-negative number required.");
        if (count < 0) throw new ArgumentOutOfRangeException("count", "Non-negative number required.");
        if (buffer.Length - index < count) throw new ArgumentException("Offset and length were out of bounds for the array or count is greater than the number of elements from index to the end of the source collection.");
        for (int i = 0; i < count; i++)
        {
            Write(buffer[index + i]);
        }
    }

    public virtual void Write(ReadOnlySpan<char> buffer)
    {
        for (int i = 0; i < buffer.Length; i++)
        {
            Write(buffer[i]);
        }
    }

    public virtual void Write(bool value)
    {
        Write(value ? "True" : "False");
    }

    public virtual void Write(int value)
    {
        Write(value.ToString());
    }

    public virtual void Write(uint value)
    {
        Write(value.ToString());
    }

    public virtual void Write(long value)
    {
        Write(String.FromInt(value));
    }

    /// A ulong is not a long: above long.MaxValue the signed formatter reads
    /// the top bit as a sign and answers a negative number.
    public virtual void Write(ulong value)
    {
        Write(String.FromUInt(value));
    }

    public virtual void Write(float value)
    {
        Write(value.ToString());
    }

    public virtual void Write(double value)
    {
        Write(value.ToString());
    }

    public virtual void Write(string? value)
    {
        if (value == null) return;
        for (int i = 0; i < value.Length; i++)
        {
            Write(value[i]);
        }
    }

    /// What it says of itself -- by its format provider when it takes one --
    /// and nothing at all for null.
    public virtual void Write(object? value)
    {
        if (value == null) return;
        if (value is IFormattable formattable)
        {
            Write(formattable.ToString(null, FormatProvider));
            return;
        }
        Write("" + value);
    }

    public virtual void Write(StringBuilder? value)
    {
        if (value != null) Write(value.ToString());
    }

    public virtual void Write(string format, object? arg0)
    {
        Write(String.Format(FormatProvider, format, arg0));
    }

    public virtual void Write(string format, object? arg0, object? arg1)
    {
        Write(String.Format(FormatProvider, format, arg0, arg1));
    }

    public virtual void Write(string format, object? arg0, object? arg1, object? arg2)
    {
        Write(String.Format(FormatProvider, format, arg0, arg1, arg2));
    }

    public virtual void Write(string format, params object?[] arg)
    {
        Write(String.Format(FormatProvider, format, arg));
    }

    public virtual void WriteLine()
    {
        Write(NewLine);
    }

    public virtual void WriteLine(char value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(char[]? buffer)
    {
        Write(buffer);
        WriteLine();
    }

    public virtual void WriteLine(char[] buffer, int index, int count)
    {
        Write(buffer, index, count);
        WriteLine();
    }

    public virtual void WriteLine(ReadOnlySpan<char> buffer)
    {
        Write(buffer);
        WriteLine();
    }

    public virtual void WriteLine(bool value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(int value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(uint value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(long value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(ulong value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(float value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(double value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(string? value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(object? value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(StringBuilder? value)
    {
        Write(value);
        WriteLine();
    }

    public virtual void WriteLine(string format, object? arg0)
    {
        WriteLine(String.Format(FormatProvider, format, arg0));
    }

    public virtual void WriteLine(string format, object? arg0, object? arg1)
    {
        WriteLine(String.Format(FormatProvider, format, arg0, arg1));
    }

    public virtual void WriteLine(string format, object? arg0, object? arg1, object? arg2)
    {
        WriteLine(String.Format(FormatProvider, format, arg0, arg1, arg2));
    }

    public virtual void WriteLine(string format, params object?[] arg)
    {
        WriteLine(String.Format(FormatProvider, format, arg));
    }

    public virtual void Flush()
    {
    }

    public virtual void Dispose()
    {
        Flush();
    }
}

/// TextWriter.Null: every write kept nowhere.
sealed class NullTextWriter : TextWriter
{
    public override void Write(char value) { }
    public override void Write(string? value) { }
    public override void Write(char[] buffer, int index, int count) { }
}

abstract class TextReader : IDisposable
{
    public virtual void Close()
    {
        Dispose();
    }

    public abstract int Read();

    public virtual int Peek()
    {
        return -1;
    }

    /// A line without its end, or null at the end of the text. A line ends at
    /// "\n", "\r" or "\r\n", each once, as .NET's ReadLine has it.
    public virtual string? ReadLine()
    {
        int c = Read();
        if (c < 0)
        {
            return null;
        }
        StringBuilder line = new StringBuilder();
        while (c >= 0 && c != 10 && c != 13)
        {
            line.Append((char)c);
            c = Read();
        }
        if (c == 13 && Peek() == 10)
        {
            Read();
        }
        return line.ToString();
    }

    public virtual Task<string> ReadToEndAsync() => ReadToEndAsync(CancellationToken.None);

    /// The rest of the text, read on a worker so the caller can wait on
    /// something else meanwhile (a child's other pipe).
    public virtual Task<string> ReadToEndAsync(CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        return Task.FromResult(ReadToEnd());
    }

    public virtual string ReadToEnd()
    {
        StringBuilder all = new StringBuilder();
        int c = Read();
        while (c >= 0)
        {
            all.Append((char)c);
            c = Read();
        }
        return all.ToString();
    }

    public virtual void Dispose()
    {
    }
}

/// .NET's StreamWriter: text into a stream in an encoding -- UTF-8 without a
/// byte-order mark unless told otherwise, which is .NET's default.
///
/// The characters are gathered and encoded a block at a time. A high surrogate
/// at the end of a block waits for the low one that follows it, so a pair split
/// across two writes is still one character in the bytes.
class StreamWriter : TextWriter
{
    const int DefaultBufferSize = 1024;

    Stream _stream;
    Encoding _encoding;
    char[] _chars;
    int _used;
    bool _leaveOpen;
    bool _preambleDone;
    bool _disposed;
    bool _autoFlush;

    /// Whether every write is flushed to the stream when it returns, as .NET's
    /// is; turning it on flushes what is already gathered.
    public virtual bool AutoFlush
    {
        get { return _autoFlush; }
        set
        {
            _autoFlush = value;
            if (value)
            {
                Flush();
            }
        }
    }

    public StreamWriter(Stream stream) : this(stream, new UTF8Encoding(false), DefaultBufferSize, false) { }
    public StreamWriter(Stream stream, Encoding encoding) : this(stream, encoding, DefaultBufferSize, false) { }
    public StreamWriter(Stream stream, Encoding encoding, int bufferSize) : this(stream, encoding, bufferSize, false) { }

    public StreamWriter(Stream stream, Encoding? encoding, int bufferSize, bool leaveOpen)
    {
        if (stream == null) throw new ArgumentNullException("stream");
        if (bufferSize == -1) bufferSize = DefaultBufferSize;
        if (bufferSize <= 0) throw new ArgumentOutOfRangeException("bufferSize", "Positive number required.");
        _stream = stream;
        _encoding = encoding ?? new UTF8Encoding(false);
        _chars = new char[bufferSize];
        _leaveOpen = leaveOpen;
        // A stream written from part way through already has its beginning:
        // the byte-order mark belongs at the start of a file, not in the middle.
        _preambleDone = stream.CanSeek && stream.Position > 0;
    }

    public StreamWriter(string path) : this(path, false) { }

    public StreamWriter(string path, bool append) : this(path, append, new UTF8Encoding(false), DefaultBufferSize) { }

    public StreamWriter(string path, bool append, Encoding encoding) : this(path, append, encoding, DefaultBufferSize) { }

    public StreamWriter(string path, bool append, Encoding encoding, int bufferSize)
        : this(new FileStream(path, append ? FileMode.Append : FileMode.Create, FileAccess.Write), encoding, bufferSize, false)
    {
    }

    public Stream BaseStream
    {
        get { return _stream; }
    }

    public override Encoding Encoding => _encoding;

    public override void Write(char value)
    {
        if (_used == _chars.Length)
        {
            Drain(false);
        }
        _chars[_used] = value;
        _used = _used + 1;
        if (_autoFlush)
        {
            Flush();
        }
    }

    /// One gathering and at most one flush per call, however many characters.
    public override void Write(char[] buffer, int index, int count)
    {
        if (buffer == null) throw new ArgumentNullException("buffer", "Buffer cannot be null.");
        if (index < 0) throw new ArgumentOutOfRangeException("index", "Non-negative number required.");
        if (count < 0) throw new ArgumentOutOfRangeException("count", "Non-negative number required.");
        if (buffer.Length - index < count) throw new ArgumentException("Offset and length were out of bounds for the array or count is greater than the number of elements from index to the end of the source collection.");
        for (int i = 0; i < count; i++)
        {
            Gather(buffer[index + i]);
        }
        if (_autoFlush)
        {
            Flush();
        }
    }

    public override void Write(ReadOnlySpan<char> buffer)
    {
        for (int i = 0; i < buffer.Length; i++)
        {
            Gather(buffer[i]);
        }
        if (_autoFlush)
        {
            Flush();
        }
    }

    public override void WriteLine(string? value)
    {
        if (value != null)
        {
            for (int i = 0; i < value.Length; i++)
            {
                Gather(value[i]);
            }
        }
        string end = NewLine;
        for (int i = 0; i < end.Length; i++)
        {
            Gather(end[i]);
        }
        if (_autoFlush)
        {
            Flush();
        }
    }

    void Gather(char value)
    {
        if (_used == _chars.Length)
        {
            Drain(false);
        }
        _chars[_used] = value;
        _used = _used + 1;
    }

    public override void Write(string? value)
    {
        if (value == null) return;
        for (int i = 0; i < value.Length; i++)
        {
            if (_used == _chars.Length)
            {
                Drain(false);
            }
            _chars[_used] = value[i];
            _used = _used + 1;
        }
        if (_autoFlush)
        {
            Flush();
        }
    }

    /// The gathered characters encoded into the stream -- all of them when
    /// `final`, else all but a trailing high surrogate, which waits for its
    /// pair.
    void Drain(bool final)
    {
        if (!_preambleDone)
        {
            _preambleDone = true;
            byte[] preamble = _encoding.GetPreamble();
            if (preamble.Length > 0)
            {
                _stream.Write(preamble, 0, preamble.Length);
            }
        }

        int count = _used;
        if (!final && count > 0 && Char.IsHighSurrogate(_chars[count - 1]))
        {
            count = count - 1;
        }
        if (count > 0)
        {
            byte[] bytes = _encoding.GetBytes(_chars, 0, count);
            _stream.Write(bytes, 0, bytes.Length);
        }
        for (int i = count; i < _used; i++)
        {
            _chars[i - count] = _chars[i];
        }
        _used = _used - count;
    }

    /// Everything written so far into the stream, and the stream flushed. A
    /// high surrogate at the very end still waits: Flush is not the end of the
    /// text, and .NET's encoder keeps it too.
    public override void Flush()
    {
        Drain(false);
        _stream.Flush();
    }

    public override void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Drain(true);
        _stream.Flush();
        if (!_leaveOpen)
        {
            _stream.Dispose();
        }
    }
}

/// .NET's StreamReader: text out of a stream in an encoding -- UTF-8 unless
/// told otherwise -- and, unless told not to, a byte-order mark at the start
/// deciding the encoding instead (UTF-8, UTF-16 either way round, UTF-32
/// either way round), as .NET's detectEncodingFromByteOrderMarks does.
///
/// Bytes are decoded a buffer at a time, and a sequence cut off by the end of
/// one buffer waits for the rest of it in the next.
class StreamReader : TextReader
{
    const int DefaultBufferSize = 1024;

    Stream _stream;
    Encoding _encoding;
    bool _detect;
    bool _started;
    bool _leaveOpen;
    byte[] _bytes;
    int _byteCount;              // bytes read and not yet decoded
    string _chars;               // decoded and not yet handed out
    int _at;
    bool _ended;

    public StreamReader(Stream stream) : this(stream, new UTF8Encoding(true), true, DefaultBufferSize, false) { }
    public StreamReader(Stream stream, bool detectEncodingFromByteOrderMarks) : this(stream, new UTF8Encoding(true), detectEncodingFromByteOrderMarks, DefaultBufferSize, false) { }
    public StreamReader(Stream stream, Encoding encoding) : this(stream, encoding, true, DefaultBufferSize, false) { }
    public StreamReader(Stream stream, Encoding encoding, bool detectEncodingFromByteOrderMarks) : this(stream, encoding, detectEncodingFromByteOrderMarks, DefaultBufferSize, false) { }
    public StreamReader(Stream stream, Encoding encoding, bool detectEncodingFromByteOrderMarks, int bufferSize) : this(stream, encoding, detectEncodingFromByteOrderMarks, bufferSize, false) { }

    public StreamReader(Stream stream, Encoding? encoding, bool detectEncodingFromByteOrderMarks, int bufferSize, bool leaveOpen)
    {
        if (stream == null) throw new ArgumentNullException("stream");
        if (bufferSize == -1) bufferSize = DefaultBufferSize;
        if (bufferSize <= 0) throw new ArgumentOutOfRangeException("bufferSize", "Positive number required.");
        _stream = stream;
        _encoding = encoding ?? new UTF8Encoding(true);
        _detect = detectEncodingFromByteOrderMarks;
        _leaveOpen = leaveOpen;
        _bytes = new byte[Math.Max(bufferSize, 4)];
        _chars = "";
    }

    public StreamReader(string path) : this(path, true) { }
    public StreamReader(string path, bool detectEncodingFromByteOrderMarks) : this(path, new UTF8Encoding(true), detectEncodingFromByteOrderMarks) { }
    public StreamReader(string path, Encoding encoding) : this(path, encoding, true) { }
    public StreamReader(string path, Encoding encoding, bool detectEncodingFromByteOrderMarks)
        : this(new FileStream(path, FileMode.Open, FileAccess.Read), encoding, detectEncodingFromByteOrderMarks, DefaultBufferSize, false)
    {
    }

    public Stream BaseStream
    {
        get { return _stream; }
    }

    /// The encoding being read -- the one a byte-order mark named, once the
    /// first read has seen it.
    public Encoding CurrentEncoding => _encoding;

    /// Throws away what was read ahead, for a caller that moved the stream.
    public void DiscardBufferedData()
    {
        _byteCount = 0;
        _chars = "";
        _at = 0;
        _ended = false;
    }

    /// More characters decoded, answering whether there are any.
    bool Fill()
    {
        while (_at >= _chars.Length)
        {
            if (_ended)
            {
                return false;
            }

            int n = _stream.Read(_bytes, _byteCount, _bytes.Length - _byteCount);
            if (n <= 0)
            {
                _ended = true;
                // A stream that ended while it could still have been a mark
                // has its mark read now -- an empty UTF-16 file is its mark.
                int lead = 0;
                if (!_started)
                {
                    _started = true;
                    lead = Preamble();
                }
                // What is left at the end is decoded as it is: a sequence
                // the stream cut short becomes U+FFFD, as .NET's does.
                _chars = _byteCount > lead ? _encoding.GetString(_bytes, lead, _byteCount - lead) : "";
                _byteCount = 0;
                _at = 0;
                continue;
            }
            _byteCount = _byteCount + n;

            int skip = 0;
            if (!_started)
            {
                // Bytes that could still be the start of a byte-order mark wait
                // for the rest of it -- and nothing else waits: an interactive
                // pipe's first line must not sit unread for want of four bytes.
                if (MarkPrefix())
                {
                    continue;
                }
                _started = true;
                skip = Preamble();
            }

            int whole = Complete(skip, _byteCount);
            _chars = _encoding.GetString(_bytes, skip, whole - skip);
            _at = 0;
            for (int i = whole; i < _byteCount; i++)
            {
                _bytes[i - whole] = _bytes[i];
            }
            _byteCount = _byteCount - whole;
        }
        return true;
    }

    /// Whether the bytes so far are a proper beginning of some byte-order
    /// mark this reader would act on, so that one more read could complete it.
    bool MarkPrefix()
    {
        if (_byteCount >= 4) return false;
        return (_detect && (Starts(new byte[] { 0xFF, 0xFE, 0, 0 }) || Starts(new byte[] { 0, 0, 0xFE, 0xFF })
                         || Starts(new byte[] { 0xEF, 0xBB, 0xBF }) || Starts(new byte[] { 0xFE, 0xFF })))
            || Starts(_encoding.GetPreamble());
    }

    /// Whether the bytes so far are a proper prefix of `mark`.
    bool Starts(byte[] mark)
    {
        if (mark.Length == 0 || _byteCount >= mark.Length) return false;
        for (int i = 0; i < _byteCount; i++)
        {
            if (_bytes[i] != mark[i]) return false;
        }
        return true;
    }

    /// The byte-order mark at the start, if there is one: the encoding it
    /// names when detecting, and how many bytes it is.
    int Preamble()
    {
        int b0 = _byteCount > 0 ? _bytes[0] : -1;
        int b1 = _byteCount > 1 ? _bytes[1] : -1;
        int b2 = _byteCount > 2 ? _bytes[2] : -1;
        int b3 = _byteCount > 3 ? _bytes[3] : -1;

        if (_detect)
        {
            if (b0 == 0xFF && b1 == 0xFE && b2 == 0 && b3 == 0) { _encoding = new UTF32Encoding(false, true); return 4; }
            if (b0 == 0 && b1 == 0 && b2 == 0xFE && b3 == 0xFF) { _encoding = new UTF32Encoding(true, true); return 4; }
            if (b0 == 0xEF && b1 == 0xBB && b2 == 0xBF) { _encoding = new UTF8Encoding(true); return 3; }
            if (b0 == 0xFF && b1 == 0xFE) { _encoding = new UnicodeEncoding(false, true); return 2; }
            if (b0 == 0xFE && b1 == 0xFF) { _encoding = new UnicodeEncoding(true, true); return 2; }
        }

        // THE ENCODING'S OWN MARK is skipped even when not detecting.
        byte[] own = _encoding.GetPreamble();
        if (own.Length == 0 || own.Length > _byteCount) return 0;
        for (int i = 0; i < own.Length; i++)
        {
            if (_bytes[i] != own[i]) return 0;
        }
        return own.Length;
    }

    /// Where the last whole character in bytes[from, end) ends: a sequence
    /// the buffer cut off is left for the next read.
    int Complete(int from, int end)
    {
        if (_encoding is UTF32Encoding)
        {
            return end - (end - from) % 4;
        }
        if (_encoding is UnicodeEncoding)
        {
            int even = end - (end - from) % 2;
            // A high surrogate at the end waits for its low half.
            if (even - from >= 2)
            {
                bool big = _encoding.CodePage == 1201;
                int unit = big ? (_bytes[even - 2] << 8) | _bytes[even - 1] : (_bytes[even - 1] << 8) | _bytes[even - 2];
                if (unit >= 0xD800 && unit <= 0xDBFF) return even - 2;
            }
            return even;
        }
        if (_encoding is UTF8Encoding)
        {
            // Back from the end to the last lead byte; if the sequence it
            // begins is longer than what follows it, it waits.
            for (int back = 1; back <= 3 && end - back >= from; back++)
            {
                int b = _bytes[end - back];
                if (b < 0x80) return end;
                if (b >= 0xC0)
                {
                    int length = b >= 0xF0 ? 4 : b >= 0xE0 ? 3 : 2;
                    return length > back ? end - back : end;
                }
            }
            return end;
        }
        return end;
    }

    public override int Read()
    {
        if (!Fill())
        {
            return -1;
        }
        int c = _chars[_at];
        _at = _at + 1;
        return c;
    }

    public override int Peek()
    {
        return Fill() ? _chars[_at] : -1;
    }

    public override string? ReadLine()
    {
        if (!Fill())
        {
            return null;
        }
        StringBuilder line = new StringBuilder();
        while (Fill())
        {
            char c = _chars[_at];
            _at = _at + 1;
            if (c == '\n')
            {
                return line.ToString();
            }
            if (c == '\r')
            {
                if (Fill() && _chars[_at] == '\n')
                {
                    _at = _at + 1;
                }
                return line.ToString();
            }
            line.Append(c);
        }
        return line.ToString();
    }

    public override string ReadToEnd()
    {
        // A FILE READ WHOLE IS DECODED WHOLE: what is left of it read into
        // one array its size and made a string in one decoding, rather than
        // a string per buffer copied into a builder that doubles -- three
        // copies of every source file a compiler reads. The byte-order mark
        // is taken as Fill takes it; a stream that is not a file, or a
        // reader part way through a buffer, goes the ordinary way.
        string? whole = null;
        if (_at >= _chars.Length && _byteCount == 0 && !_ended && _stream is FileStream file && file.CanSeek)
        {
            long left = file.Length - file.Position;
            if (left > 0 && left < 0x40000000)
            {
                byte[] kept = _bytes;
                byte[] read = new byte[(int)left];
                int got = 0;
                while (got < read.Length)
                {
                    int n = _stream.Read(read, got, read.Length - got);
                    if (n <= 0) break;
                    got = got + n;
                }
                _bytes = read;
                _byteCount = got;
                int skip = 0;
                if (!_started)
                {
                    _started = true;
                    skip = Preamble();
                }
                whole = got > skip ? _encoding.GetString(read, skip, got - skip) : "";
                _bytes = kept;
                _byteCount = 0;
            }
        }
        if (whole != null && !Fill()) return whole;
        StringBuilder all = whole != null ? new StringBuilder(whole) : new StringBuilder();
        while (Fill())
        {
            all.Append(_chars, _at, _chars.Length - _at);
            _at = _chars.Length;
        }
        return all.ToString();
    }

    public bool EndOfStream
    {
        get { return !Fill(); }
    }

    public override void Dispose()
    {
        if (!_leaveOpen)
        {
            _stream.Dispose();
        }
    }
}

/// Whether a search looks in the directory alone or in every one below it.
enum SearchOption
{
    TopDirectoryOnly = 0,
    AllDirectories = 1,
}

/// .NET's Directory, the parts a program reaches for first.
/// System.IO.Enumeration.FileSystemName -- .NET's own matcher for the search
/// pattern GetFiles and GetDirectories take. `*` stands for any run of
/// characters, `?` for exactly one, and everything else for itself.
static class FileSystemName
{
    public static bool MatchesSimpleExpression(string expression, string name)
    {
        return Matches(expression, 0, name, 0);
    }

    private static bool Matches(string pattern, int p, string name, int n)
    {
        while (p < pattern.Length)
        {
            char c = pattern[p];

            if (c == '*')
            {
                // The shortest match first, then longer ones: `*` may stand
                // for nothing at all.
                for (int at = n; at <= name.Length; at++)
                {
                    if (Matches(pattern, p + 1, name, at)) { return true; }
                }
                return false;
            }

            if (n >= name.Length) { return false; }
            if (c != '?' && c != name[n]) { return false; }

            p = p + 1;
            n = n + 1;
        }

        return n == name.Length;
    }
}


partial static class Directory
{
    public static bool Exists(string path)
    {
        long mode = Os.ModeOf(path);
        return mode >= 0 && (mode & 0xF000) == 0x4000;
    }

    /// EVERY MISSING COMPONENT, which is what .NET's own CreateDirectory
    /// does and what a caller writing Combine(a, b, c) expects: a path whose
    /// parent does not exist yet is created, not refused.
    public static DirectoryInfo CreateDirectory(string path)
    {
        if (path == null)
        {
            throw new ArgumentNullException(nameof(path));
        }
        if (path.Length == 0)
        {
            throw new ArgumentException("The path is empty.", nameof(path));
        }
        Make(path);
        return new DirectoryInfo(path);
    }

    static void Make(string path)
    {
        if (path.Length == 0 || Exists(path))
        {
            return;
        }
        string? parent = Path.GetDirectoryName(path);
        if (parent != null && parent.Length != 0 && parent != path && !Exists(parent))
        {
            Make(parent);
        }
        int r = Os.Mkdir(path, 511);
        if (r < 0 && r != -Err.Exist)
        {
            throw Interop.GetExceptionForIoErrno(r, path, true);
        }
    }

    /// THE ONES WHOSE NAME MATCHES, which is .NET's second parameter: `*` for
    /// any run of characters and `?` for one, matched against the name alone.
    public static string[] GetFiles(string path, string searchPattern)
    {
        List<string> kept = new List<string>();

        foreach (string full in GetFiles(path))
        {
            if (FileSystemName.MatchesSimpleExpression(searchPattern, Path.GetFileName(full)))
            {
                kept.Add(full);
            }
        }
        return kept.ToArray();
    }

    /// With AllDirectories, every directory below as well: a directory
    /// reached through a symbolic link is not entered, as .NET does not, so a
    /// link back up the tree cannot make the walk endless.
    public static string[] GetFiles(string path, string searchPattern, SearchOption searchOption)
    {
        if (searchOption == SearchOption.TopDirectoryOnly) return GetFiles(path, searchPattern);
        if (searchOption != SearchOption.AllDirectories) throw new ArgumentOutOfRangeException("searchOption");
        List<string> kept = new List<string>();
        Queue<string> pending = new Queue<string>();
        pending.Enqueue(path);
        while (pending.Count > 0)
        {
            string directory = pending.Dequeue();
            foreach (string file in GetFiles(directory, searchPattern)) kept.Add(file);
            foreach (string below in GetDirectories(directory))
            {
                if (FileSystem.IsDirectoryNoFollow(below)) pending.Enqueue(below);
            }
        }
        return kept.ToArray();
    }

    public static string[] GetDirectories(string path, string searchPattern, SearchOption searchOption)
    {
        if (searchOption == SearchOption.TopDirectoryOnly) return GetDirectories(path, searchPattern);
        if (searchOption != SearchOption.AllDirectories) throw new ArgumentOutOfRangeException("searchOption");
        List<string> kept = new List<string>();
        Queue<string> pending = new Queue<string>();
        pending.Enqueue(path);
        while (pending.Count > 0)
        {
            foreach (string below in GetDirectories(pending.Dequeue()))
            {
                if (FileSystemName.MatchesSimpleExpression(searchPattern, Path.GetFileName(below))) kept.Add(below);
                if (FileSystem.IsDirectoryNoFollow(below)) pending.Enqueue(below);
            }
        }
        return kept.ToArray();
    }

    public static IEnumerable<string> EnumerateFiles(string path, string searchPattern) => GetFiles(path, searchPattern);

    public static IEnumerable<string> EnumerateFiles(string path, string searchPattern, SearchOption searchOption)
        => GetFiles(path, searchPattern, searchOption);

    public static IEnumerable<string> EnumerateDirectories(string path, string searchPattern) => GetDirectories(path, searchPattern);

    public static IEnumerable<string> EnumerateDirectories(string path, string searchPattern, SearchOption searchOption)
        => GetDirectories(path, searchPattern, searchOption);

    public static string[] GetDirectories(string path, string searchPattern)
    {
        List<string> kept = new List<string>();

        foreach (string full in GetDirectories(path))
        {
            if (FileSystemName.MatchesSimpleExpression(searchPattern, Path.GetFileName(full)))
            {
                kept.Add(full);
            }
        }
        return kept.ToArray();
    }

    public static string[] GetFiles(string path)
    {
        string[]? names = Os.ListDir(path);
        if (names == null)
        {
            throw Interop.GetExceptionForIoErrno((int)Os.ModeOf(path) < 0 ? 2 : 13, path, true);
        }
        List<string> files = new List<string>();
        for (int i = 0; i < names.Length; i++)
        {
            string full = Path.Combine(path, names[i]);
            long mode = Os.ModeOf(full);
            if (mode >= 0 && (mode & 0xF000) == 0x8000)
            {
                files.Add(full);
            }
        }
        return files.ToArray();
    }

    public static string GetCurrentDirectory()
    {
        string? cwd = Os.Getcwd();
        return cwd == null ? "/" : cwd;
    }
}

/// THE REST OF System.IO.Path: the part that needs a filing system.
///
/// Combine and GetDirectoryName are string work and live in the standard
/// library with the rest of Path, where a freestanding image can have them.
/// GetFullPath cannot: it asks where the program is, and a machine with no
/// operating system has no answer.
static partial class Path
{
    /// Where temporary files go, as .NET answers on Unix: $TMPDIR when it is
    /// set and not empty, else /tmp/ -- always ending in the separator.
    /// Eight random letters and digits, a dot, and three more: a name that
    /// is not a file anywhere yet, as .NET's is.
    public static string GetRandomFileName()
    {
        const string alphabet = "abcdefghijklmnopqrstuvwxyz012345";
        byte[] bits = new byte[11];
        TempNames.Fill(bits);
        char[] name = new char[12];
        int at = 0;
        for (int i = 0; i < 12; i++)
        {
            if (i == 8)
            {
                name[i] = '.';
                continue;
            }
            name[i] = alphabet[bits[at++] & 31];
        }
        return new string(name);
    }

    public static string GetTempPath()
    {
        string? dir = Environment.GetEnvironmentVariable("TMPDIR");
        if (dir == null || dir.Length == 0) return "/tmp/";
        return dir.EndsWith("/") ? dir : dir + "/";
    }

    private static int _tempSerial;

    /// A new empty file under GetTempPath, made here and never one that
    /// already existed (O_EXCL), its full path returned.
    public static string GetTempFileName()
    {
        string directory = GetTempPath();
        for (int attempt = 0; attempt < 1000; attempt++)
        {
            // From what every build of this file has -- the Linux ABI's own
            // calls and the Sys intrinsics -- not Interlocked or Environment's
            // clock and process id: a ring-1 kernel compiles System.IO over
            // its own small Environment, and has neither.
            long serial = Sys.AtomicAdd(Sys.AddressOf(ref _tempSerial), 1) + 1;
            long pid = Sys.Syscall(Call.Getpid, 0, 0, 0);
            long mix = (Os.Micros() * 31 + pid) * 1000003 + serial * 7919 + attempt;
            string name = "tmp" + ((mix & 0x7FFFFFFFFFFF) % 0xFFFFFF).ToString("X6") + ".tmp";
            string full = directory + name;
            try
            {
                using (FileStream made = new FileStream(full, FileMode.CreateNew, FileAccess.ReadWrite)) { }
                return full;
            }
            catch (IOException) when (File.Exists(full))
            {
            }
        }
        throw new IOException("The file name could not be created in " + directory);
    }

    /// The path from one to the other: `..` for each directory of
    /// relativeTo that path is not under, then the rest of path. "." when
    /// they are the same. Compared exactly, as a Unix file system does.
    public static string GetRelativePath(string relativeTo, string path)
    {
        ArgumentNullException.ThrowIfNull(relativeTo);
        ArgumentNullException.ThrowIfNull(path);
        if (relativeTo.Length == 0) throw new ArgumentException("The value cannot be an empty string.", "relativeTo");
        if (path.Length == 0) throw new ArgumentException("The value cannot be an empty string.", "path");
        string[] from = GetFullPath(relativeTo).Split('/', StringSplitOptions.RemoveEmptyEntries);
        string[] to = GetFullPath(path).Split('/', StringSplitOptions.RemoveEmptyEntries);
        int common = 0;
        while (common < from.Length && common < to.Length && from[common] == to[common]) common++;
        List<string> parts = new List<string>();
        for (int i = common; i < from.Length; i++) parts.Add("..");
        for (int i = common; i < to.Length; i++) parts.Add(to[i]);
        return parts.Count == 0 ? "." : string.Join("/", parts);
    }

    /// The absolute path this one names, with `.` and `..` resolved. .NET
    /// promises nothing about the file existing; this is a question about the
    /// TEXT, answered against the current directory.
    public static string GetFullPath(string path)
    {
        if (path == null) { throw new ArgumentNullException("path"); }
        if (path.Length == 0) { throw new ArgumentException("The path is empty.", "path"); }

        return Normalise(IsPathRooted(path) ? path : Combine(WorkingDirectory(), path));
    }

    /// The same, against a base path of the caller's choosing rather than the
    /// current directory.
    public static string GetFullPath(string path, string basePath)
    {
        if (path == null) { throw new ArgumentNullException("path"); }
        if (basePath == null) { throw new ArgumentNullException("basePath"); }
        if (!IsPathRooted(basePath))
        {
            throw new ArgumentException("The base path must be absolute.", "basePath");
        }

        return Normalise(IsPathRooted(path) ? path : Combine(basePath, path));
    }

    /// getcwd(2), asked directly rather than through Directory: this file sits
    /// below the one that has Directory in the library the machine links, and a
    /// path is string work that must not need a filing-system class above it.
    private static string WorkingDirectory()
    {
        string? cwd = Os.Getcwd();

        return cwd == null ? "/" : cwd;
    }

    /// `.` removed, `..` applied, and runs of separators collapsed. A `..`
    /// above the root stays at the root, which is what the kernel does with
    /// the same path.
    private static string Normalise(string path)
    {
        List<string> parts = new List<string>();
        int at = 0;

        while (at < path.Length)
        {
            int end = at;

            while (end < path.Length && path[end] != '/') { end = end + 1; }

            string part = path.Substring(at, end - at);

            at = end + 1;
            if (part.Length == 0 || part == ".") { continue; }
            if (part == "..")
            {
                if (parts.Count > 0) { parts.RemoveAt(parts.Count - 1); }
                continue;
            }
            parts.Add(part);
        }

        if (parts.Count == 0) { return "/"; }

        StringBuilder made = new StringBuilder();

        for (int i = 0; i < parts.Count; i++)
        {
            made.Append('/');
            made.Append(parts[i]);
        }
        return made.ToString();
    }
}

/// System.IO.UnixFileMode -- the permission bits, named the way .NET 7 names
/// them. A [Flags] enum whose values are the octal ones the kernel uses, so
/// that the enum and the number a chmod takes are the same bits.
[Flags]
enum UnixFileMode
{
    None = 0,
    OtherExecute = 1,
    OtherWrite = 2,
    OtherRead = 4,
    GroupExecute = 8,
    GroupWrite = 16,
    GroupRead = 32,
    UserExecute = 64,
    UserWrite = 128,
    UserRead = 256,
    StickyBit = 512,
    SetGroup = 1024,
    SetUser = 2048,
}

/// System.IO.File: whole-file reads and writes, as .NET spells them. A
/// missing file is a FileNotFoundException, not a null.
partial static class File
{
    public static bool Exists(string path)
    {
        return Os.Exists(path) && !Directory.Exists(path);
    }

    public static byte[] ReadAllBytes(string path)
    {
        FileStream f = new FileStream(path, FileMode.Open, FileAccess.Read);
        long size = f.Length;
        // A FILE THAT GIVES NO LENGTH -- everything under /proc -- is read
        // to its end, as .NET's ReadAllBytesUnknownLength reads it; taking
        // the 0 at its word gave every such file back empty. (Less than 0 is
        // a pipe or a device that would not say.)
        if (size <= 0)
        {
            byte[] grown = new byte[4096];
            int had = 0;
            while (true)
            {
                if (had == grown.Length)
                {
                    byte[] bigger = new byte[grown.Length * 2];
                    Array.Copy(grown, 0, bigger, 0, had);
                    grown = bigger;
                }
                int n = f.Read(grown, had, grown.Length - had);
                if (n <= 0) break;
                had = had + n;
            }
            f.Dispose();
            byte[] exact = new byte[had];
            Array.Copy(grown, 0, exact, 0, had);
            return exact;
        }
        byte[] all = new byte[(int)size];
        int done = 0;
        while (done < all.Length)
        {
            int n = f.Read(all, done, all.Length - done);
            if (n <= 0)
            {
                break;
            }
            done = done + n;
        }
        f.Dispose();
        if (done < all.Length)
        {
            byte[] shorter = new byte[done];
            Array.Copy(all, 0, shorter, 0, done);
            return shorter;
        }
        return all;
    }

    public static string ReadAllText(string path)
    {
        StreamReader r = new StreamReader(path);
        string all = r.ReadToEnd();
        r.Dispose();
        return all;
    }

    /// Every line, with the newlines removed; a trailing newline does not
    /// make an extra empty line.
    public static string[] ReadAllLines(string path)
    {
        StreamReader r = new StreamReader(path);
        List<string> lines = new List<string>();
        while (true)
        {
            string? line = r.ReadLine();
            if (line == null)
            {
                break;
            }
            lines.Add(line);
        }
        r.Dispose();
        return lines.ToArray();
    }

    /// The lines of a file, read as they are enumerated. The file is opened
    /// here, so a missing one throws now; each further enumeration opens it
    /// again, as .NET's does.
    public static IEnumerable<string> ReadLines(string path)
    {
        if (path == null)
        {
            throw new ArgumentNullException(nameof(path));
        }
        return new FileLines(path, new StreamReader(path));
    }

    public static void WriteAllLines(string path, string[] contents)
    {
        if (contents == null)
        {
            throw new ArgumentNullException(nameof(contents));
        }
        WriteAllLines(path, (IEnumerable<string>)contents);
    }

    /// Each line followed by a newline, the file replaced.
    public static void WriteAllLines(string path, IEnumerable<string> contents)
    {
        if (path == null)
        {
            throw new ArgumentNullException(nameof(path));
        }
        if (contents == null)
        {
            throw new ArgumentNullException(nameof(contents));
        }
        using StreamWriter writer = new StreamWriter(path, false);
        foreach (string line in contents)
        {
            writer.WriteLine(line);
        }
    }

    public static void AppendAllLines(string path, IEnumerable<string> contents)
    {
        if (path == null)
        {
            throw new ArgumentNullException(nameof(path));
        }
        if (contents == null)
        {
            throw new ArgumentNullException(nameof(contents));
        }
        using StreamWriter writer = new StreamWriter(path, true);
        foreach (string line in contents)
        {
            writer.WriteLine(line);
        }
    }

    public static void WriteAllBytes(string path, byte[] bytes)
    {
        FileStream f = new FileStream(path, FileMode.Create, FileAccess.Write);
        f.Write(bytes, 0, bytes.Length);
        f.Dispose();
    }

    public static void WriteAllText(string path, string text)
    {
        StreamWriter w = new StreamWriter(path, false);
        w.Write(text);
        w.Dispose();
    }

    public static void AppendAllText(string path, string text)
    {
        StreamWriter w = new StreamWriter(path, true);
        w.Write(text);
        w.Dispose();
    }

    public static void Delete(string path)
    {
        int r = Os.Unlink(path);
        if (r < 0 && r != -Err.NoEnt)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    /// Moves a file, and throws IOException if `to` already exists, as
    /// .NET's does: rename(2) alone would replace it.
    public static void Move(string from, string to)
    {
        Move(from, to, false);
    }

    /// Moves a file, replacing `to` if `overwrite` says so: rename(2), which
    /// replaces it in one step, so a reader sees the old file or the new
    /// one and never neither.
    public static void Move(string from, string to, bool overwrite)
    {
        if (!Exists(from)) throw new FileNotFoundException("could not find file '" + from + "'", from);
        if (!overwrite && Os.Exists(to)) throw new IOException("the file '" + to + "' already exists");
        int r = Os.Rename(from, to);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, from);
        }
    }

    public static void SetUnixFileMode(string path, UnixFileMode mode)
    {
        int r = Os.Chmod(path, (int)mode);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    /// The permission bits, as .NET's UnixFileMode has them.
    public static UnixFileMode GetUnixFileMode(string path)
    {
        long mode = Os.ModeOf(path);
        if (mode < 0)
        {
            throw Interop.GetExceptionForIoErrno((int)mode, path);
        }
        return (UnixFileMode)(int)(mode & 0xFFF);
    }
}

// ---- the file system as objects: FileSystemInfo, FileInfo, DirectoryInfo ---

enum FileAttributes
{
    ReadOnly = 1,
    Hidden = 2,
    System = 4,
    Directory = 16,
    Archive = 32,
    Device = 64,
    Normal = 128,
    ReparsePoint = 1024
}

/// THE SAME CLOCK, through DateTimeOffset. It is here and not in lib/std.cor
/// beside the rest of the type for the reason DateTime's UtcNow is here:
/// reading a clock is a call on the platform, and a freestanding build has
/// no platform to call. This machine keeps no zone, so the local reading and
/// the UTC one differ by the offset TimeZoneInfo.Local has at that moment.
partial struct DateTimeOffset
{
    public static DateTimeOffset UtcNow => new DateTimeOffset(DateTime.UtcNow, TimeSpan.Zero);

    public static DateTimeOffset Now
    {
        get
        {
            DateTime utc = DateTime.UtcNow;
            TimeSpan offset = TimeZoneInfo.Local.GetUtcOffset(utc);
            return new DateTimeOffset(utc.Ticks + offset.Ticks, offset);
        }
    }

    /// The same moment, read in the machine's zone.
    public DateTime LocalDateTime => TimeZoneInfo.ConvertTimeFromUtc(UtcDateTime, TimeZoneInfo.Local);

    public DateTimeOffset ToLocalTime() { return TimeZoneInfo.ConvertTime(this, TimeZoneInfo.Local); }
}

/// What .NET calls a moment on this platform's clock: the wall clock, as
/// gettimeofday reports it, and the monotonic clock for Environment.
partial struct DateTime
{
    public static DateTime UtcNow
    {
        get { return new DateTime(UnixEpoch.Ticks + Os.Micros() * 10, DateTimeKind.Utc); }
    }

    /// The time in TimeZoneInfo.Local: TZ, else /etc/localtime, else UTC.
    public static DateTime Now
    {
        get { return TimeZoneInfo.ConvertTimeFromUtc(UtcNow, TimeZoneInfo.Local); }
    }

    public static DateTime Today
    {
        get { return Now.Date; }
    }

    /// UTC as local time; a local time left alone. Unspecified is taken as
    /// UTC, as .NET takes it.
    public DateTime ToLocalTime()
    {
        if (Kind == DateTimeKind.Local) return this;
        return TimeZoneInfo.ConvertTimeFromUtc(SpecifyKind(this, DateTimeKind.Utc), TimeZoneInfo.Local);
    }

    /// Local time as UTC; UTC left alone. Unspecified is taken as local.
    public DateTime ToUniversalTime()
    {
        if (Kind == DateTimeKind.Utc) return this;
        return TimeZoneInfo.ConvertTimeToUtc(SpecifyKind(this, DateTimeKind.Local));
    }

    public static DateTime FromUnixTimeSeconds(long seconds)
    {
        return new DateTime(UnixEpoch.Ticks + seconds * 10000000, DateTimeKind.Utc);
    }

    /// The same instant with the nanoseconds stat(2) also reports, rounded to
    /// the hundred this clock counts in. WITHOUT THEM two files written in the
    /// same second are written at the same time, and `cp -u` copies nothing.
    public static DateTime FromUnixTime(long seconds, long nsec)
    {
        return new DateTime(UnixEpoch.Ticks + seconds * 10000000 + nsec / 100, DateTimeKind.Utc);
    }

}

/// A file or directory by its name, with what stat says about it, as .NET
/// has it. The extra members beyond .NET's -- OwnerId, GroupId, LinkCount,
/// Inode, IsSymbolicLink, IsDirectoryEntry -- are the few things a Unix
/// utility needs that .NET's own class leaves to P/Invoke.
abstract class FileSystemInfo
{
    protected string _path;
    protected byte[]? _stat;
    protected bool _exists;
    protected bool _fresh;

    protected FileSystemInfo(string path)
    {
        _path = path;
    }

    public void Refresh()
    {
        byte[] into = Stat.Room();
        _exists = Os.Lstat(_path, into) >= 0;
        _stat = _exists ? into : null;
        _fresh = true;
    }

    protected byte[]? Data()
    {
        if (!_fresh)
        {
            Refresh();
        }
        return _stat;
    }

    /// stat, following a link, for the members that want the target.
    protected byte[]? Target()
    {
        byte[]? own = Data();
        if (own == null || !Stat.IsLinkMode(Stat.Mode(own)))
        {
            return own;
        }
        byte[] into = Stat.Room();
        return Os.Stat(_path, into) >= 0 ? into : null;
    }

    public string FullName
    {
        get
        {
            if (_path.Length > 0 && _path[0] == '/')
            {
                return _path;
            }
            string cwd = Directory.GetCurrentDirectory();
            return _path == "." ? cwd : Path.Combine(cwd, _path);
        }
    }

    public string Name
    {
        get { return Path.GetFileName(_path); }
    }

    public string Extension
    {
        get { return Path.GetExtension(_path); }
    }

    public abstract bool Exists { get; }

    public FileAttributes Attributes
    {
        get
        {
            byte[]? d = Data();
            if (d == null)
            {
                return (FileAttributes)(-1);
            }
            long mode = Stat.Mode(d);
            int a = 0;
            if (Stat.IsDirMode(mode)) { a = a | (int)FileAttributes.Directory; }
            if (Stat.IsLinkMode(mode)) { a = a | (int)FileAttributes.ReparsePoint; }
            if (Stat.IsCharMode(mode) || Stat.IsBlockMode(mode)) { a = a | (int)FileAttributes.Device; }
            if ((mode & 0x80) == 0) { a = a | (int)FileAttributes.ReadOnly; }
            if (Name.Length > 0 && Name[0] == '.') { a = a | (int)FileAttributes.Hidden; }
            if (a == 0) { a = (int)FileAttributes.Normal; }
            return (FileAttributes)a;
        }
    }

    public UnixFileMode UnixFileMode
    {
        get
        {
            byte[]? d = Data();
            return d == null ? UnixFileMode.None : (UnixFileMode)(int)(Stat.Mode(d) & 0xFFF);
        }
        set
        {
            int r = Os.Chmod(_path, (int)value);
            if (r < 0)
            {
                throw Interop.GetExceptionForIoErrno(r, _path);
            }
            _fresh = false;
        }
    }

    public DateTime LastWriteTimeUtc
    {
        get
        {
            byte[]? d = Data();
            return d == null ? DateTime.FromUnixTimeSeconds(0) : DateTime.FromUnixTime(Stat.Mtime(d), Stat.MtimeNsec(d));
        }
        set
        {
            File.SetLastWriteTimeUtc(_path, value);
            _fresh = false;
        }
    }

    public DateTime LastWriteTime
    {
        get { return LastWriteTimeUtc.ToLocalTime(); }
        set { LastWriteTimeUtc = value.ToUniversalTime(); }
    }

    public DateTime LastAccessTimeUtc
    {
        get
        {
            byte[]? d = Data();
            return d == null ? DateTime.FromUnixTimeSeconds(0) : DateTime.FromUnixTime(Stat.Atime(d), Stat.AtimeNsec(d));
        }
        set
        {
            File.SetLastAccessTimeUtc(_path, value);
            _fresh = false;
        }
    }

    public DateTime LastAccessTime
    {
        get { return LastAccessTimeUtc.ToLocalTime(); }
        set { LastAccessTimeUtc = value.ToUniversalTime(); }
    }

    /// Unix has no creation time; .NET reports the status change time.
    public DateTime CreationTimeUtc
    {
        get
        {
            byte[]? d = Data();
            return d == null ? DateTime.FromUnixTimeSeconds(0) : DateTime.FromUnixTime(Stat.Ctime(d), Stat.CtimeNsec(d));
        }
    }

    public DateTime CreationTime
    {
        get { return CreationTimeUtc.ToLocalTime(); }
    }

    /// Where a symbolic link points, or null when this is not one.
    public string? LinkTarget
    {
        get { return Os.Readlink(_path); }
    }

    public bool IsSymbolicLink
    {
        get
        {
            byte[]? d = Data();
            return d != null && Stat.IsLinkMode(Stat.Mode(d));
        }
    }

    public long OwnerId
    {
        get { byte[]? d = Data(); return d == null ? -1 : Stat.Uid(d); }
    }

    public long GroupId
    {
        get { byte[]? d = Data(); return d == null ? -1 : Stat.Gid(d); }
    }

    public long LinkCount
    {
        get { byte[]? d = Data(); return d == null ? 0 : Stat.Links(d); }
    }

    public long Inode
    {
        get { byte[]? d = Data(); return d == null ? 0 : Stat.Ino(d); }
    }

    /// The device the entry lives on, which is how `du -x`, `rm
    /// --one-file-system` and `find -xdev` recognise a mount point.
    public long DeviceId
    {
        get { byte[]? d = Data(); return d == null ? -1 : Stat.Device(d); }
    }

    /// The device a character or block special file NAMES, as opposed to the
    /// one it lives on. `ls -l` prints its major and minor numbers where a
    /// file has a length, and nothing else on the system has them.
    public long DeviceNumber
    {
        get { byte[]? d = Data(); return d == null ? 0 : Stat.Rdev(d); }
    }

    /// The kinds Unix has that .NET's FileAttributes cannot tell apart.
    /// `ls -l` needs every one of them for the first column.
    public bool IsCharacterDevice
    {
        get { byte[]? d = Data(); return d != null && Stat.IsCharMode(Stat.Mode(d)); }
    }

    public bool IsBlockDevice
    {
        get { byte[]? d = Data(); return d != null && Stat.IsBlockMode(Stat.Mode(d)); }
    }

    public bool IsFifo
    {
        get { byte[]? d = Data(); return d != null && Stat.IsFifoMode(Stat.Mode(d)); }
    }

    public bool IsSocket
    {
        get { byte[]? d = Data(); return d != null && Stat.IsSocketMode(Stat.Mode(d)); }
    }

    /// The whole mode word, type bits and all, as stat(2) reports it for the
    /// entry itself. UnixFileMode is the permission part of this.
    public int UnixStatusMode
    {
        get { byte[]? d = Data(); return d == null ? 0 : (int)Stat.Mode(d); }
    }

    /// The size stat(2) reports for THE ENTRY ITSELF: a directory's own size
    /// and a symbolic link's target length, neither of which FileInfo.Length
    /// can answer because it follows the link.
    public long UnixLength
    {
        get { byte[]? d = Data(); return d == null ? 0 : Stat.Size(d); }
    }

    /// 512-byte blocks in use, which is what ls -s and du count.
    public long Blocks
    {
        get { byte[]? d = Data(); return d == null ? 0 : Stat.Blocks(d); }
    }

    public abstract void Delete();

    public override string ToString()
    {
        return _path;
    }
}

class FileInfo : FileSystemInfo
{
    public FileInfo(string path) : base(path)
    {
    }

    public override bool Exists
    {
        get
        {
            byte[]? d = Target();
            return d != null && !Stat.IsDirMode(Stat.Mode(d));
        }
    }

    public long Length
    {
        get
        {
            byte[]? d = Target();
            if (d == null)
            {
                throw new FileNotFoundException(_path);
            }
            return Stat.Size(d);
        }
    }

    public string? DirectoryName
    {
        get { return Path.GetDirectoryName(FullName); }
    }

    public DirectoryInfo Directory
    {
        get
        {
            string? dir = DirectoryName;
            return new DirectoryInfo(dir == null ? "/" : dir);
        }
    }

    public bool IsReadOnly
    {
        get { return (UnixFileMode & 0x80) == 0; }
    }

    public FileStream Open(FileMode mode, FileAccess access)
    {
        return new FileStream(_path, mode, access);
    }

    public FileStream OpenRead()
    {
        return new FileStream(_path, FileMode.Open, FileAccess.Read);
    }

    public FileStream OpenWrite()
    {
        return new FileStream(_path, FileMode.OpenOrCreate, FileAccess.Write);
    }

    public FileStream Create()
    {
        return new FileStream(_path, FileMode.Create, FileAccess.Write);
    }

    public StreamReader OpenText()
    {
        return new StreamReader(_path);
    }

    public StreamWriter CreateText()
    {
        return new StreamWriter(_path, false);
    }

    public StreamWriter AppendText()
    {
        return new StreamWriter(_path, true);
    }

    public FileInfo CopyTo(string destination, bool overwrite)
    {
        File.Copy(_path, destination, overwrite);
        return new FileInfo(destination);
    }

    public void MoveTo(string destination)
    {
        File.Move(_path, destination);
        _path = destination;
        _fresh = false;
    }

    public override void Delete()
    {
        File.Delete(_path);
        _fresh = false;
    }
}

class DirectoryInfo : FileSystemInfo
{
    public DirectoryInfo(string path) : base(path)
    {
    }

    public override bool Exists
    {
        get
        {
            byte[]? d = Target();
            return d != null && Stat.IsDirMode(Stat.Mode(d));
        }
    }

    public DirectoryInfo? Parent
    {
        get
        {
            string full = FullName;
            if (full == "/")
            {
                return null;
            }
            string? up = Path.GetDirectoryName(full);
            return new DirectoryInfo(up == null || up.Length == 0 ? "/" : up);
        }
    }

    public DirectoryInfo Root
    {
        get { return new DirectoryInfo("/"); }
    }

    public void Create()
    {
        Directory.CreateDirectory(_path);
        _fresh = false;
    }

    public DirectoryInfo CreateSubdirectory(string name)
    {
        string child = Path.Combine(_path, name);
        Directory.CreateDirectory(child);
        return new DirectoryInfo(child);
    }

    /// The entries by name, in directory order, "." and ".." left out.
    string[] Names()
    {
        string[]? names = Os.ListDir(_path);
        if (names == null)
        {
            throw Interop.GetExceptionForIoErrno(Os.ModeOf(_path) < 0 ? 2 : 13, _path, true);
        }
        List<string> kept = new List<string>();
        for (int i = 0; i < names.Length; i++)
        {
            if (names[i] != "." && names[i] != "..")
            {
                kept.Add(names[i]);
            }
        }
        return kept.ToArray();
    }

    public FileSystemInfo[] GetFileSystemInfos()
    {
        string[] names = Names();
        FileSystemInfo[] all = new FileSystemInfo[names.Length];
        for (int i = 0; i < names.Length; i++)
        {
            string child = Path.Combine(_path, names[i]);
            all[i] = Directory.Exists(child) && Os.Readlink(child) == null
                ? new DirectoryInfo(child)
                : new FileInfo(child);
        }
        return all;
    }

    public FileInfo[] GetFiles()
    {
        string[] names = Names();
        List<FileInfo> files = new List<FileInfo>();
        for (int i = 0; i < names.Length; i++)
        {
            string child = Path.Combine(_path, names[i]);
            if (!Directory.Exists(child))
            {
                files.Add(new FileInfo(child));
            }
        }
        return files.ToArray();
    }

    public DirectoryInfo[] GetDirectories()
    {
        string[] names = Names();
        List<DirectoryInfo> dirs = new List<DirectoryInfo>();
        for (int i = 0; i < names.Length; i++)
        {
            string child = Path.Combine(_path, names[i]);
            if (Directory.Exists(child))
            {
                dirs.Add(new DirectoryInfo(child));
            }
        }
        return dirs.ToArray();
    }

    public FileSystemInfo[] EnumerateFileSystemInfos()
    {
        return GetFileSystemInfos();
    }

    public FileInfo[] EnumerateFiles()
    {
        return GetFiles();
    }

    public DirectoryInfo[] EnumerateDirectories()
    {
        return GetDirectories();
    }

    public void MoveTo(string destination)
    {
        Directory.Move(_path, destination);
        _path = destination;
        _fresh = false;
    }

    public override void Delete()
    {
        Directory.Delete(_path, false);
        _fresh = false;
    }

    public void Delete(bool recursive)
    {
        Directory.Delete(_path, recursive);
        _fresh = false;
    }
}

/// The rest of System.IO.File and System.IO.Directory: times, links,
/// copies, moves, listings.
static class FileSystem
{
    /// A link's target as a path somebody else can open: unchanged when it is
    /// absolute, and otherwise in the directory the link itself is in.
    public static string Beside(string link, string target)
    {
        if (target.Length > 0 && target[0] == '/')
        {
            return target;
        }
        string? directory = Path.GetDirectoryName(link);
        if (directory == null || directory.Length == 0)
        {
            return target;
        }
        return Path.Combine(directory, target);
    }

    public static bool IsDirectoryNoFollow(string path)
    {
        byte[] into = Stat.Room();
        return Os.Lstat(path, into) >= 0 && Stat.IsDirMode(Stat.Mode(into));
    }
}

partial static class File
{
    public static FileStream Create(string path)
    {
        return new FileStream(path, FileMode.Create, FileAccess.ReadWrite);
    }

    public static FileStream Open(string path, FileMode mode)
    {
        return new FileStream(path, mode);
    }

    public static FileStream Open(string path, FileMode mode, FileAccess access)
    {
        return new FileStream(path, mode, access);
    }

    public static FileStream OpenRead(string path)
    {
        return new FileStream(path, FileMode.Open, FileAccess.Read);
    }

    public static FileStream OpenWrite(string path)
    {
        return new FileStream(path, FileMode.OpenOrCreate, FileAccess.Write);
    }

    public static StreamReader OpenText(string path)
    {
        return new StreamReader(path);
    }

    public static StreamWriter CreateText(string path)
    {
        return new StreamWriter(path, false);
    }

    public static StreamWriter AppendText(string path)
    {
        return new StreamWriter(path, true);
    }

    public static void Copy(string source, string destination, bool overwrite)
    {
        if (!overwrite && Os.Exists(destination))
        {
            throw Interop.GetExceptionForIoErrno(17, destination);
        }
        FileStream from = new FileStream(source, FileMode.Open, FileAccess.Read);
        FileStream to = new FileStream(destination, FileMode.Create, FileAccess.Write);
        from.CopyTo(to);
        to.Dispose();
        from.Dispose();
        Os.Chmod(destination, (int)GetUnixFileMode(source));
    }

    public static void Copy(string source, string destination)
    {
        Copy(source, destination, false);
    }

    public static FileAttributes GetAttributes(string path)
    {
        FileInfo f = new FileInfo(path);
        if (!Os.Exists(path))
        {
            throw Interop.GetExceptionForIoErrno(2, path);
        }
        return f.Attributes;
    }

    public static DateTime GetLastWriteTimeUtc(string path)
    {
        return new FileInfo(path).LastWriteTimeUtc;
    }

    public static DateTime GetLastWriteTime(string path)
    {
        return GetLastWriteTimeUtc(path).ToLocalTime();
    }

    public static DateTime GetLastAccessTimeUtc(string path)
    {
        return new FileInfo(path).LastAccessTimeUtc;
    }

    public static DateTime GetLastAccessTime(string path)
    {
        return GetLastAccessTimeUtc(path).ToLocalTime();
    }

    public static DateTime GetCreationTimeUtc(string path)
    {
        return new FileInfo(path).CreationTimeUtc;
    }

    public static DateTime GetCreationTime(string path)
    {
        return GetCreationTimeUtc(path).ToLocalTime();
    }

    static void SetTimes(string path, long atime, long mtime)
    {
        int r = Os.Utimensat(path, atime, 0, mtime, 0, true);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    public static void SetLastWriteTimeUtc(string path, DateTime when)
    {
        SetTimes(path, -1, new DateTimeOffset(when, TimeSpan.Zero).ToUnixTimeSeconds());
    }

    public static void SetLastWriteTime(string path, DateTime when)
    {
        SetLastWriteTimeUtc(path, when.ToUniversalTime());
    }

    public static void SetLastAccessTimeUtc(string path, DateTime when)
    {
        SetTimes(path, new DateTimeOffset(when, TimeSpan.Zero).ToUnixTimeSeconds(), -1);
    }

    public static void SetLastAccessTime(string path, DateTime when)
    {
        SetLastAccessTimeUtc(path, when.ToUniversalTime());
    }

    /// THE LINK ITSELF when `followLinks` is false. .NET has no spelling for
    /// this and `touch -h` is exactly it: the times of the symbolic link,
    /// not of whatever it points at.
    public static void SetLastWriteTimeUtc(string path, DateTime when, bool followLinks)
    {
        int r = Os.Utimensat(path, -1, 0,
                             new DateTimeOffset(when, TimeSpan.Zero).ToUnixTimeSeconds(), 0, followLinks);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    public static void SetLastAccessTimeUtc(string path, DateTime when, bool followLinks)
    {
        int r = Os.Utimensat(path, new DateTimeOffset(when, TimeSpan.Zero).ToUnixTimeSeconds(),
                             0, -1, 0, followLinks);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    /// A HARD LINK: a second directory entry for a file that already exists.
    /// .NET has no call for this -- there is no Windows-and-Unix answer to
    /// it -- and `ln` without -s is exactly this system call.
    public static void CreateHardLink(string path, string pathToTarget)
    {
        int r = Os.Link(pathToTarget, path);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
    }

    /// A symbolic link at `path` pointing at `target`, as .NET 6 has it.
    public static FileSystemInfo CreateSymbolicLink(string path, string target)
    {
        int r = Os.Symlink(target, path);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path);
        }
        return new FileInfo(path);
    }

    /// What a link points at, or null when `path` is not a link.
    ///
    /// A RELATIVE TARGET IS RELATIVE TO THE LINK, not to the current
    /// directory: `ls -l /etc/x -> y` means /etc/y wherever the program
    /// asking happens to be standing. Each hop is joined to the directory of
    /// the link it came out of, which is what readlink(2)'s caller has to do
    /// and what .NET does for you.
    public static FileSystemInfo? ResolveLinkTarget(string path, bool returnFinalTarget)
    {
        string? target = Os.Readlink(path);
        if (target == null)
        {
            return null;
        }
        target = FileSystem.Beside(path, target);
        if (returnFinalTarget)
        {
            int hops = 0;
            while (hops < 40)
            {
                string? next = Os.Readlink(target);
                if (next == null)
                {
                    break;
                }
                target = FileSystem.Beside(target, next);
                hops++;
            }
        }
        return new FileInfo(target);
    }
}

partial static class Directory
{
    public static string[] GetDirectories(string path)
    {
        DirectoryInfo[] dirs = new DirectoryInfo(path).GetDirectories();
        string[] names = new string[dirs.Length];
        for (int i = 0; i < dirs.Length; i++)
        {
            names[i] = dirs[i].ToString();
        }
        return names;
    }

    public static string[] GetFileSystemEntries(string path)
    {
        FileSystemInfo[] all = new DirectoryInfo(path).GetFileSystemInfos();
        string[] names = new string[all.Length];
        for (int i = 0; i < all.Length; i++)
        {
            names[i] = all[i].ToString();
        }
        return names;
    }

    public static string[] EnumerateFileSystemEntries(string path)
    {
        return GetFileSystemEntries(path);
    }

    public static string[] EnumerateFiles(string path)
    {
        return GetFiles(path);
    }

    public static string[] EnumerateDirectories(string path)
    {
        return GetDirectories(path);
    }

    public static DirectoryInfo? GetParent(string path)
    {
        return new DirectoryInfo(path).Parent;
    }

    /// A new, uniquely named, empty directory under the temporary path, its
    /// name the prefix and random characters, as .NET 7's makes it.
    public static DirectoryInfo CreateTempSubdirectory(string? prefix = null)
    {
        if (prefix != null && prefix.IndexOf('/') >= 0)
        {
            throw new ArgumentException("The prefix must not contain a directory separator.", nameof(prefix));
        }
        string root = Path.GetTempPath();
        for (int attempt = 0; attempt < 1000; attempt++)
        {
            string name = (prefix ?? "") + Path.GetRandomFileName().Replace(".", "");
            string full = Path.Combine(root, name);
            int r = Os.Mkdir(full, 448);                // 0700, as .NET makes it
            if (r >= 0)
            {
                return new DirectoryInfo(full);
            }
            if (r != -Err.Exist)
            {
                throw Interop.GetExceptionForIoErrno(r, full, true);
            }
        }
        throw new IOException("A unique directory could not be created in " + root);
    }

    public static void SetCurrentDirectory(string path)
    {
        Environment.CurrentDirectory = path;
    }

    public static void Move(string source, string destination)
    {
        int r = Os.Rename(source, destination);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, source);
        }
    }

    public static void Delete(string path)
    {
        Delete(path, false);
    }

    public static void Delete(string path, bool recursive)
    {
        if (recursive)
        {
            string[]? names = Os.ListDir(path);
            if (names != null)
            {
                for (int i = 0; i < names.Length; i++)
                {
                    if (names[i] == "." || names[i] == "..")
                    {
                        continue;
                    }
                    string child = Path.Combine(path, names[i]);
                    if (FileSystem.IsDirectoryNoFollow(child))
                    {
                        Delete(child, true);
                    }
                    else
                    {
                        File.Delete(child);
                    }
                }
            }
        }
        int r = Os.Rmdir(path);
        if (r < 0)
        {
            throw Interop.GetExceptionForIoErrno(r, path, true);
        }
    }

    public static DateTime GetLastWriteTimeUtc(string path)
    {
        return new DirectoryInfo(path).LastWriteTimeUtc;
    }

    public static DateTime GetLastWriteTime(string path)
    {
        return GetLastWriteTimeUtc(path).ToLocalTime();
    }
}

/// Block devices: what .NET has no API for and a partition editor or a
/// mkfs cannot do without. Size asks the device how big it is; a file's
/// size is its length as usual.
static class BlockDevice
{
    /// The device's size in bytes, or a regular file's length.
    public static long Size(FileStream device)
    {
        long size = Os.SizeOf(device.Handle);
        if (size < 0)
        {
            throw new IOException("cannot find the size of the device");
        }
        return size;
    }

    /// Asks the kernel to read the partition table again (BLKRRPART).
    /// Throws with the reason when it will not: a partition mounted or
    /// open, not a whole device, not the superuser.
    public static void RereadPartitionTable(FileStream device)
    {
        long r = Os.Ioctl(device.Handle, 0x125F, 0);
        if (r < 0)
        {
            string why = r == -16 ? "a partition is mounted or open"
                       : r == -Err.Inval ? "the device is not a whole device"
                       : r == -Err.Perm || r == -Err.Access ? "only the superuser may reload it"
                       : "errno " + (-r);
            throw new IOException(why);
        }
    }
}

/// System.IO.DriveType, as .NET names the kinds.
enum DriveType
{
    Unknown = 0,
    NoRootDirectory = 1,
    Removable = 2,
    Fixed = 3,
    Network = 4,
    CDRom = 5,
    Ram = 6
}

/// System.IO.DriveInfo: one mounted filing system, how big it is and how much
/// of it is left.
///
/// .NET's own implementation on Linux is exactly this -- the mount table for
/// the list, statfs(2) for the numbers -- and the members here are its
/// members. The one addition is DeviceName, which .NET has nowhere to put and
/// `df` cannot print its first column without: the thing mounted, as opposed
/// to the place it is mounted on.
class DriveInfo
{
    string _mount;
    string _device = "";
    string _format = "";
    string _options = "";
    byte[]? _stat;
    bool _asked;

    public DriveInfo(string driveName)
    {
        _mount = driveName;
        Locate();
    }

    DriveInfo(string mount, string device, string format, string options)
    {
        _mount = mount;
        _device = device;
        _format = format;
        _options = options;
    }

    /// Where it is mounted, which is what .NET calls a drive's name on Unix.
    public string Name
    {
        get { return _mount; }
    }

    public DirectoryInfo RootDirectory
    {
        get { return new DirectoryInfo(_mount); }
    }

    /// What is mounted there: a device, or whatever a filing system with no
    /// device calls itself. NOT .NET's -- see the note above the class.
    public string DeviceName
    {
        get { return _device; }
    }

    /// The options it was mounted with, as the mount table spells them.
    public string MountOptions
    {
        get { return _options; }
    }

    /// The filing system's name: "ext2", "minix", "tmpfs".
    public string DriveFormat
    {
        get { return _format; }
    }

    public string VolumeLabel
    {
        get { return _mount; }
    }

    /// The kind, as far as the filing system's name says: what is in memory is
    /// Ram, what comes over a network is Network, a read-only optical image is
    /// CDRom, and everything else is a disc.
    public DriveType DriveType
    {
        get
        {
            if (_format == "tmpfs" || _format == "ramfs" || _format == "devtmpfs")
            {
                return DriveType.Ram;
            }
            if (_format == "nfs" || _format == "nfs4" || _format == "cifs"
                || _format == "smbfs" || _format == "9p")
            {
                return DriveType.Network;
            }
            if (_format == "iso9660" || _format == "udf")
            {
                return DriveType.CDRom;
            }
            if (_format.Length == 0)
            {
                return DriveType.Unknown;
            }
            return DriveType.Fixed;
        }
    }

    /// Whether the numbers below can be had at all: a filing system whose
    /// mount point cannot be reached -- a stale network mount, a device that
    /// has gone -- is not ready.
    public bool IsReady
    {
        get { return Data() != null; }
    }

    public long TotalSize
    {
        get { return Counted(StatFs.BlocksAt); }
    }

    /// What is free to whoever is asking, which is what df's "available"
    /// column means: the superuser's reserve is not available to anybody else.
    public long AvailableFreeSpace
    {
        get { return Counted(StatFs.AvailableAt); }
    }

    /// What is free altogether, the reserved blocks included.
    public long TotalFreeSpace
    {
        get { return Counted(StatFs.FreeAt); }
    }

    /// The inodes the filing system has and has left, which df -i prints and
    /// .NET has no member for.
    public long TotalFileNodes
    {
        get
        {
            byte[]? d = Data();
            return d == null ? 0 : StatFs.Files(d);
        }
    }

    public long FreeFileNodes
    {
        get
        {
            byte[]? d = Data();
            return d == null ? 0 : StatFs.FilesFree(d);
        }
    }

    public long BlockSize
    {
        get
        {
            byte[]? d = Data();
            return d == null ? 0 : StatFs.BlockSize(d);
        }
    }

    long Counted(int field)
    {
        byte[]? d = Data();
        if (d == null) { return 0; }
        long unit = StatFs.FragmentSize(d);
        if (unit <= 0) { unit = StatFs.BlockSize(d); }
        return Raw.I64(d, field) * unit;
    }

    byte[]? Data()
    {
        if (!_asked)
        {
            _asked = true;
            byte[] into = StatFs.Room();
            _stat = Os.Statfs(_mount, into) >= 0 ? into : null;
        }
        return _stat;
    }

    /// The device and filing system for a mount point somebody named, out of
    /// the mount table; a name that is not a mount point keeps the empty
    /// strings and answers whatever statfs says about the tree it is in.
    void Locate()
    {
        DriveInfo[] all = GetDrives();
        for (int i = 0; i < all.Length; i++)
        {
            if (all[i].Name == _mount)
            {
                _device = all[i].DeviceName;
                _format = all[i].DriveFormat;
                _options = all[i].MountOptions;
                return;
            }
        }
    }

    /// Every mounted filing system, in the order the kernel mounted them,
    /// which is the order /proc/mounts is in.
    public static DriveInfo[] GetDrives()
    {
        List<DriveInfo> drives = new List<DriveInfo>();
        string[] lines;
        try { lines = File.ReadAllLines("/proc/mounts"); }
        catch (Exception) { return drives.ToArray(); }

        for (int i = 0; i < lines.Length; i++)
        {
            string[] fields = lines[i].Split(' ');
            if (fields.Length < 3) { continue; }
            drives.Add(new DriveInfo(Unescape(fields[1]), Unescape(fields[0]),
                                     fields[2],
                                     fields.Length > 3 ? fields[3] : ""));
        }
        return drives.ToArray();
    }

    /// The mount table escapes the characters that would break its own
    /// columns -- a space in a mount point is \040 -- and a program reading it
    /// has to put them back.
    static string Unescape(string text)
    {
        if (text.IndexOf('\\') < 0) { return text; }

        StringBuilder made = new StringBuilder();
        int at = 0;
        while (at < text.Length)
        {
            if (text[at] == '\\' && at + 3 < text.Length
                && text[at + 1] >= '0' && text[at + 1] <= '7'
                && text[at + 2] >= '0' && text[at + 2] <= '7'
                && text[at + 3] >= '0' && text[at + 3] <= '7')
            {
                int value = (text[at + 1] - '0') * 64 + (text[at + 2] - '0') * 8
                          + (text[at + 3] - '0');
                made.Append((char)value);
                at = at + 4;
                continue;
            }
            made.Append(text[at]);
            at++;
        }
        return made.ToString();
    }
}

/// File.ReadLines' sequence: the first enumeration reads through the reader
/// opened when the sequence was made, each later one opens the file again.
class FileLines : IEnumerable<string>
{
    // The non-generic IEnumerable's, as .NET's collections have it.
    IEnumerator IEnumerable.GetEnumerator() { return GetEnumerator(); }

    readonly string _path;
    StreamReader? _first;

    public FileLines(string path, StreamReader first)
    {
        _path = path;
        _first = first;
    }

    public IEnumerator<string> GetEnumerator()
    {
        StreamReader? reader = _first;
        _first = null;
        return new FileLinesEnumerator(reader ?? new StreamReader(_path));
    }
}

class FileLinesEnumerator : IEnumerator<string>, IDisposable
{
    // The non-generic IEnumerator's members, as .NET's enumerators have them.
    object? IEnumerator.Current => Current;

    StreamReader? _reader;
    string _current = "";

    public FileLinesEnumerator(StreamReader reader)
    {
        _reader = reader;
    }

    public string Current => _current;

    public bool MoveNext()
    {
        StreamReader? reader = _reader;
        if (reader == null)
        {
            return false;
        }
        string? line = reader.ReadLine();
        if (line == null)
        {
            Dispose();
            return false;
        }
        _current = line;
        return true;
    }

    public void Reset()
    {
        throw new NotSupportedException("Specified method is not supported.");
    }

    public void Dispose()
    {
        StreamReader? reader = _reader;
        _reader = null;
        if (reader != null)
        {
            reader.Dispose();
        }
    }
}

/// Random bytes for temporary names, from the system's generator when there
/// is one (getrandom), else from a generator seeded by the clock.
static class TempNames
{
    static Random? _fallback;

    public static void Fill(byte[] into)
    {
        long got = Sys.Syscall(355, Sys.ArrayData(into), into.Length, 0);
        if (got == into.Length)
        {
            return;
        }
        Random fallback = _fallback ??= new Random((int)(Os.Micros() ^ Sys.Syscall(Call.Getpid, 0, 0, 0)));
        fallback.NextBytes(into);
    }
}


namespace Microsoft.Win32.SafeHandles
{
    /// An open file, as .NET's SafeFileHandle: a descriptor closed once, when
    /// it is disposed (File.OpenHandle, RandomAccess).
    public sealed class SafeFileHandle : IDisposable
    {
        internal int Fd;
        bool _closed;

        internal SafeFileHandle(int fd) { Fd = fd; }

        public bool IsClosed => _closed;
        public bool IsInvalid => Fd < 0;

        public void Dispose()
        {
            if (_closed) return;
            _closed = true;
            if (Fd >= 0) Os.Close(Fd);
        }
    }
}

partial static class File
{
    /// A handle on a file with no stream and no position of its own, as
    /// .NET's File.OpenHandle: what RandomAccess reads and writes by offset.
    public static Microsoft.Win32.SafeHandles.SafeFileHandle OpenHandle(string path, FileMode mode = FileMode.Open,
        FileAccess access = FileAccess.Read, FileShare share = FileShare.Read, FileOptions options = FileOptions.None, long preallocationSize = 0)
    {
        if (path == null) throw new ArgumentNullException("path");
        int flags = access == FileAccess.Read ? O.Read : access == FileAccess.Write ? O.Write : O.ReadWrite;
        if (mode == FileMode.CreateNew) flags = flags | O.Create | O.Exclusive;
        else if (mode == FileMode.Create) flags = flags | O.Create | O.Truncate;
        else if (mode == FileMode.OpenOrCreate) flags = flags | O.Create;
        else if (mode == FileMode.Truncate) flags = flags | O.Truncate;
        else if (mode == FileMode.Append) flags = flags | O.Create | O.Append;
        int fd = Os.Open(path, flags | O.LargeFile, 420);
        if (fd < 0) throw Interop.GetExceptionForIoErrno(fd, path);
        return new Microsoft.Win32.SafeHandles.SafeFileHandle(fd);
    }
}

/// Reads and writes by offset on a file handle, as .NET's RandomAccess: no
/// shared position, so several threads may read one file at once (pread64).
public static class RandomAccess
{
    /// Up to buffer.Length bytes at fileOffset; how many were read, 0 at the end.
    public static int Read(Microsoft.Win32.SafeHandles.SafeFileHandle handle, Span<byte> buffer, long fileOffset)
    {
        if (handle == null) throw new ArgumentNullException("handle");
        if (handle.IsClosed) throw new ObjectDisposedException("handle");
        if (fileOffset < 0) throw new ArgumentOutOfRangeException("fileOffset");
        if (buffer.Length == 0) return 0;
        long got = Os.Pread(handle.Fd, buffer.Array, buffer.Start, buffer.Length, fileOffset);
        if (got < 0) throw Interop.GetExceptionForIoErrno((int)got, "");
        return (int)got;
    }

    public static long GetLength(Microsoft.Win32.SafeHandles.SafeFileHandle handle)
    {
        if (handle == null) throw new ArgumentNullException("handle");
        return Os.SizeOf(handle.Fd);
    }
}
