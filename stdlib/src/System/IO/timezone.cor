    };
}

/// One period of daylight-saving rules, as .NET's TimeZoneInfo describes
/// them.
sealed class AdjustmentRule
{
    public DateTime DateStart { get; private set; }
    public DateTime DateEnd { get; private set; }
    public TimeSpan DaylightDelta { get; private set; }
    public TransitionTime DaylightTransitionStart { get; private set; }
    public TransitionTime DaylightTransitionEnd { get; private set; }
    public TimeSpan BaseUtcOffsetDelta => TimeSpan.Zero;

    public static AdjustmentRule CreateAdjustmentRule(DateTime dateStart, DateTime dateEnd, TimeSpan daylightDelta,
        TransitionTime daylightTransitionStart, TransitionTime daylightTransitionEnd)
    {
        AdjustmentRule rule = new AdjustmentRule();
        rule.DateStart = dateStart;
        rule.DateEnd = dateEnd;
        rule.DaylightDelta = daylightDelta;
        rule.DaylightTransitionStart = daylightTransitionStart;
        rule.DaylightTransitionEnd = daylightTransitionEnd;
        return rule;
    }
}

/// When daylight time starts or ends, as .NET says it: a fixed date, or the
/// nth given weekday of a month (week 5 is the last).
struct TransitionTime
{
    public DateTime TimeOfDay { get; private set; }
    public int Month { get; private set; }
    public int Week { get; private set; }
    public int Day { get; private set; }
    public DayOfWeek DayOfWeek { get; private set; }
    public bool IsFixedDateRule { get; private set; }

    public static TransitionTime CreateFloatingDateRule(DateTime timeOfDay, int month, int week, DayOfWeek dayOfWeek)
    {
        TransitionTime t = new TransitionTime();
        t.TimeOfDay = timeOfDay; t.Month = month; t.Week = week; t.DayOfWeek = dayOfWeek; t.Day = 1;
        t.IsFixedDateRule = false;
        return t;
    }

    public static TransitionTime CreateFixedDateRule(DateTime timeOfDay, int month, int day)
    {
        TransitionTime t = new TransitionTime();
        t.TimeOfDay = timeOfDay; t.Month = month; t.Day = day; t.Week = 1;
        t.IsFixedDateRule = true;
        return t;
    }
}

/// A POSIX TZ rule -- "CST6CDT,M3.2.0,M11.1.0" -- the rule a TZif file ends
/// with and the form TZ may take. Offsets are kept EAST of UTC, the way
/// round everything else here counts them; the string writes them west.
sealed class PosixRule
{
    public string StandardName = "";
    public string DaylightName = "";
    public long Standard;
    public long Daylight;
    public bool HasDaylight;
    long[] _start = new long[] { 0, 3, 2, 0, 7200 };   // kind (0 M, 1 J, 2 n), m, w, d, seconds
    long[] _end = new long[] { 0, 11, 1, 0, 7200 };

    string _text = "";
    int _at;

    public static PosixRule? Parse(string text)
    {
        PosixRule r = new PosixRule();
        r._text = text;
        string std = r.Name();
        if (std.Length == 0) return null;
        long west;
        if (!r.Offset(out west)) return null;
        r.StandardName = std;
        r.Standard = -west;
        r.Daylight = r.Standard + 3600;
        if (r._at < text.Length)
        {
            string dst = r.Name();
            if (dst.Length == 0) return null;
            r.DaylightName = dst;
            r.HasDaylight = true;
            if (r._at < text.Length && text[r._at] != ',')
            {
                long dwest;
                if (!r.Offset(out dwest)) return null;
                r.Daylight = -dwest;
            }
            if (r._at < text.Length)
            {
                if (text[r._at] != ',') return null;
                r._at++;
                if (!r.Date(r._start)) return null;
                if (r._at >= text.Length || text[r._at] != ',') return null;
                r._at++;
                if (!r.Date(r._end)) return null;
            }
            if (r._at != text.Length) return null;
        }
        return r;
    }

    public bool InDaylight(long utc)
    {
        if (!HasDaylight) return false;
        long year = YearOf(utc + Standard);
        long start = Transition(year, _start) - Standard;
        long end = Transition(year, _end) - Daylight;
        return start < end ? utc >= start && utc < end : utc >= start || utc < end;
    }

    public AdjustmentRule Adjustment()
    {
        return AdjustmentRule.CreateAdjustmentRule(DateTime.MinValue.Date, DateTime.MaxValue.Date,
            new TimeSpan((Daylight - Standard) * 10000000), Transition(_start), Transition(_end));
    }

    static TransitionTime Transition(long[] r)
    {
        DateTime time = new DateTime(1, 1, 1).AddSeconds(r[4]);
        if (r[0] == 0) return TransitionTime.CreateFloatingDateRule(time, (int)r[1], (int)r[2], (DayOfWeek)(int)r[3]);
        // A day of the year: said as the date it falls on in a year without Feb 29.
        long day = r[0] == 1 ? r[3] - 1 : r[3];
        DateTime date = new DateTime(2001, 1, 1).AddDays(day);
        return TransitionTime.CreateFixedDateRule(time, date.Month, date.Day);
    }

    static bool Leap(long y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }

    static long DaysFromEpoch(long year)
    {
        long days = 0;
        if (year >= 1970) for (long y = 1970; y < year; y++) days += Leap(y) ? 366 : 365;
        else for (long y = year; y < 1970; y++) days -= Leap(y) ? 366 : 365;
        return days;
    }

    static long DaysBeforeMonth(long year, long month)
    {
        long d = month <= 1 ? 0 : month == 2 ? 31 : month == 3 ? 59 : month == 4 ? 90 : month == 5 ? 120
               : month == 6 ? 151 : month == 7 ? 181 : month == 8 ? 212 : month == 9 ? 243 : month == 10 ? 273
               : month == 11 ? 304 : month == 12 ? 334 : 365;
        if (month > 2 && Leap(year)) d++;
        return d;
    }

    static long YearOf(long seconds)
    {
        long days = seconds >= 0 ? seconds / 86400 : (seconds - 86399) / 86400;
        long year = 1970;
        while (days < 0) { year--; days += Leap(year) ? 366 : 365; }
        while (true)
        {
            long length = Leap(year) ? 366 : 365;
            if (days < length) return year;
            days -= length;
            year++;
        }
    }

    static long Transition(long year, long[] r)
    {
        long day;
        if (r[0] == 1) day = r[3] - 1 + (Leap(year) && r[3] >= 60 ? 1 : 0);
        else if (r[0] == 2) day = r[3];
        else
        {
            long first = DaysBeforeMonth(year, r[1]);
            long weekday = ((DaysFromEpoch(year) + first + 4) % 7 + 7) % 7;
            long d = (r[3] - weekday + 7) % 7 + (r[2] - 1) * 7;
            long length = DaysBeforeMonth(year, r[1] + 1) - first;
            while (d >= length) d -= 7;
            day = first + d;
        }
        return (DaysFromEpoch(year) + day) * 86400 + r[4];
    }

    string Name()
    {
        if (_at < _text.Length && _text[_at] == '<')
        {
            int close = _text.IndexOf('>', _at);
            if (close < 0) return "";
            string quoted = _text.Substring(_at + 1, close - _at - 1);
            _at = close + 1;
            return quoted;
        }
        int from = _at;
        while (_at < _text.Length && char.IsLetter(_text[_at])) _at++;
        return _at - from >= 3 ? _text.Substring(from, _at - from) : "";
    }

    bool Number(out long value)
    {
        value = 0;
        int from = _at;
        while (_at < _text.Length && _text[_at] >= '0' && _text[_at] <= '9') { value = value * 10 + (_text[_at] - '0'); _at++; }
        return _at > from;
    }

    bool Offset(out long seconds)
    {
        seconds = 0;
        long sign = 1;
        if (_at < _text.Length && (_text[_at] == '+' || _text[_at] == '-')) { if (_text[_at] == '-') sign = -1; _at++; }
        long h, m = 0, s = 0;
        if (!Number(out h)) return false;
        if (_at < _text.Length && _text[_at] == ':') { _at++; if (!Number(out m)) return false; }
        if (_at < _text.Length && _text[_at] == ':') { _at++; if (!Number(out s)) return false; }
        seconds = sign * (h * 3600 + m * 60 + s);
        return true;
    }

    bool Date(long[] into)
    {
        long a, b, c;
        if (_at < _text.Length && _text[_at] == 'M')
        {
            _at++;
            if (!Number(out a) || _at >= _text.Length || _text[_at] != '.') return false;
            _at++;
            if (!Number(out b) || _at >= _text.Length || _text[_at] != '.') return false;
            _at++;
            if (!Number(out c)) return false;
            if (a < 1 || a > 12 || b < 1 || b > 5 || c > 6) return false;
            into[0] = 0; into[1] = a; into[2] = b; into[3] = c;
        }
        else if (_at < _text.Length && _text[_at] == 'J')
        {
            _at++;
            if (!Number(out a) || a < 1 || a > 365) return false;
            into[0] = 1; into[3] = a;
        }
        else
        {
            if (!Number(out a) || a > 365) return false;
            into[0] = 2; into[3] = a;
        }
        into[4] = 7200;
        if (_at < _text.Length && _text[_at] == '/')
        {
            _at++;
            long t;
            if (!Offset(out t)) return false;
            into[4] = t;
        }
        return true;
    }
}
