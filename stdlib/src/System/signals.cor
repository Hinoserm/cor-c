// System.Runtime.InteropServices.PosixSignalRegistration, as .NET spells
// it: a handler for a POSIX signal, run on the signal, able to cancel the
// default action.
//
// The kernel calls a handler as a C function with the number in its one
// argument; a static COR-C# method has exactly that shape, so Dispatch
// below is what the kernel is told to call, through Sys.AddressOf. It
// runs at any instruction of the program, so it does the minimum: it
// remembers which signal arrived, wakes the thread that delivers them, and
// returns. That thread, started with the first handler, runs the program's
// handlers, and nothing else does -- as .NET's run, on a thread of their
// own, not in the signal frame, whatever the rest of the program is doing.
// Run at the program's quiet moments instead, a program busy in a loop
// never ran them: `ping -f`, sending back to back, let Ctrl+C and
// `kill -INT` go by, and SIGKILL alone stopped it. The console, the
// scheduler, the waits (Os.Poll, a thread's sleep) and the GUI seat
// (Seat.Next) still call Deliver at theirs, which only marks what arrived
// as seen, so a wait the signal ended is not ended by it again; none waits
// for a handler, as no .NET wait does, and none runs one, so a scheduler
// pass never runs a handler that waits for a task only that pass would.
// Os.Pause, whose promise is that the handlers have run, waits for them
// (Settle).

public enum PosixSignal
{
    SIGHUP = 1,
    SIGINT = 2,
    SIGQUIT = 3,
    SIGKILL = 9,
    SIGPIPE = 13,
    SIGALRM = 14,
    SIGTERM = 15,
    SIGCHLD = 17,
    SIGCONT = 18,
    SIGTSTP = 20,
    SIGTTIN = 21,
    SIGTTOU = 22,
    SIGWINCH = 28
}

public class PosixSignalContext
{
    public PosixSignal Signal;
    public bool Cancel;
}

public interface PosixSignalHandler
{
    void Invoke(PosixSignalContext context);
}

public class PosixSignalRegistration : IDisposable
{
    const int MaxSignal = 32;
    static PosixSignalHandler?[]? _handlers;
    // A BIT PER SIGNAL THAT ARRIVED, set and taken atomically: a handler
    // runs between any two instructions -- of Deliver too, and on another
    // thread -- and a read followed by a clear lost the signal that landed
    // between them (an alarm, a child's end: a wait that then slept on).
    // Signals 1 to 31: one 32-bit word, which a 486 swaps whole; the or is
    // Interlocked's compare-and-swap loop, retried if a signal lands inside it.
    static int _pending;
    // WHAT THE PROGRAM'S WAITS HAVE NOT YET SEEN (Pending): a bit per
    // signal, set after _pending's and taken by Deliver alone, the quiet
    // moments' call. The thread that delivers takes _pending within
    // microseconds of a signal; asked of that, Os.Pause after a signal the
    // program sent itself found nothing and slept for ever, where it had
    // returned. A signal the thread ran that no wait has seen ends the next
    // Pause, as one no handler had run did.
    static int _unseen;
    // ONE DELIVERY AT A TIME (_running, a lock): the thread that delivers,
    // and Os.Pause (Settle), which runs what is pending if the thread has
    // not taken it, and otherwise waits for it.
    static int _running;
    // WHETHER THIS THREAD IS RUNNING A HANDLER (Inside): its own waits do
    // not see the signals (Pending) -- a handler polling on Windows was
    // answered EINTR at every slice while it ran -- nor take them from the
    // program's (Deliver), nor wait for themselves (Settle).
    [ThreadStatic] static bool _inside;
    // Whether the thread that delivers has been started: once, by the first
    // Create (StartDelivering). A fork's child -- which this library only
    // ever execs -- has the word and not the thread, and _running as the
    // fork found it: no handler runs in it.
    static int _delivering;

    PosixSignal _signal;

    PosixSignalRegistration(PosixSignal signal)
    {
        _signal = signal;
    }

    public static PosixSignalRegistration Create(PosixSignal signal, PosixSignalHandler handler)
    {
        if (_handlers == null)
        {
            _handlers = new PosixSignalHandler?[MaxSignal];
        }
        int n = (int)signal;
        _handlers[n] = handler;
        StartDelivering();
        Install(n, Sys.AddressOf(PosixSignalRegistration.Dispatch));
        return new PosixSignalRegistration(signal);
    }

    /// The thread that runs the handlers, started before the first is
    /// installed so no signal lands with nothing to wake. A background one:
    /// it never keeps the process alive.
    static void StartDelivering()
    {
        if (System.Threading.Interlocked.CompareExchange(ref _delivering, 1, 0) != 0)
        {
            return;
        }
        System.Threading.Thread delivering = new System.Threading.Thread(DeliverLoop);
        delivering.IsBackground = true;
        delivering.Start();
    }

    /// Asleep on the pending word until a signal sets a bit in it, then the
    /// handlers. A wait on a word already not 0 returns at once, so a signal
    /// that lands between Run and the wait is not slept through; a wait that
    /// ends with nothing there (Windows parks a second at most) runs nothing.
    static void DeliverLoop()
    {
        nuint at = Sys.AddressOf(ref _pending);
        while (true)
        {
            Native.Wait(at, 0);
            if (_pending != 0)
            {
                Enter();
                Run();
            }
        }
    }

    /// The default action again for this signal.
    public void Dispose()
    {
        int n = (int)_signal;
        if (_handlers != null)
        {
            _handlers[n] = null;
        }
        Install(n, 0);
    }

    /// Ignores a signal outright (SIG_IGN), for the ones a program never
    /// wants to see -- SIGPIPE on a closed socket, in every network
    /// program ever written.
    public static void Ignore(PosixSignal signal)
    {
        Install((int)signal, 1);
    }

    /// Called from the kernel's signal frame: two bits set and the thread
    /// that delivers woken (a futex wake, one system call), nothing more.
    /// _pending first: Os.Pause, seeing _unseen, finds the signal pending
    /// or taken by a delivery.
    public static void Dispatch(int signal)
    {
        if (signal > 0 && signal < MaxSignal)
        {
            System.Threading.Interlocked.Or(ref _pending, 1 << signal);
            System.Threading.Interlocked.Or(ref _unseen, 1 << signal);
            Native.Wake(Sys.AddressOf(ref _pending), 1);
        }
    }

    /// Whether a signal has arrived that the program's waits have not yet
    /// seen (Deliver), its handlers run or not. Never, to a handler's own.
    public static bool Pending
    {
        get { return _unseen != 0 && !Inside(); }
    }

    /// The quiet moments' call -- a wait a signal interrupted, the console,
    /// the scheduler: what arrived is seen. Its handlers are the thread's
    /// that delivers, running or about to; this neither runs nor waits for
    /// them. Nothing from a handler's own wait, which would take what the
    /// program's next wait is owed.
    public static void Deliver()
    {
        if (_unseen == 0 || Inside())
        {
            return;
        }
        System.Threading.Interlocked.Exchange(ref _unseen, 0);
    }

    /// Os.Pause's: Deliver, and then -- but from a handler -- until no
    /// delivery runs and nothing is pending, wait for the one running or
    /// run what the thread has not taken: the handlers for what it saw
    /// have run when it returns.
    public static void Settle()
    {
        Deliver();
        if (Inside())
        {
            return;
        }
        nuint gate = Sys.AddressOf(ref _running);
        while (true)
        {
            if (_running != 0)
            {
                Native.Wait(gate, 1);
                continue;
            }
            if (_pending == 0)
            {
                return;
            }
            if (System.Threading.Interlocked.CompareExchange(ref _running, 1, 0) == 0)
            {
                Run();
            }
        }
    }

    /// Whether this thread is running a handler. A thread the runtime did
    /// not start has no block to keep the answer in, and runs none.
    static bool Inside() => Sys.ThreadBlock() != 0 && _inside;

    /// The lock (_running), waited for: the thread that delivers.
    static void Enter()
    {
        nuint gate = Sys.AddressOf(ref _running);
        while (System.Threading.Interlocked.CompareExchange(ref _running, 1, 0) != 0)
        {
            Native.Wait(gate, 1);
        }
    }

    /// What is pending run, the lock held, and the lock given back.
    static void Run()
    {
        bool was = _inside;
        _inside = true;
        try
        {
            RunPending();
        }
        finally
        {
            _inside = was;
            System.Threading.Interlocked.Exchange(ref _running, 0);
            Native.Wake(Sys.AddressOf(ref _running), Native.WakeAll);
        }
    }

    /// Runs the handlers for what arrived; a handler that does not set
    /// Cancel gets the signal's default action afterwards: the process
    /// ends, as .NET's does.
    static void RunPending()
    {
        if (_pending == 0)
        {
            return;
        }
        int got = System.Threading.Interlocked.Exchange(ref _pending, 0);
        // WHAT IS NOT YET RUN GOES BACK if a handler throws: taken all at
        // once, the signals after the thrower's were lost with it. Its own
        // is taken off first, so it is not run again.
        int left = got;
        try
        {
            for (int n = 1; n < MaxSignal; n++)
            {
                if ((got & (1 << n)) == 0)
                {
                    continue;
                }
                left &= ~(1 << n);
                PosixSignalHandler? h = _handlers == null ? null : _handlers[n];
                PosixSignalContext context = new PosixSignalContext();
                context.Signal = (PosixSignal)n;
                if (h != null)
                {
                    h.Invoke(context);
                }
                if (!context.Cancel && n != (int)PosixSignal.SIGCHLD && n != (int)PosixSignal.SIGWINCH && n != (int)PosixSignal.SIGCONT)
                {
                    Os.Exit(128 + n);
                }
            }
        }
        finally
        {
            if (left != 0)
            {
                // And the thread that delivers told: it runs them next.
                System.Threading.Interlocked.Or(ref _pending, left);
                Native.Wake(Sys.AddressOf(ref _pending), 1);
            }
        }
    }

    /// The handler at a signal, 0 its default action and 1 ignored: the
    /// platform's to install (Os.InstallSignal).
    static void Install(int signal, nuint handler) => Os.InstallSignal(signal, handler);
}
