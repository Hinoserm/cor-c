// System.Text.RegularExpressions, as .NET spells it and as .NET runs it.
//
// .NET SYNTAX, not POSIX. A program that wants BRE or ERE -- grep and sed
// do, because that is what their users type -- translates its pattern into
// this syntax first, exactly as a C# port of those programs would.
//
// THE ENGINE IS .NET's OWN DESIGN, part for part, because its answers are
// the specification and many of them are what its design makes them: the
// parser reads a pattern twice, numbering the groups and finding the errors
// a scan can find before it builds the tree, so a pattern with two faults
// reports the one .NET reports; the tree is written out as a program of
// integer codes (RegexWriter); and an interpreter runs the program over two
// stacks of its own and a third of captures (RegexInterpreter), backtracking
// by popping them, never by recursing, so a long input cannot exhaust the
// machine's stack. What a group captured inside a loop, how a loop that
// matched nothing stops, what a balancing group removes, which match comes
// after an empty one: each is what the same codes on the same stacks make
// of it in .NET.
//
// Everything .NET's interpreter runs runs here: lookahead and lookbehind,
// atomic groups, conditionals on a group or an expression, balancing groups,
// every capture of every group, RightToLeft, the inline options, the match
// timeout, and RegexOptions.ECMAScript's rules. RegexOptions.Compiled is
// accepted and changes nothing, and NonBacktracking runs the same engine
// after refusing what .NET's refuses.
//
// CASE IS .NET's INVARIANT TABLE: under IgnoreCase a letter is the set of the
// letters it is equivalent to, decided once as the pattern is read, so 'k'
// also matches the Kelvin sign; a back-reference compares lower-cased.

enum RegexOptions
{
    None = 0,
    IgnoreCase = 1,
    Multiline = 2,
    ExplicitCapture = 4,
    Compiled = 8,
    Singleline = 16,
    IgnorePatternWhitespace = 32,
    RightToLeft = 64,
    ECMAScript = 256,
    CultureInvariant = 512,
    NonBacktracking = 1024
}

/// Which rule a pattern broke, named and numbered as .NET's.
enum RegexParseError
{
    Unknown = 0,
    AlternationHasTooManyConditions = 1,
    AlternationHasMalformedCondition = 2,
    InvalidUnicodePropertyEscape = 3,
    MalformedUnicodePropertyEscape = 4,
    UnrecognizedEscape = 5,
    UnrecognizedControlCharacter = 6,
    MissingControlCharacter = 7,
    InsufficientOrInvalidHexDigits = 8,
    QuantifierOrCaptureGroupOutOfRange = 9,
    UndefinedNamedReference = 10,
    UndefinedNumberedReference = 11,
    MalformedNamedReference = 12,
    UnescapedEndingBackslash = 13,
    UnterminatedComment = 14,
    InvalidGroupingConstruct = 15,
    AlternationHasNamedCapture = 16,
    AlternationHasComment = 17,
    AlternationHasMalformedReference = 18,
    AlternationHasUndefinedReference = 19,
    CaptureGroupNameInvalid = 20,
    CaptureGroupOfZero = 21,
    UnterminatedBracket = 22,
    ExclusionGroupNotLast = 23,
    ReversedCharacterRange = 24,
    ShorthandClassInCharacterRange = 25,
    InsufficientClosingParentheses = 26,
    ReversedQuantifierRange = 27,
    NestedQuantifiersNotParenthesized = 28,
    QuantifierAfterNothing = 29,
    InsufficientOpeningParentheses = 30,
    UnrecognizedUnicodeProperty = 31
}

/// Thrown for a pattern that is not a pattern: which rule it broke, and how
/// far into the pattern the parser had read when it found out.
class RegexParseException : ArgumentException
{
    public RegexParseError Error { get; }
    public int Offset { get; }

    internal RegexParseException(RegexParseError error, int offset, string message) : base(message)
    {
        Error = error;
        Offset = offset;
    }
}

/// A match that ran past its regular expression's MatchTimeout.
class RegexMatchTimeoutException : TimeoutException
{
    public string Input { get; }
    public string Pattern { get; }
    public TimeSpan MatchTimeout { get; }

    public RegexMatchTimeoutException()
        : this("The operation has timed out.")
    {
    }

    public RegexMatchTimeoutException(string message) : base(message)
    {
        Input = "";
        Pattern = "";
        MatchTimeout = TimeSpan.FromTicks(-1);
    }

    public RegexMatchTimeoutException(string message, Exception inner) : base(message, inner)
    {
        Input = "";
        Pattern = "";
        MatchTimeout = TimeSpan.FromTicks(-1);
    }

    public RegexMatchTimeoutException(string regexInput, string regexPattern, TimeSpan matchTimeout)
        : base("The Regex engine has timed out while trying to match a pattern to an input string. This can occur for many reasons, including very large inputs or excessive backtracking caused by nested quantifiers, back-references and other factors.")
    {
        Input = regexInput;
        Pattern = regexPattern;
        MatchTimeout = matchTimeout;
    }
}

delegate string MatchEvaluator(Match match);

// ---- character classes ------------------------------------------------------

/// One set of characters, as .NET's RegexCharClass builds it: ranges, Unicode
/// categories, a negation, and a set subtracted from it, [a-z-[aeiou]]. A
/// char is in the class when the ranges or categories hold it, inverted by
/// the negation, and only then if the subtracted class does not.
class RegexCharClass
{
    /// Ranges, first and last inclusive, in pairs; sorted and merged once the
    /// class is complete.
    List<int> _ranges = new List<int>();
    /// Each category entry: the UnicodeCategory bits it holds (bit 30 for
    /// .NET's white-space entry, char.IsWhiteSpace), and whether inverted.
    List<int> _categories = new List<int>();
    List<bool> _invertedCategory = new List<bool>();
    RegexCharClass? _subtraction;
    bool _sealed;
    /// The answer for each ASCII character, built when sealed.
    ulong _asciiLow;
    ulong _asciiHigh;

    public bool Negate;

    const int SpaceBit = 1 << 30;

    /// The categories \w holds: the letters, the non-spacing marks, the
    /// decimal digits and the connector punctuation.
    const int WordCategories = (1 << (int)UnicodeCategory.UppercaseLetter) | (1 << (int)UnicodeCategory.LowercaseLetter)
        | (1 << (int)UnicodeCategory.TitlecaseLetter) | (1 << (int)UnicodeCategory.ModifierLetter)
        | (1 << (int)UnicodeCategory.OtherLetter) | (1 << (int)UnicodeCategory.NonSpacingMark)
        | (1 << (int)UnicodeCategory.DecimalDigitNumber) | (1 << (int)UnicodeCategory.ConnectorPunctuation);

    const int CasedLetters = (1 << (int)UnicodeCategory.UppercaseLetter) | (1 << (int)UnicodeCategory.LowercaseLetter)
        | (1 << (int)UnicodeCategory.TitlecaseLetter);

    public void AddChar(char c)
    {
        _ranges.Add(c);
        _ranges.Add(c);
    }

    public void AddRange(char first, char last)
    {
        _ranges.Add(first);
        _ranges.Add(last);
    }

    void AddRangesOf(string pairs, bool invert)
    {
        if (!invert)
        {
            for (int i = 0; i < pairs.Length; i = i + 2)
            {
                AddRange(pairs[i], pairs[i + 1]);
            }
            return;
        }
        int next = 0;
        for (int i = 0; i < pairs.Length; i = i + 2)
        {
            if (pairs[i] > next)
            {
                AddRange((char)next, (char)(pairs[i] - 1));
            }
            next = pairs[i + 1] + 1;
        }
        if (next <= 0xFFFF)
        {
            AddRange((char)next, (char)0xFFFF);
        }
    }

    void AddCategories(int mask, bool invert)
    {
        _categories.Add(mask);
        _invertedCategory.Add(invert);
    }

    public void AddSubtraction(RegexCharClass subtraction)
    {
        _subtraction = subtraction;
    }

    // ECMAScript's \w, \s and \d, as ranges: its word set holds U+0130 too.
    const string EcmaWord = "09AZ__azİİ";
    const string EcmaSpace = "\t\r  ";
    const string EcmaDigit = "09";

    public void AddWord(bool ecma, bool negate)
    {
        if (ecma)
        {
            AddRangesOf(EcmaWord, negate);
        }
        else
        {
            AddCategories(WordCategories, negate);
        }
    }

    public void AddSpace(bool ecma, bool negate)
    {
        if (ecma)
        {
            AddRangesOf(EcmaSpace, negate);
        }
        else
        {
            AddCategories(SpaceBit, negate);
        }
    }

    public void AddDigit(bool ecma, bool negate)
    {
        if (ecma)
        {
            AddRangesOf(EcmaDigit, negate);
        }
        else
        {
            AddCategories(1 << (int)UnicodeCategory.DecimalDigitNumber, negate);
        }
    }

    public static RegexCharClass Word(bool ecma, bool negate)
    {
        RegexCharClass set = new RegexCharClass();
        set.AddWord(ecma, negate);
        return set.Seal();
    }

    public static RegexCharClass Space(bool ecma, bool negate)
    {
        RegexCharClass set = new RegexCharClass();
        set.AddSpace(ecma, negate);
        return set.Seal();
    }

    public static RegexCharClass Digit(bool ecma, bool negate)
    {
        RegexCharClass set = new RegexCharClass();
        set.AddDigit(ecma, negate);
        return set.Seal();
    }

    public static RegexCharClass Any()
    {
        RegexCharClass set = new RegexCharClass();
        set.AddRange((char)0, (char)0xFFFF);
        return set.Seal();
    }

    /// The characters given, each a range of one: a letter's case
    /// equivalents under IgnoreCase.
    public static RegexCharClass Of(char c, string equivalents)
    {
        RegexCharClass set = new RegexCharClass();
        set.AddChar(c);
        for (int i = 0; i < equivalents.Length; i++)
        {
            set.AddChar(equivalents[i]);
        }
        return set.Seal();
    }

    /// The general categories by .NET's names, in UnicodeCategory's order.
    static readonly string[] CategoryNames = new string[]
    {
        "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd", "Nl",
        "No", "Zs", "Zl", "Zp", "Cc", "Cf", "Cs", "Co", "Pc", "Pd",
        "Ps", "Pe", "Pi", "Pf", "Po", "Sm", "Sc", "Sk", "So", "Cn"
    };

    /// \p{name} or, inverted, \P{name}: a general category, one of the seven
    /// groups of them (L M N P S Z C), or a named block. Under IgnoreCase
    /// Lu, Ll and Lt each stand for all three. A name that is none of these
    /// is .NET's UnrecognizedUnicodeProperty.
    public void AddCategoryFromName(string name, bool invert, bool caseInsensitive, string pattern, int at)
    {
        int mask = 0;
        if (name.Length == 1 && "LMNPSZC".IndexOf(name[0]) >= 0)
        {
            for (int i = 0; i < CategoryNames.Length; i++)
            {
                if (CategoryNames[i][0] == name[0])
                {
                    mask = mask | (1 << i);
                }
            }
        }
        else
        {
            for (int i = 0; i < CategoryNames.Length; i++)
            {
                if (CategoryNames[i] == name)
                {
                    mask = 1 << i;
                }
            }
        }
        if (mask != 0)
        {
            if (caseInsensitive && (name == "Lu" || name == "Ll" || name == "Lt"))
            {
                mask = CasedLetters;
            }
            AddCategories(mask, invert);
            return;
        }
        string? ranges = Block(name);
        if (ranges == null)
        {
            throw new RegexParseException(RegexParseError.UnrecognizedUnicodeProperty, at,
                "Invalid pattern '" + pattern + "' at offset " + at + ". Unknown property '" + name + "'.");
        }
        AddRangesOf(ranges, invert);
    }

    /// Every character equivalent to one in the class under IgnoreCase,
    /// added to it: what makes [a-c] match 'B' with the comparison exact.
    public void AddCaseEquivalences()
    {
        int count = _ranges.Count;
        for (int i = 0; i < count; i = i + 2)
        {
            int first = _ranges[i];
            int last = _ranges[i + 1];
            for (int c = first; c <= last; c++)
            {
                string? more = RegexCaseEquivalences.Of((char)c);
                if (more != null)
                {
                    for (int k = 0; k < more.Length; k++)
                    {
                        _ranges.Add(more[k]);
                        _ranges.Add(more[k]);
                    }
                }
            }
        }
    }

    /// The class complete: its ranges sorted and merged and its ASCII
    /// answers worked out once.
    public RegexCharClass Seal()
    {
        if (_sealed)
        {
            return this;
        }
        _sealed = true;
        if (_subtraction != null)
        {
            _subtraction.Seal();
        }
        int pairs = _ranges.Count / 2;
        if (pairs > 1)
        {
            int[] firsts = new int[pairs];
            int[] lasts = new int[pairs];
            for (int i = 0; i < pairs; i++)
            {
                firsts[i] = _ranges[2 * i];
                lasts[i] = _ranges[2 * i + 1];
            }
            Array.Sort(firsts, lasts);
            List<int> merged = new List<int>();
            int first = firsts[0];
            int last = lasts[0];
            for (int i = 1; i < pairs; i++)
            {
                if (firsts[i] <= last + 1)
                {
                    if (lasts[i] > last)
                    {
                        last = lasts[i];
                    }
                }
                else
                {
                    merged.Add(first);
                    merged.Add(last);
                    first = firsts[i];
                    last = lasts[i];
                }
            }
            merged.Add(first);
            merged.Add(last);
            _ranges = merged;
        }
        for (int c = 0; c < 128; c++)
        {
            if (Holds((char)c))
            {
                if (c < 64)
                {
                    _asciiLow = _asciiLow | ((ulong)1 << c);
                }
                else
                {
                    _asciiHigh = _asciiHigh | ((ulong)1 << (c - 64));
                }
            }
        }
        return this;
    }

    public bool CharInClass(char c)
    {
        if (c < 64)
        {
            return ((_asciiLow >> c) & 1) != 0;
        }
        if (c < 128)
        {
            return ((_asciiHigh >> (c - 64)) & 1) != 0;
        }
        return Holds(c);
    }

    bool Holds(char c)
    {
        bool found = InRanges(c) || InCategories(c);
        if (Negate)
        {
            found = !found;
        }
        if (found && _subtraction != null)
        {
            found = !_subtraction.Holds(c);
        }
        return found;
    }

    bool InRanges(char c)
    {
        int low = 0;
        int high = _ranges.Count / 2 - 1;
        while (low <= high)
        {
            int mid = (low + high) >> 1;
            if (c < _ranges[2 * mid])
            {
                high = mid - 1;
            }
            else if (c > _ranges[2 * mid + 1])
            {
                low = mid + 1;
            }
            else
            {
                return true;
            }
        }
        return false;
    }

    bool InCategories(char c)
    {
        if (_categories.Count == 0)
        {
            return false;
        }
        int bit = 1 << (int)Char.GetUnicodeCategory(c);
        for (int i = 0; i < _categories.Count; i++)
        {
            int mask = _categories[i];
            bool holds = mask == SpaceBit ? Char.IsWhiteSpace(c) : (mask & bit) != 0;
            if (holds != _invertedCategory[i])
            {
                return true;
            }
        }
        return false;
    }

    /// Whether c is a word character to \w: a letter, a non-spacing mark, a
    /// decimal digit or a connector.
    public static bool IsWordChar(char c)
    {
        if (c < 128)
        {
            return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        }
        return (WordCategories & (1 << (int)Char.GetUnicodeCategory(c))) != 0;
    }

    /// What \b, \B and a group name take for a word character: \w's, and the
    /// zero-width non-joiner and joiner, which sit inside words.
    public static bool IsBoundaryWordChar(char c)
    {
        return IsWordChar(c) || c == (char)0x200C || c == (char)0x200D;
    }

    public static bool IsEcmaWordChar(char c)
    {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == (char)0x130;
    }

    /// .NET's named blocks for \p{IsName}, each the name and its first and
    /// last character, four hexadecimal digits each: .NET's own table, which
    /// kept Unicode 4.0's names and both spellings where Unicode renamed one,
    /// and its four XML name sets.
    static readonly string[] Blocks = new string[]
    {
        "IsAlphabeticPresentationForms FB00-FB4F", "IsArabic 0600-06FF",
        "IsArabicPresentationForms-A FB50-FDFF", "IsArabicPresentationForms-B FE70-FEFF",
        "IsArmenian 0530-058F", "IsArrows 2190-21FF", "IsBasicLatin 0000-007F",
        "IsBengali 0980-09FF", "IsBlockElements 2580-259F", "IsBopomofo 3100-312F",
        "IsBopomofoExtended 31A0-31BF", "IsBoxDrawing 2500-257F",
        "IsBraillePatterns 2800-28FF", "IsBuhid 1740-175F", "IsCJKCompatibility 3300-33FF",
        "IsCJKCompatibilityForms FE30-FE4F", "IsCJKCompatibilityIdeographs F900-FAFF",
        "IsCJKRadicalsSupplement 2E80-2EFF", "IsCJKSymbolsandPunctuation 3000-303F",
        "IsCJKUnifiedIdeographs 4E00-9FFF", "IsCJKUnifiedIdeographsExtensionA 3400-4DBF",
        "IsCherokee 13A0-13FF", "IsCombiningDiacriticalMarks 0300-036F",
        "IsCombiningDiacriticalMarksforSymbols 20D0-20FF", "IsCombiningHalfMarks FE20-FE2F",
        "IsCombiningMarksforSymbols 20D0-20FF", "IsControlPictures 2400-243F",
        "IsCurrencySymbols 20A0-20CF", "IsCyrillic 0400-04FF",
        "IsCyrillicSupplement 0500-052F", "IsDevanagari 0900-097F", "IsDingbats 2700-27BF",
        "IsEnclosedAlphanumerics 2460-24FF", "IsEnclosedCJKLettersandMonths 3200-32FF",
        "IsEthiopic 1200-137F", "IsGeneralPunctuation 2000-206F",
        "IsGeometricShapes 25A0-25FF", "IsGeorgian 10A0-10FF", "IsGreek 0370-03FF",
        "IsGreekExtended 1F00-1FFF", "IsGreekandCoptic 0370-03FF", "IsGujarati 0A80-0AFF",
        "IsGurmukhi 0A00-0A7F", "IsHalfwidthandFullwidthForms FF00-FFEF",
        "IsHangulCompatibilityJamo 3130-318F", "IsHangulJamo 1100-11FF",
        "IsHangulSyllables AC00-D7AF", "IsHanunoo 1720-173F", "IsHebrew 0590-05FF",
        "IsHighPrivateUseSurrogates DB80-DBFF", "IsHighSurrogates D800-DB7F",
        "IsHiragana 3040-309F", "IsIPAExtensions 0250-02AF",
        "IsIdeographicDescriptionCharacters 2FF0-2FFF", "IsKanbun 3190-319F",
        "IsKangxiRadicals 2F00-2FDF", "IsKannada 0C80-0CFF", "IsKatakana 30A0-30FF",
        "IsKatakanaPhoneticExtensions 31F0-31FF", "IsKhmer 1780-17FF",
        "IsKhmerSymbols 19E0-19FF", "IsLao 0E80-0EFF", "IsLatin-1Supplement 0080-00FF",
        "IsLatinExtended-A 0100-017F", "IsLatinExtended-B 0180-024F",
        "IsLatinExtendedAdditional 1E00-1EFF", "IsLetterlikeSymbols 2100-214F",
        "IsLimbu 1900-194F", "IsLowSurrogates DC00-DFFF", "IsMalayalam 0D00-0D7F",
        "IsMathematicalOperators 2200-22FF", "IsMiscellaneousMathematicalSymbols-A 27C0-27EF",
        "IsMiscellaneousMathematicalSymbols-B 2980-29FF", "IsMiscellaneousSymbols 2600-26FF",
        "IsMiscellaneousSymbolsandArrows 2B00-2BFF", "IsMiscellaneousTechnical 2300-23FF",
        "IsMongolian 1800-18AF", "IsMyanmar 1000-109F", "IsNumberForms 2150-218F",
        "IsOgham 1680-169F", "IsOpticalCharacterRecognition 2440-245F", "IsOriya 0B00-0B7F",
        "IsPhoneticExtensions 1D00-1D7F", "IsPrivateUse E000-F8FF",
        "IsPrivateUseArea E000-F8FF", "IsRunic 16A0-16FF", "IsSinhala 0D80-0DFF",
        "IsSmallFormVariants FE50-FE6F", "IsSpacingModifierLetters 02B0-02FF",
        "IsSpecials FFF0-FFFF", "IsSuperscriptsandSubscripts 2070-209F",
        "IsSupplementalArrows-A 27F0-27FF", "IsSupplementalArrows-B 2900-297F",
        "IsSupplementalMathematicalOperators 2A00-2AFF", "IsSyriac 0700-074F",
        "IsTagalog 1700-171F", "IsTagbanwa 1760-177F", "IsTaiLe 1950-197F",
        "IsTamil 0B80-0BFF", "IsTelugu 0C00-0C7F", "IsThaana 0780-07BF", "IsThai 0E00-0E7F",
        "IsTibetan 0F00-0FFF", "IsUnifiedCanadianAboriginalSyllabics 1400-167F",
        "IsVariationSelectors FE00-FE0F", "IsYiRadicals A490-A4CF", "IsYiSyllables A000-A48F",
        "IsYijingHexagramSymbols 4DC0-4DFF"
    };

    /// A block's range as a pair of chars, or an XML set's ranges; null for
    /// a name that is neither.
    static string? Block(string name)
    {
        string? xml = XmlSet(name);
        if (xml != null)
        {
            return xml;
        }
        for (int i = 0; i < Blocks.Length; i++)
        {
            string block = Blocks[i];
            if (block.Length == name.Length + 10 && block[name.Length] == ' '
                && block.StartsWith(name, StringComparison.Ordinal))
            {
                return "" + (char)Hex(block, name.Length + 1) + (char)Hex(block, name.Length + 6);
            }
        }
        return null;
    }

    static int Hex(string text, int at)
    {
        int value = 0;
        for (int i = at; i < at + 4; i++)
        {
            char c = text[i];
            value = value * 16 + (c <= '9' ? c - '0' : c - 'A' + 10);
        }
        return value;
    }

    /// .NET's four XML sets, \p{_xmlC} \p{_xmlD} \p{_xmlI} \p{_xmlW}: the name
    /// characters, digits, name starts and "word" characters of XML 1.0's
    /// first edition, as ranges in pairs.
    static string? XmlSet(string name)
    {
        if (name == "_xmlC") { return XmlNameChars; }
        if (name == "_xmlD") { return XmlDigits; }
        if (name == "_xmlI") { return XmlNameStarts; }
        if (name == "_xmlW") { return XmlWordChars; }
        return null;
    }

    const string XmlNameChars =
          "\u002D\u002E\u0030\u003A\u0041\u005A\u005F\u005F\u0061\u007A\u00B7\u00B7\u00C0\u00D6\u00D8\u00F6\u00F8\u0131\u0134\u013E"
        + "\u0141\u0148\u014A\u017E\u0180\u01C3\u01CD\u01F0\u01F4\u01F5\u01FA\u0217\u0250\u02A8\u02BB\u02C1\u02D0\u02D1\u0300\u0345"
        + "\u0360\u0361\u0386\u038A\u038C\u038C\u038E\u03A1\u03A3\u03CE\u03D0\u03D6\u03DA\u03DA\u03DC\u03DC\u03DE\u03DE\u03E0\u03E0"
        + "\u03E2\u03F3\u0401\u040C\u040E\u044F\u0451\u045C\u045E\u0481\u0483\u0486\u0490\u04C4\u04C7\u04C8\u04CB\u04CC\u04D0\u04EB"
        + "\u04EE\u04F5\u04F8\u04F9\u0531\u0556\u0559\u0559\u0561\u0586\u0591\u05A1\u05A3\u05B9\u05BB\u05BD\u05BF\u05BF\u05C1\u05C2"
        + "\u05C4\u05C4\u05D0\u05EA\u05F0\u05F2\u0621\u063A\u0640\u0652\u0660\u0669\u0670\u06B7\u06BA\u06BE\u06C0\u06CE\u06D0\u06D3"
        + "\u06D5\u06E8\u06EA\u06ED\u06F0\u06F9\u0901\u0903\u0905\u0939\u093C\u094D\u0951\u0954\u0958\u0963\u0966\u096F\u0981\u0983"
        + "\u0985\u098C\u098F\u0990\u0993\u09A8\u09AA\u09B0\u09B2\u09B2\u09B6\u09B9\u09BC\u09BC\u09BE\u09C4\u09C7\u09C8\u09CB\u09CD"
        + "\u09D7\u09D7\u09DC\u09DD\u09DF\u09E3\u09E6\u09F1\u0A02\u0A02\u0A05\u0A0A\u0A0F\u0A10\u0A13\u0A28\u0A2A\u0A30\u0A32\u0A33"
        + "\u0A35\u0A36\u0A38\u0A39\u0A3C\u0A3C\u0A3E\u0A42\u0A47\u0A48\u0A4B\u0A4D\u0A59\u0A5C\u0A5E\u0A5E\u0A66\u0A74\u0A81\u0A83"
        + "\u0A85\u0A8B\u0A8D\u0A8D\u0A8F\u0A91\u0A93\u0AA8\u0AAA\u0AB0\u0AB2\u0AB3\u0AB5\u0AB9\u0ABC\u0AC5\u0AC7\u0AC9\u0ACB\u0ACD"
        + "\u0AE0\u0AE0\u0AE6\u0AEF\u0B01\u0B03\u0B05\u0B0C\u0B0F\u0B10\u0B13\u0B28\u0B2A\u0B30\u0B32\u0B33\u0B36\u0B39\u0B3C\u0B43"
        + "\u0B47\u0B48\u0B4B\u0B4D\u0B56\u0B57\u0B5C\u0B5D\u0B5F\u0B61\u0B66\u0B6F\u0B82\u0B83\u0B85\u0B8A\u0B8E\u0B90\u0B92\u0B95"
        + "\u0B99\u0B9A\u0B9C\u0B9C\u0B9E\u0B9F\u0BA3\u0BA4\u0BA8\u0BAA\u0BAE\u0BB5\u0BB7\u0BB9\u0BBE\u0BC2\u0BC6\u0BC8\u0BCA\u0BCD"
        + "\u0BD7\u0BD7\u0BE7\u0BEF\u0C01\u0C03\u0C05\u0C0C\u0C0E\u0C10\u0C12\u0C28\u0C2A\u0C33\u0C35\u0C39\u0C3E\u0C44\u0C46\u0C48"
        + "\u0C4A\u0C4D\u0C55\u0C56\u0C60\u0C61\u0C66\u0C6F\u0C82\u0C83\u0C85\u0C8C\u0C8E\u0C90\u0C92\u0CA8\u0CAA\u0CB3\u0CB5\u0CB9"
        + "\u0CBE\u0CC4\u0CC6\u0CC8\u0CCA\u0CCD\u0CD5\u0CD6\u0CDE\u0CDE\u0CE0\u0CE1\u0CE6\u0CEF\u0D02\u0D03\u0D05\u0D0C\u0D0E\u0D10"
        + "\u0D12\u0D28\u0D2A\u0D39\u0D3E\u0D43\u0D46\u0D48\u0D4A\u0D4D\u0D57\u0D57\u0D60\u0D61\u0D66\u0D6F\u0E01\u0E2E\u0E30\u0E3A"
        + "\u0E40\u0E4E\u0E50\u0E59\u0E81\u0E82\u0E84\u0E84\u0E87\u0E88\u0E8A\u0E8A\u0E8D\u0E8D\u0E94\u0E97\u0E99\u0E9F\u0EA1\u0EA3"
        + "\u0EA5\u0EA5\u0EA7\u0EA7\u0EAA\u0EAB\u0EAD\u0EAE\u0EB0\u0EB9\u0EBB\u0EBD\u0EC0\u0EC4\u0EC6\u0EC6\u0EC8\u0ECD\u0ED0\u0ED9"
        + "\u0F18\u0F19\u0F20\u0F29\u0F35\u0F35\u0F37\u0F37\u0F39\u0F39\u0F3E\u0F47\u0F49\u0F69\u0F71\u0F84\u0F86\u0F8B\u0F90\u0F95"
        + "\u0F97\u0F97\u0F99\u0FAD\u0FB1\u0FB7\u0FB9\u0FB9\u10A0\u10C5\u10D0\u10F6\u1100\u1100\u1102\u1103\u1105\u1107\u1109\u1109"
        + "\u110B\u110C\u110E\u1112\u113C\u113C\u113E\u113E\u1140\u1140\u114C\u114C\u114E\u114E\u1150\u1150\u1154\u1155\u1159\u1159"
        + "\u115F\u1161\u1163\u1163\u1165\u1165\u1167\u1167\u1169\u1169\u116D\u116E\u1172\u1173\u1175\u1175\u119E\u119E\u11A8\u11A8"
        + "\u11AB\u11AB\u11AE\u11AF\u11B7\u11B8\u11BA\u11BA\u11BC\u11C2\u11EB\u11EB\u11F0\u11F0\u11F9\u11F9\u1E00\u1E9B\u1EA0\u1EF9"
        + "\u1F00\u1F15\u1F18\u1F1D\u1F20\u1F45\u1F48\u1F4D\u1F50\u1F57\u1F59\u1F59\u1F5B\u1F5B\u1F5D\u1F5D\u1F5F\u1F7D\u1F80\u1FB4"
        + "\u1FB6\u1FBC\u1FBE\u1FBE\u1FC2\u1FC4\u1FC6\u1FCC\u1FD0\u1FD3\u1FD6\u1FDB\u1FE0\u1FEC\u1FF2\u1FF4\u1FF6\u1FFC\u20D0\u20DC"
        + "\u20E1\u20E1\u2126\u2126\u212A\u212B\u212E\u212E\u2180\u2182\u3005\u3005\u3007\u3007\u3021\u302F\u3031\u3035\u3041\u3094"
        + "\u3099\u309A\u309D\u309E\u30A1\u30FA\u30FC\u30FE\u3105\u312C\u4E00\u9FA5\uAC00\uD7A3";

    const string XmlDigits =
          "\u0030\u0039\u0660\u0669\u06F0\u06F9\u0966\u096F\u09E6\u09EF\u0A66\u0A6F\u0AE6\u0AEF\u0B66\u0B6F\u0BE7\u0BEF\u0C66\u0C6F"
        + "\u0CE6\u0CEF\u0D66\u0D6F\u0E50\u0E59\u0ED0\u0ED9\u0F20\u0F29\u1040\u1049\u1369\u1371\u17E0\u17E9\u1810\u1819\uFF10\uFF19";

    const string XmlNameStarts =
          "\u003A\u003A\u0041\u005A\u005F\u005F\u0061\u007A\u00C0\u00D6\u00D8\u00F6\u00F8\u0131\u0134\u013E\u0141\u0148\u014A\u017E"
        + "\u0180\u01C3\u01CD\u01F0\u01F4\u01F5\u01FA\u0217\u0250\u02A8\u02BB\u02C1\u0386\u0386\u0388\u038A\u038C\u038C\u038E\u03A1"
        + "\u03A3\u03CE\u03D0\u03D6\u03DA\u03DA\u03DC\u03DC\u03DE\u03DE\u03E0\u03E0\u03E2\u03F3\u0401\u040C\u040E\u044F\u0451\u045C"
        + "\u045E\u0481\u0490\u04C4\u04C7\u04C8\u04CB\u04CC\u04D0\u04EB\u04EE\u04F5\u04F8\u04F9\u0531\u0556\u0559\u0559\u0561\u0586"
        + "\u05D0\u05EA\u05F0\u05F2\u0621\u063A\u0641\u064A\u0671\u06B7\u06BA\u06BE\u06C0\u06CE\u06D0\u06D3\u06D5\u06D5\u06E5\u06E6"
        + "\u0905\u0939\u093D\u093D\u0958\u0961\u0985\u098C\u098F\u0990\u0993\u09A8\u09AA\u09B0\u09B2\u09B2\u09B6\u09B9\u09DC\u09DD"
        + "\u09DF\u09E1\u09F0\u09F1\u0A05\u0A0A\u0A0F\u0A10\u0A13\u0A28\u0A2A\u0A30\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A59\u0A5C"
        + "\u0A5E\u0A5E\u0A72\u0A74\u0A85\u0A8B\u0A8D\u0A8D\u0A8F\u0A91\u0A93\u0AA8\u0AAA\u0AB0\u0AB2\u0AB3\u0AB5\u0AB9\u0ABD\u0ABD"
        + "\u0AE0\u0AE0\u0B05\u0B0C\u0B0F\u0B10\u0B13\u0B28\u0B2A\u0B30\u0B32\u0B33\u0B36\u0B39\u0B3D\u0B3D\u0B5C\u0B5D\u0B5F\u0B61"
        + "\u0B85\u0B8A\u0B8E\u0B90\u0B92\u0B95\u0B99\u0B9A\u0B9C\u0B9C\u0B9E\u0B9F\u0BA3\u0BA4\u0BA8\u0BAA\u0BAE\u0BB5\u0BB7\u0BB9"
        + "\u0C05\u0C0C\u0C0E\u0C10\u0C12\u0C28\u0C2A\u0C33\u0C35\u0C39\u0C60\u0C61\u0C85\u0C8C\u0C8E\u0C90\u0C92\u0CA8\u0CAA\u0CB3"
        + "\u0CB5\u0CB9\u0CDE\u0CDE\u0CE0\u0CE1\u0D05\u0D0C\u0D0E\u0D10\u0D12\u0D28\u0D2A\u0D39\u0D60\u0D61\u0E01\u0E2E\u0E30\u0E30"
        + "\u0E32\u0E33\u0E40\u0E45\u0E81\u0E82\u0E84\u0E84\u0E87\u0E88\u0E8A\u0E8A\u0E8D\u0E8D\u0E94\u0E97\u0E99\u0E9F\u0EA1\u0EA3"
        + "\u0EA5\u0EA5\u0EA7\u0EA7\u0EAA\u0EAB\u0EAD\u0EAE\u0EB0\u0EB0\u0EB2\u0EB3\u0EBD\u0EBD\u0EC0\u0EC4\u0F40\u0F47\u0F49\u0F69"
        + "\u10A0\u10C5\u10D0\u10F6\u1100\u1100\u1102\u1103\u1105\u1107\u1109\u1109\u110B\u110C\u110E\u1112\u113C\u113C\u113E\u113E"
        + "\u1140\u1140\u114C\u114C\u114E\u114E\u1150\u1150\u1154\u1155\u1159\u1159\u115F\u1161\u1163\u1163\u1165\u1165\u1167\u1167"
        + "\u1169\u1169\u116D\u116E\u1172\u1173\u1175\u1175\u119E\u119E\u11A8\u11A8\u11AB\u11AB\u11AE\u11AF\u11B7\u11B8\u11BA\u11BA"
        + "\u11BC\u11C2\u11EB\u11EB\u11F0\u11F0\u11F9\u11F9\u1E00\u1E9B\u1EA0\u1EF9\u1F00\u1F15\u1F18\u1F1D\u1F20\u1F45\u1F48\u1F4D"
        + "\u1F50\u1F57\u1F59\u1F59\u1F5B\u1F5B\u1F5D\u1F5D\u1F5F\u1F7D\u1F80\u1FB4\u1FB6\u1FBC\u1FBE\u1FBE\u1FC2\u1FC4\u1FC6\u1FCC"
        + "\u1FD0\u1FD3\u1FD6\u1FDB\u1FE0\u1FEC\u1FF2\u1FF4\u1FF6\u1FFC\u2126\u2126\u212A\u212B\u212E\u212E\u2180\u2182\u3007\u3007"
        + "\u3021\u3029\u3041\u3094\u30A1\u30FA\u3105\u312C\u4E00\u9FA5\uAC00\uD7A3";

    const string XmlWordChars =
          "\u0024\u0024\u002B\u002B\u0030\u0039\u003C\u003E\u0041\u005A\u005E\u005E\u0060\u007A\u007C\u007C\u007E\u007E\u00A2\u00AA"
        + "\u00AC\u00AC\u00AE\u00B6\u00B8\u00BA\u00BC\u00BE\u00C0\u0220\u0222\u0233\u0250\u02AD\u02B0\u02EE\u0300\u034F\u0360\u036F"
        + "\u0374\u0375\u037A\u037A\u0384\u0386\u0388\u038A\u038C\u038C\u038E\u03A1\u03A3\u03CE\u03D0\u03F6\u0400\u0486\u0488\u04CE"
        + "\u04D0\u04F5\u04F8\u04F9\u0500\u050F\u0531\u0556\u0559\u0559\u0561\u0587\u0591\u05A1\u05A3\u05B9\u05BB\u05BD\u05BF\u05BF"
        + "\u05C1\u05C2\u05C4\u05C4\u05D0\u05EA\u05F0\u05F2\u0621\u063A\u0640\u0655\u0660\u0669\u066E\u06D3\u06D5\u06DC\u06DE\u06ED"
        + "\u06F0\u06FE\u0710\u072C\u0730\u074A\u0780\u07B1\u0901\u0903\u0905\u0939\u093C\u094D\u0950\u0954\u0958\u0963\u0966\u096F"
        + "\u0981\u0983\u0985\u098C\u098F\u0990\u0993\u09A8\u09AA\u09B0\u09B2\u09B2\u09B6\u09B9\u09BC\u09BC\u09BE\u09C4\u09C7\u09C8"
        + "\u09CB\u09CD\u09D7\u09D7\u09DC\u09DD\u09DF\u09E3\u09E6\u09FA\u0A02\u0A02\u0A05\u0A0A\u0A0F\u0A10\u0A13\u0A28\u0A2A\u0A30"
        + "\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A3C\u0A3C\u0A3E\u0A42\u0A47\u0A48\u0A4B\u0A4D\u0A59\u0A5C\u0A5E\u0A5E\u0A66\u0A74"
        + "\u0A81\u0A83\u0A85\u0A8B\u0A8D\u0A8D\u0A8F\u0A91\u0A93\u0AA8\u0AAA\u0AB0\u0AB2\u0AB3\u0AB5\u0AB9\u0ABC\u0AC5\u0AC7\u0AC9"
        + "\u0ACB\u0ACD\u0AD0\u0AD0\u0AE0\u0AE0\u0AE6\u0AEF\u0B01\u0B03\u0B05\u0B0C\u0B0F\u0B10\u0B13\u0B28\u0B2A\u0B30\u0B32\u0B33"
        + "\u0B36\u0B39\u0B3C\u0B43\u0B47\u0B48\u0B4B\u0B4D\u0B56\u0B57\u0B5C\u0B5D\u0B5F\u0B61\u0B66\u0B70\u0B82\u0B83\u0B85\u0B8A"
        + "\u0B8E\u0B90\u0B92\u0B95\u0B99\u0B9A\u0B9C\u0B9C\u0B9E\u0B9F\u0BA3\u0BA4\u0BA8\u0BAA\u0BAE\u0BB5\u0BB7\u0BB9\u0BBE\u0BC2"
        + "\u0BC6\u0BC8\u0BCA\u0BCD\u0BD7\u0BD7\u0BE7\u0BF2\u0C01\u0C03\u0C05\u0C0C\u0C0E\u0C10\u0C12\u0C28\u0C2A\u0C33\u0C35\u0C39"
        + "\u0C3E\u0C44\u0C46\u0C48\u0C4A\u0C4D\u0C55\u0C56\u0C60\u0C61\u0C66\u0C6F\u0C82\u0C83\u0C85\u0C8C\u0C8E\u0C90\u0C92\u0CA8"
        + "\u0CAA\u0CB3\u0CB5\u0CB9\u0CBE\u0CC4\u0CC6\u0CC8\u0CCA\u0CCD\u0CD5\u0CD6\u0CDE\u0CDE\u0CE0\u0CE1\u0CE6\u0CEF\u0D02\u0D03"
        + "\u0D05\u0D0C\u0D0E\u0D10\u0D12\u0D28\u0D2A\u0D39\u0D3E\u0D43\u0D46\u0D48\u0D4A\u0D4D\u0D57\u0D57\u0D60\u0D61\u0D66\u0D6F"
        + "\u0D82\u0D83\u0D85\u0D96\u0D9A\u0DB1\u0DB3\u0DBB\u0DBD\u0DBD\u0DC0\u0DC6\u0DCA\u0DCA\u0DCF\u0DD4\u0DD6\u0DD6\u0DD8\u0DDF"
        + "\u0DF2\u0DF3\u0E01\u0E3A\u0E3F\u0E4E\u0E50\u0E59\u0E81\u0E82\u0E84\u0E84\u0E87\u0E88\u0E8A\u0E8A\u0E8D\u0E8D\u0E94\u0E97"
        + "\u0E99\u0E9F\u0EA1\u0EA3\u0EA5\u0EA5\u0EA7\u0EA7\u0EAA\u0EAB\u0EAD\u0EB9\u0EBB\u0EBD\u0EC0\u0EC4\u0EC6\u0EC6\u0EC8\u0ECD"
        + "\u0ED0\u0ED9\u0EDC\u0EDD\u0F00\u0F03\u0F13\u0F39\u0F3E\u0F47\u0F49\u0F6A\u0F71\u0F84\u0F86\u0F8B\u0F90\u0F97\u0F99\u0FBC"
        + "\u0FBE\u0FCC\u0FCF\u0FCF\u1000\u1021\u1023\u1027\u1029\u102A\u102C\u1032\u1036\u1039\u1040\u1049\u1050\u1059\u10A0\u10C5"
        + "\u10D0\u10F8\u1100\u1159\u115F\u11A2\u11A8\u11F9\u1200\u1206\u1208\u1246\u1248\u1248\u124A\u124D\u1250\u1256\u1258\u1258"
        + "\u125A\u125D\u1260\u1286\u1288\u1288\u128A\u128D\u1290\u12AE\u12B0\u12B0\u12B2\u12B5\u12B8\u12BE\u12C0\u12C0\u12C2\u12C5"
        + "\u12C8\u12CE\u12D0\u12D6\u12D8\u12EE\u12F0\u130E\u1310\u1310\u1312\u1315\u1318\u131E\u1320\u1346\u1348\u135A\u1369\u137C"
        + "\u13A0\u13F4\u1401\u166C\u166F\u1676\u1681\u169A\u16A0\u16EA\u16EE\u16F0\u1700\u170C\u170E\u1714\u1720\u1734\u1740\u1753"
        + "\u1760\u176C\u176E\u1770\u1772\u1773\u1780\u17D3\u17D7\u17D7\u17DB\u17DC\u17E0\u17E9\u180B\u180D\u1810\u1819\u1820\u1877"
        + "\u1880\u18A9\u1E00\u1E9B\u1EA0\u1EF9\u1F00\u1F15\u1F18\u1F1D\u1F20\u1F45\u1F48\u1F4D\u1F50\u1F57\u1F59\u1F59\u1F5B\u1F5B"
        + "\u1F5D\u1F5D\u1F5F\u1F7D\u1F80\u1FB4\u1FB6\u1FC4\u1FC6\u1FD3\u1FD6\u1FDB\u1FDD\u1FEF\u1FF2\u1FF4\u1FF6\u1FFE\u2044\u2044"
        + "\u2052\u2052\u2070\u2071\u2074\u207C\u207F\u208C\u20A0\u20B1\u20D0\u20EA\u2100\u213A\u213D\u214B\u2153\u2183\u2190\u2328"
        + "\u232B\u23B3\u23B7\u23CE\u2400\u2426\u2440\u244A\u2460\u24FE\u2500\u2613\u2616\u2617\u2619\u267D\u2680\u2689\u2701\u2704"
        + "\u2706\u2709\u270C\u2727\u2729\u274B\u274D\u274D\u274F\u2752\u2756\u2756\u2758\u275E\u2761\u2767\u2776\u2794\u2798\u27AF"
        + "\u27B1\u27BE\u27D0\u27E5\u27F0\u2982\u2999\u29D7\u29DC\u29FB\u29FE\u2AFF\u2E80\u2E99\u2E9B\u2EF3\u2F00\u2FD5\u2FF0\u2FFB"
        + "\u3004\u3007\u3012\u3013\u3020\u302F\u3031\u303C\u303E\u303F\u3041\u3096\u3099\u309F\u30A1\u30FA\u30FC\u30FF\u3105\u312C"
        + "\u3131\u318E\u3190\u31B7\u31F0\u321C\u3220\u3243\u3251\u327B\u327F\u32CB\u32D0\u32FE\u3300\u3376\u337B\u33DD\u33E0\u33FE"
        + "\u3400\u4DB5\u4E00\u9FA5\uA000\uA48C\uA490\uA4C6\uAC00\uD7A3\uF900\uFA2D\uFA30\uFA6A\uFB00\uFB06\uFB13\uFB17\uFB1D\uFB36"
        + "\uFB38\uFB3C\uFB3E\uFB3E\uFB40\uFB41\uFB43\uFB44\uFB46\uFBB1\uFBD3\uFD3D\uFD50\uFD8F\uFD92\uFDC7\uFDF0\uFDFC\uFE00\uFE0F"
        + "\uFE20\uFE23\uFE62\uFE62\uFE64\uFE66\uFE69\uFE69\uFE70\uFE74\uFE76\uFEFC\uFF04\uFF04\uFF0B\uFF0B\uFF10\uFF19\uFF1C\uFF1E"
        + "\uFF21\uFF3A\uFF3E\uFF3E\uFF40\uFF5A\uFF5C\uFF5C\uFF5E\uFF5E\uFF66\uFFBE\uFFC2\uFFC7\uFFCA\uFFCF\uFFD2\uFFD7\uFFDA\uFFDC"
        + "\uFFE0\uFFE6\uFFE8\uFFEE\uFFFC\uFFFD";
}

/// .NET's case equivalences for IgnoreCase, invariant culture: for each
/// character that has any, the one or two others a pattern's letter also
/// matches -- 'k' with 'K' and the Kelvin sign, 'ß' with 'ẞ', but not 'ς'
/// with 'σ', nor 'i' with 'İ'. Three units an entry, sorted: the character
/// and two equivalents, the second the character itself when it has one.
static class RegexCaseEquivalences
{
    const string Table =
          "\u0041\u0061\u0041\u0042\u0062\u0042\u0043\u0063\u0043\u0044\u0064\u0044\u0045\u0065\u0045\u0046\u0066\u0046\u0047\u0067\u0047"
        + "\u0048\u0068\u0048\u0049\u0069\u0049\u004A\u006A\u004A\u004B\u006B\u212A\u004C\u006C\u004C\u004D\u006D\u004D\u004E\u006E\u004E"
        + "\u004F\u006F\u004F\u0050\u0070\u0050\u0051\u0071\u0051\u0052\u0072\u0052\u0053\u0073\u0053\u0054\u0074\u0054\u0055\u0075\u0055"
        + "\u0056\u0076\u0056\u0057\u0077\u0057\u0058\u0078\u0058\u0059\u0079\u0059\u005A\u007A\u005A\u0061\u0041\u0061\u0062\u0042\u0062"
        + "\u0063\u0043\u0063\u0064\u0044\u0064\u0065\u0045\u0065\u0066\u0046\u0066\u0067\u0047\u0067\u0068\u0048\u0068\u0069\u0049\u0069"
        + "\u006A\u004A\u006A\u006B\u004B\u212A\u006C\u004C\u006C\u006D\u004D\u006D\u006E\u004E\u006E\u006F\u004F\u006F\u0070\u0050\u0070"
        + "\u0071\u0051\u0071\u0072\u0052\u0072\u0073\u0053\u0073\u0074\u0054\u0074\u0075\u0055\u0075\u0076\u0056\u0076\u0077\u0057\u0077"
        + "\u0078\u0058\u0078\u0079\u0059\u0079\u007A\u005A\u007A\u00C0\u00E0\u00C0\u00C1\u00E1\u00C1\u00C2\u00E2\u00C2\u00C3\u00E3\u00C3"
        + "\u00C4\u00E4\u00C4\u00C5\u00E5\u212B\u00C6\u00E6\u00C6\u00C7\u00E7\u00C7\u00C8\u00E8\u00C8\u00C9\u00E9\u00C9\u00CA\u00EA\u00CA"
        + "\u00CB\u00EB\u00CB\u00CC\u00EC\u00CC\u00CD\u00ED\u00CD\u00CE\u00EE\u00CE\u00CF\u00EF\u00CF\u00D0\u00F0\u00D0\u00D1\u00F1\u00D1"
        + "\u00D2\u00F2\u00D2\u00D3\u00F3\u00D3\u00D4\u00F4\u00D4\u00D5\u00F5\u00D5\u00D6\u00F6\u00D6\u00D8\u00F8\u00D8\u00D9\u00F9\u00D9"
        + "\u00DA\u00FA\u00DA\u00DB\u00FB\u00DB\u00DC\u00FC\u00DC\u00DD\u00FD\u00DD\u00DE\u00FE\u00DE\u00DF\u1E9E\u00DF\u00E0\u00C0\u00E0"
        + "\u00E1\u00C1\u00E1\u00E2\u00C2\u00E2\u00E3\u00C3\u00E3\u00E4\u00C4\u00E4\u00E5\u00C5\u212B\u00E6\u00C6\u00E6\u00E7\u00C7\u00E7"
        + "\u00E8\u00C8\u00E8\u00E9\u00C9\u00E9\u00EA\u00CA\u00EA\u00EB\u00CB\u00EB\u00EC\u00CC\u00EC\u00ED\u00CD\u00ED\u00EE\u00CE\u00EE"
        + "\u00EF\u00CF\u00EF\u00F0\u00D0\u00F0\u00F1\u00D1\u00F1\u00F2\u00D2\u00F2\u00F3\u00D3\u00F3\u00F4\u00D4\u00F4\u00F5\u00D5\u00F5"
        + "\u00F6\u00D6\u00F6\u00F8\u00D8\u00F8\u00F9\u00D9\u00F9\u00FA\u00DA\u00FA\u00FB\u00DB\u00FB\u00FC\u00DC\u00FC\u00FD\u00DD\u00FD"
        + "\u00FE\u00DE\u00FE\u00FF\u0178\u00FF\u0100\u0101\u0100\u0101\u0100\u0101\u0102\u0103\u0102\u0103\u0102\u0103\u0104\u0105\u0104"
        + "\u0105\u0104\u0105\u0106\u0107\u0106\u0107\u0106\u0107\u0108\u0109\u0108\u0109\u0108\u0109\u010A\u010B\u010A\u010B\u010A\u010B"
        + "\u010C\u010D\u010C\u010D\u010C\u010D\u010E\u010F\u010E\u010F\u010E\u010F\u0110\u0111\u0110\u0111\u0110\u0111\u0112\u0113\u0112"
        + "\u0113\u0112\u0113\u0114\u0115\u0114\u0115\u0114\u0115\u0116\u0117\u0116\u0117\u0116\u0117\u0118\u0119\u0118\u0119\u0118\u0119"
        + "\u011A\u011B\u011A\u011B\u011A\u011B\u011C\u011D\u011C\u011D\u011C\u011D\u011E\u011F\u011E\u011F\u011E\u011F\u0120\u0121\u0120"
        + "\u0121\u0120\u0121\u0122\u0123\u0122\u0123\u0122\u0123\u0124\u0125\u0124\u0125\u0124\u0125\u0126\u0127\u0126\u0127\u0126\u0127"
        + "\u0128\u0129\u0128\u0129\u0128\u0129\u012A\u012B\u012A\u012B\u012A\u012B\u012C\u012D\u012C\u012D\u012C\u012D\u012E\u012F\u012E"
        + "\u012F\u012E\u012F\u0132\u0133\u0132\u0133\u0132\u0133\u0134\u0135\u0134\u0135\u0134\u0135\u0136\u0137\u0136\u0137\u0136\u0137"
        + "\u0139\u013A\u0139\u013A\u0139\u013A\u013B\u013C\u013B\u013C\u013B\u013C\u013D\u013E\u013D\u013E\u013D\u013E\u013F\u0140\u013F"
        + "\u0140\u013F\u0140\u0141\u0142\u0141\u0142\u0141\u0142\u0143\u0144\u0143\u0144\u0143\u0144\u0145\u0146\u0145\u0146\u0145\u0146"
        + "\u0147\u0148\u0147\u0148\u0147\u0148\u014A\u014B\u014A\u014B\u014A\u014B\u014C\u014D\u014C\u014D\u014C\u014D\u014E\u014F\u014E"
        + "\u014F\u014E\u014F\u0150\u0151\u0150\u0151\u0150\u0151\u0152\u0153\u0152\u0153\u0152\u0153\u0154\u0155\u0154\u0155\u0154\u0155"
        + "\u0156\u0157\u0156\u0157\u0156\u0157\u0158\u0159\u0158\u0159\u0158\u0159\u015A\u015B\u015A\u015B\u015A\u015B\u015C\u015D\u015C"
        + "\u015D\u015C\u015D\u015E\u015F\u015E\u015F\u015E\u015F\u0160\u0161\u0160\u0161\u0160\u0161\u0162\u0163\u0162\u0163\u0162\u0163"
        + "\u0164\u0165\u0164\u0165\u0164\u0165\u0166\u0167\u0166\u0167\u0166\u0167\u0168\u0169\u0168\u0169\u0168\u0169\u016A\u016B\u016A"
        + "\u016B\u016A\u016B\u016C\u016D\u016C\u016D\u016C\u016D\u016E\u016F\u016E\u016F\u016E\u016F\u0170\u0171\u0170\u0171\u0170\u0171"
        + "\u0172\u0173\u0172\u0173\u0172\u0173\u0174\u0175\u0174\u0175\u0174\u0175\u0176\u0177\u0176\u0177\u0176\u0177\u0178\u00FF\u0178"
        + "\u0179\u017A\u0179\u017A\u0179\u017A\u017B\u017C\u017B\u017C\u017B\u017C\u017D\u017E\u017D\u017E\u017D\u017E\u0180\u0243\u0180"
        + "\u0181\u0253\u0181\u0182\u0183\u0182\u0183\u0182\u0183\u0184\u0185\u0184\u0185\u0184\u0185\u0186\u0254\u0186\u0187\u0188\u0187"
        + "\u0188\u0187\u0188\u0189\u0256\u0189\u018A\u0257\u018A\u018B\u018C\u018B\u018C\u018B\u018C\u018E\u01DD\u018E\u018F\u0259\u018F"
        + "\u0190\u025B\u0190\u0191\u0192\u0191\u0192\u0191\u0192\u0193\u0260\u0193\u0194\u0263\u0194\u0195\u01F6\u0195\u0196\u0269\u0196"
        + "\u0197\u0268\u0197\u0198\u0199\u0198\u0199\u0198\u0199\u019A\u023D\u019A\u019B\uA7DC\u019B\u019C\u026F\u019C\u019D\u0272\u019D"
        + "\u019E\u0220\u019E\u019F\u0275\u019F\u01A0\u01A1\u01A0\u01A1\u01A0\u01A1\u01A2\u01A3\u01A2\u01A3\u01A2\u01A3\u01A4\u01A5\u01A4"
        + "\u01A5\u01A4\u01A5\u01A6\u0280\u01A6\u01A7\u01A8\u01A7\u01A8\u01A7\u01A8\u01A9\u0283\u01A9\u01AC\u01AD\u01AC\u01AD\u01AC\u01AD"
        + "\u01AE\u0288\u01AE\u01AF\u01B0\u01AF\u01B0\u01AF\u01B0\u01B1\u028A\u01B1\u01B2\u028B\u01B2\u01B3\u01B4\u01B3\u01B4\u01B3\u01B4"
        + "\u01B5\u01B6\u01B5\u01B6\u01B5\u01B6\u01B7\u0292\u01B7\u01B8\u01B9\u01B8\u01B9\u01B8\u01B9\u01BC\u01BD\u01BC\u01BD\u01BC\u01BD"
        + "\u01BF\u01F7\u01BF\u01C4\u01C5\u01C6\u01C5\u01C4\u01C6\u01C6\u01C4\u01C5\u01C7\u01C8\u01C9\u01C8\u01C7\u01C9\u01C9\u01C7\u01C8"
        + "\u01CA\u01CB\u01CC\u01CB\u01CA\u01CC\u01CC\u01CA\u01CB\u01CD\u01CE\u01CD\u01CE\u01CD\u01CE\u01CF\u01D0\u01CF\u01D0\u01CF\u01D0"
        + "\u01D1\u01D2\u01D1\u01D2\u01D1\u01D2\u01D3\u01D4\u01D3\u01D4\u01D3\u01D4\u01D5\u01D6\u01D5\u01D6\u01D5\u01D6\u01D7\u01D8\u01D7"
        + "\u01D8\u01D7\u01D8\u01D9\u01DA\u01D9\u01DA\u01D9\u01DA\u01DB\u01DC\u01DB\u01DC\u01DB\u01DC\u01DD\u018E\u01DD\u01DE\u01DF\u01DE"
        + "\u01DF\u01DE\u01DF\u01E0\u01E1\u01E0\u01E1\u01E0\u01E1\u01E2\u01E3\u01E2\u01E3\u01E2\u01E3\u01E4\u01E5\u01E4\u01E5\u01E4\u01E5"
        + "\u01E6\u01E7\u01E6\u01E7\u01E6\u01E7\u01E8\u01E9\u01E8\u01E9\u01E8\u01E9\u01EA\u01EB\u01EA\u01EB\u01EA\u01EB\u01EC\u01ED\u01EC"
        + "\u01ED\u01EC\u01ED\u01EE\u01EF\u01EE\u01EF\u01EE\u01EF\u01F1\u01F2\u01F3\u01F2\u01F1\u01F3\u01F3\u01F1\u01F2\u01F4\u01F5\u01F4"
        + "\u01F5\u01F4\u01F5\u01F6\u0195\u01F6\u01F7\u01BF\u01F7\u01F8\u01F9\u01F8\u01F9\u01F8\u01F9\u01FA\u01FB\u01FA\u01FB\u01FA\u01FB"
        + "\u01FC\u01FD\u01FC\u01FD\u01FC\u01FD\u01FE\u01FF\u01FE\u01FF\u01FE\u01FF\u0200\u0201\u0200\u0201\u0200\u0201\u0202\u0203\u0202"
        + "\u0203\u0202\u0203\u0204\u0205\u0204\u0205\u0204\u0205\u0206\u0207\u0206\u0207\u0206\u0207\u0208\u0209\u0208\u0209\u0208\u0209"
        + "\u020A\u020B\u020A\u020B\u020A\u020B\u020C\u020D\u020C\u020D\u020C\u020D\u020E\u020F\u020E\u020F\u020E\u020F\u0210\u0211\u0210"
        + "\u0211\u0210\u0211\u0212\u0213\u0212\u0213\u0212\u0213\u0214\u0215\u0214\u0215\u0214\u0215\u0216\u0217\u0216\u0217\u0216\u0217"
        + "\u0218\u0219\u0218\u0219\u0218\u0219\u021A\u021B\u021A\u021B\u021A\u021B\u021C\u021D\u021C\u021D\u021C\u021D\u021E\u021F\u021E"
        + "\u021F\u021E\u021F\u0220\u019E\u0220\u0222\u0223\u0222\u0223\u0222\u0223\u0224\u0225\u0224\u0225\u0224\u0225\u0226\u0227\u0226"
        + "\u0227\u0226\u0227\u0228\u0229\u0228\u0229\u0228\u0229\u022A\u022B\u022A\u022B\u022A\u022B\u022C\u022D\u022C\u022D\u022C\u022D"
        + "\u022E\u022F\u022E\u022F\u022E\u022F\u0230\u0231\u0230\u0231\u0230\u0231\u0232\u0233\u0232\u0233\u0232\u0233\u023A\u2C65\u023A"
        + "\u023B\u023C\u023B\u023C\u023B\u023C\u023D\u019A\u023D\u023E\u2C66\u023E\u023F\u2C7E\u023F\u0240\u2C7F\u0240\u0241\u0242\u0241"
        + "\u0242\u0241\u0242\u0243\u0180\u0243\u0244\u0289\u0244\u0245\u028C\u0245\u0246\u0247\u0246\u0247\u0246\u0247\u0248\u0249\u0248"
        + "\u0249\u0248\u0249\u024A\u024B\u024A\u024B\u024A\u024B\u024C\u024D\u024C\u024D\u024C\u024D\u024E\u024F\u024E\u024F\u024E\u024F"
        + "\u0250\u2C6F\u0250\u0251\u2C6D\u0251\u0252\u2C70\u0252\u0253\u0181\u0253\u0254\u0186\u0254\u0256\u0189\u0256\u0257\u018A\u0257"
        + "\u0259\u018F\u0259\u025B\u0190\u025B\u025C\uA7AB\u025C\u0260\u0193\u0260\u0261\uA7AC\u0261\u0263\u0194\u0263\u0264\uA7CB\u0264"
        + "\u0265\uA78D\u0265\u0266\uA7AA\u0266\u0268\u0197\u0268\u0269\u0196\u0269\u026A\uA7AE\u026A\u026B\u2C62\u026B\u026C\uA7AD\u026C"
        + "\u026F\u019C\u026F\u0271\u2C6E\u0271\u0272\u019D\u0272\u0275\u019F\u0275\u027D\u2C64\u027D\u0280\u01A6\u0280\u0282\uA7C5\u0282"
        + "\u0283\u01A9\u0283\u0287\uA7B1\u0287\u0288\u01AE\u0288\u0289\u0244\u0289\u028A\u01B1\u028A\u028B\u01B2\u028B\u028C\u0245\u028C"
        + "\u0292\u01B7\u0292\u029D\uA7B2\u029D\u029E\uA7B0\u029E\u0370\u0371\u0370\u0371\u0370\u0371\u0372\u0373\u0372\u0373\u0372\u0373"
        + "\u0376\u0377\u0376\u0377\u0376\u0377\u037B\u03FD\u037B\u037C\u03FE\u037C\u037D\u03FF\u037D\u037F\u03F3\u037F\u0386\u03AC\u0386"
        + "\u0388\u03AD\u0388\u0389\u03AE\u0389\u038A\u03AF\u038A\u038C\u03CC\u038C\u038E\u03CD\u038E\u038F\u03CE\u038F\u0391\u03B1\u0391"
        + "\u0392\u03B2\u0392\u0393\u03B3\u0393\u0394\u03B4\u0394\u0395\u03B5\u0395\u0396\u03B6\u0396\u0397\u03B7\u0397\u0398\u03B8\u03F4"
        + "\u0399\u03B9\u0399\u039A\u03BA\u039A\u039B\u03BB\u039B\u039C\u03BC\u039C\u039D\u03BD\u039D\u039E\u03BE\u039E\u039F\u03BF\u039F"
        + "\u03A0\u03C0\u03A0\u03A1\u03C1\u03A1\u03A3\u03C3\u03A3\u03A4\u03C4\u03A4\u03A5\u03C5\u03A5\u03A6\u03C6\u03A6\u03A7\u03C7\u03A7"
        + "\u03A8\u03C8\u03A8\u03A9\u03C9\u2126\u03AA\u03CA\u03AA\u03AB\u03CB\u03AB\u03AC\u0386\u03AC\u03AD\u0388\u03AD\u03AE\u0389\u03AE"
        + "\u03AF\u038A\u03AF\u03B1\u0391\u03B1\u03B2\u0392\u03B2\u03B3\u0393\u03B3\u03B4\u0394\u03B4\u03B5\u0395\u03B5\u03B6\u0396\u03B6"
        + "\u03B7\u0397\u03B7\u03B8\u0398\u03F4\u03B9\u0399\u03B9\u03BA\u039A\u03BA\u03BB\u039B\u03BB\u03BC\u039C\u03BC\u03BD\u039D\u03BD"
        + "\u03BE\u039E\u03BE\u03BF\u039F\u03BF\u03C0\u03A0\u03C0\u03C1\u03A1\u03C1\u03C3\u03A3\u03C3\u03C4\u03A4\u03C4\u03C5\u03A5\u03C5"
        + "\u03C6\u03A6\u03C6\u03C7\u03A7\u03C7\u03C8\u03A8\u03C8\u03C9\u03A9\u2126\u03CA\u03AA\u03CA\u03CB\u03AB\u03CB\u03CC\u038C\u03CC"
        + "\u03CD\u038E\u03CD\u03CE\u038F\u03CE\u03CF\u03D7\u03CF\u03D7\u03CF\u03D7\u03D8\u03D9\u03D8\u03D9\u03D8\u03D9\u03DA\u03DB\u03DA"
        + "\u03DB\u03DA\u03DB\u03DC\u03DD\u03DC\u03DD\u03DC\u03DD\u03DE\u03DF\u03DE\u03DF\u03DE\u03DF\u03E0\u03E1\u03E0\u03E1\u03E0\u03E1"
        + "\u03E2\u03E3\u03E2\u03E3\u03E2\u03E3\u03E4\u03E5\u03E4\u03E5\u03E4\u03E5\u03E6\u03E7\u03E6\u03E7\u03E6\u03E7\u03E8\u03E9\u03E8"
        + "\u03E9\u03E8\u03E9\u03EA\u03EB\u03EA\u03EB\u03EA\u03EB\u03EC\u03ED\u03EC\u03ED\u03EC\u03ED\u03EE\u03EF\u03EE\u03EF\u03EE\u03EF"
        + "\u03F2\u03F9\u03F2\u03F3\u037F\u03F3\u03F4\u0398\u03B8\u03F7\u03F8\u03F7\u03F8\u03F7\u03F8\u03F9\u03F2\u03F9\u03FA\u03FB\u03FA"
        + "\u03FB\u03FA\u03FB\u03FD\u037B\u03FD\u03FE\u037C\u03FE\u03FF\u037D\u03FF\u0400\u0450\u0400\u0401\u0451\u0401\u0402\u0452\u0402"
        + "\u0403\u0453\u0403\u0404\u0454\u0404\u0405\u0455\u0405\u0406\u0456\u0406\u0407\u0457\u0407\u0408\u0458\u0408\u0409\u0459\u0409"
        + "\u040A\u045A\u040A\u040B\u045B\u040B\u040C\u045C\u040C\u040D\u045D\u040D\u040E\u045E\u040E\u040F\u045F\u040F\u0410\u0430\u0410"
        + "\u0411\u0431\u0411\u0412\u0432\u0412\u0413\u0433\u0413\u0414\u0434\u0414\u0415\u0435\u0415\u0416\u0436\u0416\u0417\u0437\u0417"
        + "\u0418\u0438\u0418\u0419\u0439\u0419\u041A\u043A\u041A\u041B\u043B\u041B\u041C\u043C\u041C\u041D\u043D\u041D\u041E\u043E\u041E"
        + "\u041F\u043F\u041F\u0420\u0440\u0420\u0421\u0441\u0421\u0422\u0442\u0422\u0423\u0443\u0423\u0424\u0444\u0424\u0425\u0445\u0425"
        + "\u0426\u0446\u0426\u0427\u0447\u0427\u0428\u0448\u0428\u0429\u0449\u0429\u042A\u044A\u042A\u042B\u044B\u042B\u042C\u044C\u042C"
        + "\u042D\u044D\u042D\u042E\u044E\u042E\u042F\u044F\u042F\u0430\u0410\u0430\u0431\u0411\u0431\u0432\u0412\u0432\u0433\u0413\u0433"
        + "\u0434\u0414\u0434\u0435\u0415\u0435\u0436\u0416\u0436\u0437\u0417\u0437\u0438\u0418\u0438\u0439\u0419\u0439\u043A\u041A\u043A"
        + "\u043B\u041B\u043B\u043C\u041C\u043C\u043D\u041D\u043D\u043E\u041E\u043E\u043F\u041F\u043F\u0440\u0420\u0440\u0441\u0421\u0441"
        + "\u0442\u0422\u0442\u0443\u0423\u0443\u0444\u0424\u0444\u0445\u0425\u0445\u0446\u0426\u0446\u0447\u0427\u0447\u0448\u0428\u0448"
        + "\u0449\u0429\u0449\u044A\u042A\u044A\u044B\u042B\u044B\u044C\u042C\u044C\u044D\u042D\u044D\u044E\u042E\u044E\u044F\u042F\u044F"
        + "\u0450\u0400\u0450\u0451\u0401\u0451\u0452\u0402\u0452\u0453\u0403\u0453\u0454\u0404\u0454\u0455\u0405\u0455\u0456\u0406\u0456"
        + "\u0457\u0407\u0457\u0458\u0408\u0458\u0459\u0409\u0459\u045A\u040A\u045A\u045B\u040B\u045B\u045C\u040C\u045C\u045D\u040D\u045D"
        + "\u045E\u040E\u045E\u045F\u040F\u045F\u0460\u0461\u0460\u0461\u0460\u0461\u0462\u0463\u0462\u0463\u0462\u0463\u0464\u0465\u0464"
        + "\u0465\u0464\u0465\u0466\u0467\u0466\u0467\u0466\u0467\u0468\u0469\u0468\u0469\u0468\u0469\u046A\u046B\u046A\u046B\u046A\u046B"
        + "\u046C\u046D\u046C\u046D\u046C\u046D\u046E\u046F\u046E\u046F\u046E\u046F\u0470\u0471\u0470\u0471\u0470\u0471\u0472\u0473\u0472"
        + "\u0473\u0472\u0473\u0474\u0475\u0474\u0475\u0474\u0475\u0476\u0477\u0476\u0477\u0476\u0477\u0478\u0479\u0478\u0479\u0478\u0479"
        + "\u047A\u047B\u047A\u047B\u047A\u047B\u047C\u047D\u047C\u047D\u047C\u047D\u047E\u047F\u047E\u047F\u047E\u047F\u0480\u0481\u0480"
        + "\u0481\u0480\u0481\u048A\u048B\u048A\u048B\u048A\u048B\u048C\u048D\u048C\u048D\u048C\u048D\u048E\u048F\u048E\u048F\u048E\u048F"
        + "\u0490\u0491\u0490\u0491\u0490\u0491\u0492\u0493\u0492\u0493\u0492\u0493\u0494\u0495\u0494\u0495\u0494\u0495\u0496\u0497\u0496"
        + "\u0497\u0496\u0497\u0498\u0499\u0498\u0499\u0498\u0499\u049A\u049B\u049A\u049B\u049A\u049B\u049C\u049D\u049C\u049D\u049C\u049D"
        + "\u049E\u049F\u049E\u049F\u049E\u049F\u04A0\u04A1\u04A0\u04A1\u04A0\u04A1\u04A2\u04A3\u04A2\u04A3\u04A2\u04A3\u04A4\u04A5\u04A4"
        + "\u04A5\u04A4\u04A5\u04A6\u04A7\u04A6\u04A7\u04A6\u04A7\u04A8\u04A9\u04A8\u04A9\u04A8\u04A9\u04AA\u04AB\u04AA\u04AB\u04AA\u04AB"
        + "\u04AC\u04AD\u04AC\u04AD\u04AC\u04AD\u04AE\u04AF\u04AE\u04AF\u04AE\u04AF\u04B0\u04B1\u04B0\u04B1\u04B0\u04B1\u04B2\u04B3\u04B2"
        + "\u04B3\u04B2\u04B3\u04B4\u04B5\u04B4\u04B5\u04B4\u04B5\u04B6\u04B7\u04B6\u04B7\u04B6\u04B7\u04B8\u04B9\u04B8\u04B9\u04B8\u04B9"
        + "\u04BA\u04BB\u04BA\u04BB\u04BA\u04BB\u04BC\u04BD\u04BC\u04BD\u04BC\u04BD\u04BE\u04BF\u04BE\u04BF\u04BE\u04BF\u04C0\u04CF\u04C0"
        + "\u04C1\u04C2\u04C1\u04C2\u04C1\u04C2\u04C3\u04C4\u04C3\u04C4\u04C3\u04C4\u04C5\u04C6\u04C5\u04C6\u04C5\u04C6\u04C7\u04C8\u04C7"
        + "\u04C8\u04C7\u04C8\u04C9\u04CA\u04C9\u04CA\u04C9\u04CA\u04CB\u04CC\u04CB\u04CC\u04CB\u04CC\u04CD\u04CE\u04CD\u04CE\u04CD\u04CE"
        + "\u04CF\u04C0\u04CF\u04D0\u04D1\u04D0\u04D1\u04D0\u04D1\u04D2\u04D3\u04D2\u04D3\u04D2\u04D3\u04D4\u04D5\u04D4\u04D5\u04D4\u04D5"
        + "\u04D6\u04D7\u04D6\u04D7\u04D6\u04D7\u04D8\u04D9\u04D8\u04D9\u04D8\u04D9\u04DA\u04DB\u04DA\u04DB\u04DA\u04DB\u04DC\u04DD\u04DC"
        + "\u04DD\u04DC\u04DD\u04DE\u04DF\u04DE\u04DF\u04DE\u04DF\u04E0\u04E1\u04E0\u04E1\u04E0\u04E1\u04E2\u04E3\u04E2\u04E3\u04E2\u04E3"
        + "\u04E4\u04E5\u04E4\u04E5\u04E4\u04E5\u04E6\u04E7\u04E6\u04E7\u04E6\u04E7\u04E8\u04E9\u04E8\u04E9\u04E8\u04E9\u04EA\u04EB\u04EA"
        + "\u04EB\u04EA\u04EB\u04EC\u04ED\u04EC\u04ED\u04EC\u04ED\u04EE\u04EF\u04EE\u04EF\u04EE\u04EF\u04F0\u04F1\u04F0\u04F1\u04F0\u04F1"
        + "\u04F2\u04F3\u04F2\u04F3\u04F2\u04F3\u04F4\u04F5\u04F4\u04F5\u04F4\u04F5\u04F6\u04F7\u04F6\u04F7\u04F6\u04F7\u04F8\u04F9\u04F8"
        + "\u04F9\u04F8\u04F9\u04FA\u04FB\u04FA\u04FB\u04FA\u04FB\u04FC\u04FD\u04FC\u04FD\u04FC\u04FD\u04FE\u04FF\u04FE\u04FF\u04FE\u04FF"
        + "\u0500\u0501\u0500\u0501\u0500\u0501\u0502\u0503\u0502\u0503\u0502\u0503\u0504\u0505\u0504\u0505\u0504\u0505\u0506\u0507\u0506"
        + "\u0507\u0506\u0507\u0508\u0509\u0508\u0509\u0508\u0509\u050A\u050B\u050A\u050B\u050A\u050B\u050C\u050D\u050C\u050D\u050C\u050D"
        + "\u050E\u050F\u050E\u050F\u050E\u050F\u0510\u0511\u0510\u0511\u0510\u0511\u0512\u0513\u0512\u0513\u0512\u0513\u0514\u0515\u0514"
        + "\u0515\u0514\u0515\u0516\u0517\u0516\u0517\u0516\u0517\u0518\u0519\u0518\u0519\u0518\u0519\u051A\u051B\u051A\u051B\u051A\u051B"
        + "\u051C\u051D\u051C\u051D\u051C\u051D\u051E\u051F\u051E\u051F\u051E\u051F\u0520\u0521\u0520\u0521\u0520\u0521\u0522\u0523\u0522"
        + "\u0523\u0522\u0523\u0524\u0525\u0524\u0525\u0524\u0525\u0526\u0527\u0526\u0527\u0526\u0527\u0528\u0529\u0528\u0529\u0528\u0529"
        + "\u052A\u052B\u052A\u052B\u052A\u052B\u052C\u052D\u052C\u052D\u052C\u052D\u052E\u052F\u052E\u052F\u052E\u052F\u0531\u0561\u0531"
        + "\u0532\u0562\u0532\u0533\u0563\u0533\u0534\u0564\u0534\u0535\u0565\u0535\u0536\u0566\u0536\u0537\u0567\u0537\u0538\u0568\u0538"
        + "\u0539\u0569\u0539\u053A\u056A\u053A\u053B\u056B\u053B\u053C\u056C\u053C\u053D\u056D\u053D\u053E\u056E\u053E\u053F\u056F\u053F"
        + "\u0540\u0570\u0540\u0541\u0571\u0541\u0542\u0572\u0542\u0543\u0573\u0543\u0544\u0574\u0544\u0545\u0575\u0545\u0546\u0576\u0546"
        + "\u0547\u0577\u0547\u0548\u0578\u0548\u0549\u0579\u0549\u054A\u057A\u054A\u054B\u057B\u054B\u054C\u057C\u054C\u054D\u057D\u054D"
        + "\u054E\u057E\u054E\u054F\u057F\u054F\u0550\u0580\u0550\u0551\u0581\u0551\u0552\u0582\u0552\u0553\u0583\u0553\u0554\u0584\u0554"
        + "\u0555\u0585\u0555\u0556\u0586\u0556\u0561\u0531\u0561\u0562\u0532\u0562\u0563\u0533\u0563\u0564\u0534\u0564\u0565\u0535\u0565"
        + "\u0566\u0536\u0566\u0567\u0537\u0567\u0568\u0538\u0568\u0569\u0539\u0569\u056A\u053A\u056A\u056B\u053B\u056B\u056C\u053C\u056C"
        + "\u056D\u053D\u056D\u056E\u053E\u056E\u056F\u053F\u056F\u0570\u0540\u0570\u0571\u0541\u0571\u0572\u0542\u0572\u0573\u0543\u0573"
        + "\u0574\u0544\u0574\u0575\u0545\u0575\u0576\u0546\u0576\u0577\u0547\u0577\u0578\u0548\u0578\u0579\u0549\u0579\u057A\u054A\u057A"
        + "\u057B\u054B\u057B\u057C\u054C\u057C\u057D\u054D\u057D\u057E\u054E\u057E\u057F\u054F\u057F\u0580\u0550\u0580\u0581\u0551\u0581"
        + "\u0582\u0552\u0582\u0583\u0553\u0583\u0584\u0554\u0584\u0585\u0555\u0585\u0586\u0556\u0586\u10A0\u2D00\u10A0\u10A1\u2D01\u10A1"
        + "\u10A2\u2D02\u10A2\u10A3\u2D03\u10A3\u10A4\u2D04\u10A4\u10A5\u2D05\u10A5\u10A6\u2D06\u10A6\u10A7\u2D07\u10A7\u10A8\u2D08\u10A8"
        + "\u10A9\u2D09\u10A9\u10AA\u2D0A\u10AA\u10AB\u2D0B\u10AB\u10AC\u2D0C\u10AC\u10AD\u2D0D\u10AD\u10AE\u2D0E\u10AE\u10AF\u2D0F\u10AF"
        + "\u10B0\u2D10\u10B0\u10B1\u2D11\u10B1\u10B2\u2D12\u10B2\u10B3\u2D13\u10B3\u10B4\u2D14\u10B4\u10B5\u2D15\u10B5\u10B6\u2D16\u10B6"
        + "\u10B7\u2D17\u10B7\u10B8\u2D18\u10B8\u10B9\u2D19\u10B9\u10BA\u2D1A\u10BA\u10BB\u2D1B\u10BB\u10BC\u2D1C\u10BC\u10BD\u2D1D\u10BD"
        + "\u10BE\u2D1E\u10BE\u10BF\u2D1F\u10BF\u10C0\u2D20\u10C0\u10C1\u2D21\u10C1\u10C2\u2D22\u10C2\u10C3\u2D23\u10C3\u10C4\u2D24\u10C4"
        + "\u10C5\u2D25\u10C5\u10C7\u2D27\u10C7\u10CD\u2D2D\u10CD\u10D0\u1C90\u10D0\u10D1\u1C91\u10D1\u10D2\u1C92\u10D2\u10D3\u1C93\u10D3"
        + "\u10D4\u1C94\u10D4\u10D5\u1C95\u10D5\u10D6\u1C96\u10D6\u10D7\u1C97\u10D7\u10D8\u1C98\u10D8\u10D9\u1C99\u10D9\u10DA\u1C9A\u10DA"
        + "\u10DB\u1C9B\u10DB\u10DC\u1C9C\u10DC\u10DD\u1C9D\u10DD\u10DE\u1C9E\u10DE\u10DF\u1C9F\u10DF\u10E0\u1CA0\u10E0\u10E1\u1CA1\u10E1"
        + "\u10E2\u1CA2\u10E2\u10E3\u1CA3\u10E3\u10E4\u1CA4\u10E4\u10E5\u1CA5\u10E5\u10E6\u1CA6\u10E6\u10E7\u1CA7\u10E7\u10E8\u1CA8\u10E8"
        + "\u10E9\u1CA9\u10E9\u10EA\u1CAA\u10EA\u10EB\u1CAB\u10EB\u10EC\u1CAC\u10EC\u10ED\u1CAD\u10ED\u10EE\u1CAE\u10EE\u10EF\u1CAF\u10EF"
        + "\u10F0\u1CB0\u10F0\u10F1\u1CB1\u10F1\u10F2\u1CB2\u10F2\u10F3\u1CB3\u10F3\u10F4\u1CB4\u10F4\u10F5\u1CB5\u10F5\u10F6\u1CB6\u10F6"
        + "\u10F7\u1CB7\u10F7\u10F8\u1CB8\u10F8\u10F9\u1CB9\u10F9\u10FA\u1CBA\u10FA\u10FD\u1CBD\u10FD\u10FE\u1CBE\u10FE\u10FF\u1CBF\u10FF"
        + "\u13A0\uAB70\u13A0\u13A1\uAB71\u13A1\u13A2\uAB72\u13A2\u13A3\uAB73\u13A3\u13A4\uAB74\u13A4\u13A5\uAB75\u13A5\u13A6\uAB76\u13A6"
        + "\u13A7\uAB77\u13A7\u13A8\uAB78\u13A8\u13A9\uAB79\u13A9\u13AA\uAB7A\u13AA\u13AB\uAB7B\u13AB\u13AC\uAB7C\u13AC\u13AD\uAB7D\u13AD"
        + "\u13AE\uAB7E\u13AE\u13AF\uAB7F\u13AF\u13B0\uAB80\u13B0\u13B1\uAB81\u13B1\u13B2\uAB82\u13B2\u13B3\uAB83\u13B3\u13B4\uAB84\u13B4"
        + "\u13B5\uAB85\u13B5\u13B6\uAB86\u13B6\u13B7\uAB87\u13B7\u13B8\uAB88\u13B8\u13B9\uAB89\u13B9\u13BA\uAB8A\u13BA\u13BB\uAB8B\u13BB"
        + "\u13BC\uAB8C\u13BC\u13BD\uAB8D\u13BD\u13BE\uAB8E\u13BE\u13BF\uAB8F\u13BF\u13C0\uAB90\u13C0\u13C1\uAB91\u13C1\u13C2\uAB92\u13C2"
        + "\u13C3\uAB93\u13C3\u13C4\uAB94\u13C4\u13C5\uAB95\u13C5\u13C6\uAB96\u13C6\u13C7\uAB97\u13C7\u13C8\uAB98\u13C8\u13C9\uAB99\u13C9"
        + "\u13CA\uAB9A\u13CA\u13CB\uAB9B\u13CB\u13CC\uAB9C\u13CC\u13CD\uAB9D\u13CD\u13CE\uAB9E\u13CE\u13CF\uAB9F\u13CF\u13D0\uABA0\u13D0"
        + "\u13D1\uABA1\u13D1\u13D2\uABA2\u13D2\u13D3\uABA3\u13D3\u13D4\uABA4\u13D4\u13D5\uABA5\u13D5\u13D6\uABA6\u13D6\u13D7\uABA7\u13D7"
        + "\u13D8\uABA8\u13D8\u13D9\uABA9\u13D9\u13DA\uABAA\u13DA\u13DB\uABAB\u13DB\u13DC\uABAC\u13DC\u13DD\uABAD\u13DD\u13DE\uABAE\u13DE"
        + "\u13DF\uABAF\u13DF\u13E0\uABB0\u13E0\u13E1\uABB1\u13E1\u13E2\uABB2\u13E2\u13E3\uABB3\u13E3\u13E4\uABB4\u13E4\u13E5\uABB5\u13E5"
        + "\u13E6\uABB6\u13E6\u13E7\uABB7\u13E7\u13E8\uABB8\u13E8\u13E9\uABB9\u13E9\u13EA\uABBA\u13EA\u13EB\uABBB\u13EB\u13EC\uABBC\u13EC"
        + "\u13ED\uABBD\u13ED\u13EE\uABBE\u13EE\u13EF\uABBF\u13EF\u13F0\u13F8\u13F0\u13F1\u13F9\u13F1\u13F2\u13FA\u13F2\u13F3\u13FB\u13F3"
        + "\u13F4\u13FC\u13F4\u13F5\u13FD\u13F5\u13F8\u13F0\u13F8\u13F9\u13F1\u13F9\u13FA\u13F2\u13FA\u13FB\u13F3\u13FB\u13FC\u13F4\u13FC"
        + "\u13FD\u13F5\u13FD\u1C89\u1C8A\u1C89\u1C8A\u1C89\u1C8A\u1C90\u10D0\u1C90\u1C91\u10D1\u1C91\u1C92\u10D2\u1C92\u1C93\u10D3\u1C93"
        + "\u1C94\u10D4\u1C94\u1C95\u10D5\u1C95\u1C96\u10D6\u1C96\u1C97\u10D7\u1C97\u1C98\u10D8\u1C98\u1C99\u10D9\u1C99\u1C9A\u10DA\u1C9A"
        + "\u1C9B\u10DB\u1C9B\u1C9C\u10DC\u1C9C\u1C9D\u10DD\u1C9D\u1C9E\u10DE\u1C9E\u1C9F\u10DF\u1C9F\u1CA0\u10E0\u1CA0\u1CA1\u10E1\u1CA1"
        + "\u1CA2\u10E2\u1CA2\u1CA3\u10E3\u1CA3\u1CA4\u10E4\u1CA4\u1CA5\u10E5\u1CA5\u1CA6\u10E6\u1CA6\u1CA7\u10E7\u1CA7\u1CA8\u10E8\u1CA8"
        + "\u1CA9\u10E9\u1CA9\u1CAA\u10EA\u1CAA\u1CAB\u10EB\u1CAB\u1CAC\u10EC\u1CAC\u1CAD\u10ED\u1CAD\u1CAE\u10EE\u1CAE\u1CAF\u10EF\u1CAF"
        + "\u1CB0\u10F0\u1CB0\u1CB1\u10F1\u1CB1\u1CB2\u10F2\u1CB2\u1CB3\u10F3\u1CB3\u1CB4\u10F4\u1CB4\u1CB5\u10F5\u1CB5\u1CB6\u10F6\u1CB6"
        + "\u1CB7\u10F7\u1CB7\u1CB8\u10F8\u1CB8\u1CB9\u10F9\u1CB9\u1CBA\u10FA\u1CBA\u1CBD\u10FD\u1CBD\u1CBE\u10FE\u1CBE\u1CBF\u10FF\u1CBF"
        + "\u1D79\uA77D\u1D79\u1D7D\u2C63\u1D7D\u1D8E\uA7C6\u1D8E\u1E00\u1E01\u1E00\u1E01\u1E00\u1E01\u1E02\u1E03\u1E02\u1E03\u1E02\u1E03"
        + "\u1E04\u1E05\u1E04\u1E05\u1E04\u1E05\u1E06\u1E07\u1E06\u1E07\u1E06\u1E07\u1E08\u1E09\u1E08\u1E09\u1E08\u1E09\u1E0A\u1E0B\u1E0A"
        + "\u1E0B\u1E0A\u1E0B\u1E0C\u1E0D\u1E0C\u1E0D\u1E0C\u1E0D\u1E0E\u1E0F\u1E0E\u1E0F\u1E0E\u1E0F\u1E10\u1E11\u1E10\u1E11\u1E10\u1E11"
        + "\u1E12\u1E13\u1E12\u1E13\u1E12\u1E13\u1E14\u1E15\u1E14\u1E15\u1E14\u1E15\u1E16\u1E17\u1E16\u1E17\u1E16\u1E17\u1E18\u1E19\u1E18"
        + "\u1E19\u1E18\u1E19\u1E1A\u1E1B\u1E1A\u1E1B\u1E1A\u1E1B\u1E1C\u1E1D\u1E1C\u1E1D\u1E1C\u1E1D\u1E1E\u1E1F\u1E1E\u1E1F\u1E1E\u1E1F"
        + "\u1E20\u1E21\u1E20\u1E21\u1E20\u1E21\u1E22\u1E23\u1E22\u1E23\u1E22\u1E23\u1E24\u1E25\u1E24\u1E25\u1E24\u1E25\u1E26\u1E27\u1E26"
        + "\u1E27\u1E26\u1E27\u1E28\u1E29\u1E28\u1E29\u1E28\u1E29\u1E2A\u1E2B\u1E2A\u1E2B\u1E2A\u1E2B\u1E2C\u1E2D\u1E2C\u1E2D\u1E2C\u1E2D"
        + "\u1E2E\u1E2F\u1E2E\u1E2F\u1E2E\u1E2F\u1E30\u1E31\u1E30\u1E31\u1E30\u1E31\u1E32\u1E33\u1E32\u1E33\u1E32\u1E33\u1E34\u1E35\u1E34"
        + "\u1E35\u1E34\u1E35\u1E36\u1E37\u1E36\u1E37\u1E36\u1E37\u1E38\u1E39\u1E38\u1E39\u1E38\u1E39\u1E3A\u1E3B\u1E3A\u1E3B\u1E3A\u1E3B"
        + "\u1E3C\u1E3D\u1E3C\u1E3D\u1E3C\u1E3D\u1E3E\u1E3F\u1E3E\u1E3F\u1E3E\u1E3F\u1E40\u1E41\u1E40\u1E41\u1E40\u1E41\u1E42\u1E43\u1E42"
        + "\u1E43\u1E42\u1E43\u1E44\u1E45\u1E44\u1E45\u1E44\u1E45\u1E46\u1E47\u1E46\u1E47\u1E46\u1E47\u1E48\u1E49\u1E48\u1E49\u1E48\u1E49"
        + "\u1E4A\u1E4B\u1E4A\u1E4B\u1E4A\u1E4B\u1E4C\u1E4D\u1E4C\u1E4D\u1E4C\u1E4D\u1E4E\u1E4F\u1E4E\u1E4F\u1E4E\u1E4F\u1E50\u1E51\u1E50"
        + "\u1E51\u1E50\u1E51\u1E52\u1E53\u1E52\u1E53\u1E52\u1E53\u1E54\u1E55\u1E54\u1E55\u1E54\u1E55\u1E56\u1E57\u1E56\u1E57\u1E56\u1E57"
        + "\u1E58\u1E59\u1E58\u1E59\u1E58\u1E59\u1E5A\u1E5B\u1E5A\u1E5B\u1E5A\u1E5B\u1E5C\u1E5D\u1E5C\u1E5D\u1E5C\u1E5D\u1E5E\u1E5F\u1E5E"
        + "\u1E5F\u1E5E\u1E5F\u1E60\u1E61\u1E60\u1E61\u1E60\u1E61\u1E62\u1E63\u1E62\u1E63\u1E62\u1E63\u1E64\u1E65\u1E64\u1E65\u1E64\u1E65"
        + "\u1E66\u1E67\u1E66\u1E67\u1E66\u1E67\u1E68\u1E69\u1E68\u1E69\u1E68\u1E69\u1E6A\u1E6B\u1E6A\u1E6B\u1E6A\u1E6B\u1E6C\u1E6D\u1E6C"
        + "\u1E6D\u1E6C\u1E6D\u1E6E\u1E6F\u1E6E\u1E6F\u1E6E\u1E6F\u1E70\u1E71\u1E70\u1E71\u1E70\u1E71\u1E72\u1E73\u1E72\u1E73\u1E72\u1E73"
        + "\u1E74\u1E75\u1E74\u1E75\u1E74\u1E75\u1E76\u1E77\u1E76\u1E77\u1E76\u1E77\u1E78\u1E79\u1E78\u1E79\u1E78\u1E79\u1E7A\u1E7B\u1E7A"
        + "\u1E7B\u1E7A\u1E7B\u1E7C\u1E7D\u1E7C\u1E7D\u1E7C\u1E7D\u1E7E\u1E7F\u1E7E\u1E7F\u1E7E\u1E7F\u1E80\u1E81\u1E80\u1E81\u1E80\u1E81"
        + "\u1E82\u1E83\u1E82\u1E83\u1E82\u1E83\u1E84\u1E85\u1E84\u1E85\u1E84\u1E85\u1E86\u1E87\u1E86\u1E87\u1E86\u1E87\u1E88\u1E89\u1E88"
        + "\u1E89\u1E88\u1E89\u1E8A\u1E8B\u1E8A\u1E8B\u1E8A\u1E8B\u1E8C\u1E8D\u1E8C\u1E8D\u1E8C\u1E8D\u1E8E\u1E8F\u1E8E\u1E8F\u1E8E\u1E8F"
        + "\u1E90\u1E91\u1E90\u1E91\u1E90\u1E91\u1E92\u1E93\u1E92\u1E93\u1E92\u1E93\u1E94\u1E95\u1E94\u1E95\u1E94\u1E95\u1E9E\u00DF\u1E9E"
        + "\u1EA0\u1EA1\u1EA0\u1EA1\u1EA0\u1EA1\u1EA2\u1EA3\u1EA2\u1EA3\u1EA2\u1EA3\u1EA4\u1EA5\u1EA4\u1EA5\u1EA4\u1EA5\u1EA6\u1EA7\u1EA6"
        + "\u1EA7\u1EA6\u1EA7\u1EA8\u1EA9\u1EA8\u1EA9\u1EA8\u1EA9\u1EAA\u1EAB\u1EAA\u1EAB\u1EAA\u1EAB\u1EAC\u1EAD\u1EAC\u1EAD\u1EAC\u1EAD"
        + "\u1EAE\u1EAF\u1EAE\u1EAF\u1EAE\u1EAF\u1EB0\u1EB1\u1EB0\u1EB1\u1EB0\u1EB1\u1EB2\u1EB3\u1EB2\u1EB3\u1EB2\u1EB3\u1EB4\u1EB5\u1EB4"
        + "\u1EB5\u1EB4\u1EB5\u1EB6\u1EB7\u1EB6\u1EB7\u1EB6\u1EB7\u1EB8\u1EB9\u1EB8\u1EB9\u1EB8\u1EB9\u1EBA\u1EBB\u1EBA\u1EBB\u1EBA\u1EBB"
        + "\u1EBC\u1EBD\u1EBC\u1EBD\u1EBC\u1EBD\u1EBE\u1EBF\u1EBE\u1EBF\u1EBE\u1EBF\u1EC0\u1EC1\u1EC0\u1EC1\u1EC0\u1EC1\u1EC2\u1EC3\u1EC2"
        + "\u1EC3\u1EC2\u1EC3\u1EC4\u1EC5\u1EC4\u1EC5\u1EC4\u1EC5\u1EC6\u1EC7\u1EC6\u1EC7\u1EC6\u1EC7\u1EC8\u1EC9\u1EC8\u1EC9\u1EC8\u1EC9"
        + "\u1ECA\u1ECB\u1ECA\u1ECB\u1ECA\u1ECB\u1ECC\u1ECD\u1ECC\u1ECD\u1ECC\u1ECD\u1ECE\u1ECF\u1ECE\u1ECF\u1ECE\u1ECF\u1ED0\u1ED1\u1ED0"
        + "\u1ED1\u1ED0\u1ED1\u1ED2\u1ED3\u1ED2\u1ED3\u1ED2\u1ED3\u1ED4\u1ED5\u1ED4\u1ED5\u1ED4\u1ED5\u1ED6\u1ED7\u1ED6\u1ED7\u1ED6\u1ED7"
        + "\u1ED8\u1ED9\u1ED8\u1ED9\u1ED8\u1ED9\u1EDA\u1EDB\u1EDA\u1EDB\u1EDA\u1EDB\u1EDC\u1EDD\u1EDC\u1EDD\u1EDC\u1EDD\u1EDE\u1EDF\u1EDE"
        + "\u1EDF\u1EDE\u1EDF\u1EE0\u1EE1\u1EE0\u1EE1\u1EE0\u1EE1\u1EE2\u1EE3\u1EE2\u1EE3\u1EE2\u1EE3\u1EE4\u1EE5\u1EE4\u1EE5\u1EE4\u1EE5"
        + "\u1EE6\u1EE7\u1EE6\u1EE7\u1EE6\u1EE7\u1EE8\u1EE9\u1EE8\u1EE9\u1EE8\u1EE9\u1EEA\u1EEB\u1EEA\u1EEB\u1EEA\u1EEB\u1EEC\u1EED\u1EEC"
        + "\u1EED\u1EEC\u1EED\u1EEE\u1EEF\u1EEE\u1EEF\u1EEE\u1EEF\u1EF0\u1EF1\u1EF0\u1EF1\u1EF0\u1EF1\u1EF2\u1EF3\u1EF2\u1EF3\u1EF2\u1EF3"
        + "\u1EF4\u1EF5\u1EF4\u1EF5\u1EF4\u1EF5\u1EF6\u1EF7\u1EF6\u1EF7\u1EF6\u1EF7\u1EF8\u1EF9\u1EF8\u1EF9\u1EF8\u1EF9\u1EFA\u1EFB\u1EFA"
        + "\u1EFB\u1EFA\u1EFB\u1EFC\u1EFD\u1EFC\u1EFD\u1EFC\u1EFD\u1EFE\u1EFF\u1EFE\u1EFF\u1EFE\u1EFF\u1F00\u1F08\u1F00\u1F01\u1F09\u1F01"
        + "\u1F02\u1F0A\u1F02\u1F03\u1F0B\u1F03\u1F04\u1F0C\u1F04\u1F05\u1F0D\u1F05\u1F06\u1F0E\u1F06\u1F07\u1F0F\u1F07\u1F08\u1F00\u1F08"
        + "\u1F09\u1F01\u1F09\u1F0A\u1F02\u1F0A\u1F0B\u1F03\u1F0B\u1F0C\u1F04\u1F0C\u1F0D\u1F05\u1F0D\u1F0E\u1F06\u1F0E\u1F0F\u1F07\u1F0F"
        + "\u1F10\u1F18\u1F10\u1F11\u1F19\u1F11\u1F12\u1F1A\u1F12\u1F13\u1F1B\u1F13\u1F14\u1F1C\u1F14\u1F15\u1F1D\u1F15\u1F18\u1F10\u1F18"
        + "\u1F19\u1F11\u1F19\u1F1A\u1F12\u1F1A\u1F1B\u1F13\u1F1B\u1F1C\u1F14\u1F1C\u1F1D\u1F15\u1F1D\u1F20\u1F28\u1F20\u1F21\u1F29\u1F21"
        + "\u1F22\u1F2A\u1F22\u1F23\u1F2B\u1F23\u1F24\u1F2C\u1F24\u1F25\u1F2D\u1F25\u1F26\u1F2E\u1F26\u1F27\u1F2F\u1F27\u1F28\u1F20\u1F28"
        + "\u1F29\u1F21\u1F29\u1F2A\u1F22\u1F2A\u1F2B\u1F23\u1F2B\u1F2C\u1F24\u1F2C\u1F2D\u1F25\u1F2D\u1F2E\u1F26\u1F2E\u1F2F\u1F27\u1F2F"
        + "\u1F30\u1F38\u1F30\u1F31\u1F39\u1F31\u1F32\u1F3A\u1F32\u1F33\u1F3B\u1F33\u1F34\u1F3C\u1F34\u1F35\u1F3D\u1F35\u1F36\u1F3E\u1F36"
        + "\u1F37\u1F3F\u1F37\u1F38\u1F30\u1F38\u1F39\u1F31\u1F39\u1F3A\u1F32\u1F3A\u1F3B\u1F33\u1F3B\u1F3C\u1F34\u1F3C\u1F3D\u1F35\u1F3D"
        + "\u1F3E\u1F36\u1F3E\u1F3F\u1F37\u1F3F\u1F40\u1F48\u1F40\u1F41\u1F49\u1F41\u1F42\u1F4A\u1F42\u1F43\u1F4B\u1F43\u1F44\u1F4C\u1F44"
        + "\u1F45\u1F4D\u1F45\u1F48\u1F40\u1F48\u1F49\u1F41\u1F49\u1F4A\u1F42\u1F4A\u1F4B\u1F43\u1F4B\u1F4C\u1F44\u1F4C\u1F4D\u1F45\u1F4D"
        + "\u1F51\u1F59\u1F51\u1F53\u1F5B\u1F53\u1F55\u1F5D\u1F55\u1F57\u1F5F\u1F57\u1F59\u1F51\u1F59\u1F5B\u1F53\u1F5B\u1F5D\u1F55\u1F5D"
        + "\u1F5F\u1F57\u1F5F\u1F60\u1F68\u1F60\u1F61\u1F69\u1F61\u1F62\u1F6A\u1F62\u1F63\u1F6B\u1F63\u1F64\u1F6C\u1F64\u1F65\u1F6D\u1F65"
        + "\u1F66\u1F6E\u1F66\u1F67\u1F6F\u1F67\u1F68\u1F60\u1F68\u1F69\u1F61\u1F69\u1F6A\u1F62\u1F6A\u1F6B\u1F63\u1F6B\u1F6C\u1F64\u1F6C"
        + "\u1F6D\u1F65\u1F6D\u1F6E\u1F66\u1F6E\u1F6F\u1F67\u1F6F\u1F70\u1FBA\u1F70\u1F71\u1FBB\u1F71\u1F72\u1FC8\u1F72\u1F73\u1FC9\u1F73"
        + "\u1F74\u1FCA\u1F74\u1F75\u1FCB\u1F75\u1F76\u1FDA\u1F76\u1F77\u1FDB\u1F77\u1F78\u1FF8\u1F78\u1F79\u1FF9\u1F79\u1F7A\u1FEA\u1F7A"
        + "\u1F7B\u1FEB\u1F7B\u1F7C\u1FFA\u1F7C\u1F7D\u1FFB\u1F7D\u1F80\u1F88\u1F80\u1F81\u1F89\u1F81\u1F82\u1F8A\u1F82\u1F83\u1F8B\u1F83"
        + "\u1F84\u1F8C\u1F84\u1F85\u1F8D\u1F85\u1F86\u1F8E\u1F86\u1F87\u1F8F\u1F87\u1F88\u1F80\u1F88\u1F89\u1F81\u1F89\u1F8A\u1F82\u1F8A"
        + "\u1F8B\u1F83\u1F8B\u1F8C\u1F84\u1F8C\u1F8D\u1F85\u1F8D\u1F8E\u1F86\u1F8E\u1F8F\u1F87\u1F8F\u1F90\u1F98\u1F90\u1F91\u1F99\u1F91"
        + "\u1F92\u1F9A\u1F92\u1F93\u1F9B\u1F93\u1F94\u1F9C\u1F94\u1F95\u1F9D\u1F95\u1F96\u1F9E\u1F96\u1F97\u1F9F\u1F97\u1F98\u1F90\u1F98"
        + "\u1F99\u1F91\u1F99\u1F9A\u1F92\u1F9A\u1F9B\u1F93\u1F9B\u1F9C\u1F94\u1F9C\u1F9D\u1F95\u1F9D\u1F9E\u1F96\u1F9E\u1F9F\u1F97\u1F9F"
        + "\u1FA0\u1FA8\u1FA0\u1FA1\u1FA9\u1FA1\u1FA2\u1FAA\u1FA2\u1FA3\u1FAB\u1FA3\u1FA4\u1FAC\u1FA4\u1FA5\u1FAD\u1FA5\u1FA6\u1FAE\u1FA6"
        + "\u1FA7\u1FAF\u1FA7\u1FA8\u1FA0\u1FA8\u1FA9\u1FA1\u1FA9\u1FAA\u1FA2\u1FAA\u1FAB\u1FA3\u1FAB\u1FAC\u1FA4\u1FAC\u1FAD\u1FA5\u1FAD"
        + "\u1FAE\u1FA6\u1FAE\u1FAF\u1FA7\u1FAF\u1FB0\u1FB8\u1FB0\u1FB1\u1FB9\u1FB1\u1FB3\u1FBC\u1FB3\u1FB8\u1FB0\u1FB8\u1FB9\u1FB1\u1FB9"
        + "\u1FBA\u1F70\u1FBA\u1FBB\u1F71\u1FBB\u1FBC\u1FB3\u1FBC\u1FC3\u1FCC\u1FC3\u1FC8\u1F72\u1FC8\u1FC9\u1F73\u1FC9\u1FCA\u1F74\u1FCA"
        + "\u1FCB\u1F75\u1FCB\u1FCC\u1FC3\u1FCC\u1FD0\u1FD8\u1FD0\u1FD1\u1FD9\u1FD1\u1FD8\u1FD0\u1FD8\u1FD9\u1FD1\u1FD9\u1FDA\u1F76\u1FDA"
        + "\u1FDB\u1F77\u1FDB\u1FE0\u1FE8\u1FE0\u1FE1\u1FE9\u1FE1\u1FE5\u1FEC\u1FE5\u1FE8\u1FE0\u1FE8\u1FE9\u1FE1\u1FE9\u1FEA\u1F7A\u1FEA"
        + "\u1FEB\u1F7B\u1FEB\u1FEC\u1FE5\u1FEC\u1FF3\u1FFC\u1FF3\u1FF8\u1F78\u1FF8\u1FF9\u1F79\u1FF9\u1FFA\u1F7C\u1FFA\u1FFB\u1F7D\u1FFB"
