        + "\uA784\uA785\uA784\uA785\uA784\uA785\uA786\uA787\uA786\uA787\uA786\uA787\uA78B\uA78C\uA78B\uA78C\uA78B\uA78C\uA78D\u0265\uA78D"
        + "\uA790\uA791\uA790\uA791\uA790\uA791\uA792\uA793\uA792\uA793\uA792\uA793\uA794\uA7C4\uA794\uA796\uA797\uA796\uA797\uA796\uA797"
        + "\uA798\uA799\uA798\uA799\uA798\uA799\uA79A\uA79B\uA79A\uA79B\uA79A\uA79B\uA79C\uA79D\uA79C\uA79D\uA79C\uA79D\uA79E\uA79F\uA79E"
        + "\uA79F\uA79E\uA79F\uA7A0\uA7A1\uA7A0\uA7A1\uA7A0\uA7A1\uA7A2\uA7A3\uA7A2\uA7A3\uA7A2\uA7A3\uA7A4\uA7A5\uA7A4\uA7A5\uA7A4\uA7A5"
        + "\uA7A6\uA7A7\uA7A6\uA7A7\uA7A6\uA7A7\uA7A8\uA7A9\uA7A8\uA7A9\uA7A8\uA7A9\uA7AA\u0266\uA7AA\uA7AB\u025C\uA7AB\uA7AC\u0261\uA7AC"
        + "\uA7AD\u026C\uA7AD\uA7AE\u026A\uA7AE\uA7B0\u029E\uA7B0\uA7B1\u0287\uA7B1\uA7B2\u029D\uA7B2\uA7B3\uAB53\uA7B3\uA7B4\uA7B5\uA7B4"
        + "\uA7B5\uA7B4\uA7B5\uA7B6\uA7B7\uA7B6\uA7B7\uA7B6\uA7B7\uA7B8\uA7B9\uA7B8\uA7B9\uA7B8\uA7B9\uA7BA\uA7BB\uA7BA\uA7BB\uA7BA\uA7BB"
        + "\uA7BC\uA7BD\uA7BC\uA7BD\uA7BC\uA7BD\uA7BE\uA7BF\uA7BE\uA7BF\uA7BE\uA7BF\uA7C0\uA7C1\uA7C0\uA7C1\uA7C0\uA7C1\uA7C2\uA7C3\uA7C2"
        + "\uA7C3\uA7C2\uA7C3\uA7C4\uA794\uA7C4\uA7C5\u0282\uA7C5\uA7C6\u1D8E\uA7C6\uA7C7\uA7C8\uA7C7\uA7C8\uA7C7\uA7C8\uA7C9\uA7CA\uA7C9"
        + "\uA7CA\uA7C9\uA7CA\uA7CB\u0264\uA7CB\uA7CC\uA7CD\uA7CC\uA7CD\uA7CC\uA7CD\uA7D0\uA7D1\uA7D0\uA7D1\uA7D0\uA7D1\uA7D6\uA7D7\uA7D6"
        + "\uA7D7\uA7D6\uA7D7\uA7D8\uA7D9\uA7D8\uA7D9\uA7D8\uA7D9\uA7DA\uA7DB\uA7DA\uA7DB\uA7DA\uA7DB\uA7DC\u019B\uA7DC\uA7F5\uA7F6\uA7F5"
        + "\uA7F6\uA7F5\uA7F6\uAB53\uA7B3\uAB53\uAB70\u13A0\uAB70\uAB71\u13A1\uAB71\uAB72\u13A2\uAB72\uAB73\u13A3\uAB73\uAB74\u13A4\uAB74"
        + "\uAB75\u13A5\uAB75\uAB76\u13A6\uAB76\uAB77\u13A7\uAB77\uAB78\u13A8\uAB78\uAB79\u13A9\uAB79\uAB7A\u13AA\uAB7A\uAB7B\u13AB\uAB7B"
        + "\uAB7C\u13AC\uAB7C\uAB7D\u13AD\uAB7D\uAB7E\u13AE\uAB7E\uAB7F\u13AF\uAB7F\uAB80\u13B0\uAB80\uAB81\u13B1\uAB81\uAB82\u13B2\uAB82"
        + "\uAB83\u13B3\uAB83\uAB84\u13B4\uAB84\uAB85\u13B5\uAB85\uAB86\u13B6\uAB86\uAB87\u13B7\uAB87\uAB88\u13B8\uAB88\uAB89\u13B9\uAB89"
        + "\uAB8A\u13BA\uAB8A\uAB8B\u13BB\uAB8B\uAB8C\u13BC\uAB8C\uAB8D\u13BD\uAB8D\uAB8E\u13BE\uAB8E\uAB8F\u13BF\uAB8F\uAB90\u13C0\uAB90"
        + "\uAB91\u13C1\uAB91\uAB92\u13C2\uAB92\uAB93\u13C3\uAB93\uAB94\u13C4\uAB94\uAB95\u13C5\uAB95\uAB96\u13C6\uAB96\uAB97\u13C7\uAB97"
        + "\uAB98\u13C8\uAB98\uAB99\u13C9\uAB99\uAB9A\u13CA\uAB9A\uAB9B\u13CB\uAB9B\uAB9C\u13CC\uAB9C\uAB9D\u13CD\uAB9D\uAB9E\u13CE\uAB9E"
        + "\uAB9F\u13CF\uAB9F\uABA0\u13D0\uABA0\uABA1\u13D1\uABA1\uABA2\u13D2\uABA2\uABA3\u13D3\uABA3\uABA4\u13D4\uABA4\uABA5\u13D5\uABA5"
        + "\uABA6\u13D6\uABA6\uABA7\u13D7\uABA7\uABA8\u13D8\uABA8\uABA9\u13D9\uABA9\uABAA\u13DA\uABAA\uABAB\u13DB\uABAB\uABAC\u13DC\uABAC"
        + "\uABAD\u13DD\uABAD\uABAE\u13DE\uABAE\uABAF\u13DF\uABAF\uABB0\u13E0\uABB0\uABB1\u13E1\uABB1\uABB2\u13E2\uABB2\uABB3\u13E3\uABB3"
        + "\uABB4\u13E4\uABB4\uABB5\u13E5\uABB5\uABB6\u13E6\uABB6\uABB7\u13E7\uABB7\uABB8\u13E8\uABB8\uABB9\u13E9\uABB9\uABBA\u13EA\uABBA"
        + "\uABBB\u13EB\uABBB\uABBC\u13EC\uABBC\uABBD\u13ED\uABBD\uABBE\u13EE\uABBE\uABBF\u13EF\uABBF\uFF21\uFF41\uFF21\uFF22\uFF42\uFF22"
        + "\uFF23\uFF43\uFF23\uFF24\uFF44\uFF24\uFF25\uFF45\uFF25\uFF26\uFF46\uFF26\uFF27\uFF47\uFF27\uFF28\uFF48\uFF28\uFF29\uFF49\uFF29"
        + "\uFF2A\uFF4A\uFF2A\uFF2B\uFF4B\uFF2B\uFF2C\uFF4C\uFF2C\uFF2D\uFF4D\uFF2D\uFF2E\uFF4E\uFF2E\uFF2F\uFF4F\uFF2F\uFF30\uFF50\uFF30"
        + "\uFF31\uFF51\uFF31\uFF32\uFF52\uFF32\uFF33\uFF53\uFF33\uFF34\uFF54\uFF34\uFF35\uFF55\uFF35\uFF36\uFF56\uFF36\uFF37\uFF57\uFF37"
        + "\uFF38\uFF58\uFF38\uFF39\uFF59\uFF39\uFF3A\uFF5A\uFF3A\uFF41\uFF21\uFF41\uFF42\uFF22\uFF42\uFF43\uFF23\uFF43\uFF44\uFF24\uFF44"
        + "\uFF45\uFF25\uFF45\uFF46\uFF26\uFF46\uFF47\uFF27\uFF47\uFF48\uFF28\uFF48\uFF49\uFF29\uFF49\uFF4A\uFF2A\uFF4A\uFF4B\uFF2B\uFF4B"
        + "\uFF4C\uFF2C\uFF4C\uFF4D\uFF2D\uFF4D\uFF4E\uFF2E\uFF4E\uFF4F\uFF2F\uFF4F\uFF50\uFF30\uFF50\uFF51\uFF31\uFF51\uFF52\uFF32\uFF52"
        + "\uFF53\uFF33\uFF53\uFF54\uFF34\uFF54\uFF55\uFF35\uFF55\uFF56\uFF36\uFF56\uFF57\uFF37\uFF57\uFF58\uFF38\uFF58\uFF59\uFF39\uFF59"
        + "\uFF5A\uFF3A\uFF5A";

    /// The characters c is equivalent to, besides itself, or null.
    public static string? Of(char c)
    {
        if (c < 'A')
        {
            return null;
        }
        int low = 0;
        int high = Table.Length / 3 - 1;
        while (low <= high)
        {
            int mid = (low + high) >> 1;
            char at = Table[3 * mid];
            if (c < at)
            {
                high = mid - 1;
            }
            else if (c > at)
            {
                low = mid + 1;
            }
            else
            {
                char first = Table[3 * mid + 1];
                char second = Table[3 * mid + 2];
                return second == c ? "" + first : "" + first + second;
            }
        }
        return null;
    }
}

// ---- the parse tree ----------------------------------------------------------

/// What a node of the tree is, .NET's RegexNodeKind: the leaves that match a
/// character or a string, the loops a leaf becomes under a quantifier, the
/// anchors, and the structures with children.
enum RegexNodeKind
{
    Oneloop = 3,
    Notoneloop = 4,
    Setloop = 5,
    Onelazy = 6,
    Notonelazy = 7,
    Setlazy = 8,
    One = 9,
    Notone = 10,
    Set = 11,
    Multi = 12,
    Backreference = 13,
    Bol = 14,
    Eol = 15,
    Boundary = 16,
    NonBoundary = 17,
    Beginning = 18,
    Start = 19,
    EndZ = 20,
    End = 21,
    Nothing = 22,
    Empty = 23,
    Alternate = 24,
    Concatenate = 25,
    Loop = 26,
    Lazyloop = 27,
    Capture = 28,
    Group = 29,
    PositiveLookaround = 30,
    NegativeLookaround = 31,
    Atomic = 32,
    BackreferenceConditional = 33,
    ExpressionConditional = 34,
    ECMABoundary = 41,
    NonECMABoundary = 42
}

class RegexNode
{
    public RegexNodeKind Kind;
    public RegexOptions Options;
    public char Ch;
    public string Str = "";
    public RegexCharClass? Set;
    /// A loop's least and most repetitions; a capture's group and the group
    /// it balances (-1 for none); a back-reference's group.
    public int M;
    public int N;
    public List<RegexNode>? Children;

    public RegexNode(RegexNodeKind kind, RegexOptions options)
    {
        Kind = kind;
        Options = options;
    }

    public RegexNode(RegexNodeKind kind, RegexOptions options, char ch)
    {
        Kind = kind;
        Options = options;
        Ch = ch;
    }

    public RegexNode(RegexNodeKind kind, RegexOptions options, string str)
    {
        Kind = kind;
        Options = options;
        Str = str;
    }

    public RegexNode(RegexNodeKind kind, RegexOptions options, RegexCharClass set)
    {
        Kind = kind;
        Options = options;
        Set = set;
    }

    public RegexNode(RegexNodeKind kind, RegexOptions options, int m)
    {
        Kind = kind;
        Options = options;
        M = m;
    }

    public RegexNode(RegexNodeKind kind, RegexOptions options, int m, int n)
    {
        Kind = kind;
        Options = options;
        M = m;
        N = n;
    }

    public int ChildCount => Children == null ? 0 : Children.Count;

    public RegexNode Child(int i) { return Children![i]; }

    public void AddChild(RegexNode child)
    {
        if (Children == null)
        {
            Children = new List<RegexNode>();
        }
        Children.Add(child);
    }

    /// A character under IgnoreCase is the set of it and its equivalents,
    /// matched exactly; one with none, or without IgnoreCase, is itself.
    public static RegexNode OneWithCase(char ch, RegexOptions options)
    {
        if ((options & RegexOptions.IgnoreCase) != RegexOptions.None)
        {
            string? equivalents = RegexCaseEquivalences.Of(ch);
            if (equivalents != null)
            {
                return new RegexNode(RegexNodeKind.Set, options & ~RegexOptions.IgnoreCase, RegexCharClass.Of(ch, equivalents));
            }
        }
        return new RegexNode(RegexNodeKind.One, options & ~RegexOptions.IgnoreCase, ch);
    }

    /// Under RightToLeft a concatenation is matched from its end, so its
    /// children go in backwards.
    public RegexNode ReverseConcatenationIfRightToLeft()
    {
        if ((Options & RegexOptions.RightToLeft) != RegexOptions.None && Kind == RegexNodeKind.Concatenate && ChildCount > 1)
        {
            Children!.Reverse();
        }
        return this;
    }

    /// This node repeated min to max times, lazily or not: nothing at all
    /// for {0}, itself for {1}, a string for a character a fixed number of
    /// times, a counting loop over one character, and otherwise a loop node.
    public RegexNode MakeQuantifier(bool lazy, int min, int max)
    {
        if (min == max)
        {
            if (max == 0)
            {
                return new RegexNode(RegexNodeKind.Empty, Options);
            }
            if (max == 1)
            {
                return this;
            }
            if (max <= 64 && Kind == RegexNodeKind.One)
            {
                Kind = RegexNodeKind.Multi;
                Str = new string(Ch, max);
                Ch = '\0';
                return this;
            }
        }
        if (Kind == RegexNodeKind.One || Kind == RegexNodeKind.Notone || Kind == RegexNodeKind.Set)
        {
            int step = Kind == RegexNodeKind.One ? 0 : Kind == RegexNodeKind.Notone ? 1 : 2;
            Kind = (RegexNodeKind)((lazy ? (int)RegexNodeKind.Onelazy : (int)RegexNodeKind.Oneloop) + step);
            M = min;
            N = max;
            return this;
        }
        RegexNode loop = new RegexNode(lazy ? RegexNodeKind.Lazyloop : RegexNodeKind.Loop, Options, min, max);
        loop.AddChild(this);
        return loop;
    }
}

// ---- the parser ----------------------------------------------------------------

/// .NET's RegexParser: a pattern read twice. CountCaptures numbers the groups
/// and, scanning every escape, class and comment the way the parse will,
/// throws the errors a scan can find; then ScanRegex builds the tree. The
/// unnamed groups are numbered 1, 2, 3 ... in the order they open, then each
/// name, in the order it first appears, takes the lowest number no group has.
class RegexParser
{
    string _pattern;
    int _pos;
    RegexOptions _options;
    List<RegexOptions> _optionsStack = new List<RegexOptions>();

    // The groups open around the cursor: each level's group, alternation and
    // concatenation, the innermost in the fields.
    List<RegexNode> _stack = new List<RegexNode>();
    RegexNode? _group;
    RegexNode? _alternation;
    RegexNode? _concatenation;
    RegexNode? _unit;

    int _autocap;
    int _capcount;
    int _captop;
    /// Every group number, to where in the pattern its group first opens.
    Dictionary<int, int> _caps = new Dictionary<int, int>();
    /// Names to group numbers once numbered; names to positions before.
    Dictionary<string, int>? _capnames;
    int[]? _capnumlist;
    List<string>? _capnamelist;
    bool _ignoreNextParen;

    RegexParser(string pattern, RegexOptions options)
    {
        _pattern = pattern;
        _options = options;
    }

    /// The tree of a pattern, and what the Regex keeps of its numbering.
    public static RegexTree Parse(string pattern, RegexOptions options)
    {
        RegexParser parser = new RegexParser(pattern, options);
        parser.CountCaptures();
        parser.Reset(options);
        RegexNode root = parser.ScanRegex();

        Dictionary<int, int>? sparse = null;
        int capsize;
        if (parser._capnumlist == null || parser._captop == parser._capnumlist.Length)
        {
            capsize = parser._captop;
        }
        else
        {
            capsize = parser._capnumlist.Length;
            sparse = new Dictionary<int, int>();
            for (int i = 0; i < parser._capnumlist.Length; i++)
            {
                sparse[parser._capnumlist[i]] = i;
            }
        }
        return new RegexTree(root, capsize, parser._capnamelist == null ? null : parser._capnamelist.ToArray(), parser._capnames, sparse, options);
    }

    /// A replacement pattern's pieces, read against the regex's groups.
    public static RegexNode ParseReplacement(string replacement, RegexOptions options, Dictionary<int, int>? caps, int capsize, Dictionary<string, int>? capnames)
    {
        RegexParser parser = new RegexParser(replacement, options & ~RegexOptions.IgnoreCase);
        parser._capnames = capnames;
        if (caps != null)
        {
            foreach (KeyValuePair<int, int> pair in caps)
            {
                parser._caps[pair.Key] = pair.Value;
            }
        }
        else
        {
            for (int i = 0; i < capsize; i++)
            {
                parser._caps[i] = i;
            }
        }
        parser._captop = capsize;
        parser.StartGroup(new RegexNode(RegexNodeKind.Capture, parser._options, 0, -1));
        return parser.ScanReplacement();
    }

    void Reset(RegexOptions options)
    {
        _pos = 0;
        _autocap = 1;
        _ignoreNextParen = false;
        _optionsStack.Clear();
        _options = options;
        _stack.Clear();
    }

    RegexParseException MakeException(RegexParseError error, string message)
    {
        return new RegexParseException(error, _pos, "Invalid pattern '" + _pattern + "' at offset " + _pos + ". " + message);
    }

    bool UseOptionN() { return (_options & RegexOptions.ExplicitCapture) != RegexOptions.None; }
    bool UseOptionI() { return (_options & RegexOptions.IgnoreCase) != RegexOptions.None; }
    bool UseOptionM() { return (_options & RegexOptions.Multiline) != RegexOptions.None; }
    bool UseOptionS() { return (_options & RegexOptions.Singleline) != RegexOptions.None; }
    bool UseOptionX() { return (_options & RegexOptions.IgnorePatternWhitespace) != RegexOptions.None; }
    bool UseOptionE() { return (_options & RegexOptions.ECMAScript) != RegexOptions.None; }

    void PushOptions() { _optionsStack.Add(_options); }

    void PopOptions()
    {
        _options = _optionsStack[_optionsStack.Count - 1];
        _optionsStack.RemoveAt(_optionsStack.Count - 1);
    }

    bool EmptyOptionsStack() { return _optionsStack.Count == 0; }

    void PopKeepOptions() { _optionsStack.RemoveAt(_optionsStack.Count - 1); }

    // ---- numbering --------------------------------------------------------------

    void CountCaptures()
    {
        NoteCaptureSlot(0, 0);
        _autocap = 1;

        while (_pos < _pattern.Length)
        {
            int pos = _pos;
            char ch = _pattern[_pos++];
            switch (ch)
            {
                case '\\':
                    if (_pos < _pattern.Length)
                    {
                        ScanBackslash(true);
                    }
                    break;

                case '#':
                    if (UseOptionX())
                    {
                        _pos--;
                        ScanBlank();
                    }
                    break;

                case '[':
                    ScanCharClass(false, true);
                    break;

                case ')':
                    if (!EmptyOptionsStack())
                    {
                        PopOptions();
                    }
                    break;

                case '(':
                    if (_pos + 1 < _pattern.Length && _pattern[_pos + 1] == '#' && _pattern[_pos] == '?')
                    {
                        _pos--;
                        ScanBlank();
                    }
                    else
                    {
                        PushOptions();
                        if (_pos < _pattern.Length && _pattern[_pos] == '?')
                        {
                            _pos++;
                            if (_pos + 1 < _pattern.Length && (_pattern[_pos] == '<' || _pattern[_pos] == '\''))
                            {
                                _pos++;
                                ch = _pattern[_pos];
                                if (ch != '0' && RegexCharClass.IsBoundaryWordChar(ch))
                                {
                                    if (ch >= '1' && ch <= '9')
                                    {
                                        NoteCaptureSlot(ScanDecimal(), pos);
                                    }
                                    else
                                    {
                                        NoteCaptureName(ScanCapname(), pos);
                                    }
                                }
                            }
                            else
                            {
                                ScanOptions();
                                if (_pos < _pattern.Length)
                                {
                                    if (_pattern[_pos] == ')')
                                    {
                                        _pos++;
                                        PopKeepOptions();
                                    }
                                    else if (_pattern[_pos] == '(')
                                    {
                                        // A conditional: the condition's
                                        // parentheses number no group.
                                        _ignoreNextParen = true;
                                        break;
                                    }
                                }
                            }
                        }
                        else if (!UseOptionN() && !_ignoreNextParen)
                        {
                            NoteCaptureSlot(_autocap++, pos);
                        }
                    }
                    _ignoreNextParen = false;
                    break;
            }
        }
        AssignNameSlots();
    }

    void NoteCaptureSlot(int i, int pos)
    {
        if (!_caps.ContainsKey(i))
        {
            _caps[i] = pos;
            _capcount++;
            if (_captop <= i)
            {
                _captop = i == int.MaxValue ? i : i + 1;
            }
        }
    }

    void NoteCaptureName(string name, int pos)
    {
        if (_capnames == null)
        {
            _capnames = new Dictionary<string, int>();
            _capnamelist = new List<string>();
        }
        if (!_capnames.ContainsKey(name))
        {
            _capnames[name] = pos;
            _capnamelist!.Add(name);
        }
    }

    void AssignNameSlots()
    {
        if (_capnames != null)
        {
            for (int i = 0; i < _capnamelist!.Count; i++)
            {
                while (IsCaptureSlot(_autocap))
                {
                    _autocap++;
                }
                string name = _capnamelist[i];
                int pos = _capnames[name];
                _capnames[name] = _autocap;
                NoteCaptureSlot(_autocap, pos);
                _autocap++;
            }
        }

        // A gap in the numbers: the list of those in use.
        if (_capcount < _captop)
        {
            _capnumlist = new int[_capcount];
            int i = 0;
            foreach (KeyValuePair<int, int> pair in _caps)
            {
                _capnumlist[i++] = pair.Key;
            }
            Array.Sort(_capnumlist);
        }

        // Every group's name, in number order: its own, or its number.
        if (_capnames != null || _capnumlist != null)
        {
            List<string>? oldNames;
            int next;
            int k = 0;
            if (_capnames == null)
            {
                oldNames = null;
                _capnames = new Dictionary<string, int>();
                _capnamelist = new List<string>();
                next = -1;
            }
            else
            {
                oldNames = _capnamelist;
                _capnamelist = new List<string>();
                next = _capnames[oldNames![0]];
            }
            for (int i = 0; i < _capcount; i++)
            {
                int j = _capnumlist == null ? i : _capnumlist[i];
                if (next == j)
                {
                    _capnamelist.Add(oldNames![k++]);
                    next = k == oldNames.Count ? -1 : _capnames[oldNames[k]];
                }
                else
                {
                    string number = j.ToString(CultureInfo.InvariantCulture);
                    _capnamelist.Add(number);
                    _capnames[number] = j;
                }
            }
        }
    }

    bool IsCaptureSlot(int i)
    {
        return _caps.ContainsKey(i);
    }

    bool IsCaptureName(string name)
    {
        return _capnames != null && _capnames.ContainsKey(name);
    }

    int CaptureSlotFromName(string name)
    {
        return _capnames![name];
    }

    // ---- the tree -------------------------------------------------------------

    RegexNode ScanRegex()
    {
        char ch;
        bool isQuantifier = false;

        // The whole match is group 0, without IgnoreCase: the case of each
        // piece is its own.
        StartGroup(new RegexNode(RegexNodeKind.Capture, _options & ~RegexOptions.IgnoreCase, 0, -1));

        while (_pos < _pattern.Length)
        {
            bool wasPrevQuantifier = isQuantifier;
            isQuantifier = false;

            ScanBlank();

            int startpos = _pos;

            // Past the ordinary characters.
            if (UseOptionX())
            {
                while (_pos < _pattern.Length && (!IsStopperX(ch = _pattern[_pos]) || (ch == '{' && !IsTrueQuantifier())))
                {
                    _pos++;
                }
            }
            else
            {
                while (_pos < _pattern.Length && (!IsSpecial(ch = _pattern[_pos]) || (ch == '{' && !IsTrueQuantifier())))
                {
                    _pos++;
                }
            }

            int endpos = _pos;

            ScanBlank();

            if (_pos == _pattern.Length)
            {
                ch = '!';
            }
            else if (IsSpecial(ch = _pattern[_pos]))
            {
                isQuantifier = IsQuantifier(ch);
                _pos++;
            }
            else
            {
                ch = ' ';
            }

            if (startpos < endpos)
            {
                int cchUnquantified = endpos - startpos - (isQuantifier ? 1 : 0);
                wasPrevQuantifier = false;
                if (cchUnquantified > 0)
                {
                    AddConcatenate(startpos, cchUnquantified, false);
                }
                if (isQuantifier)
                {
                    _unit = RegexNode.OneWithCase(_pattern[endpos - 1], _options);
                }
            }

            if (ch == '!')
            {
                break;
            }
            if (ch == ' ')
            {
                continue;
            }

            if (ch == '[')
            {
                RegexCharClass set = ScanCharClass(UseOptionI(), false)!;
                _unit = new RegexNode(RegexNodeKind.Set, _options & ~RegexOptions.IgnoreCase, set.Seal());
            }
            else if (ch == '(')
            {
                PushOptions();
                RegexNode? grouper = ScanGroupOpen();
                if (grouper != null)
                {
                    PushGroup();
                    StartGroup(grouper);
                }
                else
                {
                    PopKeepOptions();
                }
                continue;
            }
            else if (ch == '|')
            {
                AddAlternate();
                continue;
            }
            else if (ch == ')')
            {
                if (_stack.Count == 0)
                {
                    throw MakeException(RegexParseError.InsufficientOpeningParentheses, "Too many )'s.");
                }
                AddGroup();
                PopGroup();
                PopOptions();
                if (_unit == null)
                {
                    continue;
                }
            }
            else if (ch == '\\')
            {
                if (_pos == _pattern.Length)
                {
                    throw MakeException(RegexParseError.UnescapedEndingBackslash, "Illegal \\ at end of pattern.");
                }
                _unit = ScanBackslash(false)!;
            }
            else if (ch == '^')
            {
                _unit = new RegexNode(UseOptionM() ? RegexNodeKind.Bol : RegexNodeKind.Beginning, _options);
            }
            else if (ch == '$')
            {
                _unit = new RegexNode(UseOptionM() ? RegexNodeKind.Eol : RegexNodeKind.EndZ, _options);
            }
            else if (ch == '.')
            {
                _unit = UseOptionS()
                    ? new RegexNode(RegexNodeKind.Set, _options & ~RegexOptions.IgnoreCase, RegexCharClass.Any())
                    : new RegexNode(RegexNodeKind.Notone, _options & ~RegexOptions.IgnoreCase, '\n');
            }
            else
            {
                // '{', '*', '+' or '?' with nothing before it to repeat.
                if (_unit == null)
                {
                    throw wasPrevQuantifier
                        ? MakeException(RegexParseError.NestedQuantifiersNotParenthesized, "Nested quantifier '" + ch + "'.")
                        : MakeException(RegexParseError.QuantifierAfterNothing, "Quantifier '" + ch + "' following nothing.");
                }
                _pos--;
            }

            ScanBlank();

            if (_pos == _pattern.Length || !(isQuantifier = IsTrueQuantifier()))
            {
                AddConcatenate();
                continue;
            }

            ch = _pattern[_pos++];

            // The quantifier on the unit.
            int min = 0;
            int max = 0;
            if (ch == '*')
            {
                max = int.MaxValue;
            }
            else if (ch == '?')
            {
                max = 1;
            }
            else if (ch == '+')
            {
                min = 1;
                max = int.MaxValue;
            }
            else
            {
                startpos = _pos;
                max = min = ScanDecimal();
                if (startpos < _pos)
                {
                    if (_pos < _pattern.Length && _pattern[_pos] == ',')
                    {
                        _pos++;
                        max = _pos == _pattern.Length || _pattern[_pos] == '}' ? int.MaxValue : ScanDecimal();
                    }
                }
                if (startpos == _pos || _pos == _pattern.Length || _pattern[_pos++] != '}')
                {
                    AddConcatenate();
                    _pos = startpos - 1;
                    continue;
                }
            }

            ScanBlank();

            bool lazy = false;
            if (_pos < _pattern.Length && _pattern[_pos] == '?')
            {
                _pos++;
                lazy = true;
            }

            if (min > max)
            {
                throw MakeException(RegexParseError.ReversedQuantifierRange, "Illegal {x,y} with x > y.");
            }

            AddConcatenate(lazy, min, max);
        }

        if (_stack.Count != 0)
        {
            throw MakeException(RegexParseError.InsufficientClosingParentheses, "Not enough )'s.");
        }

        AddGroup();
        return _unit!;
    }

    /// The pieces of a replacement pattern: text, and $ references.
    RegexNode ScanReplacement()
    {
        _concatenation = new RegexNode(RegexNodeKind.Concatenate, _options);
        while (true)
        {
            int c = _pattern.Length - _pos;
            if (c == 0)
            {
                break;
            }
            int startpos = _pos;
            while (c > 0 && _pattern[_pos] != '$')
            {
                _pos++;
                c--;
            }
            AddConcatenate(startpos, _pos - startpos, true);
            if (c > 0)
            {
                if (_pattern[_pos++] == '$')
                {
                    _unit = ScanDollar();
                }
                AddConcatenate();
            }
        }
        return _concatenation;
    }

    RegexNode ScanDollar()
    {
        if (_pos == _pattern.Length)
        {
            return new RegexNode(RegexNodeKind.One, _options, '$');
        }

        char ch = _pattern[_pos];
        bool angled;
        int backpos = _pos;
        int lastEndPos = backpos;

        if (ch == '{' && _pos + 1 < _pattern.Length)
        {
            angled = true;
            _pos++;
            ch = _pattern[_pos];
        }
        else
        {
            angled = false;
        }

        if (ch >= '0' && ch <= '9')
        {
            if (!angled && UseOptionE())
            {
                int capnum = -1;
                int newcapnum = ch - '0';
                _pos++;
                if (IsCaptureSlot(newcapnum))
                {
                    capnum = newcapnum;
                    lastEndPos = _pos;
                }
                while (_pos < _pattern.Length && _pattern[_pos] >= '0' && _pattern[_pos] <= '9')
                {
                    int digit = _pattern[_pos] - '0';
                    if (newcapnum > int.MaxValue / 10 || (newcapnum == int.MaxValue / 10 && digit > int.MaxValue % 10))
                    {
                        throw MakeException(RegexParseError.QuantifierOrCaptureGroupOutOfRange, "Quantifier and capture group numbers must be less than or equal to Int32.MaxValue.");
                    }
                    newcapnum = newcapnum * 10 + digit;
                    _pos++;
                    if (IsCaptureSlot(newcapnum))
                    {
                        capnum = newcapnum;
                        lastEndPos = _pos;
                    }
                }
                _pos = lastEndPos;
                if (capnum >= 0)
                {
                    return new RegexNode(RegexNodeKind.Backreference, _options, capnum);
                }
            }
            else
            {
                int capnum = ScanDecimal();
                if (!angled || (_pos < _pattern.Length && _pattern[_pos++] == '}'))
                {
                    if (IsCaptureSlot(capnum))
                    {
                        return new RegexNode(RegexNodeKind.Backreference, _options, capnum);
                    }
                }
            }
        }
        else if (angled && RegexCharClass.IsBoundaryWordChar(ch))
        {
            string capname = ScanCapname();
            if (_pos < _pattern.Length && _pattern[_pos++] == '}')
            {
                if (_capnames != null && _capnames.ContainsKey(capname))
                {
                    return new RegexNode(RegexNodeKind.Backreference, _options, _capnames[capname]);
                }
            }
        }
        else if (!angled)
        {
            int capnum = 1;
            switch (ch)
            {
                case '$':
                    _pos++;
                    return new RegexNode(RegexNodeKind.One, _options, '$');
                case '&':
                    capnum = 0;
                    break;
                case '`':
                    capnum = RegexReplacement.LeftPortion;
                    break;
                case '\'':
                    capnum = RegexReplacement.RightPortion;
                    break;
                case '+':
                    capnum = RegexReplacement.LastGroup;
                    break;
                case '_':
                    capnum = RegexReplacement.WholeString;
                    break;
            }
            if (capnum != 1)
            {
                _pos++;
                return new RegexNode(RegexNodeKind.Backreference, _options, capnum);
            }
        }

        // Not a reference: the '$' as itself.
        _pos = backpos;
        return new RegexNode(RegexNodeKind.One, _options, '$');
    }

    /// After a '(': the group it opens, or null for an options-only group
    /// such as (?i), which sets the options of what follows.
    RegexNode? ScanGroupOpen()
    {
        if (_pos == _pattern.Length || _pattern[_pos] != '?' || (_pos + 1 < _pattern.Length && _pattern[_pos + 1] == ')'))
        {
            if (UseOptionN() || _ignoreNextParen)
            {
                _ignoreNextParen = false;
                return new RegexNode(RegexNodeKind.Group, _options);
            }
            return new RegexNode(RegexNodeKind.Capture, _options, _autocap++, -1);
        }

        _pos++;

        if (_pos == _pattern.Length)
        {
            throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
        }

        RegexNodeKind nodeType;
        char close = '>';
        char ch = _pattern[_pos++];
        bool named = false;
        if (ch == ':')
        {
            nodeType = RegexNodeKind.Group;
        }
        else if (ch == '=')
        {
            _options = _options & ~RegexOptions.RightToLeft;
            nodeType = RegexNodeKind.PositiveLookaround;
        }
        else if (ch == '!')
        {
            _options = _options & ~RegexOptions.RightToLeft;
            nodeType = RegexNodeKind.NegativeLookaround;
        }
        else if (ch == '>')
        {
            nodeType = RegexNodeKind.Atomic;
        }
        else if (ch == '\'' || ch == '<')
        {
            if (ch == '\'')
            {
                close = '\'';
            }
            if (_pos == _pattern.Length)
            {
                throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
            }
            ch = _pattern[_pos++];
            if (ch == '=' || ch == '!')
            {
                if (close == '\'')
                {
                    throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
                }
                _options = _options | RegexOptions.RightToLeft;
                nodeType = ch == '=' ? RegexNodeKind.PositiveLookaround : RegexNodeKind.NegativeLookaround;
            }
            else
            {
                _pos--;
                named = true;
                nodeType = RegexNodeKind.Capture;
            }
        }
        else if (ch == '(')
        {
            // (?(cond)yes|no): a group number or name as the condition, or
            // otherwise an expression, tested as a lookahead.
            int parenPos = _pos;
            if (_pos < _pattern.Length)
            {
                ch = _pattern[_pos];
                if (ch >= '0' && ch <= '9')
                {
                    int capnum = ScanDecimal();
                    if (_pos < _pattern.Length && _pattern[_pos++] == ')')
                    {
                        if (IsCaptureSlot(capnum))
                        {
                            return new RegexNode(RegexNodeKind.BackreferenceConditional, _options, capnum);
                        }
                        throw MakeException(RegexParseError.AlternationHasUndefinedReference, "(?(" + capnum + ") ) reference to undefined group.");
                    }
                    throw MakeException(RegexParseError.AlternationHasMalformedReference, "(?(" + capnum + ") ) malformed.");
                }
                else if (RegexCharClass.IsBoundaryWordChar(ch))
                {
                    string capname = ScanCapname();
                    if (IsCaptureName(capname) && _pos < _pattern.Length && _pattern[_pos++] == ')')
                    {
                        return new RegexNode(RegexNodeKind.BackreferenceConditional, _options, CaptureSlotFromName(capname));
                    }
                }
            }
            nodeType = RegexNodeKind.ExpressionConditional;
            if (_pos < _pattern.Length - 1 && _pattern[_pos] == '?' && _pattern[_pos + 1] == '#')
            {
                throw MakeException(RegexParseError.AlternationHasComment, "Alternation conditions cannot be comments.");
            }
            _pos = parenPos - 1;
            _ignoreNextParen = true;
            int charsRight = _pattern.Length - _pos;
            if (charsRight >= 3 && _pattern[_pos + 1] == '?')
            {
                char rightchar2 = _pattern[_pos + 2];
                if (rightchar2 == '#')
                {
                    throw MakeException(RegexParseError.AlternationHasComment, "Alternation conditions cannot be comments.");
                }
                if (rightchar2 == '\'' || (charsRight >= 4 && rightchar2 == '<' && _pattern[_pos + 3] != '!' && _pattern[_pos + 3] != '='))
                {
                    throw MakeException(RegexParseError.AlternationHasNamedCapture, "Alternation conditions do not capture and cannot be named.");
                }
            }
        }
        else
        {
            _pos--;
            nodeType = RegexNodeKind.Group;
            // A conditional's branches take no options of their own.
            if (_group!.Kind != RegexNodeKind.ExpressionConditional)
            {
                ScanOptions();
            }
            if (_pos == _pattern.Length)
            {
                throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
            }
            ch = _pattern[_pos++];
            if (ch == ')')
            {
                return null;
            }
            if (ch != ':')
            {
                throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
            }
        }

        if (!named)
        {
            return new RegexNode(nodeType, _options);
        }

        // (?<name>...), (?<number>...), (?<name-other>...) and (?<-other>...).
        ch = _pattern[_pos];
        int capnum2 = -1;
        int uncapnum = -1;
        bool proceed = false;
        if (ch >= '0' && ch <= '9')
        {
            capnum2 = ScanDecimal();
            if (!IsCaptureSlot(capnum2))
            {
                capnum2 = -1;
            }
            if (_pos < _pattern.Length && !(_pattern[_pos] == close || _pattern[_pos] == '-'))
            {
                throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
            }
            if (capnum2 == 0)
            {
                throw MakeException(RegexParseError.CaptureGroupOfZero, "Capture number cannot be zero.");
            }
        }
        else if (RegexCharClass.IsBoundaryWordChar(ch))
        {
            string capname = ScanCapname();
            if (IsCaptureName(capname))
            {
                capnum2 = CaptureSlotFromName(capname);
            }
            if (_pos < _pattern.Length && !(_pattern[_pos] == close || _pattern[_pos] == '-'))
            {
                throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
            }
        }
        else if (ch == '-')
        {
            proceed = true;
        }
        else
        {
            throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
        }

        if ((capnum2 != -1 || proceed) && _pos + 1 < _pattern.Length && _pattern[_pos] == '-')
        {
            _pos++;
            ch = _pattern[_pos];
            if (ch >= '0' && ch <= '9')
            {
                uncapnum = ScanDecimal();
                if (!IsCaptureSlot(uncapnum))
                {
                    throw MakeException(RegexParseError.UndefinedNumberedReference, "Reference to undefined group number " + uncapnum + ".");
                }
                if (_pos < _pattern.Length && _pattern[_pos] != close)
                {
                    throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
                }
            }
            else if (RegexCharClass.IsBoundaryWordChar(ch))
            {
                string uncapname = ScanCapname();
                if (!IsCaptureName(uncapname))
                {
                    throw MakeException(RegexParseError.UndefinedNamedReference, "Reference to undefined group name '" + uncapname + "'.");
                }
                uncapnum = CaptureSlotFromName(uncapname);
                if (_pos < _pattern.Length && _pattern[_pos] != close)
                {
                    throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
                }
            }
            else
            {
                throw MakeException(RegexParseError.CaptureGroupNameInvalid, "Invalid group name: Group names must begin with a word character.");
            }
        }

        if ((capnum2 != -1 || uncapnum != -1) && _pos < _pattern.Length && _pattern[_pos++] == close)
        {
            return new RegexNode(RegexNodeKind.Capture, _options, capnum2, uncapnum);
        }
        throw MakeException(RegexParseError.InvalidGroupingConstruct, "Unrecognized grouping construct.");
    }

    /// Passes over what IgnorePatternWhitespace ignores, white space and #
    /// comments, and every (?#...) comment.
    void ScanBlank()
    {
        while (true)
        {
            if (UseOptionX())
            {
                while (_pos < _pattern.Length && IsSpace(_pattern[_pos]))
                {
                    _pos++;
                }
                if (_pos < _pattern.Length && _pattern[_pos] == '#')
                {
                    while (_pos < _pattern.Length && _pattern[_pos] != '\n')
                    {
                        _pos++;
                    }
                    continue;
                }
            }
            if (_pos + 2 < _pattern.Length && _pattern[_pos + 2] == '#' && _pattern[_pos + 1] == '?' && _pattern[_pos] == '(')
            {
                while (_pos < _pattern.Length && _pattern[_pos] != ')')
                {
                    _pos++;
                }
                if (_pos == _pattern.Length)
                {
                    throw MakeException(RegexParseError.UnterminatedComment, "Unterminated (?#...) comment.");
                }
                _pos++;
                continue;
            }
            return;
        }
    }

    RegexNode? ScanBackslash(bool scanOnly)
    {
        char ch = _pattern[_pos];
        switch (ch)
        {
            case 'b':
            case 'B':
            case 'A':
            case 'G':
            case 'Z':
            case 'z':
                _pos++;
                return scanOnly ? null : new RegexNode(TypeFromCode(ch), _options);

            case 'w':
            case 'W':
                _pos++;
                return scanOnly ? null : new RegexNode(RegexNodeKind.Set, RemoveIgnoreCaseIfNotEcma(_options), RegexCharClass.Word(UseOptionE(), ch == 'W'));

            case 's':
            case 'S':
                _pos++;
                return scanOnly ? null : new RegexNode(RegexNodeKind.Set, RemoveIgnoreCaseIfNotEcma(_options), RegexCharClass.Space(UseOptionE(), ch == 'S'));

            case 'd':
            case 'D':
                _pos++;
                return scanOnly ? null : new RegexNode(RegexNodeKind.Set, RemoveIgnoreCaseIfNotEcma(_options), RegexCharClass.Digit(UseOptionE(), ch == 'D'));

            case 'p':
            case 'P':
            {
                // The counting scan steps over the \p alone: what follows is
                // read, and refused, only by the parse.
                _pos++;
                if (scanOnly)
                {
                    return null;
                }
                RegexCharClass set = new RegexCharClass();
                set.AddCategoryFromName(ParseProperty(), ch != 'p', UseOptionI(), _pattern, _pos);
                if (UseOptionI())
                {
                    set.AddCaseEquivalences();
                }
                return new RegexNode(RegexNodeKind.Set, RemoveIgnoreCaseIfNotEcma(_options), set.Seal());
            }

            default:
                return ScanBasicBackslash(scanOnly);
        }
    }

    static RegexOptions RemoveIgnoreCaseIfNotEcma(RegexOptions options)
    {
        if ((options & RegexOptions.ECMAScript) == RegexOptions.None)
        {
            options = options & ~RegexOptions.IgnoreCase;
        }
        return options;
    }

    RegexNodeKind TypeFromCode(char ch)
    {
        switch (ch)
        {
            case 'b': return UseOptionE() ? RegexNodeKind.ECMABoundary : RegexNodeKind.Boundary;
            case 'B': return UseOptionE() ? RegexNodeKind.NonECMABoundary : RegexNodeKind.NonBoundary;
            case 'A': return RegexNodeKind.Beginning;
            case 'G': return RegexNodeKind.Start;
            case 'Z': return RegexNodeKind.EndZ;
            default: return RegexNodeKind.End;
        }
    }

    /// A back-reference, \1 \k<name> \<name> \'name', or else an escaped
    /// character.
    RegexNode? ScanBasicBackslash(bool scanOnly)
    {
        int backpos = _pos;
        char close = '\0';
        bool angled = false;
        char ch = _pattern[_pos];

        if (ch == 'k')
        {
            if (_pos + 1 < _pattern.Length)
            {
                _pos++;
                ch = _pattern[_pos++];
                if (ch == '<' || ch == '\'')
                {
                    angled = true;
                    close = ch == '\'' ? '\'' : '>';
                }
            }
            if (!angled || _pos == _pattern.Length)
            {
                throw MakeException(RegexParseError.MalformedNamedReference, "Malformed \\k<...> named back reference.");
            }
            ch = _pattern[_pos];
        }
        else if ((ch == '<' || ch == '\'') && _pos + 1 < _pattern.Length)
        {
            angled = true;
            close = ch == '\'' ? '\'' : '>';
            _pos++;
            ch = _pattern[_pos];
        }

        if (angled && ch >= '0' && ch <= '9')
        {
            int capnum = ScanDecimal();
            if (_pos < _pattern.Length && _pattern[_pos++] == close)
            {
                if (scanOnly)
                {
                    return null;
                }
                if (IsCaptureSlot(capnum))
                {
                    return new RegexNode(RegexNodeKind.Backreference, _options, capnum);
                }
                throw MakeException(RegexParseError.UndefinedNumberedReference, "Reference to undefined group number " + capnum + ".");
            }
        }
        else if (!angled && ch >= '1' && ch <= '9')
        {
            if (UseOptionE())
            {
                // The longest number that names a group opened before this
                // reference; past it, the rest is digits.
                int capnum = -1;
                int newcapnum = ch - '0';
                int pos = _pos - 1;
                while (newcapnum <= _captop)
                {
                    if (IsCaptureSlot(newcapnum) && _caps[newcapnum] < pos)
                    {
                        capnum = newcapnum;
                    }
                    _pos++;
                    if (_pos == _pattern.Length || (ch = _pattern[_pos]) < '0' || ch > '9')
                    {
                        break;
                    }
                    newcapnum = newcapnum * 10 + (ch - '0');
                }
                if (capnum >= 0)
                {
                    return scanOnly ? null : new RegexNode(RegexNodeKind.Backreference, _options, capnum);
                }
            }
            else
            {
                int capnum = ScanDecimal();
                if (scanOnly)
                {
                    return null;
                }
                if (IsCaptureSlot(capnum))
                {
                    return new RegexNode(RegexNodeKind.Backreference, _options, capnum);
                }
                if (capnum <= 9)
                {
                    throw MakeException(RegexParseError.UndefinedNumberedReference, "Reference to undefined group number " + capnum + ".");
                }
            }
        }
        else if (angled && RegexCharClass.IsBoundaryWordChar(ch))
        {
            string capname = ScanCapname();
            if (_pos < _pattern.Length && _pattern[_pos++] == close)
            {
                if (scanOnly)
                {
                    return null;
                }
                if (IsCaptureName(capname))
                {
                    return new RegexNode(RegexNodeKind.Backreference, _options, CaptureSlotFromName(capname));
                }
                throw MakeException(RegexParseError.UndefinedNamedReference, "Reference to undefined group name '" + capname + "'.");
            }
        }

        // Not a back-reference: an escaped character.
        _pos = backpos;
        ch = ScanCharEscape();
        return scanOnly ? null : RegexNode.OneWithCase(ch, _options);
    }

    string ScanCapname()
    {
        int startpos = _pos;
        while (_pos < _pattern.Length && RegexCharClass.IsBoundaryWordChar(_pattern[_pos]))
        {
            _pos++;
        }
        return _pattern.Substring(startpos, _pos - startpos);
    }

    int ScanDecimal()
    {
        int i = 0;
        while (_pos < _pattern.Length && _pattern[_pos] >= '0' && _pattern[_pos] <= '9')
        {
            int d = _pattern[_pos] - '0';
            _pos++;
            if (i > int.MaxValue / 10 || (i == int.MaxValue / 10 && d > int.MaxValue % 10))
            {
                throw MakeException(RegexParseError.QuantifierOrCaptureGroupOutOfRange, "Quantifier and capture group numbers must be less than or equal to Int32.MaxValue.");
            }
            i = i * 10 + d;
        }
        return i;
    }

    /// Up to three octal digits, at most 0377 once the high bits go; under
    /// ECMAScript the digits stop once the value reaches 040.
    char ScanOctal()
    {
        int c = 3;
        int i = 0;
        while (c > 0 && _pos < _pattern.Length && _pattern[_pos] >= '0' && _pattern[_pos] <= '7')
        {
            i = i * 8 + (_pattern[_pos] - '0');
            _pos++;
            c--;
            if (UseOptionE() && i >= 0x20)
            {
                break;
            }
        }
        return (char)(i & 0xFF);
    }

    char ScanHex(int c)
    {
        int i = 0;
        if (_pos + c <= _pattern.Length)
        {
            for (; c > 0; c--)
            {
                int d = HexDigit(_pattern[_pos++]);
                if (d < 0)
                {
                    break;
                }
                i = i * 16 + d;
            }
        }
        if (c > 0)
        {
            throw MakeException(RegexParseError.InsufficientOrInvalidHexDigits, "Insufficient or invalid hexadecimal digits.");
        }
        return (char)i;
    }

    static int HexDigit(char ch)
    {
        if (ch >= '0' && ch <= '9') { return ch - '0'; }
        if (ch >= 'a' && ch <= 'f') { return ch - 'a' + 10; }
        if (ch >= 'A' && ch <= 'F') { return ch - 'A' + 10; }
        return -1;
    }

    char ScanControl()
    {
        if (_pos == _pattern.Length)
        {
            throw MakeException(RegexParseError.MissingControlCharacter, "Missing control character.");
        }
        char ch = _pattern[_pos++];
        if (ch >= 'a' && ch <= 'z')
        {
            ch = (char)(ch - ('a' - 'A'));
        }
        ch = (char)(ch - '@');
        if (ch < ' ')
        {
            return ch;
        }
        throw MakeException(RegexParseError.UnrecognizedControlCharacter, "Unrecognized control character.");
    }

    char ScanCharEscape()
    {
        char ch = _pattern[_pos++];
        if (ch >= '0' && ch <= '7')
        {
            _pos--;
            return ScanOctal();
        }
        switch (ch)
        {
            case 'x': return ScanHex(2);
            case 'u': return ScanHex(4);
            case 'a': return '\u0007';
            case 'b': return '\b';
            case 'e': return '\u001B';
            case 'f': return '\f';
            case 'n': return '\n';
            case 'r': return '\r';
            case 't': return '\t';
            case 'v': return '\u000B';
            case 'c': return ScanControl();
            default:
                if (!UseOptionE() && RegexCharClass.IsBoundaryWordChar(ch))
                {
                    throw MakeException(RegexParseError.UnrecognizedEscape, "Unrecognized escape sequence \\" + ch + ".");
                }
                return ch;
        }
    }

    /// The name inside \p{...}.
    string ParseProperty()
    {
        if (_pos + 2 >= _pattern.Length)
        {
            throw MakeException(RegexParseError.InvalidUnicodePropertyEscape, "Incomplete \\p{X} character escape.");
        }
        char ch = _pattern[_pos++];
        if (ch != '{')
        {
            throw MakeException(RegexParseError.MalformedUnicodePropertyEscape, "Malformed \\p{X} character escape.");
        }
        int startpos = _pos;
        while (_pos < _pattern.Length)
        {
            ch = _pattern[_pos];
            if (!(RegexCharClass.IsBoundaryWordChar(ch) || ch == '-'))
            {
                break;
            }
            _pos++;
        }
        string capname = _pattern.Substring(startpos, _pos - startpos);
        if (_pos == _pattern.Length || _pattern[_pos++] != '}')
        {
            throw MakeException(RegexParseError.InvalidUnicodePropertyEscape, "Incomplete \\p{X} character escape.");
        }
        return capname;
    }

    /// (?imnsx-imnsx), as far as letters of it go.
    void ScanOptions()
    {
        bool off = false;
        for (; _pos < _pattern.Length; _pos++)
        {
            char ch = _pattern[_pos];
            if (ch == '-')
            {
                off = true;
            }
            else if (ch == '+')
            {
                off = false;
            }
            else
            {
                RegexOptions option = OptionFromCode(ch);
                if (option == RegexOptions.None)
                {
                    return;
                }
                _options = off ? _options & ~option : _options | option;
            }
        }
    }

    static RegexOptions OptionFromCode(char ch)
    {
        switch ((char)(ch | (char)0x20))
        {
            case 'i': return RegexOptions.IgnoreCase;
            case 'm': return RegexOptions.Multiline;
            case 'n': return RegexOptions.ExplicitCapture;
            case 's': return RegexOptions.Singleline;
            case 'x': return RegexOptions.IgnorePatternWhitespace;
            default: return RegexOptions.None;
        }
    }

    /// A [...] class from just past its '['. In the counting scan, only how
    /// far it runs and the errors on the way: neither a range turned round
    /// nor what a subtraction holds is looked at until the parse.
    RegexCharClass? ScanCharClass(bool caseInsensitive, bool scanOnly)
    {
        char ch;
        char chPrev = '\0';
        bool inRange = false;
        bool firstChar = true;
        bool closed = false;

        RegexCharClass? set = scanOnly ? null : new RegexCharClass();

        if (_pos < _pattern.Length && _pattern[_pos] == '^')
        {
            _pos++;
            if (!scanOnly)
            {
                set!.Negate = true;
            }
            if (UseOptionE() && _pos < _pattern.Length && _pattern[_pos] == ']')
            {
                firstChar = false;
            }
        }

        for (; _pos < _pattern.Length; firstChar = false)
        {
            bool translatedChar = false;
            ch = _pattern[_pos++];
            if (ch == ']')
            {
                if (!firstChar)
                {
                    closed = true;
                    break;
                }
            }
            else if (ch == '\\' && _pos < _pattern.Length)
            {
                ch = _pattern[_pos++];
                if (ch == 'D' || ch == 'd' || ch == 'S' || ch == 's' || ch == 'W' || ch == 'w')
                {
                    if (!scanOnly)
                    {
                        if (inRange)
                        {
                            throw MakeException(RegexParseError.ShorthandClassInCharacterRange, "Cannot include class \\" + ch + " in character range.");
                        }
                        if (ch == 'D' || ch == 'd')
                        {
                            set!.AddDigit(UseOptionE(), ch == 'D');
                        }
                        else if (ch == 'S' || ch == 's')
                        {
                            set!.AddSpace(UseOptionE(), ch == 'S');
                        }
                        else
                        {
                            set!.AddWord(UseOptionE(), ch == 'W');
                        }
                    }
                    continue;
                }
                if (ch == 'p' || ch == 'P')
                {
                    if (!scanOnly)
                    {
                        if (inRange)
                        {
                            throw MakeException(RegexParseError.ShorthandClassInCharacterRange, "Cannot include class \\" + ch + " in character range.");
                        }
                        set!.AddCategoryFromName(ParseProperty(), ch != 'p', caseInsensitive, _pattern, _pos);
                    }
                    else
                    {
                        ParseProperty();
                    }
                    continue;
                }
                if (ch == '-')
                {
                    // An escaped '-' is a character, and may end a range.
                    if (!scanOnly)
                    {
                        if (inRange)
                        {
                            if (chPrev > ch)
                            {
                                throw MakeException(RegexParseError.ReversedCharacterRange, "[x-y] range in reverse order.");
                            }
                            set!.AddRange(chPrev, ch);
                            inRange = false;
                            chPrev = '\0';
                        }
                        else
                        {
                            set!.AddRange(ch, ch);
                        }
                    }
                    continue;
                }
                _pos--;
                ch = ScanCharEscape();
                translatedChar = true;
            }

            // [:name:], a POSIX class, is nothing special: its '[' is a
            // character, and the ']' after its second colon ends the class.
            if (inRange)
            {
                inRange = false;
                if (!scanOnly)
                {
                    if (ch == '[' && !translatedChar && !firstChar)
                    {
                        // Not a range after all, but a subtraction.
                        set!.AddChar(chPrev);
                        set.AddSubtraction(ScanCharClass(caseInsensitive, scanOnly)!);
                        if (_pos < _pattern.Length && _pattern[_pos] != ']')
                        {
                            throw MakeException(RegexParseError.ExclusionGroupNotLast, "A subtraction must be the last element in a character class.");
                        }
                    }
                    else
                    {
                        if (chPrev > ch)
                        {
                            throw MakeException(RegexParseError.ReversedCharacterRange, "[x-y] range in reverse order.");
                        }
                        set!.AddRange(chPrev, ch);
                    }
                }
            }
            else if (_pos + 1 < _pattern.Length && _pattern[_pos] == '-' && _pattern[_pos + 1] != ']')
            {
                chPrev = ch;
                inRange = true;
                _pos++;
            }
            else if (_pos < _pattern.Length && ch == '-' && !translatedChar && _pattern[_pos] == '[' && !firstChar)
            {
                // A subtraction after a range: [a-z-[aeiou]].
                _pos++;
                RegexCharClass? subtraction = ScanCharClass(caseInsensitive, scanOnly);
                if (!scanOnly)
                {
                    set!.AddSubtraction(subtraction!);
                    if (_pos < _pattern.Length && _pattern[_pos] != ']')
                    {
                        throw MakeException(RegexParseError.ExclusionGroupNotLast, "A subtraction must be the last element in a character class.");
                    }
                }
            }
            else if (!scanOnly)
            {
                set!.AddRange(ch, ch);
            }
        }

        if (!closed)
        {
            throw MakeException(RegexParseError.UnterminatedBracket, "Unterminated [] set.");
        }
        if (!scanOnly && caseInsensitive)
        {
            set!.AddCaseEquivalences();
        }
        return set;
    }

    // ---- building ---------------------------------------------------------

    void PushGroup()
    {
        _stack.Add(_group!);
        _stack.Add(_alternation!);
        _stack.Add(_concatenation!);
    }

    void PopGroup()
    {
        int top = _stack.Count;
        _concatenation = _stack[top - 1];
        _alternation = _stack[top - 2];
        _group = _stack[top - 3];
        _stack.RemoveRange(top - 3, 3);

        // A conditional's first parenthesised group is its condition.
        if (_group.Kind == RegexNodeKind.ExpressionConditional && _group.ChildCount == 0)
        {
            if (_unit == null)
            {
                throw MakeException(RegexParseError.AlternationHasMalformedCondition, "Illegal conditional (?(...)) expression.");
            }
            _group.AddChild(_unit);
            _unit = null;
        }
    }

    void StartGroup(RegexNode openGroup)
    {
        _group = openGroup;
        _alternation = new RegexNode(RegexNodeKind.Alternate, _options);
        _concatenation = new RegexNode(RegexNodeKind.Concatenate, _options);
    }

    void AddAlternate()
    {
        if (_group!.Kind == RegexNodeKind.ExpressionConditional || _group.Kind == RegexNodeKind.BackreferenceConditional)
        {
            _group.AddChild(_concatenation!.ReverseConcatenationIfRightToLeft());
        }
        else
        {
            _alternation!.AddChild(_concatenation!.ReverseConcatenationIfRightToLeft());
        }
        _concatenation = new RegexNode(RegexNodeKind.Concatenate, _options);
    }

    void AddConcatenate(int pos, int cch, bool isReplacement)
    {
        if (cch == 0)
        {
            return;
        }
        if (cch > 1 && (isReplacement || !UseOptionI()))
        {
            _concatenation!.AddChild(new RegexNode(RegexNodeKind.Multi, _options & ~RegexOptions.IgnoreCase, _pattern.Substring(pos, cch)));
            return;
        }
        for (int i = pos; i < pos + cch; i++)
        {
            _concatenation!.AddChild(RegexNode.OneWithCase(_pattern[i], isReplacement ? _options & ~RegexOptions.IgnoreCase : _options));
        }
    }

    void AddConcatenate()
    {
        _concatenation!.AddChild(_unit!);
        _unit = null;
    }

    void AddConcatenate(bool lazy, int min, int max)
    {
        _concatenation!.AddChild(_unit!.MakeQuantifier(lazy, min, max));
        _unit = null;
    }

    void AddGroup()
    {
        if (_group!.Kind == RegexNodeKind.ExpressionConditional || _group.Kind == RegexNodeKind.BackreferenceConditional)
        {
            _group.AddChild(_concatenation!.ReverseConcatenationIfRightToLeft());
            if ((_group.Kind == RegexNodeKind.BackreferenceConditional && _group.ChildCount > 2) || _group.ChildCount > 3)
            {
                throw MakeException(RegexParseError.AlternationHasTooManyConditions, "Too many | in (?()|).");
            }
        }
        else
        {
            _alternation!.AddChild(_concatenation!.ReverseConcatenationIfRightToLeft());
            _group.AddChild(_alternation);
        }
        _concatenation = new RegexNode(RegexNodeKind.Concatenate, _options);
        _unit = _group;
    }

    static bool IsSpace(char ch)
    {
        return ch == ' ' || (ch >= '\t' && ch <= '\r');
    }

    /// The characters that end a run of literal ones: the metacharacters,
    /// and under IgnorePatternWhitespace also white space and '#'.
    static bool IsSpecial(char ch)
    {
        return ch == '\\' || ch == '[' || ch == '(' || ch == ')' || ch == '|' || ch == '^' || ch == '$'
            || ch == '.' || ch == '*' || ch == '+' || ch == '?' || ch == '{';
    }

    static bool IsStopperX(char ch)
    {
        return IsSpecial(ch) || IsSpace(ch) || ch == '#';
    }

    static bool IsQuantifier(char ch)
    {
        return ch == '*' || ch == '+' || ch == '?' || ch == '{';
    }

    /// Whether the cursor is at a quantifier, a '{' only when what follows
    /// is {n}, {n,} or {n,m}.
    bool IsTrueQuantifier()
    {
        int startpos = _pos;
        char ch = _pattern[startpos];
        if (ch != '{')
        {
            return ch == '*' || ch == '+' || ch == '?';
        }
        int pos = startpos;
        int nChars = _pattern.Length - _pos;
        while (--nChars > 0 && (ch = _pattern[++pos]) >= '0' && ch <= '9')
        {
        }
        if (nChars == 0 || pos - startpos == 1)
        {
            return false;
        }
        if (ch == '}')
        {
            return true;
        }
        if (ch != ',')
        {
            return false;
        }
        while (--nChars > 0 && (ch = _pattern[++pos]) >= '0' && ch <= '9')
        {
        }
        return nChars > 0 && ch == '}';
    }

    /// .NET's Regex.Escape: the metacharacters and white space escaped.
    public static string Escape(string input)
    {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < input.Length; i++)
        {
            char ch = input[i];
            switch (ch)
            {
                case '\\': case '*': case '+': case '?': case '|': case '{': case '[': case '(': case ')':
                case '^': case '$': case '.': case '#': case ' ':
                    sb.Append('\\').Append(ch);
                    break;
                case '\t': sb.Append("\\t"); break;
                case '\n': sb.Append("\\n"); break;
                case '\r': sb.Append("\\r"); break;
                case '\f': sb.Append("\\f"); break;
                default: sb.Append(ch); break;
            }
        }
        return sb.ToString();
    }

    /// .NET's Regex.Unescape: every escape a pattern may hold read as the
    /// character it is, refused as a pattern would refuse it.
    public static string Unescape(string input)
    {
        int i = input.IndexOf('\\');
        if (i < 0)
        {
            return input;
        }
        RegexParser parser = new RegexParser(input, RegexOptions.None);
        StringBuilder sb = new StringBuilder();
        sb.Append(input, 0, i);
        parser._pos = i;
        while (parser._pos < input.Length)
        {
            char ch = input[parser._pos++];
            if (ch == '\\' && parser._pos < input.Length)
            {
                sb.Append(parser.ScanCharEscape());
            }
            else if (ch != '\\')
            {
                sb.Append(ch);
            }
        }
        return sb.ToString();
    }
}

/// What a parse leaves: the tree and the numbering of its groups. `Caps` is
/// null when the numbers have no gaps, and otherwise maps each number to its
/// slot; `CapNames` and `CapsList` are null when no group is named and the
/// numbers have no gaps.
class RegexTree
{
    public RegexNode Root;
    public int CapSize;
    public string[]? CapsList;
    public Dictionary<string, int>? CapNames;
    public Dictionary<int, int>? Caps;
    public RegexOptions Options;

    public RegexTree(RegexNode root, int capsize, string[]? capslist, Dictionary<string, int>? capnames, Dictionary<int, int>? caps, RegexOptions options)
    {
        Root = root;
        CapSize = capsize;
        CapsList = capslist;
        CapNames = capnames;
        Caps = caps;
        Options = options;
    }
}

// ---- replacement patterns --------------------------------------------------------

/// A replacement pattern, read once: its text and its $ references as rules,
/// .NET's RegexReplacement. A rule of 0 or more is a string; below that it
/// is a group's slot, or one of the four specials ($` $' $+ $_).
class RegexReplacement
{
    public const int LeftPortion = -1;
    public const int RightPortion = -2;
    public const int LastGroup = -3;
    public const int WholeString = -4;
    const int Specials = 4;

    public string Pattern;
    string[] _strings;
    int[] _rules;

    public RegexReplacement(string pattern, RegexNode concat, Dictionary<int, int>? caps)
    {
        Pattern = pattern;
        List<string> strings = new List<string>();
        List<int> rules = new List<int>();
        StringBuilder text = new StringBuilder();
        for (int i = 0; i < concat.ChildCount; i++)
        {
            RegexNode child = concat.Child(i);
            if (child.Kind == RegexNodeKind.Multi)
            {
                text.Append(child.Str);
            }
            else if (child.Kind == RegexNodeKind.One)
            {
                text.Append(child.Ch);
            }
            else if (child.Kind == RegexNodeKind.Backreference)
            {
                if (text.Length > 0)
                {
                    rules.Add(strings.Count);
                    strings.Add(text.ToString());
                    text.Clear();
                }
                int slot = child.M;
                if (caps != null && slot >= 0)
                {
                    slot = caps[slot];
                }
                rules.Add(-Specials - 1 - slot);
            }
        }
        if (text.Length > 0)
        {
            rules.Add(strings.Count);
            strings.Add(text.ToString());
        }
        _strings = strings.ToArray();
        _rules = rules.ToArray();
    }

    /// The replacement for one match, its pieces appended in order.
    public void Append(StringBuilder into, Match match)
    {
        for (int i = 0; i < _rules.Length; i++)
        {
            int rule = _rules[i];
            if (rule >= 0)
            {
                into.Append(_strings[rule]);
            }
            else if (rule < -Specials)
            {
                match.AppendGroup(into, -Specials - 1 - rule);
            }
            else
            {
                int special = -Specials - 1 - rule;
                if (special == LeftPortion)
                {
                    into.Append(match.Text, match.TextBeginning, match.Index - match.TextBeginning);
                }
                else if (special == RightPortion)
                {
                    into.Append(match.Text, match.Index + match.Length, match.TextEnd - match.Index - match.Length);
                }
                else if (special == LastGroup)
                {
                    match.AppendGroup(into, match.SlotCount - 1);
                }
                else if (special == WholeString)
                {
                    into.Append(match.Text);
                }
            }
        }
    }

    public string Replacement(Match match)
    {
        StringBuilder sb = new StringBuilder();
        Append(sb, match);
        return sb.ToString();
    }
}

// ---- the program ---------------------------------------------------------------

/// .NET's RegexOpcode: what the interpreter does, in the low six bits, with
/// the direction and the backtracking entries as flags above them.
enum RegexOpcode
{
    Onerep = 0,
    Notonerep = 1,
    Setrep = 2,
    Oneloop = 3,
    Notoneloop = 4,
    Setloop = 5,
    Onelazy = 6,
    Notonelazy = 7,
    Setlazy = 8,
    One = 9,
    Notone = 10,
    Set = 11,
    Multi = 12,
    Backreference = 13,
    Bol = 14,
    Eol = 15,
    Boundary = 16,
    NonBoundary = 17,
    Beginning = 18,
    Start = 19,
    EndZ = 20,
    End = 21,
    Nothing = 22,
    Lazybranch = 23,
    Branchmark = 24,
    Lazybranchmark = 25,
    Nullcount = 26,
    Setcount = 27,
    Branchcount = 28,
    Lazybranchcount = 29,
    Nullmark = 30,
    Setmark = 31,
    Capturemark = 32,
    Getmark = 33,
    Setjump = 34,
    Backjump = 35,
    Forejump = 36,
    TestBackreference = 37,
    Goto = 38,
    Stop = 40,
    ECMABoundary = 41,
    NonECMABoundary = 42,
    OperatorMask = 63,
    RightToLeft = 64,
    Backtracking = 128,
    BacktrackingSecond = 256,
    CaseInsensitive = 512
}

/// A pattern as the interpreter runs it: the codes, and the sets and strings
/// their operands name.
class RegexCode
{
    public int[] Codes;
    public RegexCharClass[] Sets;
    public string[] Strings;
    public bool RightToLeft;

    public RegexCode(int[] codes, RegexCharClass[] sets, string[] strings, bool rightToLeft)
    {
        Codes = codes;
        Sets = sets;
        Strings = strings;
        RightToLeft = rightToLeft;
    }
}

/// .NET's RegexWriter: the tree as codes. A program is a lazy branch to its
/// end, the tree, and Stop; a group is Setmark ... Capturemark; a loop is a
/// mark or a count, its body, and a branch back.
class RegexWriter
{
    List<int> _emitted = new List<int>();
    List<int> _intStack = new List<int>();
    List<RegexCharClass> _sets = new List<RegexCharClass>();
    List<string> _strings = new List<string>();
    Dictionary<string, int> _stringIndex = new Dictionary<string, int>();
    Dictionary<int, int>? _caps;

    RegexWriter(Dictionary<int, int>? caps)
    {
        _caps = caps;
    }

    public static RegexCode Write(RegexTree tree)
    {
        RegexWriter writer = new RegexWriter(tree.Caps);
        writer.Emit(RegexOpcode.Lazybranch, 0);
        writer.EmitNode(tree.Root);
        writer.PatchJump(0, writer._emitted.Count);
        writer.Emit(RegexOpcode.Stop);
        return new RegexCode(writer._emitted.ToArray(), writer._sets.ToArray(), writer._strings.ToArray(),
            (tree.Options & RegexOptions.RightToLeft) != RegexOptions.None);
    }

    int MapCapture(int capnum)
    {
        if (capnum == -1)
        {
            return -1;
        }
        return _caps == null ? capnum : _caps[capnum];
    }

    void Emit(RegexOpcode op)
    {
        _emitted.Add((int)op);
    }

    void Emit(RegexOpcode op, int a)
    {
        _emitted.Add((int)op);
        _emitted.Add(a);
    }

    void Emit(RegexOpcode op, int a, int b)
    {
        _emitted.Add((int)op);
        _emitted.Add(a);
        _emitted.Add(b);
    }

    void PatchJump(int offset, int jumpDest)
    {
        _emitted[offset + 1] = jumpDest;
    }

    int SetCode(RegexCharClass set)
    {
        _sets.Add(set);
        return _sets.Count - 1;
    }

    int StringCode(string str)
    {
        int code;
        if (!_stringIndex.TryGetValue(str, out code))
        {
            code = _strings.Count;
            _strings.Add(str);
            _stringIndex[str] = code;
        }
        return code;
    }

    void Push(int value) { _intStack.Add(value); }

    int Pop()
    {
        int value = _intStack[_intStack.Count - 1];
        _intStack.RemoveAt(_intStack.Count - 1);
        return value;
    }

    void EmitNode(RegexNode node)
    {
        int count = node.ChildCount;
        if (count == 0)
        {
            EmitLeaf(node);
            return;
        }
        for (int i = 0; i < count; i++)
        {
            BeforeChild(node, i);
            EmitNode(node.Child(i));
            AfterChild(node, i);
        }
    }

    void BeforeChild(RegexNode node, int curIndex)
    {
        switch (node.Kind)
        {
            case RegexNodeKind.Alternate:
                if (curIndex < node.ChildCount - 1)
                {
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Lazybranch, 0);
                }
                break;

            case RegexNodeKind.BackreferenceConditional:
                if (curIndex == 0)
                {
                    Emit(RegexOpcode.Setjump);
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Lazybranch, 0);
                    Emit(RegexOpcode.TestBackreference, MapCapture(node.M));
                    Emit(RegexOpcode.Forejump);
                }
                break;

            case RegexNodeKind.ExpressionConditional:
                if (curIndex == 0)
                {
                    Emit(RegexOpcode.Setjump);
                    Emit(RegexOpcode.Setmark);
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Lazybranch, 0);
                }
                break;

            case RegexNodeKind.Loop:
            case RegexNodeKind.Lazyloop:
                if (node.N < int.MaxValue || node.M > 1)
                {
                    Emit(node.M == 0 ? RegexOpcode.Nullcount : RegexOpcode.Setcount, node.M == 0 ? 0 : 1 - node.M);
                }
                else
                {
                    Emit(node.M == 0 ? RegexOpcode.Nullmark : RegexOpcode.Setmark);
                }
                if (node.M == 0)
                {
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Goto, 0);
                }
                Push(_emitted.Count);
                break;

            case RegexNodeKind.Capture:
                Emit(RegexOpcode.Setmark);
                break;

            case RegexNodeKind.PositiveLookaround:
                Emit(RegexOpcode.Setjump);
                Emit(RegexOpcode.Setmark);
                break;

            case RegexNodeKind.NegativeLookaround:
                Emit(RegexOpcode.Setjump);
                Push(_emitted.Count);
                Emit(RegexOpcode.Lazybranch, 0);
                break;

            case RegexNodeKind.Atomic:
                Emit(RegexOpcode.Setjump);
                break;
        }
    }

    void AfterChild(RegexNode node, int curIndex)
    {
        switch (node.Kind)
        {
            case RegexNodeKind.Alternate:
                if (curIndex < node.ChildCount - 1)
                {
                    int branch = Pop();
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Goto, 0);
                    PatchJump(branch, _emitted.Count);
                }
                else
                {
                    for (int i = 0; i < curIndex; i++)
                    {
                        PatchJump(Pop(), _emitted.Count);
                    }
                }
                break;

            case RegexNodeKind.BackreferenceConditional:
                if (curIndex == 0)
                {
                    int branch = Pop();
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Goto, 0);
                    PatchJump(branch, _emitted.Count);
                    Emit(RegexOpcode.Forejump);
                    if (node.ChildCount <= 1)
                    {
                        PatchJump(Pop(), _emitted.Count);
                    }
                }
                else
                {
                    PatchJump(Pop(), _emitted.Count);
                }
                break;

            case RegexNodeKind.ExpressionConditional:
                if (curIndex == 0)
                {
                    Emit(RegexOpcode.Getmark);
                    Emit(RegexOpcode.Forejump);
                }
                else if (curIndex == 1)
                {
                    int branch = Pop();
                    Push(_emitted.Count);
                    Emit(RegexOpcode.Goto, 0);
                    PatchJump(branch, _emitted.Count);
                    Emit(RegexOpcode.Getmark);
                    Emit(RegexOpcode.Forejump);
                    if (node.ChildCount <= 2)
                    {
                        PatchJump(Pop(), _emitted.Count);
                    }
                }
                else
                {
                    PatchJump(Pop(), _emitted.Count);
                }
                break;

            case RegexNodeKind.Loop:
            case RegexNodeKind.Lazyloop:
            {
                int startJumpPos = _emitted.Count;
                bool lazy = node.Kind == RegexNodeKind.Lazyloop;
                if (node.N < int.MaxValue || node.M > 1)
                {
                    Emit(lazy ? RegexOpcode.Lazybranchcount : RegexOpcode.Branchcount, Pop(), node.N == int.MaxValue ? int.MaxValue : node.N - node.M);
                }
                else
                {
                    Emit(lazy ? RegexOpcode.Lazybranchmark : RegexOpcode.Branchmark, Pop());
                }
                if (node.M == 0)
                {
                    PatchJump(Pop(), startJumpPos);
                }
                break;
            }

            case RegexNodeKind.Capture:
                Emit(RegexOpcode.Capturemark, MapCapture(node.M), MapCapture(node.N));
                break;

            case RegexNodeKind.PositiveLookaround:
                Emit(RegexOpcode.Getmark);
                Emit(RegexOpcode.Forejump);
                break;

            case RegexNodeKind.NegativeLookaround:
                Emit(RegexOpcode.Backjump);
                PatchJump(Pop(), _emitted.Count);
                Emit(RegexOpcode.Forejump);
                break;

            case RegexNodeKind.Atomic:
                Emit(RegexOpcode.Forejump);
                break;
        }
    }

    void EmitLeaf(RegexNode node)
    {
        int bits = 0;
        if ((node.Options & RegexOptions.RightToLeft) != RegexOptions.None)
        {
            bits = bits | (int)RegexOpcode.RightToLeft;
        }
        if ((node.Options & RegexOptions.IgnoreCase) != RegexOptions.None)
        {
            bits = bits | (int)RegexOpcode.CaseInsensitive;
        }

        switch (node.Kind)
        {
            case RegexNodeKind.One:
                Emit((RegexOpcode)((int)RegexOpcode.One | bits), node.Ch);
                break;

            case RegexNodeKind.Notone:
                Emit((RegexOpcode)((int)RegexOpcode.Notone | bits), node.Ch);
                break;

            case RegexNodeKind.Oneloop:
            case RegexNodeKind.Onelazy:
            case RegexNodeKind.Notoneloop:
            case RegexNodeKind.Notonelazy:
            {
                bool one = node.Kind == RegexNodeKind.Oneloop || node.Kind == RegexNodeKind.Onelazy;
                if (node.M > 0)
                {
                    Emit((RegexOpcode)((int)(one ? RegexOpcode.Onerep : RegexOpcode.Notonerep) | bits), node.Ch, node.M);
                }
                if (node.N > node.M)
                {
                    Emit((RegexOpcode)((int)node.Kind | bits), node.Ch, node.N == int.MaxValue ? int.MaxValue : node.N - node.M);
                }
                break;
            }

            case RegexNodeKind.Setloop:
            case RegexNodeKind.Setlazy:
            {
                int setCode = SetCode(node.Set!);
                if (node.M > 0)
                {
                    Emit((RegexOpcode)((int)RegexOpcode.Setrep | bits), setCode, node.M);
                }
                if (node.N > node.M)
                {
                    Emit((RegexOpcode)((int)node.Kind | bits), setCode, node.N == int.MaxValue ? int.MaxValue : node.N - node.M);
                }
                break;
            }

            case RegexNodeKind.Multi:
                Emit((RegexOpcode)((int)RegexOpcode.Multi | bits), StringCode(node.Str));
                break;

            case RegexNodeKind.Set:
                Emit((RegexOpcode)((int)RegexOpcode.Set | bits), SetCode(node.Set!));
                break;

            case RegexNodeKind.Backreference:
                Emit((RegexOpcode)((int)RegexOpcode.Backreference | bits), MapCapture(node.M));
                break;

            case RegexNodeKind.Nothing:
                Emit(RegexOpcode.Nothing);
                break;

            case RegexNodeKind.Bol:
            case RegexNodeKind.Eol:
            case RegexNodeKind.Boundary:
            case RegexNodeKind.NonBoundary:
            case RegexNodeKind.ECMABoundary:
            case RegexNodeKind.NonECMABoundary:
            case RegexNodeKind.Beginning:
            case RegexNodeKind.Start:
            case RegexNodeKind.EndZ:
            case RegexNodeKind.End:
                Emit((RegexOpcode)(int)node.Kind);
                break;

            // Empty, and a group, alternation or concatenation with nothing
            // in it: no code.
        }
    }
}

// ---- the interpreter ------------------------------------------------------------

/// .NET's RegexInterpreter over a RegexCode. Three stacks, each growing
/// downwards from the end of its array: the backtracking track (values,
/// then the code position to resume at, negated for the second backtracking
/// entry), the stack of marks and counts, and the crawl of captures made,
/// which backtracking pops to undo them.
class RegexInterpreter
{
    Regex _regex;
    RegexCode _code;
    int[] _codes;
    string _text = "";
    int _beg;
    int _end;
    int _start;
    int _pos;

    int[] _track = new int[256];
    int _trackpos;
    int[] _stack = new int[256];
    int _stackpos;
    int[] _crawl = new int[32];
    int _crawlpos;

    int _codepos;
    int _operator;
    bool _rtl;
    bool _ci;
    Match _match;

    // The match timeout: a clock read every thousand steps.
    bool _checkTimeout;
    long _timeoutAt;
    int _stepsToCheck;

    public RegexInterpreter(Regex regex, RegexCode code)
    {
        _regex = regex;
        _code = code;
        _codes = code.Codes;
        _match = new Match(regex, regex.CapSize, "", 0, 0, 0);
    }

    /// The first match in text[beg, end) from startat, or null: the search
    /// .NET's RunSingleMatch makes, a step past an empty previous match
    /// first (prevlen 0), with \G at startat all the same.
    public Match? Scan(string text, int beg, int end, int startat, int prevlen)
    {
        _text = text;
        _beg = beg;
        _end = end;
        _start = startat;
        _pos = startat;
        bool rtl = _code.RightToLeft;
        int bump = rtl ? -1 : 1;
        int stoppos = rtl ? beg : end;

        TimeSpan timeout = _regex.MatchTimeout;
        _checkTimeout = timeout != Regex.InfiniteMatchTimeout;
        if (_checkTimeout)
        {
            _timeoutAt = Environment.TickCount64 + (long)timeout.TotalMilliseconds;
            _stepsToCheck = 1000;
        }

        if (prevlen == 0)
        {
            if (_pos == stoppos)
            {
                return null;
            }
            _pos = _pos + bump;
        }

        _match = new Match(_regex, _regex.CapSize, text, beg, end - beg, startat);
        while (true)
        {
            _trackpos = _track.Length;
            _stackpos = _stack.Length;
            _crawlpos = _crawl.Length;
            if (Go())
            {
                _match.Tidy(_pos);
                return _match;
            }
            if (_pos == stoppos)
            {
                return null;
            }
            _pos = _pos + bump;
        }
    }

    void CheckTimeout()
    {
        if (_checkTimeout && --_stepsToCheck == 0)
        {
            _stepsToCheck = 1000;
            if (Environment.TickCount64 >= _timeoutAt)
            {
                throw new RegexMatchTimeoutException(_text, _regex.ToString(), _regex.MatchTimeout);
            }
        }
    }

    // ---- the stacks --------------------------------------------------------

    void EnsureTrack()
    {
        if (_trackpos < 8)
        {
            int[] grown = new int[_track.Length * 2];
            Array.Copy(_track, 0, grown, _track.Length, _track.Length);
            _trackpos = _trackpos + _track.Length;
            _track = grown;
        }
    }

    void EnsureStack()
    {
        if (_stackpos < 8)
        {
            int[] grown = new int[_stack.Length * 2];
            Array.Copy(_stack, 0, grown, _stack.Length, _stack.Length);
            _stackpos = _stackpos + _stack.Length;
            _stack = grown;
        }
    }

    void TrackPush()
    {
        EnsureTrack();
        _track[--_trackpos] = _codepos;
    }

    void TrackPush(int i1)
    {
        EnsureTrack();
        _track[--_trackpos] = i1;
        _track[--_trackpos] = _codepos;
    }

    void TrackPush(int i1, int i2)
    {
        EnsureTrack();
        _track[--_trackpos] = i1;
        _track[--_trackpos] = i2;
        _track[--_trackpos] = _codepos;
    }

    void TrackPush(int i1, int i2, int i3)
    {
        EnsureTrack();
        _track[--_trackpos] = i1;
        _track[--_trackpos] = i2;
        _track[--_trackpos] = i3;
        _track[--_trackpos] = _codepos;
    }

    void TrackPush2(int i1)
    {
        EnsureTrack();
        _track[--_trackpos] = i1;
        _track[--_trackpos] = -_codepos;
    }

    void TrackPush2(int i1, int i2)
    {
        EnsureTrack();
        _track[--_trackpos] = i1;
        _track[--_trackpos] = i2;
        _track[--_trackpos] = -_codepos;
    }

    void TrackPop() { _trackpos++; }
    void TrackPop(int framesize) { _trackpos = _trackpos + framesize; }
    int TrackPeek() { return _track[_trackpos - 1]; }
    int TrackPeek(int i) { return _track[_trackpos - i - 1]; }

    void StackPush(int i1)
    {
        EnsureStack();
        _stack[--_stackpos] = i1;
    }

    void StackPush(int i1, int i2)
    {
        EnsureStack();
        _stack[--_stackpos] = i1;
        _stack[--_stackpos] = i2;
    }

    void StackPop() { _stackpos++; }
    void StackPop(int framesize) { _stackpos = _stackpos + framesize; }
    int StackPeek() { return _stack[_stackpos - 1]; }
    int StackPeek(int i) { return _stack[_stackpos - i - 1]; }

    int Trackpos() { return _track.Length - _trackpos; }
    void Trackto(int newpos) { _trackpos = _track.Length - newpos; }
    int Crawlpos() { return _crawl.Length - _crawlpos; }

    void Crawl(int capnum)
    {
        if (_crawlpos == 0)
        {
            int[] grown = new int[_crawl.Length * 2];
            Array.Copy(_crawl, 0, grown, _crawl.Length, _crawl.Length);
            _crawlpos = _crawlpos + _crawl.Length;
            _crawl = grown;
        }
        _crawl[--_crawlpos] = capnum;
    }

    int Popcrawl() { return _crawl[_crawlpos++]; }

    void Capture(int capnum, int start, int end)
    {
        if (end < start)
        {
            int t = end;
            end = start;
            start = t;
        }
        Crawl(capnum);
        _match.AddMatch(capnum, start, end - start);
    }

    /// A balancing group's capture: the text between the two intervals it
    /// cancels, and the group it balances popped -- both undone, as any
    /// capture, by the crawl.
    void TransferCapture(int capnum, int uncapnum, int start, int end)
    {
        if (end < start)
        {
            int t = end;
            end = start;
            start = t;
        }
        int start2 = _match.MatchIndex(uncapnum);
        int end2 = start2 + _match.MatchLength(uncapnum);
        if (start >= end2)
        {
            end = start;
            start = end2;
        }
        else if (end <= start2)
        {
            start = start2;
        }
        else
        {
            if (end > end2)
            {
                end = end2;
            }
            if (start2 > start)
            {
                start = start2;
            }
        }
        Crawl(uncapnum);
        _match.BalanceMatch(uncapnum);
        if (capnum != -1)
        {
            Crawl(capnum);
            _match.AddMatch(capnum, start, end - start);
        }
    }

    void Uncapture()
    {
        _match.RemoveMatch(Popcrawl());
    }

    // ---- the text ------------------------------------------------------------

    int Operand(int i) { return _codes[_codepos + i + 1]; }

    void SetOperator(int op)
    {
        _ci = (op & (int)RegexOpcode.CaseInsensitive) != 0;
        _rtl = (op & (int)RegexOpcode.RightToLeft) != 0;
        _operator = op & ~((int)RegexOpcode.RightToLeft | (int)RegexOpcode.CaseInsensitive);
    }

    void Advance(int i)
    {
        _codepos = _codepos + i + 1;
        SetOperator(_codes[_codepos]);
    }

    void Goto(int newpos)
    {
        _codepos = newpos;
        SetOperator(_codes[newpos]);
    }

    void Backtrack()
    {
        CheckTimeout();
        int newpos = _track[_trackpos];
        _trackpos++;
        int back = (int)RegexOpcode.Backtracking;
        if (newpos < 0)
        {
            newpos = -newpos;
            back = (int)RegexOpcode.BacktrackingSecond;
        }
        SetOperator(_codes[newpos] | back);
        _codepos = newpos;
    }

    int Forwardchars() { return _rtl ? _pos - _beg : _end - _pos; }

    char Forwardcharnext()
    {
        if (_rtl)
        {
            _pos--;
            return _text[_pos];
        }
        char c = _text[_pos];
        _pos++;
        return c;
    }

    void Backwardnext() { _pos = _pos + (_rtl ? 1 : -1); }
    int Bump() { return _rtl ? -1 : 1; }
    int Leftchars() { return _pos - _beg; }
    int Rightchars() { return _end - _pos; }

    bool IsBoundary(int index)
    {
        return (index > _beg && RegexCharClass.IsBoundaryWordChar(_text[index - 1]))
            != (index < _end && RegexCharClass.IsBoundaryWordChar(_text[index]));
    }

    bool IsECMABoundary(int index)
    {
        return (index > _beg && RegexCharClass.IsEcmaWordChar(_text[index - 1]))
            != (index < _end && RegexCharClass.IsEcmaWordChar(_text[index]));
    }

    bool MatchString(string str)
    {
        int c = str.Length;
        int pos;
        if (!_rtl)
        {
            if (_end - _pos < c)
            {
                return false;
            }
            pos = _pos + c;
        }
        else
        {
            if (_pos - _beg < c)
            {
                return false;
            }
            pos = _pos;
        }
        while (c != 0)
        {
            if (str[--c] != _text[--pos])
            {
                return false;
            }
        }
        if (!_rtl)
        {
            pos = pos + str.Length;
        }
        _pos = pos;
        return true;
    }

    /// A back-reference: the text the group last captured, again, compared
    /// lower-cased under IgnoreCase.
    bool MatchRef(int index, int length)
    {
        int pos;
        if (!_rtl)
        {
            if (_end - _pos < length)
            {
                return false;
            }
            pos = _pos + length;
        }
        else
        {
            if (_pos - _beg < length)
            {
                return false;
            }
            pos = _pos;
        }
        int cmpos = index + length;
        int c = length;
        if (!_ci)
        {
            while (c-- != 0)
            {
                if (_text[--cmpos] != _text[--pos])
                {
                    return false;
                }
            }
        }
        else
        {
            while (c-- != 0)
            {
                if (Char.ToLowerInvariant(_text[--cmpos]) != Char.ToLowerInvariant(_text[--pos]))
                {
                    return false;
                }
            }
        }
        if (!_rtl)
        {
            pos = pos + length;
        }
        _pos = pos;
        return true;
    }

    // ---- the run ---------------------------------------------------------------

    const int Back = (int)RegexOpcode.Backtracking;
    const int Back2 = (int)RegexOpcode.BacktrackingSecond;

    /// The program from its start at _pos: whether it found a match, the
    /// position its end left _pos at, and its captures in _match.
    bool Go()
    {
        _match.Reset();
        _codepos = 0;
        SetOperator(_codes[0]);
        int advance = -1;

        while (true)
        {
            if (advance >= 0)
            {
                Advance(advance);
                advance = -1;
            }
            CheckTimeout();

            int op = _operator & (int)RegexOpcode.OperatorMask;
            int back = _operator & (Back | Back2);
            bool fail = false;

            switch ((RegexOpcode)op)
            {
                case RegexOpcode.Stop:
                    return _match.FoundMatch;

                case RegexOpcode.Nothing:
                    fail = true;
                    break;

                case RegexOpcode.Goto:
                    Goto(Operand(0));
                    continue;

                case RegexOpcode.TestBackreference:
                    if (!_match.IsMatched(Operand(0)))
                    {
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;

                case RegexOpcode.Lazybranch:
                    if (back == 0)
                    {
                        TrackPush(_pos);
                        advance = 1;
                        continue;
                    }
                    TrackPop();
                    _pos = TrackPeek();
                    Goto(Operand(0));
                    continue;

                case RegexOpcode.Setmark:
                case RegexOpcode.Nullmark:
                    if (back == 0)
                    {
                        StackPush(op == (int)RegexOpcode.Setmark ? _pos : -1);
                        TrackPush();
                        advance = 0;
                        continue;
                    }
                    StackPop();
                    fail = true;
                    break;

                case RegexOpcode.Getmark:
                    if (back == 0)
                    {
                        StackPop();
                        TrackPush(StackPeek());
                        _pos = StackPeek();
                        advance = 0;
                        continue;
                    }
                    TrackPop();
                    StackPush(TrackPeek());
                    fail = true;
                    break;

                case RegexOpcode.Capturemark:
                    if (back == 0)
                    {
                        if (Operand(1) != -1 && !_match.IsMatched(Operand(1)))
                        {
                            fail = true;
                            break;
                        }
                        StackPop();
                        if (Operand(1) != -1)
                        {
                            TransferCapture(Operand(0), Operand(1), StackPeek(), _pos);
                        }
                        else
                        {
                            Capture(Operand(0), StackPeek(), _pos);
                        }
                        TrackPush(StackPeek());
                        advance = 2;
                        continue;
                    }
                    TrackPop();
                    StackPush(TrackPeek());
                    Uncapture();
                    if (Operand(0) != -1 && Operand(1) != -1)
                    {
                        Uncapture();
                    }
                    fail = true;
                    break;

                case RegexOpcode.Branchmark:
                    if (back == 0)
                    {
                        StackPop();
                        int matched = _pos - StackPeek();
                        if (matched != 0)
                        {
                            // Something matched: loop again.
                            TrackPush(StackPeek(), _pos);
                            StackPush(_pos);
                            Goto(Operand(0));
                        }
                        else
                        {
                            // Nothing: go straight on.
                            TrackPush2(StackPeek());
                            advance = 1;
                        }
                        continue;
                    }
                    if (back == Back)
                    {
                        TrackPop(2);
                        StackPop();
                        _pos = TrackPeek(1);
                        TrackPush2(TrackPeek());
                        advance = 1;
                        continue;
                    }
                    TrackPop();
                    StackPush(TrackPeek());
                    fail = true;
                    break;

                case RegexOpcode.Lazybranchmark:
                    if (back == 0)
                    {
                        // The first pass, and after each match of the body:
                        // on, without looping; backtracking loops.
                        StackPop();
                        int oldMarkPos = StackPeek();
                        if (_pos != oldMarkPos)
                        {
                            if (oldMarkPos != -1)
                            {
                                TrackPush(oldMarkPos, _pos);
                            }
                            else
                            {
                                TrackPush(_pos, _pos);
                            }
                        }
                        else
                        {
                            StackPush(oldMarkPos);
                            TrackPush2(StackPeek());
                        }
                        advance = 1;
                        continue;
                    }
                    if (back == Back)
                    {
                        TrackPop(2);
                        int pos = TrackPeek(1);
                        TrackPush2(TrackPeek());
                        StackPush(pos);
                        _pos = pos;
                        Goto(Operand(0));
                        continue;
                    }
                    StackPop();
                    TrackPop();
                    StackPush(TrackPeek());
                    fail = true;
                    break;

                case RegexOpcode.Setcount:
                case RegexOpcode.Nullcount:
                    if (back == 0)
                    {
                        StackPush(op == (int)RegexOpcode.Setcount ? _pos : -1, Operand(0));
                        TrackPush();
                        advance = 1;
                        continue;
                    }
                    StackPop(2);
                    fail = true;
                    break;

                case RegexOpcode.Branchcount:
                    if (back == 0)
                    {
                        StackPop(2);
                        int mark = StackPeek();
                        int count = StackPeek(1);
                        int matched = _pos - mark;
                        if (count >= Operand(1) || (matched == 0 && count >= 0))
                        {
                            // As many as allowed, or an empty one: straight on.
                            TrackPush2(mark, count);
                            advance = 2;
                        }
                        else
                        {
                            TrackPush(mark);
                            StackPush(_pos, count + 1);
                            Goto(Operand(0));
                        }
                        continue;
                    }
                    if (back == Back)
                    {
                        TrackPop();
                        StackPop(2);
                        if (StackPeek(1) > 0)
                        {
                            _pos = StackPeek();
                            TrackPush2(TrackPeek(), StackPeek(1) - 1);
                            advance = 2;
                            continue;
                        }
                        StackPush(TrackPeek(), StackPeek(1) - 1);
                        fail = true;
                        break;
                    }
                    TrackPop(2);
                    StackPush(TrackPeek(), TrackPeek(1));
                    fail = true;
                    break;

                case RegexOpcode.Lazybranchcount:
                    if (back == 0)
                    {
                        StackPop(2);
                        int mark = StackPeek();
                        int count = StackPeek(1);
                        if (count < 0)
                        {
                            // Short of the least: loop now.
                            TrackPush2(mark);
                            StackPush(_pos, count + 1);
                            Goto(Operand(0));
                        }
                        else
                        {
                            TrackPush(mark, count, _pos);
                            advance = 2;
                        }
                        continue;
                    }
                    if (back == Back)
                    {
                        TrackPop(3);
                        int mark = TrackPeek();
                        int textpos = TrackPeek(2);
                        if (TrackPeek(1) < Operand(1) && textpos != mark)
                        {
                            _pos = textpos;
                            StackPush(textpos, TrackPeek(1) + 1);
                            TrackPush2(mark);
                            Goto(Operand(0));
                            continue;
                        }
                        StackPush(TrackPeek(), TrackPeek(1));
                        fail = true;
                        break;
                    }
                    TrackPop();
                    StackPop(2);
                    StackPush(TrackPeek(), StackPeek(1) - 1);
                    fail = true;
                    break;

                case RegexOpcode.Setjump:
                    if (back == 0)
                    {
                        StackPush(Trackpos(), Crawlpos());
                        TrackPush();
                        advance = 0;
                        continue;
                    }
                    StackPop(2);
                    fail = true;
                    break;

                case RegexOpcode.Backjump:
                    StackPop(2);
                    Trackto(StackPeek());
                    while (Crawlpos() != StackPeek(1))
                    {
                        Uncapture();
                    }
                    fail = true;
                    break;

                case RegexOpcode.Forejump:
                    if (back == 0)
                    {
                        StackPop(2);
                        Trackto(StackPeek());
                        TrackPush(StackPeek(1));
                        advance = 0;
                        continue;
                    }
                    TrackPop();
                    while (Crawlpos() != TrackPeek())
                    {
                        Uncapture();
                    }
                    fail = true;
                    break;

                case RegexOpcode.Bol:
                    if (Leftchars() > 0 && _text[_pos - 1] != '\n')
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.Eol:
                    if (Rightchars() > 0 && _text[_pos] != '\n')
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.Boundary:
                    if (!IsBoundary(_pos))
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.NonBoundary:
                    if (IsBoundary(_pos))
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.ECMABoundary:
                    if (!IsECMABoundary(_pos))
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.NonECMABoundary:
                    if (IsECMABoundary(_pos))
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.Beginning:
                    if (Leftchars() > 0)
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.Start:
                    if (_pos != _start)
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.EndZ:
                    if (Rightchars() > 1 || (Rightchars() == 1 && _text[_pos] != '\n'))
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.End:
                    if (Rightchars() > 0)
                    {
                        fail = true;
                        break;
                    }
                    advance = 0;
                    continue;

                case RegexOpcode.One:
                    if (Forwardchars() < 1 || Forwardcharnext() != (char)Operand(0))
                    {
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;

                case RegexOpcode.Notone:
                    if (Forwardchars() < 1 || Forwardcharnext() == (char)Operand(0))
                    {
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;

                case RegexOpcode.Set:
                    if (Forwardchars() < 1 || !_code.Sets[Operand(0)].CharInClass(Forwardcharnext()))
                    {
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;

                case RegexOpcode.Multi:
                    if (!MatchString(_code.Strings[Operand(0)]))
                    {
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;

                case RegexOpcode.Backreference:
                {
                    int capnum = Operand(0);
                    if (_match.IsMatched(capnum))
                    {
                        if (!MatchRef(_match.MatchIndex(capnum), _match.MatchLength(capnum)))
                        {
                            fail = true;
                            break;
                        }
                    }
                    else if ((_regex.Options & RegexOptions.ECMAScript) == RegexOptions.None)
                    {
                        // A group that took part in no match matches nothing,
                        // except under ECMAScript, where it is empty.
                        fail = true;
                        break;
                    }
                    advance = 1;
                    continue;
                }

                case RegexOpcode.Onerep:
                case RegexOpcode.Notonerep:
                case RegexOpcode.Setrep:
                {
                    int c = Operand(1);
                    if (Forwardchars() < c)
                    {
                        fail = true;
                        break;
                    }
                    if (op == (int)RegexOpcode.Setrep)
                    {
                        RegexCharClass set = _code.Sets[Operand(0)];
                        while (c-- > 0)
                        {
                            if (!set.CharInClass(Forwardcharnext()))
                            {
                                fail = true;
                                break;
                            }
                        }
                    }
                    else
                    {
                        char ch = (char)Operand(0);
                        bool want = op == (int)RegexOpcode.Onerep;
                        while (c-- > 0)
                        {
                            if ((Forwardcharnext() == ch) != want)
                            {
                                fail = true;
                                break;
                            }
                        }
                    }
                    if (fail)
                    {
                        break;
                    }
                    advance = 2;
                    continue;
                }

                case RegexOpcode.Oneloop:
                case RegexOpcode.Notoneloop:
                case RegexOpcode.Setloop:
                    if (back == 0)
                    {
                        int c = Operand(1);
                        if (c > Forwardchars())
                        {
                            c = Forwardchars();
                        }
                        int i;
                        if (op == (int)RegexOpcode.Setloop)
                        {
                            RegexCharClass set = _code.Sets[Operand(0)];
                            for (i = c; i > 0; i--)
                            {
                                if (!set.CharInClass(Forwardcharnext()))
                                {
                                    Backwardnext();
                                    break;
                                }
                            }
                        }
                        else
                        {
                            char ch = (char)Operand(0);
                            bool want = op == (int)RegexOpcode.Oneloop;
                            for (i = c; i > 0; i--)
                            {
                                if ((Forwardcharnext() == ch) != want)
                                {
                                    Backwardnext();
                                    break;
                                }
                            }
                        }
                        if (c > i)
                        {
                            TrackPush(c - i - 1, _pos - Bump());
                        }
                        advance = 2;
                        continue;
                    }
                    else
                    {
                        // Give back one more.
                        TrackPop(2);
                        int i = TrackPeek();
                        int pos = TrackPeek(1);
                        _pos = pos;
                        if (i > 0)
                        {
                            TrackPush(i - 1, pos - Bump());
                        }
                        advance = 2;
                        continue;
                    }

                case RegexOpcode.Onelazy:
                case RegexOpcode.Notonelazy:
                case RegexOpcode.Setlazy:
                    if (back == 0)
                    {
                        int c = Operand(1);
                        if (c > Forwardchars())
                        {
                            c = Forwardchars();
                        }
                        if (c > 0)
                        {
                            TrackPush(c - 1, _pos);
                        }
                        advance = 2;
                        continue;
                    }
                    else
                    {
                        // Take one more.
                        TrackPop(2);
                        int pos = TrackPeek(1);
                        _pos = pos;
                        char next = Forwardcharnext();
                        bool ok;
                        if (op == (int)RegexOpcode.Setlazy)
                        {
                            ok = _code.Sets[Operand(0)].CharInClass(next);
                        }
                        else
                        {
                            ok = (next == (char)Operand(0)) == (op == (int)RegexOpcode.Onelazy);
                        }
                        if (!ok)
                        {
                            fail = true;
                            break;
                        }
                        int i = TrackPeek();
                        if (i > 0)
                        {
                            TrackPush(i - 1, pos + Bump());
                        }
                        advance = 2;
                        continue;
                    }

                default:
                    fail = true;
                    break;
            }

            // A failure: back to the last choice.
            Backtrack();
        }
    }
}

// ---- what a match answers ---------------------------------------------------

/// .NET's Capture: a piece of the input, by where it is and what it says.
class Capture
{
    internal string Text;

    internal Capture(string text, int index, int length)
    {
        Text = text;
        Index = index;
        Length = length;
    }

    public int Index { get; internal set; }
    public int Length { get; internal set; }

    public string Value => Text.Substring(Index, Length);

    public ReadOnlySpan<char> ValueSpan => Text.AsSpan(Index, Length);

    public override string ToString()
    {
        return Value;
    }
}

/// A group of a match: its last capture, and every capture it made.
class Group : Capture
{
    internal static readonly Group EmptyGroup = new Group("", new int[0], 0, "");

    internal int[] _caps;
    internal int _capcount;
    CaptureCollection? _capcoll;

    internal Group(string text, int[] caps, int capcount, string name)
        : base(text, capcount == 0 ? 0 : caps[(capcount - 1) * 2], capcount == 0 ? 0 : caps[capcount * 2 - 1])
    {
        _caps = caps;
        _capcount = capcount;
        Name = name;
    }

    public bool Success => _capcount != 0;

    public string Name { get; }

    public CaptureCollection Captures
    {
        get
        {
            if (_capcoll == null)
            {
                _capcoll = new CaptureCollection(this);
            }
            return _capcoll;
        }
    }

    public static Group Synchronized(Group inner)
    {
        if (inner == null) throw new ArgumentNullException(nameof(inner));
        return inner;
    }
}

/// Every capture of a group, first to last; the last is the group itself.
class CaptureCollection : IList<Capture>, IReadOnlyList<Capture>
{
    Group _group;
    int _capcount;
    Capture?[]? _captures;

    internal CaptureCollection(Group group)
    {
        _group = group;
        _capcount = group._capcount;
    }

    public bool IsReadOnly => true;
    public int Count => _capcount;
    public bool IsSynchronized => false;
    public object SyncRoot => _group;

    public Capture this[int i] => GetCapture(i);

    Capture IList<Capture>.this[int index]
    {
        get { return GetCapture(index); }
        set { throw new NotSupportedException("Collection is read-only."); }
    }

    Capture GetCapture(int i)
    {
        if ((uint)i >= (uint)_capcount)
        {
            throw new ArgumentOutOfRangeException("i");
        }
        if (i == _capcount - 1)
        {
            return _group;
        }
        if (_captures == null)
        {
            _captures = new Capture?[_capcount];
        }
        Capture? made = _captures[i];
        if (made == null)
        {
            made = new Capture(_group.Text, _group._caps[i * 2], _group._caps[i * 2 + 1]);
            _captures[i] = made;
        }
        return made;
    }

    public IEnumerator GetEnumerator() { return Captures(); }

    IEnumerator<Capture> IEnumerable<Capture>.GetEnumerator() { return Captures(); }

    IEnumerator<Capture> Captures()
    {
        for (int i = 0; i < _capcount; i++)
        {
            yield return GetCapture(i);
        }
    }

    public void CopyTo(Capture[] array, int arrayIndex)
    {
        if (array == null) throw new ArgumentNullException(nameof(array));
        for (int i = 0; i < _capcount; i++)
        {
            array[arrayIndex + i] = GetCapture(i);
        }
    }

    int IList<Capture>.IndexOf(Capture item)
    {
        for (int i = 0; i < _capcount; i++)
        {
            if (object.Equals(GetCapture(i), item)) { return i; }
        }
        return -1;
    }

    bool ICollection<Capture>.Contains(Capture item) { return ((IList<Capture>)this).IndexOf(item) >= 0; }
    void IList<Capture>.Insert(int index, Capture item) { throw new NotSupportedException("Collection is read-only."); }
    void IList<Capture>.RemoveAt(int index) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Capture>.Add(Capture item) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Capture>.Clear() { throw new NotSupportedException("Collection is read-only."); }
    bool ICollection<Capture>.Remove(Capture item) { throw new NotSupportedException("Collection is read-only."); }
}

/// A match's groups, by number and by name. A number with no group, or a
/// name none has, is a group that matched nothing, named "".
// .NET's is an IReadOnlyDictionary<string, Group> as well; here it has that
// interface's members but not the interface, because the compiler shares an
// interface member's slot among the constructions of a generic interface, so
// one class cannot implement both IEnumerable<Group> and
// IEnumerable<KeyValuePair<string, Group>>.
class GroupCollection : IList<Group>, IReadOnlyList<Group>
{
    Match _match;
    Dictionary<int, int>? _captureMap;
    Group[]? _groups;

    internal GroupCollection(Match match, Dictionary<int, int>? caps)
    {
        _match = match;
        _captureMap = caps;
    }

    public bool IsReadOnly => true;
    public int Count => _match._matchcount.Length;
    public bool IsSynchronized => false;
    public object SyncRoot => _match;

    public Group this[int groupnum] => GetGroup(groupnum);

    public Group this[string groupname] => GetGroup(groupname);

    Group IList<Group>.this[int index]
    {
        get { return GetGroup(index); }
        set { throw new NotSupportedException("Collection is read-only."); }
    }

    Group GetGroup(int groupnum)
    {
        if (_captureMap != null)
        {
            int slot;
            if (_captureMap.TryGetValue(groupnum, out slot))
            {
                return GetGroupImpl(slot);
            }
        }
        else if ((uint)groupnum < (uint)_match._matchcount.Length)
        {
            return GetGroupImpl(groupnum);
        }
        return Group.EmptyGroup;
    }

    Group GetGroup(string groupname)
    {
        if (_match._regex != null)
        {
            return GetGroup(_match._regex.GroupNumberFromName(groupname));
        }
        return Group.EmptyGroup;
    }

    /// The group in slot i, every one made the first time one is asked for;
    /// each is named by GroupNameFromNumber of its slot, as .NET names it.
    internal Group GetGroupImpl(int slot)
    {
        if (slot == 0)
        {
            return _match;
        }
        if (_groups == null)
        {
            _groups = new Group[_match._matchcount.Length - 1];
            for (int i = 0; i < _groups.Length; i++)
            {
                string name = _match._regex!.GroupNameFromNumber(i + 1);
                _groups[i] = new Group(_match.Text, _match._matches[i + 1] ?? new int[0], _match._matchcount[i + 1], name);
            }
        }
        return _groups[slot - 1];
    }

    public IEnumerator GetEnumerator() { return Groups(); }

    IEnumerator<Group> IEnumerable<Group>.GetEnumerator() { return Groups(); }

    IEnumerator<Group> Groups()
    {
        for (int i = 0; i < Count; i++)
        {
            yield return GetGroupImpl(i);
        }
    }

    public bool ContainsKey(string key)
    {
        return _match._regex != null && _match._regex.GroupNumberFromName(key) >= 0;
    }

    public bool TryGetValue(string key, out Group value)
    {
        Group group = GetGroup(key);
        if (group == Group.EmptyGroup)
        {
            value = null!;
            return false;
        }
        value = group;
        return true;
    }

    public IEnumerable<string> Keys
    {
        get
        {
            for (int i = 0; i < Count; i++)
            {
                yield return GetGroup(i).Name;
            }
        }
    }

    public IEnumerable<Group> Values
    {
        get
        {
            for (int i = 0; i < Count; i++)
            {
                yield return GetGroup(i);
            }
        }
    }

    public void CopyTo(Group[] array, int arrayIndex)
    {
        if (array == null) throw new ArgumentNullException(nameof(array));
        for (int i = 0; i < Count; i++)
        {
            array[arrayIndex + i] = GetGroupImpl(i);
        }
    }

    int IList<Group>.IndexOf(Group item)
    {
        for (int i = 0; i < Count; i++)
        {
            if (object.Equals(GetGroupImpl(i), item)) { return i; }
        }
        return -1;
    }

    bool ICollection<Group>.Contains(Group item) { return ((IList<Group>)this).IndexOf(item) >= 0; }
    void IList<Group>.Insert(int index, Group item) { throw new NotSupportedException("Collection is read-only."); }
    void IList<Group>.RemoveAt(int index) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Group>.Add(Group item) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Group>.Clear() { throw new NotSupportedException("Collection is read-only."); }
    bool ICollection<Group>.Remove(Group item) { throw new NotSupportedException("Collection is read-only."); }
}

/// One match: group 0 itself, and the captures of every group, kept as .NET
/// keeps them while the interpreter runs -- per slot, pairs of index and
/// length, with a count -- and a balancing group's removals as negative
/// entries until Tidy compacts them.
class Match : Group
{
    internal static readonly Match EmptyMatch = new Match(null, 1, "", 0, 0, 0);

    internal Regex? _regex;
    internal int[][] _matches;
    internal int[] _matchcount;
    internal bool _balancing;
    internal int TextBeginning;
    internal int TextEnd;
    internal int _textstart;
    /// Where the search stopped: the match's end, or under RightToLeft its
    /// start, which is where the next one begins.
    internal int _textpos;
    GroupCollection? _groupcoll;

    internal Match(Regex? regex, int capcount, string text, int begpos, int len, int startpos)
        : base(text, new int[2], 0, "0")
    {
        _regex = regex;
        _matchcount = new int[capcount];
        _matches = new int[capcount][];
        _matches[0] = _caps;
        TextBeginning = begpos;
        TextEnd = begpos + len;
        _textstart = startpos;
    }

    public static Match Empty => EmptyMatch;

    public virtual GroupCollection Groups
    {
        get
        {
            if (_groupcoll == null)
            {
                _groupcoll = new GroupCollection(this, _regex == null ? null : _regex.Caps);
            }
            return _groupcoll;
        }
    }

    internal int SlotCount => _matchcount.Length;

    internal bool FoundMatch => _matchcount[0] > 0;

    internal void Reset()
    {
        for (int i = 0; i < _matchcount.Length; i++)
        {
            _matchcount[i] = 0;
        }
        _balancing = false;
    }

    public Match NextMatch()
    {
        if (_regex == null)
        {
            return this;
        }
        return _regex.RunSingleMatch(Length, Text, TextBeginning, TextEnd - TextBeginning, _textpos);
    }

    /// The replacement pattern, expanded for this match.
    public virtual string Result(string replacement)
    {
        if (replacement == null) throw new ArgumentNullException(nameof(replacement));
        if (_regex == null) throw new NotSupportedException("Result cannot be called on a failed Match.");
        return _regex.ReplacementFor(replacement).Replacement(this);
    }

    public static Match Synchronized(Match inner)
    {
        if (inner == null) throw new ArgumentNullException(nameof(inner));
        return inner;
    }

    internal void AppendGroup(StringBuilder into, int slot)
    {
        int c = _matchcount[slot];
        if (c == 0)
        {
            return;
        }
        int[] matches = _matches[slot];
        into.Append(Text, matches[(c - 1) * 2], matches[c * 2 - 1]);
    }

    internal string GroupText(int slot)
    {
        int c = _matchcount[slot];
        if (c == 0)
        {
            return "";
        }
        int[] matches = _matches[slot];
        return Text.Substring(matches[(c - 1) * 2], matches[c * 2 - 1]);
    }

    internal void AddMatch(int cap, int start, int len)
    {
        if (_matches[cap] == null)
        {
            _matches[cap] = new int[2];
        }
        int capcount = _matchcount[cap];
        if (capcount * 2 + 2 > _matches[cap].Length)
        {
            int[] oldmatches = _matches[cap];
            int[] newmatches = new int[capcount * 8];
            for (int j = 0; j < capcount * 2; j++)
            {
                newmatches[j] = oldmatches[j];
            }
            _matches[cap] = newmatches;
        }
        _matches[cap][capcount * 2] = start;
        _matches[cap][capcount * 2 + 1] = len;
        _matchcount[cap] = capcount + 1;
    }

    /// A capture that balances away the group's last one: a negative entry
    /// pointing at the capture now last, so that backtracking (which only
    /// lowers the count) brings everything back.
    internal void BalanceMatch(int cap)
    {
        _balancing = true;
        int capcount = _matchcount[cap];
        int target = capcount * 2 - 2;
        int[] matches = _matches[cap];
        if (matches[target] < 0)
        {
            target = -3 - matches[target];
        }
        target = target - 2;
        if (target >= 0 && matches[target] < 0)
        {
            AddMatch(cap, matches[target], matches[target + 1]);
        }
        else
        {
            AddMatch(cap, -3 - target, -4 - target);
        }
    }

    internal void RemoveMatch(int cap)
    {
        _matchcount[cap]--;
    }

    internal bool IsMatched(int cap)
    {
        return (uint)cap < (uint)_matchcount.Length && _matchcount[cap] > 0
            && _matches[cap][_matchcount[cap] * 2 - 1] != (-3 + 1);
    }

    internal int MatchIndex(int cap)
    {
        int i = _matches[cap][_matchcount[cap] * 2 - 2];
        return i >= 0 ? i : _matches[cap][-3 - i];
    }

    internal int MatchLength(int cap)
    {
        int i = _matches[cap][_matchcount[cap] * 2 - 1];
        return i >= 0 ? i : _matches[cap][-3 - i];
    }

    /// The match finished: where it ended, group 0's place, and the
    /// balancing entries compacted away.
    internal void Tidy(int textpos)
    {
        _textpos = textpos;
        _capcount = _matchcount[0];
        _caps = _matches[0];
        Index = _caps[0];
        Length = _caps[1];
        if (_balancing)
        {
            TidyBalancing();
        }
        if (_regex != null && (_regex.Options & RegexOptions.NonBacktracking) != RegexOptions.None)
        {
            // NonBacktracking keeps each group's last capture alone.
            for (int cap = 1; cap < _matchcount.Length; cap++)
            {
                int c = _matchcount[cap];
                if (c > 1)
                {
                    int[] matches = _matches[cap];
                    matches[0] = matches[(c - 1) * 2];
                    matches[1] = matches[c * 2 - 1];
                    _matchcount[cap] = 1;
                }
            }
        }
    }

    void TidyBalancing()
    {
        for (int cap = 0; cap < _matchcount.Length; cap++)
        {
            int limit = _matchcount[cap] * 2;
            int[] matcharray = _matches[cap];
            int i;
            for (i = 0; i < limit; i++)
            {
                if (matcharray[i] < 0)
                {
                    break;
                }
            }
            int j = i;
            for (; i < limit; i++)
            {
                if (matcharray[i] < 0)
                {
                    j--;
                }
                else
                {
                    if (i != j)
                    {
                        matcharray[j] = matcharray[i];
                    }
                    j++;
                }
            }
            _matchcount[cap] = j / 2;
        }
        _balancing = false;
    }
}

/// Every match of a regex in an input, found as they are asked for.
class MatchCollection : IList<Match>, IReadOnlyList<Match>
{
    Regex _regex;
    string _input;
    List<Match> _matches = new List<Match>();
    bool _done;
    int _startat;
    int _prevlen = -1;

    internal MatchCollection(Regex regex, string input, int startat)
    {
        _regex = regex;
        _input = input;
        _startat = startat;
    }

    public bool IsReadOnly => true;
    public bool IsSynchronized => false;
    public object SyncRoot => this;

    public int Count
    {
        get
        {
            EnsureInitialized();
            return _matches.Count;
        }
    }

    public virtual Match this[int i]
    {
        get
        {
            if (i < 0)
            {
                throw new ArgumentOutOfRangeException("i");
            }
            Match? match = GetMatch(i);
            if (match == null)
            {
                throw new ArgumentOutOfRangeException("i");
            }
            return match;
        }
    }

    Match IList<Match>.this[int index]
    {
        get { return this[index]; }
        set { throw new NotSupportedException("Collection is read-only."); }
    }

    Match? GetMatch(int i)
    {
        if (_matches.Count > i)
        {
            return _matches[i];
        }
        if (_done)
        {
            return null;
        }
        Match match;
        do
        {
            match = _regex.RunSingleMatch(_prevlen, _input, 0, _input.Length, _startat);
            if (!match.Success)
            {
                _done = true;
                return null;
            }
            _matches.Add(match);
            _prevlen = match.Length;
            _startat = match._textpos;
        } while (_matches.Count <= i);
        return match;
    }

    void EnsureInitialized()
    {
        if (!_done)
        {
            GetMatch(int.MaxValue);
        }
    }

    public IEnumerator GetEnumerator() { return Matches(); }

    IEnumerator<Match> IEnumerable<Match>.GetEnumerator() { return Matches(); }

    IEnumerator<Match> Matches()
    {
        int i = 0;
        while (true)
        {
            Match? match = GetMatch(i);
            if (match == null)
            {
                yield break;
            }
            yield return match;
            i++;
        }
    }

    public void CopyTo(Match[] array, int arrayIndex)
    {
        EnsureInitialized();
        _matches.CopyTo(array, arrayIndex);
    }

    int IList<Match>.IndexOf(Match item) { EnsureInitialized(); return _matches.IndexOf(item); }
    bool ICollection<Match>.Contains(Match item) { EnsureInitialized(); return _matches.Contains(item); }
    void IList<Match>.Insert(int index, Match item) { throw new NotSupportedException("Collection is read-only."); }
    void IList<Match>.RemoveAt(int index) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Match>.Add(Match item) { throw new NotSupportedException("Collection is read-only."); }
    void ICollection<Match>.Clear() { throw new NotSupportedException("Collection is read-only."); }
    bool ICollection<Match>.Remove(Match item) { throw new NotSupportedException("Collection is read-only."); }
}

// ---- Regex -------------------------------------------------------------------------

class Regex
{
    public static readonly TimeSpan InfiniteMatchTimeout = TimeSpan.FromMilliseconds(-1);

    static int _cacheSize = 15;

    string _pattern;
    RegexOptions _options;
    TimeSpan _matchTimeout;
    RegexCode _code;
    /// Group numbers to slots, when the numbers have gaps; null otherwise.
    internal Dictionary<int, int>? Caps;
    /// Names to numbers, and every slot's name; null when no group is named
    /// and the numbers have no gaps.
    Dictionary<string, int>? _capnames;
    string[]? _capslist;
    internal int CapSize;
    RegexReplacement? _replacement;
    /// The interpreter last used, kept for the next search: taken while a
    /// search runs, so two threads never share one.
    RegexInterpreter? _runner;

    public Regex(string pattern) : this(pattern, RegexOptions.None, InfiniteMatchTimeout)
    {
    }

    public Regex(string pattern, RegexOptions options) : this(pattern, options, InfiniteMatchTimeout)
    {
    }

    public Regex(string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        if (pattern == null) throw new ArgumentNullException(nameof(pattern));
        ValidateOptions(options);
        ValidateMatchTimeout(matchTimeout);
        _pattern = pattern;
        _options = options;
        _matchTimeout = matchTimeout;

        RegexTree tree = RegexParser.Parse(pattern, options);
        if ((options & RegexOptions.NonBacktracking) != RegexOptions.None)
        {
            RefuseForNonBacktracking(tree.Root);
        }
        Caps = tree.Caps;
        _capnames = tree.CapNames;
        _capslist = tree.CapsList;
        CapSize = tree.CapSize;
        _code = RegexWriter.Write(tree);
    }

    static void ValidateOptions(RegexOptions options)
    {
        int bits = (int)options;
        if ((bits >> 11) != 0
            || ((options & RegexOptions.ECMAScript) != RegexOptions.None
                && (options & ~(RegexOptions.ECMAScript | RegexOptions.IgnoreCase | RegexOptions.Multiline | RegexOptions.Compiled | RegexOptions.CultureInvariant)) != RegexOptions.None)
            || ((options & RegexOptions.NonBacktracking) != RegexOptions.None
                && (options & (RegexOptions.ECMAScript | RegexOptions.RightToLeft)) != RegexOptions.None))
        {
            throw new ArgumentOutOfRangeException(nameof(options));
        }
    }

    static void ValidateMatchTimeout(TimeSpan matchTimeout)
    {
        if (matchTimeout == InfiniteMatchTimeout)
        {
            return;
        }
        if (matchTimeout > TimeSpan.Zero && matchTimeout <= TimeSpan.FromMilliseconds(int.MaxValue - 1))
        {
            return;
        }
        throw new ArgumentOutOfRangeException(nameof(matchTimeout));
    }

    /// What NonBacktracking cannot run, refused as .NET refuses it: the first
    /// such construct found walking the tree from its last piece back.
    static void RefuseForNonBacktracking(RegexNode node)
    {
        string? what = null;
        switch (node.Kind)
        {
            case RegexNodeKind.Backreference:
                what = "backreference (\\ number)";
                break;
            case RegexNodeKind.PositiveLookaround:
                what = "positive lookahead (?= pattern) or positive lookbehind (?<= pattern)";
                break;
            case RegexNodeKind.NegativeLookaround:
                what = "negative lookahead (?! pattern) or negative lookbehind (?<! pattern)";
                break;
            case RegexNodeKind.Atomic:
                what = "atomic subexpressions (?> pattern)";
                break;
            case RegexNodeKind.BackreferenceConditional:
                what = "captured group conditional (?( name ) yes-pattern | no-pattern ) or (?( number ) yes-pattern| no-pattern )";
                break;
            case RegexNodeKind.ExpressionConditional:
                what = "test conditional (?( test-pattern ) yes-pattern | no-pattern )";
                break;
            case RegexNodeKind.Start:
                what = "contiguous matches (\\G)";
                break;
            case RegexNodeKind.Capture:
                if (node.N != -1)
                {
                    what = "balancing group (?<name1-name2>subexpression) or (?'name1-name2' subexpression)";
                }
                break;
        }
        if (what != null)
        {
            throw new NotSupportedException("RegexOptions.NonBacktracking is not supported in conjunction with expressions containing: '" + what + "'.");
        }
        for (int i = node.ChildCount - 1; i >= 0; i--)
        {
            RefuseForNonBacktracking(node.Child(i));
        }
    }

    public static int CacheSize
    {
        get { return _cacheSize; }
        set
        {
            if (value < 0) throw new ArgumentOutOfRangeException(nameof(value));
            _cacheSize = value;
        }
    }

    public RegexOptions Options => _options;

    public bool RightToLeft => (_options & RegexOptions.RightToLeft) != RegexOptions.None;

    public TimeSpan MatchTimeout => _matchTimeout;

    public override string ToString()
    {
        return _pattern;
    }

    // ---- the groups ------------------------------------------------------------

    public string[] GetGroupNames()
    {
        if (_capslist == null)
        {
            string[] names = new string[CapSize];
            for (int i = 0; i < names.Length; i++)
            {
                names[i] = i.ToString(CultureInfo.InvariantCulture);
            }
            return names;
        }
        string[] copy = new string[_capslist.Length];
        for (int i = 0; i < copy.Length; i++)
        {
            copy[i] = _capslist[i];
        }
        return copy;
    }

    public int[] GetGroupNumbers()
    {
        if (Caps == null)
        {
            int[] numbers = new int[CapSize];
            for (int i = 0; i < numbers.Length; i++)
            {
                numbers[i] = i;
            }
            return numbers;
        }
        int[] result = new int[Caps.Count];
        foreach (KeyValuePair<int, int> pair in Caps)
        {
            result[pair.Value] = pair.Key;
        }
        return result;
    }

    public string GroupNameFromNumber(int i)
    {
        if (_capslist == null)
        {
            return (uint)i < (uint)CapSize ? i.ToString(CultureInfo.InvariantCulture) : "";
        }
        if (Caps != null)
        {
            int slot;
            if (!Caps.TryGetValue(i, out slot))
            {
                return "";
            }
            i = slot;
        }
        return (uint)i < (uint)_capslist.Length ? _capslist[i] : "";
    }

    public int GroupNumberFromName(string name)
    {
        if (name == null) throw new ArgumentNullException(nameof(name));
        if (_capnames != null)
        {
            int number;
            return _capnames.TryGetValue(name, out number) ? number : -1;
        }
        uint result;
        return uint.TryParse(name, NumberStyles.None, CultureInfo.InvariantCulture, out result) && result < (uint)CapSize ? (int)result : -1;
    }

    // ---- matching --------------------------------------------------------------

    /// One search, as .NET's RunSingleMatch makes it: Match.Empty when there
    /// is none.
    internal Match RunSingleMatch(int prevlen, string input, int beginning, int length, int startat)
    {
        if ((uint)startat > (uint)input.Length)
        {
            throw new ArgumentOutOfRangeException("startat", "Start index cannot be less than 0 or greater than input length.");
        }
        if ((ulong)(uint)beginning + (ulong)(uint)length > (ulong)(uint)input.Length)
        {
            throw new ArgumentOutOfRangeException("start");
        }
        RegexInterpreter? runner = Interlocked.Exchange(ref _runner, null);
        if (runner == null)
        {
            runner = new RegexInterpreter(this, _code);
        }
        Match? match = runner.Scan(input, beginning, beginning + length, startat, prevlen);
        _runner = runner;
        return match ?? Match.Empty;
    }

    internal RegexReplacement ReplacementFor(string replacement)
    {
        RegexReplacement? cached = _replacement;
        if (cached != null && cached.Pattern == replacement)
        {
            return cached;
        }
        RegexReplacement made = new RegexReplacement(replacement, RegexParser.ParseReplacement(replacement, _options, Caps, CapSize, _capnames), Caps);
        _replacement = made;
        return made;
    }

    public bool IsMatch(string input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return RunSingleMatch(-1, input, 0, input.Length, RightToLeft ? input.Length : 0).Success;
    }

    public bool IsMatch(string input, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return RunSingleMatch(-1, input, 0, input.Length, startat).Success;
    }

    public bool IsMatch(ReadOnlySpan<char> input)
    {
        return IsMatch(input.ToString());
    }

    public bool IsMatch(ReadOnlySpan<char> input, int startat)
    {
        return IsMatch(input.ToString(), startat);
    }

    public Match Match(string input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return RunSingleMatch(-1, input, 0, input.Length, RightToLeft ? input.Length : 0);
    }

    public Match Match(string input, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return RunSingleMatch(-1, input, 0, input.Length, startat);
    }

    public Match Match(string input, int beginning, int length)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return RunSingleMatch(-1, input, beginning, length, RightToLeft ? beginning + length : beginning);
    }

    public MatchCollection Matches(string input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return new MatchCollection(this, input, RightToLeft ? input.Length : 0);
    }

    public MatchCollection Matches(string input, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        if ((uint)startat > (uint)input.Length)
        {
            throw new ArgumentOutOfRangeException("startat", "Start index cannot be less than 0 or greater than input length.");
        }
        return new MatchCollection(this, input, startat);
    }

    public int Count(string input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        int count = 0;
        Match m = RunSingleMatch(-1, input, 0, input.Length, RightToLeft ? input.Length : 0);
        while (m.Success)
        {
            count++;
            m = RunSingleMatch(m.Length, input, 0, input.Length, m._textpos);
        }
        return count;
    }

    public int Count(ReadOnlySpan<char> input)
    {
        return Count(input.ToString());
    }

    // ---- replacing -------------------------------------------------------------

    public string Replace(string input, string replacement)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Replace(input, replacement, -1, RightToLeft ? input.Length : 0);
    }

    public string Replace(string input, string replacement, int count)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Replace(input, replacement, count, RightToLeft ? input.Length : 0);
    }

    public string Replace(string input, string replacement, int count, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        if (replacement == null) throw new ArgumentNullException(nameof(replacement));
        RegexReplacement rules = ReplacementFor(replacement);
        return ReplaceMatches(input, count, startat, rules, null);
    }

    public string Replace(string input, MatchEvaluator evaluator)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Replace(input, evaluator, -1, RightToLeft ? input.Length : 0);
    }

    public string Replace(string input, MatchEvaluator evaluator, int count)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Replace(input, evaluator, count, RightToLeft ? input.Length : 0);
    }

    public string Replace(string input, MatchEvaluator evaluator, int count, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        if (evaluator == null) throw new ArgumentNullException(nameof(evaluator));
        return ReplaceMatches(input, count, startat, null, evaluator);
    }

    /// Each match replaced, as .NET's RegexReplacement.Replace: the text
    /// between them kept, gathered from the end backwards under RightToLeft.
    string ReplaceMatches(string input, int count, int startat, RegexReplacement? rules, MatchEvaluator? evaluator)
    {
        if (count < -1)
        {
            throw new ArgumentOutOfRangeException("count", "Count cannot be less than -1.");
        }
        if ((uint)startat > (uint)input.Length)
        {
            throw new ArgumentOutOfRangeException("startat", "Start index cannot be less than 0 or greater than input length.");
        }
        if (count == 0)
        {
            return input;
        }
        Match m = RunSingleMatch(-1, input, 0, input.Length, startat);
        if (!m.Success)
        {
            return input;
        }
        List<string> segments = new List<string>();
        if (!RightToLeft)
        {
            int prevat = 0;
            while (true)
            {
                segments.Add(input.Substring(prevat, m.Index - prevat));
                prevat = m.Index + m.Length;
                segments.Add(rules != null ? rules.Replacement(m) : evaluator!(m));
                if (--count == 0)
                {
                    break;
                }
                m = RunSingleMatch(m.Length, input, 0, input.Length, m._textpos);
                if (!m.Success)
                {
                    break;
                }
            }
            segments.Add(input.Substring(prevat));
        }
        else
        {
            int prevat = input.Length;
            while (true)
            {
                segments.Add(input.Substring(m.Index + m.Length, prevat - m.Index - m.Length));
                prevat = m.Index;
                segments.Add(rules != null ? rules.Replacement(m) : evaluator!(m));
                if (--count == 0)
                {
                    break;
                }
                m = RunSingleMatch(m.Length, input, 0, input.Length, m._textpos);
                if (!m.Success)
                {
                    break;
                }
            }
            segments.Add(input.Substring(0, prevat));
            segments.Reverse();
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < segments.Count; i++)
        {
            sb.Append(segments[i]);
        }
        return sb.ToString();
    }

    // ---- splitting -------------------------------------------------------------

    public string[] Split(string input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Split(input, 0, RightToLeft ? input.Length : 0);
    }

    public string[] Split(string input, int count)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        return Split(input, count, RightToLeft ? input.Length : 0);
    }

    /// The pieces between the matches, and after each match whatever its
    /// groups captured, slot by slot as .NET adds them -- a group numbered
    /// past its slot gives "".
    public string[] Split(string input, int count, int startat)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));
        if (count < 0)
        {
            throw new ArgumentOutOfRangeException("count", "Count cannot be less than -1.");
        }
        if ((uint)startat > (uint)input.Length)
        {
            throw new ArgumentOutOfRangeException("startat", "Start index cannot be less than 0 or greater than input length.");
        }
        if (count == 1)
        {
            return new string[] { input };
        }
        count--;
        List<string> results = new List<string>();
        Match m = RunSingleMatch(-1, input, 0, input.Length, startat);
        if (!m.Success)
        {
            return new string[] { input };
        }
        if (!RightToLeft)
        {
            int prevat = 0;
            while (true)
            {
                results.Add(input.Substring(prevat, m.Index - prevat));
                prevat = m.Index + m.Length;
                for (int i = 1; i < m.Groups.Count; i++)
                {
                    if (m.IsMatched(i))
                    {
                        results.Add(m.Groups[i].ToString());
                    }
                }
                if (--count == 0)
                {
                    break;
                }
                m = RunSingleMatch(m.Length, input, 0, input.Length, m._textpos);
                if (!m.Success)
                {
                    break;
                }
            }
            results.Add(input.Substring(prevat));
            return results.ToArray();
        }
        else
        {
            int prevat = input.Length;
            while (true)
            {
                results.Add(input.Substring(m.Index + m.Length, prevat - m.Index - m.Length));
                prevat = m.Index;
                for (int i = 1; i < m.Groups.Count; i++)
                {
                    if (m.IsMatched(i))
                    {
                        results.Add(m.Groups[i].ToString());
                    }
                }
                if (--count == 0)
                {
                    break;
                }
                m = RunSingleMatch(m.Length, input, 0, input.Length, m._textpos);
                if (!m.Success)
                {
                    break;
                }
            }
            results.Add(input.Substring(0, prevat));
            results.Reverse();
            return results.ToArray();
        }
    }

    // ---- the static forms ------------------------------------------------------

    public static bool IsMatch(string input, string pattern)
    {
        return new Regex(pattern).IsMatch(input);
    }

    public static bool IsMatch(string input, string pattern, RegexOptions options)
    {
        return new Regex(pattern, options).IsMatch(input);
    }

    public static bool IsMatch(string input, string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).IsMatch(input);
    }

    public static Match Match(string input, string pattern)
    {
        return new Regex(pattern).Match(input);
    }

    public static Match Match(string input, string pattern, RegexOptions options)
    {
        return new Regex(pattern, options).Match(input);
    }

    public static Match Match(string input, string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Match(input);
    }

    public static MatchCollection Matches(string input, string pattern)
    {
        return new Regex(pattern).Matches(input);
    }

    public static MatchCollection Matches(string input, string pattern, RegexOptions options)
    {
        return new Regex(pattern, options).Matches(input);
    }

    public static MatchCollection Matches(string input, string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Matches(input);
    }

    public static int Count(string input, string pattern)
    {
        return new Regex(pattern).Count(input);
    }

    public static int Count(string input, string pattern, RegexOptions options)
    {
        return new Regex(pattern, options).Count(input);
    }

    public static int Count(string input, string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Count(input);
    }

    public static string Replace(string input, string pattern, string replacement)
    {
        return new Regex(pattern).Replace(input, replacement);
    }

    public static string Replace(string input, string pattern, string replacement, RegexOptions options)
    {
        return new Regex(pattern, options).Replace(input, replacement);
    }

    public static string Replace(string input, string pattern, string replacement, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Replace(input, replacement);
    }

    public static string Replace(string input, string pattern, MatchEvaluator evaluator)
    {
        return new Regex(pattern).Replace(input, evaluator);
    }

    public static string Replace(string input, string pattern, MatchEvaluator evaluator, RegexOptions options)
    {
        return new Regex(pattern, options).Replace(input, evaluator);
    }

    public static string Replace(string input, string pattern, MatchEvaluator evaluator, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Replace(input, evaluator);
    }

    public static string[] Split(string input, string pattern)
    {
        return new Regex(pattern).Split(input);
    }

    public static string[] Split(string input, string pattern, RegexOptions options)
    {
        return new Regex(pattern, options).Split(input);
    }

    public static string[] Split(string input, string pattern, RegexOptions options, TimeSpan matchTimeout)
    {
        return new Regex(pattern, options, matchTimeout).Split(input);
    }

    public static string Escape(string str)
    {
        if (str == null) throw new ArgumentNullException(nameof(str));
        return RegexParser.Escape(str);
    }

    public static string Unescape(string str)
    {
        if (str == null) throw new ArgumentNullException(nameof(str));
        return RegexParser.Unescape(str);
    }
}
