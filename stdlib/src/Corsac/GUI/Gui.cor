// Corsac.GUI -- what the seat offers beyond Windows Forms: the seat itself
// (the device, its windows, its events), the shell's view of every window,
// and the desktop's own kind of surface. A program written to the Forms
// surface never needs this namespace; the desktop, its taskbar, and tools
// like spy do. Kept apart so a program ported from Windows meets nothing
// here by accident.

using System;
using System.IO;
using System.Drawing;
using System.Windows.Forms;

namespace Corsac.GUI;

// ---------------------------------------------------------------------------
// The seat: the transport. One per process, opened on first use.
// ---------------------------------------------------------------------------

public class Seat : IDrawingTarget
{
    static Seat? _current;
    public static Seat Current
    {
        get
        {
            if (_current == null) _current = new Seat(Environment.GetEnvironmentVariable("SEAT") ?? "/dev/seat0");
            return _current;
        }
    }

    int _fd;
    byte[] _batch = new byte[16384];
    int _used;
    int _window;                 // the window drawing goes to
    bool _named;                 // whether this batch has said so yet
    bool _clipOn;                // a clip is in force (batch-local in the seat, like the window)
    int _clipX, _clipY, _clipW, _clipH;
    public int Width;
    public int Height;
    public int Format;

    public Seat(string path)
    {
        _fd = Os.Open(path, 2, 0);          // O_RDWR
        if (_fd < 0) throw new IOException("cannot open seat " + path);
        Width = (int)Os.Ioctl(_fd, 0x47550001, 0);
        Height = (int)Os.Ioctl(_fd, 0x47550002, 0);
        Format = (int)Os.Ioctl(_fd, 0x47550003, 0);
        // A seat device that exists but has no screen answers every question
        // with an error: the kernel says why on the console. Finding out here
        // is what lets a program say so and stop, rather than failing at its
        // first window and being started again for ever.
        if (Width <= 0 || Height <= 0) throw new IOException("seat " + path + " has no screen");
    }

    /// <summary>One mode this display can be put into.</summary>
    public struct SeatMode
    {
        public int Width;
        public int Height;
        public int Format;
        public int Refresh;

        /// "800 x 600" -- what a person picking a screen area reads.
        public override string ToString()
        {
            return Width.ToString() + " x " + Height.ToString();
        }
    }

    /// <summary>
    /// The seat changed mode: take the new size. Called by the event pump
    /// when the seat says so, because Width and Height were read once when
    /// this was opened and are now wrong.
    /// </summary>
    public void Rescreen(int width, int height)
    {
        Width = width;
        Height = height;
        Format = (int)Os.Ioctl(_fd, 0x47550003, 0);      // the depth may be what changed
        Epoch++;
        _used = 0;              // whatever was half-built described the old screen
        _named = false;
        _clipOn = false;
    }

    /// <summary>
    /// Asks the seat to change mode now. The rate may be zero, which means
    /// whichever the card would pick for that size.
    /// </summary>
    public bool SetMode(int width, int height, int refresh) { return SetMode(width, height, refresh, 0); }

    /// The same with a colour depth in bits per pixel; nought keeps the
    /// depth the seat is in. Only a mode the display's own list holds is
    /// taken -- see ModeAt -- so asking for one that is not there is a
    /// refusal and not an experiment on the monitor.
    public bool SetMode(int width, int height, int refresh, int bits)
    {
        Flush();

        // FOUR WORDS BY ADDRESS, not packed into the argument: an ioctl's
        // argument is one machine word, and on a 32-bit machine everything
        // packed above bit 31 -- the rate and the depth -- simply never
        // arrived, so a change of depth alone "succeeded" by doing nothing.
        byte[] request = new byte[16];
        long at = Sys.ArrayData(request);

        Sys.PokeWord(at, width);
        Sys.PokeWord(at + 4, height);
        Sys.PokeWord(at + 8, refresh);
        Sys.PokeWord(at + 12, bits);
        return Os.Ioctl(_fd, 0x47550034, at) == 0;
    }

    /// The refresh rate in use, or zero where the card chose it.
    public int Refresh { get { return (int)Os.Ioctl(_fd, 0x47550032, 0); } }

    /// How many modes this display has. Each is a size, a colour depth and
    /// a refresh rate; the same size appears once per rate it supports.
    public int ModeCount() { return (int)Os.Ioctl(_fd, 0x47550030, 0); }

    /// The mode at `index`, or false where there is none.
    public bool ModeAt(int index, out SeatMode mode)
    {
        mode = new SeatMode();

        byte[] request = new byte[20];
        long at = Sys.ArrayData(request);

        Sys.PokeWord(at, index);
        if (Os.Ioctl(_fd, 0x47550031, at) != 0) { return false; }

        mode.Width = (int)Sys.PeekWord(at + 4);
        mode.Height = (int)Sys.PeekWord(at + 8);
        mode.Format = (int)Sys.PeekWord(at + 12);
        mode.Refresh = (int)Sys.PeekWord(at + 16);
        return true;
    }

    /// Whether a seat can be used, without throwing to find out.
    public static bool Usable(string path)
    {
        int fd = Os.Open(path, 2, 0);
        if (fd < 0) return false;
        bool ok = Os.Ioctl(fd, 0x47550001, 0) > 0;
        Os.Close(fd);
        return ok;
    }

    public int Fd { get { return _fd; } }

    /// How many colours this screen can show: what a picture with several
    /// versions of itself chooses between.
    /// Bits to a pixel in the mode the seat is in. Format is the kernel's
    /// GfxFormat: 1 an eight-bit palette, 2 five-six-five, 3 and 4 eight
    /// bits a channel, packed in three bytes or padded to four.
    public int BitsPerPixel { get { return BitsOf(Format); } }

    public static int BitsOf(int format) { return format == 2 ? 16 : format == 3 ? 24 : format == 4 ? 32 : 8; }

    /// How many colours that is: what decides whether a gradient or an
    /// antialiased letter is worth drawing.
    public int Colours { get { return Format == 2 ? 65536 : Format >= 3 ? 16777216 : 256; } }

    /// Counts mode changes. Anything a program handed the seat that was
    /// converted to the mode's pixels -- an icon -- went with the old mode;
    /// whoever holds one compares this with the value it had when it
    /// handed the picture over, and hands it over again when they differ.
    public int Epoch;

    // Ids for pictures and pointer shapes the seat keeps for us. Handing
    // them out here rather than making every caller invent one is what
    // stops two libraries from quietly using the same number.
    static int _nextBitmap;
    static int _nextCursor;
    public static int NextBitmapId() { int id = _nextBitmap; _nextBitmap = (_nextBitmap + 1) % 256; return id; }
    public static int NextCursorId() { int id = _nextCursor; _nextCursor = (_nextCursor + 1) % 32; return id; }

    /// A shape this program defined becomes one of the standard ones, for
    /// every program on the seat: what a system does once with real cursor
    /// art, so that nothing else has to know where the art came from.
    public void BindCursor(int shape, int id) { Os.Ioctl(_fd, 0x47550028, (shape & 0xFF) | ((id & 0xFF) << 8)); }

    /// How many windows the seat is showing, everybody's included.
    public int ShownWindows() { int n = (int)Os.Ioctl(_fd, 0x47550005, 0); return n < 0 ? 0 : n; }

    // --- batches ---------------------------------------------------------

    /// Room for one whole op. AN OP IS NEVER SPLIT ACROSS TWO WRITES: the
    /// seat reads each write on its own, and the tail of an op at the head
    /// of the next write is parsed as opcodes, which throws the rest away.
    void Room(int words)
    {
        if (_used + words * 4 > _batch.Length) { Flush(); Renew(); }
    }

    static void Put(byte[] into, int at, int v)
    {
        into[at] = (byte)v; into[at + 1] = (byte)(v >> 8);
        into[at + 2] = (byte)(v >> 16); into[at + 3] = (byte)(v >> 24);
    }

    void Word(int v)
    {
        _batch[_used] = (byte)v; _batch[_used + 1] = (byte)(v >> 8);
        _batch[_used + 2] = (byte)(v >> 16); _batch[_used + 3] = (byte)(v >> 24);
        _used += 4;
    }

    static int Rgb(Color c) { return (c.R << 16) | (c.G << 8) | c.B; }

    /// Send what is queued. Called when the buffer fills, on request, and
    /// by the message loop before it waits, which is the rule that keeps a
    /// program's last few draws from sitting unseen while it blocks.
    public void Flush()
    {
        int at = 0;
        while (at < _used)
        {
            int n = Os.Write(_fd, _batch, at, _used - at);
            // A batch the seat would not take is a bug in whoever built it,
            // and a bug that shows up as a picture quietly not appearing is
            // the worst kind: it stops the program here, with the kernel's
            // console line saying which op and where.
            if (n < 0) { _used = 0; throw new InvalidOperationException("the seat rejected a drawing batch (" + (-n) + ")"); }
            if (n == 0) break;
            at += n;
        }
        _used = 0;
        // The seat forgets the current window and clip at the end of every
        // write, so the next batch has to name them again: Renew does, when
        // a batch filled up mid-drawing; a new batch starts with Target.
        _named = false;
    }

    /// After a flush in the middle of drawing: the same window and clip
    /// again, or the rest of the drawing goes nowhere.
    void Renew()
    {
        if (_window != 0) { _named = true; Word(12); Word(_window); }
        if (_clipOn) { Word(6); Word(_clipX); Word(_clipY); Word(_clipW); Word(_clipH); }
    }

    public void Target(int window)
    {
        if (_window == window && _named) return;
        _window = window;
        _named = true;
        _clipOn = false;
        Room(2); Word(12); Word(window);
    }

    public void Fill(int x, int y, int w, int h, Color colour) { Room(6); Word(1); Word(x); Word(y); Word(w); Word(h); Word(Rgb(colour)); }
    public void Copy(int sx, int sy, int dx, int dy, int w, int h) { Room(7); Word(2); Word(sx); Word(sy); Word(dx); Word(dy); Word(w); Word(h); }
    public void Line(int x0, int y0, int x1, int y1, Color colour) { Room(6); Word(3); Word(x0); Word(y0); Word(x1); Word(y1); Word(Rgb(colour)); }
    public void Glyph(int id, int x, int y, Color fg, Color bg, bool transparent)
    { Room(7); Word(5); Word(id); Word(x); Word(y); Word(Rgb(fg)); Word(Rgb(bg)); Word(transparent ? 1 : 0); }
    public void Clip(int x, int y, int w, int h)
    {
        _clipOn = true; _clipX = x; _clipY = y; _clipW = w; _clipH = h;
        Room(5); Word(6); Word(x); Word(y); Word(w); Word(h);
    }
    /// A picture the seat keeps, to be drawn afterwards by its id. The
    /// colours are 0xAARRGGBB, which is what an image decodes to; the seat
    /// turns them into the screen's own pixels once, here, and remembers
    /// which of them are see-through.
    public void DefineBitmap(int id, int width, int height, byte[] argb)
    {
        int bytes = width * height * 4;
        Flush();
        // ONE WRITE: the seat reads the pixels out of the same batch as the
        // op that introduces them, so they cannot be a second write.
        // Five words, as the seat's DefineBitmap is declared: id, width,
        // height, format (0: 0xAARRGGBB), then how many bytes follow. Sent
        // with four, the seat read the byte count out of the first pixel,
        // found it did not fit, and dropped the picture without a word.
        byte[] one = new byte[24 + bytes];
        Put(one, 0, 7); Put(one, 4, id); Put(one, 8, width); Put(one, 12, height); Put(one, 16, 0); Put(one, 20, bytes);
        for (int i = 0; i < bytes; i++) one[24 + i] = argb[i];
        int at = 0;
        while (at < one.Length)
        {
            int n = Os.Write(_fd, one, at, one.Length - at);
            if (n <= 0) break;
            at += n;
        }
        Renew();
    }

    /// A pointer shape from a cursor file. The seat reduces it to what a
    /// card's hardware cursor can show -- two colours and a hole -- and it
    /// is then selected like any other shape, by SetCursor(CursorBase + id).
    public void DefineCursor(int id, int width, int height, int hotX, int hotY, byte[] argb)
    {
        int bytes = width * height * 4;
        Flush();
        byte[] one = new byte[24 + bytes];
        Put(one, 0, 11); Put(one, 4, id); Put(one, 8, width); Put(one, 12, height);
        Put(one, 16, (hotX & 0xFFFF) | (hotY << 16)); Put(one, 20, bytes);
        for (int i = 0; i < bytes; i++) one[24 + i] = argb[i];
        int at = 0;
        while (at < one.Length)
        {
            int n = Os.Write(_fd, one, at, one.Length - at);
            if (n <= 0) break;
            at += n;
        }
        Renew();
    }

    public void Blit(int id, int sx, int sy, int x, int y, int width, int height)
    { Room(8); Word(8); Word(id); Word(sx); Word(sy); Word(x); Word(y); Word(width); Word(height); }

    public void ShowPointer(bool on) { Room(2); Word(10); Word(on ? 1 : 0); }
    public void MovePointer(int x, int y) { Room(3); Word(9); Word(x); Word(y); }

    // --- windows ---------------------------------------------------------
    //
    // A window operation selects the handle first, then acts on it: the i386
    // call convention carries 32-bit arguments, so a handle cannot ride in the
    // high half of the argument as a 64-bit ABI would allow.

    void Select(int handle) { Os.Ioctl(_fd, 0x47550029, handle); }

    public int CreateWindow(int x, int y, int w, int h)
    {
        Flush();
        int handle = (int)Os.Ioctl(_fd, 0x47550010, (x & 0xFFFF) | (y << 16));
        if (handle <= 0) throw new IOException("cannot create a window");
        Select(handle);
        Os.Ioctl(_fd, 0x47550011, (w & 0xFFFF) | (h << 16));
        return handle;
    }
    /// What every window call goes through: the seat's answer, and an
    /// exception if it was a refusal. The kernel says why on its console.
    static void Must(long answer, string what)
    {
        if (answer < 0) throw new InvalidOperationException("the seat refused " + what + " (" + (-answer) + ")");
    }

    public void ShowWindow(int handle) { Flush(); Select(handle); Must(Os.Ioctl(_fd, 0x47550012, 0), "showing a window"); }
    public void HideWindow(int handle) { Flush(); Select(handle); Must(Os.Ioctl(_fd, 0x47550013, 0), "hiding a window"); }
    public void RaiseWindow(int handle) { Flush(); Select(handle); Must(Os.Ioctl(_fd, 0x47550014, 0), "raising a window"); }
    public void MoveWindow(int handle, int x, int y) { Flush(); Select(handle); Must(Os.Ioctl(_fd, 0x47550015, (x & 0xFFFF) | (y << 16)), "moving a window"); }
    public void ResizeWindow(int handle, int w, int h) { Flush(); Select(handle); Must(Os.Ioctl(_fd, 0x47550011, (w & 0xFFFF) | (h << 16)), "resizing a window"); }
    public void DestroyWindow(int handle) { Flush(); Select(handle); Os.Ioctl(_fd, 0x47550016, 0); _window = 0; _named = false; }
    public void FocusWindow(int handle) { Flush(); Select(handle); Os.Ioctl(_fd, 0x47550017, 0); }
    /// This window is the desktop: the surface under everything, never raised.
    public void DesktopWindow(int handle) { Flush(); Select(handle); Os.Ioctl(_fd, 0x47550018, 0); }
    /// This window stays above every ordinary one (a bar).
    public void TopMostWindow(int handle, bool on) { Flush(); Select(handle); Os.Ioctl(_fd, 0x47550019, on ? 1 : 0); }
    /// This window is not listed on a taskbar.
    /// Whether this window is listed on a taskbar; takes effect at once.
    public void ListOnTaskbar(int handle, bool listed) { Flush(); Select(handle); Os.Ioctl(_fd, 0x47550024, listed ? 0 : 1); }

    /// The window's title, as the seat lists it (a taskbar reads it).
    public void SetTitle(int handle, string title)
    {
        byte[] bytes = new byte[64];
        for (int i = 0; i < title.Length && i < 63; i++) bytes[i] = (byte)title[i];
        Flush(); Select(handle); Os.Ioctl(_fd, 0x4755001B, (int)Os.AddressOf(bytes));
    }

    /// Ask for a WindowsChanged message whenever the seat's list or focus changes.
    public void WatchWindows() { Os.Ioctl(_fd, 0x4755001D, 0); }

    /// Every shown window on the seat, bottom to top, whoever owns it.
    public SeatWindowInfo[] Windows()
    {
        byte[] records = new byte[80 * 64];
        int n = (int)Os.Ioctl(_fd, 0x4755001C, (int)Os.AddressOf(records));
        if (n < 0) n = 0;
        if (n > 64) n = 64;
        SeatWindowInfo[] result = new SeatWindowInfo[n];
        for (int i = 0; i < n; i++)
        {
            int at = i * 80;
            SeatWindowInfo w = new SeatWindowInfo();
            w.Handle = records[at] | (records[at + 1] << 8) | (records[at + 2] << 16) | (records[at + 3] << 24);
            w.Owner = records[at + 4] | (records[at + 5] << 8) | (records[at + 6] << 16) | (records[at + 7] << 24);
            w.Flags = records[at + 8] | (records[at + 9] << 8);
            int xy = records[at + 12] | (records[at + 13] << 8) | (records[at + 14] << 16) | (records[at + 15] << 24);
            int wh = records[at + 16] | (records[at + 17] << 8) | (records[at + 18] << 16) | (records[at + 19] << 24);
            w.Bounds = new Rectangle(LowSigned(xy), HighSigned(xy), wh & 0xFFFF, (wh >> 16) & 0xFFFF);
            string title = "";
            for (int k = 0; k < 56 && records[at + 24 + k] != 0; k++) title = title + (char)records[at + 24 + k];
            w.Title = title;
            result[i] = w;
        }
        return result;
    }

    /// Raise and focus any window, whoever owns it (a taskbar button).
    public void Activate(int handle) { Flush(); Os.Ioctl(_fd, 0x4755001E, handle); }

    // --- inspection: what is under a point of the screen, asked of the
    // window's owner through the seat (a spy tool) -------------------------
    public void WatchPointer() { Os.Ioctl(_fd, 0x47550020, 0); }

    /// The pointer's shape while it is over one of this program's windows.
    /// The seat puts the arrow back the moment the pointer leaves.
    public void SetCursor(int cursor) { Os.Ioctl(_fd, 0x47550025, cursor); }

    /// The drag outline the seat draws over everything: where a window is
    /// heading while the button is held. A width of zero takes it away.
    public void SetBand(int x, int y, int width, int height)
    {
        Flush();
        Os.Ioctl(_fd, 0x47550027, (width & 0xFFFF) | (height << 16));
        Os.Ioctl(_fd, 0x47550026, (x & 0xFFFF) | (y << 16));
    }
    public void ClearBand() { SetBand(0, 0, 0, 0); }
    /// Ask the owner of the window at a screen point what is there; the
    /// answer arrives as Application.Inspected. Returns the window handle, or -1.
    public int Inspect(int screenX, int screenY) { Flush(); return (int)Os.Ioctl(_fd, 0x47550021, (screenX & 0xFFFF) | (screenY << 16)); }
    public void InspectReply(string text)
    {
        byte[] bytes = new byte[256];
        for (int i = 0; i < text.Length && i < 255; i++) bytes[i] = (byte)text[i];
        Os.Ioctl(_fd, 0x47550022, (int)Os.AddressOf(bytes));
    }
    public string InspectRead()
    {
        byte[] bytes = new byte[256];
        int n = (int)Os.Ioctl(_fd, 0x47550023, (int)Os.AddressOf(bytes));
        string text = "";
        for (int i = 0; i < n && i < 255 && bytes[i] != 0; i++) text = text + (char)bytes[i];
        return text;
    }
    /// Ask any window's owner to close it.
    public void CloseWindow(int handle) { Flush(); Os.Ioctl(_fd, 0x4755001F, handle); }

    /// A glyph of the program's own, ids from 256: rows of packed bits, the
    /// most significant first, (width+7)/8 bytes per row.
    public void DefineGlyph(int id, int width, int height, byte[] bits)
    {
        int padded = (bits.Length + 3) & ~3;
        Room(5 + padded / 4);
        Word(4); Word(id); Word(width); Word(height); Word(bits.Length);
        for (int i = 0; i < padded; i++) _batch[_used++] = i < bits.Length ? bits[i] : (byte)0;
    }
    /// Rows at the bottom of the screen a bar owns: windows keep out of them.
    public void ReserveBottom(int rows) { Os.Ioctl(_fd, 0x4755001A, rows); }
    /// The screen height minus what a bar has reserved: where windows go.
    public int WorkAreaHeight() { int h = (int)Os.Ioctl(_fd, 0x47550006, 0); return h <= 0 ? Height : h; }
    static int Signed16(int v) { int n = v & 0xFFFF; return n >= 0x8000 ? n - 0x10000 : n; }
    public static int LowSigned(int packed) { return Signed16(packed); }
    public static int HighSigned(int packed) { return Signed16(packed >> 16); }

    // --- events ----------------------------------------------------------

    byte[] _event = new byte[16];

    /// Blocks until the seat has a message. Everything queued is flushed
    /// first, because a program about to wait must not leave its own
    /// drawing behind.
    public bool Next(out Message m)
    {
        Flush();
        m = new Message();
        int got = 0;
        while (got < 16)
        {
            int n = Os.Read(_fd, _event, got, 16 - got);
            if (n <= 0) return false;
            got += n;
        }
        m.Kind = Int(0); m.Window = Int(4); m.A = Int(8); m.B = Int(12);
        return true;
    }

    /// Is a message waiting? poll(2) on the seat: the kernel answers for
    /// the device and sleeps the caller until something arrives or the
    /// time is up. Nothing here spins or naps in steps.
    /// The frame is finished: what has been drawn may go on the screen.
    ///
    /// The seat keeps drawing in the window's own surface and puts it up in
    /// one piece when this arrives, so nothing is ever watched being drawn.
    /// Waiting for events says the same thing, which is why Poll and WaitAny
    /// send it too -- a program that only ever paints and waits needs no
    /// call of its own.
    public void Present()
    {
        Room(1); Word(13);                            // SeatOp.Present
        Flush();
    }

    public bool Poll(int timeoutMs)
    {
        Present();
        return Os.Poll(_fd, 1, timeoutMs) > 0;
    }

    /// Wait for the seat or any of `others`, whichever first. Returns the
    /// index into `others` that became readable, or -1 for the seat (or
    /// the timeout; the caller asks the seat, which is cheap).
    public int WaitAny(int[] others, int count, int timeoutMs)
    {
        Present();
        int[] fds = new int[count + 1];
        bool[] ready = new bool[count + 1];
        fds[0] = _fd;
        for (int i = 0; i < count; i++) fds[i + 1] = others[i];
        int n = Os.PollMany(fds, count + 1, 1, timeoutMs, ready);
        if (n <= 0) return -1;
        for (int i = 0; i < count; i++) if (ready[i + 1]) return i;
        return -1;
    }

    int Int(int at) { return _event[at] | (_event[at + 1] << 8) | (_event[at + 2] << 16) | (_event[at + 3] << 24); }
}


/// One shown window on the seat, as Seat.Windows() reports it.
public class SeatWindowInfo
{
    public int Handle;
    public int Owner;
    public int Flags;                        // 1 desktop, 2 top-most, 4 focused
    public Rectangle Bounds;                 // on the screen
    public string Title = "";
    public bool IsDesktop { get { return (Flags & 1) != 0; } }
    public bool IsTopMost { get { return (Flags & 2) != 0; } }
    public bool IsFocused { get { return (Flags & 4) != 0; } }
    public bool OnTaskbar { get { return (Flags & 9) == 0; } }      // neither the desktop nor a window that opted out
}


/// The shell's events and powers: what a taskbar, a desktop or a spy tool
/// uses, raised by the Forms message loop from the seat's messages.
/// The shapes a pointer can take. The seat draws them; these are its names.
public static class Cursors
{
    public const int Arrow = 0, SizeWE = 1, SizeNS = 2, SizeNWSE = 3, SizeNESW = 4;
    public const int IBeam = 5, Wait = 6, Help = 7, No = 8, Move = 9, Hand = 10, Cross = 11;

    /// Shapes a program defined itself are numbered from here: the id it
    /// gave DefineCursor, plus this.
    public const int Base = 256;
}

public static class Shell
{
    /// The seat's window list or focus changed (after WatchWindows()).
    public static event EventHandler? WindowsChanged;
    /// The pointer moved anywhere on the screen (after WatchPointer()).
    public static event MouseEventHandler? PointerMoved;
    /// An answer to Seat.Inspect is ready (Seat.InspectRead()).
    public static event EventHandler? Inspected;

    public static void WatchWindows() { Seat.Current.WatchWindows(); }
    public static void WatchPointer() { Seat.Current.WatchPointer(); }

    /// This form is the desktop: the surface under everything, never
    /// raised. Before it is shown.
    public static void MakeDesktop(Form f) { f.DesktopSurface = true; }

    internal static void RaiseWindowsChanged() { if (WindowsChanged != null) WindowsChanged(null!, EventArgs.Empty); }
    internal static void RaisePointerMoved(MouseEventArgs e) { if (PointerMoved != null) PointerMoved(null!, e); }
    internal static void RaiseInspected() { if (Inspected != null) Inspected(null!, EventArgs.Empty); }
}
