// Corsac.GUI -- what the seat offers beyond Windows Forms: the seat itself
// (the device, its windows, its events), the shell's view of every window,
// and the desktop's own kind of surface. A program written to the Forms
// surface never needs this namespace; the desktop, its taskbar, and tools
// like spy do. Kept apart so a program ported from Windows meets nothing
// here by accident.

using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Drawing;
using System.Windows.Forms;

namespace Corsac.GUI;

// ---------------------------------------------------------------------------
// The seat: the transport. One per process, opened on first use.
//
// THE SEAT IS IN THE GUI KERNEL, in ring 1, and is reached through `int
// 0x81` (docs/software/GUI-KERNEL.md in the corsac86 repository): reads of
// events, writes of drawing batches and ioctls, with the numbers the device
// /dev/seat0 used to take. The device is still opened, for two things: its
// permission is who may use the seat, and poll(2) on it says whether this
// program's events are waiting.
//
// A CRASH OF THE GUI KERNEL IS A REPAINT. Its calls come back EIO, or the
// gate is closed; this class waits for `gui` to start it again, attaches,
// sees the new start number, and makes everything again -- every window
// under the handle it had, every glyph, picture and pointer shape it
// defined, every watch and binding -- and the seat asks for every window to
// be painted. A program written to Forms never learns it happened.
// ---------------------------------------------------------------------------

public class Seat : IDrawingTarget
{
    static Seat? _current;
    public static Seat Current
    {
        get
        {
            if (_current == null) _current = new Seat(Environment.GetEnvironmentVariable("SEAT") ?? "/dev/seat0");
            return _current;
        }
    }

    int _fd;
    byte[] _batch = new byte[16384];
    int _used;
    int _window;                 // the window drawing goes to
    bool _named;                 // whether this batch has said so yet
    bool _clipOn;                // a clip is in force (batch-local in the seat, like the window)
    int _clipX, _clipY, _clipW, _clipH;
    public int Width;
    public int Height;
    public int Format;

    // ---- the gate ---------------------------------------------------------

    const long GuiAttach = 0x4000001A;
    const long CallRead = 16, CallWrite = 17, CallIoctl = 18;
    const long NoSys = 38, Io = 5;
    const long SeatStart = 0x4755002A, SeatWhoami = 0x4755002B, SeatCreateAs = 0x4755002C;
    const long SeatCursorAt = 0x4755002E, SeatCursorTo = 0x4755002F, SeatAnimateCursor = 0x47550036, SeatClipCursor = 0x47550037,
               SeatVanishPointer = 0x47550038;

    long _start;                    // the GUI kernel's start number this program last saw
    long _defined;                  // the start its shared definitions were last made in

    /// EVERYTHING KEPT FOR A RESTART IS SHARED BY THE PROGRAM'S THREADS, and
    /// guarded by this: the windows, the definitions, the bindings, the
    /// watches. Never held across a call into the GUI kernel -- a restore
    /// copies what it needs under it and replays with it let go, since a call
    /// may itself find the GUI kernel restarted and come back here.
    readonly object _keep = new object();

    /// A call through the gate, with the two answers that are not the
    /// seat's: ENOSYS, this thread is not attached (or the gate is closed
    /// while the GUI kernel restarts), and EIO, the call was cut off by a
    /// crash. Either way the thread attaches -- waiting for the GUI kernel
    /// to be up -- and the call is made again, after the windows have been
    /// put back if this is a new start. An EIO that was the seat's own
    /// answer, on a start that has not changed, is handed back as it is.
    long Call(long call, long a, long b, long c)
    {
        while (true)
        {
            long answer = Platform.Result(Sys.GuiCall(call, a, b, c));
            if (answer != -NoSys && answer != -Io) return answer;
            long was;
            lock (_keep) { was = _start; }
            if (!Attach()) return answer;
            long now;
            lock (_keep) { now = _start; }
            if (answer == -Io && now == was) return answer;
        }
    }

    /// This thread into the GUI kernel, waiting up to half a minute for it
    /// to be up; and what this thread had there, made again if the GUI
    /// kernel is a new start. THE THREAD'S OWN THINGS ONLY: a window belongs
    /// to the thread that made it (its handle carries that thread's id), and
    /// only that thread may make it again, so each thread puts its own back
    /// the first time it comes in after a restart -- a thread asleep on its
    /// events is woken for exactly that (poll on the seat says ready). The
    /// first thread in also makes the program's definitions again. If the GUI
    /// kernel starts yet again meanwhile, it is all done once more.
    bool Attach()
    {
        // HALF A MINUTE IN ALL, whatever the GUI kernel does meanwhile: a tenth
        // of a second a try while it is not up, and a try for every start
        // that a restore finds overtaken by another -- a GUI kernel that keeps
        // crashing is given up on, not chased for ever.
        for (int tries = 0; tries < 300; tries++)
        {
            long attached = Platform.Result(Sys.Syscall(GuiAttach, 0, 0, 0));
            if (attached != 0) { Thread.Sleep(100); continue; }
            long start = Platform.Result(Sys.GuiCall(CallIoctl, SeatStart, 0, 0));
            if (start <= 0) return true;
            bool first;
            lock (_keep)
            {
                first = _start == 0;
                if (first) { _start = start; _defined = start; }
                else _start = start;
            }
            if (first) return true;
            long me = Platform.Result(Sys.GuiCall(CallIoctl, SeatWhoami, 0, 0));
            Restore(start, me);
            long after = Platform.Result(Sys.GuiCall(CallIoctl, SeatStart, 0, 0));
            if (after == start || after <= 0) return true;
        }
        return false;
    }

    long Ioctl(long request, long argument)
    {
        return Call(CallIoctl, request, argument & 0xFFFFFFFF, (argument >> 32) & 0xFFFFFFFF);
    }

    int Write(byte[] data, int at, int count)
    {
        return (int)Call(CallWrite, Sys.ArrayData(data) + at, count, 0);
    }

    int Read(byte[] data, int at, int count)
    {
        return (int)Call(CallRead, Sys.ArrayData(data) + at, count, 0);
    }

    // ---- what is kept to be made again after a crash --------------------------

    class Kept
    {
        public int Handle, X, Y, W, H;
        public long Owner;               // the thread that made it: only it may make it again
        public long Start;               // the GUI kernel's start it was last made in
        public bool Shown, Desktop, TopMost, NoTaskbar, Minimized;
        public string Title = "";

        public Kept Copy()
        {
            Kept made = new Kept();
            made.Handle = Handle; made.X = X; made.Y = Y; made.W = W; made.H = H;
            made.Owner = Owner; made.Start = Start;
            made.Shown = Shown; made.Desktop = Desktop; made.TopMost = TopMost; made.NoTaskbar = NoTaskbar; made.Minimized = Minimized;
            made.Title = Title;
            return made;
        }
    }

    List<Kept> _kept = new List<Kept>();
    Dictionary<int, byte[]> _glyphs = new Dictionary<int, byte[]>();       // the whole DefineGlyph op
    Dictionary<int, byte[]> _bitmaps = new Dictionary<int, byte[]>();      // the whole DefineBitmap op
    Dictionary<int, byte[]> _cursors = new Dictionary<int, byte[]>();      // the whole DefinePointer op
    Dictionary<int, int> _bindings = new Dictionary<int, int>();           // standard shape -> own shape
    Dictionary<int, byte[]> _animations = new Dictionary<int, byte[]>();   // the whole AnimateCursor record
    List<long> _watchesWindows = new List<long>();     // threads that asked, by id
    List<long> _watchesPointer = new List<long>();
    int _reservedBottom = -1;

    /// Under _keep.
    Kept? Find(int handle)
    {
        for (int i = 0; i < _kept.Count; i++) if (_kept[i].Handle == handle) return _kept[i];
        return null;
    }

    /// The GUI kernel was started again and everything this program had
    /// there is gone. The shared things -- the screen's size, the program's
    /// glyphs, pictures and pointer shapes, its bindings and its bar -- are
    /// made again by the first thread in; then this thread's own windows and
    /// watches, in the order they were made, and its windows shown last,
    /// which is when the seat asks for them to be painted. Anything converted
    /// to the screen's pixels is handed over again by whoever holds it
    /// (Epoch), as after a mode change.
    void Restore(long start, long me)
    {
        // What to make again, copied under the lock; made with it let go.
        bool define;
        byte[][] ops;
        int[] bindShapes, bindIds;
        byte[][] animations;
        int reserved;
        bool watchWindows, watchPointer;
        List<Kept> mine = new List<Kept>();
        lock (_keep)
        {
            define = _defined != start;
            if (define) _defined = start;
            List<byte[]> all = new List<byte[]>();
            if (define)
            {
                foreach (byte[] op in _glyphs.Values) all.Add(op);
                foreach (byte[] op in _bitmaps.Values) all.Add(op);
                foreach (byte[] op in _cursors.Values) all.Add(op);
            }
            ops = all.ToArray();
            List<byte[]> steps = new List<byte[]>();
            if (define) foreach (byte[] record in _animations.Values) steps.Add(record);
            animations = steps.ToArray();
            bindShapes = new int[define ? _bindings.Count : 0];
            bindIds = new int[bindShapes.Length];
            if (define)
            {
                int at = 0;
                foreach (KeyValuePair<int, int> bound in _bindings) { bindShapes[at] = bound.Key; bindIds[at] = bound.Value; at++; }
            }
            reserved = _reservedBottom;
            watchWindows = _watchesWindows.Contains(me);
            watchPointer = _watchesPointer.Contains(me);
            for (int i = 0; i < _kept.Count; i++)
            {
                Kept w = _kept[i];
                if (w.Owner != me || w.Start == start) continue;
                w.Start = start;
                mine.Add(w.Copy());
            }
        }

        if (define)
        {
            Width = (int)Ioctl(0x47550001, 0);
            Height = (int)Ioctl(0x47550002, 0);
            Format = (int)Ioctl(0x47550003, 0);
            Epoch++;
            foreach (byte[] op in ops) Send(op);
            foreach (byte[] record in animations) Ioctl(SeatAnimateCursor, Sys.ArrayData(record));
            for (int i = 0; i < bindShapes.Length; i++) Ioctl(0x47550028, (bindShapes[i] & 0xFF) | ((bindIds[i] & 0xFFFF) << 8));
            if (reserved >= 0) Ioctl(0x4755001A, reserved);
        }
        if (watchWindows) Ioctl(0x4755001D, 0);
        if (watchPointer) Ioctl(0x47550020, 0);

        foreach (Kept w in mine)
        {
            if (Ioctl(SeatCreateAs, w.Handle) < 0)
            {
                Console.Error.WriteLine("Corsac.GUI: window " + w.Handle + " could not be made again after the GUI kernel restarted");
                continue;
            }
            Ioctl(0x47550011, (w.W & 0xFFFF) | (w.H << 16));
            Ioctl(0x47550015, (w.X & 0xFFFF) | (w.Y << 16));
            if (w.Title.Length > 0) SendTitle(w.Title);
            if (w.Desktop) Ioctl(0x47550018, 0);
            if (w.TopMost) Ioctl(0x47550019, 1);
            if (w.NoTaskbar) Ioctl(0x47550024, 1);
            if (w.Minimized) Ioctl(0x47550043, 1);
        }
        foreach (Kept w in mine)
        {
            if (!w.Shown) continue;
            Select(w.Handle);
            Ioctl(0x47550012, 0);
        }
    }

    /// One op, written whole.
    void Send(byte[] op)
    {
        int at = 0;
        while (at < op.Length)
        {
            int n = Write(op, at, op.Length - at);
            if (n <= 0) break;
            at += n;
        }
    }

    void SendTitle(string title)
    {
        byte[] bytes = new byte[64];
        for (int i = 0; i < title.Length && i < 63; i++) bytes[i] = (byte)title[i];
        Ioctl(0x4755001B, Sys.ArrayData(bytes));
    }

    public Seat(string path)
    {
        _fd = Os.Open(path, 2, 0);          // O_RDWR
        if (_fd < 0) throw new IOException("cannot open seat " + path);
        Width = (int)Ioctl(0x47550001, 0);
        Height = (int)Ioctl(0x47550002, 0);
        Format = (int)Ioctl(0x47550003, 0);
        // A seat device that exists but has no screen answers every question
        // with an error: the kernel says why on the console. Finding out here
        // is what lets a program say so and stop, rather than failing at its
        // first window and being started again for ever.
        if (Width <= 0 || Height <= 0) throw new IOException("seat " + path + " has no screen");
    }

    /// <summary>One mode this display can be put into.</summary>
    public struct SeatMode
    {
        public int Width;
        public int Height;
        public int Format;
        public int Refresh;

        /// "800 x 600" -- what a person picking a screen area reads.
        public override string ToString()
        {
            return Width.ToString() + " x " + Height.ToString();
        }
    }

    /// <summary>
    /// The seat changed mode: take the new size. Called by the event pump
    /// when the seat says so, because Width and Height were read once when
    /// this was opened and are now wrong.
    /// </summary>
    public void Rescreen(int width, int height)
    {
        Width = width;
        Height = height;
        Format = (int)Ioctl(0x47550003, 0);      // the depth may be what changed
        Epoch++;
        _used = 0;              // whatever was half-built described the old screen
        _named = false;
        _clipOn = false;
    }

    /// <summary>
    /// Asks the seat to change mode now. The rate may be zero, which means
    /// whichever the card would pick for that size.
    /// </summary>
    /// <summary>
    /// The card this seat draws on, as its driver describes it. Asked of
    /// the seat each time: how much display memory is free changes as
    /// windows come and go.
    /// </summary>
    public DisplayAdapter Adapter()
    {
        DisplayAdapter made = new DisplayAdapter();
        byte[] block = new byte[160];

        Flush();
        if (Ioctl(0x47550035, Sys.ArrayData(block)) < 0) { return made; }

        made.Name = Text(block, 0, 64);
        made.Detail = Text(block, 64, 64);
        made.Driver = Text(block, 128, 16);
        made.MemoryKiB = Word(block, 144);
        made.FreeKiB = Word(block, 148);
        made.Capabilities = Word(block, 152);
        made.ModeCount = Word(block, 156);
        return made;
    }

    static string Text(byte[] block, int from, int room)
    {
        string text = "";
        for (int i = 0; i < room && block[from + i] != 0; i++) text = text + (char)block[from + i];
        return text;
    }

    static int Word(byte[] block, int at)
    {
        return block[at] | (block[at + 1] << 8) | (block[at + 2] << 16) | (block[at + 3] << 24);
    }

    public bool SetMode(int width, int height, int refresh) { return SetMode(width, height, refresh, 0); }

    /// The same with a colour depth in bits per pixel; nought keeps the
    /// depth the seat is in. Only a mode the display's own list holds is
    /// taken -- see ModeAt -- so asking for one that is not there is a
    /// refusal and not an experiment on the monitor.
    public bool SetMode(int width, int height, int refresh, int bits)
    {
        Flush();

        // FOUR WORDS BY ADDRESS, not packed into the argument: an ioctl's
        // argument is one machine word, and on a 32-bit machine everything
        // packed above bit 31 -- the rate and the depth -- simply never
        // arrived, so a change of depth alone "succeeded" by doing nothing.
        byte[] request = new byte[16];
        long at = Sys.ArrayData(request);

        Sys.PokeWord(at, width);
        Sys.PokeWord(at + 4, height);
        Sys.PokeWord(at + 8, refresh);
        Sys.PokeWord(at + 12, bits);
        return Ioctl(0x47550034, at) == 0;
    }

    /// The refresh rate in use, or zero where the card chose it.
    public int Refresh { get { return (int)Ioctl(0x47550032, 0); } }

    /// How many modes this display has. Each is a size, a colour depth and
    /// a refresh rate; the same size appears once per rate it supports.
    public int ModeCount() { return (int)Ioctl(0x47550030, 0); }

    /// The mode at `index`, or false where there is none.
    public bool ModeAt(int index, out SeatMode mode)
    {
        mode = new SeatMode();

        byte[] request = new byte[20];
        long at = Sys.ArrayData(request);

        Sys.PokeWord(at, index);
        if (Ioctl(0x47550031, at) != 0) { return false; }

        mode.Width = (int)Sys.PeekWord(at + 4);
        mode.Height = (int)Sys.PeekWord(at + 8);
        mode.Format = (int)Sys.PeekWord(at + 12);
        mode.Refresh = (int)Sys.PeekWord(at + 16);
        return true;
    }

    /// Whether a seat can be used, without throwing to find out.
    public static bool Usable(string path)
    {
        try { new Seat(path).Close(); return true; }
        catch (IOException) { return false; }
    }

    /// The device given back. The seat keeps the program's windows until
    /// the program ends.
    public void Close()
    {
        if (_fd >= 0) Os.Close(_fd);
        _fd = -1;
    }

    public int Fd { get { return _fd; } }

    /// How many colours this screen can show: what a picture with several
    /// versions of itself chooses between.
    /// Bits to a pixel in the mode the seat is in. Format is the kernel's
    /// GfxFormat: 1 an eight-bit palette, 2 five-six-five, 3 and 4 eight
    /// bits a channel, packed in three bytes or padded to four.
    public int BitsPerPixel { get { return BitsOf(Format); } }

    public static int BitsOf(int format) { return format == 2 ? 16 : format == 3 ? 24 : format == 4 ? 32 : 8; }

    /// How many colours that is: what decides whether a gradient or an
    /// antialiased letter is worth drawing.
    public int Colours { get { return Format == 2 ? 65536 : Format >= 3 ? 16777216 : 256; } }

    /// Counts mode changes. Anything a program handed the seat that was
    /// converted to the mode's pixels -- an icon -- went with the old mode;
    /// whoever holds one compares this with the value it had when it
    /// handed the picture over, and hands it over again when they differ.
    public int Epoch;

    // Ids for pictures and pointer shapes the seat keeps for us. Handing
    // them out here rather than making every caller invent one is what
    // stops two libraries from quietly using the same number.
    static int _nextBitmap;
    static int _nextCursor;
    // A program's own numbers: the seat keeps a map per program, so these
    // need only be unique within it. Cursor ids stop short of the autoscroll
    // shapes' (CursorShapes.NoMove2D and on); the seat holds 64 a program.
    public static int NextBitmapId() { lock (_idLock) { int id = _nextBitmap; _nextBitmap = (_nextBitmap + 1) % 256; return id; } }
    public static int NextCursorId() { lock (_idLock) { int id = _nextCursor; _nextCursor = (_nextCursor + 1) % 0x7F0; return id; } }
    static readonly object _idLock = new object();

    /// A shape this program defined becomes one of the standard ones, for
    /// every program on the seat: what a system does once with real cursor
    /// art, so that nothing else has to know where the art came from.
    public void BindCursor(int shape, int id) { lock (_keep) { _bindings[shape] = id; } Ioctl(0x47550028, (shape & 0xFF) | ((id & 0xFFFF) << 8)); }

    /// A standard shape back to the seat's own drawing of it.
    public void UnbindCursor(int shape) { lock (_keep) { _bindings.Remove(shape); } Ioctl(0x47550028, (shape & 0xFF) | (0xFFFF << 8)); }

    /// AN ANIMATED CURSOR, as an .ani file describes one: the cursor `id`
    /// (defined already) shown as the others in turn, each for its number
    /// of sixtieths of a second. Selected and bound like any cursor, by id.
    /// False if the seat would not take it (a frame it does not have).
    public bool AnimateCursor(int id, int[] frames, int[] jiffies)
    {
        int steps = Math.Min(Math.Min(frames.Length, jiffies.Length), 64);
        byte[] record = new byte[8 + 64 * 8];
        Put(record, 0, id); Put(record, 4, steps);
        for (int i = 0; i < steps; i++) { Put(record, 8 + i * 8, frames[i]); Put(record, 12 + i * 8, jiffies[i]); }
        Flush();
        if (Ioctl(SeatAnimateCursor, Sys.ArrayData(record)) < 0) return false;
        lock (_keep) { _animations[id] = record; }
        return true;
    }

    /// For a program that attaches its threads to the GUI kernel itself (the
    /// gui program does, to start it): after a restart it found, what this
    /// seat had there is made again, as any call here would have done had
    /// it been the one to find the restart.
    public bool Resume() { return Attach(); }

    /// Where the pointer is on the screen: Windows' GetCursorPos.
    public Point CursorPosition()
    {
        long at = Ioctl(SeatCursorAt, 0);
        if (at < 0) return new Point(0, 0);
        return new Point((int)(at & 0xFFFF), (int)((at >> 16) & 0xFFFF));
    }

    /// A character was typed into a text box: the pointer is hidden until it
    /// next moves, if the user has "Hide pointer while typing" on.
    public void VanishPointer() { Ioctl(SeatVanishPointer, 0); }

    /// Put the pointer somewhere, as moving the mouse would: SetCursorPos.
    public void MoveCursorTo(int x, int y) { Ioctl(SeatCursorTo, (x & 0xFFFF) | ((y & 0xFFFF) << 16)); }

    /// Keep the pointer inside a rectangle of the screen (Windows'
    /// ClipCursor); an empty one lets it go. The seat lets it go too when
    /// this program loses the focus.
    public void ClipCursor(Rectangle area)
    {
        if (area.Width <= 0 || area.Height <= 0) { Ioctl(SeatClipCursor, 0); return; }
        long right = area.X + area.Width - 1, bottom = area.Y + area.Height - 1;
        Ioctl(SeatClipCursor, ((long)area.X & 0xFFFF) | (((long)area.Y & 0xFFFF) << 16)
                              | ((right & 0xFFFF) << 32) | ((bottom & 0xFFFF) << 48));
    }

    /// How many windows the seat is showing, everybody's included.
    public int ShownWindows() { int n = (int)Ioctl(0x47550005, 0); return n < 0 ? 0 : n; }

    // --- batches ---------------------------------------------------------

    /// Room for one whole op. AN OP IS NEVER SPLIT ACROSS TWO WRITES: the
    /// seat reads each write on its own, and the tail of an op at the head
    /// of the next write is parsed as opcodes, which throws the rest away.
    void Room(int words)
    {
        if (_used + words * 4 > _batch.Length) { Flush(); Renew(); }
    }

    static void Put(byte[] into, int at, int v)
    {
        into[at] = (byte)v; into[at + 1] = (byte)(v >> 8);
        into[at + 2] = (byte)(v >> 16); into[at + 3] = (byte)(v >> 24);
    }

    void Word(int v)
    {
        _batch[_used] = (byte)v; _batch[_used + 1] = (byte)(v >> 8);
        _batch[_used + 2] = (byte)(v >> 16); _batch[_used + 3] = (byte)(v >> 24);
        _used += 4;
    }

    static int Rgb(Color c) { return (c.R << 16) | (c.G << 8) | c.B; }

    /// Send what is queued. Called when the buffer fills, on request, and
    /// by the message loop before it waits, which is the rule that keeps a
    /// program's last few draws from sitting unseen while it blocks.
    public void Flush()
    {
        int at = 0;
        while (at < _used)
        {
            int n = Write(_batch, at, _used - at);
            // A batch the seat would not take is a bug in whoever built it,
            // and a bug that shows up as a picture quietly not appearing is
            // the worst kind: it stops the program here, with the kernel's
            // console line saying which op and where.
            if (n < 0) { _used = 0; throw new InvalidOperationException("the seat rejected a drawing batch (" + (-n) + ")"); }
            if (n == 0) break;
            at += n;
        }
        _used = 0;
        // The seat forgets the current window and clip at the end of every
        // write, so the next batch has to name them again: Renew does, when
        // a batch filled up mid-drawing; a new batch starts with Target.
        _named = false;
    }

    /// After a flush in the middle of drawing: the same window and clip
    /// again, or the rest of the drawing goes nowhere.
    void Renew()
    {
        if (_window != 0) { _named = true; Word(12); Word(_window); }
        if (_clipOn) { Word(6); Word(_clipX); Word(_clipY); Word(_clipW); Word(_clipH); }
    }

    public void Target(int window)
    {
        if (_window == window && _named) return;
        _window = window;
        _named = true;
        _clipOn = false;
        Room(2); Word(12); Word(window);
    }

    public void Fill(int x, int y, int w, int h, Color colour) { Room(6); Word(1); Word(x); Word(y); Word(w); Word(h); Word(Rgb(colour)); }
    public void Copy(int sx, int sy, int dx, int dy, int w, int h) { Room(7); Word(2); Word(sx); Word(sy); Word(dx); Word(dy); Word(w); Word(h); }
    public void Line(int x0, int y0, int x1, int y1, Color colour) { Room(6); Word(3); Word(x0); Word(y0); Word(x1); Word(y1); Word(Rgb(colour)); }
    public void Glyph(int id, int x, int y, Color fg, Color bg, bool transparent)
    { Room(7); Word(5); Word(id); Word(x); Word(y); Word(Rgb(fg)); Word(Rgb(bg)); Word(transparent ? 1 : 0); }
    public void Clip(int x, int y, int w, int h)
    {
        _clipOn = true; _clipX = x; _clipY = y; _clipW = w; _clipH = h;
        Room(5); Word(6); Word(x); Word(y); Word(w); Word(h);
    }
    /// A picture the seat keeps, to be drawn afterwards by its id. The
    /// colours are 0xAARRGGBB, which is what an image decodes to; the seat
    /// turns them into the screen's own pixels once, here, and remembers
    /// which of them are see-through.
    public void DefineBitmap(int id, int width, int height, byte[] argb)
    {
        int bytes = width * height * 4;
        Flush();
        // ONE WRITE: the seat reads the pixels out of the same batch as the
        // op that introduces them, so they cannot be a second write.
        // Five words, as the seat's DefineBitmap is declared: id, width,
        // height, format (0: 0xAARRGGBB), then how many bytes follow. Sent
        // with four, the seat read the byte count out of the first pixel,
        // found it did not fit, and dropped the picture without a word.
        byte[] one = new byte[24 + bytes];
        Put(one, 0, 7); Put(one, 4, id); Put(one, 8, width); Put(one, 12, height); Put(one, 16, 0); Put(one, 20, bytes);
        for (int i = 0; i < bytes; i++) one[24 + i] = argb[i];
        lock (_keep) { _bitmaps[id] = one; }
        Send(one);
        Renew();
    }

    /// A pointer shape from a cursor file. The seat reduces it to what a
    /// card's hardware cursor can show -- two colours and a hole -- and it
    /// is then selected like any other shape, by SetCursor(CursorBase + id).
    public void DefineCursor(int id, int width, int height, int hotX, int hotY, byte[] argb)
    {
        int bytes = width * height * 4;
        Flush();
        byte[] one = new byte[24 + bytes];
        Put(one, 0, 11); Put(one, 4, id); Put(one, 8, width); Put(one, 12, height);
        Put(one, 16, (hotX & 0xFFFF) | (hotY << 16)); Put(one, 20, bytes);
        for (int i = 0; i < bytes; i++) one[24 + i] = argb[i];
        lock (_keep) { _cursors[id] = one; }
        Send(one);
        Renew();
    }

    public void Blit(int id, int sx, int sy, int x, int y, int width, int height)
    { Room(8); Word(8); Word(id); Word(sx); Word(sy); Word(x); Word(y); Word(width); Word(height); }

    public void ShowPointer(bool on) { Room(2); Word(10); Word(on ? 1 : 0); }
    public void MovePointer(int x, int y) { Room(3); Word(9); Word(x); Word(y); }

    // --- windows ---------------------------------------------------------
    //
    // A window operation selects the handle first, then acts on it: the i386
    // call convention carries 32-bit arguments, so a handle cannot ride in the
    // high half of the argument as a 64-bit ABI would allow.

    void Select(int handle) { Ioctl(0x47550029, handle); }

    public int CreateWindow(int x, int y, int w, int h)
    {
        Flush();
        int handle = (int)Ioctl(0x47550010, (x & 0xFFFF) | (y << 16));
        if (handle <= 0) throw new IOException("cannot create a window");
        Select(handle);
        Ioctl(0x47550011, (w & 0xFFFF) | (h << 16));
        Kept kept = new Kept();
        kept.Handle = handle; kept.X = x; kept.Y = y; kept.W = w; kept.H = h;
        kept.Owner = (long)handle >> 12;            // the thread that made it (its handle says so)
        lock (_keep) { kept.Start = _start; _kept.Add(kept); }
        return handle;
    }
    /// What every window call goes through: the seat's answer, and an
    /// exception if it was a refusal. The kernel says why on its console.
    static void Must(long answer, string what)
    {
        if (answer < 0) throw new InvalidOperationException("the seat refused " + what + " (" + (-answer) + ")");
    }

    public void ShowWindow(int handle) { Flush(); Select(handle); Must(Ioctl(0x47550012, 0), "showing a window"); lock (_keep) { Kept? k = Find(handle); if (k != null) { k.Shown = true; k.Minimized = false; } } }
    public void HideWindow(int handle) { Flush(); Select(handle); Must(Ioctl(0x47550013, 0), "hiding a window"); lock (_keep) { Kept? k = Find(handle); if (k != null) { k.Shown = false; k.Minimized = false; } } }
    /// The window minimized -- off the screen, still on the taskbar, which
    /// asks for it back with a Restore event -- or not any more (ShowWindow
    /// puts it back on the screen).
    public void MinimizeWindow(int handle, bool minimized)
    {
        Flush(); Select(handle); Ioctl(0x47550043, minimized ? 1 : 0);
        lock (_keep) { Kept? k = Find(handle); if (k != null) { k.Minimized = minimized; if (minimized) k.Shown = false; } }
    }
    /// Ask any window's owner to minimize it (a taskbar button pressed
    /// while its window is the active one).
    public void RequestMinimize(int handle) { Flush(); Ioctl(0x47550044, handle); }
    public void RaiseWindow(int handle) { Flush(); Select(handle); Must(Ioctl(0x47550014, 0), "raising a window"); }
    public void MoveWindow(int handle, int x, int y)
    {
        Flush(); Select(handle); Must(Ioctl(0x47550015, (x & 0xFFFF) | (y << 16)), "moving a window");
        lock (_keep) { Kept? k = Find(handle); if (k != null) { k.X = x; k.Y = y; } }
    }
    /// Where the seat's move loop put a window (the Moved event): kept, so
    /// a restart of the GUI kernel puts it back there, with nothing asked.
    public void NoteMoved(int handle, int x, int y) { lock (_keep) { Kept? k = Find(handle); if (k != null) { k.X = x; k.Y = y; } } }

    /// Windows' move and size loop (SC_MOVE, SC_SIZE), run by the seat
    /// from the main button's press on the window until it comes up: the
    /// window, or an outline of it, follows the pointer in the GUI kernel,
    /// and the owner is told where it ended (the Moved and Sized events).
    /// Edges: 1 left, 2 right, 4 top, 8 bottom. False when the button is
    /// already up, and nothing is tracked.
    public bool TrackMove(int handle) { Flush(); Select(handle); return Ioctl(0x47550039, 0) >= 0; }
    public bool TrackSize(int handle, int edges, int minimumWidth, int minimumHeight)
    {
        Flush(); Select(handle);
        return Ioctl(0x4755003A, (edges & 0xF) | ((minimumWidth & 0x3FFF) << 4) | ((minimumHeight & 0x3FFF) << 18)) >= 0;
    }

    public void ResizeWindow(int handle, int w, int h)
    {
        Flush(); Select(handle); Must(Ioctl(0x47550011, (w & 0xFFFF) | (h << 16)), "resizing a window");
        lock (_keep) { Kept? k = Find(handle); if (k != null) { k.W = w; k.H = h; } }
    }
    public void DestroyWindow(int handle)
    {
        Flush(); Select(handle); Ioctl(0x47550016, 0); _window = 0; _named = false;
        lock (_keep) { Kept? k = Find(handle); if (k != null) _kept.Remove(k); }
    }
    public void FocusWindow(int handle) { Flush(); Select(handle); Ioctl(0x47550017, 0); }
    /// This window is the desktop: the surface under everything, never raised.
    public void DesktopWindow(int handle) { Flush(); Select(handle); Ioctl(0x47550018, 0); lock (_keep) { Kept? k = Find(handle); if (k != null) k.Desktop = true; } }
    /// This window stays above every ordinary one (a bar).
    public void TopMostWindow(int handle, bool on) { Flush(); Select(handle); Ioctl(0x47550019, on ? 1 : 0); lock (_keep) { Kept? k = Find(handle); if (k != null) k.TopMost = on; } }
    /// This window is not listed on a taskbar.
    /// Whether this window is listed on a taskbar; takes effect at once.
    public void ListOnTaskbar(int handle, bool listed) { Flush(); Select(handle); Ioctl(0x47550024, listed ? 0 : 1); lock (_keep) { Kept? k = Find(handle); if (k != null) k.NoTaskbar = !listed; } }

    /// The window's title, as the seat lists it (a taskbar reads it).
    public void SetTitle(int handle, string title)
    {
        byte[] bytes = new byte[64];
        for (int i = 0; i < title.Length && i < 63; i++) bytes[i] = (byte)title[i];
        Flush(); Select(handle); Ioctl(0x4755001B, Sys.ArrayData(bytes));
        lock (_keep) { Kept? k = Find(handle); if (k != null) k.Title = title; }
    }

    /// Ask for a WindowsChanged message whenever the seat's list or focus changes.
    public void WatchWindows()
    {
        long me = Ioctl(SeatWhoami, 0);
        lock (_keep) { if (!_watchesWindows.Contains(me)) _watchesWindows.Add(me); }
        Ioctl(0x4755001D, 0);
    }

    /// Every shown window on the seat, bottom to top, whoever owns it.
    public SeatWindowInfo[] Windows()
    {
        byte[] records = new byte[80 * 64];
        int n = (int)Ioctl(0x4755001C, Sys.ArrayData(records));
        if (n < 0) n = 0;
        if (n > 64) n = 64;
        SeatWindowInfo[] result = new SeatWindowInfo[n];
        for (int i = 0; i < n; i++)
        {
            int at = i * 80;
            SeatWindowInfo w = new SeatWindowInfo();
            w.Handle = records[at] | (records[at + 1] << 8) | (records[at + 2] << 16) | (records[at + 3] << 24);
            w.Owner = records[at + 4] | (records[at + 5] << 8) | (records[at + 6] << 16) | (records[at + 7] << 24);
            w.Flags = records[at + 8] | (records[at + 9] << 8);
            int xy = records[at + 12] | (records[at + 13] << 8) | (records[at + 14] << 16) | (records[at + 15] << 24);
            int wh = records[at + 16] | (records[at + 17] << 8) | (records[at + 18] << 16) | (records[at + 19] << 24);
            w.Bounds = new Rectangle(LowSigned(xy), HighSigned(xy), wh & 0xFFFF, (wh >> 16) & 0xFFFF);
            string title = "";
            for (int k = 0; k < 56 && records[at + 24 + k] != 0; k++) title = title + (char)records[at + 24 + k];
            w.Title = title;
            result[i] = w;
        }
        return result;
    }

    /// Raise and focus any window, whoever owns it (a taskbar button).
    public void Activate(int handle) { Flush(); Ioctl(0x4755001E, handle); }

    // --- inspection: what is under a point of the screen, asked of the
    // window's owner through the seat (a spy tool) -------------------------
    public void WatchPointer()
    {
        long me = Ioctl(SeatWhoami, 0);
        lock (_keep) { if (!_watchesPointer.Contains(me)) _watchesPointer.Add(me); }
        Ioctl(0x47550020, 0);
    }

    /// The pointer's shape while it is over one of this program's windows.
    /// The seat puts the arrow back the moment the pointer leaves.
    public void SetCursor(int cursor) { Ioctl(0x47550025, cursor); }

    // --- the mouse's settings, asked the way Windows asks: the index is
    // the Win32 one (SM_* for GetSystemMetrics, SPI_GET* for
    // SystemParametersInfo); System.Windows.Forms.SystemInformation is the
    // .NET face of these -------------------------------------------------
    public int SystemMetric(int index) { return (int)Ioctl(0x47550040, index); }
    public int ParameterInfo(int action) { return (int)Ioctl(0x47550041, action); }

    /// The mouse's settings are read again, as this program's user sees the
    /// registry: what the desktop does when a session starts, and the Mouse
    /// control panel after a change.
    public void ReloadSettings() { Ioctl(0x47550042, 0); }

    /// The drag outline the seat draws over everything: where a window is
    /// heading while the button is held. A width of zero takes it away.
    public void SetBand(int x, int y, int width, int height)
    {
        Flush();
        Ioctl(0x47550027, (width & 0xFFFF) | (height << 16));
        Ioctl(0x47550026, (x & 0xFFFF) | (y << 16));
    }
    public void ClearBand() { SetBand(0, 0, 0, 0); }
    /// Ask the owner of the window at a screen point what is there; the
    /// answer arrives as Application.Inspected. Returns the window handle, or -1.
    public int Inspect(int screenX, int screenY) { Flush(); return (int)Ioctl(0x47550021, (screenX & 0xFFFF) | (screenY << 16)); }
    public void InspectReply(string text)
    {
        byte[] bytes = new byte[256];
        for (int i = 0; i < text.Length && i < 255; i++) bytes[i] = (byte)text[i];
        Ioctl(0x47550022, Sys.ArrayData(bytes));
    }
    public string InspectRead()
    {
        byte[] bytes = new byte[256];
        int n = (int)Ioctl(0x47550023, Sys.ArrayData(bytes));
        string text = "";
        for (int i = 0; i < n && i < 255 && bytes[i] != 0; i++) text = text + (char)bytes[i];
        return text;
    }
    /// Ask any window's owner to close it.
    public void CloseWindow(int handle) { Flush(); Ioctl(0x4755001F, handle); }

    /// A glyph of the program's own, ids from 256: rows of packed bits, the
    /// most significant first, (width+7)/8 bytes per row.
    public void DefineGlyph(int id, int width, int height, byte[] bits)
    {
        int padded = (bits.Length + 3) & ~3;
        byte[] op = new byte[20 + padded];
        Put(op, 0, 4); Put(op, 4, id); Put(op, 8, width); Put(op, 12, height); Put(op, 16, bits.Length);
        for (int i = 0; i < bits.Length; i++) op[20 + i] = bits[i];
        lock (_keep) { _glyphs[id] = op; }
        Room(5 + padded / 4);
        for (int i = 0; i < op.Length; i++) _batch[_used++] = op[i];
    }
    // --- synthetic input: driving the seat from outside (a test harness
    // with no keyboard or mouse of its own). Each goes the way the real
    // device's input goes: a key to the focused window, the pointer into the
    // kernel's pointer ring as an absolute device of its own. ---------------

    /// A key, as the keyboard would have given it: a Key code or a
    /// character, and the modifiers (Key.Shift, Ctrl, Alt, Caps, Num) or'd.
    public void InjectKey(long key, long modifiers) { Ioctl(0x47550007, (key & 0xFFFFFFFF) | (modifiers << 32)); }

    /// The injected pointer to a place on the screen, in pixels.
    public void InjectPointerMove(int x, int y) { Ioctl(0x47550008, (x & 0xFFFF) | ((y & 0xFFFF) << 16)); }

    /// A button of the injected pointer: 1 main, 2 alternate, 3 middle, 4
    /// back, 5 forward.
    public void InjectPointerButton(int action, bool down) { Ioctl(0x47550009, (action & 0xFF) | ((down ? 1 : 0) << 8)); }

    /// Notches of the wheel, Windows' way: positive away from the user.
    public void InjectPointerWheel(int notches) { Ioctl(0x4755000A, notches); }

    /// Notches of the horizontal wheel, positive to the right.
    public void InjectPointerHWheel(int notches) { Ioctl(0x4755000B, notches); }

    /// Rows at the bottom of the screen a bar owns: windows keep out of them.
    public void ReserveBottom(int rows) { lock (_keep) { _reservedBottom = rows; } Ioctl(0x4755001A, rows); }
    /// The screen height minus what a bar has reserved: where windows go.
    public int WorkAreaHeight() { int h = (int)Ioctl(0x47550006, 0); return h <= 0 ? Height : h; }
    static int Signed16(int v) { int n = v & 0xFFFF; return n >= 0x8000 ? n - 0x10000 : n; }
    public static int LowSigned(int packed) { return Signed16(packed); }
    public static int HighSigned(int packed) { return Signed16(packed >> 16); }

    // --- events ----------------------------------------------------------

    byte[] _event = new byte[16];

    /// Blocks until the seat has a message. Everything queued is flushed
    /// first, because a program about to wait must not leave its own
    /// drawing behind.
    public bool Next(out Message m)
    {
        Flush();
        m = new Message();
        int got = 0;
        while (got < 16)
        {
            int n = Read(_event, got, 16 - got);
            if (n <= 0) return false;
            got += n;
        }
        m.Kind = Int(0); m.Window = Int(4); m.A = Int(8); m.B = Int(12);
        return true;
    }

    /// Is a message waiting? poll(2) on the seat: the kernel answers for
    /// the device and sleeps the caller until something arrives or the
    /// time is up. Nothing here spins or naps in steps.
    /// The frame is finished: what has been drawn may go on the screen.
    ///
    /// The seat keeps drawing in the window's own surface and puts it up in
    /// one piece when this arrives, so nothing is ever watched being drawn.
    /// Waiting for events says the same thing, which is why Poll and WaitAny
    /// send it too -- a program that only ever paints and waits needs no
    /// call of its own.
    public void Present()
    {
        Room(1); Word(13);                            // SeatOp.Present
        Flush();
    }

    public bool Poll(int timeoutMs)
    {
        Present();
        return Os.Poll(_fd, 1, timeoutMs) > 0;
    }

    /// Wait for the seat or any of `others`, whichever first. Returns the
    /// index into `others` that became readable, or -1 for the seat (or
    /// the timeout; the caller asks the seat, which is cheap).
    public int WaitAny(int[] others, int count, int timeoutMs)
    {
        Present();
        int[] fds = new int[count + 1];
        bool[] ready = new bool[count + 1];
        fds[0] = _fd;
        for (int i = 0; i < count; i++) fds[i + 1] = others[i];
        int n = Os.PollMany(fds, count + 1, 1, timeoutMs, ready);
        if (n <= 0) return -1;
        for (int i = 0; i < count; i++) if (ready[i + 1]) return i;
        return -1;
    }

    int Int(int at) { return _event[at] | (_event[at + 1] << 8) | (_event[at + 2] << 16) | (_event[at + 3] << 24); }
}


/// One shown window on the seat, as Seat.Windows() reports it.
public class SeatWindowInfo
{
    public int Handle;
    public int Owner;
    public int Flags;                        // 1 desktop, 2 top-most, 4 focused, 8 off the taskbar, 16 minimized
    public Rectangle Bounds;                 // on the screen
    public string Title = "";
    public bool IsDesktop { get { return (Flags & 1) != 0; } }
    public bool IsTopMost { get { return (Flags & 2) != 0; } }
    public bool IsFocused { get { return (Flags & 4) != 0; } }
    public bool OnTaskbar { get { return (Flags & 9) == 0; } }      // neither the desktop nor a window that opted out
    public bool IsMinimized { get { return (Flags & 16) != 0; } }
}


/// The shapes a pointer can take. The seat draws them; these are its names.
public static class CursorShapes
{
    public const int Arrow = 0, SizeWE = 1, SizeNS = 2, SizeNWSE = 3, SizeNESW = 4;
    public const int IBeam = 5, Wait = 6, Help = 7, No = 8, Move = 9, Hand = 10, Cross = 11;
    public const int UpArrow = 12, AppStarting = 13;

    /// Shapes a program defined itself are numbered from here: the id it
    /// gave DefineCursor, plus this.
    public const int Base = 256;

    /// The autoscroll shapes, with .NET's names: the origin marker and the
    /// direction the view is moving. Windows Forms defines them (Forms.cor,
    /// AutoScroll) the first time middle-button autoscroll starts; their ids
    /// are the top of a program's own range, so a program's shapes do not
    /// meet them.
    public const int NoMove2D = Base + 0x7F0, NoMoveVert = Base + 0x7F1, NoMoveHoriz = Base + 0x7F2;
    public const int PanNorth = Base + 0x7F3, PanSouth = Base + 0x7F4, PanEast = Base + 0x7F5, PanWest = Base + 0x7F6;
    public const int PanNE = Base + 0x7F7, PanNW = Base + 0x7F8, PanSE = Base + 0x7F9, PanSW = Base + 0x7FA;
}

/// What Seat.Adapter() answers with.
public class DisplayAdapter
{
    public string Name = "";            // "Cirrus Logic GD5446"
    public string Detail = "";          // the bus, the engine, the BIOS: one line
    public string Driver = "";          // the driver's own short word for it
    public int MemoryKiB, FreeKiB;
    public int Capabilities;
    public int ModeCount;

    /// "4 MB", "512 KB": display memory the way a card's box said it.
    public string MemoryText
    {
        get { return MemoryKiB >= 1024 && MemoryKiB % 1024 == 0 ? (MemoryKiB / 1024) + " MB" : MemoryKiB + " KB"; }
    }
}

/// The shell's events and powers: what a taskbar, a desktop or a spy tool
/// uses, raised by the Forms message loop from the seat's messages.
public static class Shell
{
    /// The seat's window list or focus changed (after WatchWindows()).
    public static event EventHandler? WindowsChanged;
    /// The pointer moved anywhere on the screen (after WatchPointer()).
    public static event MouseEventHandler? PointerMoved;
    /// An answer to Seat.Inspect is ready (Seat.InspectRead()).
    public static event EventHandler? Inspected;
    /// Ctrl+Esc was pressed (after WatchWindows()): the seat takes that
    /// key from whoever has the keyboard and hands it to the shell.
    public static event EventHandler? StartRequested;

    public static void WatchWindows() { Seat.Current.WatchWindows(); }
    public static void WatchPointer() { Seat.Current.WatchPointer(); }

    /// This form is the desktop: the surface under everything, never
    /// raised. Before it is shown.
    public static void MakeDesktop(Form f) { f.DesktopSurface = true; }

    internal static void RaiseWindowsChanged() { if (WindowsChanged != null) WindowsChanged(null!, EventArgs.Empty); }
    internal static void RaisePointerMoved(MouseEventArgs e) { if (PointerMoved != null) PointerMoved(null!, e); }
    internal static void RaiseStartRequested() { if (StartRequested != null) StartRequested(null!, EventArgs.Empty); }
    internal static void RaiseInspected() { if (Inspected != null) Inspected(null!, EventArgs.Empty); }
}
