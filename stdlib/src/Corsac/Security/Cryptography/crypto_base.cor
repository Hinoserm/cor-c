// CORSAC/SECURE Crypto portable byte, SHA-256, HMAC and HKDF base.
//
// These algorithms deliberately keep every context word in ordinary memory.
// The Crypto unit's H registers are a processor-context resource, not storage
// belonging to this heap object, so using them here would make two interleaved
// hashes overwrite one another. Stateless HashBlock, when reported by this
// CPU, transforms the object's ordinary-memory state with no hidden stream.

namespace Corsac.Security.Cryptography;

public static class CorsacSecureCrypto_Bytes
{
    /// whenTrue when condition holds, else whenFalse, without a branch on
    /// the condition's value once it is a mask.
    public static long Select(long whenTrue, long whenFalse, bool condition)
    {
        long mask = 0 - (condition ? 1 : 0);
        return (whenTrue & mask) | (whenFalse & ~mask);
    }

    /// Validates the buffer relation required by the Crypto interface without an
    /// offset + count addition which could wrap.
    public static bool Range(byte[] buffer, long offset, long count)
    {
        if (buffer == null || offset < 0 || count < 0) return false;
        return offset <= buffer.Length - count;
    }

    /// A checked memmove.  Direction depends only on public offsets; choosing
    /// backwards for two distinct buffers is harmless and keeps aliasing safe.
    public static bool Copy(byte[] destination, long destinationOffset,
                            byte[] source, long sourceOffset, long count)
    {
        if (!Range(destination, destinationOffset, count)
            || !Range(source, sourceOffset, count)) return false;
        // Sys.Copy lowers to the mandatory restartable MCp block move.  It
        // retains memmove overlap semantics, while processors with optional
        // copy acceleration can execute the same checked operation quickly.
        // Array extents are int-sized, so the validated values cast exactly.
        if (count != 0)
            Sys.Copy(destination, (int)destinationOffset,
                     source, (int)sourceOffset, (int)count);
        return true;
    }

    /// Compares exactly count bytes.  Buffer validity and count are public;
    /// once validated, no byte value changes the work or memory traversal.
    public static bool Equal(byte[] left, long leftOffset,
                             byte[] right, long rightOffset, long count)
    {
        if (!Range(left, leftOffset, count)
            || !Range(right, rightOffset, count)) return false;

        long difference = 0;
        for (long i = 0; i < count; i = i + 1)
            difference = difference
                | (left[(int)(leftOffset + i)]
                 ^ right[(int)(rightOffset + i)]);
        return difference == 0;
    }

    /// Explicitly erases caller-owned storage.  Each array store is observable
    /// through the caller's reference rather than being a dead local write.
    public static bool Zero(byte[] buffer, long offset, long count)
    {
        if (!Range(buffer, offset, count)) return false;
        // MSet is mandatory, restartable, and writes through the caller's
        // object address.  It is therefore both faster for large keys and an
        // explicit observable erase which the compiler cannot discard.
        if (count != 0)
            Sys.MemorySet(Sys.ArrayData(buffer) + offset, 0, count);
        return true;
    }
}

/// A reentrant, memory-authoritative SHA-256 streaming context.
public class CorsacSecureCrypto_Hash
{
    public const int Sha256 = 2;
    public const int InvalidArgument = 1;
    public const int ProtocolState = 9;

    private const long Mask32 = 0xffffffffL;
    private const long MaximumBytes = 0x1fffffffffffffff;

    private byte[] _block;
    private int _held;
    private long _total;
    private uint[] _state;
    // Schedule words are reduced modulo 2^32 before storage. Keep their
    // actual width so every context does not allocate unused high halves.
    private uint[] _work;
    // Public algorithm constants, shared once. They are not message/key
    // material and must not be erased when one independent context closes.
    private static readonly uint[] _round = new uint[] {
            0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,
            0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
            0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,
            0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
            0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,
            0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
            0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,
            0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
            0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,
            0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
            0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,
            0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
            0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,
            0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
            0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,
            0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
        };
    private bool _finished;
    private bool _closed;
    private int _error;

    public CorsacSecureCrypto_Hash()
    {
        _block = new byte[64];
        _state = new uint[8];
        _work = new uint[64];
        Initialize();
    }

    public int Error => _error;

    /// Reuses the allocated schedule after a successful Finish.  A failed
    /// context retains its stable error and must instead be closed.
    public bool Reset()
    {
        if (_closed || _error != 0) return false;
        EraseState();
        Initialize();
        return true;
    }

    public bool Update(byte[] buffer, long offset, long count)
    {
        if (_closed || _finished || _error != 0)
            return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(buffer, offset, count)
            || count > MaximumBytes - _total)
            return Fail(InvalidArgument);

        _total = _total + count;
        while (count > 0)
        {
            // The complete caller range was validated above. Full blocks
            // need no scratch copy in either the selected or scalar path;
            // only an unfinished block is assembled in private storage.
            if (_held == 0 && count >= 64)
            {
                Compress(buffer, (int)offset);
                offset = offset + 64;
                count = count - 64;
                continue;
            }
            int room = 64 - _held;
            int take = (int)(count < room ? count : room);
            CorsacSecureCrypto_Bytes.Copy(
                _block, _held, buffer, offset, take);
            _held = _held + take;
            offset = offset + take;
            count = count - take;
            if (_held == 64)
            {
                Compress(_block, 0);
                _held = 0;
            }
        }
        return true;
    }

    /// Finishes into caller storage.  Invalid output does not expose a partial
    /// digest and permanently records InvalidArgument on the context.
    public bool Finish(byte[] output, long outputOffset)
    {
        if (_closed || _finished || _error != 0)
            return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(output, outputOffset, 32))
            return Fail(InvalidArgument);

        _block[_held] = 0x80;
        _held = _held + 1;
        if (_held > 56)
        {
            CorsacSecureCrypto_Bytes.Zero(_block, _held, 64 - _held);
            Compress(_block, 0);
            CorsacSecureCrypto_Bytes.Zero(_block, 0, 56);
        }
        else
        {
            CorsacSecureCrypto_Bytes.Zero(_block, _held, 56 - _held);
        }

        long bits = _total << 3;
        for (int i = 0; i < 8; i = i + 1)
            _block[63 - i] = (byte)(LogicalRight(bits, i * 8) & 255);
        Compress(_block, 0);

        for (int word = 0; word < 8; word = word + 1)
        {
            for (int at = 0; at < 4; at = at + 1)
                output[(int)outputOffset + word * 4 + at] =
                    (byte)(LogicalRight(_state[word], (3 - at) * 8) & 255);
        }

        _finished = true;
        EraseState();
        return true;
    }

    public void Close()
    {
        if (_closed) return;
        EraseState();
        _closed = true;
        _finished = true;
    }

    private void Initialize()
    {
        _state[0] = 0x6a09e667; _state[1] = 0xbb67ae85;
        _state[2] = 0x3c6ef372; _state[3] = 0xa54ff53a;
        _state[4] = 0x510e527f; _state[5] = 0x9b05688c;
        _state[6] = 0x1f83d9ab; _state[7] = 0x5be0cd19;
        _held = 0;
        _total = 0;
        _finished = false;
    }

    private bool Fail(int error)
    {
        if (_error == 0) _error = error;
        return false;
    }

    private void EraseState()
    {
        CorsacSecureCrypto_Bytes.Zero(_block, 0, _block.Length);
        for (int i = 0; i < 8; i = i + 1) _state[i] = 0;
        for (int i = 0; i < 64; i = i + 1) _work[i] = 0;
        _held = 0;
        _total = 0;
    }

    // Every caller has validated one complete source block. Read-only source
    // bytes may be unaligned; both paths consume them without modifying them.
    private void Compress(byte[] block, int offset)
    {
        // (no hardware assist on this machine: the software path follows)
        for (int i = 0; i < 16; i = i + 1)
        {
            long value = 0;
            for (int at = 0; at < 4; at = at + 1)
                value = (value << 8) | (block[offset + i * 4 + at] & 255);
            _work[i] = (uint)value;
        }
        for (int i = 16; i < 64; i = i + 1)
        {
            long x = _work[i - 15], y = _work[i - 2];
            long s0 = RotateRight32(x, 7) ^ RotateRight32(x, 18)
                    ^ LogicalRight(x, 3);
            long s1 = RotateRight32(y, 17) ^ RotateRight32(y, 19)
                    ^ LogicalRight(y, 10);
            _work[i] = (uint)((_work[i - 16] + s0 + _work[i - 7] + s1)
                     & Mask32);
        }

        long a = _state[0], b = _state[1], c = _state[2], d = _state[3];
        long e = _state[4], f = _state[5], g = _state[6], h = _state[7];
        for (int i = 0; i < 64; i = i + 1)
        {
            long s1 = RotateRight32(e, 6) ^ RotateRight32(e, 11)
                    ^ RotateRight32(e, 25);
            long choose = (e & f) ^ ((~e) & g);
            long t1 = (h + s1 + choose + _round[i] + _work[i]) & Mask32;
            long s0 = RotateRight32(a, 2) ^ RotateRight32(a, 13)
                    ^ RotateRight32(a, 22);
            long majority = (a & b) ^ (a & c) ^ (b & c);
            long t2 = (s0 + majority) & Mask32;
            h = g; g = f; f = e; e = (d + t1) & Mask32;
            d = c; c = b; b = a; a = (t1 + t2) & Mask32;
        }
        _state[0] = (uint)((_state[0] + a) & Mask32);
        _state[1] = (uint)((_state[1] + b) & Mask32);
        _state[2] = (uint)((_state[2] + c) & Mask32);
        _state[3] = (uint)((_state[3] + d) & Mask32);
        _state[4] = (uint)((_state[4] + e) & Mask32);
        _state[5] = (uint)((_state[5] + f) & Mask32);
        _state[6] = (uint)((_state[6] + g) & Mask32);
        _state[7] = (uint)((_state[7] + h) & Mask32);
    }

    private static long LogicalRight(long value, int bits)
    {
        if (bits == 0) return value;
        return (value >> bits) & (0x7fffffffffffffff >> (bits - 1));
    }

    private static long RotateRight32(long value, int bits)
    {
        // ror.w operates on the low word and, as documented for narrow word
        // results, sign-extends that word back to the native register width.
        // Masking preserves SHA-256's unsigned 32-bit value in an Int64.
        return (((value & Mask32) >> bits) | ((value & Mask32) << (32 - bits))) & Mask32;
    }
}

/// A reusable streaming HMAC-SHA256 context.  Key material is copied at
/// construction and erased by Close; Update inputs are borrowed for the call.
public class CorsacSecureCrypto_Hmac
{
    private byte[] _innerPad;
    private byte[] _outerPad;
    private byte[] _innerDigest;
    private CorsacSecureCrypto_Hash _hash;
    private bool _active;
    private bool _closed;
    private int _error;

    public CorsacSecureCrypto_Hmac(byte[] key, long keyOffset, long keyCount)
    {
        _innerPad = new byte[64];
        _outerPad = new byte[64];
        _innerDigest = new byte[32];
        _hash = new CorsacSecureCrypto_Hash();

        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, keyCount))
        {
            _error = 1;
            return;
        }

        byte[] material = key;
        long materialOffset = keyOffset;
        int materialCount = (int)keyCount;
        byte[]? shortened = null;
        if (keyCount > 64)
        {
            shortened = new byte[32];
            if (!_hash.Update(key, keyOffset, keyCount)
                || !_hash.Finish(shortened, 0))
            {
                _error = _hash.Error;
                CorsacSecureCrypto_Bytes.Zero(shortened, 0, 32);
                return;
            }
            material = shortened;
            materialOffset = 0;
            materialCount = 32;
        }

        for (int i = 0; i < 64; i = i + 1)
        {
            int value = i < materialCount
                ? material[(int)materialOffset + i] : 0;
            _innerPad[i] = (byte)(value ^ 0x36);
            _outerPad[i] = (byte)(value ^ 0x5c);
        }
        if (shortened != null)
            CorsacSecureCrypto_Bytes.Zero(shortened, 0, 32);
    }

    public int Error => _error;

    public bool Start()
    {
        if (_closed || _error != 0) return false;
        if (_active) return Fail(9);
        if (!_hash.Reset() || !_hash.Update(_innerPad, 0, 64))
            return Fail(_hash.Error == 0 ? 9 : _hash.Error);
        _active = true;
        return true;
    }

    public bool Update(byte[] buffer, long offset, long count)
    {
        if (_closed || _error != 0) return false;
        if (!_active) return Fail(9);
        if (!_hash.Update(buffer, offset, count))
            return Fail(_hash.Error == 0 ? 1 : _hash.Error);
        return true;
    }

    public bool Finish(byte[] output, long outputOffset)
    {
        if (_closed || _error != 0) return false;
        if (!_active) return Fail(9);
        if (!CorsacSecureCrypto_Bytes.Range(output, outputOffset, 32))
            return Fail(1);

        if (!_hash.Finish(_innerDigest, 0)
            || !_hash.Reset()
            || !_hash.Update(_outerPad, 0, 64)
            || !_hash.Update(_innerDigest, 0, 32)
            || !_hash.Finish(output, outputOffset))
            return Fail(_hash.Error == 0 ? 9 : _hash.Error);

        CorsacSecureCrypto_Bytes.Zero(_innerDigest, 0, 32);
        _active = false;
        return true;
    }

    public void Close()
    {
        if (_closed) return;
        CorsacSecureCrypto_Bytes.Zero(_innerPad, 0, 64);
        CorsacSecureCrypto_Bytes.Zero(_outerPad, 0, 64);
        CorsacSecureCrypto_Bytes.Zero(_innerDigest, 0, 32);
        _hash.Close();
        _active = false;
        _closed = true;
    }

    public static bool Sha256(byte[] key, long keyOffset, long keyCount,
                              byte[] message, long messageOffset,
                              long messageCount,
                              byte[] output, long outputOffset)
    {
        CorsacSecureCrypto_Hmac hmac =
            new CorsacSecureCrypto_Hmac(key, keyOffset, keyCount);
        bool answer = hmac.Error == 0 && hmac.Start()
                   && hmac.Update(message, messageOffset, messageCount)
                   && hmac.Finish(output, outputOffset);
        hmac.Close();
        return answer;
    }

    private bool Fail(int error)
    {
        if (_error == 0) _error = error;
        return false;
    }
}

/// RFC 5869 HKDF-SHA256.  Expand computes into a bounded temporary result so
/// caller output may alias either borrowed input without corrupting later
/// rounds; no output is committed if a round fails.
public static class CorsacSecureCrypto_Hkdf
{
    public const int Sha256Bytes = 32;
    public const int MaximumSha256Output = 8160;

    public static bool Extract(byte[] salt, long saltOffset, long saltCount,
                               byte[] inputKeyMaterial, long inputOffset,
                               long inputCount,
                               byte[] output, long outputOffset)
    {
        if (!CorsacSecureCrypto_Bytes.Range(salt, saltOffset, saltCount)
            || !CorsacSecureCrypto_Bytes.Range(
                    inputKeyMaterial, inputOffset, inputCount)
            || !CorsacSecureCrypto_Bytes.Range(output, outputOffset, 32))
            return false;

        byte[]? zeroSalt = null;
        byte[] actualSalt = salt;
        long actualOffset = saltOffset;
        long actualCount = saltCount;
        if (saltCount == 0)
        {
            zeroSalt = new byte[32];
            actualSalt = zeroSalt;
            actualOffset = 0;
            actualCount = 32;
        }

        bool answer = CorsacSecureCrypto_Hmac.Sha256(
            actualSalt, actualOffset, actualCount,
            inputKeyMaterial, inputOffset, inputCount,
            output, outputOffset);
        if (zeroSalt != null)
            CorsacSecureCrypto_Bytes.Zero(zeroSalt, 0, 32);
        return answer;
    }

    public static bool Expand(byte[] pseudorandomKey, long keyOffset,
                              long keyCount, byte[] info, long infoOffset,
                              long infoCount, byte[] output,
                              long outputOffset, long outputCount)
    {
        // RFC 5869 section 2.3 requires a PRK of at least HashLen octets.
        // Check it even for an empty requested result; a valid buffer range
        // alone does not make a short or empty key a valid HKDF PRK.
        if (keyCount < Sha256Bytes
            || !CorsacSecureCrypto_Bytes.Range(
                    pseudorandomKey, keyOffset, keyCount)
            || !CorsacSecureCrypto_Bytes.Range(info, infoOffset, infoCount)
            || outputCount > MaximumSha256Output
            || !CorsacSecureCrypto_Bytes.Range(
                    output, outputOffset, outputCount))
            return false;
        if (outputCount == 0) return true;

        byte[] result = new byte[(int)outputCount];
        byte[] previous = new byte[32];
        byte[] counter = new byte[1];
        CorsacSecureCrypto_Hmac hmac = new CorsacSecureCrypto_Hmac(
            pseudorandomKey, keyOffset, keyCount);
        if (hmac.Error != 0)
        {
            hmac.Close();
            CorsacSecureCrypto_Bytes.Zero(result, 0, result.Length);
            CorsacSecureCrypto_Bytes.Zero(previous, 0, 32);
            return false;
        }

        long generated = 0;
        int block = 1;
        bool okay = true;
        while (generated < outputCount && okay)
        {
            counter[0] = (byte)block;
            okay = hmac.Start();
            if (okay && block > 1) okay = hmac.Update(previous, 0, 32);
            if (okay) okay = hmac.Update(info, infoOffset, infoCount);
            if (okay) okay = hmac.Update(counter, 0, 1);
            if (okay) okay = hmac.Finish(previous, 0);
            if (okay)
            {
                int take = (int)(outputCount - generated < 32
                    ? outputCount - generated : 32);
                okay = CorsacSecureCrypto_Bytes.Copy(
                    result, generated, previous, 0, take);
                generated = generated + take;
            }
            block = block + 1;
        }

        if (okay)
            okay = CorsacSecureCrypto_Bytes.Copy(
                output, outputOffset, result, 0, outputCount);
        hmac.Close();
        CorsacSecureCrypto_Bytes.Zero(result, 0, result.Length);
        CorsacSecureCrypto_Bytes.Zero(previous, 0, 32);
        CorsacSecureCrypto_Bytes.Zero(counter, 0, 1);
        return okay;
    }
}
