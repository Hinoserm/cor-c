// CORSAC/SECURE Crypto Poly1305, with a per-block optional CPU assist.
//
// Binary keys, messages and tags are byte arrays.  Five 26-bit limbs in
// 32-bit words, poly1305-donna-32's way: after a block h0, h2, h3 and h4 are
// below 2^26 and h1 at most 2^26 + 37, so every limb, and r*5, fits a UInt32,
// and each product is one 32x32->64 multiply; with the clamped r masks every
// five-term product/carry sum is below 2^57.  The limbs were Int64: every
// product a full 64x64 multiply and every add two, on a 32-bit processor --
// with ChaCha20, two fifths of the processor at 9 MB/s of SSH.

/// A single-use streaming Poly1305 context.  The 32-byte one-time key is
/// copied into private numeric state at construction and erased by Finish,
/// Verify or Close.  There is intentionally no Reset: reusing a Poly1305 key
/// is cryptographically unsound.

namespace Corsac.Security.Cryptography;

public class CorsacSecureCrypto_Poly1305
{
    public const int KeyBytes = 32;
    public const int TagBytes = 16;
    public const int InvalidArgument = 1;
    public const int AuthenticationFailure = 4;
    public const int ProtocolState = 9;

    private const long LimbMask = 0x3ffffff;
    private const long WordMask = 0xffffffffL;

    private byte[] _block;
    private int _held;

    private uint _r0;
    private uint _r1;
    private uint _r2;
    private uint _r3;
    private uint _r4;
    private uint _s1;
    private uint _s2;
    private uint _s3;
    private uint _s4;

    private uint _h0;
    private uint _h1;
    private uint _h2;
    private uint _h3;
    private uint _h4;

    private long _pad0;
    private long _pad1;
    private long _pad2;
    private long _pad3;

    private bool _finished;
    private bool _closed;
    private int _error;

    public CorsacSecureCrypto_Poly1305(byte[] key, long keyOffset)
    {
        // Keep the published object's field layout intact. The existing
        // private byte buffer holds 16 pending message bytes, room for a
        // 32-byte-aligned 24-byte accumulator, and clamped r at offset 72.
        // The accumulator never crosses a 64-byte cache line. Keep r at a
        // fixed array offset: relocating an array must not change its key
        // layout. No per-block allocation; all 96 bytes are erased on close.
        _block = new byte[96];
        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, KeyBytes))
        {
            _error = InvalidArgument;
            return;
        }

        // These overlapping loads are the 0ffffffc0ffffffc0ffffffc0fffffff
        // clamp expressed directly in radix 2^26.  No unclamped copy of r is
        // retained by the context.
        _r0 = (uint)Load32(key, keyOffset) & 0x3ffffff;
        _r1 = (uint)(Load32(key, keyOffset + 3) >> 2) & 0x3ffff03;
        _r2 = (uint)(Load32(key, keyOffset + 6) >> 4) & 0x3ffc0ff;
        _r3 = (uint)(Load32(key, keyOffset + 9) >> 6) & 0x3f03fff;
        _r4 = (uint)(Load32(key, keyOffset + 12) >> 8) & 0x00fffff;
        _s1 = _r1 * 5;
        _s2 = _r2 * 5;
        _s3 = _r3 * 5;
        _s4 = _r4 * 5;

        _pad0 = Load32(key, keyOffset + 16);
        _pad1 = Load32(key, keyOffset + 20);
        _pad2 = Load32(key, keyOffset + 24);
        _pad3 = Load32(key, keyOffset + 28);
    }

    public int Error => _error;

    /// Borrows message bytes only until this call returns.  The amount of
    /// work depends on the public byte count, and no branch on message or
    /// key values; the 32x32 multiplies are fixed-time on a Pentium and
    /// later, but a 486's MUL may take longer for some operands.
    public bool Update(byte[] message, long messageOffset, long messageCount)
    {
        if (_closed || _finished || _error != 0)
            return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(
                message, messageOffset, messageCount))
            return Fail(InvalidArgument);

        if (_held != 0 && messageCount != 0)
        {
            int room = 16 - _held;
            int take = (int)(messageCount < room ? messageCount : room);
            CorsacSecureCrypto_Bytes.Copy(
                _block, _held, message, messageOffset, take);
            _held = _held + take;
            messageOffset = messageOffset + take;
            messageCount = messageCount - take;
            if (_held == 16)
            {
                ProcessBlock(_block, 0, true);
                _held = 0;
            }
        }

        while (messageCount >= 16)
        {
            ProcessBlock(message, messageOffset, true);
            messageOffset = messageOffset + 16;
            messageCount = messageCount - 16;
        }

        if (messageCount != 0)
        {
            CorsacSecureCrypto_Bytes.Copy(
                _block, 0, message, messageOffset, messageCount);
            _held = (int)messageCount;
        }
        return true;
    }

    /// Commits exactly one 16-byte tag after the complete output range has
    /// been validated.  The temporary prevents a future internal failure from
    /// ever exposing a partial caller-visible tag.
    public bool Finish(byte[] output, long outputOffset)
    {
        if (_closed || _finished || _error != 0)
            return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(
                output, outputOffset, TagBytes))
            return Fail(InvalidArgument);

        byte[] tag = new byte[TagBytes];
        Complete(tag);
        bool copied = CorsacSecureCrypto_Bytes.Copy(
            output, outputOffset, tag, 0, TagBytes);
        CorsacSecureCrypto_Bytes.Zero(tag, 0, TagBytes);
        return copied;
    }

    /// Finishes and compares all 16 bytes.  A mismatch is recorded as the
    /// common authentication-failure class only after the fixed-work compare.
    public bool Verify(byte[] expected, long expectedOffset)
    {
        if (_closed || _finished || _error != 0)
            return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(
                expected, expectedOffset, TagBytes))
            return Fail(InvalidArgument);

        byte[] actual = new byte[TagBytes];
        Complete(actual);
        bool matches = CorsacSecureCrypto_Bytes.Equal(
            actual, 0, expected, expectedOffset, TagBytes);
        CorsacSecureCrypto_Bytes.Zero(actual, 0, TagBytes);
        if (!matches) return Fail(AuthenticationFailure);
        return true;
    }

    public void Close()
    {
        if (_closed) return;
        EraseState();
        _finished = true;
        _closed = true;
    }

    /// One-shot authentication.  Key and message may alias output: every
    /// input is consumed before the result is committed.
    public static bool Authenticate(
        byte[] key, long keyOffset,
        byte[] message, long messageOffset, long messageCount,
        byte[] output, long outputOffset)
    {
        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, KeyBytes)
            || !CorsacSecureCrypto_Bytes.Range(
                    message, messageOffset, messageCount)
            || !CorsacSecureCrypto_Bytes.Range(
                    output, outputOffset, TagBytes))
            return false;

        CorsacSecureCrypto_Poly1305 context =
            new CorsacSecureCrypto_Poly1305(key, keyOffset);
        bool okay = context.Error == 0
                 && context.Update(message, messageOffset, messageCount)
                 && context.Finish(output, outputOffset);
        context.Close();
        return okay;
    }

    /// One-shot authentication and fixed-work tag comparison.
    public static bool Verify(
        byte[] key, long keyOffset,
        byte[] message, long messageOffset, long messageCount,
        byte[] expected, long expectedOffset)
    {
        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, KeyBytes)
            || !CorsacSecureCrypto_Bytes.Range(
                    message, messageOffset, messageCount)
            || !CorsacSecureCrypto_Bytes.Range(
                    expected, expectedOffset, TagBytes))
            return false;

        CorsacSecureCrypto_Poly1305 context =
            new CorsacSecureCrypto_Poly1305(key, keyOffset);
        bool okay = context.Error == 0
                 && context.Update(message, messageOffset, messageCount)
                 && context.Verify(expected, expectedOffset);
        context.Close();
        return okay;
    }

    private bool Fail(int error)
    {
        if (_error == 0) _error = error;
        return false;
    }

    private void Complete(byte[] tag)
    {
        if (_held != 0)
        {
            // The RFC's mandatory one bit is the byte 0x01 immediately after
            // the partial message, followed by zero padding to 16 bytes.
            _block[_held] = 1;
            CorsacSecureCrypto_Bytes.Zero(
                _block, _held + 1, 15 - _held);
            ProcessBlock(_block, 0, false);
        }

        FinalReduce();
        WriteTag(tag);
        _finished = true;
        EraseState();
    }

    private void ProcessBlock(byte[] block, long offset, bool complete)
    {
        // The block's four words read whole: Update checked the range, and
        // the processor takes them in any alignment.
        nuint at = Sys.ArrayData(block) + (nuint)offset;
        uint t0 = Sys.Read32(at), t1 = Sys.Read32(at + 4);
        uint t2 = Sys.Read32(at + 8), t3 = Sys.Read32(at + 12);
        uint h0 = _h0 + (t0 & 0x3ffffff);
        uint h1 = _h1 + (((t0 >> 26) | (t1 << 6)) & 0x3ffffff);
        uint h2 = _h2 + (((t1 >> 20) | (t2 << 12)) & 0x3ffffff);
        uint h3 = _h3 + (((t2 >> 14) | (t3 << 18)) & 0x3ffffff);
        uint h4 = _h4 + ((t3 >> 8) | (complete ? 0x1000000u : 0u));
        uint r0 = _r0, r1 = _r1, r2 = _r2, r3 = _r3, r4 = _r4;
        uint s1 = _s1, s2 = _s2, s3 = _s3, s4 = _s4;

        // At entry to the products, h0..h3 are at most about 2^27 and h4 is
        // below 3*2^25.  Clamping makes the largest sum d0 < 2^57; the other
        // sums and all propagated carries are smaller.
        ulong d0 = (ulong)h0 * r0 + (ulong)h1 * s4 + (ulong)h2 * s3 + (ulong)h3 * s2 + (ulong)h4 * s1;
        ulong d1 = (ulong)h0 * r1 + (ulong)h1 * r0 + (ulong)h2 * s4 + (ulong)h3 * s3 + (ulong)h4 * s2;
        ulong d2 = (ulong)h0 * r2 + (ulong)h1 * r1 + (ulong)h2 * r0 + (ulong)h3 * s4 + (ulong)h4 * s3;
        ulong d3 = (ulong)h0 * r3 + (ulong)h1 * r2 + (ulong)h2 * r1 + (ulong)h3 * r0 + (ulong)h4 * s4;
        ulong d4 = (ulong)h0 * r4 + (ulong)h1 * r3 + (ulong)h2 * r2 + (ulong)h3 * r1 + (ulong)h4 * r0;

        uint carry = (uint)(d0 >> 26);
        h0 = (uint)d0 & 0x3ffffff;
        d1 = d1 + carry;
        carry = (uint)(d1 >> 26);
        h1 = (uint)d1 & 0x3ffffff;
        d2 = d2 + carry;
        carry = (uint)(d2 >> 26);
        h2 = (uint)d2 & 0x3ffffff;
        d3 = d3 + carry;
        carry = (uint)(d3 >> 26);
        h3 = (uint)d3 & 0x3ffffff;
        d4 = d4 + carry;
        carry = (uint)(d4 >> 26);
        h4 = (uint)d4 & 0x3ffffff;
        h0 = h0 + carry * 5;
        carry = h0 >> 26;
        h0 = h0 & 0x3ffffff;
        h1 = h1 + carry;
        _h0 = h0; _h1 = h1; _h2 = h2; _h3 = h3; _h4 = h4;
    }

    private void FinalReduce()
    {
        long h0 = _h0, h1 = _h1, h2 = _h2, h3 = _h3, h4 = _h4;
        // Propagate once through every limb.  The post-block bounds make every
        // carry here at most one except the already-folded 5*h carry.
        long carry = h1 >> 26;
        h1 = h1 & LimbMask;
        h2 = h2 + carry;
        carry = h2 >> 26;
        h2 = h2 & LimbMask;
        h3 = h3 + carry;
        carry = h3 >> 26;
        h3 = h3 & LimbMask;
        h4 = h4 + carry;
        carry = h4 >> 26;
        h4 = h4 & LimbMask;
        h0 = h0 + carry * 5;
        carry = h0 >> 26;
        h0 = h0 & LimbMask;
        h1 = h1 + carry;

        // g = h + 5 - 2^130.  g4 is nonnegative exactly when h >= p.
        // ConstantTimeSelect is a branch-free mask operation both in the
        // Crypto-unit instruction and in the compiler's portable fallback.
        long g0 = h0 + 5;
        carry = g0 >> 26;
        g0 = g0 & LimbMask;
        long g1 = h1 + carry;
        carry = g1 >> 26;
        g1 = g1 & LimbMask;
        long g2 = h2 + carry;
        carry = g2 >> 26;
        g2 = g2 & LimbMask;
        long g3 = h3 + carry;
        carry = g3 >> 26;
        g3 = g3 & LimbMask;
        long g4 = h4 + carry - 0x4000000;
        bool useReduced = g4 >= 0;

        h0 = CorsacSecureCrypto_Bytes.Select(g0, h0, useReduced);
        h1 = CorsacSecureCrypto_Bytes.Select(g1, h1, useReduced);
        h2 = CorsacSecureCrypto_Bytes.Select(g2, h2, useReduced);
        h3 = CorsacSecureCrypto_Bytes.Select(g3, h3, useReduced);
        h4 = CorsacSecureCrypto_Bytes.Select(g4, h4, useReduced);
        _h0 = (uint)h0; _h1 = (uint)h1; _h2 = (uint)h2; _h3 = (uint)h3; _h4 = (uint)h4;
    }

    private void WriteTag(byte[] tag)
    {
        long h0 = _h0, h1 = _h1, h2 = _h2, h3 = _h3, h4 = _h4;
        long f0 = (h0 | (h1 << 26)) & WordMask;
        long f1 = ((h1 >> 6) | (h2 << 20)) & WordMask;
        long f2 = ((h2 >> 12) | (h3 << 14)) & WordMask;
        long f3 = ((h3 >> 18) | (h4 << 8)) & WordMask;

        f0 = f0 + _pad0;
        f1 = f1 + _pad1 + (f0 >> 32);
        f0 = f0 & WordMask;
        f2 = f2 + _pad2 + (f1 >> 32);
        f1 = f1 & WordMask;
        f3 = f3 + _pad3 + (f2 >> 32);
        f2 = f2 & WordMask;
        f3 = f3 & WordMask;

        Store32(tag, 0, f0);
        Store32(tag, 4, f1);
        Store32(tag, 8, f2);
        Store32(tag, 12, f3);
    }

    private void EraseState()
    {
        CorsacSecureCrypto_Bytes.Zero(_block, 0, _block.Length);
        _held = 0;
        _r0 = 0; _r1 = 0; _r2 = 0; _r3 = 0; _r4 = 0;
        _s1 = 0; _s2 = 0; _s3 = 0; _s4 = 0;
        _h0 = 0; _h1 = 0; _h2 = 0; _h3 = 0; _h4 = 0;
        _pad0 = 0; _pad1 = 0; _pad2 = 0; _pad3 = 0;
    }

    private static long Load32(byte[] bytes, long offset)
    {
        long value = 0;
        for (int i = 0; i < 4; i = i + 1)
            value = value
                | (((long)bytes[(int)(offset + i)] & 255) << (i * 8));
        return value;
    }

    private static void Store32(byte[] bytes, int offset, long value)
    {
        for (int i = 0; i < 4; i = i + 1)
        {
            bytes[offset + i] = (byte)(value & 255);
            value = value >> 8;
        }
    }
}
