// CORSAC/SECURE Crypto portable RFC 8439 ChaCha20.
//
// Keys, nonces, input and output are octet buffers. The established public
// ABI carries its checked unsigned 32-bit counter range in a long.
// Private state is sixteen uint words, directly usable by ChaCha20Block.w;
// each block discovers the assist, with the same scalar fallback if absent.
// Both operations validate every caller range before writing any output.

namespace Corsac.Security.Cryptography;

public static class CorsacSecureCrypto_ChaCha20
{
    private const long Mask32 = 0xffffffffL;
    private const long CounterLimit = 0x100000000L;

    /// Produces one RFC 8439 ChaCha20 block.  Caller buffers may alias in any
    /// arrangement: the complete block is made privately before it is copied
    /// to output.
    public static bool Block(byte[] key, long keyOffset, long counter,
                             byte[] nonce, long nonceOffset,
                             byte[] output, long outputOffset)
    {
        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, 32)
            || !CorsacSecureCrypto_Bytes.Range(nonce, nonceOffset, 12)
            || !CorsacSecureCrypto_Bytes.Range(output, outputOffset, 64)
            || counter < 0 || counter > Mask32)
            return false;

        byte[] block = new byte[64];
        uint[] state = new uint[16];
        long[] work = new long[16];
        Initialize(key, keyOffset, nonce, nonceOffset, state);
        Generate(state, counter, work, block);
        bool okay = CorsacSecureCrypto_Bytes.Copy(
            output, outputOffset, block, 0, 64);
        CorsacSecureCrypto_Bytes.Zero(block, 0, block.Length);
        EraseWords(state);
        EraseWords(work);
        return okay;
    }

    private static void Initialize(byte[] key, long keyOffset,
                                   byte[] nonce, long nonceOffset,
                                   uint[] state)
    {
        state[0] = 0x61707865;
        state[1] = 0x3320646e;
        state[2] = 0x79622d32;
        state[3] = 0x6b206574;
        for (int i = 0; i < 8; i = i + 1)
            state[4 + i] = (uint)ReadLittleWord(key, keyOffset + i * 4);
        for (int i = 0; i < 3; i = i + 1)
            state[13 + i] = (uint)ReadLittleWord(nonce, nonceOffset + i * 4);
    }

    private static void Generate(uint[] state, long counter,
                                 long[] work, byte[] output)
    {
        state[12] = (uint)counter;
        // (no hardware assist on this machine: the software path follows)
        for (int i = 0; i < 16; i = i + 1) work[i] = state[i];
        for (int round = 0; round < 10; round = round + 1)
        {
            QuarterRound(work, 0, 4, 8, 12);
            QuarterRound(work, 1, 5, 9, 13);
            QuarterRound(work, 2, 6, 10, 14);
            QuarterRound(work, 3, 7, 11, 15);
            QuarterRound(work, 0, 5, 10, 15);
            QuarterRound(work, 1, 6, 11, 12);
            QuarterRound(work, 2, 7, 8, 13);
            QuarterRound(work, 3, 4, 9, 14);
        }

        for (int i = 0; i < 16; i = i + 1)
        {
            long word = (work[i] + state[i]) & Mask32;
            int at = i * 4;
            output[at] = (byte)(word & 255);
            output[at + 1] = (byte)((word >> 8) & 255);
            output[at + 2] = (byte)((word >> 16) & 255);
            output[at + 3] = (byte)((word >> 24) & 255);
        }
    }

    private static void EraseWords(long[] words)
    {
        for (int i = 0; i < words.Length; i = i + 1) words[i] = 0;
    }

    private static void EraseWords(uint[] words)
    {
        for (int i = 0; i < words.Length; i = i + 1) words[i] = 0;
    }

    private static long ReadLittleWord(byte[] bytes, long offset)
    {
        int at = (int)offset;
        return ((long)bytes[at] & 255)
             | (((long)bytes[at + 1] & 255) << 8)
             | (((long)bytes[at + 2] & 255) << 16)
             | (((long)bytes[at + 3] & 255) << 24);
    }

    private static void QuarterRound(long[] words,
                                     int ai, int bi, int ci, int di)
    {
        long a = words[ai], b = words[bi];
        long c = words[ci], d = words[di];

        a = (a + b) & Mask32;
        d = RotateLeft32((d ^ a) & Mask32, 16);
        c = (c + d) & Mask32;
        b = RotateLeft32((b ^ c) & Mask32, 12);
        a = (a + b) & Mask32;
        d = RotateLeft32((d ^ a) & Mask32, 8);
        c = (c + d) & Mask32;
        b = RotateLeft32((b ^ c) & Mask32, 7);

        words[ai] = a;
        words[bi] = b;
        words[ci] = c;
        words[di] = d;
    }

    private static long RotateLeft32(long value, int bits)
    {
        // rol.w sign-extends its narrow result.  The mask restores the RFC's
        // unsigned 32-bit word after using the native rotate fast path.
        return (((value & Mask32) << bits) | ((value & Mask32) >> (32 - bits))) & Mask32;
    }
}

/// A reusable ChaCha20 workspace for long-lived protocol connections.  The
/// key schedule and fixed scratch arrays are allocated once; Block and Xor do
/// not allocate.  Exact in-place XOR is supported, while partial overlap is
/// rejected so a caller never receives silently order-dependent output.
public class CorsacSecureCrypto_ChaCha20Context
{
    public const int InvalidArgument = 1;
    public const int ProtocolState = 9;

    private const long Mask32 = 0xffffffffL;
    private const long CounterLimit = 0x100000000L;

    private uint[] _state;
    private uint[] _keystream;
    // Generate4's: the state with each word four times over, one for each
    // block (word 12, the counter, c to c + 3), and its keystream in the
    // same layout.
    private uint[] _broad;
    private uint[] _keystream4;
    private byte[] _block;
    private bool _closed;
    private int _error;

    public CorsacSecureCrypto_ChaCha20Context(byte[] key, long keyOffset)
    {
        _state = new uint[16];
        _keystream = new uint[16];
        _broad = new uint[64];
        _keystream4 = new uint[64];
        _block = new byte[64];
        if (!CorsacSecureCrypto_Bytes.Range(key, keyOffset, 32))
        {
            _error = InvalidArgument;
            return;
        }

        _state[0] = 0x61707865;
        _state[1] = 0x3320646e;
        _state[2] = 0x79622d32;
        _state[3] = 0x6b206574;
        for (int i = 0; i < 8; i = i + 1)
            _state[4 + i] = (uint)ReadLittleWord(key, keyOffset + i * 4);
        for (int i = 0; i < 12; i = i + 1) Broadcast(i);
    }

    private void Broadcast(int word)
    {
        uint value = _state[word];
        for (int lane = 0; lane < 4; lane = lane + 1) _broad[word * 4 + lane] = value;
    }

    public int Error => _error;

    public bool Block(long counter, byte[] nonce, long nonceOffset,
                      byte[] output, long outputOffset)
    {
        if (!Ready()) return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(nonce, nonceOffset, 12)
            || !CorsacSecureCrypto_Bytes.Range(output, outputOffset, 64)
            || counter < 0 || counter > Mask32)
            return Fail(InvalidArgument);

        SetNonce(nonce, nonceOffset);
        Generate(counter);
        KeystreamBytes();
        bool okay = CorsacSecureCrypto_Bytes.Copy(
            output, outputOffset, _block, 0, 64);
        EraseBlock();
        return okay;
    }

    public bool Xor(long counter, byte[] nonce, long nonceOffset,
                    byte[] input, long inputOffset,
                    byte[] output, long outputOffset, long count)
    {
        if (!Ready()) return Fail(ProtocolState);
        if (!CorsacSecureCrypto_Bytes.Range(nonce, nonceOffset, 12)
            || !CorsacSecureCrypto_Bytes.Range(input, inputOffset, count)
            || !CorsacSecureCrypto_Bytes.Range(output, outputOffset, count)
            || !CounterRange(counter, count)
            || PartialOverlap(input, inputOffset, output, outputOffset, count))
            return Fail(InvalidArgument);
        if (count == 0) return true;

        SetNonce(nonce, nonceOffset);
        long done = 0;
        long blockCounter = counter;
        // Four blocks at a time while four whole ones are left, each block's
        // words out of the vertical keystream (Generate4).
        while (count - done >= 256 && Generate4(blockCounter))
        {
            uint[] k4 = _keystream4;
            nuint into = Sys.ArrayData(output) + (nuint)(outputOffset + done), from = Sys.ArrayData(input) + (nuint)(inputOffset + done);
            for (int blk = 0; blk < 4; blk = blk + 1)
            {
                nuint o = into + (nuint)(blk * 64), n = from + (nuint)(blk * 64);
                for (int w = 0; w < 16; w = w + 1)
                    Sys.Write32(o + (nuint)(w * 4), Sys.Read32(n + (nuint)(w * 4)) ^ k4[w * 4 + blk]);
            }
            done = done + 256;
            blockCounter = blockCounter + 4;
        }
        while (done < count)
        {
            Generate(blockCounter);
            int take = (int)(count - done < 64 ? count - done : 64);
            int o = (int)(outputOffset + done), n = (int)(inputOffset + done);
            uint[] k = _keystream;
            int i = 0;
            // A WORD AT A TIME, read and written whole: both ranges were
            // checked above, and the keystream is little-endian words as
            // the input's bytes are (a byte at a time, each one checked,
            // was a third of the cipher's time).
            nuint into = Sys.ArrayData(output) + (nuint)o, from = Sys.ArrayData(input) + (nuint)n;
            for (; i + 4 <= take; i = i + 4)
                Sys.Write32(into + (nuint)i, Sys.Read32(from + (nuint)i) ^ k[i >> 2]);
            for (; i < take; i = i + 1)
                output[o + i] = (byte)(input[n + i] ^ (k[i >> 2] >> ((i & 3) * 8)));
            done = done + take;
            blockCounter = blockCounter + 1;
        }
        EraseBlock();
        return true;
    }

    public void Close()
    {
        if (_closed) return;
        for (int i = 0; i < _state.Length; i = i + 1) _state[i] = 0;
        for (int i = 0; i < _keystream.Length; i = i + 1) _keystream[i] = 0;
        for (int i = 0; i < _broad.Length; i = i + 1) _broad[i] = 0;
        EraseBlock();
        _closed = true;
    }

    private bool Ready()
    {
        return !_closed && _error == 0;
    }

    private bool Fail(int error)
    {
        if (_error == 0) _error = error;
        return false;
    }

    private static bool PartialOverlap(
        byte[] input, long inputOffset,
        byte[] output, long outputOffset, long count)
    {
        if (count == 0 || Sys.Word(input) != Sys.Word(output)
            || inputOffset == outputOffset) return false;
        return inputOffset < outputOffset + count
            && outputOffset < inputOffset + count;
    }

    private static bool CounterRange(long counter, long count)
    {
        if (counter < 0 || counter > Mask32 || count < 0) return false;
        if (count == 0) return true;
        long blocks = ((count - 1) / 64) + 1;
        return counter <= CounterLimit - blocks;
    }

    private void SetNonce(byte[] nonce, long nonceOffset)
    {
        for (int i = 0; i < 3; i = i + 1)
        {
            _state[13 + i] = (uint)ReadLittleWord(nonce, nonceOffset + i * 4);
            Broadcast(13 + i);
        }
    }

    /// THE BLOCK FUNCTION IN 32-BIT WORDS, as ChaCha20 is defined: sixteen
    /// UInt32 locals, rotations of 32 bits, the keystream left in words
    /// (_keystream). It was written in Int64 with a mask after every add and
    /// rotation, through the work array at every quarter round -- on a 32-bit
    /// processor each operation two or three, and SSH's cipher took a fifth
    /// of the processor generating keystream at 9 MB/s.
    private void Generate(long counter)
    {
        uint[] st = _state;
        st[12] = (uint)counter;
        uint x0 = st[0];
        uint x1 = st[1];
        uint x2 = st[2];
        uint x3 = st[3];
        uint x4 = st[4];
        uint x5 = st[5];
        uint x6 = st[6];
        uint x7 = st[7];
        uint x8 = st[8];
        uint x9 = st[9];
        uint x10 = st[10];
        uint x11 = st[11];
        uint x12 = st[12];
        uint x13 = st[13];
        uint x14 = st[14];
        uint x15 = st[15];
        for (int round = 0; round < 10; round = round + 1)
        {
            x0 += x4; x12 = Rotate(x12 ^ x0, 16); x8 += x12; x4 = Rotate(x4 ^ x8, 12);
            x0 += x4; x12 = Rotate(x12 ^ x0, 8); x8 += x12; x4 = Rotate(x4 ^ x8, 7);
            x1 += x5; x13 = Rotate(x13 ^ x1, 16); x9 += x13; x5 = Rotate(x5 ^ x9, 12);
            x1 += x5; x13 = Rotate(x13 ^ x1, 8); x9 += x13; x5 = Rotate(x5 ^ x9, 7);
            x2 += x6; x14 = Rotate(x14 ^ x2, 16); x10 += x14; x6 = Rotate(x6 ^ x10, 12);
            x2 += x6; x14 = Rotate(x14 ^ x2, 8); x10 += x14; x6 = Rotate(x6 ^ x10, 7);
            x3 += x7; x15 = Rotate(x15 ^ x3, 16); x11 += x15; x7 = Rotate(x7 ^ x11, 12);
            x3 += x7; x15 = Rotate(x15 ^ x3, 8); x11 += x15; x7 = Rotate(x7 ^ x11, 7);
            x0 += x5; x15 = Rotate(x15 ^ x0, 16); x10 += x15; x5 = Rotate(x5 ^ x10, 12);
            x0 += x5; x15 = Rotate(x15 ^ x0, 8); x10 += x15; x5 = Rotate(x5 ^ x10, 7);
            x1 += x6; x12 = Rotate(x12 ^ x1, 16); x11 += x12; x6 = Rotate(x6 ^ x11, 12);
            x1 += x6; x12 = Rotate(x12 ^ x1, 8); x11 += x12; x6 = Rotate(x6 ^ x11, 7);
            x2 += x7; x13 = Rotate(x13 ^ x2, 16); x8 += x13; x7 = Rotate(x7 ^ x8, 12);
            x2 += x7; x13 = Rotate(x13 ^ x2, 8); x8 += x13; x7 = Rotate(x7 ^ x8, 7);
            x3 += x4; x14 = Rotate(x14 ^ x3, 16); x9 += x14; x4 = Rotate(x4 ^ x9, 12);
            x3 += x4; x14 = Rotate(x14 ^ x3, 8); x9 += x14; x4 = Rotate(x4 ^ x9, 7);
        }
        uint[] k = _keystream;
        k[0] = x0 + st[0];
        k[1] = x1 + st[1];
        k[2] = x2 + st[2];
        k[3] = x3 + st[3];
        k[4] = x4 + st[4];
        k[5] = x5 + st[5];
        k[6] = x6 + st[6];
        k[7] = x7 + st[7];
        k[8] = x8 + st[8];
        k[9] = x9 + st[9];
        k[10] = x10 + st[10];
        k[11] = x11 + st[11];
        k[12] = x12 + st[12];
        k[13] = x13 + st[13];
        k[14] = x14 + st[14];
        k[15] = x15 + st[15];
    }

    /// FOUR BLOCKS AT ONCE, with SSE2 (OpenSSL's and libsodium's layout):
    /// each vector one word of the state in four consecutive blocks --
    /// counters c to c + 3 -- so a quarter round is the same on whole
    /// vectors, column by column and then diagonal by diagonal, nothing
    /// shuffled inside the rounds, and every instruction four blocks' work.
    /// One block's rows in four vectors made every step wait for the one
    /// before, with a shuffle on the chain at each diagonal: slower than the
    /// scalar block on the K8. The keystream is left in the same layout
    /// (_keystream4[word * 4 + block]), which Xor reads straight. False
    /// without SSE2, where Xor goes on a block at a time.
    private bool Generate4(long counter)
    {
        if ((Packed.Features() & 0x20) == 0) return false;
        uint[] b = _broad;
        uint c = (uint)counter;
        b[48] = c; b[49] = c + 1; b[50] = c + 2; b[51] = c + 3;
        nuint s = Sys.ArrayData(b), k = Sys.ArrayData(_keystream4);
        {
            Packed128 x0 = Packed.Load128(s + 0);
            Packed128 x1 = Packed.Load128(s + 16);
            Packed128 x2 = Packed.Load128(s + 32);
            Packed128 x3 = Packed.Load128(s + 48);
            Packed128 x4 = Packed.Load128(s + 64);
            Packed128 x5 = Packed.Load128(s + 80);
            Packed128 x6 = Packed.Load128(s + 96);
            Packed128 x7 = Packed.Load128(s + 112);
            Packed128 x8 = Packed.Load128(s + 128);
            Packed128 x9 = Packed.Load128(s + 144);
            Packed128 x10 = Packed.Load128(s + 160);
            Packed128 x11 = Packed.Load128(s + 176);
            Packed128 x12 = Packed.Load128(s + 192);
            Packed128 x13 = Packed.Load128(s + 208);
            Packed128 x14 = Packed.Load128(s + 224);
            Packed128 x15 = Packed.Load128(s + 240);
            for (int round = 0; round < 10; round = round + 1)
            {
                x0 = Packed.Add32(x0, x4); x12 = Packed.Xor(x12, x0); x12 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x12, 0xB1), 0xB1);
                x8 = Packed.Add32(x8, x12); x4 = Packed.Xor(x4, x8); x4 = Packed.Or(Packed.ShiftLeft32(x4, 12), Packed.ShiftRightU32(x4, 20));
                x0 = Packed.Add32(x0, x4); x12 = Packed.Xor(x12, x0); x12 = Packed.Or(Packed.ShiftLeft32(x12, 8), Packed.ShiftRightU32(x12, 24));
                x8 = Packed.Add32(x8, x12); x4 = Packed.Xor(x4, x8); x4 = Packed.Or(Packed.ShiftLeft32(x4, 7), Packed.ShiftRightU32(x4, 25));
                x1 = Packed.Add32(x1, x5); x13 = Packed.Xor(x13, x1); x13 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x13, 0xB1), 0xB1);
                x9 = Packed.Add32(x9, x13); x5 = Packed.Xor(x5, x9); x5 = Packed.Or(Packed.ShiftLeft32(x5, 12), Packed.ShiftRightU32(x5, 20));
                x1 = Packed.Add32(x1, x5); x13 = Packed.Xor(x13, x1); x13 = Packed.Or(Packed.ShiftLeft32(x13, 8), Packed.ShiftRightU32(x13, 24));
                x9 = Packed.Add32(x9, x13); x5 = Packed.Xor(x5, x9); x5 = Packed.Or(Packed.ShiftLeft32(x5, 7), Packed.ShiftRightU32(x5, 25));
                x2 = Packed.Add32(x2, x6); x14 = Packed.Xor(x14, x2); x14 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x14, 0xB1), 0xB1);
                x10 = Packed.Add32(x10, x14); x6 = Packed.Xor(x6, x10); x6 = Packed.Or(Packed.ShiftLeft32(x6, 12), Packed.ShiftRightU32(x6, 20));
                x2 = Packed.Add32(x2, x6); x14 = Packed.Xor(x14, x2); x14 = Packed.Or(Packed.ShiftLeft32(x14, 8), Packed.ShiftRightU32(x14, 24));
                x10 = Packed.Add32(x10, x14); x6 = Packed.Xor(x6, x10); x6 = Packed.Or(Packed.ShiftLeft32(x6, 7), Packed.ShiftRightU32(x6, 25));
                x3 = Packed.Add32(x3, x7); x15 = Packed.Xor(x15, x3); x15 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x15, 0xB1), 0xB1);
                x11 = Packed.Add32(x11, x15); x7 = Packed.Xor(x7, x11); x7 = Packed.Or(Packed.ShiftLeft32(x7, 12), Packed.ShiftRightU32(x7, 20));
                x3 = Packed.Add32(x3, x7); x15 = Packed.Xor(x15, x3); x15 = Packed.Or(Packed.ShiftLeft32(x15, 8), Packed.ShiftRightU32(x15, 24));
                x11 = Packed.Add32(x11, x15); x7 = Packed.Xor(x7, x11); x7 = Packed.Or(Packed.ShiftLeft32(x7, 7), Packed.ShiftRightU32(x7, 25));
                x0 = Packed.Add32(x0, x5); x15 = Packed.Xor(x15, x0); x15 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x15, 0xB1), 0xB1);
                x10 = Packed.Add32(x10, x15); x5 = Packed.Xor(x5, x10); x5 = Packed.Or(Packed.ShiftLeft32(x5, 12), Packed.ShiftRightU32(x5, 20));
                x0 = Packed.Add32(x0, x5); x15 = Packed.Xor(x15, x0); x15 = Packed.Or(Packed.ShiftLeft32(x15, 8), Packed.ShiftRightU32(x15, 24));
                x10 = Packed.Add32(x10, x15); x5 = Packed.Xor(x5, x10); x5 = Packed.Or(Packed.ShiftLeft32(x5, 7), Packed.ShiftRightU32(x5, 25));
                x1 = Packed.Add32(x1, x6); x12 = Packed.Xor(x12, x1); x12 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x12, 0xB1), 0xB1);
                x11 = Packed.Add32(x11, x12); x6 = Packed.Xor(x6, x11); x6 = Packed.Or(Packed.ShiftLeft32(x6, 12), Packed.ShiftRightU32(x6, 20));
                x1 = Packed.Add32(x1, x6); x12 = Packed.Xor(x12, x1); x12 = Packed.Or(Packed.ShiftLeft32(x12, 8), Packed.ShiftRightU32(x12, 24));
                x11 = Packed.Add32(x11, x12); x6 = Packed.Xor(x6, x11); x6 = Packed.Or(Packed.ShiftLeft32(x6, 7), Packed.ShiftRightU32(x6, 25));
                x2 = Packed.Add32(x2, x7); x13 = Packed.Xor(x13, x2); x13 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x13, 0xB1), 0xB1);
                x8 = Packed.Add32(x8, x13); x7 = Packed.Xor(x7, x8); x7 = Packed.Or(Packed.ShiftLeft32(x7, 12), Packed.ShiftRightU32(x7, 20));
                x2 = Packed.Add32(x2, x7); x13 = Packed.Xor(x13, x2); x13 = Packed.Or(Packed.ShiftLeft32(x13, 8), Packed.ShiftRightU32(x13, 24));
                x8 = Packed.Add32(x8, x13); x7 = Packed.Xor(x7, x8); x7 = Packed.Or(Packed.ShiftLeft32(x7, 7), Packed.ShiftRightU32(x7, 25));
                x3 = Packed.Add32(x3, x4); x14 = Packed.Xor(x14, x3); x14 = Packed.ShuffleHigh16(Packed.ShuffleLow16(x14, 0xB1), 0xB1);
                x9 = Packed.Add32(x9, x14); x4 = Packed.Xor(x4, x9); x4 = Packed.Or(Packed.ShiftLeft32(x4, 12), Packed.ShiftRightU32(x4, 20));
                x3 = Packed.Add32(x3, x4); x14 = Packed.Xor(x14, x3); x14 = Packed.Or(Packed.ShiftLeft32(x14, 8), Packed.ShiftRightU32(x14, 24));
                x9 = Packed.Add32(x9, x14); x4 = Packed.Xor(x4, x9); x4 = Packed.Or(Packed.ShiftLeft32(x4, 7), Packed.ShiftRightU32(x4, 25));
            }
            Packed.Store(k + 0, Packed.Add32(x0, Packed.Load128(s + 0)));
            Packed.Store(k + 16, Packed.Add32(x1, Packed.Load128(s + 16)));
            Packed.Store(k + 32, Packed.Add32(x2, Packed.Load128(s + 32)));
            Packed.Store(k + 48, Packed.Add32(x3, Packed.Load128(s + 48)));
            Packed.Store(k + 64, Packed.Add32(x4, Packed.Load128(s + 64)));
            Packed.Store(k + 80, Packed.Add32(x5, Packed.Load128(s + 80)));
            Packed.Store(k + 96, Packed.Add32(x6, Packed.Load128(s + 96)));
            Packed.Store(k + 112, Packed.Add32(x7, Packed.Load128(s + 112)));
            Packed.Store(k + 128, Packed.Add32(x8, Packed.Load128(s + 128)));
            Packed.Store(k + 144, Packed.Add32(x9, Packed.Load128(s + 144)));
            Packed.Store(k + 160, Packed.Add32(x10, Packed.Load128(s + 160)));
            Packed.Store(k + 176, Packed.Add32(x11, Packed.Load128(s + 176)));
            Packed.Store(k + 192, Packed.Add32(x12, Packed.Load128(s + 192)));
            Packed.Store(k + 208, Packed.Add32(x13, Packed.Load128(s + 208)));
            Packed.Store(k + 224, Packed.Add32(x14, Packed.Load128(s + 224)));
            Packed.Store(k + 240, Packed.Add32(x15, Packed.Load128(s + 240)));
        }
        return true;
    }

    private static uint Rotate(uint value, int bits)
    {
        return (value << bits) | (value >> (32 - bits));
    }

    /// The keystream's 64 bytes, little-endian, for Block.
    private void KeystreamBytes()
    {
        for (int i = 0; i < 16; i = i + 1)
        {
            uint word = _keystream[i];
            int at = i * 4;
            _block[at] = (byte)word;
            _block[at + 1] = (byte)(word >> 8);
            _block[at + 2] = (byte)(word >> 16);
            _block[at + 3] = (byte)(word >> 24);
        }
    }

    private static long ReadLittleWord(byte[] bytes, long offset)
    {
        int at = (int)offset;
        return ((long)bytes[at] & 255)
             | (((long)bytes[at + 1] & 255) << 8)
             | (((long)bytes[at + 2] & 255) << 16)
             | (((long)bytes[at + 3] & 255) << 24);
    }

    private void EraseBlock()
    {
        CorsacSecureCrypto_Bytes.Zero(_block, 0, _block.Length);
        for (int i = 0; i < _keystream.Length; i = i + 1) _keystream[i] = 0;
        for (int i = 0; i < _keystream4.Length; i = i + 1) _keystream4[i] = 0;
    }
}
