<Build FormatVersion="1" DefaultTargets="all">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Compiler>$(WorkspaceDirectory)/compiler/bin/$(Configuration)/net10.0/corc</Compiler>
    <Linker>$(WorkspaceDirectory)/linker/bin/$(Configuration)/net10.0/corlink</Linker>
  </PropertyGroup>
  <Components>
    <Project Name="compiler" Path="compiler/corc.csproj" />
    <Project Name="linker" Path="linker/linker.csproj" />
    <Project Name="build-tool" Path="tools/build/build.csproj" />
  </Components>
  <Directory Path="compiler" DefaultTargets="compiler" />
  <Directory Path="linker" DefaultTargets="linker" />
  <Directory Path="tools/build" DefaultTargets="build-tool" />

  <!-- The compiler's ProjectReference builds the linker dependency once. -->
  <Target Name="all" DependsOnTargets="libraries;build-tool" />
  <Target Name="compiler"><Compile Project="compiler" /></Target>
  <Target Name="linker"><Compile Project="linker" /></Target>
  <Target Name="build-tool"><Compile Project="build-tool" /></Target>
  <Target Name="libraries" DependsOnTargets="compiler" Description="Build runtime and standard shared libraries">
    <Script Interpreter="bash" File="tests/integration/build-libraries.sh" Workers="auto">
      <Environment Name="CORC" Value="$(Compiler)" />
    </Script>
  </Target>

  <Target Name="bootstrap" Steps="seed;native">
    <Target Name="seed" Description="Bootstrap only the build utility with MSBuild">
      <Compile Project="build-tool" Toolchain="dotnet" />
    </Target>
    <Target Name="native" DependsOnTargets="seed">
      <Error Text="Native project evaluation and verified build-utility self-hosting are not implemented yet. Host seed tools are available; bootstrap has not been activated." />
    </Target>
  </Target>

  <Target Name="test" Steps="unit;smoke;lto;indexed;ir-lto;managed">
    <Target Name="managed" DependsOnTargets="/compiler">
      <Test Name="managed-units" Executable="bash" Workers="auto" Timeout="00:10:00">
        <Argument Value="tests/integration/managed-units.sh" />
      </Test>
    </Target>
    <Target Name="unit" Steps="build-tool;optimizer;assembler;x86;linker;metadata">
      <Target Name="metadata">
        <Compile Project="compiler/tests/metadata/MetadataTests.csproj" />
        <Test Name="metadata" Executable="compiler/tests/metadata/bin/cor-c/$(Configuration)/net10.0/MetadataTests" Timeout="00:03:00" />
      </Target>
      <Target Name="build-tool">
        <Compile Project="tools/build/tests/BuildTests.csproj" />
        <Test Name="build-runner" Executable="tools/build/tests/bin/cor-c/$(Configuration)/net10.0/BuildTests" Timeout="00:03:00" />
      </Target>
      <Target Name="optimizer">
        <Compile Project="compiler/tests/optimizations/OptTests.csproj" />
        <Test Name="optimizer" Executable="compiler/tests/optimizations/bin/cor-c/$(Configuration)/net10.0/OptTests" Timeout="00:03:00" />
      </Target>
      <Target Name="assembler">
        <Compile Project="compiler/tests/arch/corsac/asmtests.csproj" />
        <Test Name="assembler" Executable="compiler/tests/arch/corsac/bin/cor-c/$(Configuration)/net10.0/asmtests" Timeout="00:03:00" />
      </Target>
      <Target Name="x86">
        <Compile Project="compiler/tests/arch/x86/x86tests.csproj" />
        <Test Name="x86" Executable="compiler/tests/arch/x86/bin/cor-c/$(Configuration)/net10.0/x86tests" Timeout="00:03:00" />
      </Target>
      <Target Name="linker">
        <Compile Project="linker/tests/ElfTests.csproj" />
        <Test Name="linker" Executable="linker/tests/bin/cor-c/$(Configuration)/net10.0/ElfTests" Timeout="00:03:00" />
      </Target>
    </Target>
    <Target Name="smoke" DependsOnTargets="/compiler">
      <Script Interpreter="sh" File="tests/integration/separate-link.sh">
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Script>
    </Target>
    <Target Name="lto" DependsOnTargets="/compiler">
      <Test Name="cross-object-lto" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/lto.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="indexed" DependsOnTargets="/compiler">
      <Test Name="indexed-compilation" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/indexed.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="ir-lto" DependsOnTargets="/compiler">
      <Test Name="ir-link-optimization" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/ir-lto.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="corsac-boot" DependsOnTargets="/compiler" Description="Boot an actual CORSAC source snapshot with separately linked stage2 and kernel">
      <Script Interpreter="bash" File="tests/integration/corsac-boot.sh" Workers="auto" Timeout="00:20:00">
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Script>
    </Target>
    <Target Name="language" DependsOnTargets="/compiler">
      <Test Name="language" Executable="bash" Timeout="01:00:00">
        <Argument Value="tests/language/run.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="shared" DependsOnTargets="/libraries">
      <Test Name="shared-libraries" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/shared-libraries.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
  </Target>
</Build>
