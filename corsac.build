<Build FormatVersion="0" DefaultTargets="all">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Compiler>$(WorkspaceDirectory)/compiler/bin/managed/$(Configuration)/net10.0/corc</Compiler>
    <Linker>$(WorkspaceDirectory)/compiler/bin/managed/$(Configuration)/net10.0/corc</Linker>
    <CompilerDll>$(WorkspaceDirectory)/compiler/bin/managed/$(Configuration)/net10.0/corc.dll</CompilerDll>
    <!-- The OS test/corsac-boot builds and boots: its checkout, the revision
         read from it, and the Windows 2000 media its image carries. -->
    <CorsacRoot>$(WorkspaceDirectory)/../corsac86-gui</CorsacRoot>
    <CorsacRevision>HEAD</CorsacRevision>
    <CorsacWin2k>$(WorkspaceDirectory)/../../src/win2k</CorsacWin2k>
  </PropertyGroup>
  <Components>
    <Project Name="compiler" Path="compiler/corc.csproj" />
    <Project Name="linker" Path="linker/linker.csproj" />
    <Project Name="build-tool" Path="tools/build/build.csproj" />
  </Components>
  <Directory Path="compiler" DefaultTargets="compiler" />
  <Directory Path="linker" DefaultTargets="linker" />
  <Directory Path="tools/build" DefaultTargets="build-tool" />

  <!-- corc is the only executable: its ProjectReferences build the linker
       and the build utility with it. -->
  <Target Name="all" DependsOnTargets="libraries" />
  <Target Name="compiler"><Compile Project="compiler" Toolchain="managed" /></Target>
  <Target Name="linker"><Compile Project="linker" Toolchain="managed" /></Target>
  <Target Name="build-tool"><Compile Project="build-tool" Toolchain="managed" /></Target>
  <Target Name="libraries" DependsOnTargets="compiler" Description="Build runtime and standard shared libraries">
    <Script Interpreter="bash" File="tests/integration/build-libraries.sh" Workers="auto">
      <Environment Name="CORC" Value="$(Compiler)" />
    </Script>
  </Target>

  <Target Name="bootstrap" Steps="seed;native">
    <Target Name="seed" Description="Bootstrap only the build utility with MSBuild">
      <Compile Project="build-tool" Toolchain="dotnet" />
    </Target>
    <Target Name="native" DependsOnTargets="seed">
      <Error Text="Native project evaluation and verified build-utility self-hosting are not implemented yet. Host seed tools are available; bootstrap has not been activated." />
    </Target>
  </Target>

  <!-- EVERY TEST THE TREE HAS, in order of how long each takes: what is not
       a step here is not run by anything. Left out and run by name:
       test/corsac-boot, which boots the OS in QEMU and needs permission each
       time, and test/language-link, the whole suite through the link. -->
  <Target Name="test" Steps="unit;smoke;lto;indexed;ir-lto;managed;checked-frees;lifetimes;separate-dynamic;unused-report;modules;projects;language-scripts;separate-units;shared;language">
    <Target Name="managed" DependsOnTargets="/compiler">
      <Test Name="managed-units" Executable="bash" Workers="auto" Timeout="00:10:00">
        <Argument Value="tests/integration/managed-units.sh" />
      </Test>
    </Target>
    <Target Name="unit" Steps="build-tool;optimizer;x86;linker;metadata;project-evaluator">
      <Target Name="project-evaluator">
        <Compile Project="compiler/tests/projects/ProjectTests.csproj" Toolchain="managed" />
        <Test Name="project-evaluator" Executable="compiler/tests/projects/bin/managed/$(Configuration)/net10.0/ProjectTests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
      <Target Name="metadata">
        <Compile Project="compiler/tests/metadata/MetadataTests.csproj" Toolchain="managed" />
        <Test Name="metadata" Executable="compiler/tests/metadata/bin/managed/$(Configuration)/net10.0/MetadataTests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
      <Target Name="build-tool">
        <Compile Project="tools/build/tests/BuildTests.csproj" Toolchain="managed" />
        <Test Name="build-runner" Executable="tools/build/tests/bin/managed/$(Configuration)/net10.0/BuildTests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
      <Target Name="optimizer">
        <Compile Project="compiler/tests/optimizations/OptTests.csproj" Toolchain="managed" />
        <Test Name="optimizer" Executable="compiler/tests/optimizations/bin/managed/$(Configuration)/net10.0/OptTests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
      <Target Name="x86">
        <Compile Project="compiler/tests/arch/x86/x86tests.csproj" Toolchain="managed" />
        <Test Name="x86" Executable="compiler/tests/arch/x86/bin/managed/$(Configuration)/net10.0/x86tests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
      <Target Name="linker">
        <Compile Project="linker/tests/ElfTests.csproj" Toolchain="managed" />
        <Test Name="linker" Executable="linker/tests/bin/managed/$(Configuration)/net10.0/ElfTests" Timeout="00:03:00">
          <Environment Name="TMPDIR" Value="$(OutputDirectory)" />
        </Test>
      </Target>
    </Target>
    <Target Name="smoke" DependsOnTargets="/compiler">
      <Script Interpreter="sh" File="tests/integration/separate-link.sh">
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Script>
    </Target>
    <Target Name="lto" DependsOnTargets="/compiler">
      <Test Name="cross-object-lto" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/lto.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="indexed" DependsOnTargets="/compiler">
      <Test Name="indexed-compilation" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/indexed.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="modules" DependsOnTargets="/compiler" Description="A kernel linked with --exports loading a module built against it">
      <Test Name="kernel-modules" Executable="sh" Timeout="00:10:00">
        <Argument Value="tests/integration/modules.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="ir-lto" DependsOnTargets="/compiler">
      <Test Name="ir-link-optimization" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/ir-lto.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="corsac-boot" DependsOnTargets="/compiler" Description="The OS at CorsacRevision built by this compiler through its own corsac.build and booted by its own boot-test: boots QEMU, run by name with permission">
      <Test Name="corsac-boot" Executable="bash" Workers="auto" Timeout="01:00:00">
        <Argument Value="tests/integration/corsac-boot.sh" />
        <Argument Value="--os" /><Argument Value="$(CorsacRoot)" />
        <Argument Value="--revision" /><Argument Value="$(CorsacRevision)" />
        <Argument Value="--win2k" /><Argument Value="$(CorsacWin2k)" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="language" DependsOnTargets="/compiler">
      <Test Name="language" Executable="bash" Timeout="01:00:00">
        <Argument Value="tests/language/run.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="TMPDIR" Value="$(OutputDirectory)" />
      </Test>
    </Target>
    <Target Name="language-link" DependsOnTargets="/compiler" Description="Every language test compiled to an object and linked: the link-time optimiser, its region solver and the regions headers">
      <Test Name="language-through-link" Executable="bash" Timeout="02:00:00">
        <Argument Value="tests/language/run.sh" /><Argument Value="--through-link" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="TMPDIR" Value="$(OutputDirectory)" />
      </Test>
    </Target>
    <Target Name="language-scripts" DependsOnTargets="/compiler">
      <Test Name="asm-object" Executable="bash" Timeout="00:05:00">
        <Argument Value="tests/language/260_asm_object.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
      <Test Name="asm-movzx" Executable="bash" Timeout="00:02:00">
        <Argument Value="tests/language/262_asm_movzx.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
      <Test Name="config-dead-branch" Executable="bash" Timeout="00:05:00">
        <Argument Value="tests/language/202_config_dead_branch.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="separate-units" DependsOnTargets="/compiler" Description="Every language test compiled alone against the library's declarations and linked with the library's object">
      <Test Name="separate-units" Executable="bash" Timeout="02:00:00">
        <Argument Value="tests/integration/separate-units.sh" /><Argument Value="all" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="checked-frees" DependsOnTargets="/compiler">
      <Test Name="checked-frees" Executable="bash" Timeout="00:05:00">
        <Argument Value="tests/integration/checked-frees.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="lifetimes" DependsOnTargets="/compiler">
      <Test Name="lifetimes-across-units" Executable="bash" Timeout="00:10:00">
        <Argument Value="tests/integration/lifetimes.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="separate-dynamic" DependsOnTargets="/compiler">
      <Test Name="separate-dynamic-linking" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/separate-dynamic.sh" />
        <Environment Name="CORC" Value="$(Compiler)" /><Environment Name="CORLINK" Value="$(Linker)" />
      </Test>
    </Target>
    <Target Name="unused-report" DependsOnTargets="/compiler">
      <Test Name="unused-report" Executable="sh" Timeout="00:05:00">
        <Argument Value="tests/integration/unused-report.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
    <Target Name="projects" DependsOnTargets="/compiler" Description="corc project: the pipeline, a declaration changed between builds, a template's bodies as a dependence, and the slot table">
      <Test Name="project-pipeline" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/project-pipeline.sh" />
        <Environment Name="CORC_DLL" Value="$(CompilerDll)" />
      </Test>
      <Test Name="project-declaration-change" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/project-declaration-change.sh" />
        <Environment Name="CORC_DLL" Value="$(CompilerDll)" />
      </Test>
      <Test Name="project-slots" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/project-slots.sh" />
        <Environment Name="CORC_DLL" Value="$(CompilerDll)" />
      </Test>
      <Test Name="project-template-bodies" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/project-template-bodies.sh" />
        <Environment Name="CORC_DLL" Value="$(CompilerDll)" />
      </Test>
    </Target>
    <Target Name="shared" DependsOnTargets="/libraries">
      <Test Name="shared-libraries" Executable="bash" Timeout="00:15:00">
        <Argument Value="tests/integration/shared-libraries.sh" />
        <Environment Name="CORC" Value="$(Compiler)" />
      </Test>
    </Target>
  </Target>
</Build>
