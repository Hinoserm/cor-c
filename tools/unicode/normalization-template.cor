// ---- string.Normalize and IsNormalized ---------------------------------------
//
// .NET's, as its ICU gives them on Linux (Unicode 16.0): the four forms of
// UAX #15. A string is taken apart into code points, each decomposed to the
// end -- canonically, or with the compatibility mappings for KD and KC --
// marks put in canonical order by their combining class, and for C and KC
// composed again, a mark joining the last starter unless something of its
// class or a starter stands between. Hangul syllables by the formula, in no
// table. The tables (UnicodeNormalizationData, below) are generated:
// tools/unicode/normalization.py writes this whole file.
//
// A string below U+00A0 throughout is every form already: nothing under it
// decomposes or composes. Otherwise UAX #15's quick check first: every code
// point Yes for the form (CheckRanges) and the marks in canonical order is
// the form already, handed back as it is with nothing made. A lone
// surrogate is .NET's ArgumentException.

namespace System.Text
{
    /// .NET's NormalizationForm, by its numbers.
    public enum NormalizationForm
    {
        FormC = 1,
        FormD = 2,
        FormKC = 5,
        FormKD = 6,
    }
}

public static partial class String
{
    public static string Normalize(string s) => UnicodeNormalization.Normalize(s, System.Text.NormalizationForm.FormC, "strInput");
    public static string Normalize(string s, System.Text.NormalizationForm normalizationForm) => UnicodeNormalization.Normalize(s, normalizationForm, "strInput");
    public static bool IsNormalized(string s) => IsNormalized(s, System.Text.NormalizationForm.FormC);
    public static bool IsNormalized(string s, System.Text.NormalizationForm normalizationForm)
        => string.Equals(UnicodeNormalization.Normalize(s, normalizationForm, "source"), s, StringComparison.Ordinal);
}

static class UnicodeNormalization
{
    const int SBase = 0xAC00, LBase = 0x1100, VBase = 0x1161, TBase = 0x11A7;
    const int LCount = 19, VCount = 21, TCount = 28, NCount = VCount * TCount, SCount = LCount * NCount;

    internal static string Normalize(string s, System.Text.NormalizationForm form, string parameter)
    {
        bool compose, compatible;
        int notYes;
        switch (form)
        {
            case System.Text.NormalizationForm.FormC: compose = true; compatible = false; notYes = 4 | 8; break;
            case System.Text.NormalizationForm.FormD: compose = false; compatible = false; notYes = 1; break;
            case System.Text.NormalizationForm.FormKC: compose = true; compatible = true; notYes = 16 | 32; break;
            case System.Text.NormalizationForm.FormKD: compose = false; compatible = true; notYes = 2; break;
            default: throw new ArgumentException("Invalid or unsupported normalization form.", "normalizationForm");
        }
        bool plain = true;
        for (int i = 0; i < s.Length; i++)
        {
            char c = s[i];
            if (c >= 0xA0) { plain = false; break; }
        }
        if (plain) return s;
        if (QuickYes(s, notYes, parameter)) return s;

        List<int> points = new List<int>(s.Length + 8);
        for (int i = 0; i < s.Length; i++)
        {
            int cp = s[i];
            if (cp >= 0xD800 && cp <= 0xDFFF)
            {
                if (cp > 0xDBFF || i + 1 >= s.Length || s[i + 1] < 0xDC00 || s[i + 1] > 0xDFFF)
                    throw new ArgumentException("String contains invalid Unicode code points.", parameter);
                cp = 0x10000 + ((cp - 0xD800) << 10) + (s[i + 1] - 0xDC00);
                i++;
            }
            Decompose(cp, compatible, points);
        }
        Order(points);
        if (compose) Compose(points);

        StringBuilder made = new StringBuilder(points.Count);
        foreach (int cp in points)
        {
            if (cp < 0x10000) made.Append((char)cp);
            else
            {
                int above = cp - 0x10000;
                made.Append((char)(0xD800 + (above >> 10)));
                made.Append((char)(0xDC00 + (above & 0x3FF)));
            }
        }
        string result = made.ToString();
        // The same text is the same string, as .NET hands back.
        return string.Equals(result, s, StringComparison.Ordinal) ? s : result;
    }

    // UAX #15's quick check: Yes for every code point, marks in order.
    // Maybe or No is the full work's to settle.
    static bool QuickYes(string s, int notYes, string parameter)
    {
        int lastClass = 0;
        for (int i = 0; i < s.Length; i++)
        {
            int cp = s[i];
            if (cp < 0xA0) { lastClass = 0; continue; }
            if (cp >= 0xD800 && cp <= 0xDFFF)
            {
                if (cp > 0xDBFF || i + 1 >= s.Length || s[i + 1] < 0xDC00 || s[i + 1] > 0xDFFF)
                    throw new ArgumentException("String contains invalid Unicode code points.", parameter);
                cp = 0x10000 + ((cp - 0xD800) << 10) + (s[i + 1] - 0xDC00);
                i++;
            }
            int cc = Class(cp);
            if (cc != 0 && lastClass > cc) return false;
            if ((Check(cp) & notYes) != 0) return false;
            lastClass = cc;
        }
        return true;
    }

    // Its quick-check bits (UnicodeNormalizationData.CheckRanges).
    static int Check(int cp)
    {
        int[] ranges = UnicodeNormalizationData.CheckRanges;
        int lo = 0, hi = ranges.Length / 3 - 1;
        while (lo <= hi)
        {
            int mid = (lo + hi) >> 1;
            if (cp < ranges[mid * 3]) hi = mid - 1;
            else if (cp > ranges[mid * 3 + 1]) lo = mid + 1;
            else return ranges[mid * 3 + 2];
        }
        return 0;
    }

    static void Decompose(int cp, bool compatible, List<int> into)
    {
        if (cp >= SBase && cp < SBase + SCount)
        {
            int index = cp - SBase;
            into.Add(LBase + index / NCount);
            into.Add(VBase + index % NCount / TCount);
            int t = index % TCount;
            if (t != 0) into.Add(TBase + t);
            return;
        }
        if (cp < 0xA0) { into.Add(cp); return; }
        if (compatible && Mapped(UnicodeNormalizationData.CompatibleKeys, UnicodeNormalizationData.CompatibleOffsets, UnicodeNormalizationData.CompatibleData, cp, into)) return;
        if (Mapped(UnicodeNormalizationData.CanonicalKeys, UnicodeNormalizationData.CanonicalOffsets, UnicodeNormalizationData.CanonicalData, cp, into)) return;
        into.Add(cp);
    }

    // Its whole decomposition, where the table has one (decomposed to the end already).
    static bool Mapped(int[] keys, int[] offsets, int[] data, int cp, List<int> into)
    {
        int lo = 0, hi = keys.Length - 1;
        while (lo <= hi)
        {
            int mid = (lo + hi) >> 1;
            int k = keys[mid];
            if (k == cp)
            {
                for (int i = offsets[mid]; i < offsets[mid + 1]; i++) into.Add(data[i]);
                return true;
            }
            if (k < cp) lo = mid + 1; else hi = mid - 1;
        }
        return false;
    }

    /// A code point's canonical combining class: 0 for a starter.
    static int Class(int cp)
    {
        if (cp < 0x300) return 0;
        int[] ranges = UnicodeNormalizationData.ClassRanges;
        int lo = 0, hi = ranges.Length / 3 - 1;
        while (lo <= hi)
        {
            int mid = (lo + hi) >> 1;
            if (cp < ranges[mid * 3]) hi = mid - 1;
            else if (cp > ranges[mid * 3 + 1]) lo = mid + 1;
            else return ranges[mid * 3 + 2];
        }
        return 0;
    }

    // MARKS IN CANONICAL ORDER: a stable sort by class of each run of
    // non-starters, the classes looked up once. A short run by insertion; a
    // long one (a pile of marks) by counting, classes being 1 to 254, so no
    // run costs more than its length.
    static void Order(List<int> points)
    {
        int n = points.Count;
        int[] classes = new int[n];
        for (int i = 0; i < n; i++) classes[i] = Class(points[i]);
        int at = 0;
        while (at < n)
        {
            if (classes[at] == 0) { at++; continue; }
            int end = at;
            while (end < n && classes[end] != 0) end++;
            if (end - at <= 16) Insertion(points, classes, at, end);
            else Counting(points, classes, at, end);
            at = end;
        }
    }

    static void Insertion(List<int> points, int[] classes, int from, int to)
    {
        for (int i = from + 1; i < to; i++)
        {
            int cc = classes[i], moving = points[i];
            int j = i;
            while (j > from && classes[j - 1] > cc)
            {
                points[j] = points[j - 1];
                classes[j] = classes[j - 1];
                j--;
            }
            points[j] = moving;
            classes[j] = cc;
        }
    }

    static void Counting(List<int> points, int[] classes, int from, int to)
    {
        int[] starts = new int[257];
        for (int i = from; i < to; i++) starts[classes[i] + 1]++;
        for (int c = 1; c < 257; c++) starts[c] += starts[c - 1];
        int length = to - from;
        int[] sorted = new int[length];
        int[] sortedClasses = new int[length];
        for (int i = from; i < to; i++)
        {
            int place = starts[classes[i]]++;
            sorted[place] = points[i];
            sortedClasses[place] = classes[i];
        }
        for (int i = 0; i < length; i++)
        {
            points[from + i] = sorted[i];
            classes[from + i] = sortedClasses[i];
        }
    }

    // COMPOSED AGAIN (UAX #15's canonical composition): each mark joins the
    // last starter where nothing of its class or higher, and no starter,
    // stands between them.
    static void Compose(List<int> points)
    {
        if (points.Count == 0) return;
        int starterAt = 0;
        int starter = points[0];
        int lastClass = Class(starter);
        if (lastClass != 0) lastClass = 256;
        int written = 1;
        for (int i = 1; i < points.Count; i++)
        {
            int ch = points[i];
            int cc = Class(ch);
            int composite = Composite(starter, ch);
            if (composite >= 0 && (lastClass < cc || lastClass == 0))
            {
                points[starterAt] = composite;
                starter = composite;
                continue;
            }
            if (cc == 0)
            {
                starterAt = written;
                starter = ch;
            }
            lastClass = cc;
            points[written++] = ch;
        }
        points.RemoveRange(written, points.Count - written);
    }

    // The primary composite of a pair, or -1.
    static int Composite(int first, int second)
    {
        if (first >= LBase && first < LBase + LCount && second >= VBase && second < VBase + VCount)
            return SBase + ((first - LBase) * VCount + (second - VBase)) * TCount;
        if (first >= SBase && first < SBase + SCount && (first - SBase) % TCount == 0 && second > TBase && second < TBase + TCount)
            return first + (second - TBase);
        long key = ((long)first << 21) | (long)second;
        long[] pairs = UnicodeNormalizationData.CompositePairs;
        int lo = 0, hi = pairs.Length - 1;
        while (lo <= hi)
        {
            int mid = (lo + hi) >> 1;
            long k = pairs[mid];
            if (k == key) return UnicodeNormalizationData.CompositeValues[mid];
            if (k < key) lo = mid + 1; else hi = mid - 1;
        }
        return -1;
    }
}

