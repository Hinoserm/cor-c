#!/usr/bin/env bash
# MSBuild is used only for the initial build-tool seed and AOT pack provisioning.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tool="$root/compiler/bin/managed/Release/net10.0/corc"
packages="${NUGET_PACKAGES:-$(dotnet nuget locals global-packages --list | sed 's/^global-packages: //')}"
have_packs=0
for pack in "$packages"/runtime.linux-x64.microsoft.dotnet.ilcompiler/10.*/tools/ilc; do
    if [ -f "$pack" ]; then
        version=${pack%/tools/ilc}
        version=${version##*/}
        if [ -f "$packages/microsoft.netcore.app.runtime.nativeaot.linux-x64/$version/runtimes/linux-x64/native/libbootstrapper.o" ]; then have_packs=1; break; fi
    fi
done
# A toolchain from before the build utility, the compiler and the linker
# became one executable answers `build` as the assembler, so it cannot be
# asked to rebuild itself. Seed it instead.
merged=1
if [ -f "$tool" ]; then "$tool" help 2>/dev/null | grep -q 'corc build \[' || merged=0; fi
seed() {
    local seed="$root/compiler/bin/native-seed"
    echo "bootstrap: seeding the toolchain from the .NET SDK" >&2
    dotnet publish "$root/compiler/corc.csproj" -c Release -r linux-x64 \
        -p:PublishAot=true -o "$seed" --nologo -v quiet >&2
    "$seed/corc" build --file "$root/tools/build/host.build" >&2
}
# A toolchain that cannot read this tree's manifests (one built before a
# change to their format) cannot rebuild itself either: seed it too. Asked
# with --list, which reads the manifest and builds nothing, so a build that
# fails for any other reason -- an error in the sources, an interrupt --
# stops here as it would have.
if [ ! -f "$tool" ] || [ "$(head -c 2 "$tool")" = '#!' ] || [ "$have_packs" = 0 ] || [ "$merged" = 0 ] \
   || ! "$tool" build --file "$root/tools/build/host.build" --list >/dev/null 2>&1; then
    seed
else
    "$tool" build --file "$root/tools/build/host.build" >&2
fi
exec "$tool" build "$@"
