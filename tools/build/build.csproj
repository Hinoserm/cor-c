<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>build</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="../../compiler/src/projects/EvaluatedProject.cs" />
    <Compile Include="../../compiler/src/projects/ProjectEvaluator.cs" />
    <Compile Include="../../compiler/src/projects/ProjectGraph.cs" />
    <Compile Include="../../compiler/src/projects/ProjectCondition.cs" />
    <Compile Include="../../compiler/src/projects/ProjectGlob.cs" />
    <Compile Include="../../compiler/src/projects/ProjectItem.cs" />
  </ItemGroup>
</Project>
