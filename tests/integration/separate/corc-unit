#!/usr/bin/env bash
# The compiler as tests/language/run.sh sees it, compiling each test the way
# the OS builds a program: the test's own sources as ONE unit against the
# declarations of the runtime and class library (--ref, --decl-index), then
# linked with the library object compiled once, apart.
#
#   SEPARATE_CORC     the real compiler command
#   SEPARATE_INDEX    declaration index of the library
#   SEPARATE_LIB_OBJ  the library object
#
# Anything else -- and a compile a test runs itself -- goes to the real
# compiler unchanged.
set -euo pipefail
read -r -a real <<< "$SEPARATE_CORC"
# The options before the command, which run.sh puts there (--lib-root of its
# copy of the sources, --verify-analyses), go to every compile and link this
# makes: read as the command, they sent every test to a plain whole-program
# compile, and this script tested nothing it says.
global=()
while [ $# -gt 0 ]; do
    case "$1" in
        --lib-root) global+=("$1" "$2"); shift 2 ;;
        --*) global+=("$1"); shift ;;
        *) break ;;
    esac
done
real+=("${global[@]}")
# A compile of its own, and one in the kernels' store scheme (--store-sequences),
# which the library object compiled once was not built in, go to the compiler
# whole.
case " $* " in *" --obj "*|*" --freestanding "*|*" --store-sequences "*) exec "${real[@]}" "$@" ;; esac
[ "${1:-}" = compile ] || exec "${real[@]}" "$@"
shift
# THE LIBRARY AS THIS COMPILE SEES IT: run.sh compiles from its own copy of
# the sources (--lib-root), so the library sources it names are that copy's,
# not the ones the library object was made from.
declare -A library=()
while IFS= read -r lib; do library["$(realpath -m "$lib")"]=1; done < <("${real[@]}" library-sources)
flags=() sources=() refs=() out=
while [ $# -gt 0 ]; do
    case "$1" in
        -o) out=$2; shift 2; continue ;;
        *.cor) [ -n "${library[$(realpath -m "$1")]:-}" ] || sources+=("$1") ;;
        *) flags+=("$1") ;;
    esac
    shift
done
for lib in "${!library[@]}"; do refs+=(--ref "$lib"); done
"${real[@]}" compile --nostdlib "${refs[@]}" --decl-index "$SEPARATE_INDEX" --assembly Suite \
    "${flags[@]}" "${sources[@]}" --obj -o "$out.o"
# CLOSED, as the OS links a program (corc project): the whole program is
# these two objects, and only then does the link decide what it proves of
# one -- owned fields, element lists, regions, what is ever made. Linked
# open, it decided none of it, and every lifetime test freed less.
exec "${real[@]}" link --closed "$out.o" "$SEPARATE_LIB_OBJ" -o "$out"
