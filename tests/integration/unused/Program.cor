using System;

class Program
{
    static int _counted;
    static int _never;
    static int _read;
    static int _left, _right;
    static int Half { get; set; }

    static void Unused() { OnlyFromUnused(); }
    static void OnlyFromUnused() { Console.WriteLine(_never); }
    static void Chain() { }
    static int Small(int x) => x + 1;
    static T Id<T>(T x) => x;
    static T Nope<T>(T x) => x;
    delegate int Maker(int x);

    interface IShape { int Sides(); }
    class Square : IShape { public int Sides() => 4; }
    class Never : IShape { public int Sides() => 0; }

    static void Main()
    {
        _counted = 3;
        _read = Small(1);
        Half = _left;
        Maker twice = x => Id(x) * 2;
        IShape shape = new Square();
        Console.WriteLine(_read + twice(shape.Sides()));
    }
}
