// A module that calls the kernel's packed routine in a loop, for
// tests/integration/modules-packed.sh: it keeps the processor's state once
// around its loop, and each call is to the kernel's $inside copy, which
// saves nothing of its own.

using System.Runtime.CompilerServices;
using Kernel;

namespace Blit;

public sealed class Blitter : Driver
{
    public override string Name => "blit";

    public override int Bind(int port)
    {
        byte[] bytes = new byte[64];
        for (int i = 0; i < bytes.Length; i++) bytes[i] = (byte)(i * 7 + port);
        for (int round = 0; round < 4; round++) Pixels.Brighten(Sys.ArrayData(bytes), bytes.Length);
        int sum = 0;
        for (int i = 0; i < bytes.Length; i++) sum += bytes[i];
        Log.Write("blit " + sum);
        return sum;
    }
}

static class BlitModule
{
    [ModuleInitializer]
    internal static void Load()
    {
        Drivers.Register(new Blitter());
    }
}
