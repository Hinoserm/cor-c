// What the kernel does with a module, in miniature, for
// tests/integration/modules.sh: read it, map it, bind it against the export
// table in the kernel's own file (.corsac.exports, read from the file and
// let go, nothing of it loaded) the way the kernel's binder (elfload.cor)
// binds a library -- REL relocations, SysV hash -- and call its DT_INIT.
// Every name binds or the module is refused, naming it. The image runs as a
// Linux process (Host.cor), so the files are read with Linux's own calls.

using System.Collections.Generic;
using System;

namespace Kernel;

public static class Modules
{
#if TARGET_64BIT
    const int Read = 0, Open = 2, Close = 3, Mmap = 9;
#else
    const int Read = 3, Open = 5, Close = 6, Mmap = 192;
#endif

    /// Why the last Insmod refused, or "" when it did not.
    public static string Refusal = "";

    /// What the module's .corsac.modinfo says, an entry each.
    public static List<string> Info = new List<string>();

    // A 32-bit shared object: its offsets in the file are ints, its fields
    // uint and ushort, and where it is mapped an address.
    public static bool Insmod(string module, string kernel)
    {
        Refusal = "";
        byte[]? image = Slurp(module), file = Slurp(kernel);
        if (image == null || file == null) return Refuse("cannot read " + (image == null ? module : kernel));
        if (U32(image, 0) != 0x464C457F || image[4] != 1 || U16(image, 16) != 3) return Refuse("not a 32-bit shared object");

        // THE KERNEL'S EXPORTS, a section of its file no segment loads: read
        // for this bind, and let go after it.
        int exports = Section(file, ".corsac.exports", out int exportBytes);
        if (exports < 0) return Refuse("the kernel has no exports");
        byte[] table = new byte[exportBytes];
        for (int i = 0; i < exportBytes; i++) table[i] = file[exports + i];
        // THE FILE IS THE KERNEL RUNNING, or its addresses are another's:
        // its link identity (DT_CORSAC_LINKID) is the one this kernel holds.
        int id = Tag(table, 0x60000C07);
        if (id < 0) return Refuse("the kernel's exports carry no link identity");
        nuint mine = Sys.LinkId();
        for (int i = 0; i < 32; i++)
            if (table[id + i] != (byte)Sys.Read8(mine + (nuint)i)) return Refuse("the kernel's file is another build now; reboot");
        int info = Section(image, ".corsac.modinfo", out int infoBytes);
        Info.Clear();
        int from = info;
        for (int at = info; info >= 0 && at < info + infoBytes; at++)
        {
            if (image[at] != 0) continue;
            Info.Add(Text(image, from));
            from = at + 1;
        }

        // MAPPED, each PT_LOAD where its address says, from a base the
        // kernel chose; the zero tail is the mapping's own.
        int phoff = (int)U32(image, 28), phnum = U16(image, 44);
        uint size = 0, dynamic = 0;
        for (int p = 0; p < phnum; p++)
        {
            int ph = phoff + p * 32;
            if (U32(image, ph) == 1) size = Math.Max(size, U32(image, ph + 8) + U32(image, ph + 20));
            if (U32(image, ph) == 2) dynamic = U32(image, ph + 8);
        }
        SyscallWord mapped = Sys.Syscall(Mmap, 0, (size + 0xFFF) & ~0xFFFu, 7, 0x22, unchecked((SyscallWord)(-1)), 0);
        // An answer from -4095 to -1 is an error's.
        if (mapped > unchecked((SyscallWord)(-4096))) return Refuse("no memory");
        // A 32-bit image's words hold its addresses: below 4 GB, all of it.
        if ((ulong)mapped + size > uint.MaxValue) return Refuse("mapped above 4 GB");
        nuint bias = (nuint)mapped;
        for (int p = 0; p < phnum; p++)
        {
            int ph = phoff + p * 32;
            if (U32(image, ph) != 1) continue;
            int offset = (int)U32(image, ph + 4), bytes = (int)U32(image, ph + 16);
            nuint address = bias + U32(image, ph + 8);
            for (int b = 0; b < bytes; b++) Sys.Write8(address + (nuint)b, image[offset + b]);
        }

        // BOUND: every relocation is one a library has, every name the
        // module does not define is the kernel's, and the text is not touched.
        uint symtab = 0, strtab = 0, rel = 0, relBytes = 0, jmprel = 0, jmprelBytes = 0, init = 0;
        for (nuint d = bias + dynamic; Sys.Read32(d) != 0; d += 8)
        {
            uint tag = Sys.Read32(d), value = Sys.Read32(d + 4);
            if (tag == 6) symtab = value; else if (tag == 5) strtab = value; else if (tag == 17) rel = value; else if (tag == 18) relBytes = value;
            else if (tag == 23) jmprel = value; else if (tag == 2) jmprelBytes = value; else if (tag == 12) init = value;
            // DT_TEXTREL: a module linked --relocated-text. Its text is this
            // loader's memory as the rest is, and is bound in the same pass.
            else if (tag == 1) return Refuse("needs another module");
        }
        if (!Bind(image, table, bias, (int)symtab, (int)strtab, (int)rel, (int)relBytes) || !Bind(image, table, bias, (int)symtab, (int)strtab, (int)jmprel, (int)jmprelBytes)) return false;

        // AND STARTED: its statics become roots and its frames known, then
        // its initialisers register its drivers.
        if (init != 0) Sys.CallNative(bias + init);
        return true;
    }

    // The tables are read from the file, where a shared object's addresses
    // are its offsets: its loaded segments start at nought.
    static bool Bind(byte[] image, byte[] table, nuint bias, int symtab, int strtab, int at, int bytes)
    {
        for (int r = at; r < at + bytes; r += 8)
        {
            nuint where = bias + U32(image, r);
            uint info = U32(image, r + 4), kind = info & 0xFF;
            uint symbol = 0;
            if (kind != 8)
            {
                int sym = symtab + (int)(info >> 8) * 16;
                string name = Text(image, strtab + (int)U32(image, sym));
                symbol = U16(image, sym + 14) != 0 ? (uint)bias + U32(image, sym + 4) : Export(table, name);
                if (symbol == 0) return Refuse("undefined symbol " + name);
            }
            // Each a 32-bit word of the module's, which wraps as the processor's adds do.
            if (kind == 8) Sys.Write32(where, unchecked(Sys.Read32(where) + (uint)bias));
            else if (kind == 1) Sys.Write32(where, unchecked(Sys.Read32(where) + symbol));
            // A direct call of a module linked --relocated-text: S + A - P.
            else if (kind == 2) Sys.Write32(where, unchecked(Sys.Read32(where) + symbol - (uint)where));
            else if (kind == 6 || kind == 7) Sys.Write32(where, symbol);
            else return Refuse("relocation of kind " + kind);
        }
        return true;
    }

    /// Where the kernel's exports say `name` is: their DT_HASH, chain by
    /// chain, every offset the section's own, from its dynamic array at nought.
    static uint Export(byte[] table, string name)
    {
        int hash = 0, symtab = 0, strtab = 0;
        for (int d = 0; U32(table, d) != 0; d += 8)
        {
            uint tag = U32(table, d);
            int value = (int)U32(table, d + 4);
            if (tag == 4) hash = value; else if (tag == 6) symtab = value; else if (tag == 5) strtab = value;
        }
        uint h = 0;
        for (int i = 0; i < name.Length; i++)
        {
            h = unchecked((h << 4) + name[i]);
            uint g = h & 0xF0000000u;
            if (g != 0) h ^= g >> 24;
            h &= ~g;
        }
        uint buckets = U32(table, hash);
        for (uint i = U32(table, hash + 8 + (int)(h % buckets) * 4); i != 0; i = U32(table, hash + 8 + (int)(buckets + i) * 4))
        {
            int sym = symtab + (int)i * 16;
            if (Text(table, strtab + (int)U32(table, sym)) == name) return U32(table, sym + 4);
        }
        return 0;
    }

    /// What the exports' dynamic array says under `tag`, or -1.
    static int Tag(byte[] table, uint tag)
    {
        for (int d = 0; U32(table, d) != 0; d += 8)
            if (U32(table, d) == tag) return (int)U32(table, d + 4);
        return -1;
    }

    /// The file offset of the section called `name`, and its size; -1 if there is none.
    static int Section(byte[] image, string name, out int bytes)
    {
        bytes = 0;
        int shoff = (int)U32(image, 32), shnum = U16(image, 48), names = (int)U32(image, shoff + U16(image, 50) * 40 + 16);
        for (int s = 0; s < shnum; s++)
        {
            int sh = shoff + s * 40;
            if (Text(image, names + (int)U32(image, sh)) != name) continue;
            bytes = (int)U32(image, sh + 20);
            return (int)U32(image, sh + 16);
        }
        return -1;
    }

    static bool Refuse(string why)
    {
        Refusal = why;
        return false;
    }

    static byte[]? Slurp(string path)
    {
        byte[] name = new byte[path.Length + 1];
        for (int i = 0; i < path.Length; i++) name[i] = (byte)path[i];
        int fd = (int)Sys.Syscall(Open, (SyscallWord)Sys.ArrayData(name), 0, 0);
        if (fd < 0) return null;
        // As large as the file, whatever it is: a kernel's is megabytes.
        byte[] buffer = new byte[1024 * 1024];
        int filled = 0;
        while (true)
        {
            if (filled == buffer.Length)
            {
                byte[] larger = new byte[buffer.Length * 2];
                for (int i = 0; i < filled; i++) larger[i] = buffer[i];
                buffer = larger;
            }
            int got = (int)Sys.Syscall(Read, (SyscallWord)fd, (SyscallWord)(Sys.ArrayData(buffer) + (nuint)filled), (SyscallWord)(buffer.Length - filled));
            if (got <= 0) break;
            filled += got;
        }
        Sys.Syscall(Close, (SyscallWord)fd, 0, 0);
        byte[] file = new byte[filled];
        for (int i = 0; i < filled; i++) file[i] = buffer[i];
        return file;
    }

    static string Text(byte[] bytes, int at)
    {
        int end = at;
        while (bytes[end] != 0) end++;
        char[] chars = new char[end - at];
        for (int i = at; i < end; i++) chars[i - at] = (char)bytes[i];
        return new string(chars);
    }

    static ushort U16(byte[] b, int at) => (ushort)(b[at] | (b[at + 1] << 8));
    static uint U32(byte[] b, int at) => (uint)b[at] | ((uint)b[at + 1] << 8) | ((uint)b[at + 2] << 16) | ((uint)b[at + 3] << 24);
}
