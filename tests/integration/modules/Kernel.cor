// A kernel in miniature, for tests/integration/modules.sh: a driver base
// class, the table drivers register in, and a log. It is linked with
// --exports, so a module compiled against its declarations calls these.

using System.Collections.Generic;
using System;

namespace Kernel;

public abstract class Driver
{
    public abstract string Name { get; }
    public virtual int Bind(int port) { return -1; }
}

public static class Drivers
{
    static List<Driver> _all = new List<Driver>();

    public static void Register(Driver driver)
    {
        _all.Add(driver);
        Log.Write("registered " + driver.Name);
    }

    public static int Count => _all.Count;

    /// The first driver, offered a device at `port`: a call into a module.
    public static int Bind(int port)
    {
        return _all.Count == 0 ? -1 : _all[0].Bind(port);
    }
}

// A KERNEL INTERFACE a module's class implements and the kernel calls
// through: its slots are the kernel's, whatever interfaces a module adds
// (Binder, a module's own tier) -- the several-file module's IAudio sorts
// before it, and numbered beside it moved Probe in the module's view.
public interface IDevice
{
    int Probe(int port);
}

public static class Devices
{
    static List<IDevice> _all = new List<IDevice>();

    public static void Add(IDevice device) { _all.Add(device); }

    public static int Count => _all.Count;

    public static int ProbeAll(int port)
    {
        int found = 0;
        foreach (IDevice device in _all) found += device.Probe(port);
        return found;
    }
}

public static class Log
{
    public static int Lines;

    public static void Write(string text)
    {
        Lines++;
        Host.Line(text);
    }
}

// THE KERNEL'S OWN ANSWER TO A MODULE'S LINUX FILE CALLS (--kernel-syscalls):
// a plain function every Sys.Syscall of such a module is a call of, saying
// what it was given so the test can see every argument arrived.
public static class KernelFiles
{
    public static SyscallWord Syscall(int number, SyscallWord a, SyscallWord b, SyscallWord c, SyscallWord d, SyscallWord e, SyscallWord f)
    {
        return (SyscallWord)number * 1000 + a + b + c + d + e + f;
    }
}

// A SMALL FUNCTION A MODULE CALLS: called, never copied into the module --
// a body copied across the boundary would not change with the kernel.
public static class Tick
{
    public static int Twice(int value) => value * 2 + Log.Lines;
}

// NOTHING CALLS IT, neither the kernel nor the module: an open kernel keeps
// it for modules nobody has built, and one linked with --keep, pruned to
// what it and its build's modules reach, does not.
public static class Unused
{
    public static string Never() { return "never " + Log.Lines; }
}

// RING 1'S, and left out of this ring-0 kernel before anything is bound:
// what it names exists only in a ring-1 image.
[Ring1]
public static class Seat
{
    public static int Paint() { return GuiKernel.Repaint(); }
}

static class Program
{
    static string _junk = "";

    static int Main()
    {
        Host.Start(32 * 1024 * 1024);
        Log.Write("kernel " + Drivers.Count);
        if (!Modules.Insmod("module.ko", "kernel"))
        {
            Log.Write("refused: " + Modules.Refusal);
            Host.Done(3);
        }
        foreach (string entry in Modules.Info) Log.Write("modinfo " + entry);
        Log.Write("drivers " + Drivers.Count);
        // What a collection frees is made again at once: a module whose
        // statics were not roots would find its string overwritten.
        GC.Collect();
        for (int i = 0; i < 20000; i++) _junk = "junk " + i;
        if (Devices.Count > 0) Log.Write("probe " + Devices.ProbeAll(0x220));
        Log.Write("bind " + Drivers.Bind(0x220));
        Host.Done(0);
        return 0;
    }
}
