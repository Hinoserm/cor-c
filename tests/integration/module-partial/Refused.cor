// What a module's part of a kernel's type may not declare, one at a time
// (the test defines one symbol, -D NAME, to select it): each changes what the kernel's image fixed or
// waits for a start only the kernel makes.

namespace Kernel;

#if KIND
public partial struct Uptime
#elif ATTR
[System.Obsolete]
public static partial class Uptime
#else
public static partial class Uptime
#endif
{
#if FIELD
    public int Count;
#endif
#if VIRTUAL
    public virtual int Spin() => 1;
#endif
#if INIT
    static int _more = 3;
#endif
#if STATIC
    static int _plain;
#endif
#if CCTOR
    static Uptime() { }
#endif
#if AUTO
    public int Rate { get; set; }
#endif
#if SAUTO
    public static int Rate { get; set; }
#endif
#if SEVENT
    public static event System.Action Fired;
#endif
#if EXPLICIT
    int System.IComparable.CompareTo(object other) => 0;
#endif
#if PARTIALM
    static partial void Hook();
#endif
    public static int Three() => 3;
}
