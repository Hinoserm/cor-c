static class Program
{
    static long Work(int count, long seed)
    {
        long sum = 0;
        for (int i = 0; i < count; i++)
        {
            long x = (seed + i) & 65535;
            long a = (x * 17) ^ (x >> 3);
            long b = (x * 17) ^ (x >> 3);
            sum += a + b;
        }
        return sum;
    }
    static long Reference(int count, long seed)
    {
        long sum = 0;
        for (int i = 0; i < count; i++)
        {
            long x = (seed + i) & 65535;
            sum += 2 * ((x * 17) ^ (x >> 3));
        }
        return sum;
    }
    static long BranchWork(int count, long seed)
    {
        long sum = 0;
        for (int i = 0; i < count; i++)
        {
            long x = (seed + i) & 65535;
            long first = (x * 17) ^ (x >> 3);
            if ((i & 1) == 0) sum += first + ((x * 17) ^ (x >> 3));
            else sum += first + ((x * 17) ^ (x >> 3)) + 1;
        }
        return sum;
    }
    static int Main()
    {
        string[] args = Environment.GetCommandLineArgs();
        int count = args.Length > 1 ? int.Parse(args[1]) : 1000000;
        long seed = args.Length > 2 ? long.Parse(args[2]) : 12345;
        bool branch = args.Length > 3 && args[3] == "branch";
        if (count < 1 || count > 10000000 || seed < 0 || seed > 1000000) return 2;
        long start = Stopwatch.GetTimestamp();
        long result = branch ? BranchWork(count, seed) : Work(count, seed);
        long elapsed = Stopwatch.GetTimestamp() - start;
        bool valid = result == Reference(count, seed) + (branch ? count / 2 : 0);
        Console.WriteLine("integer-reuse,branch=" + branch + ",iterations=" + count + ",ticks=" + elapsed
            + ",frequency=" + Stopwatch.Frequency + ",checksum=" + result + ",valid=" + valid);
        return valid ? 0 : 1;
    }
}
