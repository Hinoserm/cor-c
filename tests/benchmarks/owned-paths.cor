class PathOwner
{
    public byte[] Buffer;
    public int Salt;
}
static class Program
{
    // Exercise contextual delegate conversion as well as the direct calls.
    static Func<PathOwner, long> _reader = Read;
    static long Read(PathOwner owner) => owner.Buffer[0] + owner.Salt;
    static long Work(int count)
    {
        long sum = 0;
        for (int i = 0; i < count; i++)
        {
            PathOwner owner = new PathOwner();
            if ((i & 1) == 0) owner.Salt = i & 255;
            else owner.Salt = (i + 1) & 255;
            owner.Buffer = new byte[64];
            owner.Buffer[0] = (byte)i;
            sum += Read(owner);
        }
        return sum;
    }
    static int Main()
    {
        string[] args = Environment.GetCommandLineArgs();
        int count = args.Length > 1 ? int.Parse(args[1]) : 200000;
        if (count < 1 || count > 10000000) return 2;
        // Preserve the actual method entry, not just a delegate wrapper that
        // may inline it. Keep this check outside the measured interval.
        if (Sys.AddressOf(Read) == 0) return 4;
        PathOwner probe = new PathOwner(); probe.Buffer = new byte[1]; probe.Salt = 7;
        if (_reader(probe) != 7) return 3;
        long collections = Gc.Collections;
        long start = Stopwatch.GetTimestamp();
        long result = Work(count);
        long elapsed = Stopwatch.GetTimestamp() - start;
        long collected = Gc.Collections - collections;
        long expected = 0;
        for (int i = 0; i < count; i++) expected += (i & 255) + ((i + (i & 1)) & 255);
        bool valid = result == expected;
        Console.WriteLine("owned-paths,iterations=" + count + ",ticks=" + elapsed + ",frequency=" + Stopwatch.Frequency
            + ",collections=" + collected + ",checksum=" + result + ",valid=" + valid);
        return valid ? 0 : 1;
    }
}
