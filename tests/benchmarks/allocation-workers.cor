// Profile the real allocator under concurrent allocation and explicit reuse.
// Raw addresses deliberately exercise Runtime.Alloc/Free, not compiler escape
// elimination. A live guard on each side keeps the small free block separate.

using System;
using System.Threading;
using System.Diagnostics;

class AllocationWorker : Action
{
    public int Count;
    public bool Valid;
    public void Invoke()
    {
        // The payload's first and last four bytes: 32-bit fields, whatever the word.
        nuint left = Runtime.Alloc(32);
        nuint hole = Runtime.Alloc(32);
        nuint right = Runtime.Alloc(32);
        Sys.Write32(left, 111);
        Sys.Write32(right, 222);
        Runtime.Free(hole);
        bool okay = true;
        for (int i = 0; i < Count; i++)
        {
            int bytes = 1024 + (i & 7) * 8;
            nuint memory = Runtime.Alloc((nuint)bytes);
            nuint last = memory + (nuint)bytes - 4;
            if (Sys.Read32(memory) != 0 || Sys.Read32(last) != 0) okay = false;
            Sys.Write32(memory, (uint)(i + 1));
            Sys.Write32(last, (uint)(i + 2));
            if (Sys.Read32(memory) != (uint)(i + 1) || Sys.Read32(last) != (uint)(i + 2)) okay = false;
            Runtime.Free(memory);
        }
        if (Sys.Read32(left) != 111 || Sys.Read32(right) != 222) okay = false;
        Runtime.Free(right);
        Runtime.Free(left);
        Valid = okay;
    }
}
static class Program
{
    static int Main()
    {
        string[] args = Environment.GetCommandLineArgs();
        int count = args.Length > 1 ? int.Parse(args[1]) : 200000;
        int workers = args.Length > 2 ? int.Parse(args[2]) : 4;
        if (count < 1 || count > 10000000 || workers < 1 || workers > 32) return 2;
        AllocationWorker[] work = new AllocationWorker[workers];
        Thread[] threads = new Thread[workers];
        for (int i = 0; i < workers; i++) work[i] = new AllocationWorker { Count = count };
        Gc.Collect();
        long collections = Gc.Collections;
        long start = Stopwatch.GetTimestamp();
        for (int i = 0; i < workers; i++) threads[i] = Thread.Start(work[i]);
        bool valid = true;
        for (int i = 0; i < workers; i++)
        { threads[i].Join(); valid &= work[i].Valid; }
        long elapsed = Stopwatch.GetTimestamp() - start;
        long collected = Gc.Collections - collections;
        Sys.Print("allocation-workers,workers=" + workers + ",iterations-per-worker=" + count
            + ",ticks=" + elapsed + ",frequency=" + Stopwatch.Frequency
            + ",collections=" + collected + ",valid=" + valid + "\n");
        return valid ? 0 : 1;
    }
}
