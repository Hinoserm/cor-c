// test: ranges_of_arrays_need_no_using
// expect-exit: 0
// expect-output:
// 2,3 2,3,4 7,6 2
//
// A range of an array -- `a[r]` with a Range variable, `a[from..to]` -- is
// a copy made by RuntimeHelpers.GetSubArray, which the compiler names in
// full: a program without `using System.Runtime.CompilerServices;` was
// refused for the name the compiler wrote.
// Expected output from .NET 10.

using System;

static class Program
{
    static int Main()
    {
        int[] a = { 1, 2, 3, 4, 5 };
        Range r = 1..3;
        int from = 1, to = 4;
        byte[] b = { 9, 8, 7, 6 };
        Console.WriteLine(string.Join(",", a[r]) + " " + string.Join(",", a[from..to]) + " " + string.Join(",", b[2..]) + " " + a[..^3].Length);
        return 0;
    }
}
