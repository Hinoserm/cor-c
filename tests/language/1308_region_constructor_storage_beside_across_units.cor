// test: region_constructor_storage_beside_across_units
// units: tests/language/support/1308_region_constructor_storage_units.cor
// regions: taken
// expect-exit: 0
// expect-output:
// total 1182900 first arrays in the region True
//
// A collection made in a region made its first arrays -- a Dictionary's
// keys, values, states and hashes, a HashSet's three, a Queue's items, a
// List's items for a capacity, a StringBuilder's buffer -- on the heap: its
// constructor stores them into the fields its growth replaces them in, and
// only the growth was made beside its owner. Now the constructor's are too
// (RegionPointsTo.MakeStorageBeside): in the collection's region when it is
// in one. Made.Fill is a boundary, and its five collections are its
// region's; filled within the room their constructors made, they grow
// nothing but the Dictionary's list of what went in, in order (two arrays).
// Dictionary and HashSet now make their tables at the first write (as
// .NET's do) and keep a slot's state in its hash: their arrays are all
// growth's, beside their collections either way. So a call makes twelve
// blocks in its region with the Queue's, List's and StringBuilder's first
// arrays beside their collections, and nine without (Gc.RegionBlocks):
// twelve or more says they are there. Everything is read back after a collection.

using System;
using System.Runtime.CompilerServices;

static class P
{
    // Not Main itself: what the entry calls is never a boundary.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Run()
    {
        long total = 0, before = Gc.RegionBlocks;
        for (int round = 0; round < 200; round++) total += Made.Fill(round);
        long perCall = (Gc.RegionBlocks - before) / 200;
        Console.WriteLine("total " + total + " first arrays in the region " + (perCall >= 12));
        return 0;
    }

    static int Main() => Run();
}
