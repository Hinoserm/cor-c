// test: generic_library_types_named_under_their_usings
// expect-exit: 0
// expect-output:
// 0 2 0 3 1
//
// Under its namespace's using, a generic library type is named both ways:
// as a type and before a static member, `ReadOnlySpan<byte>.Empty` in a
// conditional beside a slice, as the kernel's mount options are read.
using System;
using System.Collections.Generic;

static class Program
{
    static int Length(ReadOnlySpan<byte> bytes) => bytes.Length;

    static int Main()
    {
        ReadOnlySpan<byte> option = new ReadOnlySpan<byte>(new byte[] { 1, 2, 3 });
        int equal = -1;
        ReadOnlySpan<byte> none = equal < 0 ? ReadOnlySpan<byte>.Empty : option.Slice(equal + 1);
        equal = 0;
        ReadOnlySpan<byte> value = equal < 0 ? ReadOnlySpan<byte>.Empty : option.Slice(equal + 1);
        List<int> list = new List<int> { 1, 2, 3 };
        Func<int> one = () => 1;
        Console.WriteLine(Length(none) + " " + Length(value) + " " + Span<int>.Empty.Length + " " + list.Count + " " + one());
        return 0;
    }
}
