// test: a call by a function's address passes its words in registers, as a call by its name does
// only-target: x86
// expect-exit: 0
// expect-output:
// virtual 800 2200 2800
// interface 9 14 20
// delegate 7 30 600
// direct 7 30 600
// word 123 12 1 0
// pushed 506 506 77
//
// A function of one to three words takes them in EAX, EDX and ECX however
// it is reached (the x86 backend's RegisterArgs): by its name, through a
// descriptor's slot -- a virtual or an interface method -- through a
// delegate, or through a word (Sys.Call, which passes three: a function of
// fewer reads as many as it has). It has the one entry, under its name, and
// nothing between a caller and its body. Here every such call, of one, two
// and three arguments. And the method code not of this language calls by
// its address, its arguments pushed as C pushes them ([StackArguments]):
// called so (Sys.CallNative), and by its name, where the caller pushes
// them too. 2629_calls_by_address_in_registers.sh reads the image.

using System;
using System.Runtime.CompilerServices;

abstract class Shape
{
    public abstract int One(int a);
    public abstract int Two(int a, int b);
    public abstract int Three(int a, int b, int c);
}

sealed class Sum : Shape
{
    public override int One(int a) => a + 1;
    public override int Two(int a, int b) => a + b;
    public override int Three(int a, int b, int c) => a + b + c;
}

sealed class Product : Shape
{
    public override int One(int a) => a * 2;
    public override int Two(int a, int b) => a * b;
    public override int Three(int a, int b, int c) => a * b * c;
}

interface IWeigh { int Weigh(int a, int b); }
sealed class Light : IWeigh { public int Weigh(int a, int b) => a - b; }
sealed class Heavy : IWeigh { public int Weigh(int a, int b) => a * 10 + b; }

static class Program
{
    static int Plus(int a) => a + 5;
    static int Times(int a, int b) => a * b;
    static int Volume(int a, int b, int c) => a * b * c;

    static int Main()
    {
        Shape[] shapes = { new Sum(), new Product(), new Sum(), new Product() };
        int one = 0, two = 0, three = 0;
        for (int i = 0; i < 400; i++)
        {
            Shape s = shapes[i & 3];
            one += s.One(1);
            two += s.Two(2, 3);
            three += s.Three(1, 2, 3) + 1;
        }
        Console.WriteLine("virtual " + one + " " + two + " " + three);

        IWeigh[] weights = { new Light(), new Heavy() };
        Console.WriteLine("interface " + (weights[0].Weigh(12, 3)) + " " + (weights[1].Weigh(1, 4)) + " " + (weights[0].Weigh(9, 3) + weights[1].Weigh(1, 4)));

        Func<int, int> plus = Plus;
        Func<int, int, int> times = Times;
        Func<int, int, int, int> volume = Volume;
        Console.WriteLine("delegate " + plus(2) + " " + times(5, 6) + " " + volume(10, 20, 3));
        Console.WriteLine("direct " + Plus(2) + " " + Times(5, 6) + " " + Volume(10, 20, 3));

        Console.WriteLine("word " + Sys.Call(Sys.AddressOf(Program.Digits), 1, 2, 3) + " " + Sys.Call(Sys.AddressOf(Program.Pair), 1, 2, 3)
            + " " + Sys.Call(Sys.AddressOf(Program.Single), 1, 2, 3) + " " + Sys.Call(Sys.AddressOf(Program.None), 1, 2, 3));
        Console.WriteLine("pushed " + Sys.CallNative(Sys.AddressOf(Program.Pushed), 5, 6) + " " + Pushed(5, 6) + " " + Sys.CallNative(Sys.AddressOf(Program.PushedOne), 77));
        return 0;
    }

    [MethodImpl(MethodImplOptions.NoInlining)] static nuint Digits(nuint a, nuint b, nuint c) => a * 100 + b * 10 + c;
    [MethodImpl(MethodImplOptions.NoInlining)] static nuint Pair(nuint a, nuint b) => a * 10 + b;
    [MethodImpl(MethodImplOptions.NoInlining)] static nuint Single(nuint a) => a;
    [MethodImpl(MethodImplOptions.NoInlining)] static nuint None() => 0;

    [StackArguments, MethodImpl(MethodImplOptions.NoInlining)]
    static nuint Pushed(nuint a, nuint b) => a * 100 + b;

    [StackArguments, MethodImpl(MethodImplOptions.NoInlining)]
    static nuint PushedOne(nuint a) => a;
}
