// test: linq_consumer_hands_walk_to_sinks_across_units
// units: tests/language/support/2057_sink_units.cor
// expect-exit: 0
// expect-output:
// control odd 100000 True
// fed 9000 1,2,3,4,5
// called 1000 -6,-4,-2,0,2,4,6,8,10
// into 9000 1,2,3,4,5
// out 1,2,3,4,5
// boxed 9000 -3,-2,-1,0,1,2,3,4,5
//
// Another unit's consumer handing the walk on: to a sink of this unit
// through an interface, to a delegate of this unit, into an object this unit
// passed, out through an `out` parameter. And a struct of this unit holding
// a list, boxed as it is handed to the other unit's Sum, whose GetEnumerator
// keeps the list: the box keeps nothing, the word in it does.

using System;
using System.Collections;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

sealed class Keeper : ISink
{
    public IEnumerable<int>? Kept;

    public void Take(IEnumerable<int> walk) { Kept = walk; }
}

struct Wrap : IEnumerable<int>
{
    public static List<int>? Inner;
    readonly List<int> _list;

    public Wrap(List<int> list) { _list = list; }

    public IEnumerator<int> GetEnumerator()
    {
        Inner = _list;
        return _list.GetEnumerator();
    }

    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
}

static class P
{
    static List<int> Make(int n) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(i - 3); return l; }

    // What each call left to the collector, and whether the program gave
    // memory back itself meanwhile: frees, or a region's end (1211's measure).
    static string Measure(Func<int, int> f, out long total)
    {
        const int N = 20000;
        total = 0;
        Gc.Collect();
        long taken = Gc.CollectedBytes, frees = Gc.Frees, region = Gc.RegionFreedBytes + Gc.RegionTopFreedBytes;
        for (int k = 0; k < N; k++) total += f(9);
        bool given = Gc.Frees - frees >= N || Gc.RegionFreedBytes + Gc.RegionTopFreedBytes - region >= N * 16;
        Gc.Collect();
        long left = (Gc.CollectedBytes - taken) / N;
        return given && left <= 32 ? "True" : "False " + left;
    }

    static void Say(string name, Func<int, int> f)
    {
        string freed = Measure(f, out long total);
        Console.WriteLine(name + " " + total + " " + freed);
    }

    static List<int> MakeAt(int n, int at) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(at + i); return l; }

    // WHAT A BLOCK FREED TOO SOON BECOMES: lists of the kept ones' shape and
    // arrays of their arrays' sizes, other numbers in them, made and held while
    // the kept ones are read. Under verified frees such a block is poisoned
    // instead, and a second free ends the run.
    static readonly List<int>[] JunkLists = new List<int>[4096];
    static readonly int[][] JunkArrays = new int[4096][];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkLists.Length; k++)
        {
            JunkLists[k] = MakeAt(9, 100);
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
        }
        Gc.Collect();
    }

    // A thousand calls, their results added: the last call's object is the one read afterwards.
    static long Rounds(Func<int, int> f) { long t = 0; for (int k = 0; k < 1000; k++) t += f(9); return t; }

    static string Show(IEnumerable<int>? s) => s is null ? "null" : string.Join(",", s);

    static string Rest(IEnumerator<int> e) { string s = ""; while (e.MoveNext()) s += (s.Length > 0 ? "," : "") + e.Current; return s; }

    static readonly Keeper TheKeeper = new();
    static readonly Box TheBox = new();
    static IEnumerable<int>? _called;

    static int Use(IEnumerable<int> w)
    {
        _called = w;
        return 1;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Odd(int n) => Sinks.Odd(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Fed(int n) => Sinks.Feed(Make(n), TheKeeper);
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Called(int n) => Sinks.Call(Make(n), Use);
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Into(int n) => Sinks.Into(Make(n), TheBox);
    [MethodImpl(MethodImplOptions.NoInlining)]
    static string Outed() { Sinks.Out(Make(9), out IEnumerable<int> w); Churn(); return Show(w); }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Boxed(int n) => Sinks.Total(new Wrap(Make(n)));

    static void Main()
    {
        Say("control odd", Odd);
        long fed = Rounds(Fed), called = Rounds(Called), into = Rounds(Into), boxed = Rounds(Boxed);
        Churn();
        Console.WriteLine("fed " + fed + " " + Show(TheKeeper.Kept));
        Console.WriteLine("called " + called + " " + Show(_called));
        Console.WriteLine("into " + into + " " + Show(TheBox.Lazy));
        Console.WriteLine("out " + Outed());
        Console.WriteLine("boxed " + boxed + " " + Show(Wrap.Inner));
    }
}
