// test: a nullable bool's ToString, called or null-conditional, is Nullable's own
// expect-exit: 0
// expect-output:
// unknown none   u
// False 10 False 10 False
// True 20 True 20 True
//
// `b.ToString()` and `b?.ToString()` over a `bool?` were rewritten to
// String.FromBool, which takes a bool, and refused: the bool arm took a
// nullable one where the char and number arms leave theirs to Nullable,
// which answers the empty string without a value. The compiler's own
// VirtualTargets refused to build in its self-compile.
using System;
static class Program
{
    static bool? Maybe(int i) => i == 0 ? null : i > 1;
    static int Main()
    {
        for (int i = 0; i < 3; i++)
        {
            bool? b = Maybe(i);
            int? n = i == 0 ? null : i * 10;
            Console.WriteLine((b?.ToString() ?? "unknown") + " " + (n?.ToString() ?? "none") + " " + b.ToString() + " " + n.ToString() + " " + (Maybe(i)?.ToString() ?? "u"));
        }
        return 0;
    }
}
