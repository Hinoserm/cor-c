    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int UseV_Carry_double(BoxV b) => b.A![0] + b.A[b.A.Length - 1];

    static void Main()
    {
        { long r = Carry_int(1000, 6); Console.WriteLine("carry int " + (r / 1000) + " bad " + (r % 1000)); }
        { long r = Carry_long(1000, 6); Console.WriteLine("carry long " + (r / 1000) + " bad " + (r % 1000)); }
        { long r = Carry_bool(1000, 6); Console.WriteLine("carry bool " + (r / 1000) + " bad " + (r % 1000)); }
        { long r = Carry_char(1000, 6); Console.WriteLine("carry char " + (r / 1000) + " bad " + (r % 1000)); }
        { long r = Carry_double(1000, 6); Console.WriteLine("carry double " + (r / 1000) + " bad " + (r % 1000)); }
    }
