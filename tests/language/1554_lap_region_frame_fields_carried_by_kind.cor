    [MethodImpl(MethodImplOptions.NoInlining)]
    static int[] MakeArr_Carry_double(int v, int n) { int[] a = new int[n]; for (int k = 0; k < n; k++) a[k] = v + k; return a; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int[] Probe_Carry_double(int lap, int m) { int[] a = new int[m]; for (int k = 0; k < m; k++) a[k] = lap * 100 + k + 77; return a; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int UseA_Carry_double(BoxA b) => b.A![0] + b.A[b.A.Length - 1] + b.Tag;
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Fill_Carry_double(BoxA b, int v, int n) { b.A = MakeArr_Carry_double(v, n); b.Tag = v; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Check_Carry_double(int[] l, int lap)
    {
        for (int k = 0; k < l.Length; k++) if (l[k] != lap * 100 + k + 77) return 1;
        return 0;
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Carry_double(int laps, int m)
    {
        long sum = 0; int bad = 0; double last = default(double);
        for (int lap = 0; lap < laps; lap++)
        {
            int[]? probe = null;
            if ((lap & 1) == 1) probe = Probe_Carry_double(lap, m);
            BoxV b = new BoxV();
            b.A = MakeArr_Carry_double(lap, m);
            b.V_double = Conv_double(lap);
            sum += UseV_Carry_double(b) + (last.Equals(default(double)) ? 0 : 1);
