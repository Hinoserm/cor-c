// test: inline_asm_esp_copied_refused
// only-target: x86
// expect-compile-error: may not read ESP as a value
//
// ESP copied into a register: a write through the copy could change what
// PUSHF or PUSHAD saved unseen -- DF, EBP (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static int Main()
    {
        asm
        {
            pushfd
            mov ebx, esp
            or dword [ebx], 0x400
            popfd
        }
        return 0;
    }
}
