//
// DateTime's and DateTimeOffset's readers as .NET's. THE FREE READER is
// .NET's own state machine: month and day names in any case and either
// length, the invariant culture's orders (month before day, year before
// month, month-day-year), two-digit years to 2049, AM and PM, 'T' times,
// zones by Z, GMT or an offset, CJK suffixes, '#' literals, and .NET's
// messages for an unknown word, a wrong day of the week, a date the calendar
// lacks or one out of range. THE EXACT READER takes every standard format
// and custom picture, with "o" and "r" read by .NET's quick readers. The
// styles are checked, and applied, in .NET's order. The constructors and the
// arithmetic refuse what the calendar cannot hold, in .NET's order and
// words. Zones are read to UTC and today and this year are written as words,
// so that no line depends on the machine's zone or the date; every line came
// from the same program on .NET 10.

using System;
using System.Globalization;

class Program
{
    // TODAY AND THIS YEAR, which a text with no date or no year takes, are
    // written as words, so that the lines stay true.
    static string Show(DateTime d)
    {
        string text = d.ToString("yyyy-MM-ddTHH:mm:ss.fffffff") + " " + d.Kind;
        DateTime now = DateTime.Now;
        DateTime utc = DateTime.UtcNow;
        return text.Replace(now.ToString("yyyy-MM-dd"), "TODAY").Replace(utc.ToString("yyyy-MM-dd"), "TODAY")
            .Replace(now.ToString("yyyy"), "YEAR").Replace(utc.ToString("yyyy"), "YEAR");
    }

    static string Said(Func<string> f)
    {
        try { return f(); }
        catch (Exception e) { return e.GetType().Name + ": " + e.Message; }
    }

    static int Main()
    {
        CultureInfo inv = CultureInfo.InvariantCulture;
        DateTimeStyles utc = DateTimeStyles.AdjustToUniversal;

        // The free reader: names, orders, two-digit years, AM and PM, zones, CJK suffixes.
        string[] free = {
            "Tuesday, 05 March 2024", "March 5, 2024", "5 March 2024", "March 2024", "2024 March", "5 March", "Mar 5 2024 10:00 PM",
            "05-Mar-2024", "5-Mar-24", "Mar-05-2024", "2024-Mar-05", "05/Mar/2024", "Tuesday March 5 2024", "5 March 24", "24 March 5",
            "September 5 2024", "sep 5 2024", "MARCH 5 2024", "March, 5 2024", "5 Mar 2024 2:07:09 PM", "Mon Jan 1 2024", "1 Jan",
            "2024 5 Jan", "5 2024 Jan", "3/5/2024 2:07 PM", "2024/03/05", "1/2/3", "2024-03-05T14:07:09", "2024-03-05 14:07:09.5",
            "#3/5/2024#", "2024年3月5日", "12:30:45.123 2024-03-05", "2024-03-05 12 PM", "2024-03-05T14", "2024-03-05T25:00:00",
            "Wednesday, 05 March 2024", "March 32, 2024", "Sept 5 2024", "Tues 5 March 2024", "March", "March 5th 2024", "Jan 5 2024 Jan",
            "13:00 AM 2024-03-05", "2024-03-05 10:00 +02:00 GMT", "", "   ", "12345678901",
        };
        foreach (string s in free)
        {
            Console.WriteLine("[" + s + "] " + Said(() => Show(DateTime.Parse(s, inv))) + " | " + Said(() => Show(DateTime.Parse(s, inv, utc))));
        }

        // Zones, read to UTC so that the machine's own does not show.
        string[] zoned = {
            "Tue, 05 Mar 2024 14:07:09 GMT", "March 5 2024 GMT", "Mar 5 2024 +02:00", "2024-03-05T14:07:09.1234567Z",
            "2024-03-05T14:07:09+05:30", "2024-03-05 14:07:09.5-03:00", "2024-03-05 10:00 +0530", "2024-03-05 10:00 -5",
            "2024-03-05 10:00 +15:00", "2024-03-05 10:00 Z GMT", "0001-01-01T00:00:00+05:00", "10:00 2024-03-05Z",
        };
        foreach (string s in zoned)
        {
            Console.WriteLine("[" + s + "] " + Said(() => Show(DateTime.Parse(s, inv, utc))) + " | " + Said(() => DateTime.Parse(s, inv, DateTimeStyles.RoundtripKind).Kind.ToString())
                + " | " + Said(() => DateTimeOffset.Parse(s, inv, DateTimeStyles.AssumeUniversal).ToString("o")));
        }

        Console.WriteLine(Said(() => Show(DateTime.Parse("9999-12-31T23:59:59-05:00", inv, utc))));

        // The styles, and what a date with none becomes.
        Console.WriteLine(Show(DateTime.Parse("10:30", inv, DateTimeStyles.NoCurrentDateDefault)) + " | " + Show(DateTime.Parse("2024-03-05", inv, DateTimeStyles.AssumeUniversal | utc))
            + " | " + Show(DateTime.Parse("2024-03-05", inv, DateTimeStyles.AssumeLocal)) + " | " + Show(DateTime.Parse(" 2024-03-05 ", inv, DateTimeStyles.None)));
        Console.WriteLine(Said(() => DateTime.Parse("x", inv, (DateTimeStyles)256).ToString()) + " | " + Said(() => DateTime.Parse("x", inv, DateTimeStyles.AssumeLocal | DateTimeStyles.AssumeUniversal).ToString())
            + " | " + Said(() => DateTime.ParseExact("x", "d", inv, DateTimeStyles.RoundtripKind | utc).ToString()));
        Console.WriteLine(Said(() => DateTimeOffset.Parse("x", inv, DateTimeStyles.NoCurrentDateDefault).ToString()) + " | "
            + Said(() => DateTimeOffset.Parse("x", inv, DateTimeStyles.NoCurrentDateDefault | DateTimeStyles.AssumeLocal | DateTimeStyles.AssumeUniversal).ToString())
            + " | " + Said(() => DateTimeOffset.Parse("March 5 +02:00", inv).ToString()));
        Console.WriteLine(Said(() => DateTime.Parse(null!).ToString()) + " | " + Said(() => DateTime.ParseExact("x", (string[])null!, inv, DateTimeStyles.None).ToString())
            + " | " + Said(() => DateTime.ParseExact("x", new string[0], inv, DateTimeStyles.None).ToString()) + " | " + Said(() => DateTime.ParseExact("x", "", inv).ToString()));

        // The exact reader: standard formats both ways, pictures, and its refusals.
        DateTime d = new DateTime(2024, 3, 5, 14, 7, 9, 123, DateTimeKind.Utc);
        foreach (string f in new[] { "o", "r", "s", "u", "d", "D", "f", "F", "g", "G", "m", "t", "T", "y" })
        {
            string text = d.ToString(f, inv);
            Console.WriteLine(f + " [" + text + "] " + Said(() => Show(DateTime.ParseExact(text, f, inv, utc))) + " | " + Said(() => Show(DateTimeOffset.ParseExact(text, f, inv, DateTimeStyles.AssumeUniversal).UtcDateTime)));
        }
        string[] exact = {
            "2024-02-30T00:00:00.0000000", "o", "2024-03-05T14:07:09.1230000+5:30", "o", "Wed, 05 Mar 2024 14:07:09 GMT", "r",
            "tue, 05 mar 2024 14:07:09 GMT", "r", "Tue, 05 Mar 2024 14:07:09 gmt", "r", "05.03.2024 14:07", "dd.MM.yyyy HH:mm",
            "20240305", "yyyyMMdd", "5/3/49", "d/M/yy", "5/3/50", "d/M/yy", "5/3/2024", "d/M/yy", "2024-003-05", "yyyy-M-d",
            "MARCH 05 2024", "MMM dd yyyy", "Wed 05 Mar 2024", "ddd dd MMM yyyy", "14:07 PM", "HH:mm tt", "2:07 PM", "h:mm tt",
            "12:07 AM", "hh:mm tt", "09.5", "ss.FFF", "09", "ss.FFF", "09", "ss.F", "a", "'abc", "x", "x",
            "2024-03-05 +05", "yyyy-MM-dd z", "2024-03-05 +05:30 +05:30", "yyyy-MM-dd zzz zzz", "2024-03-05 +05:30 +05:00", "yyyy-MM-dd zzz zzz",
            "  2024 - 03 - 05  ", "yyyy-MM-dd", "A.D. 2024", "g yyyy",
        };
        for (int i = 0; i < exact.Length; i += 2)
        {
            string s = exact[i], f = exact[i + 1];
            Console.WriteLine(f + " [" + s + "] " + Said(() => Show(DateTime.ParseExact(s, f, inv, utc))) + " | " + Said(() => Show(DateTime.ParseExact(s, f, inv, DateTimeStyles.AllowWhiteSpaces | utc))));
        }
        DateTime got;
        Console.WriteLine(DateTime.TryParseExact("2024-03-05", new[] { "d", "yyyy-MM-dd" }, inv, DateTimeStyles.None, out got) + " " + Show(got) + " | "
            + DateTime.TryParse("nope", out got) + " " + Show(got) + " | " + DateTime.TryParse("2024-03-05".AsSpan(), inv, out got) + " " + Show(got)
            + " | " + DateTime.ParseExact("05/03/2024".AsSpan(), "dd/MM/yyyy".AsSpan(), inv).ToString("o"));

        // Strings back: the short and long forms.
        Console.WriteLine(d.ToShortDateString() + " | " + d.ToLongDateString() + " | " + d.ToShortTimeString() + " | " + d.ToLongTimeString());

        // The calendar's checks, in .NET's order and words.
        Console.WriteLine(Said(() => new DateTime(2024, 2, 30).ToString()));
        Console.WriteLine(Said(() => new DateTime(2024, 2, 3, 24, 0, 0).ToString()));
        Console.WriteLine(Said(() => new DateTime(2024, 13, 3, 25, 0, 0, 1000).ToString()));
        Console.WriteLine(Said(() => new DateTime(2024, 1, 3, 0, 0, 0, (DateTimeKind)7).ToString()));
        Console.WriteLine(Said(() => new DateTime(-1).ToString()) + " | " + Said(() => new DateTime(0, (DateTimeKind)3).ToString()));
        Console.WriteLine(Said(() => new DateTime(2024, 1, 3, 1, 2, 3, 4, 5).ToString("o")) + " | " + new DateTime(2024, 1, 3, 1, 2, 3, 4, 5).Microsecond + " " + new DateTime(638000000000000007).Nanosecond);
        Console.WriteLine(Said(() => DateTime.MaxValue.AddTicks(1).ToString()) + " | " + Said(() => DateTime.MinValue.AddDays(-1).ToString()));
        Console.WriteLine(Said(() => DateTime.MaxValue.AddDays(4e6).ToString()) + " | " + Said(() => (DateTime.MaxValue + TimeSpan.FromDays(1)).ToString()));
        Console.WriteLine(Said(() => DateTime.MinValue.Subtract(TimeSpan.FromDays(1)).ToString()) + " | " + Said(() => DateTime.MinValue.AddMonths(-1).ToString()));
        Console.WriteLine(Said(() => DateTime.MinValue.AddMonths(120001).ToString()) + " | " + Said(() => DateTime.MaxValue.AddYears(1).ToString()) + " | " + Said(() => DateTime.MinValue.AddYears(10001).ToString()));
        Console.WriteLine(Said(() => DateTime.DaysInMonth(2024, 13).ToString()) + " | " + Said(() => DateTime.DaysInMonth(10000, 1).ToString()) + " | " + Said(() => DateTime.IsLeapYear(0).ToString()));
        DateTime leap = new DateTime(2024, 2, 29, 10, 30, 0, DateTimeKind.Local);
        Console.WriteLine(leap.AddYears(1).ToString("s") + " " + leap.AddYears(1).Kind + " " + leap.AddMonths(-13).ToString("s") + " " + new DateTime(2024, 1, 31).AddMonths(1).ToString("s")
            + " " + new DateTime(2024, 1, 1).AddDays(1.1).Ticks + " " + new DateTime(2024, 1, 1).AddHours(-0.3).Ticks + " " + new DateTime(2024, 1, 1).AddMilliseconds(0.5).Ticks
            + " " + new DateTime(2024, 1, 1).AddMicroseconds(2.5).Ticks);
        DateTimeOffset o = new DateTimeOffset(2024, 3, 5, 14, 7, 9, TimeSpan.FromHours(2));
        Console.WriteLine(o.AddSeconds(1.5).ToString("o") + " " + (o + TimeSpan.FromDays(1)).ToString("o") + " " + (o - TimeSpan.FromDays(1)).ToString("o") + " " + o.Subtract(o.AddHours(-1))
            + " " + Said(() => DateTimeOffset.MaxValue.AddSeconds(1).ToString()) + " | " + Said(() => (DateTimeOffset.MinValue - TimeSpan.FromTicks(1)).ToString()));
        return 0;
    }
}
