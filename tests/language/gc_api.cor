// test: gc api
// expect-exit: 0
// expect-output:
// max 0
// collected True
// generation 0
// memory True
// null ArgumentNullException
// negative ArgumentOutOfRangeException
//
// System.GC as .NET names it, over a collector of one generation.

using System;
using System.Collections.Generic;

static class Program
{
    static int Main()
    {
        Console.WriteLine("max " + GC.MaxGeneration);
        int before = GC.CollectionCount(0);
        List<object> garbage = new List<object>();
        for (int i = 0; i < 1000; i++) garbage.Add(new object());
        garbage = new List<object>();
        GC.Collect();
        Console.WriteLine("collected " + (GC.CollectionCount(0) > before));
        object kept = new object();
        Console.WriteLine("generation " + GC.GetGeneration(kept));
        Console.WriteLine("memory " + (GC.GetTotalMemory(true) > 0));
        GC.KeepAlive(kept);
        try { GC.SuppressFinalize(null!); }
        catch (ArgumentNullException e) { Console.WriteLine("null " + e.GetType().Name); }
        try { GC.Collect(-1); }
        catch (ArgumentOutOfRangeException e) { Console.WriteLine("negative " + e.GetType().Name); }
        return 0;
    }
}
