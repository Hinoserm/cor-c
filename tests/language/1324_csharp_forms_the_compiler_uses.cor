// test: csharp_forms_the_compiler_uses
// expect-exit: 0
// expect-output:
// records True 4 False x2 7 True
// switch null neg bit small7 big empty s3 tok3 other other
// lists none one4 ends13
// tuples-switch zero pos-yes no neg-yes
// patterns True True True True
// nested base derived other word 21 15 104 1 1 1 3
// functions 5 42 49 16 -4 55
// ranges 2,3,4,9 5 2 bc ef 0 12
// tuples 3n 1one a1,b2 21 True
// spans 15 99 10 100 ell 7,3,7,7 True True
// linq1 50,30,80,90 1,2,3,5,8,9 9,8 28 9 1 2 True True
// linq2 8 0 2 9,2 5,3 2,9,1,8,3,5 True a5 7 0 7
// linq3 3:1,4:3,5:1 3 True fig,kiwi,pear,plum,apple pafpk fig 2 apple none
// linq4 1,2,3 2 10 zzz False none 2
// strings True True 5 8 World Hello, There hello, world a|b||c 3
// strings2 14 14 True True True True aXbc abef 007 False True True True 3.14|   42|FF a "q" b <x1 3
// collections 3,4 True True True 1 9 3,5,7 a,b 2 1 p 1 high1 -1 0
// list-apis 4,2,1 2 2 1,2 1 True 2 2 False
// arrays 0,0,3,3,3,0 3,3,3 2 2 0
// comparers 2 1 2 a,bb,ccc
// math 7 -2 9 10 3 8 10 True True 1 AB01 255 10
// binary 4 1 16909060 -1 1027 True 2 hi ok
// hash BA7816BF8F01CFEA True True
// exceptions True overflow filtered maybe 11
// threads 0,2,4,6 10 4 105 6 3 6 True 5 0
// runtime True 41 42 True True 1 1 1
// misc True 5 7 4,6 True square 9 set 3 Level 0 3 42 8 10
// text a#b# val True a\.b dir/file.txt z.cs z /x/y a.o True
//
// A CANARY: in small form, the C# the compiler's and the linker's own
// sources are written in -- records and init and required members, switch
// expressions and every pattern kind they use, nested types' name lookup,
// local functions, static lambdas and method groups, collection
// expressions and spreads, ranges and indices, tuples, ref locals and
// returns, spans and stackalloc, the LINQ operators, string and collection
// APIs, bits and binary primitives, hashing, checked arithmetic,
// exception filters, iterators, async, threads and their primitives,
// Stopwatch, the collector's APIs, ConditionalWeakTable, regular
// expressions and paths. Each line is what .NET prints. A line that differs
// is a form the compiler cannot yet build itself with.

using System;
using System.Buffers.Binary;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Numerics;
using System.Runtime;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Threading.Tasks;

namespace Canary;

public sealed record Token(string Kind, int Line);

public record struct Span2(int Start, int Length)
{
    public int End => Start + Length;
}

public sealed class Options
{
    public required string Name { get; init; }
    public int Level { get; init; } = 2;
}

public readonly record struct Vec(int X, int Y)
{
    public static Vec operator +(Vec a, Vec b) => new(a.X + b.X, a.Y + b.Y);
}

[Flags]
public enum Mode { None = 0, Read = 1, Write = 2, Exec = 4 }

public interface IShape { string Name(); }

public sealed class Square : IShape
{
    string IShape.Name() => "square";
}

public sealed class Notifier
{
    public event Action<int>? Fired;
    public void Fire(int v) => Fired?.Invoke(v);
}

public sealed class Accumulator
{
    private int _sum;
    public int Add(int x) => _sum += x;
    public static int Neg(int x) => -x;
}

public sealed class ModComparer : IEqualityComparer<int>
{
    public bool Equals(int x, int y) => x % 3 == y % 3;
    public int GetHashCode(int x) => x % 3;
}

public sealed class LengthComparer : IComparer<string>
{
    public int Compare(string? a, string? b) => a!.Length.CompareTo(b!.Length);
}

public static class Outer
{
    private const int Base = 10;
    private const string Word = "w";
    private static int Secret() => 5;
    private static int Size(int x) => x + 100;
    private static bool IsGuard(int x) => x < 0;

    public static class Inner
    {
        public const int Derived = Base * 2 + 1;
        public static string Arm(int c) => c switch { Base => "base", Derived => "derived", _ => "other" };
        public static string Text(string s) => s switch { Word => "word", _ => "none" };
        private static int Hidden => Base;
        public static int Read() => Hidden + Secret();
    }

    // A field of the nested type named as the outer method: an invocation
    // passes it by, a read finds it.
    public sealed class Sized
    {
        private int Size = 1;
        public int Call() => Size(3) + Size;
    }

    // One method group, from an instance method and from a static one.
    public sealed class Guards
    {
        private readonly int[] _p = { 3, -1, 4, -5 };
        public int Again() => Array.FindIndex(_p, IsGuard);
        public static int Find(int[] path) => Array.FindIndex(path, IsGuard);
        public static int Last(int[] path) => Array.FindLastIndex(path, IsGuard);
    }
}

public static class Program
{
    [ThreadStatic] private static int t_value;

    private static void Say(params object?[] parts) => Console.WriteLine(string.Join(" ", parts));

    private static string Classify(object? o) => o switch
    {
        null => "null",
        int n when n < 0 => "neg",
        int and (0 or 1) => "bit",
        int n and >= 2 and < 10 => "small" + n,
        int => "big",
        string { Length: 0 } => "empty",
        string s => "s" + s.Length,
        Token { Kind: "ident", Line: > 2 } tk => "tok" + tk.Line,
        _ => "other",
    };

    private static string Ends(int[] a) => a switch
    {
        [] => "none",
        [var only] => "one" + only,
        [var first, .., var last] => "ends" + first + last,
    };

    private static string Pair(int a, bool b) => (a, b) switch
    {
        (0, _) => "zero",
        (> 0, true) => "pos-yes",
        (_, false) => "no",
        _ => "neg-yes",
    };

    private static IEnumerable<int> Evens(int n)
    {
        for (int i = 0; i < n; i++)
        {
            if (i % 2 == 1) continue;
            yield return i;
        }
    }

    private static async Task<int> SumAsync(int n)
    {
        await Task.Yield();
        int s = 0;
        for (int i = 1; i <= n; i++) s += i;
        return s;
    }

    private static T Largest<T>(params T[] xs) where T : IComparable<T>
    {
        T best = xs[0];
        foreach (T x in xs) if (x.CompareTo(best) > 0) best = x;
        return best;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private static int Twice(int x) => x * 2;

    public static int Main()
    {
        // ---- records, init, required, with
        Token t = new("ident", 3);
        Token u = t with { Line = 4 };
        Options o = new() { Name = "x" };
        Span2 sp = new(2, 5);
        Span2 narrowed = sp with { Length = 1 };
        Say("records", t == new Token("ident", 3), u.Line, t.Equals(u), o.Name + o.Level, sp.End, narrowed == new Span2(2, 1));

        // ---- switch expressions and patterns
        Say("switch", Classify(null), Classify(-5), Classify(1), Classify(7), Classify(42), Classify(""), Classify("abc"),
            Classify(new Token("ident", 3)), Classify(new Token("ident", 1)), Classify(2.5));
        Say("lists", Ends(new int[0]), Ends(new[] { 4 }), Ends(new[] { 1, 2, 3 }));
        Say("tuples-switch", Pair(0, true), Pair(3, true), Pair(3, false), Pair(-1, true));
        char q = 'q';
        object boxed = "x";
        int five = 5;
        Say("patterns", q is >= 'a' and <= 'z', boxed is not int, t is { Kind.Length: 5 }, five is not (1 or 2));

        // ---- nested types' names
        int[] guardPath = { 3, -1, 4, -5 };
        Outer.Guards guards = new();
        Say("nested", Outer.Inner.Arm(10), Outer.Inner.Arm(21), Outer.Inner.Arm(3), Outer.Inner.Text("w"), Outer.Inner.Derived, Outer.Inner.Read(),
            new Outer.Sized().Call(), guards.Again(), Outer.Guards.Find(guardPath), guards.Again(), Outer.Guards.Last(guardPath));

        // ---- local functions, static lambdas, method groups
        int counter = 0;
        int Bump(int by) { counter += by; return counter; }
        static int SquareOf(int x) => x * x;
        static int Fib(int n) => n < 2 ? n : Fib(n - 1) + Fib(n - 2);
        Func<int, int> twice = static x => x * 2;
        Func<int, int> sq = SquareOf;
        Accumulator acc = new();
        Func<int, int> addTo = acc.Add;
        Func<int, int> neg = Accumulator.Neg;
        Bump(2);
        Bump(3);
        int added = addTo(5) + addTo(6);
        Say("functions", counter, twice(21), sq(7), added, neg(4), Fib(10));

        // ---- collection expressions, spreads, ranges, indices
        int[] a = [1, 2, 3, 4, 5];
        List<int> l = [.. a[1..^1], 9];
        int[] empty = [];
        string word = "abcdef";
        Say("ranges", string.Join(",", l), a[^1], a[..2].Length, word[1..3], word[^2..], empty.Length, a[2..].Sum());

        // ---- tuples and deconstruction
        (int Count, string Name) pair = (3, "n");
        var (x, y) = (1, "one");
        Dictionary<string, int> d = new(StringComparer.Ordinal) { ["b"] = 2, ["a"] = 1 };
        List<string> seen = new();
        foreach (var (k, v) in d.OrderBy(e => e.Key, StringComparer.Ordinal)) seen.Add(k + v);
        (int, int) Swap((int A, int B) p) => (p.B, p.A);
        var swapped = Swap((1, 2));
        Say("tuples", pair.Count + pair.Name, x + y, string.Join(",", seen), swapped.Item1 + "" + swapped.Item2, pair == (3, "n"));

        // ---- ref locals and returns, spans, stackalloc, CollectionsMarshal
        int[] arr = [10, 20, 30];
        ref int head = ref arr[0];
        head += 5;
        ref int At(int[] xs, int i) => ref xs[i];
        At(arr, 2) = 99;
        Span<int> buf = stackalloc int[4];
        buf.Fill(7);
        buf[1] = 3;
        Span<int> slice = buf.Slice(1, 2);
        List<int> list = [1, 2, 3];
        Span<int> listView = CollectionsMarshal.AsSpan(list);
        listView[0] = 100;
        ReadOnlySpan<char> chars = "hello".AsSpan(1, 3);
        int[] copy = new int[4];
        buf.CopyTo(copy);
        Say("spans", arr[0], arr[2], slice[0] + slice[1], list[0], chars.ToString(), string.Join(",", copy),
            "abc".AsSpan().SequenceEqual("abc".AsSpan()), "abc".AsSpan().SequenceCompareTo("abd".AsSpan()) < 0);

        // ---- LINQ
        int[] nums = [5, 3, 8, 1, 9, 2];
        Say("linq1", string.Join(",", nums.Where(n => n > 2).Select(n => n * 10)), string.Join(",", nums.Order()),
            string.Join(",", nums.OrderByDescending(n => n).Take(2)), nums.Sum(), nums.Max(), nums.Min(), nums.Count(n => n % 2 == 0),
            nums.Any(n => n > 8), nums.All(n => n > 0));
        Say("linq2", nums.First(n => n > 5), nums.FirstOrDefault(n => n > 100), nums.Last(), string.Join(",", nums.Skip(4)),
            string.Join(",", nums.Take(2)), string.Join(",", Enumerable.Reverse(nums)), nums.SequenceEqual(new[] { 5, 3, 8, 1, 9, 2 }),
            nums.Zip("abcdef", (n, c) => c + n.ToString()).First(), nums.Concat(new[] { 0 }).Count(), nums.Prepend(0).First(), nums.Append(7).Last());
        string[] words = ["pear", "apple", "fig", "plum", "kiwi"];
        Say("linq3", string.Join(",", words.GroupBy(w => w.Length).OrderBy(g => g.Key).Select(g => g.Key + ":" + g.Count())),
            words.ToDictionary(w => w, w => w.Length)["fig"], words.ToHashSet().Contains("kiwi"),
            string.Join(",", words.OrderBy(w => w.Length).ThenBy(w => w, StringComparer.Ordinal)), string.Concat(words.SelectMany(w => w.Take(1))),
            words.MinBy(w => w.Length), words.ToLookup(w => w[0])['p'].Count(), words.Single(w => w.StartsWith("ap", StringComparison.Ordinal)),
            words.SingleOrDefault(w => w == "x") ?? "none");
        List<int> counted = [1, 2, 3];
        Say("linq4", string.Join(",", new[] { 1, 2 }.Union(new[] { 2, 3 })), string.Join(",", new[] { 1, 2 }.Intersect(new[] { 2, 3 })),
            Enumerable.Range(1, 4).Sum(), string.Concat(Enumerable.Repeat("z", 3)), Enumerable.Empty<int>().Any(),
            words.LastOrDefault(w => w.Length == 9) ?? "none", counted.Count(n => n > 1));

        // ---- strings
        string text = "  Hello, World  ";
        string trimmed = text.Trim();
        Say("strings", trimmed.StartsWith("Hello", StringComparison.Ordinal), trimmed.EndsWith("ld", StringComparison.Ordinal), trimmed.IndexOf(','),
            trimmed.LastIndexOf('o'), trimmed.Substring(7), trimmed.Replace("World", "There"), trimmed.ToLowerInvariant(),
            string.Join("|", "a,b,,c".Split(',')), "a,b,,c".Split(',', StringSplitOptions.RemoveEmptyEntries).Length);
        string formatted = $"{3.14159:F2}|{42,5}|{255:X2}";
        string raw = """a "q" b""";
        StringBuilder sb = new();
        sb.Append('x').Append(1).Insert(0, "<");
        Say("strings2", text.TrimStart().Length, text.TrimEnd().Length, string.IsNullOrEmpty(""), string.IsNullOrWhiteSpace("  "),
            string.CompareOrdinal("a", "b") < 0, "abc".Contains('b'), "abc".Insert(1, "X"), "abcdef".Remove(2, 2), "7".PadLeft(3, '0'),
            char.IsLetterOrDigit('_'), char.IsDigit('5'), char.IsLetter('x'), char.IsWhiteSpace('\t'), formatted, raw, sb.ToString(), sb.Length);

        // ---- collections
        HashSet<int> hs = new() { 1, 2, 3 };
        hs.UnionWith([3, 4]);
        hs.IntersectWith([2, 3, 4, 5]);
        bool overlaps = hs.Overlaps([4, 9]);
        bool setEquals = hs.SetEquals([4, 3, 2]);
        bool subset = hs.IsSubsetOf([1, 2, 3, 4]);
        hs.ExceptWith([2]);
        SortedSet<int> ss = new() { 5, 1, 9, 3, 7 };
        string between = string.Join(",", ss.GetViewBetween(3, 7));
        SortedDictionary<string, int> sd = new(StringComparer.Ordinal) { ["b"] = 2, ["a"] = 1 };
        Stack<int> stack = new();
        stack.Push(1);
        stack.Push(2);
        stack.TryPop(out int popped);
        Queue<string> queue = new();
        queue.Enqueue("p");
        queue.Enqueue("q");
        queue.TryDequeue(out string? dequeued);
        PriorityQueue<string, int> pq = new();
        pq.Enqueue("low", 5);
        pq.Enqueue("high", 1);
        pq.TryDequeue(out string? top, out int priority);
        Dictionary<string, int> dict = new(StringComparer.OrdinalIgnoreCase) { ["Key"] = 1 };
        dict.TryAdd("KEY", 2);
        int missing = dict.GetValueOrDefault("missing", -1);
        dict.Remove("key");
        Say("collections", string.Join(",", hs.Order()), overlaps, setEquals, subset, ss.Min, ss.Max, between, string.Join(",", sd.Keys),
            popped, stack.Peek(), dequeued, queue.Count, top + priority, missing, dict.Count);

        List<int> lst = new() { 5, 1, 4 };
        lst.AddRange([7, 2]);
        lst.InsertRange(1, [9, 9]);
        lst.RemoveRange(1, 2);
        int removed = lst.RemoveAll(n => n > 4);
        lst.Sort();
        int searched = lst.BinarySearch(4);
        List<int> range = lst.GetRange(0, 2);
        int foundAt = lst.FindIndex(n => n == 2);
        bool exists = lst.Exists(n => n == 4);
        int found = lst.Find(n => n > 1);
        lst.Reverse();
        lst.EnsureCapacity(16);
        lst.TrimExcess();
        Say("list-apis", string.Join(",", lst), removed, searched, string.Join(",", range), foundAt, exists, found, lst.IndexOf(1), lst.Contains(3));

        int[] ar = new int[5];
        Array.Fill(ar, 3);
        ar[4] = 1;
        Array.Sort(ar);
        int[] dest = new int[3];
        Array.Copy(ar, 2, dest, 0, 3);
        Array.Clear(ar, 0, 2);
        Array.Resize(ref ar, 6);
        Say("arrays", string.Join(",", ar), string.Join(",", dest), Array.IndexOf(ar, 3), Array.BinarySearch(new[] { 1, 3, 5 }, 5), Array.Empty<int>().Length);

        HashSet<object> byReference = new(ReferenceEqualityComparer.Instance);
        byReference.Add(new string('a', 2));
        byReference.Add(new string('a', 2));
        HashSet<string> anyCase = new(StringComparer.OrdinalIgnoreCase) { "A", "a" };
        HashSet<int> byMod = new(new ModComparer()) { 1, 4, 7, 2 };
        List<string> byLength = new() { "ccc", "a", "bb" };
        byLength.Sort(new LengthComparer());
        Say("comparers", byReference.Count, anyCase.Count, byMod.Count, string.Join(",", byLength));

        // ---- numbers, bits, binary, hashing
        Say("math", Math.Max(3, 7), Math.Min(-2, 5), Math.Abs(-9), Math.Clamp(15, 0, 10), BitOperations.TrailingZeroCount(8), BitOperations.PopCount(0xFFu),
            BitOperations.Log2(1024u), BitConverter.DoubleToInt64Bits(1.0) == 0x3FF0000000000000, BitConverter.SingleToInt32Bits(1.0f) == 0x3F800000,
            BitConverter.ToInt32(new byte[] { 1, 0, 0, 0 }, 0), Convert.ToHexString(new byte[] { 0xAB, 0x01 }), Convert.ToInt32("ff", 16), Convert.ToUInt32("10"));
        byte[] bytes = new byte[8];
        BinaryPrimitives.WriteUInt32LittleEndian(bytes, 0x01020304u);
        BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan(4), -1);
        bool wrote = BitConverter.TryWriteBytes(new byte[4], 7);
        Say("binary", bytes[0], bytes[3], BinaryPrimitives.ReadUInt32LittleEndian(bytes), BinaryPrimitives.ReadInt32LittleEndian(bytes.AsSpan(4)),
            BinaryPrimitives.ReadUInt16BigEndian(bytes), wrote, Encoding.UTF8.GetBytes("é").Length, Encoding.ASCII.GetString(new byte[] { 104, 105 }),
            Encoding.UTF8.GetString(Encoding.UTF8.GetBytes("ok")));
        byte[] abc = Encoding.UTF8.GetBytes("abc");
        using SHA256 sha = SHA256.Create();
        Say("hash", Convert.ToHexString(SHA256.HashData(abc))[..16], sha.ComputeHash(abc).AsSpan().SequenceEqual(SHA256.HashData(abc)),
            HashCode.Combine(1, 2) == HashCode.Combine(1, 2));

        // ---- checked arithmetic, exceptions
        int big = int.MaxValue;
        int wrapped = unchecked(big + 1);
        string overflow;
        try { overflow = checked(big + 1).ToString(); }
        catch (OverflowException) { overflow = "overflow"; }
        string filtered;
        try { throw new InvalidOperationException("bad"); }
        catch (InvalidOperationException e) when (e.Message == "good") { filtered = "wrong"; }
        catch (InvalidOperationException e) when (e.Message == "bad") { filtered = "filtered"; }
        string? maybe = null;
        string thrown;
        try { thrown = maybe ?? throw new ArgumentNullException(nameof(maybe)); }
        catch (ArgumentNullException e) { thrown = e.ParamName!; }
        int fin = 0;
        try { fin = 1; }
        finally { fin += 10; }
        Say("exceptions", wrapped == int.MinValue, overflow, filtered, thrown, fin);

        // ---- iterators, async, threads
        int asyncSum = SumAsync(4).GetAwaiter().GetResult();
        int shared = 0, locked = 0;
        object gate = new();
        Task[] tasks = Enumerable.Range(0, 4).Select(i => Task.Run(() =>
        {
            Interlocked.Increment(ref shared);
            lock (gate) locked += i;
        })).ToArray();
        Task.WhenAll(tasks).Wait();
        int exchanged = Interlocked.Exchange(ref shared, 100);
        Interlocked.Add(ref shared, 5);
        int flag = 0;
        Volatile.Write(ref flag, 3);
        int readBack = Volatile.Read(ref flag);
        Thread.Sleep(1);
        t_value = 5;
        int onOther = -1;
        Thread other = new(() => onOther = t_value);
        other.Start();
        other.Join();
        Say("threads", string.Join(",", Evens(7)), asyncSum, exchanged, shared, locked, readBack, Task.FromResult(6).Result,
            Environment.ProcessorCount > 0, t_value, onOther);

        // ---- Stopwatch, the collector, ConditionalWeakTable, TrimExcess
        long started = Stopwatch.GetTimestamp();
        Stopwatch watch = Stopwatch.StartNew();
        TimeSpan elapsed = Stopwatch.GetElapsedTime(started);
        bool timing = elapsed >= TimeSpan.Zero && Stopwatch.Frequency > 0 && watch.ElapsedMilliseconds >= 0;
        ConditionalWeakTable<object, StrongBox<int>> table = new();
        object key = new();
        table.GetOrCreateValue(key).Value = 41;
        table.TryGetValue(key, out StrongBox<int>? first);
        int firstValue = first!.Value;
        table.AddOrUpdate(key, new StrongBox<int>(42));
        table.TryGetValue(key, out StrongBox<int>? second);
        GCSettings.LargeObjectHeapCompactionMode = GCLargeObjectHeapCompactionMode.CompactOnce;
        bool compacting = GCSettings.LargeObjectHeapCompactionMode == GCLargeObjectHeapCompactionMode.CompactOnce;
        bool collector = GC.GetTotalMemory(false) > 0 && GC.CollectionCount(0) >= 0 && GC.GetTotalAllocatedBytes() > 0
            && GC.GetAllocatedBytesForCurrentThread() > 0 && GC.GetGCMemoryInfo().TotalAvailableMemoryBytes >= 0;
        GC.KeepAlive(key);
        List<int> roomy = new(100) { 1 };
        roomy.TrimExcess();
        HashSet<int> roomySet = new(50) { 1 };
        roomySet.TrimExcess();
        Dictionary<int, int> roomyDict = new(50) { [1] = 1 };
        roomyDict.TrimExcess();
        Say("runtime", timing, firstValue, second!.Value, compacting, collector, roomy.Capacity, roomySet.Count, roomyDict.Count);

        // ---- enums, events, operators, interfaces, generics, the rest
        Mode mode = Mode.Read | Mode.Exec;
        Notifier notifier = new();
        int total = 0;
        notifier.Fired += value => total += value;
        notifier.Fire(3);
        notifier.Fire(4);
        Vec sum = new Vec(1, 2) + new Vec(3, 4);
        IShape shape = new Square();
        string? unset = null;
        unset ??= "set";
        int? length = unset?.Length;
        int nothing = default;
        int g = 0;
    again:
        g++;
        if (g < 3) goto again;
        const int Local = 2 * 21;
        Say("misc", mode.HasFlag(Mode.Exec), (int)mode, total, sum.X + "," + sum.Y, sum == new Vec(4, 6), shape.Name(), Largest(3, 9, 4), unset, length,
            nameof(Options.Level), nothing, g, Local, sizeof(long), Twice(5));

        // ---- regular expressions, paths
        Say("text", Regex.Replace("a1b22", "[0-9]+", "#"), Regex.Match("key=val", "(\\w+)=(\\w+)").Groups[2].Value, Regex.IsMatch("abc", "^a.c$"),
            Regex.Escape("a.b"), Path.Combine("dir", "file.txt"), Path.GetFileName("/x/y/z.cs"), Path.GetFileNameWithoutExtension("/x/y/z.cs"),
            Path.GetDirectoryName("/x/y/z.cs"), Path.ChangeExtension("a.cs", ".o"), Path.IsPathRooted("/a"));
        return 0;
    }
}
