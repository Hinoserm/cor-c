// test: ecdsa_and_rsa_verification_and_public_keys
// expect-exit: 0
// expect-output:
// curves nistP256 1.2.840.10045.3.1.7 nistP384 1.3.132.0.34 1.3.132.0.35 1.2.840.10045.3.1.7 ECDSA_P384 Named Rfc3279DerSequence
// p256 size=256 curve=ECDSA_P256/1.2.840.10045.3.1.7 named=True max=64/72
//   p1363 sha256 True spoiled False other hash False
//   der sha384 True as p1363 False
//   hash True span True
//   spki same True
//   imported 91 bytes, size 256, verifies True
//   private export: CryptographicException: Object contains only the public half of a key pair. A private key must also be provided.
//   sign without private key: a CryptographicException
// p384 size=384 curve=ECDSA_P384/1.3.132.0.34 named=True max=96/104
//   p1363 sha256 True spoiled False other hash False
//   der sha384 True as p1363 False
//   hash True span True
//   spki same True
//   imported 120 bytes, size 384, verifies True
//   private export: CryptographicException: Object contains only the public half of a key pair. A private key must also be provided.
//   sign without private key: a CryptographicException
// rsa size=2048 spki same True pkcs1 same True
//   pkcs1 sha256 True spoiled False as pss False sha512 True
//   pss sha256 True sha384 True wrong hash False hash True
//   exported n True e 010001 d True
//   private export: CryptographicException: Object contains only the public half of a key pair. A private key must also be provided.
//   sign without private key: a CryptographicException
//   null padding: ArgumentNullException: Value cannot be null. (Parameter 'padding')
// rsa imported 294/270 bytes, verifies True
// paddings Pkcs1 Pss Pkcs1 True
// cert ec True 256 True rsa True
// cert rsa True 2048 ec True has private False
//
// ECDsa (P-256, P-384) and RSA as .NET has them, the public half: keys
// imported from parameters, SubjectPublicKeyInfo and RSAPublicKey and
// exported again; signatures .NET 10 made verified in both ECDSA formats
// and both RSA paddings, spoiled ones and the wrong hash or padding
// refused; the curves' names; and the keys certificates carry
// (GetECDsaPublicKey, GetRSAPublicKey). Expected output from .NET 10.

using System;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using System.Text;

static class Program
{
    const string P256_SPKI = "3059301306072A8648CE3D020106082A8648CE3D030107034200049F21483322126A96EF2EB77B775A1E5646A6B66475837B45C53EFB86CF407D13B83D14433EAE74BC8F2F17D2F5912695680D338B489825F54D309B662D04BDE2";
    const string P256_QX = "9F21483322126A96EF2EB77B775A1E5646A6B66475837B45C53EFB86CF407D13";
    const string P256_QY = "B83D14433EAE74BC8F2F17D2F5912695680D338B489825F54D309B662D04BDE2";
    const string P256_SIG256_P1363 = "D5454F6869EE03005DF775F05520C9CDBA3176D82CEB9D3F4CE11342CB6778597D13E0F4F458BDE7714BB145B32B23A928F3E09D307A5D73F0338AF97B8D5450";
    const string P256_SIG384_DER = "3045022100D98A3F290A2E68DE017333FC172A9DDC8E10B4F510E49C1D9B5938BC096658CE02207B36BD26D750C4EABA1494C9EFE9A964D97FDCF2E244C840211CB593FE44C6B4";
    const string P256_SIGHASH = "ECCBEEBF8D3B06D1C9067F2FCE17E708163BC4992D9B1167845F3C97EFAE98A9604EAFB1D657D4B8B59686AE1CAA73351FA7610998A5F605E3A367D4DC36C810";
    const string P384_SPKI = "3076301006072A8648CE3D020106052B8104002203620004CCE12601B3362DBCE5D63D275DF30915137CB05AAE3A88F4BF5A1A839D5D58B704AE5861FDB1E17C536DAA8FD1D2CF4DEF1A2197012CDDA29BF4F90A1D72CFB1AE989F2CD1FD25CC07E6CF8CE2B8A9928DD9CB6D77C5723755C3AAD1AAE67E04";
    const string P384_QX = "CCE12601B3362DBCE5D63D275DF30915137CB05AAE3A88F4BF5A1A839D5D58B704AE5861FDB1E17C536DAA8FD1D2CF4D";
    const string P384_QY = "EF1A2197012CDDA29BF4F90A1D72CFB1AE989F2CD1FD25CC07E6CF8CE2B8A9928DD9CB6D77C5723755C3AAD1AAE67E04";
    const string P384_SIG256_P1363 = "95041B06344298069DDB2E1415D36E15CC0B3901432AA4A8FB6C5241B139EE3F5AA5A342733E5AB0F8CD53A1998AD84812194C6C97282A4F32265AA0BFC3439E8364EF08F88424FC6CA52CE115F99FC0E86D25BA03C51C3A568F42AD0F61DA14";
    const string P384_SIG384_DER = "3065023078ABAF409572777EE6EC54A6B2C575915523812E97670F152E13F1307030EDBE3B47FC2E40F7651E62DD3E4ECDD47EB8023100DEED1BB0C5ECD9A5DDBF8DE7F25AF6F1FBD9CA2AACF353023DB425CAD7EAA435F4FEF2A17607359A865E34849280475A";
    const string P384_SIGHASH = "C39AF9473B1B79095F3D24ED39B89342EB44A9DE02C04F1FB7BB7C58C33BDD69B140D8896DE3B34305EAF40CA076E5BDF9B546169541CFCFC0F8EEC09C7FFA086196FFDD027090419CE05F3AA9EFECBEB205B4233A6E07C70887EE55BA4B1CE3";
    const string RSA_SPKI = "";
    const string RSA_PKCS1 = "";
    const string RSA_N = "";
    const string RSA_E = "010001";
    const string RSA_PKCS1_SHA256 = "";
    const string RSA_PKCS1_SHA512 = "";
    const string RSA_PSS_SHA256 = "";
    const string RSA_PSS_SHA384 = "";
    const string RSA_PKCS1_HASH384 = "";
    const string LEAF = "";
    const string RSALEAF = "";

    static byte[] X(string hex) => Convert.FromHexString(hex);
    static byte[] Spoiled(byte[] b) { byte[] c = (byte[])b.Clone(); c[c.Length / 2] ^= 1; return c; }
    static void Fail(string name, Action a) { try { a(); Console.WriteLine(name + ": no failure"); } catch (Exception e) { Console.WriteLine(name + ": " + e.GetType().Name + ": " + e.Message); } }

    static void Ec(string name, ECCurve curve, string spki, string qx, string qy, string p1363, string der, string hashSig)
    {
        byte[] data = Encoding.ASCII.GetBytes("the quick brown fox signs over the lazy dog");
        ECParameters p = new ECParameters { Curve = curve, Q = new ECPoint { X = X(qx), Y = X(qy) } };
        using ECDsa key = ECDsa.Create(p);
        Console.WriteLine(name + " size=" + key.KeySize + " curve=" + key.ExportParameters(false).Curve.Oid.FriendlyName + "/" + key.ExportParameters(false).Curve.Oid.Value
            + " named=" + key.ExportParameters(false).Curve.IsNamed + " max=" + key.GetMaxSignatureSize(DSASignatureFormat.IeeeP1363FixedFieldConcatenation) + "/" + key.GetMaxSignatureSize(DSASignatureFormat.Rfc3279DerSequence));
        Console.WriteLine("  p1363 sha256 " + key.VerifyData(data, X(p1363), HashAlgorithmName.SHA256) + " spoiled " + key.VerifyData(data, Spoiled(X(p1363)), HashAlgorithmName.SHA256)
            + " other hash " + key.VerifyData(data, X(p1363), HashAlgorithmName.SHA384));
        Console.WriteLine("  der sha384 " + key.VerifyData(data, X(der), HashAlgorithmName.SHA384, DSASignatureFormat.Rfc3279DerSequence)
            + " as p1363 " + key.VerifyData(data, X(der), HashAlgorithmName.SHA384));
        Console.WriteLine("  hash " + key.VerifyHash(SHA512.HashData(data), X(hashSig)) + " span " + key.VerifyHash(new ReadOnlySpan<byte>(SHA512.HashData(data)), new ReadOnlySpan<byte>(X(hashSig))));
        Console.WriteLine("  spki same " + (Convert.ToHexString(key.ExportSubjectPublicKeyInfo()) == spki));
        using ECDsa again = ECDsa.Create();
        again.ImportSubjectPublicKeyInfo(X(spki), out int read);
        Console.WriteLine("  imported " + read + " bytes, size " + again.KeySize + ", verifies " + again.VerifyData(data, X(p1363), HashAlgorithmName.SHA256));
        Fail("  private export", () => key.ExportParameters(true));
        try { key.SignData(data, HashAlgorithmName.SHA256); Console.WriteLine("  sign without private key: no failure"); }
        catch (CryptographicException) { Console.WriteLine("  sign without private key: a CryptographicException"); }
    }

    static int Main()
    {
        Console.WriteLine("curves " + ECCurve.NamedCurves.nistP256.Oid.FriendlyName + " " + ECCurve.NamedCurves.nistP256.Oid.Value + " " + ECCurve.NamedCurves.nistP384.Oid.FriendlyName + " "
            + ECCurve.NamedCurves.nistP384.Oid.Value + " " + ECCurve.NamedCurves.nistP521.Oid.Value + " " + ECCurve.CreateFromFriendlyName("nistP256").Oid.Value + " " + ECCurve.CreateFromValue("1.3.132.0.34").Oid.FriendlyName
            + " " + ECCurve.NamedCurves.nistP256.CurveType + " " + DSASignatureFormat.Rfc3279DerSequence);
        Ec("p256", ECCurve.NamedCurves.nistP256, P256_SPKI, P256_QX, P256_QY, P256_SIG256_P1363, P256_SIG384_DER, P256_SIGHASH);
        Ec("p384", ECCurve.NamedCurves.nistP384, P384_SPKI, P384_QX, P384_QY, P384_SIG256_P1363, P384_SIG384_DER, P384_SIGHASH);

        byte[] data = Encoding.ASCII.GetBytes("the quick brown fox signs over the lazy dog");
        using (RSA rsa = RSA.Create())
        {
            rsa.ImportParameters(new RSAParameters { Modulus = X(RSA_N), Exponent = X(RSA_E) });
            Console.WriteLine("rsa size=" + rsa.KeySize + " spki same " + (Convert.ToHexString(rsa.ExportSubjectPublicKeyInfo()) == RSA_SPKI) + " pkcs1 same " + (Convert.ToHexString(rsa.ExportRSAPublicKey()) == RSA_PKCS1));
            Console.WriteLine("  pkcs1 sha256 " + rsa.VerifyData(data, X(RSA_PKCS1_SHA256), HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1)
                + " spoiled " + rsa.VerifyData(data, Spoiled(X(RSA_PKCS1_SHA256)), HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1)
                + " as pss " + rsa.VerifyData(data, X(RSA_PKCS1_SHA256), HashAlgorithmName.SHA256, RSASignaturePadding.Pss)
                + " sha512 " + rsa.VerifyData(data, X(RSA_PKCS1_SHA512), HashAlgorithmName.SHA512, RSASignaturePadding.Pkcs1));
            Console.WriteLine("  pss sha256 " + rsa.VerifyData(data, X(RSA_PSS_SHA256), HashAlgorithmName.SHA256, RSASignaturePadding.Pss)
                + " sha384 " + rsa.VerifyData(data, X(RSA_PSS_SHA384), HashAlgorithmName.SHA384, RSASignaturePadding.Pss)
                + " wrong hash " + rsa.VerifyData(data, X(RSA_PSS_SHA384), HashAlgorithmName.SHA256, RSASignaturePadding.Pss)
                + " hash " + rsa.VerifyHash(SHA384.HashData(data), X(RSA_PKCS1_HASH384), HashAlgorithmName.SHA384, RSASignaturePadding.Pkcs1));
            RSAParameters back = rsa.ExportParameters(false);
            Console.WriteLine("  exported n " + (Convert.ToHexString(back.Modulus!) == RSA_N) + " e " + Convert.ToHexString(back.Exponent!) + " d " + (back.D == null));
            Fail("  private export", () => rsa.ExportParameters(true));
            try { rsa.SignData(data, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1); Console.WriteLine("  sign without private key: no failure"); }
            catch (CryptographicException) { Console.WriteLine("  sign without private key: a CryptographicException"); }
            Fail("  null padding", () => rsa.VerifyData(data, X(RSA_PSS_SHA256), HashAlgorithmName.SHA256, null!));
        }
        using (RSA again = RSA.Create())
        {
            again.ImportSubjectPublicKeyInfo(X(RSA_SPKI), out int read);
            again.ImportRSAPublicKey(X(RSA_PKCS1), out int read2);
            Console.WriteLine("rsa imported " + read + "/" + read2 + " bytes, verifies " + again.VerifyData(data, X(RSA_PSS_SHA256), HashAlgorithmName.SHA256, RSASignaturePadding.Pss));
        }
        Console.WriteLine("paddings " + RSASignaturePadding.Pkcs1 + " " + RSASignaturePadding.Pss + " " + RSASignaturePadding.Pkcs1.Mode + " " + (RSASignaturePadding.Pss == RSASignaturePadding.Pss));

        X509Certificate2 ec = X509CertificateLoader.LoadCertificate(Convert.FromBase64String(LEAF));
        X509Certificate2 rs = X509CertificateLoader.LoadCertificate(Convert.FromBase64String(RSALEAF));
        using (ECDsa? fromCert = ec.GetECDsaPublicKey())
            Console.WriteLine("cert ec " + (fromCert != null) + " " + fromCert!.KeySize + " " + (Convert.ToHexString(fromCert.ExportSubjectPublicKeyInfo()) == Convert.ToHexString(ec.PublicKey.ExportSubjectPublicKeyInfo())) + " rsa " + (ec.GetRSAPublicKey() == null));
        using (RSA? fromCert = rs.GetRSAPublicKey())
            Console.WriteLine("cert rsa " + (fromCert != null) + " " + fromCert!.KeySize + " ec " + (rs.GetECDsaPublicKey() == null) + " has private " + rs.HasPrivateKey);
        return 0;
    }
}
