// test: [ThreadStatic] fields kept apart between two threads that take turns
// timeout: 120
// expect-exit: 0
// expect-output:
// turns 20002
// first kept its own PASS
// second kept its own PASS
// held across collections PASS
// a later thread starts at the defaults PASS
// main untouched PASS
//
// Each thread's [ThreadStatic] table is its own: on Linux through its thread
// block (Tls.ThreadStatics), in a ring-0 kernel through the platform's hook
// (Platform.ThreadStaticsHook), which a Linux build folds to the thread
// block. Two threads take strict turns -- one writes, hands over, the other
// writes, hands back -- so every write of one lies between two reads of the
// other: a shared cell, or one table answered for both, shows at the first
// turn. Each keeps an int, a long, a string and an object made on its own
// heap, which collections forced by the other must leave alone. A thread
// started after both have ended, whose block may be one of theirs reused,
// must see the defaults, and the main thread, which never wrote, its own
// initial values.

using System;
using System.Threading;

sealed class Box
{
    public int Owner;
    public int Turn;
}

static class Cells
{
    [ThreadStatic] public static int Who;
    [ThreadStatic] public static long Wide;
    [ThreadStatic] public static string? Name;
    [ThreadStatic] public static Box? Held;
}

static class Program
{
    const int Turns = 10000;

    static int _turn;
    static bool _firstKept = true;
    static bool _secondKept = true;
    static bool _held = true;
    static string _later = "";

    static void Wait(int mine)
    {
        while (Volatile.Read(ref _turn) % 2 != mine)
        {
            Thread.Yield();
        }
    }

    static bool Mine(int me, int turn)
    {
        return Cells.Who == me && Cells.Wide == ((long)me << 40) + turn
            && Cells.Name == "thread " + me && Cells.Held != null && Cells.Held.Owner == me && Cells.Held.Turn == turn;
    }

    static void Run(int me)
    {
        Cells.Who = me;
        Cells.Name = "thread " + me;
        Cells.Held = new Box { Owner = me };
        int last = -1;
        for (int i = 0; i < Turns; i++)
        {
            Wait(me);
            int turn = Volatile.Read(ref _turn);
            if (last >= 0 && !Mine(me, last))
            {
                if (me == 0) _firstKept = false; else _secondKept = false;
            }
            Cells.Wide = ((long)me << 40) + turn;
            Cells.Held!.Turn = turn;
            last = turn;
            if (i % 500 == 0)
            {
                // Garbage and a collection while the other waits: what this
                // thread's cells hold must be found by the mark.
                for (int j = 0; j < 200; j++) { string junk = "junk " + j + " " + me; }
                GC.Collect();
                if (Cells.Held == null || Cells.Held.Owner != me) _held = false;
            }
            Interlocked.Increment(ref _turn);
        }
        Wait(me);
        if (!Mine(me, last))
        {
            if (me == 0) _firstKept = false; else _secondKept = false;
        }
        Interlocked.Increment(ref _turn);
    }

    static void Main()
    {
        Thread first = new Thread(() => Run(0));
        Thread second = new Thread(() => Run(1));
        first.Start();
        second.Start();
        first.Join();
        second.Join();

        Thread later = new Thread(() =>
        {
            _later = Cells.Who == 0 && Cells.Wide == 0 && Cells.Name == null && Cells.Held == null ? "PASS" : "FAIL: " + Cells.Who + " " + Cells.Name;
        });
        later.Start();
        later.Join();
        GC.Collect();

        Console.WriteLine("turns " + _turn);
        Console.WriteLine("first kept its own " + (_firstKept ? "PASS" : "FAIL"));
        Console.WriteLine("second kept its own " + (_secondKept ? "PASS" : "FAIL"));
        Console.WriteLine("held across collections " + (_held ? "PASS" : "FAIL"));
        Console.WriteLine("a later thread starts at the defaults " + _later);
        bool main = Cells.Who == 0 && Cells.Wide == 0 && Cells.Name == null && Cells.Held == null;
        Console.WriteLine("main untouched " + (main ? "PASS" : "FAIL"));
    }
}
