// test: inline_asm_xlat_unset_al_refused
// only-target: x86
// expect-compile-error: this reads al, which the block has not set
//
// XLAT reads AL as the index into the table at EBX: an AL the block never
// set holds nothing of the method's (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static unsafe int Main()
    {
        byte* table = stackalloc byte[256];
        int r;
        asm
        {
            mov ebx, table
            xlat
            movzx ecx, al
            mov r, ecx
        }
        return r;
    }
}
