// test: from_end_target_once
// expect-exit: 0
// expect-output:
// 3 1
// 5 2
// 3
// 4
// 10 5
// o h
// 4 6
//
// `Make()[^1]` evaluates Make once, read or written to: `^k` is the count
// less k, and the count was read by writing the target twice. Output
// checked against .NET.

using System;
using System.Collections.Generic;

static class Program
{
    static int calls;
    static int[] Make() { calls++; return new[] { 1, 2, 3 }; }
    static List<int> MakeList() { calls++; return new List<int> { 4, 5, 6 }; }
    static int[] field = { 7, 8, 9 };
    static int Index() { calls++; return 1; }

    static void Main()
    {
        int a = Make()[^1];
        Console.WriteLine(a + " " + calls);
        int b = MakeList()[^2];
        Console.WriteLine(b + " " + calls);
        Make()[^1] = 10;
        Console.WriteLine(calls);
        MakeList()[^1] += 5;
        Console.WriteLine(calls);
        field[^Index()] += 1;
        Console.WriteLine(field[2] + " " + calls);
        string s = "hello";
        Console.WriteLine(s[^1] + " " + s[^5]);
        int[] arr = Make();
        arr[^1]++;
        Console.WriteLine(arr[2] + " " + calls);
    }
}
