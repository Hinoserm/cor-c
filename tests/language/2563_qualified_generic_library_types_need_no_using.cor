// test: qualified_generic_library_types_need_no_using
// expect-exit: 0
// expect-output:
// 1 1 2 0
// 2 1 3 True
//
// A generic library type named through its own namespace needs no using,
// as C# has a qualified name: `System.Collections.Generic.List<int>`,
// `global::` before it, a using alias of one, one inside another, a generic
// class's base, the namespace through an alias of it, and the rest of the
// namespace from inside the one that begins it. The copy's name, List$int,
// has lost what it was written with, which the binder is told
// (TypeRef.Qualifier); an argument written bare inside it is still the
// file's to bring in (2564).
using Map = System.Collections.Generic.Dictionary<string, int>;
using G = System.Collections.Generic;

class Box<T> : System.Collections.Generic.List<T> { }

class Same<T> : System.IEquatable<Same<T>>
{
    public bool Equals(Same<T>? other) => other is not null;
}

namespace System.Mine
{
    static class Inner
    {
        public static int Count(Collections.Generic.List<int> list) => list.Count;
    }
}

static class Program
{
    static int Main()
    {
        global::System.Collections.Generic.List<int> g = new global::System.Collections.Generic.List<int>();
        g.Add(4);
        Map m = new Map();
        m["a"] = 1;
        System.Collections.Generic.List<System.Collections.Generic.List<int>> nested = new();
        nested.Add(g);
        nested.Add(new System.Collections.Generic.List<int>());
        object o = g;
        System.ReadOnlySpan<byte> none = default;
        System.Console.WriteLine(g.Count + " " + m["a"] + " " + nested.Count + " " + (o is System.Collections.Generic.List<int> ? none.Length : 9));
        Box<int> box = new Box<int>();
        box.Add(1);
        box.Add(2);
        G.List<int> through = new G.List<int>();
        through.Add(3);
        Same<int> same = new Same<int>();
        System.Console.WriteLine(box.Count + " " + through.Count + " " + System.Mine.Inner.Count(through) * 3 + " " + same.Equals(same));
        return 0;
    }
}
