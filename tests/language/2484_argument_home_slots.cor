// test: arguments spilled where they arrived: more of them live in a loop than there are registers, so they are read back from their incoming words (home slots), and an argument reassigned or a struct's words read twice keep slots of their own
// expect-output:
// 2061598 147622 225194
//
// A value whose one definition loads an incoming argument's word lives
// there when spilled (Allocator's home slots): no store, no slot of its
// own. One reassigned in a loop has two definitions and gets none; a
// struct passed by value is read word by word, and each word read more
// than once is no home.

struct Pair
{
    public int Low, High;
    public Pair(int low, int high) { Low = low; High = high; }
}

static class Program
{
    static long Mix(int a, int b, int c, int d, int e, int f, int g, int h, int n)
    {
        long s = 0;
        for (int i = 0; i < n; i++)
            s += (long)a * i + b - c + d * 2 + (e ^ i) + f * 3 - g + (h & i);
        return s + a + b + c + d + e + f + g + h;
    }

    static int Again(int x, int n)
    {
        for (int i = 0; i < n; i++) x = x * 3 + 1;
        return x;
    }

    static long Words(Pair p, int n, Pair q)
    {
        long s = 0;
        for (int i = 0; i < n; i++) s += p.Low * i + p.High - q.Low + (q.High ^ i);
        return s + p.Low + q.High;
    }

    static int Main()
    {
        System.Console.WriteLine(Mix(3, 5, 7, 11, 13, 17, 19, 23, 1000) + " " + Again(2, 10) + " " + Words(new Pair(4, 9), 300, new Pair(6, 8)));
        return 0;
    }
}
