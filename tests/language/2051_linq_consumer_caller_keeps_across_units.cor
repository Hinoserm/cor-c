// test: linq_consumer_caller_keeps_across_units
// units: tests/language/support/2051_lent_units.cor
// expect-exit: 0
// expect-output:
// control odd 100000 True
// stored after 5000 -3,-2,-1,0,1,2,3,4,5
// static 27000 -3,-2,-1,0,1,2,3,4,5
// field 5000 -3,-2,-1,0,1,2,3,4,5
// aliased 5000 -3,-2,-1,0,1,2,3,4,5
// kept 200 1800 -3,-2,-1,0,1,2,3,4,5
//
// Lists another unit's walk keeps nowhere, which this unit keeps: stored in
// a static after the walk returns; read from a static or a live object's
// field, never this function's to free; handed as both arguments of a call
// that walks the first and keeps the second; and one walk's list kept at
// one call site and dropped at another, two hundred times. Each is read
// after blocks of its shape were made again.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

sealed class Holder
{
    public List<int> Items = new();
}

static class P
{
    static List<int> Make(int n) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(i - 3); return l; }

    // What each call left to the collector, and whether the program gave
    // memory back itself meanwhile: frees, or a region's end (1211's measure).
    static string Measure(Func<int, int> f, out long total)
    {
        const int N = 20000;
        total = 0;
        Gc.Collect();
        long taken = Gc.CollectedBytes, frees = Gc.Frees, region = Gc.RegionFreedBytes + Gc.RegionTopFreedBytes;
        for (int k = 0; k < N; k++) total += f(9);
        bool given = Gc.Frees - frees >= N || Gc.RegionFreedBytes + Gc.RegionTopFreedBytes - region >= N * 16;
        Gc.Collect();
        long left = (Gc.CollectedBytes - taken) / N;
        return given && left <= 32 ? "True" : "False " + left;
    }

    static void Say(string name, Func<int, int> f)
    {
        string freed = Measure(f, out long total);
        Console.WriteLine(name + " " + total + " " + freed);
    }

    static List<int> MakeAt(int n, int at) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(at + i); return l; }

    // WHAT A BLOCK FREED TOO SOON BECOMES: lists of the kept ones' shape and
    // arrays of their arrays' sizes, other numbers in them, made and held while
    // the kept ones are read. Under verified frees such a block is poisoned
    // instead, and a second free ends the run.
    static readonly List<int>[] JunkLists = new List<int>[4096];
    static readonly int[][] JunkArrays = new int[4096][];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkLists.Length; k++)
        {
            JunkLists[k] = MakeAt(9, 100);
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
        }
        Gc.Collect();
    }

    // A thousand calls, their results added: the last call's object is the one read afterwards.
    static long Rounds(Func<int, int> f) { long t = 0; for (int k = 0; k < 1000; k++) t += f(9); return t; }

    static string Show(IEnumerable<int>? s) => s is null ? "null" : string.Join(",", s);

    static string Rest(IEnumerator<int> e) { string s = ""; while (e.MoveNext()) s += (s.Length > 0 ? "," : "") + e.Current; return s; }

    static List<int>? _after;
    static readonly List<int> Shared = Make(9);
    static readonly Holder TheHolder = new();
    static readonly List<List<int>> KeptLists = new();

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Odd(int n) => Lent.Odd(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int StoredAfter(int n) { List<int> l = Make(n); int r = Lent.Odd(l); _after = l; return r; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int FromStatic(int n) => Lent.Tripled(Shared);
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int FromField(int n) => Lent.Odd(TheHolder.Items);
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Aliased(int n) { List<int> l = Make(n); return Lent.Pair(l, l); }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int KeepEach(int n) { List<int> l = Make(n); KeptLists.Add(l); return Lent.Odd(l); }

    static void Main()
    {
        TheHolder.Items = Make(9);
        Say("control odd", Odd);
        long after = Rounds(StoredAfter), shared = Rounds(FromStatic), field = Rounds(FromField), aliased = Rounds(Aliased);
        for (int k = 0; k < 200; k++) { KeepEach(9); Odd(9); }
        Churn();
        Console.WriteLine("stored after " + after + " " + Show(_after));
        Console.WriteLine("static " + shared + " " + Show(Shared));
        Console.WriteLine("field " + field + " " + Show(TheHolder.Items));
        Console.WriteLine("aliased " + aliased + " " + Show(Lent.Second));
        long sums = 0;
        foreach (List<int> l in KeptLists) foreach (int x in l) sums += x;
        Console.WriteLine("kept " + KeptLists.Count + " " + sums + " " + Show(KeptLists[KeptLists.Count - 1]));
    }
}
