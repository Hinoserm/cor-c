// test: csharp_collection_expressions_ranges_tuples
// expect-exit: 0
// expect-output:
// ranges 2,3,4,9 5 2 bc ef 0 12
// tuples 3n 1one a1,b2 21 True
//
// COLLECTION EXPRESSIONS AND SPREADS, RANGES AND INDICES FROM THE END, named
// tuples, deconstruction, foreach deconstruction of a dictionary's pairs,
// a local function over a tuple, tuple equality.
//
// Split out of the canary of the C# the compiler's own sources use: one
// family a test, so a form the compiler cannot build yet fails only its own.
// Every line is what .NET prints.

using System;
using System.Collections.Generic;
using System.Linq;

public static class Program
{
    private static void Say(params object?[] parts) => Console.WriteLine(string.Join(" ", parts));

    public static int Main()
    {
        int[] a = [1, 2, 3, 4, 5];
        List<int> l = [.. a[1..^1], 9];
        int[] empty = [];
        string word = "abcdef";
        Say("ranges", string.Join(",", l), a[^1], a[..2].Length, word[1..3], word[^2..], empty.Length, a[2..].Sum());

        (int Count, string Name) pair = (3, "n");
        var (x, y) = (1, "one");
        Dictionary<string, int> d = new(StringComparer.Ordinal) { ["b"] = 2, ["a"] = 1 };
        List<string> seen = new();
        foreach (var (k, v) in d.OrderBy(e => e.Key, StringComparer.Ordinal)) seen.Add(k + v);
        (int, int) Swap((int A, int B) p) => (p.B, p.A);
        var swapped = Swap((1, 2));
        Say("tuples", pair.Count + pair.Name, x + y, string.Join(",", seen), swapped.Item1 + "" + swapped.Item2, pair == (3, "n"));
        return 0;
    }
}
