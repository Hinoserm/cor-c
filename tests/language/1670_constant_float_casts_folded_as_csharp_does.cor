// test: constant_float_casts_folded_as_csharp_does
// expect-exit: 0
// expect-output:
// int 0 0 0 0 0 2147483647 -2147483648
// uint 3000000000 0 0 0 0
// long 0 0 0 3000000000
// ulong 0 0 0 18000000000000000000
// short 0 0 0 0 0 0
// float 0 0 0 0
// consts 3 0 0 3 4611686018427388904 False 0 True 3 3
// runtime 2147483647 -1 0 3000000000 44
//
// A FLOAT OR DOUBLE CONSTANT CAST TO A WHOLE TYPE IS A CONSTANT, worked out
// while compiling as Roslyn works it out: truncated toward zero, and 0 where
// that is NaN or past the type's range -- `unchecked((int)3e9)` and
// `unchecked((short)40000.0)` are 0, where the same conversion made at run
// time saturates (the last line). `const int X = (int)3.7;` was refused as
// no constant. A float literal is rounded once, straight to single
// precision: read as a double first, one just past a halfway point between
// two floats landed on the point and then on the even neighbour.

using System;

static class Program
{
    const double Big = 3e9, Huge = 1e20, Neg = -3e9;
    static double big = 3e9, nan = double.NaN;
    static void Main()
    {
        Console.WriteLine("int " + unchecked((int)Big) + " " + unchecked((int)Neg) + " " + unchecked((int)double.NaN) + " " + unchecked((int)double.PositiveInfinity) + " " + unchecked((int)double.NegativeInfinity) + " " + unchecked((int)2147483647.5) + " " + unchecked((int)-2147483648.9));
        Console.WriteLine("uint " + unchecked((uint)Big) + " " + unchecked((uint)-1.5) + " " + unchecked((uint)Huge) + " " + unchecked((uint)double.NaN) + " " + unchecked((uint)-0.5));
        Console.WriteLine("long " + unchecked((long)Huge) + " " + unchecked((long)-Huge) + " " + unchecked((long)double.NaN) + " " + unchecked((long)Big));
        Console.WriteLine("ulong " + unchecked((ulong)Huge) + " " + unchecked((ulong)-1.0) + " " + unchecked((ulong)double.NaN) + " " + unchecked((ulong)1.8e19));
        Console.WriteLine("short " + unchecked((short)40000.0) + " " + unchecked((short)Big) + " " + unchecked((short)double.NaN) + " " + unchecked((byte)300.7) + " " + unchecked((sbyte)-200.2) + " " + (int)unchecked((char)70000.0));
        Console.WriteLine("float " + unchecked((int)3e9f) + " " + unchecked((int)float.NaN) + " " + unchecked((long)float.MaxValue) + " " + unchecked((short)40000.5f));
        const int X = (int)3.7, Y = unchecked((int)(Big * 2)), W = (int)(Big / 1e9 + 0.5);
        const short Z = unchecked((short)40000.0);
        const long L = (long)(1L << 62) + (long)1e3;
        const float F = 1.000000059604644775390625001f;
        Console.WriteLine("consts " + X + " " + Y + " " + Z + " " + W + " " + L + " " + (F == 1.0f) + " " + (int)(double.MaxValue * 0) + " " + (1.5 > 1.0) + " " + (int)(0.1f * 3f * 10f) + " " + (int)(0.1 * 3 * 10));
        Console.WriteLine("runtime " + unchecked((int)big) + " " + unchecked((short)big) + " " + unchecked((int)nan) + " " + unchecked((uint)big) + " " + unchecked((byte)(big / 1e7)));
    }
}
