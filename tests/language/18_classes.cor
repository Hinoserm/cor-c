// test: classes
// expect-exit: 0
// expect-output:
// ctor 0 0 3 4
// sum 7
// move 5 6
// made 3
// identity False True
// null True False
// chain 12
//
// Classes: fields, constructors, a constructor chaining to another with
// `: this(...)`, instance methods, a static counter, reference identity and
// null comparison, and a method that returns `this` so calls chain.

class Point
{
    public static int Made;

    public int X;
    public int Y;

    public Point() : this(0, 0)
    {
    }

    public Point(int x, int y)
    {
        X = x;
        Y = y;
        Made = Made + 1;
    }

    public int Sum()
    {
        return X + Y;
    }

    public void Move(int dx, int dy)
    {
        X += dx;
        Y += dy;
    }

    public Point Scale(int by)
    {
        X = X * by;
        Y = Y * by;
        return this;
    }
}

static class Program
{
    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static int Main()
    {
        Point a = new Point();
        Point b = new Point(3, 4);
        Point c = new Point(3, 4);
        Line("ctor " + a.X + " " + a.Y + " " + b.X + " " + b.Y);
        Line("sum " + b.Sum());

        b.Move(2, 2);
        Line("move " + b.X + " " + b.Y);
        Line("made " + Point.Made);

        Point same = b;
        Line("identity " + (b == c) + " " + (b == same));

        Point? nothing = null;
        Line("null " + (nothing == null) + " " + (b == null));

        Line("chain " + c.Scale(2).Scale(2).X);
        return 0;
    }
}
