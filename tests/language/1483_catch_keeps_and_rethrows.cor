// test: catch_keeps_and_rethrows
// expect-exit: 0
// expect-output:
// 6722 1000 0 True
//
// A catch of Exception keeps what it caught in a list and rethrows it:
// the catch further out must not free it.
using System.Collections.Generic;

static class Program
{
    static List<System.Exception> kept = new List<System.Exception>();

    static void Inner(int k)
    {
        try { if ((k & 1) == 0) throw new System.InvalidOperationException("bad value " + k); }
        catch (System.Exception e) { kept.Add(e); if ((k & 2) == 0) throw; }
    }

    static int Main()
    {
        long total = 0;
        for (int k = 0; k < 2000; k++)
        {
            try { Inner(k); }
            catch (System.InvalidOperationException e) { total += e.Message.Length; }
        }
        long sum = 0;
        for (int k = 0; k < 4000; k++) { string s = "zzzz" + k + "qqqqqqqqqqqq"; sum += s.Length; }
        int bad = 0;
        for (int i = 0; i < kept.Count; i++)
            if (kept[i] is not System.InvalidOperationException || !kept[i].Message.StartsWith("bad value ")) bad++;
        System.Console.WriteLine(total + " " + kept.Count + " " + bad + " " + (sum > 0));
        return 0;
    }
}
