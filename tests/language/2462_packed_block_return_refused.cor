// test: a return inside a packed block is refused
// expect-compile-error: a return inside a packed block (using (Packed.Mmx())): the block is compiled as a function of its own, and the return would leave only it
// The block's body is a function of its own (Parser.ParsePackedBlock): a
// return there would end the block, not the method it is written in, and
// the method would go on as if it had not returned.

using System;

static class Program
{
    static int Main()
    {
        int n = 0;
        using (Packed.Mmx())
        {
            n++;
            if (n > 0) return 1;
        }
        return n;
    }
}
