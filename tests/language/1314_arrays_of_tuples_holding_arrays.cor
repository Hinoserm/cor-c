// test: arrays_of_tuples_holding_arrays
// expect-exit: 0
// expect-output:
// 3 6 9 12 15 18 21
// True False False False False False
// False True False False False False
// False False True False False False
// False False False True False False
// False False False False True False
// False False False False False True
// as 3 3 4 4 5 5
// int? 7
//
// ARRAYS OF TUPLES THAT HOLD ARRAYS, every shape in one unit: an int beside
// an int[], the two the other way round, two int[]s, an int[][], a nullable
// int beside an int?[], and the same tuple one array deeper. Each array type
// is a descriptor of its own, named for its element; the names once made
// `_` of every bracket, comma and space, and two of these were one symbol
// with two descriptors -- "an item with the same key" in the compiler's
// own late units, which hold tuples of int arrays throughout. Each array is
// asked whether it is each of the others (`is`) and taken as its own (`as`):
// every type its own, as in .NET.

using System;

static class P
{
    static int Sum(int[]? a) { int s = 0; if (a != null) foreach (int x in a) s += x; return s; }

    static string Is(object o) =>
        (o is (int, int[])[]) + " " + (o is (int[], int)[]) + " " + (o is (int[], int[])[]) + " "
        + (o is (int, int[][])[]) + " " + (o is (int?, int?[])[]) + " " + (o is (int, int[])[][]);

    static int Main()
    {
        (int, int[])[] a = { (1, new[] { 2 }) };
        (int[], int)[] b = { (new[] { 2, 4 }, 0) };
        (int[], int[])[] c = { (new[] { 4 }, new[] { 5 }) };
        (int, int[][])[] d = { (2, new[] { new[] { 5, 5 } }) };
        (int?, int?[])[] e = { (7, new int?[] { 8, null }) };
        (int, int[])[][] f = { new[] { (10, new[] { 11 }) } };

        Console.WriteLine((a[0].Item1 + Sum(a[0].Item2)) + " " + Sum(b[0].Item1) + " " + (Sum(c[0].Item1) + Sum(c[0].Item2)) + " "
            + (d[0].Item1 + Sum(d[0].Item2[0])) + " " + (e[0].Item1!.Value + e[0].Item2[0]!.Value) + " "
            + (f[0][0].Item1 + Sum(f[0][0].Item2) - 3) + " 21");

        object[] all = { a, b, c, d, e, f };
        foreach (object o in all) Console.WriteLine(Is(o));

        object oa = a, ob = b, oc = c, od = d, oe = e, of = f;
        Console.WriteLine("as " + ((oa as (int, int[])[]) == null ? 0 : 3) + " " + ((ob as (int[], int)[]) == null ? 0 : 3) + " "
            + ((oc as (int[], int[])[]) == null ? 0 : 4) + " " + ((od as (int, int[][])[]) == null ? 0 : 4) + " "
            + ((oe as (int?, int?[])[]) == null ? 0 : 5) + " " + ((of as (int, int[])[][]) == null ? 0 : 5));
        Console.WriteLine("int? " + e[0].Item1);
        return 0;
    }
}
