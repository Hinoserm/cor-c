// test: a fork made by a signal handler: the child runs handlers after it, whichever thread ran the forking one
// flags: --cpu=athlon64 --disable-3dnow
// expect-exit: 0
// expect-output:
// rounds 24 children wrong 0
//
// A HANDLER RUNS ON THE DELIVERING THREAD, or on a thread in Os.Pause that
// found the signal before that thread took it (Settle). A fork made by the
// handler copies whichever it was. Where it was the delivering thread, the
// child's only thread is that one, still delivering. Where it was the
// pausing thread, the delivering thread stayed
// behind with the parent: the child must be given one of its own, or no
// handler ever runs in it again -- the child sends itself SIGTERM after
// the fork and leaves 0 if that handler ran, 3 if five seconds passed.
// The delivering thread's copy is asked the same: it sends itself
// SIGTERM from the handler and goes on delivering, and the second
// handler leaves 0 for it; a thread it starts first leaves 3 after five
// seconds if nothing did. Which thread wins is the run's to say, so the
// program asks two dozen times and counts the children that did not
// leave 0.
using System;
using System.Runtime.InteropServices;
using System.Threading;

sealed class Forking : PosixSignalHandler
{
    public void Invoke(PosixSignalContext context)
    {
        context.Cancel = true;
        int pid = UnixProcess.Fork();
        if (pid == 0)
        {
            Program.InChild = true;
            // The delivering thread's copy: no thread of the program came
            // with it, and it must go on delivering once this returns.
            if (Environment.CurrentManagedThreadId != Program.First)
            {
                Program.OnDelivering = true;
                Thread watch = new Thread(() => { Thread.Sleep(5000); Environment.Exit(3); });
                watch.IsBackground = true;
                watch.Start();
                UnixProcess.Kill(Environment.ProcessId, (int)PosixSignal.SIGTERM);
            }
        }
        else Volatile.Write(ref Program.Child, pid);
    }
}

sealed class Counting : PosixSignalHandler
{
    public static int Ran;

    public void Invoke(PosixSignalContext context)
    {
        context.Cancel = true;
        Interlocked.Increment(ref Ran);
        if (Program.OnDelivering) Environment.Exit(0);
    }
}

static class Program
{
    public static int First, Child;
    public static volatile bool InChild, OnDelivering;

    static int Main()
    {
        First = Environment.CurrentManagedThreadId;
        PosixSignalRegistration forking = PosixSignalRegistration.Create(PosixSignal.SIGHUP, new Forking());
        PosixSignalRegistration counting = PosixSignalRegistration.Create(PosixSignal.SIGTERM, new Counting());
        int wrong = 0, rounds = 0;
        for (; rounds < 24; rounds++)
        {
            Volatile.Write(ref Child, 0);
            UnixProcess.Kill(Environment.ProcessId, (int)PosixSignal.SIGHUP);
            // Returns when the handler has run -- here, or on the delivering thread.
            Os.Pause();
            if (InChild)
            {
                // The pausing thread's copy, the handler done: handlers must still run.
                UnixProcess.Kill(Environment.ProcessId, (int)PosixSignal.SIGTERM);
                for (int waited = 0; waited < 5000 && Volatile.Read(ref Counting.Ran) < 1; waited += 5) Thread.Sleep(5);
                return Volatile.Read(ref Counting.Ran) >= 1 ? 0 : 3;
            }
            int pid = Volatile.Read(ref Child);
            // (Pause returns only once the handler has run and left the pid; none is a fork that failed.)
            if (pid <= 0) { wrong++; continue; }
            int status;
            UnixProcess.WaitPid(pid, out status);
            if (UnixProcess.Result(status) != 0) wrong++;
        }
        Console.WriteLine("rounds " + rounds + " children wrong " + wrong);
        GC.KeepAlive(forking);
        GC.KeepAlive(counting);
        return 0;
    }
}
