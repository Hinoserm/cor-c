// sb append count ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than or equal to the size of the collection. (Parameter 'startIndex')
// sb append chars ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than or equal to the size of the collection. (Parameter 'charCount')
// sb remove past ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than or equal to the size of the collection. (Parameter 'length')
// sb insert count ArgumentOutOfRangeException: count ('-1') must be a non-negative value. (Parameter 'count') | Actual value was -1.
// sb length ArgumentOutOfRangeException: value ('-1') must be a non-negative value. (Parameter 'value') | Actual value was -1.
// sb replace ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than or equal to the size of the collection. (Parameter 'count')
// sb equals ArgumentOutOfRangeException: capacity ('-1') must be a non-negative value. (Parameter 'capacity') | Actual value was -1.
//
// The string, StringBuilder, encoding, array and memory refusals of .NET
// 10, in its order and words: Substring, Remove, Insert (the place compared
// unsigned), ToCharArray (checked before any read), CopyTo, the
// constructors and Join over a run among them.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Text;

static class Program
{
    static void Try(string what, Func<object?> a)
    {
        try { object? r = a(); Console.WriteLine((what + " ok " + (r is char[] ca ? "len " + ca.Length : r is string[] sa ? "len " + sa.Length : r)).TrimEnd()); }
        catch (Exception e) { Console.WriteLine(what + " " + e.GetType().Name + ": " + e.Message.Replace("\n", " | ")); }
    }

    static void Main()
    {
        string s = "abc";
        Try("sub -1", () => s.Substring(-1));
        Try("sub 4", () => s.Substring(4));
        Try("sub 3", () => s.Substring(3));
        Try("sub 0 -1", () => s.Substring(0, -1));
        Try("sub 1 3", () => s.Substring(1, 3));
        Try("sub 4 0", () => s.Substring(4, 0));
        Try("sub -1 1", () => s.Substring(-1, 1));
        Try("insert 4", () => s.Insert(4, "x"));
        Try("insert null", () => s.Insert(0, null!));
        Try("remove 4", () => s.Remove(4));
        Try("remove 1 5", () => s.Remove(1, 5));
        Try("remove -1 1", () => s.Remove(-1, 1));
        Try("remove 1 -1", () => s.Remove(1, -1));
        Try("indexof 4", () => s.IndexOf('a', 4));
        Try("indexof 1 5", () => s.IndexOf('a', 1, 5));
        Try("indexof 1 -1", () => s.IndexOf('a', 1, -1));
        Try("indexofs -1", () => s.IndexOf("a", -1));
        Try("indexofs 4", () => s.IndexOf("a", 4));
        Try("indexofs 1 5", () => s.IndexOf("a", 1, 5));
        Try("indexofany -1", () => s.IndexOfAny(new[] { 'a' }, -1));
        Try("lastindexof 3", () => s.LastIndexOf('a', 3));
        Try("lastindexof -1", () => s.LastIndexOf('a', -1));
        Try("lastindexof 2 4", () => s.LastIndexOf('a', 2, 4));
        Try("lastindexofs 3", () => s.LastIndexOf("a", 3));
        Try("lastindexofs -1", () => s.LastIndexOf("a", -1));
        Try("tochararray -1", () => s.ToCharArray(-1, 1));
        Try("tochararray 1 5", () => s.ToCharArray(1, 5));
        Try("copyto", () => { s.CopyTo(-1, new char[3], 0, 1); return null; });
        Try("copyto2", () => { s.CopyTo(0, new char[3], 2, 2); return null; });
        Try("copyto3", () => { s.CopyTo(0, new char[3], 0, -1); return null; });
        Try("copyto4", () => { s.CopyTo(2, new char[3], 0, 2); return null; });
        Try("ctor -1", () => new string('a', -1));
        Try("ctor arr -1", () => new string(new[] { 'a' }, -1, 1));
        Try("ctor arr 0 2", () => new string(new[] { 'a' }, 0, 2));
        Try("ctor arr len -1", () => new string(new[] { 'a' }, 0, -1));
        Try("join -1", () => string.Join(",", new[] { "a" }, -1, 1));
        Try("join 0 2", () => string.Join(",", new[] { "a" }, 0, 2));
        Try("split -1", () => s.Split(',', -1));
        Try("padleft big", () => s.PadLeft(2));
        Try("replace empty", () => s.Replace("", "x"));
        Try("replace null", () => s.Replace(null!, "x"));
        Try("compare -1", () => string.Compare(s, -1, s, 0, 1));
        Try("compare len -1", () => string.Compare(s, 0, s, 0, -1));
        Try("startswith null", () => s.StartsWith((string)null!));
        Try("chars", () => s[3]);
        Try("chars -1", () => s[-1]);
        Try("concat", () => string.Concat((string?)null, null));
        Try("utf8 getstring", () => Encoding.UTF8.GetString(new byte[2], 1, 2));
        Try("ascii getstring len", () => Encoding.ASCII.GetString(new byte[2], 0, -1));
        Try("ascii getstring past", () => Encoding.ASCII.GetString(new byte[2], 1, 2));
        Try("latin1 getstring", () => Encoding.Latin1.GetString(new byte[2], -1, 1));
        Try("unicode getstring", () => Encoding.Unicode.GetString(new byte[2], -1, 1));
        Try("utf8 getbytes past", () => Encoding.UTF8.GetBytes("abc", 1, 3, new byte[4], 0));
        Try("ascii getbytes", () => Encoding.ASCII.GetBytes("abc", -1, 1, new byte[4], 0));
        Try("ascii getbytes short", () => Encoding.ASCII.GetBytes("abc", 0, 3, new byte[2], 0));
        Try("utf8 getbytes short", () => Encoding.UTF8.GetBytes("abc", 0, 3, new byte[2], 0));
        Try("utf8 getbytes idx", () => Encoding.UTF8.GetBytes("abc", 0, 3, new byte[4], 5));
        Try("utf8 getchars", () => Encoding.UTF8.GetChars(new byte[2], -1, 1));
        Try("utf8 getcharcount", () => Encoding.UTF8.GetCharCount(new byte[2], 0, 3));
        Try("utf8 getbytecount", () => Encoding.UTF8.GetByteCount(new[] { 'a' }, 0, 2));
        Try("array reverse past", () => { Array.Reverse(new int[3], 2, 2); return null; });
        Try("array reverse null", () => { Array.Reverse((int[])null!, 0, 1); return null; });
        Try("array indexof past", () => Array.IndexOf(new int[3], 0, 4));
        Try("array indexof count", () => Array.IndexOf(new int[3], 0, 1, 3));
        Try("array indexof count -1", () => Array.IndexOf(new int[3], 0, 1, -1));
        Try("array lastindexof", () => Array.LastIndexOf(new int[3], 0, 3));
        Try("array lastindexof count", () => Array.LastIndexOf(new int[3], 0, 1, 3));
        Try("array fill", () => { Array.Fill(new int[3], 1, 2, 2); return null; });
        Try("array fill neg", () => { Array.Fill(new int[3], 1, -1, 2); return null; });
        Try("array clear neg", () => { Array.Clear(new int[3], 1, -1); return null; });
        Try("array clear past", () => { Array.Clear(new int[3], 2, 2); return null; });
        Try("array resize", () => { int[] a = new int[2]; Array.Resize(ref a, -1); return null; });
        Try("array copy segment", () => new ArraySegment<int>(new int[3], 2, 2));
        Try("hashset cap", () => new HashSet<int>(-1));
        Try("memory", () => new Memory<int>(new int[3], 2, 2));
        Try("memory slice", () => new Memory<int>(new int[3]).Slice(4));
        Try("rom", () => new ReadOnlyMemory<int>(new int[3], -1, 1));
        Try("sb tostring", () => new StringBuilder("ab").ToString(1, 2));
        Try("sb tostring neg", () => new StringBuilder("ab").ToString(-1, 1));
        Try("sb chars", () => new StringBuilder("ab")[2]);
        Try("sb append count", () => new StringBuilder().Append("abc", 1, 3));
        Try("sb append chars", () => new StringBuilder().Append(new[] { 'a' }, 0, 2));
        Try("sb remove past", () => new StringBuilder("ab").Remove(1, 2));
        Try("sb insert count", () => new StringBuilder("ab").Insert(0, "x", -1));
        Try("sb length", () => new StringBuilder("ab").Length = -1);
        Try("sb replace", () => new StringBuilder("ab").Replace("a", "b", 1, 2));
        Try("sb equals", () => new StringBuilder("ab").EnsureCapacity(-1));
    }
}
