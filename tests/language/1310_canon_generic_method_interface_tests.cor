// test: canon_generic_method_interface_tests
// expect-exit: 0
// expect-output:
// direct: collection 3, list 3
// kind list: collection 3, list 3
// kind set: collection 2, no list
// kind sequence: not a collection, no list
// kind other: not a collection, no list
// kind objects: collection 2, list 2
// inferred: collection 3, list 3
// twice: twice collection 3, list 3
// switched list: read-only list 3
// switched set: collection 2
// switched sequence: sequence
// switched other: nothing
// cast count 3
// cast set 2
// other cast: InvalidCastException
// string faces: equatable True, comparable True
// item faces: equatable False, comparable False
// int faces: equatable True, comparable True
// int as object faces: equatable False, comparable False
// int as string faces: equatable False, comparable False
// char faces: equatable True, comparable True
// direct int faces: equatable True, comparable True
// direct long faces of an int: equatable False, comparable False
// string as object faces: equatable False, comparable False
// pairs item int: dictionary 1
// pairs item string: no dictionary
// pairs other int: no dictionary
//
// A generic method called from a shared generic copy with the copy's T: the
// method's copy is made over object, the one type the shared code can name,
// and a test there of an interface over U -- `o is ICollection<U>` -- asked
// for ICollection of object, which a List of Item does not implement. So
// the call reaches the shared method copy, which is handed the descriptor
// of what T is for the object at hand as a hidden argument, and asks the
// object for the interface of that family over it (Runtime.ShapedAs).
// Every answer must be .NET's: true for the T the shelf was made with,
// false for another; through `is`, `as`, a cast, a switch expression's
// arms; a T inferred rather than written; a U handed on to another such
// method; a string's IEquatable<string> and IComparable<string>, which its
// table does not name, and a boxed number's IEquatable<X> and
// IComparable<X> of its own type alone, whichever way the test is made;
// and an interface over the class's T and a method's
// own type argument together.

using System;
using System.Collections.Generic;

class Item
{
    public readonly int N;
    public Item(int n) { N = n; }
}

class Other { }

static class Ask
{
    public static string Kind<U>(object? o)
    {
        string a = o is ICollection<U> c ? "collection " + c.Count : "not a collection";
        IReadOnlyList<U>? list = o as IReadOnlyList<U>;
        string b = list is null ? "no list" : "list " + list.Count;
        return a + ", " + b;
    }

    public static string Inferred<U>(U witness, object o) => Kind<U>(o);

    public static string Twice<U>(object o) => "twice " + Kind<U>(o);

    public static string Switched<U>(object o) => o switch
    {
        IReadOnlyList<U> r => "read-only list " + r.Count,
        ICollection<U> c => "collection " + c.Count,
        IEnumerable<U> e => "sequence",
        _ => "nothing",
    };

    public static int CastCount<U>(object o) => ((ICollection<U>)o).Count;

    public static string Faces<U>(object o) => "equatable " + (o is IEquatable<U>) + ", comparable " + (o is IComparable<U>);

    public static string Pairs<K, V>(object o) => o is IDictionary<K, V> d ? "dictionary " + d.Count : "no dictionary";
}

class Shelf<T>
{
    public object? Held;
    public T? Sample;

    public string Kind() => Ask.Kind<T>(Held);

    public string Inferred() => Ask.Inferred(Sample!, Held!);

    public string Twice() => Ask.Twice<T>(Held!);

    public string Switched() => Ask.Switched<T>(Held!);

    public int CastCount() => Ask.CastCount<T>(Held!);

    public string Faces() => Ask.Faces<T>(Held!);

    public string Pairs<V>() => Ask.Pairs<T, V>(Held!);
}

// A value-type T: a copy of its own, whose test of IEquatable<T> names it.
class Faced<T>
{
    public object? Held;

    public string Faces() => Ask.Faces<T>(Held!);
}

static class P
{
    static IEnumerable<Item> Gen()
    {
        for (int i = 1; i <= 4; i++) yield return new Item(10 + i);
    }

    static int Main()
    {
        List<Item> list = new() { new Item(1), new Item(2), new Item(3) };
        HashSet<Item> set = new() { new Item(4), new Item(5) };
        List<object> objects = new() { new Item(6), "seven" };
        Dictionary<Item, int> pairs = new();
        pairs[new Item(8)] = 8;

        Console.WriteLine("direct: " + Ask.Kind<Item>(list));
        Console.WriteLine("kind list: " + new Shelf<Item> { Held = list }.Kind());
        Console.WriteLine("kind set: " + new Shelf<Item> { Held = set }.Kind());
        Console.WriteLine("kind sequence: " + new Shelf<Item> { Held = Gen() }.Kind());
        Console.WriteLine("kind other: " + new Shelf<Other> { Held = list }.Kind());
        Console.WriteLine("kind objects: " + new Shelf<object> { Held = objects }.Kind());
        Console.WriteLine("inferred: " + new Shelf<Item> { Held = list, Sample = new Item(9) }.Inferred());
        Console.WriteLine("twice: " + new Shelf<Item> { Held = list }.Twice());

        Console.WriteLine("switched list: " + new Shelf<Item> { Held = list }.Switched());
        Console.WriteLine("switched set: " + new Shelf<Item> { Held = set }.Switched());
        Console.WriteLine("switched sequence: " + new Shelf<Item> { Held = Gen() }.Switched());
        Console.WriteLine("switched other: " + new Shelf<Other> { Held = list }.Switched());

        Console.WriteLine("cast count " + new Shelf<Item> { Held = list }.CastCount());
        Console.WriteLine("cast set " + new Shelf<Item> { Held = set }.CastCount());
        try
        {
            Console.WriteLine("other cast " + new Shelf<Other> { Held = list }.CastCount());
        }
        catch (InvalidCastException)
        {
            Console.WriteLine("other cast: InvalidCastException");
        }

        Console.WriteLine("string faces: " + new Shelf<string> { Held = "abc" }.Faces());
        Console.WriteLine("item faces: " + new Shelf<Item> { Held = "abc" }.Faces());
        Console.WriteLine("int faces: " + new Faced<int> { Held = 5 }.Faces());
        Console.WriteLine("int as object faces: " + new Shelf<object> { Held = 5 }.Faces());
        Console.WriteLine("int as string faces: " + new Shelf<string> { Held = 5 }.Faces());
        Console.WriteLine("char faces: " + new Faced<char> { Held = 'c' }.Faces());
        Console.WriteLine("direct int faces: " + Ask.Faces<int>(5));
        Console.WriteLine("direct long faces of an int: " + Ask.Faces<long>(5));
        Console.WriteLine("string as object faces: " + new Shelf<object> { Held = "abc" }.Faces());

        Console.WriteLine("pairs item int: " + new Shelf<Item> { Held = pairs }.Pairs<int>());
        Console.WriteLine("pairs item string: " + new Shelf<Item> { Held = pairs }.Pairs<string>());
        Console.WriteLine("pairs other int: " + new Shelf<Other> { Held = pairs }.Pairs<int>());
        return 0;
    }
}
