// test: linq_consumer_foreign_struct_enumerator_keeps_its_owner
// units: tests/language/support/2056_over_units.cor
// expect-exit: 0
// expect-output:
// positive 15000 -3,-2,-1,0,1,2,3,4,5
// total 9000 -3,-2,-1,0,1,2,3,4,5
// head -3000 -3,-2,-1,0,1,2,3,4,5
//
// A sequence of this unit whose GetEnumerator boxes a struct holding it -- a
// box owning no field, as List's enumerator is, so the sequence is only held
// -- and whose Current, a call the other unit's walk makes on that box,
// keeps it. The only keeper of its kind in the image.

using System;
using System.Collections;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

sealed class Owner : IEnumerable<int>
{
    public readonly int[] Items;

    public Owner(int n, int at)
    {
        Items = new int[n];
        for (int i = 0; i < n; i++) Items[i] = at + i;
    }

    public IEnumerator<int> GetEnumerator() => new Walker(this);

    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();

    public override string ToString() => string.Join(",", Items);
}

struct Walker : IEnumerator<int>
{
    public static Owner? Seen;
    readonly Owner _owner;
    int _at;

    public Walker(Owner owner)
    {
        _owner = owner;
        _at = -1;
    }

    public bool MoveNext()
    {
        _at++;
        return _at < _owner.Items.Length;
    }

    public int Current
    {
        get
        {
            Seen = _owner;
            return _owner.Items[_at];
        }
    }

    object IEnumerator.Current => Current;

    public void Reset() { _at = -1; }

    public void Dispose() { }
}

static class P
{

    static List<int> MakeAt(int n, int at) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(at + i); return l; }

    // WHAT A BLOCK FREED TOO SOON BECOMES: lists of the kept ones' shape and
    // arrays of their arrays' sizes, other numbers in them, made and held while
    // the kept ones are read. Under verified frees such a block is poisoned
    // instead, and a second free ends the run.
    static readonly List<int>[] JunkLists = new List<int>[4096];
    static readonly int[][] JunkArrays = new int[4096][];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkLists.Length; k++)
        {
            JunkLists[k] = MakeAt(9, 100);
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
        }
        Gc.Collect();
    }

    // A thousand calls, their results added: the last call's object is the one read afterwards.
    static long Rounds(Func<int, int> f) { long t = 0; for (int k = 0; k < 1000; k++) t += f(9); return t; }

    static string Show(IEnumerable<int>? s) => s is null ? "null" : string.Join(",", s);

    static string Rest(IEnumerator<int> e) { string s = ""; while (e.MoveNext()) s += (s.Length > 0 ? "," : "") + e.Current; return s; }

    static readonly Owner[] JunkOwners = new Owner[4096];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Positive(int n) => Over.Positive(new Owner(n, -3));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Total(int n) => Over.Total(new Owner(n, -3));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Head(int n) => Over.Head(new Owner(n, -3));

    static string Kept()
    {
        for (int k = 0; k < JunkOwners.Length; k++) JunkOwners[k] = new Owner(9, 100);
        Churn();
        Owner? s = Walker.Seen;
        Walker.Seen = null;
        return s is null ? "none" : s.ToString();
    }

    static void Line(string name, Func<int, int> f)
    {
        long total = Rounds(f);
        Console.WriteLine(name + " " + total + " " + Kept());
    }

    static void Main()
    {
        Line("positive", Positive);
        Line("total", Total);
        Line("head", Head);
    }
}
