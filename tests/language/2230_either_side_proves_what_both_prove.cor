// test: either_side_proves_what_both_prove
// expect-exit: 0
// expect-no-compile-warning: warning CS86
// expect-output:
// 0 1 1 3 2 1
//
// A disjunction proves what each of its sides proves, as C# reads it: `sym
// is LocalSym or ParamSym` (two type tests), `(side is string || side is
// int[] && c)`, `accessor is not { Virtual: true } and not { Override: true
// }` false, and `a is null || b is null` false. A value equal to a constant
// that is not null is not null: `a is "x" or "yy"`.
// Expected output from .NET 10.

using System;

abstract class Sym { }
sealed class LocalSym : Sym { public string Name = "l"; }
sealed class ParamSym : Sym { public string Name = "p"; }
sealed class Acc { public bool Virtual; public bool Override; public string Decl = "d"; }

static class Program
{
    static int A(Sym? sym) { if (sym is LocalSym or ParamSym) return sym.GetHashCode() & 0 + 1; return 0; }
    static int B(object? side, bool c) { if ((side is string || side is int[] && c) && side.ToString() != "") return 1; return 0; }
    static int C(Acc? accessor) => accessor is not { Virtual: true } and not { Override: true } || accessor.Decl == "x" ? 0 : 1;
    static int D(string? a, string? b) { if (a is null || b is null) return 0; return a.Length + b.Length; }
    static int E(string? a) { if (a is "x" or "yy") return a.Length; return 0; }
    static int F(string? a, string? b) => a is not null || b is not null ? 1 : 0;

    static int Main()
    {
        Console.WriteLine(A(new LocalSym()) + " " + B("s", true) + " " + C(new Acc { Virtual = true, Override = false }) + " " + D("a", "bc") + " " + E("yy") + " " + F(null, "b"));
        return 0;
    }
}
