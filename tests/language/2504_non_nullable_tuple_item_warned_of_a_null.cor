// test: a non-nullable tuple item, array element or deconstructed place is warned of a null
// expect-exit: 0
// expect-compile-warning: (24,19): warning CS8625: assignment: 'Backing' is not nullable
// expect-compile-warning: (26,18): warning CS8625: assignment: 'Backing' is not nullable
// expect-compile-warning: (29,19): warning CS8625: element 1: 'string' is not nullable
// expect-output:
// done
//
// The other side of 2503: an assignment's target is its declared type, and a
// `(Backing, int)`'s item, a `Backing[]`'s element and a `string` place
// taken a tuple literal apart into are declared without the `?`, so a null
// written to them is warned of as C# warns of it (CS8625).

#nullable enable
using System;

sealed class Backing { }

static class Program
{
    static int Main()
    {
        (Backing, int) t = (new Backing(), 1);
        t.Item1 = null;
        Backing[] all = { new Backing() };
        all[0] = null;
        string s = "";
        int n = 0;
        (s, n) = (null, 5);
        Console.WriteLine("done");
        return 0;
    }
}
