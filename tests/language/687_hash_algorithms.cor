// sha1 a9993e364706816aba3e25717850c26c9cd0d89d
// sha256 ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// sha384 cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
// sha512 ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
// md5-empty d41d8cd98f00b204e9800998ecf8427e
// sha256-1000 41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3
// sha512-200 79f5b4b03cea64c1c5618d1912f5fc584f338a61f52cce1776b62d269e87ff15566ac23c2e0c4df55e038e48a70bc878672e5fffe069438e97d69be7de6d3208
// hmac256 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// hmac512 164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737
// incremental ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// cryptostream ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//
// System.Security.Cryptography's hashes against their published test values
// (FIPS 180-4, RFC 1321, RFC 4231), IncrementalHash read part way and at the
// end, and a CryptoStream hashing what is written through it.

using System.Security.Cryptography;
using System.Text;

static class Program
{
    static string Hex(byte[] bytes)
    {
        StringBuilder made = new StringBuilder();
        foreach (byte b in bytes) made.Append(b.ToString("x2"));
        return made.ToString();
    }

    static byte[] Repeat(char c, int n)
    {
        byte[] made = new byte[n];
        for (int i = 0; i < n; i++) made[i] = (byte)c;
        return made;
    }

    static int Main()
    {
        byte[] abc = Encoding.UTF8.GetBytes("abc");
        Console.WriteLine("md5 " + Hex(MD5.HashData(abc)));
        Console.WriteLine("sha1 " + Hex(SHA1.HashData(abc)));
        Console.WriteLine("sha256 " + Hex(SHA256.HashData(abc)));
        Console.WriteLine("sha384 " + Hex(SHA384.HashData(abc)));
        Console.WriteLine("sha512 " + Hex(SHA512.Create().ComputeHash(abc)));
        Console.WriteLine("md5-empty " + Hex(MD5.Create().ComputeHash(new byte[0])));
        Console.WriteLine("sha256-1000 " + Hex(SHA256.HashData(Repeat('a', 1000))));
        Console.WriteLine("sha512-200 " + Hex(SHA512.HashData(Repeat('b', 200))));

        byte[] key = Encoding.UTF8.GetBytes("Jefe");
        byte[] data = Encoding.UTF8.GetBytes("what do ya want for nothing?");
        Console.WriteLine("hmac256 " + Hex(HMACSHA256.HashData(key, data)));
        Console.WriteLine("hmac512 " + Hex(new HMACSHA512(key).ComputeHash(data)));

        using IncrementalHash hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
        hash.AppendData(Encoding.UTF8.GetBytes("ab"));
        hash.AppendData(Encoding.UTF8.GetBytes("c"));
        string partWay = Hex(hash.GetCurrentHash());
        string atEnd = Hex(hash.GetHashAndReset());
        Console.WriteLine("incremental " + partWay + " " + atEnd);

        using SHA256 sha = SHA256.Create();
        using (CryptoStream sink = new CryptoStream(Stream.Null, sha, CryptoStreamMode.Write))
        {
            sink.Write(abc, 0, 2);
            sink.Write(abc, 2, 1);
        }
        Console.WriteLine("cryptostream " + Hex(sha.Hash!));
        return 0;
    }
}
