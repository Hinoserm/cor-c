// test: negative_long_constant_to_ulong_refused
// expect-compile-error: CS0221: constant value '-9223372036854775808' cannot be converted to a 'ulong'
//
// C#'s CS0221 for a negative long constant cast to ulong, as for
// `(ulong)-1`: `(ulong)long.MinValue` is no constant ulong unless written
// unchecked. A long was taken to fit ulong whatever its sign.

using System;

static class Program
{
    static int Main()
    {
        Console.WriteLine(unchecked((ulong)long.MinValue));
        Console.WriteLine((ulong)long.MinValue);
        return 0;
    }
}
