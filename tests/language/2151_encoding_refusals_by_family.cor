// strict getbytes c idx ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than or equal to the size of the collection. (Parameter 'byteIndex')
//
// Each encoding refuses as .NET's does: UTF-8, ASCII and Latin-1 by their
// own helpers (Array cannot be null, Non-negative number required; ASCII's
// byteIndex, byteCount and chars), UTF-16 and UTF-32 by the range guards,
// and too small a buffer naming the code page and the encoder's fallback.
// Expected output from .NET 10.

using System;
using System.Text;

static class Program
{
    static void Try(string what, Func<object?> a)
    {
        try { object? r = a(); Console.WriteLine(what + " ok " + r); }
        catch (Exception e) { Console.WriteLine(what + " " + e.GetType().Name + ": " + e.Message.Replace("\n", " | ")); }
    }

    static void Main()
    {
        (string, Encoding)[] all = { ("utf8", Encoding.UTF8), ("ascii", Encoding.ASCII), ("unicode", Encoding.Unicode), ("latin1", Encoding.Latin1), ("utf32", Encoding.UTF32), ("strict", new UTF8Encoding(false, true)) };
        foreach ((string n, Encoding e) in all)
        {
            byte[] b = new byte[4];
            char[] c = { 'a', 'b' };
            Try(n + " getstring neg", () => e.GetString(b, -1, 1));
            Try(n + " getstring negcount", () => e.GetString(b, 0, -1));
            Try(n + " getstring past", () => e.GetString(b, 2, 3));
            Try(n + " getstring null", () => e.GetString(null!, 0, 0));
            Try(n + " getchars neg", () => e.GetChars(b, -1, 1));
            Try(n + " getchars past", () => e.GetChars(b, 2, 3));
            Try(n + " getcharcount neg", () => e.GetCharCount(b, -1, 1));
            Try(n + " getcharcount past", () => e.GetCharCount(b, 2, 3));
            Try(n + " getbytecount neg", () => e.GetByteCount(c, -1, 1));
            Try(n + " getbytecount past", () => e.GetByteCount(c, 1, 2));
            Try(n + " getbytecount null", () => e.GetByteCount((char[])null!, 0, 0));
            Try(n + " getbytes arr neg", () => e.GetBytes(c, -1, 1));
            Try(n + " getbytes arr past", () => e.GetBytes(c, 1, 2));
            Try(n + " getbytes s neg", () => e.GetBytes("ab", -1, 1, b, 0));
            Try(n + " getbytes s past", () => e.GetBytes("ab", 1, 2, b, 0));
            Try(n + " getbytes s idx", () => e.GetBytes("ab", 0, 2, b, 5));
            Try(n + " getbytes s short", () => e.GetBytes("ab", 0, 2, new byte[1], 0));
            Try(n + " getbytes s null", () => e.GetBytes((string)null!, 0, 0, b, 0));
            Try(n + " getbytes c short", () => e.GetBytes(c, 0, 2, new byte[1], 0));
            Try(n + " getbytes c idx", () => e.GetBytes(c, 0, 2, b, -1));
        }
    }
}
