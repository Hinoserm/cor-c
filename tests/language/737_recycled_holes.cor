// test: recycled_holes
// expect-exit: 0
// expect-output:
// holes 255
// mostly in holes True
// heap steady True
// intact True
//
// After a collection the holes it leaves are reused a chunk at a time, in
// address order, before any fresh memory (Gc.NextHole) -- holes of four
// cards or more, whose cards no old block shares. Five hundred and twelve
// arrays above that size are made and every other one below the last is
// dropped, so a collection leaves holes that cannot coalesce; as many asked
// for again must land in them -- at a dropped array's start, or where a
// buffer's free tail before it merged in -- and the heap must not grow.
// Not every one: the free tail of the buffer the collection retired is
// old memory too, and is handed out in its turn. A hole fits a request that fills it exactly, so no size here needs a
// bigger one, and the arrays kept are untouched by the reuse around them.
// (Where, not below the last: a newer chunk may be mapped lower. The
// addresses are kept complemented: the table is small enough to live in the
// frame, and the stack is read conservatively -- as addresses they would
// keep the dropped arrays alive.)

static class Program
{
    // The arrays kept are of mixed sizes; the ones dropped, and asked for
    // again, all of one, so any hole fits any request exactly whichever
    // order the chunks are recycled in.
    static int SizeFor(int i)
    {
        return (i & 1) != 0 ? 4200 : 4096 + ((i % 32) + 1) * 8;
    }

    static int Main()
    {
        object?[] keep = new object?[512];
        byte[]?[] again = new byte[]?[512];

        for (int i = 0; i < 512; i++)
        {
            byte[] b = new byte[SizeFor(i)];
            b[0] = (byte)i;
            keep[i] = b;
        }

        long[] dropped = new long[255];
        int holes = 0;

        for (int i = 1; i < 510; i = i + 2)
        {
            dropped[holes] = ~Sys.ArrayData((byte[])keep[i]!);
            keep[i] = null;
            holes = holes + 1;
        }

        Gc.Collect();

        long heap = Gc.HeapBytes;
        int fromHoles = 0;

        for (int i = 1; i < 510; i = i + 2)
        {
            byte[] b = new byte[SizeFor(i)];
            again[i] = b;
            // In a dropped array's place: at its start, or where the free
            // tail of a thread's buffer before it merged into its hole.
            long at = Sys.ArrayData(b);
            bool reused = false;
            for (int h = 0; h < holes; h++)
            {
                long gap = ~dropped[h] - at;
                if (gap >= 0 && gap < 4200) reused = true;
            }
            if (reused) fromHoles = fromHoles + 1;
        }

        bool intact = true;

        for (int i = 0; i < 512; i = i + 2)
        {
            byte[] b = (byte[])keep[i]!;
            if (b.Length != SizeFor(i) || b[0] != (byte)i) intact = false;
        }

        Sys.Print("holes ");
        Sys.PrintInt(holes);
        Sys.PrintLine();
        Sys.Print("mostly in holes ");
        Sys.Print(fromHoles * 8 >= holes * 7 ? "True" : "False");
        Sys.PrintLine();
        Sys.Print("heap steady ");
        Sys.Print(Gc.HeapBytes == heap ? "True" : "False");
        Sys.PrintLine();
        Sys.Print("intact ");
        Sys.Print(intact ? "True" : "False");
        Sys.PrintLine();
        return 0;
    }
}
