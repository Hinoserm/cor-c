// test: event subscription inside its type is the field's compound assignment
// expect-exit: 234
// Inside Button, `Clicked += handler` subscribes through the field-like
// event's field -- the handler runs at the next firing (Seen) -- and a plain
// read of `Clicked` there is the field (its delegate). The subscription is
// void inside as outside, which tests 2644 and 2655 check. Outside, += and -=
// subscribe and unsubscribe: a lambda whose body is one is an Action, and
// `?.` over a null button does nothing.
using System;

class Button
{
    public event Action<int>? Clicked;
    public int Seen;
    public int Fire(int v)
    {
        Clicked?.Invoke(v);
        Clicked += x => Seen += x;
        Clicked?.Invoke(1);
        return Clicked is null ? 0 : Seen;
    }
}

static class Program
{
    static int total;
    static int Main()
    {
        Button b = new();
        b.Clicked += v => total += v;
        b.Clicked += v => total += v * 10;
        Action<int> h = v => total += 100;
        b.Clicked += h;
        b.Clicked -= h;
        Action subscribe = () => b.Clicked += v => total += 100;
        subscribe();
        Button? none = null;
        none?.Clicked += h;
        int inside = b.Fire(2);
        return total + inside;
    }
}
