// test: event subscription inside its type is the field's compound assignment
// expect-exit: 123
// Inside Button, `Clicked += null` subscribes through the field-like event's
// field, and a plain read of `Clicked` there is the field (its delegate);
// the subscription itself is void inside as outside -- Roslyn refuses `var
// copy = (Clicked += null)` with CS0815 (test 2644). Outside, += and -=
// subscribe and unsubscribe: a lambda whose body is one is an Action, and
// `?.` over a null button does nothing.
using System;

class Button
{
    public event Action<int>? Clicked;
    public int Fire(int v) { Clicked?.Invoke(v); Clicked += null; return Clicked is null ? 0 : 1; }
}

static class Program
{
    static int total;
    static int Main()
    {
        Button b = new();
        b.Clicked += v => total += v;
        b.Clicked += v => total += v * 10;
        Action<int> h = v => total += 100;
        b.Clicked += h;
        b.Clicked -= h;
        Action subscribe = () => b.Clicked += v => total += 100;
        subscribe();
        Button? none = null;
        none?.Clicked += h;
        int inside = b.Fire(2);
        return total + inside;
    }
}
