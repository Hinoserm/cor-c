// test: event subscription inside its type is the field's compound assignment
// expect-exit: 123
// Inside Button, `Clicked += null` is the field-like event's field assigned
// and its value the delegate; outside, += and -= subscribe and unsubscribe,
// and are void: a lambda whose body is one is an Action, and `?.` over a
// null button does nothing.
using System;

class Button
{
    public event Action<int>? Clicked;
    public int Fire(int v) { Clicked?.Invoke(v); var copy = (Clicked += null); return copy is null ? 0 : 1; }
}

static class Program
{
    static int total;
    static int Main()
    {
        Button b = new();
        b.Clicked += v => total += v;
        b.Clicked += v => total += v * 10;
        Action<int> h = v => total += 100;
        b.Clicked += h;
        b.Clicked -= h;
        Action subscribe = () => b.Clicked += v => total += 100;
        subscribe();
        Button? none = null;
        none?.Clicked += h;
        int inside = b.Fire(2);
        return total + inside;
    }
}
