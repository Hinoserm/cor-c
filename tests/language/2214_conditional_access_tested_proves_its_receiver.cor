// test: conditional_access_tested_proves_its_receiver
// expect-exit: 0
// expect-no-compile-warning: warning CS86
// expect-output:
// 2 0 0
// 1 -1
// 3 -1
// one none
//
// A conditional access that gave a value had a receiver, and C# knows it
// after the test: `i.Dest?.Type is not (1 or 2)` false, `r?.Name == "x"`
// true, `xs?.Count > 0` true each leave the receiver -- and a tested value
// read by its path -- not null, with no `!` after. The compiler's own
// sources write it so, and were told the receiver may be null. And an
// out parameter `[MaybeNullWhen(false)]` may be given null inside its
// method, as C# lets it: BindResult.TryGetValue writes its accessor so.

using System;
using System.Collections.Generic;
using System.Diagnostics.CodeAnalysis;

sealed class Reg { public int Type; public string? Name; }

sealed class Ins { public Reg? Dest; }

static class Program
{
    static int Kind(Ins i)
    {
        if (i.Dest?.Type is not (1 or 2)) return 0;
        return i.Dest.Type;
    }

    static int Named(Reg? r)
    {
        if (r?.Name == "x") return r.Name.Length;
        return -1;
    }

    static int First(List<int>? xs) => xs?.Count > 0 ? xs[0] : -1;

    static bool TryFind(int k, [MaybeNullWhen(false)] out string found)
    {
        found = k == 1 ? "one" : null;
        return found is not null;
    }

    static int Main()
    {
        Console.WriteLine(Kind(new Ins { Dest = new Reg { Type = 2 } }) + " " + Kind(new Ins()) + " " + Kind(new Ins { Dest = new Reg { Type = 7 } }));
        Console.WriteLine(Named(new Reg { Name = "x" }) + " " + Named(null));
        Console.WriteLine(First(new List<int> { 3 }) + " " + First(null));
        Console.WriteLine((TryFind(1, out string? a) ? a : "none") + " " + (TryFind(2, out string? b) ? b : "none"));
        return 0;
    }
}
