// test: shared_base_field_filled_by_a_derived_class
// expect-exit: 0
// expect-output:
// kept 100 107 8
//
// a generic base's field filled by a non-generic derived class, read by the base's shared getter
using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

public class Base<T> where T : class
{
    protected List<int>? _items;
    public T? Tag;
    [MethodImpl(MethodImplOptions.NoInlining)]
    public List<int>? Items() { return _items; }
}

public sealed class Derived : Base<string>
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    public void Fill(int k) { List<int> l = new List<int>(); for (int i = 0; i < 8; i++) l.Add(k + i); _items = l; }
}

static class P
{
    static List<int>? Kept;
    static List<int>[] Hold = new List<int>[64];
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Once(int k)
    {
        Derived d = new Derived();
        d.Fill(k);
        Kept = d.Items();
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn(int k) { List<int> x = new List<int>(); for (int i = 0; i < 8; i++) x.Add(-7); Hold[k & 63] = x; }
    static void Main()
    {
        Once(100);
        for (int k = 0; k < 200; k++) Churn(k);
        Gc.Collect();
        Console.WriteLine("kept " + Kept![0] + " " + Kept[7] + " " + Kept.Count);
    }
}
