// test: small blocks come from size-class pages, large ones from buffers
// expect-exit: 0
// expect-output:
// size-class buffer passed
//
// A block of a kilobyte or less comes from a page of its size class: freed,
// it is the next block of its class this thread gets, cleared, whatever lies
// around it; a block of another class comes from another page. A larger
// request is still bumped out of the thread's buffer, zeroed. A thread's
// pages given back leave the free index whole.
static class Program
{
    static int Main()
    {
        nuint left = Runtime.Alloc(32);
        nuint reusable = Runtime.Alloc(32);
        nuint right = Runtime.Alloc(32);
        Sys.WriteAddress(left, 111);
        Sys.WriteAddress(right, 222);
        Sys.WriteAddress(reusable, 333);
        nuint leftPage = HeapChunks.Of(left);
        if (leftPage == 0 || HeapChunks.PageClass(leftPage) == 0) return 1;
        Runtime.Free(reusable);
        nuint again = Runtime.Alloc(32);
        if (again != reusable) return 2;
        for (nuint i = 0; i < 32; i += WordSize.Bytes)
            if (Sys.ReadAddress(again + i) != 0) return 3;
        if (Sys.ReadAddress(left) != 111 || Sys.ReadAddress(right) != 222) return 4;

        nuint other = Runtime.Alloc(280);
        if (HeapChunks.Of(other) == leftPage || HeapChunks.PageClass(HeapChunks.Of(other)) == 0) return 5;

        nuint thread = Sys.ThreadBlock();
        nuint large = Runtime.Alloc(4096);
        if (HeapChunks.PageClass(HeapChunks.Of(large)) != 0) return 6;
        if (large < Sys.ReadAddress(thread + Tls.AllocBase) || large >= Sys.ReadAddress(thread + Tls.AllocPtr)) return 7;
        for (nuint i = 0; i < 4096; i += WordSize.Bytes)
            if (Sys.ReadAddress(large + i) != 0) return 8;

        GcLock.Enter();
        Gc.RetireClasses(thread);
        Gc.Retire(thread);
        GcLock.Exit();
        if (!Gc.CheckFreeIndex()) return 9;
        nuint after = Runtime.Alloc(32);
        if (after == left || after == right || after == again) return 10;
        for (nuint i = 0; i < 32; i += WordSize.Bytes)
            if (Sys.ReadAddress(after + i) != 0) return 11;

        Runtime.Free(after);
        Runtime.Free(large);
        Runtime.Free(other);
        Runtime.Free(again);
        Runtime.Free(right);
        Runtime.Free(left);
        Gc.Collect();
        if (!Gc.CheckFreeIndex()) return 12;
        Sys.Print("size-class buffer passed\n");
        return 0;
    }
}
