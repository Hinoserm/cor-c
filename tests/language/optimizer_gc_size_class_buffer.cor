// test: unrelated free size classes do not disable thread-local allocation buffers
// expect-exit: 0
// expect-output:
// size-class buffer passed
//
// A buffer with room answers first: neither an unrelated free size nor a
// hole of exactly the size asked for sends a request past it. Once the
// buffer is retired, a heap with room to grow answers with a new buffer --
// not with the hole of the request's size, which would send every request
// after it through the heap lock one block at a time -- and the hole stays
// in the free index. (It used to be taken there; only a heap at its cap
// takes its holes a request at a time now.)
static class Program
{
    static int Main()
    {
        long left = Runtime.Alloc(32);
        long reusable = Runtime.Alloc(32);
        long right = Runtime.Alloc(32);
        Sys.Poke(left, 111);
        Sys.Poke(right, 222);
        Sys.Poke(reusable, 333);
        Runtime.Free(reusable);
        long thread = Sys.ThreadBlock();
        long cursor = Sys.Peek(thread + Tls.AllocPtr);
        long large = Runtime.Alloc(4096);
        if (large != cursor + 2 * WordSize.Bytes) return 1;
        for (long i = 0; i < 4096; i += WordSize.Bytes)
            if (Sys.Peek(large + i) != 0) return 2;
        long bumped = Sys.Peek(thread + Tls.AllocPtr);
        long again = Runtime.Alloc(32);
        if (again == reusable || again != bumped + 2 * WordSize.Bytes) return 3;
        for (long i = 0; i < 32; i += WordSize.Bytes)
            if (Sys.Peek(again + i) != 0) return 4;
        if (Sys.Peek(left) != 111 || Sys.Peek(right) != 222) return 5;
        long treeHole = Runtime.Alloc(280);
        long treeGuard = Runtime.Alloc(32);
        Runtime.Free(treeHole);
        GcLock.Enter();
        Gc.Retire(thread);
        GcLock.Exit();
        long treeReuse = Runtime.Alloc(280);
        if (treeReuse == treeHole || !Gc.CheckFreeIndex()) return 7;
        Runtime.Free(treeReuse);
        Runtime.Free(treeGuard);
        Runtime.Free(again);
        Runtime.Free(large);
        Runtime.Free(right);
        Runtime.Free(left);
        long marker = Runtime.Alloc(100);
        long unused = Sys.Peek(thread + Tls.AllocLimit) - Sys.Peek(thread + Tls.AllocPtr);
        long charged = Gc.Since;
        GcLock.Enter();
        Gc.Retire(thread);
        GcLock.Exit();
        long expected = charged > unused ? charged - unused : 0;
        if (Gc.Since != expected) return 6;
        Runtime.Free(marker);
        Gc.Collect();
        Sys.Print("size-class buffer passed\n");
        return 0;
    }
}
