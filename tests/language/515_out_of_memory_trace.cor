// test: out_of_memory_trace
// expect-exit: 0
// expect-output:
// caught OutOfMemoryException
// message Exception of type 'System.OutOfMemoryException' was thrown.
// frames Program.Third Program.Second Program.First
// again OutOfMemoryException True
// after 1048576
// died 134
// said Out of memory.
// frames Program.Third Program.Second Program.First
// lines no
//
// A HEAP THAT HAS RUN OUT THROWS, as .NET's does: an OutOfMemoryException,
// which a program may catch, let go of what it held, and carry on. The
// exception is the one the heap made in advance -- there is no memory to
// make one when it is needed -- with .NET's words for it, and the trace it
// records at the throw is taken with nothing made: the return addresses
// written into an array made with it, past the allocator's own frames, as
// .NET's trace begins at the method whose allocation failed. Naming them
// waits for StackTrace to be read, by when the catch has given memory back.
//
// Nobody catching it ends the process as .NET's does: "Out of memory." on
// standard error, and 134, abort()'s status. Then what .NET leaves out and
// this heap can still say with nothing made: the frames, each name written
// straight out of the frame table the code generator puts in every image
// (docs/software/X86-BACKEND.md) -- no line numbers, which would mean
// decoding a line program per frame -- and what the heap held.
//
// That child is a separate process because the exception ends it. The
// parent reads its standard error and asks what the report named.
static class Program
{
    static int Sink;

    /// Asks for a megabyte at a time and keeps every one, so a capped heap
    /// reaches its cap and a collection finds nothing to free. The three
    /// recurse so that the optimiser leaves them standing: an inlined frame
    /// is not a frame, here or in .NET.
    static void Third(int n, byte[][] kept)
    {
        if (n > 0) { Third(n - 1, kept); Sink = Sink + n; return; }

        for (int i = 0; i < kept.Length; i++)
        {
            kept[i] = new byte[1048576];
        }
    }

    static void Second(int n, byte[][] kept)
    {
        if (n > 0) { Second(n - 1, kept); Sink = Sink + n; return; }
        Third(1, kept);
    }

    static void First(int n, byte[][] kept)
    {
        if (n > 0) { First(n - 1, kept); Sink = Sink + n; return; }
        Second(1, kept);
    }

    /// The name on one row of a trace: what follows "   at ". A run of the
    /// same name counts once, because each helper recurses and so appears
    /// twice, and rows that are not frames -- the heap's own numbers -- are
    /// passed over.
    static string Named(string report, int which)
    {
        int at = 0;
        int seen = 0;
        string last = "";

        while (at < report.Length)
        {
            int end = report.IndexOf('\n', at);
            if (end < 0) { end = report.Length; }

            string row = report.Substring(at, end - at);
            at = end + 1;

            if (!row.StartsWith("   at ")) { continue; }

            string name = row.Substring(6);
            int cut = name.IndexOf('(');
            if (cut >= 0) { name = name.Substring(0, cut); }
            cut = name.IndexOf(' ');
            if (cut >= 0) { name = name.Substring(0, cut); }
            if (name == last) { continue; }
            last = name;

            if (seen == which) { return name; }
            seen = seen + 1;
        }
        return "";
    }

    /// The frames a trace named that belong to THIS test's three, innermost
    /// first, after whatever named frame comes first, which must be the
    /// innermost of them: nothing of the allocator's comes before it. What
    /// called the three depends on what the optimiser inlined into what, and
    /// is not the test's business.
    static string Ours(string report)
    {
        if (Named(report, 0) != "Program.Third") { return "began at " + Named(report, 0); }
        string said = "";

        for (int i = 0; Named(report, i).Length > 0; i++)
        {
            string name = Named(report, i);

            if (name != "Program.Third" && name != "Program.Second" && name != "Program.First") { continue; }
            said = said.Length == 0 ? name : said + " " + name;
        }
        return said;
    }

    /// Caught: the trace named once the memory is back, and the heap
    /// usable again after.
    static void Caught()
    {
        byte[][] kept = new byte[64][];

        Gc.SetLimit(4194304);
        try
        {
            First(1, kept);
            Console.WriteLine("not thrown");
        }
        catch (OutOfMemoryException e)
        {
            for (int i = 0; i < kept.Length; i++) { kept[i] = null!; }
            Console.WriteLine("caught " + e.GetType().Name);
            Console.WriteLine("message " + e.Message);
            Console.WriteLine("frames " + Ours(e.StackTrace ?? ""));
        }

        // The same exception again, as .NET's is the same object each time.
        try
        {
            First(1, kept);
        }
        catch (OutOfMemoryException e)
        {
            for (int i = 0; i < kept.Length; i++) { kept[i] = null!; }
            Console.WriteLine("again " + e.GetType().Name + " " + e.StackTrace!.Contains("Program.Third"));
        }
        byte[] after = new byte[1048576];
        Console.WriteLine("after " + after.Length);
    }

    static void Starve()
    {
        byte[][] kept = new byte[64][];

        Gc.SetLimit(4194304);
        First(1, kept);

        // Never reached: nothing catches what the heap throws.
        Environment.Exit(0);
    }

    static int Main()
    {
        Caught();

        int[]? pair = UnixProcess.Pipe();

        if (pair == null)
        {
            Console.WriteLine("pipe bad");
            return 1;
        }

        int child = UnixProcess.Fork();

        if (child == 0)
        {
            UnixProcess.Close(pair[0]);
            UnixProcess.Dup2(pair[1], 2);
            UnixProcess.Close(pair[1]);
            Starve();
        }

        UnixProcess.Close(pair[1]);

        StreamReader reading = new StreamReader(new FileStream(pair[0], FileAccess.Read, true));
        string report = reading.ReadToEnd();

        reading.Dispose();

        int status = 0;

        UnixProcess.WaitPid(child, out status);
        Console.WriteLine("died " + UnixProcess.Result(status));

        int line = report.IndexOf('\n');
        Console.WriteLine("said " + (line < 0 ? report : report.Substring(0, line)));
        Console.WriteLine("frames " + Ours(report));

        // No line numbers: this walk does not decode a line program.
        Console.WriteLine(report.Contains(":line ") ? "lines yes" : "lines no");
        return 0;
    }
}
