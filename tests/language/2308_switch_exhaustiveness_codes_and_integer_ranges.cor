// test: switch_exhaustiveness_codes_and_integer_ranges
// expect-exit: 0
// expect-compile-warning: (57,35): warning CS8655
// expect-compile-warning: (59,35): warning CS8655
// expect-compile-warning: (60,35): warning CS8655
// expect-compile-warning: (61,34): warning CS8509
// expect-compile-warning: (64,32): warning CS8655
// expect-compile-warning: (65,32): warning CS8655
// expect-compile-warning: (66,32): warning CS8655
// expect-compile-warning: (68,32): warning CS8655
// expect-compile-warning: (69,32): warning CS8655
// expect-compile-warning: (72,33): warning CS8509
// expect-compile-warning: (77,32): warning CS8846
// expect-compile-warning: (78,36): warning CS8847
// expect-compile-warning: (79,33): warning CS8847
// expect-compile-warning: (82,32): warning CS8846
// expect-compile-warning: (86,32): warning CS8509
// expect-no-compile-warning: (56,
// expect-no-compile-warning: (58,
