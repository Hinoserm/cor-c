// test: an interrupt handler may not use the packed registers, itself or through a method it calls
// expect-compile-error: 'Program.Tick' is an interrupt handler and must not use the packed registers
// A packed operation takes the thread's x87 and MMX state for its own; an
// interrupt handler runs on whatever thread it interrupted, in the middle of
// whatever that thread was doing with them, and has not saved them.

using System;

static class Program
{
    static int _n;

    static void Blend()
    {
        _n += (int)Packed.Add8(Packed.FromBits(1UL), Packed.FromBits(0UL)).Bits;
    }

    [InterruptHandler]
    static void Tick()
    {
        Blend();
    }

    static int Main()
    {
        Tick();
        return _n == 1 ? 0 : 1;
    }
}
