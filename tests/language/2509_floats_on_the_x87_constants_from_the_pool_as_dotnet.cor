// store 3F2AAAAB load 4011555556000000
//
// Test 2507's program where --cpu has no SSE: every float and double on the
// x87, each result rounded by its store, constants read from the object's
// pool (Selector.PoolHome) -- a float's four bytes, a double's eight, its
// high word by the pool's symbol. The same answers as .NET 10's, but where
// a NaN meets another NaN: which survives is the x87's choice, not SSE's.
using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)] static float Neg(float x) => -x;
    [MethodImpl(MethodImplOptions.NoInlining)] static double Neg(double x) => -x;
    [MethodImpl(MethodImplOptions.NoInlining)] static int ToInt(float x) => (int)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static int ToInt(double x) => (int)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static uint ToUInt(float x) => (uint)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static uint ToUInt(double x) => (uint)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static long ToLong(float x) => (long)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static ulong ToULong(double x) => (ulong)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static double Widen(float x) => x;
    [MethodImpl(MethodImplOptions.NoInlining)] static float Narrow(double x) => (float)x;
    [MethodImpl(MethodImplOptions.NoInlining)] static float FromInt(int x) => x;
    [MethodImpl(MethodImplOptions.NoInlining)] static double FromUInt(uint x) => x;
    [MethodImpl(MethodImplOptions.NoInlining)] static float FromLong(long x) => x;
    [MethodImpl(MethodImplOptions.NoInlining)] static float Mad(float a, float b, float c) => a * b + c * 0.5f - 3f / a;
    [MethodImpl(MethodImplOptions.NoInlining)] static double Mad(double a, double b, double c) => a * b + c * 0.5 - 3.0 / a;
    [MethodImpl(MethodImplOptions.NoInlining)] static float Sub(float a, float b) => b - a;
    [MethodImpl(MethodImplOptions.NoInlining)] static double Root(double a) => Math.Sqrt(a);
    [MethodImpl(MethodImplOptions.NoInlining)] static float RootF(float a) => MathF.Sqrt(a);
    [MethodImpl(MethodImplOptions.NoInlining)] static int Bits(float a) => BitConverter.SingleToInt32Bits(a);
    [MethodImpl(MethodImplOptions.NoInlining)] static long Bits(double a) => BitConverter.DoubleToInt64Bits(a);
    [MethodImpl(MethodImplOptions.NoInlining)] static float FromBits(int b) => BitConverter.Int32BitsToSingle(b);
    [MethodImpl(MethodImplOptions.NoInlining)] static double FromBits(long b) => BitConverter.Int64BitsToDouble(b);
    [MethodImpl(MethodImplOptions.NoInlining)] static float Store(float[] a, double d) { a[1] = (float)d; return a[1] * 2; }
    [MethodImpl(MethodImplOptions.NoInlining)] static double Load(float[] a) { double s = 0; for (int i = 0; i < a.Length; i++) s += a[i]; return s; }

    static string H(float x) => Bits(x).ToString("X8");
    static string H(double x) => Bits(x).ToString("X16");

    static int Main()
    {
        float[] fs = { 0f, -0f, 1.5f, -1.5f, float.NaN, -float.NaN, float.PositiveInfinity, float.NegativeInfinity, float.Epsilon,
            2147483520f, 2147483648f, -2147483648f, -2147483904f, 4294967040f, 4294967296f, -0.75f, 3.4e38f, 1e-40f };
        double[] ds = { 0.0, -0.0, 1.5, -1.5, double.NaN, -double.NaN, double.PositiveInfinity, double.NegativeInfinity, double.Epsilon,
            2147483647.75, 2147483648.0, -2147483648.5, -2147483649.0, 4294967295.5, 4294967296.0, -0.75, 1.7e308, 1e-310, 1e300 };
        foreach (float f in fs)
            Console.WriteLine($"f {H(f)} neg {H(Neg(f))} int {ToInt(f)} uint {ToUInt(f)} long {ToLong(f)} wide {H(Widen(f))} root {H(RootF(f))} mad {(float.IsNaN(f) ? "nan" : H(Mad(f, 3f, -f)))} sub {H(Sub(f, 1.25f))}");
        foreach (double d in ds)
            Console.WriteLine($"d {H(d)} neg {H(Neg(d))} int {ToInt(d)} uint {ToUInt(d)} ulong {ToULong(d)} narrow {H(Narrow(d))} root {H(Root(d))} mad {(double.IsNaN(d) ? "nan" : H(Mad(d, 3.0, -d)))}");
        foreach (int i in new[] { 0, 1, -1, int.MaxValue, int.MinValue, 16777217, -16777217 })
            Console.WriteLine($"i {i} {H(FromInt(i))} {H(FromUInt((uint)i))} {H(FromLong(i * 3L))}");
        foreach (int b in new[] { 0x3F800000, unchecked((int)0x80000000), 0x7FC00001, unchecked((int)0xFFC00000) })
            Console.WriteLine($"bits {b:X8} {H(FromBits(b))}");
        foreach (long b in new[] { 0x3FF0000000000000L, unchecked((long)0x8000000000000000UL), 0x7FF8000000000001L, 0x0000000000000001L })
            Console.WriteLine($"bits {b:X16} {H(FromBits(b))}");
        float[] arr = { 1f, 2f, 3f };
        Console.WriteLine($"store {H(Store(arr, 1.0 / 3.0))} load {H(Load(arr))}");
        return 0;
    }
}
