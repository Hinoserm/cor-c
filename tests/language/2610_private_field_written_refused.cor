// test: private_field_written_refused
// expect-compile-error: CS0122: 'Account._balance' is inaccessible due to its protection level
// Written, not read: another type's private field is out of reach by `=`
// as by a read.
class Account
{
    int _balance;
}

static class Program
{
    static int Main()
    {
        Account a = new Account();
        a._balance = 5;
        return 0;
    }
}
