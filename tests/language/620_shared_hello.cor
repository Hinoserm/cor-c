// test: shared hello
// expect-exit: 0
// expect-output:
// hello
// 6 3
//
// THE SMALLEST THING A SHARED CLASS LIBRARY HAS TO DO. Printing goes through
// Console, which is libSystem.Console.so; the string it is given was built by
// String.Concat, which is libcorsacrt.so; the number was formatted there too.
// Three images, one line of output.
//
// tests/tools/shared-libraries.sh compiles this one --dynamic and runs it
// against build/lib. Here it is linked statically, which is what says that
// the two ways of building it agree.
static class Program
{
    static void Main()
    {
        Console.WriteLine("hello");
        string text = "abcdef";
        Console.WriteLine("" + text.Length + " " + text.Substring(1, 3).Length);
    }
}
