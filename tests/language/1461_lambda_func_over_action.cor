// test: a lambda with a value prefers Func<T> to Action, generic or not
// expect-exit: 0
// expect-output:
// 7
// done
// 9
//
// C#'s better conversion (12.6.4.5): a lambda whose body has a value
// converts better to a delegate that returns one than to one returning
// void. Ui<T>(Func<T>) beside Ui(Action) took the Action and its answer was
// void: "cannot convert 'void' to 'Rectangle'" in the session tests.

using System;

static class Host
{
    public static T Ui<T>(Func<T> work) { return work(); }
    public static void Ui(Action work) { work(); Console.WriteLine("done"); }
}

static class Program
{
    static int Main()
    {
        int seven = Host.Ui(() => 7);
        Console.WriteLine(seven);
        Host.Ui(() => { });
        Console.WriteLine(Host.Ui(() => 4 + 5));
        return 0;
    }
}
