// test: lap_region_frame_freed_on_every_way_out
// expect-exit: 0
// expect-output:
// broken 109120000 bad 0
// nested 3009000 bad 0
//
// Exits and nesting: a frame object with a clean owned field made every lap,
// the loop left from its body (break), and the same inside an inner loop
// whose outer loop makes a probe before it on odd laps.
using System;
using System.Runtime.CompilerServices;

sealed class Node { public int V; public Node? Next; public Node(int v) { V = v; } }
sealed class BoxN { public Node? Head; public int Tag; }

static class P
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static Node MakeNode(int v) { Node n = new Node(v); n.Next = new Node(v + 1); return n; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int UseN(BoxN b) => b.Head!.V + b.Head.Next!.V + b.Tag;
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int[] Probe(int lap, int m) { int[] a = new int[m]; for (int k = 0; k < m; k++) a[k] = lap * 100 + k; return a; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Check(int[] l, int lap)
    {
        for (int k = 0; k < l.Length; k++) if (l[k] != lap * 100 + k) return 1;
        return 0;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Broken(int laps, int m, int stop)
    {
        long sum = 0; int bad = 0;
        for (int lap = 0; lap < laps; lap++)
        {
            int[]? probe = null;
            if ((lap & 1) == 1) probe = Probe(lap, m);
            BoxN b = new BoxN();
            b.Head = MakeNode(lap);
            b.Tag = lap;
            sum += UseN(b);
            if (probe != null) bad += Check(probe, lap);
            if (lap == stop) break;
        }
        int[] after = Probe(7, m);
        bad += Check(after, 7);
        return sum * 1000 + bad;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Nested(int outer, int inner, int m)
    {
        long sum = 0; int bad = 0;
        for (int o = 0; o < outer; o++)
        {
            int[]? probe = null;
            if ((o & 1) == 1) probe = Probe(o, m);
            for (int i = 0; i < inner; i++)
            {
                BoxN b = new BoxN();
                b.Head = MakeNode(o + i);
                b.Tag = i;
                sum += UseN(b);
            }
            if (probe != null) bad += Check(probe, o);
        }
        return sum * 1000 + bad;
    }

    static void Main()
    {
        long r = 0;
        for (int k = 0; k < 200; k++) r += Broken(1000, 6, 500 + k);
        Console.WriteLine("broken " + (r / 1000) + " bad " + (r % 1000));
        r = Nested(1000, 3, 6);
        Console.WriteLine("nested " + (r / 1000) + " bad " + (r % 1000));
    }
}
