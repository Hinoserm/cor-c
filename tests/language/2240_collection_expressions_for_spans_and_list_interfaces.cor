// test: collection_expressions_for_spans_and_list_interfaces
// expect-exit: 0
// expect-output:
// 3 7 8 List`1
// 4 b 3 0 List`1
//
// A collection expression becomes what its target is, as C# 12 makes it: a
// Span or ReadOnlySpan of the elements (corc looked for an Add on the
// span), and a List for an ICollection or IList, spreads included.
// Expected output from .NET 10.

using System;

static class Program
{
    static int Main()
    {
        System.Collections.Generic.ICollection<int> c = [1, 2, 3];
        System.Collections.Generic.IList<string> l = ["a", "b"];
        ReadOnlySpan<char> r = ['x', 'y', 'z'];
        Span<int> empty = [];
        c.Add(4);
        int[] arr = [5, 6];
        System.Collections.Generic.IList<int> spread = [.. arr, 7];
        Span<int> sp = [7, 8];
        Console.WriteLine(spread.Count + " " + spread[2] + " " + sp[1] + " " + spread.GetType().Name);
        Console.WriteLine(c.Count + " " + l[1] + " " + r.Length + " " + empty.Length + " " + c.GetType().Name);
        return 0;
    }
}
