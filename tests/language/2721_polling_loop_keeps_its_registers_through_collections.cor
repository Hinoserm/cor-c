// test: polling_loop_keeps_its_registers_through_collections
// expect-exit: 0
// expect-output:
// kept True 600 True
//
// A LOOP THAT POLLS KEEPS ITS VALUES IN REGISTERS through the poll (MOp.CallSafe:
// the back edge's call keeps EAX, ECX and EDX, the three a call takes), and
// the collector still finds the objects only those registers hold: the
// spinner below walks four rings of nodes it holds nowhere else -- in the
// loop's registers, the poll the only call they cross -- while the main
// thread allocates enough to make the collector run many rounds, each of
// which the spinner answers at its back edge. Every link is checked each lap.
using System;
using System.Collections.Generic;
using System.Threading;
static class Program
{
    sealed class Node { public int Value; public Node Next = null!; public string Tag = ""; }
    static volatile bool s_done;
    static volatile bool s_started;
    static int s_sum;
    static bool s_ok = true;

    static Node Ring(int n)
    {
        Node first = new() { Value = 0, Tag = "n0" }, at = first;
        for (int i = 1; i < n; i++) { at.Next = new Node { Value = i, Tag = "n" + i }; at = at.Next; }
        at.Next = first;
        return first;
    }

    static void Spin()
    {
        Node a = Ring(3), b = Ring(5), c = Ring(7), d = Ring(11);
        s_started = true;
        int laps = 0;
        bool whole = true;
        // Not counted: ends when the flag says, so its back edge polls. The
        // rings are read nowhere after the loop and nothing in it is a call
        // but the poll: four rings, a lap count and a flag are six values for
        // the six registers, three of them the ones a call takes -- the poll
        // the one call they cross. Each lap checks every node is one of its
        // ring's.
        while (!s_done)
        {
            whole &= a.Value < 3 & b.Value < 5 & c.Value < 7 & d.Value < 11;
            a = a.Next; b = b.Next; c = c.Next; d = d.Next;
            laps++;
        }
        s_ok = whole;
        s_sum = laps > 0 ? 600 : 1;
    }

    static int Main()
    {
        Thread t = new(Spin);
        t.Start();
        while (!s_started) Thread.Yield();
        List<string> keep = new();
        for (int round = 0; round < 200; round++)
        {
            List<int[]> waste = new();
            for (int i = 0; i < 2000; i++) waste.Add(new int[64]);
            keep.Add(round.ToString());
            if (keep.Count > 50) keep.RemoveAt(0);
        }
        s_done = true;
        t.Join();
        Console.WriteLine("kept " + s_ok + " " + s_sum + " " + (keep.Count == 50));
        return 0;
    }
}
