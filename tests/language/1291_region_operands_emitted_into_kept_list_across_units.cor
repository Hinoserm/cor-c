// test: region_operands_emitted_into_kept_list_across_units
// units: tests/language/support/1291_region_operands_emitted_units.cor
// expect-exit: 0
// expect-output:
// compiled 20000 ok
// kept 400 ok
//
// The compiler's own selector, in small: helpers make immediates and
// temporaries and emit instructions (each owning a list of operands copied
// from its params array) into the block the builder is in, this._cur, found
// through a dictionary of block heads; Builder.Run hands back the function
// alone. Every operand outlives Run, reached from the function by its blocks,
// their instructions and their operand lists. Made in a region of Run's, or
// of a helper's, an operand is freed when it returns, and the peephole pass
// after -- here at once and again much later -- reads memory other regions
// have reused, and writes over it (the native compiler linked with escape
// graphs died in Runtime.FreeOwnedFields, freeing such an operand).

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

static class P
{
    // What other regions make in the meantime: the same shapes, dropped.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Scribble(int seed)
    {
        List<MInstr> junk = new();
        for (int n = 0; n < 16; n++) junk.Add(new MInstr(seed & 7, new MImm(seed + n, "junk"), new MReg(-seed - n)));
        long sum = 0;
        foreach (MInstr i in junk) sum += i.Operands.Count;
        return sum;
    }

    // As X86Backend.Compile: select, then (after other work) the peephole pass.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static bool Compile(int seed)
    {
        Function f = Builder.Run(seed % 97, 24 + seed % 5);
        Scribble(seed);
        return Peephole.Run(f);
    }

    // A function compiled and kept, its peephole pass run long after.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static Function Kept(int seed) => Builder.Run(seed % 89, 20 + seed % 7);

    // Not Main itself: what the entry calls is never a boundary.
    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Run()
    {
        Function[] kept = new Function[400];
        int ok = 0;
        long junk = 0;
        for (int k = 0; k < 20000; k++)
        {
            if (Compile(k)) ok++;
            kept[k % 400] = Kept(k);
            junk += Scribble(k);
            if (k % 2000 == 1999) GC.Collect();
        }
        GC.Collect();
        int keptOk = 0;
        foreach (Function f in kept) if (Peephole.Run(f)) keptOk++;
        Console.WriteLine("compiled " + ok + (ok == 20000 ? " ok" : " BAD"));
        Console.WriteLine("kept " + keptOk + (keptOk == kept.Length ? " ok" : " BAD"));
        return junk;
    }

    static int Main() { Run(); return 0; }
}
