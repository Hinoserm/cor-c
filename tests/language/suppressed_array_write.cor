// test: suppressed array write
// expect-exit: 0
// expect-output:
// read 2
// cleared True
// kept 1
//
// `a![i] = null` on an array of nullable elements. The `!` says the ARRAY
// is there; what it may hold is still what its declaration says, so storing
// null into an element is legal, as C# has it. Reading through the same
// suppression still sees the element as not null.

class Box
{
    public int Value;

    public Box(int value)
    {
        Value = value;
    }
}

static class Program
{
    static Box?[]? _boxes;

    static void Say(string label, long value)
    {
        Sys.Print(label);
        Sys.PrintInt(value);
        Sys.PrintLine();
    }

    static int Main()
    {
        _boxes = new Box?[3];
        _boxes![0] = new Box(1);
        _boxes![1] = new Box(2);

        Say("read ", _boxes![1]!.Value);

        _boxes![1] = null;
        Sys.Print("cleared ");
        Sys.Print(_boxes[1] == null ? "True" : "False");
        Sys.PrintLine();

        int kept = 0;
        for (int i = 0; i < 3; i++)
        {
            if (_boxes![i] != null) kept++;
        }
        Say("kept ", kept);
        return 0;
    }
}
