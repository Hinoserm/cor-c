// test: numeric formats C and P on every type, E/R/G<n> on integers, exponents and per-mille in pictures
// expect-exit: 0
// expect-output:
// C => [¤12,345.68] [(¤0.26)] [¤42.00] [(¤7.00)] [¤1.50]
// C2 => [¤12,345.68] [(¤0.26)] [¤42.00] [(¤7.00)] [¤1.50]
// C0 => [¤12,346] [(¤0)] [¤42] [(¤7)] [¤2]
// E2 => [1.23E+004] [-2.56E-001] [4.20E+001] [-7.00E+000] [1.50E+000]
// e => [1.234568e+004] [-2.560000e-001] [4.200000e+001] [-7.000000e+000] [1.500000e+000]
// E => [1.234568E+004] [-2.560000E-001] [4.200000E+001] [-7.000000E+000] [1.500000E+000]
// P1 => [1,234,567.8 %] [-25.6 %] [4,200.0 %] [-700.0 %] [150.0 %]
// P => [1,234,567.80 %] [-25.60 %] [4,200.00 %] [-700.00 %] [150.00 %]
// F => [12345.68] [-0.26] [42.00] [-7.00] [1.50]
// N => [12,345.68] [-0.26] [42.00] [-7.00] [1.50]
// N3 => [12,345.678] [-0.256] [42.000] [-7.000] [1.500]
// G => [12345.678] [-0.256] [42] [-7] [1.5]
// G3 => [1.23E+04] [-0.256] [42] [-7] [1.5]
// R => [12345.678] [-0.256] [42] [-7] [1.5]
// X => FormatException FormatException [2A] [FFFFFFFFFFFFFFF9] FormatException
// D5 => FormatException FormatException [00042] [-00007] FormatException
// 0.00 => [12345.68] [-0.26] [42.00] [-7.00] [1.50]
// #,##0.0 => [12,345.7] [-0.3] [42.0] [-7.0] [1.5]
// 0.###E+0 => [1.235E+4] [-2.56E-1] [4.2E+1] [-7E+0] [1.5E+0]
// 00.0% => [1234567.8%] [-25.6%] [4200.0%] [-700.0%] [150.0%]
// #.# => [12345.7] [-.3] [42] [-7] [1.5]
// ‰0 => [‰12345678] [-‰256] [‰42000] [-‰7000] [‰1500]
// long.MaxValue 9.223E+018 9.22337203685477580700E+018 9.22E+18 9.22E+18 922,337,203,685,477,580,700 %
// long.MinValue -9223372036854775808 (¤9,223,372,036,854,775,808) -9.22E+018 -9.2E+18E+0
// ulong.MaxValue ¤18,446,744,073,709,551,615 18446744073709551615.0 1.8E+019 1.8E+19 18446744073709552
// uint 00042 42 4E+001 ¤42.00 4,200 % 42.0
// int 1.23E+04 1.23e+04 1E+03 0.00E+000 0 1.2E+04
// pictures 12.3E+3 1.2e-04 0E+0 500.0E-2 1.0E+01 [1.2E+3 m] 1.23 0 -0.01 [] -0.00
// float and double 1e+20 1E+20 16777220.00 NaN -Infinity 25.6 % (¤0)
// no placeholders [-E+2] [E+0] [-E+0] 1.1 1.1 3.4028235e+38
// fraction text [7 m] [- m] [7 m] [50%] [1.2x5] [12.3]
//
// The standard numeric letters .NET has and this library did not: "C" (the
// invariant culture's currency, a negative in parentheses) and "P" (times a
// hundred, then " %") for doubles, floats and every integer type; "E", "R"
// and a "G" precision for integers, rounded on the integer's own digits so a
// long keeps all nineteen; and every letter for the unsigned types. Pictures
// gain an exponent -- "0.###E+0", the whole part filling its placeholders --
// and the per-mille sign, which multiplies by a thousand. An exponent with no
// placeholder in front of it still carries the minus (a whole number's only
// when it did not round to nought), and a float's "R" ignores its precision
// as .NET's does. Text after a '#' that has no digit to write is still
// written, and the minus with it. Every line was taken from the same program
// run on .NET 10 against the invariant culture.

using System;

class Program
{
    static void T(string f, object v)
    {
        try { Console.Write(" [" + string.Format("{0:" + f + "}", v) + "]"); }
        catch (FormatException) { Console.Write(" FormatException"); }
    }

    static int Main()
    {
        object[] values = new object[] { 12345.678, -0.256, 42, -7L, 1.5f };
        string[] formats = new string[] { "C", "C2", "C0", "E2", "e", "E", "P1", "P", "F", "N", "N3", "G", "G3",
                                          "R", "X", "D5", "0.00", "#,##0.0", "0.###E+0", "00.0%", "#.#", "‰0" };

        foreach (string f in formats)
        {
            Console.Write(f + " =>");
            foreach (object v in values) T(f, v);
            Console.WriteLine();
        }

        long most = long.MaxValue;
        Console.WriteLine("long.MaxValue " + most.ToString("E3") + " " + most.ToString("E20") + " " + most.ToString("G3")
            + " " + most.ToString("R3") + " " + most.ToString("P0"));

        long least = long.MinValue;
        Console.WriteLine("long.MinValue " + least.ToString("D") + " " + least.ToString("C0") + " " + least.ToString("E2")
            + " " + least.ToString("0.0E+0E+0"));

        ulong all = ulong.MaxValue;
        Console.WriteLine("ulong.MaxValue " + all.ToString("C0") + " " + all.ToString("F1") + " " + all.ToString("E1")
            + " " + all.ToString("G2") + " " + all.ToString("0,"));

        uint small = 42;
        Console.WriteLine("uint " + small.ToString("D5") + " " + small.ToString("G5") + " " + small.ToString("E0")
            + " " + small.ToString("C") + " " + small.ToString("P0") + " " + small.ToString("F1"));

        int n = 12345;
        Console.WriteLine("int " + n.ToString("G3") + " " + n.ToString("g3") + " " + (999).ToString("G2")
            + " " + (0).ToString("E2") + " " + (0).ToString("G3") + " " + (12000).ToString("R2"));

        Console.WriteLine("pictures " + n.ToString("00.0E+0") + " " + (0.000123).ToString("0.0e-00")
            + " " + (0.0).ToString("#.##E+0") + " " + (5).ToString("##0.0E+0") + " " + (9.96).ToString("0.0E+00")
            + " [" + (1234).ToString("0.0E+0 m") + "] " + (1234).ToString("0,.00") + " " + (-4).ToString("0,")
            + " " + (-7).ToString("0,.00") + " [" + (-0.2).ToString("#") + "] " + (-0.0).ToString("0.00"));

        Console.WriteLine("float and double " + (1e20).ToString("g") + " " + (1e20f).ToString("R")
            + " " + (16777216f).ToString("0.00") + " " + double.NaN.ToString("C")
            + " " + double.NegativeInfinity.ToString("N") + " " + (0.256).ToString("P1") + " " + (-0.256).ToString("C0"));

        Console.WriteLine("no placeholders [" + (-7).ToString("E+0") + "] [" + (-4).ToString("E+0") + "] [" + (-0.25).ToString("E+0")
            + "] " + (1.1f).ToString("R5") + " " + (1.1f).ToString("G00") + " " + float.MaxValue.ToString("r20"));

        Console.WriteLine("fraction text [" + (7).ToString("#.# m") + "] [" + (-0.04).ToString("#.# m") + "] [" + (7).ToString("#. m")
            + "] [" + (0.5).ToString("#.##%") + "] [" + (1.25).ToString("0.#x#") + "] [" + n.ToString("0,.0,") + "]");
        return 0;
    }
}
