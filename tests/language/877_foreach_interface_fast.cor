// test: foreach_interface_fast
// expect-exit: 0
// expect-output:
// list 1,2,4,
// array 1,5,
// subclass 5,4,2,1,
// set 10,
// linq 1,5,
// empty [][]
// sum 6 9
// iter aa|bb cc
// pairs 1x 2y 3z
// co p co q
// captured 5 6
// null throws
// changed InvalidOperationException
// array write seen 41
// uvw
//
// A foreach over a sequence interface walks a List<E> with its own struct
// enumerator and an E[] by index, with no enumerator box, when that is
// exactly what the sequence is; anything else -- a List subclass that
// implements the interface again, a set, an iterator, a covariant array --
// takes the interface's enumerator. Breaks, continues, captures, iterator
// bodies, deconstruction, null and a list changed under the loop all answer
// as .NET's do. Output checked against .NET.

using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;

class Backwards : List<int>, IEnumerable<int>
{
    IEnumerator<int> IEnumerable<int>.GetEnumerator()
    {
        for (int i = Count - 1; i >= 0; i--) yield return this[i];
    }
}

static class Program
{
    static string Walk(IEnumerable<int> items)
    {
        string text = "";
        foreach (int x in items)
        {
            if (x == 3) continue;
            if (x == 7) break;
            text += x + ",";
        }
        return text;
    }

    static int Sum(IReadOnlyList<int> items)
    {
        int sum = 0;
        foreach (var x in items) sum += x;
        return sum;
    }

    static IEnumerable<string> Doubled(IEnumerable<string> words)
    {
        foreach (string w in words) yield return w + w;
    }

    static string Pairs(IEnumerable<(int N, string S)> pairs)
    {
        string text = "";
        foreach (var (n, s) in pairs) text += n + s + " ";
        return text;
    }

    static void Main()
    {
        Console.WriteLine("list " + Walk(new List<int> { 1, 2, 3, 4, 7, 8 }));
        Console.WriteLine("array " + Walk(new[] { 1, 3, 5, 7, 9 }));
        Console.WriteLine("subclass " + Walk(new Backwards { 1, 2, 4, 5 }));
        Console.WriteLine("set " + Walk(new HashSet<int> { 10 }));
        Console.WriteLine("linq " + Walk(Enumerable.Range(1, 9).Where(x => x % 2 == 1)));
        Console.WriteLine("empty [" + Walk(new List<int>()) + "][" + Walk(Array.Empty<int>()) + "]");
        Console.WriteLine("sum " + Sum(new List<int> { 1, 2, 3 }) + " " + Sum(new[] { 4, 5 }));
        Console.WriteLine("iter " + string.Join("|", Doubled(new List<string> { "a", "b" })) + " " + string.Join("|", Doubled(new[] { "c" })));
        Console.WriteLine("pairs " + (Pairs(new List<(int, string)> { (1, "x"), (2, "y") }) + Pairs(new[] { (3, "z") })).TrimEnd());
        IEnumerable<object> covariant = new[] { "p", "q" };
        string co = "";
        foreach (object o in covariant) co += "co " + o + " ";
        Console.WriteLine(co.TrimEnd());
        var actions = new List<Func<int>>();
        IEnumerable<int> captured = new List<int> { 5, 6 };
        foreach (int x in captured) actions.Add(() => x);
        Console.WriteLine("captured " + actions[0]() + " " + actions[1]());
        try
        {
            IEnumerable<int>? none = null;
            foreach (int x in none!) Console.WriteLine(x);
        }
        catch (NullReferenceException) { Console.WriteLine("null throws"); }
        try
        {
            List<int> changing = new() { 1, 2, 3 };
            IEnumerable<int> view = changing;
            foreach (int x in view) changing.Add(x);
        }
        catch (InvalidOperationException e) { Console.WriteLine("changed " + e.GetType().Name); }
        try
        {
            int[] numbers = { 1, 2 };
            IList<int> asList = numbers;
            int total = 0;
            foreach (int x in asList) { numbers[1] = 40; total += x; }
            Console.WriteLine("array write seen " + total);
        }
        catch (Exception e) { Console.WriteLine("array " + e.GetType().Name); }
        ICollection<string> col = new List<string> { "u", "v" };
        foreach (string s in col) Console.Write(s);
        IReadOnlyCollection<string> roc = new[] { "w" };
        foreach (string s in roc) Console.Write(s);
        Console.WriteLine();
    }
}
