// test: strings_and_builders_program
// expect-exit: 0
// expect-output:
// a|b||c| d |e / a|b|c|d|e / a|b;;c, d ;e / a|b|c / x|y|z
// 1, 2 xy123 a-b-c abcd
// 2 3 3 4 0 31 -1 False
// [007][ab  ][trim][hi][abc-def][abef][abcd][a/b/c][bbbbbb]
// TITLE CASE WORDS mixed ell ell 2 **** True True True
// > [   ab|FF]1,2,3\nccc 21 > <[  >
// 12.5Truexyz 1
// True 7 True ß True True True 113 True 1F600 A
// 3 line1|line2|line3 3 1,234.50|ab    |25 %|0042|{x}
//
// A whole small program over strings: Split by chars, strings and counts
// with RemoveEmptyEntries and TrimEntries, Join and Concat of each kind,
// IndexOf/Compare/Equals ordinal and ignoring case (Straße is not STRASSE
// ordinally), padding, trimming, Insert/Remove/Replace, ranges,
// StringBuilder's
// AppendFormat/AppendJoin/AppendLine/Insert/Replace/Remove/Clear and
// appends of every kind, char's classifications and surrogates,
// ReplaceLineEndings, composite format alignment and specifiers. Every line
// as .NET prints it.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text;

static class Program
{
    static int Main()
    {
        CultureInfo.CurrentCulture = CultureInfo.InvariantCulture;
        string csv = "a,b;;c, d ;e";
        Console.WriteLine(string.Join("|", csv.Split(new[] { ',', ';' })) + " / " + string.Join("|", csv.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) + " / " + string.Join("|", csv.Split(',', 2)) + " / " + string.Join("|", "a--b--c".Split("--")) + " / " + string.Join("|", "x y  z".Split(' ', StringSplitOptions.RemoveEmptyEntries)));
        Console.WriteLine(string.Join(", ", new List<int> { 1, 2 }) + " " + string.Concat(new[] { "x", "y" }) + string.Concat(Enumerable.Range(1, 3)) + " " + string.Join('-', "abc".ToCharArray()) + " " + string.Concat("a", "b", "c", "d"));
        Console.WriteLine("Hello".IndexOf("L", StringComparison.OrdinalIgnoreCase) + " " + "Hello".IndexOf('l', 3) + " " + "Hello".LastIndexOf("l") + " " + "Hello".IndexOfAny(new[] { 'x', 'o' }) + " " + string.Compare("apple", "Apple", StringComparison.OrdinalIgnoreCase) + " " + string.CompareOrdinal("a", "B") + " " + "abc".CompareTo("abd") + " " + "Straße".Equals("STRASSE", StringComparison.OrdinalIgnoreCase));
        Console.WriteLine("[" + "7".PadLeft(3, '0') + "][" + "ab".PadRight(4) + "][" + "  trim\t".Trim() + "][" + "xxhixx".Trim('x') + "][" + "abcdef".Insert(3, "-") + "][" + "abcdef".Remove(2, 2) + "][" + "abcdef".Remove(4) + "][" + "a.b.c".Replace('.', '/') + "][" + "aaa".Replace("a", "bb") + "]");
        Console.WriteLine("Title Case words".ToUpperInvariant() + " " + "MiXeD".ToLowerInvariant() + " " + "hello"[1..^1] + " " + "hello".Substring(1, 3) + " " + "a\u0301".Length + " " + new string('*', 4) + " " + string.IsNullOrWhiteSpace(" \t") + " " + "abc".Contains('b') + " " + "abc".StartsWith('a'));
        var sb = new StringBuilder("start");
        sb.AppendFormat(" [{0,5}|{1:X2}]", "ab", 255).AppendJoin(",", 1, 2, 3).AppendLine().Append('c', 3).Insert(0, ">").Replace("start", "S").Remove(1, 1);
        Console.WriteLine(sb.ToString().Replace("\n", "\\n").Replace("\r", "\\r") + " " + sb.Length + " " + sb[0] + " <" + sb.ToString(2, 3) + ">");
        sb.Clear().Append(12.5).Append(true).Append((object?)null).Append('x').Append(new char[] { 'y', 'z' });
        Console.WriteLine(sb + " " + sb.Capacity.ToString().Length.ToString().Length);
        Console.WriteLine(char.IsDigit('7') + " " + char.GetNumericValue('7') + " " + char.IsLetter('é') + " " + char.ToUpper('ß') + " " + char.IsPunctuation('!') + " " + char.IsSymbol('+') + " " + char.IsSeparator(' ') + " " + (int)char.ToLowerInvariant('Q') + " " + char.IsHighSurrogate("😀"[0]) + " " + char.ConvertToUtf32("😀", 0).ToString("X") + " " + char.ConvertFromUtf32(0x41));
        string multi = "line1\nline2\r\nline3";
        Console.WriteLine(multi.Split('\n').Length + " " + string.Join("|", multi.ReplaceLineEndings("/").Split('/')) + " " + multi.Count(c => c == 'l') + " " + string.Format("{0:N2}|{1,-6}|{2:P0}|{3:D4}|{{x}}", 1234.5, "ab", 0.25, 42));
        return 0;
    }
}
