// test: long logical chains in a unit that uses dynamic
// expect-exit: 0
// expect-output:
// True False True
//
// A unit that uses dynamic asks of every `&&` and `||` whether an operand
// is dynamic. A chain of thirty links is answered from its leaves, once
// each; asking it of the whole left side at every link checked the chain
// twice per link, and thirty links never finished. A dynamic leaf anywhere
// in the chain still makes it late-bound.

using System;

static class P
{
    static int Main()
    {
        int[] v = new int[30];
        for (int i = 0; i < 30; i++) v[i] = i;
        bool all = v[0] == 0 && v[1] == 1 && v[2] == 2 && v[3] == 3 && v[4] == 4 && v[5] == 5 && v[6] == 6 && v[7] == 7 && v[8] == 8 && v[9] == 9 && v[10] == 10 && v[11] == 11 && v[12] == 12 && v[13] == 13 && v[14] == 14 && v[15] == 15 && v[16] == 16 && v[17] == 17 && v[18] == 18 && v[19] == 19 && v[20] == 20 && v[21] == 21 && v[22] == 22 && v[23] == 23 && v[24] == 24 && v[25] == 25 && v[26] == 26 && v[27] == 27 && v[28] == 28 && v[29] == 29;
        v[29] = 0;
        bool changed = v[0] == 0 && v[1] == 1 && v[2] == 2 && v[3] == 3 && v[4] == 4 && v[5] == 5 && v[6] == 6 && v[7] == 7 && v[8] == 8 && v[9] == 9 && v[10] == 10 && v[11] == 11 && v[12] == 12 && v[13] == 13 && v[14] == 14 && v[15] == 15 && v[16] == 16 && v[17] == 17 && v[18] == 18 && v[19] == 19 && v[20] == 20 && v[21] == 21 && v[22] == 22 && v[23] == 23 && v[24] == 24 && v[25] == 25 && v[26] == 26 && v[27] == 27 && v[28] == 28 && v[29] == 29;
        dynamic d = true;
        bool late = v[0] == 0 || v[1] == 1 || v[2] == 2 || v[3] == 3 || v[4] == 4 || v[5] == 5 || v[6] == 6 || v[7] == 7 || d;
        Console.WriteLine(all + " " + changed + " " + late);
        return 0;
    }
}
