// test: valued_lambdas_for_actions_in_generic_methods
// expect-exit: 0
// expect-output:
// 12 6
//
// A lambda whose body is an assignment or a call converts to an Action<T>
// of a generic method as to any Action, its value dropped (C# 12.6.3.7
// infers from a delegate's result only when it has one): `Each(xs, v => sum
// += v)`. corc unified the void result with the lambda's long and refused
// the call.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Linq;

static class Program
{
    static void Each<T>(IEnumerable<T> source, Action<T> body) { foreach (T v in source) body(v); }
    static void EachInt(IEnumerable<int> source, Action<int> body) { foreach (int v in source) body(v); }
    static int Bump(int v) => v + 1;

    static int Main()
    {
        long sum = 0; int isum = 0;
        EachInt(Enumerable.Range(1, 3), v => sum += v);
        Each(Enumerable.Range(1, 3), v => { sum += v; });
        Each(Enumerable.Range(1, 3), v => isum += v);
        Each(Enumerable.Range(1, 3), v => Bump(v));
        Console.WriteLine(sum + " " + isum);
        return 0;
    }
}
