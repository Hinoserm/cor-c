// test: packed operations in a body that suspends (an await using) are refused: its frame outlives a run
// expect-compile-error: outside a method's own body -- in a lambda, or in a body that awaits or yields
// Giving back an IAsyncDisposable suspends, as an await does; a body that
// suspends is no method the compiler makes processors' versions of.

using System;
using System.Threading.Tasks;

sealed class Resource : IAsyncDisposable
{
    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

static class Program
{
    static async Task<int> Run()
    {
        int n = 0;
        {
            await using (Resource r = new()) { n++; }
            n += (int)Packed.Add8(Packed.FromBits(1UL), Packed.FromBits(0UL)).Bits;
        }
        return n;
    }

    static int Main() => Run().Result;
}
