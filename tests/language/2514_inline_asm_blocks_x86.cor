// test: inline_asm_blocks_x86
// only-target: x86
// requires-host: mmx sse sse2
// expect-exit: 0
// expect-output:
// add 42
// sum 5050
// memory 23 12
// constant 107
// byte 201
// long 0000000600000004
// x87 5.5
// sse2 6.25
// sse 3
// cpuid True
// push 28
// stos 40
// captured 10
// ref 18
// kept 7 9
// tsc True
//
// INLINE ASSEMBLY ON I386 (docs/INLINE-ASSEMBLY.md): head and tail bindings
// (Add), a loop on the block's own labels (Sum), locals named in the middle,
// as memory, read and written (Memory), a constant written as its number,
// a byte through AL, a long through an MMX register with its EMMS, a double
// on the x87 and in SSE2, a float in SSE, CPUID's EBX under `.runtime cpuid`,
// a balanced PUSH and POP, REP STOSD into a stackalloc buffer, a lambda's
// captured local, a ref parameter, a local written on one path only that
// keeps its value on the other, and RDTSC under `.runtime tsc`.
using System;

static class Program
{
    const int Bias = 100;

    static int Add(int a, int b)
    {
        int r;
        asm
        {
            mov eax, a
            mov ecx, b
            add eax, ecx
            mov r, eax
        }
        return r;
    }

    static int Sum(int n)
    {
        int s;
        asm
        {
            mov ecx, n
            xor eax, eax
        again:
            add eax, ecx
            dec ecx
            jnz again
            mov s, eax
        }
        return s;
    }

    static (int, int) Memory(int k, int x)
    {
        int r;
        asm
        {
            mov eax, 3
            imul eax, k
            add eax, k
            shl x, 2
            mov r, eax
        }
        return (r + 3, x);
    }

    static int Constant(int v)
    {
        int r;
        asm
        {
            mov eax, v
            add eax, Bias
            mov r, eax
        }
        return r;
    }

    static byte Byte(byte b)
    {
        byte c;
        asm
        {
            mov al, b
            add al, 1
            mov c, al
        }
        return c;
    }

    static ulong Long(ulong x)
    {
        ulong y;
        asm
        {
            .runtime mmx
            movq mm0, x
            paddd mm0, mm0
            movq y, mm0
            emms
        }
        return y;
    }

    static double X87(double d)
    {
        double e;
        asm
        {
            fld d
            fadd d
            fstp e
        }
        return e;
    }

    static double Sse2(double d)
    {
        double e;
        asm
        {
            .runtime sse2
            movsd xmm0, d
            mulsd xmm0, xmm0
            movsd e, xmm0
        }
        return e;
    }

    static float Sse(float f)
    {
        float g;
        asm
        {
            .runtime sse
            movss xmm1, f
            addss xmm1, xmm1
            movss g, xmm1
        }
        return g;
    }

    static uint Vendor()
    {
        uint v;
        asm
        {
            .runtime cpuid
            xor eax, eax
            cpuid
            mov v, ebx
        }
        return v;
    }

    static int Push(int a)
    {
        int r;
        asm
        {
            push ebx
            mov ebx, a
            add ebx, ebx
            mov r, ebx
            pop ebx
        }
        return r;
    }

    static unsafe int Stos()
    {
        byte* p = stackalloc byte[16];
        asm
        {
            mov edi, p
            mov ecx, 4
            mov eax, 0x01020304
            rep stosd
        }
        int sum = 0;
        for (int i = 0; i < 16; i++) sum += p[i];
        return sum;
    }

    static int Captured(int z)
    {
        Func<int> f = () =>
        {
            int q;
            asm
            {
                mov eax, z
                add eax, eax
                mov q, eax
            }
            return q;
        };
        return f();
    }

    static void Twice(ref int v)
    {
        asm
        {
            mov eax, v
            add eax, eax
            mov v, eax
        }
    }

    static int Kept(int flag)
    {
        int w = 7;
        asm
        {
            mov eax, flag
            test eax, eax
            jz skip
            mov w, eax
        skip:
        }
        return w;
    }

    static ulong Tsc()
    {
        uint lo, hi;
        asm
        {
            .runtime tsc
            rdtsc
            mov lo, eax
            mov hi, edx
        }
        return ((ulong)hi << 32) | lo;
    }

    static int Main()
    {
        Console.WriteLine("add " + Add(19, 23));
        Console.WriteLine("sum " + Sum(100));
        (int m, int x) = Memory(5, 3);
        Console.WriteLine("memory " + m + " " + x);
        Console.WriteLine("constant " + Constant(7));
        Console.WriteLine("byte " + Byte(200));
        Console.WriteLine("long " + Long(0x0000000300000002UL).ToString("X16"));
        Console.WriteLine("x87 " + X87(2.75));
        Console.WriteLine("sse2 " + Sse2(2.5));
        Console.WriteLine("sse " + Sse(1.5f));
        Console.WriteLine("cpuid " + (Vendor() != 0));
        Console.WriteLine("push " + Push(14));
        Console.WriteLine("stos " + Stos());
        Console.WriteLine("captured " + Captured(5));
        int v = 9;
        Twice(ref v);
        Console.WriteLine("ref " + v);
        Console.WriteLine("kept " + Kept(0) + " " + Kept(9));
        ulong t0 = Tsc(), t1 = Tsc();
        Console.WriteLine("tsc " + (t1 > t0));
        return 0;
    }
}
