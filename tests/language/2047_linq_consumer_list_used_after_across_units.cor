// test: linq_consumer_list_used_after_across_units
// units: tests/language/support/2047_after_units.cor
// expect-exit: 0
// expect-output:
// later 380000 True
// both 640000 True
// twice 300000 True
// built odd 100000 True
// built tripled 540000 True
// after churn 5 -3,-2,-1,0,1,2,3,4,5
// cached 5000 -3,-2,-1,0,1,2,3,4,5
//
// A list another unit's walk keeps nowhere is freed after its last use
// here, not at the walk's return: read again (later), handed to a second
// walk (both), walked twice there through one iterator, the second time
// through the copy GetEnumerator makes (twice). One the other unit made and
// handed over fresh is this unit's to free too (built); one it made and also
// kept (cached) is not. The last two lines read lists after blocks of their
// shape were made again.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

static class P
{
    static List<int> Make(int n) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(i - 3); return l; }

    // What each call left to the collector, and whether the program gave
    // memory back itself meanwhile: frees, or a region's end (1211's measure).
    static string Measure(Func<int, int> f, out long total)
    {
        const int N = 20000;
        total = 0;
        Gc.Collect();
        long taken = Gc.CollectedBytes, frees = Gc.Frees, region = Gc.RegionFreedBytes + Gc.RegionTopFreedBytes;
        for (int k = 0; k < N; k++) total += f(9);
        bool given = Gc.Frees - frees >= N || Gc.RegionFreedBytes + Gc.RegionTopFreedBytes - region >= N * 16;
        Gc.Collect();
        long left = (Gc.CollectedBytes - taken) / N;
        return given && left <= 32 ? "True" : "False " + left;
    }

    static void Say(string name, Func<int, int> f)
    {
        string freed = Measure(f, out long total);
        Console.WriteLine(name + " " + total + " " + freed);
    }

    static List<int> MakeAt(int n, int at) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(at + i); return l; }

    // WHAT A BLOCK FREED TOO SOON BECOMES: lists of the kept ones' shape and
    // arrays of their arrays' sizes, other numbers in them, made and held while
    // the kept ones are read. Under verified frees such a block is poisoned
    // instead, and a second free ends the run.
    static readonly List<int>[] JunkLists = new List<int>[4096];
    static readonly int[][] JunkArrays = new int[4096][];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkLists.Length; k++)
        {
            JunkLists[k] = MakeAt(9, 100);
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
        }
        Gc.Collect();
    }

    // A thousand calls, their results added: the last call's object is the one read afterwards.
    static long Rounds(Func<int, int> f) { long t = 0; for (int k = 0; k < 1000; k++) t += f(9); return t; }

    static string Show(IEnumerable<int>? s) => s is null ? "null" : string.Join(",", s);

    static string Rest(IEnumerator<int> e) { string s = ""; while (e.MoveNext()) s += (s.Length > 0 ? "," : "") + e.Current; return s; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Later(int n) { List<int> l = Make(n); int a = After.Odd(l); return a + l[n - 1] + l.Count; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Both(int n) { List<int> l = Make(n); return After.Odd(l) + After.Tripled(l); }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Twice(int n) => After.Twice(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int BuiltOdd(int n) => After.Odd(After.Build(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int BuiltTripled(int n) => After.Tripled(After.Build(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int CachedOdd(int n) => After.Odd(After.Cached(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static string Churned() { List<int> l = Make(9); int a = After.Odd(l); Churn(); return a + " " + Show(l); }

    static void Main()
    {
        Say("later", Later);
        Say("both", Both);
        Say("twice", Twice);
        Say("built odd", BuiltOdd);
        Say("built tripled", BuiltTripled);
        Console.WriteLine("after churn " + Churned());
        long cached = Rounds(CachedOdd);
        Churn();
        Console.WriteLine("cached " + cached + " " + Show(After.Last));
    }
}
