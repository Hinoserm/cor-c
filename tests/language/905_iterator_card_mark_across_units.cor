// test: iterator_card_mark_across_units
// units: tests/language/support/905_iterator_units.cor
// expect-exit: 0
// expect-output:
// 3280000
//
// An iterator compiled as its own unit and linked into a closed image: its
// card mark is a call written after the IR was archived (AsyncTransform),
// so the link's reachability never saw it and dropped the runtime's helper
// -- 'undefined symbol m_Runtime_CardMarkObject'. It is a link root now.

using System;
using System.Collections.Generic;
class MInstr { public int[] Regs = Array.Empty<int>(); public bool Mov; }
static class P
{
    static IEnumerable<(int Reg, bool IsDef)> AllRegs(MInstr i)
    {
        foreach (int r in i.Regs) yield return (r, false);
        yield return (99, true);
    }
    static int FindCopy(List<MInstr> instrs, int k)
    {
        HashSet<int> touched = new();
        for (int j = k - 1; j >= 0 && j >= k - 6; j--)
        {
            MInstr c = instrs[j];
            if (c.Mov && !touched.Contains(c.Regs[0])) return j;
            foreach ((int r, _) in AllRegs(c)) touched.Add(r);
        }
        return -1 - touched.Count;
    }
    static void Main()
    {
        List<MInstr> instrs = new();
        for (int n = 0; n < 50; n++) instrs.Add(new MInstr { Regs = new[] { n % 7, n % 5, n % 3 }, Mov = n % 11 == 0 });
        long sum = 0;
        for (int r = 0; r < 20000; r++) for (int k = 1; k < instrs.Count; k++) sum += FindCopy(instrs, k);
        Console.WriteLine(sum);
    }
}
