// test: pattern_of_its_own_type_is_a_null_test
// expect-exit: 0
// expect-output:
// derived no base
// sides 4 no shape
// called 7 no call
// held text held 5 empty box
// switch 9 switch null
// nullable of Int32
// not nullable
// node 3 none
// no type
//
// `x is T y` over what is a T already -- a Type? asked whether it is a
// Type, a Node? whether it is a Node, a Base? holding a Derived, an
// interface, a delegate, a generic class in a copy of its own and in a
// shared one, a switch arm -- asks only whether there is one, as C# reads
// it: no run-time type test, which a Type has no object to answer in a
// kernel (the library's dynamic binder, compiled there). Output from
// .NET 10 (probe ~/tmp/dn/sametype).

using System;

sealed class Node { public int Value; public Node(int v) { Value = v; } }
class Base { public virtual string Name => "base"; }
sealed class Derived : Base { public override string Name => "derived"; }
interface IShape { int Sides { get; } }
sealed class Square : IShape { public int Sides => 4; }
sealed class Box<T> { public T Held; public Box(T held) { Held = held; } }

static class Program
{
    static Type? Under(Type t) => Nullable.GetUnderlyingType(t);
    static Node? Find(int k) => k > 0 ? new Node(k) : null;

    static string Say(Type t) => Under(t) is Type under ? "nullable of " + under.Name : "not nullable";
    static string Say(int k) => Find(k) is Node n ? "node " + n.Value : "none";

    static string Kind(Base? b) => b is Base y ? y.Name : "no base";
    static string Sides(IShape? s) => s is IShape y ? "sides " + y.Sides : "no shape";
    static string Call(Func<int>? f) => f is Func<int> g ? "called " + g() : "no call";
    static string Held<T>(Box<T>? b) => b is Box<T> y ? "held " + y.Held : "empty box";
    static string Switch(Node? n) => n switch { Node m => "switch " + m.Value, null => "switch null" };

    static int Main()
    {
        Console.WriteLine(Kind(new Derived()) + " " + Kind(null));
        Console.WriteLine(Sides(new Square()) + " " + Sides(null));
        Console.WriteLine(Call(() => 7) + " " + Call(null));
        Console.WriteLine(Held(new Box<string>("text")) + " " + Held(new Box<int>(5)) + " " + Held<object>(null));
        Console.WriteLine(Switch(new Node(9)) + " " + Switch(null));
        Console.WriteLine(Say(typeof(int?)));
        Console.WriteLine(Say(typeof(string)));
        Console.WriteLine(Say(3) + " " + Say(0));
        Type? maybe = null;
        Console.WriteLine(maybe is Type ? "a type" : "no type");
        return 0;
    }
}
