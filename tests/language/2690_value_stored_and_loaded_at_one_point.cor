// test: value_stored_and_loaded_at_one_point
// expect-exit: 0
// expect-output:
// 71 39 71
//
// A VALUE'S STORE AND ITS LOAD AT ONE POINT: the load. A block of a spilled
// value's window (Allocator.SinkStores) that is entered only from outside
// the window -- loaded there -- and leaves it by its jump alone -- stored
// there -- had both at its one instruction, the store first: the register
// went to the slot before the load had put the value in it. The address
// of `_busy[reg]`, held across the inlined thread-static table lookup of
// BusyTable (the register allocator's own), was so overwritten, and the
// table stored through the stale address: a NullReferenceException on the
// read back, as the compiler's own x86tests met it. The answers are .NET's.
using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
sealed class A
{
    private readonly int[]?[] _busy;
    private readonly List<int>?[]? _busyList;
    private readonly int _fv, _len;
    private readonly int[] _start, _end;
    public A(int fv, int n, int len, bool lists) { _fv = fv; _len = len; _busy = new int[]?[fv]; _busyList = lists ? new List<int>?[fv] : null; _start = new int[n]; _end = new int[n]; Array.Fill(_start, int.MaxValue); }
    [ThreadStatic] private static int[]?[]? _spareBusy;
    private const int KeptBusy = 1 << 16;
    private int[] BusyTable(int reg)
    {
        int[]?[] spare = _spareBusy is { } kept0 && kept0.Length >= _fv ? kept0 : _spareBusy = new int[]?[_fv];
        int[]? kept = spare[reg];
        if (kept is not null && kept.Length >= _len)
        {
            Array.Clear(kept, 0, _len);
            return kept;
        }
        int[] made = new int[_len];
        if (_len <= KeptBusy) spare[reg] = made;
        return made;
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    public void Mark(int reg, int pos)
    {
        if (reg < _fv)
        {
            if (_busyList is not null) (_busyList[reg] ??= new()).Add(pos);
            else (_busy[reg] ??= BusyTable(reg))[pos] = 1;
        }
        else
        {
            _start[reg] = Math.Min(_start[reg], pos);
            _end[reg] = Math.Max(_end[reg], pos);
        }
    }
    public int Sum() { int s = 0; foreach (int[]? t in _busy) if (t != null) foreach (int x in t) s += x; return s + _end[9]; }
}
static class P
{
    static void Main()
    {
        A a = new A(8, 10, 64, false);
        for (int i = 0; i < 40; i++) a.Mark(i % 10, i);
        A b = new A(8, 10, 64, true);
        for (int i = 0; i < 40; i++) b.Mark(i % 10, i);
        A c = new A(8, 10, 64, false);
        for (int i = 0; i < 40; i++) c.Mark(i % 10, i);
        Console.WriteLine(a.Sum() + " " + b.Sum() + " " + c.Sum());
    }
}
