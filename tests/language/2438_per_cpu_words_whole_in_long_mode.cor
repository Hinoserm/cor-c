// test: in long mode a per-processor word is all eight bytes, read and written gs-relative whole
// only-target: x86-64
// expect-exit: 0
// expect-output:
// constant True
// register True
// read whole True
//
// Sys.PerCpuRead and PerCpuWrite carry the target's word: in long mode a
// higher-half kernel pointer, 0xFFFF8000..., among them. Typed as 32 bits,
// the high half was cut going in and coming out, and a word written read
// back as its low half. A value past 2^32, at a constant offset and at one
// known only at run time, is written and read back whole; and a word whose
// high half is set by Sys.Poke is read whole.
using System;
using System.Runtime.CompilerServices;

static class Program
{
    static void Say(string label, bool value)
    {
        Sys.Print(label);
        Sys.Print(value ? " True" : " False");
        Sys.PrintLine();
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long At(long offset) { return Sys.PerCpuRead(offset); }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Put(long offset, long value) { Sys.PerCpuWrite(offset, value); }

    static int Main()
    {
        long block = Sys.ThreadBlock();
        long big = 0x123456789A;
        Sys.PerCpuWrite(Tls.PreemptCount, big);
        bool constant = Sys.Peek(block + Tls.PreemptCount) == big && Sys.PerCpuRead(Tls.PreemptCount) == big;
        Sys.PerCpuWrite(Tls.PreemptCount, 0);
        Say("constant", constant);
        Put(Tls.PreemptCount, big + 1);
        bool register = Sys.Peek(block + Tls.PreemptCount) == big + 1 && At(Tls.PreemptCount) == big + 1;
        Put(Tls.PreemptCount, 0);
        Say("register", register);
        Sys.Poke(block + Tls.PreemptCount, -2);
        bool whole = At(Tls.PreemptCount) == -2;
        Sys.Poke(block + Tls.PreemptCount, 0);
        Say("read whole", whole);
        return 0;
    }
}
