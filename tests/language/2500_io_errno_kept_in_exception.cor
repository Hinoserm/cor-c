// test: io errno kept in the exception
// expect-exit: 0
// expect-output:
// missing directory DirectoryNotFoundException 0x80070003 inner=0x00000002
// not a directory DirectoryNotFoundException 0x80070003 inner=0x00000014
// missing file FileNotFoundException 0x80070002 inner=none
// missing file's directory DirectoryNotFoundException 0x80070003 inner=0x00000002
// access refused UnauthorizedAccessException 0x80070005 inner=0x0000000D
//
// THE ERRNO BEHIND A FAILED FILE CALL, read off the exception caught. Every
// HResult is .NET's own; a type that stands for one errno (ENOENT's
// FileNotFoundException) needs no more, and one that stands for several --
// an access refused, a DirectoryNotFoundException (ENOENT or ENOTDIR) --
// holds the errno in the IOException inside it (Interop), where .NET on
// Unix holds nothing inside a DirectoryNotFoundException and the reason is
// lost. Run as a user: root may read /proc/1/mem.

using System;
using System.IO;

static class Program
{
    static void Try(string what, Action action)
    {
        try { action(); Console.WriteLine(what + " no exception"); }
        catch (Exception e) { Console.WriteLine(what + " " + e.GetType().Name + " 0x" + e.HResult.ToString("X8") + " inner=" + (e.InnerException == null ? "none" : "0x" + e.InnerException.HResult.ToString("X8"))); }
    }

    static int Main()
    {
        Try("missing directory", () => Directory.GetFiles("/no-such-directory-2500"));
        Try("not a directory", () => Directory.GetFiles("/dev/null/x"));
        Try("missing file", () => File.ReadAllText("/dev/no-such-file-2500"));
        Try("missing file's directory", () => File.ReadAllText("/no-such-directory-2500/f"));
        Try("access refused", () => File.ReadAllText("/proc/1/mem"));
        return 0;
    }
}
