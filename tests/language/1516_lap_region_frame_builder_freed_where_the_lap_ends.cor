// test: lap_region_frame_builder_freed_where_the_lap_ends
// expect-exit: 0
// expect-output:
// sb 4890 bad 0
//
// A library collection (StringBuilder, whose body is another unit's) made
// every lap of a loop region; on odd laps a probe array is made before it,
// in the lap's region, where the last lap's buffer was.
using System;
using System.Text;
using System.Runtime.CompilerServices;

static class P
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int[] Probe(int lap, int m) { int[] a = new int[m]; for (int k = 0; k < m; k++) a[k] = lap * 100 + k; return a; }
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Check(int[] l, int lap)
    {
        for (int k = 0; k < l.Length; k++) if (l[k] != lap * 100 + k) return 1;
        return 0;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Laps(int laps, int m)
    {
        long sum = 0; int bad = 0;
        for (int lap = 0; lap < laps; lap++)
        {
            int[]? probe = null;
            if ((lap & 1) == 1) probe = Probe(lap, m);
            StringBuilder sb = new StringBuilder();
            sb.Append('a'); sb.Append('b'); sb.Append(lap);
            sum += sb.Length;
            if (probe != null) bad += Check(probe, lap);
        }
        return sum * 1000 + bad;
    }

    static void Main()
    {
        long r = Laps(1000, 6);
        Console.WriteLine("sb " + (r / 1000) + " bad " + (r % 1000));
    }
}
