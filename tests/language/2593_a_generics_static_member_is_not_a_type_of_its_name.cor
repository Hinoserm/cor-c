// test: a_generics_static_member_is_not_a_type_of_its_name
// expect-exit: 0
// expect-output:
// 1 7 2
//
// `Option<int>.None` is Option's static field, though a generic type named
// None exists too: a chain with arguments before its last name is a type
// nested in a generic one only when that nested template is there
// (Monomorphiser.NestedGenericPath). Asked whole, the chain fell back on its
// last name, made the field the type None<int>, and its member a type's.
class None<T>
{
    public static int Count = 7;
}

class Option<T>
{
    public static Option<T> None = new Option<T>();
    public int Tag = 1;

    public class Some
    {
        public static int Tag = 2;
    }
}

static class Program
{
    static int Main()
    {
        System.Console.WriteLine(Option<int>.None.Tag + " " + None<int>.Count + " " + Option<long>.Some.Tag);
        return 0;
    }
}
