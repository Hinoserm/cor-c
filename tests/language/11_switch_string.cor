// test: switch_string
// expect-exit: 0
// expect-output:
// codes 1 2 3 0 -1 3
// loop 2
//
// switch on a string subject, including the empty string, a value not
// listed, and a subject built at run time so the comparison cannot be done
// on identity.

static class Program
{
    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static int Code(string s)
    {
        switch (s)
        {
            case "red":
                return 1;
            case "green":
                return 2;
            case "blue":
                return 3;
            case "":
                return 0;
            default:
                return -1;
        }
    }

    static int Main()
    {
        string bl = "bl";
        string built = bl + "ue";
        Line("codes " + Code("red") + " " + Code("green") + " " + Code("blue") + " " + Code("") + " " + Code("purple") + " " + Code(built));

        string[] words = new string[] { "red", "x", "green", "y" };
        int hits = 0;
        foreach (string w in words)
        {
            switch (w)
            {
                case "red":
                case "green":
                    hits++;
                    break;
                default:
                    break;
            }
        }
        Line("loop " + hits);
        return 0;
    }
}
