// test: large allocations do not share mappings with small long lived objects
// expect-exit: 0
// expect-output:
// large allocation isolation passed
static class Program
{
    static int Main()
    {
        long[] survivors = new long[128];
        long[] objects = new long[128];
        long before = HeapChunks.HeapBytes;
        for (int i = 0; i < objects.Length; i++)
        {
            long large = Runtime.Alloc(131072);
            long small = Runtime.Alloc(64);
            long largeChunk = HeapChunks.Of(large);
            if (largeChunk == 0 || largeChunk == HeapChunks.Of(small)) return 1;
            if (HeapChunks.Limit(largeChunk) - largeChunk > 135168) return 2;
            if (Sys.Peek(large) != 0 || Sys.Peek(large + 131068) != 0) return 3;
            Sys.Poke(large, i + 1);
            Sys.Poke(small, i + 10);
            objects[i] = large;
            survivors[i] = small;
        }
        long peak = HeapChunks.HeapBytes;
        for (int i = 0; i < objects.Length; i++)
        {
            long large = objects[i];
            if (Sys.Peek(large) != i + 1) return 4;
            objects[i] = 0;
            Runtime.Free(large);
            if (HeapChunks.Of(large) != 0) return 5;
        }
        if (peak - HeapChunks.HeapBytes < 128 * 131072) return 6;
        Gc.Collect();
        for (int i = 0; i < survivors.Length; i++)
        {
            if (Sys.Peek(survivors[i]) != i + 10) return 7;
            Runtime.Free(survivors[i]);
            survivors[i] = 0;
        }
        if (!Gc.CheckFreeIndex()) return 8;
        if (HeapChunks.HeapBytes > before + 2097152) return 9;
        Sys.Print("large allocation isolation passed\n");
        return 0;
    }
}
