// test: large allocations do not share mappings with small long lived objects
// expect-exit: 0
// expect-output:
// large allocation isolation passed

// ROOTS THE COLLECTOR READS A WORD AT A TIME: a block with no descriptor,
// read as every such block is. An array of numbers is not read at all -- it
// holds no reference, as in .NET -- so raw addresses kept in a long[] kept
// nothing alive once that was so; these tests hold theirs here instead.
sealed class Roots
{
    readonly object _block;
    readonly nuint _at;

    public Roots(int count)
    {
        Length = (nuint)count;
        _at = Runtime.Alloc((nuint)(count * 8));
        _block = Sys.ObjectAt(_at);
    }

    public nuint Length { get; }

    public nuint this[nuint i]
    {
        get { return Sys.ReadAddress(_at + i * 8); }
        set { Sys.WriteAddress(_at + i * 8, value); }
    }
}
static class Program
{
    static int Main()
    {
        Roots survivors = new Roots(128);
        Roots objects = new Roots(128);
        long before = HeapChunks.HeapBytes;
        for (nuint i = 0; i < objects.Length; i++)
        {
            nuint large = Runtime.Alloc(131072);
            nuint small = Runtime.Alloc(64);
            nuint largeChunk = HeapChunks.Of(large);
            if (largeChunk == 0 || largeChunk == HeapChunks.Of(small)) return 1;
            if (HeapChunks.Limit(largeChunk) - largeChunk > 135168) return 2;
            if (Sys.ReadAddress(large) != 0 || Sys.ReadAddress(large + 131068) != 0) return 3;
            Sys.WriteAddress(large, i + 1);
            Sys.WriteAddress(small, i + 10);
            objects[i] = large;
            survivors[i] = small;
        }
        long peak = HeapChunks.HeapBytes;
        for (nuint i = 0; i < objects.Length; i++)
        {
            nuint large = objects[i];
            if (Sys.ReadAddress(large) != i + 1) return 4;
            objects[i] = 0;
            Runtime.Free(large);
            if (HeapChunks.Of(large) != 0) return 5;
        }
        if (peak - HeapChunks.HeapBytes < 128 * 131072) return 6;
        Gc.Collect();
        for (nuint i = 0; i < survivors.Length; i++)
        {
            if (Sys.ReadAddress(survivors[i]) != i + 10) return 7;
            Runtime.Free(survivors[i]);
            survivors[i] = 0;
        }
        if (!Gc.CheckFreeIndex()) return 8;
        if (HeapChunks.HeapBytes > before + 2097152) return 9;
        Sys.Print("large allocation isolation passed\n");
        return 0;
    }
}
