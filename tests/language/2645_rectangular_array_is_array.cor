// test: rectangular_array_is_array
// expect-exit: 0
// expect-output:
// is Array True is IList True is ICollection True
// rank 2 length 6 long 6
// lengths 2 3 bounds 0 1 2
// dimension 2 IndexOutOfRangeException
// value 6 2
// set 50
// one index ArgumentException
// wrong count ArgumentException
// out of range IndexOutOfRangeException
// walk 1,2,3,4,50,6,
// copy 1 50 6
// copy across ranks RankException
// clear 1000506
// reverse RankException
// index of RankException
// count 6
// copy to RankException
// ilist get ArgumentException
// ilist contains RankException
// ilist add NotSupportedException
// cube 3 8 x 2
// cleared True
//
// T[,] and T[,,] are System.Array, IList and ICollection, as .NET's are: rank,
// lengths and bounds per dimension, GetValue/SetValue by as many indices as
// dimensions, foreach in row-major order, Array.Copy and Clear over the
// elements flat (a primitive widened), and everything only a one-dimensional
// array answers refused as .NET refuses it. Expected output from real .NET 10.

using System;
using System.Collections;

static class Program
{
    static string Try(Func<object?> f) { try { return "" + f(); } catch (Exception e) { return e.GetType().Name; } }
    static void Main()
    {
        int[,] grid = { { 1, 2, 3 }, { 4, 5, 6 } };
        object boxed = grid;
        Console.WriteLine("is Array " + (boxed is Array) + " is IList " + (boxed is IList) + " is ICollection " + (boxed is ICollection));
        Array a = (Array)boxed;
        Console.WriteLine("rank " + a.Rank + " length " + a.Length + " long " + a.LongLength);
        Console.WriteLine("lengths " + a.GetLength(0) + " " + a.GetLength(1) + " bounds " + a.GetLowerBound(1) + " " + a.GetUpperBound(0) + " " + a.GetUpperBound(1));
        Console.WriteLine("dimension 2 " + Try(() => a.GetLength(2)));
        Console.WriteLine("value " + a.GetValue(1, 2) + " " + a.GetValue(0, 1));
        a.SetValue(50, 1, 1);
        Console.WriteLine("set " + grid[1, 1]);
        Console.WriteLine("one index " + Try(() => a.GetValue(0)));
        Console.WriteLine("wrong count " + Try(() => a.GetValue(1, 2, 3)));
        Console.WriteLine("out of range " + Try(() => a.GetValue(2, 0)));
        string walked = "";
        foreach (object? o in a) walked += o + ",";
        Console.WriteLine("walk " + walked);
        long[,] wide = new long[2, 3];
        Array.Copy(grid, wide, 6);
        Console.WriteLine("copy " + wide[0, 0] + " " + wide[1, 1] + " " + wide[1, 2]);
        int[] flat = new int[6];
        Console.WriteLine("copy across ranks " + Try(() => { Array.Copy(grid, flat, 6); return "done"; }));
        Array.Clear(grid, 1, 3);
        Console.WriteLine("clear " + grid[0, 0] + grid[0, 1] + grid[0, 2] + grid[1, 0] + grid[1, 1] + grid[1, 2]);
        Console.WriteLine("reverse " + Try(() => { Array.Reverse(a); return "done"; }));
        Console.WriteLine("index of " + Try(() => Array.IndexOf(a, 6)));
        Console.WriteLine("count " + ((ICollection)a).Count);
        Console.WriteLine("copy to " + Try(() => { a.CopyTo(new int[6], 0); return "done"; }));
        Console.WriteLine("ilist get " + Try(() => ((IList)a)[0]));
        Console.WriteLine("ilist contains " + Try(() => ((IList)a).Contains(6)));
        Console.WriteLine("ilist add " + Try(() => ((IList)a).Add(1)));
        string[,,] cube = new string[2, 2, 2];
        Array c = cube;
        c.SetValue("x", 1, 0, 1);
        Console.WriteLine("cube " + c.Rank + " " + c.Length + " " + cube[1, 0, 1] + " " + c.GetLength(2));
        ((IList)c).Clear();
        Console.WriteLine("cleared " + (cube[1, 0, 1] == null));
    }
}
