// test: csharp_nested_type_name_lookup
// expect-exit: 0
// expect-output:
// nested base derived other word 21 15 104 1 1 1 3
//
// NESTED TYPES' NAMES: an outer const in a switch arm, a const built from an
// outer const, an outer private member, an outer method invoked past a
// nested field of the same name, and one method group from an instance and
// a static method.
//
// Split out of the canary of the C# the compiler's own sources use: one
// family a test, so a form the compiler cannot build yet fails only its own.
// Every line is what .NET prints.

using System;

public static class Outer
{
    private const int Base = 10;
    private const string Word = "w";
    private static int Secret() => 5;
    private static int Size(int x) => x + 100;
    private static bool IsGuard(int x) => x < 0;

    public static class Inner
    {
        public const int Derived = Base * 2 + 1;
        public static string Arm(int c) => c switch { Base => "base", Derived => "derived", _ => "other" };
        public static string Text(string s) => s switch { Word => "word", _ => "none" };
        private static int Hidden => Base;
        public static int Read() => Hidden + Secret();
    }

    // A field of the nested type named as the outer method: an invocation
    // passes it by, a read finds it.
    public sealed class Sized
    {
        private int Size = 1;
        public int Call() => Size(3) + Size;
    }

    // One method group, from an instance method and from a static one.
    public sealed class Guards
    {
        private readonly int[] _p = { 3, -1, 4, -5 };
        public int Again() => Array.FindIndex(_p, IsGuard);
        public static int Find(int[] path) => Array.FindIndex(path, IsGuard);
        public static int Last(int[] path) => Array.FindLastIndex(path, IsGuard);
    }
}

public static class Program
{
    private static void Say(params object?[] parts) => Console.WriteLine(string.Join(" ", parts));

    public static int Main()
    {
        int[] guardPath = { 3, -1, 4, -5 };
        Outer.Guards guards = new();
        Say("nested", Outer.Inner.Arm(10), Outer.Inner.Arm(21), Outer.Inner.Arm(3), Outer.Inner.Text("w"), Outer.Inner.Derived, Outer.Inner.Read(),
            new Outer.Sized().Call(), guards.Again(), Outer.Guards.Find(guardPath), guards.Again(), Outer.Guards.Last(guardPath));
        return 0;
    }
}
