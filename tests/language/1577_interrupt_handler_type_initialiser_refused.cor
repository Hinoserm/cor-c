// test: an interrupt handler whose first touch of a type runs an allocating initialiser refused
// expect-compile-error: is an interrupt handler and must not allocate: the type initialiser of 'Buffers' makes an array
// Touching another type's statics runs its type initialiser the first time
// (Lowering.TouchType), and Buffers' makes an array: a handler that is the
// first to touch it allocates with interrupts off, inside
// EnterTypeInitialization's lock. The check followed calls written as calls.

using System;

static class Buffers
{
    public static readonly byte[] Ring = new byte[256];
}

static class Program
{
    [InterruptHandler]
    static void Tick()
    {
        Buffers.Ring[0]++;
    }

    static int Main()
    {
        Tick();
        Console.WriteLine(Buffers.Ring[0]);
        return 0;
    }
}
