// test: csharp_collection_apis
// expect-exit: 0
// expect-output:
// collections 3,4 True True True 1 9 3,5,7 a,b 2 1 p 1 high1 -1 0
// list-apis 4,2,1 2 2 1,2 1 True 2 2 False
// arrays 0,0,3,3,3,0 3,3,3 2 2 0
// comparers 2 1 2 a,bb,ccc
//
// THE COLLECTION APIS the sources use: sets, sorted sets and dictionaries,
// stacks, queues, a priority queue, a dictionary with a comparer, the list
// and array methods, and comparers of reference, case, and the program's own.
//
// Split out of the canary of the C# the compiler's own sources use: one
// family a test, so a form the compiler cannot build yet fails only its own.
// Every line is what .NET prints.

using System;
using System.Collections.Generic;
using System.Linq;

public sealed class ModComparer : IEqualityComparer<int>
{
    public bool Equals(int x, int y) => x % 3 == y % 3;
    public int GetHashCode(int x) => x % 3;
}

public sealed class LengthComparer : IComparer<string>
{
    public int Compare(string? a, string? b) => a!.Length.CompareTo(b!.Length);
}

public static class Program
{
    private static void Say(params object?[] parts) => Console.WriteLine(string.Join(" ", parts));

    public static int Main()
    {
        HashSet<int> hs = new() { 1, 2, 3 };
        hs.UnionWith([3, 4]);
        hs.IntersectWith([2, 3, 4, 5]);
        bool overlaps = hs.Overlaps([4, 9]);
        bool setEquals = hs.SetEquals([4, 3, 2]);
        bool subset = hs.IsSubsetOf([1, 2, 3, 4]);
        hs.ExceptWith([2]);
        SortedSet<int> ss = new() { 5, 1, 9, 3, 7 };
        string between = string.Join(",", ss.GetViewBetween(3, 7));
        SortedDictionary<string, int> sd = new(StringComparer.Ordinal) { ["b"] = 2, ["a"] = 1 };
        Stack<int> stack = new();
        stack.Push(1);
        stack.Push(2);
        stack.TryPop(out int popped);
        Queue<string> queue = new();
        queue.Enqueue("p");
        queue.Enqueue("q");
        queue.TryDequeue(out string? dequeued);
        PriorityQueue<string, int> pq = new();
        pq.Enqueue("low", 5);
        pq.Enqueue("high", 1);
        pq.TryDequeue(out string? top, out int priority);
        Dictionary<string, int> dict = new(StringComparer.OrdinalIgnoreCase) { ["Key"] = 1 };
        dict.TryAdd("KEY", 2);
        int missing = dict.GetValueOrDefault("missing", -1);
        dict.Remove("key");
        Say("collections", string.Join(",", hs.Order()), overlaps, setEquals, subset, ss.Min, ss.Max, between, string.Join(",", sd.Keys),
            popped, stack.Peek(), dequeued, queue.Count, top + priority, missing, dict.Count);

        List<int> lst = new() { 5, 1, 4 };
        lst.AddRange([7, 2]);
        lst.InsertRange(1, [9, 9]);
        lst.RemoveRange(1, 2);
        int removed = lst.RemoveAll(n => n > 4);
        lst.Sort();
        int searched = lst.BinarySearch(4);
        List<int> range = lst.GetRange(0, 2);
        int foundAt = lst.FindIndex(n => n == 2);
        bool exists = lst.Exists(n => n == 4);
        int found = lst.Find(n => n > 1);
        lst.Reverse();
        lst.EnsureCapacity(16);
        lst.TrimExcess();
        Say("list-apis", string.Join(",", lst), removed, searched, string.Join(",", range), foundAt, exists, found, lst.IndexOf(1), lst.Contains(3));

        int[] ar = new int[5];
        Array.Fill(ar, 3);
        ar[4] = 1;
        Array.Sort(ar);
        int[] dest = new int[3];
        Array.Copy(ar, 2, dest, 0, 3);
        Array.Clear(ar, 0, 2);
        Array.Resize(ref ar, 6);
        Say("arrays", string.Join(",", ar), string.Join(",", dest), Array.IndexOf(ar, 3), Array.BinarySearch(new[] { 1, 3, 5 }, 5), Array.Empty<int>().Length);

        HashSet<object> byReference = new(ReferenceEqualityComparer.Instance);
        byReference.Add(new string('a', 2));
        byReference.Add(new string('a', 2));
        HashSet<string> anyCase = new(StringComparer.OrdinalIgnoreCase) { "A", "a" };
        HashSet<int> byMod = new(new ModComparer()) { 1, 4, 7, 2 };
        List<string> byLength = new() { "ccc", "a", "bb" };
        byLength.Sort(new LengthComparer());
        Say("comparers", byReference.Count, anyCase.Count, byMod.Count, string.Join(",", byLength));
        return 0;
    }
}
