// test: array data on this target
// expect-exit: 0
// expect-output:
// header is the target's
// payload matches
// string payload matches
// object header is the target's
//
// THE MISTAKE THIS PORT WAS MOSTLY ABOUT. os/ had 391 sites spelling the
// address of an array's first element as `Sys.Word(x) + 24`, because the old
// machine's array header was 24 bytes. This one's is 16, so every one of them
// addressed eight bytes past the data -- and a program that reads or writes
// there compiles perfectly and answers the wrong bytes.
//
// Sys.ArrayData asks the target, which is why the port is a rewrite to it and
// not a rewrite to `+ 16`. The headers are the target's: 16 and 8 bytes on
// i386, 24 and 16 in long mode, where every word in them is eight.

using System;

class Program
{
#if TARGET_64BIT
    const nuint ArrayHeader = 24;
    const nuint ObjectHeader = 16;
#else
    const nuint ArrayHeader = 16;
    const nuint ObjectHeader = 8;
#endif

    static int Main()
    {
        byte[] b = new byte[8];

        Console.Write("header ");
        nuint header = Sys.ArrayData(b) - Sys.ObjectAddress(b);
        Console.WriteLine(header == ArrayHeader ? "is the target's" : "is " + header);

        for (int i = 0; i < b.Length; i++)
        {
            b[i] = (byte)(i + 1);
        }

        // Read the same bytes twice: once as an array and once through the
        // address, which is what a system call is handed.
        nuint at = Sys.ArrayData(b);
        bool same = true;

        for (int i = 0; i < b.Length; i++)
        {
            if (Sys.Read8(at + (nuint)i) != b[i])
            {
                same = false;
            }
        }
        Console.WriteLine(same ? "payload matches" : "payload DIFFERS");

        // A string is UTF-16 code units, as C#'s is, and its payload is found
        // the same way, by Sys.StringData: two bytes a unit, little end first.
        string s = "ab\u00E9";
        nuint sat = Sys.StringData(s);

        Console.WriteLine(Sys.Read8(sat) == 97 && Sys.Read8(sat + 1) == 0
                       && Sys.Read8(sat + 2) == 98 && Sys.Read8(sat + 4) == 0xE9
                       && sat - Sys.ObjectAddress(s) == Sys.ArrayData(b) - Sys.ObjectAddress(b)
                        ? "string payload matches" : "string payload DIFFERS");

        // And an object's header is two words: the other half of the same
        // change.
        Cell c = new Cell();

        c.Value = 0x11223344;
        Console.Write("object header ");
        Console.WriteLine(Sys.ReadAddress(Sys.ObjectAddress(c) + ObjectHeader) == 0x11223344 ? "is the target's" : "is not two words");
        return 0;
    }
}

class Cell
{
    public int Value;
}
