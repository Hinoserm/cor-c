// 1.7976931348623157E+308|1.7976931348623157E+308|1.7976931348623157E+308|1.7977E+308|.00|1.798E+308|179,769,313,486,231,570,814,527,423,731,704,356,798,070,567,525,844,996,598,917,476,803,157,260,780,028,538,760,589,558,632,766,878,171,540,458,953,514,382,464,234,321,326,889,464,182,768,467,546,703,537,516,986,049,910,576,551,282,076,245,490,090,389,328,944,075,868,508,455,133,942,304,583,236,903,222,948,165,808,559,332,123,348,274,797,826,204,144,723,168,738,177,180,919,299,881,250,404,026,184,124,858,368.00
// 5E-324|5E-324|4.9406564584124654E-324|4.9407E-324|0.00|4.941E-324|0.00
