// test: ref_local_tuple_element_across_an_await
// expect-compile-error: CS9217
// A named tuple element reached through a ref local, the target of a
// compound assignment whose value awaits: the element's address is held
// across the await, and Roslyn refuses it (CS9217). The name is the tuple
// type's, not a field of its class. Checked against .NET 10.

using System;
using System.Threading.Tasks;

static class Program
{
    static (int First, int Second)[] pairs = new (int, int)[1];
    static Task<int> Seven() => Task.FromResult(7);

    static async Task Bump()
    {
        ref (int First, int Second) t = ref pairs[0];
        t.First += await Seven();
    }

    static int Main() { Bump().Wait(); return pairs[0].First; }
}
