// test: a var pattern's designation named or, and or when
// expect-exit: 0
// expect-output:
// or x
// and x
// when 3
// joined True
// arm or x case and 3
// tuple 1 2
//
// `and`, `or` and `when` are words, not keywords: after `var` they name what
// the pattern matched wherever no pattern (or, for `when`, no condition)
// follows them, as C# reads `{ Reg: var or }` -- a line of the compiler's
// own ArgumentCopies, which the compiler built by itself refused.

class Holder { public object? Reg; public int Count; }

static class Program
{
    static void Arms(Holder h)
    {
        int count = h.Count;
        // A switch arm's `when` is its guard always: `var when =>` is no
        // designation there (CS1001), as it is in a property pattern.
        string armOr = h.Reg switch { var or => "arm or " + or };
        string cased = "";
        switch (count) { case var and: cased = " case and " + and; break; }
        System.Console.WriteLine(armOr + cased);
    }

    static void Tuple(int one, int two)
    {
        if ((one, two) is var (or, and)) System.Console.WriteLine("tuple " + or + " " + and);
    }

    static int Main()
    {
        object o = new Holder { Reg = "x", Count = 3 };
        if (o is Holder { Reg: var or } && or != null) System.Console.WriteLine("or " + or);
        if (o is Holder { Reg: var and }) System.Console.WriteLine("and " + and);
        if (o is Holder { Count: var when }) System.Console.WriteLine("when " + when);
        bool joined = o is Holder { Count: 2 or 3 } and { Reg: not null };
        System.Console.WriteLine("joined " + joined);
        Arms(new Holder { Reg = "x", Count = 3 });
        Tuple(1, 2);
        return 0;
    }
}
