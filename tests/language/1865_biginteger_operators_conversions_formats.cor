// -265252859812191058636308480000000: 00 00 00 AC 22 0A A2 79 69 F0 C8 09 EC F2 | F2 EC 09 C8 F0 69 79 A2 0A 22 AC 00 00 00 | -265252859812191058636308480000000 4927043998722636569894187849220096 208095997609079712277720306
