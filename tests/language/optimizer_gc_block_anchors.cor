// test: page-bounded conservative interior roots, one-past payloads and anchor lifetime
// expect-exit: 0
// expect-output:
// block anchors passed

// ROOTS THE COLLECTOR READS A WORD AT A TIME: a block with no descriptor,
// read as every such block is. An array of numbers is not read at all -- it
// holds no reference, as in .NET -- so raw addresses kept in a long[] kept
// nothing alive once that was so; these tests hold theirs here instead.
sealed class Roots
{
    readonly object _block;
    readonly long _at;

    public Roots(int count)
    {
        Length = count;
        _at = Runtime.Alloc(count * 8L);
        _block = Sys.FromWord(_at);
    }

    public int Length { get; }

    public long this[int i]
    {
        get { return Sys.Peek(_at + i * 8L); }
        set { Sys.Poke(_at + i * 8L, value); }
    }
}
static class Program
{
    // Where a request's payload ends: the block is the request plus a
    // two-word header, rounded to eight bytes -- and a one-word footer
    // besides, outside a size-class page (a block past the largest class,
    // 1024 bytes, is in the mixed heap and keeps one).
    static long OnePast(long request)
    {
        long header = 2 * WordSize.Bytes;
        if (((request + header + 7) & -8L) <= 1024) return ((request + header + 7) & -8L) - header;
        long overhead = header + WordSize.Bytes;
        return ((request + overhead + 7) & -8L) - overhead;
    }

    static int Main()
    {
        const int count = 8192;
        Gc.SetLimit(16777216);
        Roots roots = new Roots(count + 2);
        for (int i = 0; i < count; i++)
        {
            long memory = Runtime.Alloc(64);
            Sys.Poke(memory + 16, i + 1);
            // A 64-byte request's actual payload ends at OnePast(64) (+64 in
            // a 72-byte class block on i386), which is also a valid conservative root.
            roots[i] = memory + (i % 7 == 0 ? OnePast(64) : 16);
        }
        for (int i = 0; i < 2; i++)
        {
            long memory = Runtime.Alloc(20000);
            Sys.Poke(memory + 15000, 9000 + i);
            roots[count + i] = memory + (i == 0 ? 15000 : OnePast(20000));
        }
        long before = Gc.WalkSteps;
        Gc.Collect();
        long steps = Gc.WalkSteps - before;
        if (steps > (count + 64) * 260)
        { Sys.Print("interior scan steps=" + steps + "\n"); return 1; }
        for (int i = 0; i < count; i++)
        {
            long memory = roots[i] - (i % 7 == 0 ? OnePast(64) : 16);
            if (Sys.Peek(memory + 16) != i + 1) return 2;
        }
        if (Sys.Peek(roots[count]) != 9000 || Sys.Peek(roots[count + 1] - OnePast(20000) + 15000) != 9001) return 3;
        long chunk = HeapChunks.Of(roots[count / 2]);
        // Sweep invalidates boundaries. Outside marking the helper must not
        // consult the previous collection's now-stale page entries.
        if (HeapChunks.MarkStart(chunk, roots[count / 2]) != HeapChunks.First(chunk)) return 4;
        GcLock.Enter();
        long saved = Sys.Peek(chunk + 3 * WordSize.Bytes);
        Sys.Poke(chunk + 3 * WordSize.Bytes, 0);
        HeapChunks.SetBlockAnchorsActive(true);
        bool fallback = HeapChunks.MarkStart(chunk, roots[count / 2]) == HeapChunks.First(chunk);
        HeapChunks.SetBlockAnchorsActive(false);
        Sys.Poke(chunk + 3 * WordSize.Bytes, saved);
        GcLock.Exit();
        if (!fallback) return 5;
        long metadata = HeapChunks.BlockAnchorBytes;
        long temporary = HeapChunks.Take(4096);
        if (temporary == 0 || HeapChunks.PrepareBlockAnchors(temporary) == 0) return 6;
        if (HeapChunks.BlockAnchorBytes <= metadata) return 7;
        HeapChunks.Release(temporary);
        if (HeapChunks.BlockAnchorBytes != metadata) return 8;
        if (!Gc.CheckFreeIndex()) return 9;
        Sys.Print("block anchors passed\n");
        return 0;
    }
}
