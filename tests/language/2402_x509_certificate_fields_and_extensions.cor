// ext 2.5.29.19 X509v3 Basic Constraints critical True X509BasicConstraintsExtension ca=False haslen=False len=0
// hosts nnn nnn YYY nnn nnn nnn YYY nnn nnn nnn nnn ! nnn nnn ! ! !
