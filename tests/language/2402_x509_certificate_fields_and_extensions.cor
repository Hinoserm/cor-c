// PublicKey 1.3.101.112 ED25519 32 bytes, parameters null
// SimpleName server.test | DnsName server.test | IssuerSimpleName server.test
// SubjectName CN=server.test |  24 bytes
// ext 2.5.29.14 X509v3 Subject Key Identifier critical False X509SubjectKeyIdentifierExtension B395E16D1F7BC7E403C23C85DBC0A0BE7595E99A B395E16D1F7BC7E403C23C85DBC0A0BE7595E99A
// ext 2.5.29.35 X509v3 Authority Key Identifier critical False X509AuthorityKeyIdentifierExtension key=B395E16D1F7BC7E403C23C85DBC0A0BE7595E99A issuer=none raw=none serial=none
// ext 2.5.29.19 X509v3 Basic Constraints critical True X509BasicConstraintsExtension ca=True haslen=False len=0
// ext 2.5.29.17 X509v3 Subject Alternative Name critical False X509SubjectAlternativeNameExtension dns:server.test ip:127.0.0.1
// hosts nnn nnn YYY nnn nnn nnn YYY nnn nnn nnn nnn ! nnn nnn ! ! !
// same as loaded True, PEM round trip True
// aki from key 30058003010203
// aki from issuer 3034A12FA42D302B31143012060355040A0C0B434F5253414320546573743113301106035504030C0A436861696E20526F6F74820102
// aki full 303980020908A12FA42D302B31143012060355040A0C0B434F5253414320546573743113301106035504030C0A436861696E20526F6F74820200A1
// aki from certificate 304A80146DB8DEB36B5A9375624838E3CBD7D2EC9AA1EB35A12FA42D302B31143012060355040A0C0B434F5253414320546573743113301106035504030C0A436861696E20526F6F74820101 False 2.5.29.35
// aki read back 6DB8DEB36B5A9375624838E3CBD7D2EC9AA1EB35 CN=Chain Root, O=CORSAC Test 01
// bad: CryptographicException
// null: ArgumentNullException
//
// X509Certificate2 and its extensions read as .NET reads them, over
// eighteen certificates: a test PKI's, OpenSSL's self-signed P-256, RSA and
// Ed25519 ones (from PEM), RSA-PSS ones, and four public roots (ISRG Root
// X1 and X2, DigiCert Global Root G2, Amazon Root CA 3): names, serial,
// thumbprint, times, algorithms, the public key, every extension and its
// decoded form (basic constraints, key usage, EKU, subject and authority key
// identifiers, alternative names with their addresses), MatchesHostname,
// X509CertificateLoader, and X509AuthorityKeyIdentifierExtension's Create
// forms. Expected output from .NET 10 on Linux.

using System;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using System.Text;

static class Program
{
    static readonly (string Name, string Base64)[] Der =
    {
        ("chain-root", ""),
        ("chain-intermediate", ""),
        ("chain-leaf", ""),
        ("client-leaf", ""),
        ("short-leaf", ""),
        ("rsa-leaf", ""),
        ("pss-leaf", ""),
        ("rsa-intermediate", ""),
        ("p256-intermediate", ""),
        ("test-root", ""),
        ("isrg-root-x1", ""),
        ("isrg-root-x2", ""),
        ("digicert-g2", ""),
        ("amazon-root-3", ""),
        ("aki-leaf", ""),
        ("ed25519-leaf", ""),
    };

    static readonly (string Name, string Pem)[] Pem =
    {
        ("openssl-p256", "-----BEGIN CERTIFICATE-----\nMIIB3zCCAYWgAwIBAgIUTfRGwH0HlCINBIqwhFZc36ompjUwCgYIKoZIzj0EAwIw\nLDEUMBIGA1UEAwwLc2VydmVyLnRlc3QxFDASBgNVBAoMC0NPUlNBQyBUZXN0MB4X\nDTI2MTAyMzAwMTUwMVoXDTM2MTAyMDAwMTUwMVowLDEUMBIGA1UEAwwLc2VydmVy\nLnRlc3QxFDASBgNVBAoMC0NPUlNBQyBUZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\nAQcDQgAEItPctpPJM2o3LBMy0b/SHVr/ZD+vCQ/XPa799/wWb3wD9CX+2i/3XSu4\naME3x7w6Q9a3hdxQ1QoOCGrI9jvLPKOBhDCBgTAdBgNVHQ4EFgQUE5gOM0/MuQXZ\nQEQN8Nqy5/Z0hgQwHwYDVR0jBBgwFoAUE5gOM0/MuQXZQEQN8Nqy5/Z0hgQwHAYD\nVR0RBBUwE4ILc2VydmVyLnRlc3SHBH8AAAEwEwYDVR0lBAwwCgYIKwYBBQUHAwEw\nDAYDVR0TAQH/BAIwADAKBggqhkjOPQQDAgNIADBFAiBfyskzmSZZHT9JVyexh/gk\nwU21F1sc49C711Ct4rR5UAIhANvITSOOKRLvEfETeHOkLyB+T6zwSm+h+0AFTmSD\nP/qO\n-----END CERTIFICATE-----"),
        ("openssl-rsa", "-----BEGIN CERTIFICATE-----\nMIIDKzCCAhOgAwIBAgIUMeHVrA/O3VzCLys2r2McQ3ZtkrgwDQYJKoZIhvcNAQEL\nBQAwFjEUMBIGA1UEAwwLc2VydmVyLnRlc3QwHhcNMjYxMDIzMDAxNTAxWhcNMzYx\nMDIwMDAxNTAxWjAWMRQwEgYDVQQDDAtzZXJ2ZXIudGVzdDCCASIwDQYJKoZIhvcN\nAQEBBQADggEPADCCAQoCggEBAOtQGklmaOFwTenvVNs55VWpnsGCjhvhxsy/NqGJ\nvjg2FY4NKBhBWew57eVv6rk6TT0WqzvppoAMpNw03l7ZibxajgW+cikotzjaTHge\nRIQ8zdPMfo/yODHlqUz/aJi8lle4pMd4yNDJw3bJ9r3x7D2qelQ+So6Wjr9iK5Tj\nwSDJqOn5v6x9kDTehai0WWa472m7XB9QDaIL76vIdj6JqvGFH/oHX+jwxvCFiUy4\naCiQqYoUpvZ1cFtAxe70NX51Oi0QR+2cvVyOTrNp0TM03ccIhXdujHnpt3SxIWkr\nT2n5fbsYPpqS6mWh6VhNNEfwWqO33KG6tcvr0Q5t0w5KVFcCAwEAAaNxMG8wHQYD\nVR0OBBYEFLtl5KumKMGC2aZT1UNdaoyMO/vsMB8GA1UdIwQYMBaAFLtl5KumKMGC\n2aZT1UNdaoyMO/vsMA8GA1UdEwEB/wQFMAMBAf8wHAYDVR0RBBUwE4ILc2VydmVy\nLnRlc3SHBH8AAAEwDQYJKoZIhvcNAQELBQADggEBAKPe+/G4ItUx3sXBBl6mKNZY\nXO9RnFNkJAEqZd0BveFNAK9zgl3NF2/8hXzwZKNBKzlNGeA3jRCWV7QLMmOay0kK\nhVhfELGpgIQz74EHG903W3q+N/AI3Itz4G62Cp+mDfjSLmqco1+AvoFDsGlELXft\neHDXk5aEs2OIzHoH895I/OWlp2t89KVxmca8X91Rd6KRXQx97VO1H8W/uFlFxjqZ\nrFTwwRm0Q7rPwBNN8cvMSluCtDnrKpzTdNGVoEkMBTgh/GmcPurZ1x5aA2SqA67x\n5fzKy1xny8+cy/7OmWph1QZ33hHqRi1EOW7mSArhPY2TFo60M0eBU/vCQNWc0NU=\n-----END CERTIFICATE-----"),
        ("openssl-ed25519", "-----BEGIN CERTIFICATE-----\nMIIBXzCCARGgAwIBAgIUfrG0hUz8+X3v4I7GDSnu7d2kr/8wBQYDK2VwMBYxFDAS\nBgNVBAMMC3NlcnZlci50ZXN0MB4XDTI2MTAyMzAwMTUwMVoXDTM2MTAyMDAwMTUw\nMVowFjEUMBIGA1UEAwwLc2VydmVyLnRlc3QwKjAFBgMrZXADIQBsr2PcTR8Vl/sN\naIJIkyrI6ofkeLGJCs3bxXIJZwThNaNxMG8wHQYDVR0OBBYEFLOV4W0fe8fkA8I8\nhdvAoL51lemaMB8GA1UdIwQYMBaAFLOV4W0fe8fkA8I8hdvAoL51lemaMA8GA1Ud\nEwEB/wQFMAMBAf8wHAYDVR0RBBUwE4ILc2VydmVyLnRlc3SHBH8AAAEwBQYDK2Vw\nA0EAscr9Fofd3nsmMj12g8NIZlWcAkAe4XjyEHARPd2RTy7QB9iK+t7MrpTNJSRu\n/L7qTx2qGVCNSc18wBa1nh6aAA==\n-----END CERTIFICATE-----"),
    };

    static readonly string[] Hosts = { "chain.test", "CHAIN.Test.", "server.test", "www.example.test", "a.example.test", "ignored.example.test",
        "127.0.0.1", "192.0.2.1", "2001:db8::1", "[2001:db8::1]", "under_score.example.test", "-x.example.test", "x-.example.test", "1.2.3", "a..b", "*.example.test", "" };

    static void Show(string name, X509Certificate2 c)
    {
        Console.WriteLine("== " + name);
        Console.WriteLine("Subject " + c.Subject);
        Console.WriteLine("Issuer " + c.Issuer);
        Console.WriteLine("SerialNumber " + c.SerialNumber + " Thumbprint " + c.Thumbprint);
        Console.WriteLine("NotBefore " + c.NotBefore.ToUniversalTime().ToString("u") + " NotAfter " + c.NotAfter.ToUniversalTime().ToString("u"));
        Console.WriteLine("Version " + c.Version + " SignatureAlgorithm " + c.SignatureAlgorithm.Value + " " + c.SignatureAlgorithm.FriendlyName);
        Console.WriteLine("PublicKey " + c.PublicKey.Oid.Value + " " + c.PublicKey.Oid.FriendlyName + " " + c.PublicKey.EncodedKeyValue.RawData.Length
            + " bytes, parameters " + (c.PublicKey.EncodedParameters == null ? "null" : Convert.ToHexString(c.PublicKey.EncodedParameters.RawData)));
        Console.WriteLine("SimpleName " + c.GetNameInfo(X509NameType.SimpleName, false) + " | DnsName " + c.GetNameInfo(X509NameType.DnsName, false)
            + " | IssuerSimpleName " + c.GetNameInfo(X509NameType.SimpleName, true));
        Console.WriteLine("SubjectName " + c.SubjectName.Name + " | " + (c.SubjectName.Oid == null ? "null" : c.SubjectName.Oid.Value) + " " + c.SubjectName.RawData.Length + " bytes");
        foreach (X509Extension e in c.Extensions)
        {
            StringBuilder s = new StringBuilder("ext " + e.Oid?.Value + " " + e.Oid?.FriendlyName + " critical " + e.Critical + " " + e.GetType().Name);
            if (e is X509BasicConstraintsExtension bc) s.Append(" ca=" + bc.CertificateAuthority + " haslen=" + bc.HasPathLengthConstraint + " len=" + bc.PathLengthConstraint);
            if (e is X509KeyUsageExtension ku) s.Append(" " + ku.KeyUsages);
            if (e is X509EnhancedKeyUsageExtension eku) foreach (Oid o in eku.EnhancedKeyUsages) s.Append(" " + o.Value + "(" + o.FriendlyName + ")");
            if (e is X509SubjectKeyIdentifierExtension ski) s.Append(" " + ski.SubjectKeyIdentifier + " " + Convert.ToHexString(ski.SubjectKeyIdentifierBytes.Span));
            if (e is X509SubjectAlternativeNameExtension san)
            {
                foreach (string d in san.EnumerateDnsNames()) s.Append(" dns:" + d);
                foreach (System.Net.IPAddress a in san.EnumerateIPAddresses()) s.Append(" ip:" + a);
            }
            if (e is X509AuthorityKeyIdentifierExtension aki)
                s.Append(" key=" + (aki.KeyIdentifier.HasValue ? Convert.ToHexString(aki.KeyIdentifier.Value.Span) : "none")
                    + " issuer=" + (aki.NamedIssuer == null ? "none" : aki.NamedIssuer.Name)
                    + " raw=" + (aki.RawIssuer.HasValue ? Convert.ToHexString(aki.RawIssuer.Value.Span) : "none")
                    + " serial=" + (aki.SerialNumber.HasValue ? Convert.ToHexString(aki.SerialNumber.Value.Span) : "none"));
            Console.WriteLine(s.ToString());
        }
        StringBuilder hosts = new StringBuilder("hosts");
        foreach (string h in Hosts)
        {
            string r;
            try { r = (c.MatchesHostname(h) ? "Y" : "n") + (c.MatchesHostname(h, false, true) ? "Y" : "n") + (c.MatchesHostname(h, true, false) ? "Y" : "n"); }
            catch (ArgumentException) { r = "!"; }
            hosts.Append(" " + r);
        }
        Console.WriteLine(hosts.ToString());
    }

    static int Main()
    {
        foreach ((string name, string base64) in Der) Show(name, X509CertificateLoader.LoadCertificate(Convert.FromBase64String(base64)));
        foreach ((string name, string pem) in Pem)
        {
            X509Certificate2 fromPem = X509Certificate2.CreateFromPem(pem);
            X509Certificate2 loaded = X509CertificateLoader.LoadCertificate(Encoding.ASCII.GetBytes(pem));
            Show(name, fromPem);
            Console.WriteLine("same as loaded " + (fromPem.Thumbprint == loaded.Thumbprint) + ", PEM round trip " + (fromPem.ExportCertificatePem() == pem));
        }
        X509Certificate2 root = X509CertificateLoader.LoadCertificate(Convert.FromBase64String(Der[0].Base64));
        X509Certificate2 leaf = X509CertificateLoader.LoadCertificate(Convert.FromBase64String(Der[2].Base64));
        Console.WriteLine("aki from key " + Convert.ToHexString(X509AuthorityKeyIdentifierExtension.CreateFromSubjectKeyIdentifier(new byte[] { 1, 2, 3 }).RawData));
        Console.WriteLine("aki from issuer " + Convert.ToHexString(X509AuthorityKeyIdentifierExtension.CreateFromIssuerNameAndSerialNumber(root.SubjectName, new byte[] { 0x02 }).RawData));
        Console.WriteLine("aki full " + Convert.ToHexString(X509AuthorityKeyIdentifierExtension.Create(new byte[] { 9, 8 }, root.SubjectName, new byte[] { 0x00, 0xa1 }).RawData));
        X509AuthorityKeyIdentifierExtension fromCert = X509AuthorityKeyIdentifierExtension.CreateFromCertificate(root, true, true);
        Console.WriteLine("aki from certificate " + Convert.ToHexString(fromCert.RawData) + " " + fromCert.Critical + " " + fromCert.Oid!.Value);
        X509AuthorityKeyIdentifierExtension again = new X509AuthorityKeyIdentifierExtension(fromCert.RawData);
        Console.WriteLine("aki read back " + Convert.ToHexString(again.KeyIdentifier!.Value.Span) + " " + again.NamedIssuer!.Name + " " + Convert.ToHexString(again.SerialNumber!.Value.Span));
        try { X509CertificateLoader.LoadCertificate(new byte[] { 0x30, 0x03, 0x02, 0x01, 0x01 }); }
        catch (Exception e) { Console.WriteLine("bad: " + e.GetType().Name); }
        try { X509CertificateLoader.LoadCertificate((byte[])null!); }
        catch (Exception e) { Console.WriteLine("null: " + e.GetType().Name); }
        return 0;
    }
}
