// hosts nnn nnn YYY nnn nnn nnn YYY nnn nnn nnn nnn ! nnn nnn ! ! !
// same as loaded True, PEM round trip True
// == openssl-ed25519
// Subject CN=server.test
// Issuer CN=server.test
// SerialNumber 7EB1B4854CFCF97DEFE08EC60D29EEEDDDA4AFFF Thumbprint 0314833722E36FBB01A93762EEABB808E12A171F
// NotBefore 2026-10-23 00:15:01Z NotAfter 2036-10-20 00:15:01Z
