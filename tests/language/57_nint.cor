// test: nint
// expect-exit: 0
// expect-output:
// arith 30 -10 200 2 6 -20
// wrap -2147483648 4294967295 0 True
// conv 5 -1 4294967295 -1 True 1000
// mixed 15 45 4294967300 True
// addr 28 12345 7
//
// nint and nuint: the integers that are exactly one machine word. Arithmetic
// between them and with int, wrap-around at the word's width (this target's
// word is 32 bits), the implicit conversions in from int and uint and out to
// long and ulong, the explicit ones back, promotion with long and uint, and
// holding an address that Sys.PeekWord reads through.

static class Program
{
    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static string U(nuint v)
    {
        string tail = String.FromInt((long)(v % 10));
        if (v < 10)
        {
            return tail;
        }
        return U(v / 10) + tail;
    }

    static int Main()
    {
        nint a = 20;
        nint b = 10;
        Line("arith " + (a + b) + " " + (b - a) + " " + (a * b) + " " + (a / b) + " " + (a % 7) + " " + (-a));

        nint max = 2147483647;
        nint over = max + 1;
        nuint umax = 0;
        umax = umax - 1;
        nuint zero = umax + 1;
        Line("wrap " + over + " " + U(umax) + " " + U(zero) + " " + (over < 0));

        int i = 5;
        nint ni = i;
        long l = ni;
        nint fromLong = (nint)(-1L);
        nuint nu = (nuint)fromLong;
        ulong ul = nu;
        int back = (int)fromLong;
        uint ui = 1000;
        nuint nu2 = ui;
        Line("conv " + l + " " + fromLong + " " + ul + " " + back + " " + (nu == umax) + " " + U(nu2));

        nint n = 5;
        int k = 10;
        long w = 40;
        uint big = 4294967295u;
        nint s1 = n + k;
        long s2 = n + w;
        long s3 = n + big;
        Line("mixed " + s1 + " " + s2 + " " + s3 + " " + (n < w));

        int[] values = new int[4];
        values[3] = 12345;
        values[0] = 7;
        nint start = (nint)Sys.Word(values);
        nint at = start + 16 + 3 * 4;
        long first = Sys.PeekWord(start + 16);
        Line("addr " + (at - start) + " " + Sys.PeekWord(at) + " " + first);
        return 0;
    }
}
