// test: async_program_tasks_streams_and_faults
// expect-exit: 0
// expect-output:
// 1,4,9,16,25
// 4 3 2 1
// cancelled after 4
// broke after 5
// InvalidOperationException True broke after 2
// 16
// done 42
// 7 True
// 55
//
// A whole small async program: Task.WhenAll over a projection, async
// streams with a cancellation token passed through
// [EnumeratorCancellation], a faulted task awaited and two awaited
// together, WhenAny, TaskCompletionSource set from Task.Run, ValueTask, and
// Parallel.ForEachAsync (.NET 6) with an async lambda -- whose ValueTask an
// inference read as a Task (the open Func's TResult), so no overload took
// it.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

static class Program
{
    static async Task<int> Square(int x, int delay) { await Task.Delay(delay); return x * x; }

    static async IAsyncEnumerable<int> Countdown(int from, [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken token = default)
    {
        for (int i = from; i > 0; i--)
        {
            token.ThrowIfCancellationRequested();
            await Task.Yield();
            yield return i;
        }
    }

    static async Task<string> Fails(int after)
    {
        await Task.Delay(after);
        throw new InvalidOperationException("broke after " + after);
    }

    static async Task<int> Main()
    {
        int[] results = await Task.WhenAll(Enumerable.Range(1, 5).Select(i => Square(i, 6 - i)));
        Console.WriteLine(string.Join(",", results));
        var list = new List<int>();
        await foreach (int n in Countdown(4)) list.Add(n);
        Console.WriteLine(string.Join(" ", list));
        using var cts = new CancellationTokenSource();
        int seen = 0;
        try
        {
            await foreach (int n in Countdown(10, cts.Token))
            {
                seen++;
                if (n == 7) cts.Cancel();
            }
        }
        catch (OperationCanceledException) { Console.WriteLine("cancelled after " + seen); }
        try { await Fails(5); }
        catch (InvalidOperationException e) { Console.WriteLine(e.Message); }
        Task<string> one = Fails(1), two = Fails(2);
        try { await Task.WhenAll(one, two); }
        catch (Exception e) { Console.WriteLine(e.GetType().Name + " " + one.IsFaulted + " " + two.Exception!.InnerException!.Message); }
        Task<int> first = await Task.WhenAny(Square(3, 50), Square(4, 1));
        Console.WriteLine(await first);
        var tcs = new TaskCompletionSource<string>();
        _ = Task.Run(async () => { await Task.Delay(5); tcs.SetResult("done"); });
        Console.WriteLine(await tcs.Task + " " + (await Task.FromResult(41) + 1));
        ValueTask<int> vt = new(7);
        Console.WriteLine(await vt + " " + Task.CompletedTask.IsCompleted);
        int total = 0;
        await Parallel.ForEachAsync(Enumerable.Range(1, 10), async (i, ct) => { await Task.Yield(); Interlocked.Add(ref total, i); });
        Console.WriteLine(total);
        return 0;
    }
}
