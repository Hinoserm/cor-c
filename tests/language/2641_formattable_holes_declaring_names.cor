// test: an interpolated string's holes that declare a pattern variable or an out variable, a lambda, an anonymous type -- converted to a FormattableString, each checked once; one with no holes converts too, holes that are strings themselves, lambdas returning one, and the better overload where a string or an IFormattable one is beside
// expect-exit: 0
// expect-output:
// [5][7][8] [3]
// 15
// plain {{braces}}|0|plain {braces}
// {0}{1}|a|5
// abc|1
// {0}-{1}-{2,3}|x|b|a|x-b-  a
// <5>
// [5|7]
// plain a5x
// string p5
// formattable f{0}
// later l{0}
// q5
//
// Output as .NET 10 says it.

using System;
using System.Globalization;
using System.Threading.Tasks;
static class Program
{
    static bool Try(out int v) { v = 7; return true; }
    static string Take(Func<FormattableString> made) => made().ToString(CultureInfo.InvariantCulture);
    static string Take(Func<int, FormattableString> made) => made(0).ToString(CultureInfo.InvariantCulture);
    static string Pick(Func<string> made) => "string " + made();
    static string Pick(Func<FormattableString> made) => "formattable " + made().Format;
    static string Face(Func<FormattableString> made) => "formattable " + made().Format;
    static string Face(Func<IFormattable> made) => "iformattable";
    static async Task<string> Later(Func<Task<FormattableString>> made) => "later " + (await made()).Format;
    static async Task<string> Later(Func<Task<int>> made) => "later int " + await made();
    static int Main()
    {
        object o = 5;
        FormattableString a = $"[{(o is int n ? n : 0)}]";
        FormattableString b = $"[{(Try(out var w) ? w : 0)}]";
        Func<int, int> twice = x => x * 2;
        FormattableString c = $"[{new Func<int>(() => twice(4))()}] [{new { K = 3 }.K}]";
        Console.WriteLine(a.ToString(CultureInfo.InvariantCulture) + b.ToString(CultureInfo.InvariantCulture) + c.ToString(CultureInfo.InvariantCulture));
        Console.WriteLine(FormattableString.Invariant($"{(o is int m ? m * 3 : -1)}"));
        FormattableString plain = $"plain {{braces}}";
        Console.WriteLine(plain.Format + "|" + plain.ArgumentCount + "|" + plain.ToString(CultureInfo.InvariantCulture));
        FormattableString lit = $"{"a"}{o}";
        Console.WriteLine(lit.Format + "|" + lit.GetArgument(0) + "|" + lit.GetArgument(1));
        FormattableString sole = $"{"abc"}";
        Console.WriteLine(sole.ToString(CultureInfo.InvariantCulture) + "|" + sole.ArgumentCount);
        FormattableString shapes = $"{$"x"}-{"b"}-{"a",3}";
        Console.WriteLine(shapes.Format + "|" + shapes.GetArgument(0) + "|" + shapes.GetArgument(1) + "|" + shapes.GetArgument(2) + "|" + shapes.ToString(CultureInfo.InvariantCulture));
        Console.WriteLine(Take(() => $"<{(o is int q ? q : 0)}>"));
        Console.WriteLine(Take(() => { if (o is int r) return $"[{r}|{(Try(out var s) ? s : 0)}]"; return $"none"; }));
        string joined = $"plain {"a"}{o}{$"x"}";
        Console.WriteLine(joined);
        Console.WriteLine(Pick(() => $"p{o}"));
        Console.WriteLine(Face(() => $"f{o}"));
        Console.WriteLine(Later(async () => { await Task.Yield(); return $"l{o}"; }).Result);
        Console.WriteLine(FormattableString.Invariant(($"q{o}")));
        return 0;
    }
}
