// test: a known word tested in long mode is true when only its high half is set
// only-target: x86-64
// expect-exit: 0
// expect-output:
// local True
// static True
// folded True
// low False
//
// A word known at compile time and tested in long mode, with only its high
// half set, is not zero: the compare and the branch after it are decided on
// the whole word. Source code reaches a branch through a compare (Builder
// wraps a word in `!= 0`); the bare word branches the IR allows come from
// lowering's own words, and the passes that decide them (ConstantFold, Sccp,
// DeadStatics, BranchSimplify, the backends' known-branch shortcut) are
// guarded here only as far as the compares that feed them are.

using System;

static class P
{
    static readonly nuint High = (nuint)(1UL << 32);
    static nuint _set = (nuint)(1UL << 33);

    static bool Local()
    {
        nuint w = (nuint)(1UL << 32);
        if (w != 0) return true;
        return false;
    }

    static bool Static()
    {
        if (_set != 0 && High != 0) return true;
        return false;
    }

    static bool Folded()
    {
        nuint w = (nuint)(3UL << 40);
        nuint low = w & 0xFFFFFFFF;
        nuint high = w >> 32;
        return low == 0 && high != 0 && w != 0;
    }

    static bool Low()
    {
        nuint w = (nuint)(1UL << 32);
        return (uint)w != 0;
    }

    static int Main()
    {
        Console.WriteLine("local " + Local());
        Console.WriteLine("static " + Static());
        Console.WriteLine("folded " + Folded());
        Console.WriteLine("low " + Low());
        return 0;
    }
}
