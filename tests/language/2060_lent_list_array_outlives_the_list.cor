// test: lent_list_array_outlives_the_list
// units: tests/language/support/2060_lent_units.cor
// expect-exit: 0
// expect-output:
// made 9 -3,-2,-1,0,1,2,3,4,5
// local 9 -3,-2,-1,0,1,2,3,4,5
// viewed 9 -3,-2,-1,0,1,2,3,4,5
// walked 9000
//
// A List's array lent out (CollectionsMarshal.AsSpan: List.Backing) and read
// after the list's own last use: the list is dead, its array is not, and
// whatever gives the list back -- a free placed after its last use, its
// storage given back, the free of its owned array field -- must leave the
// array to the span. The list made by a call and dropped; a local list;
// the span made by another unit; and a thousand walks of such a span beside
// another list made after it.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;

static class P
{
    static List<int> Make(int n) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(i - 3); return l; }

    static readonly int[][] JunkArrays = new int[4096][];
    static readonly List<int>[] JunkLists = new List<int>[4096];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkArrays.Length; k++)
        {
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
            JunkLists[k] = new List<int> { 100, 101, 102 };
        }
        Gc.Collect();
    }

    static string Show(Span<int> s)
    {
        string r = "";
        foreach (int x in s) r += (r.Length > 0 ? "," : "") + x;
        return s.Length + " " + r;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static string Made()
    {
        Span<int> s = CollectionsMarshal.AsSpan(Make(9));
        Churn();
        return Show(s);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static string Local()
    {
        List<int> l = new();
        for (int i = 0; i < 9; i++) l.Add(i - 3);
        Span<int> s = CollectionsMarshal.AsSpan(l);
        Churn();
        return Show(s);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static string Viewed()
    {
        Span<int> s = Views.Of(Make(9));
        Churn();
        return Show(s);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Walk(int n)
    {
        Span<int> s = CollectionsMarshal.AsSpan(Make(n));
        List<int> other = Make(n);
        int t = 0;
        for (int i = 0; i < s.Length; i++) t += s[i] + other.Count - n;
        return t;
    }

    static void Main()
    {
        Console.WriteLine("made " + Made());
        Console.WriteLine("local " + Local());
        Console.WriteLine("viewed " + Viewed());
        long walked = 0;
        for (int k = 0; k < 1000; k++) walked += Walk(9);
        Console.WriteLine("walked " + walked);
    }
}
