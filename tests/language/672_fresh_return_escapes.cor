        a[0 % a.Length] = a[0 % a.Length] + (a.Length ^ 1) - (a.Length ^ 1);
        a[1 % a.Length] = a[1 % a.Length] + (a.Length ^ 8) - (a.Length ^ 8);
        a[2 % a.Length] = a[2 % a.Length] + (a.Length ^ 15) - (a.Length ^ 15);
