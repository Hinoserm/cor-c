// test: fresh return escapes
// expect-exit: 0
// expect-output:
// aliases 50250
// lambdas 50100
// holders 50350
// caught 50100
// kept 77 77
// deep 169
//
// A fresh result is owned by its caller only while it stays there. Each case
// here lets it go some other way, and each object is read back after churn
// that would reuse the memory of anything freed by mistake: a helper that
// hands its argument back (the caller keeps the alias), a lambda that
// captures it, a local holder it is stored into, a catch block that reads it
// after an exception, a helper that passes its fresh object to a callee that
// keeps it (so the helper is not fresh at all), and a recursive helper.

using System;

class Holder
{
    public long[] Items = null!;
}

static class Program
{
    static long[]? _kept;
    static long _sink;

    static long[] Make(int n)
    {
        long[] v = new long[n];
        for (int i = 0; i < n; i++) v[i] = i + 1000;
        v[0 % v.Length] = v[0 % v.Length] + (n ^ 1) - (n ^ 1);
        v[1 % v.Length] = v[1 % v.Length] + (n ^ 8) - (n ^ 8);
