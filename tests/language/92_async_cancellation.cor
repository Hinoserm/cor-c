// test: async_cancellation
// expect-exit: 0
// expect-output:
// delay completed False
// requested True
// canceled before True
// cancelling
// canceled during True
// resumed outside Cancel True
// cancelled
// worker stopped True
// stable True
// canceller done
//
// Cancellation. A delay with a token nobody cancels completes normally. A
// token cancelled before Task.Delay is called gives a canceled task, and
// awaiting it throws TaskCanceledException. Cancelling while the delay is
// pending ends it early (the five-second timer never has to fire), and the
// awaiter gets a TaskCanceledException, caught here as its base
// OperationCanceledException -- resumed OUTSIDE Cancel: a delay's
// continuations are posted, as .NET's are, where a TaskCompletionSource's
// run inside the call that completes it. A worker polling
// ThrowIfCancellationRequested stops with OperationCanceledException; its
// step and the canceller's look-and-cancel share a lock, so it stops
// exactly where the canceller saw it, on however many threads they run.

using System;
using System.Threading;
using System.Threading.Tasks;

static class Program
{
    static int steps;
    static int observed;
    static readonly object gate = new object();
    static int cancellingThread;
    static bool inCancel;

    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static async Task CancelSoon(CancellationTokenSource cts)
    {
        await Task.Delay(30);
        Line("cancelling");
        cancellingThread = Environment.CurrentManagedThreadId;
        inCancel = true;
        cts.Cancel();
        inCancel = false;
    }

    static async Task Worker(CancellationToken token)
    {
        while (true)
        {
            lock (gate)
            {
                token.ThrowIfCancellationRequested();
                steps = steps + 1;
            }
            await Task.Yield();
        }
    }

    static async Task Canceller(CancellationTokenSource cts)
    {
        while (Volatile.Read(ref steps) < 3)
        {
            await Task.Yield();
        }
        lock (gate)
        {
            observed = steps;
            cts.Cancel();
        }
    }

    static async Task Main()
    {
        CancellationTokenSource idle = new CancellationTokenSource();
        await Task.Delay(20, idle.Token);
        Line("delay completed " + idle.Token.IsCancellationRequested);

        CancellationTokenSource early = new CancellationTokenSource();
        early.Cancel();
        Line("requested " + early.Token.IsCancellationRequested);
        try
        {
            await Task.Delay(5000, early.Token);
            Line("not reached");
        }
        catch (TaskCanceledException e)
        {
            Line("canceled before " + (e is OperationCanceledException));
        }

        CancellationTokenSource during = new CancellationTokenSource();
        Task d = Task.Delay(5000, during.Token);
        Task soon = CancelSoon(during);
        try
        {
            await d;
            Line("not reached");
        }
        catch (OperationCanceledException e)
        {
            Line("canceled during " + (e is TaskCanceledException));
            Line("resumed outside Cancel " + !(inCancel && Environment.CurrentManagedThreadId == cancellingThread));
        }
        await soon;
        Line("cancelled");

        CancellationTokenSource stop = new CancellationTokenSource();
        steps = 0;
        observed = -1;
        Task w = Worker(stop.Token);
        Task c = Canceller(stop);
        try
        {
            await w;
            Line("not reached");
        }
        catch (OperationCanceledException e)
        {
            Line("worker stopped " + (steps >= 3));
        }
        Line("stable " + (steps == observed));
        await c;
        Line("canceller done");
    }
}
