// test: async_cancellation
// expect-exit: 0
// expect-output:
// delay completed False
// requested True
// canceled before True
// cancelling
// cancelled
// canceled during True
// worker stopped True
// stable True
// canceller done
//
// Cancellation. A delay with a token nobody cancels completes normally. A
// token cancelled before Task.Delay is called gives a canceled task, and
// awaiting it throws TaskCanceledException. Cancelling while the delay is
// pending ends it early (the five-second timer never has to fire): Cancel
// itself returns to its caller first, and the awaiter then gets a
// TaskCanceledException, caught here as its base OperationCanceledException.
// A worker polling ThrowIfCancellationRequested stops with
// OperationCanceledException. How many steps the worker gets through
// before the canceller runs depends on the scheduler, so the test prints
// only that it ran at least three and stopped exactly where the
// canceller saw it.

static class Program
{
    static int steps;
    static int observed;

    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static async Task CancelSoon(CancellationTokenSource cts)
    {
        await Task.Delay(30);
        Line("cancelling");
        cts.Cancel();
        Line("cancelled");
    }

    static async Task Worker(CancellationToken token)
    {
        while (true)
        {
            token.ThrowIfCancellationRequested();
            steps = steps + 1;
            await Task.Yield();
        }
    }

    static async Task Canceller(CancellationTokenSource cts)
    {
        while (steps < 3)
        {
            await Task.Yield();
        }
        observed = steps;
        cts.Cancel();
    }

    static async Task Main()
    {
        CancellationTokenSource idle = new CancellationTokenSource();
        await Task.Delay(20, idle.Token);
        Line("delay completed " + idle.Token.IsCancellationRequested);

        CancellationTokenSource early = new CancellationTokenSource();
        early.Cancel();
        Line("requested " + early.Token.IsCancellationRequested);
        try
        {
            await Task.Delay(5000, early.Token);
            Line("not reached");
        }
        catch (TaskCanceledException e)
        {
            Line("canceled before " + (e is OperationCanceledException));
        }

        CancellationTokenSource during = new CancellationTokenSource();
        Task d = Task.Delay(5000, during.Token);
        Task soon = CancelSoon(during);
        try
        {
            await d;
            Line("not reached");
        }
        catch (OperationCanceledException e)
        {
            Line("canceled during " + (e is TaskCanceledException));
        }
        await soon;

        CancellationTokenSource stop = new CancellationTokenSource();
        steps = 0;
        observed = -1;
        Task w = Worker(stop.Token);
        Task c = Canceller(stop);
        try
        {
            await w;
            Line("not reached");
        }
        catch (OperationCanceledException e)
        {
            Line("worker stopped " + (steps >= 3));
        }
        Line("stable " + (steps == observed));
        await c;
        Line("canceller done");
    }
}
