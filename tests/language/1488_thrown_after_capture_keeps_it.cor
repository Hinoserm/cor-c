// test: thrown_after_capture_keeps_it
// expect-exit: 0
// expect-output:
// 33445 1000 0 True
//
// A library function keeps the exception before it is thrown: captured
// for a later rethrow. The catch that takes it must not free it.
using System.Collections.Generic;
using System.Runtime.ExceptionServices;

static class Program
{
    static List<ExceptionDispatchInfo> saved = new List<ExceptionDispatchInfo>();

    static int Check(int k)
    {
        if ((k & 1) == 0)
        {
            System.InvalidOperationException x = new System.InvalidOperationException("bad value " + k);
            saved.Add(ExceptionDispatchInfo.Capture(x));
            throw x;
        }
        return 20;
    }

    static int Main()
    {
        long total = 0;
        for (int k = 0; k < 2000; k++)
        {
            try { total += Check(k); }
            catch (System.InvalidOperationException e) { total += e.Message.Length; }
        }
        long sum = 0;
        for (int k = 0; k < 4000; k++) { string s = "zzzz" + k + "qqqqqqqqqqqq"; sum += s.Length; }
        int bad = 0;
        for (int i = 0; i < saved.Count; i++) if (!saved[i].SourceException.Message.StartsWith("bad value ")) bad++;
        System.Console.WriteLine(total + " " + saved.Count + " " + bad + " " + (sum > 0));
        return 0;
    }
}
