// test: StringComparer.Ordinal and OrdinalIgnoreCase answer .NET's values, not only its signs
// expect-exit: 0
// expect-output:
// a|abc -98 -2
// |a -97 -1
// abc|abd -1 -1
// a|C 30 -2
// C|a -30 2
// abc|ABC 32 0
// ab|ABCD 32 -2
// é|É 32 0
// x|null 1 1
// null|x -1 -1
// null|null 0 0
// E000|D83D 1987 -71168
// D83D|D83D -1 -1
// D801|D801 40 0
// DF|SS 140 140
// 1C6|1C4 2 0
//
// .NET's Ordinal comparer is String.CompareOrdinal -- "a" against "abc" is
// the terminator read against 'b', -98 -- and OrdinalIgnoreCase answers the
// difference of the first two folded characters that differ, whole
// characters (a pair's code point, so U+E000 sorts below U+1F600), or of
// the lengths left. Here Ordinal answered the length difference and
// OrdinalIgnoreCase only -1 or 1, a pair by its units.
using System;

static class Program
{
    static string Name(string? s) => s == null ? "null" : s.Length > 0 && s[0] >= 0x80 && s[0] != 'é' && s[0] != 'É' ? ((int)s[0]).ToString("X") : s;

    static int Main()
    {
        string?[][] pairs =
        {
            new string?[] { "a", "abc" }, new string?[] { "", "a" }, new string?[] { "abc", "abd" }, new string?[] { "a", "C" }, new string?[] { "C", "a" },
            new string?[] { "abc", "ABC" }, new string?[] { "ab", "ABCD" }, new string?[] { "é", "É" }, new string?[] { "x", null }, new string?[] { null, "x" },
            new string?[] { null, null }, new string?[] { "", "😀" }, new string?[] { "😀", "😁" },
            new string?[] { "𐐨", "𐐀" }, new string?[] { "ß", "SS" }, new string?[] { "ǆ", "Ǆ" },
        };
        foreach (string?[] p in pairs)
            Console.WriteLine(Name(p[0]) + "|" + Name(p[1]) + " " + StringComparer.Ordinal.Compare(p[0], p[1]) + " " + StringComparer.OrdinalIgnoreCase.Compare(p[0], p[1]));
        return 0;
    }
}
