// test: library_shared_copy_list_through_a_concrete_face
// expect-exit: 0
// expect-output:
// kept 2 bad 0
//
// a List the library's shared code makes (FindAll), filled through a concrete interface face
using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

public sealed class Node { public int A; public int[] Pad; public Node(int a) { A = a; Pad = new int[6]; for (int i = 0; i < 6; i++) Pad[i] = a + i; } }
public static class R
{
    public static List<Node> Pool = new List<Node>();
    public static ICollection<Node>? Kept;
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static void B(int k)
    {
        ICollection<Node> c = Pool.FindAll(n => n.A > 0);
        c.Add(new Node(k));
        Kept = c;
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static long Churn(int k) { Node n = new Node(-k); return n.Pad[5]; }
}
static class P
{
    static void Main()
    {
        R.Pool.Add(new Node(1));
        R.B(100);
        long t = 0;
        for (int k = 0; k < 2000; k++) t += R.Churn(k);
        int bad = 0, count = 0;
        foreach (Node n in R.Kept!) { count++; for (int j = 0; j < 6; j++) if (n.Pad[j] != n.A + j) bad++; }
        Console.WriteLine("kept " + count + " bad " + bad);
    }
}
