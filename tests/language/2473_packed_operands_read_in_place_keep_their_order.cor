// test: a packed operation's operands read where they are keep C#'s order: a pointer moved between a store and a load, an overlapping store, an operand assigned by a later one, and a getter or an implicit conversion that writes what a load reads
// expect-exit: 0
// expect-output:
// moved 0000000000000002
// overlap 2222222222222222 3333333311111111
// assigned 0FFF0FFF0FFF0FFF
// getter 0101010101010108
// conversion 0101010101010108
// by-ref 0303030303030303
// field 0505050505050505
//
// run-with: --runtime-knob Corsac.Cpu.Features=0
// run-with: --runtime-knob Corsac.Cpu.Features=4
//
// A Packed64 local and a Packed.Load's source are read in place, not
// copied, where nothing the operation's other operands do can write memory
// first; where one can -- an assignment, a property's getter, a type's
// implicit conversion -- the operand
// is taken as C# takes it, before. The store of an overlapping load is one
// move in a variant with MMX and through a copy in one without.
struct Handle
{
    public ulong Value;
    public static implicit operator ulong(Handle h)
    {
        Program.Memory[0] = 0x5555;
        return h.Value;
    }
}

static class Program
{
    public static ulong[] Memory = new ulong[4];
    static nuint _at;

    static Packed64 _four;

    static ulong ByRef(ref Packed64 a, Packed64 b)
    {
        {
            return Packed.Add8(a, b).Bits;
        }
    }

    static ulong Seven
    {
        get { Memory[0] = 0x5555; return 7; }
    }

    static int Main()
    {
        _at = Sys.ArrayData(Memory);
        nuint p = _at, q = _at + 8;
        Memory[1] = 2;
        ulong moved;
        {
            Packed64 zero = Packed.FromBits(0UL);
            Packed.Store(p, Packed.FromBits(0x1111UL));
            p = q;
            moved = Packed.Add16(Packed.Load(p), zero).Bits;
        }
        System.Console.WriteLine("moved " + moved.ToString("X16"));

        Memory[0] = 0x1111111122222222UL;
        Memory[1] = 0x3333333344444444UL;
        {
            Packed.Store(_at + 4, Packed.Load(_at));
        }
        System.Console.WriteLine("overlap " + Memory[0].ToString("X16") + " " + Memory[1].ToString("X16"));

        ulong assigned;
        {
            Packed64 a = Packed.FromBits(0x00FF00FF00FF00FFUL), b = Packed.FromBits(0x0F0F0F0F0F0F0F0FUL);
            assigned = Packed.Or(a, a = Packed.Xor(a, b)).Bits;
        }
        System.Console.WriteLine("assigned " + assigned.ToString("X16"));

        Memory[0] = 0x0101010101010101UL;
        ulong got;
        {
            got = Packed.Add8(Packed.Load(_at), Packed.FromBits(Seven)).Bits;
        }
        System.Console.WriteLine("getter " + got.ToString("X16"));

        Memory[0] = 0x0101010101010101UL;
        Handle seven = new Handle { Value = 7 };
        {
            got = Packed.Add8(Packed.Load(_at), Packed.FromBits(seven)).Bits;
        }
        System.Console.WriteLine("conversion " + got.ToString("X16"));

        Packed64 one = Packed.FromBits(0x0101010101010101UL);
        System.Console.WriteLine("by-ref " + ByRef(ref one, Packed.FromBits(0x0202020202020202UL)).ToString("X16"));
        _four = Packed.FromBits(0x0404040404040404UL);
        ulong field;
        {
            field = Packed.Add8(_four, one).Bits;
        }
        System.Console.WriteLine("field " + field.ToString("X16"));
        return 0;
    }
}
