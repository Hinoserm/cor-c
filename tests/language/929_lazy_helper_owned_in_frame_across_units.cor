// test: lazy_helper_owned_in_frame_across_units
// units: tests/language/support/915_builder_units.cor
// expect-exit: 0
// expect-output:
// 35040000
//
// Test 928 in a unit of its own, judged by the link's rules too.

using System;
using System.Collections.Generic;
sealed class Known
{
    readonly int[] _writes;
    readonly long[] _value;
    readonly bool[] _same;
    public Known(int n)
    {
        _writes = new int[n];
        _value = new long[n];
        _same = new bool[n];
        for (int i = 0; i < n; i++) { _writes[i] = i & 3; _value[i] = i * 7; _same[i] = (i & 1) == 0; }
    }
    public long Fold(int i) => _same[i % _same.Length] ? _value[i % _value.Length] : _writes[i % _writes.Length];
}
public static class Program
{
    static long Run(int n, int salt)
    {
        Known? known = null;
        long t = 0;
        for (int k = 0; k < n; k++)
        {
            if (((k + salt) & 3) == 0)
            {
                known ??= new Known(n);
                t += known.Fold(k);
            }
        }
        return t;
    }
    public static int Main()
    {
        long t = 0;
        for (int i = 0; i < 20000; i++) t += Run(64, i);
        Console.WriteLine(t);
        return 0;
    }
}
