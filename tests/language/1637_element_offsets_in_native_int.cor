// test: element_offsets_in_native_int
// expect-exit: 0
// expect-output:
// far 2147483648 2147483648 4294959104
// as added True True True
// bytes 10 -3 190 71
// shorts 30000 -2 65535 -32768 -2771 72056494526300160
// ints 15 -1 2000000000 -2
// longs 1099511627776 -1 3
// doubles 2.5 0.25 0.75
// chars hello olleh 532 l3
// structs 21 42 63 126
// local 10 99 99 30
// jagged 6 12
// sum 4950 328350
//
// An element's offset is worked out as C# works out a pointer's, in native
// int: the index widened to the word, then scaled. Scaled in 32 bits first,
// `&p[0x20000000]` of an int* was two gigabytes BELOW p on x86-64, and
// `&p[i]` was not `p + i`, which has always widened first. The pointers
// that far out are never read through; the distances are unsigned, so a
// 32-bit target, where none of them passes four gigabytes, prints them the
// same.
//
// The rest reads and writes elements of every width, with indexes from
// arithmetic, negative ones through a pointer to a local struct's last
// field, and narrow values widened to 64 bits after the load: what x86-64
// now writes as one memory operand, base plus index times the element size
// plus displacement, with no 32-bit move after a load that already
// cleared the upper half.

using System;

struct Triple { public int A, B, C; }

static class Program
{
    static unsafe ulong FarInt(int* p, int i) => (ulong)(nuint)(&p[i]) - (ulong)(nuint)p;
    static unsafe ulong FarLong(long* p, int i) => (ulong)(nuint)(&p[i]) - (ulong)(nuint)p;
    static unsafe ulong FarShort(short* p, int i) => (ulong)(nuint)(&p[i]) - (ulong)(nuint)p;

    static unsafe int Main()
    {
        int* ip = (int*)(nint)4096;
        long* lp = (long*)(nint)4096;
        short* sp = (short*)(nint)4096;
        Console.WriteLine("far " + FarInt(ip, 0x20000000) + " " + FarLong(lp, 0x10000000) + " " + FarShort(sp, 0x7FFFF000));
        int far = 0x10000000;
        Console.WriteLine("as added " + (&ip[far] == ip + far) + " " + (&lp[far] == lp + far) + " " + (&sp[far * 7] == sp + far * 7));

        int at = 3;

        byte[] bytes = new byte[8];
        sbyte[] signedBytes = new sbyte[8];
        for (int i = 0; i < 8; i++)
        {
            bytes[i] = (byte)(i * 30 + 10);
            signedBytes[i] = (sbyte)(1 - i);
        }
        Console.WriteLine("bytes " + bytes[0] + " " + signedBytes[at + 1] + " " + bytes[at + 3] + " " + (bytes[at - 1] + signedBytes[at - 3]));

        short[] shorts = { 30000, -2, -1, short.MinValue };
        ushort[] wide = { 65535, 1 };
        long total = 0;
        for (int i = 0; i < shorts.Length; i++) total += shorts[i];
        Console.WriteLine("shorts " + shorts[at - 3] + " " + shorts[at - 2] + " " + wide[at - 3] + " " + shorts[at]
            + " " + total + " " + ((ulong)wide[at - 3] << 40));

        int[] ints = new int[10];
        for (int i = 0; i < ints.Length; i++) ints[i] = i * i - 1;
        ints[at * 2] = 2000000000;
        Console.WriteLine("ints " + ints[4] + " " + ints[0] + " " + ints[at + at] + " " + (ints[1] - 2));

        long[] longs = { 1L << 40, -1, 3 };
        Console.WriteLine("longs " + longs[at - 3] + " " + longs[at - 2] + " " + longs[longs.Length - 1]);

        double[] doubles = { 0.25, 2.5 };
        float[] floats = { 1.5f, 0.75f };
        Console.WriteLine("doubles " + doubles[at - 2] + " " + doubles[0] + " " + floats[at - 2]);

        string word = "hello";
        char[] back = new char[word.Length];
        for (int i = 0; i < word.Length; i++) back[word.Length - 1 - i] = word[i];
        ReadOnlySpan<char> view = word.AsSpan(1, 3);
        int codes = 0;
        foreach (char c in word) codes += c;
        Console.WriteLine("chars " + word + " " + new string(back) + " " + codes + " " + view[at - 1] + view.Length);

        Triple[] triples = new Triple[4];
        for (int i = 0; i < triples.Length; i++)
        {
            triples[i].A = 7 * i;
            triples[i].B = 14 * i;
            triples[i].C = 21 * i;
        }
        int cs = 0;
        foreach (Triple t in triples) cs += t.C;
        Console.WriteLine("structs " + triples[at].A + " " + triples[at].B + " " + triples[at].C + " " + cs);

        Triple local = new Triple { A = 10, B = 20, C = 30 };
        int* last = &local.C;
        last[-1] = 99;
        Console.WriteLine("local " + last[-2] + " " + last[at - 4] + " " + local.B + " " + last[0]);

        int[][] jagged = { new[] { 1, 2, 3 }, new[] { 4, 5, 6 } };
        Console.WriteLine("jagged " + (jagged[0][at - 1] + jagged[1][at - 3] - 1) + " " + jagged[at - 2][at - 1] * 2);

        int[] series = new int[100];
        for (int i = 0; i < series.Length; i++) series[i] = i;
        long squares = 0;
        int sum = 0;
        for (int i = 0; i < series.Length; i++)
        {
            sum += series[i];
            squares += (long)series[i] * series[i];
        }
        Console.WriteLine("sum " + sum + " " + squares);
        return 0;
    }
}
