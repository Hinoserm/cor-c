// test: Last and LastOrDefault from a list's end
// expect-exit: 0
// expect-output:
// 5 4 0 9
// asked 5 4
// asked 3 2 1 none
// InvalidOperationException InvalidOperationException
// 3 3
//
// Last and LastOrDefault of an IList (an array, a List) are read from
// the end, as .NET reads them: the last element, or the first from the
// end that passes -- asked of no element before it -- and the same
// refusals of an empty list or one with no match. A plain sequence is
// walked to its end as before.

using System;
using System.Collections.Generic;
using System.Linq;

static class Program
{
    static IEnumerable<int> Walk() { yield return 1; yield return 2; yield return 3; }

    static void Main()
    {
        List<int> list = new() { 1, 2, 3, 4, 5 };
        int[] none = Array.Empty<int>();
        Console.WriteLine($"{list.Last()} {list.Last(x => x % 2 == 0)} {none.LastOrDefault()} {none.LastOrDefault(9)}");
        Console.Write("asked");
        int found = list.LastOrDefault(x => { Console.Write(" " + x); return x == 4; });
        Console.WriteLine();
        Console.Write("asked");
        int[] small = { 1, 2, 3 };
        int missing = small.LastOrDefault(x => { Console.Write(" " + x); return x > 9; });
        Console.WriteLine(missing == 0 ? " none" : " some");
        string a = "", b = "";
        try { none.Last(); } catch (InvalidOperationException) { a = "InvalidOperationException"; }
        try { list.Last(x => x > 9); } catch (InvalidOperationException) { b = "InvalidOperationException"; }
        Console.WriteLine(a + " " + b);
        Console.WriteLine($"{Walk().Last()} {Walk().LastOrDefault(x => x > 1)}");
    }
}
