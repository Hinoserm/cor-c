// test: ProcessStartInfo.ArgumentList preserves argument boundaries
// expect-exit: 0
// expect-output:
// one
// two words
// three
// empty argument preserved
//
// Replace the OS-only Args convention with the compiler library's process API.
// Exercise a real child, including spaces and an empty argument.
class Program
{
    static int Main()
    {
        ProcessStartInfo info = new ProcessStartInfo("/usr/bin/printf");
        info.RedirectStandardOutput = true;
        info.ArgumentList.Add("%s\n");
        info.ArgumentList.Add("one");
        info.ArgumentList.Add("two words");
        info.ArgumentList.Add("three");
        info.ArgumentList.Add("");
        Process child = Process.Start(info);
        StreamReader output = child.StandardOutput;
        for (int i = 0; i < 3; i++) Console.WriteLine(output.ReadLine());
        if (output.ReadLine() != "" || output.ReadLine() != null) return 1;
        child.WaitForExit();
        if (child.ExitCode != 0) return 2;
        Console.WriteLine("empty argument preserved");
        return 0;
    }
}
