// test: a thread the platform says may not wait for another's collection goes on without it, and loses nothing
// expect-exit: 0
// expect-output:
// count 348174
// bad 0
// refused True
//
// On one processor a kernel's thread with its preemption count raised can
// never wait for another thread's collection: that cycle's collector may be
// a thread that yielded between budgets, and nothing runs it again while
// the waiter spins. Such a wait asks the platform first (Gc.YieldHook with
// 1), which answers nonzero for a thread that may not give the processor
// away. Then an allocation takes its last try at once, the cap lifted an
// eighth for it -- it takes its room from the system, as an allocation
// that may not sleep does in a kernel -- and a collection asked for is not
// made. Here six threads allocate under a cap that keeps cycles running
// beside them (allocations come up short and meet them, as in 1011); the
// hook refuses the waits of one of them for a step in four, as a kernel
// refuses a thread while its count is raised, and every wait of the main
// thread, which asks for collections throughout. Every allocation is
// answered (the count is whole) with every name read back its own. Whether
// the refused worker meets a cycle when it comes up short is the race's:
// in nine runs of twelve it did (Gc.RefusedAllocations), the heap's peak
// within the lifted cap, 18 MB. With the cap kept for it, it ran out of
// memory. With every thread refused at every step nothing ever waits for
// a cycle to end, and the heap outgrew a 16 MB cap twelve times over
// before the lift was bounded; bounded, that load is out of memory, as it
// should be.

using System.Runtime.CompilerServices;
using System.Threading;
using System;

class Holder
{
    public string? S;
    public Holder? Next;
}

class Node
{
    public string[]? Names;
    public int Value;
    public Node? Next;
}

class Worker : Action
{
    public static Node?[] Sink = new Node?[1024];
    public int Seed;
    public bool Refused;
    public long Bad;
    public long Count;

    public Worker(int seed) { Seed = seed; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static Holder? Chain(int v, int len)
    {
        Holder? head = null;
        for (int k = 0; k < len; k++)
        {
            Holder h = new Holder();
            h.S = "n" + v;
            h.Next = head;
            head = h;
        }
        return head;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static Node Make(int v)
    {
        Holder? c = Chain(v, 8);
        for (int k = 0; k < 4; k++)
        {
            Sink[(v * 4 + k) & 1023] = new Node();
        }
        Node n = new Node();
        n.Value = v;
        Holder p = c!;
        while (p.Next != null) p = p.Next;
        n.Names = new string[] { p.S!, p.S! };
        return n;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    public void Invoke()
    {
        Node? head = null;
        int live = 0;
        for (int i = 0; i < Program.Steps; i++)
        {
            Program.Refusing = Refused && (i & 3) == 0;
            Node n = Make(Seed * 1000000 + i);
            n.Next = head;
            head = n;
            live++;
            if (live > 2000)
            {
                Node? p = head;
                while (p != null)
                {
                    if (p.Names![1] != "n" + p.Value) Bad++;
                    Count++;
                    p = p.Next;
                }
                head = null;
                live = 0;
            }
        }
    }
}

static class Program
{
    public static int Steps = 60000;
    static long _refused;
    [ThreadStatic] public static bool Refusing;

    static long Refuse(long a, long b, long c)
    {
        if (a != 1 || !Refusing) return 0;
        Interlocked.Increment(ref _refused);
        return 1;
    }

    static int Main()
    {
        int workers = 6;
        Gc.SetLimit(16777216);
        Gc.YieldHook = Sys.AddressOf(Program.Refuse);
        Worker[] w = new Worker[workers];
        Thread[] t = new Thread[workers];
        for (int i = 0; i < workers; i++) { w[i] = new Worker(i); w[i].Refused = i == 0; t[i] = Thread.Start(w[i]); }
        Refusing = true;
        // Collections asked for while the workers' cycles run.
        for (int k = 0; k < 200; k++) Gc.Collect();
        for (int i = 0; i < workers; i++) t[i].Join();
        Gc.YieldHook = 0;
        long bad = 0;
        long count = 0;
        for (int i = 0; i < workers; i++) { bad += w[i].Bad; count += w[i].Count; }
        Console.WriteLine("count " + count);
        Console.WriteLine("bad " + bad);
        Console.WriteLine("refused " + (Interlocked.Read(ref _refused) > 0));
        return 0;
    }
}
