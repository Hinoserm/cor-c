// test: linq_semantics_program
// expect-exit: 0
// expect-output:
// built, make 1, where 1, make 2, where 2, select 2, first 20, make 1, where 1, make 2, where 2, select 2, make 3, where 3, make 4, where 4, select 4 => 20,40
// Cid Bob Eve Ann Dee
// Eve Ann Cid Bob Dee
// Ann:10 Ann:2.25 Bob:5.5
// Ann=12.25 Bob=5.5 Cid=0 Dee=0 Eve=0
// Oslo28 Rome32.5 Lima31
// 2 0 3 Ann,Eve
// A,B,C,D,E,b
// fact 120 cba
// 1,2,3,4,5 | 3,4 | 1,2 | True | 1,2,3,4
// 3,4,2 | 1,2 | 2,3 | 2,4,3,2,1 | -1
// 1,4 | two,five | 1 | x,x,x | TrueTrue
// bad cast
// 40 Bob 152 30.4 18.75 2 Cid
// 40 Ann,Eve 0A,1B,2C,3D,4E
//
// A whole small program of LINQ's semantics: deferred execution and the
// order its side effects run in (First stops early; ToList runs it again),
// stable OrderBy/ThenByDescending, Join, GroupJoin with empty groups,
// GroupBy with key, element and result selectors (the overload missing
// here), ToLookup's missing key, SelectMany with a result selector,
// Aggregate's seed and result, set operations in .NET's order,
// SkipWhile/TakeWhile, DefaultIfEmpty, OfType and a failing Cast, MinBy,
// ToDictionary, Select's index. Every line as .NET prints it.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Linq;

record Person(string Name, string City, int Age);
record Order(string Buyer, decimal Total);

static class Program
{
    static int Main()
    {
        var log = new List<string>();
        IEnumerable<int> Source() { for (int i = 1; i <= 4; i++) { log.Add("make " + i); yield return i; } }
        var query = Source().Where(x => { log.Add("where " + x); return x % 2 == 0; }).Select(x => { log.Add("select " + x); return x * 10; });
        log.Add("built");
        var first = query.First();
        log.Add("first " + first);
        var all = query.ToList();
        Console.WriteLine(string.Join(", ", log) + " => " + string.Join(",", all));
        var people = new[] { new Person("Ann", "Oslo", 31), new Person("Bob", "Rome", 25), new Person("Cid", "Oslo", 25), new Person("Dee", "Rome", 40), new Person("Eve", "Lima", 31) };
        var orders = new[] { new Order("Ann", 10m), new Order("Bob", 5.5m), new Order("Ann", 2.25m), new Order("Zed", 1m) };
        Console.WriteLine(string.Join(" ", people.OrderBy(p => p.Age).ThenByDescending(p => p.Name).Select(p => p.Name)));
        Console.WriteLine(string.Join(" ", people.OrderBy(p => p.City).Select(p => p.Name)));
        Console.WriteLine(string.Join(" ", people.Join(orders, p => p.Name, o => o.Buyer, (p, o) => p.Name + ":" + o.Total)));
        Console.WriteLine(string.Join(" ", people.GroupJoin(orders, p => p.Name, o => o.Buyer, (p, os) => p.Name + "=" + os.Sum(o => o.Total))));
        Console.WriteLine(string.Join(" ", people.GroupBy(p => p.City, p => p.Age, (city, ages) => city + ages.Average())));
        var lookup = people.ToLookup(p => p.Age);
        Console.WriteLine(lookup[25].Count() + " " + lookup[99].Count() + " " + lookup.Count + " " + string.Join(",", lookup[31].Select(p => p.Name)));
        Console.WriteLine(string.Join(",", people.SelectMany(p => p.Name.ToCharArray(), (p, c) => c).Distinct().OrderBy(c => c).Take(6)));
        Console.WriteLine(Enumerable.Range(1, 5).Aggregate(1, (acc, x) => acc * x, acc => "fact " + acc) + " " + new[] { "a", "b", "c" }.Aggregate((x, y) => y + x));
        var a = new[] { 1, 2, 3, 4, 2 }; var b = new[] { 3, 4, 5 };
        Console.WriteLine(string.Join(",", a.Union(b)) + " | " + string.Join(",", a.Intersect(b)) + " | " + string.Join(",", a.Except(b)) + " | " + a.SequenceEqual(new[] { 1, 2, 3, 4, 2 }) + " | " + string.Join(",", a.Distinct()));
        Console.WriteLine(string.Join(",", a.SkipWhile(x => x < 3)) + " | " + string.Join(",", a.TakeWhile(x => x < 3)) + " | " + string.Join(",", a.Skip(1).Take(2)) + " | " + string.Join(",", a.Reverse()) + " | " + string.Join(",", Enumerable.Empty<int>().DefaultIfEmpty(-1)));
        object[] mixed = { 1, "two", 3.0, 4, "five", null! };
        Console.WriteLine(string.Join(",", mixed.OfType<int>()) + " | " + string.Join(",", mixed.OfType<string>()) + " | " + mixed.Count(o => o is null) + " | " + string.Join(",", Enumerable.Repeat("x", 3)) + " | " + people.Any(p => p.Age > 35) + people.All(p => p.Age > 20));
        try { var bad = mixed.Cast<int>().ToList(); } catch (InvalidCastException) { Console.WriteLine("bad cast"); }
        Console.WriteLine(people.Max(p => p.Age) + " " + people.MinBy(p => p.Age)!.Name + " " + people.Sum(p => p.Age) + " " + people.Average(p => p.Age) + " " + orders.Sum(o => o.Total) + " " + people.Count(p => p.City == "Oslo") + " " + people.ElementAt(2).Name + " " + people.LastOrDefault(p => p.Age > 100)?.Name);
        var dict = people.ToDictionary(p => p.Name, p => p.Age);
        Console.WriteLine(dict["Dee"] + " " + string.Join(",", dict.Where(kv => kv.Value == 31).Select(kv => kv.Key)) + " " + string.Join(",", people.Select((p, i) => i + p.Name[0].ToString())));
        return 0;
    }
}
