// test: inline_asm_bit_string_write_refused
// only-target: x86
// expect-compile-error: at an offset it states
//
// BTS with its bit's offset in a register reaches a byte on per eight past
// [esp]: which of PUSHFD's bytes it changes, and whether it stays within
// the block's pushes, is not known (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static int Main()
    {
        asm
        {
            pushfd
            mov eax, 10
            bts dword [esp], eax
            popfd
        }
        return 0;
    }
}
