// test: inline_asm_bit_string_write_refused
// only-target: x86
// expect-compile-error: direction flag
//
// BTS with its bit's offset in a register writes a byte on per eight: which
// of PUSHFD's bytes it changed is not known, DF's among them, and POPFD may
// set DF (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static int Main()
    {
        asm
        {
            pushfd
            mov eax, 10
            bts dword [esp], eax
            popfd
        }
        return 0;
    }
}
