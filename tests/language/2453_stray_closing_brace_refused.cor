// test: stray_closing_brace_refused
// expect-compile-error: type or namespace definition, or end-of-file expected
//
// C#'s CS1022: a '}' at the top level closes nothing, and the file must end
// there. It was taken as the end of the file's members and the rest dropped
// unread: a driver whose method's closing brace stayed behind after an edit
// built with its class closed early and its last members never compiled.

static class A
{
    static void F() { }
}
}

static class B
{
    static int Main() { return 0; }
}
