// Linked(): ArgumentException | No tokens were supplied. | param=
// Linked(null): ArgumentNullException | Value cannot be null. (Parameter 'tokens') | param=tokens
// default CTR.Dispose: ok
// default CTR.Unregister: False
// default CTR.Token: False
// equal True False token True
// unregister first while running: True
// ran third second | third after False
// dispose waited True
//
// The threading surface's refusals in .NET 10's own words, names and
// values, taken from .NET 10 running this program: Task.Delay's
// millisecondsDelay and its TimeSpan form (which was missing), WhenAll's and
// WhenAny's null element, SemaphoreSlim's sentences -- and its forms without
// a token that take a timeout below -1 as a wait that ends at once --
// Monitor's unnamed null and its guard's words, a wait handle's, a slim
// event's and Thread's, a linked source of no tokens. A registration is a
// struct: default's Dispose does nothing; one disposed before a running
// cancellation comes to it does not run, and Unregister says so; Dispose
// waits for a callback another thread is running.
using System;
using System.Threading;
using System.Threading.Tasks;

static class Program
{
    static void Show(string what, Func<object> a)
    {
        try
        {
            object r = a();
            if (r is Task t)
            {
                try { t.Wait(100); } catch { }
                string tail = "";
                if (t.IsFaulted) { Exception inner = t.Exception!.InnerException!; tail = " " + inner.GetType().Name + " | " + inner.Message + " | " + ((ArgumentException)inner).ParamName; }
                else if (t.Status == TaskStatus.RanToCompletion && t is Task<bool> b) tail = " " + b.Result;
                r = "task " + t.Status + tail;
            }
            Console.WriteLine(what + ": " + r);
        }
        catch (Exception e)
        {
            Console.WriteLine(what + ": " + e.GetType().Name + " | " + e.Message.Replace("\n", "\\n") + (e is ArgumentException ae ? " | param=" + ae.ParamName : ""));
        }
    }

    static int Main()
    {
        Show("Delay(-2)", () => Task.Delay(-2));
        Show("Delay(TimeSpan -2ms)", () => Task.Delay(TimeSpan.FromMilliseconds(-2)));
        Show("Delay(TimeSpan 0)", () => Task.Delay(TimeSpan.Zero));
        Show("WhenAll(null elem)", () => Task.WhenAll(new Task[] { null! }));
        Show("WhenAll<T>(null elem)", () => Task.WhenAll(new Task<int>[] { null! }));
        Show("WhenAny(null elem)", () => Task.WhenAny(new Task[] { null! }));
        Show("SemaphoreSlim(-1,1)", () => new SemaphoreSlim(-1, 1));
        Show("SemaphoreSlim(2,1)", () => new SemaphoreSlim(2, 1));
        Show("SemaphoreSlim(0,0)", () => new SemaphoreSlim(0, 0));
        Show("Sem0.Wait(-2)", () => new SemaphoreSlim(0, 1).Wait(-2));
        Show("Sem1.Wait(-2)", () => new SemaphoreSlim(1, 1).Wait(-2));
        Show("Sem1.WaitAsync(-2)", () => new SemaphoreSlim(1, 1).WaitAsync(-2));
        Show("Sem0.WaitAsync(-2)", () => new SemaphoreSlim(0, 1).WaitAsync(-2));
        Show("Sem0.Wait(-2, none)", () => new SemaphoreSlim(0, 1).Wait(-2, CancellationToken.None));
        Show("Sem0.WaitAsync(-2, none)", () => new SemaphoreSlim(0, 1).WaitAsync(-2, CancellationToken.None));
        Show("Sem0.Wait(TimeSpan -2)", () => new SemaphoreSlim(0, 1).Wait(TimeSpan.FromMilliseconds(-2)));
        Show("Sem1.WaitAsync(TS -2)", () => new SemaphoreSlim(1, 1).WaitAsync(TimeSpan.FromMilliseconds(-2)));
        Show("Sem1.Wait(TS huge)", () => new SemaphoreSlim(1, 1).Wait(TimeSpan.FromDays(30)));
        Show("Sem.Release(0)", () => new SemaphoreSlim(1, 1).Release(0));
        Show("Sem.Release() full", () => new SemaphoreSlim(1, 1).Release());
        object o = new object();
        Show("Monitor.Wait unowned", () => Monitor.Wait(o));
        Show("Monitor.Wait(-2)", () => { lock (o) return Monitor.Wait(o, -2); });
        Show("Monitor.TryEnter(-2)", () => Monitor.TryEnter(o, -2));
        Show("Monitor.TryEnter(TS -2)", () => Monitor.TryEnter(o, TimeSpan.FromMilliseconds(-2)));
        Show("Monitor.TryEnter(TS huge)", () => Monitor.TryEnter(o, TimeSpan.FromDays(30)));
        Show("Monitor.Wait(TS -2)", () => { lock (o) return Monitor.Wait(o, TimeSpan.FromMilliseconds(-2)); });
        Show("Monitor.Exit unowned", () => { Monitor.Exit(o); return 0; });
        Show("TryEnter(null)", () => Monitor.TryEnter(null!));
        Show("TryEnter(null, 5)", () => Monitor.TryEnter(null!, 5));
        Show("Enter(null)", () => { Monitor.Enter(null!); return 0; });
        Show("Exit(null)", () => { Monitor.Exit(null!); return 0; });
        Show("Pulse(null)", () => { Monitor.Pulse(null!); return 0; });
        Show("Wait(null,-2)", () => Monitor.Wait(null!, -2));
        Show("WaitOne(-2)", () => new ManualResetEvent(false).WaitOne(-2));
        Show("WaitOne(TS huge)", () => new ManualResetEvent(true).WaitOne(TimeSpan.FromDays(30)));
        Show("MRES.Wait(-2)", () => new ManualResetEventSlim(true).Wait(-2));
        Show("MRES.Wait(TS -2)", () => new ManualResetEventSlim(true).Wait(TimeSpan.FromMilliseconds(-2)));
        Show("MRES.Wait(TS huge)", () => new ManualResetEventSlim(true).Wait(TimeSpan.FromDays(30)));
        Show("Thread.Join(-2)", () => { Thread t = new Thread(() => { }); t.Start(); return t.Join(-2); });
        Show("Thread.Join(TimeSpan huge)", () => { Thread t = new Thread(() => { }); t.Start(); return t.Join(TimeSpan.FromDays(30)); });
        Show("Thread.Join(TimeSpan -2)", () => { Thread t = new Thread(() => { }); t.Start(); return t.Join(TimeSpan.FromMilliseconds(-2)); });
        Show("Thread.Sleep(-2)", () => { Thread.Sleep(-2); return 0; });
        Show("Thread.Sleep(TimeSpan -2)", () => { Thread.Sleep(TimeSpan.FromMilliseconds(-2)); return 0; });
        Show("Thread.Sleep(TS huge)", () => { Thread.Sleep(TimeSpan.FromDays(30)); return 0; });
        Show("Task.Wait(-2)", () => Task.CompletedTask.Wait(-2));
        Show("Task.Wait(TS -2)", () => Task.CompletedTask.Wait(TimeSpan.FromMilliseconds(-2)));
        Show("WaitAll(-2)", () => { Task.WaitAll(new[] { Task.CompletedTask }, -2); return 0; });
        Show("WaitAny(TS -2)", () => Task.WaitAny(new[] { Task.CompletedTask }, TimeSpan.FromMilliseconds(-2)));
        Show("CTS.CancelAfter(-2)", () => { new CancellationTokenSource().CancelAfter(-2); return 0; });
        Show("CTS(-2)", () => new CancellationTokenSource(-2));
        Show("CTS(TS -2)", () => new CancellationTokenSource(TimeSpan.FromMilliseconds(-2)));
        Show("Linked()", () => CancellationTokenSource.CreateLinkedTokenSource());
        Show("Linked(null)", () => CancellationTokenSource.CreateLinkedTokenSource((CancellationToken[])null!));
        Show("default CTR.Dispose", () => { default(CancellationTokenRegistration).Dispose(); return "ok"; });
        Show("default CTR.Unregister", () => default(CancellationTokenRegistration).Unregister());
        Show("default CTR.Token", () => default(CancellationTokenRegistration).Token.CanBeCanceled);

        // A registration disposed by an earlier callback of the same cancel
        // does not run, and its Unregister says so; one already run says false.
        CancellationTokenSource cts = new CancellationTokenSource();
        string ran = "";
        CancellationTokenRegistration first = cts.Token.Register(() => ran += "first ");
        CancellationTokenRegistration second = default;
        second = cts.Token.Register(() => { ran += "second "; Console.WriteLine("unregister first while running: " + first.Unregister()); });
        CancellationTokenRegistration third = cts.Token.Register(() => { ran += "third "; });
        Console.WriteLine("equal " + (first == first) + " " + (first == second) + " token " + (third.Token == cts.Token));
        cts.Cancel();
        Console.WriteLine("ran " + ran + "| third after " + third.Unregister());

        // Dispose waits for a callback another thread is running.
        CancellationTokenSource slow = new CancellationTokenSource();
        int stage = 0;
        CancellationTokenRegistration held = slow.Token.Register(() => { Volatile.Write(ref stage, 1); Thread.Sleep(200); Volatile.Write(ref stage, 2); });
        Thread canceler = new Thread(() => slow.Cancel());
        canceler.Start();
        while (Volatile.Read(ref stage) == 0) Thread.Yield();
        held.Dispose();
        Console.WriteLine("dispose waited " + (Volatile.Read(ref stage) == 2));
        canceler.Join();
        return 0;
    }
}
