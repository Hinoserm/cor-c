// test: cast_operand_keywords
// expect-exit: 0
// expect-output:
// pair 0 []
// nullable False
// point 0,0
// suppressed 0,0
// boxed 0
// made 7
// awaited 7
//
// What may follow a cast's ')' (C# 12.9.7): any keyword but `as` and `is`.
// `default` after a tuple type, a nullable tuple type and an ordinary type
// name, and `await`, were read as a bracketed group and then refused. And a
// cast says what its `default` (`!` or not) and its `new()` are, not what
// waits for the cast.

using System;
using System.Threading.Tasks;

struct Point
{
    public int X, Y;
}

class Foo
{
    public int V = 7;
}

static class P
{
    static async Task<int> Seven()
    {
        await Task.Delay(1);
        return 7;
    }

    static async Task<long> Widened() => (long)await Seven();

    static void Main()
    {
        var pair = ((int, string))default;
        Console.WriteLine("pair " + pair.Item1 + " [" + pair.Item2 + "]");
        (int, int)? none = ((int, int)?)default;
        Console.WriteLine("nullable " + none.HasValue);
        Point p = (Point)default;
        Console.WriteLine("point " + p.X + "," + p.Y);
        var q = (Point)default!;
        Console.WriteLine("suppressed " + q.X + "," + q.Y);
        object o = (Point)default!;
        Console.WriteLine("boxed " + ((Point)o).X);
        object made = (Foo)new();
        Console.WriteLine("made " + ((Foo)made).V);
        Console.WriteLine("awaited " + Widened().Result);
    }
}
