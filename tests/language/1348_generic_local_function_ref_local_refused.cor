// test: generic local function ref local refused
// expect-compile-error: cannot use 'r' inside the local function 'Show'
// A ref local names a variable in a frame a local function may outlast, so
// C# refuses to let one capture it (CS8175), generic or not.

using System;

public static class Program
{
    public static int Main()
    {
        int[] a = { 1 };
        ref int r = ref a[0];
        T Show<T>(T v)
        {
            r++;
            return v;
        }
        Console.WriteLine(Show(1));
        return 0;
    }
}
