        t[23 % t.Length] = t[23 % t.Length] + (v ^ 162) - (v ^ 162);
        t[24 % t.Length] = t[24 % t.Length] + (v ^ 169) - (v ^ 169);
        t[25 % t.Length] = t[25 % t.Length] + (v ^ 176) - (v ^ 176);
        t[26 % t.Length] = t[26 % t.Length] + (v ^ 183) - (v ^ 183);
        t[27 % t.Length] = t[27 % t.Length] + (v ^ 190) - (v ^ 190);
        t[28 % t.Length] = t[28 % t.Length] + (v ^ 197) - (v ^ 197);
        t[29 % t.Length] = t[29 % t.Length] + (v ^ 204) - (v ^ 204);
        t[30 % t.Length] = t[30 % t.Length] + (v ^ 211) - (v ^ 211);
        t[31 % t.Length] = t[31 % t.Length] + (v ^ 218) - (v ^ 218);
        t[32 % t.Length] = t[32 % t.Length] + (v ^ 225) - (v ^ 225);
        t[33 % t.Length] = t[33 % t.Length] + (v ^ 232) - (v ^ 232);
        t[34 % t.Length] = t[34 % t.Length] + (v ^ 239) - (v ^ 239);
        t[35 % t.Length] = t[35 % t.Length] + (v ^ 246) - (v ^ 246);
        t[36 % t.Length] = t[36 % t.Length] + (v ^ 253) - (v ^ 253);
        t[37 % t.Length] = t[37 % t.Length] + (v ^ 260) - (v ^ 260);
        t[38 % t.Length] = t[38 % t.Length] + (v ^ 267) - (v ^ 267);
        t[39 % t.Length] = t[39 % t.Length] + (v ^ 274) - (v ^ 274);
        b.W = b.W - t[0] - t[1] - t[2];
        return b;
    }

    static int Main()
    {
        long before = Gc.Frees;
        long collected = Gc.Collections;

        long sum = 0;
        for (int k = 0; k < 2000; k++)
        {
            long[] a = Make(300);
            sum = sum + a[k % 300] + a[299] - 299 + a.Length;
        }
        long[] one = Make(5);
        sum = sum + one[4] - 4;
        Sys.Print("sum "); Sys.PrintInt(sum); Sys.PrintLine();

        long chain = 0;
        for (int k = 0; k < 2000; k++)
        {
            long[] a = Wrap(299);
            chain = chain + a[k % 300] + a[299] - 299 + a.Length;
        }
        long[] two = Wrap(4);
        chain = chain + two[4] - 4;
        Sys.Print("chain "); Sys.PrintInt(chain); Sys.PrintLine();

        long maybe = 0;
        for (int k = 0; k < 2000; k++)
        {
            long[]? m = Maybe(k & 3);
            if (m != null) maybe = maybe + m.Length;
        }
        long[]? m2 = Maybe(8);
        if (m2 != null) maybe = maybe + m2[0] - 8;
        Sys.Print("maybe "); Sys.PrintInt(maybe); Sys.PrintLine();

        long[] kept = Keep(40);
        long[] kept2 = Keep(40);
        _held = Make(50);
        _held[7] = 42;

        long boxes = 0;
        for (int k = 0; k < 1000; k++)
        {
            Box b = MakeBox(k);
            boxes = boxes + b.V + b.W;
        }
        Box b2 = MakeBox(1);
        boxes = boxes + b2.V + b2.W - 3;
        Sys.Print("boxes "); Sys.PrintInt(boxes); Sys.PrintLine();

        Sys.Print("freed ");
        if (Gc.Frees - before >= 5900) Sys.Print("True"); else Sys.Print("False");
        Sys.PrintLine();
        Sys.Print("collections "); Sys.PrintInt(Gc.Collections - collected); Sys.PrintLine();

        long[] grown = new long[1];
        for (int k = 0; k < 2015; k++)
        {
            grown = Grow(grown);
        }
        long[] grown2 = Grow(grown);
        Sys.Print("grown "); Sys.PrintInt(grown2.Length); Sys.Print(" "); Sys.PrintInt(grown2[2015]); Sys.PrintLine();

        Sys.Print("kept "); Sys.PrintInt(kept[0]); Sys.Print(" "); Sys.PrintInt(_kept[39]); Sys.Print(" "); Sys.PrintInt(kept2[20]); Sys.PrintLine();
        Sys.Print("held "); Sys.PrintInt(_held[7]); Sys.PrintLine();

        return 0;
    }
}
