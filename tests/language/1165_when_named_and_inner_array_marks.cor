// test: when_named_and_inner_array_marks
// expect-exit: 0
// expect-output:
// 117
//
// `when` names what a pattern matched where nothing follows it but what
// ends the pattern (`c is not Cond when) continue;`), and an array type
// argument's own `?` marks the inner array of `T[]`: T = long[]? makes
// long[]?[], whose longs are not long?.

using System;
using System.Collections.Generic;
using System.Linq;
class Cond { public int V; }
static class P
{
    static Cond? Pick(int i) => i % 2 == 0 ? new Cond { V = i } : null;
    static void Main()
    {
        int sum = 0;
        for (int i = 0; i < 6; i++)
        {
            if (Pick(i) is not Cond when) continue;
            sum += when.V;
        }
        Dictionary<int, long[]?[]> held = new() { [1] = new long[]?[] { new long[] { 5, 6 }, null } };
        if (held.TryGetValue(1, out long[]?[]? got))
        {
            long[]?[] copy = (long[]?[])got.Clone();
            long[]?[] listed = Enumerable.Range(0, 3).Select(p => p == 1 ? new long[] { p } : null).ToArray();
            sum += copy.Length + listed.Length + (int)copy[0]![1] + (listed[1]![0] == 1 ? 100 : 0);
        }
        Console.WriteLine(sum);
    }
}
