// test: anonymous_methods
// expect-exit: 0
// expect-output:
// 42 5
// 2 12
// 10
// 3,2,1
// 7
// True False
// 4
// 120
// 1
//
// ANONYMOUS METHODS (C# 12.19): `delegate (int x) { ... }` is a block lambda
// with every parameter's type written; `delegate { ... }`, with no parameter
// list at all, converts to a delegate of any parameters but `out` ones and
// reads none of them -- an Action, a two-parameter delegate, an
// EventHandler. Either may follow a cast, be passed, sort a list, call
// itself through a variable it captured, or capture and change a local.

using System;
using System.Collections.Generic;

delegate int Op(int a, int b);
delegate void Note(string s, int n);

static class P
{
    static int Apply(Func<int, int> f, int x) => f(x);

    static void Main()
    {
        Func<int, int> twice = delegate (int x) { return x * 2; };
        Op add = delegate (int a, int b) { return a + b; };
        Console.WriteLine(twice(21) + " " + add(2, 3));
        int count = 0;
        Action bump = delegate { count++; };
        bump(); bump();
        Note ignore = delegate { count += 10; };
        Console.Write(count + " ");
        ignore("x", 1);
        Console.WriteLine(count);
        Console.WriteLine(Apply(delegate (int v) { return v + 1; }, 9));
        List<int> list = new() { 3, 1, 2 };
        list.Sort(delegate (int a, int b) { return b.CompareTo(a); });
        Console.WriteLine(string.Join(",", list));
        Func<int> seven = (Func<int>)delegate { return 7; };
        Console.WriteLine(seven());
        Predicate<string> empty = delegate (string s) { return s.Length == 0; };
        Console.WriteLine(empty("") + " " + empty("a"));
        Action<int> each = delegate (int n) { if (n > 0) Console.Write(n); };
        each(4); each(-1); Console.WriteLine();
        Func<int, int> fact = null!;
        fact = delegate (int n) { return n <= 1 ? 1 : n * fact(n - 1); };
        Console.WriteLine(fact(5));
        int fired = 0;
        EventHandler h = delegate { fired++; };
        h(null, EventArgs.Empty);
        Console.WriteLine(fired);
    }
}
