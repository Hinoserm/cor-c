// test: array_interface_casts
// expect-exit: 0
// expect-output:
// 0 3 3 2 5
// 6
//
// An array converted to one of its sequence interfaces answers through it
// however the conversion is written: implicitly, by an explicit cast, and on
// either side of `??` -- `maybe ?? (IReadOnlyList<int>)None`, where the
// stage-1 compiler read the interface table of a bare array and crashed.

using System;
using System.Collections.Generic;

static class Program
{
    static readonly int[] None = Array.Empty<int>();
    static int[]? maybe;
    static IReadOnlyList<int> Get() => maybe ?? (IReadOnlyList<int>)None;

    static int Main()
    {
        IReadOnlyList<int> a = Get();
        maybe = new[] { 1, 2, 3 };
        IReadOnlyList<int> b = Get();
        int[] c = new[] { 4, 5 };
        IEnumerable<int> d = new[] { 6 };
        Console.WriteLine($"{a.Count} {b.Count} {b[2]} {c.Length} {c[1]}");
        foreach (int x in d) Console.WriteLine(x);
        return 0;
    }
}
