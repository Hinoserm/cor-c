// test: inline_asm_below_esp_refused
// only-target: x86
// expect-compile-error: below ESP
//
// Below ESP an interrupt or a signal may write at any time
// (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static int Main()
    {
        asm
        {
            mov dword [esp - 4], 0
        }
        return 0;
    }
}
