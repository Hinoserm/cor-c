// double 'Infinity' FormatException FormatException FormatException | inv Infinity Infinity
// double '-Infinity' FormatException FormatException FormatException | inv -Infinity -Infinity
// double '~Infinity' FormatException FormatException FormatException | inv FormatException FormatException
// double '12_345;5 EUR' FormatException 12345.5 12345.5 | inv FormatException FormatException
// double '1.234,5 EUR' FormatException 1234.5 1234.5 | inv FormatException FormatException
// double 'EUR1.234,5' FormatException FormatException FormatException | inv FormatException FormatException
// double '(1,5)' FormatException -1.5 -1.5 | inv FormatException -15
// double '1.5' 15 15 15 | inv 1.5 1.5
// double '1,234.5' FormatException FormatException FormatException | inv 1234.5 1234.5
// double ',5' 0.5 0.5 0.5 | inv FormatException FormatException
// double '5,' 5 5 5 | inv 5 5
// double '1,5~' FormatException -1.5 -1.5 | inv FormatException FormatException
// float -1.25 NaN 1234.5 1.5
// try True -5 False 0 True 1.5 True 0 255 -128 -1234 18446744073709551615
// big -12345678901234567890 5
// nbsp 1234567 1234 -5 -5 FormatException −5 1 234 567
// same 1.234 FormatException 1,234,50
// words -5 5 FormatException -5 minus 5 5.00Eplus 000 5.00Eminus 002
//
// EVERY NUMBER AS ITS PROVIDER SAYS (NumberFormatInfo): sbyte to ulong, nint,
// double, float and BigInteger in every standard format and in pictures --
// signs, decimal and group separators, group sizes ([3,2], [3,0], [1,2,3],
// none), currency, percent and per mille symbols, every currency, number and
// percent pattern, digit counts, NaN and the infinities, exponents' signs --
// through ToString, String.Format, Convert and IFormattable; the invariant
// culture and a copy of it writing exactly what no provider writes. And read
// back as it says: Parse and TryParse of each style with a culture's signs
// (whole words, a minus that takes a hyphen), separators (the currency's
// while its symbol may come, a space for a non-breaking one), currency
// symbol, parentheses, exponent signs and NaN and infinity words. Every line
// is what .NET 10 prints.

using System;
using System.Globalization;
using System.Numerics;

static class Program
{
    static void Say(string s) => Console.WriteLine(s);

    static NumberFormatInfo Odd()
    {
        NumberFormatInfo n = new NumberFormatInfo();
        n.NumberDecimalSeparator = ",";
        n.NumberGroupSeparator = ".";
        n.NumberGroupSizes = new[] { 3, 2 };
        n.NumberNegativePattern = 3;
        n.NumberDecimalDigits = 3;
        n.CurrencySymbol = "EUR";
        n.CurrencyDecimalSeparator = ";";
        n.CurrencyGroupSeparator = "_";
        n.CurrencyGroupSizes = new[] { 2 };
        n.CurrencyDecimalDigits = 1;
        n.CurrencyPositivePattern = 3;
        n.CurrencyNegativePattern = 8;
        n.PercentSymbol = "pct";
        n.PercentDecimalSeparator = ":";
        n.PercentGroupSeparator = "'";
        n.PercentGroupSizes = new[] { 4 };
        n.PercentDecimalDigits = 0;
        n.PercentPositivePattern = 1;
        n.PercentNegativePattern = 2;
        n.PerMilleSymbol = "pm";
        n.NegativeSign = "~";
        n.PositiveSign = "#";
        n.NaNSymbol = "nan!";
        n.PositiveInfinitySymbol = "+inf";
        n.NegativeInfinitySymbol = "-inf";
        return n;
    }

    static readonly string[] Standard = { "", "C", "C0", "C3", "D", "D6", "E", "E2", "e0", "F", "F0", "F4", "G", "G3", "g10", "N", "N0", "N5", "P", "P1", "R", "X", "x8", "B" };
    static readonly string[] Real = { "", "C", "C0", "E", "E2", "e0", "F", "F0", "F4", "G", "G3", "g10", "G17", "N", "N0", "N5", "P", "P1", "R" };
    static readonly string[] Pictures = { "#,##0.00", "0.###E+0", "0.0e-00", "0%", "0.0‰", "#,#", "00.00;(00.00);zero", "'lit'0", "\\#0", "#,##0,,", "0.00;-0.00", "#", "0.##" };

    static string Run(Func<string> f)
    {
        try { return f(); }
        catch (Exception e) { return e.GetType().Name; }
    }

    static void Writes()
    {
        NumberFormatInfo odd = Odd();
        NumberFormatInfo inv = NumberFormatInfo.InvariantInfo;
        int[] ints = { 0, 7, -7, 1234567, -1234567, int.MinValue };
        foreach (int v in ints)
        {
            string line = "int " + v + ":";
            foreach (string f in Standard) line += " [" + f + "]" + Run(() => v.ToString(f, odd));
            Say(line);
        }
        foreach (int v in new[] { 0, 1234567, -1234567 })
        {
            string line = "pic " + v + ":";
            foreach (string f in Pictures) line += " [" + f + "]" + Run(() => v.ToString(f, odd));
            Say(line);
        }
        Say("long " + Run(() => long.MinValue.ToString("N", odd)) + " " + Run(() => (-12345678901L).ToString("C", odd)) + " " + Run(() => 987654321012L.ToString(odd)));
        Say("ulong " + Run(() => ulong.MaxValue.ToString("N", odd)) + " " + Run(() => 12UL.ToString("P", odd)));
        Say("uint " + Run(() => 4000000000u.ToString("N0", odd)) + " short " + Run(() => ((short)-1234).ToString("N", odd)) + " ushort " + Run(() => ((ushort)65535).ToString("C", odd)));
        Say("byte " + Run(() => ((byte)255).ToString("P", odd)) + " sbyte " + Run(() => ((sbyte)-128).ToString("D5", odd)) + " " + Run(() => ((sbyte)-5).ToString(odd)));
        Say("nint " + Run(() => ((nint)(-42)).ToString("N", odd)) + " " + Run(() => ((nuint)42).ToString("N", odd)));
        double[] doubles = { 0.0, -0.0, 1234.5678, -1234.5678, 0.000012345, 1.5e30, -2.5e-300, double.NaN, double.PositiveInfinity, double.NegativeInfinity, 0.125, 12345678.9 };
        foreach (double v in doubles)
        {
            string line = "double " + v.ToString(CultureInfo.InvariantCulture) + ":";
            foreach (string f in Real) line += " [" + f + "]" + Run(() => v.ToString(f, odd));
            Say(line);
        }
        foreach (double v in new[] { 1234.5678, -1234.5678, 0.0 })
        {
            string line = "dpic " + v.ToString(CultureInfo.InvariantCulture) + ":";
            foreach (string f in Pictures) line += " [" + f + "]" + Run(() => v.ToString(f, odd));
            Say(line);
        }
        float s = -1234.5f;
        Say("float " + s.ToString(odd) + " " + s.ToString("N2", odd) + " " + s.ToString("E3", odd) + " " + float.NaN.ToString(odd) + " " + float.NegativeInfinity.ToString("F", odd));
        BigInteger big = BigInteger.Parse("-123456789012345678901234567890");
        Say("big " + big.ToString(odd) + " " + big.ToString("N", odd) + " " + big.ToString("C2", odd) + " " + big.ToString("E3", odd) + " " + big.ToString("#,##0", odd) + " " + BigInteger.One.ToString("P", odd));

        // The invariant culture, and a copy of it, write exactly what no provider writes.
        NumberFormatInfo copy = (NumberFormatInfo)inv.Clone();
        bool same = true;
        foreach (int v in ints)
            foreach (string f in Standard)
                if (Run(() => v.ToString(f, copy)) != Run(() => v.ToString(f)) || Run(() => v.ToString(f, inv)) != Run(() => v.ToString(f))) same = false;
        foreach (double v in doubles)
            foreach (string f in Real)
                if (Run(() => v.ToString(f, copy)) != Run(() => v.ToString(f))) same = false;
        Say("invariant copy same " + same);

        // Patterns, every one.
        string pats = "";
        for (int p = 0; p <= 16; p++)
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.CurrencyNegativePattern = p;
            c.CurrencySymbol = "$";
            pats += " " + (-1.5).ToString("C", c);
        }
        Say("cur neg" + pats);
        pats = "";
        for (int p = 0; p <= 3; p++)
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.CurrencyPositivePattern = p;
            c.CurrencySymbol = "$";
            pats += " " + 1.5.ToString("C", c);
        }
        Say("cur pos" + pats);
        pats = "";
        for (int p = 0; p <= 4; p++)
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.NumberNegativePattern = p;
            pats += " " + (-1.5).ToString("N", c);
        }
        Say("num neg" + pats);
        pats = "";
        for (int p = 0; p <= 11; p++)
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.PercentNegativePattern = p;
            pats += " " + (-0.015).ToString("P", c);
        }
        Say("pct neg" + pats);
        pats = "";
        for (int p = 0; p <= 3; p++)
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.PercentPositivePattern = p;
            pats += " " + 0.015.ToString("P", c);
        }
        Say("pct pos" + pats);
        foreach (int[] sizes in new[] { new[] { 3, 0 }, new[] { 1, 2, 3 }, new int[0], new[] { 0 }, new[] { 2, 3, 0 } })
        {
            NumberFormatInfo c = (NumberFormatInfo)inv.Clone();
            c.NumberGroupSizes = sizes;
            Say("sizes [" + string.Join(",", sizes) + "] " + 1234567890L.ToString("N0", c) + " " + 1234567890.123.ToString("N2", c) + " " + 1234567890.ToString("#,#", c));
        }

        // Other entry points.
        Say("format " + string.Format(odd, "{0} {1:N} {2:C} {3:P0} {4:E1}", -5, 1234.5, -1234.5, 0.5, 12345.0));
        Say("convert " + Convert.ToString(-1234.5, odd) + " " + Convert.ToString(-12, odd) + " " + Convert.ToString(12L, odd));
        Say("culture " + 1234.5.ToString("N", CultureInfo.InvariantCulture) + " " + ((IFormattable)(-12)).ToString("N", odd) + " " + ((IFormattable)1.5).ToString(null, odd));
    }


    static NumberFormatInfo ReadOdd()
    {
        NumberFormatInfo n = new NumberFormatInfo();
        n.NumberDecimalSeparator = ",";
        n.NumberGroupSeparator = ".";
        n.CurrencySymbol = "EUR";
        n.CurrencyDecimalSeparator = ";";
        n.CurrencyGroupSeparator = "_";
        n.PercentSymbol = "pct";
        n.NegativeSign = "~";
        n.PositiveSign = "#";
        n.NaNSymbol = "nan!";
        n.PositiveInfinitySymbol = "+inf";
        n.NegativeInfinitySymbol = "-inf";
        return n;
    }

    static string Int(string s, NumberStyles style, IFormatProvider p)
    {
        try { return int.Parse(s, style, p).ToString(); }
        catch (Exception e) { return e.GetType().Name; }
    }

    static string Long(string s, NumberStyles style, IFormatProvider p)
    {
        try { return long.Parse(s, style, p).ToString(); }
        catch (Exception e) { return e.GetType().Name; }
    }

    static string Dbl(string s, NumberStyles style, IFormatProvider p)
    {
        try { return double.Parse(s, style, p).ToString(CultureInfo.InvariantCulture); }
        catch (Exception e) { return e.GetType().Name; }
    }

    static string Flt(string s, IFormatProvider p)
    {
        try { return float.Parse(s, p).ToString(CultureInfo.InvariantCulture); }
        catch (Exception e) { return e.GetType().Name; }
    }

    static void Reads()
    {
        NumberFormatInfo odd = ReadOdd();
        IFormatProvider inv = CultureInfo.InvariantCulture;
        NumberStyles i = NumberStyles.Integer, n = NumberStyles.Number, f = NumberStyles.Float | NumberStyles.AllowThousands, c = NumberStyles.Currency, a = NumberStyles.Any;
        string[] ints = { "12", "~12", "#12", "-12", "+12", " ~12 ", "~ 12", "12~", "(12)", "12.345", "12.345.678", "1.2.3", "12,0", "12,5", "12;0", "EUR12", "12EUR", "EUR 12", "~EUR12", "EUR~12", "12_345", "12_345;0 EUR", "", "~", "#", "1,234", "1,234.5" };
        foreach (string s in ints)
            Say("int '" + s + "' " + Int(s, i, odd) + " " + Int(s, n, odd) + " " + Int(s, c, odd) + " " + Int(s, a, odd) + " | inv " + Int(s, n, inv) + " " + Int(s, c, inv));
        Say("long " + Long("~9223372036854775808", i, odd) + " " + Long("9.223.372.036.854.775.807", n, odd) + " " + Long("~9.223.372.036.854.775.809", n, odd));
        string[] reals = { "1,5", "~1,5", "#1,5", "1.234,5", "1,5E#3", "1,5E~3", "1,5E3", "1,5e-3", "1,5E+3", "nan!", "NAN!", "~nan!", "#nan!", "+inf", "-inf", "#+inf", "~-inf", "NaN", "Infinity", "-Infinity", "~Infinity", "12_345;5 EUR", "1.234,5 EUR", "EUR1.234,5", "(1,5)", "1.5", "1,234.5", ",5", "5,", "1,5~" };
        foreach (string s in reals)
            Say("double '" + s + "' " + Dbl(s, f, odd) + " " + Dbl(s, c, odd) + " " + Dbl(s, a, odd) + " | inv " + Dbl(s, f, inv) + " " + Dbl(s, a, inv));
        Say("float " + Flt("~1,25", odd) + " " + Flt("nan!", odd) + " " + Flt("1.234,5", odd) + " " + Flt("1.5", inv));
        int got;
        Say("try " + int.TryParse("~5", NumberStyles.Integer, odd, out got) + " " + got + " " + int.TryParse("-5", NumberStyles.Integer, odd, out got) + " " + got
            + " " + double.TryParse("1,5", NumberStyles.Float, odd, out double d) + " " + d.ToString(CultureInfo.InvariantCulture)
            + " " + uint.TryParse("~0", NumberStyles.Integer, odd, out uint u) + " " + u + " " + byte.Parse("#255", odd) + " " + sbyte.Parse("~128", odd)
            + " " + short.Parse("~1.234", NumberStyles.AllowThousands | NumberStyles.AllowLeadingSign, odd) + " " + ulong.Parse("18.446.744.073.709.551.615", NumberStyles.Number, odd));
        Say("big " + BigInteger.Parse("~12.345.678.901.234.567.890", NumberStyles.Number, odd) + " " + BigInteger.Parse("#5", odd));

        // A non-breaking space for a group separator takes a space too; a
        // minus sign other than the hyphen takes the hyphen too.
        NumberFormatInfo spaced = new NumberFormatInfo { NumberGroupSeparator = " ", NegativeSign = "−" };
        Say("nbsp " + Int("1 234 567", n, spaced) + " " + Int("1 234", n, spaced) + " " + Int("-5", i, spaced) + " " + Int("−5", i, spaced) + " " + Dbl("-1 234,5", f, spaced)
            + " " + (-5).ToString(spaced) + " " + 1234567.ToString("N0", spaced));
        // The same separator for the point and the groups.
        NumberFormatInfo same = new NumberFormatInfo { NumberGroupSeparator = ",", NumberDecimalSeparator = "," };
        Say("same " + Dbl("1,234", f, same) + " " + Dbl("1,234,5", f, same) + " " + 1234.5.ToString("N", same));
        // Longer signs.
        NumberFormatInfo words = new NumberFormatInfo { NegativeSign = "minus ", PositiveSign = "plus " };
        Say("words " + Int("minus 5", i, words) + " " + Int("plus 5", i, words) + " " + Int("minus5", i, words) + " " + Int("5minus ", NumberStyles.AllowTrailingSign, words)
            + " " + (-5).ToString(words) + " " + (5.0).ToString("E2", words) + " " + (0.05).ToString("E2", words));
    }

    static void Main()
    {
        Writes();
        Reads();
    }
}
