// double 'NAN!' NaN NaN NaN | inv FormatException FormatException
// double '~nan!' NaN NaN NaN | inv FormatException FormatException
// double '#nan!' NaN NaN NaN | inv FormatException FormatException
// double '+inf' Infinity Infinity Infinity | inv FormatException FormatException
// double '-inf' -Infinity -Infinity -Infinity | inv FormatException FormatException
// double '#+inf' Infinity Infinity Infinity | inv FormatException FormatException
