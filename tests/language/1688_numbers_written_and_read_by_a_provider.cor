// int '~' FormatException FormatException FormatException FormatException | inv FormatException FormatException
// int '#' FormatException FormatException FormatException FormatException | inv FormatException FormatException
// int '1,234' FormatException OverflowException OverflowException OverflowException | inv 1234 1234
// int '1,234.5' FormatException FormatException FormatException FormatException | inv OverflowException OverflowException
// long -9223372036854775808 9223372036854775807 OverflowException
