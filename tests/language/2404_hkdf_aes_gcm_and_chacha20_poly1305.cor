// test: hkdf_aes_gcm_and_chacha20_poly1305
// expect-exit: 0
// expect-output:
// hkdf MD5 prk=17700A7E4E55811307BD3CC3B6BAE2E7 okm=AE676BFE4FA318EEDB07BCD10651C8F6377DA83BE8B2AADAD7E23CB1C069DC21A844732555D77B2AFCD8 same=True nosalt=0034A15E9BB4DB59
// hkdf SHA1 prk=7BF4CF5CF243873DCB9F7D426D10D7AF9366EDA2 okm=96FFC03E4C0F711340759778BFE4E3D1744EB081B5F6B9E0B9AB64C3CF640565CB900BAAA7FBC65B6F38 same=True nosalt=460C07E6C0A3E93E
// hkdf SHA256 prk=BDD4D4E7DF9EA7C360B3E613D017E14B8CAC7E40A6917B7B05A699633878CBFC okm=370EF5B2AC0377057A656F7D8C661E4C8C97ADA0B1345C6E2AAB04EF5ED67A4F689962BCD4C419AE576F same=True nosalt=68041BF9FD1B496B
