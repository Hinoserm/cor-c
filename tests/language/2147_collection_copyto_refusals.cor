// list set ArgumentOutOfRangeException: Index was out of range. Must be non-negative and less than the size of the collection. (Parameter 'index')
//
// Every collection's CopyTo refuses as its .NET counterpart does: List's,
// an array's, a segment's and ReadOnlyCollection's through Array.Copy;
// Queue's and Stack's, HashSet's and SortedSet's, LinkedList's and the
// dictionaries' views each in their own words. Array.Sort over a run,
// List.CopyTo over a run and Queue's capacity are there too.
// Expected output from .NET 10.

using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Linq;

static class Program
{
    static void Try(string what, Action a)
    {
        try { a(); Console.WriteLine(what + " ok"); }
        catch (Exception e) { Console.WriteLine(what + " " + e.GetType().Name + ": " + e.Message.Replace("\n", " | ")); }
    }

    static void Bad<T>(string name, Action<T[]?, int> copy)
    {
        Try(name + " null", () => copy(null, 0));
        Try(name + " neg", () => copy(new T[5], -1));
        Try(name + " past", () => copy(new T[5], 6));
        Try(name + " short", () => copy(new T[5], 3));
        Try(name + " end", () => copy(new T[3], 3));
        T[] fits = new T[5];
        Try(name + " fits", () => copy(fits, 2));
        Console.WriteLine(name + " into " + string.Join(",", fits));
    }

    static void Main()
    {
        int[] three = { 1, 2, 3 };
        List<int> list = new(three);
        Bad<int>("list", (a, i) => list.CopyTo(a!, i));
        Try("list one null", () => list.CopyTo(null!));
        Try("list one short", () => list.CopyTo(new int[2]));
        Try("list four", () => list.CopyTo(1, new int[5], 0, 3));
        Try("list four neg count", () => list.CopyTo(0, new int[5], 0, -1));
        Try("list four neg index", () => list.CopyTo(-1, new int[5], 0, 1));
        Try("list four null", () => list.CopyTo(0, null!, 0, 1));
        Bad<int>("array", (a, i) => three.CopyTo(a!, i));
        Bad<int>("queue", (a, i) => new Queue<int>(three).CopyTo(a!, i));
        Bad<int>("stack", (a, i) => new Stack<int>(three).CopyTo(a!, i));
        Bad<int>("hashset", (a, i) => new HashSet<int>(three).CopyTo(a!, i));
        Try("hashset count neg", () => new HashSet<int>(three).CopyTo(new int[5], 0, -1));
        Try("hashset count big", () => new HashSet<int>(three).CopyTo(new int[5], 3, 3));
        Try("hashset count less", () => new HashSet<int>(three).CopyTo(new int[5], 4, 1));
        Bad<int>("sortedset", (a, i) => new SortedSet<int>(three).CopyTo(a!, i));
        Try("sortedset count neg", () => new SortedSet<int>(three).CopyTo(new int[5], 0, -1));
        Try("sortedset count big", () => new SortedSet<int>(three).CopyTo(new int[5], 3, 3));
        Bad<int>("linkedlist", (a, i) => new LinkedList<int>(three).CopyTo(a!, i));
        Dictionary<int, int> d = three.ToDictionary(x => x, x => x * 10);
        Bad<int>("dictkeys", (a, i) => d.Keys.CopyTo(a!, i));
        Bad<int>("dictvalues", (a, i) => d.Values.CopyTo(a!, i));
        Bad<KeyValuePair<int, int>>("dictpairs", (a, i) => ((ICollection<KeyValuePair<int, int>>)d).CopyTo(a!, i));
        SortedDictionary<int, int> sd = new(d);
        Bad<int>("sdkeys", (a, i) => sd.Keys.CopyTo(a!, i));
        Bad<int>("sdvalues", (a, i) => sd.Values.CopyTo(a!, i));
        Bad<KeyValuePair<int, int>>("sdpairs", (a, i) => sd.CopyTo(a!, i));
        SortedList<int, int> sl = new(d);
        Bad<int>("slkeys", (a, i) => sl.Keys.CopyTo(a!, i));
        Bad<KeyValuePair<int, int>>("slpairs", (a, i) => ((ICollection<KeyValuePair<int, int>>)sl).CopyTo(a!, i));
        Bad<int>("readonly", (a, i) => new ReadOnlyCollection<int>(list).CopyTo(a!, i));
        Bad<int>("segment", (a, i) => new ArraySegment<int>(three, 1, 2).CopyTo(a!, i));
        Try("span short", () => three.AsSpan().CopyTo(new int[2]));
        Try("queue cap", () => new Queue<int>(-1));
        Console.WriteLine("queue cap ok " + new Queue<int>(10).Count);
        Try("array sort range", () => { int[] s = { 3, 1, 2, 0 }; Array.Sort(s, 1, 2); Console.WriteLine(string.Join(",", s)); });
        Try("array sort range neg", () => Array.Sort(new int[3], -1, 1));
        Try("array sort range len", () => Array.Sort(new int[3], 0, -1));
        Try("array sort range past", () => Array.Sort(new int[3], 2, 2));
        Try("list index", () => Console.WriteLine(list[3]));
        Try("list set", () => list[-1] = 3);
    }
}
