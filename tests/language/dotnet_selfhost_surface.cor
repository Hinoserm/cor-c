// test: .NET surface the compiler's own source uses
// expect-exit: 0
// expect-output:
// E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855
// BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD
// CDC76E5C9914FB9281A1C7E284D73E67F1809A48A497200E046D39CCC7112CD0
// 248D6A61D20638B8E5C026930C3E6039A33CE45964FF2167F6ECEDD419DB06C1
// 248D6A61D20638B8E5C026930C3E6039A33CE45964FF2167F6ECEDD419DB06C1
// 4,3,2,1
// 1,2,3,4
// 4,2,1,3
// worker False
// Object System.Object Int32 Row
// True
// foreground finished
//
// SHA256 (FIPS 180-4 vectors, one-shot, incremental and over a Stream), OrderBy
// then ThenBy and IOrderedEnumerable, a foreground Thread the process waits
// for after Main, Thread.Name, `object o = new()`, Type.Name and FullName,
// GC.GetTotalPauseDuration, target-typed `new(...)` in a collection
// initializer and a lambda handed to a constructor. The expected lines are
// real .NET 10's output.

using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
static class Program
{
    record Row(string Name, int Age, int Id);
    static int Main()
    {
        Console.WriteLine(Convert.ToHexString(SHA256.HashData(new byte[0])));
        Console.WriteLine(Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes("abc"))));
        byte[] million = new byte[1000000];
        for (int i = 0; i < million.Length; i++) million[i] = (byte)'a';
        Console.WriteLine(Convert.ToHexString(SHA256.HashData(million)));
        using (SHA256 sha = SHA256.Create())
        {
            byte[] a = Encoding.UTF8.GetBytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
            sha.TransformBlock(a, 0, 10, null, 0);
            sha.TransformFinalBlock(a, 10, a.Length - 10);
            Console.WriteLine(Convert.ToHexString(sha.Hash!));
            Console.WriteLine(Convert.ToHexString(sha.ComputeHash(new MemoryStream(a))));
        }
        List<Row> rows = new() { new("b", 30, 1), new("a", 30, 2), new("c", 20, 3), new("a", 20, 4) };
        Console.WriteLine(string.Join(",", rows.OrderBy(r => r.Age).ThenBy(r => r.Name).Select(r => r.Id)));
        Console.WriteLine(string.Join(",", rows.OrderByDescending(r => r.Age).ThenByDescending(r => r.Name, StringComparer.Ordinal).Select(r => r.Id)));
        IOrderedEnumerable<Row> ordered = rows.OrderBy(r => r.Name);
        Console.WriteLine(string.Join(",", ordered.ThenBy(r => r.Age).Select(r => r.Id)));
        int done = 0;
        Thread t = new Thread(() => { Thread.Sleep(200); done = 1; Console.WriteLine("foreground finished"); }) { Name = "worker", IsBackground = false };
        Console.WriteLine(t.Name + " " + t.IsBackground);
        t.Start();
        object gate = new();
        Console.WriteLine(gate.GetType().Name + " " + gate.GetType().FullName + " " + typeof(int).Name + " " + typeof(Row).Name);
        Console.WriteLine(GC.GetTotalPauseDuration() >= TimeSpan.Zero);
        return done;
    }
}
