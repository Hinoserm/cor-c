// test: lazy_helper_owned_in_frame
// expect-exit: 0
// expect-output:
// 35040000
//
// A helper made only when first wanted, `known ??= new Known(n)`, inside a
// loop: the register it is read through is written with null and with it,
// and the one `??=` reads is written with that register and with the new
// object -- each waits on the other. Judged together they hold nothing
// else, so the helper lives in the frame; its arrays, filled through the
// registers they were stored from, are owned with it. Output from .NET.

using System;
using System.Collections.Generic;
sealed class Known
{
    readonly int[] _writes;
    readonly long[] _value;
    readonly bool[] _same;
    public Known(int n)
    {
        _writes = new int[n];
        _value = new long[n];
        _same = new bool[n];
        for (int i = 0; i < n; i++) { _writes[i] = i & 3; _value[i] = i * 7; _same[i] = (i & 1) == 0; }
    }
    public long Fold(int i) => _same[i % _same.Length] ? _value[i % _value.Length] : _writes[i % _writes.Length];
}
public static class Program
{
    static long Run(int n, int salt)
    {
        Known? known = null;
        long t = 0;
        for (int k = 0; k < n; k++)
        {
            if (((k + salt) & 3) == 0)
            {
                known ??= new Known(n);
                t += known.Fold(k);
            }
        }
        return t;
    }
    public static int Main()
    {
        long t = 0;
        for (int i = 0; i < 20000; i++) t += Run(64, i);
        Console.WriteLine(t);
        return 0;
    }
}
