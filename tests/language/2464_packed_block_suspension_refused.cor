// test: packed operations in a body that suspends (an await foreach) are refused: its frame outlives a run
// expect-compile-error: outside a method's own body -- in a lambda, or in a body that awaits or yields
// The compiler makes each processor's version of a method's body, and keeps
// the thread's x87 and MMX state around it; a body that suspends would hand
// that state to whatever the thread ran next. An await foreach suspends as
// an await does: the packed operation goes into a method of its own.

using System;
using System.Collections.Generic;
using System.Threading.Tasks;

static class Program
{
    static async IAsyncEnumerable<int> Items()
    {
        await Task.Yield();
        yield return 1;
    }

    static async Task<int> Sum()
    {
        int total = 0;
        {
            await foreach (int x in Items()) total += x;
            total += (int)Packed.Add8(Packed.FromBits(1UL), Packed.FromBits(0UL)).Bits;
        }
        return total;
    }

    static int Main() => Sum().Result;
}
