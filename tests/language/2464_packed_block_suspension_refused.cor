// test: an await foreach inside a packed block is refused, as an await is
// expect-compile-error: an await foreach inside a packed block (using (Packed.Mmx())): the thread's packed state is the block's until it ends, and a suspension would hand it to whatever ran next
// A packed block owns the thread's x87 and MMX state until it ends; a
// suspension in it would leave that state to whatever the thread ran next.
// An await using and an await foreach suspend as an await does, and are
// statements the expression's refusal never saw.

using System;
using System.Collections.Generic;
using System.Threading.Tasks;

static class Program
{
    static async IAsyncEnumerable<int> Items()
    {
        await Task.Yield();
        yield return 1;
    }

    static async Task<int> Sum()
    {
        int total = 0;
        using (Packed.Mmx())
        {
            await foreach (int x in Items()) total += x;
        }
        return total;
    }

    static int Main() => Sum().Result;
}
