// test: tuple_value_semantics
// expect-exit: 0
// expect-output:
// (1, a) (99, a)
// (0, 0) 0
// (0, ) (5, ) 3
// (1, v1);(2, v2);(3, c)
// 10 False
// True True True True
// (1, a) True False
// False (4, 5) 5
// ab -1
//
// Tuples are values, as System.ValueTuple is: a copy is its own, default is
// zeros, a new array holds zero tuples, == compares element-wise, and Equals,
// GetHashCode and CompareTo are ValueTuple's -- which is what sorting, a
// dictionary key and a boxed tuple rely on. Expected output is real .NET's.

using System;
using System.Collections.Generic;
using System.Linq;
static class Program
{
    static (int, string) Make(int n) => (n, "v" + n);
    static void Main()
    {
        var a = (1, "a");
        var b = a;
        b.Item1 = 99;
        Console.WriteLine(a + " " + b);
        (int X, int Y) d = default;
        Console.WriteLine(d + " " + d.X);
        var arr = new (int, string)[3];
        arr[1].Item1 = 5;
        Console.WriteLine(arr[0] + " " + arr[1] + " " + arr.Length);
        var list = new List<(int, string)> { Make(2), Make(1), (3, "c") };
        list.Sort();
        Console.WriteLine(string.Join(";", list));
        var dict = new Dictionary<(int, string), int> { [(1, "a")] = 10 };
        Console.WriteLine(dict[(1, "a")] + " " + dict.ContainsKey((1, "b")));
        Console.WriteLine(((1, "a") == (1, "a")) + " " + (a != b) + " " + a.Equals((1, "a")) + " " + (a.GetHashCode() == (1, "a").GetHashCode()));
        object boxed = a;
        Console.WriteLine(boxed + " " + boxed.Equals((1, "a")) + " " + boxed.Equals((1, "b")));
        (int, int)? maybe = null;
        (int, int)? some = (4, 5);
        Console.WriteLine(maybe.HasValue + " " + some + " " + some.Value.Item2);
        var pairs = new[] { (2, 'b'), (1, 'a') }.OrderBy(p => p).Select(p => p.Item2);
        Console.WriteLine(string.Join("", pairs) + " " + a.CompareTo((1, "b")));
    }
}
