// test: iterator_returning_a_qualified_sequence
// expect-exit: 0
// expect-output:
// 3 2 6 2 1
// 1 1
//
// An iterator whose return type is named through its namespace,
// `System.Collections.Generic.IEnumerable<int>` and IEnumerator<int>, with
// no using -- a method's and a local function's -- or through an alias of
// it, or the rest of it inside namespace System, is an iterator as the
// bare name's is -- and so the non-generic IEnumerable, through an alias
// of System.Collections or `Collections.` inside namespace System. It was
// refused: a method using 'yield return' must return IEnumerable<T>.
using G = System.Collections.Generic;
using C = System.Collections;

namespace System.Mine
{
    static class Part
    {
        public static Collections.Generic.IEnumerable<int> One() { yield return 1; }
        public static Collections.IEnumerable Plain() { yield return "a"; }
    }
}

static class Program
{
    static G.IEnumerable<int> Aliased() { yield return 1; yield return 1; }
    static C.IEnumerator Objects() { yield return "b"; }

    static System.Collections.Generic.IEnumerable<int> Up(int n)
    {
        for (int i = 1; i <= n; i++) yield return i;
    }

    static System.Collections.Generic.IEnumerator<int> Two()
    {
        yield return 1;
        yield return 1;
    }

    static int Main()
    {
        System.Collections.Generic.IEnumerable<int> Local() { yield return 6; }
        int count = 0;
        foreach (int x in Up(3)) count++;
        System.Collections.Generic.IEnumerator<int> two = Two();
        int seen = 0;
        while (two.MoveNext()) seen += two.Current;
        int local = 0;
        foreach (int x in Local()) local += x;
        int aliased = 0;
        foreach (int x in Aliased()) aliased += x;
        int part = 0;
        foreach (int x in System.Mine.Part.One()) part += x;
        System.Console.WriteLine(count + " " + seen + " " + local + " " + aliased + " " + part);
        int plain = 0;
        foreach (object o in System.Mine.Part.Plain()) plain++;
        C.IEnumerator objects = Objects();
        int counted = 0;
        while (objects.MoveNext()) counted++;
        System.Console.WriteLine(plain + " " + counted);
        return 0;
    }
}
