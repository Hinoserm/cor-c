// test: iterator_returning_a_qualified_sequence
// expect-exit: 0
// expect-output:
// 3 2 6
//
// An iterator whose return type is named through its namespace,
// `System.Collections.Generic.IEnumerable<int>` and IEnumerator<int>, with
// no using -- a method's and a local function's -- is an iterator as the
// bare name's is. It was refused: a method using 'yield return' must
// return IEnumerable<T>.

static class Program
{
    static System.Collections.Generic.IEnumerable<int> Up(int n)
    {
        for (int i = 1; i <= n; i++) yield return i;
    }

    static System.Collections.Generic.IEnumerator<int> Two()
    {
        yield return 1;
        yield return 1;
    }

    static int Main()
    {
        System.Collections.Generic.IEnumerable<int> Local() { yield return 6; }
        int count = 0;
        foreach (int x in Up(3)) count++;
        System.Collections.Generic.IEnumerator<int> two = Two();
        int seen = 0;
        while (two.MoveNext()) seen += two.Current;
        int local = 0;
        foreach (int x in Local()) local += x;
        System.Console.WriteLine(count + " " + seen + " " + local);
        return 0;
    }
}
