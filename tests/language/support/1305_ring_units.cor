// The other unit of 1305_region_unified_fields_apart_across_units: a ring
// of 301 functions, each handing its arguments to the next, the last
// storing the leaking object into one field of the holder and the local
// into another, and going round again while depth remains: one cycle, past
// the size the escape graphs solve by inclusion, so it is unified.
using System;
using System.Runtime.CompilerServices;

namespace RingUnits;

public sealed class Local
{
    public int V;

    public Local(int v) { V = v; }
}

public sealed class Holder
{
    public object? Kept;
    public Local? Mine;
}

public static class Ring
{
    // Where the leaking object goes: anything may read it.
    public static object? Sink;

    [MethodImpl(MethodImplOptions.NoInlining)]
    public static int R0(Holder h, object leak, Local mine, int depth) => R1(h, leak, mine, depth);

