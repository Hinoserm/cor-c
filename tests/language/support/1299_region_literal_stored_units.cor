// The other unit of 1299_region_literal_stored_is_no_escape_across_units:
// a record and a ring of 310 functions that call each other round, each
// storing a string literal, the answer of a type test and a type into the
// record it is handed. A cycle this large is solved by unification
// (RegionEscape.Unified), where a symbol's address taken for the unknown
// object joined every field it was stored into to the global class.
using System;
using System.Runtime.CompilerServices;

public sealed class Leaf
{
    public readonly int Value;
    public Leaf(int value) { Value = value; }
}

public sealed class Record
{
    public string Name = "";
    public string Kind = "";
    public Type? Tag;
    public object? Child;
}

public static class Ring
{
    // A boundary: the record and its child are made here and dead at the
    // return, whatever the ring stored into the record.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static int Build(int seed)
    {
        Record r = new();
        r.Child = new Leaf(seed);
        F0(r, 320);
        return r.Name.Length + r.Kind.Length + ((Leaf)r.Child).Value + (r.Tag == typeof(Record) ? 0 : 100);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    internal static void F0(Record r, int depth)
    {
        r.Name = "n0";
        r.Kind = r.Child is Leaf ? "leaf" : "node";
        r.Tag = typeof(Record);
        if (depth > 0) F1(r, depth - 1);
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    internal static void F1(Record r, int depth)
    {
        r.Name = "n1";
        r.Kind = r.Child is Leaf ? "leaf" : "node";
        r.Tag = typeof(Record);
        if (depth > 0) F2(r, depth - 1);
    }
