// The other unit of 2051_linq_consumer_caller_keeps_across_units: walks
// keeping nothing of the list they are handed, and one keeping its second
// argument.
using System.Collections.Generic;
using System.Linq;

public static class Lent
{
    public static List<int>? Second;

    public static int Odd(List<int> l)
    {
        int t = 0;
        foreach (int x in l.Where(x => x % 2 != 0)) t += x;
        return t;
    }

    public static int Tripled(List<int> l) => l.Select(x => x * 3).Sum();

    public static int Pair(List<int> walked, List<int> kept)
    {
        Second = kept;
        return walked.Where(x => x > 0).Count();
    }
}
