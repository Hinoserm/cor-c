// The other unit of 1291_region_operands_emitted_into_kept_list_across_units:
// an instruction selector's shapes. An instruction owns a list of operands,
// filled from the params array it was made with; a builder's helpers make
// immediates and temporaries and emit instructions into the block it is in
// (this._cur, found through a dictionary of block heads); the function is
// handed back, and a pass after replaces operands in place.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

public abstract class MOperand
{
    public abstract long Weight { get; }
}

public sealed class MReg : MOperand
{
    public readonly int Id;
    public MReg(int id) { Id = id; }
    public override long Weight => Id;
}

public sealed class MImm : MOperand
{
    public readonly long Value;
    public readonly string? Symbol;
    public MImm(long value, string? symbol = null) { Value = value; Symbol = symbol; }
    public override long Weight => Value + (Symbol is null ? 0 : Symbol.Length);
}

public sealed class MInstr
{
    public int Op { get; init; }
    public List<MOperand> Operands { get; } = new();
    public int Width { get; init; } = 4;
    public int Line { get; set; }

    public MInstr(int op, params MOperand[] operands)
    {
        Op = op;
        Operands.AddRange(operands);
    }
}

public sealed class Block
{
    public string Name { get; }
    public List<MInstr> Instrs { get; } = new();
    public Block(string name) => Name = name;
}

public sealed class Function
{
    public readonly List<Block> Blocks = new();
    public int NextReg = 1;
    // What the builder saw as it emitted, in numbers: checked after the
    // function's region, if it had one, is long over.
    public long Instructions, Imms, ImmWeight, RegWeight, Replacement;

    public MReg NewReg() => new(NextReg++);

    public Block NewBlock(string name)
    {
        Block b = new(name);
        Blocks.Add(b);
        return b;
    }
}

public sealed class Builder
{
    private readonly Function _m = new();
    private readonly Dictionary<int, Block> _heads = new();
    private readonly Dictionary<int, MReg> _lo = new();
    private Block _cur = null!;
    private int _line;

    private static readonly MReg Ecx = new(-3);

    private Builder() { }

    // The function and nothing else is handed back: everything it holds
    // outlives this call, as the selector's MFunction does.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static Function Run(int seed, int length)
    {
        Builder b = new();
        b.Select(seed, length);
        return b._m;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private void Select(int seed, int length)
    {
        for (int h = 0; h < 3; h++) _heads[h] = _m.NewBlock("b" + h);
        for (int j = 0; j < length; j++)
        {
            _cur = _heads[j % 3];
            _line = j + 1;
            switch ((seed + j) % 4)
            {
                case 0: ByteSwapWord(Lo(j)); break;
                case 1: BitOrAlu(7, Lo(j), Lo(j + 1), Imm(j + 1)); break;
                case 2: EmitCl(9, Lo(j), (j & 1) == 0 ? null : Lo(j + 2)); break;
                default: Commit(j, Temp()); break;
            }
        }
    }

    // ---- emission, as Selector's ---------------------------------------------

    private MInstr Emit(MInstr i)
    {
        i.Line = _line;
        _cur.Instrs.Add(i);
        Count(i);
        return i;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private MInstr Emit(int op, params MOperand[] ops) => Emit(new MInstr(op, ops));

    private MReg Temp() => _m.NewReg();

    private static MImm Imm(long v) => new(v);

    private void Mov(MOperand dst, MOperand src) => Emit(1, dst, src);

    private MReg Lo(int v)
    {
        if (!_lo.TryGetValue(v, out MReg? r))
        {
            r = _m.NewReg();
            _lo[v] = r;
        }
        return r;
    }

    // The builder's own account, in numbers only.
    private void Count(MInstr i)
    {
        _m.Instructions++;
        foreach (MOperand o in i.Operands)
        {
            if (o is MImm imm)
            {
                _m.Imms++;
                _m.ImmWeight += imm.Weight;
                _m.Replacement += 1000 + (imm.Value & 0xff);
            }
            else _m.RegWeight += o.Weight;
        }
    }

    // ---- the helpers the site dump named -------------------------------------

    [MethodImpl(MethodImplOptions.NoInlining)]
    private void ByteSwapWord(MReg value)
    {
        MReg other = Temp(); Mov(other, value);
        Emit(2, value, Imm(8)); Emit(3, value, Imm(unchecked((int)0xff00ff00)));
        Emit(4, other, Imm(8)); Emit(3, other, Imm(0x00ff00ff));
        Emit(5, value, other); Emit(6, value, Imm(16));
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private void BitOrAlu(int op, MReg dest, MOperand left, MOperand right)
    {
        if (right is MImm imm && imm.Symbol == null && imm.Value == 0) { Mov(dest, left); return; }
        Mov(dest, left);
        Emit(op, dest, right);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private void EmitCl(int op, MReg dest, MReg? src = null)
    {
        if (src is null) Emit(op, dest, Ecx);
        else Emit(op, dest, src, Ecx);
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    private void Commit(int v, MReg temp)
    {
        Mov(Lo(v), temp);
        Mov(temp, new MImm(v, "s" + v));
    }
}

// ---- after selection: a pass that replaces operands in place ------------------

public static class Peephole
{
    /// Every immediate becomes a register, written over the old element in
    /// the instruction's own list (the selector's operands go so in the
    /// compiler's own peephole, and an owned list frees what it drops). True
    /// when what is read agrees with what the builder counted.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static bool Run(Function f)
    {
        long instructions = 0, imms = 0, immWeight = 0, regWeight = 0, after = 0;
        foreach (Block b in f.Blocks)
            foreach (MInstr i in b.Instrs)
            {
                instructions++;
                for (int k = 0; k < i.Operands.Count; k++)
                {
                    MOperand old = i.Operands[k];
                    if (old is MImm imm)
                    {
                        imms++;
                        immWeight += imm.Weight;
                        i.Operands[k] = new MReg(1000 + (int)(imm.Value & 0xff));
                    }
                    else regWeight += old.Weight;
                }
                foreach (MOperand o in i.Operands) after += o.Weight;
            }
        return instructions == f.Instructions && imms == f.Imms && immWeight == f.ImmWeight
            && regWeight == f.RegWeight && after == f.RegWeight + f.Replacement;
    }
}
