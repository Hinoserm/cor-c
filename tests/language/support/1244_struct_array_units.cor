// The unit 1244 calls into: an array of (int, Tok) tuples read back.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
namespace TupUnits;
public sealed class Tok { public int A; public Tok(int a) { A = a; } }
public static class W
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static long Work(int n)
    {
        List<(int At, Tok Was)> marks = new();
        for (int i = 0; i < n; i++) marks.Add((i, new Tok(i)));
        long s = 0;
        for (int k = 0; k < marks.Count; k++) { (int at, Tok was) = marks[k]; s += at + was.A; }
        return s;
    }
}
