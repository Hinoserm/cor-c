// The other unit of 1263_region_recursive_return_across_units: a recursive
// search whose deepest activation makes the answer and every activation
// above hands it up, beside scratch each activation makes and drops.
using System.Runtime.CompilerServices;

public sealed class Answer
{
    public readonly int[] Path;
    public readonly string Text;
    public Answer? Inner;

    public Answer(int[] path, string text) { Path = path; Text = text; }
}

public static class Search
{
    // A boundary at every level: the answer is made where depth reaches
    // zero and returned through every activation above it. Every third
    // level wraps what it got in an Answer of its own, so the result is a
    // chain of objects made at different depths.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static Answer Find(int depth, int seed, int[] trail)
    {
        int[] scratch = new int[trail.Length + 1];
        for (int i = 0; i < trail.Length; i++) scratch[i] = trail[i];
        scratch[trail.Length] = seed + depth;
        if (depth == 0) return new Answer(scratch, "leaf" + seed);
        Answer below = Find(depth - 1, seed, scratch);
        if (depth % 3 != 0) return below;
        Answer wrap = new(new int[] { depth, seed }, "wrap" + depth);
        wrap.Inner = below;
        return wrap;
    }
}
