// A unit of 1603_partial_class_parts_in_separate_units: Math.Min(long, int)
// and Math.Max(long, long), with parts of Ledger and Tally that call the
// other units' private members and keep fields the other units read.

using System;

static partial class Ledger
{
    public static long Piece(long count, long done)
    {
        long piece = Math.Min(count - done, 0x1000);
        return piece + Twice(1) - Lines();
    }
    static long Third(long x) { return x * 3; }
}

partial class Tally
{
    long last;
    int count = 1;
    public void Add(long value) { last = Math.Max(value, first); count++; }
}
