// test: lap_region_frame_list_freed_where_the_lap_ends
// expect-exit: 0
// expect-output:
// laps 500500 bad 0
//
// A frame object with a clean owned list, made every lap of a loop region;
// on odd laps a probe list is made before it, in the lap's region, where the
// last lap's list was. The probe must keep its contents to the lap's end.
using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

sealed class Holder
{
    public List<int> Items = new List<int>();
    public int Sum() { int s = 0; for (int i = 0; i < Items.Count; i++) s += Items[i]; return s; }
}

static class P
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Fill(List<int> l, int lap, int n) { for (int k = 0; k < n; k++) l.Add(lap * 100 + k); }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Check(List<int> l, int lap, int n)
    {
        if (l.Count != n) return 1;
        for (int k = 0; k < n; k++) if (l[k] != lap * 100 + k) return 1;
        return 0;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Laps(int laps)
    {
        long sum = 0; int bad = 0;
        for (int lap = 0; lap < laps; lap++)
        {
            List<int>? probe = null;
            if ((lap & 1) == 1) { probe = new List<int>(); Fill(probe, lap, 6); }
            Holder h = new Holder();
            h.Items.Add(lap); h.Items.Add(1);
            sum += h.Sum();
            if (probe != null) bad += Check(probe, lap, 6);
        }
        return sum * 1000 + bad;
    }

    static void Main()
    {
        long r = Laps(1000);
        Console.WriteLine("laps " + (r / 1000) + " bad " + (r % 1000));
    }
}
