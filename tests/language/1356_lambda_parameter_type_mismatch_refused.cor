// test: lambda parameter type mismatch refused
// expect-compile-error: parameter 1 of the lambda is declared 'long'
// A lambda's written parameter types are the delegate's exactly: a long is
// no int, however an int would convert to one (CS1678).

using System;

public static class Program
{
    public static int Main()
    {
        Func<int, int> f = (long x) => (int)x;
        Console.WriteLine(f(1));
        return 0;
    }
}
