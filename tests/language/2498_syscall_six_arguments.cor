// test: a six-argument system call, its arguments from the frame
// expect-exit: 0
// only-target: x86
// expect-output:
// mapped
// woke 0
// refused -22
//
// The sixth argument goes to EBP for the trap; read from a parameter, it
// had no register while the other six held the number and five arguments.
// futex(FUTEX_WAKE_BITSET) reads the sixth as its bit set: zero is refused
// (EINVAL), any other wakes nobody (0), so a lost or wrong sixth argument shows.
using System.Runtime.CompilerServices;

static class Program
{
    static uint _bits = 0xFFFFFFFF;

    [MethodImpl(MethodImplOptions.NoInlining)]
    static long Call(int n, SyscallWord a = 0, SyscallWord b = 0, SyscallWord c = 0, SyscallWord d = 0, SyscallWord e = 0, SyscallWord f = 0)
    {
        return (long)(int)Sys.Syscall(n, a, b, c, d, e, f);
    }

    static int Main()
    {
        // mmap2(0, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        long at = Call(192, 0, 4096, 3, 0x22, unchecked((SyscallWord)(-1)), 0);
        if (at < 0 && at > -4096) return 1;
        System.Console.WriteLine("mapped");
        // futex(at, FUTEX_WAKE_BITSET, 1, 0, 0, bits)
        System.Console.WriteLine("woke " + Call(240, (SyscallWord)at, 10, 1, 0, 0, _bits));
        System.Console.WriteLine("refused " + Call(240, (SyscallWord)at, 10, 1, 0, 0, 0));
        return 0;
    }
}
