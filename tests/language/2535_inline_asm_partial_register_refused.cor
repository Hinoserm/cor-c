// test: inline_asm_partial_register_refused
// only-target: x86
// expect-compile-error: this reads eax, which the block has set only part of
//
// A 32-bit read of a register the block set only a byte of: the rest holds
// nothing of the method's (docs/INLINE-ASSEMBLY.md).
static class Program
{
    static int Main()
    {
        int r;
        asm
        {
            mov al, 1
            mov r, eax
        }
        return r;
    }
}
