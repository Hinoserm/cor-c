// expect-exit: 0
using System;

static class RuntimeCompareBytesTest
{
    static int Reference(string a, int aAt, string b, int bAt, int count)
    {
        for (int i = 0; i < count; i++)
        {
            int x = Sys.GetByte(a, aAt + i), y = Sys.GetByte(b, bAt + i);
            if (x != y) return x < y ? -1 : 1;
        }
        return 0;
    }

    static int Main()
    {
        string a = new string('x', 40), b = new string('x', 40);
        for (int aAt = 0; aAt < 4; aAt++)
        for (int bAt = 0; bAt < 4; bAt++)
        for (int count = 0; count <= 33; count++)
        {
            for (int i = 0; i < 40; i++) { Sys.SetByte(a, i, 0x55); Sys.SetByte(b, i, 0x55); }
            for (int i = 0; i < count; i++)
            {
                int value = (i * 37 + 128) & 255;
                Sys.SetByte(a, aAt + i, value); Sys.SetByte(b, bAt + i, value);
            }
            // A difference immediately outside the requested range is ignored.
            Sys.SetByte(b, bAt + count, 0xaa);
            if (Sys.CompareBytes(a, aAt, b, bAt, count) != 0) return 1;
            for (int at = 0; at < count; at++)
            {
                int saved = Sys.GetByte(b, bAt + at);
                Sys.SetByte(b, bAt + at, saved ^ 255);
                if (Sys.CompareBytes(a, aAt, b, bAt, count) != Reference(a, aAt, b, bAt, count)) return 2;
                if (Sys.CompareBytes(b, bAt, a, aAt, count) != Reference(b, bAt, a, aAt, count)) return 3;
                Sys.SetByte(b, bAt + at, saved);
            }
        }
        return 0;
    }
}
