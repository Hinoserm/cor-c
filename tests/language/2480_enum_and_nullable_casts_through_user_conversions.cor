// test: an enum casts to decimal through its underlying type, and a cast to or from a nullable goes through a user-defined conversion lifted
// expect-exit: 0
// expect-output:
// 300 300 2 2 null
// 7 null 7 Big7 null Big7
// 9 1
// empty throws
// 300 Big4 300 2
// 3 3 3.75 null 4
// True:True 7 7.5 7 null
// whole -1 1
// 1002 2.5
// 5 5
// 7.5 7
// 300 300
// Low Low High
// N5
// 77 77
// throws null null 2
//
// C# 10.3.3: an enum's explicit conversion to decimal is its underlying
// type's, `(decimal)level` is `(decimal)(short)level` -- with no implicit
// conversion from an enum to a number, decimal's operators took none of it,
// and the enum's word went on as a reference (NullReferenceException).
// C# 10.6.2: a user-defined conversion to T? is the operator's T wrapped
// (`(decimal?)300` came out null, `(Big?)s` a value from the struct's
// padding), and one from S? is lifted: the operator on the value, empty
// where it is empty to a T?, InvalidOperationException to a T. The operand
// is evaluated once. The operator taken is the one for the type asked, among
// operators that differ only in what they make; one declared on S? itself
// takes the nullable whole, empty included. To a T? the operator to T is as
// exact (`(int?)300m` decimal's operator to int, not its first, to byte);
// with none exact, the most encompassing result (`(long)w` through
// operators to byte and int, the one to int); a narrower result widened
// (`(long)n` through an operator to int); a decimal? to an enum through the
// enum's number; and a reference result from S? the operator on the value,
// null where it is empty.

using System;

enum Level : short { Low = 2, High = 300 }

struct Big
{
    public int V;
    public static implicit operator Big(short x) => new Big { V = x };
    public override string ToString() => "Big" + V;
}

struct Node
{
    public double V;
    public static explicit operator Node(bool b) => new Node { V = b ? 1 : 0 };
    public static explicit operator bool(Node n) => n.V != 0;
    public static explicit operator int(Node n) => (int)n.V;
    public static explicit operator double(Node n) => n.V;
    public override string ToString() => "Node:" + V;
}

struct S2
{
    public double V;
    public static explicit operator decimal(S2 s) => (decimal)s.V;
    public static explicit operator int(S2 s) => (int)s.V + 1000;
}

struct N
{
    public int V;
    public static explicit operator int(N n) => n.V;
    public static explicit operator string(N n) => "N" + n.V;
}

struct W
{
    public int V;
    public static explicit operator byte(W w) => (byte)(w.V & 0xFF);
    public static explicit operator int(W w) => w.V;
}

struct Whole
{
    public static explicit operator int(Whole? w) => w.HasValue ? 1 : -1;
}

class Program
{
    static string S(object? o) => o == null ? "null" : o.ToString()!;
    static int calls;
    static short? Next() { calls++; return 9; }

    static int Main()
    {
        Level? some = Level.Low; Level? none = null; Level lv = Level.High;
        short? sn = 7; short? snull = null;
        Console.WriteLine(S((decimal)lv) + " " + S((decimal?)lv) + " " + S((decimal)some) + " " + S((decimal?)some) + " " + S((decimal?)none));
        Console.WriteLine(S((decimal?)sn) + " " + S((decimal?)snull) + " " + S((decimal)sn) + " " + S((Big?)sn) + " " + S((Big?)snull) + " " + S((Big)sn));
        Console.WriteLine(S((decimal?)Next()) + " " + calls);
        try { decimal bad = (decimal)none; Console.WriteLine("no throw " + bad); }
        catch (InvalidOperationException) { Console.WriteLine("empty throws"); }
        Console.WriteLine(S((decimal?)300) + " " + S((Big?)(short)4) + " " + S((double?)lv) + " " + S((decimal)Level.Low));
        decimal? dn = 3.75m; decimal? dnull = null;
        Console.WriteLine(S((int)dn) + " " + S((long)dn) + " " + S((double)dn) + " " + S((int?)dnull) + " " + S((int?)(decimal?)4.5m));
        Node? nd = new Node { V = 7.5 }; Node? ndnull = null;
        Console.WriteLine(S((bool)nd) + ":" + ((bool)nd) + " " + S((int)nd) + " " + S((double?)nd) + " " + S((int?)nd) + " " + S((double?)ndnull));
        Whole? wnull = null; Whole? wsome = new Whole();
        Console.WriteLine("whole " + (int)wnull + " " + (int)wsome);
        S2? sx = new S2 { V = 2.5 };
        N? nn = new N { V = 5 };
        Node node = new Node { V = 7.5 };
        decimal? two = 2m; decimal big = 300m;
        Console.WriteLine(S((int?)sx) + " " + S((decimal?)sx));
        Console.WriteLine(S((long)nn) + " " + S((long?)nn));
        Console.WriteLine(S((double?)node) + " " + S((int?)node));
        Console.WriteLine(S((int?)big) + " " + S((long?)big));
        Console.WriteLine(S((Level)two) + " " + S((Level?)two) + " " + S((Level?)big));
        Console.WriteLine(S((string)nn));
        W w = new W { V = 333 };
        Console.WriteLine(S((long)w - 256) + " " + S(((long?)w).Value - 256));
        N? nnull = null; decimal? dtwo = 2m;
        string a, c;
        try { a = S((Level)dnull); } catch (InvalidOperationException) { a = "throws"; }
        try { c = S((string)nnull); } catch (InvalidOperationException) { c = "throws"; }
        Console.WriteLine(a + " " + S((Level?)dnull) + " " + c + " " + S((int)(Level?)dtwo));
        return 0;
    }
}
