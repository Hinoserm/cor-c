// test: custom numeric format strings -- "0.00", "#,##0", "000", "0%"
// expect-exit: 0
// expect-output:
// [1.0][1.3][0.5][-2.3][1234567.9][0.0][0.0]  <- 0.0
// [1.00][1.25][0.50][-2.35][1234567.89][0.00][0.00]  <- 0.00
// [1][1][1][-2][1,234,568][0][0]  <- #,##0
// [001][001][001][-002][1234568][000][000]  <- 000
// [1][1.25][.5][-2.35][1234567.89][][]  <- #.##
// [1][1.25][0.5][-2.345][1234567.891][0][0.004]  <- 0.###
// [1.00][1.25][0.50][-2.35][1,234,567.89][0.00][0.00]  <- #,##0.00
// [1][1][1][-2][1234568][][]  <- #
// [100%][125%][50%][-235%][123456789%][0%][0%]  <- 0%
// [100.0%][125.0%][50.0%][-234.5%][123456789.1%][0.0%][0.4%]  <- 0.0%
// [1.00][1.25][.50][-2.35][1234567.89][.00][.00]  <- .00
// [1.0][1.25][0.5][-2.345][1234567.891][0.0][0.004]  <- ##0.0##
// [000][005][-042][1234567]  <- 000
// [0][5][-42][1,234,567]  <- #,##0
// [0.00][5.00][-42.00][1234567.00]  <- 0.00
// [][5][-42][1234567]  <- #
// 3 -0 1,234.6
// ||12|(12)|zero
// [abc][(1234)][12 34]
//
// The OTHER grammar of .NET's ToString: not a letter naming a shape but the
// shape itself, a digit at a time. `0` always prints and so pads; `#` prints
// only if there is a digit and so trims; everything else is itself, which is
// what makes "0;(0);zero" write an accountant's negative and "0%" multiply by
// a hundred. Every line was taken from the same program run on .NET against
// the invariant culture.

class Program
{
    static double[] Numbers()
    {
        return new double[] { 1.0, 1.25, 0.5, -2.345, 1234567.891, 0.0, 0.004 };
    }

    static void Row(string format)
    {
        double[] values = Numbers();
        string line = "";

        for (int i = 0; i < values.Length; i++) { line = line + "[" + values[i].ToString(format) + "]"; }
        Console.WriteLine(line + "  <- " + format);
    }

    static int Main()
    {
        string[] pictures = new string[] { "0.0", "0.00", "#,##0", "000", "#.##", "0.###",
                                           "#,##0.00", "#", "0%", "0.0%", ".00", "##0.0##" };
        for (int i = 0; i < pictures.Length; i++) { Row(pictures[i]); }

        long[] whole = new long[] { 0, 5, -42, 1234567 };
        string[] forWhole = new string[] { "000", "#,##0", "0.00", "#" };

        for (int f = 0; f < forWhole.Length; f++)
        {
            string line = "";

            for (int i = 0; i < whole.Length; i++) { line = line + "[" + whole[i].ToString(forWhole[f]) + "]"; }
            Console.WriteLine(line + "  <- " + forWhole[f]);
        }

        Console.WriteLine((2.5).ToString("0") + " " + (-0.4).ToString("0") + " " + (1234.5678).ToString("#,##0.0"));
        Console.WriteLine((0.0).ToString("#") + "|" + (0.0).ToString("#.##") + "|" + (12.0).ToString("0;(0);zero")
            + "|" + (-12.0).ToString("0;(0);zero") + "|" + (0.0).ToString("0;(0);zero"));
        Console.WriteLine("[" + (5L).ToString("abc") + "][" + (1234.0).ToString("(0)") + "][" + (1234.0).ToString("00 00") + "]");
        return 0;
    }
}
