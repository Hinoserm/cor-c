// test: expr_bodied_indexer
// expect-exit: 0
// expect-output:
// 20
// 4
// 7
// 30
//
// An expression-bodied indexer, `public int this[int i] => data[i];`, is a
// getter and nothing else -- the same shape an expression-bodied property has.
// The property form was understood where members are dispatched, which an
// indexer never reaches, so it was refused with "expected '{' to open the
// property". Expression-bodied accessors inside the braces are checked here
// too, since they share the shape.

class Row {
    int[] data = new int[] { 20, 21, 22, 23 };
    int stored;

    public int this[int i] => data[i];
    public int Count => data.Length;
    public int Stored { get => stored; set => stored = value; }
}

class Program {
    static int Main() {
        Row r = new Row();

        Console.WriteLine(r[0]);
        Console.WriteLine(r.Count);

        r.Stored = 7;
        Console.WriteLine(r.Stored);

        Console.WriteLine(r[0] + r.Count + r.Stored - 1);
        return 0;
    }
}
