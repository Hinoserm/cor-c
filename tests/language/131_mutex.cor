// test: mutex
// expect-exit: 0
// expect-output:
// free True
// trylock while held False
// total 40000
// balanced True
//
// .NET's Mutex under contention: four threads each take it with WaitOne and
// add to two plain (non-atomic) fields, which only comes out right if the
// mutex really excludes. The second field counts down, so the two must
// cancel exactly. Whether it is held is what another thread's WaitOne(0)
// says: the owner's own would take it again, a mutex being recursive.

using System;
using System.Threading;

class Ledger
{
    public int Total;
    public int Mirror;
}

class Adder
{
    Mutex _lock;
    Ledger _ledger;
    int _times;

    public Adder(Mutex l, Ledger ledger, int times)
    {
        _lock = l;
        _ledger = ledger;
        _times = times;
    }

    public void Run()
    {
        for (int i = 0; i < _times; i++)
        {
            _lock.WaitOne();
            _ledger.Total = _ledger.Total + 1;
            _ledger.Mirror = _ledger.Mirror - 1;
            _lock.ReleaseMutex();
        }
    }
}

static class Program
{
    /// Whether a thread other than this one can take the mutex now.
    static bool FreeElsewhere(Mutex m)
    {
        bool took = false;
        Thread other = new Thread(() =>
        {
            took = m.WaitOne(0);
            if (took)
            {
                m.ReleaseMutex();
            }
        });
        other.Start();
        other.Join();
        return took;
    }

    static int Main()
    {
        Mutex m = new Mutex();

        Console.WriteLine("free " + FreeElsewhere(m));

        m.WaitOne();
        Console.WriteLine("trylock while held " + FreeElsewhere(m));
        m.ReleaseMutex();

        Ledger ledger = new Ledger();
        int threads = 4;
        int each = 10000;

        Thread[] all = new Thread[threads];

        for (int i = 0; i < threads; i++)
        {
            all[i] = new Thread(new Adder(m, ledger, each).Run);
            all[i].Start();
        }

        for (int i = 0; i < threads; i++)
        {
            all[i].Join();
        }

        Console.WriteLine("total " + ledger.Total);
        Console.WriteLine("balanced " + (ledger.Total + ledger.Mirror == 0));
        return 0;
    }
}
