// test: shared_generic_relay_across_units
// units: tests/language/support/1525_shared_generic_relay_across_units_units.cor
// expect-exit: 0
// expect-output:
// relay ok True
//
// An iterator and its list handed to the other unit's relay, which keeps
// them through a sink reached by an interface call a shared generic copy
// makes.
using System;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.CompilerServices;

static class P
{
    static List<int> Make(int n, int b) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(b + i); return l; }

    [MethodImpl(MethodImplOptions.NoInlining)] static int F(int b) { List<int> l = Make(9, b); return Hub.Pass(l.Select(x => x * 2)); }
    [MethodImpl(MethodImplOptions.NoInlining)] static int G(int b) { List<int> l = Make(9, b); return l.Select(x => x * 3).Sum(); }

    static void Main()
    {
        int b = 0;
        for (int k = 0; k < 300; k++) { b = 100 * k; F(b); }
        long t = 0;
        for (int k = 0; k < 20000; k++) t += G(-1000000) + Make(9, -1000000).Count + Make(6, -1000000).Count;
        Gc.Collect();
        for (int k = 0; k < 20000; k++) t += G(-1000000) + Make(9, -1000000).Count;
        int want = 2 * (9 * b + 36);
        int got = KeepSink.Kept!.Sum();
        Console.WriteLine("relay " + (got == want ? "ok" : "BAD " + got + " want " + want) + " " + (t != 0));
    }
}
