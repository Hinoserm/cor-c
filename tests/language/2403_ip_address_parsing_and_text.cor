// [2001::1] 2001::1 InterNetworkV6 20-01-00-00-00-00-00-00-00-00-00-00-00-00-00-01 scope=0 ll=False sl=False mc=False teredo=True ula=False mapped=False loop=False v4=0.0.0.1 v6=2001::1
