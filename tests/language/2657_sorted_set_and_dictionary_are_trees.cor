// test: sorted_set_and_dictionary_are_trees
// expect-exit: 0
// expect-output:
// 1321 1321 1324057 1324057 9693 8372 0
// 1 1999
// 642 642 500 1500
// 1216 537 True False False True
// 1216 0
// 600,603,604,606,607,610,611,612,613,615,617,618,620,627,628,629,631,632,634,639,640,642,645,646,648,649,652,653,655,656,657,659,661,663,666,668,670,673,674,675,676,680,681,682,688,689,691,692,695,696,697,698,699
// 1163 484 0
// 0 0 0 0
// 3,6,9,99
// 1,3,4,6,9,99 True True
// 3000 633 633 1971 True False 0
// An item with the same key has already been added. Key: [k1, 5]
// moved
//
// SortedSet is a red-black tree in two arrays, and SortedDictionary a tree
// set of its pairs by key, as .NET's: 40,000 random adds and removes checked
// against a presence array (order, count, answers), views and views of
// views, Reverse, every member removed in a scrambled order (each removal
// case of the tree), the set operations, and a map counted and thinned.
// Output from .NET 10 (probe ~/tmp/dn/rbtree).

using System;
using System.Collections.Generic;

static class Program
{
    static uint seed = 12345;
    static int Next(int bound) { seed = seed * 1103515245u + 12345u; return (int)((seed >> 8) % (uint)bound); }

    static int Main()
    {
        const int Range = 2000;
        var set = new SortedSet<int>();
        var there = new bool[Range];
        int adds = 0, removes = 0, bad = 0;
        for (int step = 0; step < 40000; step++)
        {
            int v = Next(Range);
            if (Next(3) != 0) { if (set.Add(v) != !there[v]) bad++; if (!there[v]) adds++; there[v] = true; }
            else { if (set.Remove(v) != there[v]) bad++; if (there[v]) removes++; there[v] = false; }
            if (step % 4000 == 0)
            {
                int expect = 0, prev = -1;
                foreach (int x in set) { if (x <= prev || !there[x]) bad++; prev = x; expect++; }
                if (expect != set.Count) bad++;
            }
        }
        int count = 0; long sum = 0;
        for (int i = 0; i < Range; i++) if (there[i]) { count++; sum += i; }
        long walked = 0; foreach (int x in set) walked += x;
        Console.WriteLine($"{set.Count} {count} {sum} {walked} {adds} {removes} {bad}");
        Console.WriteLine($"{set.Min} {set.Max}");
        var view = set.GetViewBetween(500, 1500);
        int inView = 0; for (int i = 500; i <= 1500; i++) if (there[i]) inView++;
        Console.WriteLine($"{view.Count} {inView} {view.Min} {view.Max}");
        view.Add(1000); view.Remove(1001); view.RemoveWhere(x => x % 7 == 0);
        Console.WriteLine($"{set.Count} {view.Count} {set.Contains(1000)} {set.Contains(1001)} {set.Contains(707)} {set.Contains(7)}");
        int r = 0, last = int.MaxValue; foreach (int x in set.Reverse()) { if (x >= last) bad++; last = x; r++; }
        Console.WriteLine($"{r} {bad}");
        var inner = view.GetViewBetween(600, 700);
        Console.WriteLine(string.Join(",", inner));
        inner.Clear();
        Console.WriteLine($"{set.Count} {view.Count} {inner.Count}");
        // Everything out again, in a scrambled order.
        var all = new List<int>(set);
        for (int i = all.Count - 1; i > 0; i--) { int j = Next(i + 1); (all[i], all[j]) = (all[j], all[i]); }
        foreach (int x in all) if (!set.Remove(x)) bad++;
        Console.WriteLine($"{set.Count} {bad} {set.Min} {set.Max}");
        for (int i = 0; i < 50; i++) set.Add(i * 3);
        set.IntersectWith(new[] { 3, 6, 9, 10, 99 });
        Console.WriteLine(string.Join(",", set));
        set.UnionWith(new SortedSet<int> { 1, 2, 3 });
        set.SymmetricExceptWith(new[] { 2, 4 });
        Console.WriteLine(string.Join(",", set) + " " + set.SetEquals(new[] { 99, 1, 3, 4, 6, 9 }) + " " + set.IsSubsetOf(new[] { 1, 3, 4, 6, 9, 99, 100 }));

        var map = new SortedDictionary<string, int>(StringComparer.Ordinal);
        for (int i = 0; i < 3000; i++) { string k = "k" + Next(1000); map[k] = map.TryGetValue(k, out int c) ? c + 1 : 1; }
        int total = 0; string prevKey = ""; foreach (var p in map) { if (string.CompareOrdinal(p.Key, prevKey) <= 0) bad++; prevKey = p.Key; total += p.Value; }
        for (int i = 0; i < 1000; i += 3) map.Remove("k" + i);
        int keys = 0; foreach (string k in map.Keys) keys++;
        int values = 0; foreach (int v in map.Values) values += v;
        Console.WriteLine($"{total} {map.Count} {keys} {values} {map.ContainsKey("k1")} {map.ContainsKey("k3")} {bad}");
        try { map.Add("k1", 5); } catch (ArgumentException e) { Console.WriteLine(e.Message); }
        try { foreach (var p in map) map["k2"] = 0; } catch (InvalidOperationException) { Console.WriteLine("moved"); }
        return 0;
    }
}
