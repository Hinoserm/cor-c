// test: HashSet's set operations take out and add in .NET's order, so later members fill the same places
// expect-exit: 0
// expect-output:
// intersect empty 7,8,9
// intersect set 2,8,4,7
// intersect list 2,8,4,7
// intersect self 1,2,3
// except self 0
// except 1,5,3,6
// symmetric list 1,3,4
// symmetric set 1,4,3
// symmetric empty 4,2
// symmetric dups 1,3,7,8
// symmetric refill 1,11,3,10
//
// .NET's IntersectWith clears for an empty collection, asks another set
// compared alike of each member in entry order, and else marks what the
// other holds and takes the rest out in entry order; ExceptWith of the set
// itself clears; SymmetricExceptWith of anything but a set compared alike
// adds every new member first, then takes out the marked originals in
// entry order. The order of the removals is the order the freed places are
// reused in, so what is added after came out in another order here.
using System;
using System.Collections.Generic;

static class Program
{
    static string Show(HashSet<int> s) => string.Join(",", s);

    static int Main()
    {
        var a = new HashSet<int> { 1, 2, 3 };
        a.IntersectWith(new List<int>());
        a.Add(7); a.Add(8); a.Add(9);
        Console.WriteLine("intersect empty " + Show(a));

        var b = new HashSet<int> { 1, 2, 3, 4, 5 };
        b.IntersectWith(new HashSet<int> { 4, 2 });
        b.Add(7); b.Add(8);
        Console.WriteLine("intersect set " + Show(b));

        var c = new HashSet<int> { 1, 2, 3, 4, 5 };
        c.IntersectWith(new List<int> { 4, 2, 9 });
        c.Add(7); c.Add(8);
        Console.WriteLine("intersect list " + Show(c));

        var d = new HashSet<int> { 1, 2, 3 };
        d.IntersectWith(d);
        Console.WriteLine("intersect self " + Show(d));
        d.ExceptWith(d);
        Console.WriteLine("except self " + d.Count);

        var e = new HashSet<int> { 1, 2, 3, 4 };
        e.ExceptWith(new[] { 4, 2 });
        e.Add(5); e.Add(6);
        Console.WriteLine("except " + Show(e));

        var f = new HashSet<int> { 1, 2, 3 };
        f.SymmetricExceptWith(new List<int> { 2, 4 });
        Console.WriteLine("symmetric list " + Show(f));

        var g = new HashSet<int> { 1, 2, 3 };
        g.SymmetricExceptWith(new HashSet<int> { 2, 4 });
        Console.WriteLine("symmetric set " + Show(g));

        var h = new HashSet<int>();
        h.SymmetricExceptWith(new[] { 4, 2, 4 });
        Console.WriteLine("symmetric empty " + Show(h));

        var i = new HashSet<int> { 1, 2, 3, 5 };
        i.SymmetricExceptWith(new[] { 5, 7, 2, 5, 7, 8 });
        Console.WriteLine("symmetric dups " + Show(i));

        var j = new HashSet<int> { 1, 2, 3, 4 };
        j.SymmetricExceptWith(new[] { 4, 2 });
        j.Add(10); j.Add(11);
        Console.WriteLine("symmetric refill " + Show(j));
        return 0;
    }
}
