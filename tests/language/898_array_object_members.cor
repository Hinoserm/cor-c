// test: array_object_members
// expect-exit: 0
// expect-output:
// System.Int32[] System.Byte[] System.String[] True True False System.Int32[] Int32[]
//
// An array is an object and answers object's ToString, Equals and
// GetHashCode, as C#'s arrays inherit them from System.Array: asked as the
// object it is. Output checked against .NET.

using System;
static class Program
{
    static void Main()
    {
        int[] a = { 1 }; byte[] b = new byte[2]; string[] s = { "x" };
        object o = a;
        Console.WriteLine(a.ToString() + " " + b.ToString() + " " + s.ToString() + " " + (a.GetHashCode() == a.GetHashCode()) + " " + a.Equals(a) + " " + a.Equals(b) + " " + o.ToString() + " " + a.GetType().Name);
    }
}
