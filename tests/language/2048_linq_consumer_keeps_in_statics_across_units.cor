// test: linq_consumer_keeps_in_statics_across_units
// units: tests/language/support/2048_keeper_units.cor
// expect-exit: 0
// expect-output:
// control odd 100000 True
// list 15000 -3,-2,-1,0,1,2,3,4,5
// lazy 5000 1,2,3,4,5
// test 8000 True False
// view 9000 -3,-2,-1,0,1,2,3,4,5
//
// What another unit's LINQ consumer keeps past the call in statics of its
// own: the list, the iterator Where made of it, a predicate capturing it, a
// read-only view of it (2043 keeps an enumerator). Each is handed a list a
// function here made and drops, a thousand times; the last one kept is read
// after blocks of its shape were made again. The first line is the same
// image freeing a list a walk keeps nowhere: the rules are on, and keep these.

using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

static class P
{
    static List<int> Make(int n) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(i - 3); return l; }

    // What each call left to the collector, and whether the program gave
    // memory back itself meanwhile: frees, or a region's end (1211's measure).
    static string Measure(Func<int, int> f, out long total)
    {
        const int N = 20000;
        total = 0;
        Gc.Collect();
        long taken = Gc.CollectedBytes, frees = Gc.Frees, region = Gc.RegionFreedBytes + Gc.RegionTopFreedBytes;
        for (int k = 0; k < N; k++) total += f(9);
        bool given = Gc.Frees - frees >= N || Gc.RegionFreedBytes + Gc.RegionTopFreedBytes - region >= N * 16;
        Gc.Collect();
        long left = (Gc.CollectedBytes - taken) / N;
        return given && left <= 32 ? "True" : "False " + left;
    }

    static void Say(string name, Func<int, int> f)
    {
        string freed = Measure(f, out long total);
        Console.WriteLine(name + " " + total + " " + freed);
    }

    static List<int> MakeAt(int n, int at) { List<int> l = new(); for (int i = 0; i < n; i++) l.Add(at + i); return l; }

    // WHAT A BLOCK FREED TOO SOON BECOMES: lists of the kept ones' shape and
    // arrays of their arrays' sizes, other numbers in them, made and held while
    // the kept ones are read. Under verified frees such a block is poisoned
    // instead, and a second free ends the run.
    static readonly List<int>[] JunkLists = new List<int>[4096];
    static readonly int[][] JunkArrays = new int[4096][];

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Churn()
    {
        for (int k = 0; k < JunkLists.Length; k++)
        {
            JunkLists[k] = MakeAt(9, 100);
            JunkArrays[k] = new int[k % 2 == 0 ? 16 : 9];
            JunkArrays[k][0] = 100;
        }
        Gc.Collect();
    }

    // A thousand calls, their results added: the last call's object is the one read afterwards.
    static long Rounds(Func<int, int> f) { long t = 0; for (int k = 0; k < 1000; k++) t += f(9); return t; }

    static string Show(IEnumerable<int>? s) => s is null ? "null" : string.Join(",", s);

    static string Rest(IEnumerator<int> e) { string s = ""; while (e.MoveNext()) s += (s.Length > 0 ? "," : "") + e.Current; return s; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Odd(int n) => Keepers.Odd(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int HandList(int n) => Keepers.KeepList(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int HandLazy(int n) => Keepers.KeepLazy(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int HandTest(int n) => Keepers.KeepTest(Make(n));
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int HandView(int n) => Keepers.KeepView(Make(n));

    static void Main()
    {
        Say("control odd", Odd);
        long list = Rounds(HandList), lazy = Rounds(HandLazy), test = Rounds(HandTest), view = Rounds(HandView);
        Churn();
        Console.WriteLine("list " + list + " " + Show(Keepers.KeptList));
        Console.WriteLine("lazy " + lazy + " " + Show(Keepers.KeptLazy));
        Console.WriteLine("test " + test + " " + Keepers.KeptTest!(4) + " " + Keepers.KeptTest!(5));
        Console.WriteLine("view " + view + " " + Show(Keepers.KeptView));
    }
}
