        Show("IOException", () => new IOException(), () => new IOException((string?)null), () => new IOException(""), () => new IOException((string?)null, new Exception("i")));
        Show("JsonException", () => new JsonException(), () => new JsonException((string?)null), () => new JsonException(""), () => new JsonException((string?)null, new Exception("i")));
        Show("KeyNotFoundException", () => new KeyNotFoundException(), () => new KeyNotFoundException((string?)null), () => new KeyNotFoundException(""), () => new KeyNotFoundException((string?)null, new Exception("i")));
        Show("MemberAccessException", () => new MemberAccessException(), () => new MemberAccessException((string?)null), () => new MemberAccessException(""), () => new MemberAccessException((string?)null, new Exception("i")));
        Show("MissingMemberException", () => new MissingMemberException(), () => new MissingMemberException((string?)null), () => new MissingMemberException(""), () => new MissingMemberException((string?)null, new Exception("i")));
        Show("MissingMethodException", () => new MissingMethodException(), () => new MissingMethodException((string?)null), () => new MissingMethodException(""), () => new MissingMethodException((string?)null, new Exception("i")));
