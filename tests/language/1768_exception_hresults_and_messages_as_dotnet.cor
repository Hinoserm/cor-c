// (null,"") 0x80131621 [Could not load file or assembly ''. Could not find or load a specific file. (0x80131621)] file  log (none) :: System.IO.FileLoadException: Could not load file or assembly ''. Could not find or load a specific file. (0x80131621)
// string object int long
// True x
//
// EVERY EXCEPTION TYPE'S HRESULT AND MESSAGE, as .NET 10's: no message at all is
// the type's own sentence (or Exception's "Exception of type ... was thrown."
// where .NET has none), an empty one stays empty, and HResult is the type's
// COR_E_ code from the moment it is made. ExternalException's code is its
// HResult; Win32Exception says strerror's words, a negative number an "Unknown
// error"; FileLoadException with no message names the file in .NET's sentence.
// A CONSTRUCTOR WHOSE PARAMETERS ARE THE MORE SPECIFIC WINS where as many
// arguments match exactly: `new SwitchExpressionException("")` is the (string?
// message) one, not the (object? unmatchedValue) declared before it.

using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.IO;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using System.Xml;

static class Program
{
    static string One(Func<Exception>? make)
    {
        if (make == null) return "-";
        Exception e = make();
        string? m = e.Message;
        return "0x" + e.HResult.ToString("X8") + " [" + (m == null ? "<null>" : m.Replace("\n", "|")) + "]";
    }

    static void Show(string name, Func<Exception>? none, Func<Exception> nul, Func<Exception> empty, Func<Exception> inner)
    {
        Console.WriteLine(name + " () " + One(none) + " (null) " + One(nul) + " (\"\") " + One(empty) + " (null, inner) " + One(inner));
    }

    static void External(string what, Exception e)
    {
        string code = e is ExternalException x ? " code 0x" + x.ErrorCode.ToString("X8") : "";
        string native = e is Win32Exception w ? " native " + w.NativeErrorCode : "";
        Console.WriteLine(what + " 0x" + e.HResult.ToString("X8") + code + native + " [" + e.Message + "]");
    }

    static void Load(string what, FileLoadException e)
    {
        Console.WriteLine(what + " 0x" + e.HResult.ToString("X8") + " [" + e.Message + "] file " + (e.FileName ?? "(none)") + " log " + (e.FusionLog ?? "(none)") + " :: " + e.ToString().Replace("\n", "|"));
    }

    static void Main()
    {
        Show("AbandonedMutexException", () => new AbandonedMutexException(), () => new AbandonedMutexException((string?)null), () => new AbandonedMutexException(""), () => new AbandonedMutexException((string?)null, new Exception("i")));
        Show("AggregateException", () => new AggregateException(), () => new AggregateException((string?)null), () => new AggregateException(""), () => new AggregateException((string?)null, new Exception("i")));
        Show("ApplicationException", () => new ApplicationException(), () => new ApplicationException((string?)null), () => new ApplicationException(""), () => new ApplicationException((string?)null, new Exception("i")));
        Show("ArgumentException", () => new ArgumentException(), () => new ArgumentException((string?)null), () => new ArgumentException(""), () => new ArgumentException((string?)null, new Exception("i")));
        Show("ArgumentNullException", () => new ArgumentNullException(), () => new ArgumentNullException((string?)null), () => new ArgumentNullException(""), () => new ArgumentNullException((string?)null, new Exception("i")));
        Show("ArgumentOutOfRangeException", () => new ArgumentOutOfRangeException(), () => new ArgumentOutOfRangeException((string?)null), () => new ArgumentOutOfRangeException(""), () => new ArgumentOutOfRangeException((string?)null, new Exception("i")));
        Show("ArithmeticException", () => new ArithmeticException(), () => new ArithmeticException((string?)null), () => new ArithmeticException(""), () => new ArithmeticException((string?)null, new Exception("i")));
        Show("ArrayTypeMismatchException", () => new ArrayTypeMismatchException(), () => new ArrayTypeMismatchException((string?)null), () => new ArrayTypeMismatchException(""), () => new ArrayTypeMismatchException((string?)null, new Exception("i")));
        Show("COMException", () => new COMException(), () => new COMException((string?)null), () => new COMException(""), () => new COMException((string?)null, new Exception("i")));
        Show("CryptographicException", () => new CryptographicException(), () => new CryptographicException((string?)null), () => new CryptographicException(""), () => new CryptographicException((string?)null, new Exception("i")));
        Show("DecoderFallbackException", () => new DecoderFallbackException(), () => new DecoderFallbackException((string?)null), () => new DecoderFallbackException(""), () => new DecoderFallbackException((string?)null, new Exception("i")));
        Show("DirectoryNotFoundException", () => new DirectoryNotFoundException(), () => new DirectoryNotFoundException((string?)null), () => new DirectoryNotFoundException(""), () => new DirectoryNotFoundException((string?)null, new Exception("i")));
        Show("DivideByZeroException", () => new DivideByZeroException(), () => new DivideByZeroException((string?)null), () => new DivideByZeroException(""), () => new DivideByZeroException((string?)null, new Exception("i")));
        Show("DuplicateWaitObjectException", () => new DuplicateWaitObjectException(), () => new DuplicateWaitObjectException((string?)null), () => new DuplicateWaitObjectException(""), () => new DuplicateWaitObjectException((string?)null, new Exception("i")));
        Show("EncoderFallbackException", () => new EncoderFallbackException(), () => new EncoderFallbackException((string?)null), () => new EncoderFallbackException(""), () => new EncoderFallbackException((string?)null, new Exception("i")));
        Show("EndOfStreamException", () => new EndOfStreamException(), () => new EndOfStreamException((string?)null), () => new EndOfStreamException(""), () => new EndOfStreamException((string?)null, new Exception("i")));
        Show("ExternalException", () => new ExternalException(), () => new ExternalException((string?)null), () => new ExternalException(""), () => new ExternalException((string?)null, new Exception("i")));
        Show("FileLoadException", () => new FileLoadException(), () => new FileLoadException((string?)null), () => new FileLoadException(""), () => new FileLoadException((string?)null, new Exception("i")));
        Show("FileNotFoundException", () => new FileNotFoundException(), () => new FileNotFoundException((string?)null), () => new FileNotFoundException(""), () => new FileNotFoundException((string?)null, new Exception("i")));
        Show("FormatException", () => new FormatException(), () => new FormatException((string?)null), () => new FormatException(""), () => new FormatException((string?)null, new Exception("i")));
        Show("IndexOutOfRangeException", () => new IndexOutOfRangeException(), () => new IndexOutOfRangeException((string?)null), () => new IndexOutOfRangeException(""), () => new IndexOutOfRangeException((string?)null, new Exception("i")));
        Show("InternalBufferOverflowException", () => new InternalBufferOverflowException(), () => new InternalBufferOverflowException((string?)null), () => new InternalBufferOverflowException(""), () => new InternalBufferOverflowException((string?)null, new Exception("i")));
        Show("InvalidCastException", () => new InvalidCastException(), () => new InvalidCastException((string?)null), () => new InvalidCastException(""), () => new InvalidCastException((string?)null, new Exception("i")));
        Show("InvalidComObjectException", () => new InvalidComObjectException(), () => new InvalidComObjectException((string?)null), () => new InvalidComObjectException(""), () => new InvalidComObjectException((string?)null, new Exception("i")));
        Show("InvalidDataException", () => new InvalidDataException(), () => new InvalidDataException((string?)null), () => new InvalidDataException(""), () => new InvalidDataException((string?)null, new Exception("i")));
        Show("InvalidOperationException", () => new InvalidOperationException(), () => new InvalidOperationException((string?)null), () => new InvalidOperationException(""), () => new InvalidOperationException((string?)null, new Exception("i")));
