        Show("TimeoutException", () => new TimeoutException(), () => new TimeoutException((string?)null), () => new TimeoutException(""), () => new TimeoutException((string?)null, new Exception("i")));
        Show("TimeZoneNotFoundException", () => new TimeZoneNotFoundException(), () => new TimeZoneNotFoundException((string?)null), () => new TimeZoneNotFoundException(""), () => new TimeZoneNotFoundException((string?)null, new Exception("i")));
        Show("UnauthorizedAccessException", () => new UnauthorizedAccessException(), () => new UnauthorizedAccessException((string?)null), () => new UnauthorizedAccessException(""), () => new UnauthorizedAccessException((string?)null, new Exception("i")));
        Show("XmlException", () => new XmlException(), () => new XmlException((string?)null), () => new XmlException(""), () => new XmlException((string?)null, new Exception("i")));
        Show("Exception", () => new Exception(), () => new Exception((string?)null), () => new Exception(""), () => new Exception((string?)null, new Exception("i")));
        Show("WaitHandleCannotBeOpenedException", () => new WaitHandleCannotBeOpenedException(), () => new WaitHandleCannotBeOpenedException((string?)null), () => new WaitHandleCannotBeOpenedException(""), () => new WaitHandleCannotBeOpenedException((string?)null, new Exception("i")));
        Show("Win32Exception", () => new Win32Exception(), () => new Win32Exception((string?)null), () => new Win32Exception(""), () => new Win32Exception((string?)null, new Exception("i")));
        Show("ObjectDisposedException", null, () => new ObjectDisposedException((string?)null), () => new ObjectDisposedException(""), () => new ObjectDisposedException((string?)null, new Exception("i")));

        External("ext(null,5)", new ExternalException(null, 5));
        External("ext(s,5)", new ExternalException("s", 5));
        External("com(null,5)", new COMException(null, 5));
        External("com(s,5)", new COMException("s", 5));
        External("w32(2)", new Win32Exception(2));
        External("w32(2,s)", new Win32Exception(2, "s"));
        External("w32(2,null)", new Win32Exception(2, null));
        External("w32(0)", new Win32Exception(0));
        External("w32(-1)", new Win32Exception(-1));
        External("w32(9999)", new Win32Exception(9999));
        Load("()", new FileLoadException());
        Load("(m)", new FileLoadException("m"));
        Load("(null,f)", new FileLoadException(null, "f"));
        Load("(m,f)", new FileLoadException("m", "f"));
        Load("(null,f,inner)", new FileLoadException(null, "f", new Exception("i")));
        Load("(null,\"\")", new FileLoadException(null, ""));
        Console.WriteLine(new Picked("text").Said + " " + new Picked((object)"text").Said + " " + new Picked(3).Said + " " + new Picked(3L).Said);
        Console.WriteLine((new SwitchExpressionException("").UnmatchedValue == null) + " " + new SwitchExpressionException((object)"x").UnmatchedValue);
    }
}

// THE CONSTRUCTOR WHOSE PARAMETERS ARE THE MORE SPECIFIC, as C# picks it:
// declared after the wider one, and still the one a string argument takes.
class Picked
{
    public readonly string Said;
    public Picked(object? value) { Said = "object"; }
    public Picked(long value) { Said = "long"; }
    public Picked(string? value) { Said = "string"; }
    public Picked(int value) { Said = "int"; }
}

