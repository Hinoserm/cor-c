// test: Queue<T> and Stack<T> are the non-generic ICollection as .NET's are: their count, their CopyTo into any array with each one's refusals and names, and Count() reads them without walking
// expect-exit: 0
// expect-output:
// 4 3 False False True True
// _,3,4,5,6,_
// c,b,a,_
// 3,4,5,6
// c,b,a
// exactly full: copied
// empty at the end: copied
// queue null: ArgumentNullException array
// stack null: ArgumentNullException array
// queue negative: ArgumentOutOfRangeException index
// stack negative: ArgumentOutOfRangeException arrayIndex
// queue past: ArgumentOutOfRangeException index
// stack past: ArgumentOutOfRangeException arrayIndex
// queue short: ArgumentException -
// stack short: ArgumentException -
// queue rank: ArgumentException array
// stack rank: ArgumentException array
// queue type: ArgumentException -
// stack type: ArgumentException array
// stack widened: copied
// queue widened: copied
// queue mixed: InvalidCastException
// after: x,_
// stack mixed: InvalidCastException
// after: _,_
// queue boxed long into int[]: InvalidCastException
// stack boxed int into long[]: InvalidCastException
// queue 1 and null into int[]: InvalidCastException
// after: 1,8
// queue 1 and null into int?[]: copied
// after: 1,_
// queue boxed enum into int[]: InvalidCastException
// queue boxed char into ushort[]: InvalidCastException
// queue boxed int into DayOfWeek[]: InvalidCastException
// after: Friday
// queue boxed long into int?[]: InvalidCastException
// 4 3 2 True
//
// Expected output from .NET 10. Queue and Stack name the index differently
// (index and arrayIndex), and only Stack names the array when an element type
// cannot be stored. A copy refused partway keeps what was copied before it, and
// Stack copies bottom first before turning the run over. Core.cor reads the
// count through the interface, so it names no type of Collections.cor, which a
// freestanding build leaves out.

using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;

static class Program {
    static string Show(object?[] a) { string r = ""; for (int i = 0; i < a.Length; i++) { if (i > 0) r += ","; r += a[i] == null ? "_" : a[i]!.ToString(); } return r; }

    static void Try(string what, Action act) {
        try { act(); Console.WriteLine(what + ": copied"); }
        catch (ArgumentException e) { Console.WriteLine(what + ": " + e.GetType().Name + " " + (e.ParamName ?? "-")); }
        catch (Exception e) { Console.WriteLine(what + ": " + e.GetType().Name); }
    }

    static int Main() {
        Queue<int> q = new Queue<int>();
        for (int i = 1; i <= 4; i++) { q.Enqueue(i); }
        q.Dequeue(); q.Dequeue(); q.Enqueue(5); q.Enqueue(6);
        Stack<string> s = new Stack<string>();
        s.Push("a"); s.Push("b"); s.Push("c");
        ICollection qc = q;
        ICollection sc = s;
        Console.WriteLine(qc.Count + " " + sc.Count + " " + qc.IsSynchronized + " " + sc.IsSynchronized + " " + ReferenceEquals(qc.SyncRoot, q) + " " + ReferenceEquals(sc.SyncRoot, s));
        object?[] o = new object?[6]; qc.CopyTo(o, 1); Console.WriteLine(Show(o));
        o = new object?[4]; sc.CopyTo(o, 0); Console.WriteLine(Show(o));
        int[] ints = new int[4]; qc.CopyTo(ints, 0); Console.WriteLine(string.Join(",", ints));
        string[] strs = new string[3]; sc.CopyTo(strs, 0); Console.WriteLine(string.Join(",", strs));
        qc.CopyTo(new object[4], 0); sc.CopyTo(new object[3], 0);
        Console.WriteLine("exactly full: copied");
        new Queue<int>().ToArray(); ((ICollection)new Stack<int>()).CopyTo(new int[0], 0);
        Console.WriteLine("empty at the end: copied");
        Try("queue null", () => qc.CopyTo(null!, 0));
        Try("stack null", () => sc.CopyTo(null!, 0));
        Try("queue negative", () => qc.CopyTo(new object[4], -1));
        Try("stack negative", () => sc.CopyTo(new object[3], -1));
        Try("queue past", () => qc.CopyTo(new object[3], 4));
        Try("stack past", () => sc.CopyTo(new object[3], 4));
        Try("queue short", () => qc.CopyTo(new object[4], 1));
        Try("stack short", () => sc.CopyTo(new object[3], 1));
        Try("queue rank", () => qc.CopyTo(new object[2, 2], 0));
        Try("stack rank", () => sc.CopyTo(new object[2, 2], 0));
        Try("queue type", () => qc.CopyTo(new string[4], 0));
        Stack<int> numbers = new Stack<int>(); numbers.Push(1); numbers.Push(2);
        Try("stack type", () => ((ICollection)numbers).CopyTo(new string[2], 0));
        Try("stack widened", () => ((ICollection)numbers).CopyTo(new long[2], 0));
        Try("queue widened", () => qc.CopyTo(new double[4], 0));
        Queue<object> mixed = new Queue<object>(); mixed.Enqueue("x"); mixed.Enqueue(1);
        Stack<object> mixedStack = new Stack<object>(); mixedStack.Push(1); mixedStack.Push("y");
        string[] into = new string[2];
        Try("queue mixed", () => ((ICollection)mixed).CopyTo(into, 0));
        Console.WriteLine("after: " + Show(into));
        into = new string[2];
        Try("stack mixed", () => ((ICollection)mixedStack).CopyTo(into, 0));
        Console.WriteLine("after: " + Show(into));
        Queue<object> boxedLong = new Queue<object>(); boxedLong.Enqueue(5L);
        Try("queue boxed long into int[]", () => ((ICollection)boxedLong).CopyTo(new int[1], 0));
        Stack<object> boxedInt = new Stack<object>(); boxedInt.Push(5);
        Try("stack boxed int into long[]", () => ((ICollection)boxedInt).CopyTo(new long[1], 0));
        Queue<object?> unboxed = new Queue<object?>(); unboxed.Enqueue(1); unboxed.Enqueue(null);
        int[] sevens = new int[] { 7, 8 };
        Try("queue 1 and null into int[]", () => ((ICollection)unboxed).CopyTo(sevens, 0));
        Console.WriteLine("after: " + sevens[0] + "," + sevens[1]);
        int?[] maybes = new int?[] { 7, 8 };
        Try("queue 1 and null into int?[]", () => ((ICollection)unboxed).CopyTo(maybes, 0));
        Console.WriteLine("after: " + maybes[0] + "," + (maybes[1] == null ? "_" : maybes[1].ToString()));
        Queue<object> day = new Queue<object>(); day.Enqueue(DayOfWeek.Monday);
        Try("queue boxed enum into int[]", () => ((ICollection)day).CopyTo(new int[1], 0));
        Queue<object> letter = new Queue<object>(); letter.Enqueue('a');
        Try("queue boxed char into ushort[]", () => ((ICollection)letter).CopyTo(new ushort[1], 0));
        Queue<object> two = new Queue<object>(); two.Enqueue(2);
        DayOfWeek[] days = new DayOfWeek[] { DayOfWeek.Friday };
        Try("queue boxed int into DayOfWeek[]", () => ((ICollection)two).CopyTo(days, 0));
        Console.WriteLine("after: " + days[0]);
        Queue<object> wide = new Queue<object>(); wide.Enqueue(5L);
        Try("queue boxed long into int?[]", () => ((ICollection)wide).CopyTo(new int?[1], 0));
        IEnumerable<int> asQueue = q;
        IEnumerable<string> asStack = s;
        Console.WriteLine(asQueue.Count() + " " + asStack.Count() + " " + asQueue.Count(x => x > 4) + " " + asStack.Contains("b"));
        return 0;
    }
}
