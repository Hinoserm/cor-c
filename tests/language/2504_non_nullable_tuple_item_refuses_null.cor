// test: a non-nullable tuple item or array element still refuses null
// expect-compile-error: is not nullable
//
// The other side of 2503: an assignment's target is its declared type, and a
// `(Backing, int)`'s item and a `Backing[]`'s element are declared without
// the `?`, so a null written to them is refused as C# refuses it.

#nullable enable

sealed class Backing { }

static class Program
{
    static int Main()
    {
        (Backing, int) t = (new Backing(), 1);
        t.Item1 = null;
        Backing[] all = { new Backing() };
        all[0] = null;
        return 0;
    }
}
