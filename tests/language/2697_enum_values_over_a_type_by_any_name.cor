// test: enum_values_over_a_type_by_any_name
// expect-exit: 0
// expect-output:
// Red;Green;Blue;
// Size[] 3 L Blue L
// True Blue 6
// Only:1:Only
//
// Enum.GetValues OVER A TYPE IN A VARIABLE, BY WHATEVER NAME THE PROGRAM
// CALLS IT: `using static System.Enum` and a bare GetValues, a method group
// held in a Func, an enum boxed only in a later function. The enum's box
// names its array's descriptor wherever that method is compiled
// (Lowering.SettleEnumArrays, at the end of lowering), not where its name
// was looked up, which `using static` went round. And IsDefined and GetName
// over typeof(E) with an argument that declares names (a pattern, an
// `out var`): the compiler's look at it takes them back (Binder.Peek). The
// answers are .NET 10's.
using System;
using static System.Enum;
enum Color { Red, Green = 5, Blue }
enum Size : byte { S = 1, M, L }
enum Late { Only = 9 }
static class P
{
    static Type Pick(int i) => i == 0 ? typeof(Color) : typeof(Size);
    static string Later(Type t) { object late = Late.Only; return late + ":" + GetValues(t).Length + ":" + GetValues(late.GetType()).GetValue(0); }
    static void Main()
    {
        object boxed = Color.Blue; object other = Size.L;
        foreach (object v in GetValues(Pick(0))) Console.Write(v + ";");
        Console.WriteLine();
        Func<Type, Array> f = GetValues;
        Array a = f(Pick(1));
        Console.WriteLine(a.GetType().Name + " " + a.Length + " " + a.GetValue(2) + " " + boxed + " " + other);
        object o = 5;
        Console.WriteLine(Enum.IsDefined(typeof(Color), o is int n ? n : 0) + " " + Enum.GetName(typeof(Color), int.TryParse("6", out var k) ? k : 0) + " " + k);
        Console.WriteLine(Later(typeof(Late)));
    }
}
