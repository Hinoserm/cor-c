// test: ref_conditional_types_must_match
// expect-compile-error: CS8173
// A ref conditional's arms are one variable or the other, so they must be of
// one type: Roslyn refuses int against long with CS8173.

using System;
static class Program
{
    static void Main()
    {
        int a = 1; long b = 2; bool c = true;
        ref int r = ref (c ? ref a : ref b);
        Console.WriteLine(r);
    }
}
