// test: base_statics_through_derived_across_units
// units: tests/language/support/915_builder_units.cor
// expect-exit: 0
// expect-output:
// items 1 7
//
// Test 932 in a unit of its own.

using System;
using System.Collections.Generic;
abstract class Base
{
    static readonly List<int> None = new() { 7 };
    List<int>? _items;
    public List<int> Items => _items ?? None;
}
sealed class Derived : Base { public int X; }
public static class Program
{
    public static int Main()
    {
        Derived d = new() { X = 1 };
        Console.WriteLine(d.Items is null ? "null" : "items " + d.Items.Count + " " + d.Items[0]);
        return 0;
    }
}
