// test: select_consumed_across_units
// units: tests/language/support/915_builder_units.cor
// expect-exit: 0
// expect-output:
// 5001550000
//
// Select's iterator made, then walked by ToArray and ToList, in a unit that
// does not hold the library. Select comes in (its iterator is what it
// makes), then the List built from it (it calls GetEnumerator on what its
// caller just made); the three iterator kinds Select can make are one
// group, each owned; the calls on them are guarded by type, and the
// ICollection<T> calls none of them can take are not their escape.

using System;
using System.Collections.Generic;
using System.Linq;
sealed class R { public int V; public R(int v) { V = v; } }
static class P
{
    static int Work(List<R> xs, int k)
    {
        int[] mapped = xs.Select(x => x.V + k).ToArray();
        List<int> listed = xs.Select(x => x.V * k).ToList();
        return mapped.Length + listed.Count + mapped[0];
    }
    static void Main()
    {
        List<R> xs = new();
        for (int i = 0; i < 8; i++) xs.Add(new R(i));
        long t = 0;
        for (int k = 0; k < 100000; k++) t += Work(xs, k);
        Console.WriteLine(t);
    }
}
