// test: enums
// expect-exit: 0
// expect-output:
// values 0 5 6
// compare True True
// switch green red blue
// cast True
// list 3 11
// field 5
//
// Enums: implicit and explicit member values, comparison, switch on an
// enum, casting from an int, enums in a List, and an enum-typed field.

// NOT CALLED COLOR, deliberately. The standard library is compiled
// from source alongside every test, and System.Drawing declares a
// Color of its own. A type of that name in the GLOBAL namespace is found
// before a using-directive of the compilation unit -- C#'s own lookup
// order -- so it captures the name inside System.Windows.Forms too, and
// the library stops compiling. Nothing here is about Colors.
enum Hue
{
    Red,
    Green = 5,
    Blue,
}

class Pixel
{
    public Hue Tint;
}

static class Program
{
    static void Line(string s)
    {
        Sys.Print(s);
        Sys.PrintLine();
    }

    static string Name(Hue c)
    {
        switch (c)
        {
            case Hue.Red: return "red";
            case Hue.Green: return "green";
            case Hue.Blue: return "blue";
            default: return "?";
        }
    }

    static int Main()
    {
        Line("values " + (int)Hue.Red + " " + (int)Hue.Green + " " + (int)Hue.Blue);

        Hue c = Hue.Green;
        Line("compare " + (c == Hue.Green) + " " + (c != Hue.Red));
        Line("switch " + Name(c) + " " + Name(Hue.Red) + " " + Name(Hue.Blue));

        int six = 6;
        Hue fromInt = (Hue)six;
        Line("cast " + (fromInt == Hue.Blue));

        List<Hue> all = new List<Hue>();
        all.Add(Hue.Red);
        all.Add(Hue.Green);
        all.Add(Hue.Blue);
        int sum = 0;
        foreach (Hue k in all)
        {
            sum += (int)k;
        }
        Line("list " + all.Count + " " + sum);

        Pixel p = new Pixel();
        p.Tint = Hue.Green;
        Line("field " + (int)p.Tint);
        return 0;
    }
}
