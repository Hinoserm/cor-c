// test: filter_keeps_and_declines
// expect-exit: 0
// expect-output:
// 6722 6723 1000 0 True
//
// A filter keeps what it was shown and declines it: the exception goes on
// to the catch further out, which must not free it.
using System.Collections.Generic;

static class Program
{
    static List<System.Exception> kept = new List<System.Exception>(); static long total2;

    static bool Remember(System.Exception e, int k) { kept.Add(e); return (k & 2) != 0; }

    static void Inner(int k)
    {
        try { if ((k & 1) == 0) throw new System.InvalidOperationException("bad value " + k); }
        catch (System.Exception e) when (Remember(e, k)) { total2 += e.Message.Length; }
    }

    static int Main()
    {
        long total = 0;
        for (int k = 0; k < 2000; k++)
        {
            try { Inner(k); }
            catch (System.InvalidOperationException e) { total += e.Message.Length; }
        }
        long sum = 0;
        for (int k = 0; k < 4000; k++) { string s = "zzzz" + k + "qqqqqqqqqqqq"; sum += s.Length; }
        int bad = 0;
        for (int i = 0; i < kept.Count; i++)
            if (kept[i] is not System.InvalidOperationException || !kept[i].Message.StartsWith("bad value ")) bad++;
        System.Console.WriteLine(total + " " + total2 + " " + kept.Count + " " + bad + " " + (sum > 0));
        return 0;
    }
}
