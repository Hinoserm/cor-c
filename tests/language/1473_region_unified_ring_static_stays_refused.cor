// test: region_unified_ring_static_stays_refused
// expect-exit: 0
// expect-output:
// read 7000 kept 7 churn 1000
//
// A ring of 301 calls, past the cycle the escape engine solves by
// inclusion, is solved by unification. R0, at the bottom of each walk
// round the ring, makes a Node, keeps it in a static and hands it back:
// the Node is the ring's unknown object, and every member's summary
// hands it back as the unknown object, with no site. Read, outside the
// ring, reads it and drops it: nothing Read's own escape answer names
// outlives it. Made in Read's region, the kept Node would be given back
// with it and Churn's Nodes made over it. What a unified cycle's unknown
// object holds outlives every boundary.

using System;
using System.Runtime.CompilerServices;

public sealed class Node { public long V; public long W; }
public static class Kept { public static Node? Last; }

public static class Ring
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static Node R0(int d)
    {
        if (d <= 0) { Node n = new(); n.V = 7; Kept.Last = n; return n; }
        return R1(d - 1);
    }
    [MethodImpl(MethodImplOptions.NoInlining)] public static Node R1(int d) => R2(d - 1);
    [MethodImpl(MethodImplOptions.NoInlining)] public static Node R2(int d) => R3(d - 1);
    [MethodImpl(MethodImplOptions.NoInlining)] public static Node R3(int d) => R4(d - 1);
    [MethodImpl(MethodImplOptions.NoInlining)] public static Node R4(int d) => R5(d - 1);
