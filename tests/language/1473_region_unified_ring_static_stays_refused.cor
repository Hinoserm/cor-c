public static class B
{
    // The boundary outside the ring: the Node it is handed back is dropped.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static long Read() => Ring.R0(3).V;

    // Nodes made and dropped, in a region of their own, over the memory a
    // region of Read's gave back.
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static long Churn(int k)
    {
        long s = 0;
        for (int i = 0; i < 8; i++) { Node junk = new(); junk.V = 1000 + k; junk.W = i; s += junk.W; }
        return s == 28 ? 1 : 0;
    }
}

static class P
{
    static void Main()
    {
        long read = 0, churn = 0;
        for (int k = 0; k < 1000; k++) read += B.Read();
        for (int k = 0; k < 1000; k++) churn += B.Churn(k);
        Console.WriteLine("read " + read + " kept " + Kept.Last!.V + " churn " + churn);
    }
}
