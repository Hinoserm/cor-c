// test: switch_statement_unreachable_case_refused
// expect-compile-error: CS8120: The switch case is unreachable. It has already been handled by a previous case or it is impossible to match.
//
// C#'s CS8120: a case every value of which earlier cases took. `case 5:`
// after `case > 0:` can never be reached; it was compiled as dead code.

using System;

static class Program
{
    static int Sign(int x)
    {
        switch (x)
        {
            case > 0: return 1;
            case 5: return 2;
            default: return 3;
        }
    }

    static int Main()
    {
        Console.WriteLine(Sign(5));
        return 0;
    }
}
