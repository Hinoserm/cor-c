// test: large free-bin search, deletion, splitting, merging and sweep rebuilding
// expect-exit: 0
// expect-output:
// free tree passed
//
// The free index is a list per bin and a bitmap of the non-empty ones: a
// fit looks at no more than the first few blocks of its own bin (Gc.FitDepth)
// and otherwise takes the head of the next non-empty bin, so however many
// holes the heap has, a large request probes a handful of blocks at most.

using System;

// ROOTS THE COLLECTOR READS A WORD AT A TIME: a block with no descriptor,
// read as every such block is. An array of numbers is not read at all -- it
// holds no reference, as in .NET -- so raw addresses kept in a long[] kept
// nothing alive once that was so; these tests hold theirs here instead.
sealed class Roots
{
    readonly object _block;
    readonly nuint _at;

    public Roots(int count)
    {
        Length = (nuint)count;
        _at = Runtime.Alloc(count * 8);
        _block = Sys.ObjectAt(_at);
    }

    public nuint Length { get; }

    public nuint this[nuint i]
    {
        get { return Sys.ReadAddress(_at + i * 8); }
        set { Sys.WriteAddress(_at + i * 8, value); }
    }
}
static class Program
{
    static void Check(nuint stage)
    {
        if (Gc.CheckFreeIndex()) return;
        Sys.Print("free index failed stage=" + stage + " kind=" + Gc.FreeIndexErrorKind
            + " block=" + Gc.FreeIndexErrorBlock + "\n");
        throw new InvalidOperationException("free index invariant");
    }
    static int Main()
    {
        const int count = 512;
        Gc.SetLimit(134217728);
        Roots blocks = new Roots(count);
        Roots guards = new Roots(count);
        nuint large = Runtime.Alloc(60000);
        nuint largeGuard = Runtime.Alloc(64);
        for (nuint i = 0; i < count; i++)
        {
            blocks[i] = Runtime.Alloc(40000 + (int)(i % 7) * 8);
            // Stay below the dedicated-mapping threshold so this exercises
            // the free bins rather than immediate whole-chunk unmapping.
            guards[i] = Runtime.Alloc(64);
            Sys.WriteAddress(guards[i], i + 1);
        }
        Check(1);
        Runtime.Free((nint)large);
        for (nuint i = 0; i < count; i++)
        {
            nuint index = (i * 73) & (count - 1);
            Runtime.Free((nint)blocks[index]);
            blocks[index] = 0;
            if ((i & 31) == 31) Check(1000 + i);
        }
        long probes = Gc.ProbeSteps;
        large = Runtime.Alloc(50000);
        if (Gc.ProbeSteps - probes > 8)
        { Sys.Print("excessive free-index probes: " + (Gc.ProbeSteps - probes) + "\n"); return 1; }
        for (nuint i = 0; i + WordSize.Bytes <= 50000; i += WordSize.Bytes)
            if (Sys.ReadAddress(large + i) != 0) return 2;
        Check(2);
        for (nuint i = 0; i < count; i++)
        {
            blocks[i] = Runtime.Alloc(40000);
            if (Sys.ReadAddress(blocks[i]) != 0 || Sys.ReadAddress(blocks[i] + 40000 - WordSize.Bytes) != 0) return 3;
            Sys.WriteAddress(blocks[i], i + 1);
            if ((i & 31) == 31) Check(2000 + i);
        }
        Gc.Collect();
        Check(3);
        for (nuint i = 0; i < count; i++)
        {
            if (Sys.ReadAddress(guards[i]) != i + 1 || Sys.ReadAddress(blocks[i]) != i + 1) return 4;
            Runtime.Free((nint)guards[i]);
            guards[i] = 0;
        }
        Check(4);
        for (nuint i = 0; i < count; i++)
        {
            nuint index = (i * 173) & (count - 1);
            Runtime.Free((nint)blocks[index]);
            blocks[index] = 0;
            if ((i & 31) == 31) Check(3000 + i);
        }
        Runtime.Free((nint)large);
        Runtime.Free((nint)largeGuard);
        Gc.Collect();
        Check(5);
        Sys.Print("free tree passed\n");
        return 0;
    }
}
