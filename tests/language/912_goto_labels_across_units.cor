// test: goto_labels_across_units
// units: tests/language/support/912_goto_units.cor
// expect-exit: 0
// expect-output:
// 2
// -3
// 1
//
// A generic method with a goto and a label, compiled in another unit and
// specialised in this one: its body crosses in the declaration index (Gir),
// which carries GotoStmt and LabeledStmt.

using System;
using System.Collections.Generic;
static class P
{
    static void Main()
    {
        Console.WriteLine(LabelUnit.CountUntil(new List<int> { 4, 5, 6 }, 6));
        Console.WriteLine(LabelUnit.CountUntil(new List<string> { "a", "b", "c" }, "z"));
        Console.WriteLine(LabelUnit.CountUntil(new List<string> { "a", "b", "c" }, "b"));
    }
}
