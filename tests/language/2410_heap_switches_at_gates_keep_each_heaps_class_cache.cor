// test: heap switches at gates keep each heap's class cache, threads and collections running
// expect-exit: 0
// expect-output:
// cheap True
// gate sums 4999950000 4999950000
// main sum 499500
// free index True
// released True True
// free index True
//
// A KERNEL MODULE'S GATE (docs/HEAPS.md): a thread enters the module's heap
// on the way in (Runtime.EnterHeap) and leaves it on the way out, around a
// call that makes a few small objects. The class cache of the heap left is
// shelved and the one of the heap entered taken down (Gc.SwitchHeap), with
// no lock: a hundred thousand switches back and forth take the allocator's
// slow way a handful of times, not once a switch. Two threads do it while
// the main thread churns and collects, every string kept is read back
// whole, every heap's bins hold its own blocks, and the heaps go back.

using System.Threading;

static class Program
{
    static long[] _heaps = new long[2];
    static long[] _sums = new long[2];

    /// A gate: into the module's heap, a call that makes a little, out.
    static string Gate(long heap, int which, long n)
    {
        long was = Runtime.EnterHeap(heap);
        string made = "g" + which + " " + n;
        Runtime.LeaveHeap(was);
        return made;
    }

    static void Work(int which)
    {
        var ring = new string[1000];
        long sum = 0;
        for (long n = 0; n < 100000; n++)
        {
            string s = Gate(_heaps[which], which, n);
            ring[n % 1000] = s;
            sum += long.Parse(s.Substring(s.IndexOf(' ') + 1));
        }
        for (int i = 0; i < 1000; i++)
            if (ring[i] != "g" + which + " " + (99000 + i)) sum = -1;
        _sums[which] = sum;
    }

    static int Main()
    {
        _heaps[0] = Gc.NewHeap();
        _heaps[1] = Gc.NewHeap();

        // CHEAP: warmed once, then a hundred thousand switches back and forth.
        Gate(_heaps[0], 0, 0);
        long before = Gc.SlowPaths;
        for (long n = 0; n < 100000; n++) Gate(_heaps[0], 0, n);
        long slow = Gc.SlowPaths - before;
        Sys.Print("cheap ");
        Sys.Print(slow < 2000 ? "True" : "False");
        Sys.PrintLine();

        var a = new Thread(() => Work(0));
        var b = new Thread(() => Work(1));
        a.Start();
        b.Start();
        var ring = new string[1000];
        for (int round = 0; round < 40; round++)
        {
            for (int i = 0; i < 1000; i++) ring[i] = "m " + (round * 1000 + i);
            if (round % 10 == 0) Gc.Collect();
        }
        a.Join();
        b.Join();
        long main = 0;
        for (int i = 0; i < 1000; i++) main += long.Parse(ring[i].Substring(2)) - 39000;

        Sys.Print("gate sums ");
        Sys.PrintInt(_sums[0]);
        Sys.Print(" ");
        Sys.PrintInt(_sums[1]);
        Sys.PrintLine();
        Sys.Print("main sum ");
        Sys.PrintInt(main);
        Sys.PrintLine();
        Sys.Print("free index ");
        Sys.Print(Gc.CheckFreeIndex() ? "True" : "False");
        Sys.PrintLine();
        Gc.Collect();
        bool one = Gc.ReleaseHeap(_heaps[0]);
        bool two = Gc.ReleaseHeap(_heaps[1]);
        Sys.Print("released ");
        Sys.Print(one ? "True " : "False ");
        Sys.Print(two ? "True" : "False");
        Sys.PrintLine();
        Sys.Print("free index ");
        Sys.Print(Gc.CheckFreeIndex() ? "True" : "False");
        Sys.PrintLine();
        return 0;
    }
}
