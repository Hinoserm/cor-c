// test: switch_non_exhaustive_only_through_when
// expect-exit: 0
// expect-compile-warning: (18,35): warning CS8846
// expect-compile-warning: (19,33): warning CS8509
// expect-compile-warning: (20,41): warning CS8846
// expect-compile-warning: (21,33): warning CS8509
// expect-output:
// 1onefpos
//
// C#'s CS8846 beside CS8509. A switch expression that would cover every
// value of its input with its `when` guards left aside is warned CS8846,
// as Roslyn warns it ("a pattern with a 'when' clause might successfully
// match this value"); one that misses a value no pattern takes, CS8509.
// Both were CS8509, so `#pragma warning disable CS8846` disabled nothing.

static class Program
{
    static string A(int[] a) => a switch { [] => "e", [var x] => "1", [var f, .., var l] when a.Length > 2 => "many", [_, _] => "2" };
    static string B(int x) => x switch { 1 => "one", 2 when x > 0 => "two" };
    static string C(bool b, int y) => b switch { true when y > 0 => "t", false => "f" };
    static string D(int x) => x switch { > 0 => "pos", < 0 => "neg" };
    static int Main() { System.Console.WriteLine(A(new[] { 1 }) + B(1) + C(false, 0) + D(1)); return 0; }
}
