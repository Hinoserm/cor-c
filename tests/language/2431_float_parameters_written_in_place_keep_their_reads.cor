// test: a float or double parameter assigned in place, its old value read after, under register pressure, gives .NET's results
// expect-exit: 0
// expect-output:
// d 7.5 15 -64 4
// f 2.25 4.5 1 6
// mix 1.5 6 21
//
// A float parameter's home is its own argument slot, written with fstp. A
// spilled copy of a parameter must never be read from that slot once it has
// been stored to, so each function keeps the old value live past the store
// with enough other values that the copy is spilled.

using System;

static class Program
{
    static void D(double x, int a, int b, int c)
    {
        double old = x;
        int p = a * 3, q = b * 5, r = c * 7, s = a + b + c;
        x = x * 2;
        Console.WriteLine("d " + old + " " + x + " " + (p + q + r + s - 82) + " " + (s + a));
    }

    static void F(float x, int a, int b)
    {
        float old = x;
        int p = a * 3, q = b * 5;
        x += x;
        Console.WriteLine("f " + old + " " + x + " " + (p - q + 8) + " " + (a + b + 3));
    }

    static void Mix(double x, double y, int n)
    {
        double keep = x;
        for (int i = 0; i < n; i++) { y += x; x = y; }
        Console.WriteLine("mix " + keep + " " + x + " " + (n * 7));
    }

    static int Main()
    {
        D(7.5, 1, 1, 1);
        F(2.25f, 1, 2);
        Mix(1.5, 0, 3);
        return 0;
    }
}
