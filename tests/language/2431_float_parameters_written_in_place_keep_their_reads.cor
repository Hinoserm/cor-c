// test: a float or double parameter assigned in place, its old bits read after, under register pressure, gives .NET's results
// expect-exit: 0
// expect-output:
// f 1074790400 4.5 1 6
// d 4620130267728707584 15 -64 4
// mix 1.5 6 21
//
// A float parameter's home is its own argument slot, written with fstp. A
// copy of the parameter's bits taken at entry and spilled must never be
// read back from that slot once it has been stored to: the copy is the
// old value. Each function takes the bits first, assigns the parameter in
// place, and keeps the bits live past it beside enough other values that
// they are spilled. None is inlined, so each keeps its parameters.

using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static void F(float x, int a, int b)
    {
        int bits = BitConverter.SingleToInt32Bits(x);
        int p = a * 3, q = b * 5, r = a ^ b, s = a + b;
        x += x;
        Console.WriteLine("f " + bits + " " + x + " " + (p - q + 8 + r - r) + " " + (s + 3));
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void D(double x, int a, int b, int c)
    {
        long bits = BitConverter.DoubleToInt64Bits(x);
        int p = a * 3, q = b * 5, r = c * 7, s = a + b + c;
        x = x * 2;
        Console.WriteLine("d " + bits + " " + x + " " + (p + q + r + s - 82) + " " + (s + a));
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static void Mix(double x, double y, int n)
    {
        double keep = x;
        for (int i = 0; i < n; i++) { y += x; x = y; }
        Console.WriteLine("mix " + keep + " " + x + " " + (n * 7));
    }

    static int Main()
    {
        F(2.25f, 1, 2);
        D(7.5, 1, 1, 1);
        Mix(1.5, 0, 3);
        return 0;
    }
}
