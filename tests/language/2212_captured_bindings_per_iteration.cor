// test: captured_bindings_per_iteration
// expect-exit: 0
// expect-output:
// a1 a2 b1 b2 c1 c2
// x y
// p q
// 1 2
// n1 ttwo
// 5 6 7
// 3 7
// 16
// <a><b>
// one;two;
//
// A variable no statement declares -- a pattern's binding, an `out var` --
// is a new variable each time its scope is entered, as a declared local and
// a foreach's cursor are (C#), and a lambda keeps the one it was made with.
// Captured, they had one cell for the whole method, and every lambda made
// in a loop read the last lap's value: the link's preinitialiser, `if
// (IrArchive.Read(obj) is not IrArchive archive) continue; ... () =>
// archive.ReadBody(key)`, read every unit's bodies from the last archive,
// and the compiler built by itself failed to link ("Missing IR record").
// Where the block has local functions, whose closures are made at its top,
// the variable is made new there instead, as a declared local is: the
// compiler's Peephole hands `Jumped`, reading an `out int[] liveIn`, on as
// a delegate, and a cell made again at the `out` left the closure's empty.

using System;
using System.Collections.Generic;

static class Program
{
    static void Say<T>(List<Func<T>> made)
    {
        string line = "";
        foreach (Func<T> f in made) line += (line.Length == 0 ? "" : " ") + f();
        Console.WriteLine(line);
    }

    static int Count(int[] xs, out int[] doubled)
    {
        doubled = new int[xs.Length];
        for (int i = 0; i < xs.Length; i++) doubled[i] = xs[i] * 2;
        return xs.Length;
    }

    static int Jumpy(int[] xs)
    {
        int total = Count(xs, out int[] doubled);
        int Twice(int i) => doubled[i];
        Func<int, int> f = Twice;
        return total + f(0) + f(1);
    }

    static int Main()
    {
        List<Func<string>> fs = new();
        foreach (object o in new object[] { "a", "b", 1, "c" })
        {
            if (o is not string s) continue;
            foreach (string k in new[] { "1", "2" })
                fs.Add(() => s + k);
        }
        Say(fs);

        List<Func<string>> gs = new();
        foreach (object o in new object[] { "x", "y" })
        {
            string t = (string)o;
            gs.Add(() => t);
        }
        Say(gs);

        List<Func<string>> hs = new();
        foreach (object o in new object[] { "p", 2, "q" })
        {
            if (o is string u) hs.Add(() => u);
        }
        Say(hs);

        Dictionary<string, int> map = new() { ["a"] = 1, ["b"] = 2 };
        List<Func<int>> outs = new();
        foreach (string k in new[] { "a", "b" })
        {
            if (map.TryGetValue(k, out int v)) outs.Add(() => v);
        }
        Say(outs);

        List<Func<string>> arms = new();
        foreach (object o in new object[] { 1, "two", 3L })
        {
            switch (o) { case int n: arms.Add(() => "n" + n); break; case string t: arms.Add(() => "t" + t); break; }
        }
        Say(arms);

        List<Func<int>> whiles = new();
        Queue<object> q = new(new object[] { 5, 6, 7 });
        while (q.Count > 0 && q.Dequeue() is int w) whiles.Add(() => w);
        Say(whiles);

        List<Func<int>> decon = new();
        foreach ((int a, int b) in new[] { (1, 2), (3, 4) }) decon.Add(() => a + b);
        Say(decon);

        Console.WriteLine(Jumpy(new[] { 3, 4 }));
        List<Func<string>> echoes = new();
        foreach (object o in new object[] { "a", 1, "b" })
        {
            if (o is not string s) continue;
            string Echo() => "<" + s + ">";
            echoes.Add(Echo);
        }
        string line = "";
        foreach (Func<string> f in echoes) line += f();
        Console.WriteLine(line);
        List<Func<string>> reads = new();
        foreach (string k in new[] { "a", "b" })
        {
            if (!map.TryGetValue(k, out int found)) continue;
            string Read() => found == 1 ? "one" : "two";
            reads.Add(Read);
        }
        line = "";
        foreach (Func<string> g in reads) line += g() + ";";
        Console.WriteLine(line);
        return 0;
    }
}
