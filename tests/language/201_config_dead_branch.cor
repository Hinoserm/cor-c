// test: config dead branch
// expect-exit: 0
// expect-output:
// ide probed
// uart probed
// drivers 2
//
// A driver that is off is not in the image: its Probe is never called, so
// nothing reaches it, so the compiler drops it (X86-KERNEL.md,
// "Configuration"). That claim is the entire reason the kernel configures
// itself with constants instead of a preprocessor, and it is worth a test
// that fails loudly if the optimiser ever stops doing it.
//
// This file proves the half that can be proved by running: the body behind a
// false constant does not execute, and the probe count is the number of
// drivers the configuration turned on. The other half -- that the dropped
// function is not merely unexecuted but ABSENT from the executable -- cannot
// be seen from inside the program, so tests/lang/202_kconfig_tool.sh
// compiles this same file and checks with nm that the symbol
// m_FloppyDriver_Probe_0 is not in it while m_IdeDriver_Probe_0 is.
//
// The Config block is tools/kconfig.py's output for
// tests/lang/200_kconfig_test.conf, which is the configuration that turns
// DriverFloppy off and DriverIde on.

// BEGIN GENERATED Config.cor
// os/kernel/config/Config.cor -- GENERATED by tools/kconfig.py
// from tests/lang/200_kconfig_test.conf. Do not edit.
//
// Every constant here is folded by the compiler, so a driver that is off
// has no call to its Probe, nothing reaches it, and it is not in the
// image. This is Kconfig without the preprocessor and with every
// configuration type-checked whether or not it is selected.

static class CpuKind
{
    public const long I386 = 3;
    public const long I486 = 4;
    public const long Pentium = 5;
    public const long PentiumPro = 6;
}

static class FirmwareKind
{
    public const long Bios = 1;
    public const long Corsac = 2;
}

static class ConsoleKind
{
    public const long None = 0;
    public const long Serial = 1;
    public const long Vga = 2;
}

static class Config
{
    // Build for a 486-class PC: arch/x86 is compiled and arch/corsac is not.
    public const bool X86 = true;

    // Build for the CORSAC mainframe: arch/corsac is compiled.
    public const bool Corsac = false;

    // The instruction-set floor the compiler is told (--cpu). Code wanting a
    // later instruction tests Config.Cpu >= CpuKind.Pentium and provides the
    // 486 path in the else; the compiler keeps one of them. Features that vary
    // within a floor -- CPUID, TSC, MMX -- are detected at boot into Cpu.Has
    // and are never assumed here.
    public const long Cpu = CpuKind.Pentium;

    // An x87 is present and the kernel need not emulate it. True on a 486DX,
    // false on an SX.
    public const bool Fpu = true;

    // More than one processor. False makes every lock a no-op and every
    // per-CPU array one entry, so the single-processor build pays nothing for
    // a machine that does not exist yet.
    public const bool Smp = false;

    // How many processors the per-CPU arrays are sized for.
    public const long MaxCpus = 1;

    // What loaded the kernel and what it may assume. Bios is the machine as
    // IBM left it, entered from a second stage that has already left real
    // mode. Corsac is our own firmware: protected mode, a complete device
    // table, the low megabyte ours, and runtime services. Both produce the
    // same BootInfo block, and this key selects which of arch/x86/boot is
    // compiled.
    public const long Firmware = FirmwareKind.Bios;

    // A PCI bus is present and may be enumerated. ISA only, for now.
    public const bool Pci = false;

    // ATA PIO, LBA28, the primary and secondary channels, behind Blk.
    public const bool DriverIde = true;

    // The ISA NE2000 at Ne2000Base, behind the frame-shaped Net contract.
    public const bool DriverNe2000 = false;

    // 80x25 text at 0xB8000 with a VT100 subset, behind Con.
    public const bool DriverVgaText = false;

    // 8250/16450/16550 COM ports, the kernel log and the early console.
    public const bool DriverSerial8250 = true;

    // Scan-code set 1 through the 8042, feeding the console line.
    public const bool DriverKeyboard8042 = false;

    // Reserved. There is no code behind this key and turning it on builds a
    // kernel that does not mention a floppy controller anywhere -- which is
    // what the dead-branch test in tests/lang proves.
    public const bool DriverFloppy = false;

    // Reserved, for the PCI milestone. No code.
    public const bool DriverVirtio = false;

    // Compile os/kernel/net: ARP, IP, UDP and TCP above the frame interface.
    public const bool Tcp = false;

    // Where the kernel's own messages go before and after the drivers start.
    // Serial is what the QEMU tests read.
    public const long ConsoleDevice = ConsoleKind.Serial;

    // The COM port the serial console uses when ConsoleDevice is Serial.
    public const long SerialConsoleBase = 0x2F8;

    // The NE2000's jumpered I/O base.
    public const long Ne2000Base = 0x320;

    // The NE2000's jumpered interrupt.
    public const long Ne2000Irq = 10;

    // Keep the kernel's internal consistency checks. Off, every assert folds
    // away and the code that only the assert called is dropped with it.
    public const bool DebugAsserts = false;

    // The virtual address the kernel image is linked at: the top gigabyte,
    // supervisor-only, mapped into every address space.
    public const long KernelBase = 0xC0100000;

    // The physical address the loader puts the image at: 1 MiB, above the
    // option-ROM hole.
    public const long LoadPhysical = 0x100000;
}
// END GENERATED Config.cor

// Three drivers with the same shape as the real ones in os/kernel/drivers.
// Each is reached only from behind its own Config constant, which is what
// makes it droppable.

static class IdeDriver
{
    public static bool Probe()
    {
        Sys.Print("ide probed");
        Sys.PrintLine();
        return true;
    }
}

static class UartDriver
{
    public static bool Probe()
    {
        Sys.Print("uart probed");
        Sys.PrintLine();
        return true;
    }
}

static class FloppyDriver
{
    // Nothing else in this program calls this. If the compiler kept the
    // `if (Config.DriverFloppy)` body this would be reachable and the two
    // builds 202_kconfig_tool.sh makes would be the same size, which is the
    // only way from outside to tell "dropped" from "not executed".
    public static bool Probe()
    {
        Sys.Print("floppy probed");
        Sys.PrintLine();
        return true;
    }
}

static class Program
{
    static int Main()
    {
        long probed = 0;

        if (Config.DriverIde)
        {
            if (IdeDriver.Probe())
            {
                probed = probed + 1;
            }
        }

        if (Config.DriverSerial8250)
        {
            if (UartDriver.Probe())
            {
                probed = probed + 1;
            }
        }

        if (Config.DriverFloppy)
        {
            if (FloppyDriver.Probe())
            {
                probed = probed + 1;
            }
        }

        Sys.Print("drivers " + probed.ToString());
        Sys.PrintLine();
        return 0;
    }
}
