// test: nested_type_of_a_generic_beats_an_alias
// expect-exit: 0
// expect-output:
// 5 6 7 8 10 11
// 3 1
// 6 11 12
// Int64,Int32 Int32,String Int64,Int32,Int32 Int32,String,Int64
// 3 Int64 5
// 9 4 Int64 6
//
// Inside Box<T>, `G` is Box's own nested class, not the file's
// `using G = System.Collections.Generic`: C# looks in the types around a
// use before the aliases. A type nested in a generic one takes the outer
// parameters (Parser.FinishFamily) however it is named from inside the
// family -- through the nearest type around the use that declares its
// head, by its whole path, bare, on the left of a member access, with the
// outer's arguments written (Box<T>.Inner<int>.Shared) -- and, from outside
// with the outer's arguments, is that type in an expression too
// (Monomorphiser: Box<int>.G.List<string>.Made(), once 'Box$int' had no
// member 'G'). Box's nested types are keyed under `Box`, its name plain, not under
// `Box`1` (Binder.TypePath); outside Box, `G` is the alias. The last line
// names every parameter's argument, so an outer argument put in the wrong
// place -- or left out of a chain -- prints the wrong names, a type nested
// two deep (G.List<int>.Node<int>) included. A type taking Box's parameter
// alone, Plain, named bare in an expression (`Plain.Shared`) is Box.Plain<T>
// too -- but not where a local of the name hides it, as C# looks there first;
// so is `G.Quiet.Shared` for one nested in Box's G, and a nested type's field
// of a type's name hides that type in its own methods.
using G = System.Collections.Generic;

class Box<T>
{
    public class G
    {
        public class List<U>
        {
            public int Mine = 5;
            public static int Made() => 6;
            public static string Names() => typeof(T).Name + "," + typeof(U).Name;

            public class Node<W>
            {
                public static string Names() => typeof(T).Name + "," + typeof(U).Name + "," + typeof(W).Name;
            }
        }

        public class Quiet
        {
            public static int Shared = 4;
            public static string Names() => typeof(T).Name;
        }

        public class Deeper
        {
            // G from here is Box.G, the nearest type around that declares one.
            public int Through() => new G.List<int>().Mine + 2;
        }
    }

    public class Shadow
    {
        public int Shared = 9;
        public int Value = 6;
    }

    public class Other
    {
        public static int Value = 5;
    }

    public class Holder
    {
        public Shadow Other = new Shadow();
        public int Read() => Other.Value;
    }

    public class Plain
    {
        public static int Shared = 3;
        public static string Names() => typeof(T).Name;
    }

    public class Inner<V>
    {
        public static int Shared = 11;
        public int Own = 10;
    }

    public int Use() => new G.List<int>().Mine;
    public int Made() => G.List<int>.Made();
    public int Deep() => new G.Deeper().Through();
    public int Whole() => new Box<T>.G.List<int>().Mine + 3;
    public int Own() => new Inner<int>().Own;
    public int Static() => Inner<int>.Shared;
    public int Spelt() => Box<T>.Inner<int>.Shared + 1;
    public int Bare() => Plain.Shared;
    public string BareNames() => Plain.Names();
    public int Hidden()
    {
        int Plain = 4;
        return Plain + 1;
    }
    public int HiddenAccess()
    {
        Shadow Plain = new Shadow();
        return Plain.Shared;
    }
    public string Quietly() => G.Quiet.Shared + " " + G.Quiet.Names();
    public string ListNames() => G.List<int>.Names();
    public string NodeNames() => G.List<int>.Node<int>.Names();
}

static class Program
{
    static int Main()
    {
        Box<long> box = new Box<long>();
        System.Console.WriteLine(box.Use() + " " + box.Made() + " " + box.Deep() + " " + box.Whole()
            + " " + box.Own() + " " + box.Static());
        G.List<int> library = new G.List<int>();
        library.Add(9);
        System.Console.WriteLine(new Box<int>.G.List<string>().Mine / 2 + 1 + " " + library.Count);
        System.Console.WriteLine(Box<int>.G.List<string>.Made() + " " + Box<long>.Inner<int>.Shared + " " + box.Spelt());
        System.Console.WriteLine(box.ListNames() + " " + Box<int>.G.List<string>.Names() + " " + box.NodeNames()
            + " " + Box<int>.G.List<string>.Node<long>.Names());
        System.Console.WriteLine(box.Bare() + " " + box.BareNames() + " " + box.Hidden());
        System.Console.WriteLine(box.HiddenAccess() + " " + box.Quietly() + " " + new Box<long>.Holder().Read());
        return 0;
    }
}
