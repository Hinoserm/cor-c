// test: nested_type_of_a_generic_beats_an_alias
// expect-exit: 0
// expect-output:
// 5 6 7 8 9 10 11
// 3 1
//
// Inside Box<T>, `G` is Box's own nested class, not the file's
// `using G = System.Collections.Generic`: C# looks in the types around a
// use before the aliases. A type nested in a generic one takes the outer
// parameters (Parser.FinishFamily) however it is named from inside the
// family -- through the nearest type around the use that declares its
// head, by its whole path, bare, on the left of a member access -- and,
// written from outside with the outer's arguments already, is left as it
// is. Box's nested types are keyed under `Box`, its name plain, not under
// `Box`1` (Binder.TypePath); outside Box, `G` is the alias.
using G = System.Collections.Generic;

class Box<T>
{
    public class G
    {
        public class List<U>
        {
            public int Mine = 5;
            public static int Made() => 6;
        }

        public class Deeper
        {
            // G from here is Box.G, the nearest type around that declares one.
            public int Through() => new G.List<int>().Mine + 2;
        }
    }

    public class Plain
    {
        public static int Shared = 9;
    }

    public class Inner<V>
    {
        public static int Shared = 11;
        public int Own = 10;
    }

    public int Use() => new G.List<int>().Mine;
    public int Made() => G.List<int>.Made();
    public int Deep() => new G.Deeper().Through();
    public int Whole() => new Box<T>.G.List<int>().Mine + 3;
    public int Bare() => Plain.Shared;
    public int Own() => new Inner<int>().Own;
    public int Static() => Inner<int>.Shared;
}

static class Program
{
    static int Main()
    {
        Box<long> box = new Box<long>();
        System.Console.WriteLine(box.Use() + " " + box.Made() + " " + box.Deep() + " " + box.Whole()
            + " " + box.Bare() + " " + box.Own() + " " + box.Static());
        G.List<int> library = new G.List<int>();
        library.Add(9);
        System.Console.WriteLine(new Box<int>.G.List<string>().Mine / 2 + 1 + " " + library.Count);
        return 0;
    }
}
