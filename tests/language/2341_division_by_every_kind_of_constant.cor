// test: division_and_remainder_by_every_kind_of_constant
// expect-exit: 0
// expect-output:
// u32 fails 0
// i32 fails 0
// u64 fails 0
// i64 fails 0
// narrow fails 0
// checks 1643220
//
// EVERY KIND OF CONSTANT DIVISOR, BOTH WIDTHS, BOTH SIGNS (Select.
// DivideByConstant and, for i386's 64-bit values, UnsignedByConstant; the
// numbers DivisionMagic's): each quotient and remainder by a constant
// against the processor's own division by the same divisor read at run
// time, over edge dividends and pseudo-random ones. The divisors take
// every form: a magic of the width; one of a bit more (7, 19, 21, the
// add-and-halve form, and long mode's single 64-bit multiply for it); an
// even one divided by its power of two first (14, 28); powers of two,
// signed and unsigned (shifts, masks, the bias toward zero: the IR passes'
// here, the selector's own in the backend's unit tests,
// DivisionByConstant, which hand it every form as an immediate); the
// largest and the most negative; unsigned 64-bit divisors above 2^63 (a
// compare); and dividends known narrow (a byte, a ushort, a uint widened),
// whose magic is smaller, or whose quotient is known zero. Each remainder
// is also taken alone, in a method of its own kept apart (NoInlining),
// where no quotient beside it lets DivRemReuse make it a multiply and a
// subtract. The target and the processor are the run's: both targets'
// batches run it.
//
// (Generated: one line per divisor per type, so every one is its own
// constant to the compiler.)
using System;
using System.Runtime.CompilerServices;

static class Program
{
    static uint Zero;
    static int Fails, Checks;
    static uint OU(uint v) => v ^ Zero;
    static int OI(int v) => v ^ (int)Zero;
    static ulong OUL(ulong v) => v ^ Zero;
    static long OL(long v) => v ^ (long)Zero;

    static void Report(string kind, string n, string d)
    {
        Fails++;
        if (Fails <= 20) Console.WriteLine(kind + " " + n + " / " + d + " wrong");
    }
    static void CU(uint n, uint d, uint q, uint r) { Checks++; if (n / d != q || n % d != r) Report("u32", n.ToString(), d.ToString()); }
    static void CI(int n, int d, int q, int r) { Checks++; if (n / d != q || n % d != r) Report("i32", n.ToString(), d.ToString()); }
    static void CUL(ulong n, ulong d, ulong q, ulong r) { Checks++; if (n / d != q || n % d != r) Report("u64", n.ToString(), d.ToString()); }
    static void CL(long n, long d, long q, long r) { Checks++; if (n / d != q || n % d != r) Report("i64", n.ToString(), d.ToString()); }
    static void RU(uint n, uint d, uint r) { Checks++; if (n % d != r) Report("u32 rem", n.ToString(), d.ToString()); }
    static void RI(int n, int d, int r) { Checks++; if (n % d != r) Report("i32 rem", n.ToString(), d.ToString()); }
    static void RUL(ulong n, ulong d, ulong r) { Checks++; if (n % d != r) Report("u64 rem", n.ToString(), d.ToString()); }
    static void RL(long n, long d, long r) { Checks++; if (n % d != r) Report("i64 rem", n.ToString(), d.ToString()); }

