        CU(n, OU(1000u), n / 1000u, n % 1000u);
        CU(n, OU(1024u), n / 1024u, n % 1024u);
        CU(n, OU(7919u), n / 7919u, n % 7919u);
        CU(n, OU(65537u), n / 65537u, n % 65537u);
        CU(n, OU(1000000007u), n / 1000000007u, n % 1000000007u);
        CU(n, OU(2147483647u), n / 2147483647u, n % 2147483647u);
        CU(n, OU(2147483648u), n / 2147483648u, n % 2147483648u);
