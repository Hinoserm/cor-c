    [MethodImpl(MethodImplOptions.NoInlining)]
    static void NarrowRem(ulong x)
    {
        uint wb = (byte)x, wh = (ushort)x;
        ulong wu = (uint)x;
        RU(wb, OU(7u), wb % 7u);
        RU(wb, OU(300u), wb % 300u);
        RU(wh, OU(641u), wh % 641u);
        RUL(wu, OUL(19UL), wu % 19UL);
        RUL(wu, OUL(4294967297UL), wu % 4294967297UL);
    }
    static void Narrow(ulong x)
    {
        byte b = (byte)x;
        ushort h = (ushort)x;
        uint u = (uint)x;
        uint wb = b, wh = h;
        ulong wu = u;
        CU(wb, OU(7u), wb / 7u, wb % 7u);
        CU(wb, OU(14u), wb / 14u, wb % 14u);
        CU(wb, OU(300u), wb / 300u, wb % 300u);
        CU(wb, OU(256u), wb / 256u, wb % 256u);
        CU(wh, OU(7u), wh / 7u, wh % 7u);
        CU(wh, OU(641u), wh / 641u, wh % 641u);
        CU(wh, OU(65537u), wh / 65537u, wh % 65537u);
        CUL(wu, OUL(7UL), wu / 7UL, wu % 7UL);
        CUL(wu, OUL(19UL), wu / 19UL, wu % 19UL);
        CUL(wu, OUL(28UL), wu / 28UL, wu % 28UL);
        CUL(wu, OUL(4294967295UL), wu / 4294967295UL, wu % 4294967295UL);
        CUL(wu, OUL(4294967297UL), wu / 4294967297UL, wu % 4294967297UL);
        CUL(wu, OUL(0xFFFFFFFFFFFFFFFEUL), wu / 0xFFFFFFFFFFFFFFFEUL, wu % 0xFFFFFFFFFFFFFFFEUL);
    }

    static int Main()
    {
        Zero = (uint)(Environment.GetCommandLineArgs().Length >> 16);
        ulong[] edges = { 0, 1, 2, 3, 6, 7, 8, 9, 13, 14, 15, 27, 28, 255, 256, 299, 300, 640, 641, 642, 65535, 65536, 65537,
            0x7FFFFFFE, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFD, 0xFFFFFFFE, 0xFFFFFFFF, 0x100000000, 0x100000001,
            999999999999, 1000000000000, 0x7FFFFFFFFFFFFFFE, 0x7FFFFFFFFFFFFFFF, 0x8000000000000000, 0x8000000000000001,
            0xBFFFFFFFFFFFFFFF, 0xC000000000000000, 0xFFFFFFFFFFFFFFFD, 0xFFFFFFFFFFFFFFFE, 0xFFFFFFFFFFFFFFFF };
        int failed = 0;
        string[] kinds = { "u32", "i32", "u64", "i64", "narrow" };
        for (int kind = 0; kind < 5; kind++)
        {
            Fails = 0;
            ulong seed = 0x9E3779B97F4A7C15UL;
            for (int k = 0; k < edges.Length + 3000; k++)
            {
                ulong x;
                if (k < edges.Length) x = edges[k];
                else
                {
                    seed = seed * 6364136223846793005UL + 1442695040888963407UL;
                    // Random magnitudes too: the top bits cleared by a varying amount.
                    x = seed >> (int)((seed >> 58) & 63);
                }
                for (int sign = 0; sign < 2; sign++)
                {
                    ulong v = sign == 0 ? x : 0UL - x;
                    if (kind == 0) { U32((uint)v); U32Rem((uint)v); }
                    else if (kind == 1) { I32((int)v); I32Rem((int)v); }
                    else if (kind == 2) { U64(v); U64Rem(v); }
                    else if (kind == 3) { I64((long)v); I64Rem((long)v); }
                    else { Narrow(v); NarrowRem(v); }
                }
            }
            Console.WriteLine(kinds[kind] + " fails " + Fails);
            failed += Fails;
        }
        Console.WriteLine("checks " + Checks);
        return failed == 0 ? 0 : 1;
    }
}
