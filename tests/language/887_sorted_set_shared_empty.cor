// test: sorted_set_shared_empty
// expect-exit: 0
// expect-output:
// 0 0 0 False True False 0
// moved False
// 1,3,5 0 1 5
// 3,5 | 9 | a
// 6 0 3,2,1
//
// An empty SortedSet shares one empty list until its first Add, and every
// set and sort asks Comparer<T>.Default rather than making a comparer of
// its own; neither shows: an empty set answers, clears, filters and is
// enumerated as before, and Comparer<T>.Create orders as .NET's does.
// Output checked against .NET.

using System;
using System.Collections.Generic;
static class Program
{
    static void Main()
    {
        var a = new SortedSet<int>(); var b = new SortedSet<int>();
        Console.WriteLine(a.Count + " " + a.Min + " " + a.Max + " " + a.Contains(3) + " " + a.SetEquals(b) + " " + a.Remove(1) + " " + a.RemoveWhere(x => true));
        foreach (int x in b) Console.WriteLine("never");
        using (var e = b.GetEnumerator()) { a.Clear(); Console.WriteLine("moved " + e.MoveNext()); }
        a.Add(5); a.Add(1); a.Add(3); a.Add(3);
        Console.WriteLine(string.Join(",", a) + " " + b.Count + " " + a.Min + " " + a.Max);
        b.UnionWith(new[] { 9, 2 }); a.IntersectWith(new[] { 3, 5, 7 }); b.ExceptWith(new[] { 2 });
        Console.WriteLine(string.Join(",", a) + " | " + string.Join(",", b) + " | " + new SortedSet<string>(StringComparer.Ordinal) { "b", "a" }.Min);
        var c = new SortedSet<int>(new[] { 4, 2, 8 }); c.Clear(); c.Add(6);
        Console.WriteLine(string.Join(",", c) + " " + new SortedSet<long>().Count + " " + string.Join(",", new SortedSet<int>(Comparer<int>.Create((x, y) => y.CompareTo(x))) { 1, 3, 2 }));
    }
}
