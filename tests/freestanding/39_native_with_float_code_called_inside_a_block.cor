// test: a native whose code uses the x87, called through Sys.CallNative inside a packed block, runs under that block
// targets: x86
// with-asm: 39_native_with_float_code_called_inside_a_block
// flags: --asm-entry corc_start --entry _start --x87-in-blocks-only
// expect-output:
// one 3F800000
//
// The start (the assembly beside this) leaves float_one's address in
// Program.Native, as a kernel's entry leaves its natives'. The assembled
// object's facts say float_one uses the x87 and is the routine in that
// static; the call through it is made inside Main's block, so it runs under
// that block's save, and is no error.

static class Program
{
    public static nuint Native;

    static int Main()
    {
        Host.Start(1024 * 1024);
        uint[] cell = new uint[1];
        using (Packed.X87())
        {
            Sys.CallNative(Native, Sys.ArrayData(cell));
        }
        Host.Line("one " + cell[0].ToString("X8"));
        Host.Done(0);
        return 0;
    }
}
