// test: a native whose code uses the x87, called through Sys.CallNative, runs where its caller keeps the state
// targets: x86
// with-asm: 39_native_with_float_code_called_inside_a_block
// flags: --asm-entry corc_start --entry _start --x87-in-blocks-only
// expect-output:
// one 3F800000
//
// The start (the assembly beside this) leaves float_one's address in
// Program.Native, as a kernel's entry leaves its natives'. A method calling a
// native keeps the state (the compiler cannot see what a native uses), so
// the call through the static runs inside it, and is no error -- the test of
// Native against 0 before it takes nothing, nor do float_one's own branch and
// loop.

static class Program
{
    public static nuint Native;

    static int Main()
    {
        Host.Start(1024 * 1024);
        uint[] cell = new uint[1];
        if (Native != 0)
        {
            {
                Sys.CallNative(Native, Sys.ArrayData(cell));
            }
        }
        Host.Line("one " + cell[0].ToString("X8"));
        Host.Done(0);
        return 0;
    }
}
