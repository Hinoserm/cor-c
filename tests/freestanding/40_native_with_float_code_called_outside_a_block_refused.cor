// test: a native whose code uses the x87, called through Sys.CallNative outside every packed block, is refused at that call
// targets: x86
// with-asm: 40_native_with_float_code_called_outside_a_block_refused
// flags: --asm-entry corc_start --entry _start --x87-in-blocks-only
// expect-compile-error: 'float_one' has float code outside a packed block (40_native_with_float_code_called_outside_a_block_refused.x86.asm:22) and can run outside one: 'the routine in s_Program_Native' calls 'float_one'
//
// As 39, but the call is made outside any block: float_one's x87 code
// would run on the interrupted thread's state, and the error names the
// way there through Program.Native (from Main, or the entry stub Main is
// inlined into).

static class Program
{
    public static nuint Native;

    static int Main()
    {
        Host.Start(1024 * 1024);
        uint[] cell = new uint[1];
        Sys.CallNative(Native, Sys.ArrayData(cell));
        Host.Line("one " + cell[0].ToString("X8"));
        Host.Done(0);
        return 0;
    }
}
