// test: an asm block that only reads the x87's state is no float code, and runs on the thread's own state where its method keeps one
// targets: x86
// flags: --x87-in-blocks-only
// expect-output:
// precision 3 masked yes 5
//
// FNSTCW only reads the control word: as in an .asm file, the link counts
// it no float code (X87Notes). Main keeps the state for its own double, and
// gives the thread's back around the block (Lowering.OnOwnState), as
// around a plain Sys.CallNative: the block reads the thread's control word,
// FNINIT's 0x037F -- precision 3, the 64-bit mantissa -- and not the kept
// state's 0x027F, every exception masked in both (docs/INLINE-ASSEMBLY.md).

static class Program
{
    static int _half = 5;

    static int Main()
    {
        Host.Start(1024 * 1024);
        double d = _half * 0.5 * 2;
        ushort cw;
        asm
        {
            fnstcw cw
        }
        Host.Line("precision " + ((cw >> 8) & 3).ToString() + " masked " + ((cw & 0x3F) == 0x3F ? "yes" : "no") + " " + ((int)d).ToString());
        Host.Done(0);
        return 0;
    }
}
