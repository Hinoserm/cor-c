// test: a native whose code uses the x87, called through Sys.CallNativeFloat from a lambda, is refused: no state is kept there
// targets: x86
// with-asm: 40_native_with_float_code_called_from_a_lambda_refused
// flags: --asm-entry corc_start --entry _start --x87-in-blocks-only
// expect-compile-error: 'float_one' has float code (40_native_with_float_code_called_from_a_lambda_refused.x86.asm:22) that can run where no kept state is: 'the routine in s_Program_Native' calls 'float_one'
//
// As 39, but the call is made from a lambda, a delegate that may run from
// anywhere: the compiler keeps the state around methods that call such a
// native, not around a lambda's body, and float_one's x87 code would run
// on the interrupted thread's state; the error names the way there through
// Program.Native.

static class Program
{
    public static nuint Native;

    static int Main()
    {
        Host.Start(1024 * 1024);
        uint[] cell = new uint[1];
        System.Action call = () => Sys.CallNativeFloat(Native, Sys.ArrayData(cell));
        call();
        Host.Line("one " + cell[0].ToString("X8"));
        Host.Done(0);
        return 0;
    }
}
