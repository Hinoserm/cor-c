// test: a choice whose arms compute is a cmov; a loop-carried one keeps its branch
// flags-x86: --cpu=pentium-pro
// expect-exit: 0
// expect-output:
// abs 5 4 0
// pick 12 -9
// clip 6 1
// max 12
// count 3
// expect-asm-x86: Abs: cmov
// expect-asm-x86: Pick: cmov
// expect-asm-x86: Clip: cmov
// expect-asm-x86: CountBig: cmov
// expect-no-asm-x86: MaxOf: cmov
// expect-asm-x86-64: Abs: cmov
// expect-asm-x86-64: Pick: cmov
// expect-asm-x86-64: Clip: cmov
// expect-asm-x86-64: CountBig: cmov
// expect-no-asm-x86-64: MaxOf: cmov
//
// Abs's `-x`, `a > b ? b + c : a - c` and an `if` that doubles before it
// assigns kept their branches: an arm that computed was no move. Now each
// arm's arithmetic -- a few instructions on registers and constants, none
// that can fault or reads memory -- runs before the compare, in registers
// only that arm used, and the cmov chooses between the results. Not where
// the choice is carried round an inner loop: a running maximum's cmov waits
// on the last lap's, where a predicted branch does not wait at all. The
// x86-64 backend selects the same way (it had no if-conversion).

using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)] static int Abs(int x) { return x < 0 ? -x : x; }
    [MethodImpl(MethodImplOptions.NoInlining)] static int Pick(int a, int b, int c) { return a > b ? b + c : a - c; }
    [MethodImpl(MethodImplOptions.NoInlining)] static int Clip(int a, int b) { int v = a; if (a > b) v = b * 2; return v; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int MaxOf(int[] xs)
    {
        int m = int.MinValue;
        for (int i = 0; i < xs.Length; i++) if (xs[i] > m) m = xs[i];
        return m;
    }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int CountBig(int[] xs, int t)
    {
        int n = 0;
        for (int i = 0; i < xs.Length; i++) n += xs[i] > t ? 1 : 0;
        return n;
    }

    static int Main()
    {
        Host.Start(1024 * 1024);
        int zero = 0;
        int[] xs = new int[] { 3, -9, 12, 7, zero };
        Host.Line("abs " + Abs(-5 - zero) + " " + Abs(4 + zero) + " " + Abs(zero));
        Host.Line("pick " + Pick(3, 2 + zero, 10) + " " + Pick(1, 2 + zero, 10));
        Host.Line("clip " + Clip(5, 3 + zero) + " " + Clip(1, 3));
        Host.Line("max " + MaxOf(xs));
        Host.Line("count " + CountBig(xs, 2));
        Host.Done(0);
        return 0;
    }
}
