// test: float code in a method called only from where the state is kept runs under its caller's state, keeping none of its own
// targets: x86
// flags: --x87-in-blocks-only
// apart: yes
// expect-no-asm-x86: Main: Round
// expect-output:
// ceil 4 -2 3
// shade 191 0 255
// round 3 8
//
// Main keeps the x87 state for its own float code (the compiler's, once at
// its start); Ceil, Clamp255 and Shade, called only from inside it, run as
// copies that keep none of their own ($inside), so the state is saved once
// and not on every call. Round is inlined at both its calls (Main's code
// names it nowhere): the body left behind in the unit's object, which
// nothing calls, never runs, and is no error at the link.

using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Ceil(double d) { int i = (int)d; return i < d ? i + 1 : i; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Clamp255(double d) => d < 0 ? 0 : d > 255 ? 255 : (int)d;

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Shade(double a, double b) => Clamp255(a * b + 0.5);

    static int Round(double d) => (int)(d + 0.5);

    static int Main()
    {
        Host.Start(1024 * 1024);
        int a, b, c, s, t, u, r, q;
        {
            a = Ceil(3.25); b = Ceil(-2.5); c = Ceil(3.0);
            s = Shade(0.75, 255.0); t = Shade(-1.0, 3.0); u = Shade(2.0, 255.0);
            r = Round(2.5); q = Round(7.75);
        }
        Host.Line("ceil " + a + " " + b + " " + c);
        Host.Line("shade " + s + " " + t + " " + u);
        Host.Line("round " + r + " " + q);
        Host.Done(0);
        return 0;
    }
}
