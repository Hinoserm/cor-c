// test: Platform.Blocking makes its call as a blocking one to the collector, on bare metal as on Linux
// expect-asm-x86: Main: BeginBlocking EndBlocking
// expect-asm-x86-64: Main: BeginBlocking EndBlocking
// expect-exit: 0
// expect-output:
// through Platform.Blocking
// wrote 26
// collected True
// alive 100
//
// A ring-1 kernel of CORSAC has a kernel below it, and the Linux platform's
// files.cor, compiled into it, makes every read and write through
// Platform.Blocking: the gate may park the call there for as long as a pipe's
// server takes to answer. The thread counts as stopped meanwhile, as a Linux
// thread in read(2) does, or the first collection another thread started
// would wait for it until the call came back. Here the host's write stands
// for the gate's: the call is bracketed, its answer is the kernel's, and the
// one thread is a running thread again after it -- the collection it then
// makes keeps what it holds. Platform.Blocking is inlined into Main, and
// Runtime.BeginBlocking, never put in place (it reads its caller's registers,
// Sys.CallerRegister), is called from it.

using System;

static class Program
{
#if SYSCALL64
    const int Write = 1;
#else
    const int Write = 4;
#endif

    static int Main()
    {
        Host.Start(8 * 1024 * 1024);

        string text = "through Platform.Blocking\n";
        byte[] bytes = new byte[text.Length];
        for (int i = 0; i < text.Length; i++) bytes[i] = (byte)text[i];
        long wrote = (int)Platform.Blocking(Write, 1, (SyscallWord)Sys.ArrayData(bytes), (SyscallWord)bytes.Length);
        Host.Line("wrote " + wrote);

        object[] keep = new object[100];
        for (int round = 0; round < 1000; round++)
        {
            for (int i = 0; i < 100; i++)
            {
                byte[] junk = new byte[500];
                junk[0] = (byte)i;
                if (round == 999) keep[i] = junk;
            }
        }
        int alive = 0;
        for (int i = 0; i < 100; i++) if (keep[i] != null && ((byte[])keep[i])[0] == i) alive++;
        Host.Line("collected " + (GC.CollectionCount(0) > 0));
        Host.Line("alive " + alive);

        Host.Done(alive == 100 && wrote == bytes.Length ? 0 : 1);
        return 0;
    }
}
