// test: a function with float code called outside every packed block is refused at the call that takes it there
// targets: x86
// flags: --x87-in-blocks-only
// apart: yes
// expect-compile-error: 'Program.Main()' calls 'Program.Ceil(Double d)' at 37_float_helper_called_outside_a_block_refused.cor:
//
// Ceil is called inside Main's block once and outside it once: the second
// call runs its float code on the interrupted thread's x87 state, and the
// error names that call, the one to move into a block.

using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Ceil(double d) { int i = (int)d; return i < d ? i + 1 : i; }

    static int Main()
    {
        Host.Start(1024 * 1024);
        int a;
        using (Packed.X87()) { a = Ceil(3.25); }
        int b = Ceil(1.5);
        Host.Line("ceil " + a + " " + b);
        Host.Done(0);
        return 0;
    }
}
