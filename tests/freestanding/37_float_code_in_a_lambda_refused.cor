// test: float code in a lambda is refused: the compiler keeps the x87's state around methods, and a lambda's body is no method's
// targets: x86
// flags: --x87-in-blocks-only
// expect-compile-error: has its address taken (a delegate
//
// The compiler keeps the interrupted thread's x87 state around a method
// with float code, and around a method's callers' calls; a lambda is a
// delegate, which may run from anywhere, and its float code is refused.

using System;
using System.Runtime.CompilerServices;

static class Program
{
    // Kept where the call cannot see it: a delegate anything may call.
    static Func<double, int> _twice = d => (int)(d * 2.0);

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Call(Func<double, int> f, double x) => f(x);

    static int Main()
    {
        Host.Start(1024 * 1024);
        Host.Line("twice " + Call(_twice, 1.5));
        Host.Done(0);
        return 0;
    }
}
