// test: a function with float code reached outside every packed block through another is refused, naming the outer call
// targets: x86
// flags: --x87-in-blocks-only
// apart: yes
// expect-compile-error: 'Program.Draw()' calls 'Program.Span(Int32 x)' at 38_float_helper_reached_outside_through_another_refused.cor:
//
// Span is called inside Main's block, and also from Draw, which Main calls
// outside one: Ceil, which only Span calls, runs outside every block that
// way, and the error names Draw's call of Span.

using System;
using System.Runtime.CompilerServices;

static class Program
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Ceil(double d) { int i = (int)d; return i < d ? i + 1 : i; }

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Span(int x) => Ceil(x) + 1;

    [MethodImpl(MethodImplOptions.NoInlining)]
    static int Draw() => Span(7);

    static int Main()
    {
        Host.Start(1024 * 1024);
        int a;
        using (Packed.X87()) { a = Span(2); }
        int b = Draw();
        Host.Line("span " + a + " " + b);
        Host.Done(0);
        return 0;
    }
}
