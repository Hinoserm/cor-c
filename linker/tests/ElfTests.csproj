<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests for Corsac.Lang.Elf against GNU binutils, gcc and the
       host kernel. Plain console program: no test framework, no packages, so
       it runs anywhere the compiler builds. Exit status is the verdict. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Corsac.Tests.Elf</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../compiler/corc.csproj" />
  </ItemGroup>

</Project>
